            "text": "[\n  {\"id\": 701379, \"suggestedTranslation\": \"\\\"Hỡi Bệ hạ, Mặt Trăng Vinh Quang trên bầu trời đêm lạnh giá. Xin hãy ban Ánh Sáng Ban Sự Sống của ngài cho chúng con mãi mãi.\\\"\", \"rating\": 9.0},\n  {\"id\": 701380, \"suggestedTranslation\": \"\\\"Hỡi Bệ Hạ vĩ đại, nguồn sức mạnh của chúng con, đấng nuôi dưỡng duy nhất của chúng con. Chúng con chỉ trung thành với duy nhất Ngài.\\\"\", \"rating\": 9.0},\n  {\"id\": 701384, \"suggestedTranslation\": \"Nỗi sợ hãi biến thành sự tận tâm. Run rẩy thành lòng biết ơn.\", \"rating\": 9.0},\n  {\"id\": 701446, \"suggestedTranslation\": \"Mỗi lá bài cơ bị loại bỏ\\n+1 đa năng\", \"rating\": 8.0},\n  {\"id\": 701447, \"suggestedTranslation\": \"Với mỗi chất bài khác nhau\\ntrong bộ bài đã bỏ +15 chip\", \"rating\": 8.5},\n  {\"id\": 701448, \"suggestedTranslation\": \"Bắt đầu với 80 chip\\nMỗi lần loại bỏ -15 chip\", \"rating\": 8.5},\n  {\"id\": 701450, \"suggestedTranslation\": \"Mỗi lá Cơ hoặc Rô được thay thế\\nbằng Chuồn hoặc Bích +2 đa năng\", \"rating\": 8.0},\n  {\"id\": 701451, \"suggestedTranslation\": \"Mỗi quân bài bị loại bỏ trở thành\\ncùng chất +5 chip +2 đa năng\", \"rating\": 8.5},\n  {\"id\": 701452, \"suggestedTranslation\": \"Tay bài tệ hơn sau khi loại bỏ\\n+30 chip\", \"rating\": 9.0},\n  {\"id\": 701453, \"suggestedTranslation\": \"Mỗi quân Hậu trên tay\\n+1 đa năng\", \"rating\": 8.5},\n  {\"id\": 701454, \"suggestedTranslation\": \"Mỗi quân Bích trên tay\\n+25 chip\", \"rating\": 8.5},\n  {\"id\": 701455, \"suggestedTranslation\": \"Mỗi quân bài hình người bị loại bỏ\\n+20 chip\", \"rating\": 8.5},\n  {\"id\": 701456, \"suggestedTranslation\": \"Mỗi đôi trên tay\\n+3 đa năng\", \"rating\": 8.5},\n  {\"id\": 701457, \"suggestedTranslation\": \"Mỗi lá Cơ được giữ lại\\n+1 đa năng\", \"rating\": 8.5},\n  {\"id\": 701458, \"suggestedTranslation\": \"Mỗi quân Vua trên tay\\n+25 chip\", \"rating\": 8.5},\n  {\"id\": 701459, \"suggestedTranslation\": \"Mỗi lá bài bị loại bỏ\\n+7 chip\", \"rating\": 9.0},\n  {\"id\": 701460, \"suggestedTranslation\": \"Mỗi lá Chuồn được giữ lại\\n+15 chip\", \"rating\": 8.5},\n  {\"id\": 701461, \"suggestedTranslation\": \"Mỗi lá Cơ bị bỏ +15 chip\\nMỗi lá Cơ trên tay -11 chip +1 đa năng\", \"rating\": 8.5},\n  {\"id\": 701462, \"suggestedTranslation\": \"Mỗi quân bài hình người được giữ lại\\n+10 chip cho mỗi quân bài hình người\", \"rating\": 8.5},\n  {\"id\": 701463, \"suggestedTranslation\": \"Mỗi lá Cơ được giữ một lần\\nRồi bị loại bỏ +2 đa năng\", \"rating\": 8.5},\n  {\"id\": 701631, \"suggestedTranslation\": \"Cậu có nghe thấy gì không?\\nCậu không nghĩ chúng ta đang bị theo dõi đấy chứ?\", \"rating\": 9.0},\n  {\"id\": 701634, \"suggestedTranslation\": \"Có một vụ án mạng bí ẩn vừa xảy ra ở đây...\\nVà ơn trời, năm sau chúng ta lại được quay lại đây! Cah-cah-cah!\", \"rating\": 9.0},\n  {\"id\": 701642, \"suggestedTranslation\": \"Nếu tao ăn nữa chắc tao nổ tung mất.\\nHmm, nổ... bỏng ngô... mmmmmm...\", \"rating\": 9.0},\n  {\"id\": 701643, \"suggestedTranslation\": \"Mày có nghĩ chúng nó đang cố vỗ béo tụi mình để ăn thịt không?\\nKhông... trông chúng không thông minh đến thế đâu.\", \"rating\": 9.0},\n  {\"id\": 701652, \"suggestedTranslation\": \"Mấy món ăn nhẹ đó trông ngon quá...\\nChắc chúng nó sẽ không phiền đâu nếu mình lén cắn một miếng nhỉ...\", \"rating\": 9.0},\n  {\"id\": 701667, \"suggestedTranslation\": \"Được nghỉ ngơi đôi cánh chút thế này thật thích.\\nBọn mình thường chẳng thể ở một chỗ quá lâu.\", \"rating\": 9.0},\n  {\"id\": 701668, \"suggestedTranslation\": \"Cậu có thấy người phụ nữ trông coi Hội Chợ Quạ vào ban đêm không?\\nQuả là rợn tóc gáy.\", \"rating\": 9.0},\n  {\"id\": 701676, \"suggestedTranslation\": \"Cậu ở đây suốt cả năm luôn á?\\nChà, không có cánh chắc vất vả lắm nhỉ.\", \"rating\": 9.0},\n  {\"id\": 701682, \"suggestedTranslation\": \"Không thể tin nổi là cậu chưa từng thấy Hội Chợ Quạ trước khi bọn mình tới đấy!\\nCậu bỏ lỡ khối thứ hay ho rồi.\", \"rating\": 9.0},\n  {\"id\": 701708, \"suggestedTranslation\": \"\\\"Chưa đến giữa hè\\\" mà bạn lại nói thế á? Này bạn hiền, con chim dậy sớm mới bắt được sâu chứ!\", \"rating\": 9.5},\n  {\"id\": 701720, \"suggestedTranslation\": \"\\\"Chưa đến giữa hè\\\" mà bạn lại nói thế á? Này bạn hiền, con chim dậy sớm mới bắt được sâu chứ!\", \"rating\": 9.5},\n  {\"id\": 701890, \"suggestedTranslation\": \"Chắc nó chỉ có tác dụng với Merm thôi.\", \"rating\": 9.0},\n  {\"id\": 701892, \"suggestedTranslation\": \"Bò Lai của tôi đã được buộc lại rồi.\", \"rating\": 9.5},\n  {\"id\": 701893, \"suggestedTranslation\": \"Con Bò Lai của tôi có vẻ hơi tăng động.\", \"rating\": 9.0},\n  {\"id\": 702070, \"suggestedTranslation\": \"Không, không! Cậu đi ngược đường rồi!\", \"rating\": 9.0},\n  {\"id\": 702157, \"suggestedTranslation\": \"Tôi đang bận chết đuối thì tự dưng có thứ trồi lên... là tôi!\", \"rating\": 9.5},\n  {\"id\": 702158, \"suggestedTranslation\": \"Tôi ghét bị bỏ lửng trong sự hồi-\", \"rating\": 8.5},\n  {\"id\": 702274, \"suggestedTranslation\": \"Tôi có dự cảm chẳng lành là thứ này đáng lẽ nên nằm ở vùng nước nông.\", \"rating\": 9.0},\n  {\"id\": 702280, \"suggestedTranslation\": \"Câu hò đó chỉ có thể mang một ý nghĩa duy nhất...\", \"rating\": 9.0},\n  {\"id\": 702444, \"suggestedTranslation\": \"Chết đi, nai cái!\", \"rating\": 9.0},\n  {\"id\": 702446, \"suggestedTranslation\": \"Heo con, heo con mau ra đây nào!\", \"rating\": 9.0},\n  {\"id\": 702483, \"suggestedTranslation\": \"Trông bạn giống hệt nhưng lại khác biệt.\", \"rating\": 9.0},\n  {\"id\": 702542, \"suggestedTranslation\": \"Dù nó đã làm gì đi nữa, thì giờ nó cũng ngưng rồi.\", \"rating\": 9.0},\n  {\"id\": 702554, \"suggestedTranslation\": \"Trông vừa đáng sợ lại vừa đầy bánh răng.\", \"rating\": 9.0},\n  {\"id\": 702610, \"suggestedTranslation\": \"Cuốn băng này thực sự đang chắp cánh bay xa.\", \"rating\": 9.0},\n  {\"id\": 702627, \"suggestedTranslation\": \"Tôi từng đốt áo vest của mình trước khi đi xem kịch. Tôi gọi đó là ủi đồ đầy tính kịch.\", \"rating\": 9.0},\n  {\"id\": 702689, \"suggestedTranslation\": \"Dính quá không bước nổi.\", \"rating\": 9.0},\n  {\"id\": 702779, \"suggestedTranslation\": \"Nó không thể bảo vệ thuyền ván khỏi mọi thứ, nhưng ít ra thì cũng rất hữu ích.\", \"rating\": 9.5},\n  {\"id\": 702781, \"suggestedTranslation\": \"Nó giúp thuyền ván có thêm chút vỏ bảo vệ.\", \"rating\": 9.5},\n  {\"id\": 702849, \"suggestedTranslation\": \"Nếu không có thứ này, thì nó chỉ là một cục bơ.\", \"rating\": 9.5},\n  {\"id\": 702961, \"suggestedTranslation\": \"Trông... thật mất tự nhiên.\", \"rating\": 9.0},\n  {\"id\": 702993, \"suggestedTranslation\": \"Cẩn thận đấy, nó sắp thức giấc rồi.\", \"rating\": 9.0},\n  {\"id\": 703000, \"suggestedTranslation\": \"Tôi đổi cái bát to hơn được không? Cái này trông hơi bị còi cọc đấy.\", \"rating\": 9.5},\n  {\"id\": 703114, \"suggestedTranslation\": \"Mmmmm! Chín rồi, ăn thôi!\", \"rating\": 9.0},\n  {\"id\": 703141, \"suggestedTranslation\": \"Đúng là một cái vuốt đáng báo động!\", \"rating\": 9.0},\n  {\"id\": 703146, \"suggestedTranslation\": \"Mày sẽ không bao giờ làm điều gì xấu xa đâu, đúng chứ?\", \"rating\": 9.0},\n  {\"id\": 703191, \"suggestedTranslation\": \"Nó đang nhìn chằm chằm vào mình à? ...Chắc là không.\", \"rating\": 9.0},\n  {\"id\": 703261, \"suggestedTranslation\": \"Nó nặng bao nhiêu vàng thì đáng giá bấy nhiêu.\", \"rating\": 9.0},\n  {\"id\": 703305, \"suggestedTranslation\": \"Lớn lên nào mấy cưng ơi!\", \"rating\": 9.0},\n  {\"id\": 703395, \"suggestedTranslation\": \"Nó sống lại rồi! Ơ khoan, chưa.\", \"rating\": 9.0},\n  {\"id\": 703403, \"suggestedTranslation\": \"Đây rốt cuộc là... lũ ếch nhồi trong bụng cá hả?\", \"rating\": 9.5},\n  {\"id\": 703446, \"suggestedTranslation\": \"\\\"Gớm ghiếc\\\" là chuẩn xác luôn!\", \"rating\": 9.0},\n  {\"id\": 703458, \"suggestedTranslation\": \"Chúng đang hứa hẹn ban cho tôi... tri thức.\", \"rating\": 9.0},\n  {\"id\": 703477, \"suggestedTranslation\": \"Chỗ ăn chỗ ở gói gọn trong một.\", \"rating\": 9.0},\n  {\"id\": 703514, \"suggestedTranslation\": \"Tóc ướt trông cũng được phết... khổ nỗi lúc khô mới là vấn đề.\", \"rating\": 9.0},\n  {\"id\": 703594, \"suggestedTranslation\": \"Cửa hàng này vắng-trà (trống trơn).\", \"rating\": 9.0},\n  {\"id\": 703605, \"suggestedTranslation\": \"Tôi... đã không chăm sóc nó cho tốt.\", \"rating\": 9.0},\n  {\"id\": 703634, \"suggestedTranslation\": \"Nấu chín hồng hào đẹp mắt, nhưng về mặt đạo đức thì vẫn xám xịt.\", \"rating\": 9.0},\n  {\"id\": 703717, \"suggestedTranslation\": \"Mặc cái này chắc tôi sẽ có đủ sức để biểu diễn thêm vài trò mạo hiểm.\", \"rating\": 9.0},\n  {\"id\": 703732, \"suggestedTranslation\": \"Mặc cái này vào mấy cú đấm của tôi sẽ thấm hơn một chút.\", \"rating\": 9.0},\n  {\"id\": 703740, \"suggestedTranslation\": \"Nóng quá không dám động vào.\", \"rating\": 9.0},\n  {\"id\": 703753, \"suggestedTranslation\": \"Một nơi tuyệt vời hệt như bao nơi khác.\", \"rating\": 9.0},\n  {\"id\": 703957, \"suggestedTranslation\": \"Thối hoắc, bù lại tầm nhìn cực tốt.\", \"rating\": 9.0},\n  {\"id\": 703986, \"suggestedTranslation\": \"Đêm nay trăng tròn.\", \"rating\": 9.5},\n  {\"id\": 703987, \"suggestedTranslation\": \"Đêm nay trăng non.\", \"rating\": 9.5},\n  {\"id\": 703988, \"suggestedTranslation\": \"Trăng đang khuyết dần.\", \"rating\": 9.5},\n  {\"id\": 703989, \"suggestedTranslation\": \"Trăng đang tròn dần.\", \"rating\": 9.5},\n  {\"id\": 704005, \"suggestedTranslation\": \"Chắc tôi sẽ gọi nó là \\\"Hạt Higgsbury.\\\"\", \"rating\": 9.0},\n  {\"id\": 704013, \"suggestedTranslation\": \"Có cảm giác như nó đang chờ đợi thứ gì đó.\", \"rating\": 9.0},\n  {\"id\": 704018, \"suggestedTranslation\": \"Chắc nó đang tích tụ để làm gì đó.\", \"rating\": 9.0},\n  {\"id\": 704069, \"suggestedTranslation\": \"Một cây nấm bự mang hơi hướng khoa học.\", \"rating\": 9.0},\n  {\"id\": 704089, \"suggestedTranslation\": \"Tôi ngưỡng mộ sự chết-tâm của nó.\", \"rating\": 9.0},\n  {\"id\": 704128, \"suggestedTranslation\": \"Nó thực sự mang mái chèo ra chiến trường.\", \"rating\": 9.0},\n  {\"id\": 704144, \"suggestedTranslation\": \"Mấy con cá sẽ không biết tuyết rơi trúng đầu từ lúc nào đâu!\", \"rating\": 9.5},\n  {\"id\": 704153, \"suggestedTranslation\": \"Tôi đã tốn rất nhiều nốt thăng trầm (khó khăn) mới bắt được nó đấy.\", \"rating\": 9.0},\n  {\"id\": 704154, \"suggestedTranslation\": \"Tôi không hề bốc phét (sư tử) về năng khiếu câu cá của mình đâu!\", \"rating\": 9.0},\n  {\"id\": 704190, \"suggestedTranslation\": \"Chúng ta nên gắn thêm chuông Bò Lai vào.\", \"rating\": 9.5},\n  {\"id\": 704304, \"suggestedTranslation\": \"Tiến lên, khám phá thôi!\", \"rating\": 9.0},\n  {\"id\": 704305, \"suggestedTranslation\": \"Tiến lên, khám phá thôi!\", \"rating\": 9.0},\n  {\"id\": 704341, \"suggestedTranslation\": \"Cái này đòi hỏi chút sự chú-lều (chú ý).\", \"rating\": 9.5},\n  {\"id\": 704382, \"suggestedTranslation\": \"Một cái bát sáng bóng.\", \"rating\": 9.5},\n  {\"id\": 704390, \"suggestedTranslation\": \"Hàng thật giá trị thật ở đây chứ đâu.\", \"rating\": 9.0},\n  {\"id\": 704394, \"suggestedTranslation\": \"Chắc là chứa đầy vitamin đấy.\", \"rating\": 9.0},\n  {\"id\": 704397, \"suggestedTranslation\": \"Chắc tôi nên đem dâng nó lên Bệ Thờ Của Gnaw.\", \"rating\": 9.5},\n  {\"id\": 704407, \"suggestedTranslation\": \"Làm tôi nhớ đến bà vú em cũ của mình.\", \"rating\": 9.0},\n  {\"id\": 704429, \"suggestedTranslation\": \"Thuật ngữ khoa học là: \\\"Vật nhọn hoắt\\\".\", \"rating\": 9.0},\n  {\"id\": 704443, \"suggestedTranslation\": \"Lại là một ngõ cụt.\", \"rating\": 9.0},\n  {\"id\": 704444, \"suggestedTranslation\": \"Trông có vẻ đậm chất khoa học.\", \"rating\": 9.0},\n  {\"id\": 704488, \"suggestedTranslation\": \"Chảy ra nào, nhựa cây ơi.\", \"rating\": 9.5},\n  {\"id\": 704582, \"suggestedTranslation\": \"Một bụi cây... từ trên mặt trăng!\", \"rating\": 9.0},\n  {\"id\": 704589, \"suggestedTranslation\": \"Hân hạnh được làm quen (gai băng) với bạn.\", \"rating\": 9.5},\n  {\"id\": 704620, \"suggestedTranslation\": \"Cay... quá... cơ...!\", \"rating\": 9.0},\n  {\"id\": 704627, \"suggestedTranslation\": \"Được khai thác sạch... sạch bách rồi!\", \"rating\": 9.0},\n  {\"id\": 704669, \"suggestedTranslation\": \"Đúng là một nồi súp mướp tây hải sản khổng lồ.\", \"rating\": 9.5},\n  {\"id\": 704678, \"suggestedTranslation\": \"Cháy rụi chẳng còn đường đi.\", \"rating\": 9.0},\n  {\"id\": 704918, \"suggestedTranslation\": \"Cần đồ ăn gấp lắm rồi phải không, hả?\", \"rating\": 9.0},\n  {\"id\": 704919, \"suggestedTranslation\": \"Nó đang chợp mắt một lát.\", \"rating\": 9.0},\n  {\"id\": 704923, \"suggestedTranslation\": \"Với thứ này tôi chắc chắn có thể vượt không gian và thời gian!\", \"rating\": 9.0},\n  {\"id\": 704991, \"suggestedTranslation\": \"Nó đã nguội bớt nhưng vẫn có thể gây ra chút sát thương.\", \"rating\": 9.0},\n  {\"id\": 705070, \"suggestedTranslation\": \"Một chiếc vòi nhẹ nhàng thoáng mát.\", \"rating\": 9.0},\n  {\"id\": 705134, \"suggestedTranslation\": \"Mong là món này không làm ai phải hóa lươn!\", \"rating\": 9.5},\n  {\"id\": 705191, \"suggestedTranslation\": \"Hỏng nặng quá không sửa nổi nhưng tôi có thể tháo linh kiện ra tận dụng.\", \"rating\": 9.0},\n  {\"id\": 705258, \"suggestedTranslation\": \"Nếu không có %s, chắc tôi thành người tối cổ rồi!\", \"rating\": 9.0},\n  {\"id\": 705292, \"suggestedTranslation\": \"Chúng ta đang bị vây hãm rồi!\", \"rating\": 9.0},\n  {\"id\": 705308, \"suggestedTranslation\": \"Có vẻ cậu vừa chuyển từ \\\"bảnh tỏn\\\" thành \\\"bấm chai\\\".\", \"rating\": 9.0},\n  {\"id\": 705316, \"suggestedTranslation\": \"Tôi sẽ cuộn một tờ giấy cói lại cho chắc ăn.\", \"rating\": 9.5},\n  {\"id\": 705325, \"suggestedTranslation\": \"%s không mang theo vật sắc nhọn nào đâu nhỉ?\", \"rating\": 9.0},\n  {\"id\": 705383, \"suggestedTranslation\": \"Tôi có thể sửa cho nó chạy được, nếu Winona đang bận.\", \"rating\": 9.0},\n  {\"id\": 705471, \"suggestedTranslation\": \"%s dạo này có vẻ hơi chán đời (nhựa cây)...\", \"rating\": 9.5},\n  {\"id\": 705473, \"suggestedTranslation\": \"Cậu có giận dai như đỉa nếu tôi không hồi sinh cậu không, %s?\", \"rating\": 9.0},\n  {\"id\": 705636, \"suggestedTranslation\": \"Thứ này sẽ giúp cải thiện sức bền cho Cà Ruột của tôi.\", \"rating\": 9.5},\n  {\"id\": 705688, \"suggestedTranslation\": \"Đúng là bài đăng trên cột\", \"rating\": 9.5},\n  {\"id\": 705769, \"suggestedTranslation\": \"Này trong lúc cậu đang ở đây, có muốn nghe một câu chuyện rùng rợn tôi vừa nghe trên đài không?\", \"rating\": 9.0},\n  {\"id\": 705938, \"suggestedTranslation\": \"Cái này làm tôi nhớ đến một chương trình phát thanh kể về một anh chàng bị sét đánh rồi biến thành người điện thuần khiết và-\", \"rating\": 9.5},\n  {\"id\": 705958, \"suggestedTranslation\": \"Tiếng kêu đó có nghĩa là xuất phát! Đi thôi!!\", \"rating\": 9.0},\n  {\"id\": 705967, \"suggestedTranslation\": \"Này đ-đợi đã- tôi tưởng chúng ta có thể làm bạn chứ!\", \"rating\": 9.0},\n  {\"id\": 706004, \"suggestedTranslation\": \"Cái này... ựm... hơi nặng đấy...\", \"rating\": 9.0},\n  {\"id\": 706010, \"suggestedTranslation\": \"Hừm... cho tôi... thêm phút nữa...\", \"rating\": 9.0},\n  {\"id\": 706011, \"suggestedTranslation\": \"Sao mình lại... làm cái trò này... nữa nhỉ...?\", \"rating\": 9.0},\n  {\"id\": 706029, \"suggestedTranslation\": \"Tôi phải 'gác chân' lại đã. Hiểu ý tôi chứ, Wobes?\", \"rating\": 9.0},\n  {\"id\": 706045, \"suggestedTranslation\": \"Tôi ư... hình như mất dấu rồi...\", \"rating\": 9.0},\n  {\"id\": 706066, \"suggestedTranslation\": \"Được rồi, tớ nhắm mắt lại đây! Ba... hai... một...!\", \"rating\": 9.0},\n  {\"id\": 706070, \"suggestedTranslation\": \"W-Woby...? Ôi... chuyện gì thế này?\", \"rating\": 9.0},\n  {\"id\": 706078, \"suggestedTranslation\": \"Hà! Chắc chắn chúng ta chỉ gặp một cặp thôi, Woby! Chúng là quân cờ mà!\", \"rating\": 9.0},\n  {\"id\": 706095, \"suggestedTranslation\": \"Khỉ thật, chắc tớ làm sai ở đâu rồi...\", \"rating\": 9.0},\n  {\"id\": 706150, \"suggestedTranslation\": \"Đúng là tuyệt cú mèo (trò đùa) luôn!\", \"rating\": 9.0},\n  {\"id\": 706189, \"suggestedTranslation\": \"Tiếc quá... nó chạy mất tiêu rồi.\", \"rating\": 9.0},\n  {\"id\": 706221, \"suggestedTranslation\": \"Theo anh nào, cô bé!\", \"rating\": 9.0},\n  {\"id\": 706253, \"suggestedTranslation\": \"Ngồi yên đấy nhé, cô bé!\", \"rating\": 9.0},\n  {\"id\": 706316, \"suggestedTranslation\": \"Chà, đúng là may mắn khi anh ấy mang theo thứ đó bên mình!\", \"rating\": 9.0},\n  {\"id\": 706336, \"suggestedTranslation\": \"Đó là hòn đá à? Ơ không, gốc đá (gốc cây) mà!\", \"rating\": 9.5},\n  {\"id\": 706390, \"suggestedTranslation\": \"Tôi sắp trở thành nửa người nửa máy rồi!\", \"rating\": 9.0},\n  {\"id\": 706513, \"suggestedTranslation\": \"Xin lỗi nhé, bé bò Lai.\", \"rating\": 9.5},\n  {\"id\": 706531, \"suggestedTranslation\": \"Hay là chúng ta đeo nó vào vòng cổ của em nhé, Woby?\", \"rating\": 9.0},\n  {\"id\": 706576, \"suggestedTranslation\": \"Tôi nên vẽ vài hình thân thiện lên đó, để mọi người biết chúng ta là hải tặc tốt bụng.\", \"rating\": 9.0},\n  {\"id\": 706636, \"suggestedTranslation\": \"Chà, ừm... chắc vẫn còn nhiều thứ tệ hơn để dùng làm gối nhỉ?\", \"rating\": 9.0},\n  {\"id\": 706651, \"suggestedTranslation\": \"Câu cá là một phần 'cực kỳ' (reel-y) quan trọng trong sinh tồn nơi hoang dã. Hiểu ý tớ không? Cực-kỳ-cá (reel-y)?\", \"rating\": 9.0},\n  {\"id\": 706732, \"suggestedTranslation\": \"Nhớ là đừng có đuổi theo quả bóng này đấy nhé, Woby!\", \"rating\": 9.0},\n  {\"id\": 706737, \"suggestedTranslation\": \"Hứa là không đuổi theo quả bóng nhé, Woby?\", \"rating\": 9.0},\n  {\"id\": 706751, \"suggestedTranslation\": \"Làm ơn đi vào giữa giùm tôi với!\", \"rating\": 9.0},\n  {\"id\": 706878, \"suggestedTranslation\": \"Bức tượng này thật là mê-cung-hồn (a-maze-ing)! Hiểu ý tớ không?\", \"rating\": 9.0},\n  {