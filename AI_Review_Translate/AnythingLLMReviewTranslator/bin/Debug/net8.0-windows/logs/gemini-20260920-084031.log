ating\":8.5},\n  {\"id\":770932,\"suggestedTranslation\":\"Bao bọc bản thân bằng những chiếc lá mặt trăng sắc bén.\",\"rating\":8.5},\n  {\"id\":770933,\"suggestedTranslation\":\"Trở thành kẻ gai góc nhất trong số chúng.\",\"rating\":8.5},\n  {\"id\":770934,\"suggestedTranslation\":\"Bảo vệ thể xác, nhưng mặc kệ tâm trí.\",\"rating\":8.5},\n  {\"id\":770935,\"suggestedTranslation\":\"Một chiếc áo choàng ác mộng để xua đuổi ánh sáng.\",\"rating\":8.5},\n  {\"id\":770936,\"suggestedTranslation\":\"Chỉ tay vào thế giới. Hoặc các biển báo.\",\"rating\":9.0},\n  {\"id\":770937,\"suggestedTranslation\":\"Chặt đổ cây cối!\",\"rating\":9.0},\n  {\"id\":770938,\"suggestedTranslation\":\"Mang theo nhiều đồ hơn.\",\"rating\":9.0},\n  {\"id\":770939,\"suggestedTranslation\":\"Ai lại không thích bóng bay cơ chứ?\",\"rating\":8.5},\n  {\"id\":770940,\"suggestedTranslation\":\"Mở đầu tuyệt vời cho mọi câu chuyện!\",\"rating\":8.5},\n  {\"id\":770941,\"suggestedTranslation\":\"Lan tỏa chút niềm vui.\",\"rating\":8.5},\n  {\"id\":770942,\"suggestedTranslation\":\"Giúp bước chân bạn trở nên thanh thoát.\",\"rating\":8.5},\n  {\"id\":770943,\"suggestedTranslation\":\"Giá mà có cách nào đó dễ dàng hơn.\",\"rating\":8.5},\n  {\"id\":770944,\"suggestedTranslation\":\"Phao bóng bay chuyên dụng để đi thuyền.\",\"rating\":8.5},\n  {\"id\":770945,\"suggestedTranslation\":\"Chữa lành các vết thương nhẹ.\",\"rating\":9.0},\n  {\"id\":770946,\"suggestedTranslation\":\"Miếng băng được làm từ đôi cánh bướm.\",\"rating\":8.5},\n  {\"id\":770947,\"suggestedTranslation\":\"Mớ khoa học này thật là... vắt kiệt sức lực.\",\"rating\":8.5},\n  {\"id\":770948,\"suggestedTranslation\":\"Hoa cho mùa xuân ư? Thật đột phá làm sao.\",\"rating\":8.5},\n  {\"id\":770949,\"suggestedTranslation\":\"Mở khóa bí mật giả kim thuật hồ nước nóng.\",\"rating\":9.0},\n  {\"id\":770950,\"suggestedTranslation\":\"Lưu trữ tất cả những bản hit đỉnh nhất của bạn.\",\"rating\":8.5},\n  {\"id\":770951,\"suggestedTranslation\":\"