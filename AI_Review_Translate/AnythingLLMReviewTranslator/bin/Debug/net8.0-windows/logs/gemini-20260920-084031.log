        "parts": [
          {
            "text": "[\n  {\"id\":772038,\"suggestedTranslation\":\"Wigfrid và đồng minh ở gần sẽ hồi máu khi chiến đấu. Wigfrid cũng sẽ hồi phục thêm một chút.\\n\\nĐây là Bài hát Chiến đấu. Wigfrid phải tiếp tục hát để duy trì hiệu ứng.\",\"rating\":9.0},\n  {\"id\":772039,\"suggestedTranslation\":\"Khiến kẻ địch ở gần hoảng sợ.\\n\\nĐây là Khúc Hồi Sức vì nó phát huy tác dụng ngay lập tức.\",\"rating\":8.5},\n  {\"id\":772040,\"suggestedTranslation\":\"Hồi sinh tối đa 2 người chơi đồng minh ở gần.\\n\\nĐây là Khúc Hồi Sức vì nó phát huy tác dụng ngay lập tức.\",\"rating\":8.5},\n  {\"id\":772041,\"suggestedTranslation\":\"Thu hút sự chú ý của kẻ địch ở gần.\\n\\nĐây là Khúc Hồi Sức vì nó phát huy tác dụng ngay lập tức.\",\"rating\":8.5},\n  {\"id\":772042,\"suggestedTranslation\":\"Wigfrid và các đồng minh gần đó nhận ít hơn 10% sát thương từ kẻ địch thuộc Liên Kết Mặt Trăng và gây thêm 5% sát thương cho kẻ địch thuộc Liên Kết Bóng Đêm.\\n\\nĐây là Bài hát Chiến đấu. Wigfrid phải tiếp tục hát để duy trì hiệu ứng.\",\"rating\":8.5},\n  {\"id\":772043,\"suggestedTranslation\":\"Những sinh vật đáng sợ dường như chỉ đáng sợ một nửa khi bạn nghe bài hát hay này.\\n\\nĐây là Bài hát Chiến đấu. Wigfrid phải tiếp tục hát để duy trì hiệu ứng.\",\"rating\":8.5},\n  {\"id\":772044,\"suggestedTranslation\":\"Wigfrid và các đồng minh ở gần sẽ phục hồi tinh thần khi chiến đấu.\\n\\nĐây là Bài hát Chiến đấu. Wigfrid phải tiếp tục hát để duy trì hiệu ứng.\",\"rating\":9.0},\n  {\"id\":772045,\"suggestedTranslation\":\"Wigfrid và các đồng minh ở gần sẽ nhận ít hơn 10% sát thương từ kẻ thù thuộc Liên Kết Bóng Đêm và gây thêm 5% sát thương cho kẻ địch thuộc Liên Kết Mặt Trăng.\\n\\nĐây là Bài hát Chiến đấu. Wigfrid phải tiếp tục hát để duy trì hiệu ứng.\",\"rating\":8.5},\n  {\"id\":772046,\"suggestedTranslation\":\"Một chiếc túi có thể mang theo với 6 ô chứa được thức ăn đã chế biến.\\n\\nThức ăn bảo quản bên trong sẽ giữ được rất lâu.\",\"rating\":8.5},\n  {\"id\":772047,\"suggestedTranslation\":\"Tốc độ đói giảm 25% khi mặc.\",\"rating\":9.0},\n  {\"id\":772048,\"suggestedTranslation\":\"Nếu có từ 6 bông hoa trở lên xung quanh thùng ong, ong sẽ sản xuất mật ong bên trong thùng.\",\"rating\":9.0},\n  {\"id\":772049,\"suggestedTranslation\":\"Hãy đề phòng mùa giao phối hung hãn.\\n\\nCho ăn và chăm sóc một trong những con thú này, và biết đâu bạn có thể gắn yên cưỡi lên chúng.\",\"rating\":9.0},\n  {\"id\":772051,\"suggestedTranslation\":\"Người sống sót có thể buộc một con bò lai đã gắn kết vào trạm chăm sóc này, sau đó thêm hoặc thay đổi trang phục cho bò lai.\",\"rating\":8.5},\n  {\"id\":772052,\"suggestedTranslation\":\"Khiến người mặc trở nên thân thiện với bò lai đang động dục.\",\"rating\":9.0},\n  {\"id\":772054,\"suggestedTranslation\":\"Đặt tên và liên kết với một con bò lai tại một thời điểm. Bò lai đã liên kết sẽ đi theo người giữ, ngay cả khi vào hang động và khi ngoại tuyến.\",\"rating\":9.0},\n  {\"id\":772055,\"suggestedTranslation\":\"Khả năng bảo vệ của chiếc mũ này thực sự chỉ phát huy tác dụng với ong và các sinh vật giống ong.\",\"rating\":9.0},\n  {\"id\":772056,\"suggestedTranslation\":\"Tổ ong khổng lồ này chứa đầy mật ong ngọt ngào và những bất ngờ khác.\",\"rating\":8.5},\n  {\"id\":772057,\"suggestedTranslation\":\"Đóng băng giai đoạn phát triển của cây. Điều này khiến cây không thể sản xuất, nhưng cũng không thu hút ký sinh trùng.\",\"rating\":8.5},\n  {\"id\":772058,\"suggestedTranslation\":\"Một người bạn mạnh mẽ khi tâm trí Willow đứng trước bờ vực điên loạn.\",\"rating\":9.0},\n  {\"id\":772059,\"suggestedTranslation\":\"Có thể nhốt chim vào lồng này.\\n\\nHãy nhớ cho chim ăn.\\n\\nNếu cho chim ăn trái cây hoặc rau củ, nó sẽ thải ra hạt của những loại cây trồng đó.\\n\\nNếu cho chim ăn thịt, nó có thể đẻ trứng.\",\"rating\":9.0},\n  {\"id\":772060,\"suggestedTranslation\":\"Tăng tinh thần đồng thời làm mát người mặc.\",\"rating\":9.0},\n  {\"id\":772061,\"suggestedTranslation\":\"Nó dạy bạn cách chế tạo một vật phẩm cụ thể.\",\"rating\":9.0},\n  {\"id\":772062,\"suggestedTranslation\":\"Bắn ra các luồng đạn đóng băng.\",\"rating\":9.0},\n  {\"id\":772063,\"suggestedTranslation\":\"Có thể nạp đạn đại bác.\\n\\nSau khi nạp, nó có thể nhắm và bắn. Hướng bắn có thể thay đổi bằng cách đứng ở các phía khác nhau cạnh nó trước khi ngắm.\",\"rating\":9.0},\n  {\"id\":772064,\"suggestedTranslation\":\"Công trình này trước tiên phải được ghép nối với Đèn Hiệu Tự Lái.\\n\\nSau khi ghép nối, nó sẽ tự kéo về phía đèn hiệu.\\n\\nNếu ở trên thuyền, nó sẽ tăng tốc độ của thuyền theo hướng đó.\",\"rating\":9.0},\n  {\"id\":772065,\"suggestedTranslation\":\"Vá các chỗ rò rỉ trên thuyền.\",\"rating\":9.0},\n  {\"id\":772066,\"suggestedTranslation\":\"Một giải pháp tạm thời cho các vết rò rỉ. Thuyền bị thủng ư? Hãy dùng miếng vá tảo bẹ... rồi miếng nữa... và miếng nữa...\",\"rating\":9.0},\n  {\"id\":772067,\"suggestedTranslation\":\"Một chiếc thuyền kiên cố được tích hợp sẵn thùng chứa 16 ô. Chúng không còn được chế tạo tốt như trước nữa.\",\"rating\":9.0},\n  {\"id\":772068,\"suggestedTranslation\":\"Một tấm cản giống như đá không bị tổn hại khi va vào đất liền. Đỡ lấy này, đất liền!\",\"rating\":9.0},\n  {\"id\":772069,\"suggestedTranslation\":\"Hấp thụ sát thương va chạm cho chiếc thuyền mà nó được gắn lên. Có thể được sửa chữa bằng tảo bẹ.\",\"rating\":9.0},\n  {\"id\":772070,\"suggestedTranslation\":\"Hấp thụ sát thương va chạm cho chiếc thuyền mà nó được gắn lên. Có thể được sửa chữa bằng vỏ sò vỡ.\",\"rating\":9.0},\n  {\"id\":772071,\"suggestedTranslation\":\"Một tủ chứa 20 ô dành cho Sách và Giấy.\\n\\nSách bên trong sẽ hồi 1 độ bền sau mỗi 30 giây, gấp đôi nếu Wickerbottom ở gần.\\n\\nNgoài ra, thư viện hoạt động như một Máy Giả Kim, cung cấp cho những người sống sót ở gần những công thức chế tạo mới.\",\"rating\":9.0},\n  {\"id\":772072,\"suggestedTranslation\":\"Triệu tập 2 con ong càu nhàu đi theo. Tối đa 16 con cùng một lúc.\",\"rating\":9.0},\n  {\"id\":772073,\"suggestedTranslation\":\"Triệu tập tối đa 20 con chim hạ cánh xuống gần đó.\",\"rating\":9.0},\n  {\"id\":772074,\"suggestedTranslation\":\"Giáng xuống hơn một chục tia sét không kiểm soát.\",\"rating\":9.0},\n  {\"id\":772075,\"suggestedTranslation\":\"Dập tắt tất cả các đám cháy đang bùng cháy và âm ỉ gần đó, đồng thời tạo ra hoặc sạc năng lượng cho một cây Bút Lửa.\",\"rating\":9.0},\n  {\"id\":772076,\"suggestedTranslation\":\"Triệu tập một đàn cá đại dương đến gần.\",\"rating\":9.0},\n  {\"id\":772077,\"suggestedTranslation\":\"Làm lớn nhanh chóng tối đa 10 loại cây trồng trong vườn hoặc bụi cây ăn quả ở gần.\",\"rating\":9.0},\n  {\"id\":772078,\"suggestedTranslation\":\"Làm lớn nhanh chóng tối đa 15 loại cây trồng trong vườn hoặc bụi cây ăn quả ở gần.\",\"rating\":9.0},\n  {\"id\":772079,\"suggestedTranslation\":\"Triệu tập ánh sáng chiếu xuống trong nửa ngày. Sẽ gây ra động đất trong hang động.\",\"rating\":9.0},\n  {\"id\":772080,\"suggestedTranslation\":\"Triệu tập ánh sáng chiếu xuống trong 2 ngày. Sẽ gây ra động đất trong hang động.\",\"rating\":9.0},\n  {\"id\":772081,\"suggestedTranslation\":\"Chuyển pha mặt trăng hiện tại thành trăng tròn.\",\"rating\":9.0},\n  {\"id\":772082,\"suggestedTranslation\":\"Nếu trời đang mưa, mưa sẽ tạnh. Nếu trời không mưa, mưa sẽ bắt đầu và đồng thời tưới nước cho đất nông trại ở gần.\",\"rating\":9.0},\n  {\"id\":772083,\"suggestedTranslation\":\"Cung cấp cho những người sống sót ở gần một lượt chế tạo đặc biệt. Mỗi lượt cho phép họ chế tạo vật phẩm tiếp theo ở bậc công nghệ cao hơn bình thường một bậc.\",\"rating\":9.0},\n  {\"id\":772084,\"suggestedTranslation\":\"Làm lớn cỏ, cây non và cây cối ở gần, nhưng cỏ sẽ cần được bón phân lại sớm hơn.\",\"rating\":9.0},\n  {\"id\":772085,\"suggestedTranslation\":\"Làm cho các sinh vật ở gần chìm vào giấc ngủ.\",\"rating\":9.0},\n  {\"id\":772086,\"suggestedTranslation\":\"Làm khô những người sống sót ở gần cũng như điều chỉnh nhiệt độ của họ về mức dễ chịu 35 độ.\",\"rating\":9.0},\n  {\"id\":772087,\"suggestedTranslation\":\"Triệu tập một số Xúc Tu không thân thiện ở gần.\",\"rating\":9.0},\n  {\"id\":772088,\"suggestedTranslation\":\"Tạo ra một vùng mạng nhện trên mặt đất giúp làm chậm các sinh vật di chuyển trên đó.\\n\\nNó sẽ biến mất sau 2 phút.\",\"rating\":9.0},\n  {\"id\":772089,\"suggestedTranslation\":\"Bạn phải bắt lại nó sau khi ném đi.\",\"rating\":9.0},\n  {\"id\":772090,\"suggestedTranslation\":\"Có thể ném xuống biển để tạo ra một cặp Cổng Xoáy kết nối với nhau. Thuyền đi sát qua chúng sẽ được dịch chuyển đến lối ra kia.\",\"rating\":8.5},\n  {\"id\":772091,\"suggestedTranslation\":\"Có thể dùng trên bò lai để thu thập lông bò lai.\\n\\nTăng 40% độ vâng lời của bò lai và tăng 1,6% độ thuần hóa mỗi ngày một lần.\",\"rating\":9.0},\n  {\"id\":772092,\"suggestedTranslation\":\"Bắt các sinh vật bay nhỏ và đưa chúng hoặc chiến lợi phẩm của chúng vào kho đồ của bạn.\",\"rating\":9.0},\n  {\"id\":772093,\"suggestedTranslation\":\"Có thể mở ra để giải phóng các vật phẩm bên trong.\",\"rating\":9.0},\n  {\"id\":772094,\"suggestedTranslation\":\"Có thể đóng gói tối đa 4 ô vật phẩm thành một vật phẩm duy nhất để có thể mở ra sử dụng sau.\",\"rating\":9.0},\n  {\"id\":772095,\"suggestedTranslation\":\"Người mặc có thể ẩn nấp dưới bụi rậm và sẽ không bị sinh vật tấn công miễn là chúng không nhìn thấy người sống sót trốn vào đó.\",\"rating\":9.0},\n  {\"id\":772096,\"suggestedTranslation\":\"Khi được đốt nhiên liệu, nó tạo ra ánh sáng và sức nóng.\\n\\nNó cũng có thể nấu chín thức ăn.\\n\\nSẽ biến mất khi hết nhiên liệu.\",\"rating\":9.0},\n  {\"id\":772097,\"suggestedTranslation\":\"Rất nhạy cảm với hơi độc, chúng thường chết khi phát hiện có độc tính quái dị ở gần.\",\"rating\":9.0},\n  {\"id\":772098,\"suggestedTranslation\":\"Một túi chứa 14 ô dùng để đựng Kẹo, Đồ Trang Sức và Đồ Trang Trí.\",\"rating\":9.0},\n  {\"id\":772099,\"suggestedTranslation\":\"Tăng 25% tốc độ di chuyển khi cầm trên tay.\",\"rating\":9.0},\n  {\"id\":772100,\"suggestedTranslation\":\"Cho phép Bàn Cưa được trang bị nó chế tạo những vật phẩm mới.\",\"rating\":9.0},\n  {\"id\":772101,\"suggestedTranslation\":\"Đứng gần thiết bị này sẽ cung cấp cho người sống sót các món Đồ Nội Thất mới để chế tạo.\",\"rating\":9.0},\n  {\"id\":772102,\"suggestedTranslation\":\"Cho phép những người sống sót chế tạo Cuộn Bản Đồ để trao đổi thông tin bản đồ.\\n\\nSử dụng Bản Thiết Kế, Bản Phác Thảo, Mẫu Trang Phục, Trang Sổ Lưu Niệm, Quảng Cáo hoặc Thẻ Công Thức lên bàn này sẽ biến chúng thành Giấy Trống.\",\"rating\":9.0},\n  {\"id\":772103,\"suggestedTranslation\":\"Hang ổ của mèo trúc và là nơi chúng cất giữ những món đồ nhặt được.\\n\\nBạn có thể lấy lại những món đồ đó ở đây, nhưng mèo trúc sẽ không thích đâu.\",\"rating\":9.0},\n  {\"id\":772105,\"suggestedTranslation\":\"Những lỗ thông hơi này có thể phun ra nhiều thứ hơn là chỉ hơi nóng.\",\"rating\":9.0},\n  {\"id\":772106,\"suggestedTranslation\":\"Một món quà được Nữ Hoàng Của Cõi Hằng ban tặng cho bạn, nhằm làm phong phú thêm những cuộc đời tẻ nhạt và vô nghĩa của các ngươi. Cô ấy thậm chí còn chu đáo chuẩn bị cả trang phục và kịch bản!\",\"rating\":9.0},\n  {\"id\":772107,\"suggestedTranslation\":\"Có thể cất giữ đồ đạc trong Chester giống như trong rương.\",\"rating\":9.0},\n  {\"id\":772108,\"suggestedTranslation\":\"Một con quái vật không có trái tim. Nó thèm khát hương vị của chiến lợi phẩm và cả thịt thà.\",\"rating\":9.0},\n  {\"id\":772109,\"suggestedTranslation\":\"Thu hút một đàn cá khi ném xuống đại dương.\",\"rating\":9.0},\n  {\"id\":772110,\"suggestedTranslation\":\"Hoạt động giống như lửa trại, nhưng làm lạnh mọi thứ thay vì sưởi ấm.\",\"rating\":9.0},\n  {\"id\":772111,\"suggestedTranslation\":\"Hoạt động giống như lò lửa, nhưng làm lạnh mọi thứ thay vì sưởi ấm.\",\"rating\":9.0},\n  {\"id\":772112,\"suggestedTranslation\":\"Sẽ hiển thị vị trí của người dùng trên bản đồ cho những người sống sót khác cũng đang cầm La Bàn.\",\"rating\":9.0},\n  {\"id\":772113,\"suggestedTranslation\":\"Cung cấp 24 Chất Dinh Dưỡng khi bón cho Đất Nông Trại.\",\"rating\":9.0},\n  {\"id\":772114,\"suggestedTranslation\":\"Có thể chứa tối đa 6 vật phẩm \\\"ướt\\\" và \\\"khô\\\". Khi có ít nhất 2 vật phẩm, nó sẽ bắt đầu quá trình ủ phân.\\n\\nCàng nhiều vật phẩm, tốc độ ủ phân càng nhanh.\\n\\nQuá trình sẽ nhanh hơn nếu cân bằng giữa vật phẩm \\\"ướt\\\" và \\\"khô\\\".\",\"rating\":9.0},\n  {\"id\":772115,\"suggestedTranslation\":\"Wormwood hồi 8 máu cộng thêm 1 máu/giây trong 32 giây. Wormwood cũng sẽ nở hoa trong 4 phút.\\nĐây đồng thời là phân bón tốt cho việc làm vườn.\",\"rating\":9.0},\n  {\"id\":772116,\"suggestedTranslation\":\"Ghi lại tất cả các món ăn đã nấu và/hoặc đã ăn, cùng với các nguyên liệu dùng để chế biến chúng.\",\"rating\":9.0},\n  {\"id\":772117,\"suggestedTranslation\":\"Tinh chất của sự thấu hiểu... Nhiên liệu của sức mạnh... ...Đang sủi bọt.\",\"rating\":9.0},\n  {\"id\":772118,\"suggestedTranslation\":\"Trang phục dùng trong các vở kịch sân khấu.\",\"rating\":9.0},\n  {\"id\":772119,\"suggestedTranslation\":\"Đứng gần thiết bị này sẽ cung cấp cho người sống sót những công thức chế tạo mới.\",\"rating\":9.0},\n  {\"id\":772120,\"suggestedTranslation\":\"Có một khe cắm hình viên ngọc.\",\"rating\":9.0},\n  {\"id\":772121,\"suggestedTranslation\":\"Những người sống sót có thể tạo ra một thú cưng từ đây để đi theo họ.\",\"rating\":9.0},\n  {\"id\":772122,\"suggestedTranslation\":\"Một thùng chứa 4 ô dùng để nhận nguyên liệu nấu ăn.\\n\\nĐặt 4 vật phẩm vào thùng sẽ cho phép nấu chúng thành một món ăn tùy thuộc vào nguyên liệu ban đầu.\",\"rating\":9.0},\n  {\"id\":772123,\"suggestedTranslation\":\"Có vẻ như cần đến một phép thuật đặc biệt nào đó mới loại bỏ được những thứ kỳ quặc này.\",\"rating\":9.0},\n  {\"id\":772124,\"suggestedTranslation\":\"Đánh văng vật phẩm khỏi kho đồ của mục tiêu.\",\"rating\":9.0},\n  {\"id\":772125,\"suggestedTranslation\":\"Có thể cuốc bỏ để làm lộ ra lớp lõi tối màu hơn làm bằng chất liệu cứng hơn.\",\"rating\":9.0},\n  {\"id\":772126,\"suggestedTranslation\":\"Chơi một ván bài theo cách bạn muốn. Đánh vào nó để xáo bài, nhưng hãy cẩn thận!\",\"rating\":9.0},\n  {\"id\":772127,\"suggestedTranslation\":\"Giúp môi trường xung quanh mát mẻ nếu cầm Nhãn Cầu Deerclops.\\n\\nCháy rừng sẽ không xảy ra ở gần, đồng thời ngăn cây trồng bị khô héo. Nó ảnh hưởng đến tốc độ khô ráo của mọi thứ, bao gồm độ ẩm của đất và tốc độ hỏng hóc.\\n\\nTạo ra các Sông Băng Nhỏ xung quanh theo thời gian.\",\"rating\":9.0},\n  {\"id\":772128,\"suggestedTranslation\":\"Làm phép lên Hang Nhện để trấn an những con nhện ở gần. Hang nhện được làm phép sẽ không phát triển.\",\"rating\":9.0},\n  {\"id\":772129,\"suggestedTranslation\":\"Cải thiện tầm nhìn trong bão cát.\",\"rating\":9.0},\n  {\"id\":772130,\"suggestedTranslation\":\"Một thùng chứa chống cháy với 12 ô.\",\"rating\":9.0},\n  {\"id\":772131,\"suggestedTranslation\":\"Cung cấp một lượng ánh sáng nhỏ và lượng nhiệt lớn giống như lửa trại. Nó cũng có thể dùng để tiêu hủy vật phẩm.\",\"rating\":9.0},\n  {\"id\":772132,\"suggestedTranslation\":\"Chiếc mũ giáp này có thể tự động hồi phục độ bền theo thời gian.\",\"rating\":9.0},\n  {\"id\":772133,\"suggestedTranslation\":\"Khi trang bị, Wolfgang có thể Nâng Tạ để tăng Sức Mạnh.\",\"rating\":9.0},\n  {\"id\":772134,\"suggestedTranslation\":\"Khi trang bị, Wolfgang có thể Nâng Tạ để tăng Sức Mạnh.\\n\\nKhi ném đi, nó làm tăng cái lạnh của các sinh vật ở gần nơi tiếp đất.\",\"rating\":9.0},\n  {\"id\":772135,\"suggestedTranslation\":\"Khi trang bị, Wolfgang có thể Nâng Tạ để tăng Sức Mạnh.\\n\\nTăng nhiệt khi ở gần vật nóng và làm mát khi ở gần vật lạnh.\\n\\nNó sẽ sưởi ấm hoặc làm mát người cầm tùy theo nhiệt độ của nó.\",\"rating\":9.0},\n  {\"id\":772136,\"suggestedTranslation\":\"Khi trang bị, Wolfgang có thể Nâng Tạ để tăng Sức Mạnh.\\n\\nKhi ném đi, nó tạo ra ngọn lửa tại nơi tiếp đất.\",\"rating\":9.0},\n  {\"id\":772137,\"suggestedTranslation\":\"Đây không phải là thức ăn phù hợp cho con người.\",\"rating\":9.0},\n  {\"id\":772138,\"suggestedTranslation\":\"Nếu nó được khảm Thulecite thì có thể dùng cuốc để khai thác.\",\"rating\":9.0},\n  {\"id\":772139,\"suggestedTranslation\":\"Một túi đựng có thể mang theo với 9 ô chứa các Bình Thuốc Tiên.\",\"rating\":9.0},\n  {\"id\":772140,\"suggestedTranslation\":\"Hoạt động như lửa trại trong thời gian duy trì, tạo ra ánh sáng, nhiệt lượng và làm bén lửa các vật ở gần. Nó cũng có thể dùng để nấu ăn.\",\"rating\":9.0},\n  {\"id\":772141,\"suggestedTranslation\":\"Triệu tập Chester khi nhặt lên. Chester sẽ đi theo người giữ. Khi Chester còn sống, con mắt sẽ mở.\",\"rating\":9.0},\n  {\"id\":772142,\"suggestedTranslation\":\"Cho con mắt đang đói này ăn để hồi phục nó.\",\"rating\":9.0},\n  {\"id\":772143,\"suggestedTranslation\":\"Một tòa tháp bắn đạn tầm xa vào các sinh vật thù địch và hồi 12 máu mỗi giây.\",\"rating\":9.0},\n  {\"id\":772144,\"suggestedTranslation\":\"Đào một ô đất thành đất nông trại có thể dùng cuốc xới lên để gieo hạt trồng cây.\",\"rating\":9.0},\n  {\"id\":772145,\"suggestedTranslation\":\"Mỗi lần sử dụng sẽ dập tắt lửa, làm khô và hạ nhiệt độ của những người sống sót xuống 50 độ (tối đa xuống 2.5 độ) trong một khu vực.\",\"rating\":9.0},\n  {\"id\":772146,\"suggestedTranslation\":\"Làm tăng gấp đôi số lượng chim đáp xuống gần người mặc.\",\"rating\":9.0},\n  {\"id\":772147,\"suggestedTranslation\":\"Vẽ vật phẩm gần nhất vào một Bảng Mini.\",\"rating\":9.0},\n  {\"id\":772148,\"suggestedTranslation\":\"Xoay hướng các cấu trúc có thể xoay như hàng rào, bảng hiệu và ghế.\",\"rating\":9.0},\n  {\"id\":772149,\"suggestedTranslation\":\"\\\"Trải nghiệm học tập điện thần kinh cảm ứng qua da\\\" Sử dụng công nghệ điện từ để phóng điện vào các thực thể dẫn điện.\\n\\nKhi được bật, nút T.I.N.G.L.E. sẽ tìm kiếm một nút lân cận khác để liên kết, thiết lập một điện trường giữa hai bên.\\n\\nKhông gây tổn hại thể chất (tổn hại tinh thần thì chưa rõ). Hầu hết các đối tượng sẽ bỏ chạy sau cú sốc điện nhanh.\\n\\nKhuyên người thử nghiệm nên dùng đồ cách nhiệt để tránh trải nghiệm học tập đặc biệt này!\",\"rating\":9.0},\n  {\"id\":772150,\"suggestedTranslation\":\"\\\"Trải nghiệm học tập điện thần kinh cảm ứng qua da\\\" Sử dụng công nghệ điện từ để phóng điện vào các thực thể dẫn điện.\\n\\nKhi được bật, nút T.I.N.G.L.E. sẽ tìm kiếm một nút lân cận khác để liên kết, thiết lập một điện trường giữa hai bên.\\n\\nKhông gây tổn hại thể chất (tổn hại tinh thần thì chưa rõ). Hầu hết các đối tượng sẽ bỏ chạy sau cú sốc điện nhanh.\\n\\nKhuyên người thử nghiệm nên dùng đồ cách nhiệt để tránh trải nghiệm học tập đặc biệt này!\",\"rating\":9.0},\n  {\"id\":772151,\"suggestedTranslation\":\"Khi được đốt nhiên liệu, nó tạo ra ánh sáng và sức nóng.\\n\\nNó cũng có thể nấu chín thức ăn.\\n\\nKhông bị phá hủy khi tiêu thụ hết nhiên liệu.\",\"rating\":9.0},\n  {\"id\":772152,\"suggestedTranslation\":\"Có thể bật và tắt. Khi được tiếp nhiên liệu và bật, nếu có lửa xuất hiện trong phạm vi, nó sẽ bắn ra một quả cầu tuyết để dập tắt.\",\"rating\":9.0},\n  {\"id\":772153,\"suggestedTranslation\":\"Khi đặt trên thuyền hoặc bến cảng, đây là một thùng chứa 20 ô dùng để chứa sinh vật biển. Cá bên trong sẽ chậm bị hỏng hơn.\",\"rating\":9.0},\n  {\"id\":772155,\"suggestedTranslation\":\"Sử dụng cùng với Cần Câu Biển.\",\"rating\":9.0},\n  {\"id\":772156,\"suggestedTranslation\":\"Bộ xương hóa thạch của một sinh vật kỳ lạ.\\n\\nCổ sinh vật học rất khó và việc lắp ráp lại những bộ xương cổ cũng vậy. Không phải tất cả sản phẩm hoàn thiện đều được lắp ráp đúng cách.\",\"rating\":9.0},\n  {\"id\":772157,\"suggestedTranslation\":\"Tăng nhiệt khi ở gần vật nóng và làm mát khi ở gần vật lạnh.\\n\\nNó sẽ sưởi ấm người cầm tùy theo nhiệt độ của nó.\\n\\nKhi nóng, nó chặt hiệu quả hơn một chút và gây thêm sát thương lên các mục tiêu bị đóng băng.\\n\\nMất độ bền khi nguội hẳn, nhưng có thể sửa chữa để hoạt động trở lại bằng cách nung nóng nó lên.\",\"rating\":9.0},\n  {\"id\":772158,\"suggestedTranslation\":\"Tăng nhiệt khi ở gần vật nóng và làm mát khi ở gần vật lạnh.\\n\\nNó sẽ sưởi ấm người cầm tùy theo nhiệt độ của nó.\\n\\nKhi nóng, nó đập hiệu quả hơn một chút và gây thêm sát thương lên các mục tiêu bị đóng băng.\\n\\nMất độ bền khi nguội hẳn, nhưng có thể sửa chữa để hoạt động trở lại bằng cách nung nóng nó lên.\",\"rating\":9.0},\n  {\"id\":772159,\"suggestedTranslation\":\"Tăng nhiệt khi ở gần vật nóng và làm mát khi ở gần vật lạnh.\\n\\nNó sẽ sưởi ấm người cầm tùy theo nhiệt độ của nó.\\n\\nKhi nóng, nó đào hiệu quả hơn một chút và gây thêm sát thương lên các mục tiêu bị đóng băng.\\n\\nMất độ bền khi nguội hẳn, nhưng có thể sửa chữa để hoạt động trở lại bằng cách nung nóng nó lên.\",\"rating\":9.0},\n  {\"id\":772160,\"suggestedTranslation\":\"Tăng nhiệt khi ở gần vật nóng và làm mát khi ở gần vật lạnh.\\n\\nNó sẽ sưởi ấm người cầm tùy theo nhiệt độ của nó.\\n\\nKhi nóng, nó gây thêm sát thương lên các mục tiêu bị đóng băng.\\n\\nMất độ bền khi nguội hẳn, nhưng có thể sửa chữa để hoạt động trở lại bằng cách nung nóng nó lên.\",\"rating\":9.0},\n  {\"id\":772161,\"suggestedTranslation\":\"Tăng nhiệt khi ở gần vật nóng và làm mát khi ở gần vật lạnh.\\n\\nNó sẽ sưởi ấm người cầm tùy theo nhiệt độ của nó.\\n\\nKhi nóng, nó gây thêm sát thương lên các mục tiêu bị đóng băng.\\n\\nMất độ bền khi nguội hẳn, nhưng có thể sửa chữa để hoạt động trở lại bằng cách nung nóng nó lên.\",\"rating\":9.0},\n  {\"id\":772162,\"suggestedTranslation\":\"Ngủ trong đó hồi 1 Tinh Thần và 1 Máu mỗi giây, tiêu hao 1 Đói mỗi giây. Nó đồng thời sưởi ấm người dùng theo thời gian.\",\"rating\":9.0},\n  {\"id\":772163,\"suggestedTranslation\":\"Dịch Nhầy hoàn toàn ngăn chặn sự hư hỏng của thực phẩm đặt bên trong.\",\"rating\":9.0},\n  {\"id\":772164,\"suggestedTranslation\":\"Được Wendy sử dụng để chế tạo Thuốc Tiên Ma.\",\"rating\":9.0},\n  {\"id\":772165,\"suggestedTranslation\":\"Khi trang bị, cho phép Wendy tự uống Thuốc Tiên.\",\"rating\":9.0},\n  {\"id\":772166,\"suggestedTranslation\":\"Abigail sẽ gây sát thương ban đêm ngay cả vào ban ngày và hoàng hôn. Kéo dài 1 ngày.\\n\\nKhi được uống bởi một người không phải ma đang đeo Vòng Hoa Vong Linh:\\n\\nNgười uống có thể nhìn trong bóng tối như một bóng ma.\",\"rating\":9.0},\n  {\"id\":772167,\"suggestedTranslation\":\"Tăng khả năng hồi máu của Abigail từ 1 lên 20 máu mỗi giây. Kéo dài 30 giây.\\n\\nKhi được uống bởi một người không phải ma đang đeo Vòng Hoa Vong Linh:\\n\\nHồi 5 máu mỗi giây trong 20 giây.\",\"rating\":9.0},\n  {\"id\":772168,\"suggestedTranslation\":\"Abigail gây thêm 10 sát thương xuyên giáp khi tấn công và tăng lên 100 khi Abigail ở dạng Sinh Vật Vô Định.\",\"rating\":9.0},\n  {\"id\":772169,\"suggestedTranslation\":\"Tăng khả năng hồi máu của Abigail từ 1 lên 3 máu mỗi giây. Kéo dài 1 ngày.\\n\\nKhi được uống bởi một người không phải ma đang đeo Vòng Hoa Vong Linh:\\n\\nHồi 1 máu mỗi giây trong 20 giây.\",\"rating\":9.0},\n  {\"id\":772170,\"suggestedTranslation\":\"Nhân đôi thời gian duy trì khiên của Abigail từ 0,5 giây lên 1 giây.\\n\\nCác sinh vật tấn công cũng chịu 20 sát thương.\\n\\nKéo dài 1 ngày.\\n\\nKhi được uống bởi một người không phải ma đang đeo Vòng Hoa Vong Linh:\\n\\nCung cấp cho người uống một chiếc khiên hấp thụ phần lớn sát thương từ một đòn đánh, sau đó hồi chiêu trong 10 giây. Nó cũng gây 20 sát thương cho tất cả kẻ địch xung quanh.\",\"rating\":9.0},\n  {\"id\":772171,\"suggestedTranslation\":\"Đưa cấp độ của Abigail trở về mức 3.\\n\\nKhi được uống bởi một người không phải ma đang đeo Vòng Hoa Vong Linh:\\n\\nHồi phục một chút tinh thần cho người uống, lấp đầy một ít độ đói và xóa bỏ hình phạt máu khi hồi sinh.\",\"rating\":9.0},\n  {\"id\":772172,\"suggestedTranslation\":\"Cường hóa lời nguyền mà Abigail áp dụng lên mục tiêu, khiến chúng nhận thêm 10 Sát Thương Xuyên Giáp khi bị tấn công.\",\"rating\":9.0},\n  {\"id\":772173,\"suggestedTranslation\":\"Nhân đôi thời gian duy trì khiên của Abigail từ 0,5 giây lên 1 giây. Kéo dài 1 ngày.\\n\\nKhi được uống bởi một người không phải ma đang đeo Vòng Hoa Vong Linh:\\n\\nCung cấp cho người uống một chiếc khiên hấp thụ phần lớn sát thương từ một đòn đánh, sau đó hồi chiêu trong 10 giây.\",\"rating\":9.0},\n  {\"id\":772174,\"suggestedTranslation\":\"Abigail được tăng 75% tốc độ trong 1 ngày.\\n\\nKhi được uống bởi một người không phải ma đang đeo Vòng Hoa Vong Linh:\\n\\nVật nặng sẽ không làm người uống bị giảm tốc độ nhiều nữa.\",\"rating\":9.0},\n  {\"id\":772175,\"suggestedTranslation\":\"Những nơi chúng xuất hiện, Hoa Quỷ thường có xu hướng mọc lên xung quanh.\",\"rating\":9.0},\n  {\"id\":772176,\"suggestedTranslation\":\"Nó được dùng để di chuyển Bia Mộ.\",\"rating\":9.0},\n  {\"id\":772177,\"suggestedTranslation\":\"Giảm một nửa nguyên liệu chế tạo vật phẩm và tăng tinh thần khi đeo.\",\"rating\":9.0},\n  {\"id\":772178,\"suggestedTranslation\":\"Biến các vật phẩm và công trình đã chế tạo thành nguyên liệu ban đầu dựa trên độ bền còn lại của chúng.\\n\\nNguyên liệu đá quý sẽ không được hoàn lại.\",\"rating\":9.0},\n  {\"id\":772179,\"suggestedTranslation\":\"Nguồn nước thấm đẫm bùn Hố Mặt Trăng sẽ hình thành các tinh thể Pha Lê Trăng nếu nước trong và đủ ánh sáng.\",\"rating\":9.0},\n  {\"id\":772180,\"suggestedTranslation\":\"Sẽ phát nổ gây 200 sát thương khi châm lửa.\",\"rating\":9.0},\n  {\"id\":772181,\"suggestedTranslation\":\"Tạo ra những tia sáng đẹp mắt khi cho vào lửa.\",\"rating\":9.0},\n  {\"id\":772182,\"suggestedTranslation\":\"Biến đổi một số sinh vật và thực vật thành dạng đột biến mặt trăng của chúng.\",\"rating\":9.0},\n  {\"id\":772183,\"suggestedTranslation\":\"Có thể treo lên Cây Hoàn Toàn Bình Thường để làm trang trí.\",\"rating\":9.0},\n  {\"id\":772184,\"suggestedTranslation\":\"Hồi 20 Máu.\",\"rating\":9.0},\n  {\"id\":772185,\"suggestedTranslation\":\"Hồi 20 Máu và giúp người sống sót miễn nhiễm với Mưa Axit trong nửa ngày. Trấn an Sên Rùa và Sên Đất trong suốt thời gian tác dụng.\",\"rating\":9.0},\n  {\"id\":772186,\"suggestedTranslation\":\"Cung cấp một chút khả năng chống quá nhiệt và miễn nhiễm lửa trong thời gian 4 phút.\",\"rating\":9.0},\n  {\"id\":772187,\"suggestedTranslation\":\"Tỏa nhiệt khi ở gần vật nóng và làm mát khi ở gần vật lạnh.\\n\\nNó sẽ sưởi ấm hoặc làm mát người cầm tùy theo nhiệt độ của nó.\",\"rating\":9.0},\n  {\"id\":772188,\"suggestedTranslation\":\"Sinh vật giáp xác cáu kỉnh này không dễ gì làm thân, nhưng chỉ cần chút thời gian và sự quan tâm, bạn sẽ nhận ra ẩn sâu dưới lớp vỏ cứng cáp ấy là một con người khác.\",\"rating\":9.0},\n  {\"id\":772189,\"suggestedTranslation\":\"Sưởi ấm bản thân với thức uống được pha chế đầy tình cảm từ Pearl.\",\"rating\":9.0},\n  {\"id\":772190,\"suggestedTranslation\":\"Bảo vệ tâm trí trước những kẻ thù đáng sợ với thức uống được pha chế đầy tình cảm từ Pearl.\",\"rating\":9.0},\n  {\"id\":772191,\"suggestedTranslation\":\"Xoa dịu tâm trí không gì sánh bằng với thức uống đặc biệt được pha chế từ Pearl.\",\"rating\":9.0},\n  {\"id\":772192,\"suggestedTranslation\":\"Xua tan bóng tối đêm đen với thức uống được pha chế đầy tình cảm từ Pearl.\",\"rating\":9.0},\n  {\"id\":772193,\"suggestedTranslation\":\"Xoa dịu tâm trí với thức uống được pha chế đầy tình cảm từ Pearl.\",\"rating\":9.0},\n  {\"id\":772194,\"suggestedTranslation\":\"Làm chua xót tâm trí với thức uống được pha chế từ Pearl này.\",\"rating\":9.0},\n  {\"id\":772195,\"suggestedTranslation\":\"Làm mát bản thân với thức uống được pha chế đầy tình cảm từ Pearl.\",\"rating\":9.0},\n  {\"id\":772196,\"suggestedTranslation\":\"Chữa lành vết thương với thức uống được pha chế đầy tình cảm từ Pearl.\",\"rating\":9.0},\n  {\"id\":772197,\"suggestedTranslation\":\"Treo đèn lấp lánh ánh ngọc trai. Cũng có thể kết nối với các Quán Trà và Điện Ngọc Trai!\",\"rating\":9.0},\n  {\"id\":772198,\"suggestedTranslation\":\"Giúp Pearl tìm ngôi nhà mới! Có thể hơi khó khăn để tìm được vị trí hoàn hảo, nhưng hãy nhớ — cô ấy rất thích ở gần đại dương.\",\"rating\":9.0},\n  {\"id\":772199,\"suggestedTranslation\":\"Quán trà của riêng Pearl phục vụ cho bạn những loại trà hấp dẫn.\",\"rating\":9.0},\n  {\"id\":772200,\"suggestedTranslation\":\"Ngôi nhà của Cua Ẩn Sĩ trông có vẻ cần được tu sửa lại chút ít.\",\"rating\":9.0},\n  {\"id\":772201,\"suggestedTranslation\":\"Biến những thứ đáng sợ xung quanh bạn trở nên thư giãn.\",\"rating\":9.0},\n  {\"id\":772202,\"suggestedTranslation\":\"Sử dụng trên Đất Vườn để tạo ra các mô đất nơi người sống sót có thể gieo hạt giống.\",\"rating\":9.0},\n  {\"id\":772203,\"suggestedTranslation\":\"Khi được đặt xuống, nó cho phép người sống sót viết lại một thông điệp để bản thân hoặc những người sống sót khác đọc sau này.\",\"rating\":9.0},\n  {\"id\":772204,\"suggestedTranslation\":\"Khiến tối đa 5 con bò lai ở gần đi theo người thổi trong ngày hôm đó.\",\"rating\":9.0},\n  {\"id\":772205,\"suggestedTranslation\":\"Suối nước nóng giống như bồn tắm đối với một số người.\",\"rating\":9.0},\n  {\"id\":772206,\"suggestedTranslation\":\"Có thể cất giữ đồ đạc trong Hutch giống như trong rương.\",\"rating\":9.0},\n  {\"id\":772207,\"suggestedTranslation\":\"Triệu tập Hutch khi nhặt lên. Hutch sẽ đi theo người giữ. Khi Hutch còn sống, Sao Trời sẽ còn sống.\",\"rating\":9.0},\n  {\"id\":772208,\"suggestedTranslation\":\"Một thùng chứa 9 ô dùng để đựng thức ăn.\\n\\nThực phẩm bên trong sẽ giảm một nửa tốc độ hư hỏng.\",\"rating\":9.0},\n  {\"id\":772209,\"suggestedTranslation\":\"Độ ẩm của người mặc sẽ nhanh chóng tăng lên tới 50%. Làm chậm 10% tốc độ người đeo.\",\"rating\":9.0},\n  {\"id\":772210,\"suggestedTranslation\":\"Một chiếc túi 8 ô giúp giảm một nửa tốc độ hỏng của thức ăn bên trong.\",\"rating\":9.0},\n  {\"id\":772211,\"suggestedTranslation\":\"Một sinh vật nhỏ phiền phức chỉ muốn được bạn ôm ấp. Hãy giẫm bẹp nó ngay trước khi nó kịp gây ra thêm rắc rối.\",\"rating\":9.0},\n  {\"id\":772212,\"suggestedTranslation\":\"Một đống rác cao ngất ngưởng. Có thể có thứ gì đó bất ngờ đang ẩn giấu bên trong...\",\"rating\":9.0},\n  {\"id\":772213,\"suggestedTranslation\":\"Là một người cá, Wurt chuyển hóa việc mất tinh thần thành việc tăng tinh thần.\",\"rating\":9.0},\n  {\"id\":772214,\"suggestedTranslation\":\"Vật phẩm này tạo ra ánh sáng trong suốt thời gian duy trì.\\n\\nNó không bị hỏng khi hết thời gian và có thể được tiếp thêm nhiên liệu.\",\"rating\":9.0},\n  {\"id\":772215,\"suggestedTranslation\":\"Làm tăng nhiệt độ của những người sống sót ở gần và làm bén lửa các vật thể xung quanh.\",\"rating\":9.0},\n  {\"id\":772216,\"suggestedTranslation\":\"Khôi phục \\\"sức khỏe tối đa\\\" đã mất.\",\"rating\":9.0},\n  {\"id\":772217,\"suggestedTranslation\":\"Có thể tạo ra ánh sáng. Willow, Walter và Warly có thể dùng nó để nấu ăn.\\n\\nSẽ mất độ bền nhanh hơn khi trời mưa.\",\"rating\":9.0},\n  {\"id\":772218,\"suggestedTranslation\":\"Tia sét đánh xuống gần đó sẽ nhắm vào cột thu lôi này và làm nó tích điện.\",\"rating\":9.0},\n  {\"id\":772219,\"suggestedTranslation\":\"Hiện thân ma quái của món đồ chơi thất lạc thuộc về một linh hồn.\",\"rating\":9.0},\n  {\"id\":772220,\"suggestedTranslation\":\"Đứng gần thiết bị này sẽ cung cấp cho người sống sót những công thức chế tạo mới dựa trên Quang Thạch Tinh Khiết.\",\"rating\":9.0},\n  {\"id\":772221,\"suggestedTranslation\":\"Phát sáng trong bóng tối và giúp Trượng Ánh Sáng tăng thêm 2 lần nảy đạn.\\nThêm +5 Sát Thương Xuyên Giáp cho các vũ khí có sẵn chỉ số này.\",\"rating\":9.0},\n  {\"id\":772222,\"suggestedTranslation\":\"Sẽ khôi phục độ bền của công cụ và vũ khí được chế tạo bằng Vỏ Gai Ánh Sáng.\",\"rating\":9.0},\n  {\"id\":772223,\"suggestedTranslation\":\"Một loại vật liệu cực kỳ cứng. Dụng cụ không có phẩm chất đặc biệt đôi khi có thể bị bật ngược lại.\",\"rating\":9.0},\n  {\"id\":772224,\"suggestedTranslation\":\"Một cánh cửa một chiều làm từ năng lượng mặt trăng, phát triển theo thời gian rồi biến mất để xuất hiện ở nơi khác sau đó.\",\"rating\":9.0},\n  {\"id\":772225,\"suggestedTranslation\":\"Quấn lấy một loại cây đang phát triển và che khuất nó khỏi những người sống sót.\",\"rating\":9.0},\n  {\"id\":772226,\"suggestedTranslation\":\"Chúng đến từ chiếc Vương Miện Khai Sáng — hãy trả chúng về đó để đắm mình trong sự giác ngộ vĩnh hằng.\",\"rating\":9.0},\n  {\"id\":772227,\"suggestedTranslation\":\"Đứng gần thiết bị này sẽ cung cấp cho người sống sót các Thí Nghiệm mới để chế tạo.\",\"rating\":9.0},\n  {\"id\":772228,\"suggestedTranslation\":\"Một thùng chứa 12 ô thực chất là một kho lưu trữ chung được liên kết với tất cả các vật phẩm \\\"lưu trữ ma thuật\\\".\",\"rating\":9.0},\n  {\"id\":772230,\"suggestedTranslation\":\"Có thể trồng xuống đất.\",\"rating\":9.0},\n  {\"id\":772231,\"suggestedTranslation\":\"Trang phục dùng trong các vở kịch sân khấu.\\nĐối mặt với sự thật cay đắng hay ôm lấy sự vô minh ngọt ngào tốt hơn đây?\",\"rating\":9.0},\n  {\"id\":772232,\"suggestedTranslation\":\"Trang phục dùng trong các vở kịch sân khấu.\\nCô ấy đã làm những gì cần thiết để phụng sự Nữ Hoàng của mình.\",\"rating\":9.0},\n  {\"id\":772233,\"suggestedTranslation\":\"Trang phục dùng trong các vở kịch sân khấu.\\nSự phản bội sinh ra những lời nguyền đen tối nhất.\",\"rating\":9.0},\n  {\"id\":772234,\"suggestedTranslation\":\"Có thể nhanh chóng giương lên và hạ xuống bằng sức lực. Khi giương buồm, cánh buồm làm tăng vận tốc tiến lên của thuyền thêm 2.5.\\n\\nMỗi cột buồm được đặt thêm sẽ giảm 30% hiệu quả so với cái trước.\\n\\nVô Lăng có thể dùng để xoay hướng tiến của Cột Buồm.\",\"rating\":9.0},\n  {\"id\":772235,\"suggestedTranslation\":\"Có thể nhanh chóng hạ xuống và giương lên bằng sức lực. Khi giương buồm, cánh buồm làm tăng vận tốc tiến lên của thuyền thêm 4.\\n\\nMỗi cột buồm được đặt thêm sẽ giảm 30% hiệu quả so với cái trước.\\n\\nVô Lăng có thể dùng để xoay hướng tiến của Cột Buồm.\",\"rating\":9.0},\n  {\"id\":772236,\"suggestedTranslation\":\"Vật phẩm này tạo ra ánh sáng trong suốt thời gian duy trì.\\n\\nNó không bị hỏng khi hết thời gian và có thể được tiếp nhiên liệu.\",\"rating\":9.0},\n  {\"id\":772237,\"suggestedTranslation\":\"Tia sét đánh xuống gần đó sẽ nhắm vào cột thu lôi này và làm nó tích điện.\",\"rating\":9.0},\n  {\"id\":772238,\"suggestedTranslation\":\"Một số vật phẩm có thể đặt lên giá để bắt đầu phơi khô. Sau một thời gian phơi, vật phẩm sẽ chuyển thành phiên bản khô của chính nó.\",\"rating\":9.0},\n  {\"id\":772239,\"suggestedTranslation\":\"Tạo ra một tia chớp trên bầu trời mà tất cả những người sống sót có thể thấy trên bản đồ nhỏ.\\n\\nTia chớp lớn này cũng sẽ thu hút sự chú ý của một số sinh vật thù địch.\",\"rating\":9.0},\n  {\"id\":772240,\"suggestedTranslation\":\"Người cá sẽ đối xử với người mặc như đồng loại.\",\"rating\":9.0},\n  {\"id\":772241,\"suggestedTranslation\":\"Một người cá ở gần sẽ đến ở đây và nếu được cho ăn, sẽ trở thành Vua Người Cá.\",\"rating\":9.0},\n  {\"id\":772242,\"suggestedTranslation\":\"Khi được trữ Cỏ Khô và Gỗ, Vệ Binh Người Cá sẽ lấy Mũ Đấu Sĩ Đầm Lầy từ đây, làm giảm lượng dự trữ.\\n\\nMũ Đấu Sĩ Đầm Lầy là cách tiết kiệm để Người Cá nhận được 50% khả năng chống chịu sát thương trong chốc lát.\",\"rating\":9.0},\n  {\"id\":772243,\"suggestedTranslation\":\"Khi được trữ Cỏ Khô và Gỗ, Vệ Binh Người Cá sẽ lấy Mũ Chiến Binh Đầm Lầy từ đây, làm giảm lượng dự trữ.\\n\\nMũ Chiến Binh Đầm Lầy có thiết kế vượt trội hơn bản Đấu Sĩ, cung cấp 70% khả năng kháng sát thương trong thời gian dài hơn.\",\"rating\":9.0},\n  {\"id\":772244,\"suggestedTranslation\":\"Khi được trữ cành cây và đá, người cá thông thường sẽ lấy Dụng Cụ Kém Chất Lượng từ đây, làm giảm lượng dự trữ.\\n\\nDụng Cụ Kém Chất Lượng sẽ tăng năng suất làm việc của người cá trong một thời gian ngắn.\\n\\nVới Dụng Cụ Kém Chất Lượng, người cá đi theo sẽ giúp chặt cây, đào đá, dọn vườn và xới đất.\",\"rating\":9.0},\n  {\"id\":772245,\"suggestedTranslation\":\"Khi được trữ cành cây và đá, người cá thông thường sẽ lấy Dụng Cụ Xịn Hơn Một Chút từ đây, làm giảm lượng dự trữ.\\n\\nDụng Cụ Xịn Hơn Một Chút giúp tăng năng suất làm việc của người cá tốt hơn so với loại kém chất lượng.\\n\\nVới dụng cụ này, người cá đi theo sẽ giúp chặt cây, đào đá, dọn vườn và xới đất.\",\"rating\":9.0},\n  {\"id\":772246,\"suggestedTranslation\":\"Một số thông điệp là ghi chú, một số là bản đồ dẫn đến các địa điểm đặc biệt.\",\"rating\":9.0},\n  {\"id\":772247,\"suggestedTranslation\":\"Một cấu trúc do Wolfgang có thể tự dựng lên để gia tăng Sức Mạnh bằng cách nâng tạ đúng nhịp.\\n\\nNó yêu cầu đặt hai vật nặng lên các bệ của nó để hoạt động. Chất lượng của vật nặng càng cao, Wolfgang càng nhận được nhiều Sức Mạnh sau mỗi lần nâng.\",\"rating\":9.0},\n  {\"id\":772249,\"suggestedTranslation\":\"Làm mát người cầm khi họ chạy.\",\"rating\":9.0},\n  {\"id\":772250,\"suggestedTranslation\":\"Tạo ra một tia sáng trên bầu trời mà tất cả những người sống sót đều thấy được trên bản đồ nhỏ.\",\"rating\":9.0},\n  {\"id\":772251,\"suggestedTranslation\":\"Một thùng chứa có 12 ô.\",\"rating\":9.0},\n  {\"id\":772252,\"suggestedTranslation\":\"Đã bao giờ chơi \\\"Đập Chuột Chũi\\\" chưa? Thật là một trò chơi tuyệt vời.\",\"rating\":9.0},\n  {\"id\":772253,\"suggestedTranslation\":\"Cho phép người mặc nhìn thế giới qua chế độ nhìn ban đêm trong bóng tối.\",\"rating\":9.0},\n  {\"id\":772254,\"suggestedTranslation\":\"Một vết nứt giống như mạch phun xuất hiện từ nơi khác, lũ khỉ và các mảnh vụn liên tục rơi ra từ đó.\",\"rating\":9.0},\n  {\"id\":772255,\"suggestedTranslation\":\"Vị quân vương cuồng chuối này có tài giải trừ lời nguyền và cai quản đám thuộc hạ linh trưởng cướp biển ô hợp của mình.\",\"rating\":9.0},\n  {\"id\":772256,\"suggestedTranslation\":\"Giảm một nửa sát thương va chạm và hư hỏng của thuyền.\",\"rating\":9.0},\n  {\"id\":772257,\"suggestedTranslation\":\"Người mặc sẽ thực hiện các thao tác trên thuyền nhanh hơn và tốn ít độ bền mái chèo hơn một nửa.\",\"rating\":9.0},\n  {\"id\":772258,\"suggestedTranslation\":\"Đứng gần thiết bị này sẽ cung cấp cho người sống sót những công thức chế tạo mới.\",\"rating\":9.0},\n  {\"id\":772259,\"suggestedTranslation\":\"Có cảm giác như một cơn bão sắp tới...\",\"rating\":9.0},\n  {\"id\":772260,\"suggestedTranslation\":\"\\\"Dưới ánh trăng tròn, ngươi đặt chìa khóa;\\nCây gậy mà các vì sao hằng mong đợi.\\nNhưng hãy cảnh giác trước khi nhận phần thưởng,\\nHãy sống sót qua bầy đàn, kẻo bị xé xác.\\\"\",\"rating\":9.0},\n  {\"id\":772261,\"suggestedTranslation\":\"Một cơ chế phức tạp để kiềm hãm cột năng lượng phun trào với nhiều giai đoạn xây dựng.\",\"rating\":9.0},\n  {\"id\":772262,\"suggestedTranslation\":\"Mực nước phản ánh trạng thái hiện tại và sắp tới của mặt trăng, tràn ngập nước vào những đêm trăng tròn.\",\"rating\":9.0},\n  {\"id\":772263,\"suggestedTranslation\":\"Luôn xuất hiện trên bản đồ nhỏ, kể cả ở những khu vực chưa khám phá.\",\"rating\":9.0},\n  {\"id\":772264,\"suggestedTranslation\":\"Khi sử dụng tại Cổng Thiên Thể, người sống sót có thể đổi sang nhân vật khác.\",\"rating\":9.0},\n  {\"id\":772265,\"suggestedTranslation\":\"Đứng gần thiết bị này sẽ cung cấp cho người sống sót những vật phẩm mới để chế tạo.\",\"rating\":9.0},\n  {\"id\":772266,\"suggestedTranslation\":\"Một thí nghiệm đang được thực hiện bởi một hình chiếu dạng hologram bí ẩn cần sự giúp đỡ từ những người sống sót.\",\"rating\":9.0},\n  {\"id\":772267,\"suggestedTranslation\":\"Cải thiện tầm nhìn trong bão.\\n\\nSẽ giúp định vị các hình chiếu hologram bí ẩn.\",\"rating\":9.0},\n  {\"id\":772268,\"suggestedTranslation\":\"Giờ thì bạn là người đi bắt rồi đấy!\\nHãy tìm luồng năng lượng đang rò rỉ trong các cơn bão và cố gắng khống chế nó.\",\"rating\":9.0},\n  {\"id\":772269,\"suggestedTranslation\":\"Một vật thể bị kẹt bên trong Đá Mặt Trăng.\",\"rating\":9.0},\n  {\"id\":772270,\"suggestedTranslation\":\"Chứa đầy những sinh vật đang quằn quại bên trong đến mức khi bầy bọ được giải phóng sẽ phát nổ gây sát thương cho mục tiêu xung quanh.\",\"rating\":9.0},\n  {\"id\":772271,\"suggestedTranslation\":\"Một thiết bị chữa trị hữu ích nhưng chỉ dành cho người cá, xét cho cùng, muỗi phần lớn đều chứa đầy máu người cá.\",\"rating\":9.0},\n  {\"id\":772272,\"suggestedTranslation\":\"Chứa \\\"tinh chất muỗi\\\" khiến bất kỳ ai mang theo cũng có vẻ thân thiện với muỗi hoang dã.\",\"rating\":9.0},\n  {\"id\":772273,\"suggestedTranslation\":\"Có thể dùng để hồi 8 máu.\",\"rating\":9.0},\n  {\"id\":772274,\"suggestedTranslation\":\"Ra vào Cõi Hằng kỳ diệu hết lần này đến lần khác qua cánh cổng trường tồn này.\",\"rating\":9.0},\n  {\"id\":772275,\"suggestedTranslation\":\"Nó sẽ biến Cổng Hoa thành dự án xây dựng Cổng Thiên Thể.\",\"rating\":9.0},\n  {\"id\":772276,\"suggestedTranslation\":\"Giảm 25% độ đói. Định kỳ tạo ra Bào Tử Nấm.\",\"rating\":9.0},\n  {\"id\":772277,\"suggestedTranslation\":\"Cần trồng một loại nấm hoặc bào tử lên đó để bắt đầu mọc nấm mới.\\n\\nPhải mất gần 4 ngày để đạt sản lượng nấm tối đa khi thu hoạch.\\n\\nSau khi thu hoạch 4 lần, nó phải được bón phân bằng Gỗ Sống.\",\"rating\":9.0},\n  {\"id\":772278,\"suggestedTranslation\":\"Một thùng chứa 4 ô có thể chứa các vật phẩm phát sáng như Bóng Đèn. Càng nhiều vật phẩm, bán kính ánh sáng tạo ra càng lớn.\",\"rating\":9.0},\n  {\"id\":772279,\"suggestedTranslation\":\"Những cuống nấm kỳ lạ giúp Cóc Nấm gia tăng sức mạnh, độ dẻo dai và tốc độ.\",\"rating\":9.0},\n  {\"id\":772280,\"suggestedTranslation\":\"Những con thú ăn thây ma đến từ những sa mạc cằn cỗi và đồng bằng đá. Hãy đề chừng chất gây đột biến quái dị của chúng.\",\"rating\":9.0},\n  {\"id\":772281,\"suggestedTranslation\":\"Cần bón phân nếu đem đi trồng ở nơi khác.\",\"rating\":9.0},\n  {\"id\":772282,\"suggestedTranslation\":\"Khi được thắp sáng, nó tạo ra ánh sáng và rút cạn Tinh Thần của những người sống sót xung quanh với tốc độ 3 mỗi phút vào ban ngày và 8 mỗi phút vào ban đêm.\",\"rating\":9.0},\n  {\"id\":772283,\"suggestedTranslation\":\"Khi những vật này phát sáng, chúng trở nên đáng sợ hơn, rút cạn 10 Tinh Thần mỗi giây, và khi sáng hoàn toàn, chúng rút cạn 15 tinh thần mỗi giây.\",\"rating\":9.0},\n  {\"id\":772284,\"suggestedTranslation\":\"Khi ở trong hang động, nó cho biết mức độ bão hòa ma thuật hắc ám.\",\"rating\":9.0},\n  {\"id\":772285,\"suggestedTranslation\":\"Tạo ra ánh sáng khi cầm trên tay.\\n\\nGây sát thương điện và gây sát thương nhiều hơn lên các mục tiêu bị ướt.\",\"rating\":9.0},\n  {\"id\":772286,\"suggestedTranslation\":\"Nghiên cứu cây trồng trong vườn ở các giai đoạn phát triển khác nhau sẽ bổ sung vào Sổ Đăng Ký Thực Vật.\\n\\nNgười mặc có thể nhìn thấy lượng chất dinh dưỡng trong đất nông trại.\",\"rating\":9.0},\n  {\"id\":772287,\"suggestedTranslation\":\"Với mảnh đất ven nước tuyệt vời này giữa lòng sa mạc khắc nghiệt, những người sống sót có thể xây dựng nhà mùa hè và nghỉ ngơi tránh cái nóng chết người, cháy rừng cùng sự mất nước!\",\"rating\":9.0},\n  {\"id\":772288,\"suggestedTranslation\":\"Sử dụng cùng với Cần Câu Biển.\\n\\nHiệu quả nhất vào ban đêm.\",\"rating\":9.0},\n  {\"id\":772289,\"suggestedTranslation\":\"Sử dụng cùng với Cần Câu Biển.\\n\\nGiúp làm cá mệt nhanh hơn.\",\"rating\":9.0},\n  {\"id\":772290,\"suggestedTranslation\":\"Sử dụng cùng với Cần Câu Biển.\\n\\nHiệu quả nhất vào lúc hoàng hôn.\",\"rating\":9.0},\n  {\"id\":772291,\"suggestedTranslation\":\"Sử dụng cùng với Cần Câu Biển.\\n\\nChỉ thu hút những con cá có kích thước lớn thuộc loài của chúng.\",\"rating\":9.0},\n  {\"id\":772292,\"suggestedTranslation\":\"Sử dụng cùng với Cần Câu Biển.\\n\\nChỉ hiệu quả khi trời mưa.\",\"rating\":9.0},\n  {\"id\":772293,\"suggestedTranslation\":\"Sử dụng cùng với Cần Câu Biển.\\n\\nHiệu quả nhất vào ban ngày.\",\"rating\":9.0},\n  {\"id\":772294,\"suggestedTranslation\":\"Sử dụng cùng với Cần Câu Biển.\\n\\nChỉ hiệu quả khi trời có tuyết.\",\"rating\":9.0},\n  {\"id\":772295,\"suggestedTranslation\":\"Bắt cá ở ngoài đại dương.\\n\\nSử dụng phao và mồi giả để tăng cơ hội câu được cá.\",\"rating\":9.0},\n  {\"id\":772296,\"suggestedTranslation\":\"Một thùng chứa 4 ô cuối cùng sẽ đầy cá. Khi đã đầy, theo thời gian có khả năng cá sẽ làm rách lưới và trốn thoát.\\n\\nCó thể bỏ mồi vào để tăng cơ hội bắt được cá.\",\"rating\":9.0},\n  {\"id\":772297,\"suggestedTranslation\":\"Đứng gần cây giúp kháng 35% sát thương từ mưa và làm mát người sống sót một chút.\\n\\nVới sự chăm sóc, nó có thể phát triển đến kích thước khổng lồ.\",\"rating\":9.0},\n  {\"id\":772298,\"suggestedTranslation\":\"Xoáy tròn thôi miên, hút lấy mọi thứ, nuốt chửng tất cả những gì lọt vào mắt bão.\\nCó sức tàn phá cực lớn đối với cả tàu thuyền lẫn công trình.\",\"rating\":9.0},\n  {\"id\":772299,\"suggestedTranslation\":\"Một đống bùn đặc. Tốt nhất là đào lên xem sao!\",\"rating\":9.0},\n  {\"id\":772300,\"suggestedTranslation\":\"Một cổng dịch chuyển đại dương cho phép thuyền di chuyển những quãng đường dài.\",\"rating\":9.0},\n  {\"id\":772301,\"suggestedTranslation\":\"Tăng tốc độ hồi sinh của Người Cá trong Nhà Người Cá, Pháo Đài Cá và Lều Rò Rỉ.\\n\\nCó thể dùng để gọi Người Cá ở gần đến ăn tảo bẹ và đi theo Người Cá đã triệu hồi chúng.\",\"rating\":9.0},\n  {\"id\":772302,\"suggestedTranslation\":\"Tăng tốc độ hồi sinh của Người Cá trong Nhà Người Cá, Pháo Đài Cá và Lều Rò Rỉ.\\n\\nCó thể dùng để gọi Người Cá ở gần đến ăn tảo bẹ và đi theo Người Cá đã triệu hồi chúng.\",\"rating\":9.0},\n  {\"id\":772303,\"suggestedTranslation\":\"Mang Ban Nhạc Một Người làm giảm tinh thần, nhưng đổi lại sẽ thu phục những người lợn và người thỏ ở gần đi theo bạn.\",\"rating\":9.0},\n  {\"id\":772304,\"suggestedTranslation\":\"Tạo ra Ánh Sáng Cực Quang.\",\"rating\":9.0},\n  {\"id\":772305,\"suggestedTranslation\":\"Tự động nhặt các vật phẩm gần đó và đưa vào kho đồ của bạn. Đồng thời tăng tinh thần khi đeo.\",\"rating\":9.0},\n  {\"id\":772306,\"suggestedTranslation\":\"Khi cầm trên tay, nó tăng 25% tốc độ và có thể dịch chuyển người dùng đến các vị trí nhìn thấy được bằng cách đánh đổi một ít tinh thần.\",\"rating\":9.0},\n  {\"id\":772307,\"suggestedTranslation\":\"Được tìm thấy sâu trong kho lưu trữ đã bị lãng quên từ lâu của một nền văn minh cổ đại, thiết bị đáng chú ý này vừa du dương vừa đầy bí ẩn. Giải mã câu đố của nó có thể chính là chìa khóa mở ra nguồn tri thức cổ xưa dồi dào.\",\"rating\":9.0},\n  {\"id\":772308,\"suggestedTranslation\":\"Có thể chèo trên mặt nước để di chuyển thuyền theo hướng mong muốn.\",\"rating\":9.0},\n  {\"id\":772309,\"suggestedTranslation\":\"Làm cho các sinh vật ở gần chìm vào giấc ngủ.\",\"rating\":9.0},\n  {\"id\":772310,\"suggestedTranslation\":\"Triệu tập một Chiến Binh Lợn Tinh Túy.\",\"rating\":9.0},\n  {\"id\":772311,\"suggestedTranslation\":\"Một chiếc ba lô lớn có 12 ô chứa đồ nhưng làm giảm 10% tốc độ của người đeo.\",\"rating\":9.0},\n  {\"id\":772312,\"suggestedTranslation\":\"Cai quản ngôi làng của mình bằng chiếc móng guốc chẻ đôi, thủ lĩnh loài lợn này nổi tiếng là người cứng rắn nhưng công bằng trong các giao dịch với người ngoài.\",\"rating\":9.0},\n  {\"id\":772313,\"suggestedTranslation\":\"Được trao cho Vua Lợn để bắt đầu một Trận Đấu Vật.\",\"rating\":9.0},\n  {\"id\":772314,\"suggestedTranslation\":\"Một công trình tạo ra ánh sáng khi được tiếp nhiên liệu.\\n\\nCác Vệ Binh Lợn ở gần sẽ chủ động tiếp nhiên liệu cho nó.\",\"rating\":9.0},\n  {\"id\":772315,\"suggestedTranslation\":\"Có thể trồng xuống đất.\",\"rating\":9.0},\n  {\"id\":772316,\"suggestedTranslation\":\"Cần bón phân sau khi trồng.\",\"rating\":9.0},\n  {\"id\":772318,\"suggestedTranslation\":\"Có thể trồng trên Các Cột Biển.\",\"rating\":9.0},\n  {\"id\":772319,\"suggestedTranslation\":\"Nghiên cứu cây trồng trong vườn ở các giai đoạn phát triển khác nhau sẽ bổ sung vào Sổ Đăng Ký Thực Vật.\",\"rating\":9.0},\n  {\"id\":772321,\"suggestedTranslation\":\"Một lời cảnh tỉnh ám ảnh từ quá khứ, và là điềm báo cho những gì đang chờ đợi phía trước.\",\"rating\":9.0},\n  {\"id\":772323,\"suggestedTranslation\":\"Một lá bài đơn lẻ để chơi trò chơi! Kết hợp chúng lại với nhau để tạo thành một bộ bài.\",\"rating\":9.0},\n  {\"id\":772324,\"suggestedTranslation\":\"Dùng để đo trọng lượng của Cá Đại Dương.\",\"rating\":9.0},\n  {\"id\":772325,\"suggestedTranslation\":\"Tháo rời đồng hồ bỏ túi thành các nguyên liệu ban đầu ngoại trừ Nhiên Liệu Ác Mộng.\",\"rating\":9.0},\n  {\"id\":772326,\"suggestedTranslation\":\"Tua ngược tuổi của Wanda lại 8 năm. Thời gian hồi chiêu 2 phút.\",\"rating\":9.0},\n  {\"id\":772327,\"suggestedTranslation\":\"Dùng để đánh dấu một vị trí, sau đó dùng lại để mở cổng dẫn đến vị trí đó trong 10 giây.\\n\\nSử dụng cổng tiêu tốn 20 Tinh Thần.\\n\\nĐồng Hồ Nứt Gãy sẽ biến thành Đồng Hồ Du Hành sau khi sử dụng.\",\"rating\":9.0},\n  {\"id\":772328,\"suggestedTranslation\":\"Dùng để đánh dấu một vị trí, sau đó dùng lại để dịch chuyển tức thời đến đó.\\n\\nThời gian hồi chiêu 8 phút. Thậm chí dùng được giữa Hang Động và Rừng.\",\"rating\":9.0},\n  {\"id\":772329,\"suggestedTranslation\":\"Wanda có thể ám chiếc đồng hồ dưới dạng bóng ma để hồi sinh bản thân, làm vỡ đồng hồ. Đồng hồ cũng có thể dùng lên bộ xương của người sống sót để hồi sinh họ tại đó. Thời gian hồi chiêu 4 phút.\",\"rating\":9.0},\n  {\"id\":772330,\"suggestedTranslation\":\"Dịch chuyển Wanda đến vị trí đã đánh dấu trên mặt đất.\\n\\nWanda càng trẻ, vị trí đánh dấu được dịch chuyển về quá khứ càng xa. Wanda bất tử trong chốc lát khi dịch chuyển.\\n\\nThời gian hồi chiêu 2 giây.\",\"rating\":9.0},\n  {\"id\":772331,\"suggestedTranslation\":\"Khi nhiên liệu cạn về 0, sát thương của nó giảm xuống còn 27.\",\"rating\":9.0},\n  {\"id\":772332,\"suggestedTranslation\":\"Thu gom chiến lợi phẩm ở gần.\",\"rating\":9.0},\n  {\"id\":772333,\"suggestedTranslation\":\"Chim Hải Tặc sẽ bay xuống và đi theo người đeo, nhặt các vật phẩm ở gần.\",\"rating\":9.0},\n  {\"id\":772334,\"suggestedTranslation\":\"Nếu chứa đầy axit, ao này sẽ đóng một lớp vỏ Diêm Tiêu bên trên.\",\"rating\":9.0},\n  {\"id\":772335,\"suggestedTranslation\":\"Đứng gần thiết bị này sẽ cung cấp cho người sống sót những công thức Gia Vị mới để chế tạo.\",\"rating\":9.0},\n  {\"id\":772336,\"suggestedTranslation\":\"Một thùng chứa 4 ô dùng để nhận nguyên liệu nấu ăn.\\n\\nĐặt 4 vật phẩm vào thùng sẽ cho phép nấu chúng thành một món ăn tùy thuộc vào nguyên liệu ban đầu.\\n\\nNó có thể được tháo rời trở lại thành vật phẩm trong kho đồ.\",\"rating\":9.0},\n  {\"id\":772337,\"suggestedTranslation\":\"Một Bếp Lửa Di Động vẫn duy trì sự cháy ngay cả khi đã được đóng gói!\",\"rating\":9.0},\n  {\"id\":772338,\"suggestedTranslation\":\"Một thùng chứa 2 ô. Một ô dành cho món ăn đã nấu chín và một ô dành cho Gia Vị.\\n\\nNếu đặt đủ cả hai, nó sẽ tẩm gia vị đó vào món ăn.\",\"rating\":9.0},\n  {\"id\":772339,\"suggestedTranslation\":\"Ngủ trong lều hồi phục 1 Tinh Thần và 2 Máu mỗi giây, nhưng tiêu tốn 1 Đói mỗi giây.\\n\\nLà một Người Tiên Phong Pinetree, Walter sẽ mất 1 Đói mỗi 2 giây.\\n\\nĐồng thời độ ẩm giảm 1 mỗi giây và nhiệt độ được nâng lên 40 độ, tốc độ 1 độ mỗi giây.\",\"rating\":9.0},\n  {\"id\":772340,\"suggestedTranslation\":\"Tốt nhất là nên chuẩn bị sẵn một ít vật hối lộ cho những tên cướp biển này.\",\"rating\":9.0},\n  {\"id\":772341,\"suggestedTranslation\":\"Có thể dùng để khắc các hình thù cụ thể lên Bí Ngô Khổng Lồ.\",\"rating\":9.0},\n  {\"id\":772342,\"suggestedTranslation\":\"Tạo ra một lượng ánh sáng nhỏ khi còn cháy.\",\"rating\":9.0},\n  {\"id\":772343,\"suggestedTranslation\":\"Người mặc sẽ rơi vào trạng thái phát cuồng.\",\"rating\":9.0},\n  {\"id\":772344,\"suggestedTranslation\":\"Dịch chuyển mục tiêu đến một vị trí ngẫu nhiên hoặc tới Tâm Dịch Chuyển đã được nạp nhiên liệu.\",\"rating\":9.0},\n  {\"id\":772345,\"suggestedTranslation\":\"Hóa trang thành thỏ để chúng không còn hoảng sợ bỏ chạy khỏi bạn nữa.\",\"rating\":9.0},\n  {\"id\":772347,\"suggestedTranslation\":\"Kho lưu trữ vật phẩm và đồ trang trí của bạn có thể truy cập từ Hang Di Động.\",\"rating\":9.0}\n]",
            "thoughtSignature": "El0KWwFpFH0TlVEqSfrAYv705eV4jNiw88xF32a8v0vQg+hGb+85Xt9m2w6cKXsVlvpJJsL1nAX/jwD9747uo34ugkkXpWQK3nTOhSAlbyGXABPZeZYNMVpAuFhWLeA="
