on\": \"Gnaw muốn {craving}... {part2}\", \"rating\": 9.0},\n  {\"id\": 766392, \"suggestedTranslation\": \"Gnaw đang thèm {craving}!\", \"rating\": 9.0},\n  {\"id\": 766393, \"suggestedTranslation\": \"Gnaw đang muốn {craving}!\", \"rating\": 9.0},\n  {\"id\": 766394, \"suggestedTranslation\": \"Gnaw đang thèm thuồng {craving}!\", \"rating\": 9.0},\n  {\"id\": 766395, \"suggestedTranslation\": \"Tớ biết mà, baa.\", \"rating\": 9.0},\n  {\"id\": 766396, \"suggestedTranslation\": \"Tớ cảm nhận được.\", \"rating\": 9.0},\n  {\"id\": 766397, \"suggestedTranslation\": \"Đến lúc nấu ăn rồi.\", \"rating\": 9.0},\n  {\"id\": 766399, \"suggestedTranslation\": \"Tớ chắc chắn luôn.\", \"rating\": 9.0},\n  {\"id\": 766400, \"suggestedTranslation\": \"Cậu phải làm theo thôi.\", \"rating\": 9.0},\n  {\"id\": 766402, \"suggestedTranslation\": \"hay gì cũng được! Nhanh lên, BAAA!\", \"rating\": 9.0},\n  {\"id\": 766403, \"suggestedTranslation\": \"BAAA! Nhanh chân lên!\", \"rating\": 9.0},\n  {\"id\": 766404, \"suggestedTranslation\": \"không còn thời gian nữa rồi!\", \"rating\": 9.0},\n  {\"id\": 766405, \"suggestedTranslation\": \"Đút cho nó cái gì đi! Bất cứ thứ gì!\", \"rating\": 9.0},\n  {\"id\": 766406, \"suggestedTranslation\": \"một món ăn làm từ BÁNH MÌ\", \"rating\": 9.0},\n  {\"id\": 766407, \"suggestedTranslation\": \"một món ăn có PHÔ MAI\", \"rating\": 9.0},\n  {\"id\": 766410, \"suggestedTranslation\": \"MÌ Ý\", \"rating\": 9.0},\n  {\"id\": 766411, \"suggestedTranslation\": \"một MÓN ĂN NHẸ\", \"rating\": 9.0},\n  {\"id\": 766413, \"suggestedTranslation\": \"món tráng miệng\", \"rating\": 10.0},\n  {\"id\": 766414, \"suggestedTranslation\": \"một món RAU CỦ\", \"rating\": 9.0},\n  {\"id\": 766415, \"suggestedTranslation\": \"Ồ đúng rồi, {craving}! Cậu vừa mua thêm được ít thời gian đấy.\", \"rating\": 9.0},\n  {\"id\": 766416, \"suggestedTranslation\": \"Đúng rồi, {craving}! Thế đủ để nhét đầy cái bụng con quái đó rồi.\", \"rating\": 9.0},\n  {\"id\": 766417, \"suggestedTranslation\": \"Cậu đã tìm đúng món Gnaw đang thèm khát!\", \"rating\": 9.0},\n  {\"id\": 766418, \"suggestedTranslation\": \"Gnaw rất hài lòng với vật phẩm của cậu.\", \"rating\": 9.0},\n  {\"id\": 766419, \"suggestedTranslation\": \"Hỡi Gnaw vĩ đại! Hãy thưởng thức {craving} đi!\", \"rating\": 9.0},\n  {\"id\": 766420, \"suggestedTranslation\": \"Ừm, không phải {craving}. Nhưng có còn hơn không!\", \"rating\": 10.0},\n  {\"id\": 766421, \"suggestedTranslation\": \"Đó không phải món Gnaw muốn, nhưng tạm chấp nhận vậy.\", \"rating\": 9.0},\n  {\"id\": 766422, \"suggestedTranslation\": \"Tớ không gọi đó là {craving} đâu, nhưng thôi kệ.\", \"rating\": 9.0},\n  {\"id\": 766423, \"suggestedTranslation\": \"Hết thật rồi.\", \"rating\": 9.0},\n  {\"id\": 766424, \"suggestedTranslation\": \"Cơn thịnh nộ của Gnaw đã giáng xuống đầu các cậu.\", \"rating\": 9.0},\n  {\"id\": 766425, \"suggestedTranslation\": \"Tớ xin lỗi vì không giúp gì nhiều hơn được.\", \"rating\": 9.0},\n  {\"id\": 766427, \"suggestedTranslation\": \"Nếu kiếm được sự ưng thuận của Gnaw... các cậu có thể trốn thoát.\", \"rating\": 9.0},\n  {\"id\": 766428, \"suggestedTranslation\": \"Gnaw đã ở đây từ khi tớ còn là một chú cừu non.\", \"rating\": 9.0},\n  {\"id\": 766429, \"suggestedTranslation\": \"Từng có một kẻ giống các cậu đi ngang qua đây rồi.\", \"rating\": 9.0},\n  {\"id\": 766430, \"suggestedTranslation\": \"Đặc Ân từ Gnaw có lẽ sẽ nạp lại năng lượng cho chiếc chìa khóa cũ.\", \"rating\": 9.0},\n  {\"id\": 766431, \"suggestedTranslation\": \"Các cậu phải nấu ăn, nếu không sẽ phải bỏ mạng.\", \"rating\": 9.0},\n  {\"id\": 766432, \"suggestedTranslation\": \"Sự hiện diện của các cậu ở đây giúp nó chú ý ít hơn đến Billy và tớ.\", \"rating\": 9.0},\n  {\"id\": 766433, \"suggestedTranslation\": \"Các cậu có phải là... Người Gác Cổng không thế?\", \"rating\": 9.0},\n  {\"id\": 766434, \"suggestedTranslation\": \"Nhanh lên, xin đấy!\", \"rating\": 9.0},\n  {\"id\": 766435, \"suggestedTranslation\": \"Gnaw đang ngày càng mất kiên nhẫn rồi!\", \"rating\": 9.0},\n  {\"id\": 766437, \"suggestedTranslation\": \"Đòi hỏi của Gnaw là vô tận.\", \"rating\": 9.0},\n  {\"id\": 766438, \"suggestedTranslation\": \"Tớ tin các cậu làm được. Cố lên.\", \"rating\": 9.0},\n  {\"id\": 766440, \"suggestedTranslation\": \"Gnaw sẽ giáng cơn thịnh nộ xuống nếu không được cho ăn!\", \"rating\": 9.0},\n  {\"id\": 766441, \"suggestedTranslation\": \"Lại gần đây một chút nào.\", \"rating\": 9.0},\n  {\"id\": 766442, \"suggestedTranslation\": \"Này bạn ơi, qua đây nè! Baa.\", \"rating\": 9.0},\n  {\"id\": 766443, \"suggestedTranslation\": \"Qua đây nào, cưng!\", \"rating\": 9.0},\n  {\"id\": 766444, \"suggestedTranslation\": \"Chờ đã! Cậu cần dụng cụ nấu ăn!\", \"rating\": 9.0},\n  {\"id\": 766445, \"suggestedTranslation\": \"Lại gần đây nào cưng.\", \"rating\": 9.0},\n  {\"id\": 766446, \"suggestedTranslation\": \"Không còn thời gian để lãng phí nữa!\", \"rating\": 9.0},\n  {\"id\": 766447, \"suggestedTranslation\": \"Cậu đi đâu thế?\", \"rating\": 9.0},\n  {\"id\": 766448, \"suggestedTranslation\": \"Cậu sẽ cần một bộ dụng cụ nấu ăn của tớ đấy.\", \"rating\": 9.0},\n  {\"id\": 766449, \"suggestedTranslation\": \"Baa. Giao dịch nào.\", \"rating\": 9.0},\n  {\"id\": 766450, \"suggestedTranslation\": \"Tớ có vài dụng cụ nấu ăn dư để đem đổi.\", \"rating\": 9.0},\n  {\"id\": 766451, \"suggestedTranslation\": \"Cậu muốn lấy một cái nồi, lò nướng hay vỉ nướng?\", \"rating\": 10.0},\n  {\"id\": 766452, \"suggestedTranslation\": \"Dùng mấy đồng xu đó để giao dịch với tớ nhé?\", \"rating\": 9.0},\n  {\"id\": 766453, \"suggestedTranslation\": \"Giao dịch nào. Tớ sẽ chuẩn bị đồ cho cậu.\", \"rating\": 9.0},\n  {\"id\": 766454, \"suggestedTranslation\": \"Mong là cậu nấu ăn giỏi, cưng à.\", \"rating\": 9.0},\n  {\"id\": 766455, \"suggestedTranslation\": \"Lựa chọn tuyệt vời, baa! Giờ thì xem nào...\", \"rating\": 9.0},\n  {\"id\": 766456, \"suggestedTranslation\": \"Cảm ơn nhé, cưng.\", \"rating\