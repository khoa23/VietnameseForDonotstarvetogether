nslation\":\"Chào bé cưng quý giá nhé.\",\"rating\":8.5},\n  {\"id\":766610,\"suggestedTranslation\":\"Mấy cái ghế bạn đóng dễ thương thật đấy, cưng ạ. Thêm vài cái nữa thì tuyệt.\",\"rating\":8.5},\n  {\"id\":766614,\"suggestedTranslation\":\"Chỗ ngồi câu cá của tôi rộng rãi hẳn ra rồi, chỉ trừ vài chỗ thôi, cưng ạ.\",\"rating\":8.5},\n  {\"id\":766621,\"suggestedTranslation\":\"Chỉ cần thêm vài bông hoa nữa thôi là tuyệt cú mèo luôn đấy, cưng ơi.\",\"rating\":8.5},\n  {\"id\":766628,\"suggestedTranslation\":\"Vẫn hơi tối đấy, cưng ạ!\",\"rating\":8.5},\n  {\"id\":766639,\"suggestedTranslation\":\"Chúng ta sắp đủ bùa chuông gió rồi đấy, cưng ơi!\",\"rating\":8.5},\n  {\"id\":766647,\"suggestedTranslation\":\"Chỉ cần thêm vài chậu cây nữa cho tôi là đủ rồi, cưng ạ.\",\"rating\":8.5},\n  {\"id\":766659,\"suggestedTranslation\":\"Thêm vài con cá lớn nữa thì tuyệt cú mèo luôn, cưng ơi!\",\"rating\":8.5},\n  {\"id\":766665,\"suggestedTranslation\":\"Mấy chú ong mê nhà mới lắm! Cảm ơn cưng nhé!\",\"rating\":8.5},\n  {\"id\":766671,\"suggestedTranslation\":\"Mấy cây cọc bến tàu tuyệt lắm luôn đấy, cưng ạ!\",\"rating\":8.5},\n  {\"id\":766676,\"suggestedTranslation\":\"Nhờ cưng mà khu vườn của tôi ngập tràn hoa đẹp luôn!\",\"rating\":8.5},\n  {\"id\":766677,\"suggestedTranslation\":\"Mấy bông hoa này làm tôi vui quá xá! Cảm ơn cưng nhé.\",\"rating\":8.5},\n  {\"id\":766693,\"suggestedTranslation\":\"Mấy chậu cây này cưng yêu quá đi.\",\"rating\":8.5},\n  {\"id\":766697,\"suggestedTranslation\":\"Cảm ơn cưng đã giúp tôi dựng quán trà nhé.\",\"rating\":8.5},\n  {\"id\":766699,\"suggestedTranslation\":\"Cảm ơn cưng nhé. Cưng đã mang cả bãi biển đến cho tôi rồi!\",\"rating\":8.5},\n  {\"id\":766705,\"suggestedTranslation\":\"Cảm ơn cưng nha! Giờ thì đúng chất nhà mình rồi đấy!\",\"rating\":8.5},\n  {\"id\":766750,\"suggestedTranslation\":\"Bà kiên trì phết nhỉ\",\"rating\":8.5},\n  {\"id\":766767,\"suggestedTranslation\":\"Tôi không biết bạn đang giở trò gì nữa\",\"rating\":8.