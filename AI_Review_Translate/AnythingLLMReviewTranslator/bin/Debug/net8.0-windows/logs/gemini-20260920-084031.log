 },\n  {\n    \"id\": 772733,\n    \"suggestedTranslation\": \"Phải... gi-giết.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772734,\n    \"suggestedTranslation\": \"Thịt... của ta!\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 772735,\n    \"suggestedTranslation\": \"Th... th-thịt!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772736,\n    \"suggestedTranslation\": \"Đói quá.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772737,\n    \"suggestedTranslation\": \"Ta cần thêm sức mạnh từ thịt.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772738,\n    \"suggestedTranslation\": \"Tìm thứ gì đó để ta giết đi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772739,\n    \"suggestedTranslation\": \"Ngươi nghĩ sao về một chút sườn heo?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772740,\n    \"suggestedTranslation\": \"Ta đói muốn chết!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 772741,\n    \"suggestedTranslation\": \"Ngươi cần kiếm thịt cho ta!\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 772742,\n    \"suggestedTranslation\": \"Ta thèm thịt quái thú!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772743,\n    \"suggestedTranslation\": \"Khi nào thì chúng ta được ăn?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772745,\n    \"suggestedTranslation\": \"Ngươi dám bỏ bê ta à, {mortal}?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 772746,\n    \"suggestedTranslation\": \"Cái chết ban cho ta sự sống.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772747,\n    \"suggestedTranslation\": \"Người sử dụng, ngươi đã thay đổi rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772748,\n    \"suggestedTranslation\": \"Cảm thấy... lạ... lắm...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772749,\n    \"suggestedTranslation\": \"Có gì đó... đang xảy ra.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772750,\n    \"suggestedTranslation\": \"M-mạnh... mẽ... hơn!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772751,\n    \"suggestedTranslation\": \"Đa