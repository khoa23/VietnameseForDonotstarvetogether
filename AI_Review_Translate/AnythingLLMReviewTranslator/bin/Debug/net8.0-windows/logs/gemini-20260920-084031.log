stedTranslation\": \"Chỗ này không ổn lắm đâu.\", \"rating\": 9.0},\n  {\"id\": 760442, \"suggestedTranslation\": \"Cây cối ở đây lạ hoắc.\", \"rating\": 9.0},\n  {\"id\": 760454, \"suggestedTranslation\": \"Bé Mòng ngứa ngáy có muốn chơi cùng bạn bè không?\", \"rating\": 8.5},\n  {\"id\": 760494, \"suggestedTranslation\": \"Chú chim xinh xắn.\", \"rating\": 9.0},\n  {\"id\": 760553, \"suggestedTranslation\": \"Chắc không làm cá bị thương đâu nhỉ?\", \"rating\": 8.5},\n  {\"id\": 760554, \"suggestedTranslation\": \"Chắc không làm cá bị thương đâu nhỉ?\", \"rating\": 8.5},\n  {\"id\": 760555, \"suggestedTranslation\": \"Chắc không làm cá bị thương đâu nhỉ?\", \"rating\": 8.5},\n  {\"id\": 760556, \"suggestedTranslation\": \"Chắc không làm cá bị thương đâu nhỉ?\", \"rating\": 8.5},\n  {\"id\": 760557, \"suggestedTranslation\": \"Chắc không làm cá bị thương đâu nhỉ?\", \"rating\": 8.5},\n  {\"id\": 760563, \"suggestedTranslation\": \"Cảm thấy... hơi mâu thuẫn sao ấy về con này, florp.\", \"rating\": 8.5},\n  {\"id\": 760574, \"suggestedTranslation\": \"Là con cá xấu xí, nhưng tớ vẫn thích!\", \"rating\": 9.0},\n  {\"id\": 760750, \"suggestedTranslation\": \"Ăn vào đau bụng lắm đây, nhưng... thơm quá...\", \"rating\": 9.0},\n  {\"id\": 760968, \"suggestedTranslation\": \"Trông giống con gà tây dở hơi, mà sao lại ngửi như rau thế nhỉ?\", \"rating\": 8.5},\n  {\"id\": 761082, \"suggestedTranslation\": \"Cảm thấy... buồn quá...\", \"rating\": 9.0},\n  {\"id\": 761102, \"suggestedTranslation\": \"Sao nó được phép cắn mình mà mình lại bị mắng thế này?!\", \"rating\": 8.5},\n  {\"id\": 761140, \"suggestedTranslation\": \"Mấy mảnh vụn linh tinh.\", \"rating\": 8.5},\n  {\"id\": 761268, \"suggestedTranslation\": \"Không phải em Ironfolk nhí làm hỏng đâu. Tớ tìm thấy nó như thế này mà.\", \"rating\": 8.5},\n  {\"id\": 761369, \"suggestedTranslation\": \"Món ăn vặt mềm mại to bự.\", \"rating\": 8.5},\n  {\"id\": 761401, \"suggestedTranslation\": \"Lớn lên, lớn lên mau nào!\", \"rating\": 9.0},\n  {\"id\": 761403, \"suggestedTranslation\": \"Đâm chọc này!\", \"rating\": 9.0},\n  {\"id\": 761617, \"suggestedTranslation\": \"Chị Wicker bảo cái này để đi bộ, chứ không phải để chọc Wendy...\", \"rating\": 8.5},\n  {\"id\": 761629, \"suggestedTranslation\": \"Xây bức tường xinh xắn nào, flort!\", \"rating\": 8.5},\n  {\"id\": 761641, \"suggestedTranslation\": \"Cậu chẳng giúp gì cả, đồ xấu tính!\", \"rating\": 8.5},\n  {\"id\": 761655, \"suggestedTranslation\": \"Chào anh chàng lông lá! Florp!\", \"rating\": 8.5},\n  {\"id\": 761673, \"suggestedTranslation\": \"Hee-hee vừa hay vừa đáng sợ!\", \"rating\": 8.5},\n  {\"id\": 761674, \"suggestedTranslation\": \"Trông có vẻ đáng sợ... nhưng bên trong ngọt lắm...\", \"rating\": 9.0},\n  {\"id\": 761682, \"suggestedTranslation\": \"Mmmm to và ngon quá.\", \"rating\": 9.0},\n  {\"id\": 761824, \"suggestedTranslation\": \"Cái này. Ngon. Nhất. Trên. Đời.\", \"rating\": 8.5},\n  {\"id\": 761865, \"suggestedTranslation\": \"Tưởng cậu thích chặt cây chứ, sao lại đi đốt thế?\", \"rating\": 8.5},\n  {\"id\": 762022, \"suggestedTranslation\": \"Đặt cái này ở đâu thì hợp lý hả flort?\", \"rating\": 8.5},\n  {\"id\": 762104, \"suggestedTranslation\": \"CẢM BIẾN CHO THẤY THỦ LĨNH CHIM ĐANG Ở ĐÂY\", \"rating\": 9.0},\n  {\"id\": 762105, \"suggestedTranslation\": \"NÓ KHÔNG CÓ SINH VẬT HỮU CƠ NÀO\", \"rating\": 8.5},\n  {\"id\": 762106, \"suggestedTranslation\": \"Bộ não chim bé nhỏ của hắn quá dễ bị phân tâm\", \"rating\": 8.5},\n  {\"id\": 762108, \"suggestedTranslation\": \"KHÔNG CÓ ĐỦ VỊ TRÍ ĐỂ TRỐN TRÁNH SỨC MẠNH CỦA TA\", \"rating\": 8.5},\n  {\"id\": 762109, \"suggestedTranslation\": \"HỌ CẦN NẠP LẠI NĂNG LƯỢNG\", \"rating\": 9.0},\n  {\"id\": 762110, \"suggestedTranslation\": \"YÊU CẦU MÃ TRUY CẬP\", \"rating\": 9.0},\n  {\"id\": 762111, \"suggestedTranslation\": \"TÚI VẢI KHÔNG THỂ TIN TƯỞNG ĐƯỢC TRONG TRƯỜNG HỢP NÀY\", \"rating\": 8.5},\n  {\"id\": 762112, \"suggestedTranslation\": \"CHÚNG SẼ KHÔNG PHẢI TIẾC NUỐI ĐÂU\", \"rating\": 8.5},\n  {\"id\": 762114, \"suggestedTranslation\": \"not_used_by_wx78\", \"rating\": 10.0},\n  {\"id\": 762115, \"suggestedTranslation\": \"LŨ QUÁI VẬT CÁ ƯƠNG BƯỚC\", \"rating\": 9.0},\n  {\"id\": 762122, \"suggestedTranslation\": \"ĐANG HIỆU CHỈNH LẠI HỆ THỐNG\", \"rating\": 9.0},\n  {\"id\": 762125, \"suggestedTranslation\": \"TÔI PHẢI SỬA CHỮA TRƯỚC KHI LÀM VIỆC NÀY\", \"rating\": 9.0},\n  {\"id\": 762126, \"suggestedTranslation\": \"NÓ ĐÃ BỊ KÍCH HOẠT BOM\", \"rating\": 8.5},\n  {\"id\": 762130, \"suggestedTranslation\": \"TÔI ĐÃ CÓ MỘT THÚ CƯNG HỮU CƠ RỒI\", \"rating\": 8.5},\n  {\"id\": 762132, \"suggestedTranslation\": \"ĐÃ ĐẠT GIỚI HẠN TỐI ĐA\", \"rating\": 9.0},\n  {\"id\": 762136, \"suggestedTranslation\": \"TÔI CỐ TÌNH BỎ LỠ NÓ ĐÓ\", \"rating\": 8.5},\n  {\"id\": 762138, \"suggestedTranslation\": \"ĐANG ĐƯỢC SỬ DỤNG BỞI NGƯỜI DÙNG\", \"rating\": 8.5},\n  {\"id\": 762149, \"suggestedTranslation\": \"CÒN NHỮNG VẤN ĐỀ QUAN TRỌNG HƠN CẦN GIẢI QUYẾT\", \"rating\": 8.5},\n  {\"id\": 762150, \"suggestedTranslation\": \"ĐÃ CÓ NGƯỜI DÙNG\", \"rating\": 8.5},\n  {\"id\": 762151, \"suggestedTranslation\": \"KHÔNG CÓ Mục tiêu NÀO ĐƯỢC GẮN KẾT\", \"rating\": 9.0},\n  {\"id\": 762152, \"suggestedTranslation\": \"Mục tiêu CẦN THÊM TÓC\", \"rating\": 9.0},\n  {\"id\": 762158, \"suggestedTranslation\": \"LŨ KÉM CỎI ĐANG XÂY DỰNG NÓ\", \"rating\": 8.5},\n  {\"id\": 762162, \"suggestedTranslation\": \"TÔI KHÔNG MUỐN NẤU ĂN\", \"rating\": 9.0},\n  {\"id\": 762165, \"suggestedTranslation\": \"BỊ CHẶN BỞI MŨ\", \"rating\": 9.0},\n  {\"id\": 762166, \"suggestedTranslation\": \"ĐANG ĐƯỢC SỬ DỤNG BỞI NGƯỜI DÙNG\", \"rating\": 8.5},\n  {\"id\": 762168, \"suggestedTranslation\": \"ĐÃ ĐẠT CHIỀU CAO TỐI ĐA\", \"rating\": 9.0},\n  {\"id\": 762171, \"suggestedTranslation\": \"LŨ KÉM CỎI ĐANG SỬ DỤNG NÓ NGAY BÂY GIỜ\", \"rating\": 8.5},\n  {\"id\": 762172, \"suggestedTranslation\": \"TÔI PHẢI LẤY HẾT ĐỒ BÊN TRONG RA ĐÃ\", \"rating\": 8.5},\n  {\"id\": 762173, \"suggestedTranslation\": \"Mục tiêu ĐÃ TRỐN THOÁT, ĐANG TÍNH TOÁN LẠI\", \"rating\": 9.0},\n  {\"id\": 762175, \"suggestedTranslation\": \"NGAY CẢ THỰC VẬT CÒN GHÉT NƯỚC BIỂN\", \"rating\": 8.5},\n  {\"id\": 762178, \"suggestedTranslation\": \"THẤT BẠI\", \"rating\": 9.0},\n  {\"id\": 762179, \"suggestedTranslation\": \"Mục tiêu ĐANG BẬN\", \"rating\": 9.0},\n  {\"id\": 762188, \"suggestedTranslation\": \"KHÔNG ĐÁNG ĐỂ LÀM\", \"rating\": 8.5},\n  {\"id\": 762189, \"suggestedTranslation\": \"YÊU CẦU KHÚC Gỗ ĐẶC BIỆT\", \"rating\": 9.0},\n  {\"id\": 762192, \"suggestedTranslation\": \"THIẾT BỊ CẮM VÀO KHÔNG TƯƠNG THÍCH\", \"rating\": 8.5},\n  {\"id\": 762196, \"suggestedTranslation\": \"THIẾT BỊ CẮM VÀO KHÔNG TƯƠNG THÍCH\", \"rating\": 8.5},\n  {\"id\": 762197, \"suggestedTranslation\": \"VẬT LIỆU QUÁ KÉM ĐỂ ĐIÊU KHẮC\", \"rating\": 9.0},\n  {\"id\": 762198, \"suggestedTranslation\": \"SAI VẬT DỤNG\", \"rating\": 8.5},\n  {\"id\": 762202, \"suggestedTranslation\": \"TÔI SẼ KHÔNG BỊ LƠ LÀ ĐÂU\", \"rating\": 8.5},\n  {\"id\": 762203, \"suggestedTranslation\": \"ĐƠN VỊ ĐÓ ĐANG BẬN SẠC LẠI\", \"rating\": 9.0},\n  {\"id\": 762208, \"suggestedTranslation\": \"NGUỒN NĂNG LƯỢNG KHOÁNG SẢN KHÔNG HỢP LỆ\", \"rating\": 9.0},\n  {\"id\": 762210, \"suggestedTranslation\": \"Mục tiêu ĐANG BẬN\", \"rating\": 9.0},\n  {\"id\": 762212, \"suggestedTranslation\": \"Mục tiêu ĐÃ QUÁ TẢI SỨC CHỨA\", \"rating\": 9.0},\n  {\"id\": 762213, \"suggestedTranslation\": \"ĐƠN VỊ ĐÓ ĐANG BẬN SẠC LẠI\", \"rating\": 9.0},\n  {\"id\": 762214, \"suggestedTranslation\": \"Mục tiêu ĐANG BẬN\", \"rating\": 9.0},\n  {\"id\": 762216, \"suggestedTranslation\": \"Mục tiêu ĐÃ QUÁ TẢI SỨC CHỨA\", \"rating\": 9.0},\n  {\"id\": 762217, \"suggestedTranslation\": \"ĐƠN VỊ ĐÓ ĐANG BẬN SẠC LẠI\", \"rating\": 9.0},\n  {\"id\": 762219, \"suggestedTranslation\": \"THÔNG TIN XÁC THỰC KHÔNG HỢP LỆ\", \"rating\": 9.0},\n  {\"id\": 762220, \"suggestedTranslation\": \"not_used_by_wx78\", \"rating\": 10.0},\n  {\"id\": 7622