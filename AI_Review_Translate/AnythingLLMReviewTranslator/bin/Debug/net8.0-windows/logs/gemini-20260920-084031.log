          {
            "text": "[\n  {\"id\": 773797, \"suggestedTranslation\": \"Vật Chủ Máy Móc III\", \"rating\": 9.5},\n  {\"id\": 773805, \"suggestedTranslation\": \"Đam Mê Viễn Cơ I\", \"rating\": 9.5},\n  {\"id\": 773807, \"suggestedTranslation\": \"Đam Mê Viễn Cơ II\", \"rating\": 9.5},\n  {\"id\": 773829, \"suggestedTranslation\": \"Một bông hoa được tưới đẫm bởi dòng nước mắt tuôn rơi không ngừng.\", \"rating\": 8.5},\n  {\"id\": 773835, \"suggestedTranslation\": \"Bông hoa chống cháy này có thể chịu được sức nóng của địa ngục.\", \"rating\": 8.5},\n  {\"id\": 773842, \"suggestedTranslation\": \"Một đoá hoa anh thảo trang trọng và đầy bi thương.\", \"rating\": 9.0},\n  {\"id\": 773849, \"suggestedTranslation\": \"Đôi khi bạn phải đánh mất nó để tìm lại chính mình.\", \"rating\": 9.0},\n  {\"id\": 773863, \"suggestedTranslation\": \"Vuốt dọc bộ giáp này sẽ thấy trơn láng một chiều và sắc bén ở chiều ngược lại.\", \"rating\": 8.5},\n  {\"id\": 773943, \"suggestedTranslation\": \"Thơm phức mùi hoa hồng... ngay cả khi mặc bộ lông Gấu Lửng.\", \"rating\": 9.0},\n  {\"id\": 774116, \"suggestedTranslation\": \"Bộ quần áo yếm màu 'xanh siêu thông minh' này rất tuyệt vời khi phải lặn lụp dưới độ sâu.\", \"rating\": 8.5},\n  {\"id\": 774120, \"suggestedTranslation\": \"Đừng lo nếu chiếc áo ngủ màu 'xanh độ pH cao' này hơi rộng so với bạn. Nó chỉ trông càng đáng yêu hơn thôi.\", \"rating\": 8.5},\n  {\"id\": 774123, \"suggestedTranslation\": \"Đừng lo nếu chiếc áo ngủ màu 'cam mật ong vụng về' này hơi rộng so với bạn. Nó chỉ trông càng đáng yêu hơn thôi.\", \"rating\": 8.5},\n  {\"id\": 774129, \"suggestedTranslation\": \"Một chiếc áo polo màu 'xanh siêu thông minh'. Đừng để cổ áo lật phấp phới trong gió nhé.\", \"rating\": 8.5},\n  {\"id\": 774134, \"suggestedTranslation\": \"Một chiếc áo polo màu 'trắng cẩm thạch'. Đừng để cổ áo lật phấp phới trong gió nhé.\", \"rating\": 8.5},\n  {\"id\": 774163, \"suggestedTranslation\": \"Một chiếc áo khoác măng-tô thời trang nhưng chẳng có khả năng bảo vệ, mang màu 'nâu hải ly biến dạng'.\", \"rating\": 8.5},\n  {\"id\": 774164, \"suggestedTranslation\": \"Một chiếc áo khoác măng-tô thời trang nhưng chẳng có khả năng bảo vệ, mang màu 'xám mây bão'.\", \"rating\": 8.5},\n  {\"id\": 774165, \"suggestedTranslation\": \"Một chiếc áo khoác măng-tô thời trang nhưng chẳng có khả năng bảo vệ, mang màu 'giày dính bùn'.\", \"rating\": 8.5},\n  {\"id\": 774166, \"suggestedTranslation\": \"Một chiếc áo khoác măng-tô thời trang nhưng chẳng có khả năng bảo vệ, mang màu 'vàng axit'.\", \"rating\": 8.5},\n  {\"id\": 774182, \"suggestedTranslation\": \"Đừng lạc lõng giữa đám vải tuýt khi mặc món quà lưu niệm màu 'nâu sô-cô-la thiếu thốn' đến từ Làng Tweed này.\", \"rating\": 8.5},\n  {\"id\": 774221, \"suggestedTranslation\": \"Bộ quần yếm này dành cho công việc nghiêm túc, nhưng bạn cứ thoải mái đùa nghịch nhé.\", \"rating\": 9.0},\n  {\"id\": 774238, \"suggestedTranslation\": \"Hãy luôn ấm áp nhé các bạn tôi.\", \"rating\": 9.0},\n  {\"id\": 774353, \"suggestedTranslation\": \"Nếu những bộ quần áo này biết nói, hãy tưởng tượng những câu chuyện chúng sẽ kể đi.\", \"rating\": 9.0},\n  {\"id\": 774354, \"suggestedTranslation\": \"Nếu những bộ quần áo này biết nói, hãy tưởng tượng những câu chuyện chúng sẽ kể đi.\", \"rating\": 9.0},\n  {\"id\": 774497, \"suggestedTranslation\": \"Trang phục Đêm Halloween hóa thân thành Thần Rừng này sẽ thực sự khiến bạn phải mê mẩn.\", \"rating\": 9.0},\n  {\"id\": 774498, \"suggestedTranslation\": \"Trang phục Đêm Halloween hóa thân thành Thần Rừng này sẽ thực sự khiến bạn phải mê mẩn.\", \"rating\": 9.0},\n  {\"id\": 774689, \"suggestedTranslation\": \"Kiệt tác của Mermeer.\", \"rating\": 9.5},\n  {\"id\": 774832, \"suggestedTranslation\": \"Đây là những đôi bốt đến cổ chân của bạn. Cặp này có màu 'đen không còn ánh sáng'.\", \"rating\": 8.5},\n  {\"id\": 774839, \"suggestedTranslation\": \"Một, hai, thắt dây giày màu 'hồng ác mộng' của bạn lại.\", \"rating\": 9.0},\n  {\"id\": 774841, \"suggestedTranslation\": \"Một, hai, thắt dây giày màu 'giày dính bùn' của bạn lại.\", \"rating\": 9.0},\n  {\"id\": 774842, \"suggestedTranslation\": \"Cho đám thỏ thấy mùi lợi hại bằng cách đi đôi dép thỏ xù màu 'chất nhầy ốc sên' này.\", \"rating\": 8.5},\n  {\"id\": 774858, \"suggestedTranslation\": \"Những đôi dép màu 'mèo nhân hình xanh' ấm áp và mềm mại. Mang lại chút niềm vui giữa một thế giới thù địch.\", \"rating\": 8.5},\n  {\"id\": 774898, \"suggestedTranslation\": \"Chinh phục mọi địa hình thật phong cách.\", \"rating\": 9.0},\n  {\"id\": 774901, \"suggestedTranslation\": \"Dành cho tên cướp biển coi trọng giày dép thoải mái hơn tất cả.\", \"rating\": 9.0},\n  {\"id\": 775063, \"suggestedTranslation\": \"firestaff_bee\", \"rating\": 1.0},\n  {\"id\": 775133, \"suggestedTranslation\": \"Găng tay màu 'nâu hải ly biến dạng' có khóa ở mặt sau giúp ôm sát tay bạn.\", \"rating\": 8.5},\n  {\"id\": 775134, \"suggestedTranslation\": \"Găng tay màu 'xanh lạc quẻ' có khóa ở mặt sau giúp ôm sát tay bạn.\", \"rating\": 8.5},\n  {\"id\": 775190, \"suggestedTranslation\": \"Bảo vệ đôi tay của bạn khỏi bụi bẩn và những trận ẩu đả lặt vặt.\", \"rating\": 9.0},\n  {\"id\": 775212, \"suggestedTranslation\": \"Dành cho kẻ khờ dại dũng cảm dám nắm lấy vận mệnh bằng sừng mà không thốt lên một tiếng nào.\", \"rating\": 9.0},\n  {\"id\": 775218, \"suggestedTranslation\": \"Găng tay giáp để xử lý các mẫu dung nham nóng.\", \"rating\": 9.5},\n  {\"id\": 775242, \"suggestedTranslation\": \"Dù có khả năng kháng hóa chất, những chiếc găng tay này chắc chắn sẽ gây ra không ít phản ứng.\", \"rating\": 9.0},\n  {\"id\": 775276, \"suggestedTranslation\": \"Những chiếc găng tay màu 'nâu sô-cô-la thiếu thốn' này trông có vẻ bảo vệ tốt, nhưng thực ra thì không.\", \"rating\": 8.5},\n  {\"id\": 775380, \"suggestedTranslation\": \"icestaff_bee\", \"rating\": 1.0},\n  {\"id\": 775381, \"suggestedTranslation\": \"ICESTAFF_GUNGGNIR\", \"rating\": 1.0},\n  {\"id\": 775385, \"suggestedTranslation\": \"icestaff_northern\", \"rating\": 1.0},\n  {\"id\": 775386, \"suggestedTranslation\": \"icestaff_rose\", \"rating\": 1.0},\n  {\"id\": 775443, \"suggestedTranslation\": \"Quần sọc màu 'xanh quạ'.\", \"rating\": 9.0},\n  {\"id\": 775445, \"suggestedTranslation\": \"Quần sọc màu 'đỏ ruột giun'.\", \"rating\": 9.0},\n  {\"id\": 775454, \"suggestedTranslation\": \"Đừng tự bán rẻ bản thân khi mặc chiếc quần đùi màu 'xanh oxit cô-ban' này.\", \"rating\": 8.5},\n  {\"id\": 775480, \"suggestedTranslation\": \"Quần khiêu vũ màu 'nâu ô-mbra'.\", \"rating\": 9.0},\n  {\"id\": 775485, \"suggestedTranslation\": \"Tận hưởng niềm vui ngập tràn trong chiếc quần lửng phồng màu 'nâu sô-cô-la thiếu thốn' này.\", \"rating\": 8.5},\n  {\"id\": 775486, \"suggestedTranslation\": \"Tận hưởng niềm vui ngập tràn trong chiếc quần lửng phồng màu 'xanh người bảo vệ rừng' này.\", \"rating\": 8.5},\n  {\"id\": 775487, \"suggestedTranslation\": \"Tận hưởng niềm vui ngập tràn trong chiếc quần lửng phồng màu 'xám bạc keo' này.\", \"rating\": 8.5},\n  {\"id\": 775605, \"suggestedTranslation\": \"Tạo hình nhân mã này thật mê hồn!\", \"rating\": 9.0},\n  {\"id\": 775638, \"suggestedTranslation\": \"Có những thứ xứng đáng bị lãng quên...\", \"rating\": 9.0},\n  {\"id\": 775674, \"suggestedTranslation\": \"Có thứ gì đó đang thao túng các sinh vật ở The Constant... thứ gì đó không thuộc về thế giới này...\", \"rating\": 9.0},\n  {\"id\": 775727, \"suggestedTranslation\": \"Cố gắng giải thích tâm lý của gã hề kịch câm này là một việc vô ích... thực chất là trò đùa tháng Tư đấy.\", \"rating\": 9.0},\n  {\"id\": 775731, \"suggestedTranslation\": \"Thật tuyệt vời, cô Wickerbottom nhận ra niềm đam mê với con chữ của mình ngày càng sâu sắc theo năm tháng. Bạn biết đấy, mọi kiến thức ghi lên giấy sẽ miễn nhiễm với sương mù não do tuổi tác!\", \"rating\": 9.5},\n  {\"id\": 775749, \"suggestedTranslation\": \"Sáng tạo được đánh giá bởi ánh mắt soi mói đầy lạnh lùng của người tạo ra nó.\", \"rating\": 9.0},\n  {\"id\": 775811, \"suggestedTranslation\": \"Sự thông thái của Người Cá vượt xa tầm hiểu biết của chúng ta, và của cả chính họ nữa.\", \"rating\": 9.0},\n  {\"id\": 775875, \"suggestedTranslation\": \"Gói Quà Rotwood\", \"rating\": 9.5},\n  {\"id\": 775898, \"suggestedTranslation\": \"Tặng họ một cú câu kết hợp nấu nướng kinh điển đi nào.\", \"rating\": 9.0},\n  {\"id\": 775911, \"suggestedTranslation\": \"Rương Vật phẩm và Trang phục Thám hiểm Nguyệt Liên Huyền bí này chứa Rương Hợp tuyển Huyền bí, Rương Hiệp sĩ Nguyệt Liên, Rương Vật phẩm Thám hiểm, cùng các trang phục Nguyệt Liên của Woodie, Wortox và Wurt; và các bộ trang phục Thám hiểm của Wanda, Wigfrid và Wes.\", \"rating\": 9.5},\n  {\"id\": 775926, \"suggestedTranslation\": \"Bộ dụng cụ thợ cắt tóc này chứa các vật phẩm trang phục sau: Dao cạo của thợ cắt tóc, Hình nộm gọn gàng và Đuốc dầu.\", \"rating\": 9.5},\n  {\"id\": 775966, \"suggestedTranslation\": \"Chiếc rương kỳ ảo này chứa các vật phẩm trang phục sau: Cột mốc đường kỳ ảo, Bảng tên kỳ ảo, Cọc hàng rào kỳ ảo, Dơi kỳ ảo, Mũ lông kỳ ảo, Rương quái thú, Ô mắt quái thú, Đá sưởi mê hoặc, Nhà người cá kỳ ảo, Glommer tiên, Ếch hoàng tử Hutch.\", \"rating\": 9.5},\n  {\"id\": 775967, \"suggestedTranslation\": \"Chiếc rương kỳ ảo này chứa các vật phẩm trang phục sau: Lỗ sâu nhớt nháp, Vòng tròn tiên, Trụ cột mê hoặc, Hang động huyền bí, Bia mộ buồn ngủ và Hòn đá triết gia.\", \"rating\": 9.5},\n  {\"id\": 775986, \"suggestedTranslation\": \"Rương đồ đạc gothic này chứa các vật phẩm trang phục sau: Gói quà ảm đạm, Hố lửa gothic, Hàng rào gothic, Cổng kính màu, Đèn lồng gothic, Kẻ gọi sấm sét gothic, Trang viên hoang phế, Lò luyện kim đan gothic, Dụng cụ khoa học gothic, Bàn thợ thủ công gothic, Trụ cột gothic và Tủ quần áo gothic.\", \"rating\": 9.5},\n  {\"id\": 776005, \"suggestedTranslation\": \"Rương Sinh Vật này chứa toàn bộ các món trang phục Đêm Hallowed của Winona.\", \"rating\": 9.5},\n  {\"id\": 776014, \"suggestedTranslation\": \"Rương dụng cụ của gã hề chứa các vật phẩm trang phục sau: Gậy hề, Sáo hề và Mũ hề.\", \"rating\": 9.5},\n  {\"id\": 776017, \"suggestedTranslation\": \"Rương của Người ẩn dật này chứa các trang phục sau: Thùng ong ngọc trai, Giá thịt san hô, Giá thịt san hô lớn, Ghế vỏ sò, Ghế đẩu vỏ sò, Bàn tròn vỏ sò, Bàn vỏ sò, Thùng dụng cụ câu vỏ sò, Tường vỏ sò, Hàng rào vỏ sò, Cổng vỏ sò, Hộp câu ngọc trai, Hộp đánh bắt đặc biệt ngọc trai, Cần câu khớp nối, Cần câu dây leo rối và Cần câu kiếm.\", \"rating\": 9.5},\n  {\"id\": 776065, \"suggestedTranslation\": \"Rương Mặt Trăng đối đầu Bóng Tối này chứa các trang phục Nguyệt Liên của Winona, Wigfrid và Wolfgang, cùng các trang phục Khải Hoàn của Wortox, Walter và Warly.\", \"rating\": 9.5},\n  {\"id\": 776118, \"suggestedTranslation\": \"Rương thư viện này chứa các vật phẩm trang phục sau: Bùa mắt tâm trí, Kệ sách gỗ óc chó và Bảng tên thư viện.\", \"rating\": 9.5},\n  {\"id\": 776119, \"suggestedTranslation\": \"Rương chiến lợi phẩm hải lập dị này chứa các vật phẩm trang phục sau: Thùng rác hải tặc, Cột buồm dã chiến, Bè hải tặc, Bè thô sơ, Lưới đánh cá xương chéo và Tời trục vớt.\", \"rating\": 9.5},\n  {\"id\": 776132, \"suggestedTranslation\": \"Rương Tráp Thánh Tích này chứa các vật phẩm trang phục sau: Bùa Ánh Sáng Mờ, Bùa Iterum, Bùa Qualming, Bùa Robustum, Bùa Reaping, Bùa Sepulchral, Giáp xương hoa văn, Mũ xương hoa văn, Gậy gọi sao xoắn, Gậy gọi trăng xoắn, Tường Đá Kinh Hoàng nhiều lớp, Kẻ đào ngũ bí ẩn và Đèn chong đêm hoa văn.\", \"rating\": 9.5},\n  {\"id\": 776136, \"suggestedTranslation\": \"Gói Quà Don't Starve: Reign of Giants\", \"rating\": 9.5},\n  {\"id\": 776143, \"suggestedTranslation\": \"Rương Thám hiểm Rosy Roaring này chứa Rương Nội thất Rosy, Rương Tiện nghi Rosy, Rương Trang trí Rosy, Rương Roarer và Rương Đồ thám hiểm Phần II\", \"rating\": 9.5},\n  {\"id\": 776148, \"suggestedTranslation\": \"Rương nhà thám hiểm này chứa các trang phục vật dụng tò mò dành cho những ai có trái tim gan dạ.\", \"rating\": 