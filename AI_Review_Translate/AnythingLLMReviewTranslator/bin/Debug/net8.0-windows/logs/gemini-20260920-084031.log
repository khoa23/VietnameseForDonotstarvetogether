,\n  {\"id\":770970,\"suggestedTranslation\":\"Kết bạn với một người bạn bò.\",\"rating\":8.5},\n  {\"id\":770971,\"suggestedTranslation\":\"Bảo vệ khỏi lũ ong nổi giận.\",\"rating\":9.0},\n  {\"id\":770972,\"suggestedTranslation\":\"Ong được vũ khí hóa. Chuyện gì có thể tồi tệ hơn được chứ?\",\"rating\":8.5},\n  {\"id\":770974,\"suggestedTranslation\":\"Một chất bảo quản hóa đá cho thực vật.\",\"rating\":9.0},\n  {\"id\":770975,\"suggestedTranslation\":\"Cái chuông này không phải dạng vừa đâu.\",\"rating\":8.5},\n  {\"id\":770976,\"suggestedTranslation\":\"Một gương mặt quen thuộc giữa thế giới điên loạn này.\",\"rating\":8.5},\n  {\"id\":770977,\"suggestedTranslation\":\"Ngôi nhà hạnh phúc cho những người bạn có cánh.\",\"rating\":8.5},\n  {\"id\":770978,\"suggestedTranslation\":\"Bắt giữ những sinh vật có cánh.\",\"rating\":8.5},\n  {\"id\":770979,\"suggestedTranslation\":\"Phun lửa vào kẻ thù của bạn.\",\"rating\":9.0},\n  {\"id\":770980,\"suggestedTranslation\":\"Phun răng vào kẻ thù của bạn.\",\"rating\":8.5},\n  {\"id\":770981,\"suggestedTranslation\":\"Phun cơn buồn ngủ vào kẻ thù của bạn.\",\"rating\":8.5},\n  {\"id\":770982,\"suggestedTranslation\":\"Phun sét vào kẻ thù của bạn.\",\"rating\":9.0},\n  {\"id\":770983,\"suggestedTranslation\":\"Chiếc bùa mới mát mẻ làm sao.\",\"rating\":8.5},\n  {\"id\":770984,\"suggestedTranslation\":\"Mang một màu xanh lam.\",\"rating\":8.5},\n  {\"id\":770985,\"suggestedTranslation\":\"Một bản mô phỏng chân thực nhất có thể.\",\"rating\":8.5},\n  {\"id\":770986,\"suggestedTranslation\":\"Xây dựng một sàn nhà theo phong cách của nền văn minh cổ đại.\",\"rating\":8.5},\n  {\"id\":770987,\"suggestedTranslation\":\"Cảm giác như đang ăn mọi loại nấm trên đời.\",\"rating\":8.5},\n  {\"id\":770988,\"suggestedTranslation\":\"Giống khúc gỗ, nhưng phẳng hơn.\",\"rating\":8.5},\n  {\"id\":770989,\"suggestedTranslation\":\"Tích trữ ván ép của bạn.\",\"rating\":9.0},\n  {\"id\":770990,\"suggestedTranslation\":\"Chưa bao giờ là quá muộn