{\"id\":767047,\"suggestedTranslation\":\"*Triệu hồi Đấu sĩ Bóng tối sau khi tập trung tấn công vào một mục tiêu\\n\\n\\nChuyên môn:\\nSách, Gậy\",\"rating\":8.5},\n  {\"id\":767048,\"suggestedTranslation\":\"*Có những chú nhện tí hon đi cùng\\n\\n\\n\\nChuyên môn:\\nTiêu\",\"rating\":8.5},\n  {\"id\":767049,\"suggestedTranslation\":\"*Được bảo vệ bởi người chị song sinh Abigail\\n\\n\\n\\nChuyên môn:\\nTiêu, Gậy\",\"rating\":8.5},\n  {\"id\":767050,\"suggestedTranslation\":\"*Được hồi sinh nhanh gấp đôi\\n*Rất ít thu hút thù hận khi tấn công\\n*Khó bị mất thù hận hơn một khi đã nhắm đến\\n\\nChuyên môn:\\nCận chiến, Tiêu, Gậy\",\"rating\":8.5},\n  {\"id\":767051,\"suggestedTranslation\":\"*Nhận bùa lợi sau khi gây đủ sát thương, cường hóa phép thuật tiếp theo\\n\\n\\nChuyên môn:\\nSách, Gậy\",\"rating\":8.5},\n  {\"id\":767052,\"suggestedTranslation\":\"*Được bảo vệ bởi Gấu Bernie\\n*Sát thương tấn công từ lửa và thuốc nổ tăng 10%\\n\\nChuyên môn:\\nTiêu, Gậy\",\"rating\":8.5},\n  {\"id\":767053,\"suggestedTranslation\":\"*Hồi sinh đồng minh nhanh gấp đôi\\n*Hồi phục lượng máu gấp ba lần khi hồi sinh đồng minh\\n\\nChuyên môn:\\nCận chiến, Tiêu, Gậy\",\"rating\":8.5},\n  {\"id\":767054,\"suggestedTranslation\":\"*Tất cả thời gian hồi chiêu nhanh hơn 10%\\n\\n\\n\\nChuyên môn:\\nCận chiến, Tiêu, Gậy\",\"rating\":8.5},\n  {\"id\":767055,\"suggestedTranslation\":\"*Trở nên Hùng Mạnh khi thấp máu, tăng sức tấn công, phòng thủ và tốc độ di chuyển trong 10 giây\\n\\nChuyên môn:\\nCận chiến\",\"rating\":8.5},\n  {\"id\":767056,\"suggestedTranslation\":\"CHƯA CÓ\\n\\n\\n\\nChuyên môn:\\nCHƯA CÓ\",\"rating\":8.5},\n  {\"id\":767057,\"suggestedTranslation\":\"*Lucy sẽ quay về với Woodie khi bị ném đi\\n*Tăng tốc độ tấn công khi cầm Lucy\\n\\nChuyên môn:\\nCận chiến\",\"rating\":8.5},\n  {\"id\":767058,\"suggestedTranslation\":\"*Lucy sẽ quay về với Woodie khi bị ném đi\\n*Tăng tốc độ tấn công khi cầm Lucy\\n\\nChuyên môn:\\nCận chiến\",\"rating\":8.5},\n  {\"id\":767059,\"suggestedTranslation\":\"*Lucy sẽ quay về với Woodie khi bị ném đi\\n*Tăng tốc độ tấn công khi cầm Lucy\\n\\nChuyên môn:\\nCận chiến\",\"rating\":8.5},\n  {\"id\":767060,\"suggestedTranslation\":\"*CHƯA CÓ\\n\\n\\n\\nChuyên môn:\\nCHƯA CÓ\",\"rating\":8.5},\n  {\"id\":767061,\"suggestedTranslation\":\"*CHƯA CÓ\\n\\n\\n\\nChuyên môn:\\nCHƯA CÓ\",\"rating\":8.5},\n  {\"id\":767062,\"suggestedTranslation\":\"*CHƯA CÓ\\n\\n\\n\\nChuyên môn:\\nCHƯA CÓ\",\"rating\":8.5},\n  {\"id\":767063,\"suggestedTranslation\":\"*Gây sốc kẻ thù khi bị tấn công\\n*Sát thương tấn công bằng điện tăng 50%\\n\\nChuyên môn:\\nCận chiến\",\"rating\":8.5},\n  {\"id\":767064,\"suggestedTranslation\":\"Nóng quá đi!\",\"rating\":8.5},\n  {\"id\":767066,\"suggestedTranslation\":\"Tôi nghĩ chúng ta sắp thắng rồi đấy!\",\"rating\":8.5},\n  {\"id\":767067,\"suggestedTranslation\":\"Họ không có cửa đâu!\",\"rating\":8.5},\n  {\"id\":767068,\"suggestedTranslation\":\"Trời ạ, trong này nóng thật đấy.\",\"rating\":8.5},\n  {\"id\":767069,\"suggestedTranslation\":\"Đánh! Đánh nó!\",\"rating\":8.5},\n  {\"id\":767070,\"suggestedTranslation\":\"Đập chết nó!\",\"rating\":8.5},\n  {\"id\":767071,\"suggestedTranslation\":\"Cho chúng một nhát đi!\",\"rating\":8.5},\n  {\"id\":767072,\"suggestedTranslation\":\"Khán giả hò reo sung quá!\",\"rating\":8.5},\n  {\"id\":767073,\"suggestedTranslation\":\"Ối!\",\"rating\":8.5},\n  {\"id\":767074,\"suggestedTranslation\":\"Trượt mất tiêu!\",\"rating\":8.5},\n  {\"id\":767075,\"suggestedTranslation\":\"Đen thế!\",\"rating\":8.5},\n  {\"id\":767076,\"suggestedTranslation\":\"Này!\",\"rating\":8.5},\n  {\"id\":767077,\"suggestedTranslation\":\"Quay lại đây mau!\",\"rating\":8.5},\n  {\"id\":767078,\"suggestedTranslation\":\"Tôi không khoái vụ này lắm đâu.\",\"rating\":8.5},\n  {\"id\":767079,\"suggestedTranslation\":\"Cầm kiểu gì thế hả!\",\"rating\":8.5},\n  {\"id\":767080,\"suggestedTranslation\":\"Tay ông đổ mồ hôi kì cục quá.\",\"rating\":8.5},\n  {\"id\":767081,\"suggestedTranslation\":\"Ném tôi đi lẹ lên xem nào!\",\"rating\":8.5},\n  {\"id\":767082,\"suggestedTranslation\":\"Đây không phải là chuyện thường xuyên đâu đấy.\",\"rating\":8.5},\n  {\"id\":767083,\"suggestedTranslation\":\"Đừng có suy diễn lung tung nhé.\",\"rating\":8.5},\n  {\"id\":767084,\"suggestedTranslation\":\"Dính đòn nhé!\",\"rating\":8.5},\n  {\"id\":767085,\"suggestedTranslation\":\"Nhận lấy này!\",\"rating\":8.5},\n  {\"id\":767086,\"suggestedTranslation\":\"Ăn đòn này!\",\"rating\":8.5},\n  {\"id\":767087,\"suggestedTranslation\":\"Trúng hồng tâm!\",\"rating\":8.5},\n  {\"id\":767089,\"suggestedTranslation\":\"Bốp!\",\"rating\":8.5},\n  {\"id\":767090,\"suggestedTranslation\":\"Anh ổn chứ?\",\"rating\":8.5},\n  {\"id\":767091,\"suggestedTranslation\":\"Ổn không đấy, anh bạn lực lưỡng?\",\"rating\":8.5},\n  {\"id\":767092,\"suggestedTranslation\":\"Sao thế nhỉ?\",\"rating\":8.5},\n  {\"id\":767093,\"suggestedTranslation\":\"Anh chắc là mình vẫn ổn chứ?\",\"rating\":8.5},\n  {\"id\":767094,\"suggestedTranslation\":\"Hôm nay trông anh có vẻ gắt gỏng hơn đấy.\",\"rating\":8.5},\n  {\"id\":767095,\"suggestedTranslation\":\"Trông anh cứ lơ đễnh thế nào ấy.\",\"rating\":8.5},\n  {\"id\":767096,\"suggestedTranslation\":\"Sao mặt anh trông nhăn nhó thế kia?\",\"rating\":8.5},\n  {\"id\":767097,\"suggestedTranslation\":\"Cố gắng hít thở sâu vào nhé, được chứ?\",\"rating\":8.5},\n  {\"id\":767098,\"suggestedTranslation\":\"Anh làm quá lên rồi đấy!\",\"rating\":8.5},\n  {\"id\":767099,\"suggestedTranslation\":\"Anh chẳng thèm kiềm chế bản thân gì cả!\",\"rating\":8.5},\n  {\"id\":767100,\"suggestedTranslation\":\"Anh sắp biến đổi rồi kìa!\",\"rating\":8.5},\n  {\"id\":767101,\"suggestedTranslation\":\"Bình tĩnh nào!\",\"rating\":8.5},\n  {\"id\":767102,\"suggestedTranslation\":\"Anh phải chậm lại thôi!\",\"rating\":8.5},\n  {\"id\":767103,\"suggestedTranslation\":\"Chậm lại đi, em lo cho anh lắm đấy!\",\"rating\":8.5},\n  {\"id\":767104,\"suggestedTranslation\":\"Cẩn thận! Anh sắp biến hình rồi kìa!\",\"rating\":8.5},\n  {\"id\":767105,\"suggestedTranslation\":\"Alo? Anh có nghe thấy em nói không?\",\"rating\":8.5},\n  {\"id\":767106,\"suggestedTranslation\":\"Không phải đã đến lúc làm chút đồ ăn nhẹ bằng gỗ rồi sao?\",\"rating\":8.5},\n  {\"id\":767107,\"suggestedTranslation\":\"Woodie! Nhớ ăn cành cây của anh đi đấy!\",\"rating\":8.5},\n  {\"id\":767108,\"suggestedTranslation\":\"Có khi anh nên ăn một khúc gỗ đi.\",\"rating\":8.5},\n  {\"id\":767109,\"suggestedTranslation\":\"Mmm, vỏ cây... nghe hấp dẫn phết đúng không nào? Hửm?\",\"rating\":8.5},\n  {\"id\":767110,\"suggestedTranslation\":\"Anh lại bỏ bữa món gỗ của mình nữa rồi à?\",\"rating\":8.5},\n  {\"id\":767111,\"suggestedTranslation\":\"Này, này, làm một mẩu gỗ vụn đi.\",\"rating\":8.5},\n  {\"id\":767112,\"suggestedTranslation\":\"Anh biết điều gì sẽ xảy ra nếu không ăn đủ gỗ rồi đấy!\",\"rating\":8.5},\n  {\"id\":767113,\"suggestedTranslation\":\"Suýt thì nguy!\",\"rating\":8.5},\n  {\"id\":767114,\"suggestedTranslation\":\"Em nghĩ chúng ta ổn rồi đấy.\",\"rating\":8.5},\n  {\"id\":767115,\"suggestedTranslation\":\"Trông anh khá hơn nhiều rồi đấy.\",\"rating\":8.5},\n  {\"id\":767116,\"suggestedTranslation\":\"Qua cơn hoạn nạn rồi. Tạm thời là thế.\",\"rating\":8.5},\n  {\"id\":767117,\"suggestedTranslation\":\"Em thật ngốc khi cứ hoài nghi anh.\",\"rating\":8.5},\n  {\"id\":767118,\"suggestedTranslation\":\"Chà, cứ tưởng phen này anh toi rồi chứ!\",\"rating\":8.5},\n  {\"id\":767119,\"suggestedTranslation\":\"Em thấy má anh hồng hào trở lại rồi đấy.\",\"rating\":8.5},\n  {\"id\":767120,\"suggestedTranslation\":\"Trở lại bình thường rồi. Phù!\",\"rating\":8.5},\n  {\"id\":767121,\"suggestedTranslation\":\"Chỉ những gì tốt nhất cho anh thôi, bạn tôi ơi!\",\"rating\":8.5},\n  {\"id\":767122,\"suggestedTranslation\":\"Heh, cái này chắc chắn sẽ rất đặc biệt đây!\",\"rating\":8.5},\n  {\"id\":767123,\"suggestedTranslation\":\"Phải bảo vệ cái đầu xinh xắn của anh chứ!\",\"rating\":8.5},\n  {\"id\":767124,\"suggestedTranslation\":\"Xem tôi trổ tài phép thuật đây!\",\"rating\":8.5},\n  {\"id\":767125,\"suggestedTranslation\":\"Cẩn thận bị dằm đâm đấy nhé!\",\"rating\":8.5},\n  {\"id\":767126,\"suggestedTranslation\":\"Muốn ván ép à? Tôi cho anh thấy thế nào là ván ép nhé! Hây-YẠ!\",\"rating\":8.5},\n  {\"id\":767127,\"suggestedTranslation\":\"Đi chặt vài cái cây nào!\",\"rating\":8.5},\n  {\"id\":767128,\"suggestedTranslation\":\"Chặt, chặt, chặt. Heh.\",\"rating\":8.5},\n  {\"id\":767129,\"suggestedTranslation\":\"Chặt, c-c-chặt nào!\",\"rating\":8.5},\n  {\"id\":767130,\"suggestedTranslation\":\"Ừ thì, cây bằng đá... chuyện quái gì thế nhỉ?\",\"rating\":8.5},\n  {\"id\":767131,\"suggestedTranslation\":\"Tìm một khu rừng nhỏ rồi quậy tưng bừng lên nào!\",\"rating\":8.5},\n  {\"id\":767132,\"suggestedTranslation\":\"Thời tiết đẹp thế này để đi dạo là chuẩn bài!\",\"rating\":8.5},\n  {\"id\":767133,\"suggestedTranslation\":\"Chúng ta là một cặp bài trùng đấy!\",\"rating\":8.5},\n  {\"id\":767134,\"suggestedTranslation\":\"Chắc phải có mấy cái cây nào quanh đây chứ.\",\"rating\":8.5},\n  {\"id\":767135,\"suggestedTranslation\":\"Thời tiết lý tưởng để chặt chém đây rồi.\",\"rating\":8.5},\n  {\"id\":767136,\"suggestedTranslation\":\"Một ngày tuyệt vời để đi chặt cây.\",\"rating\":8.5},\n  {\"id\":767137,\"suggestedTranslation\":\"Anh có nghề đấy, bạn tôi ơi.\",\"rating\":8.5},\n  {\"id\":767138,\"suggestedTranslation\":\"Này! Đi chặt vài cái cây đi chứ!\",\"rating\":8.5},\n  {\"id\":767139,\"suggestedTranslation\":\"Làm việc suốt mà chẳng chơi đùa gì khiến tôi lại thèm đi chặt cây quá.\",\"rating\":8.5},\n  {\"id\":767140,\"suggestedTranslation\":\"Trong này tối thui hà!\",\"rating\":8.5},\n  {\"id\":767141,\"suggestedTranslation\":\"Em chẳng thấy đường nào cả!\",\"rating\":8.5},\n  {\"id\":767142,\"suggestedTranslation\":\"Thật tình thì đây là nơi tệ nhất rồi.\",\"rating\":8.5},\n  {\"id\":767143,\"suggestedTranslation\":\"Em ghét phải ở trong này lắm rồi đấy.\",\"rating\":8.5},\n  {\"id\":767144,\"suggestedTranslation\":\"Tôi đã làm gì sai với anh cơ chứ?\",\"rating\":8.5},\n  {\"id\":767145,\"suggestedTranslation\":\"Em sợ lắm!\",\"rating\":8.5},\n  {\"id\":767146,\"suggestedTranslation\":\"Cứu với! Thả tôi ra mau!\",\"rating\":8.5},\n  {\"id\":767147,\"suggestedTranslation\":\"Trong này chẳng có gì để chặt cả!\",\"rating\":8.5},\n  {\"id\":767148,\"suggestedTranslation\":\"Chán chết đi được.\",\"rating\":8.5},\n  {\"id\":767149,\"suggestedTranslation\":\"Thảeee tôiiii raaaa mauuu!\",\"rating\":8.5},\n  {\"id\":767150,\"suggestedTranslation\":\"Em bị chứng sợ không gian hẹp rồi!\",\"rating\":8.5},\n  {\"id\":767151,\"suggestedTranslation\":\"Tôi sợ mấy nơi chật chội lắm!\",\"rating\":8.5},\n  {\"id\":767152,\"suggestedTranslation\":\"Em thở không nổi nữa! Khoan đã.\",\"rating\":8.5},\n  {\"id\":767153,\"suggestedTranslation\":\"Woooooo!\",\"rating\":8.5},\n  {\"id\":767156,\"suggestedTranslation\":\"Chết đi! Chết hết đi!\",\"rating\":8.5},\n  {\"id\":767158,\"suggestedTranslation\":\"Phá hủy thôi!\",\"rating\":8.5},\n  {\"id\":767160,\"suggestedTranslation\":\"Đã cái nết thật đấy!\",\"rating\":8.5},\n  {\"id\":767161,\"suggestedTranslation\":\"Tiêu diệt toàn bộ cây cối!\",\"rating\":8.5},\n  {\"id\":767162,\"suggestedTranslation\":\"Nữa đi! Chặt thêm cây khác nào!\",\"rating\":8.5},\n  {\"id\":767163,\"suggestedTranslation\":\"Vung rìu chuẩn đấy!\",\"rating\":8.5},\n  {\"id\":767164,\"suggestedTranslation\":\"Yeah!\",\"rating\":8.5},\n  {\"id\":767165,\"suggestedTranslation\":\"Dễ như ăn bánh!\",\"rating\":8.5},\n  {\"id\":767166,\"suggestedTranslation\":\"Cái cây ngốc nghếch!\",\"rating\":8.5},\n  {\"id\":767167,\"suggestedTranslation\":\"Măm măm măm!\",\"rating\":8.5},\n  {\"id\":767168,\"suggestedTranslation\":\"Chúng ta làm được rồi!\",\"rating\":8.5},\n  {\"id\":767169,\"suggestedTranslation\":\"Tôi thấy mình như đang SỐNG dậy vậy!\",\"rating\":8.5},\n  {\"id\":767172,\"suggestedTranslation\":\"Đây mới chính là lẽ sống của tôi!\",\"rating\":8.5},\n  {\"id\":767173,\"suggestedTranslation\":\"Anh sẽ quay lại phải không?\",\"rating\":8.5},\n  {\"id\":767174,\"suggestedTranslation\":\"Chúng ta là bạn cơ mà?\",\"rating\":8.5},\n  {\"id\":767175,\"suggestedTranslation\":\"Ai lại đi vứt bỏ một cây rìu biết nói chứ hả?!\",\"rating\":8.5},\n  {\"id\":767176,\"suggestedTranslation\":\"Em... không thể hiểu nổi!\",\"rating\":8.5},\n  {\"id\":767177,\"suggestedTranslation\":\"Chúng ta nói chuyện lại được không?\",\"rating\":8.5},\n  {\"id\":767178,\"suggestedTranslation\":\"Đừng quên em nhé!\",\"rating\":8.5},\n  {\"id\":767179,\"suggestedTranslation\":\"Ối!\",\"rating\":8.5},\n  {\"id\":767180,\"suggestedTranslation\":\"Em không thích cục diện này tẹo nào đâu.\",\"rating\":8.5},\n  {\"id\":767181,\"suggestedTranslation\":\"Bộ... bộ anh định biến thành cái cây luôn hả?\",\"rating\":8.5},\n  {\"id\":767182,\"suggestedTranslation\":\"Đau thế!\",\"rating\":8.5},\n  {\"id\":767183,\"suggestedTranslation\":\"Em vừa nói gì cơ chứ?\",\"rating\":8.5},\n  {\"id\":767184,\"suggestedTranslation\":\"Ôi, chơi dơ thế nhỉ.\",\"rating\":8.5},\n  {\"id\":767185,\"suggestedTranslation\":\"Đừng bỏ đi! Em... em thấy hình như có mùi hoa hồng nè!\",\"rating\":8.5},\n  {\"id\":767186,\"suggestedTranslation\":\"Em biết đây chỉ là chuyện tạm thời thôi mà...\",\"rating\":8.5},\n  {\"id\":767187,\"suggestedTranslation\":\"Awww...\",\"rating\":8.5},\n  {\"id\":767188,\"suggestedTranslation\":\"Ồ, hóa ra anh đối xử với em vậy đấy hả?!\",\"rating\":8.5},\n  {\"id\":767189,\"suggestedTranslation\":\"Này! Em có bao giờ ném anh đi đâu cơ chứ!\",\"rating\":8.5},\n  {\"id\":767190,\"suggestedTranslation\":\"Sao anh lại ném em đi cơ chứ?\",\"rating\":8.5},\n  {\"id\":767191,\"suggestedTranslation\":\"Quay lại đây! Mang em theo với!\",\"rating\":8.5},\n  {\"id\":767192,\"suggestedTranslation\":\"Này! Quay lại đây mau!\",\"rating\":8.5},\n  {\"id\":767193,\"suggestedTranslation\":\"Tôi không thể tự chặt cây một mình được đâu!\",\"rating\":8.5},\n  {\"id\":767194,\"suggestedTranslation\":\"Cô đơn... quá đi...\",\"rating\":8.5},\n  {\"id\":767195,\"suggestedTranslation\":\"Chắc tôi cứ ở lì đây luôn quá...\",\"rating\":8.5},\n  {\"id\":767196,\"suggestedTranslation\":\"Nhỡ em bị ai cuỗm mất thì sao?!\",\"rating\":8.5},\n  {\"id\":767197,\"suggestedTranslation\":\"Anh đi đâu mất tiêu rồi?\",\"rating\":8.5},\n  {\"id\":767198,\"suggestedTranslation\":\"Dẫn em theo với!\",\"rating\":8.5},\n  {\"id\":767199,\"suggestedTranslation\":\"Lạnh quá đi mất!\",\"rating\":8.5},\n  {\"id\":767200,\"suggestedTranslation\":\"Người tôi dính đầy đất cát rồi đây này!\",\"rating\":8.5},\n  {\"id\":767201,\"suggestedTranslation\":\"Xung quanh đầy quái vật kìa, anh biết không hả!\",\"rating\":8.5},\n  {\"id\":767202,\"suggestedTranslation\":\"Tôi cay lắm rồi đấy nhé!\",\"rating\":8.5},\n  {\"id\":767203,\"suggestedTranslation\":\"Anh dám bỏ rơi tôi đấy à?!\",\"rating\":8.5},\n  {\"id\":767204,\"suggestedTranslation\":\"Nhưng mà... chúng ta là một cặp không thể tách rời cơ mà!\",\"rating\":8.5},\n  {\"id\":767205,\"suggestedTranslation\":\"Ái, đau đấy.\",\"rating\":8.5},\n  {\"id\":767206,\"suggestedTranslation\":\"Tôi đã làm gì thốn lắm với anh hả!?\",\"rating\":8.5},\n  {\"id\":767207,\"suggestedTranslation\":\"Đúng là con ma lanh lợi nhất quả đất!\",\"rating\":8.5},\n  {\"id\":767208,\"suggestedTranslation\":\"Chết rồi thì nằm im đi, đừng có mà trút giận lên tôi!\",\"rating\":8.5},\n  {\"id\":767209,\"suggestedTranslation\":\"Mà mày có xác thịt tao băm cho tơi bời rồi đấy!\",\"rating\":8.5},\n  {\"id\":767210,\"suggestedTranslation\":\"OOooOOooOOoo! Haha, đùa tí thôi mà.\",\"rating\":8.5},\n  {\"id\":767211,\"suggestedTranslation\":\"Ghê rợn thật!\",\"rating\":8.5},\n  {\"id\":767212,\"suggestedTranslation\":\"Brrr! Lạnh buốt cả người!\",\"rating\":8.5},\n  {\"id\":767213,\"suggestedTranslation\":\"Cả đống chất nhầy ma quái dính cả lên cán tôi rồi kìa!!\",\"rating\":8.5},\n  {\"id\":767214,\"suggestedTranslation\":\"Thôi ngay cái trò đó đi!\",\"rating\":8.5},\n  {\"id\":767215,\"suggestedTranslation\":\"Hỗn xược!\",\"rating\":8.5},\n  {\"id\":767216,\"suggestedTranslation\":\"ooOOoooOO lại anh luôn cho bõ tức.\",\"rating\":8.5},\n  {\"id\":767217,\"suggestedTranslation\":\"Tôi là một cây rìu bị ám đấy nhé!\",\"rating\":8.5},\n  {\"id\":767218,\"suggestedTranslation\":\"Tìm đứa nào to xác bằng mình mà hù đi!\",\"rating\":8.5},\n  {\"id\":767219,\"suggestedTranslation\":\"Này!\",\"rating\":8.5},\n  {\"id\":767220,\"suggestedTranslation\":\"Trời ạ! Kiếp trước tôi có gây thù chuốc oán gì với anh không thế?\",\"rating\":8.5},\n  {\"id\":767221,\"suggestedTranslation\":\"Mặt tôi trắng bệch ra như tờ giấy rồi đây này.\",\"rating\":8.5},\n  {\"id\":767222,\"suggestedTranslation\":\"Hôm nay trông anh \\\"ma-mị\\\" xinh xắn phết đấy.\",\"rating\":8.5},\n  {\"id\":767223,\"suggestedTranslation\":\"Giờ thì tôi thành một chiếc rìu BỊ MA ÁM rồi đấy.\",\"rating\":8.5},\n  {\"id\":767224,\"suggestedTranslation\":\"Tôi đéo sợ ma quỷ gì đâu nhé!\",\"rating\":8.5},\n  {\"id\":767225,\"suggestedTranslation\":\"Boo cái gì mà boo?\",\"rating\":8.5},\n  {\"id\":767226,\"suggestedTranslation\":\"Cảnh tượng này tôi gặp hoài.\",\"rating\":8.5},\n  {\"id\":767227,\"suggestedTranslation\":\"Bộ anh nghĩ tôi sợ anh chắc?\",\"rating\":8.5},\n  {\"id\":767228,\"suggestedTranslation\":\"Muốn làm gì thì làm đi, con ma kia.\",\"rating\":8.5},\n  {\"id\":767229,\"suggestedTranslation\":\"Biến đi chỗ khác chơi chỗ người ta nhờ! Haha.\",\"rating\":8.5},\n  {\"id\":767230,\"suggestedTranslation\":\"Em nhớ anh muốn chết đi được!\",\"rating\":8.5},\n  {\"id\":767231,\"suggestedTranslation\":\"Anh có nhớ em không thế?\",\"rating\":8.5},\n  {\"id\":767232,\"suggestedTranslation\":\"Lại được kề vai sát cánh rồi!\",\"rating\":8.5},\n  {\"id\":767233,\"suggestedTranslation\":\"Ahhh, về đúng chốn thuộc về rồi đây.\",\"rating\":8.5},\n  {\"id\":767234,\"suggestedTranslation\":\"Đoàn tụ thật là sướng quá đi!\",\"rating\":8.5},\n  {\"id\":767235,\"suggestedTranslation\":\"Em cứ sợ là anh sẽ bỏ đi luôn chứ.\",\"rating\":8.5},\n  {\"id\":767236,\"suggestedTranslation\":\"Cuối cùng anh cũng quay lại vì em!\",\"rating\":8.5},\n  {\"id\":767237,\"suggestedTranslation\":\"Ôi, tạ ơn trời đất.\",\"rating\":8.5},\n  {\"id\":767238,\"suggestedTranslation\":\"Ôi, kinh khủng thật đấy!\",\"rating\":8.5},\n  {\"id\":767239,\"suggestedTranslation\":\"Đừng bao giờ làm thế nữa nhé! Trái tim bé nhỏ của em chịu không thấu đâu.\",\"rating\":8.5},\n  {\"id\":767240,\"suggestedTranslation\":\"Từ nay chúng ta sẽ dính lấy nhau không rời luôn.\",\"rating\":8.5},\n  {\"id\":767241,\"suggestedTranslation\":\"Đồ bắt cá hai tay!\",\"rating\":8.5},\n  {\"id\":767242,\"suggestedTranslation\":\"Cô ta là hàng giả mạo đấy!\",\"rating\":8.5},\n  {\"id\":767243,\"suggestedTranslation\":\"Cứ làm như anh chẳng quen biết gì em vậy!\",\"rating\":8.5},\n  {\"id\":767244,\"suggestedTranslation\":\"Vứt cô ta đi mau! Em nổi da gà hết cả người rồi đây này.\",\"rating\":8.5},\n  {\"id\":767245,\"suggestedTranslation\":\"Em đang bị khủng hoảng nhân dạng ở đây nè.\",\"rating\":8.5},\n  {\"id\":767246,\"suggestedTranslation\":\"Ôi, anh đang tự chuốc họa vào thân rồi đấy!\",\"rating\":8.5},\n  {\"id\":767247,\"suggestedTranslation\":\"Làm gì có chuyện tồn tại tận hai Lucy cơ chứ!\",\"rating\":8.5},\n  {\"id\":767249,\"suggestedTranslation\":\"Nhưng em mới là cô vợ Lucy duy nhất và độc tôn của anh cơ mà!\",\"rating\":8.5},\n  {\"id\":767250,\"suggestedTranslation\":\"Chỉ có thể có một mà thôi!\",\"rating\":8.5},\n  {\"id\":767252,\"suggestedTranslation\":\"Anh định thay thế em đấy à?!\",\"rating\":8.5},\n  {\"id\":767253,\"suggestedTranslation\":\"Đó không phải là em!\",\"rating\":8.5},\n  {\"id\":767255,\"suggestedTranslation\":\"Hừm, cứ đợi đấy mà xem!\",\"rating\":8.5},\n  {\"id\":767256,\"suggestedTranslation\":\"Này! Anh không phân biệt nổi hai đứa bọn em à?\",\"rating\":8.5},\n  {\"id\":767257,\"suggestedTranslation\":\"Tôi không quen anh.\",\"rating\":8.5},\n  {\"id\":767258,\"suggestedTranslation\":\"Bỏ cái tay dơ bẩn của anh ra khỏi người tôi mau!\",\"rating\":8.5},\n  {\"id\":767259,\"suggestedTranslation\":\"Thả tôi xuống ngay lập tức!\",\"rating\":8.5},\n  {\"id\":767260,\"suggestedTranslation\":\"Sao anh dám cả gan cầm lấy tôi hả?!\",\"rating\":8.5},\n  {\"id\":767261,\"suggestedTranslation\":\"Eo ôi, tay anh dính mỡ kìa!\",\"rating\":8.5},\n  {\"id\":767262,\"suggestedTranslation\":\"Thả tôi ra mau!\",\"rating\":8.5},\n  {\"id\":767263,\"suggestedTranslation\":\"Cứu với! Tôi đang bị bắt cóc.\",\"rating\":8.5},\n  {\"id\":767265,\"suggestedTranslation\":\"Bỏ tao xuống mau!\",\"rating\":8.5},\n  {\"id\":767266,\"suggestedTranslation\":\"Này! Hàng mới nóng hổi nhé!\",\"rating\":8.5},\n  {\"id\":767267,\"suggestedTranslation\":\"Ghê tởm.\",\"rating\":8.5},\n  {\"id\":767268,\"suggestedTranslation\":\"Lịch sự chút đi chứ!\",\"rating\":8.5},\n  {\"id\":767269,\"suggestedTranslation\":\"Ummmm, XIN LỖI nhé??\",\"rating\":8.5},\n  {\"id\":767270,\"suggestedTranslation\":\"Để tôi yên đi, đồ vũ phu!\",\"rating\":8.5},\n  {\"id\":767271,\"suggestedTranslation\":\"Thả tôi xuống! Hôi quá đi mất!\",\"rating\":8.5},\n  {\"id\":767272,\"suggestedTranslation\":\"Tôi đã đồng ý cho anh cầm tôi chưa hả?\",\"rating\":8.5},\n  {\"id\":767273,\"suggestedTranslation\":\"Ôi không!\",\"rating\":8.5},\n  {\"id\":767275,\"suggestedTranslation\":\"Không! Cố chống lại đi!\",\"rating\":8.5},\n  {\"id\":767276,\"suggestedTranslation\":\"Anh phải kìm lại chứ!\",\"rating\":8.5},\n  {\"id\":767277,\"suggestedTranslation\":\"Lại thế nữa rồi!\",\"rating\":8.5},\n  {\"id\":767279,\"suggestedTranslation\":\"Đừng thế nữa mà!\",\"rating\":8.5},\n  {\"id\":767280,\"suggestedTranslation\":\"Anh không nhất thiết phải làm thế này đâu!\",\"rating\":8.5},\n  {\"id\":767281,\"suggestedTranslation\":\"Em đã cảnh báo anh rồi mà!\",\"rating\":8.5},\n  {\"id\":767282,\"suggestedTranslation\":\"Anh về rồi kìa!\",\"rating\":8.5},\n  {\"id\":767283,\"suggestedTranslation\":\"Trông anh khá hơn nhiều rồi đấy.\",\"rating\":8.5},\n  {\"id\":767284,\"suggestedTranslation\":\"Phù! Hú hồn vía!\",\"rating\":8.5},\n  {\"id\":767285,\"suggestedTranslation\":\"Mừng quá, mọi chuyện qua rồi...\",\"rating\":8.5},\n  {\"id\":767286,\"suggestedTranslation\":\"Đừng có tái diễn chuyện đó nữa nhé.\",\"rating\":8.5},\n  {\"id\":767287,\"suggestedTranslation\":\"Nhớ các bài tập hít thở của anh đấy nhé!\",\"rating\":8.5},\n  {\"id\":767288,\"suggestedTranslation\":\"Mọi thứ rồi sẽ ổn thôi. Cứ tập trung vào!\",\"rating\":8.5},\n  {\"id\":767289,\"suggestedTranslation\":\"Anh ổn chứ?\",\"rating\":8.5},\n  {\"id\":767290,\"suggestedTranslation\":\"Phen vừa rồi hú vía nhỉ?\",\"rating\":8.5},\n  {\"id\":767291,\"suggestedTranslation\":\"Đừng để chuyện đó xảy ra nữa đấy!\",\"rating\":8.5},\n  {\"id\":767292,\"suggestedTranslation\":\"Anh làm em sợ chết khiếp!\",\"rating\":8.5},\n  {\"id\":767293,\"suggestedTranslation\":\"Em nghĩ con nhỏ kỳ cục kia đang giận anh đấy.\",\"rating\":8.5},\n  {\"id\":767294,\"suggestedTranslation\":\"Mừng vì anh vẫn bình an vô sự!\",\"rating\":8.5},\n  {\"id\":767295,\"suggestedTranslation\":\"Phù! Vẫn còn nguyên vẹn chán nhỉ?\",\"rating\":8.5},\n  {\"id\":767296,\"suggestedTranslation\":\"Có anh quay lại thật là tốt, bạn tôi ơi.\",\"rating\":8.5},\n  {\"id\":767297,\"suggestedTranslation\":\" ở trong các hang động\",\"rating\":9.5},\n  {\"id\":767298,\"suggestedTranslation\":\"Đã vẽ bản đồ {location} bởi {author} vào ngày {day}.\",\"rating\":8.5},\n  {\"id\":767301,\"suggestedTranslation\":\"Ồ, tìm ra cổng dịch chuyển của ta rồi đấy à?\",\"rating\":8.5},\n  {\"id\":767302,\"suggestedTranslation\":\"Hmm. Thử thách hơn một chút xem sao nhỉ?\",\"rating\":8.5},\n  {\"id\":767303,\"suggestedTranslation\":\"Cứ ngỡ là ngài đã khôn ra được chút nào rồi chứ.\",\"rating\":8.5},\n  {\"id\":767304,\"suggestedTranslation\":\"Ồ, nhìn kìa, ngươi sống sót được cơ đấy.\",\"rating\