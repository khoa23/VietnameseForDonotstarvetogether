            "text": "[\n  {\"id\": 728242, \"suggestedTranslation\": \"Bạn càng có nhiều bạn bè thì họ càng hời hợt.\", \"rating\": 8.5},\n  {\"id\": 728280, \"suggestedTranslation\": \"Có lẽ nếu tôi muốn khu vườn của mình chết một cách từ từ và đau đớn…\", \"rating\": 9.5},\n  {\"id\": 728304, \"suggestedTranslation\": \"Nguy hiểm đang rình rập. Không có thời gian cho trò chơi.\", \"rating\": 8.5},\n  {\"id\": 728394, \"suggestedTranslation\": \"Nó... không đúng...\", \"rating\": 8.0},\n  {\"id\": 728402, \"suggestedTranslation\": \"Tôi nên từ bỏ, hay tìm một chiếc chìa khóa khác?\", \"rating\": 9.0},\n  {\"id\": 728439, \"suggestedTranslation\": \"Nếu Abigail không thể nghỉ ngơi, tôi cũng sẽ không.\", \"rating\": 9.0},\n  {\"id\": 728459, \"suggestedTranslation\": \"Cà Ruột, ngươi đang định chế nhạo ta à?\", \"rating\": 9.0},\n  {\"id\": 728484, \"suggestedTranslation\": \"Một lần nữa tôi lại không có khả năng tự vệ trước thiên nhiên.\", \"rating\": 8.0},\n  {\"id\": 728507, \"suggestedTranslation\": \"Tôi... ổn mà...\", \"rating\": 8.5},\n  {\"id\": 728546, \"suggestedTranslation\": \"Tôi đã nhìn vào hư vô, và nó vừa sâu thẳm lại tối tăm.\", \"rating\": 8.5},\n  {\"id\": 728568, \"suggestedTranslation\": \"Ta đã hoài phí thời gian, và giờ thời gian đang hoài phí ta.\", \"rating\": 8.5},\n  {\"id\": 728590, \"suggestedTranslation\": \"Tôi thấy... lạ lắm...\", \"rating\": 8.5},\n  {\"id\": 728591, \"suggestedTranslation\": \"Đừng cười em, Abigail! Chẳng vui chút nào đâu!\", \"rating\": 9.0},\n  {\"id\": 728641, \"suggestedTranslation\": \"Không sao cả...\", \"rating\": 9.0},\n  {\"id\": 728712, \"suggestedTranslation\": \"Tôi cảm thấy... ấm áp...\", \"rating\": 9.0},\n  {\"id\": 728727, \"suggestedTranslation\": \"Điểm xuất phát ở xa quá...\", \"rating\": 9.0},\n  {\"id\": 728743, \"suggestedTranslation\": \"Thật là cô đơn khi không có cậu ở đây.\", \"rating\": 9.0},\n  {\"id\": 728894, \"suggestedTranslation\": \"Tôi... thích nó.\", \"rating\": 9.0},\n  {\"id\": 728963, \"suggestedTranslation\": \"Ồ, thật tuyệt khi có thể tìm thấy niềm vui trong một điều giản đơn đến vậy...\", \"rating\": 8.5},\n  {\"id\": 728990, \"suggestedTranslation\": \"Cách này không ngăn được sự phân hủy, mà chỉ kéo dài thêm thôi.\", \"rating\": 8.0},\n  {\"id\": 729089, \"suggestedTranslation\": \"Cái này cứng quá.\", \"rating\": 8.5},\n  {\"id\": 729102, \"suggestedTranslation\": \"Tội nghiệp lũ cá, bị giết dễ dàng quá.\", \"rating\": 8.5},\n  {\"id\": 729147, \"suggestedTranslation\": \"Một con cá lạnh lùng khoác lên mình chiếc áo choàng rong biển.\", \"rating\": 9.0},\n  {\"id\": 729161, \"suggestedTranslation\": \"Ồ. Chắc là... v-vui lắm...\", \"rating\": 8.5},\n  {\"id\": 729185, \"suggestedTranslation\": \"Chúng ta nên làm gì đây, Abigail?\", \"rating\": 9.5},\n  {\"id\": 729196, \"suggestedTranslation\": \"Aww dễ thương quá, nó giống như một vực thẳm thu nhỏ vậy.\", \"rating\": 9.0},\n  {\"id\": 729210, \"suggestedTranslation\": \"Mình rất giỏi ghi nhớ... phải không, Abigail?\", \"rating\": 9.0},\n  {\"id\": 729230, \"suggestedTranslation\": \"Trông khá đẹp đấy chứ, phải không?\", \"rating\": 9.0},\n  {\"id\": 729239, \"suggestedTranslation\": \"Tôi tìm thấy sự an ủi kỳ lạ trong tiếng lá chết xào xạc.\", \"rating\": 9.0},\n  {\"id\": 729240, \"suggestedTranslation\": \"Có lẽ tôi nên nhập bọn với lũ quạ và bay thật xa, thật xa...\", \"rating\": 9.0},\n  {\"id\": 729255, \"suggestedTranslation\": \"Vậy là hết vẽ bản đồ nhé.\", \"rating\": 8.5},\n  {\"id\": 729270, \"suggestedTranslation\": \"Tôi còn đang bận phát điên nên chẳng rảnh để xuống cái hang đó đâu.\", \"rating\": 8.5},\n  {\"id\": 729302, \"suggestedTranslation\": \"Cuộc đời mới của nó hóa ra lại ngắn ngủi làm sao.\", \"rating\": 8.0},\n  {\"id\": 729352, \"suggestedTranslation\": \"Nó sẽ càng làm sự trống rỗng trong lồng ngực tôi lớn hơn...\", \"rating\": 9.5},\n  {\"id\": 729389, \"suggestedTranslation\": \"Lấp đầy dạ dày để làm gì khi trái tim vẫn trống rỗng...\", \"rating\": 9.0},\n  {\"id\": 729409, \"suggestedTranslation\": \"Chúng ta chơi trò hóa trang nhé, Abigail?\", \"rating\": 9.0},\n  {\"id\": 729410, \"suggestedTranslation\": \"Chúng ta chơi trò hóa trang nhé, Abigail?\", \"rating\": 9.0},\n  {\"id\": 729411, \"suggestedTranslation\": \"Chúng ta chơi trò hóa trang nhé, Abigail?\", \"rating\": 9.0},\n  {\"id\": 729412, \"suggestedTranslation\": \"Chúng ta chơi trò hóa trang nhé, Abigail?\", \"rating\": 9.0},\n  {\"id\": 729413, \"suggestedTranslation\": \"Chúng ta chơi trò hóa trang nhé, Abigail?\", \"rating\": 9.0},\n  {\"id\": 729415, \"suggestedTranslation\": \"Chúng ta chơi trò hóa trang nhé, Abigail?\", \"rating\": 9.0},\n  {\"id\": 729416, \"suggestedTranslation\": \"Chúng ta chơi trò hóa trang nhé, Abigail?\", \"rating\": 9.0},\n  {\"id\": 729457, \"suggestedTranslation\": \"Nó quá mạnh, còn tôi thì quá yếu.\", \"rating\": 9.0},\n  {\"id\": 729471, \"suggestedTranslation\": \"Rồi nó cũng sẽ chết mà thôi.\", \"rating\": 9.0},\n  {\"id\": 729533, \"suggestedTranslation\": \"Đập nghe đã tai mà lại còn bổ dưỡng nữa!\", \"rating\": 9.0},\n  {\"id\": 729547, \"suggestedTranslation\": \"Nó sưởi ấm thể xác, chứ nào sưởi ấm được trái tim.\", \"rating\": 9.0},\n  {\"id\": 729611, \"suggestedTranslation\": \"Một chiếc lông chim tuyết, trắng ngần như ánh sáng cuối đường hầm.\", \"rating\": 9.5},\n  {\"id\": 729654, \"suggestedTranslation\": \"Nó sẽ... cầm cự... giúp tôi lúc này.\", \"rating\": 8.5},\n  {\"id\": 729736, \"suggestedTranslation\": \"Giờ thì không còn nguy hiểm thế nữa...\", \"rating\": 9.0},\n  {\"id\": 729776, \"suggestedTranslation\": \"Cậu cũng vừa đánh mất một thứ rất quý giá phải không?\", \"rating\": 9.0},\n  {\"id\": 729848, \"suggestedTranslation\": \"Cái này cứng quá.\", \"rating\": 8.5},\n  {\"id\": 729861, \"suggestedTranslation\": \"Chúng... thật đẹp.\", \"rating\": 8.5},\n  {\"id\": 729863, \"suggestedTranslation\": \"Nó sưởi ấm mọi thứ, ngoại trừ linh hồn tôi.\", \"rating\": 9.5},\n  {\"id\": 729941, \"suggestedTranslation\": \"Làm ơn cho tôi loại thuốc độc nào đỡ hôi hơn chút đi.\", \"rating\": 9.0},\n  {\"id\": 730227, \"suggestedTranslation\": \"Chúng ta phải cắm nó xuống nền đất lạnh lẽo, cứng nhắc này...\", \"rating\": 9.0},\n  {\"id\": 730308, \"suggestedTranslation\": \"Trông khá kỳ quặc đấy chứ?\", \"rating\": 9.0},\n  {\"id\": 730388, \"suggestedTranslation\": \"Quỷ dị nhưng lại đẹp đẽ.\", \"rating\": 9.0},\n  {\"id\": 730389, \"suggestedTranslation\": \"Thứ này xuất hiện cùng với những giấc mơ chập chờn.\", \"rating\": 8.5},\n  {\"id\": 730469, \"suggestedTranslation\": \"Vậy là, ngay cả lũ người cá cũng có giới hạn của chúng.\", \"rating\": 9.0},\n  {\"id\": 730480, \"suggestedTranslation\": \"Nó nhìn thấu vạn vật, nhưng lại chẳng thấy gì.\", \"rating\": 9.5},\n  {\"id\": 730491, \"suggestedTranslation\": \"Nó... ngon lắm.\", \"rating\": 9.0},\n  {\"id\": 730520, \"suggestedTranslation\": \"Vị... ngon phết.\", \"rating\": 9.0},\n  {\"id\": 730616, \"suggestedTranslation\": \"Nó có mắt, nhưng chẳng bao giờ khóc.\", \"rating\": 9.0},\n  {\"id\": 730630, \"suggestedTranslation\": \"Cuộc đời này bất công thật đấy, phải không?\", \"rating\": 9.0},\n  {\"id\": 730680, \"suggestedTranslation\": \"Xin chào thưa cô. Muốn giao dịch không?\", \"rating\": 9.0},\n  {\"id\": 730719, \"suggestedTranslation\": \"Nó có mắt, nhưng chẳng bao giờ khóc.\", \"rating\": 9.0},\n  {\"id\": 730814, \"suggestedTranslation\": \"Giờ thì Wolfgang sẽ không bị \\\"lạc\\\" mỗi khi tôi rủ anh ấy chơi cùng nữa.\", \"rating\": 9.0},\n  {\"id\": 730835, \"suggestedTranslation\": \"Sự thay đổi... không phải lúc nào cũng tồi tệ.\", \"rating\": 9.0},\n  {\"id\": 730846, \"suggestedTranslation\": \"Ồ, được bao bọc bên trong một lớp vỏ cứng cáp và vô cảm...\", \"rating\": 9.0},\n  {\"id\": 730858, \"suggestedTranslation\": \"Nó mọc trên cây, nhưng trông giống một hòn đá tảng.\", \"rating\": 9.5},\n  {\"id\": 730968, \"suggestedTranslation\": \"Chắc tôi có thể tự tay ráp nó lại nếu cố thử.\", \"rating\": 9.0},\n  {\"id\": 730973, \"suggestedTranslation\": \"Tôi nên chế tạo gì đây, Abigail?\", \"rating\": 9.0},\n  {\"id\": 730990, \"suggestedTranslation\": \"Chúng chẳng làm tôi thấy dễ chịu chút nào, nhưng lại có ích cho Abigail.\", \"rating\": 9.0},\n  {\"id\": 731003, \"suggestedTranslation\": \"Nỗi buồn chẳng chiếm chút không gian nào, nhưng lại nặng trĩu hơn tất cả.\", \"rating\": 9.0},\n  {\"id\": 731047, \"suggestedTranslation\": \"Thịt, được làm khô và trở nên thơm ngon.\", \"rating\": 9.5},\n  {\"id\": 731097, \"suggestedTranslation\": \"Chân nó mảnh mai và yếu ớt làm sao, như thể chỉ khẽ đá một cái là gãy ngay...\", \"rating\": 9.0},\n  {\"id\": 731099, \"suggestedTranslation\": \"Vĩnh biệt nhé, bạn hiền.\", \"rating\": 9.0},\n  {\"id\": 731101, \"suggestedTranslation\": \"Đời nó ngắn ngủi, nhưng tươi đẹp.\", \"rating\": 9.0},\n  {\"id\": 731103, \"suggestedTranslation\": \"Và thế là sinh vật nhỏ bé ấy bỗng biến mất.\", \"rating\": 8.0},\n  {\"id\": 731104, \"suggestedTranslation\": \"Nó chẳng có khái niệm gì về thời gian hay sự mất mát.\", \"rating\": 9.0},\n  {\"id\": 731158, \"suggestedTranslation\": \"Đáng sợ, nhưng cũng thật dễ chịu.\", \"rating\": 9.0},\n  {\"id\": 731171, \"suggestedTranslation\": \"Những phương pháp mới để bắt cá rời xa cuộc sống yên bình của chúng.\", \"rating\": 9.5},\n  {\"id\": 731178, \"suggestedTranslation\": \"Một sinh vật bé nhỏ, mong manh, đang giãy giụa tìm ánh sáng.\", \"rating\": 9.0},\n  {\"id\": 731226, \"suggestedTranslation\": \"Gần ngay trước mắt, mà lại cách xa tận chân trời.\", \"rating\": 9.0},\n  {\"id\": 731259, \"suggestedTranslation\": \"Nóng quá... không chịu nổi...\", \"rating\": 9.0},\n  {\"id\": 731260, \"suggestedTranslation\": \"Ở đây có sự ấm áp, nhưng cũng kèm theo nỗi đau.\", \"rating\": 9.0},\n  {\"id\": 731325, \"suggestedTranslation\": \"Nếu con cá của tôi nặng bằng trái tim tôi, chắc chắn tôi sẽ thắng.\", \"rating\": 9.5},\n  {\"id\": 731441, \"suggestedTranslation\": \"Chẳng có gì cay đắng hơn cuộc đời tôi cả.\", \"rating\": 8.5},\n  {\"id\": 731442, \"suggestedTranslation\": \"Hóa trang cho bò lai trông... khá vui đấy...\", \"rating\": 9.5},\n  {\"id\": 731707, \"suggestedTranslation\": \"Ồ, vui ghê.\", \"rating\": 8.5},\n  {\"id\": 731872, \"suggestedTranslation\": \"Tôi tự hỏi nên đặt nó ở xó nào để yên nghỉ đây?\", \"rating\": 9.0},\n  {\"id\": 731890, \"suggestedTranslation\": \"Chạy, chạy mãi, để rồi chẳng đi đến đâu.\", \"rating\": 9.0},\n  {\"id\": 731917, \"suggestedTranslation\": \"Tôi có chèo mỏi cả tay, thì cảm giác vẫn cứ như đang giậm chân tại chỗ.\", \"rating\": 9.0},\n  {\"id\": 731936, \"suggestedTranslation\": \"Đấu trường hiện tại vẫn im lìm và trống vắng.\", \"rating\": 8.5},\n  {\"id\": 731958, \"suggestedTranslation\": \"Ít ra thì cái thực vật này có vẻ đang phát triển tốt.\", \"rating\": 9.5},\n  {\"id\": 732034, \"suggestedTranslation\": \"Nó cao quá mức để có thể chồng thêm cái nữa rồi.\", \"rating\": 9.0},\n  {\"id\": 732070, \"suggestedTranslation\": \"Chúng ta hãy xử lý hết món trên đĩa trước đã nhé?\", \"rating\": 9.5},\n  {\"id\": 732088, \"suggestedTranslation\": \"Xong rồi cưng ơi.\", \"rating\": 9.0},\n  {\"id\": 732125, \"suggestedTranslation\": \"May mắn là không có đám cháy nào cần dập tắt cả.\", \"rating\": 9.0},\n  {\"id\": 732145, \"suggestedTranslation\": \"Nhớ phân loại theo màu sắc và trọng lượng nhé em.\", \"rating\": 8.5},\n  {\"id\": 732168, \"suggestedTranslation\": \"Tối thế này thì đọc sao nổi.\", \"rating\": 8.5},\n  {\"id\": 732228, \"suggestedTranslation\": \"Cố gắng trông năng nổ hơn một chút nào em yêu.\", \"rating\": 9.0},\n  {\"id\": 732320, \"suggestedTranslation\": \"Theo tôi thì nó cần thêm chút phân bón đấy.\", \"rating\": 9.0},\n  {\"id\": 732324, \"suggestedTranslation\": \"À, em ở đây rồi.\", \"rating\": 9.0},\n  {\"id\": 732385, \"suggestedTranslation\": \"Thử lại lần nữa nào?\", \"rating\": 9.0},\n  {\"id\": 732403, \"suggestedTranslation\": \"Ôi trời! Lần sau tôi xin phép được đề xuất đặt điểm dịch chuyển gần mặt đất hơn nhé em yêu?\", \"rating\": 9.0},\n  {\"id\": 732432, \"suggestedTranslation\": \"Anh không giữ em lâu được đâu, cưng à.\", \"rating\": 9.0},\n  {\"id\": 732538, \"suggestedTranslation\": \"Nếu phỏng đoán của tôi chính xác, đây sẽ là hình thái cuối cùng của nó.\", \"rating\": 9.0},\n  {\"id\": 732548, \"suggestedTranslation\": \"Dễ tiêu hóa hơn một chút, nhưng chẳng có tác dụng cải thiện thị lực nào cả.\", \"rating\": 9.0},\n  {\"id\": 732624, \"suggestedTranslation\": \"Hơi nặng mùi, nhưng khá bổ dưỡng.\", \"rating\": 9.0},\n  {\"id\": 732661, \"suggestedTranslation\": \"Người xưa từng tin rằng loài ngỗng sinh ra từ hà biển. Bạn tưởng tượng nổi không?\", \"rating\": 9.5},\n  {\"id\": 732714, \"suggestedTranslation\": \"Biết đâu vẫn còn cách để hồi sinh nó...\", \"rating\": 9.0},\n  {\"id\": 732730, \"suggestedTranslation\": \"Hãy tút tát lại cho bạn trông tươm tất hơn một chút nào.\", \"rating\": 9.0},\n  {\"id\": 732769, \"suggestedTranslation\": \"Theo truyền thống, bánh gạo nướng được nướng trong lò nướng đất sét chuyên dụng.\", \"rating\": 9.5},\n  {\"id\": 732836, \"suggestedTranslation\": \"Một loại vũ khí cực kỳ hiệu quả trong hải chiến, miễn là được nạp đạn đầy đủ.\", \"rating\": 9.0},\n  {\"id\": 732845, \"suggestedTranslation\": \"Nó sẽ hút các nam châm điện cỡ lớn, nhưng chỉ khi được kích hoạt.\", \"rating\": 9.0},\n  {\"id\": 732857, \"suggestedTranslation\": \"Không giống cách mẹ từng nấu cho lắm, nhưng thơm tuyệt cú mèo!\", \"rating\": 9.0},\n  {\"id\": 732919, \"suggestedTranslation\": \"Ôi trời ơi.\", \"rating\": 9.0},\n  {\"id\": 732924, \"suggestedTranslation\": \"Tạm thời thì đang rảnh rỗi, thật may mắn.\", \"rating\": 8.5},\n  {\"id\": 732940, \"suggestedTranslation\": \"Hơi khó uống lúc đầu, nhưng bù lại rất giải khát.\", \"rating\": 9.0},\n  {\"id\": 733015, \"suggestedTranslation\": \"Daucus carota là một loại rau củ.\", \"rating\": 9.0},\n  {\"id\": 733115, \"suggestedTranslation\": \"Nói thật thì nó làm tăng sức chứa của rương lên một mức vô lý.\", \"rating\": 9.0},\n  {\"id\": 733199, \"suggestedTranslation\": \"Tôi tự hỏi hệ thống thần kinh của cậu còn hoạt động, hay chỉ để trang trí cho đẹp...\", \"rating\": 9.0},\n  {\"id\": 733231, \"suggestedTranslation\": \"À, giá mà có thêm một chiếc khăn lót nhỉ?\", \"rating\": 9.0},\n  {\"id\": 733250, \"suggestedTranslation\": \"Trông giống như một chiếc chìa khóa, nhưng khá giòn.\", \"rating\": 9.5},\n  {\"id\": 733369, \"suggestedTranslation\": \"Không hẳn là hàng thật, nhưng chắc cũng lừa được vài con chim.\", \"rating\": 9.0},\n  {\"id\": 733389, \"suggestedTranslation\": \"Một sự kết hợp bất ngờ, nhưng không hề tệ chút nào.\", \"rating\": 9.0},\n  {\"id\": 733415, \"suggestedTranslation\": \"Mặn mòi, nhưng rất đỗi thỏa lòng.\", \"rating\": 9.0},\n  {\"id\": 733418, \"suggestedTranslation\": \"Mặn mòi, nhưng rất đỗi thỏa lòng.\", \"rating\": 9.0},\n  {\"id\": 733524, \"suggestedTranslation\": \"Gói quà là một công việc thư thái nhỉ?\", \"rating\": 9.0},\n  {\"id\": 733533, \"suggestedTranslation\": \"Nó đã ngả sang màu xám, nhưng vẫn còn nhỏ giọt.\", \"rating\": 9.0},\n  {\"id\": 733587, \"suggestedTranslation\": \"Hmm, ít ra cũng có một món lành mạnh trên bàn.\", \"rating\": 9.0},\n  {\"id\": 733625, \"suggestedTranslation\": \"Trời ạ, cô ta hơi xấc xược thì phải?\", \"rating\": 9.0},\n  {\"id\": 733751, \"suggestedTranslation\": \"Giàu protein và chất xơ.\", \"rating\": 9.0},\n  {\"id\": 733769, \"suggestedTranslation\": \"Quả là một thánh tích ma thuật đáng ghen tị.\", \"rating\": 9.5},\n  {\"id\": 733786, \"suggestedTranslation\": \"Một cơ hội để thuần hóa đấy.\", \"rating\": 9.0},\n  {\"id\": 733810, \"suggestedTranslation\": \"Nếu thuyết phục được nó đứng yên, đây sẽ là chiếc đèn đọc sách tuyệt vời.\", \"rating\": 9.0},\n  {\"id\": 733842, \"suggestedTranslation\": \"Giờ thì tôi đã quen với chất liệu này rồi, sửa nó dễ như trở bàn tay.\", \"rating\": 9.0},\n  {\"id\": 733900, \"suggestedTranslation\": \"Chỉ cần giương 