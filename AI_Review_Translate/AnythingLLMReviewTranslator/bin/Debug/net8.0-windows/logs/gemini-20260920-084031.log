            "text": "[\n  {\n    \"id\": 767305,\n    \"suggestedTranslation\": \"Xong một, còn bốn!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 767306,\n    \"suggestedTranslation\": \"Gì chứ? Ngươi vẫn còn ở đây à?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 767307,\n    \"suggestedTranslation\": \"Ấn tượng đấy. Nhưng tốt nhất ngươi nên dừng lại khi còn có thể.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767308,\n    \"suggestedTranslation\": \"Này, bạn trẻ.\",\n    \"rating\": 8.0\n  },\n  {\n    \"id\": 767309,\n    \"suggestedTranslation\": \"Quay đầu đi, kẻo ta lại phải dùng đến biện pháp mạnh đấy.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 767310,\n    \"suggestedTranslation\": \"Ngươi đang thử thách vận may của mình quá đà rồi đấy.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 767311,\n    \"suggestedTranslation\": \"Đồ con kiến hỗn xược, đáng thương và nhỏ bé!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 767312,\n    \"suggestedTranslation\": \"Ngươi sẽ phải hối hận nếu bước tiếp đấy...\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 767313,\n    \"suggestedTranslation\": \"Đừng có chọc giận Maxwell Vĩ Đại!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767314,\n    \"suggestedTranslation\": \"Thế thì còn gì là thú vị nữa?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 767315,\n    \"suggestedTranslation\": \"Ngươi nghĩ ai cho phép ngươi làm thế hả?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 767316,\n    \"suggestedTranslation\": \"Ngươi mong đợi điều này sao?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 767317,\n    \"suggestedTranslation\": \"Chỉ có cát bụi. Cả hư vô. Và Bọn Họ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767318,\n    \"suggestedTranslation\": \"Ta đã học hỏi được rất nhiều kể từ đó. Ta đã gây dựng nên biết bao thứ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767319,\n    \"suggestedTranslation\": \"Nhưng ngay cả một quân Vương cũng phải tuân theo quy tắc bàn cờ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767320,\n    \"suggestedTranslation\": \"Ngươi không thể thay đổi luật chơi được đâu.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767321,\n    \"suggestedTranslation\": \"Ta cũng chẳng rõ chúng muốn gì. Chúng... chúng chỉ đứng nhìn thôi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767322,\n    \"suggestedTranslation\": \"Trừ khi ngươi đến quá gần. Khi đó...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767323,\n    \"suggestedTranslation\": \"À thì, có lý do cả mà sao ta lúc nào cũng bảnh chọe thế này.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 767324,\n    \"suggestedTranslation\": \"Ngoài kia đang là năm nào rồi? Thời gian ở đây trôi theo cách khác.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767325,\n    \"suggestedTranslation\": \"Thôi nào, ở lại đây một lúc đi. Bầu bạn với chúng ta chút.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767326,\n    \"suggestedTranslation\": \"Hoặc cắm chìa khóa vào hộp. Quyết định là ở ngươi.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 767327,\n    \"suggestedTranslation\": \"Thứ lỗi nếu ta không đứng dậy nổi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767328,\n    \"suggestedTranslation\": \"Dù thế nào đi nữa, ngươi cũng chỉ đang kéo dài cái kết tất yếu mà thôi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767329,\n    \"suggestedTranslation\": \"Thực tế đôi khi là vậy đấy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767330,\n    \"suggestedTranslation\": \"Ta nghĩ mình nói thế là đủ rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767332,\n    \"suggestedTranslation\": \"Ngươi đã là một món đồ chơi thú vị, nhưng ta chán cái trò này lắm rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767333,\n    \"suggestedTranslation\": \"Hoặc có lẽ Bọn Họ đã chán ta rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767334,\n    \"suggestedTranslation\": \"Hừ. Phải mất khối thời gian đấy.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 767335,\n    \"suggestedTranslation\": \"Chúng sẽ cho ngươi thấy những thứ vừa kinh hoàng, lại vừa mỹ lệ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767336,\n    \"suggestedTranslation\": \"Nó sẽ cải biến ngươi, y như đã làm với ta.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767337,\n    \"suggestedTranslation\": \"Tốt nhất là đừng có chống cự.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767338,\n    \"suggestedTranslation\": \"Chẳng có mấy thứ ở đây khi ta đặt chân đến.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767339,\n    \"suggestedTranslation\": \"Nào, đến đây là hết.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 767340,\n    \"suggestedTranslation\": \"Ngươi nghĩ là ta chưa thử cách đó sao?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767341,\n    \"suggestedTranslation\": \"Đường cùng rồi. Chúng ta chẳng thể trốn thoát đâu.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767342,\n    \"suggestedTranslation\": \"Ngươi đã tìm thấy ta. Giờ thì tính làm gì tiếp đây?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767343,\n    \"suggestedTranslation\": \"Tất cả những gì tao muốn đổi lấy chỉ là một lệnh hưu chiến.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 767344,\n    \"suggestedTranslation\": \"Sao nào, bạn cũ.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 767345,\n    \"suggestedTranslation\": \"Tao sẽ cho mày thức ăn, vàng, heo, bất cứ thứ gì mày cần.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767346,\n    \"suggestedTranslation\": \"Hãy giao kèo thế này đi. Ngươi có thể ở lại đây. Thậm chí là định cư luôn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767347,\n    \"suggestedTranslation\": \"Ngai vàng sẽ không cho phép điều đó đâu. Tôi đã thử rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767348,\n    \"suggestedTranslation\": \"Mọi chuyện sẽ kết thúc thế này sao?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767349,\n    \"suggestedTranslation\": \"Hừ, ta đúng là một tên ngốc. Đã dám nuôi hy vọng cơ chứ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767350,\n    \"suggestedTranslation\": \"Cảm ơn cậu. Tôi đã phải nghe bản nhạc đó suốt cả một cõi vĩnh hằng.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767351,\n    \"suggestedTranslation\": \"Chắc tôi đáng bị vậy rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767352,\n    \"suggestedTranslation\": \"Được thôi. Chỉ là hãy nhớ rằng chính bạn đã chọn điều này.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767353,\n    \"suggestedTranslation\": \"Chỉ là...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767354,\n    \"suggestedTranslation\": \"Tôi đã quen với việc giành chiến thắng rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767355,\n    \"suggestedTranslation\": \"Chúng ta không khác nhau là mấy đâu, cậu và tôi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767356,\n    \"suggestedTranslation\": \"Ồ, mày tưởng mình là kẻ đầu tiên đấy à?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767357,\n    \"suggestedTranslation\": \"HA!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767358,\n    \"suggestedTranslation\": \"Đó là lý do tại sao tôi đưa bạn đến đây.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767359,\n    \"suggestedTranslation\": \"Đó là lý do tại sao tôi đưa tất cả bọn họ đến đây.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767360,\n    \"suggestedTranslation\": \"Này bạn hiền, trông bạn có vẻ không ổn lắm đâu.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767361,\n    \"suggestedTranslation\": \"Tốt hơn hết là nên kiếm cái gì đó ăn trước khi trời tối đi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767362,\n    \"suggestedTranslation\": \"Đầu óc ta giờ chẳng còn minh mẫn như trước nữa.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767363,\n    \"suggestedTranslation\": \"Mumsy là ai nhỉ? À, đúng rồi. Quý cô tốt bụng.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767364,\n    \"suggestedTranslation\": \"Dạo này tự nhiên thấy thèm ăn cá ghê. Hừm.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767365,\n    \"suggestedTranslation\": \"Pip lúc nào cũng căng thẳng. Cứ hay lo lắng cho ta mãi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767366,\n    \"suggestedTranslation\": \"Này, trao đổi với lão Sammy đi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767367,\n    \"suggestedTranslation\": \"HẠT GIỐNG ĐÂY! BÁN HẠT GIỐNG NÀO!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767368,\n    \"suggestedTranslation\": \"Mình đang làm gì thế nhỉ? ...Ờ thì, HẠT GIỐNG ĐÂY!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767369,\n    \"suggestedTranslation\": \"Được rồi, được rồi, nhanh chân lên nào.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767370,\n    \"suggestedTranslation\": \"Vinh hạnh cho tôi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767371,\n    \"suggestedTranslation\": \"Lúc nào cũng vội vã, cái đám các người.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767372,\n    \"suggestedTranslation\": \"Cơn dịch bệnh này cũng không tệ lắm đâu, biết thế không.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767373,\n    \"suggestedTranslation\": \"Nhớ quay lại đấy nhé, nghe chưa?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767374,\n    \"suggestedTranslation\": \"Ngươi là ai ấy nhỉ?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767375,\n    \"suggestedTranslation\": \"Cảm ơn nhé, người lạ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767376,\n    \"suggestedTranslation\": \"Chào buổi chiều! Có muốn giao dịch không?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767377,\n    \"suggestedTranslation\": \"Ít ra thì căn bệnh quái ác đó vẫn chừa bộ ria mép của tôi ra. Ho ho!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767378,\n    \"suggestedTranslation\": \"Trí tuệ của Sammy đang kém dần rồi, nhưng đừng có đi loan truyền điều đó nhé.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767379,\n    \"suggestedTranslation\": \"Nhiều người bệnh của chúng ta đã biến mất xuống đáy biển. Thật kỳ lạ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767380,\n    \"suggestedTranslation\": \"Tiếc là cậu không được thấy thị trấn này trong những ngày tháng huy hoàng của nó.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767381,\n    \"suggestedTranslation\": \"Tôi chỉ có những mặt hàng thượng hạng để bán thôi đấy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767382,\n    \"suggestedTranslation\": \"Đây là một nơi tồi tệ để một đứa trẻ lớn lên.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767383,\n    \"suggestedTranslation\": \"Đang vội à?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767384,\n    \"suggestedTranslation\": \"Đừng nấn ná nữa, bạn tôi ơi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767385,\n    \"suggestedTranslation\": \"Tôi sẽ không làm mất thêm thời gian của bạn nữa.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767386,\n    \"suggestedTranslation\": \"Tôi xin ngả mũ thán phục bạn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767387,\n    \"suggestedTranslation\": \"Thật là vinh hạnh.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767388,\n    \"suggestedTranslation\": \"Mong Thần Gặm mỉm cười với bạn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 767389,\n    \"suggestedTranslation\": \"Flargle\",\n    \"rating\": 8.0\n  },\n  {\n    \"id\": 767396,\n    \"suggestedTranslation\": \"Glurt\",\n    \"rating\": 8.0\n  },\n  {\n    \"id\": 767397,\n    \"suggestedTranslation\": \"Glurble\",\n    \"rating\": 8.0\n  },\n  {\n    \"id\": 767399,\n    \"suggestedTranslation\": \"Gop\",\n    \"rating\": 8.0\n  },\n  {\n    \"id\": 767400,\n    \"suggestedTranslation\": \"Flop\",\n    \"rating\": 8.0\n  },\n  {\n    \"id\": 767422,\n    \"suggestedTranslation\": \"Flupt\",\n    \"rating\": 8.0\n  },\n  {\n    \"id\": 767427,\n    \"suggestedTranslation\": \"Glorp! Biến đi!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 767428,\n    \"suggestedTranslation\": \"Glorp! Glorpy glup!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 767429,\n    \"suggestedTranslation\": \"Tiêu diệt ngươi!\",\n    \"rating\": 9.0\n  },\n  {\n    