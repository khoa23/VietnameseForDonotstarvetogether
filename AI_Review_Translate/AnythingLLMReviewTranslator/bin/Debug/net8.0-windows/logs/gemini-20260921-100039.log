            "text": "[\n  {\n    \"id\": 781906,\n    \"suggestedTranslation\": \"\\\"Applause röars as red, red röses flööd my stage!\\\"\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 781907,\n    \"suggestedTranslation\": \"\\\"I shall scare öff all the black winged beasties!\\\"\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 781908,\n    \"suggestedTranslation\": \"\\\"I will deströy my enemies!\\\"\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 781909,\n    \"suggestedTranslation\": \"\\\"I will deströy my enemies!\\\"\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 781910,\n    \"suggestedTranslation\": \"\\\"Yöu have tö try harder than this tö defeat me!\\\"\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 781911,\n    \"suggestedTranslation\": \"\\\"Yöu have tö try harder than this tö defeat me!\\\"\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 781912,\n    \"suggestedTranslation\": \"\\\"Sân khấu đã sẵn sàng cho sự vươn lên đỉnh cao vinh quang của tôi!\\\"\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 781913,\n    \"suggestedTranslation\": \"\\\"Wörds, wörds, wörds.\\\"\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 781914,\n    \"suggestedTranslation\": \"\\\"Không con thú nào có thể chống lại ý chí của một kẻ có trái tim cuồng nhiệt.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781915,\n    \"suggestedTranslation\": \"\\\"Ta là kẻ xuất sắc nhất từ trước đến nay!!\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781916,\n    \"suggestedTranslation\": \"\\\"Gööd tidings to all!\\\"\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 781917,\n    \"suggestedTranslation\": \"\\\"Ta đã từng đối mặt với những thử thách tồi tệ hơn thế.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781918,\n    \"suggestedTranslation\": \"\\\"Mọi thứ ta làm ra đều hoàn mỹ.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781919,\n    \"suggestedTranslation\": \"\\\"Ta chỉ cần tìm lại cô trợ lý xinh đẹp của mình thôi.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781920,\n    \"suggestedTranslation\": \"\\\"Ta chỉ cần tìm lại cô trợ lý xinh đẹp của mình thôi.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781921,\n    \"suggestedTranslation\": \"\\\"Tất cả những kẻ chống lại ta đều phải diệt vong!\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781922,\n    \"suggestedTranslation\": \"\\\"Hừm... mff! Mmmf!\\\"\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 781923,\n    \"suggestedTranslation\": \"\\\"Không có gì đâu bạn trẻ, ngành công nghiệp băng đá này vốn là một thương trường lạnh lẽo.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781924,\n    \"suggestedTranslation\": \"\\\"Hư hỏng. Quả là hư hỏng.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781925,\n    \"suggestedTranslation\": \"\\\"Hư hỏng. Quả là hư hỏng.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781926,\n    \"suggestedTranslation\": \"\\\"Hư hỏng. Quả là hư hỏng.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781927,\n    \"suggestedTranslation\": \"\\\"Có lẽ ta đã sai khi quá vội vàng phớt lờ sức mạnh của mặt trăng...\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781928,\n    \"suggestedTranslation\": \"\\\"Sức mạnh của núi lửa thật khiến người ta say đắm.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781929,\n    \"suggestedTranslation\": \"\\\"Ngươi mong ta phải giao du sao? Ta được đảm bảo là sẽ có một chỗ ngồi hạng sang riêng tư cơ mà!\\\"\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 781930,\n    \"suggestedTranslation\": \"\\\"Ẩn chứa phép màu trong những tán cây kia.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781931,\n    \"suggestedTranslation\": \"\\\"Biển cả không bao giờ thương xót kẻ ngốc - và ta cũng vậy.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781932,\n    \"suggestedTranslation\": \"\\\"Hoa hồng có gai thì sao lại không đâm người được chứ. Đó là bản chất của nó mà.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781933,\n    \"suggestedTranslation\": \"\\\"Hoa hồng có gai thì sao lại không đâm người được chứ. Đó là bản chất của nó mà.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781934,\n    \"suggestedTranslation\": \"\\\"Hoặc là dâng lễ vật, hoặc là kẻ thành lễ vật.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781935,\n    \"suggestedTranslation\": \"\\\"Này bạn ơi, trông tôi có vẻ không ổn lắm.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781936,\n    \"suggestedTranslation\": \"\\\"Này bạn ơi, trông tôi có vẻ không ổn lắm.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781937,\n    \"suggestedTranslation\": \"\\\"Kẻ ngốc nghếch tội nghiệp ấy chẳng hề hay biết điều gì sắp xảy ra đâu.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781938,\n    \"suggestedTranslation\": \"\\\"Kẻ ngốc nghếch tội nghiệp ấy chẳng hề hay biết điều gì sắp xảy ra đâu.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781939,\n    \"suggestedTranslation\": \"\\\"Ta chưa bao giờ là kẻ ngại mấy trò kịch nghệ, hay một bộ vest chỉnh tề cả.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781940,\n    \"suggestedTranslation\": \"\\\"Hừ.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781941,\n    \"suggestedTranslation\": \"\\\"Ở đây sống nhanh lên... hoặc là chết.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781942,\n    \"suggestedTranslation\": \"\\\"Rất ít kẻ dám dấn thân khám phá những bí ẩn của hắc ma thuật.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781943,\n    \"suggestedTranslation\": \"\\\"Hừ. Ngoài trời lạnh thật.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781944,\n    \"suggestedTranslation\": \"\\\"Raaar! ...Đó là tiếng dơi kêu của chúng tôi đấy.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781945,\n    \"suggestedTranslation\": \"\\\"Raaar! ...Đó là tiếng dơi kêu của chúng tôi đấy.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781946,\n    \"suggestedTranslation\": \"\\\"Raaar! ...Đó là tiếng dơi kêu của chúng tôi đấy.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781947,\n    \"suggestedTranslation\": \"\\\"Hồi đó chúng tôi cô đơn lắm...\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781948,\n    \"suggestedTranslation\": \"\\\"Chúng tôi không muốn chiến đấu nếu không bắt buộc.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781949,\n    \"suggestedTranslation\": \"\\\"Cùng nấu ăn nào!\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781950,\n    \"suggestedTranslation\": \"\\\"Chúng tôi thích tiệc tùng lắm!\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781951,\n    \"suggestedTranslation\": \"\\\"Chúng tôi thích tiệc tùng lắm!\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781952,\n    \"suggestedTranslation\": \"\\\"Đấu với chúng tôi là ngươi thua chắc.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781953,\n    \"suggestedTranslation\": \"\\\"Hừm... mff! Mmmf!\\\"\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 781954,\n    \"suggestedTranslation\": \"\\\"Chúng tôi thích chơi đùa trong tuyết lắm!\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781955,\n    \"suggestedTranslation\": \"\\\"Mặt trăng đã khiến chúng tôi... khác biệt.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781956,\n    \"suggestedTranslation\": \"\\\"Chúng tôi cứ như một ngọn núi lửa di động vậy.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781957,\n    \"suggestedTranslation\": \"\\\"Chúng tôi sẽ ngoan ngoãn hết sức có thể... chắc vậy.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781958,\n    \"suggestedTranslation\": \"\\\"Chỉ có những con nhện mạnh nhất mới sống sót nổi ở chốn này!\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781959,\n    \"suggestedTranslation\": \"\\\"Thật may là chúng tôi biết cách nhả tơ, chứ móng vuốt cứ vướng vào cánh buồm mãi...\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781960,\n    \"suggestedTranslation\": \"\\\"Đừng có dây với chúng tôi.\\\"\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 781961,\n    \"suggestedTranslation\": \"\\\"Bông hồng 