            "text": "[\n  {\n    \"id\": 788331,\n    \"suggestedTranslation\": \"Đã làm ẩm\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788332,\n    \"suggestedTranslation\": \"Héo\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788333,\n    \"suggestedTranslation\": \"Giao hàng\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788334,\n    \"suggestedTranslation\": \"Tìm kiếm thức ăn (bật/tắt)\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788335,\n    \"suggestedTranslation\": \"Nhặt đồ (bật/tắt)\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 788336,\n    \"suggestedTranslation\": \"Đánh dấu vị trí\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788337,\n    \"suggestedTranslation\": \"Lướt Bóng Tối (bật/tắt)\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 788338,\n    \"suggestedTranslation\": \"Biến hình\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788339,\n    \"suggestedTranslation\": \"Ở lại (bật/tắt)\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788341,\n    \"suggestedTranslation\": \"Hỗ trợ (bật/tắt)\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 788342,\n    \"suggestedTranslation\": \"Bạn nhận được rồi mà. Đừng tham lam thế chứ.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 788343,\n    \"suggestedTranslation\": \"Món đồ tuyệt vời đấy.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 788344,\n    \"suggestedTranslation\": \"Hãy để ta xem cháu có gì nào.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 788345,\n    \"suggestedTranslation\": \"Tình hình đang hơi quá đà rồi đấy, nhanh tay nhận giải đi nào!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788346,\n    \"suggestedTranslation\": \"Chúc mừng cậu nhóc! Cháu thắng rồi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788348,\n    \"suggestedTranslation\": \"Cúi đầu chào nào!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788349,\n    \"suggestedTranslation\": \"Ai cũng có quà mang về nhé.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788350,\n    \"suggestedTranslation\": \"Được rồi, bắt đầu buổi biểu diễn thôi nào...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788351,\n    \"suggestedTranslation\": \"Tuyệt vời, ta nghĩ cuộc thi kết thúc rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788352,\n    \"suggestedTranslation\": \"Con này trông dữ dằn quá mức.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788353,\n    \"suggestedTranslation\": \"Độ hung dữ của con Bò Lai này vượt quá gu của ta hôm nay rồi.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788354,\n    \"suggestedTranslation\": \"Bò Lai hôm nay cần phải dữ dội hơn chú gấu bông này nhiều.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788355,\n    \"suggestedTranslation\": \"Hôm nay ta muốn tìm thứ gì đó đáng sợ hơn cơ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788356,\n    \"suggestedTranslation\": \"Con Bò Lai này dữ hơn mức ta mong muốn một chút.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788357,\n    \"suggestedTranslation\": \"Hơi dữ tợn một chút thì tốt, nhưng hôm nay thì không.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788358,\n    \"suggestedTranslation\": \"Có lẽ con Bò Lai này cần phải dữ dằn hơn một chút nữa.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788359,\n    \"suggestedTranslation\": \"Con Bò Lai này chưa đủ dữ dội như ta thích, nhưng cũng gần được rồi.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788360,\n    \"suggestedTranslation\": \"Ta thích sự hung dữ của con này.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788361,\n    \"suggestedTranslation\": \"Con Bò Lai này mang lại cho ta cảm giác sợ hãi vừa đủ.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788362,\n    \"suggestedTranslation\": \"Cuối cùng thì ta cũng có hứng để xem mấy thứ đáng sợ. Mang con Bò Lai dữ dằn nhất của các cháu ra đây nào!\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788363,\n    \"suggestedTranslation\": \"Cuối cùng, người chiến thắng hôm nay phải là một chú gấu bông. Trái tim già cỗi này không chịu được sợ hãi đâu.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788364,\n    \"suggestedTranslation\": \"Cuối cùng, người chiến thắng hôm nay sẽ chỉ nhỉnh hơn vẻ thân thiện một chút thôi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788365,\n    \"suggestedTranslation\": \"Cuối cùng, ta muốn thấy một con Bò Lai thân thiện hơn là đáng sợ.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788366,\n    \"suggestedTranslation\": \"Cuối cùng, ta vẫn chưa quyết định được. Hãy cho ta thấy sự cân bằng hoàn hảo giữa đáng sợ và thân thiện.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788367,\n    \"suggestedTranslation\": \"Cuối cùng, ta đang tìm kiếm thứ gì đó thật sự hung dữ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788368,\n    \"suggestedTranslation\": \"Cuối cùng, ta muốn một bề ngoài trông thật đáng sợ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788369,\n    \"suggestedTranslation\": \"Cuối cùng, ta chỉ muốn một chút xíu hung dữ thôi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788370,\n    \"suggestedTranslation\": \"Cuối cùng, hôm nay ta muốn thấy chút hung dữ, nhưng chỉ phớt qua thôi nhé.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788371,\n    \"suggestedTranslation\": \"Mẫu vật này dữ dằn hơn mức ta muốn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788372,\n    \"suggestedTranslation\": \"Ta công nhận con Bò Lai này rất đáng sợ, nhưng hơi quá gu của ta rồi.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788373,\n    \"suggestedTranslation\": \"Ta muốn con Bò Lai của mình phải đáng sợ hơn thế này kha khá.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788374,\n    \"suggestedTranslation\": \"Con này chưa đủ độ máu chiến, còn kém xa lắm.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788375,\n    \"suggestedTranslation\": \"Con này mang không khí lễ hội quá mức rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788376,\n    \"suggestedTranslation\": \"Độ lễ hội của con Bò Lai này vượt quá gu của ta hôm nay rồi.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788377,\n    \"suggestedTranslation\": \"Bò Lai hôm nay phải có không khí lễ hội hơn lão khó tính này nhiều.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788378,\n    \"suggestedTranslation\": \"Hôm nay ta đang tìm kiếm thứ gì đó đậm chất lễ hội hơn cơ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788379,\n    \"suggestedTranslation\": \"Con Bò Lai này mang không khí lễ hội hơn ta mong muốn một chút.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788380,\n    \"suggestedTranslation\": \"Mang chút không khí lễ hội thì tốt, nhưng hôm nay thì không.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788381,\n    \"suggestedTranslation\": \"Có lẽ con Bò Lai này nên mang không khí lễ hội hơn một chút.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788382,\n    \"suggestedTranslation\": \"Con Bò Lai này chưa đủ không khí lễ hội như ta thích, nhưng cũng gần được rồi.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788383,\n    \"suggestedTranslation\": \"Ta thích không khí lễ hội của con này.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788384,\n    \"suggestedTranslation\": \"Con Bò Lai này có độ lễ hội vừa đủ.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788385,\n    \"suggestedTranslation\": \"Ngoài ra, người chiến thắng phải là loài thú rộn ràng nhất mùa lễ hội.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788386,\n    \"suggestedTranslation\": \"Ngoài ra, ta không muốn thấy chút không khí lễ hội nào ở nhà vô địch hôm nay cả.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788387,\n    \"suggestedTranslation\": \"Thêm nữa, hôm nay ta không có tâm trạng cho lễ hội đâu. Tốt nhất là đừng để ta thấy một dấu vết nào!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788388,\n    \"suggestedTranslation\": \"Ngoài ra, phải thật tưng bừng lễ hội, chỉ phảng phất chút u buồn thôi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788389,\n    \"suggestedTranslation\": \"Thêm nữa, người chiến thắng hôm nay sẽ mang nét u buồn nhiều hơn là lễ hội.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788390,\n    \"suggestedTranslation\": \"Ngoài ra, ta đang tìm kiếm sự pha trộn tinh tế giữa lễ hội và nét u buồn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788391,\n    \"suggestedTranslation\": \"Thêm nữa, nhà vô địch hôm nay phải là sự kết hợp hoàn hảo giữa nét u buồn và sự rộn ràng lễ hội.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788392,\n    \"suggestedTranslation\": \"Ngoài ra, hôm nay ta muốn tìm kiếm thứ gì đó thật tưng bừng lễ hội.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788393,\n    \"suggestedTranslation\": \"Thêm nữa, ta chỉ muốn thấy một chút xíu không khí lễ hội thôi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788394,\n    \"suggestedTranslation\": \"Anh bạn này rộn ràng lễ hội hơn mức ta muốn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788395,\n    \"suggestedTranslation\": \"Ta công nhận con Bò Lai này rất có không khí lễ hội, nhưng hơi quá gu của ta rồi.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788396,\n    \"suggestedTranslation\": \"Ta muốn con Bò Lai của mình phải mang không khí lễ hội hơn thế này kha khá.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788397,\n    \"suggestedTranslation\": \"Con này chưa đủ độ lễ hội, còn kém xa lắm.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788398,\n    \"suggestedTranslation\": \"Được rồi, cuộc thi tạm thời kết thúc nhé mọi người!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788399,\n    \"suggestedTranslation\": \"Cuối cùng, lựa chọn cho vị trí quán quân của ta là...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788400,\n    \"suggestedTranslation\": \"Con này trang trọng quá mức rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788401,\n    \"suggestedTranslation\": \"Sự trang trọng của con Bò Lai này vượt quá gu của ta hôm nay rồi.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788402,\n    \"suggestedTranslation\": \"Bò Lai hôm nay phải trang trọng hơn chú nhóc rách rưới này nhiều.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788403,\n    \"suggestedTranslation\": \"Hôm nay ta đang tìm kiếm thứ gì đó trang trọng hơn nhiều.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788404,\n    \"suggestedTranslation\": \"Con Bò Lai này trang trọng hơn ta mong muốn một chút.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788405,\n    \"suggestedTranslation\": \"Hơi trang trọng quá thì tốt, nhưng hôm nay thì không.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788406,\n    \"suggestedTranslation\": \"Có lẽ con Bò Lai này nên trang trọng hơn một chút.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788407,\n    \"suggestedTranslation\": \"Con Bò Lai này chưa đủ trang trọng như ta thích, nhưng cũng gần được rồi.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788408,\n    \"suggestedTranslation\": \"Ta thích sự trang trọng của con này.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788409,\n    \"suggestedTranslation\": \"Con Bò Lai này có độ trang trọng vừa đủ.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788410,\n    \"suggestedTranslation\": \"Mọi thứ về người chiến thắng hôm nay đều phải toát lên sự \\\"trang trọng\\\".\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788411,\n    \"suggestedTranslation\": \"Gu của ta hôm nay là hoàn toàn không cần sự trang trọng.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788412,\n    \"suggestedTranslation\": \"Con Bò Lai hôm nay nên mang chút vẻ trang trọng lịch sự.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788413,\n    \"suggestedTranslation\": \"Lựa chọn của ta hôm nay sẽ phá cách hơn là trang trọng.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788414,\n    \"suggestedTranslation\": \"Ta muốn thấy sự pha trộn hoàn hảo giữa nét phá cách và trang trọng.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788415,\n    \"suggestedTranslation\": \"Hôm nay ta muốn thấy đỉnh cao của sự trang trọng, kèm theo chút nổi loạn phá cách.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788416,\n    \"suggestedTranslation\": \"Ta muốn tìm thứ gì đó mang tính phá cách là chính, phảng phất chút trang trọng thôi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788417,\n    \"suggestedTranslation\": \"Mẫu vật này trang trọng hơn mức ta muốn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788418,\n    \"suggestedTranslation\": \"Ta công nhận con Bò Lai này rất trang trọng, nhưng hơi quá gu của ta rồi.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788419,\n    \"suggestedTranslation\": \"Ta muốn con Bò Lai của mình phải trang trọng hơn thế này kha khá.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788420,\n    \"suggestedTranslation\": \"Con này chưa đủ độ trang trọng, còn kém xa lắm.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788422,\n    \"suggestedTranslation\": \"Chà chà, để ta ngắm nghía đám thú cưng này xem nào.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788423,\n    \"suggestedTranslation\": \"Con Bò Lai hoàn hảo trong mắt ta thay đổi theo từng ngày...\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 788424,\n    \"suggestedTranslation\": \"Được rồi, lựa chọn cho vị trí thứ ba của ta là...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788425,\n    \"suggestedTranslation\": \"Cuối cùng, đây là con búp bê đáng sợ nhất!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788426,\n    \"suggestedTranslation\": \"Cuối cùng, con này trông như chú gấu bông vậy. Trái tim ta nhẹ nhõm hẳn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788427,\n    \"suggestedTranslation\": \"Cuối cùng, nó chỉ nhỉnh hơn vẻ thân thiện một chút thôi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788428,\n    \"suggestedTranslation\": \"Cuối cùng, con này thân thiện hơn là đáng sợ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788429,\n    \"suggestedTranslation\": \"Cuối cùng, nó có sự cân bằng tốt giữa sự đáng sợ và thân thiện.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788430,\n    \"suggestedTranslation\": \"Cuối cùng, nó khá là hung dữ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788431,\n    \"suggestedTranslation\": \"Cuối cùng, bề ngoài con này trông khá đáng sợ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788432,\n    \"suggestedTranslation\": \"Cuối cùng, nó chỉ có chút xíu hung dữ thôi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788433,\n    \"suggestedTranslation\": \"Cuối cùng, ta thấy chút hung dữ ở đó, nhưng chỉ phớt qua thôi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788434,\n    \"suggestedTranslation\": \"Ngoài ra, đây là con búp bê rộn ràng lễ hội nhất.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788435,\n    \"suggestedTranslation\": \"Nhìn chung, ta chả thấy một dấu hiệu nào được gọi là không khí lễ hội ở đây cả.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788436,\n    \"suggestedTranslation\": \"Ngoài ra, nó rất rộn ràng lễ hội, chỉ phảng phất chút u buồn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788437,\n    \"suggestedTranslation\": \"Thêm nữa, con này mang nét u buồn nhiều hơn là lễ hội.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788438,\n    \"suggestedTranslation\": \"Ngoài ra, đây là sự kết hợp tinh tế giữa lễ hội và nét u buồn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788439,\n    \"suggestedTranslation\": \"Thêm nữa, nó là sự cân bằng hoàn hảo giữa nét u buồn và rộn ràng lễ hội.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788440,\n    \"suggestedTranslation\": \"Ngoài ra, nó mang rất nhiều không khí lễ hội.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788441,\n    \"suggestedTranslation\": \"Thêm nữa, nó chỉ mang một chút xíu không khí lễ hội thôi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788442,\n    \"suggestedTranslation\": \"Mọi thứ ở con này đều toát lên sự \\\"trang trọng\\\".\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788443,\n    \"suggestedTranslation\": \"Nó hoàn toàn thiếu đi sự trang trọng.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788444,\n    \"suggestedTranslation\": \"Con này mang một chút nét trang trọng.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788445,\n    \"suggestedTranslation\": \"Con này mang tính phá cách nhiều hơn là trang trọng.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788446,\n    \"suggestedTranslation\": \"Đó là sự pha trộn hoàn hảo giữa nét phá cách và trang trọng.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788447,\n    \"suggestedTranslation\": \"Đây là đỉnh cao của sự trang trọng, kèm theo chút nổi loạn phá cách.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788448,\n    \"suggestedTranslation\": \"Con này mang tính phá cách là chính, phảng phất chút trang trọng thôi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788449,\n    \"suggestedTranslation\": \"Hãy tập hợp vài cư dân địa phương để mọi thứ thêm phần thú vị nào.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788450,\n    \"suggestedTranslation\": \"Chúc mừng nhé! Đừng tiêu sạch tiền vào một chỗ đấy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788451,\n    \"suggestedTranslation\": \"Của bạn đây, làm tốt lắm.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788452,\n    \"suggestedTranslation\": \"Nào, đố bạn trong số mấy mỹ nhân này ai là người chiến thắng hôm nay đấy!?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788453,\n    \"suggestedTranslation\": \"Cứ thong thả, lựa chọn cho chuẩn vào nhé.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788454,\n    \"suggestedTranslation\": \"Được rồi, nhanh tay lên nào...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788457,\n    \"suggestedTranslation\": \"Chào nhé!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788461,\n    \"suggestedTranslation\": \"Đến lấy phần thưởng đi, ta không đợi cả ngày đâu.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788462,\n    \"suggestedTranslation\": \"Tiếc quá, lần này bạn không thắng được giải nào rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788463,\n    \"suggestedTranslation\": \"Quả là một đám đông đầy phong cách.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 788464,\n    \"suggestedTranslation\": \"Hôm nay không ai đoán đúng cả! Vẫn còn ngày mai cơ mà.\",\n    \