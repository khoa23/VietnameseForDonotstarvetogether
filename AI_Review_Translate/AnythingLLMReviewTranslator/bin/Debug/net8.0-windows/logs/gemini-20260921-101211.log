            "text": "[\n  {\n    \"id\": 783045,\n    \"suggestedTranslation\": \"nó cháy...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 783046,\n    \"suggestedTranslation\": \"Người có tầm nhìn!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 783047,\n    \"suggestedTranslation\": \"... đàn con của tôi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783048,\n    \"suggestedTranslation\": \"Ngươi đã làm gì vậy, Người mang khiên?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783049,\n    \"suggestedTranslation\": \"Á-!!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 783050,\n    \"suggestedTranslation\": \"Vậy... lòng trung thành cả đời lại được đền đáp bằng một nhát dao đâm vào lớp giáp của ta...\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783051,\n    \"suggestedTranslation\": \"Với hơi thở cuối cùng này, ta nguyền rủa ngươi và Nữ hoàng của ngươi!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783052,\n    \"suggestedTranslation\": \"Cầu cho đàn con của ngươi biến thành đồ thối...\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783053,\n    \"suggestedTranslation\": \"Cầu mong tất cả những gì ngươi trân quý đều bị nhấn chìm trong bóng tối...\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783054,\n    \"suggestedTranslation\": \"Hãy để bóng đêm vô tận... nuốt chửng... tất cả các ngươi...\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783055,\n    \"suggestedTranslation\": \"trong sự nô lệ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 783056,\n    \"suggestedTranslation\": \"Artificer thân mến, ngươi hỏi ta đã làm gì ư.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783057,\n    \"suggestedTranslation\": \"Không giống như Visionist đáng kính của chúng ta,\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783058,\n    \"suggestedTranslation\": \"Ta đã cạn chén rượu của trách nhiệm\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783059,\n    \"suggestedTranslation\": \"dù biết rõ sự cay đắng chứa đựng bên trong.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783060,\n    \"suggestedTranslation\": \"Giờ đây, khi những người anh em đang ngã xuống trước mặt ta,\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783061,\n    \"suggestedTranslation\": \"Ta sẽ canh giữ công trình của chúng ta\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783062,\n    \"suggestedTranslation\": \"Artificer thân mến của tôi,\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783063,\n    \"suggestedTranslation\": \"cho đến khi ta cũng theo họ vào cõi vĩnh hằng.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783064,\n    \"suggestedTranslation\": \"Niềm an ủi duy nhất của ta là:\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783065,\n    \"suggestedTranslation\": \"rằng ta đã phụng sự Người,\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783067,\n    \"suggestedTranslation\": \"Hãy tung hô Metheus.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783068,\n    \"suggestedTranslation\": \"Nguyện xin Người trị vì mãi mãi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783069,\n    \"suggestedTranslation\": \"đây là kiệt tác tuyệt vời nhất mà bạn từng thực hiện,\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783070,\n    \"suggestedTranslation\": \"đưa tầm nhìn của ta đến bước thành hiện thực.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783071,\n    \"suggestedTranslation\": \"Và chưa từng có một tầm nhìn nào vĩ đại hơn\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783072,\n    \"suggestedTranslation\": \"của ngươi trong căn phòng này, Visionist thân mến.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783073,\n    \"suggestedTranslation\": \"Những vị khách tiếp theo của chúng ta chẳng cần phải giới thiệu nữa!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783074,\n    \"suggestedTranslation\": \"Chuẩn luôn.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783075,\n    \"suggestedTranslation\": \"Vậy sao chúng ta lại ở đây?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783076,\n    \"suggestedTranslation\": \"Các ngươi có thắc mắc.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783077,\n    \"suggestedTranslation\": \"Các ngươi thấy tò mò!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783078,\n    \"suggestedTranslation\": \"Sợ chết khiếp!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783079,\n    \"suggestedTranslation\": \"Không có gì phải sợ cả...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 783080,\n    \"suggestedTranslation\": \"Ít ra là không sợ bóng tối.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783081,\n    \"suggestedTranslation\": \"Các ngươi phải sợ điều gì chứ?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783084,\n    \"suggestedTranslation\": \"Chào các bạn!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783085,\n    \"suggestedTranslation\": \"Đó là thứ ánh sáng lấp lánh bị nguyền rủa chứ gì nữa!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783086,\n    \"suggestedTranslation\": \"Tất nhiên rồi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 783087,\n    \"suggestedTranslation\": \"Từ cái Cầu Thiên Thể khốn nạn đó!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 783088,\n    \"suggestedTranslation\": \"Hừ! Quả cầu!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783089,\n    \"suggestedTranslation\": \"Phải. \\\"Hừ\\\" thật chứ!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783090,\n    \"suggestedTranslation\": \"Chúng ta cũng đến từ những vương quốc của riêng mình.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783091,\n    \"suggestedTranslation\": \"Bị đe dọa bởi những vị thần khủng khiếp.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783092,\n    \"suggestedTranslation\": \"Cho đến khi tấm màn dịu ngọt được buông xuống chúng ta.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783093,\n    \"suggestedTranslation\": \"Và giờ đây, ba chúng ta đã được tự do!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783094,\n    \"suggestedTranslation\": \"Tự dooooo!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783095,\n    \"suggestedTranslation\": \"Ba chúng tôi là sứ giả của đấng bảo hộ u ám.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783096,\n    \"suggestedTranslation\": \"Các ngươi cũng có thể được giải thoát!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783097,\n    \"suggestedTranslation\": \"Ú òa!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783098,\n    \"suggestedTranslation\": \"Hãy đến với chúng tôi dưới lớp màn bảo vệ\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783099,\n    \"suggestedTranslation\": \"các ngươi sẽ không bao giờ phải sợ bóng tối nữa!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783100,\n    \"suggestedTranslation\": \"Đừng bao giờ nhóm lửa nữa!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 783101,\n    \"suggestedTranslation\": \"Hay chặt gỗ!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783102,\n    \"suggestedTranslation\": \"Hay đi ngủ!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783103,\n    \"suggestedTranslation\": \"Hay ăn uống!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783104,\n    \"suggestedTranslation\": \"Hay chớp mắt!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783105,\n    \"suggestedTranslation\": \"Các ngươi vẫn có thể chớp mắt.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783106,\n    \"suggestedTranslation\": \"Ôooo... u ám quá!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783107,\n    \"suggestedTranslation\": \"Vẫn chớp mắt được!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783108,\n    \"suggestedTranslation\": \"Các ngươi sẽ hòa làm một với màn đêm vĩnh hằng!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783109,\n    \"suggestedTranslation\": \"Mãi mãi trong vòng tay ngọt ngào và mập mờ!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783113,\n    \"suggestedTranslation\": \"Tối tăm!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783114,\n    \"suggestedTranslation\": \"Tối thui luôn ấy chứ!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783115,\n    \"suggestedTranslation\": \"Chết chóc!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783116,\n    \"suggestedTranslation\": \"Không chết chóc đâu.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783117,\n    \"suggestedTranslation\": \"Thật nhân từ!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783118,\n    \"suggestedTranslation\": \"Quá đỗi nhân từ!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783119,\n    \"suggestedTranslation\": \"Tại sao nhà biên kịch lại làm mờ đèn ở màn đầu tiên nhỉ?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783120,\n    \"suggestedTranslation\": \"Điềm báo trước!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783121,\n    \"suggestedTranslation\": \"\\\"Khúc ca về phong cảnh\\\"\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783122,\n    \"suggestedTranslation\": \"Ồ, cái này có vẻ hay đây.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783123,\n    \"suggestedTranslation\": \"Cây cối đứng một mình.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783124,\n    \"suggestedTranslation\": \"Trong sự im lặng kiên định.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783125,\n    \"suggestedTranslation\": \"Chẳng làm cái quái gì cả.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783126,\n    \"suggestedTranslation\": \"Đó là màn diễn tôi thích nhất từ trước đến nay.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783128,\n    \"suggestedTranslation\": \"Và bây giờ, Visionist...\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783129,\n    \"suggestedTranslation\": \"Người giám sát của chúng ta rất kiên định với mục tiêu,\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783130,\n    \"suggestedTranslation\": \"và tôi đặt trọn niềm tin vào cô ấy\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783131,\n    \"suggestedTranslation\": \"để dẫn dắt chúng ta vượt qua nỗ lực bền bỉ này.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783132,\n    \"suggestedTranslation\": \"Kẻ Khác sẽ không thể thắng thế.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783133,\n    \"suggestedTranslation\": \"Ồ, nhưng hắn sẽ thắng đấy!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783134,\n    \"suggestedTranslation\": \"Chắc hắn không ngờ tới điều đó đâu.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783136,\n    \"suggestedTranslation\": \"Visionist? Hắn có thấy tụi mình đang chán không vậy?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783138,\n    \"suggestedTranslation\": \"Đây quả là một nhiệm vụ nặng nề đặt lên vai chúng ta,\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783139,\n    \"suggestedTranslation\": \"nhưng ta sẽ thiết kế một công trình phức tạp đến mức\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783140,\n    \"suggestedTranslation\": \"không tài nào giải nổi mà vương quốc này từng chứng kiến.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783141,\n    \"suggestedTranslation\": \"Vì vinh quang của Nhà vua và Nữ hoàng,\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783142,\n    \"suggestedTranslation\": \"vì Vương quốc của chúng ta,\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783144,\n    \"suggestedTranslation\": \"Tôi đã dạy Woby rất nhiều trò đấy, xem này!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783145,\n    \"suggestedTranslation\": \"Được rồi Woby... ngồi im nào!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783146,\n    \"suggestedTranslation\": \"Cô gái ngoan!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783147,\n    \"suggestedTranslation\": \"Tụi tôi ờ... tụi tôi vẫn đang luyện tập mấy trò còn lại.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783148,\n    \"suggestedTranslation\": \"Nhưng thế cũng khá ấn tượng rồi đúng không?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783149,\n    \"suggestedTranslation\": \"\\\"Ông già William ơi,\\\" chàng thanh niên cất lời\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783150,\n    \"suggestedTranslation\": \"\\\"Và mái tóc ông đã điểm bạc;\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 783151,\n    \"suggestedTranslation\": \"Vậy mà ông cứ cắm đầu đứng bằng tay—\",\n    \"rating\": 8.5\