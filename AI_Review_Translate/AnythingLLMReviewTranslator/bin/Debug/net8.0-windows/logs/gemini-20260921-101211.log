ation\": \"Lối chơi:\", \"rating\": 9.5},\n  {\"id\": 787406, \"suggestedTranslation\": \"Lối chơi của bạn là gì?\", \"rating\": 9.5},\n  {\"id\": 787407, \"suggestedTranslation\": \"Máy chủ chuyên dụng\", \"rating\": 9.0},\n  {\"id\": 787408, \"suggestedTranslation\": \"Hiện máy chủ trống:\", \"rating\": 9.5},\n  {\"id\": 787409, \"suggestedTranslation\": \"Hiện máy chủ đầy:\", \"rating\": 9.5},\n  {\"id\": 787410, \"suggestedTranslation\": \"Ẩn máy chủ đang tạm dừng:\", \"rating\": 9.0},\n  {\"id\": 787412, \"suggestedTranslation\": \"LAN\", \"rating\": 9.5},\n  {\"id\": 787413, \"suggestedTranslation\": \"Cuối \", \"rating\": 9.0},\n  {\"id\": 787415, \"suggestedTranslation\": \"Người chơi hoạt động tối đa\", \"rating\": 8.5},\n  {\"id\": 787416, \"suggestedTranslation\": \"Số người chơi tối đa\", \"rating\": 9.0},\n  {\"id\": 787417, \"suggestedTranslation\": \"Người chơi hoạt động tối thiểu\", \"rating\": 8.5},\n  {\"id\": 787418, \"suggestedTranslation\": \"Của tôi\", \"rating\": 8.0},\n  {\"id\": 787419, \"suggestedTranslation\": \"Số chỗ trống tối thiểu:\", \"rating\": 9.0},\n  {\"id\": 787420, \"suggestedTranslation\": \"Máy chủ này chưa được cập nhật. Chúng tôi không thể hiển thị cài đặt thế giới.\", \"rating\": 9.0},\n  {\"id\": 787422, \"suggestedTranslation\": \"Đã bật Mod:\", \"rating\": 9.0},\n  {\"id\": 787424, \"suggestedTranslation\": \"Không thể xem danh sách mod qua mạng LAN.\\nSao bạn không quay sang hỏi trực tiếp bạn mình nhỉ?\", \"rating\": 9.5},\n  {\"id\": 787425, \"suggestedTranslation\": \"Không thể tải danh sách mod do không tương thích phiên bản.\", \"rating\": 9.0},\n  {\"id\": 787428, \"suggestedTranslation\": \"Máy chủ này có bật mod. Klei sẽ không thể hỗ trợ nếu bạn gặp sự cố khi chơi trên máy chủ có mod.\", \"rating\": 9.0},\n  {\"id\": 787429, \"suggestedTranslation\": \"Đã bật Mod\", \"rating\": 9.5},\n  {\"id\": 787433, \"suggestedTranslation\": \"Chưa chọn máy chủ nào\", \"rating\": 9.5},\n  {\"id\": 787434, \"suggestedTranslati