            "text": "[\n  {\"id\": 702065, \"suggestedTranslation\": \"Thẩm phán sẽ không thể nhìn thấy con Bò Lai của tôi từ đây được đâu.\", \"rating\": 10.0},\n  {\"id\": 702066, \"suggestedTranslation\": \"Tất nhiên là không thể dễ dàng như thế được.\", \"rating\": 9.5},\n  {\"id\": 702067, \"suggestedTranslation\": \"Đừng có mà ngủ! Dậy đi, chúng ta còn phải thắng cuộc đua này nữa!\", \"rating\": 9.0},\n  {\"id\": 702068, \"suggestedTranslation\": \"Dậy mau! TIẾN LÊN NÀO!\", \"rating\": 9.0},\n  {\"id\": 702069, \"suggestedTranslation\": \"Đừng đi bộ, HÃY CHẠY!\", \"rating\": 9.5},\n  {\"id\": 702070, \"suggestedTranslation\": \"Không, không! Bạn đang đi sai đường rồi!\", \"rating\": 9.5},\n  {\"id\": 702071, \"suggestedTranslation\": \"Quay lại đây, mắt trắng!\", \"rating\": 9.0},\n  {\"id\": 702072, \"suggestedTranslation\": \"Hãy để thí nghiệm... ý tôi là cuộc đua, bắt đầu!\", \"rating\": 8.5},\n  {\"id\": 702073, \"suggestedTranslation\": \"Trần hang đang mất ổn định!\", \"rating\": 9.5},\n  {\"id\": 702074, \"suggestedTranslation\": \"Mọi chuyện vẫn ổn.\", \"rating\": 9.0},\n  {\"id\": 702075, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wx78\", \"rating\": 10.0},\n  {\"id\": 702076, \"suggestedTranslation\": \"Sự hiện diện đó... quen quá! Ai đấy?\", \"rating\": 9.0},\n  {\"id\": 702077, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_winona\", \"rating\": 10.0},\n  {\"id\": 702078, \"suggestedTranslation\": \"Ái! Có thứ gì vừa cắn tôi!\", \"rating\": 9.0},\n  {\"id\": 702079, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_winona\", \"rating\": 10.0},\n  {\"id\": 702080, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfgang\", \"rating\": 10.0},\n  {\"id\": 702081, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfgang\", \"rating\": 10.0},\n  {\"id\": 702082, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfgang\", \"rating\": 10.0},\n  {\"id\": 702083, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfgang\", \"rating\": 10.0},\n  {\"id\": 702084, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfgang\", \"rating\": 10.0},\n  {\"id\": 702085, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfgang\", \"rating\": 10.0},\n  {\"id\": 702086, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfgang\", \"rating\": 10.0},\n  {\"id\": 702087, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfgang\", \"rating\": 10.0},\n  {\"id\": 702088, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfgang\", \"rating\": 10.0},\n  {\"id\": 702089, \"suggestedTranslation\": \"Lạnh quá!\", \"rating\": 9.5},\n  {\"id\": 702090, \"suggestedTranslation\": \"La bàn này không còn hoạt động nữa rồi.\", \"rating\": 9.5},\n  {\"id\": 702091, \"suggestedTranslation\": \"Tôi cảm thấy sảng khoái hẳn lên!\", \"rating\": 9.5},\n  {\"id\": 702092, \"suggestedTranslation\": \"Tôi còn thiếu vài nguyên liệu chính.\", \"rating\": 9.0},\n  {\"id\": 702093, \"suggestedTranslation\": \"Ồ, H2O.\", \"rating\": 9.5},\n  {\"id\": 702094, \"suggestedTranslation\": \"Nghe có vẻ to lắm!\", \"rating\": 9.0},\n  {\"id\": 702095, \"suggestedTranslation\": \"Tôi thấy ánh sáng rồi!\", \"rating\": 9.0},\n  {\"id\": 702096, \"suggestedTranslation\": \"Có vẻ sự vạm vỡ của tôi không kéo dài lâu được.\", \"rating\": 9.0},\n  {\"id\": 702097, \"suggestedTranslation\": \"Điện đã biến mất, nhưng hiện tượng tĩnh điện vẫn còn vương lại.\", \"rating\": 9.0},\n  {\"id\": 702098, \"suggestedTranslation\": \"Xem ra chuỗi ngày khô ráo của tôi đã kết thúc.\", \"rating\": 9.0},\n  {\"id\": 702099, \"suggestedTranslation\": \"Chà, thế là tuyệt cú mèo trong lúc nó còn kéo dài.\", \"rating\": 9.0},\n  {\"id\": 702100, \"suggestedTranslation\": \"Tôi sẽ... (ngáp) không bao giờ... thấy mệt... nữa đâu...\", \"rating\": 9.0},\n  {\"id\": 702101, \"suggestedTranslation\": \"Cảm giác muốn trì hoãn... đang quay trở lại...\", \"rating\": 9.0},\n  {\"id\": 702102, \"suggestedTranslation\": \"Trông nó đã khá hơn rồi đấy.\", \"rating\": 9.5},\n  {\"id\": 702103, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wx78\", \"rating\": 10.0},\n  {\"id\": 702104, \"suggestedTranslation\": \"Trời đang muộn dần. Sẽ tối nhanh thôi.\", \"rating\": 9.0},\n  {\"id\": 702105, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_warly\", \"rating\": 10.0},\n  {\"id\": 702106, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_warly\", \"rating\": 10.0},\n  {\"id\": 702107, \"suggestedTranslation\": \"Ngon tuyệt!\", \"rating\": 9.5},\n  {\"id\": 702108, \"suggestedTranslation\": \"Tôi không thể ăn thứ đó!\", \"rating\": 9.5},\n  {\"id\": 702109, \"suggestedTranslation\": \"Tôi thấy hơi khó chịu trong người.\", \"rating\": 9.0},\n  {\"id\": 702110, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_warly\", \"rating\": 10.0},\n  {\"id\": 702111, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_warly\", \"rating\": 10.0},\n  {\"id\": 702112, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_warly\", \"rating\": 10.0},\n  {\"id\": 702113, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_warly\", \"rating\": 10.0},\n  {\"id\": 702114, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_warly\", \"rating\": 10.0},\n  {\"id\": 702115, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_warly\", \"rating\": 10.0},\n  {\"id\": 702116, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_warly\", \"rating\": 10.0},\n  {\"id\": 702117, \"suggestedTranslation\": \"Eo ôi! Kinh khủng quá!\", \"rating\": 9.5},\n  {\"id\": 702118, \"suggestedTranslation\": \"Tôi nghĩ món đó bắt đầu ôi thiu rồi.\", \"rating\": 9.0},\n  {\"id\": 702119, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_warly\", \"rating\": 10.0},\n  {\"id\": 702120, \"suggestedTranslation\": \"Cho thứ đó vào miệng đúng là ghê tởm!\", \"rating\": 9.0},\n  {\"id\": 702121, \"suggestedTranslation\": \"Lẽ ra tôi nên chia sẻ món này với mọi người.\", \"rating\": 9.0},\n  {\"id\": 702122, \"suggestedTranslation\": \"Nó giống như một mũi tiêm tăng cường vậy.\", \"rating\": 9.0},\n  {\"id\": 702123, \"suggestedTranslation\": \"Tôi cảm thấy hơi choáng váng.\", \"rating\": 9.0},\n  {\"id\": 702124, \"suggestedTranslation\": \"Tôi nghĩ mình có thể nhấc bổng cả một con ngựa.\", \"rating\": 9.0},\n  {\"id\": 702125, \"suggestedTranslation\": \"Cái này có vẻ hơi nặng đô đấy.\", \"rating\": 9.0},\n  {\"id\": 702126, \"suggestedTranslation\": \"Hộc... Thở... hoo...\", \"rating\": 9.0},\n  {\"id\": 702127, \"suggestedTranslation\": \"Lẽ ra tôi nên chế tạo... một cỗ máy nâng vật nặng...\", \"rating\": 9.0},\n  {\"id\": 702128, \"suggestedTranslation\": \"Dùng lực... bằng sống lưng của bạn...\", \"rating\": 9.0},\n  {\"id\": 702129, \"suggestedTranslation\": \"Đây không phải... việc dành cho quý ông...\", \"rating\": 9.0},\n  {\"id\": 702130, \"suggestedTranslation\": \"Vì... khoa học... hừm!\", \"rating\": 9.0},\n  {\"id\": 702131, \"suggestedTranslation\": \"Việc này có làm... hỏng mái tóc của tôi không vậy?\", \"rating\": 9.0},\n  {\"id\": 702132, \"suggestedTranslation\": \"Hừm...!\", \"rating\": 9.5},\n  {\"id\": 702133, \"suggestedTranslation\": \"Thở... hổn hển...\", \"rating\": 9.0},\n  {\"id\": 702134, \"suggestedTranslation\": \"Đây đúng là... thí nghiệm tệ nhất...\", \"rating\": 9.0},\n  {\"id\": 702135, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_winona\", \"rating\": 10.0},\n  {\"id\": 702136, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_winona\", \"rating\": 10.0},\n  {\"id\": 702137, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_winona\", \"rating\": 10.0},\n  {\"id\": 702138, \"suggestedTranslation\": \"Tối quá!\", \"rating\": 9.5},\n  {\"id\": 702139, \"suggestedTranslation\": \"Tôi lại nhìn thấy rồi!\", \"rating\": 9.5},\n  {\"id\": 702140, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_waxwell\", \"rating\": 10.0},\n  {\"id\": 702141, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_waxwell\", \"rating\": 10.0},\n  {\"id\": 702142, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_waxwell\", \"rating\": 10.0},\n  {\"id\": 702143, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_waxwell\", \"rating\": 10.0},\n  {\"id\": 702144, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfang\", \"rating\": 10.0},\n  {\"id\": 702145, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfang\", \"rating\": 10.0},\n  {\"id\": 702146, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfang\", \"rating\": 10.0},\n  {\"id\": 702147, \"suggestedTranslation\": \"Suýt thì tôi chết đuối trong mớ... thứ đó rồi!\", \"rating\": 9.0},\n  {\"id\": 702148, \"suggestedTranslation\": \"Cái gì thế - một con mắt khổng lồ đang trôi nổi á?!\", \"rating\": 9.0},\n  {\"id\": 702149, \"suggestedTranslation\": \"Đứng lại đó mau, tôi chưa xử xong cô đâu!\", \"rating\": 9.0},\n  {\"id\": 702150, \"suggestedTranslation\": \"Cuối cùng thì!\", \"rating\": 9.5},\n  {\"id\": 702151, \"suggestedTranslation\": \"Cái quạt của tôi đã bay theo gió mất rồi.\", \"rating\": 9.5},\n  {\"id\": 702152, \"suggestedTranslation\": \"Tôi chưa bao giờ nghĩ mình lại dùng tư duy khoa học vào... việc này.\", \"rating\": 9.0},\n  {\"id\": 702153, \"suggestedTranslation\": \"Bên trong tôi đang bốc cháy!\", \"rating\": 9.5},\n  {\"id\": 702154, \"suggestedTranslation\": \"Ái chà, nóng quá!\", \"rating\": 9.5},\n  {\"id\": 702155, \"suggestedTranslation\": \"Ghi nhớ: không bao giờ thử nghiệm với độc tố cây tầm ma nữa.\", \"rating\": 9.0},\n  {\"id\": 702156, \"suggestedTranslation\": \"Không biết ai đã đốt pháo sáng thế nhỉ?\", \"rating\": 9.0},\n  {\"id\": 702157, \"suggestedTranslation\": \"Tôi đang bận chết đuối thì có thứ gì đó trồi lên... chính là tôi!\", \"rating\": 9.0},\n  {\"id\": 702158, \"suggestedTranslation\": \"Tôi ghét bị bỏ lửng...\", \"rating\": 9.0},\n  {\"id\": 702159, \"suggestedTranslation\": \"Tôi mệt lắm rồi.\", \"rating\": 9.5},\n  {\"id\": 702160, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_warly\", \"rating\": 10.0},\n  {\"id\": 702161, \"suggestedTranslation\": \"Tôi được tự do rồi! Cuối cùng tôi cũng được tự do!\", \"rating\": 9.5},\n  {\"id\": 702162, \"suggestedTranslation\": \"Chắc lại là chuyện của đám Người Cá rồi.\", \"rating\": 9.0},\n  {\"id\": 702163, \"suggestedTranslation\": \"Phần người trong tôi sắp sửa tan biến rồi...\", \"rating\": 9.0},\n  {\"id\": 702164, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wendy\", \"rating\": 10.0},\n  {\"id\": 702165, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wendy\", \"rating\": 10.0},\n  {\"id\": 702166, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wendy\", \"rating\": 10.0},\n  {\"id\": 702167, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wendy\", \"rating\": 10.0},\n  {\"id\": 702168, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wendy\", \"rating\": 10.0},\n  {\"id\": 702169, \"suggestedTranslation\": \"Ha! Trượt rồi nhé!\", \"rating\": 9.0},\n  {\"id\": 702170, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wormwood\", \"rating\": 10.0},\n  {\"id\": 702171, \"suggestedTranslation\": \"Đã đến lúc bôi thêm Thuốc chống Axit.\", \"rating\": 9.5},\n  {\"id\": 702172, \"suggestedTranslation\": \"Có lẽ đã đến lúc bôi thêm Cao nhiệt rồi.\", \"rating\": 9.0},\n  {\"id\": 702173, \"suggestedTranslation\": \"Tôi bị say sóng rồi!\", \"rating\": 9.5},\n  {\"id\": 702174, \"suggestedTranslation\": \"Tại sao tôi vẫn còn ở đây cơ chứ?\", \"rating\": 9.0},\n  {\"id\": 702175, \"suggestedTranslation\": \"Giờ thì tôi cảm thấy mình thật thông minh!\", \"rating\": 9.5},\n  {\"id\": 702176, \"suggestedTranslation\": \"Cần... băng... hoặc... bóng râm!\", \"rating\": 9.0},\n  {\"id\": 702177, \"suggestedTranslation\": \"Bạn có nghe thấy gì không?\", \"rating\": 9.5},\n  {\"id\": 702178, \"suggestedTranslation\": \"Tôi đói quá!\", \"rating\": 9.5},\n  {\"id\": 702179, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_winona\", \"rating\": 10.0},\n  {\"id\": 702180, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_winona\", \"rating\": 10.0},\n  {\"id\": 702181, \"suggestedTranslation\": \"Lối này trông có vẻ an toàn hơn.\", \"rating\": 9.5},\n  {\"id\": 702182, \"suggestedTranslation\": \"Dấu chân này còn rất mới. Con quái thú chắc đang ở gần đây.\", \"rating\": 9.5},\n  {\"id\": 702183, \"suggestedTranslation\": \"Dấu vết của con quái thú kết thúc ở đây rồi.\", \"rating\": 9.5},\n  {\"id\": 702184, \"suggestedTranslation\": \"Đất ướt thế này không lưu lại được dấu chân đâu.\", \"rating\": 9.0},\n  {\"id\": 702185, \"suggestedTranslation\": \"Đường mòn này trông có vẻ nguy hiểm.\", \"rating\": 9.5},\n  {\"id\": 702186, \"suggestedTranslation\": \"Không con quái thú nào đấu lại được sự thông minh của ta đâu!\", \"rating\": 9.5},\n  {\"id\": 702187, \"suggestedTranslation\": \"Tôi có cảm giác như ai đó đang theo dõi mình.\", \"rating\": 9.5},\n  {\"id\": 702188, \"suggestedTranslation\": \"Cây ơi, cậu vẫn đói à?\", \"rating\": 9.5},\n  {\"id\": 702189, \"suggestedTranslation\": \"Tôi không thể mang thêm món nào nữa rồi!\", \"rating\": 9.5},\n  {\"id\": 702190, \"suggestedTranslation\": \"Chúc mừng Lễ hội Mùa Đông!\", \"rating\": 9.5},\n  {\"id\": 702191, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wormwood\", \"rating\": 10.0},\n  {\"id\": 702192, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wurt\", \"rating\": 10.0},\n  {\"id\": 702193, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wurt\", \"rating\": 10.0},\n  {\"id\": 702194, \"suggestedTranslation\": \"Biết ngay là có đứa đang trốn quanh đây mà!\", \"rating\": 9.0},\n  {\"id\": 702195, \"suggestedTranslation\": \"Tìm thấy cậu rồi!\", \"rating\": 9.5},\n  {\"id\": 702196, \"suggestedTranslation\": \"Cậu đây rồi.\", \"rating\": 9.5},\n  {\"id\": 702197, \"suggestedTranslation\": \"Tao biết mày trốn ở đấy mà!\", \"rating\": 9.0},\n  {\"id\": 702198, \"suggestedTranslation\": \"Thấy cậu rồi nhé!\", \"rating\": 9.5},\n  {\"id\": 702199, \"suggestedTranslation\": \"Tìm được đứa cuối cùng rồi!\", \"rating\": 9.5},\n  {\"id\": 702200, \"suggestedTranslation\": \"{name} đã tìm thấy người cuối cùng!\", \"rating\": 9.5},\n  {\"id\": 702201, \"suggestedTranslation\": \"Giờ thì đứa cuối cùng trốn ở đâu rồi nhỉ?\", \"rating\": 9.5},\n  {\"id\": 702202, \"suggestedTranslation\": \"Chắc chúng không muốn chơi nữa rồi...\", \"rating\": 9.5},\n  {\"id\": 702203, \"suggestedTranslation\": \"Mấy đứa nhỏ này chắc sắp hết kiên nhẫn rồi đây...\", \"rating\": 9.0},\n  {\"id\": 702204, \"suggestedTranslation\": \"Chắc chúng không trốn xa thế này đâu nhỉ?\", \"rating\": 9.5},\n  {\"id\": 702205, \"suggestedTranslation\": \"Mấy chú kitcoon hẳn phải ở quanh đây thôi.\", \"rating\": 9.5},\n  {\"id\": 702206, \"suggestedTranslation\": \"Ôi, chúng đang chơi trốn tìm kìa.\", \"rating\": 9.5},\n  {\"id\": 702207, \"suggestedTranslation\": \"3, 2, 1... Trốn hay không, ta tới đây!\", \"rating\": 9.0},\n  {\"id\": 702208, \"suggestedTranslation\": \"Nó vừa gọi cứu trợ!\", \"rating\": 9.0},\n  {\"id\": 702209, \"suggestedTranslation\": \"Giờ thì làm sao mà thắng nổi nữa chứ!!\", \"rating\": 9.0},\n  {\"id\": 702210, \"suggestedTranslation\": \"Xiềng xích của nó đã đứt rồi!\", \"rating\": 9.5},\n  {\"id\": 702211, \"suggestedTranslation\": \"Úi chà, đầu tôi!\", \"rating\": 9.0},\n  {\"id\": 702212, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_willow\", \"rating\": 10.0},\n  {\"id\": 702213, \"suggestedTranslation\": \"Thoát khỏi tia sét đáng sợ đó rồi!\", \"rating\": 9.5},\n  {\"id\": 702214, \"suggestedTranslation\": \"Khoan đã, cái quái gì dưới này thế này?\", \"rating\": 9.0},\n  {\"id\": 702215, \"suggestedTranslation\": \"Tôi chẳng học hỏi được mấy từ đó.\", \"rating\": 9.0},\n  {\"id\": 702216, \"suggestedTranslation\": \"Nó quay lại rồi!\", \"rating\": 9.5},\n  {\"id\": 702217, \"suggestedTranslation\": \"Chúng rơi xuống như mưa chim vậy.\", \"rating\": 9.0},\n  {\"id\": 702218, \"suggestedTranslation\": \"Hóa ra đây là tiếng kêu của cả một bầy quạ.\", \"rating\": 9.0},\n  {\"id\": 702219, \"suggestedTranslation\": \"Ánh chớp đó! Có phải ánh trăng không vậy?\", \"rating\": 9.5},\n  {\"id\": 702220, \"suggestedTranslation\": \"Hừm, chắc là hợp lý khi tô