8,\"suggestedTranslation\":\"Suko\",\"rating\":9.0},\n  {\"id\":701599,\"suggestedTranslation\":\"Thumbelina\",\"rating\":9.0},\n  {\"id\":701600,\"suggestedTranslation\":\"Celeriac\",\"rating\":9.0},\n  {\"id\":701601,\"suggestedTranslation\":\"Topweight\",\"rating\":9.0},\n  {\"id\":701602,\"suggestedTranslation\":\"Touchon\",\"rating\":9.0},\n  {\"id\":701603,\"suggestedTranslation\":\"Uchon\",\"rating\":9.0},\n  {\"id\":701604,\"suggestedTranslation\":\"Valery\",\"rating\":9.0},\n  {\"id\":701605,\"suggestedTranslation\":\"Vàng\",\"rating\":9.0},\n  {\"id\":701606,\"suggestedTranslation\":\"Zino\",\"rating\":9.0},\n  {\"id\":701607,\"suggestedTranslation\":\"Scandius\",\"rating\":9.0},\n  {\"id\":701608,\"suggestedTranslation\":\"Yttria\",\"rating\":9.0},\n  {\"id\":701609,\"suggestedTranslation\":\"Lanthan\",\"rating\":9.0},\n  {\"id\":701610,\"suggestedTranslation\":\"Cerium\",\"rating\":9.0},\n  {\"id\":701611,\"suggestedTranslation\":\"Daikon\",\"rating\":9.0},\n  {\"id\":701612,\"suggestedTranslation\":\"Praseodymia\",\"rating\":9.0},\n  {\"id\":701613,\"suggestedTranslation\":\"Neodymia\",\"rating\":9.0},\n  {\"id\":701614,\"suggestedTranslation\":\"Promethia\",\"rating\":9.0},\n  {\"id\":701615,\"suggestedTranslation\":\"Samari\",\"rating\":9.0},\n  {\"id\":701616,\"suggestedTranslation\":\"Europia\",\"rating\":9.0},\n  {\"id\":701617,\"suggestedTranslation\":\"Gadolin\",\"rating\":9.0},\n  {\"id\":701618,\"suggestedTranslation\":\"Terbia\",\"rating\":9.0},\n  {\"id\":701619,\"suggestedTranslation\":\"Dyspros\",\"rating\":9.0},\n  {\"id\":701620,\"suggestedTranslation\":\"Holmia\",\"rating\":9.0},\n  {\"id\":701621,\"suggestedTranslation\":\"Erbium\",\"rating\":9.0},\n  {\"id\":701622,\"suggestedTranslation\":\"Lepidium\",\"rating\":9.0},\n  {\"id\":701623,\"suggestedTranslation\":\"Thulium\",\"rating\":9.0},\n  {\"id\":701624,\"suggestedTranslation\":\"Ytterbia\",\"rating\":9.0},\n  {\"id\":701625,\"suggestedTranslation\":\"Lutetium\",\"rating\":9.0},\n  {\"id\":701626,\"suggestedTranslation\":\"Microseris\",\"rating\":9.0},\n  {\"id\":701627,\"suggestedTranslation\":\"Parsnip\",\"rating\":9.0},\n  {\"id\":701628,\"suggestedTranslation\":\"Cậu đưa cái này cho mình thật á? Cảm ơn nhé!\",\"rating\":9.5},\n  {\"id\":701629,\"suggestedTranslation\":\"Chà, mình còn chẳng phải đi trộm nữa—Ý mình là, cảm ơn nhé!\",\"rating\":9.5},\n  {\"id\":701630,\"suggestedTranslation\":\"Ở đây cứ tự nhiên tặng đồ cho người khác thế à? Hay thật đấy!\",\"rating\":9.5},\n  {\"id\":701631,\"suggestedTranslation\":\"Cậu có nghe thấy tiếng gì không?\\nCậu nghĩ tụi mình không bị bám đuôi đấy chứ?\",\"rating\":9.5},\n  {\"id\":701632,\"suggestedTranslation\":\"Ở đây ấm cúng thật đấy.\",\"rating\":9.5},\n  {\"id\":701633,\"suggestedTranslation\":\"Được sưởi ấm móng vuốt bên đống lửa thật là dễ chịu.\",\"rating\":9.5},\n  {\"id\":701634,\"suggestedTranslation\":\"Có một vụ án mạng bí ẩn vừa xảy ra ở đây...\\nVà hy vọng là năm sau tụi mình lại được quay lại đây lần nữa! Quạ quạ quạ!\",\"rating\":9.5},\n  {\"id\":701635,\"suggestedTranslation\":\"Không biết sao mấy sinh vật không có lông lại sợ bóng tối thế nhỉ?\",\"rating\":9.5},\n  {\"id\":701636,\"suggestedTranslation\":\"Có ai mang theo chút ngô không vậy?\",\"rating\":9.5},\n  {\"id\":701637,\"suggestedTranslation\":\"Ồ! Không khí lễ hội quá đi!\",\"rating\":9.5},\n  {\"id\":701638,\"suggestedTranslation\":\"Lễ Hội Quạ tuyệt nhất từ trước đến nay!\",\"rating\":9.5},\n  {\"id\":701639,\"suggestedTranslation\":\"Lễ Hội Quạ năm ngoái làm không được hoành tráng thế này đâu.\",\"rating\":9.5},\n  {\"id\":701640,\"suggestedTranslation\":\"Mình muốn xem mấy trò chơi quá!\",\"rating\":9.5},\n  {\"id\":701641,\"suggestedTranslation\":\"Cậu ghé qua Gian hàng giải thưởng chưa thế?\",\"rating\":9.5},\n  {\"id\":701642,\"suggestedTranslation\":\"Nếu ăn nữa chắc bụng mình nổ tung mất.\\nỪm, nổ... bỏng ngô... mmmmmm...\",\"rating\":9.5},\n  {\"id\":701643,\"suggestedTranslation\":\"Cậu có nghĩ họ đang cố vỗ béo tụi mình rồi ăn thịt không?\\nKhông đâu... trông họ có vẻ không thông minh đến thế.\",\"rating\":9.5},\n  {\"id\":701644,\"suggestedTranslation\":\"Tụi mình thật may mắn khi Corvus tìm ra nơi này.\",\"rating\":9.5},\n  {\"id\":701645,\"suggestedTranslation\":\"Chắc họ vẫn đang dựng gian hàng thôi.\",\"rating\":9.5},\n  {\"id\":701646,\"suggestedTranslation\":\"Bữa tiệc ở đâu rồi nhỉ?\",\"rating\":9.5},\n  {\"id\":701647,\"suggestedTranslation\":\"Lễ Hội Hạ Chí chán ngắt nhất từ trước đến nay.\",\"rating\":9.5},\n  {\"id\":701648,\"suggestedTranslation\":\"Đúng hơn phải là Chán-vial.\",\"rating\":9.0},\n  {\"id\":701649,\"suggestedTranslation\":\"Có vẻ như mình đến hơi sớm thì phải...\",\"rating\":9.5},\n  {\"id\":701650,\"suggestedTranslation\":\"Chắc mình phải bảo bạn bè đợi bao giờ dựng xong hẳn hẵng ra.\",\"rating\":9.0},\n  {\"id\":701651,\"suggestedTranslation\":\"Không khí Lễ Hội Quạ náo nhiệt này làm mình đói bụng quá rồi.\",\"rating\":9.5},\n  {\"id\":701652,\"suggestedTranslation\":\"Mấy món ăn vặt kia trông ngon thế...\\nChắc họ không phiền nếu mình lén cắn một miếng đâu nhỉ...\",\"rating\":9.5},\n  {\"id\":701653,\"suggestedTranslation\":\"Sau chuyến đi dài đằng đẵng, mình đói lả cả người rồi.\",\"rating\":9.5},\n  {\"id\":701654,\"suggestedTranslation\":\"Trang trí được phết chứ lị.\",\"rating\":9.0},\n  {\"id\":701655,\"suggestedTranslation\":\"Cũng tạm ổn... nhưng ước gì có thêm chút điểm nhấn.\",\"rating\":9.5},\n  {\"id\":701656,\"suggestedTranslation\":\"Mình từng thấy nhiều Lễ Hội Quạ hay hơn thế này.\",\"rating\":9.5},\n  {\"id\":701657,\"suggestedTranslation\":\"Bữa tiệc chỉ mới bắt đầu thôi đấy!\",\"rating\":9.5},\n  {\"id\":701658,\"suggestedTranslation\":\"Đúng là một nơi tuyệt vời, chẳng có ai đuổi tụi mình đi cả!\",\"rating\":9.5},\n  {\"id\":701659,\"suggestedTranslation\":\"Ai có bộ lông đỏ đằng kia thế nhỉ? Trông cứ quen quen.\",\"rating\":9.5},\n  {\"id\":701660,\"suggestedTranslation\":\"Hy vọng năm sau tụi mình lại được tổ chức Lễ Hội Quạ ở đây.\",\"rating\":9.5},\n  {\"id\":701661,\"suggestedTranslation\":\"Ồ! Không khí lễ hội quá đi!\",\"rating\":9.5},\n  {\"id\":701662,\"suggestedTranslation\":\"Làm tốt lắm.\",\"rating\":9.5},\n  {\"id\":701663,\"suggestedTranslation\":\"Chắc cậu phải giỏi mấy trò chơi này lắm nhỉ.\",\"rating\":9.5},\n  {\"id\":701664,\"suggestedTranslation\":\"Cậu đã thử chơi Tranh Giành Trứng chưa? Đó là trò khoái khẩu của mình đấy!\",\"rating\":9.5},\n  {\"id\":701665,\"suggestedTranslation\":\"Mình vừa xem có người chơi Tiếng Kêu Đòi Sâu, nhìn xong thấy đói bụng ghê...\",\"rating\":9.5},\n  {\"id\":701666,\"suggestedTranslation\":\"Cậu đã giật được món giải thưởng nào chưa?\",\"rating\":9.5},\n  {\"id\":701667,\"suggestedTranslation\":\"Được nghỉ ngơi đôi cánh chút xíu thế này thích thật.\\nTụi mình hiếm khi được ở yên một chỗ quá lâu lắm.\",\"rating\":9.5},\n  {\"id\":701668,\"suggestedTranslation\":\"Cậu đã thấy người phụ nữ đứng ngắm Lễ Hội Quạ lúc đêm hôm chưa?\\nNghe cứ rợn cả người.\",\"rating\":9.5},\n  {\"id\":701669,\"suggestedTranslation\":\"Cậu chơi có vui không? Mình thì vui hết nấc luôn!\",\"rating\":9.5},\n  {\"id\":701670,\"suggestedTranslation\":\"Cậu nên trang trí thêm đi chứ.\",\"rating\":9.5},\n  {\"id\":701671,\"suggestedTranslation\":\"Đồ trang trí để đâu hết cả rồi nhỉ?\",\"rating\":9.5},\n  {\"id\":701672,\"suggestedTranslation\":\"Thiếu đồ trang trí quanh Cây Kỷ Niệm thì sao gọi là Lễ Hội Quạ được!\",\"rating\":9.5},\n  {\"id\":701673,\"suggestedTranslation\":\"Đây chắc là Lễ Hội Quạ đầu tiên cậu tham gia rồi.\",\"rating\":9.5},\n  {\"id\":701674,\"suggestedTranslation\":\"Này, có định chia sẻ đồ ăn vặt cho mình không đấy?\",\"rating\":9.5},\n  {\"id\":701675,\"suggestedTranslation\":\"Tụi mình từ đâu đến á? Ồ, cậu biết đấy, chỗ này chỗ kia ấy mà...\",\"rating\":9.5},\n  {\"id\":701676,\"suggestedTranslation\":\"Cậu cứ ở lì đây suốt cả năm luôn á?\\nChà, không có cánh chắc là chật vật lắm nhỉ.\",\"rating\":9.5},\n  {\"id\":701677,\"suggestedTranslation\":\"Cậu làm tốt phết đấy chứ.\",\"rating\":9.5},\n  {\"id\":701678,\"suggestedTranslation\":\"Mình ước gì xung quanh Cây Kỷ Niệm có thêm nhiều đồ trang trí hơn...\",\"rating\":9.5},\n  {\"id\":701679,\"suggestedTranslation\":\"Mình từng thấy Lễ Hội Quạ hoành tráng hơn. Chỉ góp ý thế thôi.\",\"rating\":9.5},\n  {\"id\":701680,\"suggestedTranslation\":\"Phải công nhận là Lễ Hội Quạ năm ngoái đỉnh hơn...\",\"rating\":9.5},\n  {\"id\":701681,\"suggestedTranslation\":\"Thế CẬU từ đâu đến thế? Chỉ tò mò chút thôi!\",\"rating\":9.5},\n  {\"id\":701682,\"suggestedTranslation\":\"Không thể tin nổi là cậu chưa từng thấy Lễ Hội Quạ trước khi tụi mình đến đấy!\\nĐúng là bỏ lỡ khối thứ hay ho rồi.\",\"rating\":9.5},\n  {\"id\":701683,\"suggestedTranslation\":\"Cậu lạ lùng thật đấy. Đã ai nói với cậu điều này chưa?\",\"rating\":9.5},\n  {\"id\":701684,\"suggestedTranslation\":\"Ô kìa có người đang chơi kìa!\",\"rating\":9.5},\n  {\"id\":701685,\"suggestedTranslation\":\"Cùng xem sinh vật không lông này chơi nào!\",\"rating\":9.5},\n  {\"id\":701686,\"suggestedTranslation\":\"Nhìn kìa, có người sắp chơi kìa!\",\"rating\":9.5},\n  {\"id\":701687,\"suggestedTranslation\":\"Mình thích xem mấy trò này lắm!\",\"rating\":9.5},\n  {\"id\":701688,\"suggestedTranslation\":\"Ôi, trò đấy là tủ của mình đấy!\",\"rating\":9.5},\n  {\"id\":701689,\"suggestedTranslation\":\"Sao lại lắm quà thế này? Bắt đầu thấy đáng nghi rồi đấy...\",\"rating\":9.5},\n  {\"id\":701690,\"suggestedTranslation\":\"Cảm ơn nhé, nhưng mình có món này rồi!\",\"rating\":9.5},\n  {\"id\":701691,\"suggestedTranslation\":\"Xin lỗi, mình bận rồi. Cậu đưa người khác đi.\",\"rating\":9.5},\n  {\"id\":701692,\"suggestedTranslation\":\"Đây là thể loại trò chơi gì thế nhỉ?\",\"rating\":9.5},\n  {\"id\":701693,\"suggestedTranslation\":\"Mấy sinh vật không lông đang đánh nhau à? Mình muốn xem!\",\"rating\":9.5},\n  {\"id\":701694,\"suggestedTranslation\":\"Ồ... chà... ừm, thôi không cần đâu, cậu cứ giữ lấy đi.\",\"rating\":9.5},\n  {\"id\":701695,\"suggestedTranslation\":\"Úi, chắc cậu không biết đâu, chứ mình thực sự bị dị ứng với đúng thứ đấy đấy.\",\"rating\":9.5},\n  {\"id\":701696,\"suggestedTranslation\":\"Thôi cảm ơn, mình không cần đâu.\",\"rating\":9.5},\n  {\"id\":701697,\"suggestedTranslation\":\"Quạ!\",\"rating\":9.5},\n  {\"id\":701698,\"suggestedTranslation\":\"Lên đường thôi!\",\"rating\":9.5},\n  {\"id\":701699,\"suggestedTranslation\":\"Lông vũ bay tứ tung rồi!\",\"rating\":9.5},\n  {\"id\":701700,\"suggestedTranslation\":\"Không, cảm ơn!\",\"rating\":9.5},\n  {\"id\":701701,\"suggestedTranslation\":\"Mình lượn đây!\",\"rating\":9.5},\n  {\"id\":701702,\"suggestedTranslation\":\"Tản ra mau!!\",\"rating\":9.5},\n  {\"id\":701703,\"suggestedTranslation\":\"Đúng vậy, đúng vậy! Lại đến cái thời điểm tuyệt vời nhất trong năm rồi đây!\",\"rating\":9.5},\n  {\"id\":701704,\"suggestedTranslation\":\"Ta, Chymgià vĩ đại, đã rộng lượng quyết định quay trở lại cùng Lễ Hội Quạ kỳ diệu của mình!\",\"rating\":9.5},\n  {\"id\":701705,\"suggestedTranslation\":\"Này cậu kia! Cậu có muốn trở thành một phần của thứ gì đó hoành tráng không hả?!\",\"rating\":9.5},\n  {\"id\":701706,\"suggestedTranslation\":\"Chính là ta đây, một kẻ lang thang vui vẻ với bộ lông đen tựa màn đêm!\",\"rating\":9.5},\n  {\"id\":701707,\"suggestedTranslation\":\"Ta được biết đến với rất nhiều danh hiệu, nhưng cứ gọi ta là Corvus Chymgià!\",\"rating\":9.5},\n  {\"id\":701708,\"suggestedTranslation\":\"\\\"Chưa đến giữa hè\\\" á, cậu nói gì thế? Này bạn tôi ơi, trâu chậm thì uống nước đục thôi!\",\"rating\":9.5},\n  {\"id\":701709,\"suggestedTranslation\":\"Ôi bạn tôi ơi, thật là may mắn làm sao khi nơi này lại là điểm dừng chân trong chuyến bay lãng mạn của tụi ta!\",\"rating\":9.5},\n  {\"id\":701710,\"suggestedTranslation\":\"Hãy vui lên nào, vì lão Chymgià đáng mến đã quay lại cùng Lễ Hội Quạ hoành tráng của lão đây!\",\"rating\":9.5},\n  {\"id\":701711,\"suggestedTranslation\":\"Năm ngoái mang lại lợi nhuận quá lớn... à nhầm, VUI quá, nên tụi ta không thể không quay lại!\",\"rating\":9.5},\n  {\"id\":701712,\"suggestedTranslation\":\"Lễ Hội Quạ đang diễn ra tưng bừng rồi kìa!\",\"rating\":9.5},\n  {\"id\":701713,\"suggestedTranslation\":\"Chào mừng, chào mừng tất cả mọi người!\",\"rating\":9.5},\n  {\"id\":701714,\"suggestedTranslation\":\"Mua xu ở đây này các bác ơi!\",\"rating\":9.5},\n  {\"id\":701715,\"suggestedTranslation\":\"Hãy tận hưởng Lễ Hội Quạ nhé!\",\"rating\":9.5},\n  {\"id\":701716,\"suggestedTranslation\":\"Sao không tậu một mô hình thu nhỏ xinh xắn để đặt dưới Cây nhỉ?\",\"rating\":9.5},\n  {\"id\":701717,\"suggestedTranslation\":\"Mấy trò chơi trông hấp dẫn quá phải không? Sao không mua một vốc xu liền tay nào?\",\"rating\":9.5},\n  {\"id\":701718,\"suggestedTranslation\":\"Giành vé đi, rồi đổi vé lấy những phần quà cực khủng nào!\",\"rating\":9.5},\n  {\"id\":701719,\"suggestedTranslation\":\"Hãy ghé qua Gian hàng giải thưởng đi các bạn ơi! Bọn ta có vô số món đồ độc lạ từ khắp muôn phương đấy!\",\"rating\":9.5},\n  {\"id\":701720,\"suggestedTranslation\":\"\\\"Chưa đến giữa hè\\\" á, cậu nói gì thế? Này bạn tôi ơi, trâu chậm thì uống nước đục thôi!\",\"rating\":9.5},\n  {\"id\":701721,\"suggestedTranslation\":\"Ồ, suýt chút nữa là cậu ghi được điểm rồi đấy!\",\"rating\":9.5},\n  {\"id\":701722,\"suggestedTranslation\":\"Cậu chưa từng chơi trò chơi nào của Lễ Hội Quạ bao giờ à?\",\"rating\":9.5},\n  {\"id\":701723,\"suggestedTranslation\":\"Chắc lần tới may mắn hơn sẽ mỉm cười với cậu nhỉ?\",\"rating\":9.5},\n  {\"id\":701724,\"suggestedTranslation\":\"Đúng rồi, đúng rồi! Cậu có năng khiếu thiên bẩm đấy!\",\"rating\":9.5},\n  {\"id\":701725,\"suggestedTranslation\":\"Xem ra cậu nắm bắt luật chơi rất nhanh đấy chứ!\",\"rating\":9.5},\n  {\"id\":701726,\"suggestedTranslation\":\"Màn thể hiện quá xuất sắc! Hy vọng cậu sẽ mua thêm xu để tiếp tục biểu diễn cho tụi ta xem nhé!\",\"rating\":9.5},\n  {\"id\":701727,\"suggestedTranslation\":\"Tiếc quá nhỉ. Chúc cậu may mắn lần sau!\",\"rating\":9.5},\n  {\"id\":701728,\"suggestedTranslation\":\"Ta vẫn còn rất nhiều xu để bán nếu cậu muốn thử lại đấy!\",\"rating\":9.5},\n  {\"id\":701729,\"suggestedTranslation\":\"Làm tốt lắm, làm tốt lắm! Giờ thì sao không ghé qua Gian hàng giải thưởng của tụi ta nhỉ?\",\"rating\":9.5},\n  {\"id\":701730,\"suggestedTranslation\":\"Thật là một màn trình diễn kinh ngạc! Nào, để lão Corvus Chymgià tặng cậu thêm một vé thưởng nhé.\",\"rating\":9.5},\n  {\"id\":701731,\"suggestedTranslation\":\"Đây là trò gì thế này?\",\"rating\":9.5},\n  {\"id\":701732,\"suggestedTranslation\":\"Quái lạ thật. Chẳng vui bằng mấy trò tụi ta có ở Lễ Hội Quạ gì cả!\",\"rating\":9.5},\n  {\"id\":701733,\"suggestedTranslation\":\"Ta không rõ luật chơi cho lắm...\",\"rating\":9.5},\n  {\"id\":701734,\"suggestedTranslation\":\"Nhìn đây này, ta có bao nhiêu trò chơi thú vị đang chờ cậu thưởng thức đấy!\",\"rating\":9.5},\n  {\"id\":701735,\"suggestedTranslation\":\"Lễ Hội Quạ sẽ không thể trọn vẹn nếu thiếu đi những trò chơi vui nhộn.\",\"rating\":9.5},\n  {\"id\":701736,\"suggestedTranslation\":\"Được rồi, được rồi! Phải đặt linh hồn của buổi lễ vào giữa chứ!\",\"rating\":9.5},\n  {\"id\":701737,\"suggestedTranslation\":\"Lễ Hội Quạ chưa thể bắt đầu cho đến khi Cây được trồng xuống!\",\"rating\":9.5},\n  {\"id\":701738,\"suggestedTranslation\":\"Thợ Chế Tạo\",\"rating\":9.5},\n  {\"id\":701739,\"suggestedTranslation\":\"Thợ Rèn\",\"rating\":9.5},\n  {\"id\":701740,\"suggestedTranslation\":\"Búp Bê\",\"rating\":9.5},\n  {\"id\":701741,\"suggestedTranslation\":\"Con Búp Bê Bị Hỏng\",\"rating\":9.5},\n  {\"id\":701742,\"suggestedTranslation\":\"Con Búp Bê Vỡ Nát\",\"rating\":9.5},\n  {\"id\":701743,\"suggestedTranslation\":\"Cánh Côn Trùng\",\"rating\":9.5},\n  {\"id\":701744,\"suggestedTranslation\":\"Kẻ Ngốc\",\"rating\":9.5},\n  {\"id\":701745,\"suggestedTranslation\":\"Kẻ Khờ Khạo\",\"rating\":9.5},\n  {\"id\":701746,\"suggestedTranslation\":\"Đức Vua\",\"rating\":9.5},\n  {\"id\":701747,\"suggestedTranslation\":\"Tấm Gương\",\"rating\":9.5},\n  {\"id\":701748,\"suggestedTranslation\":\"Nàng Công Chúa\",\"rating\":9.5},\n  {\"id\":701749,\"suggestedTranslation\":\"Bậc Nữ Vương\",\"rating\":9.5},\n  {\"id\":701750,\"suggestedTranslation\":\"Bậc Hiền Triết\",\"rating\":9.5},\n  {\"id\":701751,\"suggestedTranslation\":\"Kẻ Nịnh Hót\",\"rating\":9.5},\n  {\"id\":701752,\"suggestedTranslation\":\"Cây Cổ Thụ\",\"rating\":9.5},\n  {\"id\":701753,\"suggestedTranslation\":\"Nhà Ảo Thuật\",\"rating\":9.5},\n  {\"id\":701754,\"suggestedTranslation\":\"Hắn có quanh đâu đây thôi.\",\"rating\":9.5},\n  {\"id\":701755,\"suggestedTranslation\":\"Xém chết, cứ tưởng trong đó có món gì ngon chứ!\",\"rating\":9.5},\n  {\"id\":701756,\"suggestedTranslation\":\"chỉ_được_sử_dụng_bởi_wurt\",\"rating\":10.0},\n  {\"id\":701757,\"suggestedTranslation\":\"Trông anh ta có vẻ đang bận bịu việc gì đó lúc này.\",\"rating\":9.5},\n  {\"id\":701758,\"suggestedTranslation\":\"Dễ quá nhỉ, giá như có thêm mấy đứa nhỏ này tham gia...\",\"rating\":9.5},\n  {\"id\":701759,\"suggestedTranslation\":\"Xung quanh chẳng có mấy chỗ thích hợp để tụi nó trốn cả.\",\"rating\":9.5},\n  {\"id\":701760,\"suggestedTranslation\":\"Mình nghĩ chơi thế là đủ cho một ngày rồi.\",\"rating\":9.5},\n  {\"id\":701761,\"suggestedTranslation\":\"Cổng đã bị khóa rồi.\",\"rating\":9.5},\n  {\"id\":701762,\"suggestedTranslation\":\"Mình không nghĩ anh ta mặc được món này đâu.\",\"rating\":9.5},\n  {\"id\":701763,\"suggestedTranslation\":\"Có vẻ như đám chim đó bay đi mất tiêu rồi.\",\"rating\":9.5},\n  {\"id\":701764,\"suggestedTranslation\":\"chỉ_được_sử_dụng_bởi_wurt\",\"rating\":10.0}\n]",
