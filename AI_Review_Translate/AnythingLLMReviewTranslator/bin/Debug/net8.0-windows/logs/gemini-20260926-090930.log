slation\":\"chỉ_được_sử_dụng_bởi_walter\",\"rating\":10.0},\n  {\"id\":702365,\"suggestedTranslation\":\"Lớn lên nào thực vật, lớn lên đi!\",\"rating\":8.5},\n  {\"id\":702366,\"suggestedTranslation\":\"Tôi vẫn luôn ao ước có một loại thực vật như bạn.\",\"rating\":9.0},\n  {\"id\":702367,\"suggestedTranslation\":\"Chào thực vật, tôi đến đây để trò chuyện với bạn mỗi ngày đây!\",\"rating\":8.5},\n  {\"id\":702368,\"suggestedTranslation\":\"Bạn là một loại thực vật dễ thương làm sao.\",\"rating\":8.5},\n  {\"id\":702369,\"suggestedTranslation\":\"Thực vật ơi, bạn là một người lắng nghe tuyệt vời đấy.\",\"rating\":8.5},\n  {\"id\":702370,\"suggestedTranslation\":\"Ái!\",\"rating\":9.0},\n  {\"id\":702371,\"suggestedTranslation\":\"Bình xông hương đã cạn kiệt rồi.\",\"rating\":8.5},\n  {\"id\":702372,\"suggestedTranslation\":\"Tôi sẽ tự mình tìm mấy đứa nhỏ đó vậy.\",\"rating\":8.5},\n  {\"id\":702373,\"suggestedTranslation\":\"Tội nghiệp ghê... Mà nãy nó dẫn mình đi đâu nhỉ?\",\"rating\":8.5},\n  {\"id\":702374,\"suggestedTranslation\":\"Nó rất muốn mình đi theo đấy.\",\"rating\":8.5},\n  {\"id\":702375,\"suggestedTranslation\":\"Có vẻ ai đó đã tìm thấy thứ nó đang tìm rồi.\",\"rating\":8.5},\n  {\"id\":702376,\"suggestedTranslation\":\"Nó chắc hẳn vừa tìm thấy gì đó rồi!\",\"rating\":8.5},\n  {\"id\":702377,\"suggestedTranslation\":\"Có vẻ như nó chẳng tìm thấy gì cả.\",\"rating\":8.5},\n  {\"id\":702378,\"suggestedTranslation\":\"Nó ngửi thấy mùi rồi!\",\"rating\":8.5},\n  {\"id\":702379,\"suggestedTranslation\":\"Mình phải đi theo cậu ấy thôi!\",\"rating\":8.5},\n  {\"id\":702380,\"suggestedTranslation\":\"Con cóc đã trốn mất tiêu rồi.\",\"rating\":8.5},\n  {\"id\":702381,\"suggestedTranslation\":\"Con cóc đang dần mất kiên nhẫn rồi.\",\"rating\":8.5},\n  {\"id\":702382,\"suggestedTranslation\":\"Chà, dụng cụ này trơn quá!\",\"rating\":8.5},\n  {\"id\":702383,\"suggestedTranslation\":\"Tôi cần một công cụ mạnh hơn!\",\"rating\":8.5},\n  {\"id\":702384,\"suggestedTranslation\":\"chỉ_được_sử_dụng_bởi_wicker\",\"rating\":10.0},\n  {\"id\":702385,\"suggestedTranslation\":\"Đèn của tôi vừa vụt tắt rồi!\",\"rating\":8.5},\n  {\"id\":702386,\"suggestedTranslation\":\"Tôi không chắc đó là khoa học đâu.\",\"rating\":8.5},\n  {\"id\":702387,\"suggestedTranslation\":\"Ối.\",\"rating\":9.0},\n  {\"id\":702388,\"suggestedTranslation\":\"ÔI! Tôi không nghĩ nó đã sẵn sàng đâu.\",\"rating\":8.5},\n  {\"id\":702389,\"suggestedTranslation\":\"Không còn bóng dáng nghi ngờ gì nữa, chúng đang giúp đỡ đấy!\",\"rating\":8.5},\n  {\"id\":702390,\"suggestedTranslation\":\"Có lẽ có điều gì không ổn ở phía bên kia chăng?\",\"rating\":8.5},\n  {\"id\":702391,\"suggestedTranslation\":\"chỉ_được_sử_dụng_bởi_wanda\",\"rating\":10.0},\n  {\"id\":702392,\"suggestedTranslation\":\"chỉ_được_sử_dụng_bởi_wanda\",\"rating\":10.0},\n  {\"id\":702393,\"suggestedTranslation\":\"chỉ_được_sử_dụng_bởi_wanda\",\"rating\":10.0},\n  {\"id\":702394,\"suggestedTranslation\":\"chỉ_được_sử_dụng_bởi_wanda\",\"rating\":10.0},\n  {\"id\":702395,\"suggestedTranslation\":\"Tôi ướt sũng, nhưng vẫn còn sống.\",\"rating\":8.5},\n  {\"id\":702396,\"suggestedTranslation\":\"chỉ_được_sử_dụng_bởi_wicker\",\"rating\":10.0},\n  {\"id\":702397,\"suggestedTranslation\":\"Cánh Cà Ruột này không đủ điều kiện để huấn luyện đâu.\",\"rating\":8.0},\n  {\"id\":702398,\"suggestedTranslation\":\"Tôi cần thứ gì đó mạnh hơn!\",\"rating\":8.5},\n  {\"id\":702399,\"suggestedTranslation\":\"Cân nặng: {weight}\",\"rating\":10.0},\n  {\"id\":702400,\"suggestedTranslation\":\"Cân nặng: {weight}\\nTôi là một cao thủ câu cá hạng nặng!\",\"rating\":8.5},\n  {\"id\":702401,\"suggestedTranslation\":\"chỉ_được_sử_dụng_bởi_wendy\",\"rating\":10.0},\n  {\"id\":702402,\"suggestedTranslation\":\"chỉ_được_sử_dụng_bởi_wendy\",\"rating\":10.0},\n  {\"id\":702403,\"suggestedTranslation\":\"Quần áo của tôi có vẻ thấm nước rồi.\",\"rating\":8.5},\n  {\"id\":702404,\"suggestedTranslation\":\"Đúng là một cách đi tồi tệ dưới 