g\": 9.0\n  },\n  {\n    \"id\": 706054,\n    \"suggestedTranslation\": \"Biết ngay là tớ sẽ tìm ra cậu mà!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 706055,\n    \"suggestedTranslation\": \"Cậu đây rồi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 706056,\n    \"suggestedTranslation\": \"Tóm được nhé!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 706057,\n    \"suggestedTranslation\": \"Dễ quá đi mất.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 706058,\n    \"suggestedTranslation\": \"Tớ nghĩ là hết rồi đấy!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 706059,\n    \"suggestedTranslation\": \"Làm tốt lắm {name}, tớ nghĩ đó là đứa cuối cùng đấy!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 706060,\n    \"suggestedTranslation\": \"Chắc vẫn còn một đứa đang trốn đâu đây...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 706061,\n    \"suggestedTranslation\": \"Khỉ thật, chúng trốn kỹ quá!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 706062,\n    \"suggestedTranslation\": \"Á chà, hình như sắp hết giờ rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 706063,\n    \"suggestedTranslation\": \"Tớ không nghĩ chúng lại trốn ra tận ngoài này đâu.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 706064,\n    \"suggestedTranslation\": \"Tớ nghĩ chúng ta đang tiến gần hơn rồi đấy, Woby!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 706065,\n    \"suggestedTranslation\": \"Tớ chơi cùng được chứ? Ờ... ý tớ là, dùng chuyên môn dò dấu vết Hướng đạo sinh ấy?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 706066,\n    \"suggestedTranslation\": \"Được rồi, tớ đang nhắm mắt lại! Ba... hai... một...!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 706067,\n    \"suggestedTranslation\": \"Nó đang gọi thêm quái vật kìa! TUYỆT VỜI!!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 706068,\n    \"suggestedTranslation\": \"Hình như chúng ta chọc giận nó rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 706069,\n    \"suggestedTranslation\": \"Biết đâu gỡ bỏ sợi