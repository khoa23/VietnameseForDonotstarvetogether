estedTranslation\": \"Chắc chắn đây là con cuối cùng rồi.\", \"rating\": 9.5},\n  {\"id\": 709895, \"suggestedTranslation\": \"Ồ tốt quá, {name} cuối cùng cũng tìm được con cuối cùng rồi.\", \"rating\": 9.5},\n  {\"id\": 709896, \"suggestedTranslation\": \"Hình như vẫn còn một con nữa chưa tìm thấy thì phải...\", \"rating\": 9.5},\n  {\"id\": 709897, \"suggestedTranslation\": \"Ôi phiền phức thật, tôi không nhanh tay bằng.\", \"rating\": 9.5},\n  {\"id\": 709898, \"suggestedTranslation\": \"Nhanh lên nào, sắp hết thời gian rồi!\", \"rating\": 9.5},\n  {\"id\": 709899, \"suggestedTranslation\": \"Chắc là chúng không đi tận ra đây đâu nhỉ?\", \"rating\": 9.5},\n  {\"id\": 709900, \"suggestedTranslation\": \"Đúng rồi, chỗ này quen hơn, chắc chắn tôi sẽ tìm thấy chúng ở đây!\", \"rating\": 9.5},\n  {\"id\": 709901, \"suggestedTranslation\": \"Có lẽ tôi đủ thời gian chơi một ván nhanh...\", \"rating\": 9.5},\n  {\"id\": 709902, \"suggestedTranslation\": \"Được rồi đi thôi nào, giải quyết nhanh gọn nhé.\", \"rating\": 9.5},\n  {\"id\": 709903, \"suggestedTranslation\": \"Cái loại người như hắn sao lại có bạn bè để gọi đến giúp cơ chứ?\", \"rating\": 9.5},\n  {\"id\": 709904, \"suggestedTranslation\": \"Tôi nghĩ đã đến lúc mình phải chuồn rồi!\", \"rating\": 9.5},\n  {\"id\": 709905, \"suggestedTranslation\": \"Cái này không ổn chút nào...\", \"rating\": 9.5},\n  {\"id\": 709906, \"suggestedTranslation\": \"Tôi bất tỉnh bao lâu rồi? Đã mất bao nhiêu thời gian rồi cơ chứ?!\", \"rating\": 9.5},\n  {\"id\": 709907, \"suggestedTranslation\": \"Suýt nữa thì bị sét đánh trúng!\", \"rating\": 9.5},\n  {\"id\": 709908, \"suggestedTranslation\": \"Lạ thật. Ngươi không thuộc về dưới này.\", \"rating\": 9.5},\n  {\"id\": 709909, \"suggestedTranslation\": \"Chà, tôi cũng học thêm được chút ít, nhưng không nhiều lắm.\", \"rating\": 9.5},\n  {\"id\": 709910, \"suggestedTranslation\": \"Đến đúng lúc thật.\", \"rating\": 9.5},\n  {\"id\": 709911, \"suggestedTranslation\": \"Chúng chẳng có