.5},\n  {\"id\": 707560, \"suggestedTranslation\": \"Nó mang ánh nhìn đậm chất khoa học.\", \"rating\": 9.5},\n  {\"id\": 707561, \"suggestedTranslation\": \"Những chiếc lông xù xì đó khiến tớ chỉ muốn chạy trốn!\", \"rating\": 9.5},\n  {\"id\": 707562, \"suggestedTranslation\": \"Nó có mùi giống diêm sinh.\", \"rating\": 9.5},\n  {\"id\": 707563, \"suggestedTranslation\": \"Bông hoa tương tác rất tốt với ma thuật hồi máu.\", \"rating\": 9.5},\n  {\"id\": 707564, \"suggestedTranslation\": \"Vòng hoa này sẽ hồi phục lại một phần sức sống cho tớ.\", \"rating\": 9.5},\n  {\"id\": 707565, \"suggestedTranslation\": \"Một dụng cụ trông có vẻ bén.\", \"rating\": 9.5},\n  {\"id\": 707566, \"suggestedTranslation\": \"Nó cần một chiếc chìa khóa.\", \"rating\": 9.5},\n  {\"id\": 707567, \"suggestedTranslation\": \"Thế là được rồi.\", \"rating\": 9.5},\n  {\"id\": 707568, \"suggestedTranslation\": \"Các đòn đánh của tớ sẽ đau hơn một chút khi mặc món đó.\", \"rating\": 9.5},\n  {\"id\": 707569, \"suggestedTranslation\": \"Vũ khí đó dùng để ném.\", \"rating\": 9.5},\n  {\"id\": 707570, \"suggestedTranslation\": \"Đó là cách chúng ta đến đây. Hi vọng cũng là cách để về.\", \"rating\": 9.5},\n  {\"id\": 707571, \"suggestedTranslation\": \"Tớ đi đây.\", \"rating\": 9.5},\n  {\"id\": 707572, \"suggestedTranslation\": \"Những viên pha lê đó sẽ làm năng lực của tớ nhanh hơn.\", \"rating\": 9.5},\n  {\"id\": 707573, \"suggestedTranslation\": \"Đây là nơi lũ kẻ địch đó xuất hiện.\", \"rating\": 9.5},\n  {\"id\": 707574, \"suggestedTranslation\": \"Trông nó có vẻ tung ra những đòn cực kỳ nặng đô.\", \"rating\": 9.5},\n  {\"id\": 707575, \"suggestedTranslation\": \"Có vẻ nó khuếch đại kỹ năng hồi máu.\", \"rating\": 9.5},\n  {\"id\": 707576, \"suggestedTranslation\": \"Tuyệt vời thật đấy!\", \"rating\": 9.5},\n  {\"id\": 707577, \"suggestedTranslation\": \"Tớ nghĩ nó đang nghỉ ngơi.\", \"rating\": 9.5},\n  {\"id\": 707578, \"suggestedTranslation\": \"Tớ nóng lòng chờ nó nở quá!\", \"ratin