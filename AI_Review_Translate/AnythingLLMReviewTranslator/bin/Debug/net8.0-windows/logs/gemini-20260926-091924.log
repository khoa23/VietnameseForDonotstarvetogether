.5},\n  {\"id\":702969,\"suggestedTranslation\":\"Giờ thì mình có thể cho mọi người xem những gì mình tìm được rồi!\",\"rating\":9.5},\n  {\"id\":702970,\"suggestedTranslation\":\"Một sinh vật nhỏ bé hay đùa nghịch.\",\"rating\":9.5},\n  {\"id\":702971,\"suggestedTranslation\":\"Chủ nhân của nó đã hết mạng rồi.\",\"rating\":9.5},\n  {\"id\":702972,\"suggestedTranslation\":\"Đó là một cái ổ trong gốc cây.\",\"rating\":9.5},\n  {\"id\":702973,\"suggestedTranslation\":\"Mũ tai mèo!\",\"rating\":9.5},\n  {\"id\":702974,\"suggestedTranslation\":\"Chuột có bánh xe, khoa học còn phát minh ra gì nữa đây?\",\"rating\":9.5},\n  {\"id\":702975,\"suggestedTranslation\":\"Tôi nghĩ mình có thể nhấc cái này lên.\",\"rating\":9.5},\n  {\"id\":702976,\"suggestedTranslation\":\"Không với tới được.\",\"rating\":9.5},\n  {\"id\":702977,\"suggestedTranslation\":\"Nó mềm nhũn.\",\"rating\":9.5},\n  {\"id\":702978,\"suggestedTranslation\":\"Tại tôi đâu!\",\"rating\":9.5},\n  {\"id\":702979,\"suggestedTranslation\":\"Ngon quá!\",\"rating\":9.5},\n  {\"id\":702980,\"suggestedTranslation\":\"Quá trình quang hợp của nó thật đáng ngờ.\",\"rating\":9.5},\n  {\"id\":702981,\"suggestedTranslation\":\"Tự hỏi liệu có di chuyển được hòn đá tảng đó không.\",\"rating\":9.5},\n  {\"id\":702982,\"suggestedTranslation\":\"Tôi phải đợi ai đó đi ra rồi mới vào được.\",\"rating\":9.5},\n  {\"id\":702983,\"suggestedTranslation\":\"Chính mặt đất đang hắt hủi tôi!\",\"rating\":9.5},\n  {\"id\":702984,\"suggestedTranslation\":\"Chắc có đủ thứ hay ho để khám phá dưới đó.\",\"rating\":9.5},\n  {\"id\":702985,\"suggestedTranslation\":\"Chắc là đang giấu cái gì đó.\",\"rating\":9.5},\n  {\"id\":702986,\"suggestedTranslation\":\"Trên mặt đất đông đúc quá rồi!\",\"rating\":9.5},\n  {\"id\":702987,\"suggestedTranslation\":\"Chắc tôi cứ ở dưới này luôn vậy.\",\"rating\":9.5},\n  {\"id\":702988,\"suggestedTranslation\":\"Thế là đủ cho sự tò mò rồi.\",\"rating\":9.5},\n  {\"id\":702989,\"suggestedTranslation\":\"Đó là mộ