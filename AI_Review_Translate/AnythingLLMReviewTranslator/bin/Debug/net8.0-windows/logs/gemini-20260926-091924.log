            "text": "[\n  {\"id\":703695,\"suggestedTranslation\":\"Cái quái gì thế kia!\",\"rating\":10.0},\n  {\"id\":703696,\"suggestedTranslation\":\"Trông sang chảnh hơn hẳn một chiếc nhung hươu bình thường.\",\"rating\":8.5},\n  {\"id\":703697,\"suggestedTranslation\":\"Chúng ta nhất định phải mở cái đó.\",\"rating\":9.0},\n  {\"id\":703698,\"suggestedTranslation\":\"Nhìn kìa!\",\"rating\":9.0},\n  {\"id\":703699,\"suggestedTranslation\":\"Đúng là một cơn ác mộng hiệp sĩ!\",\"rating\":9.0},\n  {\"id\":703700,\"suggestedTranslation\":\"Hiệp sĩ tốt!\",\"rating\":9.0},\n  {\"id\":703701,\"suggestedTranslation\":\"Ai là người chỉ huy thế? Bạn có nghe ngóng được gì không?\",\"rating\":9.0},\n  {\"id\":703702,\"suggestedTranslation\":\"Đừng có đùa giỡn nữa!\",\"rating\":9.0},\n  {\"id\":703703,\"suggestedTranslation\":\"Đáng yêu một cách chết chóc.\",\"rating\":9.0},\n  {\"id\":703704,\"suggestedTranslation\":\"Đáng yêu và ngon miệng.\",\"rating\":9.0},\n  {\"id\":703705,\"suggestedTranslation\":\"Trông ấm áp và đầy thịt.\",\"rating\":9.0},\n  {\"id\":703706,\"suggestedTranslation\":\"Tuyệt thật, giờ thì tớ bị nghẹt mũi rồi.\",\"rating\":9.0},\n  {\"id\":703707,\"suggestedTranslation\":\"Nó đang định lấy đồ của tôi!\",\"rating\":9.0},\n  {\"id\":703708,\"suggestedTranslation\":\"Eo. Dính đầy chất nhờn của Krampus rồi.\",\"rating\":9.0},\n  {\"id\":703709,\"suggestedTranslation\":\"Ánh sáng văn minh hơn.\",\"rating\":9.0},\n  {\"id\":703710,\"suggestedTranslation\":\"Tôi có thể ăn thêm một đĩa bánh latke nữa đấy.\",\"rating\":9.0},\n  {\"id\":703711,\"suggestedTranslation\":\"Bộ giáp này đã hóa đá để bảo vệ tối đa.\",\"rating\":9.0},\n  {\"id\":703712,\"suggestedTranslation\":\"Không thể tốt hơn được nữa.\",\"rating\":9.0},\n  {\"id\":703713,\"suggestedTranslation\":\"Nhẹ, nhưng không bền lắm.\",\"rating\":9.0},\n  {\"id\":703714,\"suggestedTranslation\":\"Nhẹ nhàng và được thiết kế để tăng tính cơ động.\",\"rating\":9.0},\n  {\"id\":703715,\"suggestedTranslation\":\"Nó cung cấp khả năng bảo vệ khá ổn.\",\"rating\":9.0},\n  {\"id\":703716,\"suggestedTranslation\":\"Thứ đó có thể giúp mình đánh đau hơn một chút.\",\"rating\":9.0},\n  {\"id\":703717,\"suggestedTranslation\":\"Tôi sẽ có đủ năng lượng để thực hiện thêm một số động tác mạo hiểm nếu mặc cái đó.\",\"rating\":9.0},\n  {\"id\":703718,\"suggestedTranslation\":\"Nó sẽ giữ cho két sắt của mình an toàn.\",\"rating\":7.5},\n  {\"id\":703719,\"suggestedTranslation\":\"Mọi người, phá hủy cờ hiệu chiến đấu đi!\",\"rating\":9.0},\n  {\"id\":703720,\"suggestedTranslation\":\"Hắn có thể là một vật đánh lạc hướng tốt cho chúng ta.\",\"rating\":9.0},\n  {\"id\":703721,\"suggestedTranslation\":\"Đó là kẻ phụ trách ở đây.\",\"rating\":9.0},\n  {\"id\":703722,\"suggestedTranslation\":\"Cái đó có thể gây ra sự hủy diệt lớn đấy.\",\"rating\":9.0},\n  {\"id\":703723,\"suggestedTranslation\":\"Nó là một con quái vật đá tảng!\",\"rating\":9.0},\n  {\"id\":703724,\"suggestedTranslation\":\"Ánh nhìn của nó chứa đầy tri thức khoa học.\",\"rating\":9.0},\n  {\"id\":703725,\"suggestedTranslation\":\"Mấy cái lông vũ mềm mại kia làm mình muốn chạy đi quá!\",\"rating\":9.0},\n  {\"id\":703726,\"suggestedTranslation\":\"Nó có mùi lưu huỳnh.\",\"rating\":9.0},\n  {\"id\":703727,\"suggestedTranslation\":\"Cánh hoa này tương tác rất tốt với ma thuật hồi phục.\",\"rating\":9.0},\n  {\"id\":703728,\"suggestedTranslation\":\"Vòng hoa này sẽ giúp mình hồi phục một chút sinh lực.\",\"rating\":9.0},\n  {\"id\":703729,\"suggestedTranslation\":\"Một món vũ khí trông thật sắc bén.\",\"rating\":9.0},\n  {\"id\":703730,\"suggestedTranslation\":\"Cần có một chiếc chìa khóa.\",\"rating\":9.0},\n  {\"id\":703731,\"suggestedTranslation\":\"Thế là xong.\",\"rating\":9.0},\n  {\"id\":703732,\"suggestedTranslation\":\"Những đòn tấn công của mình sẽ đau hơn một tí khi mặc thứ này.\",\"rating\":9.0},\n  {\"id\":703733,\"suggestedTranslation\":\"Vũ khí đó dùng để ném.\",\"rating\":9.0},\n  {\"id\":703734,\"suggestedTranslation\":\"Đó là cách chúng ta đến đây. Hy vọng cũng là cách để chúng ta quay về.\",\"rating\":9.0},\n  {\"id\":703735,\"suggestedTranslation\":\"Tôi đi đây.\",\"rating\":9.0},\n  {\"id\":703736,\"suggestedTranslation\":\"Mấy viên tinh thể đó sẽ giúp tôi hồi phục năng lực nhanh hơn.\",\"rating\":9.0},\n  {\"id\":703737,\"suggestedTranslation\":\"Đây là nơi lũ kẻ thù đó xuất hiện.\",\"rating\":9.0},\n  {\"id\":703738,\"suggestedTranslation\":\"Trông nó có vẻ uy lực phết.\",\"rating\":9.0},\n  {\"id\":703739,\"suggestedTranslation\":\"Trông có vẻ nó giúp tăng cường khả năng hồi máu.\",\"rating\":9.0},\n  {\"id\":703740,\"suggestedTranslation\":\"Quá nóng để xử lý.\",\"rating\":9.0},\n  {\"id\":703741,\"suggestedTranslation\":\"Đã nguội lạnh và thư giãn rồi.\",\"rating\":9.0},\n  {\"id\":703742,\"suggestedTranslation\":\"Có hơi ấm thoang thoảng phát ra từ bên trong.\",\"rating\":9.0},\n  {\"id\":703743,\"suggestedTranslation\":\"Tôi không nghĩ quả trứng đó đủ ấm.\",\"rating\":9.0},\n  {\"id\":703744,\"suggestedTranslation\":\"Tôi chưa bao giờ nghĩ mình sẽ thấy một quả trứng hạnh phúc.\",\"rating\":9.0},\n  {\"id\":703745,\"suggestedTranslation\":\"Nó có vẻ đang vui.\",\"rating\":9.0},\n  {\"id\":703746,\"suggestedTranslation\":\"Ôi. Ai là quái vật ngoan nào?\",\"rating\":9.0},\n  {\"id\":703747,\"suggestedTranslation\":\"Tôi nghe thấy tiếng bụng bé xíu đang réo lên.\",\"rating\":9.0},\n  {\"id\":703748,\"suggestedTranslation\":\"Tội nghiệp, chắc là nó đang đói lắm rồi.\",\"rating\":9.0},\n  {\"id\":703749,\"suggestedTranslation\":\"Đó là một chiếc răng trứng!\",\"rating\":9.0},\n  {\"id\":703750,\"suggestedTranslation\":\"Tôi thích gọi nó là \\\"Basaliva\\\".\",\"rating\":9.0},\n  {\"id\":703751,\"suggestedTranslation\":\"Nước bọt nóng bỏng!\",\"rating\":9.0},\n  {\"id\":703752,\"suggestedTranslation\":\"Tuyệt ma-ma-mĩ!\",\"rating\":9.0},\n  {\"id\":703753,\"suggestedTranslation\":\"Như một nơi như bất kỳ.\",\"rating\":9.0},\n  {\"id\":703754,\"suggestedTranslation\":\"Thịt lá bí ẩn.\",\"rating\":9.0},\n  {\"id\":703755,\"suggestedTranslation\":\"Ăn chay, nhưng không hề nhân đạo.\",\"rating\":9.0},\n  {\"id\":703756,\"suggestedTranslation\":\"Khoa học đã đi quá xa rồi chăng?\",\"rating\":9.0},\n  {\"id\":703757,\"suggestedTranslation\":\"Hắn to thật đấy!\",\"rating\":9.0},\n  {\"id\":703758,\"suggestedTranslation\":\"Tạc tượng từ gỗ có vẻ hơi thừa thãi.\",\"rating\":9.0},\n  {\"id\":703759,\"suggestedTranslation\":\"Hắn khổng lồ thật!\",\"rating\":9.0},\n  {\"id\":703760,\"suggestedTranslation\":\"Chỉ có vi khuẩn lam mới mọc được dưới ánh sáng này.\",\"rating\":9.0},\n  {\"id\":703761,\"suggestedTranslation\":\"Một bước tiến khoa học! Thuốc giải đây rồi!\",\"rating\":9.0},\n  {\"id\":703762,\"suggestedTranslation\":\"Trông nó ngon một cách kỳ lạ.\",\"rating\":9.0},\n  {\"id\":703763,\"suggestedTranslation\":\"Nó phát quang sinh học!\",\"rating\":9.0},\n  {\"id\":703764,\"suggestedTranslation\":\"Chiếc bật lửa may mắn của cô ấy.\",\"rating\":9.0},\n  {\"id\":703765,\"suggestedTranslation\":\"Thật kỳ lạ, mang theo nó làm túi của mình thấy nhẹ bẫng đi!\",\"rating\":9.0},\n  {\"id\":703766,\"suggestedTranslation\":\"Tôi không nghĩ nó thích bị sét đánh đâu.\",\"rating\":9.0},\n  {\"id\":703767,\"suggestedTranslation\":\"\\\"Bêêê\\\" lại chính ông đấy!\",\"rating\":9.0},\n  {\"id\":703768,\"suggestedTranslation\":\"Nó giống như một chiếc cột thu lôi thu nhỏ.\",\"rating\":9.0},\n  {\"id\":703769,\"suggestedTranslation\":\"Sức mạnh này thuộc về ta!\",\"rating\":9.0},\n  {\"id\":703770,\"suggestedTranslation\":\"Để chế ngự bầu trời!\",\"rating\":9.0},\n  {\"id\":703771,\"suggestedTranslation\":\"Nó sẽ không đáng yêu và dễ thương mãi đâu.\",\"rating\":9.0},\n  {\"id\":703772,\"suggestedTranslation\":\"Trông nó có vẻ lo lắng.\",\"rating\":9.0},\n  {\"id\":703773,\"suggestedTranslation\":\"Nó đang theo dõi mình sao?\",\"rating\":9.0},\n  {\"id\":703774,\"suggestedTranslation\":\"Có thứ gì đó bên trong! Tôi phải nhổ tận gốc nó mới được.\",\"rating\":9.0},\n  {\"id\":703775,\"suggestedTranslation\":\"Nó sẽ lớn lên thành một thứ to lớn và kinh hoàng.\",\"rating\":9.0},\n  {\"id\":703776,\"suggestedTranslation\":\"Nêm thêm chút muối thì hay, nhưng chuyện súp của tôi thì chẳng liên quan đến ai.\",\"rating\":9.0},\n  {\"id\":703777,\"suggestedTranslation\":\"Nếu mình ăn vào buổi sáng thì nó còn là bữa tối không nhỉ?\",\"rating\":9.0},\n  {\"id\":703778,\"suggestedTranslation\":\"Gỗ nóng thật đấy!\",\"rating\":9.0},\n  {\"id\":703779,\"suggestedTranslation\":\"Nó to, nó nặng, và nó là gỗ.\",\"rating\":9.0},\n  {\"id\":703780,\"suggestedTranslation\":\"Này, đừng làm phiền lũ cây nữa!\",\"rating\":9.0},\n  {\"id\":703781,\"suggestedTranslation\":\"Chắc chắn phải có một cách giải thích khoa học hoàn hảo cho thứ đó rồi.\",\"rating\":9.0},\n  {\"id\":703782,\"suggestedTranslation\":\"Chắc chắn phải có một cách giải thích khoa học hoàn hảo cho thứ đó rồi.\",\"rating\":9.0},\n  {\"id\":703783,\"suggestedTranslation\":\"Chắc hẳn phải có một lời giải thích khoa học hoàn hảo cho thứ đó.\",\"rating\":9.0},\n  {\"id\":703784,\"suggestedTranslation\":\"Chắc chắn là có một lời giải thích khoa học hoàn hảo cho thứ đó rồi.\",\"rating\":9.0},\n  {\"id\":703785,\"suggestedTranslation\":\"Chắc chắn là có lời giải thích khoa học hoàn hảo cho việc đó rồi.\",\"rating\":9.0},\n  {\"id\":703786,\"suggestedTranslation\":\"Chắc hẳn có một lời giải thích khoa học hoàn hảo cho việc đó.\",\"rating\":9.0},\n  {\"id\":703787,\"suggestedTranslation\":\"Chắc chắn phải có một cách giải thích khoa học hoàn hảo cho thứ đó rồi.\",\"rating\":9.0},\n  {\"id\":703788,\"suggestedTranslation\":\"Chắc chắn phải có một cách giải thích khoa học hoàn hảo cho thứ đó rồi.\",\"rating\":9.0},\n  {\"id\":703789,\"suggestedTranslation\":\"Chắc chắn là có một lời giải thích khoa học hoàn hảo cho thứ đó rồi.\",\"rating\":9.0},\n  {\"id\":703790,\"suggestedTranslation\":\"Chắc chắn là có một lời giải thích khoa học hoàn hảo cho thứ đó rồi.\",\"rating\":9.0},\n  {\"id\":703791,\"suggestedTranslation\":\"Thật là một món đồ may mắn!\",\"rating\":9.0},\n  {\"id\":703792,\"suggestedTranslation\":\"Cây rìu này trông đẹp hơn những loại tôi thường dùng.\",\"rating\":9.0},\n  {\"id\":703793,\"suggestedTranslation\":\"Cái cây này sinh sản kiểu gì vậy nhỉ?\",\"rating\":9.0},\n  {\"id\":703794,\"suggestedTranslation\":\"Đừng nhìn chằm chằm nữa.\",\"rating\":9.0},\n  {\"id\":703795,\"suggestedTranslation\":\"Nó làm mình trông còn tỏa sáng hơn thường ngày.\",\"rating\":9.0},\n  {\"id\":703796,\"suggestedTranslation\":\"Nó cứng kinh khủng. Mình có thể dùng thứ này!\",\"rating\":9.0},\n  {\"id\":703797,\"suggestedTranslation\":\"Tôi đang làm thêm công việc thợ may dưới ánh trăng.\",\"rating\":9.0},\n  {\"id\":703798,\"suggestedTranslation\":\"Ánh sáng kết tinh.\",\"rating\":9.0},\n  {\"id\":703799,\"suggestedTranslation\":\"Bao nhiêu tri thức ẩn giấu bên trong đó... mà mình lại chẳng thể chạm tới!\",\"rating\":9.0},\n  {\"id\":703800,\"suggestedTranslation\":\"Nó chẳng có vẻ gì là quan tâm đến không gian cá nhân cả.\",\"rating\":9.0},\n  {\"id\":703801,\"suggestedTranslation\":\"Nó có bản tính gai góc.\",\"rating\":9.0},\n  {\"id\":703802,\"suggestedTranslation\":\"Đúng là nơi lý tưởng để chế tạo thứ gì đó thật thông minh và đầy tính khoa học.\",\"rating\":9.0},\n  {\"id\":703803,\"suggestedTranslation\":\"Sự kết hợp đơn giản của các nguyên tố!\",\"rating\":9.0},\n  {\"id\":703804,\"suggestedTranslation\":\"Chắc hẳn nó đã chui qua vết nứt kỳ lạ đó!\",\"rating\":9.0},\n  {\"id\":703805,\"suggestedTranslation\":\"Thứ này từng là một phần trên vương miện của nó.\",\"rating\":9.0},\n  {\"id\":703806,\"suggestedTranslation\":\"Nó thật quyến rũ.\",\"rating\":9.0},\n  {\"id\":703807,\"suggestedTranslation\":\"Giờ mình có thể tự mở trang trại thịt rồi.\",\"rating\":9.0},\n  {\"id\":703808,\"suggestedTranslation\":\"Có loại cá kèn nào ở đây không nhỉ?\",\"rating\":9.0},\n  {\"id\":703809,\"suggestedTranslation\":\"Sự tỉnh táo chỉ là cái giá nhỏ để đổi lấy khoa học!\",\"rating\":9.0},\n  {\"id\":703810,\"suggestedTranslation\":\"Sao mình bắt đầu thấy hơi bất an thế này...?\",\"rating\":9.0},\n  {\"id\":703811,\"suggestedTranslation\":\"Quả là một con quái điểu!\",\"rating\":9.0},\n  {\"id\":703812,\"suggestedTranslation\":\"Có mùi tanh thật.\",\"rating\":9.0},\n  {\"id\":703813,\"suggestedTranslation\":\"Được nhổ ra từ một con quái vật đầy lông lá.\",\"rating\":9.0},\n  {\"id\":703814,\"suggestedTranslation\":\"Tôi đang làm một chiếc áo lông vũ đây!\",\"rating\":9.0},\n  {\"id\":703815,\"suggestedTranslation\":\"Anh ta bị mắc kẹt rồi!\",\"rating\":9.0},\n  {\"id\":703816,\"suggestedTranslation\":\"Rễ cây nhân sâm có những đặc tính kỳ lạ.\",\"rating\":9.0},\n  {\"id\":703817,\"suggestedTranslation\":\"Chà, anh bạn này sẽ chẳng tỉnh lại nữa đâu.\",\"rating\":9.0},\n  {\"id\":703818,\"suggestedTranslation\":\"Ngưng lại ngay!\",\"rating\":9.0},\n  {\"id\":703819,\"suggestedTranslation\":\"Nó trông không còn quá kỳ lạ nữa.\",\"rating\":9.0},\n  {\"id\":703820,\"suggestedTranslation\":\"Tôi nghe đồn những cái cây đó kỳ quặc lắm.\",\"rating\":9.0},\n  {\"id\":703821,\"suggestedTranslation\":\"Cầm nó trên tay làm tôi thấy dễ chịu hơn một chút.\",\"rating\":9.0},\n  {\"id\":703822,\"suggestedTranslation\":\"Một tấm bản đồ trống. Có vẻ không hữu ích cho lắm.\",\"rating\":9.0},\n  {\"id\":703823,\"suggestedTranslation\":\"Sang trọng thật!\",\"rating\":9.0},\n  {\"id\":703824,\"suggestedTranslation\":\"Tôi đã đổi con bò của gia đình lấy nó đấy.\",\"rating\":9.0},\n  {\"id\":703825,\"suggestedTranslation\":\"Trông như được chạm khắc vậy.\",\"rating\":9.0},\n  {\"id\":703826,\"suggestedTranslation\":\"Tôi nghĩ mình có thể dùng nó.\",\"rating\":9.0},\n  {\"id\":703827,\"suggestedTranslation\":\"Tôi hiểu mà.\",\"rating\":9.0},\n  {\"id\":703828,\"suggestedTranslation\":\"Tôi không nghĩ rìu có thể chặt được nó.\",\"rating\":9.0},\n  {\"id\":703829,\"suggestedTranslation\":\"Nó đang cháy nhanh quá!\",\"rating\":9.0},\n  {\"id\":703830,\"suggestedTranslation\":\"Đỡ được một bụi gai phiền phức.\",\"rating\":9.0},\n  {\"id\":703831,\"suggestedTranslation\":\"Trông đầy gai góc.\",\"rating\":9.0},\n  {\"id\":703832,\"suggestedTranslation\":\"Ái.\",\"rating\":9.0},\n  {\"id\":703833,\"suggestedTranslation\":\"Nó là một loài thực vật.\",\"rating\":9.0},\n  {\"id\":703834,\"suggestedTranslation\":\"Gai nhọn và lửa!\",\"rating\":9.0},\n  {\"id\":703835,\"suggestedTranslation\":\"Giờ nó cháy trụi và đầy gai góc rồi.\",\"rating\":9.0},\n  {\"id\":703836,\"suggestedTranslation\":\"Giờ thì đỡ gai góc rồi nhé!\",\"rating\":9.0},\n  {\"id\":703837,\"suggestedTranslation\":\"Mấy cái gai đó trông sắc thật!\",\"rating\":9.0},\n  {\"id\":703838,\"suggestedTranslation\":\"Tôi nghe nói nấu ăn cơ bản là hóa học. Mình nên thử xem sao.\",\"rating\":9.0},\n  {\"id\":703839,\"suggestedTranslation\":\"Tôi không thấy giống chỗ nào cả.\",\"rating\":9.0},\n  {\"id\":703840,\"suggestedTranslation\":\"Tôi sẽ không làm phiền cô ấy đâu.\",\"rating\":9.0},\n  {\"id\":703841,\"suggestedTranslation\":\"Nó trông nặng hơn những cái khác.\",\"rating\":9.0},\n  {\"id\":703842,\"suggestedTranslation\":\"Đó là mặt nạ thợ rèn.\",\"rating\":9.0},\n  {\"id\":703843,\"suggestedTranslation\":\"Đó là mặt nạ búp bê nứt vỡ.\",\"rating\":9.0},\n  {\"id\":703844,\"suggestedTranslation\":\"Đó là mặt nạ búp bê.\",\"rating\":9.0},\n  {\"id\":703845,\"suggestedTranslation\":\"Trước đây nó từng là mặt nạ búp bê.\",\"rating\":9.0},\n  {\"id\":703846,\"suggestedTranslation\":\"Mặt nạ của kẻ khờ.\",\"rating\":9.0},\n  {\"id\":703847,\"suggestedTranslation\":\"Trông hơi nhàm chán.\",\"rating\":9.0},\n  {\"id\":703848,\"suggestedTranslation\":\"Đó là mặt nạ nhà vua.\",\"rating\":9.0},\n  {\"id\":703849,\"suggestedTranslation\":\"Nó là một chiếc mặt nạ, nhưng trông cứ như một chiếc gương vậy.\",\"rating\":9.0},\n  {\"id\":703850,\"suggestedTranslation\":\"Này, công chúa!\",\"rating\":9.0},\n  {\"id\":703851,\"suggestedTranslation\":\"Mặt nạ nữ hoàng đây