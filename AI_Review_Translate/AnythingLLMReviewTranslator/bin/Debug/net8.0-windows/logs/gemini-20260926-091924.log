            "text": "[\n  {\"id\": 709695, \"suggestedTranslation\": \"Tôi sẽ kiểm tra nó sau vậy. Hoặc trước đó?\", \"rating\": 9.5},\n  {\"id\": 709696, \"suggestedTranslation\": \"Tôi không nghĩ trong đó có gì đáng để lấy đâu.\", \"rating\": 9.5},\n  {\"id\": 709697, \"suggestedTranslation\": \"Nó thuộc về cỗ máy tự động đó.\", \"rating\": 9.5},\n  {\"id\": 709698, \"suggestedTranslation\": \"Mất quá nhiều thời gian để nấu một bữa ăn cầu kỳ.\", \"rating\": 9.5},\n  {\"id\": 709699, \"suggestedTranslation\": \"Con tiểu yêu đó muốn làm gì với mấy thứ này cũng được.\", \"rating\": 9.5},\n  {\"id\": 709700, \"suggestedTranslation\": \"Tôi sẽ không phí thời gian với cái đó đâu.\", \"rating\": 9.5},\n  {\"id\": 709701, \"suggestedTranslation\": \"Tôi đang vội, nhưng chưa đến mức vội thế này.\", \"rating\": 9.5},\n  {\"id\": 709702, \"suggestedTranslation\": \"Cảm ơn nhưng tôi không muốn bỏ mạng dưới móng guốc của một con Bò Lai giận dữ đâu.\", \"rating\": 10.0},\n  {\"id\": 709703, \"suggestedTranslation\": \"Cách đó không hiệu quả đâu.\", \"rating\": 9.5},\n  {\"id\": 709704, \"suggestedTranslation\": \"Bộ lông của chúng mất rất lâu để mọc lại đấy.\", \"rating\": 9.5},\n  {\"id\": 709705, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_woodie\", \"rating\": 10.0},\n  {\"id\": 709706, \"suggestedTranslation\": \"Tôi không có thời gian rảnh để đi cạo lông Bò Lai của người khác đâu!\", \"rating\": 10.0},\n  {\"id\": 709707, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wathgrithr\", \"rating\": 10.0},\n  {\"id\": 709708, \"suggestedTranslation\": \"Nó được sống thêm một ngày nữa.\", \"rating\": 9.5},\n  {\"id\": 709709, \"suggestedTranslation\": \"Tôi không thể chiếm cùng một không gian với người khác được.\", \"rating\": 9.5},\n  {\"id\": 709710, \"suggestedTranslation\": \"Mình đang quên cái gì nhỉ? Ồ! Lũ Cà Ruột!\", \"rating\": 10.0},\n  {\"id\": 709711, \"suggestedTranslation\": \"Chỗ chứa chỉ có hạn thôi.\", \"rating\": 9.5},\n  {\"id\": 709712, \"suggestedTranslation\": \"Làm ơn nhanh lên, tôi còn bao việc phải làm!\", \"rating\": 9.5},\n  {\"id\": 709713, \"suggestedTranslation\": \"Tôi không có thời gian để bận tâm mấy thứ này!\", \"rating\": 9.5},\n  {\"id\": 709714, \"suggestedTranslation\": \"Nó thuộc về cỗ máy tự động đó.\", \"rating\": 9.5},\n  {\"id\": 709715, \"suggestedTranslation\": \"Mất quá nhiều thời gian để nấu một bữa ăn cầu kỳ.\", \"rating\": 9.5},\n  {\"id\": 709716, \"suggestedTranslation\": \"Con tiểu yêu đó muốn làm gì với mấy thứ này cũng được.\", \"rating\": 9.5},\n  {\"id\": 709717, \"suggestedTranslation\": \"Tôi sẽ không phí thời gian với cái đó đâu.\", \"rating\": 9.5},\n  {\"id\": 709718, \"suggestedTranslation\": \"Tôi không tài nào giải nổi cái đó...\", \"rating\": 9.5},\n  {\"id\": 709719, \"suggestedTranslation\": \"Vâng vâng, tôi biết cái đó rồi.\", \"rating\": 9.5},\n  {\"id\": 709720, \"suggestedTranslation\": \"Trong này tối quá... Tôi chẳng nhìn thấy gì cả.\", \"rating\": 9.5},\n  {\"id\": 709721, \"suggestedTranslation\": \"Mấy thứ ngoằn ngoèo gì thế này? Chẳng có hòn đảo quanh đây lại có hình dáng này cả.\", \"rating\": 9.5},\n  {\"id\": 709722, \"suggestedTranslation\": \"Tôi đã đến đúng thời gian, nhưng lại sai địa điểm.\", \"rating\": 9.5},\n  {\"id\": 709723, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_walter\", \"rating\": 10.0},\n  {\"id\": 709724, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_walter\", \"rating\": 10.0},\n  {\"id\": 709725, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_walter\", \"rating\": 10.0},\n  {\"id\": 709726, \"suggestedTranslation\": \"Ôi phiền phức thật, cách này không ổn rồi.\", \"rating\": 9.5},\n  {\"id\": 709727, \"suggestedTranslation\": \"Chắc lần này chúng ta không có duyên làm đối tác rồi.\", \"rating\": 9.5},\n  {\"id\": 709728, \"suggestedTranslation\": \"Tôi không có thời gian để chăm sóc hết đám Bò Lai này đâu!\", \"rating\": 10.0},\n  {\"id\": 709729, \"suggestedTranslation\": \"Ồ, cái đó không phải... thật là xấu hổ quá đi.\", \"rating\": 9.5},\n  {\"id\": 709730, \"suggestedTranslation\": \"Nó hỏng đến mức không sửa được nữa rồi.\", \"rating\": 9.5},\n  {\"id\": 709731, \"suggestedTranslation\": \"Không phải việc của tôi.\", \"rating\": 9.5},\n  {\"id\": 709732, \"suggestedTranslation\": \"Tôi sẽ quay lại sau khi không phải chiến đấu giữ mạng!\", \"rating\": 9.5},\n  {\"id\": 709733, \"suggestedTranslation\": \"Khoan đã... đây thậm chí còn không phải chìa khóa đúng!\", \"rating\": 10.0},\n  {\"id\": 709734, \"suggestedTranslation\": \"Tôi cứ đinh ninh đó là chiếc chìa khóa chính xác...\", \"rating\": 10.0},\n  {\"id\": 709735, \"suggestedTranslation\": \"Tôi đang làm sai trình tự rồi, cần phải gói thứ gì đó trước đã.\", \"rating\": 9.5},\n  {\"id\": 709736, \"suggestedTranslation\": \"Tôi không có thời gian bận tâm mấy thứ đó.\", \"rating\": 9.5},\n  {\"id\": 709737, \"suggestedTranslation\": \"Anh đang viết tiểu thuyết đấy à? Sao mà lâu thế?\", \"rating\": 9.5},\n  {\"id\": 709738, \"suggestedTranslation\": \"Trông có vẻ không có ai ở đây cả.\", \"rating\": 9.5},\n  {\"id\": 709739, \"suggestedTranslation\": \"Chà, nếu anh ta không bắt đầu cuộc thi thì tôi cũng chẳng đứng chờ đâu.\", \"rating\": 9.5},\n  {\"id\": 709740, \"suggestedTranslation\": \"Chẳng có ai ở đây cả.\", \"rating\": 9.5},\n  {\"id\": 709741, \"suggestedTranslation\": \"Cậu ta đang bận.\", \"rating\": 9.5},\n  {\"id\": 709742, \"suggestedTranslation\": \"Tôi chắc chắn là mình từng thấy cái này rồi.\", \"rating\": 9.5},\n  {\"id\": 709743, \"suggestedTranslation\": \"Không phải ở mốc thời gian này.\", \"rating\": 9.5},\n  {\"id\": 709744, \"suggestedTranslation\": \"Hừ! Thành công rồi!\", \"rating\": 9.5},\n  {\"id\": 709745, \"suggestedTranslation\": \"Tôi nghĩ mình đã hoàn thành mọi việc cần làm rồi.\", \"rating\": 9.5},\n  {\"id\": 709746, \"suggestedTranslation\": \"Có cái gì đó đang đến.\", \"rating\": 9.5},\n  {\"id\": 709747, \"suggestedTranslation\": \"Nếu lần đầu không thành công, hãy đảo ngược thời gian và thử lại.\", \"rating\": 9.5},\n  {\"id\": 709748, \"suggestedTranslation\": \"Mặt đất đang cố nuốt chửng tôi kìa!\", \"rating\": 9.5},\n  {\"id\": 709749, \"suggestedTranslation\": \"Tiếng ầm ầm kinh khủng gì thế này?\", \"rating\": 9.5},\n  {\"id\": 709750, \"suggestedTranslation\": \"Có cái gì đó đang dịch chuyển!\", \"rating\": 9.5},\n  {\"id\": 709751, \"suggestedTranslation\": \"Này, cầm lấy cái này rồi để tôi yên ổn rời đi!\", \"rating\": 9.5},\n  {\"id\": 709752, \"suggestedTranslation\": \"Cứ cầm lấy cái này đi rồi tôi còn đi tiếp.\", \"rating\": 9.5},\n  {\"id\": 709753, \"suggestedTranslation\": \"Đã đến lúc tiếp tục rồi.\", \"rating\": 9.5},\n  {\"id\": 709754, \"suggestedTranslation\": \"Nó đang cho tôi xem những hình vẽ kỳ lạ... Tôi không nghĩ mình từng thấy chúng trước đây.\", \"rating\": 9.5},\n  {\"id\": 709755, \"suggestedTranslation\": \"Nơi này giống như một chiếc đồng hồ chưa được lên dây cót vậy.\", \"rating\": 9.5},\n  {\"id\": 709756, \"suggestedTranslation\": \"Tôi biết cái này. Hoặc có lẽ tôi sẽ sớm biết.\", \"rating\": 9.5},\n  {\"id\": 709757, \"suggestedTranslation\": \"Đến lúc di chuyển thôi!\", \"rating\": 9.5},\n  {\"id\": 709758, \"suggestedTranslation\": \"Tôi phải ra khỏi đây thôi!\", \"rating\": 9.5},\n  {\"id\": 709759, \"suggestedTranslation\": \"Có chuyện gì đang xảy ra... Tôi không thể ở lại đây được!\", \"rating\": 9.5},\n  {\"id\": 709760, \"suggestedTranslation\": \"Tôi muốn đấm vào cái gì đó quá!!\", \"rating\": 9.5},\n  {\"id\": 709761, \"suggestedTranslation\": \"Chưa bao giờ tôi cảm thấy tràn đầy năng lượng thế này!\", \"rating\": 9.5},\n  {\"id\": 709762, \"suggestedTranslation\": \"Tôi cảm thấy hoàn toàn chống nước rồi.\", \"rating\": 9.5},\n  {\"id\": 709763, \"suggestedTranslation\": \"Thật kỳ lạ, tôi cảm thấy an toàn hơn một chút.\", \"rating\": 9.5},\n  {\"id\": 709764, \"suggestedTranslation\": \"Cuối cùng thì tôi cũng không phải lãng phí thời gian để ngủ nữa!\", \"rating\": 9.5},\n  {\"id\": 709765, \"suggestedTranslation\": \"Thế này mới đúng chứ! Tôi sẽ xong việc ngay lập tức thôi!\", \"rating\": 9.5},\n  {\"id\": 709766, \"suggestedTranslation\": \"oOooOooo!!\", \"rating\": 9.5},\n  {\"id\": 709767, \"suggestedTranslation\": \"Ôi phiền phức thật. Lũ ong đó thật làm tôi phát bực!\", \"rating\": 9.5},\n  {\"id\": 709768, \"suggestedTranslation\": \"Ôi không không không! T-thuyền ván đang bị tràn nước rồi!!\", \"rating\": 10.0},\n  {\"id\": 709769, \"suggestedTranslation\": \"Không, chờ đã! Tôi cần thêm thời gian!!\", \"rating\": 9.5},\n  {\"id\": 709770, \"suggestedTranslation\": \"Gieo nhân nào gặt quả nấy.\", \"rating\": 9.5},\n  {\"id\": 709771, \"suggestedTranslation\": \"Lần này thì trông nó không đáng sợ lắm.\", \"rating\": 9.5},\n  {\"id\": 709772, \"suggestedTranslation\": \"Suýt nữa thì tôi bị nướng thành tro rồi!\", \"rating\": 9.5},\n  {\"id\": 709773, \"suggestedTranslation\": \"Đug đây này!\", \"rating\": 9.0},\n  {\"id\": 709774, \"suggestedTranslation\": \"\\nTôi từng sửa những chiếc đồng hồ phức tạp, sửa cái này chắc chắn sẽ dễ thôi!\", \"rating\": 9.5},\n  {\"id\": 709775, \"suggestedTranslation\": \"Ôi phiền phức thật, tôi phải đi thu thập vài thứ trước đã.\", \"rating\": 9.5},\n  {\"id\": 709776, \"suggestedTranslation\": \"Tôi không thể chế tạo nó nếu không có bàn làm việc đàng hoàng.\", \"rating\": 9.5},\n  {\"id\": 709777, \"suggestedTranslation\": \"Tôi vẫn chưa nghiên cứu ra cái đó.\", \"rating\": 9.5},\n  {\"id\": 709778, \"suggestedTranslation\": \"Đặt nó gần Rạp Giám Khảo của giám khảo sẽ hiệu quả hơn đấy.\", \"rating\": 9.5},\n  {\"id\": 709779, \"suggestedTranslation\": \"Sao tôi cứ có cảm giác không thể...? Ồ không...\", \"rating\": 9.5},\n  {\"id\": 709780, \"suggestedTranslation\": \"Không có thời gian để ngủ đâu!\", \"rating\": 9.5},\n  {\"id\": 709781, \"suggestedTranslation\": \"Không phải lúc để đứng thẫn thờ đâu!\", \"rating\": 9.5},\n  {\"id\": 709782, \"suggestedTranslation\": \"Sao tôi lại vớ được một con Cà Ruột chậm chạp thế này nhỉ?\", \"rating\": 10.0},\n  {\"id\": 709783, \"suggestedTranslation\": \"Ôi không... chắc cái tật mù đường của tôi lây sang nó rồi.\", \"rating\": 9.5},\n  {\"id\": 709784, \"suggestedTranslation\": \"Đi sai đường rồi, quay lại mau!\", \"rating\": 9.5},\n  {\"id\": 709785, \"suggestedTranslation\": \"Theo hiệu lệnh của tôi, ba, một, hai-- CHẠY!\", \"rating\": 9.5},\n  {\"id\": 709786, \"suggestedTranslation\": \"Không không không! Mọi thứ đang sụp đổ hết rồi!\", \"rating\": 9.5},\n  {\"id\": 709787, \"suggestedTranslation\": \"Ổn thôi.\", \"rating\": 9.5},\n  {\"id\": 709788, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wx78\", \"rating\": 10.0},\n  {\"id\": 709789, \"suggestedTranslation\": \"Chúng tìm thấy tôi rồi... K-Không! Tránh ra!\", \"rating\": 9.5},\n  {\"id\": 709790, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_winona\", \"rating\": 10.0},\n  {\"id\": 709791, \"suggestedTranslation\": \"Đừng làm phiền tôi!\", \"rating\": 9.5},\n  {\"id\": 709792, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_winona\", \"rating\": 10.0},\n  {\"id\": 709793, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfgang\", \"rating\": 10.0},\n  {\"id\": 709794, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfgang\", \"rating\": 10.0},\n  {\"id\": 709795, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfgang\", \"rating\": 10.0},\n  {\"id\": 709796, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfgang\", \"rating\": 10.0},\n  {\"id\": 709797, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfgang\", \"rating\": 10.0},\n  {\"id\": 709798, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfgang\", \"rating\": 10.0},\n  {\"id\": 709799, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfgang\", \"rating\": 10.0},\n  {\"id\": 709800, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfgang\", \"rating\": 10.0},\n  {\"id\": 709801, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfgang\", \"rating\": 10.0},\n  {\"id\": 709802, \"suggestedTranslation\": \"Hừm... t-từ bao giờ mà trời lạnh thế này?\", \"rating\": 9.5},\n  {\"id\": 709803, \"suggestedTranslation\": \"Tôi không chắc cơ chế đơn giản này sao lại hỏng được, nhưng mà...\", \"rating\": 9.5},\n  {\"id\": 709804, \"suggestedTranslation\": \"À, tôi cảm thấy khỏe khoắn như vạm vỡ vậy!\", \"rating\": 9.5},\n  {\"id\": 709805, \"suggestedTranslation\": \"Ôi phiền phức thật. Tôi lại quên mất thứ gì rồi phải không?\", \"rating\": 9.5},\n  {\"id\": 709806, \"suggestedTranslation\": \"Chút nước thì có gì mà phải lo.\", \"rating\": 9.5},\n  {\"id\": 709807, \"suggestedTranslation\": \"Ôi phiền phức thật, lại đến cái thời điểm trong năm này rồi à?\", \"rating\": 9.5},\n  {\"id\": 709808, \"suggestedTranslation\": \"Khoan, dừng lại! Tôi cần thêm thời gian--!\", \"rating\": 9.5},\n  {\"id\": 709809, \"suggestedTranslation\": \"Phù, không biết chuyện gì vừa nhập vào tôi nữa...\", \"rating\": 9.5},\n  {\"id\": 709810, \"suggestedTranslation\": \"Tôi sẽ nhớ cảm giác có điện giật trong tầm tay lắm đây.\", \"rating\": 9.5},\n  {\"id\": 709811, \"suggestedTranslation\": \"Ôi phiền phức thật, tôi đang quen dần với việc chống nước rồi cơ mà.\", \"rating\": 9.5},\n  {\"id\": 709812, \"suggestedTranslation\": \"Bỗng nhiên tôi thấy hơi kém an toàn...\", \"rating\": 9.5},\n  {\"id\": 709813, \"suggestedTranslation\": \"Chắc tôi không thể tránh việc ngủ mãi được.\", \"rating\": 9.5},\n  {\"id\": 709814, \"suggestedTranslation\": \"Không! Tôi không thể chậm lại lúc này được!\", \"rating\": 9.5},\n  {\"id\": 709815, \"suggestedTranslation\": \"Trông khá hơn rồi đấy.\", \"rating\": 9.5},\n  {\"id\": 709816, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wx78\", \"rating\": 10.0},\n  {\"id\": 709817, \"suggestedTranslation\": \"Tôi phải nhanh lên thôi, sắp tối rồi.\", \"rating\": 9.5},\n  {\"id\": 709818, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_warly\", \"rating\": 10.0},\n  {\"id\": 709819, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_warly\", \"rating\": 10.0},\n  {\"id\": 709820, \"suggestedTranslation\": \"Mmm!\", \"rating\": 9.5},\n  {\"id\": 709821, \"suggestedTranslation\": \"Tôi không ăn cái đó đâu!\", \"rating\": 9.5},\n  {\"id\": 709822, \"suggestedTranslation\": \"Ôi... tôi thấy khó chịu quá...\", \"rating\": 9.5},\n  {\"id\": 709823, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_warly\", \"rating\": 10.0},\n  {\"id\": 709824, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_warly\", \"rating\": 10.0},\n  {\"id\": 709825, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_warly\", \"rating\": 10.0},\n  {\"id\": 709826, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_warly\", \"rating\": 10.0},\n  {\"id\": 709827, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_warly\", \"rating\": 10.0},\n  {\"id\": 709828, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_warly\", \"rating\": 10.0},\n  {\"id\": 709829, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_warly\", \"rating\": 10.0},\n  {\"id\": 709830, \"suggestedTranslation\": \"Tôi có thể quay lại thời điểm trước khi ăn món đó không?\", \"rating\": 9.5},\n  {\"id\": 709831, \"suggestedTranslation\": \"Tôi nghĩ món đó hơi cũ rồi.\", \"rating\": 9.5},\n  {\"id\": 709832, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_warly\", \"rating\": 10.0},\n  {\"id\": 709833, \"suggestedTranslation\": \"Dù là vấn đề sinh tồn, nhưng tôi VẪN có tiêu chuẩn của mình đấy.\", \"rating\": 9.5},\n  {\"id\": 709834, \"suggestedTranslation\": \"Có lẽ tôi nên chia sẻ một ít cho những người khác...\", \"rating\": 9.5},\n  {\"id\": 709835, \"suggestedTranslation\": \"Giống như một tách trà ngon vậy.\", \"rating\": 9.5},\n  {\"id\": 709836, \"suggestedTranslation\": \"Tiếp tục nào.\", \"rating\": 9.5},\n  {\"id\": 709837, \"suggestedTranslation\": \"Sức mạnh là hiệu suất!\", \"rating\": 9.5},\n  {\"id\": 709838, \"suggestedTranslation\": \"Ối. Mạnh quá mức rồi đấy.\", \"rating\": 9.5},\n  {\"id\": 709839, \"suggestedTranslation\": \"Phù...\", \"rating\": 9.5},\n  {\"id\": 709840, \"suggestedTran