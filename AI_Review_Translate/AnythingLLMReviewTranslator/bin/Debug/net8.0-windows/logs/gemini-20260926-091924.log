},\n  {\"id\": 709946, \"suggestedTranslation\": \"Thật hoài phí thời gian.\", \"rating\": 9.5},\n  {\"id\": 709947, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfgang\", \"rating\": 10.0},\n  {\"id\": 709948, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wolfgang\", \"rating\": 10.0},\n  {\"id\": 709949, \"suggestedTranslation\": \"Phiền phức thật... sáng thế này thì ngủ sao được khi con robot đó hãy còn lảng vảng.\", \"rating\": 9.5},\n  {\"id\": 709950, \"suggestedTranslation\": \"Chắc khó mà ngủ được khi tôi đang bị quay như tế sống thế này.\", \"rating\": 9.5},\n  {\"id\": 709951, \"suggestedTranslation\": \"Tôi không đời nào chịu bỏ mạng trong biển lửa chỉ để thay quần áo đâu, cảm ơn nhé!\", \"rating\": 9.5},\n  {\"id\": 709952, \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_wendy\", \"rating\": 10.0},\n  {\"id\": 709953, \"suggestedTranslation\": \"Chuyện đó dễ ợt.\", \"rating\": 9.5},\n  {\"id\": 709954, \"suggestedTranslation\": \"Có lẽ tôi nên quay lại và thử lại lần nữa...\", \"rating\": 9.5},\n  {\"id\": 709955, \"suggestedTranslation\": \"Tôi sẽ tóm được cậu vào kiếp trước! À nhầm, kiếp sau!\", \"rating\": 9.5},\n  {\"id\": 709956, \"suggestedTranslation\": \"Cá không Câu Cá, sao tôi lại phải lãng phí thời gian ở đây chứ?\", \"rating\": 9.0},\n  {\"id\": 709957, \"suggestedTranslation\": \"Lũ cá không thể Câu Cá biết điều mà tự động lao vào cắn câu cho nhanh à?\", \"rating\": 8.0},\n  {\"id\": 709958, \"suggestedTranslation\": \"Tôi thực sự có thời gian để lãng phí vào việc này sao?\", \"rating\": 9.5},\n  {\"id\": 709959, \"suggestedTranslation\": \"Có lẽ tôi nên đi câu sau. Hoặc sớm hơn.\", \"rating\": 9.5},\n  {\"id\": 709960, \"suggestedTranslation\": \"Không! Suýt chút nữa thì được rồi!\", \"rating\": 9.5},\n  {\"id\": 709961, \"suggestedTranslation\": \"Tôi cần phải giữ cho dây câu căng.\", \"rating\": 9.5},\n  {\"id\": 709962, \"suggestedTranslation\": \"Tôi không thích cái Bóng đó chút nào...\", \"rating\": 10.0},\n  {\"id\": 709963, \"suggestedTranslation\": \"Tôi không nghĩ kịch bản phải diễn ra theo hướng đó đâu.\", \"rating\": 9.5},\n  {\"id\": 709964, \"suggestedTranslation\": \"À. Tôi quên mất cái tổ chính là thứ giữ cho cái bệ này gắn kết với nhau...\", \"rating\": 9.5},\n  {\"id\": 709965, \"suggestedTranslation\": \"Không, không, không! Bây giờ không phải lúc để rệu rã đâu!\", \"rating\": 9.5},\n  {\"id\": 709966, \"suggestedTranslation\": \"Được rồi, tôi đi đây, đi đây!\", \"rating\": 9.5},\n  {\"id\": 709967, \"suggestedTranslation\": \"Âm thanh kinh khủng gì thế nhỉ? Nó phát ra từ mấy cái cây à?\", \"rating\": 9.5},\n  {\"id\": 709968, \"suggestedTranslation\": \"Ớ, nó có mùi thế này là bình thường hả?\", \"rating\": 9.5},\n  {\"id\": 709969, \"suggestedTranslation\": \"Phiền phức thật! Tôi nghe thấy tiếng nhạc bắt tai của bọn chúng đang đến gần kìa!\", \"rating\": 9.5},\n  {\"id\": 709970, \"suggestedTranslation\": \"Không biết nó sẽ thành cái gì nhỉ? Hay là tôi tời thời gian tới xem trước một chút...\", \"rating\": 9.5},\n  {\"id\": 709971, \"suggestedTranslation\": \"Tôi học được điều mới rồi! Hoặc ít ra là nhớ lại thứ mình từng quên...\", \"rating\": 9.5},\n  {\"id\": 709972, \"suggestedTranslation\": \"Đó sẽ là một điểm Dây Neo mốc tuyệt vời.\", \"rating\": 8.5},\n  {\"id\": 709973, \"suggestedTranslation\": \"Được rồi mọi người, mau lên nào!\", \"rating\": 9.5},\n  {\"id\": 709974, \"suggestedTranslation\": \"Tỉnh táo lên nào, đây sẽ là một cú nhảy lớn đấy!\", \"rating\": 9.5},\n  {\"id\": 709975, \"suggestedTranslation\": \"Chúng ta đến nơi rồi! Đừng hoảng sợ, bị say thời gian một chút là chuyện hoàn toàn bình thường.\", \"rating\": 9.5},\n  {\"id\": 709976, \"suggestedTranslation\": \"Không gì tuyệt bằng một chuyến dạo chơi qua thời gian để làm tim đập rộn ràng cả!\", \"rating\": 9.5},\n  {\"id\": 709977, \"suggestedTranslation\": \"Đã đến lúc tìm mảnh đất vững chắc rồi!\", \"rating\": 9.5},\n  {\"id\": 709978, \"suggestedTranslation\": \"Dòng thời gian đang sụp đổ! Không, tệ hơn thế, là mặt đất!\", \"rating\": 9.5},\n  {\"id\": 709979, \"suggestedTranslation\": \"Lẽ ra tôi phải biết đây là sai chỗ rồi chứ.\", \"rating\": 9.5},\n  {\"id\": 709980, \"suggestedTranslation\": \"Tôi nghe thấy tiếng cào dưới lòng đất.\", \"rating\": 9.5},\n  {\"id\": 709981, \"suggestedTranslation\": \"Tôi từng thấy con Thỏ đó rồi!\", \"rating\": 10.0},\n  {\"id\": 709982, \"suggestedTranslation\": \"Chúng ta lại gặp nhau rồi!\", \"rating\": 9.5},\n  {\"id\": 709983, \"suggestedTranslation\": \"Có cái gì đó đang di chuyển bên dưới.\", \"rating\": 9.5},\n  {\"id\": 709984, \"suggestedTranslation\": \"Tôi không qua được!\", \"rating\": 9.5},\n  {\"id\": 709985, \"suggestedTranslation\": \"Tôi học hỏi rất nhanh.\", \"rating\": 9.5},\n  {\"id\": 709986, \"suggestedTranslation\": \"Th-thoáng một cái, tôi cứ tưởng mình tiêu đời rồi chứ...\", \"rating\": 9.5},\n  {\"id\": 709987, \"suggestedTranslation\": \"Phù... Tôi đến vừa đúng lúc.\", \"rating\": 9.5},\n  {\"id\": 709988, \"suggestedTranslation\": \"Đừng có hòng qua mặt tôi!!\", \"rating\": 9.5},\n  {\"id\": 709989, \"suggestedTranslation\": \"Trông bạn có vẻ vương giả đấy.\", \"rating\": 9.5},\n  {\"id\": 709990, \"suggestedTranslation\": \"Chiếc vương miện rất hợp với bạn.\", \"rating\": 9.5},\n  {\"id\": 709991, \"suggestedTranslation\": \"Tôi đang đứng trước mặt hoàng gia đấy.\", \"rating\": 9.5},\n  {\"id\": 709992, \"suggestedTranslation\": \"Trông bạn có vẻ \\\"vương giả\\\" đấy.\", \"rating\": 9.5},\n  {\"id\": 709993, \"suggestedTranslation\": \"Chiếc \\\"vương miện\\\" rất hợp với bạn.\", \"rating\": 9.5},\n  {\"id\": 709994, \"suggestedTranslation\": \"Tôi đang đứng trước mặt \\\"hoàng gia\\\" đấy.\", \"rating\": 9.5}\n]",
