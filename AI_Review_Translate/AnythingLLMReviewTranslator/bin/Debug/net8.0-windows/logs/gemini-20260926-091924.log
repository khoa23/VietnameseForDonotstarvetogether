anslation\":\"Tớ không biết chúng ta có sửa được cái này không nữa, Woby...\",\"rating\":9.5},\n  {\"id\":707726,\"suggestedTranslation\":\"Nó cháy rụi mất rồi!\",\"rating\":9.5},\n  {\"id\":707727,\"suggestedTranslation\":\"Đồ khô của bà đã sẵn sàng rồi, thưa quý cô!\",\"rating\":9.5},\n  {\"id\":707728,\"suggestedTranslation\":\"Đồ khô của bà đã sẵn sàng rồi, thưa quý cô!\",\"rating\":9.5},\n  {\"id\":707729,\"suggestedTranslation\":\"Nhìn đống muối kìa, Woby!\",\"rating\":9.5},\n  {\"id\":707730,\"suggestedTranslation\":\"Nó sẽ sẵn sàng sớm thôi.\",\"rating\":9.5},\n  {\"id\":707731,\"suggestedTranslation\":\"Ồ không, trời mưa thế này thì bao giờ mới khô được chứ!\",\"rating\":9.5},\n  {\"id\":707732,\"suggestedTranslation\":\"Ồ không, trời mưa thế này thì bao giờ mới khô được chứ!\",\"rating\":9.5},\n  {\"id\":707733,\"suggestedTranslation\":\"Nó sẽ sẵn sàng sớm thôi.\",\"rating\":9.5},\n  {\"id\":707734,\"suggestedTranslation\":\"Úi chà, chúng ta có thể phơi khô bao nhiêu thứ luôn đấy, Woby!\",\"rating\":9.5},\n  {\"id\":707735,\"suggestedTranslation\":\"Mấy cục lổn nhổn trong đó là gì thế nhỉ?\",\"rating\":9.5},\n  {\"id\":707736,\"suggestedTranslation\":\"Đúng là món thịt khô ngon tuyệt!\",\"rating\":9.5},\n  {\"id\":707737,\"suggestedTranslation\":\"Chúng ta đâu muốn ai cảm thấy bị bỏ rơi đâu, phải không Woby?\",\"rating\":9.5},\n  {\"id\":707738,\"suggestedTranslation\":\"Quái vật đầm lầy! Mình biết chúng có thật mà!\",\"rating\":9.5},\n  {\"id\":707739,\"suggestedTranslation\":\"Á chà, hội Người cá toàn được dùng đồ tốt thôi.\",\"rating\":9.5},\n  {\"id\":707740,\"suggestedTranslation\":\"Á chà, hội Người cá toàn được dùng đồ tốt thôi.\",\"rating\":9.5},\n  {\"id\":707741,\"suggestedTranslation\":\"Nó làm mình nhớ đến món câu cá nướng BBQ.\",\"rating\":9.0},\n  {\"id\":707742,\"suggestedTranslation\":\"Eo ôi, ngửi mùi tanh cá thế.\",\"rating\":9.5},\n  {\"id\":707743,\"suggestedTranslation\":\"Ngửi thấy mùi cực kỳ tanh luôn!\",\"rating\":9.5},\n  {\"id\":707744,\"suggestedTranslation\":\"Chúng là một loại quái vật đầm lầy khác à?\",\"rating\":9.5},\n  {\"id\":707745,\"suggestedTranslation\":\"Quái vật đầm lầy đến từ mặt trăng!\",\"rating\":9.5},\n  {\"id\":707746,\"suggestedTranslation\":\"Hay ghê! Vừa là quái vật đầm lầy vừa là quái vật bóng luôn!\",\"rating\":9.0},\n  {\"id\":707747,\"suggestedTranslation\":\"Giờ thì mình có thể giả dạng làm quái vật đầm lầy rồi! Thời thế thay đổi rồi nhé!\",\"rating\":9.5},\n  {\"id\":707748,\"suggestedTranslation\":\"Tiếc ghê, bằng chứng của tôi đi đời nhà ma rồi.\",\"rating\":9.5},\n  {\"id\":707749,\"suggestedTranslation\":\"Ối chà, nó không làm bằng cao su đâu! Mình nghĩ nó là hàng thật đấy!\",\"rating\":9.5},\n  {\"id\":707750,\"suggestedTranslation\":\"Mong là lũ mối đã kịp thoát ra ngoài an toàn.\",\"rating\":9.5},\n  {\"id\":707751,\"suggestedTranslation\":\"Cá là đống gỗ đó đầy mối cho mà xem.\",\"rating\":9.5},\n  {\"id\":707752,\"suggestedTranslation\":\"Thật là kinh khủng!\",\"rating\":9.5},\n  {\"id\":707753,\"suggestedTranslation\":\"Quái vật đầm lầy cũng sống trong nhà á?\",\"rating\":9.5},\n  {\"id\":707754,\"suggestedTranslation\":\"Vị vua của lũ quái vật đầm lầy!\",\"rating\":9.5},\n  {\"id\":707755,\"suggestedTranslation\":\"Mình xin lỗi vì chuyện đó nha!\",\"rating\":9.5},\n  {\"id\":707756,\"suggestedTranslation\":\"Ồ, hóa ra có cả một nền văn minh quái vật đầm lầy luôn!\",\"rating\":9.5},\n  {\"id\":707757,\"suggestedTranslation\":\"Xui ghê! Giờ thì đố mà biết nó từng là cái gì luôn!\",\"rating\":9.5},\n  {\"id\":707758,\"suggestedTranslation\":\"Trông như chúng đang xây cái gì ấy, nhưng mà là gì nhỉ?\",\"rating\":9.5},\n  {\"id\":707759,\"suggestedTranslation\":\"Chà, giống như pháo đài trên cây vậy!\",\"rating\":9.5},\n  {\"id\":707760,\"suggestedTranslation\":\"Họ thân thiện lắm!\",\"rating\":9.5},\n  {\"id\":707761,\"suggestedTranslation\":\"Éc, không cho mình ngó vào trong một chút thôi à?\",\"rating\":9.5},\n  {\"id\":707762,\"suggestedTranslation\":\"Éc, không cho mình ngó vào trong một chút thôi à?\",\"rating\":9.5},\n  {\"id\":707763,\"suggestedTranslation\":\"Quái vật đầm lầy đến từ mặt trăng!\",\"rating\":9.5},\n  {\"id\":707764,\"suggestedTranslation\":\"Tự hỏi không biết họ chọn vua kiểu gì nhỉ?\",\"rating\":9.5},\n  {\"id\":707765,\"suggestedTranslation\":\"Hay ghê! Vừa là quái vật đầm lầy vừa là quái vật bóng luôn!\",\"rating\":9.0},\n  {\"id\":707766,\"suggestedTranslation\":\"Chắc là khó lắm khi phải chế tạo đồ đạc bằng mấy cái móng vuốt thay cho bàn tay.\",\"rating\":9.5},\n  {\"id\":707767,\"suggestedTranslation\":\"Tự hỏi trong đó chúng giấu những bí mật gì của quái vật đầm lầy nhỉ...\",\"rating\":9.5},\n  {\"id\":707768,\"suggestedTranslation\":\"Tự hỏi trong đó chúng giấu những bí mật gì của quái vật đầm lầy nhỉ...\",\"rating\":9.5},\n  {\"id\":707769,\"suggestedTranslation\":\"Chắc là khó lắm khi phải chế tạo đồ đạc bằng mấy cái móng vuốt thay cho bàn tay.\",\"rating\":9.5},\n  {\"id\":707770,\"suggestedTranslation\":\"Có một tờ giấy nhắn ở bên trong.\",\"rating\":9.5},\n  {\"id\":707771,\"suggestedTranslation\":\"Chắc mình sẽ dùng nó để đựng bộ sưu tập bọ, túi của mình sắp đầy rồi.\",\"rating\":9.5},\n  {\"id\":707772,\"suggestedTranslation\":\"Tiếc ghê, mình còn chưa kịp thử nó lần nào...\",\"rating\":9.5},\n  {\"id\":707773,\"suggestedTranslation\":\"Chà! Không biết liệu có ngày nào mình khỏe được như anh WOLFGANG không...\",\"rating\":9.5},\n  {\"id\":707774,\"suggestedTranslation\":\"Woby, kiếm hộ tớ một cành cây được không? Tớ muốn chọc vào nó.\",\"rating\":9.5},\n  {\"id\":707775,\"suggestedTranslation\":\"Nhìn thấy mọi thứ giúp việc thám hiểm dễ dàng hơn nhiều.\",\"rating\":9.5},\n  {\"id\":707776,\"suggestedTranslation\":\"Nó sẽ giúp chúng ta tìm quái vật biển. Mình biết chúng đang ở ngoài đó mà!\",\"rating\":9.5},\n  {\"id\":707777,\"suggestedTranslation\":\"Mấy thứ đó chỉ dành cho trẻ con thôi!\",\"rating\":9.5},\n  {\"id\":707778,\"suggestedTranslation\":\"Đó là tín hiệu, chỉ được dùng trong trường hợp khẩn cấp thôi.\",\"rating\":9.5},\n  {\"id\":707779,\"suggestedTranslation\":\"Ai vẽ cái này thế?\",\"rating\":9.5},\n  {\"id\":707780,\"suggestedTranslation\":\"Woby, ngồi yên nào! Tớ sẽ vẽ chân dung cho cậu.\",\"rating\":9.5},\n  {\"id\":707781,\"suggestedTranslation\":\"Đâu là chỗ hoàn hảo để đặt cái này nhỉ...\",\"rating\":9.5},\n  {\"id\":707782,\"suggestedTranslation\":\"Ối, có ai bỏ mặc cậu một mình dưới này à?\",\"rating\":9.5},\n  {\"id\":707783,\"suggestedTranslation\":\"Mình phải xem bên trong có gì mới được!\",\"rating\":9.5},\n  {\"id\":707784,\"suggestedTranslation\":\"Tuyệt cú mèo! Sừng quái vật xịn luôn!\",\"rating\":9.5},\n  {\"id\":707785,\"suggestedTranslation\":\"Nó nguội ngắt rồi.\",\"rating\":9.5},\n  {\"id\":707786,\"suggestedTranslation\":\"Một bãi nhầy nhụa nóng hổi đầy ruột Mối Địa Nhiệt!\",\"rating\":9.0},\n  {\"id\":707787,\"suggestedTranslation\":\"Mình chỉ cần cẩn thận kẻo bỏng lưỡi thôi.\",\"rating\":9.5},\n  {\"id\":707788,\"suggestedTranslation\":\"Tóm lấy nó đi, Woby!\",\"rating\":9.5},\n  {\"id\":707789,\"suggestedTranslation\":\"Tôi có nó rồi! Ae ê, tôi có nó rồi nè!\",\"rating\":9.5},\n  {\"id\":707790,\"suggestedTranslation\":\"Có cái gì đang di chuyển dưới lòng đất à?\",\"rating\":9.5},\n  {\"id\":707791,\"suggestedTranslation\":\"Chắc chúng bị dị ứng nặng lắm đây.\",\"rating\":9.5},\n  {\"id\":707792,\"suggestedTranslation\":\"Có khi trong đó có gì đó thú vị đấy.\",\"rating\":9.5},\n  {\"id\":707793,\"suggestedTranslation\":\"Cái này dùng ngon hơn hẳn cái kính nhìn xuyên thấu mà tớ đặt mua qua thư hồi ở nhà!\",\"rating\":9.5},\n  {\"id\":707794,\"suggestedTranslation\":\"Tự hỏi trong đó có gì nhỉ...\",\"rating\":9.5},\n  {\"id\":707795,\"suggestedTranslation\":\"Trước giờ mình chỉ thấy chúng trong sở thú thôi!\",\"rating\":9.5},\n  {\"id\":707796,\"suggestedTranslation\":\"Chắc chỉ là một cái thùng bình thường thôi.\",\"rating\":9.5},\n  {\"id\":707797,\"suggestedTranslation\":\"Có cảm giác như chúng chưa bao giờ được học về an toàn phòng cháy chữa cháy.\",\"rating\":9.5},\n  {\"id\":707798,\"suggestedTranslation\":\"Hay ghê, một pháo đài trên cây kìa!\",\"rating\":9.5},\n  {\"id\":707799,\"suggestedTranslation\":\"Tuyệt, một cánh cổng dịch chuyển! Nó luôn như thế sao?\",\"rating\":9.5},\n  {\"id\":707800,\"suggestedTranslation\":\"Mọi người thực sự không nên vứt rác bừa bãi thế chứ.\",\"rating\":9.5},\n  {\"id\":707801,\"suggestedTranslation\":\"Tự hỏi không biết mình có trèo tuốt lên tận ngọn được không nhỉ...\",\"rating\":9.5},\n  {\"id\":707802,\"suggestedTranslation\":\"Xin chào quý cô! Ngài có cần giúp trèo xuống dưới đó không?\",\"rating\":9.5},\n  {\"id\":707803,\"suggestedTranslation\":\"Tự hỏi không biết có con khỉ thật nào đang trốn trong đó không?\",\"rating\":9.5},\n  {\"id\":707804,\"suggestedTranslation\":\"Nghe đây mọi người, tôi là thuyền trưởng!\",\"rating\":9.5},\n  {\"id\":707805,\"suggestedTranslation\":\"Trông mình giống một tên cướp biển thực thụ!\",\"rating\":9.5},\n  {\"id\":707806,\"suggestedTranslation\":\"Trông có vẻ hơi khả nghi... có lẽ Woby sẽ muốn ăn đấy.\",\"rating\":9.5},\n  {\"id\":707807,\"suggestedTranslation\":\"Hả Woby? Cậu có muốn cái này không?\",\"rating\":9.5},\n  {\"id\":707808,\"suggestedTranslation\":\"Này Woby, món khoái khẩu của cậu đây!\",\"rating\":9.5},\n  {\"id\":707809,\"suggestedTranslation\":\"Mấy thứ sang chảnh với ghê rợn hay đi chung với nhau lắm.\",\"rating\":9.5},\n  {\"id\":707810,\"suggestedTranslation\":\"Đúng là bãi chiến trường.\",\"rating\":9.5},\n  {\"id\":707811,\"suggestedTranslation\":\"Nó trông giống như có gì đó sẽ đến đây.\",\"rating\":9.5},\n  {\"id\":707812,\"suggestedTranslation\":\"Ồ! Nó vừa làm gì kìa!\",\"rating\":9.5},\n  {\"id\":707813,\"suggestedTranslation\":\"Có... có chuyện gì sắp xảy ra không vậy?\",\"rating\":9.5},\n  {\"id\":707814,\"suggestedTranslation\":\"Mình không nghĩ cách đó hiệu quả đâu...\",\"rating\":9.5},\n  {\"id\":707815,\"suggestedTranslation\":\"Mình chưa từng thấy con bướm đêm nào thế này bao giờ!\",\"rating\":9.5},\n  {\"id\":707816,\"suggestedTranslation\":\"Chui vào túi của tôi nào!\",\"rating\":9.5},\n  {\"id\":707817,\"suggestedTranslation\":\"Chúng rất mỏng manh.\",\"rating\":9.5},\n  {\"id\":707818,\"suggestedTranslation\":\"Tội nghiệp con bướm đêm.\",\"rating\":9.5},\n  {\"id\":707819,\"suggestedTranslation\":\"Mình không thể nhìn xuyên qua đá... hay là được nhỉ? ...Không.\",\"rating\":9.5},\n  {\"id\":707820,\"suggestedTranslation\":\"Hả? Mình nhìn thấy mặt trăng kìa!\",\"rating\":9.5},\n  {\"id\":707821,\"suggestedTranslation\":\"Khoan đã, đây không phải là băng đá / gai băng... mà là thủy tinh!\",\"rating\":9.0},\n  {\"id\":707822,\"suggestedTranslation\":\"Trăng tròn hay còn được gọi là lúc tuyệt nhất để hoá chó sói!\",\"rating\":9.5},\n  {\"id\":707823,\"suggestedTranslation\":\"Mình biết hết các pha của mặt trăng, đây là trăng non.\",\"rating\":9.5},\n  {\"id\":707824,\"suggestedTranslation\":\"Đó là trăng khuyết.\",\"rating\":9.5},\n  {\"id\":707825,\"suggestedTranslation\":\"Đó là trăng bán nguyệt.\",\"rating\":9.5},\n  {\"id\":707826,\"suggestedTranslation\":\"Ồ... nhẹ ghê!\",\"rating\":9.5},\n  {\"id\":707827,\"suggestedTranslation\":\"Này... chợt nghĩ ra là cái này có thể hơi nguy hiểm đấy.\",\"rating\":9.5},\n  {\"id\":707828,\"suggestedTranslation\":\"Nó nhẹ và phát sáng kìa.\",\"rating\":9.5},\n  {\"id\":707829,\"suggestedTranslation\":\"Tôi chưa từng thấy đá tảng nào thế này bao giờ.\",\"rating\":9.0},\n  {\"id\":707830,\"suggestedTranslation\":\"Đó là nơi lũ Tôm Hùm Biển dựng trại.\",\"rating\":9.5},\n  {\"id\":707831,\"suggestedTranslation\":\"Cảm giác như nó đang nhìn mình vậy.\",\"rating\":9.5},\n  {\"id\":707832,\"suggestedTranslation\":\"Thường thì mấy thứ thế này bị khóa trong ngôi đền cổ bị quái vật canh giữ.\",\"rating\":9.5},\n  {\"id\":707833,\"suggestedTranslation\":\"Nó đến từ ngoài không gian!\",\"rating\":9.5},\n  {\"id\":707834,\"suggestedTranslation\":\"Mặt trăng bị... ám à?\",\"rating\":9.5},\n  {\"id\":707835,\"suggestedTranslation\":\"Chúng ta có nên thử đập vỡ nó không Woby?\",\"rating\":9.5},\n  {\"id\":707836,\"suggestedTranslation\":\"Nhìn kìa Woby! Đó là nhà của mấy sinh vật mặt trăng!\",\"rating\":9.5},\n  {\"id\":707837,\"suggestedTranslation\":\"Mình chưa từng thấy thủy tinh do sét đánh tạo ra bao giờ!\",\"rating\":9.5},\n  {\"id\":707838,\"suggestedTranslation\":\"Nhìn kìa Woby! Nó đang phát sáng!\",\"rating\":9.5},\n  {\"id\":707839,\"suggestedTranslation\":\"Có trang bị phù hợp khi có bão là rất quan trọng.\",\"rating\":9.5},\n  {\"id\":707840,\"suggestedTranslation\":\"Đúng là nổi da gà luôn!\",\"rating\":9.5},\n  {\"id\":707841,\"suggestedTranslation\":\"Tự hỏi ông ấy đang làm gì nhỉ?\",\"rating\":9.5},\n  {\"id\":707842,\"suggestedTranslation\":\"Trông trống rỗng nhỉ Wobes.\",\"rating\":9.5},\n  {\"id\":707843,\"suggestedTranslation\":\"Cậu sẽ sốc khi thấy có gì ở bên trong đấy! Hiểu chưa? Vì bên trong có tĩnh điện mà?\",\"rating\":9.5},\n  {\"id\":707844,\"suggestedTranslation\":\"Woby, chúng ta có nên đặt tên nó là Sparky không?\",\"rating\":9.5},\n  {\"id\":707845,\"suggestedTranslation\":\"Cậu nói đúng, mọi người NÊN lắng nghe mình nhiều hơn.\",\"rating\":9.5},\n  {\"id\":707846,\"suggestedTranslation\":\"Đừng lo, một Hướng đạo sinh Thông Đỏ luôn làm đến cùng những gì đã bắt đầu!\",\"rating\":9.5},\n  {\"id\":707847,\"suggestedTranslation\":\"Mình nghĩ nó sẵn sàng rồi.\",\"rating\":9.5},\n  {\"id\":707848,\"suggestedTranslation\":\"\\\"Sắp đến giờ rồi ư\\\"? Giờ gì cơ?\",\"rating\":9.5},\n  {\"id\":707849,\"suggestedTranslation\":\"Đừng lo, bọn mình sẽ đưa cậu về nhà!\",\"rating\":9.5},\n  {\"id\":707850,\"suggestedTranslation\":\"Đừng lo, tôi sẽ giúp bạn đến nơi cần đến.\",\"rating\":9.5},\n  {\"id\":707851,\"suggestedTranslation\":\"Woby và tôi sẽ giúp các bạn đoàn tụ!\",\"rating\":9.5},\n  {\"id\":707852,\"suggestedTranslation\":\"Bạn có cần giúp gì không?\",\"rating\":9.5},\n  {\"id\":707853,\"suggestedTranslation\":\"Cái gì thế nhỉ? Ái chà, hồi hộp quá đi!\",\"rating\":9.5},\n  {\"id\":707854,\"suggestedTranslation\":\"Mình nghĩ có cái gì trong đó...\",\"rating\":9.5},\n  {\"id\":707855,\"suggestedTranslation\":\"Mình nghĩ có cái gì trong đó...\",\"rating\":9.5},\n  {\"id\":707856,\"suggestedTranslation\":\"Mình nghĩ có cái gì trong đó...\",\"rating\":9.5},\n  {\"id\":707857,\"suggestedTranslation\":\"Chúng ta phải giúp nó thôi, Woby!\",\"rating\":9.5},\n  {\"id\":707858,\"suggestedTranslation\":\"Không sao đâu, tụi mình sẽ đưa cậu về nhà sớm thôi.\",\"rating\":9.5},\n  {\"id\":707859,\"suggestedTranslation\":\"Lại thêm một cây nấm không có trong sổ tay của mình...\",\"rating\":9.5},\n  {\"id\":707860,\"suggestedTranslation\":\"Đây có vẻ không phải là ý hay cho lắm.\",\"rating\":9.5},\n  {\"id\":707861,\"suggestedTranslation\":\"Chúng ta vẫn còn một chặng đường dài phải đi.\",\"rating\":9.5},\n  {\"id\":707862,\"suggestedTranslation\":\"Sắp lắp ráp xong rồi!\",\"rating\":9.5},\n  {\"id\":707863,\"suggestedTranslation\":\"Ồ! Tự hỏi nó dùng để làm gì nhỉ?\",\"rating\":9.5},\n  {\"id\":707864,\"suggestedTranslation\":\"Cậu có nghe thấy tiếng thì thầm đó không, Woby?\",\"rating\":9.5},\n  {\"id\":707865,\"suggestedTranslation\":\"Có con quái vật nào dưới đó không?\",\"rating\":9.5},\n  {\"id\":707866,\"suggestedTranslation\":\"Cô ấy đã nhốt tất cả hồn ma mặt trăng vào lỗ của chúng.\",\"rating\":9.5},\n  {\"id\":707867,\"suggestedTranslation\":\"Đây là lý do tại sao chúng ta luôn phải thực hiện an toàn phòng cháy!\",\"rating\":9.5},\n  {\"id\":707868,\"suggestedTranslation\":\"Chắc là mọi chuyện vẫn ổn chán.\",\"rating\":9.5},\n  {\"id\":707869,\"suggestedTranslation\":\"Cái này đã bị chặt từ trước rồi.\",\"rating\":9.5},\n  {\"id\":707870,\"suggestedTranslation\":\"Cái này chắc chắn không có trong sổ tay của mình rồi.\",\"rating\":9.5},\n  {\"id\":707871,\"suggestedTranslation\":\"Ai mà biết trên mặt trăng lại có hoa cơ chứ?\",\"rating\":9.5},\n  {\"id\":707872,\"suggestedTranslation\":\"Khô hoàn hảo!\",\"rating\":9.5},\n  {\"id\":707873,\"suggestedTranslation\":\"Ồ! LẼ RA ĐÂY phải là động vật quốc gia của Canada chứ!\",\"rating\":9.5},\n  {\"id\":707874,\"suggestedTranslation\":\"Mình nóng lòng chờ chúng nở quá!\",\"rating\":9.5},\n  {\"id\":707875,\"suggestedTranslation\":\"Hình như chúng ta tìm thấy tổ của nó rồi.\",\"rating\":9.5},\n  {\"id\":707876,\"suggestedTranslation\":\"Ồ, có một đầu bếp thực thụ bên cạnh khi đi cắm trại thật là tuyệt!\",\"rating\":9.5},\n  {\"id\":707877,\"suggestedTranslation\":\"Ma cà rồng tí hon trong thế giới côn trùng.\",\"rating\":9.5},\n  {\"id\":707878,\"suggestedTranslation\":\"Giờ thì tôi ngứa ngáy hết cả người rồi đấy, hy vọng cậu vui nhé.\",\"rating\":9.5},\n  {\"id\":707879,\"suggestedTranslation\":\"Cẩn thận đấy, Woby! Tụi mình không muốn bị cuốn vào đám ve đó đâu!\",\"rating\":9.5},\n  {\"id\":707880,\"suggestedTranslation\":\"Cây cối rất thích thứ này.\",\"rating\":9.5},\n  {\"id\":707881,\"suggestedTranslation\":\"Con muỗi tội nghiệp đó...\",\"rating\":9.5},\n  {\"id\":707882,\"suggestedTranslation\":\"Đó không phải đồ chơi gặm nhấm đâu, Woby!\",\"rating\":9.5},\n  {\"id\":707883,\"suggestedTranslation\":\"May là mình không... dễ thấy ghê...\",\"rating\":9.5},\n  {\"id\":707884,\"suggestedTranslation\":\"Ồ, chúng dễ thương ghê!\",\"rating\":9.5},\n  {\"id\":707885,\"suggestedTranslation\":\"Chà, sự tò mò của mình đã được giải đáp.\",\"rating\":9.5},\n  {\"id\":707886,\"suggestedTranslation\":\"Tôi tự hỏi liệu tôi sẽ tìm được bộ xương dưới kia không.\",\"rating\":9.0},\n  {\"id\":707887,\"suggestedTranslation\":\"Mình thích dùng thanh quế làm ống hút.\",\"rating\":9.5},\n  {\"id\":707888,\"suggestedTranslation\":\"Tiếc là nó không đưa chúng ta về nhà được.\",\"rating\":9.5},\n  {\"id\":707889,\"suggestedTranslation\":\"Cái này trông xịn hơn nhiều... nhưng vẫn không đưa chúng ta về nhà được.\",\"rating\":9.5},\n  {\"id\":707890,\"suggestedTranslation\":\"Là hai công cụ trong một đấy!\",\"rating\":9.5},\n  {\"id\":707891,\"suggestedTranslation\":\"Một cây nấm sống! Ờ thì, mình đoán tất cả nấm về mặt kỹ thuật đều sống...\",\"rating\":9.0},\n  {\"id\":707892,\"suggestedTranslation\":\"Sổ tay của tôi bảo không được hái những loại nấm mình không nhận ra.\",\"rating\":9.5},\n  {\"id\":707893,\"suggestedTranslation\":\"Nó không được làm từ loại có độc đâu nhỉ?\",\"rating\":9.5},\n  {\"id\":707894,\"suggestedTranslation\":\"Thật hoài phí.\",\"rating\":9.5}\n]",
