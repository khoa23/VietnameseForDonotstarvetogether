            "text": "[\n  {\"id\": 706995, \"suggestedTranslation\": \"Cái này chắc chắn sẽ được đưa vào bộ sưu tập của mình rồi.\", \"rating\": 9.5},\n  {\"id\": 706996, \"suggestedTranslation\": \"Nhìn này, mình có thể làm còi bằng nó đấy! PHHWEEEE!\", \"rating\": 9.5},\n  {\"id\": 706997, \"suggestedTranslation\": \"Kiếm đồ chơi chỉ dành cho trẻ con thôi.\", \"rating\": 9.5},\n  {\"id\": 706998, \"suggestedTranslation\": \"Cái này không giữ được lâu đâu.\", \"rating\": 9.5},\n  {\"id\": 706999, \"suggestedTranslation\": \"Cô Wickerbottom có lẽ cần thêm... nguyên liệu đọc-sách đấy.\", \"rating\": 9.5},\n  {\"id\": 707000, \"suggestedTranslation\": \"Cũng không khó lắm đâu!\", \"rating\": 9.5},\n  {\"id\": 707001, \"suggestedTranslation\": \"Tớ cứ tưởng cậu ta sẽ vui hơn khi được tự do chứ...\", \"rating\": 9.5},\n  {\"id\": 707002, \"suggestedTranslation\": \"Chúng ta không thể cứ bỏ mặc cậu ấy như vậy được, Woby! Tớ trò mình phải giúp cậu ấy!\", \"rating\": 8.5},\n  {\"id\": 707003, \"suggestedTranslation\": \"Mình có nên giúp cậu ấy không, Woby?\", \"rating\": 9.5},\n  {\"id\": 707004, \"suggestedTranslation\": \"Đừng lo, Woby. Tớ nghĩ mình có thể lấy được lòng tin của cậu ta.\", \"rating\": 9.5},\n  {\"id\": 707005, \"suggestedTranslation\": \"Tớ vẫn nghĩ chúng ta có thể làm bạn với nhau mà.\", \"rating\": 9.5},\n  {\"id\": 707006, \"suggestedTranslation\": \"Ồ, nó chỉ là một loại đá tảng khác thôi mà.\", \"rating\": 9.5},\n  {\"id\": 707007, \"suggestedTranslation\": \"Này, thứ bên trong đó là gì vậy?\", \"rating\": 9.5},\n  {\"id\": 707008, \"suggestedTranslation\": \"Ai đó có thể bị bệnh nếu ăn thứ đó đấy!\", \"rating\": 9.5},\n  {\"id\": 707009, \"suggestedTranslation\": \"Đây chắc chắn là xương quái vật biển rồi!\", \"rating\": 9.5},\n  {\"id\": 707010, \"suggestedTranslation\": \"Cậu phải chặt cây trước, RỒI HÃY đốt lửa chứ!\", \"rating\": 9.5},\n  {\"id\": 707011, \"suggestedTranslation\": \"Cái cây đó không tài nào chờ được đến lúc làm lửa trại...\", \"rating\": 9.5},\n  {\"id\": 707012, \"suggestedTranslation\": \"Cái cây này trông cụt hứng ghê. Hì, câu hay đấy Walter.\", \"rating\": 9.0},\n  {\"id\": 707013, \"suggestedTranslation\": \"Cậu có biết từ \\\"rụng lá\\\" có nghĩa là gì không?\", \"rating\": 9.5},\n  {\"id\": 707014, \"suggestedTranslation\": \"Woah! Tớ chưa từng thấy cái cây nào có răng bao giờ!\", \"rating\": 9.5},\n  {\"id\": 707015, \"suggestedTranslation\": \"Woby! Rút một lá bài đi, lá nào cũng được!\", \"rating\": 9.5},\n  {\"id\": 707016, \"suggestedTranslation\": \"Cũng ngầu đấy. Chắc vậy.\", \"rating\": 9.5},\n  {\"id\": 707017, \"suggestedTranslation\": \"Woby, cậu ăn mất bông hoa rồi à?\", \"rating\": 9.5},\n  {\"id\": 707018, \"suggestedTranslation\": \"Oooh, hữu ích.\", \"rating\": 9.0},\n  {\"id\": 707019, \"suggestedTranslation\": \"Cẩn thận với nó đấy, Woby.\", \"rating\": 9.5},\n  {\"id\": 707020, \"suggestedTranslation\": \"Chúng ta nên tìm một cái tươi hơn đi, Woby!\", \"rating\": 9.5},\n  {\"id\": 707021, \"suggestedTranslation\": \"Trông nó có vẻ buồn thiu.\", \"rating\": 9.5},\n  {\"id\": 707022, \"suggestedTranslation\": \"Tắt nó đi khi chúng ta kể chuyện ma nhé.\", \"rating\": 9.5},\n  {\"id\": 707023, \"suggestedTranslation\": \"Nó bị ngược đầu à?\", \"rating\": 9.5},\n  {\"id\": 707024, \"suggestedTranslation\": \"Woby, có muốn vẽ tranh bằng vết chân không?\", \"rating\": 9.5},\n  {\"id\": 707025, \"suggestedTranslation\": \"Trông giống họ y đúc luôn! Phải không, Woby?\", \"rating\": 9.5},\n  {\"id\": 707026, \"suggestedTranslation\": \"Cậu có thể bị chọc mù mắt với mấy thứ đó đấy! Hay là anh ta bị từ trước rồi?\", \"rating\": 8.5},\n  {\"id\": 707027, \"suggestedTranslation\": \"Này Woby, mấy cậu có chung một thợ cắt tóc à?\", \"rating\": 9.5},\n  {\"id\": 707028, \"suggestedTranslation\": \"Woah! Là cậu à!\", \"rating\": 9.5},\n  {\"id\": 707029, \"suggestedTranslation\": \"Tớ sẽ nhớ cô ấy lắm đây.\", \"rating\": 9.5},\n  {\"id\": 707030, \"suggestedTranslation\": \"Tội nghiệp Deerclops...\", \"rating\": 9.5},\n  {\"id\": 707031, \"suggestedTranslation\": \"Nhìn kìa Woby, cô ấy không sao rồi!\", \"rating\": 9.5},\n  {\"id\": 707032, \"suggestedTranslation\": \"Cách nó cứ trân trân nhìn tớ thật là nổi da gà. Tớ thích thế.\", \"rating\": 9.5},\n  {\"id\": 707033, \"suggestedTranslation\": \"Thiếu thứ gì đó rồi. Woby, con mắt đó không phải là đồ chơi đâu!\", \"rating\": 9.5},\n  {\"id\": 707034, \"suggestedTranslation\": \"Woby, có muốn giúp tớ lắp ráp cái này không?\", \"rating\": 9.5},\n  {\"id\": 707035, \"suggestedTranslation\": \"Ít ra chúng ta cũng lấy được món đồ lưu niệm này.\", \"rating\": 9.5},\n  {\"id\": 707036, \"suggestedTranslation\": \"Này, cậu đánh rơi cái này nè!\", \"rating\": 9.5},\n  {\"id\": 707037, \"suggestedTranslation\": \"Cắm một viên ngọc trên trán chắc chẳng thoải mái gì đâu.\", \"rating\": 9.5},\n  {\"id\": 707038, \"suggestedTranslation\": \"Nó vẫn chưa mọc lại.\", \"rating\": 9.5},\n  {\"id\": 707039, \"suggestedTranslation\": \"Mặc trang phục phù hợp với thời tiết là rất quan trọng.\", \"rating\": 9.5},\n  {\"id\": 707040, \"suggestedTranslation\": \"Cậu sẽ không còn mùi chó ướt nữa đâu, Woby!\", \"rating\": 9.5},\n  {\"id\": 707041, \"suggestedTranslation\": \"Nó đúng là giúp tớ khô ráo và thoải mái thật.\", \"rating\": 9.5},\n  {\"id\": 707042, \"suggestedTranslation\": \"Lạ thật! Trông nó giống một cái rìu, nhưng mà...\", \"rating\": 9.5},\n  {\"id\": 707043, \"suggestedTranslation\": \"Chắc tớ chưa đạt được huy hiệu đó rồi.\", \"rating\": 9.5},\n  {\"id\": 707044, \"suggestedTranslation\": \"Woby, cậu vừa đào được gì lên à?\", \"rating\": 9.5},\n  {\"id\": 707045, \"suggestedTranslation\": \"Lạnh dần rồi... chắc là đi nhầm hướng rồi.\", \"rating\": 9.5},\n  {\"id\": 707046, \"suggestedTranslation\": \"Này! Trông nó rất giống cái đài phát thanh đó!\", \"rating\": 9.5},\n  {\"id\": 707047, \"suggestedTranslation\": \"Chúng ta đang bám rất sát manh mối rồi đấy, Woby!\", \"rating\": 9.5},\n  {\"id\": 707048, \"suggestedTranslation\": \"Hơi ấm lên rồi...\", \"rating\": 9.5},\n  {\"id\": 707049, \"suggestedTranslation\": \"Ấm hơn rồi...\", \"rating\": 9.5},\n  {\"id\": 707050, \"suggestedTranslation\": \"Trông có vẻ quan trọng đấy.\", \"rating\": 9.5},\n  {\"id\": 707051, \"suggestedTranslation\": \"Biết đâu tớ có thể mở khóa nó bằng thứ gì đó...\", \"rating\": 9.5},\n  {\"id\": 707052, \"suggestedTranslation\": \"Thành công rồi!\", \"rating\": 9.5},\n  {\"id\": 707053, \"suggestedTranslation\": \"Này! Trông nó rất giống cái đài phát thanh đó!\", \"rating\": 9.5},\n  {\"id\": 707054, \"suggestedTranslation\": \"Hay ghê, tớ có thể xây một bến tàu cho chiếc thuyền ván của mình!\", \"rating\": 9.5},\n  {\"id\": 707055, \"suggestedTranslation\": \"Vài cái cọc sẽ làm cho bến tàu trông... giống bến tàu hơn nữa.\", \"rating\": 9.5},\n  {\"id\": 707056, \"suggestedTranslation\": \"Aww, dễ thương quá!\", \"rating\": 9.5},\n  {\"id\": 707057, \"suggestedTranslation\": \"Tránh ra nào mọi người, việc này để Hướng đạo sinh Thông Xanh lo.\", \"rating\": 9.5},\n  {\"id\": 707058, \"suggestedTranslation\": \"Chà, sao họ có thể đóng gói mọi thứ gọn gàng thế nhỉ?\", \"rating\": 9.5},\n  {\"id\": 707059, \"suggestedTranslation\": \"Tớ nghĩ tớ làm đầu tàu sẽ tốt hơn.\", \"rating\": 9.5},\n  {\"id\": 707060, \"suggestedTranslation\": \"Nó được làm từ rồng thật à?\", \"rating\": 9.5},\n  {\"id\": 707061, \"suggestedTranslation\": \"Woah! Là một con bọ khổng lồ!\", \"rating\": 9.5},\n  {\"id\": 707062, \"suggestedTranslation\": \"Chúng ta phải tìm thứ gì đó xứng đáng để cất vào đó mới được.\", \"rating\": 9.5},\n  {\"id\": 707063, \"suggestedTranslation\": \"Càng giữ được nhiều đồ vật an toàn trong két sắt khỏi lửa thì càng tốt!\", \"rating\": 9.0},\n  {\"id\": 707064, \"suggestedTranslation\": \"Nhưng tớ có nướng kẹo dẻo trên đó được không nhỉ?\", \"rating\": 9.5},\n  {\"id\": 707065, \"suggestedTranslation\": \"...Cách đó không sửa được nó đâu.\", \"rating\": 9.5},\n  {\"id\": 707066, \"suggestedTranslation\": \"Nóng giòn luôn!\", \"rating\": 9.5},\n  {\"id\": 707067, \"suggestedTranslation\": \"Ấm áp ghê!\", \"rating\": 9.5},\n  {\"id\": 707068, \"suggestedTranslation\": \"Trông có vẻ ngon đấy.\", \"rating\": 9.5},\n  {\"id\": 707069, \"suggestedTranslation\": \"Thảo nào thanh long ăn với lửa lại ngon hơn.\", \"rating\": 9.5},\n  {\"id\": 707070, \"suggestedTranslation\": \"Đáng tiếc là không phải rồng thật.\", \"rating\": 9.5},\n  {\"id\": 707071, \"suggestedTranslation\": \"Hãy tìm thực vật nào đó để trồng chúng đi.\", \"rating\": 9.5},\n  {\"id\": 707072, \"suggestedTranslation\": \"Tớ sẽ làm đội trưởng!\", \"rating\": 9.5},\n  {\"id\": 707073, \"suggestedTranslation\": \"Nó được làm từ rồng thật hả?\", \"rating\": 9.5},\n  {\"id\": 707074, \"suggestedTranslation\": \"Tớ không muốn làm đuôi đâu...\", \"rating\": 9.5},\n  {\"id\": 707075, \"suggestedTranslation\": \"Cô ấy là bọ hay thằn lằn thế nhỉ?\", \"rating\": 9.5},\n  {\"id\": 707076, \"suggestedTranslation\": \"Nó chỉ là một đá tảng thôi, có gì mà đáng sợ chứ?\", \"rating\": 9.5},\n  {\"id\": 707077, \"suggestedTranslation\": \"Đừng bao giờ quên đội chiếc mũ hắc ám của mình nhé.\", \"rating\": 9.5},\n  {\"id\": 707078, \"suggestedTranslation\": \"Tớ cá là còn nhiều thứ nữa được chôn sâu dưới lòng đất đấy!\", \"rating\": 9.5},\n  {\"id\": 707079, \"suggestedTranslation\": \"Cậu cũng sẽ nổi lên nếu bám chặt lấy nó đấy!\", \"rating\": 9.5},\n  {\"id\": 707080, \"suggestedTranslation\": \"Cậu phải đào hố, gom củi rồi HÃY nhóm lửa chứ!\", \"rating\": 9.5},\n  {\"id\": 707081, \"suggestedTranslation\": \"Suýt thì rắc rối to.\", \"rating\": 9.5},\n  {\"id\": 707082, \"suggestedTranslation\": \"Cảm ơn vì đống củi nhé, cây ơi!\", \"rating\": 9.5},\n  {\"id\": 707083, \"suggestedTranslation\": \"Trông có vẻ hơi rợn tóc gáy nhỉ?\", \"rating\": 9.5},\n  {\"id\": 707084, \"suggestedTranslation\": \"Ăn thịt sống có phải là ý hay không...?\", \"rating\": 9.5},\n  {\"id\": 707085, \"suggestedTranslation\": \"Thế này thì thích hơn rồi!\", \"rating\": 9.5},\n  {\"id\": 707086, \"suggestedTranslation\": \"Khoan đã, tớ cứ tưởng chuối mọc trên cây ở quanh đây chứ?\", \"rating\": 9.5},\n  {\"id\": 707087, \"suggestedTranslation\": \"Nào bụi dâu ơi, chúng ta chuẩn bị đi phiêu lưu thôi!\", \"rating\": 9.5},\n  {\"id\": 707088, \"suggestedTranslation\": \"Nào bụi dâu ơi, chúng ta chuẩn bị đi phiêu lưu thôi!\", \"rating\": 9.5},\n  {\"id\": 707089, \"suggestedTranslation\": \"Giờ thì tớ có thể trồng thực vật đó gần khu cắm trại hơn rồi.\", \"rating\": 9.5},\n  {\"id\": 707090, \"suggestedTranslation\": \"Này Woby, cậu có thấy chỗ nào ngon nghẻ để trồng thực vật này không?\", \"rating\": 9.5},\n  {\"id\": 707091, \"suggestedTranslation\": \"Tớ tự hỏi có con khỉ thật nào đang trốn trong đó không nhỉ?\", \"rating\": 9.5},\n  {\"id\": 707092, \"suggestedTranslation\": \"Này Woby, cậu có thấy chỗ nào ngon nghẻ để trồng thực vật này không?\", \"rating\": 9.5},\n  {\"id\": 707093, \"suggestedTranslation\": \"Tớ đang phạt bọn chúng đứng góc phòng đấy.\", \"rating\": 9.5},\n  {\"id\": 707094, \"suggestedTranslation\": \"Tớ làm được mà! Chỉ là... cần cầm chắc nó hơn chút thôi!\", \"rating\": 9.5},\n  {\"id\": 707095, \"suggestedTranslation\": \"Bạn sẽ có một buổi tập luyện cực kỳ lạnh lẽo với nó! Hì. Hay đấy, Walter.\", \"rating\": 9.0},\n  {\"id\": 707096, \"suggestedTranslation\": \"Đến lúc đập viên ngọc rồi! Hiểu ý tớ chứ? Vì \\\"gem\\\" nghe gần giống \\\"gym\\\" mà!\", \"rating\": 9.5},\n  {\"id\": 707097, \"suggestedTranslation\": \"Ừm, c-chắc tớ nên bắt đầu với cái gì nhẹ hơn một chút.\", \"rating\": 9.5},\n  {\"id\": 707098, \"suggestedTranslation\": \"Tớ có thể làm ấm người mà chẳng cần nâng cái gì cả! K-không phải là tớ không nâng được đâu nhé!\", \"rating\": 9.5},\n  {\"id\": 707099, \"suggestedTranslation\": \"Ồ... lúc anh ta nói nó được làm bằng đá cẩm thạch, tớ cứ hy vọng là loại viên bi nhỏ cơ.\", \"rating\": 9.5},\n  {\"id\": 707100, \"suggestedTranslation\": \"Tớ không nghĩ cơ bắp của cậu nên đau buốt đến MỨC ĐÓ đâu...\", \"rating\": 9.5},\n  {\"id\": 707101, \"suggestedTranslation\": \"Eo! Gì thế kia?\", \"rating\": 9.5},\n  {\"id\": 707102, \"suggestedTranslation\": \"Thôi cảm ơn.\", \"rating\": 9.5},\n  {\"id\": 707103, \"suggestedTranslation\": \"Sao quả này lại phải lớn thế cơ chứ?\", \"rating\": 9.5},\n  {\"id\": 707104, \"suggestedTranslation\": \"Chuẩn rồi, hạt đấy!\", \"rating\": 9.5},\n  {\"id\": 707105, \"suggestedTranslation\": \"Ờ... thôi khỏi. Chắc lũ bướm đêm sẽ thích nhỉ?\", \"rating\": 9.5},\n  {\"id\": 707106, \"suggestedTranslation\": \"Mình nuôi chúng được không? Xin đấyyyyy?\", \"rating\": 9.5},\n  {\"id\": 707107, \"suggestedTranslation\": \"Ồ, hóa ra chất liệu kỳ lạ đó xuất phát từ đây!\", \"rating\": 9.5},\n  {\"id\": 707108, \"suggestedTranslation\": \"Đâu phải ai cũng có lớp lông tai tự nhiên như tụi mình đâu, Woby.\", \"rating\": 9.5},\n  {\"id\": 707109, \"suggestedTranslation\": \"Nhìn hàm răng của nó kìa!\", \"rating\": 9.5},\n  {\"id\": 707110, \"suggestedTranslation\": \"Ngửi thơm phết đấy chứ!\", \"rating\": 9.5},\n  {\"id\": 707111, \"suggestedTranslation\": \"Ngay cả chốn hoang dã này thì cậu cũng phải ăn rau củ thôi.\", \"rating\": 9.5},\n  {\"id\": 707112, \"suggestedTranslation\": \"Ồ, nấu lên ăn ngon hơn hẳn!\", \"rating\": 9.5},\n  {\"id\": 707113, \"suggestedTranslation\": \"Ồ... tuyệt! Chắc tuần tới chúng ta chỉ ăn cà tím thôi quá...\", \"rating\": 9.5},\n  {\"id\": 707114, \"suggestedTranslation\": \"Chúng ta nên tìm chỗ để gieo thực vật này.\", \"rating\": 9.5},\n  {\"id\": 707115, \"suggestedTranslation\": \"Thành phần bên trong không an toàn trong két sắt cho con người tiêu thụ!\", \"rating\": 9.0},\n  {\"id\": 707116, \"suggestedTranslation\": \"Đống lửa trại này không có gỗ. Thôi kệ.\", \"rating\": 9.5},\n  {\"id\": 707117, \"suggestedTranslation\": \"Đó là cách mà cháy rừng bắt đầu đấy!\", \"rating\": 9.5},\n  {\"id\": 707118, \"suggestedTranslation\": \"Này... tớ tưởng vừa thấy có gì đó chuyển động dưới đó.\", \"rating\": 9.5},\n  {\"id\": 707119, \"suggestedTranslation\": \"Ta-da! Ánh sáng!\", \"rating\": 9.5},\n  {\"id\": 707120, \"suggestedTranslation\": \"Có ai đang trang trí ở ngoài này à?\", \"rating\": 9.5},\n  {\"id\": 707121, \"suggestedTranslation\": \"Có vẻ chúng ta cần thay bóng đèn rồi.\", \"rating\": 9.5},\n  {\"id\": 707122, \"suggestedTranslation\": \"Mấy bông hoa đó trông buồn thiu nhỉ.\", \"rating\": 9.5},\n  {\"id\": 707123, \"suggestedTranslation\": \"Cậu phải chặt cây trước, RỒI HÃY nhóm lửa chứ!\", \"rating\": 9.5},\n  {\"id\": 707124, \"suggestedTranslation\": \"Cái cây đó không thể chờ đợi để được làm lửa trại nữa rồi...\", \"rating\": 9.5},\n  {\"id\": 707125, \"suggestedTranslation\": \"Cái cây này trông cụt hứng ghê. Heh, được đấy WALTER.\", \"rating\": 9.0},\n  {\"id\": 707126, \"suggestedTranslation\": \"Người ta gọi thông thẳng là \\\"evergreen\\\" vì... ừm chắc cậu hiểu ý mà.\", \"rating\": 9.0},\n  {\"id\": 707127, \"suggestedTranslation\": \"Cậu phải chặt cây trước, RỒI HÃY nhóm lửa chứ!\", \"rating\": 9.5},\n  {\"id\": 707128, \"suggestedTranslation\": \"Cái cây đó không thể chờ đợi để được làm lửa trại nữa rồi...\", \"rating\": 9.5},\n  {\"id\": 707129, \"suggestedTranslation\": \"Cái cây này trông cụt hứng ghê. Heh, được đấy WALTER.\", \"rating\": 9.0},\n  {\"id\": 707130, \"suggestedTranslation\": \"Đúng là một cái cây xơ xác.\", \"rating\": 9.5},\n  {\"id\": 707131, \"suggestedTranslation\": \"Nó đang theo dõi tớ kìa. Hiểu chưa? Vì nó là một con mắt khổng lồ mà?\", \"rating\": 9.5},\n  {\"id\": 707132, \"suggestedTranslation\": \"Đừng lo Woby. Chỉ là một chiếc mũ thôi mà, thấy chưa?\", \"rating\": 9.5},\n  {\"id\": 707133, \"suggestedTranslation\": \"Ồ! Cậu nghĩ nó sổng ra từ một cái đầu khổng lồ à?\", \"rating\": 9.5},\n  {\"id\": 707134, \"suggestedTranslation\": \"Cậu có nghĩ chúng đang... nhân l-eyên không? Heh. Hay đấy, WALTER.\", \"rating\": 9.0},\n  {\"id\": 707135, \"suggestedTranslation\": \"Ồh, hóa ra mấy con mắt em bé được tạo ra như thế.\", \"rating\": 9.5},\n  {\"id\": 707136, \"suggestedTranslation\": \"Tớ cược là nó thân thiện đấy!\", \"rating\": 9.5},\n  {\"id\": 707137, \"suggestedTranslation\": \"Nó đang để mắt tới tớ kìa! Hiểu chưa? Vì nó là... cậu biết đấy...\", \"rating\": 9.5},\n  {\"id\": 707138, \"suggestedTranslation\": \"Nào Woby, đi tìm một chỗ đẹp để đặt cái này thôi!\", \"rating\": 9.5},\n  {\"id\": 707139, \"suggestedTranslation\": \"Khỉ thật, giờ tớ phải làm lại từ đầu rồi!\", \"rating\": 9.5},\n  {\"id\": 707140, \"suggestedTranslation\": \"Mẹ chưa bao giờ cho tớ vào vườn của mình... kể từ Sự cố Con Sên.\", \"rating\": 9.5},\n  {\"id\": 707141, \"suggestedTranslation\": \"Này! Tớ khá giỏi khoản này đấy chứ!\", \"rating\": 9.5},\n  {\"id\": 707142, \"suggestedTranslation\": \"Nó cần thứ gì đó để giúp lớn lên...\", \"rating\": 9.5},\n  {\"id\": 707143, \"suggestedTranslation\": \"Chúng ta sẽ cần cái đó để trồng thực vật và hạt.\", \"rating\": 9.5},\n  {\"id\": 707144, \"suggestedTranslation\": \"Mấy thứ đó... ừm có lẽ cần ít nước đấy.\", \"rating\": 9.5},\n  {\"id\": 707145, \"suggestedTranslation\": \"Tớ nghĩ nó sẵn sàng để thu hoạch rồi!\", \"rating\": 9.5},\n  {\"id\": 707146, \"suggestedTranslation\": \"Chà, đúng là một con quái vật!\", \"rating\": 9.5},\n  {\"id\": 707147, \"suggestedTranslation\": \"Này, cậu không phải rau củ đâu nhé!\", \"rating\": 9.5},\n  {\"id\": 707148, \"suggestedTranslation\": \"Đó là một trong số các loài thực vật của chúng ta.\", \"rating\": 9.5},\n  {\"id\": 707149, \"suggestedTranslation\": \"Tớ sẽ chăm sóc cậu thật tốt, đừng lo lắng nhé.\", \"rating\": 9.5},\n  {\"id\": 707150, \"suggestedTranslation\": \"Ôi... Lẽ ra tớ nên hái nó sớm hơn.\", \"rating\": 9.5},\n  {\"id\": 707151, \"suggestedTranslation\": \"Nó hỏng hết cả rồi!\", \"rating\": 9.5},\n  {\"id\": 707152, \"suggestedTranslation\": \"Nhìn kìa Woby, nó đang lớn lên đấy!\", \"rating\": 9.5},\n  {\"id\": 707153, \"suggestedTranslation\": \"Này, làm ruộng có vẻ không khó lắm nhỉ!\", \"rating\": 9.5},\n  {\"id\": 707154, \"suggestedTranslation\": \"Muốn giúp tớ tìm một chỗ đẹp để làm vườn không, Woby?\", \"rating\": 9.5},\n  {\"id\": 707155, \"suggestedTranslation\": \"Tốt hơn là chúng ta nên dọn dẹp đống đó.\", \"rating\": 9.5},\n  {\"id\": 707156, \"suggestedTranslation\": \"Tớ rất hâm mộ việc giữ cho đầu óc mát mẻ. Hiểu chưa, vì đó là cái quạt mà?\", \"rating\": 9.5},\n  {\"id\": 707157, \"suggestedTranslation\": \"Và tớ cứ tưởng huy hiệu quan sát chim chóc của mình là một điểm sáng lớn cơ chứ!\", \"rating\": 9.5},\n  {\"id\": 707158, \"suggestedTranslation\": \"Tớ cảm thấy mình nên viết vài vần thơ với thứ này...\", \"rating\": 9.5},\n  {\"id\": 707159, \"suggestedTranslation\": \"Trông giống lông chim hoàng yến.\", \"rating\": 9.5},\n  {\"id\": 707160, \"suggestedTranslation\": \"Trông giống lông chim đen.\", \"rating\": 9.5},\n  {\"id\": 707161, \"suggestedTranslation\": \"Trông giống lông chim đỏ.\", \"rating\": 9.5},\n  {\"id\": 707162, \"suggestedTranslation\": \"Trông giống lông chim tuyết.\", \"rating\": 9.5},\n  {\"id\": 707163, \"suggestedTranslation\": \"Đừng lo, một Hướng đạo sinh Thông Đỏ luôn giúp đỡ những ai gặp khó khăn!\", \"rating\": 9.5},\n  {\"id\": 707164, \"suggestedTranslation\": \"Cần gì hàng rào chứ, bạn sợ à\", \"rating\": 9.0},\n  {\"id\": 707165, \"suggestedTranslation\": \"Đừng lo, Wobes. Nó chưa được cắm điện đâu.\", \"rating\": 9.5},\n  {\"id\": 707166, \"suggestedTranslation\": \"Tránh ra nào, Woby!\", \"rating\": 9.5},\n  {\"id\": 707167, \"suggestedTranslation\": \"Chúng ta phải trồng thực vật đó xuống trước đã.\", \"rating\": 9.5},\n  {\"id\": 707168, \"suggestedTranslation\": \"Nó đóng mở dễ dàng.\", \"rating\": 9.5},\n  {\"id\": 707169, \"suggestedTranslation\": \"Chắc tớ phải tìm chỗ nào đó để đặt cái này.\", \"rating\": 9.5},\n  {\"id\": 707170, \"suggestedTranslation\": \"Sao lại rào giậu thiên nhiên lại làm gì?\", \"rating\": 9.5},\n  {\"id\": 707171, \"suggestedTranslation\": \"Tớ đoán thế này vẫn đỡ hơn là vứt đống sắt vụn đó lăn lóc.\", \"rating\": 9.5},\n  {\"id\": 707172, \"suggestedTranslation\": \"Ồ. Tớ không biết là người ta dùng kiếm để sửa hàng rào đấy.\", \"rating\": 9.5},\n  {\"id\": 707173, \"suggestedTranslation\": \"Cây cối rất thích phân bón.\", \"rating\": 9.5},\n  {\"id\": 707174, \"suggestedTranslation\": \"Cá với một vài loại gia vị theo mùa đặc biệt dùng để câu cá.\", \"rating\": 9.0},\n  {\"id\": 707175, \"suggestedTranslation\": \"Ước gì tớ có thể làm một cái cho Woby, nhưng số đo của cậu ấy cứ thay đổi mãi...\", \"rating\": 9.5},\n  {\"id\": 707176, \"suggestedTranslation\": \"Tớ không thích ăn sung cho lắm...\", \"rating\": 9.5},\n  {\"id\": 707177, \"suggestedTranslation\": \"Ít ra thì quả vả cũng đã bị giấu bên trong rồi.\", \"rating\": 9.5},\n  {\"id\": 707178, \"suggestedTranslation\": \"Ối trời, cứ phải là sung sao?\", \"rating\": 9.5},\n  {\"id\": 707179, \"suggestedTranslation\": \"Tớ cũng chẳng thấy sung nấu chín ngon hơn chút nào...\", \"rating\": 9.5},\n  {\"id\": 707180, \"suggestedTranslation\": \"Nó gọi một thiên thạch từ trên trời xuống.\", \"rating\": 9.5},\n  {\"id\": 707181, \"suggestedTranslation\": \"Cậu không được phép đốt pháo trong rừng đâu đấy.\", \"rating\": 9.5},\n  {\"id\": 707182, \"suggestedTranslation\": \"Ước gì tớ có một chiếc lọ.\", \"rating\": 9.5},\n  {\"id\": 707183, \"suggestedTranslation\": \"Hy vọng chúng sẽ hòa hợp với mấy con bọ khác trong túi tớ.\", \"rating\": 9.5},\n  {\"id\": 707184, \"suggestedTranslation\": \"Ai là cún ngoan nào?\", \"rating\": 9.5},\n  {\"id\": 707185, \"suggestedTranslation\": \"Chúng còn tệ hơn cả cây sơn độc ấy chứ!\", \"rating\": 9.5},\n  {\"id\": 707186, \"suggestedTranslation\": \"Được phơi khô hoàn hảo!\", \"rating\": 9.5},\n  {\"id\": 707187, \"suggestedTranslation\": \"Tớ không ngờ việc viết lách lại nguy hiểm thế đấy.\", \"rating\": 9.5},\n  {\"id\": 707188, \"suggestedTranslation\": \"Chúng ta cần thêm củi cho lửa!\", \"rating\": 9.5},\n  {\"id\": 707189, \"suggestedTranslation\": \"Có ai muốn nghe một câu chuyện ma không?\", \"rating\": 9.5},\n  {\"id\": 707190, \"suggestedTranslation\": \"Ôi! Tớ không nghĩ thế là an toàn trong két sắt đâu...\", \"rating\": 9.0},\n  {\"id\": 707191, \"suggestedTranslation\": \"Chắc tớ phải cấp thêm chút củi cho đống lửa rồi.\", \"rating\": 9.5},\n  {\"id\": 707192, \"suggestedTranslation\": \"Nhiệt độ này hoàn hảo để nướng kẹo dẻo marshmallow rồi!\", \"rating\": 9.5},\n  {\"id\": 707193, \"suggestedTranslation\": \"Lò lửa đã được xây xong rồi, tất cả những gì chúng ta cần là thêm gỗ!\", \"rating\": 9.5},\n  {\"id\": 707194, \"suggestedTranslation\": \"Tốt hơn là tớ nên giữ cái này tránh xa mấy đứa nhỏ ra... và cả Willow.\", \"rating\": 9.5},\n  {\"id\": 707195, \"suggestedTranslation\": \"Chúng ta nên tiếp thêm nhiên liệu cho nó.\", \"rating\": 9.5},\n  {\"id\": 707196, \"suggestedTranslation\": \"Nó đang tiết kiệm năng lượng.\", \"rating\": 9.5},\n  {\"id\": 707197, \"suggestedTranslation\": \"Thế này chắc sẽ giữ cho trại của chúng ta không bị lửa bén... hy vọng là thế.\", \"rating\": 9.5},\n  {\"id\": 707198, \"suggestedTranslation\": \"Tớ cực giỏi câu cá đấy! Tớ có hẳn huy hiệu và mọi thứ luôn!\", \"rating\": 9.5},\n  {\"id\": 707199, \"suggestedTranslation\": \"Này Woby, muốn đi câu cá không?\", \"rating\": 9.5},\n  {\"id\": 707200, \"suggestedTranslation\": \"Đó là cần câu, dùng để câu cá.\", \"rating\": 9.5},\n  {\"id\": 707201, \"suggestedTranslation\": \"Ăn sống có sao không ta?\", \"rating\": 9.5},\n  {\"id\": 707202, \"suggestedTranslation\": \"Tự câu cá của riêng bạn và ăn nó, một điều mà một sinh tồn gia thực thụ hay làm!\", \"rating\": 9.5},\n  {\"id\": 707203, \"suggestedTranslation\": \"Đó là một ít thịt khô câu cá ngon phết đấy!\", \"rating\": 9.0},\n  {\"id\": 707204, \"suggestedTranslation\": \"Chắc mình dùng nó làm mồi câu cá con cá to hơn được đấy.\", \"rating\": 9.0},\n  {\"id\": 707205, \"suggestedTranslation\": \"Thơm quá!\", \"rating\": 9.5},\n  {\"id\": 707206, \"suggestedTranslation\": \"Có ít thịt khô còn hơn không có gì.\", \"rating\": 9.5},\n  {\"id\": 707207, \"suggestedTranslation\": \"Ngon lành, bổ dưỡng và đậm vị cá.\", \"rating\": 9.5},\n  {\"id\": 707208, \"suggestedTranslation\": \"Món câu cá ngon nhất luôn!\", \"rating\": 9.0},\n  {\"id\": 707209, \"suggestedTranslation\": \"Cái đó sẽ giữ cá câu của chúng ta luôn tươi ngon!\", \"rating\": 9.0},\n  {\"id\": 707210, \"suggestedTranslation\": \"Tự câu và nấu cá chính là tinh thần của việc cắm trại!\", \"rating\": 9.5},\n  {\"id\": 707211, \"suggestedTranslation\": \"Cái này thể nào cũng có ích cho xem!\", \"rating\": 9.5},\n  {\"id\": 707212, \"suggestedTranslation\": \"Hic, đẹp thế mà ngắn ngủi ghê.\", \"rating\": 9.5},\n  {\"id\": 707213, \"suggestedTranslation\": \"Nhìn lên trên đi, Woby!\", \"rating\": 9.5},\n  {\"id\": 707214, \"suggestedTranslation\": \"Chúng ta có nên thắp sáng không khí lên chút không, Wobes?\", \"rating\": 9.5},\n  {\"id\": 707215, \"suggestedTranslation\": \"Bọn mình rất yêu an toàn dưới nước! Phải không Wobes?\", \"rating\": 9.5},\n  {\"id\": 707216, \"suggestedTranslation\": \"Trên đó có con bọ nào không ta?\", \"rating\": 9.5},\n  {\"id\": 707217, \"suggestedTranslation\": \"Lạ thật, đây không phải loại hoa hồng hay mọc ngoài tự nhiên.\", \"rating\": 9.5},\n  {\"id\": 707218, \"suggestedTranslation\": \"Này, trông đẹp phết chứ lị!\", \"rating\": 9.5},\n  {\"id\": 707219, \"suggestedTranslation\": \"Ngay cả lá cây nhặt nhạnh cũng có thể thành đồ ăn ở chốn hoang dã mà!\", \"rating\": 9.5},\n  {\"id\": 707220, \"suggestedTranslation\": \"Mấy bông hoa này chu đáo thật đấy, thắp sáng đường đi cho tụi mình luôn!\", \"rating\": 9.5},\n  {\"id\": 707221, \"suggestedTranslation\": \"Tự hỏi sao nó lại đang héo úa nhỉ.\", \"rating\": 9.5},\n  {\"id\": 707222, \"suggestedTranslation\": \"Woby, sao thế? Chỉ là một hoa thôi mà.\", \"rating\": 9.5},\n  {\"id\": 707223, \"suggestedTranslation\": \"Mình nên tưới nhiều nước hơn hay ít nước đi đây?!\", \"rating\": 9.5},\n  {\"id\": 707224, \"suggestedTranslation\": \"Cái này mà nhóm lửa trại thì tuyệt cú mèo.\", \"rating\": 9.5},\n  {\"id\": 707225, \"suggestedTranslation\": \"Khô hoàn hảo luôn!\", \"rating\": 9.5},\n  {\"id\": 707226, \"suggestedTranslation\": \"Ơ, bóng đá á! Ừ thì... tớ chơi bóng đá giỏi lắm...\", \"rating\": 9.5},\n  {\"id\": 707227, \"suggestedTranslation\": \"Tớ cứ hay quên tra cứu chúng trong cẩm nang của mình.\", \"rating\": 9.5},\n  {\"id\": 707228, \"suggestedTranslation\": \"Khô hoàn hảo luôn!\", \"rating\": 9.5},\n  {\"id\": 707229, \"suggestedTranslation\": \"Cái này có vẻ không thực tế lắm cho việc ở ngoài trời.\", \"rating\": 9.5},\n  {\"id\": 707230, \"suggestedTranslation\": \"Xương của một sinh vật cổ đại kìa!\", \"rating\": 9.5},\n  {\"id\": 707231, \"suggestedTranslation\": \"Tớ nghĩ tụi mình làm được rồi đấy Woby!\", \"rating\": 9.5},\n  {\"id\": 707232, \"suggestedTranslation\": \"\\\"Xương tay nối với xương...\\\" xương nào ấy nhờ...\", \"rating\": 9.5},\n  {\"id\": 707233, \"suggestedTranslation\": \"Vẫn còn thiếu thứ gì đó.\", \"rating\": 9.5},\n  {\"id\": 707234, \"suggestedTranslation\": \"Làm từ trái cây rừng mới hái đấy.\", \"rating\": 9.5},\n  {\"id\": 707235, \"suggestedTranslation\": \"Tớ sẽ gọi cậu là Buzzy nhé!\", \"rating\": 9.5},\n  {\"id\": 707236, \"suggestedTranslation\": \"Tội nghiệp chú ta quá.\", \"rating\": 9.5},\n  {\"id\": 707237, \"suggestedTranslation\": \"Trông không giống mấy con ếch trong cẩm nang của tớ cho lắm...\", \"rating\": 9.5},\n  {\"id\": 707238, \"suggestedTranslation\": \"Chúc cậu có những giấc mơ ngọt ngào ngập tràn ruồi nhé.\", \"rating\": 9.5},\n  {\"id\": 707239, \"suggestedTranslation\": \"Er... có lẽ Woby muốn một vài.\", \"rating\": 9.5},\n  {\"id\": 707240, \"suggestedTranslation\": \"Cậu có thể kẹp gì vào bánh mì cũng được miễn là cố gắng hết sức.\", \"rating\": 9.5},\n  {\"id\": 707241, \"suggestedTranslation\": \"Tớ không nghĩ chúng chín rồi đâu, vẫn còn xanh lắm.\", \"rating\": 9.5},\n  {\"id\": 707242, \"suggestedTranslation\": \"Trông không sang chảnh như tớ tưởng tượng cho lắm.\", \"rating\": 9.5},\n  {\"id\": 707243, \"suggestedTranslation\": \"Này, ngon phết đấy chứ! Trong này có gì thế?\", \"rating\": 9.5},\n  {\"id\": 707244, \"suggestedTranslation\": \"Đừng uống nhanh quá kẻo lại đau đầu đấy.\", \"rating\": 9.5},\n  {\"id\": 707245, \"suggestedTranslation\": \"Một con thằn lằn nhỏ xíu!\", \"rating\": 9.5},\n  {\"id\": 707246, \"suggestedTranslation\": \"Tớ thề là cách đây một giây nó còn màu xanh mà.\", \"rating\": 9.5},\n  {\"id\": 707247, \"suggestedTranslation\": \"Lúc ngủ trông chúng còn đáng yêu hơn nữa.\", \"rating\": 9.5},\n  {\"id\": 707248, \"suggestedTranslation\": \"Chúng chỉ đang làm những gì mà con bọ hay làm! Tôi ước rằng chúng đừng làm nó trên thực vật của tôi thôi.\", \"rating\": 9.0},\n  {\"id\": 707249, \"suggestedTranslation\": \"Lũ Ruồi Giấm hình như rất thích bay theo bám lấy nó.\", \"rating\": 9.5},\n  {\"id\": 707250, \"suggestedTranslation\": \"Tốt cho sức khỏe lắm đấy!\", \"rating\": 9.5},\n  {\"id\": 707251, \"suggestedTranslation\": \"Hồi hộp ghê. Có vẻ sắp gãy rồi...\", \"rating\": 9.5},\n  {\"id\": 707252, \"suggestedTranslation\": \"Ôi chao, tớ có thể cảm nhận được hơi nóng từ tận đây này!\", \"rating\": 9.5},\n  {\"id\": 707253, \"suggestedTranslation\": \"Nó chỉ hơi ấm một chút thôi.\", \"rating\": 9.5},\n  {\"id\": 707254, \"suggestedTranslation\": \"Nó sẽ giúp tớ giữ ấm trong lúc chặt củi!\", \"rating\": 9.5},\n  {\"id\": 707255, \"suggestedTranslation\": \"Hồi hộp ghê. Có vẻ sắp gãy rồi...\", \"rating\": 9.5},\n  {\"id\": 707256, \"suggestedTranslation\": \"Ôi chao, tớ có thể cảm nhận được hơi nóng từ tận đây này!\", \"rating\": 9.5},\n  {\"id\": 707257, \"suggestedTranslation\": \"Nó chỉ hơi ấm một chút thôi.\", \"rating\": 9.5},\n  {\"id\": 707258, \"suggestedTranslation\": \"Nó sẽ giúp tớ giữ ấm trong lúc dùng búa đập đồ!\", \"rating\": 9.5},\n  {\"id\": 707259, \"suggestedTranslation\": \"Hồi hộp ghê. Có vẻ sắp gãy rồi...\", \"rating\": 9.5},\n  {\"id\": 707260, \"suggestedTranslation\": \"Ôi chao, tớ có thể cảm nhận được hơi nóng từ tận đây này!\", \"rating\": 9.5},\n  {\"id\": 707261, \"suggestedTranslation\": \"Nó chỉ hơi ấm một chút thôi.\", \"rating\": 9.5},\n  {\"id\": 707262, \"suggestedTranslation\": \"Nó sẽ giúp tớ giữ ấm trong lúc đập cục đá!\", \"rating\": 9.5},\n  {\"id\": 707263, \"suggestedTranslation\": \"Hồi hộp ghê. Có vẻ sắp gãy rồi...\", \"rating\": 9.5},\n  {\"id\": 707264, \"suggestedTranslation\": \"Ôi chao, tớ có thể cảm nhận được hơi nóng từ tận đây này!\", \"rating\": 9.5},\n  {\"id\": 707265, \"suggestedTranslation\": \"Nó chỉ hơi ấm một chút thôi.\", \"rating\": 9.5},\n  {\"id\": 707266, \"suggestedTranslation\": \"Nó sẽ giúp tớ giữ ấm trong lúc đào đất!\", \"rating\": 9.5},\n  {\"id\": 707267, \"suggestedTranslation\": \"Hồi hộp ghê. Có vẻ sắp gãy rồi...\", \"rating\": 9.5},\n  {\"id\": 707268, \"suggestedTranslation\": \"Ôi chao, tớ có thể cảm nhận được hơi nóng từ tận đây này!\", \"rating\": 9.5},\n  {\"id\": 707269, \"suggestedTranslation\": \"Nó chỉ hơi ấm một chút thôi.\", \"rating\": 9.5},\n  {\"id\": 707270, \"suggestedTranslation\": \"Nó sẽ giúp tớ giữ ấm trong lúc làm vườn!\", \"rating\": 9.5},\n  {\"id\": 707271, \"suggestedTranslation\": \"Mềm mại quá!\", \"rating\": 9.5},\n  {\"id\": 707272, \"suggestedTranslation\": \"Woby, nhìn kìa! Nó có một quả bóng ở đuôi!\", \"rating\": 9.5},\n  {\"id\": 707273, \"suggestedTranslation\": \"Ái chà! Quả bóng đó có sống đấy!\", \"rating\": 9.5},\n  {\"id\": 707274, \"suggestedTranslation\": \"Sẽ hài hước lắm đây nếu nó sống dậy nhỉ?\", \"rating\": 9.5},\n  {\"id\": 707275, \"suggestedTranslation\": \"Đừng lo Woby, chỉ là bức tượng thôi mà.\", \"rating\": 9.5},\n  {\"id\": 707276, \"suggestedTranslation\": \"Khắc tinh của ma cà rồng.\", \"rating\": 9.5},\n  {\"id\": 707277, \"suggestedTranslation\": \"Tiếc là ma cà rồng chẳng bao giờ được thưởng thức nó.\", \"rating\": 9.5},\n  {\"id\": 707278, \"suggestedTranslation\": \"Chà, giờ thì chúng ta an toàn trong két sắt trước lũ ma cà rồng khổng lồ rồi.\", \"rating\": 9.0},\n  {\"id\": 707279, \"suggestedTranslation\": \"Chúng ta nên trồng thực vật đó ở đâu đây, Woby?\", \"rating\": 9.5},\n  {\"id\": 707280, \"suggestedTranslation\": \"(Thở dài) Tớ biết là nó tốt cho sức khỏe nhưng mà...\", \"rating\": 9.5},\n  {\"id\": 707281, \"suggestedTranslation\": \"Mấy thứ này thường không xuất hiện trong tự nhiên.\", \"rating\": 9.5},\n  {\"id\": 707282, \"suggestedTranslation\": \"Đừng để bị dính vào đấy nhé, Woby!\", \"rating\": 9.5},\n  {\"id\": 707283, \"suggestedTranslation\": \"Cậu có cần giúp gì không thế?\", \"rating\": 9.5},\n  {\"id\": 707284, \"suggestedTranslation\": \"Cậu có thấy gì ở bên trong không, Woby?\", \"rating\": 9.5},\n  {\"id\": 707285, \"suggestedTranslation\": \"Chúng ta thực sự nên dán nhãn cho cái đó.\", \"rating\": 9.5},\n  {\"id\": 707286, \"suggestedTranslation\": \"Nó đang lơ lửng trong đám chất nhờn kìa!\", \"rating\": 9.5},\n  {\"id\": 707287, \"suggestedTranslation\": \"Chúng ta nên cho gì vào trong đó đây, Woby?\", \"rating\": 9.5},\n  {\"id\": 707288, \"suggestedTranslation\": \"Dựng cái này có vẻ hơi bừa bộn đấy.\", \"rating\": 9.5},\n  {\"id\": 707289, \"suggestedTranslation\": \"Tớ phải đặt đá quý vào trước đã.\", \"rating\": 9.5},\n  {\"id\": 707290, \"suggestedTranslation\": \"Sẵn sàng lên đường.\", \"rating\": 9.5},\n  {\"id\": 707291, \"suggestedTranslation\": \"Phải đảm bảo là nó không chui lên từ cõi chết đấy!\", \"rating\": 9.5},\n  {\"id\": 707292, \"suggestedTranslation\": \"Đôi khi ở chốn hoang dã mọi chuyện là vậy đấy.\", \"rating\": 9.5},\n  {\"id\": 707293, \"suggestedTranslation\": \"Woby! Nó sống lại rồi kìa!\", \"rating\": 9.5},\n  {\"id\": 707294, \"suggestedTranslation\": \"Cậu là ma... đến từ mặt trăng à?\", \"rating\": 9.5}\n]",
