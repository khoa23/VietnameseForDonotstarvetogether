            "text": "[\n  {\"id\":707895,\"suggestedTranslation\":\"Ồ! Một cây nấm khổng lồ!\",\"rating\":10.0},\n  {\"id\":707896,\"suggestedTranslation\":\"Đó không phải củi đâu!\",\"rating\":10.0},\n  {\"id\":707897,\"suggestedTranslation\":\"Nó cần thứ gì đó để bắt đầu.\",\"rating\":10.0},\n  {\"id\":707898,\"suggestedTranslation\":\"Lũ nấm chắc phải thích ở đó lắm!\",\"rating\":10.0},\n  {\"id\":707900,\"suggestedTranslation\":\"Sổ tay của mình bảo nấm cần thời tiết ấm áp hơn để phát triển.\",\"rating\":10.0},\n  {\"id\":707899,\"suggestedTranslation\":\"Khúc gỗ này chẳng còn lại mấy để cho nấm ăn nữa.\",\"rating\":10.0},\n  {\"id\":707901,\"suggestedTranslation\":\"Giờ có vài cây nấm rồi, nhưng chắc chốc nữa sẽ mọc thêm nhiều hơn.\",\"rating\":10.0},\n  {\"id\":707902,\"suggestedTranslation\":\"Nấm hơi đáng sợ khi bạn nghĩ về chúng đấy.\",\"rating\":10.0},\n  {\"id\":707903,\"suggestedTranslation\":\"Giờ thì chẳng làm được mấy đâu.\",\"rating\":10.0},\n  {\"id\":707904,\"suggestedTranslation\":\"Dễ thấy lắm! Cậu thấy đấy, vì nó có đốm mà! Hè...\",\"rating\":10.0},\n  {\"id\":707905,\"suggestedTranslation\":\"Mẹ tớ thích sưu tầm mấy chiếc đèn kì lạ... Mong là mẹ vẫn ổn.\",\"rating\":10.0},\n  {\"id\":707906,\"suggestedTranslation\":\"Giờ thì chẳng làm được mấy đâu.\",\"rating\":10.0},\n  {\"id\":707907,\"suggestedTranslation\":\"Trông đẹp đấy... nhưng tớ không nướng kẹo dẻo trên đó được.\",\"rating\":10.0},\n  {\"id\":707908,\"suggestedTranslation\":\"Thiên nhiên luôn đầy rẫy những điều bất ngờ.\",\"rating\":10.0},\n  {\"id\":707909,\"suggestedTranslation\":\"Ngửi kì lạ thế. Phải không Woby?\",\"rating\":10.0},\n  {\"id\":707910,\"suggestedTranslation\":\"Trông cây này đang ra hoa kìa.\",\"rating\":10.0},\n  {\"id\":707911,\"suggestedTranslation\":\"Mấy cây nấm dưới này mọc to thật đấy...\",\"rating\":10.0},\n  {\"id\":707912,\"suggestedTranslation\":\"Thực ra trông cũng khá đẹp đấy chứ!\",\"rating\":10.0},\n  {\"id\":707913,\"suggestedTranslation\":\"Ngửi kì lạ thế. Phải không Woby?\",\"rating\":10.0},\n  {\"id\":707914,\"suggestedTranslation\":\"Nó đang mọc thêm nấm kìa.\",\"rating\":10.0},\n  {\"id\":707915,\"suggestedTranslation\":\"Cây này hơi còi cọc.\",\"rating\":10.0},\n  {\"id\":707916,\"suggestedTranslation\":\"Ngửi kì lạ thế. Phải không Woby?\",\"rating\":10.0},\n  {\"id\":707917,\"suggestedTranslation\":\"Chúng chỉ nở hoa theo dạng bào tử. Heh... hay đấy, Walter.\",\"rating\":10.0},\n  {\"id\":707918,\"suggestedTranslation\":\"Cái đó không có trong cẩm nang của tớ...\",\"rating\":10.0},\n  {\"id\":707919,\"suggestedTranslation\":\"Ngửi kì lạ thế. Phải không Woby?\",\"rating\":10.0},\n  {\"id\":707920,\"suggestedTranslation\":\"Chắc chắn quanh đây có nhện rồi!\",\"rating\":10.0},\n  {\"id\":707921,\"suggestedTranslation\":\"Một con Gấu Lửng thây ma ư? Gọn gàng ghê!\",\"rating\":8.5},\n  {\"id\":707922,\"suggestedTranslation\":\"Nhìn con chim kìa, Woby!\",\"rating\":10.0},\n  {\"id\":707923,\"suggestedTranslation\":\"Nó đang mở tiệc thị tùng thực sự kìa, Woby!\",\"rating\":10.0},\n  {\"id\":707924,\"suggestedTranslation\":\"Tớ nghĩ đó là một điềm rất xấu.\",\"rating\":10.0},\n  {\"id\":707925,\"suggestedTranslation\":\"Ôi, tớ nghĩ con Hươu Một Mắt tội nghiệp đó đang bị bệnh!\",\"rating\":10.0},\n  {\"id\":707926,\"suggestedTranslation\":\"Ôi không... đừng nhìn, Woby.\",\"rating\":10.0},\n  {\"id\":707927,\"suggestedTranslation\":\"Đó là một con chó bất tử à?\",\"rating\":10.0},\n  {\"id\":707928,\"suggestedTranslation\":\"Thấy chưa, chúng vô hại mà!\",\"rating\":10.0},\n  {\"id\":707929,\"suggestedTranslation\":\"Con Chó Sói đó trông không ổn lắm...\",\"rating\":8.5},\n  {\"id\":707930,\"suggestedTranslation\":\"Chắc nó chết hẳn rồi đấy.\",\"rating\":10.0},\n  {\"id\":707931,\"suggestedTranslation\":\"Đó là một con chim cánh cụt, sống lại từ nấm mồ!\",\"rating\":9.0},\n  {\"id\":707932,\"suggestedTranslation\":\"Tớ nghĩ nó đang ngủ, nhưng khó nói lắm.\",\"rating\":10.0},\n  {\"id\":707933,\"suggestedTranslation\":\"Hay ghê! Mà không có mảnh vụn nhện thật nào trong này đâu đúng không?\",\"rating\":10.0},\n  {\"id\":707934,\"suggestedTranslation\":\"Hay ghê! Mà không có mảnh vụn nhện thật nào trong này đâu đúng không?\",\"rating\":10.0},\n  {\"id\":707935,\"suggestedTranslation\":\"Này, bánh quy kìa! Ừm... mấy cái này làm từ gì thế nhỉ?\",\"rating\":10.0},\n  {\"id\":707936,\"suggestedTranslation\":\"Này, bánh quy kìa! Ừm... mấy cái này làm từ gì thế nhỉ?\",\"rating\":10.0},\n  {\"id\":707937,\"suggestedTranslation\":\"Hay ghê! Mà không có mảnh vụn nhện thật nào trong này đâu đúng không?\",\"rating\":10.0},\n  {\"id\":707938,\"suggestedTranslation\":\"Này, bánh quy kìa! Ừm... mấy cái này làm từ gì thế nhỉ?\",\"rating\":10.0},\n  {\"id\":707939,\"suggestedTranslation\":\"Này, bánh quy kìa! Ừm... mấy cái này làm từ gì thế nhỉ?\",\"rating\":10.0},\n  {\"id\":707940,\"suggestedTranslation\":\"Mong là nó không thu hút quá nhiều ong.\",\"rating\":10.0},\n  {\"id\":707941,\"suggestedTranslation\":\"Đó là một chiếc túi ngủ nhỏ cho cái đầu của cậu.\",\"rating\":10.0},\n  {\"id\":707942,\"suggestedTranslation\":\"Nó thực sự làm tăng thêm bầu không khí.\",\"rating\":10.0},\n  {\"id\":707943,\"suggestedTranslation\":\"Mọi người vẫn luôn bảo những câu chuyện bên lửa trại của tớ là nhiên liệu Ác Mộng.\",\"rating\":9.5},\n  {\"id\":707944,\"suggestedTranslation\":\"Chúng ta có lẽ nên tránh xa thứ đó ra, Woby.\",\"rating\":10.0},\n  {\"id\":707945,\"suggestedTranslation\":\"Nhưng có nướng kẹo dẻo trên đó được không?\",\"rating\":10.0},\n  {\"id\":707946,\"suggestedTranslation\":\"Trông ngon phết!\",\"rating\":10.0},\n  {\"id\":707947,\"suggestedTranslation\":\"Chẳng có chuyện gì xảy ra cả.\",\"rating\":10.0},\n  {\"id\":707948,\"suggestedTranslation\":\"Chúng đang biến mất kìa!\",\"rating\":10.0},\n  {\"id\":707949,\"suggestedTranslation\":\"Ồ, hết rồi á?\",\"rating\":10.0},\n  {\"id\":707950,\"suggestedTranslation\":\"Chỉ là một dòng lũ quái vật liên tục đổ về!\",\"rating\":10.0},\n  {\"id\":707951,\"suggestedTranslation\":\"Tớ nghĩ chúng sắp cạn kiệt năng lượng rồi...\",\"rating\":10.0},\n  {\"id\":707952,\"suggestedTranslation\":\"Mọi thứ bắt đầu trở nên thú vị rồi đấy!\",\"rating\":10.0},\n  {\"id\":707953,\"suggestedTranslation\":\"Tớ nghĩ lũ quái vật đang tới!\",\"rating\":10.0},\n  {\"id\":707954,\"suggestedTranslation\":\"Ý tưởng sáng chói này của ai thế? Hiểu chứ? Vì nó sáng mà! Thôi bỏ đi.\",\"rating\":10.0},\n  {\"id\":707955,\"suggestedTranslation\":\"Thứ đó chắắắcc chắn là bị nguyền rủa rồi.\",\"rating\":10.0},\n  {\"id\":707956,\"suggestedTranslation\":\"Ni tơ ở đây hay ở đâu nhỉ. Hè...\",\"rating\":8.5},\n  {\"id\":707957,\"suggestedTranslation\":\"Hả. Trông giống một cục đá lớn.\",\"rating\":8.5},\n  {\"id\":707958,\"suggestedTranslation\":\"Hè. Mấy món đồ của tớ sẽ không bị tuột mất nhờ cái này đâu!\",\"rating\":10.0},\n  {\"id\":707959,\"suggestedTranslation\":\"Đừng có liếm thứ đó dưới đất đấy, Woby!\",\"rating\":10.0},\n  {\"id\":707960,\"suggestedTranslation\":\"Ồ, tớ có thể nhìn xuyên qua lớp đất luôn!\",\"rating\":10.0},\n  {\"id\":707961,\"suggestedTranslation\":\"Tớ từng đi chèo thuyền canoe với đội Hướng đạo sinh Cây Thông của mình.\",\"rating\":10.0},\n  {\"id\":707962,\"suggestedTranslation\":\"Tớ từng đi chèo thuyền canoe với đội Hướng đạo sinh Cây Thông của mình.\",\"rating\":10.0},\n  {\"id\":707963,\"suggestedTranslation\":\"Sao cái mái chèo đó sắc thế nhỉ? Lỡ ai đó bị thương thì sao!\",\"rating\":10.0},\n  {\"id\":707964,\"suggestedTranslation\":\"Một cái hồ vô hình ư?\",\"rating\":10.0},\n  {\"id\":707965,\"suggestedTranslation\":\"Chúng ta được cứu rồi, Woby!\",\"rating\":10.0},\n  {\"id\":707966,\"suggestedTranslation\":\"Lần này thì CHẮC CHẮN là quái vật biển-- (thở dài) không, chỉ là một cục bùn nhão thôi.\",\"rating\":10.0},\n  {\"id\":707967,\"suggestedTranslation\":\"Chỉ là một phao câu đơn giản.\",\"rating\":10.0},\n  {\"id\":707968,\"suggestedTranslation\":\"Tớ đã làm theo đúng hướng dẫn đấy.\",\"rating\":10.0},\n  {\"id\":707969,\"suggestedTranslation\":\"Tớ đã làm theo đúng hướng dẫn đấy.\",\"rating\":10.0},\n  {\"id\":707970,\"suggestedTranslation\":\"Nó nổi được... thực ra là nhẹ tựa lông hồng.\",\"rating\":10.0},\n  {\"id\":707971,\"suggestedTranslation\":\"Cảm ơn Malbatross nhé!\",\"rating\":10.0},\n  {\"id\":707972,\"suggestedTranslation\":\"Sơ đồ trong cẩm nang của tớ có vẽ một chiếc phao câu, chắc nó sẽ giúp ích đấy.\",\"rating\":10.0},\n  {\"id\":707973,\"suggestedTranslation\":\"Một chiếc phao câu bớt đơn giản hơn một chút.\",\"rating\":10.0},\n  {\"id\":707974,\"suggestedTranslation\":\"Tớ đã làm theo đúng hướng dẫn đấy.\",\"rating\":10.0},\n  {\"id\":707975,\"suggestedTranslation\":\"Tớ đã làm theo đúng hướng dẫn đấy.\",\"rating\":10.0},\n  {\"id\":707976,\"suggestedTranslation\":\"Được rồi... cứ cầm cẩn thận đã...\",\"rating\":10.0},\n  {\"id\":707977,\"suggestedTranslation\":\"Cứ xem tớ câu cá này Woby, tớ sẽ bắt con cá bự nhất mà cậu từng thấy!\",\"rating\":8.5},\n  {\"id\":707978,\"suggestedTranslation\":\"Tớ tự hỏi nó hoạt động thế nào nhỉ.\",\"rating\":10.0},\n  {\"id\":707979,\"suggestedTranslation\":\"Câu cá trên tuyết á? Hừm, một kỹ thuật mới cần phải chinh phục...\",\"rating\":10.0},\n  {\"id\":707980,\"suggestedTranslation\":\"Cẩn thận đấy Woby, mấy thứ này không phải đồ ăn thật đâu!\",\"rating\":10.0},\n  {\"id\":707981,\"suggestedTranslation\":\"Cẩn thận đấy Woby, mấy thứ này không phải đồ ăn thật đâu!\",\"rating\":10.0},\n  {\"id\":707982,\"suggestedTranslation\":\"Cẩn thận đấy Woby, mấy thứ này không phải đồ ăn thật đâu!\",\"rating\":10.0},\n  {\"id\":707983,\"suggestedTranslation\":\"Cẩn thận đấy Woby, mấy thứ này không phải đồ ăn thật đâu!\",\"rating\":10.0},\n  {\"id\":707984,\"suggestedTranslation\":\"Cẩn thận đấy Woby, mấy thứ này không phải đồ ăn thật đâu!\",\"rating\":10.0},\n  {\"id\":707985,\"suggestedTranslation\":\"Cẩn thận đấy Woby, mấy thứ này không phải đồ ăn thật đâu!\",\"rating\":10.0},\n  {\"id\":707986,\"suggestedTranslation\":\"Cần câu này chắc chắn thật đấy!\",\"rating\":10.0},\n  {\"id\":707987,\"suggestedTranslation\":\"QUÁI VẬT BI-- à nhầm, chỉ là một con cá câu cực kỳ xấu xí thôi.\",\"rating\":8.5},\n  {\"id\":707988,\"suggestedTranslation\":\"Cứ như thể nó đang nhìn thấu linh hồn tớ vậy...\",\"rating\":9.0},\n  {\"id\":707989,\"suggestedTranslation\":\"Chẳng có con cá câu nào trong này giống mấy con trong cẩm nang của tớ cả...\",\"rating\":8.5},\n  {\"id\":707990,\"suggestedTranslation\":\"Ngươi là con cá câu xui xẻo sẽ trở thành bữa tối của ta đấy.\",\"rating\":8.5},\n  {\"id\":707991,\"suggestedTranslation\":\"Là ngô đột biến thành cá câu, hay là cá câu đột biến thành ngô thế nhỉ?\",\"rating\":8.5},\n  {\"id\":707992,\"suggestedTranslation\":\"Không phải bình thường cậu sống ở ao hồ à?\",\"rating\":10.0},\n  {\"id\":707993,\"suggestedTranslation\":\"Không phải bình thường cậu sống ở ao hồ à?\",\"rating\":10.0},\n  {\"id\":707994,\"suggestedTranslation\":\"Nó có bị chảy ra nếu tớ cố nấu không nhỉ?\",\"rating\":10.0},\n  {\"id\":707995,\"suggestedTranslation\":\"Ôi, nó có mấy cái vây tai nhỏ xinh kìa!\",\"rating\":10.0},\n  {\"id\":707996,\"suggestedTranslation\":\"Nó còn chẳng đủ lớn để gọi là cá bảy màu nữa.\",\"rating\":10.0},\n  {\"id\":707997,\"suggestedTranslation\":\"Tớ bắt nó có chủ đích đấy. Để luyện tập thôi.\",\"rating\":10.0},\n  {\"id\":707998,\"suggestedTranslation\":\"Tớ thường bắt được mấy con cá câu to hơn nhiều đấy nhé.\",\"rating\":8.5},\n  {\"id\":707999,\"suggestedTranslation\":\"Cậu biết đấy, đôi khi bắt được những con cá câu nhỏ mới là thử thách thực sự.\",\"rating\":8.5},\n  {\"id\":708000,\"suggestedTranslation\":\"Cẩn thận kẻo vây dính vào răng đấy.\",\"rating\":10.0},\n  {\"id\":708001,\"suggestedTranslation\":\"Nó ngửi giống mùi lá khô.\",\"rating\":10.0},\n  {\"id\":708002,\"suggestedTranslation\":\"Này anh bạn nhỏ! Hiểu rồi, vì nó có một cái nụ trên đầu à?\",\"rating\":10.0},\n  {\"id\":708003,\"suggestedTranslation\":\"Tránh xa những thứ dễ cháy ra!\",\"rating\":10.0},\n  {\"id\":708004,\"suggestedTranslation\":\"Này! Nhổ nước bọt vào người khác là bất lịch sự đấy!\",\"rating\":10.0},\n  {\"id\":708005,\"suggestedTranslation\":\"Chắc bọn chúng không phải lo chuyện thiếu nước đâu nhỉ.\",\"rating\":10.0},\n  {\"id\":708006,\"suggestedTranslation\":\"Hạt giống to phết!\",\"rating\":10.0},\n  {\"id\":708007,\"suggestedTranslation\":\"Đúng là một cái cây tỏa bóng mát tuyệt vời!\",\"rating\":10.0},\n  {\"id\":708008,\"suggestedTranslation\":\"Biết đâu một trong số chúng lại hóa thành rắn thì sao!\",\"rating\":10.0},\n  {\"id\":708009,\"suggestedTranslation\":\"Chắc chắn đó là tổ của chúng rồi! Giá mà mình có thể lại gần xem hơn...\",\"rating\":10.0},\n  {\"id\":708010,\"suggestedTranslation\":\"Tội nghiệp mấy con nhện...\",\"rating\":10.0},\n  {\"id\":708011,\"suggestedTranslation\":\"Cậu ngửi thấy gì trong đó không, Woby?\",\"rating\":10.0},\n  {\"id\":708012,\"suggestedTranslation\":\"Tớ không nghĩ huy hiệu an toàn dưới nước đã chuẩn bị sẵn cho tớ vụ này đâu.\",\"rating\":10.0},\n  {\"id\":708013,\"suggestedTranslation\":\"Nhìn đống cá câu kìa!\",\"rating\":8.5},\n  {\"id\":708014,\"suggestedTranslation\":\"Chết tiệt, chúng sổng mất rồi!\",\"rating\":10.0},\n  {\"id\":708015,\"suggestedTranslation\":\"Sửa cái này cũng không khó lắm.\",\"rating\":10.0},\n  {\"id\":708016,\"suggestedTranslation\":\"Có lưới thì câu cá đúng là dễ hơn hẳn.\",\"rating\":10.0},\n  {\"id\":708017,\"suggestedTranslation\":\"Chẳng mấy chốc mà mình lại được nướng cá câu trên lửa trại rồi.\",\"rating\":8.5},\n  {\"id\":708018,\"suggestedTranslation\":\"Tốt hơn là nên dựng nó lên nếu mình muốn bắt cá câu.\",\"rating\":8.5},\n  {\"id\":708019,\"suggestedTranslation\":\"Cần một ít rong biển chứ? Haha. Đùa hay đấy, Walter.\",\"rating\":10.0},\n  {\"id\":708020,\"suggestedTranslation\":\"Ít nhiều gì cũng có ích cả. Hả! Cậu kiếm đống này ở đâu thế, Walter?\",\"rating\":9.5},\n  {\"id\":708021,\"suggestedTranslation\":\"Thêm rong biển đang tới đây! Hiểu ý tớ chứ, Woby?\",\"rating\":10.0},\n  {\"id\":708022,\"suggestedTranslation\":\"Cần chút rong biển không? Hè. Hay đấy, Walter.\",\"rating\":9.5},\n  {\"id\":708023,\"suggestedTranslation\":\"Ít nhiều gì cũng có ích cả. Hả! Cậu kiếm đống này ở đâu thế, Walter?\",\"rating\":9.5},\n  {\"id\":708024,\"suggestedTranslation\":\"Thêm rong biển đang tới đây! Hiểu ý tớ chứ, Woby?\",\"rating\":10.0},\n  {\"id\":708025,\"suggestedTranslation\":\"Tớ chưa từng chơi nhạc cụ nào trong số này, nhưng tớ chắc chắn mình sẽ làm tốt thôi!\",\"rating\":10.0},\n  {\"id\":708026,\"suggestedTranslation\":\"Tớ ghét thái hành lắm.\",\"rating\":10.0},\n  {\"id\":708027,\"suggestedTranslation\":\"Một củ hành nấu chín mọng nước.\",\"rating\":10.0},\n  {\"id\":708028,\"suggestedTranslation\":\"Tớ không muốn là kẻ phải đi thái nó đâu.\",\"rating\":10.0},\n  {\"id\":708029,\"suggestedTranslation\":\"Chúng ta nên trồng thực vật ở đâu đây, Woby?\",\"rating\":8.5},\n  {\"id\":708030,\"suggestedTranslation\":\"Nhiều màu sắc quá!\",\"rating\":10.0},\n  {\"id\":708031,\"suggestedTranslation\":\"Không phải Woby ơi, cái gậy này không phải để nhặt về đâu!\",\"rating\":10.0},\n  {\"id\":708032,\"suggestedTranslation\":\"Hành trình mới là một nửa của niềm vui!\",\"rating\":10.0},\n  {\"id\":708033,\"suggestedTranslation\":\"Cậu có vui không khi tớ tìm thấy Ngọc Cam này? Ha ha, đùa hay đấy Walter.\",\"rating\":8.5},\n  {\"id\":708034,\"suggestedTranslation\":\"Đó là một cột mốc khá rõ, cậu không thể nhầm được đâu!\",\"rating\":10.0},\n  {\"id\":708035,\"suggestedTranslation\":\"Tớ cá là bây giờ tớ có thể đua với cậu đấy, Woby!\",\"rating\":9.0},\n  {\"id\":708036,\"suggestedTranslation\":\"Cẩn thận đấy, Woby. Tớ nghĩ nó muốn nhòm ngó đồ của chúng ta đấy.\",\"rating\":10.0},\n  {\"id\":708037,\"suggestedTranslation\":\"Trông có vẻ chẳng có gì. Ồ thế à!\",\"rating\":10.0},\n  {\"id\":708038,\"suggestedTranslation\":\"Tớ nghĩ chúng ta trúng quả rồi đấy, Woby!\",\"rating\":10.0},\n  {\"id\":708039,\"suggestedTranslation\":\"Woby, chuẩn bị bỏ tàu thôi.\",\"rating\":10.0},\n  {\"id\":708040,\"suggestedTranslation\":\"Cái này- không, khoan đã, cái này cũng không có trong sổ tay của tớ.\",\"rating\":10.0},\n  {\"id\":708041,\"suggestedTranslation\":\"Nó vẫn đang lớn.\",\"rating\":10.0},\n  {\"id\":708042,\"suggestedTranslation\":\"Sổ tay của tớ chẳng nói gì về việc cây cối có vẩy cả...\",\"rating\":9.5},\n  {\"id\":708043,\"suggestedTranslation\":\"Tớ nên trồng thực vật, chẳng bao giờ là thừa cây cả!\",\"rating\":8.5},\n  {\"id\":708044,\"suggestedTranslation\":\"Chắc chắn bên trong phải có món gì ngon lắm đây!\",\"rating\":10.0},\n  {\"id\":708045,\"suggestedTranslation\":\"Tớ có thể ăn món này hoài luôn.\",\"rating\":10.0},\n  {\"id\":708046,\"suggestedTranslation\":\"Chắc chơi cũng không khó lắm đâu.\",\"rating\":10.0},\n  {\"id\":708047,\"suggestedTranslation\":\"Chỉ là dăm tờ giấy trắng tinh.\",\"rating\":8.5},\n  {\"id\":708048,\"suggestedTranslation\":\"Mmmm, nó gần như làm tớ nhớ đến một viên kẹo dẻo nướng hoàn hảo.\",\"rating\":10.0},\n  {\"id\":708049,\"suggestedTranslation\":\"Bãi nước bọt đó có tính ăn mòn đấy!\",\"rating\":10.0},\n  {\"id\":708050,\"suggestedTranslation\":\"Tớ chưa bao giờ được nhìn cận cảnh một con như thế này trước đây!\",\"rating\":10.0},\n  {\"id\":708051,\"suggestedTranslation\":\"Ngửi có vẻ ngon phết.\",\"rating\":10.0},\n  {\"id\":708052,\"suggestedTranslation\":\"Tránh xa nó ra, Woby!\",\"rating\":10.0},\n  {\"id\":708053,\"suggestedTranslation\":\"Yeah! Tớ biết ngay mà!\",\"rating\":10.0},\n  {\"id\":708054,\"suggestedTranslation\":\"Đỏ au và chín mọng!\",\"rating\":10.0},\n  {\"id\":708055,\"suggestedTranslation\":\"Sao món này lại có vị bạc hà nhỉ...?\",\"rating\":10.0},\n  {\"id\":708056,\"suggestedTranslation\":\"Cay quá!\",\"rating\":10.0},\n  {\"id\":708057,\"suggestedTranslation\":\"Cháy! Ồ khoan, chỉ là một quả ớt cay thôi.\",\"rating\":10.0},\n  {\"id\":708058,\"suggestedTranslation\":\"Chúng ta nên trồng thực vật ở đâu đây,