            "text": "[\n  {\n    \"id\": 709095,\n    \"suggestedTranslation\": \"Nó có vẻ phản ứng lại với ánh đuốc.\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709096,\n    \"suggestedTranslation\": \"Chúng ta nên chế tạo gì đây, Woby?\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709097,\n    \"suggestedTranslation\": \"Trông ngài có vẻ hơi cáu kỉnh đấy ngài %s, có lẽ ngài nên ăn gì đó đi?\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709098,\n    \"suggestedTranslation\": \"Ngài đang làm nó cháy rồi kìa, ngài %s!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709099,\n    \"suggestedTranslation\": \"Chào ngài %s!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709100,\n    \"suggestedTranslation\": \"Đợi đã nào ngài %s! Ngài sẽ lại quay lại nấu những món ăn sang trọng sớm thôi.\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709101,\n    \"suggestedTranslation\": \"Ngài đã ấp ủ âm mưu giết người này từ bao giờ vậy ngài %s?\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709102,\n    \"suggestedTranslation\": \"Cảm ơn ngài %s! Món đó thật sự rất hợp khẩu vị đấy.\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709103,\n    \"suggestedTranslation\": \"Tớ tự hỏi liệu đám Bò Lai có thực sự thích mặc mấy thứ này không.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 709104,\n    \"suggestedTranslation\": \"M-mọi người bình tĩnh... chúng ta sẽ đi thôi...\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709105,\n    \"suggestedTranslation\": \"Đừng lo, tớ nhắm chuẩn lắm! Hoặc có khi cậu nên lo lắng đấy...\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709106,\n    \"suggestedTranslation\": \"Chắc tớ có thể tìm thấy cái ao nào quanh đây...\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709107,\n    \"suggestedTranslation\": \"Nào Woby, xem lũ cây có cần miếng nước nào không nào.\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709108,\n    \"suggestedTranslation\": \"Một món ăn nhẹ ngọt ngào, sảng khoái!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709109,\n    \"suggestedTranslation\": \"Cảm giác ngốc nghếch thế nào ấy...\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709110,\n    \"suggestedTranslation\": \"Bằng chứng rõ mười mươi là món gì cắm vào que cũng ngon hơn!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709111,\n    \"suggestedTranslation\": \"Vẫn ngọt đấy, nhưng không còn sảng khoái nữa...\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709112,\n    \"suggestedTranslation\": \"Chúng ta sẽ có dưa hấu mà ăn cả tuần cho xem!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709113,\n    \"suggestedTranslation\": \"Chuẩn luôn, hạt của chúng đây mà!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709114,\n    \"suggestedTranslation\": \"Woah! Bông hoa đó to quá!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709115,\n    \"suggestedTranslation\": \"Tớ nghĩ mình làm vườn khá lên rồi đấy!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709116,\n    \"suggestedTranslation\": \"Này! Cẩn thận với mấy thứ đó chứ!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709117,\n    \"suggestedTranslation\": \"Đừng lo, chúng ta sẽ tìm một hòn đá tảng đẹp để trồng cậu lên.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 709118,\n    \"suggestedTranslation\": \"Luôn chuẩn bị sẵn các biện pháp an toàn là điều tốt.\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709119,\n    \"suggestedTranslation\": \"Woah, thử nhìn kích thước của cái cây kìa!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709120,\n    \"suggestedTranslation\": \"Cẩn thận mấy mối nguy hiểm dưới nước đấy!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709121,\n    \"suggestedTranslation\": \"Cô %s có vẻ còn hiếu chiến hơn mọi khi...\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709122,\n    \"suggestedTranslation\": \"Không phải cái gì cũng cần phải có một đám tang kiểu Viking đâu, cô %s!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709123,\n    \"suggestedTranslation\": \"Chào cô %s!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709124,\n    \"suggestedTranslation\": \"Đừng lo cô %s! Woby và cháu sẽ kiếm tim cho cô ngay thôi.\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709125,\n    \"suggestedTranslation\": \"Cô %s nổi cơn thịnh nộ kiểu Viking rồi!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709126,\n    \"suggestedTranslation\": \"Cảm ơn cô %s! Cô là người Viking duy nhất cháu biết, nhưng cũng là người tuyệt vời nhất!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709127,\n    \"suggestedTranslation\": \"Có lẽ Hướng đạo sinh Thông Đỏ nên đổi sang đội mũ bảo hiểm thì hơn.\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709128,\n    \"suggestedTranslation\": \"Woah, nhiều cánh gắn lên một cái mũ thế!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709129,\n    \"suggestedTranslation\": \"Tớ thấy an toàn hơn rồi đấy!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709130,\n    \"suggestedTranslation\": \"Nó vẫn sống... tớ nghĩ thế.\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709131,\n    \"suggestedTranslation\": \"Mẹ hay dùng thứ thế này để nướng bánh.\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709132,\n    \"suggestedTranslation\": \"Bản chất đen tối của ông đang lộ ra kìa, ngài %s.\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709133,\n    \"suggestedTranslation\": \"Không ai quan tâm đến an toàn phòng cháy chữa cháy à?\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709134,\n    \"suggestedTranslation\": \"Chào ngài %s! Woby, thôi gầm gừ với ông ấy đi!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709135,\n    \"suggestedTranslation\": \"Đừng lo, Hướng đạo sinh Thông Đỏ không bao giờ bỏ lại ai phía sau đâu!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709136,\n    \"suggestedTranslation\": \"Ông là một con quái vật, nhưng lại không phải loại vui vẻ gì.\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709137,\n    \"suggestedTranslation\": \"Làm ma cũng hơi vui vui đấy chứ...\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 709138,\n    \"suggestedTranslation\": \"Hay là chú dạy cháu vài trò ảo thuật đi? Cháu học nhanh lắm đấy!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709139,\n    \"suggestedTranslation\": \"Chắc cậu ta LÀ quái vật thật... chuyện đó là đương nhiên mà.\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709140,\n    \"suggestedTranslation\": \"Chúng ta cần mở một buổi họp nhóm về an toàn phòng cháy chữa cháy thôi.\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709141,\n    \"suggestedTranslation\": \"Chào %s!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709142,\n    \"suggestedTranslation\": \"Đừng lo nhóc con, Woby và tớ sẽ lo cho.\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709143,\n    \"suggestedTranslation\": \"Này %s! Cậu đi quá giới hạn rồi đấy!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709144,\n    \"suggestedTranslation\": \"Cảm ơn vì đã giúp đỡ! Sau này cậu sẽ trở thành một Hướng đạo sinh Thông Đỏ cừ khôi đấy!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709145,\n    \"suggestedTranslation\": \"Không Woby, đống xương này không phải để nhai đâu!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709146,\n    \"suggestedTranslation\": \"Chắc là chúng đang chiến đấu vì chúng ta.\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709147,\n    \"suggestedTranslation\": \"Trông nó như có một chiếc vuốt quái vật nhỏ, sẵn sàng chộp lấy cậu vậy!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709148,\n    \"suggestedTranslation\": \"Cậu không dọa được tớ đâu... à thì, hơi sợ một chút.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 709149,\n    \"suggestedTranslation\": \"An toàn phòng cháy chữa cháy có khó gì đâu cơ chứ!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709150,\n    \"suggestedTranslation\": \"Chào %s!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709151,\n    \"suggestedTranslation\": \"Ồ, khó... nhận ra hai người là ai với ai lắm.\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709152,\n    \"suggestedTranslation\": \"Cậu... sao lại có thể làm thế ch