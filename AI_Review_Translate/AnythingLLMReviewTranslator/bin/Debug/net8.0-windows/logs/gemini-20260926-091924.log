            "text": "[\n  {\"id\":702795,\"suggestedTranslation\":\"Nó sẽ thu hút mọi nam châm mạnh ở gần đó.\",\"rating\":9.5},\n  {\"id\":702796,\"suggestedTranslation\":\"Một trong những ý tưởng thiên tài của tôi, phải công nhận là thế.\",\"rating\":9.5},\n  {\"id\":702797,\"suggestedTranslation\":\"Mọi thứ đang đi đúng hướng. Hoặc có thể là bên trái.\",\"rating\":9.5},\n  {\"id\":702798,\"suggestedTranslation\":\"Chắc tôi phải đem ra khơi thử một vòng thôi.\",\"rating\":9.5},\n  {\"id\":702799,\"suggestedTranslation\":\"Ước gì nó đừng có mùi như bò lai.\",\"rating\":9.5},\n  {\"id\":702800,\"suggestedTranslation\":\"Nó ẩm ướt hơn mình muốn.\",\"rating\":9.5},\n  {\"id\":702801,\"suggestedTranslation\":\"Ít ra nó thơm hơn cái gối bò lai.\",\"rating\":9.5},\n  {\"id\":702802,\"suggestedTranslation\":\"Ai mà ngủ được trên cái này chứ?\",\"rating\":9.5},\n  {\"id\":702803,\"suggestedTranslation\":\"Thực vật học và hóa học, kết hợp cùng nhau.\",\"rating\":9.5},\n  {\"id\":702804,\"suggestedTranslation\":\"Bạn của chúng ta có vẻ ngày càng gắn kết hơn với cội nguồn nguyệt tộc.\",\"rating\":9.5},\n  {\"id\":702805,\"suggestedTranslation\":\"Mấy mảnh xương.\",\"rating\":9.5},\n  {\"id\":702806,\"suggestedTranslation\":\"Warly nấu ăn ngon hết chê, không phải bàn cãi về xương xẩu nữa.\",\"rating\":9.0},\n  {\"id\":702807,\"suggestedTranslation\":\"Một món hầm giúp bổ sung thịt và xương chắc khỏe.\",\"rating\":9.0},\n  {\"id\":702808,\"suggestedTranslation\":\"Tôi nghĩ thư viện đóng cửa rồi.\",\"rating\":9.5},\n  {\"id\":702809,\"suggestedTranslation\":\"Sao phải học trong khi mình có thể làm thí nghiệm cơ chứ?\",\"rating\":9.5},\n  {\"id\":702810,\"suggestedTranslation\":\"Tôi không hiểu mấy tiếng vo ve quanh cuốn này.\",\"rating\":9.5},\n  {\"id\":702811,\"suggestedTranslation\":\"Không cần học nếu mình có thể tự xoay xở.\",\"rating\":9.5},\n  {\"id\":702812,\"suggestedTranslation\":\"Phần đầu hơi chán, nhưng về cuối thì khá hơn.\",\"rating\":9.5},\n  {\"id\":702813,\"suggestedTranslation\":\"Tôi không đọc được chữ trong sách.\",\"rating\":9.5},\n  {\"id\":702814,\"suggestedTranslation\":\"Tôi không có hứng thú cháy bỏng để đọc nó.\",\"rating\":9.5},\n  {\"id\":702815,\"suggestedTranslation\":\"Nó không thu hút tôi cho lắm.\",\"rating\":9.5},\n  {\"id\":702816,\"suggestedTranslation\":\"Cái này sẽ giữ chân bọn quái vật đó một lúc.\",\"rating\":9.5},\n  {\"id\":702817,\"suggestedTranslation\":\"Đọc cái này xong thấy chẳng có tí ruộng nương nào ở đây cả.\",\"rating\":9.5},\n  {\"id\":702818,\"suggestedTranslation\":\"Tôi chẳng thấy có nông trại nào trong việc đọc sách cả.\",\"rating\":9.5},\n  {\"id\":702819,\"suggestedTranslation\":\"Nó chán chẳng kém gì việc ngồi nhìn cỏ mọc.\",\"rating\":9.5},\n  {\"id\":702820,\"suggestedTranslation\":\"Chắc kẻ viết cuốn này phải sáng dạ lắm đây.\",\"rating\":9.5},\n  {\"id\":702821,\"suggestedTranslation\":\"Rực rỡ!\",\"rating\":9.5},\n  {\"id\":702822,\"suggestedTranslation\":\"Tất cả sự quan tâm đến mặt trăng này chắc chỉ là chuyện nhất thời thôi.\",\"rating\":9.5},\n  {\"id\":702823,\"suggestedTranslation\":\"Nghe có vẻ không khoa học cho lắm.\",\"rating\":9.5},\n  {\"id\":702824,\"suggestedTranslation\":\"Wickerbottom thích làm mọi thứ theo sách vở.\",\"rating\":9.5},\n  {\"id\":702825,\"suggestedTranslation\":\"Tôi thích tự làm thí nghiệm hơn.\",\"rating\":9.5},\n  {\"id\":702826,\"suggestedTranslation\":\"Lạ thật, toàn là 500 trang mã điện tín không.\",\"rating\":9.5},\n  {\"id\":702827,\"suggestedTranslation\":\"Nó chỉ khiến suy nghĩ của tôi ở mức hững hờ.\",\"rating\":9.5},\n  {\"id\":702828,\"suggestedTranslation\":\"Sẽ có kẻ bị lừa đọc cái này cho xem.\",\"rating\":9.5},\n  {\"id\":702829,\"suggestedTranslation\":\"Mình không sợ nhện đâu! Không sợ chút nào!\",\"rating\":9.5},\n  {\"id\":702830,\"suggestedTranslation\":\"Tính khí động học!\",\"rating\":9.5},\n  {\"id\":702831,\"suggestedTranslation\":\"Đâu đó ngoài kia, một tên cướp biển đang thiếu chiếc ủng của mình.\",\"rating\":9.5},\n  {\"id\":702832,\"suggestedTranslation\":\"Nó bị hỏng rồi, nhưng tôi nghĩ mình có thể sửa được.\",\"rating\":9.5},\n  {\"id\":702833,\"suggestedTranslation\":\"Nếu nung nó đủ nóng, mình có thể hàn lại các mảnh vỡ.\",\"rating\":9.5},\n  {\"id\":702834,\"suggestedTranslation\":\"Cá là đám bò lai thích cái này lắm.\",\"rating\":9.5},\n  {\"id\":702835,\"suggestedTranslation\":\"Dùng để bắt côn trùng.\",\"rating\":9.5},\n  {\"id\":702836,\"suggestedTranslation\":\"Chà. Rong biển thôi mà.\",\"rating\":9.5},\n  {\"id\":702837,\"suggestedTranslation\":\"Tự nhiên nổi máu tảo biển.\",\"rating\":9.5},\n  {\"id\":702838,\"suggestedTranslation\":\"Tôi có thể trồng thực vật này ở vùng nước sâu.\",\"rating\":9.5},\n  {\"id\":702839,\"suggestedTranslation\":\"Đồ tiếp tế của chúng ta ở trong đó!\",\"rating\":9.5},\n  {\"id\":702840,\"suggestedTranslation\":\"Gói ghém lại sẽ giúp mang vác dễ hơn.\",\"rating\":9.5},\n  {\"id\":702841,\"suggestedTranslation\":\"Tôi đang dâng trào một thôi thúc khoa học không thể cưỡng lại.\",\"rating\":9.5},\n  {\"id\":702842,\"suggestedTranslation\":\"Đứa này hết vận may rồi.\",\"rating\":9.5},\n  {\"id\":702843,\"suggestedTranslation\":\"Nó bị cháy trụi rồi.\",\"rating\":9.5},\n  {\"id\":702844,\"suggestedTranslation\":\"Hơi ngứa một chút.\",\"rating\":9.5},\n  {\"id\":702845,\"suggestedTranslation\":\"Không thể tin được đây là bơ!\",\"rating\":9.5},\n  {\"id\":702846,\"suggestedTranslation\":\"Bướm bay lượn kìa.\",\"rating\":9.5},\n  {\"id\":702847,\"suggestedTranslation\":\"Tóm được ngươi rồi nhé!\",\"rating\":9.5},\n  {\"id\":702848,\"suggestedTranslation\":\"Chúng tôi vứt công thức đi và cứ thế làm đại.\",\"rating\":9.5},\n  {\"id\":702849,\"suggestedTranslation\":\"Nếu không có chúng, nó chỉ là một cục bơ.\",\"rating\":9.5},\n  {\"id\":702850,\"suggestedTranslation\":\"Đúng là một con diều hâu kỳ quái!\",\"rating\":9.5},\n  {\"id\":702851,\"suggestedTranslation\":\"Đấy mới gọi là phượng hoàng lửa chứ.\",\"rating\":9.5},\n  {\"id\":702852,\"suggestedTranslation\":\"Tôi thấy gà thế nào ấy.\",\"rating\":9.5},\n  {\"id\":702853,\"suggestedTranslation\":\"It's becoming a new species!\",\"rating\":0.0},\n  {\"id\":702854,\"suggestedTranslation\":\"Thịt ẩn bên trong bắp cải để tránh kẻ săn mồi.\",\"rating\":9.5},\n  {\"id\":702855,\"suggestedTranslation\":\"Nhọn hoắt nhưng ngon tuyệt.\",\"rating\":9.5},\n  {\"id\":702856,\"suggestedTranslation\":\"Xìu rồi, nhưng vẫn nhiều gai.\",\"rating\":9.5},\n  {\"id\":702857,\"suggestedTranslation\":\"Một bông hoa xinh từ loài thực vật gai góc.\",\"rating\":9.5},\n  {\"id\":702858,\"suggestedTranslation\":\"Vẫn còn vài cái gai chắn giữa tôi và bữa ăn ngon lành.\",\"rating\":9.5},\n  {\"id\":702859,\"suggestedTranslation\":\"Trái cây sa mạc nướng.\",\"rating\":9.5},\n  {\"id\":702860,\"suggestedTranslation\":\"Nhưng mình không có đũa.\",\"rating\":9.5},\n  {\"id\":702861,\"suggestedTranslation\":\"Đống lửa đó cần thêm nhiên liệu nếu không nó sẽ tắt mất.\",\"rating\":9.5},\n  {\"id\":702862,\"suggestedTranslation\":\"Vẫn hơn bóng đêm.\",\"rating\":9.5},\n  {\"id\":702863,\"suggestedTranslation\":\"Ngọn lửa đó đang vượt khỏi tầm kiểm soát rồi!\",\"rating\":9.5},\n  {\"id\":702864,\"suggestedTranslation\":\"Lửa đang sắp tàn rồi.\",\"rating\":9.5},\n  {\"id\":702865,\"suggestedTranslation\":\"Ấm áp và dễ chịu.\",\"rating\":9.5},\n  {\"id\":702866,\"suggestedTranslation\":\"Thế là xong.\",\"rating\":9.5},\n  {\"id\":702867,\"suggestedTranslation\":\"Một loại sinh vật màu vàng tạo ra từ khoa học.\",\"rating\":9.5},\n  {\"id\":702868,\"suggestedTranslation\":\"Tôi không bóp bẹp mày chứ, hả?\",\"rating\":9.5},\n  {\"id\":702869,\"suggestedTranslation\":\"Chắc là không sao đâu.\",\"rating\":9.5},\n  {\"id\":702870,\"suggestedTranslation\":\"Đó là một dạng chiều không gian bỏ túi ngon lành dành cho đồ ngọt.\",\"rating\":9.5},\n  {\"id\":702871,\"suggestedTranslation\":\"Thực ra đi bộ chỉ là cú ngã có kiểm soát.\",\"rating\":9.5},\n  {\"id\":702872,\"suggestedTranslation\":\"Viên đạn