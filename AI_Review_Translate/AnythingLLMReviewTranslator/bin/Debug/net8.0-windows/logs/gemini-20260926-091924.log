            "text": "[\n  {\"id\":703395,\"suggestedTranslation\":\"Nó còn sống! À đợi đã, không có.\",\"rating\":9.0},\n  {\"id\":703396,\"suggestedTranslation\":\"Trực giác khoa học của tôi mách bảo rằng thứ này không ổn cho lắm.\",\"rating\":9.5},\n  {\"id\":703397,\"suggestedTranslation\":\"Vẫn còn thiếu vài mảnh nữa.\",\"rating\":9.0},\n  {\"id\":703398,\"suggestedTranslation\":\"Trái cây ngọt ngào! Một phần của bữa sáng đầy đủ dinh dưỡng.\",\"rating\":9.0},\n  {\"id\":703399,\"suggestedTranslation\":\"Khu vườn trông có vẻ vui tươi hơn khi có nó ở quanh đây.\",\"rating\":9.0},\n  {\"id\":703400,\"suggestedTranslation\":\"Nó đã ngỏm rồi.\",\"rating\":9.0},\n  {\"id\":703401,\"suggestedTranslation\":\"Nó dễ thương quá!\",\"rating\":9.0},\n  {\"id\":703402,\"suggestedTranslation\":\"Ôi, nhìn nó ngủ kìa!\",\"rating\":9.0},\n  {\"id\":703403,\"suggestedTranslation\":\"Đó có phải là… những con ếch nhồi bên trong một con cá không?\",\"rating\":8.5},\n  {\"id\":703404,\"suggestedTranslation\":\"Một chiếc sandwich đầy chân ếch.\",\"rating\":9.0},\n  {\"id\":703405,\"suggestedTranslation\":\"Tôi nghe nói đây là một món cao lương mỹ vị.\",\"rating\":9.0},\n  {\"id\":703406,\"suggestedTranslation\":\"Vị giống thịt gà.\",\"rating\":9.0},\n  {\"id\":703407,\"suggestedTranslation\":\"Quả Vả thực sự kết nối mọi thứ lại với nhau.\",\"rating\":9.0},\n  {\"id\":703408,\"suggestedTranslation\":\"Vàng tươi và dịu ngọt.\",\"rating\":9.0},\n  {\"id\":703409,\"suggestedTranslation\":\"Trông dễ thương thật, nhưng chưa chín đâu.\",\"rating\":9.0},\n  {\"id\":703410,\"suggestedTranslation\":\"Chắc là chín rồi đấy.\",\"rating\":9.0},\n  {\"id\":703411,\"suggestedTranslation\":\"Nó đang ngủ khò khò.\",\"rating\":9.0},\n  {\"id\":703412,\"suggestedTranslation\":\"Biến đi!\",\"rating\":9.0},\n  {\"id\":703413,\"suggestedTranslation\":\"Giờ thì mình nắm quyền rồi!\",\"rating\":9.0},\n  {\"id\":703414,\"suggestedTranslation\":\"Tràn ngập hương vị hoa quả.\",\"rating\":8.5},\n  {\"id\":703415,\"suggestedTranslation\":\"Nó lạnh và giòn dễ vỡ.\",\"rating\":9.0},\n  {\"id\":703416,\"suggestedTranslation\":\"Nó là một món hàng nóng hổi.\",\"rating\":9.0},\n  {\"id\":703417,\"suggestedTranslation\":\"Tôi nghĩ nó đang mất dần hơi nóng rồi.\",\"rating\":9.0},\n  {\"id\":703418,\"suggestedTranslation\":\"Nó đã được làm nóng rồi!\",\"rating\":9.0},\n  {\"id\":703419,\"suggestedTranslation\":\"Nó lạnh và giòn dễ vỡ.\",\"rating\":9.0},\n  {\"id\":703420,\"suggestedTranslation\":\"Món hàng nóng hổi đấy.\",\"rating\":9.0},\n  {\"id\":703421,\"suggestedTranslation\":\"Tôi nghĩ nó đang mất dần hơi rồi.\",\"rating\":9.0},\n  {\"id\":703422,\"suggestedTranslation\":\"Nó đã được làm nóng lên rồi!\",\"rating\":9.0},\n  {\"id\":703423,\"suggestedTranslation\":\"Nó lạnh và giòn dễ vỡ.\",\"rating\":9.0},\n  {\"id\":703424,\"suggestedTranslation\":\"Món hàng nóng hổi đây.\",\"rating\":9.0},\n  {\"id\":703425,\"suggestedTranslation\":\"Tôi nghĩ nó sắp hết hơi rồi.\",\"rating\":9.0},\n  {\"id\":703426,\"suggestedTranslation\":\"Nó đã được làm nóng rồi!\",\"rating\":9.0},\n  {\"id\":703427,\"suggestedTranslation\":\"Nó lạnh và giòn dễ vỡ.\",\"rating\":9.0},\n  {\"id\":703428,\"suggestedTranslation\":\"Món hàng nóng hổi đấy.\",\"rating\":9.0},\n  {\"id\":703429,\"suggestedTranslation\":\"Tôi nghĩ nó đang mất dần hơi rồi.\",\"rating\":9.0},\n  {\"id\":703430,\"suggestedTranslation\":\"Nó đã được làm ấm lên rồi!\",\"rating\":9.0},\n  {\"id\":703431,\"suggestedTranslation\":\"Nó lạnh và giòn dễ vỡ.\",\"rating\":9.0},\n  {\"id\":703432,\"suggestedTranslation\":\"Món đồ nóng hổi đây.\",\"rating\":9.0},\n  {\"id\":703433,\"suggestedTranslation\":\"Tôi nghĩ nó đang mất dần hơi nóng rồi.\",\"rating\":9.0},\n  {\"id\":703434,\"suggestedTranslation\":\"Nó đã được làm ấm lên rồi!\",\"rating\":9.0},\n  {\"id\":703435,\"suggestedTranslation\":\"Bộ lông đen trắng.\",\"rating\":9.0},\n  {\"id\":703436,\"suggestedTranslation\":\"Tôi thích lúc ngươi còn nhỏ và đi làm phiền kẻ khác hơn.\",\"rating\":9.0},\n  {\"id\":703437,\"suggestedTranslation\":\"Bùng nổ!\",\"rating\":9.0},\n  {\"id\":703438,\"suggestedTranslation\":\"Tôi không thích cái cách nó nhìn chằm chằm vào mình.\",\"rating\":9.0},\n  {\"id\":703439,\"suggestedTranslation\":\"Trông nó sống động như thật vậy.\",\"rating\":9.0},\n  {\"id\":703440,\"suggestedTranslation\":\"Vật phẩm khử mùi hơi thở số một.\",\"rating\":9.0},\n  {\"id\":703441,\"suggestedTranslation\":\"Chín vàng hoàn hảo.\",\"rating\":9.0},\n  {\"id\":703442,\"suggestedTranslation\":\"Một củ Tỏi khổng lồ!\",\"rating\":9.0},\n  {\"id\":703443,\"suggestedTranslation\":\"Một nắm Hạt giống kỳ lạ.\",\"rating\":9.0},\n  {\"id\":703444,\"suggestedTranslation\":\"Khoa học kiểu gì mà ngon thế nhỉ?\",\"rating\":9.0},\n  {\"id\":703445,\"suggestedTranslation\":\"Một đống linh kiện cơ khí.\",\"rating\":9.0},\n  {\"id\":703446,\"suggestedTranslation\":\"Kinh tởm thật!\",\"rating\":8.5},\n  {\"id\":703447,\"suggestedTranslation\":\"Có ai đó đang ở trong tình huống khó xử rồi.\",\"rating\":9.0},\n  {\"id\":703448,\"suggestedTranslation\":\"Ồ, hóa ra mình để nó ở đó.\",\"rating\":9.0},\n  {\"id\":703449,\"suggestedTranslation\":\"Tôi có thói quen cất kỹ mọi thứ trong chai lọ.\",\"rating\":9.0},\n  {\"id\":703450,\"suggestedTranslation\":\"Nó đang giữ cho nó... tươi mới sao?\",\"rating\":9.0},\n  {\"id\":703451,\"suggestedTranslation\":\"Trông có vẻ trống rỗng.\",\"rating\":9.0},\n  {\"id\":703452,\"suggestedTranslation\":\"Tôi sẽ giữ phán đoán của mình cho riêng mình.\",\"rating\":9.0},\n  {\"id\":703453,\"suggestedTranslation\":\"Nó cần một viên ngọc.\",\"rating\":9.0},\n  {\"id\":703454,\"suggestedTranslation\":\"Trông có vẻ sẵn sàng rồi.\",\"rating\":9.0},\n  {\"id\":703455,\"suggestedTranslation\":\"Chẳng còn đường quay đầu nữa rồi.\",\"rating\":9.0},\n  {\"id\":703456,\"suggestedTranslation\":\"Nó chết thật rồi.\",\"rating\":9.0},\n  {\"id\":703457,\"suggestedTranslation\":\"Sự trở lại đầy bất ngờ.\",\"rating\":9.0},\n  {\"id\":703458,\"suggestedTranslation\":\"Họ hứa sẽ cho tôi… tri thức.\",\"rating\":9.0},\n  {\"id\":703459,\"suggestedTranslation\":\"Nó đã có chủ rồi.\",\"rating\":9.0},\n  {\"id\":703460,\"suggestedTranslation\":\"Xui thật, trống không.\",\"rating\":9.0},\n  {\"id\":703461,\"suggestedTranslation\":\"Chúng đang hứa hẹn... một cú vả đau điếng nếu tôi bén mảng lại gần.\",\"rating\":9.0},\n  {\"id\":703462,\"suggestedTranslation\":\"Mấy tên này có tính cách thật bùng nổ.\",\"rating\":9.0},\n  {\"id\":703463,\"suggestedTranslation\":\"Điều này xúc phạm đến tư cách nhà khoa học của tôi.\",\"rating\":9.0},\n  {\"id\":703464,\"suggestedTranslation\":\"Bộ não khoa học của tôi từ chối nhìn nhận nó.\",\"rating\":9.0},\n  {\"id\":703465,\"suggestedTranslation\":\"Cái này làm tôi thấy khát quá.\",\"rating\":9.0},\n  {\"id\":703466,\"suggestedTranslation\":\"À phải. Rất là khoa học.\",\"rating\":9.0},\n  {\"id\":703467,\"suggestedTranslation\":\"À phải rồi. Rất là khoa học.\",\"rating\":9.0},\n  {\"id\":703468,\"suggestedTranslation\":\"À phải rồi. Rất là khoa học.\",\"rating\":9.0},\n  {\"id\":703469,\"suggestedTranslation\":\"À phải. Rất là khoa học.\",\"rating\":9.0},\n  {\"id\":703470,\"suggestedTranslation\":\"À phải. Rất là khoa học.\",\"rating\":9.0},\n  {\"id\":703471,\"suggestedTranslation\":\"Ồ vâng. Rất là khoa học đấy.\",\"rating\":9.0},\n  {\"id\":703472,\"suggestedTranslation\":\"Ồ vâng. Trông rất là khoa học.\",\"rating\":9.0},\n  {\"id\":703473,\"suggestedTranslation\":\"À phải. Rất là khoa học.\",\"rating\":9.0},\n  {\"id\":703474,\"suggestedTranslation\":\"À phải. Rất là khoa học.\",\"rating\":9.0},\n  {\"id\":703475,\"suggestedTranslation\":\"Cái đó cho mình à?\",\"rating\":9.0},\n  {\"id\":703476,\"suggestedTranslation\":\"Gói xong rồi!\",\"rating\":9.0},\n  {\"id\":703477,\"suggestedTranslation\":\"Nhà và thức ăn hòa làm một.\",\"rating\":9.0},\n  {\"id\":703478,\"suggestgTranslation\":\"Mình nên theo chân nó thôi.\",\"rating\":9.0},\n  {\"id\":703479,\"suggestedTranslation\":\"Đến lúc bỏ rơi món tráng miệng này rồi.\",\"rating\":9.0},\n  {\"id\":703480,\"suggestedTranslation\":\"Đúng là khoa học mà.\",\"rating\":9.0},\n  {\"id\":703481,\"suggestedTranslation\":\"Tôi không thực sự hợp với việc chiến đấu.\",\"rating\":9.0},\n  {\"id\":703482,\"suggestedTranslation\":\"Ký ức về khoảng thời gian mình không bị xiên qua.\",\"rating\":9.0},\n  {\"id\":703483,\"suggestedTranslation\":\"Trông cũng dễ thương, theo một kiểu hơi ghê.\",\"rating\":9.0},\n  {\"id\":703484,\"suggestedTranslation\":\"Ngủ ngon lành.\",\"rating\":9.0},\n  {\"id\":703485,\"suggestedTranslation\":\"Cánh hoa rũ xuống và lấp lánh dưới ánh sáng.\",\"rating\":9.0},\n  {\"id\":703486,\"suggestedTranslation\":\"Cánh hoa lấp lánh dưới ánh sáng.\",\"rating\":9.0},\n  {\"id\":703487,\"suggestedTranslation\":\"Đống nhầy này thối quắc.\",\"rating\":9.0},\n  {\"id\":703488,\"suggestedTranslation\":\"Gắn mấy cái này lên mũ thì trông cứ gọi là đỉnh của chóp!\",\"rating\":9.0},\n  {\"id\":703489,\"suggestedTranslation\":\"Warly nấu ăn đỉnh thật.\",\"rating\":9.0},\n  {\"id\":703490,\"suggestedTranslation\":\"Mất mũi rồi nhé!\",\"rating\":9.0},\n  {\"id\":703491,\"suggestedTranslation\":\"Đó là cái tội cứ thích chõ mũi vào chuyện người khác đấy!\",\"rating\":9.0},\n  {\"id\":703492,\"suggestedTranslation\":\"Cá là mọi chuyện đều ổn.\",\"rating\":8.5},\n  {\"id\":703493,\"suggestedTranslation\":\"Chà, chiếc sừng của bạn mới lớn làm sao.\",\"rating\":9.0},\n  {\"id\":703494,\"suggestedTranslation\":\"Ghê chưa kìa!\",\"rating\":9.0},\n  {\"id\":703495,\"suggestedTranslation\":\"Nó đang râm ran sự ngon lành!\",\"rating\":9.0},\n  {\"id\":703496,\"suggestedTranslation\":\"Một cặp kính thật sành điệu.\",\"rating\":9.0},\n  {\"id\":703497,\"suggestedTranslation\":\"Đúng là một cái Rìu hào nhoáng.\",\"rating\":9.0},\n  {\"id\":703498,\"suggestedTranslation\":\"Này, vàng không phải rất mềm sao?\",\"rating\":9.0},\n  {\"id\":703499,\"suggestedTranslation\":\"Sao mình lại đi làm cái Chĩa sang chảnh thế này chứ?\",\"rating\":9.0},\n  {\"id\":703500,\"suggestedTranslation\":\"Tôi nóng lòng muốn đào hố rồi.\",\"rating\":9.0},\n  {\"id\":703501,\"suggestedTranslation\":\"Mình thực sự cần một thứ xịn sò thế này để cuốc đất sao?\",\"rating\":9.0},\n  {\"id\":703502,\"suggestedTranslation\":\"Tôi không ăn được, nhưng nó lấp lánh thật đấy.\",\"rating\":9.0},\n  {\"id\":703503,\"suggestedTranslation\":\"Xốp quá!\",\"rating\":9.0},\n  {\"id\":703504,\"suggestedTranslation\":\"Nó cần phân.\",\"rating\":9.0},\n  {\"id\":703505,\"suggestedTranslation\":\"Nó cháy nhanh quá!\",\"rating\":9.0},\n  {\"id\":703506,\"suggestedTranslation\":\"Trông nó có vẻ ốm yếu.\",\"rating\":9.0},\n  {\"id\":703507,\"suggestedTranslation\":\"Ơ, có gì đó không ổn.\",\"rating\":9.0},\n  {\"id\":703508,\"suggestedTranslation\":\"Đó là một bụi Cỏ.\",\"rating\":9.0},\n  {\"id\":703509,\"suggestedTranslation\":\"Nó đã bị đốn ngã khi đang ở độ tuổi đẹp nhất.\",\"rating\":9.0},\n  {\"id\":703510,\"suggestedTranslation\":\"Trời nóng thế này thì nó không mọc lại được đâu.\",\"rating\":9.0},\n  {\"id\":703511,\"suggestedTranslation\":\"Tôi nghĩ nó không thích tôi cho lắm.\",\"rating\":9.0},\n  {\"id\":703512,\"suggestedTranslation\":\"Trông nó có vẻ ốm nặng lắm.\",\"rating\":9.0},\n  {\"id\":703513,\"suggestedTranslation\":\"Đó là một con thằn lằn nhiều lá.\",\"rating\":9.0},\n  {\"id\":703514,\"suggestedTranslation\":\"Tóc mình trông thật ẩm ướt… khổ cái là lúc khô mới đáng sợ.\",\"rating\":9.0},\n  {\"id\":703515,\"suggestedTranslation\":\"Cái Bình Di Cốt này trông thiếu sức sống quá.\",\"rating\":9.0},\n  {\"id\":703516,\"suggestedTranslation\":\"Linh hồn này đã tìm được một ngôi nhà mới!\",\"rating\":9.0},\n  {\"id\":703517,\"suggestedTranslation\":\"Mọi chuyện đều ổn cả.\",\"rating\":9.0},\n  {\"id\":703518,\"suggestedTranslation\":\"Cứ sở hữu một cái là chuẩn bài!\",\"rating\":9.0},\n  {\"id\":703519,\"suggestedTranslation\":\"Nó xanh và lấp lánh.\",\"rating\":9.0},\n  {\"id\":703520,\"suggestedTranslati