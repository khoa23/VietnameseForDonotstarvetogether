slation\": \"Nó trộn mọi loại thức ăn lại.\", \"rating\": 9.0},\n  {\"id\": 704332, \"suggestedTranslation\": \"Món ăn đó sẽ mất một lúc đấy.\", \"rating\": 9.0},\n  {\"id\": 704333, \"suggestedTranslation\": \"Sắp xong rồi đấy!\", \"rating\": 9.0},\n  {\"id\": 704334, \"suggestedTranslation\": \"Xong phần nấu nướng rồi!\", \"rating\": 9.0},\n  {\"id\": 704335, \"suggestedTranslation\": \"Chắc là chẳng có gì trong đó đâu.\", \"rating\": 9.0},\n  {\"id\": 704336, \"suggestedTranslation\": \"Giờ thì nấu nướng thôi!\", \"rating\": 9.0},\n  {\"id\": 704337, \"suggestedTranslation\": \"Cuối cùng thì cũng có lửa mang theo! Đang chờ cấp bằng sáng chế.\", \"rating\": 9.0},\n  {\"id\": 704338, \"suggestedTranslation\": \"Chắc là sẽ ngon hơn một chút đây.\", \"rating\": 9.0},\n  {\"id\": 704339, \"suggestedTranslation\": \"Cái này sẽ làm mọi thứ thú vị hơn đây.\", \"rating\": 9.0},\n  {\"id\": 704340, \"suggestedTranslation\": \"Tôi cảm thấy như lâu lắm rồi mình chưa được ngủ một giấc đàng hoàng!\", \"rating\": 9.0},\n  {\"id\": 704341, \"suggestedTranslation\": \"Điều này đòi hỏi một chút sự chú ý.\", \"rating\": 9.0},\n  {\"id\": 704342, \"suggestedTranslation\": \"Táo của mặt đất.\", \"rating\": 9.0},\n  {\"id\": 704343, \"suggestedTranslation\": \"Đầy những hòn đá hình củ khoai hoặc củ khoai hình hòn đá.\", \"rating\": 9.0},\n  {\"id\": 704344, \"suggestedTranslation\": \"Tôi quên mất vị ngon của thức ăn thế nào rồi.\", \"rating\": 9.0},\n  {\"id\": 704345, \"suggestedTranslation\": \"Khoai tây, đã được truyền sức mạnh khoa học của một cơn lốc xoáy!\", \"rating\": 9.0},\n  {\"id\": 704346, \"suggestedTranslation\": \"Một thí nghiệm nhiệt độ thành công.\", \"rating\": 9.0},\n  {\"id\": 704347, \"suggestedTranslation\": \"Đúng là một đống khoai tây bự.\", \"rating\": 9.0},\n  {\"id\": 704348, \"suggestedTranslation\": \"Một nắm hạt giống lạ.\", \"rating\": 9.0},\n  {\"id\": 704349, \"suggestedTranslation\": \"Một cây dương xỉ trong chậu.\", \"rating\": 9.0},\n  {\"id\": 704350, \"suggestedTranslation\": \"Chúa cứu thế.\", \"rating\": 9.0},\n  {\"id\": 704351, \"suggestedTranslation\": \"Đừng có mà giở trò khỉ với thuyền ván của tôi đấy!\", \"rating\": 9.0},\n  {\"id\": 704352, \"suggestedTranslation\": \"Không có nước thì chẳng ích gì.\", \"rating\": 9.0},\n  {\"id\": 704353, \"suggestedTranslation\": \"Nó đã được cải tiến bằng khoa học... và cả bộ phận của chim nữa!\", \"rating\": 9.0},\n  {\"id\": 704354, \"suggestedTranslation\": \"Một chiếc mũ đẹp luôn là dấu hiệu rõ ràng cho thấy ai là người nắm quyền.\", \"rating\": 9.0},\n  {\"id\": 704355, \"suggestedTranslation\": \"Tôi chưa bao giờ thấy hải âu cổ rụt ngoài đời thực cả!\", \"rating\": 9.0},\n  {\"id\": 704356, \"suggestedTranslation\": \"Bắt được con này thì có gì mà phồng mồm trợn má.\", \"rating\": 9.0},\n  {\"id\": 704357, \"suggestedTranslation\": \"Đang khò khò ngon lành.\", \"rating\": 9.0},\n  {\"id\": 704358, \"suggestedTranslation\": \"To bằng cả đầu mình luôn!\", \"rating\": 9.0},\n  {\"id\": 704359, \"suggestedTranslation\": \"Ai muốn có một khoảng thời gian bí đầy vui vẻ nào?\", \"rating\": 9.0},\n  {\"id\": 704360, \"suggestedTranslation\": \"Đúng là một chiếc bánh quy bí ngô xinh xắn!\", \"rating\": 9.0},\n  {\"id\": 704361, \"suggestedTranslation\": \"Đúng là một vẻ mặt trống rỗng.\", \"rating\": 9.0},\n  {\"id\": 704362, \"suggestedTranslation\": \"Đeo cái quả không mặt này thì kỳ lắm.\", \"rating\": 9.0},\n  {\"id\": 704363, \"suggestedTranslation\": \"Chắc mình nên ăn cả cái luôn quá... vì khoa học.\", \"rating\": 9.0},\n  {\"id\": 704364, \"suggestedTranslation\": \"Sao nó không biến thành bánh bí ngô nhỉ?\", \"rating\": 9.0},\n  {\"id\": 704365, \"suggestedTranslation\": \"Đáng sợ quá!\", \"rating\": 9.0},\n  {\"id\": 704366, \"suggestedTranslation\": \"Một quả bí ngô lực lưỡng.\", \"rating\": 9.0},\n  {\"id\": 704367, \"suggestedTranslation\": \"Đó là hạt giống.\", \"rating\": 9.0},\n  {\"id\": 704368, \"suggestedTranslation\": \"Nó đi kèm với một cái máy