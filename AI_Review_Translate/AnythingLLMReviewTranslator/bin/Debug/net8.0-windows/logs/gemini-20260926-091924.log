\":705625,\"suggestedTranslation\":\"Một sự hy sinh nhỏ trên con đường theo đuổi khoa học.\",\"rating\":10.0},\n  {\"id\":705626,\"suggestedTranslation\":\"Cùng luyện tập phản xạ giống Cà Ruột nào!\",\"rating\":10.0},\n  {\"id\":705627,\"suggestedTranslation\":\"Thời gian phản ứng của đối tượng đang cải thiện đều đặn!\",\"rating\":10.0},\n  {\"id\":705628,\"suggestedTranslation\":\"Cái này chắc sẽ giúp cải thiện đáng kể thời gian phản ứng của Cà Ruột nhà tôi.\",\"rating\":10.0},\n  {\"id\":705629,\"suggestedTranslation\":\"Có vẻ tôi đã làm quá tay rồi.\",\"rating\":10.0},\n  {\"id\":705630,\"suggestedTranslation\":\"Tôi cần phải tăng tốc độ cho Cà Ruột của mình.\",\"rating\":10.0},\n  {\"id\":705631,\"suggestedTranslation\":\"Nhanh nữa... nhanh nữa lên!\",\"rating\":10.0},\n  {\"id\":705632,\"suggestedTranslation\":\"Mình nên lắp ráp cái này nhanh lên mới được.\",\"rating\":10.0},\n  {\"id\":705633,\"suggestedTranslation\":\"Cậu không thể ngăn cản tiến bộ! Nhưng cái này sẽ làm chậm nó lại...\",\"rating\":10.0},\n  {\"id\":705634,\"suggestedTranslation\":\"Giờ thì đang khỏe lên rồi đấy!\",\"rating\":10.0},\n  {\"id\":705635,\"suggestedTranslation\":\"Con Cà Ruột này... sẽ không thể cản phá nổi!!\",\"rating\":10.0},\n  {\"id\":705636,\"suggestedTranslation\":\"Điều này sẽ giúp cải thiện sức chịu đựng của Cà Ruột tôi.\",\"rating\":9.5},\n  {\"id\":705637,\"suggestedTranslation\":\"Cậu đã chứng minh được quan điểm của mình rồi đấy.\",\"rating\":10.0},\n  {\"id\":705638,\"suggestedTranslation\":\"Chuẩn xác rồi.\",\"rating\":10.0},\n  {\"id\":705639,\"suggestedTranslation\":\"Mọi thứ đã hóa thành tro bụi rồi!\",\"rating\":10.0},\n  {\"id\":705640,\"suggestedTranslation\":\"Thực ra đây là vòng tròn đích hơn là một vạch kẻ.\",\"rating\":10.0},\n  {\"id\":705641,\"suggestedTranslation\":\"Ha HA! Khoa học đã chiến thắng!\",\"rating\":10.0},\n  {\"id\":705642,\"suggestedTranslation\":\"Haizz... chúc mừng nhé, {winner}.\",\"rating\":10.0},\n  {\"id\":705643,\"suggestedTranslation\":\"Vạch đích đã ở trước mắt rồi.\",\"rating\":10.0},\n  {\"id\":705644,\"suggestedTranslation\":\"Đây là một nơi đủ tốt để bắt đầu.\",\"rating\":10.0},\n  {\"id\":705645,\"suggestedTranslation\":\"Chà, ít ra cũng là một khởi đầu.\",\"rating\":10.0},\n  {\"id\":705646,\"suggestedTranslation\":\"Thật là một đống hỗn độn.\",\"rating\":10.0},\n  {\"id\":705647,\"suggestedTranslation\":\"Ta cho rằng dù thế nào đi nữa, nó vẫn chỉ là một loại rau củ có tri giác.\",\"rating\":10.0},\n  {\"id\":705648,\"suggestedTranslation\":\"Con Cà Ruột này trông có vẻ đã sẵn sàng để đua rồi!\",\"rating\":10.0},\n  {\"id\":705649,\"suggestedTranslation\":\"Hy vọng là cán cân sẽ nghiêng về phía tôi.\",\"rating\":10.0},\n  {\"id\":705650,\"suggestedTranslation\":\"Cái này sẽ giúp kiểm định Cà Ruột của tôi.\",\"rating\":9.0},\n  {\"id\":705651,\"suggestedTranslation\":\"Trông khá nhiều hạt đấy, nếu ngươi hỏi ta.\",\"rating\":10.0},\n  {\"id\":705652,\"suggestedTranslation\":\"Chào nhé, mấy cái cây điệu đà!\",\"rating\":10.0},\n  {\"id\":705653,\"suggestedTranslation\":\"Ta không muốn thuyền ván của mình bay đi mất đâu.\",\"rating\":9.0},\n  {\"id\":705654,\"suggestedTranslation\":\"Giờ thì ta có thể dựng một cái dây neo rồi.\",\"rating\":9.0},\n  {\"id\":705655,\"suggestedTranslation\":\"Mọi chuyện có vẻ hơi nóng bỏng rồi đây.\",\"rating\":10.0},\n  {\"id\":705656,\"suggestedTranslation\":\"Nó có vẻ thích một mẩu than củi đấy.\",\"rating\":10.0},\n  {\"id\":705657,\"suggestedTranslation\":\"Ta đang tò mò đến phát cuồng để xem có gì ở trỏng kìa.\",\"rating\":10.0},\n  {\"id\":705658,\"suggestedTranslation\":\"Đúng là một cây mái chèo cực kỳ tiện lợi.\",\"rating\":10.0},\n  {\"id\":705659,\"suggestedTranslation\":\"Cái đó sẽ lái ta đi đúng hướng. Và cả hướng trái nữa.\",\"rating\":10.0},\n  {\"id\":705660,\"suggestedTranslation\":\"Cái đó sắp trở thành bánh lái tàu rồi.\",\"rating\":10.0},\n  {\"id\":705661,\"suggestedTranslation\":\"Đúng là một chuyến đi bập bênh!\",\"rating\":10.0},\n  {\"id\":705662,\"suggestedTranslation\":\"Liệu ta có trông giống một chú ngựa con không nhỉ?\",\"rating\":10.0},\n  {\"id\":705663,\"suggestedTranslation\":\"Nó không phải lừa, nhưng chắc chắn là đống tro rồi.\",\"rating\":10.0},\n  {\"id\":705664,\"suggestedTranslation\":\"Nó cứ làm lơ trừ khi ta dâng cho nó thứ gì đó.\",\"rating\":10.0},\n  {\"id\":705665,\"suggestedTranslation\":\"Ta đã cố hết sức để tỏ ra tôn kính đấy.\",\"rating\":10.0},\n  {\"id\":705666,\"suggestedTranslation\":\"Ta đang hừng hực khí thế rồi đây!\",\"rating\":10.0},\n  {\"id\":705667,\"suggestedTranslation\":\"Hừm, không dám nhận là ta biết múa giáo đâu.\",\"rating\":10.0},\n  {\"id\":705668,\"suggestedTranslation\":\"Một bữa tiệc xứng tầm với ta.\",\"rating\":10.0},\n  {\"id\":705669,\"suggestedTranslation\":\"Bữa ăn mà chỉ có quái thú mới thích.\",\"rating\":10.0},\n  {\"id\":705670,\"suggestedTranslation\":\"Chẳng có gì cầu kỳ cả.\",\"rating\":10.0},\n  {\"id\":705671,\"suggestedTranslation\":\"Con thỏ đó thực sự làm bừng sáng cả căn phòng.\",\"rating\":10.0},\n  {\"id\":705672,\"suggestedTranslation\":\"Con thỏ đó chẳng thắp sáng được cái gì sất.\",\"rating\":10.0},\n  {\"id\":705673,\"suggestedTranslation\":\"Ta biết đúng chỗ dành cho nó rồi.\",\"rating\":10.0},\n  {\"id\":705674,\"suggestedTranslation\":\"Con thỏ đó thực sự làm bừng sáng cả căn phòng.\",\"rating\":10.0},\n  {\"id\":705675,\"suggestedTranslation\":\"Con thỏ đó chẳng thắp sáng được cái gì sất.\",\"rating\":10.0},\n  {\"id\":705676,\"suggestedTranslation\":\"Ta biết đúng chỗ dành cho nó rồi.\",\"rating\":10.0},\n  {\"id\":705677,\"suggestedTranslation\":\"Tạm thời thì mọi thứ vẫn đang yên bình.\",\"rating\":10.0},\n  {\"id\":705678,\"suggestedTranslation\":\"Ta nghĩ hôm nay tất cả chúng ta đã học được nhiều điều.\",\"rating\":10.0},\n  {\"id\":705679,\"suggestedTranslation\":\"Nó phải được xây dựng lên, vì mục đích khoa học!\",\"rating\":10.0},\n  {\"id\":705680,\"suggestedTranslation\":\"Nó làm từ cà rốt, nên khoa học bảo là phải tốt cho sức khỏe.\",\"rating\":10.0},\n  {\"id\":705681,\"suggestedTranslation\":\"Màu xanh dương là hương vị mang tính khoa học nhất.\",\"rating\":10.0},\n  {\"id\":705682,\"suggestedTranslation\":\"Một món tráng miệng lúc lắc.\",\"rating\":10.0},\n  {\"id\":705683,\"suggestedTranslation\":\"Nhảy cẫng vào miệng ta ngay nào!\",\"rating\":10.0},\n  {\"id\":705684,\"suggestedTranslation\":\"Ngửi cứ như đồ nướng chay ấy.\",\"rating\":10.0},\n  {\"id\":705685,\"suggestedTranslation\":\"Con thỏ đó trông có vẻ đói rồi.\",\"rating\":10.0},\n  {\"id\":705686,\"suggestedTranslation\":\"Nên làm gì đây...\",\"rating\":10.0},\n  {\"id\":705687,\"suggestedTranslation\":\"Ta nên cẩn thận khi đưa cái này cho ai đó.\",\"rating\":10.0},\n  {\"id\":705688,\"suggestedTranslation\":\"Đó là cột bài đăng\",\"rating\":9.0},\n  {\"id\":705689,\"suggestedTranslation\":\"Nó có ở trên cột đâu cơ chứ.\",\"rating\":9.0},\n  {\"id\":705690,\"suggestedTranslation\":\"Nó sẽ đặt lên cột nào đây?\",\"rating\":9.0},\n  {\"id\":705691,\"suggestedTranslation\":\"WILLOW ơi!\",\"rating\":10.0},\n  {\"id\":705692,\"suggestedTranslation\":\"Nó có một cơn thèm ăn khổng lồ.\",\"rating\":10.0},\n  {\"id\":705693,\"suggestedTranslation\":\"Nó đang tràn đầy hứa hẹn!\",\"rating\":10.0},\n  {\"id\":705694,\"suggestedTranslation\":\"Nó đến từ những tầng sâu thẳm hơn.\",\"rating\":10.0},\n  {\"id\":705695,\"suggestedTranslation\":\"Ngửi như mùi lông bị cháy xém.\",\"rating\":10.0},\n  {\"id\":705696,\"suggestedTranslation\":\"Biết đâu nó lại thích một chiếc lông vũ để chơi đùa...\",\"rating\":10.0},\n  {\"id\":705697,\"suggestedTranslation\":\"Nên làm gì đây...\",\"rating\":10.0},\n  {\"id\":705698,\"suggestedTranslation\":\"Đó là một... thứ.\",\"rating\":10.0},\n  {\"id\":705699,\"suggestedTranslation\":\"Quả là một thực vật hạnh phúc!\",\"rating\":9.0},\n  {\"id\":705700,\"suggestedTranslation\":\"Nó hơi cáu kỉnh một chút.\",\"rating\":10.0},\n  {\"id\":705701,\"suggestedTranslation\":\"Theo suy luận khoa học của tôi thì thực vật này có vẻ cô đơn.\",\"rating\":9.0},\n  {\"id\":705702,\"suggestedTranslation\":\"Nó đang thèm được trò chuyện đôi chút.\",\"rating\":10.0},\n  {\"id\":705703,\"suggestedTranslation\":\"Chắc tôi phải nhổ bớt cỏ dại rồi...\",\"rating\":10.0},\n  {\"id\":705704,\"suggestedTranslation\":\"Trông nó có vẻ thiếu nước trầm trọng.\",\"rating\":10.0},\n  {\"id\":705705,\"suggestedTranslation\":\"Thực vật tội nghiệp này cần chất dinh dưỡng!\",\"rating\":9.0},\n  {\"id\":705706,\"suggestedTranslation\":\"Có quá nhiều cây đang tranh giành không gian chật hẹp này.\",\"rating\":10.0},\n  {\"id\":705707,\"suggestedTranslation\":\"Thời tiết mùa này không mấy đối xử tốt với thực vật này.\",\"rating\":9.0},\n  {\"id\":705708,\"suggestedTranslation\":\"Thực vật này có vẻ đang chịu nhiều áp lực.\",\"rating\":9.0},\n  {\"id\":705709,\"suggestedTranslation\":\"Thứ đó sắp bắt lửa rồi.\",\"rating\":9.5},\n  {\"id\":705710,\"suggestedTranslation\":\"Tối quá không thấy gì cả!\",\"rating\":10.0},\n  {\"id\":705711,\"suggestedTranslation\":\"Hừm. Mỏ nhọn.\",\"rating\":10.0},\n  {\"id\":705712,\"suggestedTranslation\":\"Vị cứ như ngày lễ vậy.\",\"rating\":10.0},\n  {\"id\":705713,\"suggestedTranslation\":\"Tôi có linh cảm không lành về chuyện này.\",\"rating\":10.0},\n  {\"id\":705714,\"suggestedTranslation\":\"Tôi để nó trên đó lâu quá rồi.\",\"rating\":10.0},\n  {\"id\":705715,\"suggestedTranslation\":\"Mấy nguyên liệu đó chẳng làm ra được món gì cả.\",\"rating\":10.0},\n  {\"id\":705716,\"suggestedTranslation\":\"Đến lúc đi thôi!\",\"rating\":10.0},\n  {\"id\":705717,\"suggestedTranslation\":\"chỉ_được_sử_dụng_bởi_wendy\",\"rating\":10.0},\n  {\"id\":705718,\"suggestedTranslation\":\"Tớ tưởng mình thấy ông ấy ở quanh đây chứ...\",\"rating\":10.0},\n  {\"id\":705719,\"suggestedTranslation\":\"Trống rỗng á? Giờ thì tớ thấy hơi tệ rồi đấy...\",\"rating\":10.0},\n  {\"id\":705720,\"suggestedTranslation\":\"Xin lỗi chú...? Hừm, có vẻ chú ấy đang bận.\",\"rating\":10.0},\n  {\"id\":705721,\"suggestedTranslation\":\"Trò chơi sẽ kết thúc khá nhanh đấy, có lẽ tớ nên tìm thêm người trước đã.\",\"rating\":10.0},\n  {\"id\":705722,\"suggestedTranslation\":\"Ờm, tớ không chắc tụi nó có thể trốn ở đâu quanh đây nữa.\",\"rating\":10.0},\n  {\"id\":705723,\"suggestedTranslation\":\"Xin lỗi mấy nhóc mèo nhé, tớ không thể chơi với các cậu cả ngày được!\",\"rating\":10.0},\n  {\"id\":705724,\"suggestedTranslation\":\"Tớ nghĩ nó bị khóa rồi.\",\"rating\":10.0},\n  {\"id\":705725,\"suggestedTranslation\":\"Xin lỗi, chắc là bạn không mặc được món đó đâu.\",\"rating\":10.0},\n  {\"id\":705726,\"suggestedTranslation\":\"Ối, có vẻ tất cả bọn họ đã đi rồi...\",\"rating\":10.0},\n  {\"id\":705727,\"suggestedTranslation\":\"chỉ_được_sử_dụng_bởi_wurt\",\"rating\":10.0},\n  {\"id\":705728,\"suggestedTranslation\":\"Cái này không dành cho chúng ta đâu, Woby.\",\"rating\":10.0},\n  {\"id\":705729,\"suggestedTranslation\":\"Tớ đã thử nói bằng tiếng quái vật đầm lầy, nhưng hình như tớ vừa xúc phạm tụi nó thì phải.\",\"rating\":10.0},\n  {\"id\":705730,\"suggestedTranslation\":\"Chắc tớ cũng chẳng thể bảo một con gấu bông phải làm gì đâu.\",\"rating\":10.0},\n  {\"id\":705731,\"suggestedTranslation\":\"Khoan đã, tớ chưa chuẩn bị xong!\",\"rating\":10.0},\n  {\"id\":705732,\"suggestedTranslation\":\"chỉ_được_sử_dụng_bởi_wendy\",\"rating\":10.0},\n  {\"id\":705733,\"suggestedTranslation\":\"Tớ không nghĩ bụng dạ mình chịu nổi thứ đó đâu.\",\"rating\":10.0},\n  {\"id\":705734,\"suggestedTranslation\":\"chỉ_được_sử_dụng_bởi_wx78\",\"rating\":10.0},\n  {\"id\":705735,\"suggestedTranslation\":\"chỉ_được_sử_dụng_bởi_wx78\",\"rating\":10.0},\n  {\"id\":705736,\"suggestedTranslation\":\"Chúng ta quay lại sau đi.\",\"rating\":10.0},\n  {\"id\":705737,\"suggestedTranslation\":\"Tớ không thể! Tớ cần được y tế chăm sóc! Hộp sơ cứu đâu rồi?!\",\"rating\":10.0},\n  {\"id\":705738,\"suggestedTranslation\":\"Tớ không muốn lãng phí vật tư đâu.\",\"rating\":10.0},\n  {\"id\":705739,\"suggestedTranslation\":\"Tớ không nghĩ cách đó khả thi đâu.\",\"rating\":10.0},\n  {\"id\":705740,\"suggestedTranslation\":\"Chúng ta phải đợi thôi, Woby!\",\"rating\":10.0},\n  {\"id\":705741,\"suggestedTranslation\":\"Tớ nghĩ Woby có thể sẽ nổi ghen nếu tớ cứ nhận nuôi thú cưng đấy.\",\"rating\":10.0},\n  {\"id\":705742,\"suggestedTranslation\":\"Tớ phải xuống ngựa nếu muốn làm việc đó cho đàng hoàng.\",\"rating\":10.0},\n  {\"id\":705743,\"suggestedTranslation\":\"Chăm sóc một đứa thế này là đủ mệt rồi.\",\"rating\":10.0},\n  {\"id\":705744,\"suggestedTranslation\":\"Khỉ thật! Tớ không đủ nhanh.\",\"rating\":10.0},\n  {\"id\":705745,\"suggestedTranslation\":\"Ái! An toàn phòng cháy đâu rồi!\",\"rating\":10.0},\n  {\"id\":705746,\"suggestedTranslation\":\"Quả bí ngô đó đang được khắc mà, Woby!\",\"rating\":9.5},\n  {\"id\":705747,\"suggestedTranslation\":\"chỉ_được_sử_dụng_bởi_willow\",\"rating\":10.0},\n  {\"id\":705748,\"suggestedTranslation\":\"chỉ_được_sử_dụng_bởi_willow\",\"rating\":10.0},\n  {\"id\":705749,\"suggestedTranslation\":\"chỉ_được_sử_dụng_bởi_winona\",\"rating\":10.0},\n  {\"id\":705750,\"suggestedTranslation\":\"chỉ_được_sử_dụng_bởi_winona\",\"rating\":10.0},\n  {\"id\":705751,\"suggestedTranslation\":\"chỉ_được_sử_dụng_bởi_willow\",\"rating\":10.0},\n  {\"id\":705752,\"suggestedTranslation\":\"chỉ_được_sử_dụng_bởi_willow\",\"rating\":10.0},\n  {\"id\":705753,\"suggestedTranslation\":\"chỉ_được_sử_dụng_bởi_wurt\",\"rating\":10.0},\n  {\"id\":705754,\"suggestedTranslation\":\"Việc đó đi ngược lại mọi quy tắc an toàn phòng cháy mà chúng ta đã học.\",\"rating\":10.0},\n  {\"id\":705755,\"suggestedTranslation\":\"Đồ tớ đang mặc ổn chán mà.\",\"rating\":10.0},\n  {\"id\":705756,\"suggestedTranslation\":\"Cậu bị lạc trong đó à? Ha... ha... à mà, đùa tí thôi.\",\"rating\":10.0},\n  {\"id\":705757,\"suggestedTranslation\":\"Ừm, tớ nghĩ chúng ta đang quên mất thứ gì đó...\",\"rating\":10.0},\n  {\"id\":705758,\"suggestedTranslation\":\"Tớ sẽ phải đợi cho đến khi tóc của chúng mọc lại vậy.\",\"rating\":10.0},\n  {\"id\":705759,\"suggestedTranslation\":\"Chúng ta đã nạp đầy năng lượng rồi, Woby!\",\"rating\":10.0},\n  {\"id\":705760,\"suggestedTranslation\":\"Không đủ năng lượng rồi.\",\"rating\":10.0},\n  {\"id\":705761,\"suggestedTranslation\":\"Con này nhỏ quá thể.\",\"rating\":10.0},\n  {\"id\":705762,\"suggestedTranslation\":\"Không. Chưa đủ lớn.\",\"rating\":10.0},\n  {\"id\":705763,\"suggestedTranslation\":\"Mình cần vài món đồ tiếp tế!\",\"rating\":10.0},\n  {\"id\":705764,\"suggestedTranslation\":\"Cậu có bận không? Muốn nghe về con bọ tớ tìm thấy hôm qua không?\",\"rating\":10.0},\n  {\"id\":705765,\"suggestedTranslation\":\"Khoan đã... đây thậm chí còn chẳng phải bản thiết kế đúng.\",\"rating\":10.0},\n  {\"id\":705766,\"suggestedTranslation\":\"Chẳng có lý gì cả.\",\"rating\":10.0},\n  {\"id\":705767,\"suggestedTranslation\":\"Chắc tớ sẽ thử khi mặt đất ngừng rung chuyển vậy.\",\"rating\":10.0},\n  {\"id\":705768,\"suggestedTranslation\":\"Ước gì mình có vài viên kẹo dẻo... thôi đành chịu.\",\"rating\":10.0},\n  {\"id\":705769,\"suggestedTranslation\":\"Này nếu bạn đang đây rồi, có muốn nghe một vài câu chuyện rùng rợn mà tôi thường nghe trên radio không?\",\"rating\":10.0},\n  {\"id\":705770,\"suggestedTranslation\":\"Tay tớ không dài đến thế đâu.\",\"rating\":10.0},\n  {\"id\":705771,\"suggestedTranslation\":\"Này, có cái mũ vướng đường kìa!\",\"rating\":10.0},\n  {\"id\":705772,\"suggestedTranslation\":\"Cái đó có người chiếm rồi, Woby.\",\"rating\":10.0},\n  {\"id\":705773,\"suggestedTranslation\":\"Ồ không, nó đang tan chảy kìa! Chúng ta không trang trí nó được nữa đâu, Woby.\",\"rating\":10.0},\n  {\"id\":705774,\"suggestedTranslation\":\"Tớ không thể xây nó cao hơn thế được đâu, Woby!\",\"rating\":10.0},\n  {\"id\":705775,\"suggestedTranslation\":\"Á chà, nó khô cạn rồi. Để lát nữa thử lại nhé!\",\"rating\":10.0},\n  {\"id\":705776,\"suggestedTranslation\":\"Chắc chúng ta nên chọn chỗ khác thôi, Woby.\",\"rating\":10.0},\n  {\"id\":705777,\"suggestedTranslation\":\"Việc đó có vẻ hơi nguy hiểm.\",\"rating\":10.0},\n  {\"id\":705778,\"suggestedTranslation\":\"Chắc tớ phải chờ thôi.\",\"rating\":10.0},\n  {\"id\":705779,\"suggestedTranslation\":\"Tớ nên đảm bảo nó trống trước đã.\",\"rating\":10.0},\n  {\"id\":705780,\"suggestedTranslation\":\"Đừng bỏ cuộc, Walter!\",\"rating\":10.0},\n  {\"id\":705781,\"suggestedTranslation\":\"Khoan đã... Woby, cậu có nhớ nó trông thế nào không?\",\"rating\":10.0},\n  {\"id\":705782,\"suggestedTranslation\":\"Trừ khi tớ đang trồng cả một vườn rong biển.\",\"rating\":10.0},\n  {\"id\":705783,\"suggestedTranslation\":\"Một Hướng đạo sinh Cây Thông biết rõ phải dùng đúng dụng cụ. Và đây không phải loại đó.\",\"rating\":10.0},\n  {\"id\":705784,\"suggestedTranslation\":\"Ôi!\",\"rating\":10.0},\n  {\"id\":705785,\"suggestedTranslation\":\"Nếu điều đó làm cậu thấy khá hơn, thì dù sao hồn ma cũng thú vị hơn nhiều.\",\"rating\":10.0},\n  {\"id\":705786,\"suggestedTranslation\":\"Chắc họ đang bận rồi.\",\"rating\":10.0},\n  {\"id\":705787,\"suggestedTranslation\":\"Khỉ thật. Nó không hoạt động.\",\"rating\":10.0},\n  {\"id\":705788,\"suggestedTranslation\":\"Chúng ta có thể đợi đến khi họ xong việc. Phải không Woby?\",\"rating\":10.0},\n  {\"id\":705789,\"suggestedTranslation\":\"Chúng ta không thể chơi cho đến khi có lỗ cờ, Woby!\",\"rating\":10.0},\n  {\"id\":705790,\"suggestedTranslation\":\"Tớ đã có linh cảm là nó sẽ không hiệu quả...\",\"rating\":10.0},\n  {\"id\":705791,\"suggestedTranslation\":\"Ồ, ớ... Tớ nghĩ họ đang bận. Bận chết ấy.\",\"rating\":10.0},\n  {\"id\":705792,\"suggestedTranslation\":\"Tớ biết cái đó rồi.\",\"rating\":10.0},\n  {\"id\":705793,\"suggestedTranslation\":\"Đã có sẵn một ít vật phẩm trong đó rồi.\",\"rating\":10.0},\n  {\"id\":705794,\"suggestedTranslation\":\"Tớ không nghĩ mình nên đặt cái đó ở đấy... nhỉ?\",\"rating\":10.0}\n]",
