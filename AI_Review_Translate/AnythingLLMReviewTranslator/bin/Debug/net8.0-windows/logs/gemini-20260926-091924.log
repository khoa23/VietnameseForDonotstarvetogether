anslation\": \"Tớ biết cậu nghĩ thế nào về bọn mèo rồi đấy Woby, nhưng thế này vẫn có vẻ hơi tệ.\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709168,\n    \"suggestedTranslation\": \"Có phải vì tớ bảo đài phát thanh sẽ làm sách trở nên lỗi thời không?\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709169,\n    \"suggestedTranslation\": \"Cả cô nữa sao, cô %s!!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709170,\n    \"suggestedTranslation\": \"Chào cô %s! Cô có cần giúp qua đường không?\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709171,\n    \"suggestedTranslation\": \"Chà, cô ấy đã sống một cuộc đời trọn vẹn... thôi mà, đừng lườm nữa! Cháu đi kiếm tim đây!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709172,\n    \"suggestedTranslation\": \"Cuộc tấn công của thủ thư sát nhân!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709173,\n    \"suggestedTranslation\": \"Cảm ơn cô %s!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709174,\n    \"suggestedTranslation\": \"%s? Sao cậu lại nhìn tớ kiểu đó cơ chứ...?\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709175,\n    \"suggestedTranslation\": \"Cậu bảo là cậu đang lắng nghe lúc tớ giảng về an toàn phòng cháy cơ mà!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709176,\n    \"suggestedTranslation\": \"Chào %s!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709177,\n    \"suggestedTranslation\": \"Woby, ra đây mau! Một trái tim kìa! ...Thôi được rồi, tớ tự đi lấy vậy.\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709178,\n    \"suggestedTranslation\": \"Bắt lấy cô ta đi Woby! Cô ta là kẻ sát nhân đấy!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709179,\n    \"suggestedTranslation\": \"Giờ thì tớ hiểu vì sao Woby thích cậu rồi!\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709180,\n    \"suggestedTranslation\": \"chỉ_được_sử_dụng_bởi_willow\",\n    \"rating\": 10.0\n  },\n  {\n    \"id\": 709181,\n    \"suggestedTranslation\": \"Tớ cứ tưởng anh ấy là người ổn chứ... có lẽ tớ đã l