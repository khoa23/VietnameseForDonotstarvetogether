            "text": "[\n  {\"id\":702965,\"suggestedTranslation\":\"Trái đất đang tạo ra những mầm cây bé nhỏ.\",\"rating\":9.0},\n  {\"id\":702966,\"suggestedTranslation\":\"Đó là một hạt giống.\",\"rating\":9.0},\n  {\"id\":702967,\"suggestedTranslation\":\"Thế là hết chỗ đó.\",\"rating\":9.0},\n  {\"id\":702968,\"suggestedTranslation\":\"Giờ thì chỉ còn là tro tàn.\",\"rating\":9.0},\n  {\"id\":702969,\"suggestedTranslation\":\"Giờ thì ta có thể cho mọi người xem những gì ta tìm được rồi!\",\"rating\":9.0},\n  {\"id\":702970,\"suggestedTranslation\":\"Một sinh vật nhỏ bé nghịch ngợm.\",\"rating\":9.0},\n  {\"id\":702971,\"suggestedTranslation\":\"Chủ của nó đã hết mạng rồi.\",\"rating\":9.0},\n  {\"id\":702972,\"suggestedTranslation\":\"Đó là một cái ổ trong gốc cây.\",\"rating\":9.0},\n  {\"id\":702973,\"suggestedTranslation\":\"Mũ tai mèo!\",\"rating\":9.0},\n  {\"id\":702974,\"suggestedTranslation\":\"Chuột có bánh xe, khoa học tiếp theo sẽ nghĩ ra cái gì đây?\",\"rating\":9.0},\n  {\"id\":702975,\"suggestedTranslation\":\"Ta nghĩ mình nhấc nổi cục này.\",\"rating\":9.0},\n  {\"id\":702976,\"suggestedTranslation\":\"Nó ở ngoài tầm với.\",\"rating\":9.0},\n  {\"id\":702977,\"suggestedTranslation\":\"Nó bị nhũn rồi.\",\"rating\":9.0},\n  {\"id\":702978,\"suggestedTranslation\":\"Không phải tại tôi!\",\"rating\":9.0},\n  {\"id\":702979,\"suggestedTranslation\":\"Ngon tuyệt!\",\"rating\":9.0},\n  {\"id\":702980,\"suggestedTranslation\":\"Khả năng quang hợp của nó thật đáng ngờ.\",\"rating\":9.0},\n  {\"id\":702981,\"suggestedTranslation\":\"Tự hỏi liệu cục đá tảng đó có dịch chuyển được không.\",\"rating\":9.0},\n  {\"id\":702982,\"suggestedTranslation\":\"Tôi phải đợi ai đó rời đi mới vào được.\",\"rating\":9.0},\n  {\"id\":702983,\"suggestedTranslation\":\"Chính trái đất cũng từ chối tôi!\",\"rating\":9.0},\n  {\"id\":702984,\"suggestedTranslation\":\"Cá là dưới đó có đủ thứ để khám phá.\",\"rating\":9.0},\n  {\"id\":702985,\"suggestedTranslation\":\"Chắc nó đang giấu thứ gì đó.\",\"rating\":9.0},\n  {\"id\":702986,\"suggestedTranslation\":\"Mặt đất đông đúc quá!\",\"rating\":9.0},\n  {\"id\":702987,\"suggestedTranslation\":\"Chắc tôi cứ ở dưới này thôi.\",\"rating\":9.0},\n  {\"id\":702988,\"suggestedTranslation\":\"Tạm thời khám phá thế là đủ rồi.\",\"rating\":9.0},\n  {\"id\":702989,\"suggestedTranslation\":\"Đó là một cây dương xỉ.\",\"rating\":9.0},\n  {\"id\":702990,\"suggestedTranslation\":\"Đó là một cây dương xỉ héo.\",\"rating\":9.0},\n  {\"id\":702991,\"suggestedTranslation\":\"Hết hơi rồi!\",\"rating\":9.0},\n  {\"id\":702992,\"suggestedTranslation\":\"Nó có thể là con gì nhỉ?\",\"rating\":9.0},\n  {\"id\":702993,\"suggestedTranslation\":\"Cẩn thận, nó có thể thức giấc đấy.\",\"rating\":9.0},\n  {\"id\":702994,\"suggestedTranslation\":\"Nó đang bốc hỏa đấy!\",\"rating\":9.0},\n  {\"id\":702995,\"suggestedTranslation\":\"Mệt mỏi thật đấy.\",\"rating\":9.0},\n  {\"id\":702996,\"suggestedTranslation\":\"Tôi không chắc nó thổi về hướng nào nữa.\",\"rating\":9.0},\n  {\"id\":702997,\"suggestedTranslation\":\"Mọi thứ đang nóng lên thực sự rồi.\",\"rating\":9.0},\n  {\"id\":702998,\"suggestedTranslation\":\"Còn chướng khí thì sao nhỉ?\",\"rating\":9.0},\n  {\"id\":702999,\"suggestedTranslation\":\"Đó là một sợi dây thừng leo trèo.\",\"rating\":9.0},\n  {\"id\":703000,\"suggestedTranslation\":\"Tôi xin cái bát lớn hơn được không? Cái này trông hơi ít tôm.\",\"rating\":9.0},\n  {\"id\":703001,\"suggestedTranslation\":\"Nó nhỏ, tối màu và có mùi như gỗ cháy.\",\"rating\":9.0},\n  {\"id\":703002,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":9.0},\n  {\"id\":703003,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":9.0},\n  {\"id\":703004,\"suggestedTranslation\":\"Nó muốn một thứ kinh khủng nào đó.\",\"rating\":9.0},\n  {\"id\":703005,\"suggestedTranslation\":\"Họ đến đây chỉ để gây kịch tính thôi.\",\"rating\":9.0},\n  {\"id\":703006,\"suggestedTranslation\":\"Có ai đang diễn kịch à?\",\"rating\":9.0},\n  {\"id\":703007,\"suggestedTranslation\":\"Khoan đã, đó là...?\",\"rating\":9.0},\n  {\"id\":703008,\"suggestedTranslation\":\"Đây là một cái bẫy! Cảm giác quá... dàn dựng.\",\"rating\":9.0},\n  {\"id\":703009,\"suggestedTranslation\":\"Một đống quân cờ vua bị vỡ.\",\"rating\":9.0},\n  {\"id\":703010,\"suggestedTranslation\":\"Lại một đống quân cờ vua bị vỡ khác.\",\"rating\":9.0},\n  {\"id\":703011,\"suggestedTranslation\":\"Thậm chí còn nhiều quân cờ vua vỡ hơn nữa.\",\"rating\":9.0},\n  {\"id\":703012,\"suggestedTranslation\":\"Nó nặng y như vẻ bề ngoài của nó.\",\"rating\":9.0},\n  {\"id\":703013,\"suggestedTranslation\":\"Một con Kiến Sư Tử tĩnh lặng.\",\"rating\":9.0},\n  {\"id\":703014,\"suggestedTranslation\":\"Nhìn gần thì nó lớn hơn nhiều.\",\"rating\":9.0},\n  {\"id\":703015,\"suggestedTranslation\":\"Không hiểu sao trông nó còn cáu bẳn hơn con thật.\",\"rating\":9.0},\n  {\"id\":703016,\"suggestedTranslation\":\"Bức tượng này khá là cơ bắp đấy.\",\"rating\":9.0},\n  {\"id\":703017,\"suggestedTranslation\":\"Rất ra dáng điêu khắc.\",\"rating\":9.0},\n  {\"id\":703018,\"suggestedTranslation\":\"Đó là một quân tượng bằng đá.\",\"rating\":9.0},\n  {\"id\":703019,\"suggestedTranslation\":\"Mấy quân cờ vua đang tự di chuyển kìa!\",\"rating\":9.0},\n  {\"id\":703020,\"suggestedTranslation\":\"Trông đẹp đấy chứ, phải không?\",\"rating\":9.0},\n  {\"id\":703021,\"suggestedTranslation\":\"Chúng ta có một người chiến thắng!\",\"rating\":9.0},\n  {\"id\":703022,\"suggestedTranslation\":\"Chắc nó sẽ làm một cái cột cào móng tuyệt vời đấy.\",\"rating\":9.0},\n  {\"id\":703023,\"suggestedTranslation\":\"Thứ đó là mối bận tâm ít nhất của tôi.\",\"rating\":9.0},\n  {\"id\":703024,\"suggestedTranslation\":\"Và tôi thậm chí còn chưa bị ăn thịt!\",\"rating\":9.0},\n  {\"id\":703025,\"suggestedTranslation\":\"Vẫn chưa cáu bẳn bằng Maxwell đâu.\",\"rating\":9.0},\n  {\"id\":703026,\"suggestedTranslation\":\"Giờ thì hắn ta đi đâu mất tiêu rồi.\",\"rating\":9.0},\n  {\"i