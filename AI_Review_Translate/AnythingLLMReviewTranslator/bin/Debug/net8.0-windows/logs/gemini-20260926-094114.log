            "text": "[\n  {\"id\":702665,\"suggestedTranslation\":\"Con này ít hôi hơn mấy con khác một chút.\",\"rating\":9.0},\n  {\"id\":702666,\"suggestedTranslation\":\"Nó đi theo rất ôn hòa.\",\"rating\":9.0},\n  {\"id\":702667,\"suggestedTranslation\":\"Là một con bò lai!\",\"rating\":9.0},\n  {\"id\":702668,\"suggestedTranslation\":\"Chúng ta là bạn bò mãi mãi.\",\"rating\":9.0},\n  {\"id\":702669,\"suggestedTranslation\":\"Trời ơi, nó buồn quá kìa.\",\"rating\":9.0},\n  {\"id\":702670,\"suggestedTranslation\":\"Trông nó có vẻ cực kỳ tức giận.\",\"rating\":9.0},\n  {\"id\":702671,\"suggestedTranslation\":\"Hừm, có lẽ có quá nhiều thức ăn bên trong nó.\",\"rating\":9.0},\n  {\"id\":702672,\"suggestedTranslation\":\"Thanh niên này có vẻ rất dễ cưỡi.\",\"rating\":9.0},\n  {\"id\":702673,\"suggestedTranslation\":\"Mấy cậu này ngủ say như chết ấy.\",\"rating\":9.0},\n  {\"id\":702674,\"suggestedTranslation\":\"Tôi không ăn đâu, cảm ơn nhé.\",\"rating\":9.0},\n  {\"id\":702675,\"suggestedTranslation\":\"Đúng là mầm mống của kiểu tóc đội mũ.\",\"rating\":9.0},\n  {\"id\":702676,\"suggestedTranslation\":\"Hơi nhiều cám so với khẩu vị của tôi.\",\"rating\":9.0},\n  {\"id\":702677,\"suggestedTranslation\":\"Nó có mùi giống nước mắt bò lai.\",\"rating\":9.0},\n  {\"id\":702678,\"suggestedTranslation\":\"Tôi đã chải chuốt cho con bò lai của mình theo mốt thời thượng nhất... và đã phải trả giá.\",\"rating\":9.0},\n  {\"id\":702679,\"suggestedTranslation\":\"Chẳng có con bò lai nào ở đây để chải chuốt cả.\",\"rating\":9.0},\n  {\"id\":702680,\"suggestedTranslation\":\"Hãy làm đẹp cho con bò lai này nào!\",\"rating\":9.0},\n  {\"id\":702681,\"suggestedTranslation\":\"Tốt hơn là tôi nên dựng cái này ở đâu đó.\",\"rating\":9.0},\n  {\"id\":702682,\"suggestedTranslation\":\"Nó làm cho bò lai trở nên thân thiện. Tôi chắc là có một lời giải thích rất khoa học.\",\"rating\":9.0},\n  {\"id\":702683,\"suggestedTranslation\":\"Nó đang bảo vệ nữ hoàng.\",\"rating\":9.0},\n  {\"id\":702684,\"suggestedTranslation\":\"Bảo vệ làn da của bạn, nhưng làm hỏng mái tóc chải chuốt tỉ mỉ của bạn.\",\"rating\":9.0},\n  {\"id\":702685,\"suggestedTranslation\":\"Nó đang nhộn nhịp hoạt động.\",\"rating\":9.0},\n  {\"id\":702686,\"suggestedTranslation\":\"Nó kêu vo ve khi bị lắc.\",\"rating\":9.0},\n  {\"id\":702687,\"suggestedTranslation\":\"Cơn giận của muỗi được đóng chai!\",\"rating\":9.0},\n  {\"id\":702688,\"suggestedTranslation\":\"Tránh xa cái gai ong đó ra khỏi tôi!\",\"rating\":9.0},\n  {\"id\":702689,\"suggestedTranslation\":\"Nó quá dính để đi lên.\",\"rating\":9.0},\n  {\"id\":702690,\"suggestedTranslation\":\"Cái đó có ở đó trước đây không nhỉ?\",\"rating\":9.0},\n  {\"id\":702691,\"suggestedTranslation\":\"Làm thế quái nào mà nó to thế được cơ chứ?!\",\"rating\":9.0},\n  {\"id\":702692,\"suggestedTranslation\":\"Sáp ong là chất bảo quản đã được khoa học chứng minh!\",\"rating\":9.0},\n  {\"id\":702693,\"suggestedTranslation\":\"Có phải tôi ngửi thấy mùi formalin không nhỉ?\",\"rating\":9.0},\n  {\"id\":702694,\"suggestedTranslation\":\"Tôi có thể ngửi thấy mùi hắn từ đây!\",\"rating\":9.0},\n  {\"id\":702695,\"suggestedTranslation\":\"Teng teng teng.\",\"rating\":9.0},\n  {\"id\":702696,\"suggestedTranslation\":\"Con gấu bông đó đang di chuyển kìa. Thú vị thật.\",\"rating\":9.0},\n  {\"id\":702697,\"suggestedTranslation\":\"Nhắc tôi đừng bao giờ chọc giận Willow nhé.\",\"rating\":9.0},\n  {\"id\":702698,\"suggestedTranslation\":\"Cuối cùng nó cũng tan tành rồi.\",\"rating\":9.0},\n  {\"id\":702699,\"suggestedTranslation\":\"Nó bị cháy xém hết rồi.\",\"rating\":9.0},\n  {\"id\":702700,\"suggestedTranslation\":\"Dâu rừng đỏ là ngon nhất.\",\"rating\":9.0},\n  {\"id\":702701,\"suggestedTranslation\":\"Tôi không nghĩ nhiệt độ làm chúng ngon hơn đâu.\",\"rating\":9.0},\n  {\"id\":702702,\"suggestedTranslation\":\"Cực kỳ ngon, dù chúng sẽ không để được lâu.\",\"rating\":9.0},\n  {\"id\":702703,\"suggestedTranslation\":\"Tốt hơn là nên ăn chúng trước khi bị hỏng!\",\"rating\":9.0},\n  {\"id\":702704,\"suggestedTranslation\":\"Tôi nghĩ nó cần được bón phân.\",\"rating\":9.0},\n  {\"id\":702705,\"suggestedTranslation\":\"Nó đang bốc cháy dữ dội.\",\"rating\":9.0},\n  {\"id\":702706,\"suggestedTranslation\":\"Trông nó có vẻ khá ốm yếu.\",\"rating\":9.0},\n  {\"id\":702707,\"suggestedTranslation\":\"Hừm, có gì đó không ổn lắm.\",\"rating\":9.0},\n  {\"id\":702708,\"suggestedTranslation\":\"Tôi nghĩ đó là loại ăn được.\",\"rating\":9.0},\n  {\"id\":702709,\"suggestedTranslation\":\"Liệu chúng có mọc lại không nhỉ?\",\"rating\":9.0},\n  {\"id\":702710,\"suggestedTranslation\":\"Sẽ chẳng có gì mọc nổi trong cái nóng này đâu.\",\"rating\":9.0},\n  {\"id\":702711,\"suggestedTranslation\":\"Nó sẽ không ra trái dâu rừng nào trong tình trạng này đâu.\",\"rating\":9.0},\n  {\"id\":702712,\"suggestedTranslation\":\"Nó đang bốc cháy dữ dội.\",\"rating\":9.0},\n  {\"id\":702713,\"suggestedTranslation\":\"Trông nó có vẻ khá ốm yếu.\",\"rating\":9.0},\n  {\"id\":702714,\"suggestedTranslation\":\"Hừm, có gì đó không ổn lắm.\",\"rating\":9.0},\n  {\"id\":702715,\"suggestedTranslation\":\"Tôi nên để chúng ở đó cho đến khi đến giờ ăn.\",\"rating\":9.0},\n  {\"id\":702716,\"suggestedTranslation\":\"Bụi cây đang nỗ lực hết sức cho đợt quả tiếp theo.\",\"rating\":9.0},\n  {\"id\":702717,\"suggestedTranslation\":\"Sức nóng thậm chí còn làm khô cả lũ dâu mọng!\",\"rating\":9.0},\n  {\"id\":702718,\"suggestedTranslation\":\"Vừa vui vẻ lại vừa đậm vị dâu.\",\"rating\":9.0},\n  {\"id\":702719,\"suggestedTranslation\":\"Mềm và xốp.\",\"rating\":9.0},\n  {\"id\":702720,\"suggestedTranslation\":\"Đó đúng là một bàn chân to chà bá.\",\"rating\":9.0},\n  {\"id\":702721,\"suggestedTranslation\":\"Một hạt dẻ điên khùng.\",\"rating\":9.0},\n  {\"id\":702722,\"suggestedTranslation\":\"Biết đâu nó chỉ đang nghỉ ngơi thì sao?\",\"rating\":9.0},\n  {\"id\":702723,\"suggestedTranslation\":\"Giờ thì chỉ cần thêm một con chim nữa thôi.\",\"rating\":9.0},\n  {\"id\":702724,\"suggestedTranslation\":\"Trông nó có vẻ hơi đói bụng rồi đấy.\",\"rating\":9.0},\n  {\"id\":702725,\"suggestedTranslation\":\"Ai là chú chim ngoan nào?\",\"rating\":9.0},\n  {\"id\":702726,\"suggestedTranslation\":\"Con chim đó chắc chắn đã chầu trời rồi.\",\"rating\":9.0},\n  {\"id\":702727,\"suggestedTranslation\":\"Ôi trời, nó đang ngủ kìa.\",\"rating\":9.0},\n  {\"id\":702728,\"suggestedTranslation\":\"Không ai cho cậu ăn trong một thời gian rồi à?\",\"rating\":9.0},\n  {\"id\":702729,\"suggestedTranslation\":\"Đó mới đúng là chim lửa chứ.\",\"rating\":9.0},\n  {\"id\":702730,\"suggestedTranslation\":\"Tôi thấy có mùi gia cầm ở đây.\",\"rating\":9.0},\n  {\"id\":702731,\"suggestedTranslation\":\"Nó đang tiến hóa thành một loài mới kìa!\",\"rating\":9.0},\n  {\"id\":702732,\"suggestedTranslation\":\"Cho tôi một lợi thế rõ rệt!\",\"rating\":9.0},\n  {\"id\":702733,\"suggestedTranslation\":\"Một quả trứng nhỏ, bình thường.\",\"rating\":9.0},\n  {\"id\":702734,\"suggestedTranslation\":\"Trứng ốp la ngon tuyệt!\",\"rating\":9.0},\n  {\"id\":702735,\"suggestedTranslation\":\"Tôi nghĩ trước đây đó là một con quạ.\",\"rating\":9.0},\n  {\"id\":702736,\"suggestedTranslation\":\"Tôi không thích cái cách nó nhìn tôi chút nào...\",\"rating\":9.0},\n  {\"id\":702737,\"suggestedTranslation\":\"Tránh xa ra, ông thầy tu!\",\"rating\":9.0},\n  {\"id\":702738,\"suggestedTranslation\":\"Ái!\",\"rating\":9.0},\n  {\"id\":702739,\"suggestedTranslation\":\"Nó đang tan rã kìa!\",\"rating\":9.0},\n  {\"id\":702740,\"suggestedTranslation\":\"Hải tặc kiêm nhà khoa học quý tộc nghe cũng có vẻ kêu đấy chứ.\",\"rating\":9.0},\n  {\"id\":702741,\"suggestedTranslation\":\"Cái này cơ bản là không an toàn chút nào.\",\"rating\":9.0},\n  {\"id\":702742,\"suggestedTranslation\":\"Đó là một thứ vũ khí tôi có thể dùng từ xa.\",\"rating\":9.0},\n  {\"id\":702743,\"suggestedTranslation\":\"Nó dùng một luồng khí mạnh để đẩy vật thể đi.\",\"rating\":9.0},\n  {\"id\":702744,\"suggestedTranslation\":\"Tập luyện tốt để thổi nến sinh nhật đây!\",\"rating\":9.0},\n  {\"id\":702745,\"suggestedTranslation\":\"Chỉ là đừng hít thở vào là được.\",\"rating\":9.0},\n  {\"id\":702746,\"suggestedTranslation\":\"Độ chính xác thật gây choáng váng.\",\"rating\":9.0},\n  {\"id\":702747,\"suggestedTranslation\":\"Mát lạnh như băng!\",\"rating\":9.0},\n  {\"id\":702748,\"suggestedTranslation\":\"Nó lấp lánh với năng lượng băng giá.\",\"rating\":9.0},\n  {\"id\":702749,\"suggestedTranslation\":\"Lúc nào cũng nên cảnh giác là khôn ngoan nhất.\",\"rating\":9.0},\n  {\"id\":702750,\"suggestedTranslation\":\"Mang tính khoa học đấy!\",\"rating\":9.0},\n  {\"id\":702751,\"suggestedTranslation\":\"Mang tính khoa học CỰC KỲ!\",\"rating\":9.0},\n  {\"id\":702752,\"suggestedTranslation\":\"Nó thật kỳ lạ và nhầy nhụa.\",\"rating\":9.0},\n  {\"id\":702753,\"suggestedTranslation\":\"Bây giờ nó khác trước rồi...\",\"rating\":9.0},\n  {\"id\":702754,\"suggestedTranslation\":\"Đó là một cây nấm.\",\"rating\":9.0},\n  {\"id\":702755,\"suggestedTranslation\":\"Nó đang ngủ.\",\"rating\":9.0},\n  {\"id\":702756,\"suggestedTranslation\":\"Tự hỏi liệu nó có mọc lại không nhỉ?\",\"rating\":9.0},\n  {\"id\":702757,\"suggestedTranslation\":\"Ván ép.\",\"rating\":9.0},\n  {\"id\":702758,\"suggestedTranslation\":\"Tôi cân tất!\",\"rating\":9.0},\n  {\"id\":702759,\"suggestedTranslation\":\"Ngươi to con thật đấy!\",\"rating\":9.0},\n  {\"id\":702760,\"suggestedTranslation\":\"Chẳng còn lại mấy mảnh ra hồn.\",\"rating\":9.0},\n  {\"id\":702761,\"suggestedTranslation\":\"Chẳng còn lại mấy mảnh ra hồn.\",\"rating\":9.0},\n  {\"id\":702762,\"suggestedTranslation\":\"Chẳng còn lại mấy mảnh ra hồn.\",\"rating\":9.0},\n  {\"id\":702763,\"suggestedTranslation\":\"Phòng khi thảm họa xảy ra.\",\"rating\":9.0},\n  {\"id\":702764,\"suggestedTranslation\":\"Tạm thời dùng cái này vậy.\",\"rating\":9.0},\n  {\"id\":702765,\"suggestedTranslation\":\"Điểm kiểm soát kìa!\",\"rating\":9.0},\n  {\"id\":702766,\"suggestedTranslation\":\"Thêm một việc nữa cần gạch khỏi danh sách.\",\"rating\":9.0},\n  {\"id\":702767,\"suggestedTranslation\":\"Có ai đó đang bám theo tôi!\",\"rating\":9.0},\n  {\"id\":702768,\"suggestedTranslation\":\"Phao cứu sinh tuyệt vời!\",\"rating\":9.0},\n  {\"id\":702769,\"suggestedTranslation\":\"Phao cứu sinh tuyệt vời!\",\"rating\":9.0},\n  {\"id\":702770,\"suggestedTranslation\":\"Phao cứu sinh tuyệt vời!\",\"rating\":9.0},\n  {\"id\":702771,\"suggestedTranslation\":\"Phao cứu sinh tuyệt vời!\",\"rating\":9.0},\n  {\"id\":702772,\"suggestedTranslation\":\"Sự cổ vũ của nó đang làm tôi hừng hực khí thế!\",\"rating\":9.0},\n  {\"id\":702773,\"suggestedTranslation\":\"Phải bắt đầu từ đâu đó chứ.\",\"rating\":9.0},\n  {\"id\":702774,\"suggestedTranslation\":\"Bắt đầu từ đâu đây?\",\"rating\":9.0},\n  {\"id\":702775,\"suggestedTranslation\":\"\\\"Hàng hóa\\\" theo tiếng thủy thủ nghĩa là \\\"đồ đạc\\\".\",\"rating\":9.0},\n  {\"id\":702776,\"suggestedTranslation\":\"Chắc tôi phải làm theo cách truyền thống thôi.\",\"rating\":9.0},\n  {\"id\":702777,\"suggestedTranslation\":\"Đó là vinh quang đỉnh cao cho thuyền ván của tôi.\",\"rating\":9.0},\n  {\"id\":702778,\"suggestedTranslation\":\"Một món đồ chắn va đập thuyền ván tương lai.\",\"rating\":9.0},\n  {\"id\":702779,\"suggestedTranslation\":\"Nó không cứu thuyền ván khỏi mọi thứ được, nhưng đúng là rất hữu ích.\",\"rating\":9.0},\n  {\"id\":702780,\"suggestedTranslation\":\"Một món đồ chắn va đập thuyền ván tương lai.\",\"rating\":9.0},\n  {\"id\":702781,\"suggestedTranslation\":\"Nó giúp thuyền ván có thêm chút phòng thủ vỏ sò.\",\"rating\":9.0},\n  {\"id\":702782,\"suggestedTranslation\":\"Một món đồ chắn va đập thuyền ván tương lai.\",\"rating\":9.0},\n  {\"id\":702783,\"suggestedTranslation\":\"Khi bạn gây sự với thuyền rồng, bạn sẽ phải nhận sừng đấy!\",\"rating\":9.0},\n  {\"id\":702784,\"suggestedTranslation\":\"Một món đồ chắn va đập thuyền ván tương lai.\",\"rating\":9.0},\n  {\"id\":702785,\"s