            "text": "[\n  {\"id\":702065,\"suggestedTranslation\":\"Từ đây thì vị thẩm phán không thấy được con Bò Lai của tôi đâu.\",\"rating\":0.0},\n  {\"id\":702066,\"suggestedTranslation\":\"Dĩ nhiên là mọi chuyện không dễ dàng thế rồi.\",\"rating\":0.0},\n  {\"id\":702067,\"suggestedTranslation\":\"Đừng có mà hòng! Dậy đi, chúng ta còn phải đua thắng nữa đấy!\",\"rating\":0.0},\n  {\"id\":702068,\"suggestedTranslation\":\"Dậy đi! MA NHANH LÊN!\",\"rating\":0.0},\n  {\"id\":702069,\"suggestedTranslation\":\"Đừng đi bộ, CHẠY ĐI!\",\"rating\":0.0},\n  {\"id\":702070,\"suggestedTranslation\":\"Không, không! Ngươi đi ngược đường rồi kìa!\",\"rating\":0.0},\n  {\"id\":702071,\"suggestedTranslation\":\"Quay đầu lại đi mấy người ơi!\",\"rating\":0.0},\n  {\"id\":702072,\"suggestedTranslation\":\"Cuộc thí nghiệm— ơ nhầm, cuộc đua xin được phép bắt đầu!\",\"rating\":0.0},\n  {\"id\":702073,\"suggestedTranslation\":\"Trần nhà đang mất ổn định rồi!\",\"rating\":0.0},\n  {\"id\":702074,\"suggestedTranslation\":\"Mọi chuyện vẫn ổn thôi.\",\"rating\":0.0},\n  {\"id\":702075,\"suggestedTranslation\":\"only_used_by_wx78\",\"rating\":0.0},\n  {\"id\":702076,\"suggestedTranslation\":\"Sự hiện diện đó... quen thuộc quá! Ai đấy?\",\"rating\":0.0},\n  {\"id\":702077,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":0.0},\n  {\"id\":702078,\"suggestedTranslation\":\"Ái! Có cái gì vừa cắn tôi!\",\"rating\":0.0},\n  {\"id\":702079,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":0.0},\n  {\"id\":702080,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":0.0},\n  {\"id\":702081,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":0.0},\n  {\"id\":702082,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":0.0},\n  {\"id\":702083,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":0.0},\n  {\"id\":702084,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":0.0},\n  {\"id\":702085,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":0.0},\n  {\"id\":702086,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":0.0},\n  {\"id\":702087,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":0.0},\n  {\"id\":702088,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":0.0},\n  {\"id\":702089,\"suggestedTranslation\":\"Lạnh quá!\",\"rating\":0.0},\n  {\"id\":702090,\"suggestedTranslation\":\"Chiếc la bàn này không còn chỉ hướng nữa rồi.\",\"rating\":0.0},\n  {\"id\":702091,\"suggestedTranslation\":\"Tôi thấy sảng khoái quá!\",\"rating\":0.0},\n  {\"id\":702092,\"suggestedTranslation\":\"Tôi còn thiếu vài nguyên liệu chính.\",\"rating\":0.0},\n  {\"id\":702093,\"suggestedTranslation\":\"Ồ, H2O.\",\"rating\":0.0},\n  {\"id\":702094,\"suggestedTranslation\":\"Nghe tiếng có vẻ to đấy!\",\"rating\":0.0},\n  {\"id\":702095,\"suggestedTranslation\":\"Tôi thấy ánh sáng rồi!\",\"rating\":0.0},\n  {\"id\":702096,\"suggestedTranslation\":\"Có vẻ cơ bắp của tôi chẳng duy trì được bao lâu.\",\"rating\":0.0},\n  {\"id\":702097,\"suggestedTranslation\":\"Điện đã mất, nhưng tĩnh điện vẫn còn vương vấn.\",\"rating\":0.0},\n  {\"id\":702098,\"suggestedTranslation\":\"Có vẻ chuỗi ngày khô ráo của tôi đã kết thúc.\",\"rating\":0.0},\n  {\"id\":702099,\"suggestedTranslation\":\"Chà, cũng tuyệt phết lúc nó còn kéo dài.\",\"rating\":0.0},\n  {\"id\":702100,\"suggestedTranslation\":\"Tôi sẽ... (ngáp) không bao giờ... mệt...\",\"rating\":0.0},\n  {\"id\":702101,\"suggestedTranslation\":\"Cảm giác lười biếng... lại đang ùa về...\",\"rating\":0.0},\n  {\"id\":702102,\"suggestedTranslation\":\"Trông nó khá hơn hẳn rồi kìa.\",\"rating\":0.0},\n  {\"id\":702103,\"suggestedTranslation\":\"only_used_by_wx78\",\"rating\":0.0},\n  {\"id\":702104,\"suggestedTranslation\":\"Trời muộn rồi. Sẽ tối nhanh thôi.\",\"rating\":0.0},\n  {\"id\":702105,\"suggestedTranslation\":\"only_used_by_warly\",\"rating\":0.0},\n  {\"id\":702106,\"suggestedTranslation\":\"only_used_by_warly\",\"rating\":0.0},\n  {\"id\":702107,\"suggestedTranslation\":\"Ngon tuyệt!\",\"rating\":0.0},\n  {\"id\":702108,\"suggestedTranslation\":\"Tôi không ăn cái đó được!\",\"rating\":0.0},\n  {\"id\":702109,\"suggestedTranslation\":\"Tôi thấy không được khỏe lắm.\",\"rating\":0.0},\n  {\"id\":702110,\"suggestedTranslation\":\"only_used_by_warly\",\"rating\":0.0},\n  {\"id\":702111,\"suggestedTranslation\":\"only_used_by_warly\",\"rating\":0.0},\n  {\"id\":702112,\"suggestedTranslation\":\"only_used_by_warly\",\"rating\":0.0},\n  {\"id\":702113,\"suggestedTranslation\":\"only_used_by_warly\",\"rating\":0.0},\n  {\"id\":702114,\"suggestedTranslation\":\"only_used_by_warly\",\"rating\":0.0},\n  {\"id\":702115,\"suggestedTranslation\":\"only_used_by_warly\",\"rating\":0.0},\n  {\"id\":702116,\"suggestedTranslation\":\"only_used_by_warly\",\"rating\":0.0},\n  {\"id\":702117,\"suggestedTranslation\":\"Eo ôi! Dở tệ!\",\"rating\":0.0},\n  {\"id\":702118,\"suggestedTranslation\":\"Tôi nghĩ món đó bắt đầu thiu rồi.\",\"rating\":0.0},\n  {\"id\":702119,\"suggestedTranslation\":\"only_used_by_warly\",\"rating\":0.0},\n  {\"id\":702120,\"suggestedTranslation\":\"Cho cái đó vào miệng đúng là kinh tởm!\",\"rating\":0.0},\n  {\"id\":702121,\"suggestedTranslation\":\"Lẽ ra tôi nên chia sẻ món này với những người khác mới phải.\",\"rating\":0.0},\n  {\"id\":702122,\"suggestedTranslation\":\"Cảm giác như một mũi tiêm TĂNG-cường ấy.\",\"rating\":0.0},\n  {\"id\":702123,\"suggestedTranslation\":\"Tôi thấy đầu óc cứ hốt hoảng sao ấy.\",\"rating\":0.0},\n  {\"id\":702124,\"suggestedTranslation\":\"Tôi nghĩ mình có thể nhấc nổi cả một con ngựa.\",\"rating\":0.0},\n  {\"id\":702125,\"suggestedTranslation\":\"Cái này có vẻ hơi quá đô một chút.\",\"rating\":0.0},\n  {\"id\":702126,\"suggestedTranslation\":\"Hộc... Thở dốc...\",\"rating\":0.0},\n  {\"id\":702127,\"suggestedTranslation\":\"Lẽ ra tôi nên chế tạo... một cỗ máy nâng vật nặng...\",\"rating\":0.0},\n  {\"id\":702128,\"suggestedTranslation\":\"Nâng lên... bằng lưng của bạn...\",\"rating\":0.0},\n  {\"id\":702129,\"suggestedTranslation\":\"Đây không phải là... việc dành cho quý ông...\",\"rating\":0.0},\n  {\"id\":702130,\"suggestedTranslation\":\"Vì... khoa học... hự!\",\"rating\":0.0},\n  {\"id\":702131,\"suggestedTranslation\":\"Việc này có làm rối tóc tôi không ta?\",\"rating\":0.0},\n  {\"id\":702132,\"suggestedTranslation\":\"Hừm...!\",\"rating\":0.0},\n  {\"id\":702133,\"suggestedTranslation\":\"Thở dốc... Thở dốc...\",\"rating\":0.0},\n  {\"id\":702134,\"suggestedTranslation\":\"Đây là thí nghiệm tồi tệ nhất...\",\"rating\":0.0},\n  {\"id\":702135,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":0.0},\n  {\"id\":702136,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":0.0},\n  {\"id\":702137,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":0.0},\n  {\"id\":702138,\"suggestedTranslation\":\"Tối quá!\",\"rating\":0.0},\n  {\"id\":702139,\"suggestedTranslation\":\"Tôi nhìn thấy lại được rồi!\",\"rating\":0.0},\n  {\"id\":702140,\"suggestedTranslation\":\"only_used_by_waxwell\",\"rating\":0.0},\n  {\"id\":702141,\"suggestedTranslation\":\"only_used_by_waxwell\",\"rating\":0.0},\n  {\"id\":702142,\"suggestedTranslation\":\"only_used_by_waxwell\",\"rating\":0.0},\n  {\"id\":702143,\"suggestedTranslation\":\"only_used_by_waxwell\",\"rating\":0.0},\n  {\"id\":702144,\"suggestedTranslation\":\"only_used_by_wolfang\",\"rating\":0.0},\n  {\"id\":702145,\"suggestedTranslation\":\"only_used_by_wolfang\",\"rating\":0.0},\n  {\"id\":702146,\"suggestedTranslation\":\"only_used_by_wolfang\",\"rating\":0.0},\n  {\"id\":702147,\"suggestedTranslation\":\"Tôi suýt thì chết đuối trong cái... thứ đó rồi!\",\"rating\":0.0},\n  {\"id\":702148,\"suggestedTranslation\":\"Cái gì thế kia - một con mắt khổng lồ đang bay á?!\",\"rating\":0.0},\n  {\"id\":702149,\"suggestedTranslation\":\"Quay lại đây mau, tôi chưa xử xong ngươi đâu!\",\"rating\":0.0},\n  {\"id\":702150,\"suggestedTranslation\":\"Cuối cùng cũng tới!\",\"rating\":0.0},\n  {\"id\":702151,\"suggestedTranslation\":\"Cái quạt của tôi đã bay theo chiều gió rồi.\",\"rating\":0.0},\n  {\"id\":702152,\"suggestedTranslation\":\"Tôi chưa từng nghĩ có ngày mình lại áp dụng bộ óc khoa học vào... việc này.\",\"rating\":0.0},\n  {\"id\":702153,\"suggestedTranslation\":\"Bên trong tôi đang bốc cháy!\",\"rating\":0.0},\n  {\"id\":702154,\"suggestedTranslation\":\"Ái, nóng quá!\",\"rating\":0.0},\n  {\"id\":702155,\"suggestedTranslation\":\"Ghi nhớ: không thử nghiệm với độc tố Tầm Ma Lửa nữa.\",\"rating\":0.0},\n  {\"id\":702156,\"suggestedTranslation\":\"Không biết ai đã bắn pháo sáng thế nhỉ?\",\"rating\":0.0},\n  {\"id\":702157,\"suggestedTranslation\":\"Tôi suýt chết đuối nhưng có cái gì đó nổi lên... chính là tôi!\",\"rating\":0.0},\n  {\"id\":702158,\"suggestedTranslation\":\"Tôi ghét bị để cho hồi hộp...\",\"rating\":0.0},\n  {\"id\":702159,\"suggestedTranslation\":\"Tôi mệt lắm rồi.\",\"rating\":0.0},\n  {\"id\":702160,\"suggestedTranslation\":\"only_used_by_warly\",\"rating\":0.0},\n  {\"id\":702161,\"suggestedTranslation\":\"Tôi được tự do rồi! Cuối cùng cũng được tự do!\",\"rating\":0.0},\n  {\"id\":702162,\"suggestedTranslation\":\"Chắc lại là chuyện của Người Cá thôi.\",\"rating\":0.0},\n  {\"id\":702163,\"suggestedTranslation\":\"Phần con người trong tôi sắp sửa tan biến rồi...\",\"rating\":0.0},\n  {\"id\":702164,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":0.0},\n  {\"id\":702165,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":0.0},\n  {\"id\":702166,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":0.0},\n  {\"id\":702167,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":0.0},\n  {\"id\":702168,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":0.0},\n  {\"id\":702169,\"suggestedTranslation\":\"Hạ! Ngươi bắn trượt rồi!\",\"rating\":0.0},\n  {\"id\":702170,\"suggestedTranslation\":\"only_used_by_wormwood\",\"rating\":0.0},\n  {\"id\":702171,\"suggestedTranslation\":\"Đến lúc bôi thêm Thuốc Kháng Axit rồi.\",\"rating\":0.0},\n  {\"id\":702172,\"suggestedTranslation\":\"Có lẽ đến lúc bôi thêm chút Cao nhiệt rồi.\",\"rating\":0.0},\n  {\"id\":702173,\"suggestedTranslation\":\"Tôi thấy say sóng quá!\",\"rating\":0.0},\n  {\"id\":702174,\"suggestedTranslation\":\"Sao tôi vẫn còn ở đây nhỉ?\",\"rating\":0.0},\n  {\"id\":702175,\"suggestedTranslation\":\"Giờ tôi thấy mình thông minh quá cơ!\",\"rating\":0.0},\n  {\"id\":702176,\"suggestedTranslation\":\"Cần... đá... hoặc... bóng râm!\",\"rating\":0.0},\n  {\"id\":702177,\"suggestedTranslation\":\"Cậu có nghe thấy gì không?\",\"rating\":0.0},\n  {\"id\":702178,\"suggestedTranslation\":\"Tôi đói quá!\",\"rating\":0.0},\n  {\"id\":702179,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":0.0},\n  {\"id\":702180,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":0.0},\n  {\"id\":702181,\"suggestedTranslation\":\"Lối này trông an toàn hơn.\",\"rating\":0.0},\n  {\"id\":702182,\"suggestedTranslation\":\"Dấu vết này còn mới. Con quái vật chắc ở quanh đây thôi.\",\"rating\":0.0},\n  {\"id\":702183,\"suggestedTranslation\":\"Dấu vết của con quái vật kết thúc ở đây.\",\"rating\":0.0},\n  {\"id\":702184,\"suggestedTranslation\":\"Đất ẩm thế này không giữ được dấu chân đâu.\",\"rating\":0.0},\n  {\"id\":702185,\"suggestedTranslation\":\"Lối này trông nguy hiểm đấy.\",\"rating\":0.0},\n  {\"id\":702186,\"suggestedTranslation\":\"Không con quái vật nào địch lại sự thông minh của tôi được đâu!\",\"rating\":0.0},\n  {\"id\":702187,\"suggestedTranslation\":\"Tôi có cảm giác như có ai đó đang theo dõi mình.\",\"rating\":0.0},\n  {\"id\":702188,\"suggestedTranslation\":\"Cây ơi, mày vẫn đói à?\",\"rating\":0.0},\n  {\"id\":702189,\"suggestedTranslation\":\"Tôi không thể mang thêm món đồ nào nữa rồi!\",\"rating\":0.0},\n  {\"id\":702190,\"suggestedTranslation\":\"Chúc mừng Đại Tiệc Mùa Đông!\",\"rating\":0.0},\n  {\"id\":702191,\"suggestedTranslation\":\"only_used_by_wormwood\"