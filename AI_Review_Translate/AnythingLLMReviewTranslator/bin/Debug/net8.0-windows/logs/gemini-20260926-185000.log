            "text": "[\n  {\"id\":704413,\"suggestedTranslation\":\"Chắc chắn cái két sắt này sẽ có ích đấy.\",\"rating\":9.0},\n  {\"id\":704414,\"suggestedTranslation\":\"Tôi sẽ đút nó vào túi cho đến khi ra tới công viên.\",\"rating\":9.0},\n  {\"id\":704415,\"suggestedTranslation\":\"Hừm. Gợi nhớ đến nhà ghê.\",\"rating\":9.0},\n  {\"id\":704416,\"suggestedTranslation\":\"Thật là khai sáng.\",\"rating\":9.0},\n  {\"id\":704417,\"suggestedTranslation\":\"Công việc bù đầu hàng ngày.\",\"rating\":9.0},\n  {\"id\":704418,\"suggestedTranslation\":\"Cái nhà nhỏ xấu xí gì thế này.\",\"rating\":9.0},\n  {\"id\":704419,\"suggestedTranslation\":\"Có khoa học nào trong đó không nhỉ?\",\"rating\":9.0},\n  {\"id\":704420,\"suggestedTranslation\":\"Tôi có thể cần vài thứ đồ đạc.\",\"rating\":9.0},\n  {\"id\":704421,\"suggestedTranslation\":\"Đây là những cây nấm ăn được.\",\"rating\":9.0},\n  {\"id\":704422,\"suggestedTranslation\":\"Đấy là nấm á? Tôi chịu chết rồi đấy.\",\"rating\":9.0},\n  {\"id\":704423,\"suggestedTranslation\":\"Tôi không nghĩ nó sẽ mọc lại đâu.\",\"rating\":9.0},\n  {\"id\":704424,\"suggestedTranslation\":\"Trông giòn ghê.\",\"rating\":9.0},\n  {\"id\":704425,\"suggestedTranslation\":\"Một phản ứng hóa học thành công.\",\"rating\":9.0},\n  {\"id\":704426,\"suggestedTranslation\":\"Một nắm hạt kỳ lạ.\",\"rating\":9.0},\n  {\"id\":704427,\"suggestedTranslation\":\"Nó cần các nguyên liệu để tiến hành thí nghiệm.\",\"rating\":9.0},\n  {\"id\":704428,\"suggestedTranslation\":\"Dùng để đốt đồ vật một cách khoa học.\",\"rating\":9.0},\n  {\"id\":704429,\"suggestedTranslation\":\"Thuật ngữ khoa học là: \\\"Thứ nhọn hoắt\\\".\",\"rating\":9.0},\n  {\"id\":704430,\"suggestedTranslation\":\"Nhận lấy đây, sinh vật kia!\",\"rating\":9.0},\n  {\"id\":704431,\"suggestedTranslation\":\"Nhìn như thật ấy.\",\"rating\":9.0},\n  {\"id\":704432,\"suggestedTranslation\":\"Lâu lắm rồi nơi này mới được nối với nguồn nước.\",\"rating\":9.0},\n  {\"id\":704433,\"suggestedTranslation\":\"Hóa ra chìa khóa chính là mấu chốt để vào trong.\",\"rating\":9.0},\n  {\"id\":704434,\"suggestedTranslation\":\"Khóa kín mít.\",\"rating\":9.0},\n  {\"id\":704435,\"suggestedTranslation\":\"Một tượng đài mang tính tượng đài.\",\"rating\":9.0},\n  {\"id\":704436,\"suggestedTranslation\":\"Tro hoàn tro.\",\"rating\":9.0},\n  {\"id\":704437,\"suggestedTranslation\":\"Cục đá tảng đó đang sống kìa!\",\"rating\":9.0},\n  {\"id\":704438,\"suggestedTranslation\":\"Chúng chết rồi.\",\"rating\":9.0},\n  {\"id\":704439,\"suggestedTranslation\":\"Nó đang ứng biến đấy thôi.\",\"rating\":9.0},\n  {\"id\":704440,\"suggestedTranslation\":\"Nó đang ngủ, tạm thời là vậy.\",\"rating\":9.0},\n  {\"id\":704441,\"suggestedTranslation\":\"Một chiếc đĩa mạ bạc.\",\"rating\":9.0},\n  {\"id\":704442,\"suggestedTranslation\":\"Một mạch nước mặn nhỏ.\",\"rating\":9.0},\n  {\"id\":704443,\"suggestedTranslation\":\"Lại một ngõ cụt nữa.\",\"rating\":9.0},\n  {\"id\":704444,\"suggestedTranslation\":\"Cái này trông mang tính khoa học phết.\",\"rating\":9.0},\n  {\"id\":704445,\"suggestedTranslation\":\"Chiếc nồi này chứa được nhiều nguyên liệu hơn.\",\"rating\":9.0},\n  {\"id\":704446,\"suggestedTranslation\":\"Những quả táo của mặt đất.\",\"rating\":9.0},\n  {\"id\":704447,\"suggestedTranslation\":\"Một thí nghiệm nhiệt độ thành công.\",\"rating\":9.0},\n  {\"id\":704448,\"suggestedTranslation\":\"Một nắm hạt kỳ lạ.\",\"rating\":9.0},\n  {\"id\":704449,\"suggestedTranslation\":\"Nó có nhiều điều vướng bận.\",\"rating\":9.0},\n  {\"id\":704450,\"suggestedTranslation\":\"Dành cho việc nấu nướng dựa trên hệ thống treo.\",\"rating\":9.0},\n  {\"id\":704451,\"suggestedTranslation\":\"Bắt tay vào nấu nướng thôi!\",\"rating\":9.0},\n  {\"id\":704452,\"suggestedTranslation\":\"Tôi cần làm ngọt cái nồi này.\",\"rating\":9.0},\n  {\"id\":704453,\"suggestedTranslation\":\"Tôi không nghĩ cái bệ thờ sẽ muốn thứ đó đâu.\",\"rating\":9.0},\n  {\"id\":704454,\"suggestedTranslation\":\"Chắc là tôi nói nhịu rồi.\",\"rating\":9.0},\n  {\"id\":704455,\"suggestedTranslation\":\"Trên con đường đi đến hư vô.\",\"rating\":9.0},\n  {\"id\":704456,\"suggestedTranslation\":\"Trở thành con mồi.\",\"rating\":9.0},\n  {\"id\":704457,\"suggestedTranslation\":\"Có cái gì đó làmụt tắt cái ống khói đó rồi.\",\"rating\":9.0},\n  {\"id\":704458,\"suggestedTranslation\":\"Có cái gì đó làmụt tắt cái ống khói đó rồi.\",\"rating\":9.0},\n  {\"id\":704459,\"suggestedTranslation\":\"Ai đó đã đánh bại thời gian. Theo đúng nghĩa đen.\",\"rating\":9.0},\n  {\"id\":704460,\"suggestedTranslation\":\"Cái đồng hồ đó vừa bị đấm tơi bời.\",\"rating\":9.0},\n  {\"id\":704461,\"suggestedTranslation\":\"Không có ai ở đây cả.\",\"rating\":9.0},\n  {\"id\":704462,\"suggestedTranslation\":\"Thứ gì đó đã phá hủy thị trấn này.\",\"rating\":9.0},\n  {\"id\":704463,\"suggestedTranslation\":\"Tự hỏi bọn chúng đã chọc giận ai nhỉ.\",\"rating\":9.0},\n  {\"id\":704464,\"suggestedTranslation\":\"Không còn đáng yêu... ý nhầm, đáng mở nữa rồi.\",\"rating\":9.0},\n  {\"id\":704465,\"suggestedTranslation\":\"Ai đó đã đập phá mái nhà.\",\"rating\":9.0},\n  {\"id\":704466,\"suggestedTranslation\":\"Đó là một cái két sắt. Dùng để cất giữ đồ đạc an toàn.\",\"rating\":9.0},\n  {\"id\":704467,\"suggestedTranslation\":\"Nó sẽ không mở được nếu không có chìa khóa.\",\"rating\":9.0},\n  {\"id\":704468,\"suggestedTranslation\":\"Ừm, câu cá tươi ngon.\",\"rating\":9.0},\n  {\"id\":704469,\"suggestedTranslation\":\"Sẵn sàng lên bàn ăn rồi đây.\",\"rating\":9.0},\n  {\"id\":704470,\"suggestedTranslation\":\"Nó đầy muối.\",\"rating\":9.0},\n  {\"id\":704471,\"suggestedTranslation\":\"Muối. Khoáng chất ngon nhất.\",\"rating\":9.0},\n  {\"id\":704472,\"suggestedTranslation\":\"Khoa học cần có thời gian.\",\"rating\":9.0},\n  {\"id\":704473,\"suggestedTranslation\":\"Muối đã đọng lại trên dây thừng.\",\"rating\":9.0},\n  {\"id\":704474,\"suggestedTranslation\":\"Dùng để thu hoạch muối từ cái ao.\",\"rating\":9.0},\n  {\"id\":704475,\"suggestedTranslation\":\"Nó có vị ngọt.\",\"rating\":9.0},\n  {\"id\":704476,\"suggestedTranslation\":\"Chúng ta có thể dùng nó để lấy nhựa cây từ các thân cây.\",\"rating\":9.0},\n  {\"id\":704477,\"suggestedTranslation\":\"Tôi không thể lấy thêm gì từ thứ đó nữa rồi.\",\"rating\":9.0},\n  {\"id\":704478,\"suggestedTranslation\":\"Cứ ném nó vào lửa quách cho rồi.\",\"rating\":9.0},\n  {\"id\":704479,\"suggestedTranslation\":\"Gieo gì gặt nấy nhỉ?\",\"rating\":9.0},\n  {\"id\":704480,\"suggestedTranslation\":\"Dụng cụ phòng thí nghiệm dùng để mổ xẻ phẫu thuật.\",\"rating\":9.0},\n  {\"id\":704481,\"suggestedTranslation\":\"Đậm đà hương vị.\",\"rating\":9.0},\n  {\"id\":704482,\"suggestedTranslation\":\"Nó làm tôi nhớ đến những con quái vật xúc tu đó.\",\"rating\":9.0},\n  {\"id\":704483,\"suggestedTranslation\":\"Tôi không thể lấy thêm gì từ bụi cây đó nữa rồi.\",\"rating\":9.0},\n  {\"id\":704484,\"suggestedTranslation\":\"Tôi có thể nghiền nát nó để làm gia vị.\",\"rating\":9.0},\n  {\"id\":704485,\"suggestedTranslation\":\"Nó chứa đầy nhựa cây ngon tuyệt.\",\"rating\":9.0},\n  {\"id\":704486,\"suggestedTranslation\":\"Cái cây đâu mất tiêu rồi? Tôi bí tịt rồi đây.\",\"rating\":9.0},\n  {\"id\":704487,\"suggestedTranslation\":\"Đó là cách để thu hút lũ kiến đấy.\",\"rating\":9.0},\n  {\"id\":704488,\"suggestedTranslation\":\"Nhựa cây ơi, mau chảy ra nào.\",\"rating\":9.0},\n  {\"id\":704489,\"suggestedTranslation\":\"Nhựa cây vàng óng ngọt ngào.\",\"rating\":9.0},\n  {\"id\":704490,\"suggestedTranslation\":\"Trông nó có vẻ ốm yếu.\",\"rating\":9.0},\n  {\"id\":704491,\"suggestedTranslation\":\"Đó là một con lợn siêu nhiều lông.\",\"rating\":9.0},\n  {\"id\":704492,\"suggestedTranslation\":\"Chắc cậu là người quản ở đây hả?\",\"rating\":9.0},\n  {\"id\":704493,\"suggestedTranslation\":\"Nó đang ngủ, tạm thời là vậy.\",\"rating\":9.0},\n  {\"id\":704494,\"suggestedTranslation\":\"Nó đã qua thời huy hoàng rồi.\",\"rating\":9.0},\n  {\"id\":704495,\"suggestedTranslati