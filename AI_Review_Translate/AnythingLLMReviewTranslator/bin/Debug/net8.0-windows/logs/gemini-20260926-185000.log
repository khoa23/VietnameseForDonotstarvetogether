ggestedTranslation\":\"Chắc nó sắp nở đến nơi rồi.\",\"rating\":9.0},\n  {\"id\":704913,\"suggestedTranslation\":\"Đó là một quả trứng khá to!\",\"rating\":9.0},\n  {\"id\":704914,\"suggestedTranslation\":\"Cái tổ trống không.\",\"rating\":9.0},\n  {\"id\":704915,\"suggestedTranslation\":\"Một bước đột phá trong công nghệ ăn sáng!\",\"rating\":9.0},\n  {\"id\":704916,\"suggestedTranslation\":\"Nếu tôi ăn thêm chút nữa chắc tôi sẽ mập lên mất.\",\"rating\":9.0},\n  {\"id\":704917,\"suggestedTranslation\":\"Con chim này không cao cho lắm.\",\"rating\":9.0},\n  {\"id\":704918,\"suggestedTranslation\":\"Mày cần chút thức ăn và nhanh lên phải không?\",\"rating\":9.0},\n  {\"id\":704919,\"suggestedTranslation\":\"Nó đang tranh thủ chợp mắt kìa.\",\"rating\":9.0},\n  {\"id\":704920,\"suggestedTranslation\":\"Ánh mắt của nó trông có vẻ nguy hiểm đấy.\",\"rating\":9.0},\n  {\"id\":704921,\"suggestedTranslation\":\"Nó cần thêm ngọc tím.\",\"rating\":9.0},\n  {\"id\":704922,\"suggestedTranslation\":\"Nó đã sẵn sàng hoạt động.\",\"rating\":9.0},\n  {\"id\":704923,\"suggestedTranslation\":\"Với thứ này tôi chắc chắn có thể xuyên không gian và thời gian!\",\"rating\":9.0},\n  {\"id\":704924,\"suggestedTranslation\":\"Đây có vẻ là một cổng kết nối đến thế giới khác!\",\"rating\":9.0},\n  {\"id\":704925,\"suggestedTranslation\":\"Vẫn còn thiếu thứ gì đó.\",\"rating\":9.0},\n  {\"id\":704926,\"suggestedTranslation\":\"Chẳng mấy chốc nữa, phát minh này sẽ hoàn thành!\",\"rating\":9.0},\n  {\"id\":704927,\"suggestedTranslation\":\"Thứ này có thể điều khiển cực tính của cả vũ trụ.\",\"rating\":9.0},\n  {\"id\":704928,\"suggestedTranslation\":\"Đủ cứng cáp để xử lý những thí nghiệm khắc nghiệt nhất.\",\"rating\":9.0},\n  {\"id\":704929,\"suggestedTranslation\":\"Củ khoai tây bằng kim loại này chứa đựng sức mạnh vĩ đại và đáng sợ...\",\"rating\":9.0},\n  {\"id\":704930,\"suggestedTranslation\":\"Một chiếc nhẫn có khả năng tập trung năng lượng chiều không gian.\",\"rating\":9.0},\n  {\"id\":704931,\"suggestedTranslation\":\"Thứ đó có thể hé lộ thế giới này.\",\"rating\":9.0},\n  {\"id\":704932,\"suggestedTranslation\":\"Chẳng còn chỗ nào để chui vào ngủ nữa rồi.\",\"rating\":9.0},\n  {\"id\":704933,\"suggestedTranslation\":\"Tôi sẽ hóa điên mất nếu không được ngủ.\",\"rating\":9.0},\n  {\"id\":704934,\"suggestedTranslation\":\"Trông nguy hiểm phết.\",\"rating\":9.0},\n  {\"id\":704935,\"suggestedTranslation\":\"Nó nhọn và nhớt nhát.\",\"rating\":9.0},\n  {\"id\":704936,\"suggestedTranslation\":\"Tôi nghĩ đây từng là bộ phận sinh dục của nó.\",\"rating\":9.0},\n  {\"id\":704937,\"suggestedTranslation\":\"Lại một cái cột nhầy nhụa khác.\",\"rating\":9.0},\n  {\"id\":704938,\"suggestedTranslation\":\"Một cái cột nhầy nhụa.\",\"rating\":9.0},\n  {\"id\":704939,\"suggestedTranslation\":\"Những chiếc xúc tu nhỏ trơn trượt.\",\"rating\":9.0},\n  {\"id\":704940,\"suggestedTranslation\":\"Nghe có vẻ bốc mùi, nhưng rất đáng để khám phá.\",\"rating\":9.0},\n  {\"id\":704941,\"suggestedTranslation\":\"Nó cần phải hạ nhiệt sau vụ đó cái đã.\",\"rating\":9.0},\n  {\"id\":704942,\"suggestedTranslation\":\"Tôi có một linh cảm chẳng lành về chuyện này...\",\"rating\":9.0},\n  {\"id\":704943,\"suggestedTranslation\":\"Mình đang ở bên kia cầu vồng à?!\",\"rating\":9.0},\n  {\"id\":704944,\"suggestedTranslation\":\"Nhìn vào nó làm đầu óc tôi cứ mụ mẫm... hay là... vuông vắn nhỉ?\",\"rating\":9.0},\n  {\"id\":704945,\"suggestedTranslation\":\"Giờ thì tôi không bị mấy con mắt tò mò nào làm phiền nữa rồi.\",\"rating\":9.0},\n  {\"id\":704946,\"suggestedTranslation\":\"Nó có thể là gì nhỉ? Thôi đi ngủ một giấc rồi tính tiếp.\",\"rating\":9.0},\n  {\"id\":704947,\"suggestedTranslation\":\"Nó sẽ chẳng làm phiền ai được nữa đâu.\",\"rating\":9.0},\n  {\"id\":704948,\"suggestedTranslation\":\"Có bao giờ tò mò nhìn vào trong hộp mà gặp rắc rối đâu cơ chứ?\",\"rating\":9.0},\n  {\"id\":704949,\"suggestedTranslation\":\"Trông có vẻ hơi lạc quẻ một chút...\",\"rating\":9.0},\n  {\"id\":704950,\"suggestedTranslation\":\"Tự hỏi thứ này xuất xứ từ đâu nhỉ?\",\"rating\":9.0},\n  {\"id\":704951,\"suggestedTranslation\":\"Có ai nắm bắt được tin tức gì mới chưa?\",\"rating\":9.0},\n  {\"id\":704952,\"suggestedTranslation\":\"Đó chỉ là mấy mẩu Thulecite nhỏ hơn thôi.\",\"rating\":9.0},\n  {\"id\":704953,\"suggestedTranslation\":\"Nó có mùi giống hóa chất.\",\"rating\":9.0},\n  {\"id\":704954,\"suggestedTranslation\":\"Tôi chắc là mình có thể tự tìm thấy chúng.\",\"rating\":9.0},\n  {\"id\":704955,\"suggestedTranslation\":\"Trông chú ta có vẻ biết mình đang làm gì đấy!\",\"rating\":9.0},\n  {\"id\":704956,\"suggestedTranslation\":\"Có ai đó đã tìm thấy chúng trước rồi.\",\"rating\":9.0},\n  {\"id\":704957,\"suggestedTranslation\":\"Trông có vẻ như có thứ gì đó ở quanh đây.\",\"rating\":9.0},\n  {\"id\":704958,\"suggestedTranslation\":\"Có vẻ như chẳng còn gì để tìm kiếm nữa rồi.\",\"rating\":9.0},\n  {\"id\":704959,\"suggestedTranslation\":\"Này, chú ta tìm thấy một cái rồi kìa!\",\"rating\":9.0},\n  {\"id\":704960,\"suggestedTranslation\":\"Chúng có thể ở quá xa để chú ta có thể đánh hơi thấy.\",\"rating\":9.0},\n  {\"id\":704961,\"suggestedTranslation\":\"Tôi nên đi theo sự dẫn dắt của chú ta thôi.\",\"rating\":9.0},\n  {\"id\":704962,\"suggestedTranslation\":\"Chú ta đang dẫn đường cho người khác mất rồi.\",\"rating\":9.0},\n  {\"id\":704963,\"suggestedTranslation\":\"Cút khỏi khu vườn của tôi ngay, đồ kia!\",\"rating\":9.0},\n  {\"id\":704964,\"suggestedTranslation\":\"Liều thuốc cứu rỗi của tôi đây rồi.\",\"rating\":9.0},\n  {\"id\":704965,\"suggestedTranslation\":\"Khô ráo thật đấy.\",\"rating\":9.0},\n  {\"id\":704966,\"suggestedTranslation\":\"Hây dà! Tôi không thèm hôn cái đó đâu!\",\"rating\":9.0},\n  {\"id\":704967,\"suggestedTranslation\":\"Giờ thì nó tức lộn ruột rồi đấy!\",\"rating\":9.0},\n  {\"id\":704968,\"suggestedTranslation\":\"Chỉ là một cái hố trên mặt đất thôi.\",\"rating\":9.0},\n  {\"id\":704969,\"suggestedTranslation\":\"Cây cóc nấm đó cứ như đang cầu xin bị đốn hạ vậy.\",\"rating\":9.0},\n  {\"id\":704970,\"suggestedTranslation\":\"Có cái gì đó đang nhô lên kìa.\",\"rating\":9.0},\n  {\"id\":704971,\"suggestedTranslation\":\"Nó màu đỏ vì chứa đầy khoa học đấy.\",\"rating\":9.0},\n  {\"id\":704972,\"suggestedTranslation\":\"Nấu ăn rất dễ nếu bạn hiểu về hóa học.\",\"rating\":9.0},\n  {\"id\":704973,\"suggestedTranslation\":\"Một quả cà chua có kích thước khó tin.\",\"rating\":9.0},\n  {\"id\":704974,\"suggestedTranslation\":\"Một nắm hạt kỳ lạ.\",\"rating\":9.0},\n  {\"id\":704975,\"suggestedTranslation\":\"Đúng là một chiếc mũ đẹp.\",\"rating\":9.0},\n  {\"id\":704976,\"suggestedTranslation\":\"Chiếc mũ đó toát lên vẻ phong cách ngời ngời.\",\"rating\":9.0},\n  {\"id\":704977,\"suggestedTranslation\":\"Thứ gì đó để đẩy lùi màn đêm.\",\"rating\":9.0},\n  {\"id\":704978,\"suggestedTranslation\":\"Rất hân hạnh được ăn thịt bạn.\",\"rating\":9.0},\n  {\"id\":704979,\"suggestedTranslation\":\"Đã sẵn sàng để phân rã nguyên tử.\",\"rating\":9.0},\n  {\"id\":704980,\"suggestedTranslation\":\"Kim tự tháp này điều khiển những cồn cát.\",\"rating\":9.0},\n  {\"id\":704981,\"suggestedTranslation\":\"Một người tỉnh táo hơn sẽ chọn cách đi bộ.\",\"rating\":9.0},\n  {\"id\":704982,\"suggestedTranslation\":\"Một máy phân rã mini.\",\"rating\":9.0},\n  {\"id\":704983,\"suggestedTranslation\":\"Một món ăn nhẹ lành mạnh và tự nhiên.\",\"rating\":9.0},\n  {\"id\":704984,\"suggestedTranslation\":\"Cánh tay chú ta khỏe phết đấy.\",\"rating\":9.0},\n  {\"id\":704985,\"suggestedTranslation\":\"Nó đang kêu vo ve vì dòng điện kìa.\",\"rating\":9.0},\n  {\"id\":704986,\"suggestedTranslation\":\"Tôi đã đan nó cực kỳ chắc chắn đấy.\",\"rating\":9.0},\n  {\"id\":704987,\"suggestedTranslation\":\"Chắc chắn nó sẽ đâm thủng bất cứ ai dẫm phải.\",\"rating\":9.0},\n  {\"id\":704988,\"suggestedTranslation\":\"Chúng chẳng có mấy tác dụng khi bị lạnh đâu.\",\"rating\":9.0},\n  {\"id\":704989,\"suggestedTranslation\":\"Chúng đang làm thủng một hố trong túi tôi kìa!\",\"rating\":9.0},\n  {\"id\":704990,\"suggestedTranslation\":\"Tôi sẽ không muốn chạy nhanh qua cái đó đâu.\",\"rating\":9.0},\n  {\"id\":704991,\"suggestedTranslation\":\"Nó đã nguội đi rồi, nhưng vẫn có thể gây ra chút sát thương đấy.\",\"rating\":9.0},\n  {\"id\":704992,\"suggestedTranslation\":\"Nó cố ngoạm tôi kìa!\",\"rating\":9.0},\n  {\"id\":704993,\"suggestedTranslation\":\"Ôi, chú sao biển nhỏ mới đáng yêu làm sao!\",\"rating\":9.0},\n  {\"id\":704994,\"suggestedTranslation\":\"Đây quả là một bất ngờ khó chịu.\",\"rating\":9.0},\n  {\"id\":704995,\"suggestedTranslation\":\"Mình tốt nhất nên tránh dẫm vào cái đó!\",\"rating\":9.0},\n  {\"id\":704996,\"suggestedTranslation\":\"Cái rương đó đã bị cụt đầu rồi.\",\"rating\":9.0},\n  {\"id\":704997,\"suggestedTranslation\":\"Đó là một chiếc rương ma thuật!\",\"rating\":9.0},\n  {\"id\":704998,\"suggestedTranslation\":\"Nó đã được cải tiến đáng kể về sức chứa.\",\"rating\":9.0},\n  {\"id\":704999,\"suggestedTranslation\":\"Tiện lợi thật đấy!\",\"rating\":9.0},\n  {\"id\":705000,\"suggestedTranslation\":\"Cứ như thể có ai đó đang cố ngăn tôi đi đến chỗ nào đó vậy.\",\"rating\":9.0},\n  {\"id\":705001,\"suggestedTranslation\":\"Măm măm, thức ăn cho cây đây!\",\"rating\":9.0},\n  {\"id\":705002,\"suggestedTranslation\":\"Trông có vẻ hơi nóng ở cổ rồi đấy.\",\"rating\":9.0},\n  {\"id\":705003,\"suggestedTranslation\":\"Nó thiếu sự nâng đỡ rồi.\",\"rating\":9.0},\n  {\"id\":705004,\"suggestedTranslation\":\"Trông hợp lý với tôi đấy.\",\"rating\":9.0},\n  {\"id\":705005,\"suggestedTranslation\":\"Nó đã có một khởi đầu gian nan.\",\"rating\":9.0},\n  {\"id\":705006,\"suggestedTranslation\":\"Đó là một cái hạt.\",\"rating\":9.0},\n  {\"id\":705007,\"suggestedTranslation\":\"Cái này sắp bùng nổ to đây!\",\"rating\":9.0},\n  {\"id\":705008,\"suggestedTranslation\":\"Đã tan chảy. Chắc là Willow đã nghịch dại với chúng à?\",\"rating\":9.0},\n  {\"id\":705009,\"suggestedTranslation\":\"Chúng nhanh chóng trở thành đạo cụ yêu thích của Wes.\",\"rating\":9.0},\n  {\"id\":705010,\"suggestedTranslation\":\"Hal thì thầm những lời nói dối ngọt ngào với tôi.\",\"rating\":9.0},\n  {\"id\":705011,\"suggestedTranslation\":\"Thứ này đúng là đang tự nguyện mang ra để thí nghiệm mà.\",\"rating\":9.0},\n  {\"id\":705012,\"suggestedTranslation\":\"Chắc đây là một loại cổ vật tôn giáo nào đó.\",\"rating\":9.0}\n]",
