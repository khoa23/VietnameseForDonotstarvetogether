          {
            "text": "[\n  {\"id\":704113,\"suggestedTranslation\":\"Cơn ác mộng sắp biến mất rồi!\",\"rating\":1.0},\n  {\"id\":704114,\"suggestedTranslation\":\"Chẳng có chút phép thuật nào ở quanh đây cả.\",\"rating\":1.0},\n  {\"id\":704115,\"suggestedTranslation\":\"Nó có vẻ vẫn đang ổn định.\",\"rating\":1.0},\n  {\"id\":704116,\"suggestedTranslation\":\"Cảm giác như nó đang suy yếu dần.\",\"rating\":1.0},\n  {\"id\":704117,\"suggestedTranslation\":\"Khá là nhiều phép thuật xuất hiện quanh đây rồi đấy.\",\"rating\":1.0},\n  {\"id\":704118,\"suggestedTranslation\":\"Nó đang trở nên đậm đặc hơn!\",\"rating\":1.0},\n  {\"id\":704119,\"suggestedTranslation\":\"Nó có điện đấy!\",\"rating\":1.0},\n  {\"id\":704120,\"suggestedTranslation\":\"Sao lại có người chế tạo ra thứ này chứ? Thật đáng sợ.\",\"rating\":1.0},\n  {\"id\":704121,\"suggestedTranslation\":\"Tôi có phải nhà địa chất học đâu.\",\"rating\":1.0},\n  {\"id\":704122,\"suggestedTranslation\":\"Đó chắc chắn là một loại đá tảng nào đó.\",\"rating\":1.0},\n  {\"id\":704123,\"suggestedTranslation\":\"Độ bám khá tốt đấy chứ!\",\"rating\":1.0},\n  {\"id\":704124,\"suggestedTranslation\":\"Giờ thì chúng ta thực sự đang bám rất chắc rồi!\",\"rating\":1.0},\n  {\"id\":704125,\"suggestedTranslation\":\"Cái này sẽ giúp tôi thấy hết đống khoa học ẩn giấu trong đất.\",\"rating\":1.0},\n  {\"id\":704126,\"suggestedTranslation\":\"Tăng tốc tàu thủ công.\",\"rating\":1.0},\n  {\"id\":704127,\"suggestedTranslation\":\"Tăng tốc tàu thủ công.\",\"rating\":1.0},\n  {\"id\":704128,\"suggestedTranslation\":\"Thật là đưa mái chèo vào trận chiến.\",\"rating\":1.0},\n  {\"id\":704129,\"suggestedTranslation\":\"Khô như ngói.\",\"rating\":1.0},\n  {\"id\":704130,\"suggestedTranslation\":\"Kia là ảo ảnh phải không?\",\"rating\":1.0},\n  {\"id\":704131,\"suggestedTranslation\":\"Chỉ là một ít cỏ lầy.\",\"rating\":1.0},\n  {\"id\":704132,\"suggestedTranslation\":\"Lũ cá sẽ cực kỳ thích thú với thứ này khi đi Câu Cá đấy.\",\"rating\":1.0},\n  {\"id\":704133,\"suggestedTranslation\":\"Chào người anh em nhỏ bé nhé!\",\"rating\":1.0},\n  {\"id\":704134,\"suggestedTranslation\":\"Thà đi Câu Cá còn hơn là nhai thịt quạ.\",\"rating\":1.0},\n  {\"id\":704135,\"suggestedTranslation\":\"Mày tiêu đời rồi, lũ cá khi đi Câu Cá!\",\"rating\":1.0},\n  {\"id\":704136,\"suggestedTranslation\":\"Cầu được ước thấy.\",\"rating\":1.0},\n  {\"id\":704137,\"suggestedTranslation\":\"Thêm phao câu có lẽ sẽ cải thiện độ chuẩn xác.\",\"rating\":1.0},\n  {\"id\":704138,\"suggestedTranslation\":\"Lũ cá khi đi Câu Cá sẽ không thể thoát khỏi tay tôi lần này đâu!\",\"rating\":1.0},\n  {\"id\":704139,\"suggestedTranslation\":\"Hy vọng nó không thu hút bất kỳ sự đánh lạc hướng nào.\",\"rating\":1.0},\n  {\"id\":704140,\"suggestedTranslation\":\"Lông vũ của Chim Tuyết giúp tôi giữ được sự lạnh lùng.\",\"rating\":1.0},\n  {\"id\":704141,\"suggestedTranslation\":\"Bộ não tôi được bảo vệ bởi một lớp khoa học khô khan dày đặc!\",\"rating\":1.0},\n  {\"id\":704142,\"suggestedTranslation\":\"Cái này có vẻ hơi nặng tay thì phải.\",\"rating\":1.0},\n  {\"id\":704143,\"suggestedTranslation\":\"Tự làm ướt mình có thể giúp tôi suy nghĩ giống như một con cá khi Câu Cá...\",\"rating\":1.0},\n  {\"id\":704144,\"suggestedTranslation\":\"Lũ cá khi đi Câu Cá sẽ không biết điều gì giáng xuống đầu chúng đâu!\",\"rating\":1.0},\n  {\"id\":704145,\"suggestedTranslation\":\"Vài con cá khi đi Câu Cá có thể sẽ thấy thứ này cực kỳ cuốn hút!\",\"rating\":1.0},\n  {\"id\":704146,\"suggestedTranslation\":\"Vài con cá khi đi Câu Cá có thể sẽ thấy thứ này cực kỳ cuốn hút!\",\"rating\":1.0},\n  {\"id\":704147,\"suggestedTranslation\":\"Vài con cá khi đi Câu Cá có thể sẽ thấy thứ này cực kỳ cuốn hút!\",\"rating\":1.0},\n  {\"id\":704148,\"suggestedTranslation\":\"Vài con cá nhỏ hơn khi đi Câu Cá có thể sẽ thấy thứ này cực kỳ cuốn hút!\",\"rating\":1.0},\n  {\"id\":704149,\"suggestedTranslation\":\"Vài con cá nhỏ hơn khi đi Câu Cá có thể sẽ thấy thứ này cực kỳ cuốn hút!\",\"rating\":1.0},\n  {\"id\":704150,\"suggestedTranslation\":\"Vài con cá nhỏ hơn khi đi Câu Cá có thể sẽ thấy thứ này cực kỳ cuốn hút!\",\"rating\":1.0},\n  {\"id\":704151,\"suggestedTranslation\":\"Đây mới chính là chiếc cần câu hàng thật!\",\"rating\":1.0},\n  {\"id\":704152,\"suggestedTranslation\":\"Tôi thực sự hy vọng nó ngon hơn vẻ bề ngoài.\",\"rating\":1.0},\n  {\"id\":704153,\"suggestedTranslation\":\"Tôi đã tốn rất nhiều công sức để bắt được nó đấy.\",\"rating\":1.0},\n  {\"id\":704154,\"suggestedTranslation\":\"Tôi không hề bốc phét về tài câu cá của mình đâu nhé!\",\"rating\":1.0},\n  {\"id\":704155,\"suggestedTranslation\":\"Tôi chắc rằng thứ này sẽ không mang lại vận rủi nào đâu.\",\"rating\":1.0},\n  {\"id\":704156,\"suggestedTranslation\":\"Con này có vẻ hơi ngớ ngẩn nhỉ.\",\"rating\":1.0},\n  {\"id\":704157,\"suggestedTranslation\":\"Đúng là hàng chuẩn McKoi rồi!\",\"rating\":1.0},\n  {\"id\":704158,\"suggestedTranslation\":\"Đúng là hàng chuẩn McKoi rồi!\",\"rating\":1.0},\n  {\"id\":704159,\"suggestedTranslation\":\"Kem vền băng, bạn bè cùng thèm.\",\"rating\":1.0},\n  {\"id\":704160,\"suggestedTranslation\":\"Đó là mùi hương ngọt ngào của một chuyến đi câu thành công.\",\"rating\":1.0},\n  {\"id\":704161,\"suggestedTranslation\":\"Trông như đứa còi cọc nhất đàn.\",\"rating\":1.0},\n  {\"id\":704162,\"suggestedTranslation\":\"Tôi chẳng thể khoe khoang gì với chiến tích này được đâu.\",\"rating\":1.0},\n  {\"id\":704163,\"suggestedTranslation\":\"Nó hơi nhỏ về kích thước thì phải.\",\"rating\":1.0},\n  {\"id\":704164,\"suggestedTranslation\":\"Một con cá khi đi Câu Cá kích cỡ này không đủ để tôi qua ngày đâu.\",\"rating\":1.0},\n  {\"id\":704165,\"suggestedTranslation\":\"Tôi không thể chờ để tọng nó vào miệng nữa rồi.\",\"rating\":1.0},\n  {\"id\":704166,\"suggestedTranslation\":\"Phải thấy tận mắt mới tin được đấy.\",\"rating\":1.0},\n  {\"id\":704167,\"suggestedTranslation\":\"Cuối cùng tôi cũng bắt được con cá khi đi Câu Cá chết tiệt này!\",\"rating\":1.0},\n  {\"id\":704168,\"suggestedTranslation\":\"Nóng cháy da cháy thịt đấy!\",\"rating\":1.0},\n  {\"id\":704169,\"suggestedTranslation\":\"Chỉ đoán mò thế thôi, nhưng chắc tôi sẽ dùng được việc gì đấy...\",\"rating\":1.0},\n  {\"id\":704170,\"suggestedTranslation\":\"Tôi nghĩ những cái cây này có chút đi lạc đấy.\",\"rating\":1.0},\n  {\"id\":704171,\"suggestedTranslation\":\"Có cái gì đó đang sống ở bên trong.\",\"rating\":1.0},\n  {\"id\":704172,\"suggestedTranslation\":\"Nó không tuyệt bằng bản gốc, nhưng vẫn khá ổn.\",\"rating\":1.0},\n  {\"id\":704173,\"suggestedTranslation\":\"Thuật ngữ khoa học là \\\"mì cây\\\".\",\"rating\":1.0},\n  {\"id\":704174,\"suggestedTranslation\":\"Sẽ thế nào nếu tôi chọc nhẹ vào nó một cái nhỉ?\",\"rating\":1.0},\n  {\"id\":704175,\"suggestedTranslation\":\"Tôi ngửi thấy mùi bánh mì cháy.\",\"rating\":1.0},\n  {\"id\":704176,\"suggestedTranslation\":\"Tôi thấy mảnh vụn trôi nổi.\",\"rating\":1.0},\n  {\"id\":704177,\"suggestedTranslation\":\"Tôi sẽ thử một vòng xem sao.\",\"rating\":1.0},\n  {\"id\":704178,\"suggestedTranslation\":\"Nó bắt được cái gì kìa!\",\"rating\":1.0},\n  {\"id\":704179,\"suggestedTranslation\":\"Hình như có gì đó mắc câu, nhưng nó sổng mất rồi...\",\"rating\":1.0},\n  {\"id\":704180,\"suggestedTranslation\":\"Đã sẵn sàng đi câu cá khi đi Câu Cá trở lại!\",\"rating\":1.0},\n  {\"id\":704181,\"suggestedTranslation\":\"Nó giúp việc câu cá trở nên hiệu-cá-hơn.\",\"rating\":1.0},\n  {\"id\":704182,\"suggestedTranslation\":\"Và giờ chúng ta chờ đợi.\",\"rating\":1.0},\n  {\"id\":704183,\"suggestedTranslation\":\"Tôi nên đặt nó ở nơi có thật nhiều cá khi đi Câu Cá.\",\"rating\":1.0},\n  {\"id\":704184,\"suggestedTranslation\":\"Trông thật đáng thương và thiếu vắng rong biển...\",\"rating\":1.0},\n  {\"id\":704185,\"suggestedTranslation\":\"Một lượng rong biển khổng lồ!\",\"rating\":1.0},\n  {\"id\":704186,\"suggestedTranslation\":\"Tôi nghĩ mình có thể nhét thêm chút rong biển vào trỏng.\",\"r