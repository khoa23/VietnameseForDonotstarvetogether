        "parts": [
          {
            "text": "[\n  {\"id\":705313,\"suggestedTranslation\":\"%s đang dùng sức mạnh của mình vào việc thiện.\",\"rating\":0.0},\n  {\"id\":705314,\"suggestedTranslation\":\"Đáng sợ thật.\",\"rating\":0.0},\n  {\"id\":705315,\"suggestedTranslation\":\"only_used_by_waxwell\",\"rating\":0.0},\n  {\"id\":705316,\"suggestedTranslation\":\"Tôi sẽ cuộn một tờ báo giấy lại, để phòng hờ.\",\"rating\":0.0},\n  {\"id\":705317,\"suggestedTranslation\":\"Chúng ta cần tổ chức một cuộc họp nhóm về an toàn lửa mới được.\",\"rating\":0.0},\n  {\"id\":705318,\"suggestedTranslation\":\"Chào ngày mới, %s!\",\"rating\":0.0},\n  {\"id\":705319,\"suggestedTranslation\":\"%s cứ bám riết lấy tôi đòi tim kìa.\",\"rating\":0.0},\n  {\"id\":705320,\"suggestedTranslation\":\"Kẻ giết người! Ta sẽ nghiền nát ngươi, %s!\",\"rating\":0.0},\n  {\"id\":705321,\"suggestedTranslation\":\"%s đang chơi rất hòa đồng với mọi người.\",\"rating\":0.0},\n  {\"id\":705322,\"suggestedTranslation\":\"Tội nghiệp cậu bé. Cậu ấy xứng đáng có một tang lễ tử tế.\",\"rating\":0.0},\n  {\"id\":705323,\"suggestedTranslation\":\"Chắc là chúng đang chiến đấu vì chúng ta.\",\"rating\":0.0},\n  {\"id\":705324,\"suggestedTranslation\":\"Này, cậu không phải là rau củ đâu nhé!\",\"rating\":0.0},\n  {\"id\":705325,\"suggestedTranslation\":\"%s không mang theo vật sắc nhọn nào chứ nhỉ?\",\"rating\":0.0},\n  {\"id\":705326,\"suggestedTranslation\":\"Tôi biết chính cậu là người đã châm lửa đấy, %s.\",\"rating\":0.0},\n  {\"id\":705327,\"suggestedTranslation\":\"Xin chào, %s!\",\"rating\":0.0},\n  {\"id\":705328,\"suggestedTranslation\":\"Tôi hoa mắt mất rồi! Tốt hơn là nên chế tạo một trái tim cho %s.\",\"rating\":0.0},\n  {\"id\":705329,\"suggestedTranslation\":\"Kẻ giết người!\",\"rating\":0.0},\n  {\"id\":705330,\"suggestedTranslation\":\"%s đối xử với hồn ma như người nhà vậy.\",\"rating\":0.0},\n  {\"id\":705331,\"suggestedTranslation\":\"Thật là yên tâm một cách kỳ lạ!\",\"rating\":0.0},\n  {\"id\":705332,\"suggestedTranslation\":\"Chắc khoa học ở phương Bắc hoạt động khác kiểu ở đây rồi.\",\"rating\":0.0},\n  {\"id\":705333,\"suggestedTranslation\":\"Thứ đó làm TÔI nổi cả da gà đấy!\",\"rating\":0.0},\n  {\"id\":705334,\"suggestedTranslation\":\"Một con hươu sừng tấm bị nguyền rủa bình thường hoàn toàn.\",\"rating\":0.0},\n  {\"id\":705335,\"suggestedTranslation\":\"%s tuy im lặng nhưng lại rất nguy hiểm...\",\"rating\":0.0},\n  {\"id\":705336,\"suggestedTranslation\":\"Khoan, đừng nói với tôi nhé. Cậu đã châm lửa đúng không.\",\"rating\":0.0},\n  {\"id\":705337,\"suggestedTranslation\":\"Xin chào, %s!\",\"rating\":0.0},\n  {\"id\":705338,\"suggestedTranslation\":\"Làm sao để nói \\\"Tôi sẽ kiếm thiết bị hồi sinh\\\" bằng ngôn ngữ cơ thể nhỉ?\",\"rating\":0.0},\n  {\"id\":705339,\"suggestedTranslation\":\"Nhìn động tác đây này!\",\"rating\":0.0},\n  {\"id\":705340,\"suggestedTranslation\":\"%s luôn suy nghĩ vượt ra khỏi khuôn khổ vô hình.\",\"rating\":0.0},\n  {\"id\":705341,\"suggestedTranslation\":\"Chẳng có vị gì cả.\",\"rating\":0.0},\n  {\"id\":705342,\"suggestedTranslation\":\"Mong là nó sẽ sớm khô ráo trở lại.\",\"rating\":0.0},\n  {\"id\":705343,\"suggestedTranslation\":\"Gói hàng này sắp rã rời đến nơi rồi.\",\"rating\":0.0},\n  {\"id\":705344,\"suggestedTranslation\":\"Không gì bằng những tiếng động lớn để giúp giữ gìn hòa bình cả.\",\"rating\":0.0},\n  {\"id\":705345,\"suggestedTranslation\":\"Tôi nghĩ %s đang định trút hết mọi thứ lên đầu tôi đấy.\",\"rating\":0.0},\n  {\"id\":705346,\"suggestedTranslation\":\"Tôi chắc là bạn có một lý do cực kỳ thông minh cho đống lửa đó đấy.\",\"rating\":0.0},\n  {\"id\":705347,\"suggestedTranslation\":\"Chào ngày mới, %s!\",\"rating\":0.0},\n  {\"id\":705348,\"suggestedTranslation\":\"Việc này có vẻ không khoa học cho lắm nhỉ, %s?\",\"rating\":0.0},\n  {\"id\":705349,\"suggestedTranslation\":\"Đợt phản biện của tôi đến đây!\",\"rating\":0.0},\n  {\"id\":705350,\"suggestedTranslation\":\"Tôi vô cùng tôn trọng các định lý thực tiễn 