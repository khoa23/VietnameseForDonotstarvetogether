            "text": "[\n  {\"id\":705613,\"suggestedTranslation\":\"Ta lo mà dựng nó lên thôi.\",\"rating\":0.0},\n  {\"id\":705614,\"suggestedTranslation\":\"May vá chắc không khó lắm đâu... nhỉ?\",\"rating\":0.0},\n  {\"id\":705615,\"suggestedTranslation\":\"Có vẻ cần phải lắp ráp một chút.\",\"rating\":0.0},\n  {\"id\":705616,\"suggestedTranslation\":\"Lạ thật, mình chẳng bao giờ thấy hắn bước vào hay bước ra cả...\",\"rating\":0.0},\n  {\"id\":705617,\"suggestedTranslation\":\"Có vẻ cần phải xây dựng một chút.\",\"rating\":0.0},\n  {\"id\":705618,\"suggestedTranslation\":\"Ngửi giống cà rốt nướng thế.\",\"rating\":0.0},\n  {\"id\":705619,\"suggestedTranslation\":\"Hừm... Cà Ruột thích ăn gì nhỉ?\",\"rating\":0.0},\n  {\"id\":705620,\"suggestedTranslation\":\"Nên làm gì đây...\",\"rating\":0.0},\n  {\"id\":705621,\"suggestedTranslation\":\"Kế hoạch huấn luyện của tôi đổ sông đổ biển rồi.\",\"rating\":0.0},\n  {\"id\":705622,\"suggestedTranslation\":\"Cái này sẽ giúp mọi thứ tiến triển theo đúng hướng.\",\"rating\":0.0},\n  {\"id\":705623,\"suggestedTranslation\":\"Cậu sẽ trở thành một con chuột thí nghiệm xuất sắc đấy.\",\"rating\":0.0},\n  {\"id\":705624,\"suggestedTranslation\":\"Tốt hơn là mình nên bắt đầu huấn luyện thôi!\",\"rating\":0.0},\n  {\"id\":705625,\"suggestedTranslation\":\"Một sự hy sinh nhỏ trên con đường theo đuổi khoa học.\",\"rating\":0.0},\n  {\"id\":705626,\"suggestedTranslation\":\"Cùng rèn luyện phản xạ giống Cà Ruột nào!\",\"rating\":0.0},\n  {\"id\":705627,\"suggestedTranslation\":\"Tốc độ phản ứng của đối tượng đang cải thiện đều đặn!\",\"rating\":0.0},\n  {\"id\":705628,\"suggestedTranslation\":\"Cái này sẽ cải thiện đáng kể thời gian phản ứng của Cà Ruột nhà tôi.\",\"rating\":0.0},\n  {\"id\":705629,\"suggestedTranslation\":\"Có lẽ tôi hơi quá tay rồi.\",\"rating\":0.0},\n  {\"id\":705630,\"suggestedTranslation\":\"Tôi cần phải giúp Cà Ruột bắt kịp tốc độ.\",\"rating\":0.0},\n  {\"id\":705631,\"suggestedTranslation\":\"Nhanh lên... nhanh nữa lên!\",\"rating\":0.0},\n  {\"id\":705632,\"suggestedTranslation\":\"Tốt nhất là mình nên lắp ráp cái này thôi.\",\"rating\":0.0},\n  {\"id\":705633,\"suggestedTranslation\":\"Cậu không thể ngăn cản sự tiến bộ! Nhưng việc này sẽ làm chậm nó lại...\",\"rating\":0.0},\n  {\"id\":705634,\"suggestedTranslation\":\"Bắt đầu khỏe lên rồi đây!\",\"rating\":0.0},\n  {\"id\":705635,\"suggestedTranslation\":\"Con Cà Ruột này... sẽ là vô địch!!\",\"rating\":0.0},\n  {\"id\":705636,\"suggestedTranslation\":\"Cái này sẽ giúp cải thiện thể lực cho Cà Ruột của tôi.\",\"rating\":0.0},\n  {\"id\":705637,\"suggestedTranslation\":\"Cậu đã nói lên được quan điểm của mình rồi đấy.\",\"rating\":0.0},\n  {\"id\":705638,\"suggestedTranslation\":\"Khớp rồi đấy.\",\"rating\":0.0},\n  {\"id\":705639,\"suggestedTranslation\":\"Biển lửa nuốt chửng tất cả rồi!\",\"rating\":0.0},\n  {\"id\":705640,\"suggestedTranslation\":\"Thực ra đây là một vòng tròn đích hơn là một vạch kẻ.\",\"rating\":0.0},\n  {\"id\":705641,\"suggestedTranslation\":\"Hà HA! Khoa học đã chiến thắng!\",\"rating\":0.0},\n  {\"id\":705642,\"suggestedTranslation\":\"Haizz... chúc mừng nhé, {winner}.\",\"rating\":0.0},\n  {\"id\":705643,\"suggestedTranslation\":\"Điểm kết thúc đang ở trước mắt rồi.\",\"rating\":0.0},\n  {\"id\":705644,\"suggestedTranslation\":\"Đây là một nơi khá tốt để bắt đầu.\",\"rating\":0.0},\n  {\"id\":705645,\"suggestedTranslation\":\"Ừ thì, cũng là một khởi đầu.\",\"rating\":0.0},\n  {\"id\":705646,\"suggestedTranslation\":\"Đúng là một bãi rác.\",\"rating\":0.0},\n  {\"id\":705647,\"suggestedTranslation\":\"Tôi cho rằng dù thế nào đi nữa, nó vẫn chỉ là một loại rau củ có tri giác.\",\"rating\":0.0},\n  {\"id\":705648,\"suggestedTranslation\":\"Con Cà Ruột này trông có vẻ đã sẵn sàng để đua rồi!\",\"rating\":0.0},\n  {\"id\":705649,\"suggestedTranslation\":\"Mong là các vẩy cân sẽ nghiêng về phía tôi.\",\"rating\":0.0},\n  {\"id\":705650,\"suggestedTranslation\":\"Cái này sẽ giúp tôi đánh giá Cà Ruột của mình.\",\"rating\":0.0},\n  {\"id\":705651,\"suggestedTranslation\":\"Trông mờ ám phết đấy chứ, nếu bạn hỏi tôi.\",\"rating\":0.0},\n  {\"id\":705652,\"suggestedTranslation\":\"Chào nhé, những cái cây sang chảnh!\",\"rating\":0.0},\n  {\"id\":705653,\"suggestedTranslation\":\"Tôi không muốn thuyền ván của mình bay mất đâu.\",\"rating\":0.0},\n  {\"id\":705654,\"suggestedTranslation\":\"Giờ tôi có thể chế tạo dây neo rồi.\",\"rating\":0.0},\n  {\"id\":705655,\"suggestedTranslation\":\"Mọi chuyện có vẻ hơi căng thẳng rồi đây.\",\"rating\":0.0},\n  {\"id\":705656,\"suggestedTranslation\":\"Nó có lẽ sẽ thích một mẩu than đấy.\",\"rating\":0.0},\n  {\"id\":705657,\"suggestedTranslation\":\"Tôi đang tò mò đến phát cuồng để xem ở đây có gì.\",\"rating\":0.0},\n  {\"id\":705658,\"suggestedTranslation\":\"Đúng là một cây dầm tiện lợi.\",\"rating\":0.0},\n  {\"id\":705659,\"suggestedTranslation\":\"Cái đó sẽ lái tôi đi đúng hướng. Cả hướng trái nữa.\",\"rating\":0.0},\n  {\"id\":705660,\"suggestedTranslation\":\"Đó sẽ là bánh lái.\",\"rating\":0.0},\n  {\"id\":705661,\"suggestedTranslation\":\"Một chuyến đi chòng chành!\",\"rating\":0.0},\n  {\"id\":705662,\"suggestedTranslation\":\"Trông mình có giống ngựa con không nhỉ?\",\"rating\":0.0},\n  {\"id\":705663,\"suggestedTranslation\":\"Nó không phải con lừa, nhưng chắc chắn là tro tàn rồi.\",\"rating\":0.0},\n  {\"id\":705664,\"suggestedTranslation\":\"Nó cứ quay lưng đi cho đến khi tôi cống hiến thứ gì đó.\",\"rating\":0.0},\n  {\"id\":705665,\"suggestedTranslation\":\"Tôi đã cố hết sức đền thờ rồi đấy.\",\"rating\":0.0},\n  {\"id\":705666,\"suggestedTranslation\":\"Tôi đang hừng hực khí thế muốn cất bước đây!\",\"rating\":0.0},\n  {\"id\":705667,\"suggestedTranslation\":\"Hừm, không thể nói là tôi thích múa giáo lắm đâu.\",\"rating\":0.0},\n  {\"id\":705668,\"suggestedTranslation\":\"Một bữa tiệc xứng đáng cho tôi.\",\"rating\":0.0},\n  {\"id\":705669,\"suggestedTranslation\":\"Một bữa ăn mà chỉ có quái thú mới thích nổi.\",\"rating\":0.0},\n  {\"id\":705670,\"suggestedTranslation\":\"Chẳng có gì đặc biệt cả.\",\"rating\":0.0},\n  {\"id\":705671,\"suggestedTranslation\":\"Con thỏ đó thực sự có thể làm bừng sáng cả căn phòng đấy.\",\"rating\":0.0},\n  {\"id\":705672,\"suggestedTranslation\":\"Con thỏ đó chẳng thèm làm bừng sáng cái gì sất.\",\"rating\":0.0},\n  {\"id\":705673,\"suggestedTranslation\":\"Tôi biết chính xác chỗ dành cho nó rồi.\",\"rating\":0.0},\n  {\"id\":705674,\"suggestedTranslation\":\"Con thỏ đó thực sự có thể làm bừng sáng cả căn phòng đấy.\",\"rating\":0.0},\n  {\"id\":705675,\"suggestedTranslation\":\"Con thỏ đó chẳng thèm làm bừng sáng cái gì sất.\",\"rating\":0.0},\n  {\"id\":705676,\"suggestedTranslation\":\"Tôi biết chính xác chỗ dành cho nó rồi.\",\"rating\":0.0},\n  {\"id\":705677,\"suggestedTranslation\":\"Tạm thời thì mọi thứ vẫn yên bình.\",\"rating\":0.0},\n  {\"id\":705678,\"suggestedTranslation\":\"Tôi nghĩ tất cả chúng ta đều học được rất nhiều điều ở đây hôm nay.\",\"rating\":0.0},\n  {\"id\":705679,\"suggestedTranslation\":\"Nó phải được xây dựng, vì khoa học!\",\"rating\":0.0},\n  {\"id\":705680,\"suggestedTranslation\":\"Nó được làm bằng cà rốt, thế nên khoa học bảo là nó rất bổ dưỡng.\",\"rating\":0.0},\n  {\"id\":705681,\"suggestedTranslation\":\"Màu xanh dương là hương vị mang tính khoa học nhất.\",\"rating\":0.0},\n  {\"id\":705682,\"suggestedTranslation\":\"Một món ăn dẻo dẻo vui nhộn.\",\"rating\":0.0},\n  {\"id\":705683,\"suggestedTranslation\":\"Nhảy cẫng như thỏ vào miệng tôi nào!\",\"rating\":0.0},\n  {\"id\":705684,\"suggestedTranslation\":\"Ngửi giống đồ nướng chay thế.\",\"rating\":0.0},\n  {\"id\":705685,\"suggestedTranslation\":\"Con thỏ đó trông có vẻ đói rồi.\",\"rating\":0.0},\n  {\"id\":705686,\"suggestedTranslation\":\"Nên làm gì đây...\",\"rating\":0.0},\n  {\"id\":705687,\"suggestedTranslation\":\"Tôi nên cẩn thận xem mình sẽ đưa cái này cho ai.\",\"rating\":0.0},\n  {\"id\":705688,\"suggestedTranslation\":\"Đúng là một cái cột cột.\",\"rating\":0.0},\n  {\"id\":705689,\"suggestedTranslation\":\"Nó cột là phải ở đó mà.\",\"rating\":0.0},\n  {\"id\":705690,\"suggestedTranslation\":\"Nó cột đi đâu thế nhỉ?\",\"rating\":0.0},\n  {\"id\":705691,\"suggestedTranslation\":\"Willow!\",\"rating\":0.0},\n  {\"id\":705692,\"suggestedTranslation\":\"Nó có sự thèm ăn lớn như quái vật vậy.\",\"rating\":0.0},\n  {\"id\":705693,\"suggestedTranslation\":\"Nó tràn đầy những hứa hẹn!\",\"rating\":0.0},\n  {\"id\":705694,\"suggestedTranslation\":\"Nó đến từ những tầng sâu thẳm hơn.\",\"rating\":0.0},\n  {\"id\":705695,\"suggestedTranslation\":\"Ngửi giống mùi lông bị cháy xém.\",\"rating\":0.0},\n  {\"id\":705696,\"suggestedTranslation\":\"Có lẽ nó sẽ thích một chiếc lông vũ để chơi đùa...\",\"rating\":0.0},\n  {\"id\":705697,\"suggestedTranslation\":\"Nên làm gì đây...\",\"rating\":0.0},\n  {\"id\":705698,\"suggestedTranslation\":\"Đó là một... thứ.\",\"rating\":0.0},\n  {\"id\":705699,\"suggestedTranslation\":\"Thật là một thực vật vui vẻ!\",\"rating\":0.0},\n  {\"id\":705700,\"suggestedTranslation\":\"Nó hơi cáu kỉnh một chút.\",\"rating\":0.0},\n  {\"id\":705701,\"suggestedTranslation\":\"Theo kết luận khoa học của tôi thì thực vật này có vẻ cô đơn.\",\"rating\":0.0},\n  {\"id\":705702,\"suggestedTranslation\":\"Nó đang khát khao một cuộc trò chuyện thú vị.\",\"rating\":0.0},\n  {\"id\":705703,\"suggestedTranslation\":\"Tôi có lẽ phải đi nhổ cỏ dại một chút...\",\"rating\":0.0},\n  {\"id\":705704,\"suggestedTranslation\":\"Cây này trông thực sự rất mất nước.\",\"rating\":0.0},\n  {\"id\":705705,\"suggestedTranslation\":\"Thực vật tội nghiệp này rất cần chất dinh dưỡng!\",\"rating\":0.0},\n  {\"id\":705706,\"suggestedTranslation\":\"Có quá nhiều thực vật đang tranh giành không gian chật hẹp này.\",\"rating\":0.0},\n  {\"id\":705707,\"suggestedTranslation\":\"Mùa này không hề đối xử tốt với thực vật này chút nào.\",\"rating\":0.0},\n  {\"id\":705708,\"suggestedTranslation\":\"Thực vật này có vẻ đang chịu rất nhiều căng thẳng.\",\"rating\":0.0},\n  {\"id\":705709,\"suggestedTranslation\":\"Thứ đó sắp bốc cháy rồi.\",\"rating\":0.0},\n  {\"id\":705710,\"suggestedTranslation\":\"Tối quá không thấy gì cả!\",\"rating\":0.0},\n  {\"id\":705711,\"suggestedTranslation\":\"Măm măm. Toàn mùi mỏ chim.\",\"rating\":0.0},\n  {\"id\":705712,\"suggestedTranslation\":\"Có vị giống như mấy ngày lễ hội vậy.\",\"rating\":0.0},\n  {\"id\":705713,\"suggestedTranslation\":\"Tôi có linh cảm không lành về chuyện này.\",\"rating\":0.0},\n  {\"id\":705714,\"suggestedTranslation\":\"Tôi để nó trên bếp quá lâu rồi.\",\"rating\":0.0},\n  {\"id\":705715,\"suggestedTranslation\":\"Mấy nguyên liệu đó chẳng tạo ra món gì cả.\",\"rating\":0.0},\n  {\"id\":705716,\"suggestedTranslation\":\"Đến lúc đi rồi!\",\"rating\":0.0},\n  {\"id\":705717,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":0.0},\n  {\"id\":705718,\"suggestedTranslation\":\"Tôi tưởng mình vừa thấy ổng ở đâu quanh đây chứ...\",\"rating\":0.0},\n  {\"id\":705719,\"suggestedTranslation\":\"Nó trống không á? Giờ thì tôi thấy hơi tệ rồi đấy...\",\"rating\":0.0},\n  {\"id\":705720,\"suggestedTranslation\":\"Xin lỗi chú nhé...? Hừm, trông ổng có vẻ bận.\",\"rating\":0.0},\n  {\"id\":705721,\"suggestedTranslation\":\"Trò chơi này sẽ kết thúc khá nhanh đây, có lẽ tôi nên tìm thêm người trước đã.\",\"rating\":0.0},\n  {\"id\":705722,\"suggestedTranslation\":\"Ờm, tôi không chắc tụi nó có thể trốn ở đâu quanh đây nữa.\",\"rating\":0.0},\n  {\"id\":705723,\"suggestedTranslation\":\"Xin lỗi mấy bé mèo nhé, tôi không thể chơi với các bạn cả ngày được!\",\"rating\":0.0},\n  {\"id\":705724,\"suggestedTranslation\":\"Tôi nghĩ nó bị khóa rồi.\",\"rating\":0.0},\n  {\"id\":705725,\"suggestedTranslation\":\"Xin lỗi, chắc là bạn không mặc được món đó đâu.\",\"rating\":0.0},\n  {\"id\":705726,\"suggestedTranslation\":\"Ôi, có vẻ như bọn họ đi hết rồi...\",\"rating\":0.0},\n  {\"id\":705727,\"suggestedTranslation\":\"only_used_by_wurt\",\"rating\":0.0},\n  {\"id\":705728,\"suggestedTranslation\":\"Cái đó không dành cho chúng ta đâu, Woby.\",\"rating\":0.0},\n  {\"id\":705729,\"suggestedTranslation\":\"Tôi đã cố nói bằng tiếng quái vật đầm lầy, nhưng có vẻ tôi vừa xúc phạm chúng thì phải.\",\"rating\":0.0},\n  {\"id\":705730,\"suggestedTranslation\":\"Tôi đoán là mình cũng chẳng thể bảo một con gấu bông phải làm gì được.\",\"rating\":0.0},\n  {\"id\":705731,\"suggestedTranslation\":\"Khoan đã, tôi chưa chuẩn bị xong mà!\",\"rating\":0.0},\n  {\"id\":705732,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":0.0},\n  {\"id\":705733,\"suggestedTranslation\":\"Tôi không nghĩ cái bụng của mình chịu nổi món đó đâu.\",\"rating\":0.0},\n  {\"id\":705734,\"suggestedTranslation\":\"only_used_by_wx78\",\"rating\":0.0},\n  {\"id\":705735,\"suggestedTranslation\":\"only_used_by_wx78\",\"rating\":0.0},\n  {\"id\":705736,\"suggestedTranslation\":\"Để lát nữa chúng ta quay lại nhé.\",\"rating\":0.0},\n  {\"id\":705737,\"suggestedTranslation\":\"Tôi không thể! Tôi cần được y tế chăm sóc! Hộp sơ cứu đâu rồi?!\",\"rating\":0.0},\n  {\"id\":705738,\"suggestedTranslation\":\"Tôi không muốn lãng phí nguyên liệu đâu.\",\"rating\":0.0},\n  {\"id\":705739,\"suggestedTranslation\":\"Tôi không nghĩ cách đó sẽ hiệu quả đâu.\",\"rating\":0.0},\n  {\"id\":705740,\"suggestedTranslation\":\"Chúng ta phải đợi thôi, Woby!\",\"rating\":0.0},\n  {\"id\":705741,\"suggestedTranslation\":\"Tôi nghĩ Woby có thể sẽ ghen tị nếu tôi cứ tiếp tục thu thập thú cưng đấy.\",\"rating\":0.0},\n  {\"id\":705742,\"suggestedTranslation\":\"Tôi phải xuống ngựa nếu muốn làm việc đó cho đàng hoàng.\",\"rating\":0.0},\n  {\"id\":705743,\"suggestedTranslation\":\"Một đứa thế này là đủ mệt để trông chừng rồi.\",\"rating\":0.0},\n  {\"id\":705744,\"suggestedTranslation\":\"Chết tiệt! Tôi không đủ nhanh.\",\"rating\":0.0},\n  {\"id\":705745,\"suggestedTranslation\":\"Ái! An toàn lửa đấy!\",\"rating\":0.0},\n  {\"id\":705746,\"suggestedTranslation\":\"Quả bí ngô đó đang được khắc mà, Woby!\",\"rating\":0.0},\n  {\"id\":705747,\"suggestedTranslation\":\"only_used_by_willow\",\"rating\":0.0},\n  {\"id\":705748,\"suggestedTranslation\":\"only_used_by_willow\",\"rating\":0.0},\n  {\"id\":705749,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":0.0},\n  {\"id\":705750,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":0.0},\n  {\"id\":705751,\"suggestedTranslation\":\"only_used_by_willow\",\"rating\":0.0},\n  {\"id\":705752,\"suggestedTranslation\":\"only_used_by_willow\",\"rating\":0.0},\n  {\"id\":705753,\"suggestedTranslation\":\"only_used_by_wurt\",\"rating\":0.0},\n  {\"id\":705754,\"suggestedTranslation\":\"Điều đó đi ngược lại mọi thứ chúng ta được học về an toàn phòng cháy chữa cháy.\",\"rating\":0.0},\n  {\"id\":705755,\"suggestedTranslation\":\"Thứ tôi đang mặc ổn chán.\",\"rating\":0.0},\n  {\"id\":705756,\"suggestedTranslation\":\"Cậu bị lạc trong đó hả? Ha... ha... à, đùa đấy.\",\"rating\":0.0},\n  {\"id\":705757,\"suggestedTranslation\":\"Ờm, tôi nghĩ chúng ta quên mất điều gì đó...\",\"rating\":0.0},\n  {\"id\":705758,\"suggestedTranslation\":\"Tôi sẽ phải đợi cho đến khi tóc họ mọc lại đã.\",\"rating\":0.0},\n  {\"id\":705759,\"suggestedTranslation\":\"Chúng ta đã nạp đầy năng lượng rồi, Woby!\",\"rating\":0.0},\n  {\"id\":705760,\"suggestedTranslation\":\"Không đủ năng lượng rồi.\",\"rating\":0.0},\n  {\"id\":705761,\"suggestedTranslation\":\"Con này quá nhỏ rồi.\",\"rating\":0.0},\n  {\"id\":705762,\"suggestedTranslation\":\"Không. Không đủ lớn.\",\"rating\":0.0},\n  {\"id\":705763,\"suggestedTranslation\":\"Tôi cần một số nguyên liệu!\",\"rating\":0.0},\n  {\"id\":705764,\"suggestedTranslation\":\"Cậu đang bận à? Có muốn nghe về con bọ tôi tìm thấy hôm qua không?\",\"rating\":0.0},\n  {\"id\":705765,\"suggestedTranslation\":\"Khoan đã... đây thậm chí còn không phải bản thiết kế đúng.\",\"rating\":0.0},\n  {\"id\":705766,\"suggestedTranslation\":\"Điều đó thật vô lý.\",\"rating\":0.0},\n  {\"id\":705767,\"suggestedTranslation\":\"Có lẽ tôi sẽ thử khi mặt đất ngừng rung chuyển vậy.\",\"rating\":0.0},\n  {\"id\":705768,\"suggestedTranslation\":\"Giá như tôi có vài viên kẹo dẻo... mà thôi kệ.\",\"rating\":0.0},\n  {\"id\":705769,\"suggestedTranslation\":\"Này, trong lúc cậu ở đây, có muốn nghe một câu chuyện kinh dị tôi nghe được trên đài không?\",\"rating\":0.0},\n  {\"id\":705770,\"suggestedTranslation\":\"Tay tôi không dài đến thế đâu.\",\"rating\":0.0},\n  {\"id\":705771,\"suggestedTranslation\":\"Này, có cái mũ vướng ở đường kìa!\",\"rating\":0.0},\n  {\"id\":705772,\"suggestedTranslation\":\"Cái đó có chủ rồi, Woby.\",\"rating\":0.0},\n  {\"id\":705773,\"suggestedTranslation\":\"Ồ không, nó đang tan chảy kìa! Chúng ta không thể trang trí nó nữa đâu, Woby.\",\"rating\":0.0},\n  {\"id\":705774,\"suggestedTranslation\":\"Tôi không thể xây nó cao hơn thế nữa đâu, Woby!\",\"rating\":0.0},\n  {\"id\":705775,\"suggestedTranslation\":\"Hây da, nó khô khốc rồi. Để lát nữa thử lại vậy!\",\"rating\":0.0},\n  {\"id\":705776,\"suggestedTranslation\":\"Chắc chúng ta nên chọn chỗ khác thôi, Woby.\",\"rating\":0.0},\n  {\"id\":705777,\"suggestedTranslation\":\"Việc đó có vẻ hơi nguy hiểm đấy.\",\"rating\":0.0},\n  {\"id\":705778,\"suggestedTranslation\":\"Chắc tôi phải đợi thôi.\",\"rating\":0.0},\n  {\"id\":705779,\"suggestedTranslation\":\"Tôi nên chắc chắn là nó trống trước đã.\",\"rating\":0.0},\n  {\"id\":705780,\"suggestedTranslation\":\"Đừng bỏ cuộc, Walter!\",\"rating\":0.0},\n  {\"id\":705781,\"suggestedTranslation\":\"Khoan đã... Woby, cậu có nhớ trông nó thế nào không?\",\"rating\":0.0},\n  {\"id\":705782,\"suggestedTranslation\":\"Trừ khi tôi đang trồng một khu vườn toàn rong biển.\",\"rating\":0.0},\n  {\"id\":705783,\"suggestedTranslation\":\"Một Hướng đạo sinh Cây Thông biết phải dùng đúng dụng cụ. Và đây không phải thứ đó.\",\"rating\":0.0},\n  {\"id\":705784,\"suggestedTranslation\":\"Ôi không!\",\"rating\":0.0},\n  {\"id\":705785,\"suggestedTranslation\":\"Nếu nó làm cậu thấy khá hơn, dẫu sao thì hồn ma thú vị hơn nhiều.\",\"rating\":0.0},\n  {\"id\":705786,\"suggestedTranslation\":\"Tôi đoán là họ đang bận.\",\"rating\":0.0},\n  {\"id\":705787,\"suggestedTranslation\":\"Chết tiệt. Không có tác dụng.\",\"rating\":0.0},\n  {\"id\":705788,\"suggestedTranslation\":\"Chúng ta có thể đợi cho đến khi họ chơi xong. Phải không Woby?\",\"rating\":0.0},\n  {\"id\":705789,\"suggestedTranslation\":\"Chúng ta không thể chơi cho đến khi có lỗ cờ, Woby!\",\"rating\":0.0},\n  {\"id\":705790,\"suggestedTranslation\":\"Tôi có cảm giác cách đó không hiệu quả đâu...\",\"rating\":0.0},\n  {\"id\":705791,\"suggestedTranslation\":\"Ồ, à... tôi nghĩ họ đang bận. Bận chết ấy.\",\"rating\":0.0},\n  {\"id\":705792,\"suggestedTranslation\":\"Cái đó tôi biết rồi.\",\"rating\":0.0},\n  {\"id\":705793,\"suggestedTranslation\":\"Đã có sẵn một vài thứ lương thực trong đó rồi.\",\"rating\":0.0},\n  {\"id\":705794,\"suggestedTranslation\":\"Tôi không nghĩ mình nên đặt cái đó ở đây... phải không nhỉ?\",\"rating\":0.0},\n  {\"id\":705795,\"suggestedTranslation\":\"Họ có vẻ rất tận tụy với lối sống của mình. Hoặc là việc thiếu đi một lối sống?\",\"rating\":0.0},\n  {\"id\":705796,\"suggestedTranslation\":\"Một trong những khúc gỗ bị ma ám đó sẽ phát huy tác dụng đấy.\",\"rating\":0.0},\n  {\"id\":705797,\"suggestedTranslation\":\"Tôi cần đi kiếm nấm! Mau lên Woby!\",\"rating\":0.0},\n  {\"id\":705798,\"suggestedTranslation\":\"Tôi không nghĩ chúng sẽ mọc ở đây đâu.\",\"rating\":0.0},\n  {\"id\":705799,\"suggestedTranslation\":\"Chắc là cái đó không hoạt động đâu.\",\"rating\":0.0},\n  {\"id\":705800,\"suggestedTranslation\":\"Tôi sẽ phải đợi cho đến khi trăng mọc.\",\"rating\":0.0},\n  {\"id\":705801,\"suggestedTranslation\":\"Ừm. Xin lỗi, bạn có thể nhắc lại được không?\",\"rating\":0.0},\n  {\"id\":705802,\"suggestedTranslation\":\"Tôi sẽ phải tiếp tục tìm kiếm chiếc chìa khóa phù hợp.\",\"rating\":0.0},\n  {\"id\":705803,\"suggestedTranslation\":\"Thứ đó... trông không giống thứ mà bất kỳ ai sẽ ăn cả.\",\"rating\":0.0},\n  {\"id\":705804,\"suggestedTranslation\":\"Chắc là cái đó không hoạt động đâu.\",\"rating\":0.0},\n  {\"id\":705805,\"suggestedTranslation\":\"Tôi thậm chí còn không thèm thử chạm khắc thứ đó đâu.\",\"rating\":0.0},\n  {\"id\":705806,\"suggestedTranslation\":\"Cái đó không vừa ở đây đâu.\",\"rating\":0.0},\n  {\"id\":705807,\"suggestedTranslation\":\"Hả? Lúc này tôi đang bị phân tâm đấy.\",\"rating\":0.0},\n  {\"id\":705808,\"suggestedTranslation\":\"Không thể làm gì cho đến khi khu vực này được dọn sạch!\",\"rating\":0.0},\n  {\"id\":705809,\"suggestedTranslation\":\"Quá muộn cho việc đó rồi.\",\"rating\":0.0},\n  {\"id\":705810,\"suggestedTranslation\":\"Xin lỗi thưa ngài, tôi sẽ đợi cho đến khi ngài sẵn sàng.\",\"rating\":0.0},\n  {\"id\":705811,\"suggestedTranslation\":\"Này Woby, chúng ta có nên đánh thức họ dậy không?\",\"rating\":0.0},\n  {\"id\":705812,\"suggestedTranslation\":\"Nó được đóng gói kín rồi.\",\"rating\":0.0},\n  {\"id\":705813,\"suggestedTranslation\":\"Tôi không nghĩ điều đó sẽ thoải mái cho con nhện lắm đâu.\",\"rating\":0.0},\n  {\"id\":705814,\"suggestedTranslation\":\"Chưa có cái cây nào để dâng hiến cả!\",\"rating\":0.0},\n  {\"id\":705815,\"suggestedTranslation\":\"Tôi đoán đó là một ý tưởng ngớ ngẩn khi thử...\",\"rating\":0.0},\n  {\"id\":705816,\"suggestedTranslation\":\"Trông có vẻ không đúng lắm.\",\"rating\":0.0},\n  {\"id\":705817,\"suggestedTranslation\":\"Có phải tôi lắp ghép nhầm không nhỉ? Ước gì nó có sách hướng dẫn...\",\"rating\":0.0},\n  {\"id\":705818,\"suggestedTranslation\":\"Tôi đoán là họ đang bận.\",\"rating\":0.0},\n  {\"id\":705819,\"suggestedTranslation\":\"Ồ, à... tôi nghĩ họ đang bận. Bận chết ấy.\",\"rating\":0.0},\n  {\"id\":705820,\"suggestedTranslation\":\"Trông có vẻ bạn đã có đủ đồ dự trữ rồi.\",\"rating\":0.0},\n  {\"id\":705821,\"suggestedTranslation\":\"Này Woby, chúng ta có nên đánh thức họ dậy không?\",\"rating\":0.0},\n  {\"id\":705822,\"suggestedTranslation\":\"Tôi đoán là họ đang bận.\",\"rating\":0.0},\n  {\"id\":705823,\"suggestedTranslation\":\"Ồ, à... tôi nghĩ họ đang bận. Bận chết ấy.\",\"rating\":0.0},\n  {\"id\":705824,\"suggestedTranslation\":\"Trông có vẻ bạn đã có đủ đồ dự trữ rồi.\",\"rating\":0.0},\n  {\"id\":705825,\"suggestedTranslation\":\"Này Woby, chúng ta có nên đánh thức họ dậy không?\",\"rating\":0.0},\n  {\"id\":705826,\"suggestedTranslation\":\"Hừ. Tôi học cái đó từ lâu rồi!\",\"rating\":0.0},\n  {\"id\":705827,\"suggestedTranslation\":\"Tôi định gãi sau tai nó... nhưng tôi không nghĩ nó có tai đâu.\",\"rating\":0.0},\n  {\"id\":705828,\"suggestedTranslation\":\"Không Woby, cái đó chỉ dành cho quái vật đầm lầy thôi.\",\"rating\":0.0},\n  {\"id\":705829,\"suggestedTranslation\":\"Chúng không thèm nghe tôi! Có lẽ Webber có thể nói chuyện với chúng...\",\"rating\":0.0},\n  {\"id\":705830,\"suggestedTranslation\":\"Đừng lo, con bò lai của tôi không đi đâu đâu.\",\"rating\":0.0},\n  {\"id\":705831,\"suggestedTranslation\":\"Có lẽ chúng ta nên đợi chúng bình tĩnh lại...\",\"rating\":0.0},\n  {\"id\":705832,\"suggestedTranslation\":\"Xin lỗi Woby, tôi cần một con bò lai thực sự cho việc này.\",\"rating\":0.0},\n  {\"id\":705833,\"suggestedTranslation\":\"Tôi nên gọi con bò lai của mình tới đây.\",\"rating\":0.0},\n  {\"id\":705834,\"suggestedTranslation\":\"Làm lại lần nữa, y như trong cẩm nang hướng dẫn.\",\"rating\":0.0},\n  {\"id\":705835,\"suggestedTranslation\":\"Ái, bị dây thừng cọ rát tay quá!\",\"rating\":0.0},\n  {\"id\":705836,\"suggestedTranslation\":\"Cái này khó hơn mấy hình minh họa vẽ nhiều...\",\"rating\":0.0},\n  {\"id\":705837,\"suggestedTranslation\":\"Tôi đã chọn một cái rồi mà!\",\"rating\":0.0},\n  {\"id\":705838,\"suggestedTranslation\":\"Woby và tôi sẽ chỉ đứng xem ở hiệp này thôi.\",\"rating\":0.0},\n  {\"id\":705839,\"suggestedTranslation\":\"Tôi có cái súng ná nào để độ chế đâu!\",\"rating\":0.0},\n  {\"id\":705840,\"suggestedTranslation\":\"Tôi đoán là chỗ này có người ngồi rồi.\",\"rating\":0.0},\n  {\"id\":705841,\"suggestedTranslation\":\"Xin lỗi vì đã làm phiền cậu thức giấc, nhưng cho tôi đi nhờ một đoạn được không?\",\"rating\":0.0},\n  {\"id\":705842,\"suggestedTranslation\":\"Này, bình tĩnh nào! Cho tôi lên với!\",\"rating\":0.0},\n  {\"id\":705843,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":0.0},\n  {\"id\":705844,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":0.0},\n  {\"id\":705845,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":0.0},\n  {\"id\":705846,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":0.0},\n  {\"id\":705847,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":0.0},\n  {\"id\":705848,\"suggestedTranslation\":\"Hừm... cẩm nang của tôi nói rằng tôi cần một loại cần câu khác.\",\"rating\":0.0},\n  {\"id\":705849,\"suggestedTranslation\":\"Có lẽ tôi nên để yên cho nó thì hơn.\",\"rating\":0.0},\n  {\"id\":705850,\"suggestedTranslation\":\"Cậu có thể dạy tôi vài thủ thuật ma thuật được không? Tôi học nhanh lắm đấy!\",\"rating\":0.0},\n  {\"id\":705851,\"suggestedTranslation\":\"Chúc may mắn lần sau!\",\"rating\":0.0},\n  {\"id\":705852,\"suggestedTranslation\":\"Nó kẹt mất rồi. Thôi kệ đi!\",\"rating\":0.0},\n  {\"id\":705853,\"suggestedTranslation\":\"Tôi thực sự không nên nhặt những thứ không thuộc về mình.\",\"rating\":0.0},\n  {\"id\":705854,\"suggestedTranslation\":\"Chắc tôi phải đợi thôi.\",\"rating\":0.0},\n  {\"id\":705855,\"suggestedTranslation\":\"Khoan đã... mày không phải Cà Ruột của tao!\",\"rating\":0.0},\n  {\"id\":705856,\"suggestedTranslation\":\"Của tôi là con màu cam KHÁC cơ.\",\"rating\":0.0},\n  {\"id\":705857,\"suggestedTranslation\":\"Đó không phải của tôi.\",\"rating\":0.0},\n  {\"id\":705858,\"suggestedTranslation\":\"Tôi nghĩ mình biết mọi thứ cần biết rồi.\",\"rating\":0.0},\n  {\"id\":705859,\"suggestedTranslation\":\"Tôi đã học được mọi thứ cần biết về món đó rồi.\",\"rating\":0.0},\n  {\"id\":705860,\"suggestedTranslation\":\"Đừng bỏ cuộc, Walter!\",\"rating\":0.0},\n  {\"id\":705861,\"suggestedTranslation\":\"Chà, hết sạch nước rồi.\",\"rating\":0.0},\n  {\"id\":705862,\"suggestedTranslation\":\"Tôi sẽ cần phải lấy thêm nước.\",\"rating\":0.0},\n  {\"id\":705863,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":0.0},\n  {\"id\":705864,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":0.0},\n  {\"id\":705865,\"suggestedTranslation\":\"only_used_by_wx78\",\"rating\":0.0},\n  {\"id\":705866,\"suggestedTranslation\":\"Không, thấy chưa? Mấy mảnh đó có khớp với nhau tí nào đâu!\",\"rating\":0.0},\n  {\"id\":705867,\"suggestedTranslation\":\"Tôi cần phải dùng một cái đĩa khác. Rõ ràng là thế.\",\"rating\":0.0},\n  {\"id\":705868,\"suggestedTranslation\":\"Trông nó chẳng khác gì cái đĩa cũ cả...\",\"rating\":0.0},\n  {\"id\":705869,\"suggestedTranslation\":\"Khoan, tôi làm được mà! Chỉ cần nắm bắt được nhịp điệu thôi.\",\"rating\":0.0},\n  {\"id\":705870,\"suggestedTranslation\":\"Đó chỉ là tập luyện thôi!\",\"rating\":0.0},\n  {\"id\":705871,\"suggestedTranslation\":\"Thôi nào Walter, theo nhịp điệu vào chứ, y như trong cẩm nang ấy.\",\"rating\":0.0},\n  {\"id\":705872,\"suggestedTranslation\":\"Việc đó phạm quy đấy.\",\"rating\":0.0},\n  {\"id\":705873,\"suggestedTranslation\":\"Cậu thích nghe chương trình phát thanh không? Có một chương trình kinh dị hay lắm mà tôi hay nghe hồi trước-\",\"rating\":0.0},\n  {\"id\":705874,\"suggestedTranslation\":\"Tôi không muốn làm bọn quái vật đầm lầy nổi giận với mình đâu!\",\"rating\":0.0},\n  {\"id\":705875,\"suggestedTranslation\":\"Cái đó không dành cho chúng ta đâu, Woby.\",\"rating\":0.0},\n  {\"id\":705876,\"suggestedTranslation\":\"Tôi đi kiểm tra đồ dự trữ của mình đây.\",\"rating\":0.0},\n  {\"id\":705877,\"suggestedTranslation\":\"Đó là linh hồn đấy Woby, không phải món ăn vặt đâu.\",\"rating\":0.0},\n  {\"id\":705878,\"suggestedTranslation\":\"Ôi, tôi không dùng được thứ đó rồi.\",\"rating\":0.0},\n  {\"id\":705879,\"suggestedTranslation\":\"Tôi sẽ... đợi cho đến khi cậu xong việc vậy.\",\"rating\":0.0},\n  {\"id\":705880,\"suggestedTranslation\":\"Làm thế có hơi bất lịch sự không nhỉ?\",\"rating\":0.0},\n  {\"id\":705881,\"suggestedTranslation\":\"Có lẽ nếu tôi xin xỏ tử tế...\",\"rating\":0.0},\n  {\"id\":705882,\"suggestedTranslation\":\"Nó vừa cạo sát xong. Hì, hay đấy Walter.\",\"rating\":0.0},\n  {\"id\":705883,\"suggestedTranslation\":\"Việc đó có vẻ không lịch sự cho lắm...\",\"rating\":0.0},\n  {\"id\":705884,\"suggestedTranslation\":\"Này, đi chậm lại chứ! Tôi chỉ muốn ăn thịt cậu thôi mà!\",\"rating\":0.0},\n  {\"id\":705885,\"suggestedTranslation\":\"Chắc tôi phải tìm chỗ khác thôi!\",\"rating\":0.0},\n  {\"id\":705886,\"suggestedTranslation\":\"Ồ. Tôi quên mất mấy vận động viên đua rồi!\",\"rating\":0.0},\n  {\"id\":705887,\"suggestedTranslation\":\"Tôi không thể nhét thêm gì vào trong đó nữa rồi.\",\"rating\":0.0},\n  {\"id\":705888,\"suggestedTranslation\":\"\\\"Hướng đạo sinh Cây Thông phải kiên nhẫn và lịch sự.\\\" Nhưng mà à, làm ơn nhanh lên giúp nhé?\",\"rating\":0.0},\n  {\"id\":705889,\"suggestedTranslation\":\"Việc đó phạm quy đấy.\",\"rating\":0.0},\n  {\"id\":705890,\"suggestedTranslation\":\"Cái đó không dành cho chúng ta đâu, Woby.\",\"rating\":0.0},\n  {\"id\":705891,\"suggestedTranslation\":\"Thành thật mà nói, tôi thích nấu nướng trên lửa trại hơn...\",\"rating\":0.0},\n  {\"id\":705892,\"suggestedTranslation\":\"Đó là linh hồn đấy Woby, không phải món ăn vặt đâu.\",\"rating\":0.0},\n  {\"id\":705893,\"suggestedTranslation\":\"Ôi, tôi không dùng được thứ đó rồi.\",\"rating\":0.0},\n  {\"id\":705894,\"suggestedTranslation\":\"Xin lỗi, tôi hơi mất hứng rồi.\",\"rating\":0.0},\n  {\"id\":705895,\"suggestedTranslation\":\"Hừ. Tôi biết cái đó rồi.\",\"rating\":0.0},\n  {\"id\":705896,\"suggestedTranslation\":\"Nào Walter, phải tập trung vào! Đừng để bị phân tâm!\",\"rating\":0.0},\n  {\"id\":705897,\"suggestedTranslation\":\"Ừm... mấy con khỉ đó vẽ bản đồ tệ thật đấy.\",\"rating\":0.0},\n  {\"id\":705898,\"suggestedTranslation\":\"Khoan đã... tấm bản đồ này trông sai bét nhè.\",\"rating\":0.0},\n  {\"id\":705899,\"suggestedTranslation\":\"Đây không phải là lúc thích hợp để kể chuyện kinh dị đâu...\",\"rating\":0.0},\n  {\"id\":705900,\"suggestedTranslation\":\"Tôi nên đợi cho trời tối hẳn để đạt độ đáng sợ tối đa.\",\"rating\":0.0},\n  {\"id\":705901,\"suggestedTranslation\":\"Tôi cần một ngọn lửa, nó làm tăng thêm không khí đấy!\",\"rating\":0.0},\n  {\"id\":705902,\"suggestedTranslation\":\"Không đúng rồi.\",\"rating\":0.0},\n  {\"id\":705903,\"suggestedTranslation\":\"Tôi rung nó rồi mà!\",\"rating\":0.0},\n  {\"id\":705904,\"suggestedTranslation\":\"Tôi đã có nhiều người bạn lớn lông xù nhất có thể rồi.\",\"rating\":0.0},\n  {\"id\":705905,\"suggestedTranslation\":\"Tôi không nghĩ cách đó sẽ hiệu quả đâu.\",\"rating\":0.0},\n  {\"id\":705906,\"suggestedTranslation\":\"Ôi, nó không sửa được nữa rồi.\",\"rating\":0.0},\n  {\"id\":705907,\"suggestedTranslation\":\"Đó không phải của chúng ta, Woby.\",\"rating\":0.0},\n  {\"id\":705908,\"suggestedTranslation\":\"Khoan, tôi muốn nhìn kỹ hơn con quái vật đó!\",\"rating\":0.0},\n  {\"id\":705909,\"suggestedTranslation\":\"Chắc tôi cần một chiếc chìa khóa khác.\",\"rating\":0.0},\n  {\"id\":705910,\"suggestedTranslation\":\"Tôi không nghĩ đó là thứ mình nên dùng trong hoàn cảnh này.\",\"rating\":0.0},\n  {\"id\":705911,\"suggestedTranslation\":\"Chết tiệt, tôi quên kiếm thứ để gói lại rồi.\",\"rating\":0.0},\n  {\"id\":705912,\"suggestedTranslation\":\"Có lẽ tôi không nên...\",\"rating\":0.0}\n]",
