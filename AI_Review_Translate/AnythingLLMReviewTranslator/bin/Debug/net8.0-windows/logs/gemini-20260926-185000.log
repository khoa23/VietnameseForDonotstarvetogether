anslation\":\"Nó muốn tôi cho nó một mái nhà.\",\"rating\":8.5},\n  {\"id\":704023,\"suggestedTranslation\":\"Nó muốn ở cùng với những thứ khác.\",\"rating\":8.5},\n  {\"id\":704024,\"suggestedTranslation\":\"Trông không hấp dẫn cho lắm.\",\"rating\":8.5},\n  {\"id\":704025,\"suggestedTranslation\":\"Những gì tôi làm vì danh nghĩa khoa học...\",\"rating\":8.5},\n  {\"id\":704026,\"suggestedTranslation\":\"Khoa học mới chỉ bắt đầu thôi.\",\"rating\":8.5},\n  {\"id\":704027,\"suggestedTranslation\":\"Trông ra dáng khoa học hơn hẳn rồi đấy!\",\"rating\":8.5},\n  {\"id\":704028,\"suggestedTranslation\":\"Nó đang chứa đựng nguồn năng lượng kìa! Tất nhiên là tôi biết nó dùng để làm gì từ trước rồi.\",\"rating\":8.5},\n  {\"id\":704029,\"suggestedTranslation\":\"Bộ não tôi vừa rung lên bởi sự bình yên và nỗi kinh hoàng.\",\"rating\":8.5},\n  {\"id\":704030,\"suggestedTranslation\":\"Những vết nứt ở nơi này bắt đầu lộ ra rồi.\",\"rating\":8.5},\n  {\"id\":704031,\"suggestedTranslation\":\"Không mang tính khoa học cho lắm... nhưng khá hiệu quả.\",\"rating\":8.5},\n  {\"id\":704032,\"suggestedTranslation\":\"Cái cây đang bốc cháy!\",\"rating\":8.5},\n  {\"id\":704033,\"suggestedTranslation\":\"Cái cây đã bị cháy rụi.\",\"rating\":8.5},\n  {\"id\":704034,\"suggestedTranslation\":\"Đó là một cái cây khá dày.\",\"rating\":8.5},\n  {\"id\":704035,\"suggestedTranslation\":\"Tôi không biết cây cối lại mọc được trên mặt trăng đấy.\",\"rating\":8.5},\n  {\"id\":704036,\"suggestedTranslation\":\"Nó rơi ra từ cây mặt trăng.\",\"rating\":8.5},\n  {\"id\":704037,\"suggestedTranslation\":\"Khô ráo thật đấy.\",\"rating\":8.5},\n  {\"id\":704038,\"suggestedTranslation\":\"Tôi không thực sự biết thứ đó là gì nữa.\",\"rating\":8.5},\n  {\"id\":704039,\"suggestedTranslation\":\"Mấy đứa nhỏ trông giống như những hạt electron phấn khích đang cố trốn thoát.\",\"rating\":8.5},\n  {\"id\":704040,\"suggestedTranslation\":\"Nó đặt con của mình ở đó.\",\"rating\":8.5},\n  {\"id\":704041,\"suggestedTranslation\":\"Hắn ta cũng tài năng trong chuyện nấu nướng như tôi trong khoa học vậy.\",\"rating\":8.5},\n  {\"id\":704042,\"suggestedTranslation\":\"Con sâu hút máu ghê tởm.\",\"rating\":8.5},\n  {\"id\":704043,\"suggestedTranslation\":\"Này, đó là máu của tôi phải không?\",\"rating\":8.5},\n  {\"id\":704044,\"suggestedTranslation\":\"Tôi đang ngứa tay muốn ném nó lắm rồi đây.\",\"rating\":8.5},\n  {\"id\":704045,\"suggestedTranslation\":\"Rõ ràng là thực vật rất thích thứ này.\",\"rating\":8.5},\n  {\"id\":704046,\"suggestedTranslation\":\"Đó là mốt mới nhất trong giới người cá đấy.\",\"rating\":8.5},\n  {\"id\":704047,\"suggestedTranslation\":\"Mấy con muỗi hút máu đó đừng hòng chạm vào được tôi!\",\"rating\":8.5},\n  {\"id\":704048,\"suggestedTranslation\":\"Chắc là máu của ai khác rồi...\",\"rating\":8.5},\n  {\"id\":704049,\"suggestedTranslation\":\"Ái chà! Mày tuyệt đối không phải là hạt electron đâu nhé!\",\"rating\":8.5},\n  {\"id\":704050,\"suggestedTranslation\":\"Chắc hắn ta đáng bị như vậy.\",\"rating\":8.5},\n  {\"id\":704051,\"suggestedTranslation\":\"Tôi cá là có đủ loại đồ hay ho dưới đó!\",\"rating\":8.5},\n  {\"id\":704052,\"suggestedTranslation\":\"Món punch này có pha chút cay nồng đấy.\",\"rating\":8.5},\n  {\"id\":704053,\"suggestedTranslation\":\"Cái này đúng là một điều bất khả thi về mặt khoa học.\",\"rating\":8.5},\n  {\"id\":704054,\"suggestedTranslation\":\"Tôi chắc là có lời giải thích khoa học nào đó cho chuyện này.\",\"rating\":8.5},\n  {\"id\":704055,\"suggestedTranslation\":\"Nó thật thiên tài!\",\"rating\":8.5},\n  {\"id\":704056,\"suggestedTranslation\":\"Nó có thể hung hăng, nhưng chỉ thỉnh thoảng mới phát cơn thôi.\",\"rating\":8.5},\n  {\"id\":704057,\"suggestedTranslation\":\"Đám mây hình nấm đang thành hình kìa!\",\"rating\":9.0},\n  {\"id\":704058,\"suggestedTranslation\":\"Làm cho người đội trông có vẻ rất cởi mở và vui tính.\",\"rating\":8.5},\n  {\"id\":704059,\"suggestedTranslation\":\"Thật là vô đạo đức làm sao!\",\"rating\":8.5},\n  {\"id\":704060,\"suggestedTranslation\":\"Thật mang tính khoa học làm sao!\",\"rating\":8.5},\n  {\"id\":704061,\"suggestedTranslation\":\"Sức mạnh của khoa học đã bắt buộc nó phải thế.\",\"rating\":8.5},\n  {\"id\":704062,\"suggestedTranslation\":\"Nó có thể dùng một bào tử nấm. Hoặc cấy nấm vào.\",\"rating\":9.0},\n  {\"id\":704063,\"suggestedTranslation\":\"Lũ nấm đã bám rễ rất chắc vào khúc gỗ rồi.\",\"rating\":9.0},\n  {\"id\":704064,\"suggestedTranslation\":\"Khúc gỗ đã chết rồi. Chúng ta nên thay nó bằng một khúc gỗ sống.\",\"rating\":9.0},\n  {\"id\":704065,\"suggestedTranslation\":\"Tôi không nghĩ nó có thể mọc được trong cái lạnh này đâu.\",\"rating\":8.5},\n  {\"id\":704066,\"suggestedTranslation\":\"Giờ thì nó sẽ tiếp tục lớn lên thôi.\",\"rating\":8.5},\n  {\"id\":704067,\"suggestedTranslation\":\"Nhiều nấm thật đấy!\",\"rating\":8.5},\n  {\"id\":704068,\"suggestedTranslation\":\"Cháy rụi hoàn toàn.\",\"rating\":8.5},\n  {\"id\":704069,\"suggestedTranslation\":\"Đó là một cây nấm lớn mang hơi hướng khoa học.\",\"rating\":8.5},\n  {\"id\":704070,\"suggestedTranslation\":\"Khoa học làm cho nó phát sáng đấy.\",\"rating\":8.5},\n  {\"id\":704071,\"suggestedTranslation\":\"Tôi thề là tôi không làm nó bị mốc đâu nhé.\",\"rating\":8.5},\n  {\"id\":704072,\"suggestedTranslation\":\"Chúng ta có thể tạo ra một nguồn sáng tuyệt hảo bằng vài màu cơ bản.\",\"rating\":8.5},\n  {\"id\":704073,\"suggestedTranslation\":\"Màu xanh dương rõ ràng là màu mang tính khoa học nhất rồi.\",\"rating\":8.5},\n  {\"id\":704074,\"suggestedTranslation\":\"Nó bị phủ đầy axit rồi.\",\"rating\":8.5},\n  {\"id\":704075,\"suggestedTranslation\":\"Tôi thấy hơi chướng mắt với cái này đấy.\",\"rating\":8.5},\n  {\"id\":704076,\"suggestedTranslation\":\"Mấy thứ này từng mọc trong phòng tắm của tôi đấy.\",\"rating\":8.5},\n  {\"id\":704077,\"suggestedTranslation\":\"Cây nấm này rõ ràng là kỳ lạ hơn những cây khác.\",\"rating\":9.0},\n  {\"id\":704078,\"suggestedTranslation\":\"Nó bị phủ đầy axit rồi.\",\"rating\":8.5},\n  {\"id\":704079,\"suggestedTranslation\":\"Nó đang cố sinh sản đấy.\",\"rating\":8.5},\n  {\"id\":704080,\"suggestedTranslation\":\"Một cây nấm thần kỳ ư?\",\"rating\":9.0},\n  {\"id\":704081,\"suggestedTranslation\":\"Nó bị phủ đầy axit rồi.\",\"rating\":8.5},\n  {\"id\":704082,\"suggestedTranslation\":\"Nhìn từ xa thì không thấy gì, nhưng mà rất hôi đấy.\",\"rating\":8.5},\n  {\"id\":704083,\"suggestedTranslation\":\"Cây nấm đó đã lớn quá mức cần thiết rồi.\",\"rating\":9.0},\n  {\"id\":704084,\"suggestedTranslation\":\"Nó bị phủ đầy axit rồi.\",\"rating\":8.5},\n  {\"id\":704085,\"suggestedTranslation\":\"Lũ nhện nghĩ cái này rất quan trọng.\",\"rating\":8.5},\n  {\"id\":704086,\"suggestedTranslation\":\"Mọi chuyện sắp trở nên rắc rối to rồi đây...\",\"rating\":8.5},\n  {\"id\":704087,\"suggestedTranslation\":\"Tôi đoán đây là một con chim hiếm.\",\"rating\":8.5},\n  {\"id\":704088,\"suggestedTranslation\":\"Đừng để ý đến tôi, chỉ là đang ăn thịt thối thôi.\",\"rating\":8.5},\n  {\"id\":704089,\"suggestedTranslation\":\"Tôi rất nể tinh thần cống hiến đến chết của nó đấy.\",\"rating\":8.5},\n  {\"id\":704090,\"suggestedTranslation\":\"Nó đang bị vướng một chút bụi trong mắt kìa.\",\"rating\":8.5},\n  {\"id\":704091,\"suggestedTranslation\":\"Giờ thì tôi có thể thở phào nhẹ nhõm rồi.\",\"rating\":8.5},\n  {\"id\":704092,\"suggestedTranslation\":\"Khoa học phù hộ chúng ta!\",\"rating\":8.5},\n  {\"id\":704093,\"suggestedTranslation\":\"Tôi đang có một khao khát chạy trốn cực kỳ mạnh mẽ.\",\"rating\":8.5},\n  {\"id\":704094,\"suggestedTranslation\":\"Đôi mắt bạn mới to và sáng làm sao!\",\"rating\":8.5},\n  {\"id\":704095,\"suggestedTranslation\":\"Thế là hết phim nhé.\",\"rating\":8.5},\n  {\"id\":704096,\"suggestedTranslation\":\"Thứ đó thật đáng sợ!\",\"rating\":8.5},\n  {\"id\":704097,\"suggestedTranslation\":\"Ơn trời. Nó đang ngủ rồi.\",\"rating\":8.5},\n  {\"id\":704098,\"suggestedTranslation\":\"À, tôi... vừa ăn xong! Sao bạn không đưa nó cho một trong những người bạn nhện của mình nhỉ?\",\"rating\":9.0},\n  {\"id\":704099,\"suggestedTranslation\":\"À, tôi... vừa ăn xong! Sao bạn không đưa nó cho một trong những người bạn nhện của mình nhỉ?\",\"rating\":9.0},\n  {\"id\":704100,\"suggestedTranslation\":\"Ồ chà, trông nó có vẻ... ngon đấy, Webber!\",\"rating\":8.5},\n  {\"id\":704101,\"suggestedTranslation\":\"Ồ chà, trông nó có vẻ... ngon đấy, Webber!\",\"rating\":8.5},\n  {\"id\":704102,\"suggestedTranslation\":\"À, tôi... vừa ăn xong! Sao bạn không đưa nó cho một trong những người bạn nhện của mình nhỉ?\",\"rating\":9.0},\n  {\"id\":704103,\"suggestedTranslation\":\"Ồ chà, trông nó có vẻ... ngon đấy, Webber!\",\"rating\":8.5},\n  {\"id\":704104,\"suggestedTranslation\":\"Ồ chà, trông nó có vẻ... ngon đấy, Webber!\",\"rating\":8.5},\n  {\"id\":704105,\"suggestedTranslation\":\"Bạn sẽ chẳng bao giờ phải hối hận khi chọn hoa hoét đâu.\",\"rating\":8.5},\n  {\"id\":704106,\"suggestedTranslation\":\"Nhà khoa học này sẽ không còn đầu bù tóc rối khi ngủ nữa!\",\"rating\":8.5},\n  {\"id\":704107,\"suggestedTranslation\":\"Nó tỏa ra một thứ ánh sáng ma quái.\",\"rating\":8.5},\n  {\"id\":704108,\"suggestedTranslation\":\"Thứ này thật điên rồ!\",\"rating\":8.5},\n  {\"id\":704109,\"suggestedTranslation\":\"Mấy viên tinh thể đó có lẽ là nguyên nhân gây ra vài mối lo ngại đấy.\",\"rating\":8.5},\n  {\"id\":704110,\"suggestedTranslation\":\"Tự hỏi chức năng của thứ này là gì nhỉ.\",\"rating\":8.5},\n  {\"id\":704111,\"suggestedTranslation\":\"Trông có vẻ hơi đáng sợ.\",\"rating\":8.5},\n  {\"id\":704112,\"suggestedTranslation\":\"Mọi thứ đều ổn.\",\"rating\":8.5}\n]",
