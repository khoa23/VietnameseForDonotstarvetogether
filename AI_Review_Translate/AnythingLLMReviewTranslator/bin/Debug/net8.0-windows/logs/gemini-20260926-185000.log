nslation\":\"Trông mụ ta giống như đại gia chuối ở vùng này vậy.\",\"rating\":9.0},\n  {\"id\":703967,\"suggestedTranslation\":\"Không biết chúng có ăn được không nhỉ? Chắc phải làm thí nghiệm xem sao.\",\"rating\":8.5},\n  {\"id\":703968,\"suggestedTranslation\":\"Tôi nghĩ nó làm cho mình trông rất bảnh bao và ra dáng thuyền trưởng.\",\"rating\":8.5},\n  {\"id\":703969,\"suggestedTranslation\":\"Ít ra nó cũng giữ cho tóc tôi khỏi ướt.\",\"rating\":8.5},\n  {\"id\":703970,\"suggestedTranslation\":\"Đúng là một sự sỉ nhục đối với khoa học.\",\"rating\":8.5},\n  {\"id\":703971,\"suggestedTranslation\":\"Hợ. Tôi nghĩ mình không nên ăn thứ đó đâu.\",\"rating\":8.5},\n  {\"id\":703972,\"suggestedTranslation\":\"Món thịt khô có mùi lạ.\",\"rating\":9.0},\n  {\"id\":703973,\"suggestedTranslation\":\"Chắc phải có thứ gì khác để ăn quanh đây chứ.\",\"rating\":8.5},\n  {\"id\":703974,\"suggestedTranslation\":\"Nó vỡ tung bét hết cả rồi.\",\"rating\":8.5},\n  {\"id\":703975,\"suggestedTranslation\":\"Có một chiếc hố ở giữa để nhét thứ gì đó vào.\",\"rating\":9.0},\n  {\"id\":703976,\"suggestedTranslation\":\"Viên đá đã làm nó phát sáng theo một cách nào đó.\",\"rating\":8.5},\n  {\"id\":703977,\"suggestedTranslation\":\"Giờ thì sao nữa?\",\"rating\":8.5},\n  {\"id\":703978,\"suggestedTranslation\":\"Tôi có linh cảm rõ ràng rằng cái này không đúng rồi.\",\"rating\":8.5},\n  {\"id\":703979,\"suggestedTranslation\":\"Kiến thức khoa học uyên bác của tôi bảo rằng đó là... một con bướm mặt trăng.\",\"rating\":9.0},\n  {\"id\":703980,\"suggestedTranslation\":\"Tóm được ngươi rồi nhé.\",\"rating\":8.5},\n  {\"id\":703981,\"suggestedTranslation\":\"Giờ thì chúng ta tha hồ tung cánh bay lượn rồi.\",\"rating\":8.5},\n  {\"id\":703982,\"suggestedTranslation\":\"Một con bướm đêm biến thành cây ư? Thật là hoang đường!\",\"rating\":8.5},\n  {\"id\":703983,\"suggestedTranslation\":\"Dưới này làm gì có mặt trăng nào để mà đo đạc.\",\"rating\":8.5},\n  {\"id\":703984,\"suggestedTranslation\":\"