            "text": "[\n  {\"id\": 706339, \"suggestedTranslation\": \"Tôi rất nóng lòng muốn xem nó lớn lên thành cây gì!\", \"rating\": 9.0},\n  {\"id\": 706341, \"suggestedTranslation\": \"Có vẻ như nó không muốn mọc ở đây.\", \"rating\": 9.0},\n  {\"id\": 706342, \"suggestedTranslation\": \"Đánh hơi tìm một chỗ tốt để thực vật cây nào, Woby!\", \"rating\": 8.5},\n  {\"id\": 706343, \"suggestedTranslation\": \"Tôi cần tìm đúng chỗ để trồng cái này.\", \"rating\": 9.0},\n  {\"id\": 706344, \"suggestedTranslation\": \"Cậu có nghĩ người ngoài hành tinh đã giúp họ làm ra nó không?\", \"rating\": 9.0},\n  {\"id\": 706345, \"suggestedTranslation\": \"Trông nó có vẻ hỏng rồi.\", \"rating\": 9.0},\n  {\"id\": 706346, \"suggestedTranslation\": \"Nó làm tôi thấy buồn nữa đấy, Woby.\", \"rating\": 9.0},\n  {\"id\": 706347, \"suggestedTranslation\": \"Ồ! Trông họ thế này sao?\", \"rating\": 9.0},\n  {\"id\": 706348, \"suggestedTranslation\": \"Dấu chân! Chúng đi hướng này!\", \"rating\": 9.0},\n  {\"id\": 706349, \"suggestedTranslation\": \"Tôi có nhiều cảm xúc lẫn lộn.\", \"rating\": 9.0},\n  {\"id\": 706350, \"suggestedTranslation\": \"Chào!\", \"rating\": 9.0},\n  {\"id\": 706351, \"suggestedTranslation\": \"Thật khó để đọc được biểu cảm của cô ấy...\", \"rating\": 9.0},\n  {\"id\": 706352, \"suggestedTranslation\": \"Chúng ta đã trở thành bạn rồi kìa.\", \"rating\": 9.0},\n  {\"id\": 706353, \"suggestedTranslation\": \"Tôi vẫn luôn muốn trông giống như hoàng tộc côn trùng!\", \"rating\": 9.0},\n  {\"id\": 706354, \"suggestedTranslation\": \"Hừm, chắc tôi có thể dùng nó làm gói quà nhỉ?\", \"rating\": 8.5},\n  {\"id\": 706355, \"suggestedTranslation\": \"Biết đâu nó thân thiện thì sao?\", \"rating\": 9.0},\n  {\"id\": 706356, \"suggestedTranslation\": \"Tôi không nghĩ nó còn hoạt động từ lâu rồi.\", \"rating\": 9.0},\n  {\"id\": 706357, \"suggestedTranslation\": \"Nó... ừm... chín quá tay rồi!\", \"rating\": 9.0},\n  {\"id\": 706358, \"suggestedTranslation\": \"Cái này có vẻ mất thời gian đấy. Trong lúc chờ đợi có muốn xem con bọ siêu ngầu tôi tìm được không?\", \"rating\": 9.0},\n  {\"id\": 706359, \"suggestedTranslation\": \"Sắp đến giờ ăn rồi!\", \"rating\": 9.0},\n  {\"id\": 706360, \"suggestedTranslation\": \"Mau đến lấy nào!\", \"rating\": 9.0},\n  {\"id\": 706361, \"suggestedTranslation\": \"Họ cũng không khác chúng ta là mấy nhỉ?\", \"rating\": 9.0},\n  {\"id\": 706362, \"suggestedTranslation\": \"Ước gì nó có kèm theo hướng dẫn...\", \"rating\": 9.0},\n  {\"id\": 706363, \"suggestedTranslation\": \"Phần kính đó trông có vẻ quen quen.\", \"rating\": 9.0},\n  {\"id\": 706364, \"suggestedTranslation\": \"Không biết họ dùng nó để làm gì nhỉ.\", \"rating\": 9.0},\n  {\"id\": 706365, \"suggestedTranslation\": \"Chà, trông họ có vẻ hạnh phúc hơn những bức tượng bên ngoài... tôi nghĩ thế.\", \"rating\": 9.0},\n  {\"id\": 706366, \"suggestedTranslation\": \"Muốn giải đố không, Woby?\", \"rating\": 9.0},\n  {\"id\": 706367, \"suggestedTranslation\": \"Kì lạ thật, đây là thứ duy nhất không bật lại.\", \"rating\": 9.0},\n  {\"id\": 706368, \"suggestedTranslation\": \"Không biết cái này dùng để làm gì nhỉ?\", \"rating\": 9.0},\n  {\"id\": 706369, \"suggestedTranslation\": \"Chắc nó hơi giống một chiếc la bàn.\", \"rating\": 8.5},\n  {\"id\": 706370, \"suggestedTranslation\": \"Chắc chúng ta đã tìm thấy tất cả rồi!\", \"rating\": 9.0},\n  {\"id\": 706371, \"suggestedTranslation\": \"Chắc chắn nó phải làm được việc gì quan trọng lắm.\", \"rating\": 9.0},\n  {\"id\": 706372, \"suggestedTranslation\": \"Ước gì tôi đọc được nó.\", \"rating\": 9.0},\n  {\"id\": 706373, \"suggestedTranslation\": \"Không biết nó ghi gì nhỉ.\", \"rating\": 9.0},\n  {\"id\": 706374, \"suggestedTranslation\": \"Ước gì tôi đọc được nó.\", \"rating\": 9.0},\n  {\"id\": 706375, \"suggestedTranslation\": \"Không biết nó ghi gì nhỉ.\", \"rating\": 9.0},\n  {\"id\": 706376, \"suggestedTranslation\": \"Ước gì tôi đọc được nó.\", \"rating\": 9.0},\n  {\"id\": 706377, \"suggestedTranslation\": \"Bất kỳ tàn tích cổ đáng kính nào cũng phải có vài loại bẫy chứ.\", \"rating\": 9.0},\n  {\"id\": 706378, \"suggestedTranslation\": \"Có vẻ nó không còn hoạt động nữa rồi.\", \"rating\": 9.0},\n  {\"id\": 706379, \"suggestedTranslation\": \"Nào Woby, hãy xem nó dẫn đến đâu!\", \"rating\": 9.0},\n  {\"id\": 706380, \"suggestedTranslation\": \"Có cái gì đó đang thiếu...\", \"rating\": 9.0},\n  {\"id\": 706381, \"suggestedTranslation\": \"Tôi nghĩ những viên ngọc này rất quan trọng đấy, Woby!\", \"rating\": 9.0},\n  {\"id\": 706382, \"suggestedTranslation\": \"Tôi vẫn ước gì chúng ta có thể làm bạn...\", \"rating\": 9.0},\n  {\"id\": 706383, \"suggestedTranslation\": \"Trông giống giáp của một hiệp sĩ tà ác. Gọn gàng thật!\", \"rating\": 9.0},\n  {\"id\": 706384, \"suggestedTranslation\": \"Ngửi giống như bãi cỏ mới cắt.\", \"rating\": 9.0},\n  {\"id\": 706385, \"suggestedTranslation\": \"Liệu tôi có đi lại nổi trong đó không?\", \"rating\": 9.0},\n  {\"id\": 706386, \"suggestedTranslation\": \"Ồ! Thậm chí nó còn chẳng nặng!\", \"rating\": 9.0},\n  {\"id\": 706387, \"suggestedTranslation\": \"Yessss giáp xương đậm chất lừ!!\", \"rating\": 8.5},\n  {\"id\": 706388, \"suggestedTranslation\": \"Mùi của nó làm tôi mất cả cảm giác thèm ăn.\", \"rating\": 9.0},\n  {\"id\": 706389, \"suggestedTranslation\": \"Tôi là cậu bé ốc sên đáng sợ đây! Nửa người, nửa ốc sên!\", \"rating\": 9.0},\n  {\"id\": 706390, \"suggestedTranslation\": \"Tôi sẽ là nửa người, nửa máy móc!\", \"rating\": 9.0},\n  {\"id\": 706391, \"suggestedTranslation\": \"Cây cối khá là hữu ích.\", \"rating\": 9.0},\n  {\"id\": 706392, \"suggestedTranslation\": \"Đừng ôm nhau khi đang mặc thứ đó nhé.\", \"rating\": 9.0},\n  {\"id\": 706393, \"suggestedTranslation\": \"Áo giáp rau củ tuyệt cú mèo! Hiểu ý tôi chứ, Woby?\", \"rating\": 9.0},\n  {\"id\": 706394, \"suggestedTranslation\": \"Nó làm tôi cảm thấy an toàn như trong két sắt vậy!\", \"rating\": 8.5},\n  {\"id\": 706395, \"suggestedTranslation\": \"Ái chà. Sao tôi lại không được mặc nó cơ chứ?\", \"rating\": 9.0},\n  {\"id\": 706396, \"suggestedTranslation\": \"Khoan đã... cái này có nguy hiểm không?\", \"rating\": 9.0},\n  {\"id\": 706397, \"suggestedTranslation\": \"Trông nó suýt soát như có khuôn mặt vậy nhỉ?\", \"rating\": 9.0},\n  {\"id\": 706398, \"suggestedTranslation\": \"Giờ thì tôi đúng là một chú chiến mã thực thụ rồi!\", \"rating\": 9.0},\n  {\"id\": 706399, \"suggestedTranslation\": \"Hy vọng là nó không ghi điều gì quan trọng.\", \"rating\": 9.0},\n  {\"id\": 706400, \"suggestedTranslation\": \"Ai đó có chữ viết xấu quá.\", \"rating\": 9.0},\n  {\"id\": 706401, \"suggestedTranslation\": \"Chà... chắc là CÁI GÌ ĐÓ ở hướng đó.\", \"rating\": 9.0},\n  {\"id\": 706402, \"suggestedTranslation\": \"Hy vọng là nó không ghi điều gì quan trọng.\", \"rating\": 9.0},\n  {\"id\": 706403, \"suggestedTranslation\": \"Ai đó có chữ viết xấu quá.\", \"rating\": 9.0},\n  {\"id\": 706404, \"suggestedTranslation\": \"Chà... chắc là CÁI GÌ ĐÓ ở hướng đó.\", \"rating\": 9.0},\n  {\"id\": 706405, \"suggestedTranslation\": \"Có ai nhóm lửa trại mà không rủ tôi à?\", \"rating\": 8.5},\n  {\"id\": 706406, \"suggestedTranslation\": \"Ồ, tôi thích món đó cơ mà!\", \"rating\": 9.0},\n  {\"id\": 706407, \"suggestedTranslation\": \"Tiếc thật.\", \"rating\": 9.0},\n  {\"id\": 706408, \"suggestedTranslation\": \"Giờ thì tôi chẳng bao giờ biết nó là gì nữa...\", \"rating\": 9.0},\n  {\"id\": 706409, \"suggestedTranslation\": \"Nó không phải món tôi thích nhất.\", \"rating\": 9.0},\n  {\"id\": 706410, \"suggestedTranslation\": \"Lại măng tây nữa á? Ờ, không phải là tôi đang phàn nàn đâu...\", \"rating\": 8.5},\n  {\"id\": 706411, \"suggestedTranslation\": \"Tôi sẽ ăn hết rau của mình.\", \"rating\": 9.0},\n  {\"id\": 706412, \"suggestedTranslation\": \"Ồ... nhiều măng tây quá...\", \"rating\": 8.5},\n  {\"id\": 706413, \"suggestedTranslation\": \"Chúng ta nên thực vật chúng ở đâu đây, Woby?\", \"rating\": 8.5},\n  {\"id\": 706414, \"suggestedTranslation\": \"Chắc chúng ta phải đợi nó nạp năng lượng thôi.\", \"rating\": 9.0},\n  {\"id\": 706415, \"suggestedTranslation\": \"Chắc bây giờ tôi nên cho nó nghỉ ngơi một chút.\", \"rating\": 9.0},\n  {\"id\": 706416, \"suggestedTranslation\": \"Nó có nên phát ra âm thanh đó không nhỉ?\", \"rating\": 9.0},\n  {\"id\": 706417, \"suggestedTranslation\": \"Trông nó như đang thiếu một mảnh ghép.\", \"rating\": 9.0},\n  {\"id\": 706418, \"suggestedTranslation\": \"Nó đang hoạt động kìa!\", \"rating\": 9.0},\n  {\"id\": 706419, \"suggestedTranslation\": \"Đó chính là chìa khóa cho toàn bộ bí ẩn này!\", \"rating\": 8.5},\n  {\"id\": 706420, \"suggestedTranslation\": \"Chắc chắn phải có cách nào đó để bật nó lên chứ.\", \"rating\": 9.0},\n  {\"id\": 706421, \"suggestedTranslation\": \"Chà, chúng ta đã làm cho hệ thống đèn hoạt động rồi!\", \"rating\": 9.0},\n  {\"id\": 706422, \"suggestedTranslation\": \"Nó có ý nghĩa gì chứ?!\", \"rating\": 9.0},\n  {\"id\": 706423, \"suggestedTranslation\": \"Có vẻ như mọi chuyện không mấy suôn sẻ đối với những người ở đây.\", \"rating\": 9.0},\n  {\"id\": 706424, \"suggestedTranslation\": \"Tôi không nhận ra điều gì đang xảy ra trong bức này nữa, hình vẽ mờ hết rồi.\", \"rating\": 9.0},\n  {\"id\": 706425, \"suggestedTranslation\": \"Có... một cái bóng? Hay thứ gì đó... họ đã phóng tác nghệ thuật một chút.\", \"rating\": 8.5},\n  {\"id\": 706426, \"suggestedTranslation\": \"Ồ, trông như tất cả bọn họ bắt đầu thay đổi.\", \"rating\": 9.0},\n  {\"id\": 706427, \"suggestedTranslation\": \"Đó chắc là cảnh thành phố từ rất lâu về trước.\", \"rating\": 9.0},\n  {\"id\": 706428, \"suggestedTranslation\": \"Nếu nó có thể nói chuyện, không biết nó sẽ kể cho chúng ta nghe điều gì.\", \"rating\": 9.0},\n  {\"id\": 706429, \"suggestedTranslation\": \"Công cụ ưa thích của kẻ sát nhân dùng rìu và thợ mộc.\", \"rating\": 8.5},\n  {\"id\": 706430, \"suggestedTranslation\": \"Chào chú em nhỏ!\", \"rating\": 9.0},\n  {\"id\": 706431, \"suggestedTranslation\": \"Suỵt! Woby, chúng đang ngủ kìa!\", \"rating\": 9.0},\n  {\"id\": 706432, \"suggestedTranslation\": \"Hoàn hảo để mang theo đồ dùng! Và cả côn trùng nữa!\", \"rating\": 9.0},\n  {\"id\": 706433, \"suggestedTranslation\": \"Một bữa sáng cắm trại tuyệt vời.\", \"rating\": 9.0},\n  {\"id\": 706434, \"suggestedTranslation\": \"Woby, dừng chân lại và làm vài ván bài nào. Ồ, Walter!\", \"rating\": 9.0},\n  {\"id\": 706435, \"suggestedTranslation\": \"Giác quan theo dấu nhạy bén của tôi đang mách bảo có một tên hề ở gần đây.\", \"rating\": 9.0},\n  {\"id\": 706436, \"suggestedTranslation\": \"Tôi có vẻ hơi già cho trò này rồi.\", \"rating\": 9.0},\n  {\"id\": 706437, \"suggestedTranslation\": \"Có ai đang tổ chức tiệc à?\", \"rating\": 9.0},\n  {\"id\": 706438, \"suggestedTranslation\": \"Bây giờ thì nó chẳng khác gì một quả bong bóng bình thường.\", \"rating\": 8.5},\n  {\"id\": 706439, \"suggestedTranslation\": \"Lũ hề có những cách cư xử thật kỳ lạ và bí ẩn...\", \"rating\": 9.0},\n  {\"id\": 706440, \"suggestedTranslation\": \"Ai đó đã xả rác ở đây!\", \"rating\": 9.0},\n  {\"id\": 706441, \"suggestedTranslation\": \"Chắc là vẫn hơn việc không có áo phao cứu sinh nào...\", \"rating\": 9.0},\n  {\"id\": 706442, \"suggestedTranslation\": \"Khoan, tôi tưởng ở đây chuối mọc trên cây chứ?\", \"rating\": 9.0},\n  {\"id\": 706443, \"suggestedTranslation\": \"Măm măm, nó còn ngon hơn mấy món ở quán sữa lắc nữa!\", \"rating\": 9.0},\n  {\"id\": 706444, \"suggestedTranslation\": \"Mấy thứ đó dành cho trẻ con. Nhưng chuối rất tốt cho sức khỏe nên chắc là ổn.\", \"rating\": 9.0},\n  {\"id\": 706445, \"suggestedTranslation\": \"Bạn không bao giờ là quá thừa sự chuẩn bị khi ở ngoài vùng hoang dã.\", \"rating\": 9.0},\n  {\"id\": 706446, \"suggestedTranslation\": \"Nó làm từ cánh bướm đấy! Dễ thương ghê! Và cũng hơi đáng buồn nữa.\", \"rating\": 8.5},\n  {\"id\": 706447, \"suggestedTranslation\": \"Được hái lượm từ dưới biển!\", \"rating\": 9.0},\n  {\"id\": 706448, \"suggestedTranslation\": \"Lại thêm một minh chứng cho thấy bất cứ thứ gì cũng có thể làm bánh mì kẹp.\", \"rating\": 9.0},\n  {\"id\": 706449, \"suggestedTranslation\": \"Hả Woby? Cậu có muốn món này không?\", \"rating\": 9.0},\n  {\"id\": 706450, \"suggestedTranslation\": \"Nó... thú vị phết.\", \"rating\": 9.0},\n  {\"id\": 706451, \"suggestedTranslation\": \"Hừm, không tệ đâu!\", \"rating\": 9.0},\n  {\"id\": 706452, \"suggestedTranslation\": \"Mì Ý thì ăn với cái gì cũng ngon hết.\", \"rating\": 9.0},\n  {\"id\": 706453, \"suggestedTranslation\": \"Tôi không nghĩ chúng ta có thể phá vỡ thứ đó đâu.\", \"rating\": 9.0},\n  {\"id\": 706454, \"suggestedTranslation\": \"Biết đâu nếu may mắn, nó sẽ biến thành ma cà rồng!\", \"rating\": 9.0},\n  {\"id\": 706455, \"suggestedTranslation\": \"Lên gậy nào!\", \"rating\": 9.0},\n  {\"id\": 706456, \"suggestedTranslation\": \"Trông chúng đang ngủ kìa. Chúng ta có nên đánh thức chúng không?\", \"rating\": 9.0},\n  {\"id\": 706457, \"suggestedTranslation\": \"Nó thơm phết.\", \"rating\": 9.0},\n  {\"id\": 706458, \"suggestedTranslation\": \"Trông có vẻ như ai đó đang tò mò quá đà nhỉ? Hiểu ý tôi chứ? Vì nó là cái mũi mà?\", \"rating\": 9.0},\n  {\"id\": 706459, \"suggestedTranslation\": \"Sữa rất tốt cho bộ xương của bạn!\", \"rating\": 8.5},\n  {\"id\": 706460, \"suggestedTranslation\": \"Bây giờ thì nó chắc chắn không còn thơm nữa rồi...\", \"rating\": 9.0},\n  {\"id\": 706461, \"suggestedTranslation\": \"Nó giống như một chiếc ba lô chuyên dụng đựng các bài ca!\", \"rating\": 8.5},\n  {\"id\": 706462, \"suggestedTranslation\": \"Cái này có vẻ phức tạp hơn mấy bài ca tôi học hồi làm Hướng đạo sinh rồi.\", \"rating\": 9.0},\n  {\"id\": 706463, \"suggestedTranslation\": \"Cái này có vẻ phức tạp hơn mấy bài ca tôi học hồi làm Hướng đạo sinh rồi.\", \"rating\": 9.0},\n  {\"id\": 706464, \"suggestedTranslation\": \"Cái này có vẻ phức tạp hơn mấy bài ca tôi học hồi làm Hướng đạo sinh rồi.\", \"rating\": 9.0},\n