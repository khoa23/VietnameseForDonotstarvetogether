            "text": "[\n  {\"id\":706640,\"suggestedTranslation\":\"Oà, trông nó mạnh hơn nhiều rồi!\",\"rating\":9.0},\n  {\"id\":706641,\"suggestedTranslation\":\"Một cục xương kìa!\",\"rating\":9.0},\n  {\"id\":706642,\"suggestedTranslation\":\"No căng bụng luôn.\",\"rating\":9.0},\n  {\"id\":706643,\"suggestedTranslation\":\"Ngon tuyệt!\",\"rating\":9.0},\n  {\"id\":706644,\"suggestedTranslation\":\"Tội nghiệp cô Wickerbottom...\",\"rating\":9.0},\n  {\"id\":706645,\"suggestedTranslation\":\"Đọc to sách lên nghe cứ như đang nghe kịch truyền thanh ấy.\",\"rating\":9.0},\n  {\"id\":706646,\"suggestedTranslation\":\"Chắc không có ong thật ở trong đấy đâu nhỉ? Hì, không đâu, thế thì ngớ ngẩn lắm.\",\"rating\":9.0},\n  {\"id\":706647,\"suggestedTranslation\":\"Tôi không muốn khoe đâu... nhưng tôi có huy hiệu quan sát chim đấy.\",\"rating\":9.0},\n  {\"id\":706648,\"suggestedTranslation\":\"Wendy đã kể trước kết cục cho tôi rồi...\",\"rating\":9.0},\n  {\"id\":706649,\"suggestedTranslation\":\"Tôi không đọc được chữ trong này.\",\"rating\":9.0},\n  {\"id\":706650,\"suggestedTranslation\":\"Có rất nhiều mẹo an toàn về lửa hay ở trong này! Ứm... Willow đã đọc nó chưa nhỉ?\",\"rating\":9.0},\n  {\"id\":706651,\"suggestedTranslation\":\"Câu cá là một phần vô-cùng quan trọng trong sinh tồn nơi hoang dã. Hiểu ý tôi chứ? Vô-cùng ấy?\",\"rating\":9.0},\n  {\"id\":706652,\"suggestedTranslation\":\"Cái này sẽ giữ chân lũ quái vật trong chốc lát.\",\"rating\":9.0},\n  {\"id\":706653,\"suggestedTranslation\":\"Tôi đã có huy hiệu làm vườn rồi.\",\"rating\":9.0},\n  {\"id\":706654,\"suggestedTranslation\":\"Tôi đã có huy hiệu làm vườn rồi.\",\"rating\":9.0},\n  {\"id\":706655,\"suggestedTranslation\":\"Biết đâu tôi lại kiếm thêm được huy hiệu làm vườn nữa nhỉ?\",\"rating\":9.0},\n  {\"id\":706656,\"suggestedTranslation\":\"Nghe bí ẩn phết!\",\"rating\":9.0},\n  {\"id\":706657,\"suggestedTranslation\":\"Quyển này nghe còn bí ẩn hơn nữa.\",\"rating\":9.0},\n  {\"id\":706658,\"suggestedTranslation\":\"Ôi chao, còn chẳng thèm nhắc đến người ngoài hành tinh cơ à!\",\"rating\":9.0},\n  {\"id\":706659,\"suggestedTranslation\":\"Không biết mấy nghi thức cầu mưa viển vông trông sẽ như thế nào nhỉ?\",\"rating\":9.0},\n  {\"id\":706660,\"suggestedTranslation\":\"Nó hữu ích gần bằng cẩm nang Hướng đạo sinh Cây Thông của tôi luôn.\",\"rating\":9.0},\n  {\"id\":706661,\"suggestedTranslation\":\"Có rất nhiều thứ để học về chốn rừng rậm này đấy!\",\"rating\":9.0},\n  {\"id\":706662,\"suggestedTranslation\":\"Truyện ngủ theo ý tôi phải có nhiều quái vật hơn cơ...\",\"rating\":9.0},\n  {\"id\":706663,\"suggestedTranslation\":\"Mong là nó có tác dụng với Woby, tôi cứ lo cho con bé vào mùa hè với đống lông dày đó...\",\"rating\":9.0},\n  {\"id\":706664,\"suggestedTranslation\":\"Úi chà, cái này làm tôi nhớ đến vở kịch phát thanh mà tàu bị một con mực khổng lồ ăn thịt!\",\"rating\":9.0},\n  {\"id\":706665,\"suggestedTranslation\":\"Chắc tôi nên đưa quyển sách này cho anh Wolfgang quá.\",\"rating\":9.0},\n  {\"id\":706666,\"suggestedTranslation\":\"Đi nhặt về đi, Woby!\",\"rating\":9.0},\n  {\"id\":706667,\"suggestedTranslation\":\"Xin lỗi Woby, cục xương đó không dành cho cậu đâu.\",\"rating\":9.0},\n  {\"id\":706668,\"suggestedTranslation\":\"Woby! Cậu đang nghịch cái đó đấy à?\",\"rating\":9.0},\n  {\"id\":706669,\"suggestedTranslation\":\"Cá là tôi có thể dùng chút nhiệt để nung chảy nó dính lại như cũ.\",\"rating\":9.0},\n  {\"id\":706670,\"suggestedTranslation\":\"Woby rất thích được chải lông.\",\"rating\":9.0},\n  {\"id\":706671,\"suggestedTranslation\":\"Tôi là chuyên gia bắt côn trùng đấy.\",\"rating\":9.0},\n  {\"id\":706672,\"suggestedTranslation\":\"Đó là tảo bẹ... hoặc là một con thủy quái đang TRANG CẢM thành tảo bẹ.\",\"rating\":9.0},\n  {\"id\":706673,\"suggestedTranslation\":\"Chắc chỉ là tảo bẹ thường thôi.\",\"rating\":9.0},\n  {\"id\":706674,\"suggestedTranslation\":\"Tôi có thể trồng lại thực vật này xuống biển.\",\"rating\":9.0},\n  {\"id\":706675,\"suggestedTranslation\":\"Nó được nhồi đầy lương thực.\",\"rating\":9.0},\n  {\"id\":706676,\"suggestedTranslation\":\"Đóng gói gọn gàng thực sự là một nghệ thuật hay bị bỏ quên khi cắm trại.\",\"rating\":9.0},\n  {\"id\":706677,\"suggestedTranslation\":\"Tôi chưa từng nghe về Thỏ Người bao giờ! Phải ghi chép lại mới được.\",\"rating\":9.0},\n  {\"id\":706678,\"suggestedTranslation\":\"Chẳng Hướng đạo sinh nào nỡ từ chối món này đâu!\",\"rating\":9.0},\n  {\"id\":706679,\"suggestedTranslation\":\"Hóa ra không phải quái vật đầm lầy.\",\"rating\":9.0},\n  {\"id\":706680,\"suggestedTranslation\":\"Ngụy trang!\",\"rating\":9.0},\n  {\"id\":706681,\"suggestedTranslation\":\"Thành thật mà nói, cái này hợp lý hơn nhiều.\",\"rating\":9.0},\n  {\"id\":706682,\"suggestedTranslation\":\"Không biết tôi có bắt được nó không nhỉ.\",\"rating\":9.0},\n  {\"id\":706683,\"suggestedTranslation\":\"Tóm được rồi!\",\"rating\":9.0},\n  {\"id\":706684,\"suggestedTranslation\":\"Tôi thấy hơi tội lỗi với con bướm.\",\"rating\":9.0},\n  {\"id\":706685,\"suggestedTranslation\":\"Thiên nhiên thật tuyệt diệu phải không nào?\",\"rating\":9.0},\n  {\"id\":706686,\"suggestedTranslation\":\"Trông có vẻ là một tấm bảng hiệu tồi.\",\"rating\":9.0},\n  {\"id\":706687,\"suggestedTranslation\":\"Ngửi có vẻ ngon phết.\",\"rating\":9.0},\n  {\"id\":706688,\"suggestedTranslation\":\"Tránh xa nó ra, Woby!\",\"rating\":9.0},\n  {\"id\":706689,\"suggestedTranslation\":\"Đúng rồi! Tôi biết ngay mà!\",\"rating\":9.0},\n  {\"id\":706690,\"suggestedTranslation\":\"Món này làm đồ ăn cắm trại thì hết ý!\",\"rating\":9.0},\n  {\"id\":706691,\"suggestedTranslation\":\"Đó là một loại thực vật đầy gai.\",\"rating\":9.0},\n  {\"id\":706692,\"suggestedTranslation\":\"Cầu trời là cậu ngon miệng đấy.\",\"rating\":9.0},\n  {\"id\":706693,\"suggestedTranslation\":\"Trông thì hay ho đấy, nhưng hái được nó thì nhức cả đầu.\",\"rating\":9.0},\n  {\"id\":706694,\"suggestedTranslation\":\"Chắc tôi nên gỡ mấy cái gai ra trước đã.\",\"rating\":9.0},\n  {\"id\":706695,\"suggestedTranslation\":\"Ít nhất thì bây giờ nó đã an toàn trong két sắt để ăn.\",\"rating\":9.0},\n  {\"id\":706696,\"suggestedTranslation\":\"Đó là cá sống à? Hay là mình đi câu cá nhỉ?\",\"rating\":9.0},\n  {\"id\":706697,\"suggestedTranslation\":\"Chúng ta cần thêm nhiên liệu cho lửa!\",\"rating\":9.0},\n  {\"id\":706698,\"suggestedTranslation\":\"Có ai muốn nghe truyện ma không nào?\",\"rating\":9.0},\n  {\"id\":706699,\"suggestedTranslation\":\"Úi chà! Tôi không nghĩ để trong két sắt là an toàn đâu...\",\"rating\":9.0},\n  {\"id\":706700,\"suggestedTranslation\":\"Nó có vẻ cần thêm chút nhiên liệu đấy.\",\"rating\":9.0},\n  {\"id\":706701,\"suggestedTranslation\":\"Nhiệt độ hoàn hảo để nướng kẹo dẻo!\",\"rating\":9.0},\n  {\"id\":706702,\"suggestedTranslation\":\"Hết rồi á?\",\"rating\":9.0},\n  {\"id\":706703,\"suggestedTranslation\":\"Cậu cũng đi lạc hả?\",\"rating\":9.0},\n  {\"id\":706704,\"suggestedTranslation\":\"Này, đừng mổ chứ!\",\"rating\":9.0},\n  {\"id\":706705,\"suggestedTranslation\":\"Con chim này cần được sơ cứu gấp!\",\"rating\":9.0},\n  {\"id\":706706,\"suggestedTranslation\":\"Tôi già quá để chơi mấy thứ này rồi. Nhưng chắc tôi sẽ giúp mấy đứa nhỏ...\",\"rating\":9.0},\n  {\"id\":706707,\"suggestedTranslation\":\"Không gì bằng một cây gậy đi bộ tốt! Lần này đừng có gặm nó đấy nhé, Woby.\",\"rating\":9.0},\n  {\"id\":706708,\"suggestedTranslation\":\"Cái đó dùng cho đại bác.\",\"rating\":9.0},\n  {\"id\":706709,\"suggestedTranslation\":\"Đừng lo cô Wickerbottom, lát nữa cháu sẽ dọn sạch đống này!\",\"rating\":9.0},\n  {\"id\":706710,\"suggestedTranslation\":\"Chắc chúng ta nên thử phát xem sao. Kiểu như là để kiểm tra đại bác á.\",\"rating\":9.0},\n  {\"id\":706711,\"suggestedTranslation\":\"Chỉ mong là nó không làm Woby giật mình.\",\"rating\":9.0},\n  {\"id\":706712,\"suggestedTranslation\":\"Khoan đã... hình như nó làm bằng bìa cứng với giấy bạc!\",\"rating\":9.0},\n  {\"id\":706713,\"suggestedTranslation\":\"Tôi dựng nó lên cái vèo là xong ngay!\",\"rating\":9.0},\n  {\"id\":706714,\"suggestedTranslation\":\"Hơi ước gì chúng có cái lớn hơn một chút.\",\"rating\":9.0},\n  {\"id\":706715,\"suggestedTranslation\":\"Tôi dựng nó lên cái vèo là xong ngay!\",\"rating\":9.0},\n  {\"id\":706716,\"suggestedTranslation\":\"Gọn gàng thật! Tôi thích sưu tầm đồ đạc lắm!\",\"rating\":9.0},\n  {\"id\":706717,\"suggestedTranslation\":\"Ối chà, tôi vớ được một món siêu hiếm luôn!\",\"rating\":9.0},\n  {\"id\":706718,\"suggestedTranslation\":\"Tôi đem bổ sung vào bộ sưu tập đây!\",\"rating\":9.0},\n  {\"id\":706719,\"suggestedTranslation\":\"Sự hồi hộp này sắp làm tôi phát điên rồi!\",\"rating\":9.0},\n  {\"id\":706720,\"suggestedTranslation\":\"Sự hồi hộp này sắp làm tôi phát điên rồi!\",\"rating\":9.0},\n  {\"id\":706721,\"suggestedTranslation\":\"Sự hồi hộp này sắp làm tôi phát điên rồi!\",\"rating\":9.0},\n  {\"id\":706722,\"suggestedTranslation\":\"Cậu nghĩ nó chạy bằng ma thuật hả?\",\"rating\":9.0},\n  {\"id\":706723,\"suggestedTranslation\":\"Tôi dựng nó lên cái vèo là xong ngay!\",\"rating\":9.0},\n  {\"id\":706724,\"suggestedTranslation\":\"Tôi sẽ chăm sóc nó thật tốt!\",\"rating\":9.0},\n  {\"id\":706725,\"suggestedTranslation\":\"Tôi dựng nó lên cái vèo là xong ngay!\",\"rating\":9.0},\n  {\"id\":706726,\"suggestedTranslation\":\"Ngon... nhỉ...?\",\"rating\":9.0},\n  {\"id\":706727,\"suggestedTranslation\":\"Ôi, không phải giun thật à!\",\"rating\":9.0},\n  {\"id\":706728,\"suggestedTranslation\":\"Chắc cũng không khó hơn việc dựng lều là mấy đâu.\",\"rating\":9.0},\n  {\"id\":706729,\"suggestedTranslation\":\"Tôi rất muốn biết có cái gì ở dưới đó.\",\"rating\":9.0},\n  {\"id\":706730,\"suggestedTranslation\":\"Hình như nó muốn tôi cho một đồng xu.\",\"rating\":9.0},\n  {\"id\":706731,\"suggestedTranslation\":\"Trông có vẻ không khó lắm!\",\"rating\":9.0},\n  {\"id\":706732,\"suggestedTranslation\":\"Nhớ là không được đuổi theo quả bóng này đấy nhé, Woby!\",\"rating\":9.0},\n  {\"id\":706733,\"suggestedTranslation\":\"Bí quyết là sự kiểm soát, hiểu chưa? Không phải sức mạnh. Chỉ cần ngắm cẩn thận, tay vững và thái độ tốt!\",\"rating\":9.0},\n  {\"id\":706734,\"suggestedTranslation\":\"Tôi nóng lòng muốn chơi sân golf mini tự thiết kế của chúng ta quá đi, Woby!\",\"rating\":9.0},\n  {\"id\":706735,\"suggestedTranslation\":\"Quá dễ dàng, Woby thân mến!\",\"rating\":9.0},\n  {\"id\":706736,\"suggestedTranslation\":\"Cái này sẽ hơi khoai đây, Woby! Nhưng chúng ta làm được mà!\",\"rating\":9.0},\n  {\"id\":706737,\"suggestedTranslation\":\"Hứa là không đuổi theo bóng nhé, Woby?\",\"rating\":9.0},\n  {\"id\":706738,\"suggestedTranslation\":\"Ồ, chạm khắc khéo thế!\",\"rating\":9.0},\n  {\"id\":706739,\"suggestedTranslation\":\"Nhìn kìa, Woby! Chúng ta có một cái quạt!\",\"rating\":9.0},\n  {\"id\":706740,\"suggestedTranslation\":\"Cái đó sẽ ngăn bóng lăn ra ngoài... và cả cậu nữa đấy, Woby!\",\"rating\":9.0},\n  {\"id\":706741,\"suggestedTranslation\":\"Sủa lên khi nó hạ xuống nhé, Woby!\",\"rating\":9.0},\n  {\"id\":706742,\"suggestedTranslation\":\"Làm một vòng nào!\",\"rating\":9.0},\n  {\"id\":706743,\"suggestedTranslation\":\"Đến giờ phóng rồi! Không phải giờ ăn trưa đâu, Woby!\",\"rating\":9.0},\n  {\"id\":706744,\"suggestedTranslation\":\"Biết đâu lại là lối tắt thì sao!\",\"rating\":9.0},\n  {\"id\":706745,\"suggestedTranslation\":\"Và đây là nơi bóng sẽ chui vào, Woby!\",\"rating\":9.0},\n  {\"id\":706746,\"suggestedTranslation\":\"Nên đặt lỗ cờ ở đâu đây, Wobes?\",\"rating\":9.0},\n  {\"id\":706747,\"suggestedTranslation\":\"Giờ chúng ta chỉ cần đút xu vào thôi!\",\"rating\":9.0},\n  {\"id\":706748,\"suggestedTranslation\":\"Chưa có lỗ cờ thì chưa chơi được đâu, Woby!\",\"rating\":9.0},\n  {\"id\":706749,\"suggestedTranslation\":\"Nó có xu sẵn rồi kìa!\",\"rating\":9.0},\n  {\"id\":706750,\"suggestedTranslation\":\"Chúng ta nên bắt đầu từ đâu đây cô bé Woby?\",\"rating\":9.0},\n  {\"id\":706751,\"suggestedTranslation\":\"Vào giữa nào, làm ơn đấy!\",\"rating\":9.0},\n  {\"id\":706752,\"suggestedTranslation\":\"Tôi dựng nó lên cái vèo là xong ngay!\",\"rating\":9.0},\n  {\"id\":706753,\"suggestedTranslation\":\"Hình như nó muốn tôi cho một đồng xu.\",\"rating\":9.0},\n  {\"id\":706754,\"suggestedTranslation\":\"Không biết Woby có mang dòng máu chó chăn cừu không nhỉ...\",\"rating\":9.0},\n  {\"id\":706755,\"suggestedTranslation\":\"Tôi rất muốn biết có cái gì ở dưới đó.\",\"rating\":9.0},\n  {\"id\":706756,\"suggestedTranslation\":\"Tôi khá chắc là cái này...\",\"rating\":9.0},\n  {\"id\":706757,\"suggestedTranslation\":\"Cái này dựng lên trông có vẻ dễ.\",\"rating\":9.0},\n  {\"id\":706758,\"suggestedTranslation\":\"Hình như nó muốn tôi cho một đồng xu.\",\"rating\":9.0},\n  {\"id\":706759,\"suggestedTranslation\":\"Cá là tôi chơi món này cừ lắm đấy!\",\"rating\":9.0},\n  {\"id\":706760,\"suggestedTranslation\":\"Tôi dựng nó lên cái vèo là xong ngay!\",\"rating\":9.0},\n  {\"id\":706761,\"suggestedTranslation\":\"Hình như nó muốn tôi cho một đồng xu.\",\"rating\":9.0},\n  {\"id\":706762,\"suggestedTranslation\":\"Hồi ở nhà tôi từng thấy trò bi đá cẩm thạch này, lúc nào cũng muốn thử cả!\",\"rating\":9.0},\n  {\"id\":706763,\"suggestedTranslation\":\"Hình như nó muốn tôi cho một đồng xu.\",\"rating\":9.0},\n  {\"id\":706764,\"suggestedTranslation\":\"Tôi chỉ cần đánh trúng vào đúng lúc...\",\"rating\":9.0},\n  {\"id\":706765,\"suggestedTranslation\":\"Tôi dựng nó lên cái vèo là xong ngay!\",\"rating\":9.0},\n  {\"id\":706766,\"suggestedTranslation\":\"Hình như nó muốn tôi cho một đồng xu.\",\"rating\":9.0},\n  {\"id\":706767,\"suggestedTranslation\":\"Bấy lâu nay tập luyện súng cao su chắc sẽ có ích đây!\",\"rating\":9.0},\n  {\"id\":706768,\"suggestedTranslation\":\"Tôi rất muốn biết có cái gì ở dưới đó.\",\"rating\":9.0},\n  {\"id\":706769,\"suggestedTranslation\":\"Không biết đó là con bọ gì nhỉ?\",\"rating\":9.0},\n  {\"id\":706770,\"suggestedTranslation\":\"Tôi dựng nó lên cái vèo là xong ngay!\",\"rating\":9.0},\n  {\"id\":706771,\"suggestedTranslation\":\"Hình như nó muốn tôi cho một đồng xu.\",\"rating\":9.0},\n  {\"id\":706772,\"suggestedTranslation\":\"Cảm giác dễ đến phát nản luôn.\",\"rating\":9.0},\n  {\"id\":706773,\"suggestedTranslation\":\"Đi nhặt bóng đi Woby! Ờ... chắc để sau vậy.\",\"rating\":9.0},\n  {\"id\":706774,\"suggestedTranslation\":\"Mấy người chim tí hon! Trẻ em chim à?\",\"rating\":9.0},\n  {\"id\":706775,\"suggestedTranslation\":\"Nên chơi trò gì trước đây nhỉ? Khó quyết định thật đấy!\",\"rating\":9.0},\n  {\"id\":706776,\"suggestedTranslation\":\"Ôi chà! Người chim bằng xương bằng thịt kìa!\",\"rating\":9.0},\n  {\"id\":706777,\"suggestedTranslation\":\"Biết đâu trang trí quanh đây thì sẽ có nhiều chim tới hơn!\",\"rating\":9.0},\n  {\"id\":706778,\"suggestedTranslation\":\"Trông ổn phết, nhưng tôi nghĩ chúng ta còn làm tốt hơn nữa cơ.\",\"rating\":9.0},\n  {\"id\":706779,\"suggestedTranslation\":\"Tôi có năng khiếu trang trí thiên bẩm đấy! Hiểu ý chứ? Vì quạ có vuốt sắc mà?\",\"rating\":9.0},\n  {\"id\":706780,\"suggestedTranslation\":\"Tôi giỏi trồng cây lắm, hồi ở Hướng đạo sinh chúng tôi làm suốt mà!\",\"rating\":9.0},\n  {\"id\":706781,\"suggestedTranslation\":\"Có huy hiệu nào cho việc giành hết giải thưởng không nhỉ?\",\"rating\":9.0},\n  {\"id\":706782,\"suggestedTranslation\":\"Tôi sẽ bày cái này lên ngay đây!\",\"rating\":9.0},\n  {\"id\":706783,\"suggestedTranslation\":\"Khởi đầu tốt đấy Woby, nhưng chúng ta còn làm tốt hơn nữa!\",\"rating\":9.0},\n  {\"id\":706784,\"suggestedTranslation\":\"Chừng này chắc đổi được món quà cực kỳ giá trị luôn!\",\"rating\":9.0},\n  {\"id\":706785,\"suggestedTranslation\":\"Nên đi đổi quà luôn nhỉ? Hay là để dành đổi món nào thật xịn...\",\"rating\":9.0},\n  {\"id\":706786,\"suggestedTranslation\":\"Trông có vẻ giống món quả hạt trộn dã ngoại. Hơi giống thế.\",\"rating\":9.0},\n  {\"id\":706787,\"suggestedTranslation\":\"Không biết mấy đứa nhóc người chim đó có muốn gia nhập đội Hướng đạo sinh của tôi không...\",\"rating\":9.0},\n  {\"id\":706788,\"suggestedTranslation\":\"Tôi có thể hòa lẫn vào với đám cây cõi!\",\"rating\":9.0},\n  {\"id\":706789,\"suggestedTranslation\":\"Mặc vào thời tiết nóng thì hợp phải biết!\",\"rating\":9.0},\n  {\"id\":706790,\"suggestedTranslation\":\"Trông sắc bén đấy! Hì.\",\"rating\":9.0},\n  {\"id\":706791,\"suggestedTranslation\":\"Chắc huy hiệu mộc của tôi phải đợi rồi.\",\"rating\":9.0},\n  {\"id\":706792,\"suggestedTranslation\":\"Giờ thì tôi có thể phấn đấu lấy huy hiệu mộc rồi!\",\"rating\":9.0},\n  {\"id\":706793,\"suggestedTranslation\":\"Tội nghiệp sinh vật nhỏ bé.\",\"rating\":9.0},\n  {\"id\":706794,\"suggestedTranslation\":\"Rau củ ở đây thú vị hơn ở nhà nhiều.\",\"rating\":9.0},\n  {\"id\":706795,\"suggestedTranslation\":\"Làm ơn đừng gặm thủng một hố trong túi áo tôi nhé.\",\"rating\":9.0},\n  {\"id\":706796,\"suggestedTranslation\":\"Cà rốt thì mơ thấy gì nhỉ?\",\"rating\":9.0},\n  {\"id\":706797,\"suggestedTranslation\":\"Kiếm đâu ra một con cà ruột bóng tối bây giờ nhỉ?\",\"rating\":9.0},\n  {\"id\":706798,\"suggestedTranslation\":\"Tôi cứ hơi hụt hẫng khi nó không biến thành con chuột.\",\"rating\":9.0},\n  {\"id\":706799,\"suggestedTranslation\":\"Ừm. Là một củ cà rốt được nấu chín.\",\"rating\":9.0},\n  {\"id\":706800,\"suggestedTranslation\":\"Cứ tưởng nó mọc thêm tai với ria mép cơ... thôi kệ.\",\"rating\":9.0},\n  {\"id\":706801,\"suggestedTranslation\":\"Giờ chúng ta sẽ có nhiều cà rốt hơn. Yay.\",\"rating\":9.0},\n  {\"id\":706802,\"suggestedTranslation\":\"Ừm, đúng là hạt rồi!\",\"rating\":9.0},\n  {\"id\":706803,\"suggestedTranslation\":\"Đó không phải là lửa trại đàng hoàng!\",\"rating\":9.0},\n  {\"id\":706804,\"suggestedTranslation\":\"Ai đó đã không tuân thủ an toàn về lửa rồi.\",\"rating\":9.0},\n  {\"id\":706805,\"suggestedTranslation\":\"Chúng ta đang vẽ bản đồ vùng hoang dã đấy!\",\"rating\":9.0},\n  {\"id\":706806,\"suggestedTranslation\":\"Cậu là một con gấu mèo trông kỳ cục thật đấy.\",\"rating\":9.0},\n  {\"id\":706807,\"suggestedTranslation\":\"Không có ai ở nhà.\",\"rating\":9.0},\n  {\"id\":706808,\"suggestedTranslation\":\"Hình như có thứ gì đang sống trong đó!\",\"rating\":9.0},\n  {\"id\":706809,\"suggestedTranslation\":\"Đây mới đúng là chiếc mũ dành cho chốn hoang dã!\",\"rating\":9.0},\n  {\"id\":706810,\"suggestedTranslation\":\"Xin lỗi Woby, cái đó để cho lũ mèo con chơi cơ.\",\"rating\":9.0},\n  {\"id\":706811,\"suggestedTranslation\":\"Nào Woby, phụ một tay dịch cái này đi!\",\"rating\":9.0},\n  {\"id\":706812,\"suggestedTranslation\":\"Tôi không với tới được!\",\"rating\":9.0},\n  {\"id\":706813,\"suggestedTranslation\":\"Dừng chân ăn vặt một chút chắc cũng chẳng sao.\",\"rating\":9.0},\n  {\"id\":706814,\"suggestedTranslation\":\"Ối...\",\"rating\":9.0},\n  {\"id\":706815,\"suggestedTranslation\":\"Chà... đúng là một quả chuối nóng.\",\"rating\":9.0},\n  {\"id\":706816,\"suggestedTranslation\":\"Tôi không biết chuối lại mọc được trong hang động đấy.\",\"rating\":9.0},\n  {\"id\":706817,\"suggestedTranslation\":\"Cục đá tảng đó đang chặn lối vào rồi!\",\"rating\":9.0},\n  {\"id\":706818,\"suggestedTranslation\":\"Đông người trong đó quá... thôi tôi đợi vậy.\",\"rating\":9.0},\n  {\"id\":706819,\"suggestedTranslation\":\"Sao chúng ta không vào được nhỉ?\",\"rating\":9.0},\n  {\"id\":706820,\"suggestedTranslation\":\"Nào Woby! Vào thám thính xem sao!\",\"rating\":9.0},\n  {\"id\":706821,\"suggestedTranslation\":\"Trong đó chắc có khối đồ xịn.\",\"rating\":9.0},\n  {\"id\":706822,\"suggestedTranslation\":\"Đông người ngoài đó quá... thôi cứ đợi ở đây đã.\",\"rating\":9.0},\n  {\"id\":706823,\"suggestedTranslation\":\"Chắc chúng ta kẹt ở đây luôn rồi Woby.\",\"rating\":9.0},\n  {\"id\":706824,\"suggestedTranslation\":\"Được rồi, đi thôi!\",\"rating\":9.0},\n  {\"id\":706825,\"suggestedTranslation\":\"Có mấy loài thực vật kỳ lạ mọc dưới này nè.\",\"rating\":9.0},\n  {\"id\":706826,\"suggestedTranslation\":\"Mấy loại thực vật kỳ lạ này không sống nổi dưới này đâu.\",\"rating\":9.0},\n  {\"id\":706827,\"suggestedTranslation\":\"Ừm. Nó chết ngắc rồi.\",\"rating\":9.0},\n  {\"id\":706828,\"suggestedTranslation\":\"Cẩn thận đấy Woby! Nó xì hơi độc đấy.\",\"rating\":9.0},\n  {\"id\":706829,\"suggestedTranslation\":\"Suỵt... đừng làm nó thức giấc, Woby.\",\"rating\":9.0},\n  {\"id\":706830,\"suggestedTranslation\":\"Nó đang xả hơi kìa! Hiểu ý tôi chứ, Woby?\",\"rating\":9.0},\n  {\"id\":706831,\"suggestedTranslation\":\"Kinh quá! Tránh ra nào, cô bé Woby!\",\"rating\":9.0},\n  {\"id\":706832,\"suggestedTranslation\":\"Đứng gần quá đấy, Wobes.\",\"rating\":9.0},\n  {\"id\":706833,\"suggestedTranslation\":\"Nó chỉ đang xả hơi thôi! Hiểu ý tôi chứ, Woby?\",\"rating\":9.0},\n  {\"id\":706834,\"suggestedTranslation\":\"Tránh xa ra, Wobers!\",\"rating\":9.0},\n  {\"id\":706835,\"suggestedTranslation\":\"May mà tôi có huy hiệu leo núi đấy!\",\"rating\":9.0},\n  {\"id\":706836,\"suggestedTranslation\":\"Hơi nhão, nhưng mà ngon.\",\"rating\":9.0},\n  {\"id\":706837,\"suggestedTranslation\":\"Cậu hay bắt gặp mấy thứ này trong hố lửa lắm.\",\"rating\":9.0},\n  {\"id\":706838,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":1.0},\n  {\"id\":706839,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":1.0},\n  {\"id\":706840,\"suggestedTranslation\":\"Chúng ta nên giúp một tay mới được! Hì. Hay đấy, Walter.\",\"rating\":9.0},\n  {\"id\":706841,\"suggestedTranslation\":\"Đám chim hư đốn! Ít ra tôi nghĩ chúng là chim.\",\"rating\":9.0},\n  {\"id\":706842,\"suggestedTranslation\":\"Không biết ai sẽ đóng vai các nhân vật nhỉ?\",\"rating\":9.0},\n  {\"id\":706843,\"suggestedTranslation\":\"Xin lỗi cô! Ở đây nguy hiểm lắm, cô có cần giúp gì không?\",\"rating\":9.0},\n  {\"id\":706844,\"suggestedTranslation\":\"Chúng ta đang chuẩn bị thi tài năng à?\",\"rating\":9.0},\n  {\"id\":706845,\"suggestedTranslation\":\"Mấy thứ đó chắc còn lâu mới dậy nổi.\",\"rating\":9.0},\n  {\"id\":706846,\"suggestedTranslation\":\"Mấy thứ đó chắc còn lâu mới dậy nổi.\",\"rating\":9.0},\n  {\"id\":706847,\"suggestedTranslation\":\"Mấy thứ đó chắc còn lâu mới dậy nổi.\",\"rating\":9.0},\n  {\"id\":706848,\"suggestedTranslation\":\"Về mặt kỹ thuật thì cái này vẫn dùng làm dây neo thật được.\",\"rating\":9.0},\n  {\"id\":706849,\"suggestedTranslation\":\"Nó làm cậu hú hồn một phen phải không Woby?\",\"rating\":9.0},\n  {\"id\":706850,\"suggestedTranslation\":\"Trông y chang nó luôn!\",\"rating\":9.0},\n  {\"id\":706851,\"suggestedTranslation\":\"Suýt nữa thì chúng ta gấu-tiêu luôn! Hiểu ý chứ?\",\"rating\":9.0},\n  {\"id\":706852,\"suggestedTranslation\":\"Đừng có ghen tị chứ Woby, cậu cũng xứng đáng có tượng riêng mà!\",\"rating\":9.0},\n  {\"id\":706853,\"suggestedTranslation\":\"Ít ra tôi không bị dị ứng với ong làm bằng đá.\",\"rating\":9.0},\n  {\"id\":706854,\"suggestedTranslation\":\"Woby có vẻ không thích nó cho lắm.\",\"rating\":9.0},\n  {\"id\":706855,\"suggestedTranslation\":\"Nó sắp sống lại rồi kìa!\",\"rating\":9.0},\n  {\"id\":706856,\"suggestedTranslation\":\"Không hoành tráng bằng bộ sưu tập bọ thật, nhưng cũng gần bằng rồi!\",\"rating\":9.0},\n  {\"id\":706857,\"suggestedTranslation\":\"Tôi thường thích huy hiệu hơn cúp, nhưng cái này thì châm chước được.\",\"rating\":9.0},\n  {\"id\":706858,\"suggestedTranslation\":\"Trông không kích thích bằng tượng quái vật cho lắm nhỉ?\",\"rating\":9.0},\n  {\"id\":706859,\"suggestedTranslation\":\"Nó không phải là chú chó ngoan cho lắm.\",\"rating\":9.0},\n  {\"id\":706860,\"suggestedTranslation\":\"Tội nghiệp Woby. Con bé hình như chẳng bao giờ hợp với mấy con chó khác.\",\"rating\":9.0},\n  {\"id\":706861,\"suggestedTranslation\":\"Con thủy quái khó tính nhất mà tôi từng gặp!\",\"rating\":9.0},\n  {\"id\":706862,\"suggestedTranslation\":\"Mong là chúng ta sẽ sớm được gặp lại hắn!\",\"rating\":9.0},\n  {\"id\":706863,\"suggestedTranslation\":\"Chúng ta gặp lại hắn thật rồi!\",\"rating\":9.0},\n  {\"id\":706864,\"suggestedTranslation\":\"Tôi thích cái này đấy!\",\"rating\":9.0},\n  {\"id\":706865,\"suggestedTranslation\":\"Tôi vẫn thấy hơi áy náy với cô ta.\",\"rating\":9.0},\n  {\"id\":706866,\"suggestedTranslation\":\"Tác phẩm chạm khắc mà cứ như đang trườn bò ấy!\",\"rating\":9.0},\n  {\"id\":706867,\"suggestedTranslation\":\"Giá mà chúng ta có thể làm hòa với nhau.\",\"rating\":9.0},\n  {\"id\":706868,\"suggestedTranslation\":\"Không có gì để xem ở đây đâu, thưa bà con! Ha ha, hiểu ý tôi chứ Woby?\",\"rating\":9.0},\n  {\"id\":706869,\"suggestedTranslation\":\"Hừ. Ai lại muốn bị kẹt trong bộ vest này mãi cơ chứ?\",\"rating\":9.0},\n  {\"id\":706870,\"suggestedTranslation\":\"Trông sống động quá, cứ như tụi nó đang chằm chằm nhìn tôi vậy!\",\"rating\":9.0},\n  {\"id\":706871,\"suggestedTranslation\":\"Mới nhìn thôi mà tôi đã thấy đói rồi...\",\"rating\":9.0},\n  {\"id\":706872,\"suggestedTranslation\":\"Mấy chú nhóc đó cũng xinh đấy, nhưng không dễ thương bằng cậu đâu Woby.\",\"rating\":9.0},\n  {\"id\":706873,\"suggestedTranslation\":\"Ôi, nó làm tôi nhớ đến dịp lễ hội quá.\",\"rating\":9.0},\n  {\"id\":706874,\"suggestedTranslation\":\"Cậu lo lắng cái gì thế Woby? Chỉ là bức tượng thôi mà.\",\"rating\":9.0},\n  {\"id\":706875,\"suggestedTranslation\":\"Được rồi Woby, tôi xin rút lại lời nói lúc nãy.\",\"rating\":9.0},\n  {\"id\":706876,\"suggestedTranslation\":\"Nó giận tụi mình lắm đấy, phải không Woby?\",\"rating\":9.0},\n  {\"id\":706877,\"suggestedTranslation\":\"Trông anh ta vui vẻ quá! Lại còn đang nhảynót nữa!\",\"rating\":9.0},\n  {\"id\":706878,\"suggestedTranslation\":\"Bức tượng này đúng là... mê-cung-hồn! Hiểu ý chứ?\",\"rating\":9.0},\n  {\"id\":706879,\"suggestedTranslation\":\"Nó bảo mọi người phải cẩn-thận đấy! Hiểu ý chứ?\",\"rating\":9.0},\n  {\"id\":706880,\"suggestedTranslation\":\"Thật tiếc khi mọi chuyện lại kết thúc theo cách đó.\",\"rating\":9.0},\n  {\"id\":706881,\"suggestedTranslation\":\"Chỉ là một bức tượng thôi mà.\",\"rating\":9.0},\n  {\"id\":706882,\"suggestedTranslation\":\"Tốt thí trông không giống chất liệu để làm tượng cho lắm.\",\"rating\":9.0},\n  {\"id\":706883,\"suggestedTranslation\":\"Trông giống mấy cái tẩu giả mà bạn có thể gửi thư để đổi quà.\",\"rating\":9.0},\n  {\"id\":706884,\"suggestedTranslation\":\"Trông sống động thật đấy!\",\"rating\":9.0},\n  {\"id\":706885,\"suggestedTranslation\":\"Này, hình như nó đang chuyển động kìa!\",\"rating\":9.0},\n  {\"id\":706886,\"suggestedTranslation\":\"Tiếng sủa của cậu còn đáng sợ hơn cả vết cắn của chúng đấy, Woby!\",\"rating\":9.0},\n  {\"id\":706887,\"suggestedTranslation\":\"Chắc chắn nằm trong top năm bộ xương yêu thích của tôi.\",\"rating\":9.0},\n  {\"id\":706888,\"suggestedTranslation\":\"Ít ra phiên bản này không có mùi nấm mốc cũ.\",\"rating\":9.0},\n  {\"id\":706889,\"suggestedTranslation\":\"Đây có phải kiểu tượng điêu khắc mà mắt cứ dõi theo bạn quanh phòng không nhỉ?\",\"rating\":9.0},\n  {\"id\":706890,\"suggestedTranslation\":\"Đừng có mà tơ tưởng đến nó đấy, Woby!\",\"rating\":9.0},\n  {\"id\":706891,\"suggestedTranslation\":\"Giống như một con robot bị nhập vậy!\",\"rating\":9.0},\n  {\"id\":706892,\"suggestedTranslation\":\"Mô hình robot độc quyền của tôi đây!\",\"rating\":9.0},\n  {\"id\":706893,\"suggestedTranslation\":\"Mấy con đó chẳng đáng yêu bằng cậu tí nào đâu, Woby.\",\"rating\":9.0},\n  {\"id\":706894,\"suggestedTranslation\":\"Gớm ghiếc từ trong ra ngoài luôn!\",\"rating\":9.0},\n  {\"id\":706895,\"suggestedTranslation\":\"Đua rất vui, dù tôi chẳng được cái huy hiệu nào cho việc đó...\",\"rating\":9.0},\n  {\"id\":706896,\"suggestedTranslation\":\"Đó là quân cờ vua của một quân cờ vua!\",\"rating\":9.0},\n  {\"id\":706897,\"suggestedTranslation\":\"Tác phẩm chạm khắc trông vẫn cứ như đang trườn bò ấy!\",\"rating\":9.0},\n  {\"id\":706898,\"suggestedTranslation\":\"Ai là quái vật ngoan thế nhỉ? Chính là cậu đấy!\",\"rating\":9.0},\n  {\"id\":706899,\"suggestedTranslation\":\"Không được gặm cục xương này đâu đấy, Woby?\",\"rating\":9.0},\n  {\"id\":706900,\"suggestedTranslation\":\"Tranh thủ chợp mắt xứng đáng một chút.\",\"rating\":9.0},\n  {\"id\":706901,\"suggestedTranslation\":\"Tôi có thể dọn thêm chỗ cho vật tư rồi!\",\"rating\":9.0},\n  {\"id\":706902,\"suggestedTranslation\":\"Và tôi đã đoán chuẩn! Đó là một con quái vật hộp, Woby!\",\"rating\":9.0},\n  {\"id\":706903,\"suggestedTranslation\":\"Bạn dùng nó để dụ cá vào.\",\"rating\":9.0},\n  {\"id\":706904,\"suggestedTranslation\":\"Ai là cún ngoan nào?\",\"rating\":9.0},\n  {\"id\":706905,\"suggestedTranslation\":\"Không biết ai làm mấy bức tượng này nhỉ? Trông như thật vậy!\",\"rating\":9.0},\n  {\"id\":706906,\"suggestedTranslation\":\"Đừng lo, tôi giỏi đối phó với chó lắm!\",\"rating\":9.0},\n  {\"id\":706907,\"suggestedTranslation\":\"Woby cứ hít hà quanh bức tượng này mãi thôi.\",\"rating\":9.0},\n  {\"id\":706908,\"suggestedTranslation\":\"Chúng ta cần thêm nhiên liệu cho lửa!\",\"rating\":9.0},\n  {\"id\":706909,\"suggestedTranslation\":\"Có ai muốn nghe truyện ma không nào?\",\"rating\":9.0},\n  {\"id\":706910,\"suggestedTranslation\":\"Úi chà! Tôi không nghĩ để trong két sắt là an toàn đâu...\",\"rating\":9.0},\n  {\"id\":706911,\"suggestedTranslation\":\"Nó có vẻ cần thêm chút nhiên liệu đấy.\",\"rating\":9.0},\n  {\"id\":706912,\"suggestedTranslation\":\"Nhiệt độ hoàn hảo để... nướng kẹo dẻo lạnh à?\",\"rating\":9.0},\n  {\"id\":706913,\"suggestedTranslation\":\"Hết rồi á?\",\"rating\":9.0},\n  {\"id\":706914,\"suggestedTranslation\":\"Chúng ta cần thêm nhiên liệu cho lửa!\",\"rating\":9.0},\n  {\"id\":706915,\"suggestedTranslation\":\"Có ai muốn nghe truyện ma không nào?\",\"rating\":9.0},\n  {\"id\":706916,\"suggestedTranslation\":\"Úi chà! Tôi không nghĩ để trong két sắt là an toàn đâu...\",\"rating\":9.0},\n  {\"id\":706917,\"suggestedTranslation\":\"Tôi có thể phải cho lửa ăn thêm một chút.\",\"rating\":9.0},\n  {\"id\":706918,\"suggestedTranslation\":\"Nhiệt độ hoàn hảo để... nướng kẹo dẻo lạnh à?\",\"rating\":9.0},\n  {\"id\":706919,\"suggestedTranslation\":\"Lò lửa đã được xây sẵn rồi, tất cả những gì chúng ta cần là thêm gỗ!\",\"rating\":9.0},\n  {\"id\":706920,\"suggestedTranslation\":\"Trông tơi tả thật đấy... nhưng chắc tôi sửa được!\",\"rating\":9.0},\n  {\"id\":706921,\"suggestedTranslation\":\"Phía Đông.\",\"rating\":9.0},\n  {\"id\":706922,\"suggestedTranslation\":\"Cẩm nang Hướng đạo sinh Cây Thông dặn lúc nào cũng phải mang theo la bàn!\",\"rating\":9.0},\n  {\"id\":706923,\"suggestedTranslation\":\"Phía Bắc.\",\"rating\":9.0},\n  {\"id\":706924,\"suggestedTranslation\":\"Đông Bắc.\",\"rating\":9.0},\n  {\"id\":706925,\"suggestedTranslation\":\"Tây Bắc.\",\"rating\":9.0},\n  {\"id\":706926,\"suggestedTranslation\":\"Phía Nam.\",\"rating\":9.0},\n  {\"id\":706927,\"suggestedTranslation\":\"Đông Nam.\",\"rating\":9.0},\n  {\"id\":706928,\"suggestedTranslation\":\"Tây Nam.\",\"rating\":9.0},\n  {\"id\":706929,\"suggestedTranslation\":\"Phía Tây.\",\"rating\":9.0},\n  {\"id\":706930,\"suggestedTranslation\":\"Không có gì là phí phạm cả!\",\"rating\":9.0},\n  {\"id\":706931,\"suggestedTranslation\":\"Trông khá ổn đấy chứ!\",\"rating\":9.0},\n  {\"id\":706932,\"suggestedTranslation\":\"Tất cả chúng ta thực sự nên cẩn thận hơn với lửa!\",\"rating\":9.0},\n  {\"id\":706933,\"suggestedTranslation\":\"Hừm... trông có vẻ hơi khô quá không hả Woby?\",\"rating\":9.0},\n  {\"id\":706934,\"suggestedTranslation\":\"Ồ, thùng phân trộn thường có đủ loại côn trùng thú vị trong đó lắm!\",\"rating\":9.0},\n  {\"id\":706935,\"suggestedTranslation\":\"Cái này có vẻ hơi ẩm quá rồi.\",\"rating\":9.0},\n  {\"id\":706936,\"suggestedTranslation\":\"Ôi, ừm... thôi khỏi, tôi không đói đâu.\",\"rating\":9.0},\n  {\"id\":706937,\"suggestedTranslation\":\"Tôi rất giỏi làm theo hướng dẫn! Tôi có huy hiệu cho việc đó hẳn hoi nhé!\",\"rating\":9.0},\n  {\"id\":706938,\"suggestedTranslation\":\"Có vẻ như tôi lại có một cuốn cẩm nang mới cần ghi nhớ rồi!\",\"rating\":9.0},\n  {\"id\":706939,\"suggestedTranslation\":\"Xin lỗi bạn nhỏ nhé.\",\"rating\":9.0}\n]",
