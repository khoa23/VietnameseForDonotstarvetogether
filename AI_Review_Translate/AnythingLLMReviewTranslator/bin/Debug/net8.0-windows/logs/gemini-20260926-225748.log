\n  {\"id\": 706588, \"suggestedTranslation\": \"T-tôi khá chắc đây không phải loại độc...\", \"rating\": 9.0},\n  {\"id\": 706589, \"suggestedTranslation\": \"Có liều thì mới có ăn!\", \"rating\": 9.0},\n  {\"id\": 706590, \"suggestedTranslation\": \"Hừm... không có nấm xanh nào trong cẩm nang của tôi cả...\", \"rating\": 9.0},\n  {\"id\": 706591, \"suggestedTranslation\": \"Woby, cậu nghĩ cậu có thể đào nó lên không? Chắc là không rồi.\", \"rating\": 9.0},\n  {\"id\": 706592, \"suggestedTranslation\": \"Biết đâu nó sẽ mọc lại theo thời gian.\", \"rating\": 9.0},\n  {\"id\": 706593, \"suggestedTranslation\": \"Vài tấm ván ép.\", \"rating\": 8.5},\n  {\"id\": 706594, \"suggestedTranslation\": \"Tôi xử đẹp hắn được!\", \"rating\": 9.0},\n  {\"id\": 706595, \"suggestedTranslation\": \"Cậu to con thật đấy!\", \"rating\": 9.0},\n  {\"id\": 706596, \"suggestedTranslation\": \"Trông như bị quái vật biển tẩn cho một trận.\", \"rating\": 9.0},\n  {\"id\": 706597, \"suggestedTranslation\": \"Trông như bị quái vật biển tẩn cho một trận.\", \"rating\": 9.0},\n  {\"id\": 706598, \"suggestedTranslation\": \"Trông như bị quái vật biển tẩn cho một trận.\", \"rating\": 9.0},\n  {\"id\": 706599, \"suggestedTranslation\": \"Cẩn thận vẫn hơn.\", \"rating\": 9.0},\n  {\"id\": 706600, \"suggestedTranslation\": \"Tôi biết hái đống rong biển đó là một ý hay mà!\", \"rating\": 9.0},\n  {\"id\": 706601, \"suggestedTranslation\": \"Mong là nó không trôi đi mất.\", \"rating\": 9.0},\n  {\"id\": 706602, \"suggestedTranslation\": \"Chúng ta nên ném cái này ở đâu đây, Woby?\", \"rating\": 9.0},\n  {\"id\": 706603, \"suggestedTranslation\": \"Chúng ta không sợ một chút cạnh tranh thân thiện đâu. Phải không Woby?\", \"rating\": 9.0},\n  {\"id\": 706604, \"suggestedTranslation\": \"Phao tiêu ở mạn trái! Ờ, ý tôi là mạn phải! Để tôi kiểm tra lại cẩm nang...\", \"rating\": 9.0},\n  {\"id\": 706605, \"suggestedTranslation\": \"Phao tiêu ở mạn trái! Ờ, ý tôi là mạn phải! Để tôi kiểm tra lại cẩm nang...\", \"rating\": 9.0},\n  {\"id\": 706606, \"suggestedTranslation\": \"Tôi sẽ thả nó xuống nước trong tích tắc!\", \"rating\": 9.0},\n  {\"id\": 706607, \"suggestedTranslation\": \"Tôi sẽ thả nó xuống nước trong tích tắc!\", \"rating\": 9.0},\n  {\"id\": 706608, \"suggestedTranslation\": \"Nhìn kìa Woby! Tôi nghĩ chú ấy đang cổ vũ chúng ta đấy!\", \"rating\": 9.0},\n  {\"id\": 706609, \"suggestedTranslation\": \"Thì ra đây là nơi chúng ta bắt đầu cuộc đua.\", \"rating\": 9.0},\n  {\"id\": 706610, \"suggestedTranslation\": \"Hừm, không biết chúng ta nên bắt đầu cuộc đua ở đâu nhỉ.\", \"rating\": 9.0},\n  {\"id\": 706611, \"suggestedTranslation\": \"Thứ này sẽ giữ cho vật tư của chúng ta an toàn như trong két sắt đấy, Woby.\", \"rating\": 8.5},\n  {\"id\": 706612, \"suggestedTranslation\": \"Đây thực sự là cách họ đóng thuyền thời ngày xưa sao?\", \"rating\": 9.0},\n  {\"id\": 706613, \"suggestedTranslation\": \"Đừng lo Woby, tôi chèo thuyền giỏi lắm. Đó chỉ là biện pháp phòng ngừa thôi!\", \"rating\": 9.0},\n  {\"id\": 706614, \"suggestedTranslation\": \"Chuẩn bị trước vẫn luôn là tốt nhất!\", \"rating\": 9.0},\n  {\"id\": 706615, \"suggestedTranslation\": \"Đừng lo Woby, tôi chèo thuyền giỏi lắm. Đó chỉ là biện pháp phòng ngừa thôi!\", \"rating\": 9.0},\n  {\"id\": 706616, \"suggestedTranslation\": \"Chuẩn bị trước vẫn luôn là tốt nhất!\", \"rating\": 9.0},\n  {\"id\": 706617, \"suggestedTranslation\": \"Đừng lo Woby, tôi chèo thuyền giỏi lắm. Đó chỉ là biện pháp phòng ngừa thôi!\", \"rating\": 9.0},\n  {\"id\": 706618, \"suggestedTranslation\": \"Chuẩn bị trước vẫn luôn là tốt nhất!\", \"rating\": 9.0},\n  {\"id\": 706619, \"suggestedTranslation\": \"Tuyệt thật! Đó là răng rồng thật à?\", \"rating\": 9.0},\n  {\"id\": 706620, \"suggestedTranslation\": \"Chuẩn bị trước vẫn luôn là tốt nhất!\", \"rating\": 9.0},\n  {\"id\": 706621, \"suggestedTranslation\": \"Nó hơi giống một chiếc súng cao su khổng lồ, nếu cậu nghĩ về điều đó.\", \"rating\": 9.0},\n  {\"id\": 706622, \"suggestedTranslation\": \"Tôi sẽ nạp đạn pháo!\", \"rating\": 8.5},\n  {\"id\": 706623, \"suggestedTranslation\": \"Tôi quên đạn pháo rồi! Chắc việc này không làm tôi bị trừ điểm huy hiệu đâu nhỉ?\", \"rating\": 9.0},\n  {\"id\": 706624, \"suggestedTranslation\": \"Tôi đã có đủ mọi thứ cần thiết để chế tạo một khẩu đại bác rồi.\", \"rating\": 8.5},\n  {\"id\": 706625, \"suggestedTranslation\": \"Phải xoay sở với những gì mình có khi ở ngoài vùng hoang dã thôi!\", \"rating\": 9.0},\n  {\"id\": 706626, \"suggestedTranslation\": \"Bắt tay vào xây dựng nào, Woby!\", \"rating\": 9.0},\n  {\"id\": 706627, \"suggestedTranslation\": \"Đừng lo! Tôi có huy hiệu chèo thuyền, tôi biết phải làm gì mà!\", \"rating\": 9.0},\n  {\"id\": 706628, \"suggestedTranslation\": \"Nó chắc chắn đang kéo chúng ta về phía thứ gì đó!\", \"rating\": 9.0},\n  {\"id\": 706629, \"suggestedTranslation\": \"Ồ, tôi chưa từng thấy cục nam châm nào lớn thế này!\", \"rating\": 9.0},\n  {\"id\": 706630, \"suggestedTranslation\": \"Nó đang nhấp nháy kìa! Chắc là nó đang hoạt động phải không?\", \"rating\": 9.0},\n  {\"id\": 706631, \"suggestedTranslation\": \"Tôi không thực sự hiểu nó hoạt động thế nào, nhưng trông có vẻ hay phết!\", \"rating\": 9.0},\n  {\"id\": 706632, \"suggestedTranslation\": \"Mong là tôi nhớ đúng hướng dẫn của ông Wilson... ông ấy cứ lầm bầm suốt trong lúc giảng.\", \"rating\": 9.0},\n  {\"id\": 706633, \"suggestedTranslation\": \"Bánh lái rất quan trọng cho việc chèo thuyền đấy!\", \"rating\": 9.0},\n  {\"id\": 706634, \"suggestedTranslation\": \"Một chiếc cần điều hướng có lẽ sẽ có ích đấy.\", \"rating\": 8.5},\n  {\"id\": 706635, \"suggestedTranslation\": \"Nó gần như là một chiếc gối tốt ngang ngửa Woby vậy!\", \"rating\": 9.0},\n  {\"id\": 706636, \"suggestedTranslation\": \"Chà, ừm... tôi đoán là vẫn có những thứ tệ hơn để dùng làm gối nhỉ?\", \"rating\": 9.0},\n  {\"id\": 706637, \"suggestedTranslation\": \"Đừng lo, tôi đã kiểm tra xem có con ong nào ở trỏng không rồi.\", \"rating\": 9.0},\n  {\"id\": 706638, \"suggestedTranslation\": \"Cũng không tệ lắm đâu, có lần tôi từng làm giường bằng kim thông cơ mà.\", \"rating\": 9.0},\n  {\"id\": 706639, \"suggestedTranslation\": \"Ước gì tôi có thể dùng nó cho súng cao su của mình.\", \"rating\": 9.0}\n]",
