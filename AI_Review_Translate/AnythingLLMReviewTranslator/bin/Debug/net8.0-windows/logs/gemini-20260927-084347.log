            "text": "[\n  {\"id\": 709438, \"suggestedTranslation\": \"Có óc định hướng tốt rất quan trọng để sinh tồn!\", \"rating\": 0.0},\n  {\"id\": 709439, \"suggestedTranslation\": \"Cậu sẽ chẳng bao giờ làm Hướng đạo sinh Thông Xanh được nếu không biết tuân theo chỉ dẫn!\", \"rating\": 0.0},\n  {\"id\": 709440, \"suggestedTranslation\": \"Mình tranh thủ huấn luyện con Cà Ruột của mình thôi.\", \"rating\": 0.0},\n  {\"id\": 709441, \"suggestedTranslation\": \"Mình... phản ứng chậm quá... không dập kịp lửa rồi...\", \"rating\": 0.0},\n  {\"id\": 709442, \"suggestedTranslation\": \"Đến lúc chúng ta xong việc, con Cà Ruột của tớ sẽ sẵn sàng cho mọi thứ!\", \"rating\": 0.0},\n  {\"id\": 709443, \"suggestedTranslation\": \"Những phản xạ này có thể cứu mạng cậu chốn hoang dã đấy!\", \"rating\": 0.0},\n  {\"id\": 709444, \"suggestedTranslation\": \"Chắc mình đặt nó ở đây... không, đằng kia!\", \"rating\": 0.0},\n  {\"id\": 709445, \"suggestedTranslation\": \"Cái đó trông giống lò lửa lắm à?!\", \"rating\": 0.0},\n  {\"id\": 709446, \"suggestedTranslation\": \"Mình chưa từng làm huấn luyện viên bao giờ!\", \"rating\": 0.0},\n  {\"id\": 709447, \"suggestedTranslation\": \"Nhanh lên, nhanh lên! Huấn luyện viên hay nói thế phải không nhỉ?\", \"rating\": 0.0},\n  {\"id\": 709448, \"suggestedTranslation\": \"Cậu có nghĩ chúng ta nên đặt nó ở đằng kia không, Woby?\", \"rating\": 0.0},\n  {\"id\": 709449, \"suggestedTranslation\": \"Ôi không!!\", \"rating\": 0.0},\n  {\"id\": 709450, \"suggestedTranslation\": \"Đây là thiết bị huấn luyện vô cùng nghiêm túc đấy.\", \"rating\": 0.0},\n  {\"id\": 709451, \"suggestedTranslation\": \"Úi chà, nhìn nó nhảy kìa!\", \"rating\": 0.0},\n  {\"id\": 709452, \"suggestedTranslation\": \"Mình rất giỏi lắp ráp mọi thứ với nhau đấy!\", \"rating\": 0.0},\n  {\"id\": 709453, \"suggestedTranslation\": \"Một cuộc đua hay cần phải có sự chuẩn bị.\", \"rating\": 0.0},\n  {\"id\": 709454, \"suggestedTranslation\": \"Nên đặt nó ở đó... không, không, hay là ở đằng kia...\", \"rating\": 0.0},\n  {\"id\": 709455, \"suggestedTranslation\": \"Có kẻ phá hoại cuộc đua!\", \"rating\": 0.0},\n  {\"id\": 709456, \"suggestedTranslation\": \"Ai đến đây trước người đó thắng!\", \"rating\": 0.0},\n  {\"id\": 709457, \"suggestedTranslation\": \"Yeah!! Làm tốt lắm nhóc con!\", \"rating\": 0.0},\n  {\"id\": 709458, \"suggestedTranslation\": \"Chúng tôi sẽ quay lại phục thù, {winner}!\", \"rating\": 0.0},\n  {\"id\": 709459, \"suggestedTranslation\": \"Sẽ thế nào nếu cuộc đua cứ diễn ra mãi mãi nhỉ?\", \"rating\": 0.0},\n  {\"id\": 709460, \"suggestedTranslation\": \"Bắt đầu cuộc đua thôi!\", \"rating\": 0.0},\n  {\"id\": 709461, \"suggestedTranslation\": \"Woby, giúp tôi tìm một chỗ đẹp để dựng cái này lên nào!\", \"rating\": 0.0},\n  {\"id\": 709462, \"suggestedTranslation\": \"Sao mọi người không chịu dùng lò lửa chứ hả?!\", \"rating\": 0.0},\n  {\"id\": 709463, \"suggestedTranslation\": \"Nó chỉ cần luyện tập thêm chút nữa thôi. Rồi chúng ta sẽ thành công!\", \"rating\": 0.0},\n  {\"id\": 709464, \"suggestedTranslation\": \"Ồ, mọi công sức luyện tập của chúng ta đã được đền đáp!\", \"rating\": 0.0},\n  {\"id\": 709465, \"suggestedTranslation\": \"Mình có được huy hiệu vì có con Cà Ruột xuất sắc nhất không?\", \"rating\": 0.0},\n  {\"id\": 709466, \"suggestedTranslation\": \"Tôi chưa từng biết kỹ năng lại có thể được đo lường bằng cân nặng đấy.\", \"rating\": 0.0},\n  {\"id\": 709467, \"suggestedTranslation\": \"Hạt giống bí ẩn!\", \"rating\": 0.0},\n  {\"id\": 709468, \"suggestedTranslation\": \"Không biết chúng là gì chính là một nửa sự thú vị đấy!\", \"rating\": 0.0},\n  {\"id\": 709469, \"suggestedTranslation\": \"Đó chắc là cái dây neo đẹp nhất mà mình từng thấy.\", \"rating\": 0.0},\n  {\"id\": 709470, \"suggestedTranslation\": \"Tôi đã chuẩn bị sẵn tất cả nguyên liệu để dựng dây neo rồi.\", \"rating\": 0.0},\n  {\"id\": 709471, \"suggestedTranslation\": \"Chắc chỉ có vậy thôi.\", \"rating\": 0.0},\n  {\"id\": 709472, \"suggestedTranslation\": \"Tôi nghĩ nó muốn thứ gì đó đã bị đốt cháy.\", \"rating\": 0.0},\n  {\"id\": 709473, \"suggestedTranslation\": \"Chúng ta nên làm gì đây, Woby?\", \"rating\": 0.0},\n  {\"id\": 709474, \"suggestedTranslation\": \"Thuyền ván rồng cần một mái chèo rồng.\", \"rating\": 0.0},\n  {\"id\": 709475, \"suggestedTranslation\": \"Tôi sẽ lái chúng ta đi thẳng đến vạch đích!\", \"rating\": 0.0},\n  {\"id\": 709476, \"suggestedTranslation\": \"Lắp thêm bánh lái có lẽ là một ý hay.\", \"rating\": 0.0},\n  {\"id\": 709477, \"suggestedTranslation\": \"Tôi vẫn luôn muốn có một con ngựa bập bênh!\", \"rating\": 0.0},\n  {\"id\": 709478, \"suggestedTranslation\": \"Tôi cần tập phi nước đại!\", \"rating\": 0.0},\n  {\"id\": 709479, \"suggestedTranslation\": \"Đúng là một chú ngựa ô bí ẩn!\", \"rating\": 0.0},\n  {\"id\": 709480, \"suggestedTranslation\": \"Chúng ta phải tặng gói quà cho thần tượng trước đã!\", \"rating\": 0.0},\n  {\"id\": 709481, \"suggestedTranslation\": \"Đừng có nhìn vào miệng nó đấy, Woby!\", \"rating\": 0.0},\n  {\"id\": 709482, \"suggestedTranslation\": \"Đúng là một sức mạnh mãnh liệt!\", \"rating\": 0.0},\n  {\"id\": 709483, \"suggestedTranslation\": \"Nó hoàn hảo để cưỡi ngựa thương đấy, Woby! Hiểu ý tớ chứ?\", \"rating\": 0.0},\n  {\"id\": 709484, \"suggestedTranslation\": \"Chúng ta sẽ bêu đầu nó lên đĩa!\", \"rating\": 0.0},\n  {\"id\": 709485, \"suggestedTranslation\": \"Chà, ít ra thì lũ sâu đang tận hưởng nó.\", \"rating\": 0.0},\n  {\"id\": 709486, \"suggestedTranslation\": \"Ai đã ăn hết mấy phần ngon rồi nhỉ?\", \"rating\": 0.0},\n  {\"id\": 709487, \"suggestedTranslation\": \"Có thêm chút ánh lửa thế này thật là tuyệt!\", \"rating\": 0.0},\n  {\"id\": 709488, \"suggestedTranslation\": \"Đừng lo, Woby và tôi sẽ kiếm ít củi mồi cho nó.\", \"rating\": 0.0},\n  {\"id\": 709489, \"suggestedTranslation\": \"Tôi sẽ dựng nó xong trong chớp mắt!\", \"rating\": 0.0},\n  {\"id\": 709490, \"suggestedTranslation\": \"Có thêm chút ánh lửa thế này thật là tuyệt!\", \"rating\": 0.0},\n  {\"id\": 709491, \"suggestedTranslation\": \"Đừng lo, Woby và tôi sẽ kiếm ít củi mồi cho nó.\", \"rating\": 0.0},\n  {\"id\": 709492, \"suggestedTranslation\": \"Tôi sẽ dựng nó xong trong chớp mắt!\", \"rating\": 0.0},\n  {\"id\": 709493, \"suggestedTranslation\": \"Mọi cuộc đấu đá đều nên dùng gối để giải quyết.\", \"rating\": 0.0},\n  {\"id\": 709494, \"suggestedTranslation\": \"Không sao đâu, ai cũng đang mang đồ bảo hộ mà!\", \"rating\": 0.0},\n  {\"id\": 709495, \"suggestedTranslation\": \"Tôi sẽ dựng nó xong trong chớp mắt!\", \"rating\": 0.0},\n  {\"id\": 709496, \"suggestedTranslation\": \"Đã đến lúc ăn tráng miệng rồi!\", \"rating\": 0.0},\n  {\"id\": 709497, \"suggestedTranslation\": \"Mặt trăng có vị như thế này sao?\", \"rating\": 0.0},\n  {\"id\": 709498, \"suggestedTranslation\": \"Nó mềm dẻo rung rinh quá!\", \"rating\": 0.0},\n  {\"id\": 709499, \"suggestedTranslation\": \"Chúng không phải kẹo dẻo nướng, nhưng cũng khá ngon đấy!\", \"rating\": 0.0},\n  {\"id\": 709500, \"suggestedTranslation\": \"Thật phí phạm đống vật dụng tốt quá...\", \"rating\": 0.0},\n  {\"id\": 709501, \"suggestedTranslation\": \"Trông bức tượng thỏ này có vẻ đang đói bụng.\", \"rating\": 0.0},\n  {\"id\": 709502, \"suggestedTranslation\": \"Chúng ta nên làm gì đây, Woby?\", \"rating\": 0.0},\n  {\"id\": 709503, \"suggestedTranslation\": \"Dùng găng tay đấm người khác là bất lịch sự đấy. Cậu có thể gây chiến đấy!\", \"rating\": 0.0},\n  {\"id\": 709504, \"suggestedTranslation\": \"Cháy bùng lên như một cây diêm khổng lồ!\", \"rating\": 0.0},\n  {\"id\": 709505, \"suggestedTranslation\": \"Nó cũng làm tớ vui lắm, Woby!\", \"rating\": 0.0},\n  {\"id\": 709506, \"suggestedTranslation\": \"Thắp sáng lên nào, từ cột này sang cột khác!\", \"rating\": 0.0},\n  {\"id\": 709507, \"suggestedTranslation\": \"Trông có vẻ ai đó đã quên quy tắc an toàn phòng lửa rồi.\", \"rating\": 0.0},\n  {\"id\": 709508, \"suggestedTranslation\": \"Chúng ta nên cho nó ăn gì đây, Woby?\", \"rating\": 0.0},\n  {\"id\": 709509, \"suggestedTranslation\": \"Tớ đang phấn khích đến mức quằn quại cả lên đây!\", \"rating\": 0.0},\n  {\"id\": 709510, \"suggestedTranslation\": \"Woby, cẩn thận con sâu kìa!\", \"rating\": 0.0},\n  {\"id\": 709511, \"suggestedTranslation\": \"Đây chính là lý do tại sao học về an toàn phòng lửa lại quan trọng đến vậy!\", \"rating\": 0.0},\n  {\"id\": 709512, \"suggestedTranslation\": \"Tôi biết rất nhiều về loài chó, nhưng loài mèo thì thích gì nhỉ?\", \"rating\": 0.0},\n  {\"id\": 709513, \"suggestedTranslation\": \"Nào Woby, chúng ta cùng chế tạo thứ gì đó đi!\", \"rating\": 0.0},\n  {\"id\": 709514, \"suggestedTranslation\": \"Đúng là một điều bí ẩn!\", \"rating\": 0.0},\n  {\"id\": 709515, \"suggestedTranslation\": \"Tôi nghĩ mình đang làm rất tốt!\", \"rating\": 0.0},\n  {\"id\": 709516, \"suggestedTranslation\": \"Chắc hẳn có điều gì đang làm nó phiền lòng.\", \"rating\": 0.0},\n  {\"id\": 709517, \"suggestedTranslation\": \"Có lẽ nó sẽ vui hơn nếu không phải thui thủi một mình?\", \"rating\": 0.0},\n  {\"id\": 709518, \"suggestedTranslation\": \"Tôi nghĩ nó cần nghe vài câu chuyện để vực lại tinh thần!\", \"rating\": 0.0},\n  {\"id\": 709519, \"suggestedTranslation\": \"Chắc tôi phải đi nhổ cỏ dại thôi.\", \"rating\": 0.0},\n  {\"id\": 709520, \"suggestedTranslation\": \"Cậu có nghĩ nó cần chút nước không, Woby?\", \"rating\": 0.0},\n  {\"id\": 709521, \"suggestedTranslation\": \"Có lẽ nó cần đất tốt hơn...\", \"rating\": 0.0},\n  {\"id\": 709522, \"suggestedTranslation\": \"Tôi nghĩ chúng ta đã trồng chúng quá sát nhau rồi, Woby.\", \"rating\": 0.0},\n  {\"id\": 709523, \"suggestedTranslation\": \"Tôi không nghĩ nó thích thời tiết này đâu.\", \"rating\": 0.0},\n  {\"id\": 709524, \"suggestedTranslation\": \"Trông nó không ổn lắm...\", \"rating\": 0.0},\n  {\"id\": 709525, \"suggestedTranslation\": \"Nhanh lên, dập tắt nó trước khi bùng cháy!\", \"rating\": 0.0},\n  {\"id\": 709526, \"suggestedTranslation\": \"Ước gì mình có một chiếc đèn pin.\", \"rating\": 0.0},\n  {\"id\": 709527, \"suggestedTranslation\": \"Tôi nhớ món trứng bác của mẹ quá...\", \"rating\": 0.0},\n  {\"id\": 709528, \"suggestedTranslation\": \"Mmmm, vị như một chiếc bánh s'more nướng hoàn hảo vậy.\", \"rating\": 0.0},\n  {\"id\": 709529, \"suggestedTranslation\": \"Thôi được rồi, chúng ta có thể thử lại mà, phải không? Phải không...?\", \"rating\": 0.0},\n  {\"id\": 709530, \"suggestedTranslation\": \"Khỉ thật! Nó... hơi bị cháy giòn rồi...\", \"rating\": 0.0},\n  {\"id\": 709531, \"suggestedTranslation\": \"Hả. Tớ cứ nghĩ chúng sẽ hợp nhau chứ.\", \"rating\": 0.0},\n  {\"id\": 709532, \"suggestedTranslation\": \"Ơ, chúng ta thực sự phải rời đi sao?\", \"rating\": 0.0},\n  {\"id\": 709533, \"suggestedTranslation\": \"only_used_by_wendy\", \"rating\": 0.0},\n  {\"id\": 709534, \"suggestedTranslation\": \"Không phải tôi vừa thấy Goodfeather ở quanh đây sao? Tôi dám thề là mình thấy rồi mà...\", \"rating\": 0.0},\n  {\"id\": 709535, \"suggestedTranslation\": \"Ôi phiền phức thật! Trông có vẻ mất thời gian vô ích rồi.\", \"rating\": 0.0},\n  {\"id\": 709536, \"suggestedTranslation\": \"Hừ, mình nên quay lại sớm hơn... hoặc có lẽ là muộn hơn.\", \"rating\": 0.0},\n  {\"id\": 709537, \"suggestedTranslation\": \"Đó sẽ là một trò chơi khá ngắn, không phải là tôi bận tâm đâu...\", \"rating\": 0.0},\n  {\"id\": 709538, \"suggestedTranslation\": \"Chẳng có chỗ nào để trốn ở quanh đây cả.\", \"rating\": 0.0},\n  {\"id\": 709539, \"suggestedTranslation\": \"Tôi nghĩ hôm nay mình đã tốn đủ thời gian để lùa lũ quái vật tí hon này rồi.\", \"rating\": 0.0},\n  {\"id\": 709540, \"suggestedTranslation\": \"Tôi có thể bẻ khóa không nhỉ? Suy cho cùng, ổ khóa (locks) và đồng hồ (clocks) chỉ cách nhau một chữ cái thôi mà.\", \"rating\": 0.0},\n  {\"id\": 709541, \"suggestedTranslation\": \"Hừm. Kén chọn quá nhỉ?\", \"rating\": 0.0},\n  {\"id\": 709542, \"suggestedTranslation\": \"Đi mất rồi sao? Thời gian trôi thật nhanh khi ta đang vui vẻ.\", \"rating\": 0.0},\n  {\"id\": 709543, \"suggestedTranslation\": \"only_used_by_wurt\", \"rating\": 0.0},\n  {\"id\": 709544, \"suggestedTranslation\": \"Nó thuộc về cỗ máy tự động.\", \"rating\": 0.0},\n  {\"id\": 709545, \"suggestedTranslation\": \"Tôi không có thời gian để bận tâm với đám merm đâu.\", \"rating\": 0.0},\n  {\"id\": 709546, \"suggestedTranslation\": \"Tôi không có thời gian cho những chú gấu không biết nghe lời.\", \"rating\": 0.0},\n  {\"id\": 709547, \"suggestedTranslation\": \"Tôi không thể cứ tay không lao vào được!\", \"rating\": 0.0},\n  {\"id\": 709548, \"suggestedTranslation\": \"only_used_by_wendy\", \"rating\": 0.0},\n  {\"id\": 709549, \"suggestedTranslation\": \"Uầy. Cái đó mạnh quá mức rồi.\", \"rating\": 0.0},\n  {\"id\": 709550, \"suggestedTranslation\": \"only_used_by_wx78\", \"rating\": 0.0},\n  {\"id\": 709551, \"suggestedTranslation\": \"only_used_by_wx78\", \"rating\": 0.0},\n  {\"id\": 709552, \"suggestedTranslation\": \"Tôi cần anh nhìn cái này, thời gian vô cùng cấp bách đấy!\", \"rating\": 0.0},\n  {\"id\": 709553, \"suggestedTranslation\": \"Tôi cảm thấy bóng đêm đang tiến đến gần... Tôi cần thêm thời gian!\", \"rating\": 0.0},\n  {\"id\": 709554, \"suggestedTranslation\": \"Vui quá đi, chắc tôi phải quay lại làm phát nữa quá!\", \"rating\": 0.0},\n  {\"id\": 709555, \"suggestedTranslation\": \"Có lẽ ở một dòng thời gian khác.\", \"rating\": 0.0},\n  {\"id\": 709556, \"suggestedTranslation\": \"only_used_by_wendy\", \"rating\": 0.0},\n  {\"id\": 709557, \"suggestedTranslation\": \"Cái này mất cả thế kỷ mất.\", \"rating\": 0.0},\n  {\"id\": 709558, \"suggestedTranslation\": \"Tôi không thể chia sẻ thời gian cho thêm bất kỳ thú cưng nào nữa!\", \"rating\": 0.0},\n  {\"id\": 709559, \"suggestedTranslation\": \"Tôi mà với lấy cái đó từ trên này chắc căng cơ mất thôi.\", \"rating\": 0.0},\n  {\"id\": 709560, \"suggestedTranslation\": \"Khoan đã, chẳng phải tôi đang đi theo một con rồi sao?\", \"rating\": 0.0},\n  {\"id\": 709561, \"suggestedTranslation\": \"Thôi nào, cậu muốn mấy con sâu này mà, phải không?\", \"rating\": 0.0},\n  {\"id\": 709562, \"suggestedTranslation\": \"Tôi đang bốc cháy rồi!\", \"rating\": 0.0},\n  {\"id\": 709563, \"suggestedTranslation\": \"Có ai đó đang khắc nó rồi.\", \"rating\": 0.0},\n  {\"id\": 709564, \"suggestedTranslation\": \"only_used_by_willow\", \"rating\": 0.0},\n  {\"id\": 709565, \"suggestedTranslation\": \"only_used_by_willow\", \"rating\": 0.0},\n  {\"id\": 709566, \"suggestedTranslation\": \"only_used_by_winona\", \"rating\": 0.0},\n  {\"id\": 709567, \"suggestedTranslation\": \"only_used_by_winona\", \"rating\": 0.0},\n  {\"id\": 709568, \"suggestedTranslation\": \"only_used_by_willow\", \"rating\": 0.0},\n  {\"id\": 709569, \"suggestedTranslation\": \"only_used_by_willow\", \"rating\": 0.0},\n  {\"id\": 709570, \"suggestedTranslation\": \"only_used_by_wurt\", \"rating\": 0.0},\n  {\"id\": 709571, \"suggestedTranslation\": \"Quá rủi ro.\", \"rating\": 0.0},\n  {\"id\": 709572, \"suggestedTranslation\": \"Dòng thời gian ở đây quá bất ổn... Tôi không nên mạo hiểm.\", \"rating\": 0.0},\n  {\"id\": 709573, \"suggestedTranslation\": \"Có vẻ như tôi đã đến quá muộn...\", \"rating\": 0.0},\n  {\"id\": 709574, \"suggestedTranslation\": \"Dòng thời gian đang bị chao đảo quá nhiều.\", \"rating\": 0.0},\n  {\"id\": 709575, \"suggestedTranslation\": \"Thế là đủ quay ngược thời gian cho lúc này rồi.\", \"rating\": 0.0},\n  {\"id\": 709576, \"suggestedTranslation\": \"Cảm ơn nhưng tôi không đời nào chịu chết cháy chỉ để thay quần áo đâu!\", \"rating\": 0.0},\n  {\"id\": 709577, \"suggestedTranslation\": \"Bây giờ không phải lúc.\", \"rating\": 0.0},\n  {\"id\": 709578, \"suggestedTranslation\": \"Làm ơn làm lẹ lên trong đó giùm cái coi?\", \"rating\": 0.0},\n  {\"id\": 709579, \"suggestedTranslation\": \"Tưởng đâu mình đã bắt nhầm... chắc là ở một dòng thời gian khác.\", \"rating\": 0.0},\n  {\"id\": 709580, \"suggestedTranslation\": \"Ôi phiền phức thật, nó chưa mọc đủ tóc.\", \"rating\": 0.0},\n  {\"id\": 709581, \"suggestedTranslation\": \"Đã sạc đầy.\", \"rating\": 0.0},\n  {\"id\": 709582, \"suggestedTranslation\": \"Không đủ điện năng.\", \"rating\": 0.0},\n  {\"id\": 709583, \"suggestedTranslation\": \"Nó quá nhỏ để đo.\", \"rating\": 0.0},\n  {\"id\": 709584, \"suggestedTranslation\": \"Quá nhỏ. Chắc tôi không nên hái nó sớm thế...\", \"rating\": 0.0},\n  {\"id\": 709585, \"suggestedTranslation\": \"Tưởng mình đã đặt... à, chắc là mình làm việc đó sau rồi.\", \"rating\": 0.0},\n  {\"id\": 709586, \"suggestedTranslation\": \"Chờ đợi thật là sốt ruột!\", \"rating\": 0.0},\n  {\"id\": 709587, \"suggestedTranslation\": \"Khoan đã... đây là bản thiết kế nhầm! Thật phí thời gian quá!\", \"rating\": 0.0},\n  {\"id\": 709588, \"suggestedTranslation\": \"Chúng không khớp nhau được.\", \"rating\": 0.0},\n  {\"id\": 709589, \"suggestedTranslation\": \"Đây có lẽ không phải là thời điểm thích hợp nhất...\", \"rating\": 0.0},\n  {\"id\": 709590, \"suggestedTranslation\": \"Bây giờ không phải lúc nấu nướng.\", \"rating\": 0.0},\n  {\"id\": 709591, \"suggestedTranslation\": \"Lẽ ra tôi nên đến đây sớm hơn.\", \"rating\": 0.0},\n  {\"id\": 709592, \"suggestedTranslation\": \"Nó ở ngoài tầm với của tôi.\", \"rating\": 0.0},\n  {\"id\": 709593, \"suggestedTranslation\": \"Không được. Ai đó đã đội mũ lên đó rồi.\", \"rating\": 0.0},\n  {\"id\": 709594, \"suggestedTranslation\": \"Ai đó đang trang trí nó kìa.\", \"rating\": 0.0},\n  {\"id\": 709595, \"suggestedTranslation\": \"Thời gian của nó đã hết rồi.\", \"rating\": 0.0},\n  {\"id\": 709596, \"suggestedTranslation\": \"Không. Nó đủ cao rồi.\", \"rating\": 0.0},\n  {\"id\": 709597, \"suggestedTranslation\": \"Đúng vậy, nó đã khô. Tôi sẽ thử lại sau.\", \"rating\": 0.0},\n  {\"id\": 709598, \"suggestedTranslation\": \"Tôi phải kiên nhẫn... cứ kiên nhẫn... Mình kiên nhẫn được mà!\", \"rating\": 0.0},\n  {\"id\": 709599, \"suggestedTranslation\": \"Bạn có thể nhanh lên một chút được không?\", \"rating\": 0.0},\n  {\"id\": 709600, \"suggestedTranslation\": \"Ồ! Tôi quên kiểm tra xem bên trong còn gì không.\", \"rating\": 0.0},\n  {\"id\": 709601, \"suggestedTranslation\": \"Nó cần chút thời gian để xả dây cót.\", \"rating\": 0.0},\n  {\"id\": 709602, \"suggestedTranslation\": \"Trượt mất! Tính thời gian tệ quá...\", \"rating\": 0.0},\n  {\"id\": 709603, \"suggestedTranslation\": \"Hừm. Tôi không nhớ rõ trông nó thế nào nữa...\", \"rating\": 0.0},\n  {\"id\": 709604, \"suggestedTranslation\": \"Úi, suýt nữa là tưới nước biển cho đám cây rồi!\", \"rating\": 0.0},\n  {\"id\": 709605, \"suggestedTranslation\": \"Ha! Chẳng khác nào dùng bánh răng gạt cho bánh xe cả!\", \"rating\": 0.0},\n  {\"id\": 709606, \"suggestedTranslation\": \"Lần sau tôi sẽ chọn đúng cái.\", \"rating\": 0.0},\n  {\"id\": 709607, \"suggestedTranslation\": \"Tôi đã hy vọng dòng thời gian này sẽ khác.\", \"rating\": 0.0},\n  {\"id\": 709608, \"suggestedTranslation\": \"Làm ơn dừng việc đang làm lại đi, việc này quan trọng lắm!\", \"rating\": 0.0},\n  {\"id\": 709609, \"suggestedTranslation\": \"Nó sẽ không quay lại đâu. Có lẽ lần này thế lại hay?\", \"rating\": 0.0},\n  {\"id\": 709610, \"suggestedTranslation\": \"Tôi sẽ quay lại sau. Hoặc sớm hơn.\", \"rating\": 0.0},\n  {\"id\": 709611, \"suggestedTranslation\": \"Ôi phiền thật, tôi quên mất lỗ cờ rồi phải không nhỉ?\", \"rating\": 0.0},\n  {\"id\": 709612, \"suggestedTranslation\": \"Nó cần thứ gì đó vừa khít với cái khe nhỏ này...\", \"rating\": 0.0},\n  {\"id\": 709613, \"suggestedTranslation\": \"Có lẽ ở một dòng thời gian khác...\", \"rating\": 0.0},\n  {\"id\": 709614, \"suggestedTranslation\": \"Tôi có cảm giác deja vu... chẳng phải chúng ta đã làm cái này rồi sao? Hay là sẽ làm...\", \"rating\": 0.0},\n  {\"id\": 709615, \"suggestedTranslation\": \"Ồ may quá, có ai đó đã nấu sẵn đồ ăn từ trước rồi!\", \"rating\": 0.0},\n  {\"id\": 709616, \"suggestedTranslation\": \"Hừm, không. Cách đó không ổn đâu.\", \"rating\": 0.0},\n  {\"id\": 709617, \"suggestedTranslation\": \"Ồ. Tôi nhầm rồi, tưởng cậu là bạn của tôi chứ.\", \"rating\": 0.0},\n  {\"id\": 709618, \"suggestedTranslation\": \"Tôi đành phải kiếm một trong mấy khúc gỗ kinh khủng đó thôi...\", \"rating\": 0.0},\n  {\"id\": 709619, \"suggestedTranslation\": \"Úi, suýt nữa thì nhét cái đó vào ruộng trồng nấm rồi.\", \"rating\": 0.0},\n  {\"id\": 709620, \"suggestedTranslation\": \"Nó sẽ không mọc ở đây đâu. Tôi không phí thời gian với nó nữa.\", \"rating\": 0.0},\n  {\"id\": 709621, \"suggestedTranslation\": \"Làm ơn đi. Chẳng khác nào gắn quả lắc vào đồng hồ cả.\", \"rating\": 0.0},\n  {\"id\": 709622, \"suggestedTranslation\": \"Cái này sẽ không hoạt động được nếu tôi không nhìn thấy mặt trăng.\", \"rating\": 0.0},\n  {\"id\": 709623, \"suggestedTranslation\": \"Lạ thật, tôi cứ thề là lúc trước mình biết nói tiếng khỉ cơ.\", \"rating\": 0.0},\n  {\"id\": 709624, \"suggestedTranslation\": \"Tôi cần thứ gì đó vừa khít, nếu không cơ chế sẽ không hoạt động.\", \"rating\": 0.0},\n  {\"id\": 709625, \"suggestedTranslation\": \"Chà... thế là mất toi thời gian.\", \"rating\": 0.0},\n  {\"id\": 709626, \"suggestedTranslation\": \"Làm ơn đi. Chẳng khác nào gắn quả lắc vào đồng hồ cả.\", \"rating\": 0.0},\n  {\"id\": 709627, \"suggestedTranslation\": \"Tôi không phí thêm một giây nào để cố làm việc với vật liệu này nữa đâu.\", \"rating\": 0.0},\n  {\"id\": 709628, \"suggestedTranslation\": \"Tôi cần thứ gì đó vừa khít thì cơ chế mới hoạt động được.\", \"rating\": 0.0},\n  {\"id\": 709629, \"suggestedTranslation\": \"Tôi không đem tính mạng ra đùa giỡn vì một trò chơi đâu!\", \"rating\": 0.0},\n  {\"id\": 709630, \"suggestedTranslation\": \"Nó hơi gợi cho tôi nhớ về xưởng cũ của mình... một bãi rác.\", \"rating\": 0.0},\n  {\"id\": 709631, \"suggestedTranslation\": \"Trời tối rồi. Chắc để dịp khác vậy.\", \"rating\": 0.0},\n  {\"id\": 709632, \"suggestedTranslation\": \"Cô ta có chức tước gì đi nữa thì cũng không phải lý do bắt tôi phải đợi!\", \"rating\": 0.0},\n  {\"id\": 709633, \"suggestedTranslation\": \"Úi chao cậu không ngủ nhanh hơn được chút à?\", \"rating\": 0.0},\n  {\"id\": 709634, \"suggestedTranslation\": \"Tôi không thể nhét thêm gì vào đó nữa rồi.\", \"rating\": 0.0},\n  {\"id\": 709635, \"suggestedTranslation\": \"Dù nghe có vẻ kỳ quặc, nhưng túi của tôi hết chỗ rồi.\", \"rating\": 0.0},\n  {\"id\": 709636, \"suggestedTranslation\": \"Vẫn chưa xong á? Phiền phức thật, mấy cái cây cỏ tí hon mà cũng mất cả đời để lớn!\", \"rating\": 0.0},\n  {\"id\": 709637, \"suggestedTranslation\": \"Tự hỏi phép thuật từ thế giới này sẽ ảnh hưởng thế nào đến nó nhỉ?\", \"rating\": 0.0},\n  {\"id\": 709638, \"suggestedTranslation\": \"Tôi dám chắc đây là viên ngọc đúng mà.\", \"rating\": 0.0},\n  {\"id\": 709639, \"suggestedTranslation\": \"Ồ, đây mới là một câu đố thú vị...\", \"rating\": 0.0},\n  {\"id\": 709640, \"suggestedTranslation\": \"Tôi không có thời gian đứng chờ đâu!\", \"rating\": 0.0},\n  {\"id\": 709641, \"suggestedTranslation\": \"Không, không, tôi làm thế này là sai trình tự rồi!\", \"rating\": 0.0},\n  {\"id\": 709642, \"suggestedTranslation\": \"Nếu cậu muốn cái này, tốt hơn là nên vứt bớt thứ gì đó đi cho nhanh.\", \"rating\": 0.0},\n  {\"id\": 709643, \"suggestedTranslation\": \"Cậu không thể ngủ nhanh hơn một chút được sao?\", \"rating\": 0.0},\n  {\"id\": 709644, \"suggestedTranslation\": \"Tôi không có thời gian đứng chờ đâu!\", \"rating\": 0.0},\n  {\"id\": 709645, \"suggestedTranslation\": \"Không, không, tôi làm thế này là sai trình tự rồi!\", \"rating\": 0.0},\n  {\"id\": 709646, \"suggestedTranslation\": \"Nếu cậu muốn cái này, tốt hơn là nên vứt bớt thứ gì đó đi cho nhanh.\", \"rating\": 0.0},\n  {\"id\": 709647, \"suggestedTranslation\": \"Cậu không thể ngủ nhanh hơn một chút được sao?\", \"rating\": 0.0},\n  {\"id\": 709648, \"suggestedTranslation\": \"Tôi khá chắc mình từng thấy cái này rồi. Hoặc có lẽ tôi sẽ sớm thấy nó?\", \"rating\": 0.0},\n  {\"id\": 709649, \"suggestedTranslation\": \"Thôi được rồi, cứ giữ bí mật của cậu đi!\", \"rating\": 0.0},\n  {\"id\": 709650, \"suggestedTranslation\": \"Cái này sẽ giúp đám merm kéo dài thêm chút thời gian.\", \"rating\": 0.0},\n  {\"id\": 709651, \"suggestedTranslation\": \"Chúng chẳng có hứng nghe tôi, và tôi cũng chẳng quan tâm đến chúng.\", \"rating\": 0.0},\n  {\"id\": 709652, \"suggestedTranslation\": \"Khoan, tôi làm rồi mà!\", \"rating\": 0.0},\n  {\"id\": 709653, \"suggestedTranslation\": \"Tôi không đủ kiên nhẫn để đối phó với một con bò lai đang cáu kỉnh đâu.\", \"rating\": 0.0},\n  {\"id\": 709654, \"suggestedTranslation\": \"Mình quên cái gì nhỉ? Nghe quen lắm...\", \"rating\": 0.0},\n  {\"id\": 709655, \"suggestedTranslation\": \"Nào mau lên, phi kiệu đến đây xem nào.\", \"rating\": 0.0},\n  {\"id\": 709656, \"suggestedTranslation\": \"Ôi trời phiền phức quá đi mất!!\", \"rating\": 0.0},\n  {\"id\": 709657, \"suggestedTranslation\": \"Sao cái buồm này cứ không chịu hạ xuống đàng hoàng khi mình bảo thế nhỉ?\", \"rating\": 0.0},\n  {\"id\": 709658, \"suggestedTranslation\": \"Ái! Chắc tôi bị căng cơ lưng rồi!\", \"rating\": 0.0},\n  {\"id\": 709659, \"suggestedTranslation\": \"Mình chọn cái này rồi à? Đúng vậy, mình khá chắc là rồi.\", \"rating\": 0.0},\n  {\"id\": 709660, \"suggestedTranslation\": \"Tôi tham gia sau cũng được. Hoặc sớm hơn.\", \"rating\": 0.0},\n  {\"id\": 709661, \"suggestedTranslation\": \"Ôi phiền phức thật. Tôi định dùng cái đó đấy, biết chưa!\", \"rating\": 0.0},\n  {\"id\": 709662, \"suggestedTranslation\": \"Dậy đi! Còn khối nơi phải đi, khối việc phải làm đấy!\", \"rating\": 0.0},\n  {\"id\": 709663, \"suggestedTranslation\": \"Tôi không đời nào chịu kết thúc dưới móng guốc của một con bò lai giận dữ đâu!\", \"rating\": 0.0},\n  {\"id\": 709664, \"suggestedTranslation\": \"only_used_by_wendy\", \"rating\": 0.0},\n  {\"id\": 709665, \"suggestedTranslation\": \"only_used_by_wendy\", \"rating\": 0.0},\n  {\"id\": 