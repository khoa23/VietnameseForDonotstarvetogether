\n  {\"id\": 711741, \"suggestedTranslation\": \"Một thứ vũ khí phát sáng á? Lần tới họ sẽ nghĩ ra cái gì nữa đây!\", \"rating\": 9.0},\n  {\"id\": 711742, \"suggestedTranslation\": \"Suy cho cùng nó cũng chỉ là một công cụ, tại sao tôi lại không được dùng cơ chứ?\", \"rating\": 9.0},\n  {\"id\": 711743, \"suggestedTranslation\": \"Một loại đá tảng nào đó.\", \"rating\": 9.5},\n  {\"id\": 711744, \"suggestedTranslation\": \"Thật thú vị, lại thêm cục đá!\", \"rating\": 9.5},\n  {\"id\": 711745, \"suggestedTranslation\": \"Tôi không bị mất chỗ bám dễ thế đâu!\", \"rating\": 9.0},\n  {\"id\": 711746, \"suggestedTranslation\": \"Bám chắc hơn một chút cũng chẳng hại gì.\", \"rating\": 9.0},\n  {\"id\": 711747, \"suggestedTranslation\": \"Nó mang lại cho tôi một góc nhìn hoàn toàn mới về việc làm vườn. Theo đúng nghĩa đen luôn.\", \"rating\": 9.0},\n  {\"id\": 711748, \"suggestedTranslation\": \"Dùng buồm chẳng phải sẽ nhanh hơn sao?\", \"rating\": 9.0},\n  {\"id\": 711749, \"suggestedTranslation\": \"Dùng buồm chẳng phải sẽ nhanh hơn sao?\", \"rating\": 9.0},\n  {\"id\": 711750, \"suggestedTranslation\": \"Ít ra tôi cũng phải công nhận khả năng làm nhiều việc cùng lúc của nó.\", \"rating\": 9.0},\n  {\"id\": 711751, \"suggestedTranslation\": \"Ở đây có lẽ từng có nước... hoặc có thể sau này sẽ có.\", \"rating\": 9.0},\n  {\"id\": 711752, \"suggestedTranslation\": \"Nước! Cuối cùng cũng có nước!\", \"rating\": 9.0},\n  {\"id\": 711753, \"suggestedTranslation\": \"Có thể có thứ gì đó thú vị đang ẩn trốn trong đống bùn kia.\", \"rating\": 9.0},\n  {\"id\": 711754, \"suggestedTranslation\": \"Trông nó giống như một phao câu thông thường đối với tôi.\", \"rating\": 9.0},\n  {\"id\": 711755, \"suggestedTranslation\": \"Biết ngay là thế nào rồi tôi cũng tìm được cách dùng chiếc lông vũ đó mà!\", \"rating\": 9.0},\n  {\"id\": 711756, \"suggestedTranslation\": \"Biết ngay là thế nào rồi tôi cũng tìm được cách dùng chiếc lông vũ đó mà!\", \"rating\": 9.0},\n  {\"id\": 711757, \"suggestedTranslation\": \"Tôi rất thích khoản câu cá này, hì hụi với mấy thứ linh tinh nhỏ xíu!\", \"rating\": 9.0},\n  {\"id\": 711758, \"suggestedTranslation\": \"Tôi rất thích khoản câu cá này, hì hụi với mấy thứ linh tinh nhỏ xíu!\", \"rating\": 9.0},\n  {\"id\": 711759, \"suggestedTranslation\": \"Ồ, tôi mất phao câu rồi! Hoặc có lẽ tôi chưa gắn nó vào...\", \"rating\": 9.0},\n  {\"id\": 711760, \"suggestedTranslation\": \"Một chiếc phao câu hơi thuôn dài.\", \"rating\": 9.0},\n  {\"id\": 711761, \"suggestedTranslation\": \"Biết ngay là thế nào rồi tôi cũng tìm được cách dùng chiếc lông vũ đó mà!\", \"rating\": 9.0},\n  {\"id\": 711762, \"suggestedTranslation\": \"Biết ngay là thế nào rồi tôi cũng tìm được cách dùng chiếc lông vũ đó mà!\", \"rating\": 9.0},\n  {\"id\": 711763, \"suggestedTranslation\": \"Nó bị bỏ độc à? Mình thực sự nên đầu độc bữa tối của mình sao?\", \"rating\": 9.0},\n  {\"id\": 711764, \"suggestedTranslation\": \"Cách nhanh chóng để câu cá lớn á? Không phiền nếu tôi thử đâu!\", \"rating\": 9.5},\n  {\"id\": 711765, \"suggestedTranslation\": \"Cứ giữ nó lại dùng cho những ngày mưa vậy.\", \"rating\": 9.0},\n  {\"id\": 711766, \"suggestedTranslation\": \"Tôi không thích bỏ mạng vì một con cá đâu.\", \"rating\": 9.5},\n  {\"id\": 711767, \"suggestedTranslation\": \"Nếu nó giúp tôi câu cá nhanh hơn, tôi hoàn toàn ủng hộ.\", \"rating\": 9.5},\n  {\"id\": 711768, \"suggestedTranslation\": \"Nếu nó giúp tôi câu cá nhanh hơn, tôi hoàn toàn ủng hộ.\", \"rating\": 9.5},\n  {\"id\": 711769, \"suggestedTranslation\": \"Nếu nó giúp tôi câu cá nhanh hơn, tôi hoàn toàn ủng hộ.\", \"rating\": 9.5},\n  {\"id\": 711770, \"suggestedTranslation\": \"Nếu nó giúp tôi câu cá nhanh hơn, tôi hoàn toàn ủng hộ.\", \"rating\": 9.5},\n  {\"id\": 711771, \"suggestedTranslation\": \"Nếu nó giúp tôi câu cá nhanh hơn, tôi hoàn toàn ủng hộ.\", \"rating\": 9.5},\n  {\"id\": 711772, \"suggestedTranslation\": \"Nếu nó giúp tôi câu cá nhanh hơn, tôi hoàn toàn ủng hộ.\", \"rating\