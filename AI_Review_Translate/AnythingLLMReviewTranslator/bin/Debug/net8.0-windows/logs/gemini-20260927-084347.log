: 9.0},\n  {\"id\": 711121, \"suggestedTranslation\": \"Hương vị không thể diễn tả nổi.\", \"rating\": 9.0},\n  {\"id\": 711122, \"suggestedTranslation\": \"Tôi thấy chúng khá hợp với món đồ tôi đang mặc.\", \"rating\": 9.0},\n  {\"id\": 711123, \"suggestedTranslation\": \"Ở đây ngoài vàng ra thì dùng vào việc gì được nữa chứ?\", \"rating\": 9.0},\n  {\"id\": 711124, \"suggestedTranslation\": \"Đừng nghĩ nhiều về nó thì sẽ thấy hợp lý thôi.\", \"rating\": 9.0},\n  {\"id\": 711125, \"suggestedTranslation\": \"Tôi không muốn số vàng đó bị lãng phí đâu.\", \"rating\": 9.0},\n  {\"id\": 711126, \"suggestedTranslation\": \"Nếu phải tốn thời gian đào hố, ít ra tôi cũng phải thật sang chảnh.\", \"rating\": 9.0},\n  {\"id\": 711127, \"suggestedTranslation\": \"Sao đống đất này không tự dịch chuyển đi nhỉ?\", \"rating\": 9.0},\n  {\"id\": 711128, \"suggestedTranslation\": \"Hmm... một chiếc đồng hồ bỏ túi bằng vàng khối có hơi quá không nhỉ?\", \"rating\": 9.0},\n  {\"id\": 711129, \"suggestedTranslation\": \"Chắc chắn sớm muộn gì tôi cũng tìm được cách dùng cho nó.\", \"rating\": 9.0},\n  {\"id\": 711130, \"suggestedTranslation\": \"Tôi có thể tìm cái gì đó để giúp nó mọc nhanh hơn.\", \"rating\": 9.0},\n  {\"id\": 711131, \"suggestedTranslation\": \"Không ổn rồi...\", \"rating\": 9.0},\n  {\"id\": 711132, \"suggestedTranslation\": \"Trông có vẻ ốm nặng rồi.\", \"rating\": 9.0},\n  {\"id\": 711133, \"suggestedTranslation\": \"Hừm, có gì đó không đúng lắm.\", \"rating\": 9.0},\n  {\"id\": 711134, \"suggestedTranslation\": \"Cỏ. Ra ngoài thì hay thấy rất nhiều cỏ.\", \"rating\": 9.0},\n  {\"id\": 711135, \"suggestedTranslation\": \"Và giờ nó sẽ bắt đầu quá trình mọc lại chậm chạp đến phát bực.\", \"rating\": 9.0},\n  {\"id\": 711136, \"suggestedTranslation\": \"Chẳng có gì mọc nổi trong cái nóng này đâu.\", \"rating\": 9.0},\n  {\"id\": 711137, \"suggestedTranslation\": \"Nó có vẻ không muốn dính dáng gì đến chúng ta, tôi thì sao cũng được.\", \"rating\": 9.0},\n  {\"id\": 711138, \"suggestedTranslation\": \"Trông ốm nặng thật đấy.\", \"rating\": 9.0},\n  {\"id\": 711139, \"suggestedTranslation\": \"Lũ nhóc nhảy nhót gớm nhỉ? Khôn hồn đấy.\", \"rating\": 9.0},\n  {\"id\": 711140, \"suggestedTranslation\": \"Đúng là một chiếc ô che mưa phong cách buổi chiều nhỉ?\", \"rating\": 9.0},\n  {\"id\": 711141, \"suggestedTranslation\": \"Trống rỗng.\", \"rating\": 9.0},\n  {\"id\": 711142, \"suggestedTranslation\": \"Mong là cái này chỉ tạm thời.\", \"rating\": 9.0},\n  {\"id\": 711143, \"suggestedTranslation\": \"Tôi chẳng cần gà tây để rưới nước sốt lên đâu, cứ đưa tôi cái thìa là được.\", \"rating\": 9.0},\n  {\"id\": 711144, \"suggestedTranslation\": \"Hiệu quả một cách tuyệt đẹp.\", \"rating\": 9.0},\n  {\"id\": 711145, \"suggestedTranslation\": \"Giá mà tôi có thể tóm được một cái từ trước... thôi quên đi.\", \"rating\": 9.0},\n  {\"id\": 711146, \"suggestedTranslation\": \"Nó sẽ giúp tôi nhớ lại mình đã đi những đâu.\", \"rating\": 9.0},\n  {\"id\": 711147, \"suggestedTranslation\": \"Nó thô sơ hơn chiếc đồng hồ bỏ túi của tôi, nhưng tuân theo cùng một nguyên lý cơ bản.\", \"rating\": 9.0},\n  {\"id\": 711148, \"suggestedTranslation\": \"Hừ, nấm...\", \"rating\": 9.0},\n  {\"id\": 711149, \"suggestedTranslation\": \"Không hiểu sao ý nghĩ ăn nó bây giờ không còn đáng sợ nữa.\", \"rating\": 9.0},\n  {\"id\": 711150, \"suggestedTranslation\": \"Chỉ là một cây nấm lục.\", \"rating\": 9.0},\n  {\"id\": 711151, \"suggestedTranslation\": \"Chắc chỉ là một loại nấm nào đó thôi.\", \"rating\": 9.0},\n  {\"id\": 711152, \"suggestedTranslation\": \"Chẳng có lý do gì phải đứng đợi nó mọc lại cả.\", \"rating\": 9.0},\n  {\"id\": 711153, \"suggestedTranslation\": \"Đó không phải là hồ nước tôi muốn nhảy xuống.\", \"rating\": 9.0},\n  {\"id\": 711154, \"suggestedTranslation\": \"Đó không phải là hồ nước tôi muốn nhảy xuống.\", \"rating\": 9.0},\n  {\"id\": 711155, \"suggestedTranslation\": \"Sầu riêng trộn, sầu-sầu riêng trộn!\", \"rating\": 9.0},\n  {\"id\": 711156, \"suggestedTranslation\": \"Phân dơi. Thật tuyệt vời.\", \"rating\": 9.0},\n  {\"id\": 711157, \"suggestedTranslation\": \"Có vô số cách khiến việc này trở nên cực kỳ tồi tệ.\", \"rating\": 9.0},\n  {\"id\": 711158, \"suggestedTranslation\": \"Một quả táo được nâng tầm bởi lớp kẹo bọc ngon lành.\", \"rating\": 9.0},\n  {\"id\": 711159, \"suggestedTranslation\": \"Thứ ngọt ngào không bao giờ hỏng, ai mà không thích chứ?\", \"rating\": 9.0},\n  {\"id\": 711160, \"suggestedTranslation\": \"Thôi được rồi, tôi sẽ cắn một miếng vậy.\", \"rating\": 9.0},\n  {\"id\": 711161, \"suggestedTranslation\": \"Nếu không ai muốn thì tôi vui vẻ nhận hết nhé.\", \"rating\": 9.0},\n  {\"id\": 711162, \"suggestedTranslation\": \"Nghe có vẻ là một lời tiên tri tự ứng nghiệm đấy.\", \"rating\": 9.0},\n  {\"id\": 711163, \"suggestedTranslation\": \"Vị ngọt hòa quyện với vị cay!\", \"rating\": 9.0},\n  {\"id\": 711164, \"suggestedTranslation\": \"Bắp ngô ngào đường ngon tuyệt để nhâm nhi.\", \"rating\": 9.0},\n  {\"id\": 711165, \"suggestedTranslation\": \"Ai lại đi giả dạng bắp ngô bình thường thành cục kẹo thế này?\", \"rating\": 9.0},\n  {\"id\": 711166, \"suggestedTranslation\": \"Cái đó nhai đỡ buồn miệng phết.\", \"rating\": 9.0},\n  {\"id\": 711167, \"suggestedTranslation\": \"Tôi sẽ giấu vài viên trong túi, lũ trẻ chắc sẽ thích kẹo cứng lắm đây.\", \"rating\": 9.0},\n  {\"id\": 711168, \"suggestedTranslation\": \"Anh nghĩ tôi sinh ra ngày hôm qua chắc?\", \"rating\": 9.0},\n  {\"id\": 711169, \"suggestedTranslation\": \"Thêm chút chất xơ chẳng hại ai bao giờ.\", \"rating\": 9.0},\n  {\"id\": 711170, \"suggestedTranslation\": \"Con ma nhỏ này tôi thích đấy.\", \"rating\": 9.0},\n  {\"id\": 711171, \"suggestedTranslation\": \"Dai, và chỉ có hơi nhiều giun một chút thôi.\", \"rating\": 9.0},\n  {\"id\": 711172, \"suggestedTranslation\": \"Nỗi sợ giúp bạn két sắt, nhưng lòng dũng cảm giúp bạn tiến bước.\", \"rating\": 9.0},\n  {\"id\": 711173, \"suggestedTranslation\": \"Tôi có thể cảm nhận được tiềm năng tỏa ra từ nó.\", \"rating\": 9.0},\n  {\"id\": 711174, \"suggestedTranslation\": \"Tôi là thợ đồng hồ, chứ có phải nhà hóa học đâu.\", \"rating\": 9.0},\n  {\"id\": 711175, \"suggestedTranslation\": \"Việc này có vẻ hơi phí thời gian của tôi...\", \"rating\": 9.0},\n  {\"id\": 711176, \"suggestedTranslation\": \"Nó có mùi của những khả năng đang thay đổi.\", \"rating\": 9.0},\n  {\"id\": 711177, \"suggestedTranslation\": \"Đúng là một cách ăn mừng ảm đạm.\", \"rating\": 9.0},\n  {\"id\": 711178, \"suggestedTranslation\": \"Chắc tôi có thể dành chút thời gian trang trí.\", \"rating\": 9.0},\n  {\"id\": 711179, \"suggestedTranslation\": \"Hừ, tôi không muốn phải nhớ đến chúng đâu.\", \"rating\": 9.0},\n  {\"id\": 711180, \"suggestedTranslation\": \"Tôi cứ treo nó lên đâu đó vậy.\", \"rating\": 9.0},\n  {\"id\": 711181, \"suggestedTranslation\": \"Nếu nhớ không lầm thì nó dùng để treo trên cây.\", \"rating\": 9.0},\n  {\"id\": 711182, \"suggestedTranslation\": \"Có quá nhiều con thật đang bay lượn ngoài kia, treo thế này hơi thừa.\", \"rating\": 9.0},\n  {\"id\": 711183, \"suggestedTranslation\": \"Chà, con heo đó đáng đời lắm.\", \"rating\": 9.0},\n  {\"id\": 711184, \"suggestedTranslation\": \"Đôi khi có những thứ cần phải đập đi làm lại.\", \"rating\": 9.0},\n  {\"id\": 711185, \"suggestedTranslation\": \"Đó là một cái búa nặng dùng để đập đồ vật.\", \"rating\": 9.0},\n  {\"id\": 711186, \"suggestedTranslation\": \"Trông có vẻ khá thoải mái.\", \"rating\": 9.0},\n  {\"id\": 711187, \"suggestedTranslation\": \"Ai lại nghĩ ra ý tưởng tồi tệ này thế nhỉ?\", \"rating\": 9.0},\n  {\"id\": 711188, \"suggestedTranslation\": \"Hương thơm dễ chịu làm sao!\", \"rating\": 9.0},\n  {\"id\": 711189, \"suggestedTranslation\": \"Nó ráp rúa khủng khiếp.\", \"rating\": 9.0},\n  {\"id\": 711190, \"suggestedTranslation\": \"Kinh tởm thật!\", \"rating\": 9.0},\n  {\"id\": 711191, \"suggestedTranslation\": \"Thư giãn và xả hơi một chút cũng hay... trong một hoặc hai phút.\", \"rating\": 9.0},\n  {\"id\": 711192, \"suggestedTranslation\": \"Cái đó không giúp gì đâu, thứ tôi cần là thời gian!\", \"rating\": 9.0},\n  {\"id\": 711193, \"suggestedTranslation\": \"Hợp chất quái gở này có thể kéo dài thời gian cho chúng ta đấy.\", \"rating\": 9.0},\n  {\"id\": 711194, \"suggestedTranslation\": \"Bôi nhanh một chút chắc không sao đâu.\", \"rating\": 9.0},\n  {\"id\": 711195, \"suggestedTranslation\": \"Nó dẫn truyền năng lượng hồi phục.\", \"rating\": 9.0},\n  {\"id\": 711196, \"suggestedTranslation\": \"Sờ vào thấy mát lạnh.\", \"rating\": 9.0},\n  {\"id\": 711197, \"suggestedTranslation\": \"Nó lạnh ngắt như băng đá / gai băng.\", \"rating\": 9.0},\n  {\"id\": 711198, \"suggestedTranslation\": \"Đây không phải là một viên đá tảng bình thường.\", \"rating\": 9.0},\n  {\"id\": 711199, \"suggestedTranslation\": \"Suýt nữa thì tôi bị bỏng ngón tay!\", \"rating\": 9.0},\n  {\"id\": 711200, \"suggestedTranslation\": \"Thứ gì đó để sưởi ấm những khúc xương già cỗi này.\", \"rating\": 9.0},\n  {\"id\": 711201, \"suggestedTranslation\": \"Lừa tôi một lần, nhục cho bạn. Lừa tôi lần nữa, lại nhục cho bạn tiếp!\", \"rating\": 9.0},\n  {\"id\": 711202, \"suggestedTranslation\": \"Vừa nãy có bụi hoa hồng ở đó à?\", \"rating\": 9.0},\n  {\"id\": 711203, \"suggestedTranslation\": \"Ha! Bà ta vẫn khó ở như ngày nào.\", \"rating\": 9.0},\n  {\"id\": 711204, \"suggestedTranslation\": \"Nó sẽ xua tan cái lạnh trong xương tôi.\", \"rating\": 9.0},\n  {\"id\": 711205, \"suggestedTranslation\": \"Chỉ có tác dụng nếu ta nhớ uống từ trước.\", \"rating\": 9.0},\n  {\"id\": 711206, \"suggestedTranslation\": \"Một cách chắc chắn để lấy lại sự tỉnh táo.\", \"rating\": 9.0},\n  {\"id\": 711207, \"suggestedTranslation\": \"Ánh trăng mang lại một hương vị khó quên.\", \"rating\": 9.0},\n  {\"id\": 711208, \"suggestedTranslation\": \"Một tách trà tuyệt vời để xua tan cơn điên loạn.\", \"rating\": 9.0},\n  {\"id\": 711209, \"suggestedTranslation\": \"Tôi chắc là nó có công dụng hay ho nào đó.\", \"rating\": 9.0},\n  {\"id\": 711210, \"suggestedTranslation\": \"Hừm. Để hạ nhiệt nhanh thôi mà.\", \"rating\": 9.0},\n  {\"id\": 711211, \"suggestedTranslation\": \"Một món vực dậy tinh thần nho nhỏ.\", \"rating\": 9.0},\n  {\"id\": 711212, \"suggestedTranslation\": \"Ôi phiền phức thật, bừa bộn quá.\", \"rating\": 9.0},\n  {\"id\": 711213, \"suggestedTranslation\": \"Thật là một cảnh tượng vui mắt.\", \"rating\": 9.0},\n  {\"id\": 711214, \"suggestedTranslation\": \"Tôi nghĩ bà ấy sẽ khá thích món này đấy.\", \"rating\": 9.0},\n  {\"id\": 711215, \"suggestedTranslation\": \"Mình dời nhà bà ấy đi đâu mất tiêu rồi nhỉ?\", \"rating\": 9.0},\n  {\"id\": 711216, \"suggestedTranslation\": \"Đã bao lâu rồi nhỉ từ lần cuối mình ghé thăm Ngọc trai?\", \"rating\": 9.0},\n  {\"id\": 711217, \"suggestedTranslation\": \"Đã đến giờ uống trà.\", \"rating\": 9.0},\n  {\"id\": 711218, \"suggestedTranslation\": \"Pha trà thì phải từ từ thong thả.\", \"rating\": 9.0},\n  {\"id\": 711219, \"suggestedTranslation\": \"Thật tiếc. Lẽ ra mình phải đoán trước được chứ.\", \"rating\": 9.0},\n  {\"id\": 711220, \"suggestedTranslation\": \"Mong là Ngọc trai sẽ sớm ghé qua.\", \"rating\": 9.0},\n  {\"id\": 711221, \"suggestedTranslation\": \"Cũng có lúc phải sống chậm lại và tận hưởng những điều nhỏ nhặt.\", \"rating\": 9.0},\n  {\"id\": 711222, \"suggestedTranslation\": \"Đứng ngẩn ngơ quanh cái hố trống thì có ích gì chứ.\", \"rating\": 9.0},\n  {\"id\": 711223, \"suggestedTranslation\": \"Trông thật ấm áp và mời gọi.\", \"rating\": 9.0},\n  {\"id\": 711224, \"suggestedTranslation\": \"Tất nhiên là chưa xong rồi.\", \"rating\": 9.0},\n  {\"id\": 711225, \"suggestedTranslation\": \"Thời gian bỏ ra rất đáng giá.\", \"rating\": 9.0},\n  {\"id\": 711226, \"suggestedTranslation\": \"Nơi này từng là một ngôi nhà tuyệt đẹp, nhưng giờ đã xuống cấp rồi.\", \"rating\": 9.0},\n  {\"id\": 711227, \"suggestedTranslation\": \"Lần cuối mình giặt đồ là khi nào nhỉ?\", \"rating\": 9.0},\n  {\"id\": 711228, \"suggestedTranslation\": \"Khá là duyên dáng.\", \"rating\": 9.0},\n  {\"id\": 711229, \"suggestedTranslation\": \"Ooooh tự hỏi có món đồ chơi thú vị nào bên trong nhỉ!\", \"rating\": 9.0},\n  {\"id\": 711230, \"suggestedTranslation\": \"Một đám vỏ sò hay ho để thêm vào bộ sưu tập nhỏ của tôi.\", \"rating\": 9.0},\n  {\"id\": 711231, \"suggestedTranslation\": \"Tôi cứ ôm hy vọng mọi chuyện lần này sẽ khác.\", \"rating\": 9.0},\n  {\"id\": 711232, \"suggestedTranslation\": \"Tôi sẽ... cố gắng hết sức.\", \"rating\": 9.0},\n  {\"id\": 711233, \"suggestedTranslation\": \"Thật kỳ quặc một cách thú vị!\", \"rating\": 9.0},\n  {\"id\": 711234, \"suggestedTranslation\": \"Tôi lỡ xông vào nhà của ai mất rồi.\", \"rating\": 9.0},\n  {\"id\": 711235, \"suggestedTranslation\": \"Đó là một bảng hiệu tồi.\", \"rating\": 9.0},\n  {\"id\": 711236, \"suggestedTranslation\": \"Chắc hẳn đó là một loại bảng hiệu nào đó.\", \"rating\": 9.0},\n  {\"id\": 711237, \"suggestedTranslation\": \"Chẳng có chữ nào viết ở đây cả. Thật là một bảng hiệu vô tích sự!\", \"rating\": 9.0}\n]",
