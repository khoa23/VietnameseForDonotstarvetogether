            "text": "[\n  {\"id\": 711838, \"suggestedTranslation\": \"Chuyện này chắc là sẽ chấm dứt được nó thôi.\", \"rating\": 8.5},\n  {\"id\": 711839, \"suggestedTranslation\": \"Tôi biết chuyện gì sẽ xảy ra tiếp theo.\", \"rating\": 8.5},\n  {\"id\": 711840, \"suggestedTranslation\": \"Tôi ghét phần này nhất.\", \"rating\": 8.5},\n  {\"id\": 711841, \"suggestedTranslation\": \"Một chút gia vị có thể giúp tôi bước đi nhanh nhẹn hơn.\", \"rating\": 8.5},\n  {\"id\": 711842, \"suggestedTranslation\": \"Mất khối thời gian để làm... nhưng mà ngon phết.\", \"rating\": 8.5},\n  {\"id\": 711843, \"suggestedTranslation\": \"Một trái ớt đặc biệt cay.\", \"rating\": 8.5},\n  {\"id\": 711844, \"suggestedTranslation\": \"Uoooh, tôi có cảm giác trái này sẽ siêu cay luôn đấy.\", \"rating\": 8.5},\n  {\"id\": 711845, \"suggestedTranslation\": \"Việc gì phải tốn thời gian trồng trong khi tôi có thể ăn luôn bây giờ cơ chứ?\", \"rating\": 8.5},\n  {\"id\": 711846, \"suggestedTranslation\": \"Con chim đó nhanh quá!\", \"rating\": 8.5},\n  {\"id\": 711847, \"suggestedTranslation\": \"Tôi không nghĩ nó may mắn lắm đối với tội nghiệp con chim đó đâu.\", \"rating\": 8.5},\n  {\"id\": 711848, \"suggestedTranslation\": \"Biến mất trong chớp mắt.\", \"rating\": 8.5},\n  {\"id\": 711849, \"suggestedTranslation\": \"Nào, mánh khóe với cái này là gì ấy nhỉ?\", \"rating\": 8.5},\n  {\"id\": 711850, \"suggestedTranslation\": \"Cái này sẽ ngốn thời gian khủng khiếp nếu tôi không cẩn thận...\", \"rating\": 8.5},\n  {\"id\": 711851, \"suggestedTranslation\": \"Những chiếc túi đồ ăn nhỏ xinh.\", \"rating\": 8.5},\n  {\"id\": 711852, \"suggestedTranslation\": \"Chúng héo tàn nhanh thật đấy.\", \"rating\": 8.5},\n  {\"id\": 711853, \"suggestedTranslation\": \"Thơm dễ chịu phết.\", \"rating\": 8.5},\n  {\"id\": 711854, \"suggestedTranslation\": \"Hái chúng có vẻ là một ý hay vào lúc đó...\", \"rating\": 8.5},\n  {\"id\": 711855, \"suggestedTranslation\": \"Thơm dễ chịu phết.\", \"rating\": 8.5},\n  {\"id\": 711856, \"suggestedTranslation\": \"Đông cứng trong dòng thời gian.\", \"rating\": 8.5},\n  {\"id\": 711857, \"suggestedTranslation\": \"Hừ, ngay cả thời gian cũng chẳng thèm chạm vào nó.\", \"rating\": 8.5},\n  {\"id\": 711858, \"suggestedTranslation\": \"Chúng ta nên mở bài gì mới hay bài gì cũ đây?\", \"rating\": 8.5},\n  {\"id\": 711859, \"suggestedTranslation\": \"Cách nhanh nhất để đập vỡ đá.\", \"rating\": 8.5},\n  {\"id\": 711860, \"suggestedTranslation\": \"Thật khó tin, nó dùng khá ổn phết.\", \"rating\": 8.5},\n  {\"id\": 711861, \"suggestedTranslation\": \"Nó hẳn phải là một loại đặc sản nào đó.\", \"rating\": 8.5},\n  {\"id\": 711862, \"suggestedTranslation\": \"Sao tôi lại tự vướng vào chuyện này cơ chứ?\", \"rating\": 8.5},\n  {\"id\": 711863, \"suggestedTranslation\": \"Heo con ngoan nào...\", \"rating\": 8.5},\n  {\"id\": 711864, \"suggestedTranslation\": \"Cứ bình tĩnh lại một chút nào...\", \"rating\": 8.5},\n  {\"id\": 711865, \"suggestedTranslation\": \"Khoan, khoan, tạm dừng trận đấu nào!!\", \"rating\": 8.5},\n  {\"id\": 711866, \"suggestedTranslation\": \"Sao tôi lại tự vướng vào chuyện này cơ chứ?\", \"rating\": 8.5},\n  {\"id\": 711867, \"suggestedTranslation\": \"Heo con ngoan nào...\", \"rating\": 8.5},\n  {\"id\": 711868, \"suggestedTranslation\": \"Cứ bình tĩnh lại một chút nào...\", \"rating\": 8.5},\n  {\"id\": 711869, \"suggestedTranslation\": \"Khoan, khoan, tạm dừng trận đấu nào!!\", \"rating\": 8.5},\n  {\"id\": 711870, \"suggestedTranslation\": \"Trông hắn có vẻ cực kỳ khó chịu.\", \"rating\": 8.5},\n  {\"id\": 711871, \"suggestedTranslation\": \"Tôi có thực sự muốn khênh cái thứ này đi quanh không nhỉ?\", \"rating\": 8.5},\n  {\"id\": 711872, \"suggestedTranslation\": \"Không hiểu sao nó lại có thể chết thêm lần nữa được cơ chứ.\", \"rating\": 8.5},\n  {\"id\": 711873, \"suggestedTranslation\": \"Chà, cái đó chẳng đáng sợ chút nào đâu.\", \"rating\": 8.5},\n  {\"id\": 711874, \"suggestedTranslation\": \"Biến mất trong chớp mắt.\", \"rating\": 8.5},\n  {\"id\": 711875, \"suggestedTranslation\": \"Bọn chúng chảnh chó hết chỗ nói đối với một lũ heo.\", \"rating\": 8.5},\n  {\"id\": 711876, \"suggestedTranslation\": \"Bao nhiêu thời gian trôi qua mà tôi chưa từng được mời vào trong lần nào.\", \"rating\": 8.5},\n  {\"id\": 711877, \"suggestedTranslation\": \"Lũ heo tồi tệ! Ít ra tụi mày cũng phải để đèn sáng chứ!\", \"rating\": 8.5},\n  {\"id\": 711878, \"suggestedTranslation\": \"Hắn khá là dễ nói chuyện một khi cậu đã quen thân.\", \"rating\": 8.5},\n  {\"id\": 711879, \"suggestedTranslation\": \"Thời gian của hắn đã cạn kiệt.\", \"rating\": 8.5},\n  {\"id\": 711880, \"suggestedTranslation\": \"Chà, tạm thời thì hắn cũng khá thân thiện.\", \"rating\": 8.5},\n  {\"id\": 711881, \"suggestedTranslation\": \"Đi tiếp đi, chú heo.\", \"rating\": 8.5},\n  {\"id\": 711882, \"suggestedTranslation\": \"Tốt nhất là nên tránh mặt hắn ra.\", \"rating\": 8.5},\n  {\"id\": 711883, \"suggestedTranslation\": \"Tôi ghét nhất lúc bọn chúng trở nên thế này!\", \"rating\": 8.5},\n  {\"id\": 711884, \"suggestedTranslation\": \"Nó cháy rụi đi trong nháy mắt.\", \"rating\": 8.5},\n  {\"id\": 711885, \"suggestedTranslation\": \"Lại đến thời điểm của chu kỳ quỹ đạo mười hai năm một lần rồi.\", \"rating\": 8.5},\n  {\"id\": 711886, \"suggestedTranslation\": \"Chà... chắc là vẫn còn thời gian để làm vài món đồ trang sức nhỏ.\", \"rating\": 8.5},\n  {\"id\": 711887, \"suggestedTranslation\": \"Thật là một kết cục đáng buồn.\", \"rating\": 8.5},\n  {\"id\": 711888, \"suggestedTranslation\": \"Tôi không muốn tốn quá nhiều thời gian ở trong đó đâu.\", \"rating\": 8.5},\n  {\"id\": 711889, \"suggestedTranslation\": \"Biết đâu đám heo đó thông minh hơn tôi tưởng.\", \"rating\": 8.5},\n  {\"id\": 711890, \"suggestedTranslation\": \"Ồ, tôi chưa bao giờ thuê trợ lý trước đây cả.\", \"rating\": 8.5},\n  {\"id\": 711891, \"suggestedTranslation\": \"Đúng là một chiếc thắt lưng khóa vàng khá cầu kỳ đối với một con heo!\", \"rating\": 8.5},\n  {\"id\": 711892, \"suggestedTranslation\": \"Khởi đầu của một cái cây.\", \"rating\": 8.5},\n  {\"id\": 711893, \"suggestedTranslation\": \"Tôi nghĩ nó cố tình mọc chậm để chọc tức tôi đấy.\", \"rating\": 8.5},\n  {\"id\": 711894, \"suggestedTranslation\": \"Đi biển đã đủ nguy hiểm rồi, giờ lại còn phải đối phó với cướp biển nữa á?\", \"rating\": 8.5},\n  {\"id\": 711895, \"suggestedTranslation\": \"Cứ như thể tôi không hề ngờ lại có một chữ \\\"X\\\" xuất hiện trên mặt đất vậy.\", \"rating\": 8.5},\n  {\"id\": 711896, \"suggestedTranslation\": \"Tôi quen dùng những dụng cụ nhỏ hơn nhiều rồi.\", \"rating\": 8.5},\n  {\"id\": 711897, \"suggestedTranslation\": \"Nếu tôi không đói đến thế, chắc tôi đã suy nghĩ lại rồi.\", \"rating\": 8.5},\n  {\"id\": 711898, \"suggestedTranslation\": \"Nếu bạn nhắm mắt lại thì ăn ngon hơn hẳn đấy.\", \"rating\": 8.5},\n  {\"id\": 711899, \"suggestedTranslation\": \"Đúng là chiếc mũ nhỏ ngộ nghĩnh. Để tôi thử xem!\", \"rating\": 8.5},\n  {\"id\": 711900, \"suggestedTranslation\": \"Nó chắc chắn là thực vật.\", \"rating\": 8.5},\n  {\"id\": 711901, \"suggestedTranslation\": \"Lớn nhanh lên xem nào! Tôi còn khối việc phải làm đấy!\", \"rating\": 8.5},\n  {\"id\": 711902, \"suggestedTranslation\": \"Cuối cùng cũng xong!\", \"rating\": 8.5},\n  {\"id\": 711903, \"suggestedTranslation\": \"Lại quên tưới nước cho nó nữa à?\", \"rating\": 8.5},\n  {\"id\": 711904, \"suggestedTranslation\": \"Đúng là một vở kịch nhỏ kỳ quặc.\", \"rating\": 8.5},\n  {\"id\": 711905, \"suggestedTranslation\": \"Nó kể cái gì đó về loài ngựa thì phải.\", \"rating\": 8.5},\n  {\"id\": 711906, \"suggestedTranslation\": \"Cái này đưa tôi quay ngược về quá khứ.\", \"rating\": 8.5},\n  {\"id\": 711907, \"suggestedTranslation\": \"Khá là đáng sợ nếu bạn hỏi tôi đấy.\", \"rating\": 8.5},\n  {\"id\": 711908, \"suggestedTranslation\": \"Tôi đang ghim cậu đấy nhé, %s...\", \"rating\": 8.5},\n  {\"id\": 711909, \"suggestedTranslation\": \"Hiểu rồi, trong dòng thời gian này cậu tự coi mình là kẻ phóng hỏa hả?\", \"rating\": 8.5},\n  {\"id\": 711910, \"suggestedTranslation\": \"Xin lỗi %s, tôi không có thời gian ở lại tán gẫu đâu!\", \"rating\": 8.5},\n  {\"id\": 711911, \"suggestedTranslation\": \"%s! Đừng lo, tôi sửa được mà!\", \"rating\": 8.5},\n  {\"id\": 711912, \"suggestedTranslation\": \"%s! Cậu đã làm cái quái gì thế hả?!\", \"rating\": 8.5},\n  {\"id\": 711913, \"suggestedTranslation\": \"C-cảm ơn nhé %s, tôi sẽ cẩn thận hơn.\", \"rating\": 8.5},\n  {\"id\": 711914, \"suggestedTranslation\": \"Một cách ra đi thật kinh khủng.\", \"rating\": 8.5},\n  {\"id\": 711915, \"suggestedTranslation\": \"Lần này chúc may mắn hơn vậy.\", \"rating\": 8.5},\n  {\"id\": 711916, \"suggestedTranslation\": \"Người ta làm gì với một lá bài đơn độc nhỉ?\", \"rating\": 8.5},\n  {\"id\": 711917, \"suggestedTranslation\": \"Mọi thứ tôi cần để chế tạo và tháo rời những chiếc đồng hồ đáng yêu của mình.\", \"rating\": 8.5},\n  {\"id\": 711918, \"suggestedTranslation\": \"Tôi chỉ cần thêm thời gian thôi!\", \"rating\": 8.5},\n  {\"id\": 711919, \"suggestedTranslation\": \"Nào, nhanh lên nào...\", \"rating\": 8.5},\n  {\"id\": 711920, \"suggestedTranslation\": \"Không hề dễ dàng chút nào khi chế tạo lại các cơ chế nhỏ, chính xác ở chốn hoang dã này.\", \"rating\": 8.5},\n  {\"id\": 711921, \"suggestedTranslation\": \"Sao chúng ta không làm một chuyến du ngoạn nhỏ về quá khứ nhỉ? Sẽ vui lắm đấy!\", \"rating\": 8.5},\n  {\"id\": 711922, \"suggestedTranslation\": \"Sẽ là một bước nhảy xa đấy, nhưng chúng ta làm được mà! Tôi nghĩ thế...\", \"rating\": 8.5},\n  {\"id\": 711923, \"suggestedTranslation\": \"Đã đến lúc chúng ta hòa mình vào dòng thời gian chưa nhỉ?\", \"rating\": 8.5},\n  {\"id\": 711924, \"suggestedTranslation\": \"Vẫn chưa sẵn sàng á? Phiền phức thật, dòng chảy thời gian bình thường chậm chạp quá!\", \"rating\": 8.5},\n  {\"id\": 711925, \"suggestedTranslation\": \"Sao chúng ta không làm một chuyến du ngoạn nhỏ về quá khứ nhỉ? Sẽ vui lắm đấy!\", \"rating\": 8.5},\n  {\"id\": 711926, \"suggestedTranslation\": \"Nó sẽ không mở mãi đâu. Đi thôi mọi người, tích tắc nào!\", \"rating\": 8.5},\n  {\"id\": 711927, \"suggestedTranslation\": \"Nó sẽ không mở mãi đâu. Đi thôi mọi người, tích tắc nào!\", \"rating\": 8.5},\n  {\"id\": 711928, \"suggestedTranslation\": \"Lại một chuyến du hành thời gian hoàn hảo không tì vết.\", \"rating\": 8.5},\n  {\"id\": 711929, \"suggestedTranslation\": \"Ồ, điều đó đưa tôi về tuốt quá khứ.\", \"rating\": 8.5},\n  {\"id\": 711930, \"suggestedTranslation\": \"Sẽ là một cú nhảy lớn đây, nhưng tôi làm được!\", \"rating\": 8.5},\n  {\"id\": 711931, \"suggestedTranslation\": \"Đã đến lúc tôi hòa mình vào dòng thời gian chưa nhỉ?\", \"rating\": 8.5},\n  {\"id\": 711932, \"suggestedTranslation\": \"Nhanh lên nào, tích tắc!\", \"rating\": 8.5},\n  {\"id\": 711933, \"suggestedTranslation\": \"Ồ, điều đó đưa tôi về tuốt quá khứ.\", \"rating\": 8.5},\n  {\"id\": 711934, \"suggestedTranslation\": \"Tôi thích chuẩn bị sẵn sàng cho mọi tình huống.\", \"rating\": 8.5},\n  {\"id\": 711935, \"suggestedTranslation\": \"Việc này có thể mất một chút thời gian. Trong lúc đó đừng ai làm gì nguy hiểm đấy!\", \"rating\": 8.5},\n  {\"id\": 711936, \"suggestedTranslation\": \"Nó hoàn hảo cho những chuyến đi ngắn, gọn gàng và chẳng phiền phức gì.\", \"rating\": 8.5},\n  {\"id\": 711937, \"suggestedTranslation\": \"Nó cần một chút thời gian để dừng lại.\", \"rating\": 8.5},\n  {\"id\": 711938, \"suggestedTranslation\": \"Tôi phải kiếm thêm chút nhiên liệu đen tối đó mới được...\", \"rating\": 8.5},\n  {\"id\": 711939, \"suggestedTranslation\": \"Nếu có thứ gì dám đe dọa tôi, tôi sẽ cho chúng ăn đòn ngay mà không cần suy nghĩ lần hai!\", \"rating\": 8.5},\n  {\"id\": 711940, \"suggestedTranslation\": \"Theo tôi, mọi thứ đều nên có phiên bản bỏ túi.\", \"rating\": 8.5},\n  {\"id\": 711941, \"suggestedTranslation\": \"Tôi sẽ nhét thêm vài cái vào túi... đừng để ý tôi nhé.\", \"rating\": 8.5},\n  {\"id\": 711942, \"suggestedTranslation\": \"Một trợ thủ bỏ túi, còn gì tuyệt vời hơn nữa chứ?\", \"rating\": 8.5},\n  {\"id\": 711943, \"suggestedTranslation\": \"Thiết kế kỳ quặc thật... Tôi phải có nó mới được.\", \"rating\": 8.5},\n  {\"id\": 711944, \"suggestedTranslation\": \"Ai mà muốn tốn thời gian nhặt từng cái hạt ra cơ chứ?\", \"rating\": 8.5},\n  {\"id\": 711945, \"suggestedTranslation\": \"Nó có vẻ là ý hay hơn khi nghĩ trong đầu.\", \"rating\": 8.5},\n  {\"id\": 711946, \"suggestedTranslation\": \"Tôi hi vọng những hạt bên trong cũng to lên.\", \"rating\": 8.5},\n  {\"id\": 711947, \"suggestedTranslation\": \"Việc gì phải tốn thời gian trồng trong khi tôi có thể ăn luôn bây giờ cơ chứ?\", \"rating\": 8.5},\n  {\"id\": 711948, \"suggestedTranslation\": \"Cái ao đó ở đó từ xưa tới giờ luôn à?\", \"rating\": 8.5},\n  {\"id\": 711949, \"suggestedTranslation\": \"Tôi đang phân vân không biết có nên ném nó xuống lại không...\", \"rating\": 8.5},\n  {\"id\": 711950, \"suggestedTranslation\": \"Tôi có thể gọi nó là hải sản không nhỉ? Thực ra nó giống đồ ăn dưới ao hơn.\", \"rating\": 8.5},\n  {\"id\": 711951, \"suggestedTranslation\": \"Tôi không thể dành thời gian để ngắm nghía từng loại thực vật cũ kỹ dưới ao được.\", \"rating\": 8.5},\n  {\"id\": 711952, \"suggestedTranslation\": \"Đó đúng là một bãi phân vô cùng khỏe mạnh.\", \"rating\": 8.5},\n  {\"id\": 711953, \"suggestedTranslation\": \"Nó cứ nhún nhảy một cách đầy sức sống.\", \"rating\": 8.5},\n  {\"id\": 711954, \"suggestedTranslation\": \"Ôi chao ước gì nó nhanh lên một chút!\", \"rating\": 8.5},\n  {\"id\": 711955, \"suggestedTranslation\": \"Chắc là sẽ không mất quá nhiều thời gian nữa đâu nhỉ?\", \"rating\": 8.5},\n  {\"id\": 711956, \"suggestedTranslation\": \"Cuối cùng thì cũng có đồ ăn!\", \"rating\": 8.5},\n  {\"id\": 711957, \"suggestedTranslation\": \"Tôi chẳng ngửi thấy mùi gì đang nấu cả.\", \"rating\": 8.5},\n  {\"id\": 711958, \"suggestedTranslation\": \"Tôi không thích bày vẽ nấu nướng cầu kỳ đâu.\", \"rating\": 8.5},\n  {\"id\": 711959, \"suggestedTranslation\": \"Cậu nhóc Walter đó thông minh phết.\", \"rating\": 8.5},\n  {\"id\": 711960, \"suggestedTranslation\": \"Phải công nhận là trông nó thèm ăn hơn trước rồi đấy.\", \"rating\": 8.5},\n  {\"id\": 711961, \"suggestedTranslation\": \"Thêm chút gia vị thì ngon đấy, nhưng có đáng tốn thêm thời gian không nhỉ?\", \"rating\": 8.5},\n  {\"id\": 711962, \"suggestedTranslation\": \"Có một nơi an toàn để qua đêm thì đúng là tuyệt vời.\", \"rating\": 8.5},\n  {\"id\": 711963, \"suggestedTranslation\": \"Ai rảnh rỗi hơn thì hãy dựng nó lên đi.\", \"rating\": 8.5},\n  {\"id\": 711964, \"suggestedTranslation\": \"Một trong những loại rau củ đáng tin cậy nhất.\", \"rating\": 8.5},\n  {\"id\": 711965, \"suggestedTranslation\": \"Ai mà muốn khênh cái thứ nặng nề này đi quanh chứ?\", \"rating\": 8.5},\n  {\"id\": 711966, \"suggestedTranslation\": \"Nhẹ nhàng và xốp mềm.\", \"rating\": 8.5},\n  {\"id\": 711967, \"suggestedTranslation\": \"Thời gian cứ ngỡ như một củ khoai tây xoắn ốc vậy.\", \"rating\": 8.5},\n  {\"id\": 711968, \"suggestedTranslation\": \"Phải công nhận là khoai tây nấu chín ngon hơn hẳn.\", \"rating\": 8.5},\n  {\"id\": 711969, \"suggestedTranslation\": \"Đúng là một củ khoai tây to đến mức lố bịch.\", \"rating\": 8.5},\n  {\"id\": 711970, \"suggestedTranslation\": \"Việc gì phải tốn thời gian trồng trong khi tôi có thể ăn luôn bây giờ cơ chứ?\", \"rating\": 8.5},\n  {\"id\": 711971, \"suggestedTranslation\": \"Tôi có vẻ chẳng bao giờ giữ cho chúng sống lâu được.\", \"rating\": 8.5},\n  {\"id\": 711972, \"suggestedTranslation\": \"Cái này chẳng bao giờ kết thúc tốt đẹp cả.\", \"rating\": 8.5},\n  {\"id\": 711973, \"suggestedTranslation\": \"Đến đây để gây phiền toái à, hả?\", \"rating\": 8.5},\n  {\"id\": 711974, \"suggestedTranslation\": \"Đúng rồi, mình phải đi múc nước trước đã.\", \"rating\": 8.5},\n  {\"id\": 711975, \"suggestedTranslation\": \"Tôi biết cái mỏ đó rồi sẽ có ích