            "text": "[\n  {\"id\":713638,\"suggestedTranslation\":\"Cái gì thế này? Ai đó đang cố thu hút sự chú ý của chúng ta kìa.\",\"rating\":9.0},\n  {\"id\":713639,\"suggestedTranslation\":\"Ta cảm thấy như một chiếc bánh bao vậy!\",\"rating\":9.0},\n  {\"id\":713640,\"suggestedTranslation\":\"Liệu thế có khôn ngoan không?\",\"rating\":9.0},\n  {\"id\":713641,\"suggestedTranslation\":\"Ta đang trong giờ nghỉ mà!\",\"rating\":9.0},\n  {\"id\":713642,\"suggestedTranslation\":\"\\nTa thà không ăn lại món cũ rích đó một lần nữa.\",\"rating\":9.0},\n  {\"id\":713643,\"suggestedTranslation\":\"Tự dooooo rồi!\",\"rating\":9.0},\n  {\"id\":713644,\"suggestedTranslation\":\"only_used_by_wurt\",\"rating\":10.0},\n  {\"id\":713645,\"suggestedTranslation\":\"Trời ạ, ta đau đầu quá.\",\"rating\":9.0},\n  {\"id\":713646,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":10.0},\n  {\"id\":713647,\"suggestedTranslation\":\"Dù nó có làm gì đi nữa, đầu óc ta giờ đã tỉnh táo hơn nhiều rồi.\",\"rating\":9.0},\n  {\"id\":713648,\"suggestedTranslation\":\"Đã đến lúc dùng đợt thuốc Chống Axit thứ hai rồi.\",\"rating\":9.0},\n  {\"id\":713649,\"suggestedTranslation\":\"Ôi không! Ta lại dễ bắt lửa lần nữa rồi!\",\"rating\":9.0},\n  {\"id\":713650,\"suggestedTranslation\":\"Ta đã đến chỗ của Quý cô Ngọc trai rồi!\",\"rating\":9.0},\n  {\"id\":713651,\"suggestedTranslation\":\"Ôi không! Nó thất bại rồi!\",\"rating\":9.0},\n  {\"id\":713652,\"suggestedTranslation\":\"Bộ não của ta đang tê rần lên đây!\",\"rating\":9.0},\n  {\"id\":713653,\"suggestedTranslation\":\"Ta đang nướng mình như một cái bánh soufflé ở đây này...\",\"rating\":9.0},\n  {\"id\":713654,\"suggestedTranslation\":\"Ta nhận ra âm thanh đó. Cơn đói.\",\"rating\":9.0},\n  {\"id\":713655,\"suggestedTranslation\":\"Ta cần đồ ăn...\",\"rating\":9.0},\n  {\"id\":713656,\"suggestedTranslation\":\"Đường mòn này có vẻ an toàn hơn nhỉ?\",\"rating\":9.0},\n  {\"id\":713657,\"suggestedTranslation\":\"Con mồi đã ở ngay gần đây...\",\"rating\":9.0},\n  {\"id\":713658,\"suggestedTranslation\":\"Ta đã mất dấu rồi.\",\"rating\":9.0},\n  {\"id\":713659,\"suggestedTranslation\":\"Dấu vết đã bị cuốn trôi mất rồi.\",\"rating\":9.0},\n  {\"id\":713660,\"suggestedTranslation\":\"Ôi trời... con đường đó có vẻ hơi nguy hiểm so với sở thích của ta...\",\"rating\":9.0},\n  {\"id\":713661,\"suggestedTranslation\":\"Nó ở gần lắm rồi, ta sắp tóm được nó đây!\",\"rating\":9.0},\n  {\"id\":713662,\"suggestedTranslation\":\"Chúa ơi, ta có một linh cảm vô cùng tồi tệ...\",\"rating\":9.0},\n  {\"id\":713663,\"suggestedTranslation\":\"Cần thêm phân bón cho nó.\",\"rating\":9.0},\n  {\"id\":713664,\"suggestedTranslation\":\"Ta không thể nhấc nổi một món nào nữa rồi.\",\"rating\":9.0},\n  {\"id\":713665,\"suggestedTranslation\":\"Đại tiệc Mùa Đông đã được dọn lên!\",\"rating\":9.0},\n  {\"id\":713666,\"suggestedTranslation\":\"Ồ! Chào chú mèo nhỏ nhé!\",\"rating\":9.0},\n  {\"id\":713667,\"suggestedTranslation\":\"Voila!\",\"rating\":9.0},\n  {\"id\":713668,\"suggestedTranslation\":\"Mi đây rồi chú mèo nhỏ của ta!\",\"rating\":9.0},\n  {\"id\":713669,\"suggestedTranslation\":\"À, mi đây rồi!\",\"rating\":9.0},\n  {\"id\":713670,\"suggestedTranslation\":\"Xin chào, ta thấy mi rồi nhé!\",\"rating\":9.0},\n  {\"id\":713671,\"suggestedTranslation\":\"Et voila! Chú mèo nhỏ cuối cùng đây rồi.\",\"rating\":9.0},\n  {\"id\":713672,\"suggestedTranslation\":\"À, {name} cuối cùng cũng tìm thấy chúng rồi!\",\"rating\":9.0},\n  {\"id\":713673,\"suggestedTranslation\":\"Chắc chỉ còn lại một con nữa thôi.\",\"rating\":9.0},\n  {\"id\":713674,\"suggestedTranslation\":\"Chà, ta đoán lần sau mình phải cố gắng hơn thôi.\",\"rating\":9.0},\n  {\"id\":713675,\"suggestedTranslation\":\"Trò chơi sắp kết thúc rồi đấy.\",\"rating\":9.0},\n  {\"id\":713676,\"suggestedTranslation\":\"Ta nghĩ mình có lẽ đã đi hơi xa rồi...\",\"rating\":9.0},\n  {\"id\":713677,\"suggestedTranslation\":\"Hừm, chúng phải ở quanh đâu đây chứ...\",\"rating\":9.0},\n  {\"id\":713678,\"suggestedTranslation\":\"Ta có thể tham gia được chứ, làm ơn?\",\"rating\":9.0},\n  {\"id\":713679,\"suggestedTranslation\":\"Ba, hai, một... đi thôi!\",\"rating\":9.0},\n  {\"id\":713680,\"suggestedTranslation\":\"Có cái gì đó đang đến kìa!\",\"rating\":9.0},\n  {\"id\":713681,\"suggestedTranslation\":\"Trứng của chúng ta bị đập vỡ rồi! Chạy mau!\",\"rating\":9.0},\n  {\"id\":713682,\"suggestedTranslation\":\"Xiềng xích của nó đã rơi ra rồi!\",\"rating\":9.0},\n  {\"id\":713683,\"suggestedTranslation\":\"Đầu ta... quay cuồng quá...\",\"rating\":9.0},\n  {\"id\":713684,\"suggestedTranslation\":\"Suýt nữa thì trúng rồi đấy!\",\"rating\":9.0},\n  {\"id\":713685,\"suggestedTranslation\":\"Có quá nhiều đầu bếp trong căn bếp này rồi!\",\"rating\":9.0},\n  {\"id\":713686,\"suggestedTranslation\":\"Ta chẳng học được mẹo mới nào từ thứ đó cả.\",\"rating\":9.0},\n  {\"id\":713687,\"suggestedTranslation\":\"Cảm giác quen thuộc thật.\",\"rating\":9.0},\n  {\"id\":713688,\"suggestedTranslation\":\"Trời đang mưa thịt gia cầm kìa.\",\"rating\":9.0},\n  {\"id\":713689,\"suggestedTranslation\":\"Nghe giống như một cái máy xay sinh tố vậy!\",\"rating\":9.0},\n  {\"id\":713690,\"suggestedTranslation\":\"Ánh sáng phát rạng kia là gì nhỉ?\",\"rating\":9.0},\n  {\"id\":713691,\"suggestedTranslation\":\"Có lẽ nó đang ngại ngùng thôi.\",\"rating\":9.0},\n  {\"id\":713692,\"suggestedTranslation\":\"Quả pháo sáng đó chắc chắn sẽ thu hút bất cứ thứ gì ở gần đó.\",\"rating\":9.0},\n  {\"id\":713693,\"suggestedTranslation\":\"Hà... ta đang nóng ran cả người...\",\"rating\":9.0},\n  {\"id\":713694,\"suggestedTranslation\":\"Bụng ta đang nóng bừng lên này!\",\"rating\":9.0},\n  {\"id\":713695,\"suggestedTranslation\":\"Ta sẽ phải cẩn thận hơn với những gì mình ăn mới được...\",\"rating\":9.0},\n  {\"id\":713696,\"suggestedTranslation\":\"Ta bắt đầu cảm thấy hơi khó chịu rồi đấy...\",\"rating\":9.0},\n  {\"id\":713697,\"suggestedTranslation\":\"Chúa ơi, ta đã biến thành một con khỉ rồi!\",\"rating\":9.0},\n  {\"id\":713698,\"suggestedTranslation\":\"Ta nghĩ mình sẽ không nấu ăn với chuối trong một thời gian nữa đâu...\",\"rating\":9.0},\n  {\"id\":713699,\"suggestedTranslation\":\"Sắp tới nơi rồi, bạn hiền ơi!\",\"rating\":9.0},\n  {\"id\":713700,\"suggestedTranslation\":\"Có vẻ như có thứ gì đó bị kẹt bên trong.\",\"rating\":9.0},\n  {\"id\":713701,\"suggestedTranslation\":\"Tận hưởng sự tự do ngọt ngào đi!\",\"rating\":9.0},\n  {\"id\":713702,\"suggestedTranslation\":\"Sắp tới nơi rồi, bạn hiền ơi!\",\"rating\":9.0},\n  {\"id\":713703,\"suggestedTranslation\":\"Có vẻ như có thứ gì đó bị kẹt bên trong.\",\"rating\":9.0},\n  {\"id\":713704,\"suggestedTranslation\":\"Tận hưởng sự tự do ngọt ngào đi!\",\"rating\":9.0},\n  {\"id\":713705,\"suggestedTranslation\":\"Sắp tới nơi rồi, bạn hiền ơi!\",\"rating\":9.0},\n  {\"id\":713706,\"suggestedTranslation\":\"Có vẻ như có thứ gì đó bị kẹt bên trong.\",\"rating\":9.0},\n  {\"id\":713707,\"suggestedTranslation\":\"Tận hưởng sự tự do ngọt ngào đi!\",\"rating\":9.0},\n  {\"id\":713708,\"suggestedTranslation\":\"Có lẽ thế lại là điều tốt nhất.\",\"rating\":9.0},\n  {\"id\":713709,\"suggestedTranslation\":\"Bệnh dịch có cánh!\",\"rating\":9.0},\n  {\"id\":713710,\"suggestedTranslation\":\"Miếng thịt thăn tội nghiệp của ta trông không ổn lắm rồi!\",\"rating\":9.0},\n  {\"id\":713711,\"suggestedTranslation\":\"Những con chim kỳ lạ và đáng sợ đó đã đến để dự tiệc kìa!\",\"rating\":9.0},\n  {\"id\":713712,\"suggestedTranslation\":\"Ta muốn là người không chết đầu tiên.\",\"rating\":9.0},\n  {\"id\":713713,\"suggestedTranslation\":\"Đây không phải lúc để nhắm mắt nghỉ ngơi đâu!\",\"rating\":9.0},\n  {\"id\":713714,\"suggestedTranslation\":\"Trong trường hợp cụ thể này, ta thích không phải chết khi đang ngủ hơn!\",\"rating\":9.0},\n  {\"id\":713715,\"suggestedTranslation\":\"Trời sáng quá không ngủ được.\",\"rating\":9.0},\n  {\"id\":713716,\"suggestedTranslation\":\"Ta không thấy mệt.\",\"rating\":9.0},\n  {\"id\":713717,\"suggestedTranslation\":\"Ta có thể dùng một bữa ăn ngon trước đã.\",\"rating\":9.0},\n  {\"id\":713718,\"suggestedTranslation\":\"Cơn đói của ta quan trọng hơn sự kiệt sức này.\",\"rating\":9.0},\n  {\"id\":713719,\"suggestedTranslation\":\"Đầu tiên ta nên xuống khỏi miếng thịt thăn lớn này đã.\",\"rating\":9.0},\n  {\"id\":713720,\"suggestedTranslation\":\"Ngủ trưa trong bóng tối á? Ta không nghĩ vậy đâu.\",\"rating\":9.0},\n  {\"id\":713721,\"suggestedTranslation\":\"Nơi này đối với ta không có vẻ gì là thư giãn để ngủ trưa cả.\",\"rating\":9.0},\n  {\"id\":713722,\"suggestedTranslation\":\"Mi quá đẹp để thuộc về thế giới này.\",\"rating\":9.0},\n  {\"id\":713723,\"suggestedTranslation\":\"Ta vẫn có thể nhìn thấy ánh sáng từ người bạn bằng kim loại của chúng ta khi nhắm mắt lại...\",\"rating\":9.0},\n  {\"id\":713724,\"suggestedTranslation\":\"Ta không nghĩ vậy đâu! Đó là một ổ nguy hiểm đấy!\",\"rating\":9.0},\n  {\"id\":713725,\"suggestedTranslation\":\"Lửa!\",\"rating\":9.0},\n  {\"id\":713726,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":10.0},\n  {\"id\":713727,\"suggestedTranslation\":\"Mọi chuyện diễn ra suôn sẻ không chút trục trặc.\",\"rating\":9.0},\n  {\"id\":713728,\"suggestedTranslation\":\"À không, cú ném tồi tệ quá!\",\"rating\":9.0},\n  {\"id\":713729,\"suggestedTranslation\":\"Mi đã thoát khỏi cái nồi đất của ta tạm thời đấy, bạn hiền ạ.\",\"rating\":9.0},\n  {\"id\":713730,\"suggestedTranslation\":\"Câu cá đòi hỏi rất nhiều sự kiên nhẫn.\",\"rating\":9.0},\n  {\"id\":713731,\"suggestedTranslation\":\"Hỡi cá ơi! Các ngươi không muốn thử mồi câu của ta sao?\",\"rating\":9.0},\n  {\"id\":713732,\"suggestedTranslation\":\"Ừm đụm đi đà...\",\"rating\":9.0},\n  {\"id\":713733,\"suggestedTranslation\":\"Ta tự hỏi liệu có chỗ nào khác tốt hơn không nhỉ.\",\"rating\":9.0},\n  {\"id\":713734,\"suggestedTranslation\":\"À, quái thật! Ta mất mồi câu rồi.\",\"rating\":9.0},\n  {\"id\":713735,\"suggestedTranslation\":\"Ta nên kéo dây câu căng hơn một chút.\",\"rating\":9.0},\n  {\"id\":713736,\"suggestedTranslation\":\"Ồ? Cái gì thế nhỉ?\",\"rating\":9.0},\n  {\"id\":713737,\"suggestedTranslation\":\"Ai cũng muốn thêm chút gia vị cá nhân vào vai diễn của mình.\",\"rating\":9.0},\n  {\"id\":713738,\"suggestedTranslation\":\"Nó đang sụp đổ vì thiếu phần trung tâm kìa!\",\"rating\":9.0},\n  {\"id\":713739,\"suggestedTranslation\":\"Khỉ thật, ra khơi xa thế này đúng là thảm họa tự tìm đến.\",\"rating\":9.0},\n  {\"id\":713740,\"suggestedTranslation\":\"Hừ! Đủ rồi đấy!\",\"rating\":9.0},\n  {\"id\":713741,\"suggestedTranslation\":\"Có phải mấy cái cây đang phát ra âm thanh đó không?\",\"rating\":9.0},\n  {\"id\":713742,\"suggestedTranslation\":\"Nó có mùi vô cùng kém ngon miệng.\",\"rating\":9.0},\n  {\"id\":713743,\"suggestedTranslation\":\"Ôi, rắc rối thật đấy...\",\"rating\":9.0},\n  {\"id\":713744,\"suggestedTranslation\":\"Ta tự hỏi nó sẽ mọc thành cái gì đây.\",\"rating\":9.0},\n  {\"id\":713745,\"suggestedTranslation\":\"Ta đã học thêm được đôi chút về loài thực vật này.\",\"rating\":9.0},\n  {\"id\":713746,\"suggestedTranslation\":\"Chúa ơi, không hiểu sao thứ đó lại làm ta hơi say sóng...\",\"rating\":9.0},\n  {\"id\":713747,\"suggestedTranslation\":\"Không phải cú ngã giết chết bạn đâu...\",\"rating\":9.0},\n  {\"id\":713748,\"suggestedTranslation\":\"Đó không phải là một âm thanh dễ chịu chút nào...\",\"rating\":9.0},\n  {\"id\":713749,\"suggestedTranslation\":\"Có lẽ âm học ở đây không được lý tưởng cho lắm.\",\"rating\":9.0},\n  {\"id\":713750,\"suggestedTranslation\":\"Có điều gì đó không mấy dễ chịu đang nung nấu bên dưới.\",\"rating\":9.0},\n  {\"id\":713751,\"suggestedTranslation\":\"Đó quả thực là một chú thỏ hiếm có!\",\"rating\":9.0},\n  {\"id\":713752,\"suggestedTranslation\":\"Voila! Tóm được mi rồi!\",\"rating\":9.0},\n  {\"id\":713753,\"suggestedTranslation\":\"Ta nghe thấy tiếng sột soạt nhẹ bên dưới chân chúng ta.\",\"rating\":9.0},\n  {\"id\":713754,\"suggestedTranslation\":\"Ta không qua được!\",\"rating\":9.0},\n  {\"id\":713755,\"suggestedTranslation\":\"Học tập là quá trình suốt đời.\",\"rating\":9.0},\n  {\"id\":713756,\"suggestedTranslation\":\"Ta ngửi thấy mùi bánh nướng phải không nhỉ?\",\"rating\":9.0},\n  {\"id\":713757,\"suggestedTranslation\":\"Et voila!\",\"rating\":9.0},\n  {\"id\":713758,\"suggestedTranslation\":\"Đợi đã, bạn hiền.\",\"rating\":9.0},\n  {\"id\":713759,\"suggestedTranslation\":\"Hoàng đế của ta!\",\"rating\":9.0},\n  {\"id\":713760,\"suggestedTranslation\":\"Điện hạ.\",\"rating\":9.0},\n  {\"id\":713761,\"suggestedTranslation\":\"Ngài Đại sứ.\",\"rating\":9.0},\n  {\"id\":713762,\"suggestedTranslation\":\"\\\"Hoàng đế\\\" của ta!\",\"rating\":9.0},\n  {\"id\":713763,\"suggestedTranslation\":\"\\\"Điện hạ\\\" của ngài.\",\"rating\":9.0},\n  {\"id\":713764,\"suggestedTranslation\":\"\\\"Ngài Đại sứ\\\".\",\"rating\":9.0},\n  {\"id\":713765,\"suggestedTranslation\":\"Những con quái vật đáng sợ đã trở lại rồi!\",\"rating\":9.0},\n  {\"id\":713766,\"suggestedTranslation\":\"Xin lỗi vì những thiếu sót của ta nhé.\",\"rating\":9.0},\n  {\"id\":713767,\"suggestedTranslation\":\"Cảm ơn rất nhiều!\",\"rating\":9.0},\n  {\"id\":713768,\"suggestedTranslation\":\"Cuốn sổ lưu niệm của ta đã chật cứng rồi.\",\"rating\":9.0},\n  {\"id\":713769,\"suggestedTranslation\":\"Xin chào, bạn hiền! Mi đang bám theo ta đấy à?\",\"rating\":9.0},\n  {\"id\":713770,\"suggestedTranslation\":\"Không không, ta từ chối làm một miếng thịt ngon lành đâu!\",\"rating\":9.0},\n  {\"id\":713771,\"suggestedTranslation\":\"Ánh sáng kỳ lạ lúc nãy là gì vậy?\",\"rating\":9.0},\n  {\"id\":713772,\"suggestedTranslation\":\"Ta rất biết ơn lớp chắn bảo vệ của cái cây này.\",\"rating\":9.0},\n  {\"id\":713773,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":10.0},\n  {\"id\":713774,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":10.0},\n  {\"id\":713775,\"suggestedTranslation\":\"Ái! Thật mất lịch sự!\",\"rating\":9.0},\n  {\"id\":713776,\"suggestedTranslation\":\"Ngươi nghĩ mình có thể đứng giữa ta và những nguyên liệu tươi ngon của ta sao, bạn hiền?\",\"rating\":9.0},\n  {\"id\":713777,\"suggestedTranslation\":\"Ở đây không có đủ tuyết!\",\"rating\":9.0},\n  {\"id\":713778,\"suggestedTranslation\":\"Ta sợ là nó không thể to hơn được nữa đâu.\",\"rating\":9.0},\n  {\"id\":713779,\"suggestedTranslation\":\"Ta ướt như một cái giẻ lau bát rồi!\",\"rating\":9.0},\n  {\"id\":713780,\"suggestedTranslation\":\"Ái!\",\"rating\":9.0},\n  {\"id\":713781,\"suggestedTranslation\":\"Xin chào! Bạn có nói tiếng Pháp không?\",\"rating\":9.0},\n  {\"id\":713782,\"suggestedTranslation\":\"Mong cho bạn lớn nhanh, chín mọng và thật ngon lành nhé.\",\"rating\":9.0},\n  {\"id\":713783,\"suggestedTranslation\":\"Trời ạ, trông bạn tươi như hoa hôm nay vậy, bạn hiền ơi!\",\"rating\":9.0},\n  {\"id\":713784,\"suggestedTranslation\":\"Bạn là một loài thực vật ngoan ngoãn làm sao.\",\"rating\":9.0},\n  {\"id\":713785,\"suggestedTranslation\":\"Hôm nay bạn thế nào rồi, bạn hiền? Mọi thứ vẫn lớn tốt chứ?\",\"rating\":9.0},\n  {\"id\":713786,\"suggestedTranslation\":\"Ái!\",\"rating\":9.0},\n  {\"id\":713787,\"suggestedTranslation\":\"Hết nhiên liệu rồi.\",\"rating\":9.0},\n  {\"id\":713788,\"suggestedTranslation\":\"Ta nghĩ có lẽ đã đến lúc nghỉ ngơi rồi. Tạm biệt nhé!\",\"rating\":9.0},\n  {\"id\":713789,\"suggestedTranslation\":\"Ôi trời, chắc đó là mạng sống thứ chín của nó mất...\",\"rating\":9.0},\n  {\"id\":713790,\"suggestedTranslation\":\"Ồ! Ngài có ngửi thấy mùi gì không, thưa ngài?\",\"rating\":9.0},\n  {\"id\":713791,\"suggestedTranslation\":\"À, có vẻ như nó đã mất dấu rồi.\",\"rating\":9.0},\n  {\"id\":713792,\"suggestedTranslation\":\"Ta có cảm giác chúng ta đang ở rất gần rồi.\",\"rating\":9.0},\n  {\"id\":713793,\"suggestedTranslation\":\"Có lẽ không có chú mèo nhỏ nào ở quanh đây để theo dấu đâu.\",\"rating\":9.0},\n  {\"id\":713794,\"suggestedTranslation\":\"Đi thôi, thưa ngài! Ta sẽ theo sát phía sau.\",\"rating\":9.0},\n  {\"id\":713795,\"suggestedTranslation\":\"Đợi một chút, ta đến đây!\",\"rating\":9.0},\n  {\"id\":713796,\"suggestedTranslation\":\"Nó chuẩn bị rời đi rồi kìa.\",\"rating\":9.0},\n  {\"id\":713797,\"suggestedTranslation\":\"Có phải do ta nói gì sai không nhỉ?\",\"rating\":9.0},\n  {\"id\":713798,\"suggestedTranslation\":\"Mọi thứ trơn tuột cả rồi...\",\"rating\":9.0},\n  {\"id\":713799,\"suggestedTranslation\":\"Không, thế này thì không ổn rồi...\",\"rating\":9.0},\n  {\"id\":713800,\"suggestedTranslation\":\"Quay lại đây, ánh sáng ơi!\",\"rating\":9.0},\n  {\"id\":713801,\"suggestedTranslation\":\"Xin chào! Ta đến nơi rồi đây!\",\"rating\":9.0},\n  {\"id\":713802,\"suggestedTranslation\":\"Chết tiệt!\",\"rating\":9.0},\n  {\"id\":713803,\"suggestedTranslation\":\"Nó vẫn chưa hoạt động được.\",\"rating\":9.0},\n  {\"id\":713804,\"suggestedTranslation\":\"Có vẻ như ta có vài phụ bếp bóng tối hỗ trợ rồi đây!\",\"rating\":9.0},\n  {\"id\":713805,\"suggestedTranslation\":\"Có lẽ có gì đó đã bị mất nghĩa trong bản dịch.\",\"rating\":9.0},\n  {\"id\":713806,\"suggestedTranslation\":\"Đất liền! Ta được cứu rồi!\",\"rating\":9.0},\n  {\"id\":713807,\"suggestedTranslation\":\"Thật đáng tiếc, ta nghĩ nó hỏng mất tiêu rồi.\",\"rating\":9.0},\n  {\"id\":713808,\"suggestedTranslation\":\"Ta cần thứ gì đó... bự con hơn!\",\"rating\":9.0},\n  {\"id\":713809,\"suggestedTranslation\":\"Trọng lượng: {weight}\",\"rating\":9.0},\n  {\"id\":713810,\"suggestedTranslation\":\"Trọng lượng: {weight}\\nĐủ cá để nuôi sống cả một đoàn thủy thủ!\",\"rating\":9.0},\n  {\"id\":713811,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":10.0},\n  {\"id\":713812,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":10.0},\n  {\"id\":713813,\"suggestedTranslation\":\"Ta đang sũng nước lên đây này.\",\"rating\":9.0},\n  {\"id\":713814,\"suggestedTranslation\":\"Ta sợ rằng mình có thể tan trong nước mất!\",\"rating\":9.0},\n  {\"id\":713815,\"suggestedTranslation\":\"Ái, suýt trúng!\",\"rating\":9.0},\n  {\"id\":713816,\"suggestedTranslation\":\"Có lẽ ta sẽ thử lại lần nữa.\",\"rating\":9.0},\n  {\"id\":713817,\"suggestedTranslation\":\"Chúa ơi, thế giới của ta đang bừng sáng kìa!\",\"rating\":9.0},\n  {\"id\":713818,\"suggestedTranslation\":\"Á không, nó kết thúc nhanh thế sao?\",\"rating\":9.0},\n  {\"id\":713819,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":713820,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":713821,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":713822,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":713823,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":713824,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":713825,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":713826,\"suggestedTranslation\":\"Chắc ta phải điên lắm mới đi du hành kiểu này...\",\"rating\":9.0},\n  {\"id\":713827,\"suggestedTranslation\":\"Hả? Gì thế nhỉ?\",\"rating\":9.0},\n  {\"id\":713828,\"suggestedTranslation\":\"Ta không thích âm thanh đó chút nào đâu.\",\"rating\":9.0},\n  {\"id\":713829,\"suggestedTranslation\":\"Ta có đi đâu thì vẫn cứ là ở đây.\",\"rating\":9.0},\n  {\"id\":713830,\"suggestedTranslation\":\"only_used_by_wx78\",\"rating\":10.0},\n  {\"id\":713831,\"suggestedTranslation\":\"À hay nha! Một kiểu trang phục bò lai mới!\",\"rating\":9.0},\n  {\"id\":713832,\"suggestedTranslation\":\"Có vẻ như ta đã trôi dạt hơi xa điểm xuất phát rồi.\",\"rating\":9.0},\n  {\"id\":713833,\"suggestedTranslation\":\"A! Làm gì có cuộc đua nào mà không có các trạm kiểm soát chứ!\",\"rating\":9.0},\n  {\"id\":713834,\"suggestedTranslation\":\"Có lẽ ta nên dọn ra một chút, nhỡ đâu có ai muốn ghé vào.\",\"rating\":9.0},\n  {\"id\":713835,\"suggestedTranslation\":\"Ta đoán là họ đang bận việc khác vào lúc này đấy!\",\"rating\":9.0},\n  {\"id\":713836,\"suggestedTranslation\":\"Bầy chim đang bay đến kìa!\",\"rating\":9.0},\n  {\"id\":713837,\"suggestedTranslation\":\"Ồ, thịt nai hươu đến rồi!\",\"rating\":9.0},\n  {\"id\":713838,\"suggestedTranslation\":\"Ta cũng là một tay đồ tể cừ khôi đấy nhé!\",\"rating\":9.0},\n  {\"id\":713839,\"suggestedTranslation\":\"Không một phần nào trên cơ thể ngươi bị bỏ phí đâu, heo con ạ!\",\"rating\":9.0},\n  {\"id\":713840,\"suggestedTranslation\":\"Trông ngươi ngon miệng quá đấy!\",\"rating\":9.0},\n  {\"id\":713841,\"suggestedTranslation\":\"Mong là trời đừng mưa sau khi ta kết liễu ngươi!\",\"rating\":9.0},\n  {\"id\":713842,\"suggestedTranslation\":\"Ngươi sẽ phải bỏ mạng thôi, đồ sâu bọ!\",\"rating\":9.0},\n  {\"id\":713843,\"suggestedTranslation\":\"Bỏ chạy thì có gì mà xấu hổ chứ!\",\"rating\":9.0},\n  {\"id\":713844,\"suggestedTranslation\":\"Khônggggg, những chiếc giò heo đó, những miếng sườn đó...\",\"rating\":9.0},\n  {\"id\":713845,\"suggestedTranslation\":\"Hà... ta hết hơi rồi đây.\",\"rating\":9.0},\n  {\"id\":713846,\"suggestedTranslation\":\"Mong là nó không cắn miếng nào trên người ta.\",\"rating\":9.0},\n  {\"id\":713847,\"suggestedTranslation\":\"Mọi chuyện suýt thì tệ hơn rồi đấy.\",\"rating\":9.0},\n  {\"id\":713848,\"suggestedTranslation\":\"Bonjour, Tiểu thư Abigail!\",\"rating\":9.0},\n  {\"id\":713849,\"suggestedTranslation\":\"Bonjour, Tiểu thư Abigail!\",\"rating\":9.0},\n  {\"id\":713850,\"suggestedTranslation\":\"Bonjour, Tiểu thư Abigail!\",\"rating\":9.0},\n  {\"id\":713851,\"suggestedTranslation\":\"Bonjour, Tiểu thư Abigail!\",\"rating\":9.0},\n  {\"id\":713852,\"suggestedTranslation\":\"Bonjour, Tiểu thư Abigail!\",\"rating\":9.0},\n  {\"id\":713853,\"suggestedTranslation\":\"Bonjour, Tiểu thư Abigail!\",\"rating\":9.0},\n  {\"id\":713854,\"suggestedTranslation\":\"Ta không nghĩ nó ăn được đâu.\",\"rating\":9.0},\n  {\"id\":713855,\"suggestedTranslation\":\"Giờ sao nữa đây, Tiểu thư Wendy?\",\"rating\":9.0},\n  {\"id\":713856,\"suggestedTranslation\":\"Ta nghĩ việc giữ cái này không phải việc của mình.\",\"rating\":9.0},\n  {\"id\":713857,\"suggestedTranslation\":\"Có cái gì đó đang cựa quậy bên trong.\",\"rating\":9.0},\n  {\"id\":713858,\"suggestedTranslation\":\"Bonjour? Có ai ở đó không?\",\"rating\":9.0},\n  {\"id\":713859,\"suggestedTranslation\":\"À, hôm nay trông bông hoa nhỏ có vẻ rất khỏe khoắn đấy!\",\"rating\":9.0},\n  {\"id\":713860,\"suggestedTranslation\":\"Có cái gì đó đang cựa quậy bên trong.\",\"rating\":9.0},\n  {\"id\":713861,\"suggestedTranslation\":\"Ta nghĩ nó đang tỉnh dậy rồi đấy.\",\"rating\":9.0},\n  {\"id\":713862,\"suggestedTranslation\":\"Ta có cảm giác sắp có chuyện xảy ra rồi.\",\"rating\":9.0},\n  {\"id\":713863,\"suggestedTranslation\":\"Ngươi đang đi đâu thế hả?!\",\"rating\":9.0},\n  {\"id\":713864,\"suggestedTranslation\":\"Đúng là bức tượng đe dọa làm sao!\",\"rating\":9.0},\n  {\"id\":713865,\"suggestedTranslation\":\"Liệu chiếc két sắt đó có an toàn không?\",\"rating\":9.0},\n  {\"id\":713866,\"suggestedTranslation\":\"Ta vẫn luôn ao ước tạo dựng được tên tuổi cho chính mình.\",\"rating\":9.0},\n  {\"id\":713867,\"suggestedTranslation\":\"Nó phát ra tiếng lục cục.\",\"rating\":9.0},\n  {\"id\":713868,\"suggestedTranslation\":\"Món này có thể cho thêm chút gì đó... Bất cứ thứ gì cũng được.\",\"rating\":9.0},\n  {\"id\":713869,\"suggestedTranslation\":\"Chỉ là một bé cưng tí xíu thôi.\",\"rating\":9.0},\n  {\"id\":713870,\"suggestedTranslation\":\"Lại trò quỷ quái tươi mới nào thế này?\",\"rating\":9.0},\n  {\"id\":713871,\"suggestedTranslation\":\"Nó làm ta nghe thấy những lời thì thầm ngọt ngào làm sao...\",\"rating\":9.0},\n  {\"id\":713872,\"suggestedTranslation\":\"Nó đã bị đập vụn về các nguyên liệu cơ bản rồi.\",\"rating\":9.0},\n  {\"id\":713873,\"suggestedTranslation\":\"Nó đang ngấu nghiến toàn bộ năng lượng kìa!\",\"rating\":9.0},\n  {\"id\":713874,\"suggestedTranslation\":\"Au revoir.\",\"rating\":9.0},\n  {\"id\":713875,\"suggestedTranslation\":\"Trông nó có vẻ khá là bực bội đấy...\",\"rating\":9.0},\n  {\"id\":713876,\"suggestedTranslation\":\"Phiên bản mới cải tiến! Thật kinh khủng!\",\"rating\":9.0},\n  {\"id\":713877,\"suggestedTranslation\":\"Đó là thứ rực rỡ nhất mà ta từng thấy đấy!\",\"rating\":9.0},\n  {\"id\":713878,\"suggestedTranslation\":\"Cuối cùng thì nó cũng xong. Hoặc là chưa nhỉ...\",\"rating\":9.0},\n  {\"id\":713879,\"suggestedTranslation\":\"Chúa ơi, món thứ hai đây sao!\",\"rating\":9.0},\n  {\"id\":713880,\"suggestedTranslation\":\"Ta sẽ không để bị xiên bởi kẻ như ngươi đâu!\",\"rating\":9.0},\n  {\"id\":713881,\"suggestedTranslation\":\"Ta thà không bị nướng chín bởi cái ánh nhìn rực lửa đó đâu!\",\"rating\":9.0},\n  {\"id\":713882,\"suggestedTranslation\":\"Cuối cùng thì, mọi chuyện cũng kết thúc.\",\"rating\":9.0},\n  {\"id\":713883,\"suggestedTranslation\":\"Liệu vẫn còn điều gì đang chờ đón chúng ta nữa không?\",\"rating\":9.0},\n  {\"id\":713884,\"suggestedTranslation\":\"Tốt nhất là cứ đứng tránh xa mấy thứ đó ra, nhỉ?\",\"rating\":9.0},\n  {\"id\":713885,\"suggestedTranslation\":\"Thật là kinh khủng!\",\"rating\":9.0},\n  {\"id\":713886,\"suggestedTranslation\":\"Ta đang đeo sự an toàn trên người đây.\",\"rating\":9.0},\n  {\"id\":713887,\"suggestedTranslation\":\"Giờ thì ngươi phải đứng yên đấy nhé!\",\"rating\":9.0},\n  {\"id\":713888,\"suggestedTranslation\":\"Trông giống như công thức làm dây neo vậy.\",\"rating\":9.0},\n  {\"id\":713889,\"suggestedTranslation\":\"Ta tự hỏi liệu có thể nấu được một loại quả bằng đá như thế này không nhỉ?\",\"rating\":9.0},\n  {\"id\":713890,\"suggestedTranslation\":\"Ta nghĩ là... mình có thể đã mất cảm giác thèm ăn rồi.\",\"rating\":9.0},\n  {\"id\":713891,\"suggestedTranslation\":\"Khá hơn rồi, nhưng giờ nó lại thiếu đi một chút điểm nhấn khó tả đó.\",\"rating\":9.0},\n  {\"id\":713892,\"suggestedTranslation\":\"Có cái gì đang nấu bên trong đấy à?\",\"rating\":9.0},\n  {\"id\":713893,\"suggestedTranslation\":\"Chỉ còn trơ lại mỗi cái gốc cây.\",\"rating\":9.0},\n  {\"id\":713894,\"suggestedTranslation\":\"Trông không hẳn là một cái cây thân thiện cho lắm nhỉ?\",\"rating\":9.0},\n  {\"id\":713895,\"suggestedTranslation\":\"Chỉ còn trơ lại mỗi cái gốc cây.\",\"rating\":9.0},\n  {\"id\":713896,\"suggestedTranslation\":\"Chỉ là một bé cưng tí xíu thôi.\",\"rating\":9.0},\n  {\"id\":713897,\"suggestedTranslation\":\"À, có lẽ nó chưa đến mùa.\",\"rating\":9.0},\n  {\"id\":713898,\"suggestedTranslation\":\"Đất này có vẻ không hợp với sở thích của nó lắm.\",\"rating\":9.0},\n  {\"id\":713899,\"suggestedTranslation\":\"Đi nào! Ta không thể cứ để cái cây nhỏ bị bứng gốc thế này được!\",\"rating\":9.0},\n  {\"id\":713900,\"suggestedTranslation\":\"Ta tự hỏi nó sẽ phát triển thành cái gì đây?\",\"rating\":9.0},\n  {\"id\":713901,\"suggestedTranslation\":\"Một công trình từ thời cổ đại.\",\"rating\":9.0},\n  {\"id\":713902,\"suggestedTranslation\":\"Nó bị hỏng rồi.\",\"rating\":9.0},\n  {\"id\":713903,\"suggestedTranslation\":\"Kinh khủng thật!\",\"rating\":9.0},\n  {\"id\":713904,\"suggestedTranslation\":\"Nó tỏa ra những rung động kỳ lạ.\",\"rating\":9.0},\n  {\"id\":713905,\"suggestedTranslation\":\"Những dấu vết này chỉ đến con mồi mới.\",\"rating\":9.0},\n  {\"id\":713906,\"suggestedTranslation\":\"Hmm, bạn sẽ rất tuyệt vời trong một món súp đấy!\",\"rating\":9.0},\n  {\"id\":713907,\"suggestedTranslation\":\"Ta nghĩ nó rất thân thiện.\",\"rating\":9.0},\n  {\"id\":713908,\"suggestedTranslation\":\"Ôi không, đừng giận mà.\",\"rating\":9.0},\n  {\"id\":713909,\"suggestedTranslation\":\"Cuộc sống lúc này thật tuyệt vời.\",\"rating\":9.0},\n  {\"id\":713910,\"suggestedTranslation\":\"Quý cô Kiến Sư Tử thật tốt bụng khi chia sẻ công thức này đấy.\",\"rating\":9.0},\n  {\"id\":713911,\"suggestedTranslation\":\"Ta nghĩ mình biết ai sẽ muốn thứ này đấy.\",\"rating\":9.0},\n  {\"id\":713912,\"suggestedTranslation\":\"Xin lỗi nhé, làm phiền bạn nha!\",\"rating\":9.0},\n  {\"id\":713913,\"suggestedTranslation\":\"Hừm, hình như nó thiếu một chiếc chìa khóa quan trọng thì phải.\",\"rating\":9.0},\n  {\"id\":713914,\"suggestedTranslation\":\"Bi kịch thật đấy.\",\"rating\":9.0},\n  {\"id\":713915,\"suggestedTranslation\":\"Một kiệt tác thì cần phải có thời gian.\",\"rating\":9.0},\n  {\"id\":713916,\"suggestedTranslation\":\"Sắp xong rồi...\",\"rating\":9.0},\n  {\"id\":713917,\"suggestedTranslation\":\"À ha, xong rồi!\",\"rating\":9.0},\n  {\"id\":713918,\"suggestedTranslation\":\"Những người từng sống ở đây có gu dùng dụng cụ nhà bếp khá tốt đấy.\",\"rating\":9.0},\n  {\"id\":713919,\"suggestedTranslation\":\"Có lẽ nó chứa một công thức cổ xưa nào đó.\",\"rating\":9.0},\n  {\"id\":713920,\"suggestedTranslation\":\"Ta tự hỏi cỗ máy này sẽ nấu cho chúng ta món gì đây.\",\"rating\":9.0},\n  {\"id\":713921,\"suggestedTranslation\":\"Trông có vẻ như nó đã không được sử dụng từ rất lâu rồi.\",\"rating\":9.0},\n  {\"id\":713922,\"suggestedTranslation\":\"Họ có vẻ đánh giá rất cao mặt trăng.\",\"rating\":9.0},\n  {\"id\":713923,\"suggestedTranslation\":\"Đúng là một điều bí ẩn đối với ta.\",\"rating\":9.0},\n  {\"id\":713924,\"suggestedTranslation\":\"À, ta không nên đặt quá nhiều kỳ vọng thì hơn.\",\"rating\":9.0},\n  {\"id\":713925,\"suggestedTranslation\":\"Liệu đây có phải là con đường để về nhà không?\",\"rating\":9.0},\n  {\"id\":713926,\"suggestedTranslation\":\"Để xem thứ này đưa chúng ta đi đâu nào, nhỉ?\",\"rating\":9.0},\n  {\"id\":713927,\"suggestedTranslation\":\"Mọi chuyện đã kết thúc.\",\"rating\":9.0},\n  {\"id\":713928,\"suggestedTranslation\":\"Ta đã nấu nó lên với một chút kiến thức cổ xưa.\",\"rating\":9.0},\n  {\"id\":713929,\"suggestedTranslation\":\"Ta e là ý nghĩa của nó vượt quá sự hiểu biết của ta rồi.\",\"rating\":9.0},\n  {\"id\":713930,\"suggestedTranslation\":\"Biết bao nhiêu bí mật đã bị thời gian chôn vùi.\",\"rating\":9.0},\n  {\"id\":713931,\"suggestedTranslation\":\"Ta e là ý nghĩa của nó vượt quá sự hiểu biết của ta rồi.\",\"rating\":9.0},\n  {\"id\":713932,\"suggestedTranslation\":\"Biết bao nhiêu bí mật đã bị thời gian chôn vùi.\",\"rating\":9.0},\n  {\"id\":713933,\"suggestedTranslation\":\"Ta e là ý nghĩa của nó vượt quá sự hiểu biết của ta rồi.\",\"rating\":9.0},\n  {\"id\":713934,\"suggestedTranslation\":\"Thật kỳ lạ làm sao!\",\"rating\":9.0},\n  {\"id\":713935,\"suggestedTranslation\":\"Nó thật yên tĩnh.\",\"rating\":9.0},\n  {\"id\":713936,\"suggestedTranslation\":\"Thật đẹp làm sao! Ta tự hỏi nó đang đi đâu thế nhỉ?\",\"rating\":9.0},\n  {\"id\":713937,\"suggestedTranslation\":\"Nó thiếu mất một chiếc chìa khóa quan trọng rồi.\",\"rating\":9.0}\n]",
