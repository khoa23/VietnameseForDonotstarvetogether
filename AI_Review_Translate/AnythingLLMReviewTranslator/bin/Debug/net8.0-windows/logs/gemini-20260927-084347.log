            "text": "[\n  {\"id\": 710638, \"suggestedTranslation\": \"Tôi nghi ngờ chúng được giữ lại với nhau bằng ma thuật nhiều hơn là sự khéo léo.\", \"rating\": 0.0},\n  {\"id\": 710639, \"suggestedTranslation\": \"Không thấy một cái bánh răng hay con lắc nào cả. Thật đáng xấu hổ!\", \"rating\": 0.0},\n  {\"id\": 710640, \"suggestedTranslation\": \"Nó không đi đâu được đâu. Tôi có thể xem xét sau.\", \"rating\": 0.0},\n  {\"id\": 710641, \"suggestedTranslation\": \"Đúng rồi. Lần đó tôi suýt bị gai đâm xiên người.\", \"rating\": 0.0},\n  {\"id\": 710642, \"suggestedTranslation\": \"Không phải là một trong những ký ức đẹp nhất của tôi.\", \"rating\": 0.0},\n  {\"id\": 710643, \"suggestedTranslation\": \"Ồ, tuyệt thật. Nó còn tệ hơn những gì tôi nhớ.\", \"rating\": 0.0},\n  {\"id\": 710644, \"suggestedTranslation\": \"Một con thật sự trông sẽ thú vị hơn một chút.\", \"rating\": 0.0},\n  {\"id\": 710645, \"suggestedTranslation\": \"Cái này sẽ nhắc nhở tôi đừng có táy máy chọc ngoáy vào tổ ong.\", \"rating\": 0.0},\n  {\"id\": 710646, \"suggestedTranslation\": \"Tôi đoán là có một bàn cờ lớn ở đâu đó gần đây.\", \"rating\": 0.0},\n  {\"id\": 710647, \"suggestedTranslation\": \"Chuyện gì đang xảy ra vậy? Không thể nào!\", \"rating\": 0.0},\n  {\"id\": 710648, \"suggestedTranslation\": \"Vẻ đẹp của nó đã được lưu giữ mãi mãi.\", \"rating\": 0.0},\n  {\"id\": 710649, \"suggestedTranslation\": \"Tôi không nghĩ cái này đáng để làm một bức tượng.\", \"rating\": 0.0},\n  {\"id\": 710650, \"suggestedTranslation\": \"Tôi đoán rốt cuộc mình cũng có thời gian chơi với bạn.\", \"rating\": 0.0},\n  {\"id\": 710651, \"suggestedTranslation\": \"Chà, nó chưa sống lại. Mọi thứ vẫn ổn.\", \"rating\": 0.0},\n  {\"id\": 710652, \"suggestedTranslation\": \"Tôi hy vọng chuyện này sẽ không quay lại cắn mình.\", \"rating\": 0.0},\n  {\"id\": 710653, \"suggestedTranslation\": \"Ồ đúng rồi, tôi nhớ rồi. Tôi suýt chết đuối.\", \"rating\": 0.0},\n  {\"id\": 710654, \"suggestedTranslation\": \"À phải rồi, sao tôi có thể quên cái lần mình suýt bị đập thành mảnh vụn chứ?\", \"rating\": 0.0},\n  {\"id\": 710655, \"suggestedTranslation\": \"Một gương mặt quen thuộc mà tôi ước gì mình có thể quên sớm hơn.\", \"rating\": 0.0},\n  {\"id\": 710656, \"suggestedTranslation\": \"Tôi sẽ rất vui nếu không bao giờ phải gặp lại nó nữa.\", \"rating\": 0.0},\n  {\"id\": 710657, \"suggestedTranslation\": \"Đúng là một chủ đề khó chịu cho một bức tượng.\", \"rating\": 0.0},\n  {\"id\": 710658, \"suggestedTranslation\": \"Và tôi vừa kịp quên mất bạn đấy.\", \"rating\": 0.0},\n  {\"id\": 710659, \"suggestedTranslation\": \"Một đài tưởng niệm cho một ngày vô cùng mệt mỏi.\", \"rating\": 0.0},\n  {\"id\": 710660, \"suggestedTranslation\": \"Quả là một con mắt đáng chiêm ngưỡng.\", \"rating\": 0.0},\n  {\"id\": 710661, \"suggestedTranslation\": \"Trông có vẻ như hắn cũng mất đầu rồi.\", \"rating\": 0.0},\n  {\"id\": 710662, \"suggestedTranslation\": \"Tôi hy vọng mình sẽ không phải làm lại chuyện đó lần nữa.\", \"rating\": 0.0},\n  {\"id\": 710663, \"suggestedTranslation\": \"Tôi cảm thấy như chúng ta đang bị chế nhạo vậy.\", \"rating\": 0.0},\n  {\"id\": 710664, \"suggestedTranslation\": \"Ồ, một bức tượng cao chênh vênh, chuyện gì có thể xảy ra cơ chứ?\", \"rating\": 0.0},\n  {\"id\": 710665, \"suggestedTranslation\": \"Tại sao tôi lại muốn nhớ đến hắn ta chứ?\", \"rating\": 0.0},\n  {\"id\": 710666, \"suggestedTranslation\": \"Nó trông giống một quân cờ vua quá khổ.\", \"rating\": 0.0},\n  {\"id\": 710667, \"suggestedTranslation\": \"Chuyện gì đang xảy ra vậy? Không thể nào!\", \"rating\": 0.0},\n  {\"id\": 710668, \"suggestedTranslation\": \"Tại sao lại có nhiều bức tượng khó chịu đến thế?\", \"rating\": 0.0},\n  {\"id\": 710669, \"suggestedTranslation\": \"Tôi cho rằng đó không phải là trò tiêu khiển khó chịu nhất.\", \"rating\": 0.0},\n  {\"id\": 710670, \"suggestedTranslation\": \"Điều này sẽ giúp tôi nhớ đừng mạo hiểm đi quá sâu vào các hang động...\", \"rating\": 0.0},\n  {\"id\": 710671, \"suggestedTranslation\": \"Chỉ cần nhìn lên trên nếu bạn muốn thấy mặt trăng. Thực ra, tốt nhất là không nên.\", \"rating\": 0.0},\n  {\"id\": 710672, \"suggestedTranslation\": \"Ồ tốt quá, lại gợi nhắc về một cuộc chạm trán khó chịu khác.\", \"rating\": 0.0},\n  {\"id\": 710673, \"suggestedTranslation\": \"Cô ấy đã đi và đánh rơi cái đầu của mình.\", \"rating\": 0.0},\n  {\"id\": 710674, \"suggestedTranslation\": \"Ngay cả một con tốt bình thường cũng có thể trở nên mạnh mẽ nếu đủ khôn ngoan.\", \"rating\": 0.0},\n  {\"id\": 710675, \"suggestedTranslation\": \"Một bức tranh tĩnh vật. Thật là cuốn hút làm sao.\", \"rating\": 0.0},\n  {\"id\": 710676, \"suggestedTranslation\": \"Ai đã điêu khắc ra những thứ này vậy?\", \"rating\": 0.0},\n  {\"id\": 710677, \"suggestedTranslation\": \"Chuyện gì đang xảy ra vậy? Không thể nào!\", \"rating\": 0.0},\n  {\"id\": 710678, \"suggestedTranslation\": \"Làm sao tôi có thể quên được tên du côn này chứ?\", \"rating\": 0.0},\n  {\"id\": 710679, \"suggestedTranslation\": \"Vẫn thật đáng sợ.\", \"rating\": 0.0},\n  {\"id\": 710680, \"suggestedTranslation\": \"Những ký ức thật vui về việc suýt bị một con cóc khổng lồ giết chết.\", \"rating\": 0.0},\n  {\"id\": 710681, \"suggestedTranslation\": \"Tôi sẽ rất vui nếu không bao giờ phải nhìn thấy chúng thêm lần nào nữa.\", \"rating\": 0.0},\n  {\"id\": 710682, \"suggestedTranslation\": \"Tôi sẽ không sớm quên được tên thô lỗ này đâu.\", \"rating\": 0.0},\n  {\"id\": 710683, \"suggestedTranslation\": \"Chúng ta không thể để con quái vật này lại trong quá khứ sao?\", \"rating\": 0.0},\n  {\"id\": 710684, \"suggestedTranslation\": \"Chúng ta có thực sự cần phải gợi nhắc về thứ này không?\", \"rating\": 0.0},\n  {\"id\": 710685, \"suggestedTranslation\": \"Đó là một ký ức mà tôi rất vui nếu không phải ôn lại.\", \"rating\": 0.0},\n  {\"id\": 710686, \"suggestedTranslation\": \"Tốt hơn là không nên trải lại cảm giác này.\", \"rating\": 0.0},\n  {\"id\": 710687, \"suggestedTranslation\": \"Trở lại nơi mọi chuyện bắt đầu... dù sao thì cũng là cuộc đua thuyền ván.\", \"rating\": 8.5},\n  {\"id\": 710688, \"suggestedTranslation\": \"Tôi có những cảm xúc lẫn lộn về cái này.\", \"rating\": 0.0},\n  {\"id\": 710689, \"suggestedTranslation\": \"Và tôi vừa kịp quên mất bạn đấy.\", \"rating\": 0.0},\n  {\"id\": 710690, \"suggestedTranslation\": \"Được rồi, được rồi, mày rất dễ thương. Chỉ là hãy cẩn thận với đồ đạc của ta nhé.\", \"rating\": 0.0},\n  {\"id\": 710691, \"suggestedTranslation\": \"Mày có bao giờ chớp mắt không thế?\", \"rating\": 0.0},\n  {\"id\": 710692, \"suggestedTranslation\": \"Nó ngủ gật rồi à?\", \"rating\": 0.0},\n  {\"id\": 710693, \"suggestedTranslation\": \"Thêm không gian luôn được chào đón, nhưng có thêm thời gian thì tuyệt hơn.\", \"rating\": 0.0},\n  {\"id\": 710694, \"suggestedTranslation\": \"Hoàn toàn không đáng để liếc nhìn đâu!\", \"rating\": 0.0},\n  {\"id\": 710695, \"suggestedTranslation\": \"Cho cá ăn trước khi chúng ăn mình là điều công bằng mà.\", \"rating\": 8.5},\n  {\"id\": 710696, \"suggestedTranslation\": \"Tôi thực sự mong là nó có thể dễ vỡ hơn một chút!\", \"rating\": 0.0},\n  {\"id\": 710697, \"suggestedTranslation\": \"Đó là một sự cố thờigian, hay bức tượng vừa mới chuyển động vậy?\", \"rating\": 0.0},\n  {\"id\": 710698, \"suggestedTranslation\": \"Không phải tượng đâu nhé!!\", \"rating\": 0.0},\n  {\"id\": 710699, \"suggestedTranslation\": \"May mắn thay, nó chỉ là một bức tượng.\", \"rating\": 0.0},\n  {\"id\": 710700, \"suggestedTranslation\": \"Tôi cần phải cho nó thứ gì đó để đốt, nhanh lên!\", \"rating\": 0.0},\n  {\"id\": 710701, \"suggestedTranslation\": \"Nó giúp xua đuổi bóng tối.\", \"rating\": 0.0},\n  {\"id\": 710702, \"suggestedTranslation\": \"Ôi phiền phức thật, tôi lỡ tay cho quá nhiều củi mồi rồi!\", \"rating\": 0.0},\n  {\"id\": 710703, \"suggestedTranslation\": \"Nó cần thêm thứ để đốt nếu tôi muốn nó cháy lâu hơn.\", \"rating\": 0.0},\n  {\"id\": 710704, \"suggestedTranslation\": \"Đỡ hơn rồi đấy.\", \"rating\": 0.0},\n  {\"id\": 710705, \"suggestedTranslation\": \"Thế là cũng vui trong chốc lát.\", \"rating\": 0.0},\n  {\"id\": 710706, \"suggestedTranslation\": \"Tôi cần phải cho nó thứ gì đó để đốt, nhanh lên!\", \"rating\": 0.0},\n  {\"id\": 710707, \"suggestedTranslation\": \"Nó giúp xua đuổi bóng tối.\", \"rating\": 0.0},\n  {\"id\": 710708, \"suggestedTranslation\": \"Ôi phiền phức thật, tôi lỡ tay cho quá nhiều củi mồi rồi!\", \"rating\": 0.0},\n  {\"id\": 710709, \"suggestedTranslation\": \"Nó cần thêm thứ để đốt nếu tôi muốn nó cháy lâu hơn.\", \"rating\": 0.0},\n  {\"id\": 710710, \"suggestedTranslation\": \"Đỡ hơn rồi đấy.\", \"rating\": 0.0},\n  {\"id\": 710711, \"suggestedTranslation\": \"Tôi có thể nhóm nó lại ngay lập tức chẳng tốn chút thời gian nào.\", \"rating\": 0.0},\n  {\"id\": 710712, \"suggestedTranslation\": \"Sửa lại chỉ tổ phí thời gian nếu có ai đó lại phá nát nó lần nữa.\", \"rating\": 0.0},\n  {\"id\": 710713, \"suggestedTranslation\": \"Phía Đông. Chắc chắn là phía Đông rồi!\", \"rating\": 0.0},\n  {\"id\": 710714, \"suggestedTranslation\": \"Giá như nó có thể cho tôi biết hướng nào là quá khứ và hướng nào là tương lai.\", \"rating\": 0.0},\n  {\"id\": 710715, \"suggestedTranslation\": \"Phía Bắc. Đó là \\\"lên\\\" trên bản đồ phải không?\", \"rating\": 0.0},\n  {\"id\": 710716, \"suggestedTranslation\": \"Đông Bắc. Tôi nghĩ vậy.\", \"rating\": 0.0},\n  {\"id\": 710717, \"suggestedTranslation\": \"Tây Bắc. Có lẽ thế?\", \"rating\": 0.0},\n  {\"id\": 710718, \"suggestedTranslation\": \"Phía Nam. Đó là \\\"xuống\\\" trên bản đồ phải không?\", \"rating\": 0.0},\n  {\"id\": 710719, \"suggestedTranslation\": \"Đông Nam. Chắc là vậy.\", \"rating\": 0.0},\n  {\"id\": 710720, \"suggestedTranslation\": \"Tây Nam. Hoặc không, ai mà biết được chứ?\", \"rating\": 0.0},\n  {\"id\": 710721, \"suggestedTranslation\": \"Phía Tây. Hướng đó là bên trái đúng không?\", \"rating\": 0.0},\n  {\"id\": 710722, \"suggestedTranslation\": \"Ít ra thì tôi cũng không phải chạm tay vào nó.\", \"rating\": 0.0},\n  {\"id\": 710723, \"suggestedTranslation\": \"Hoàn hảo! Mong là tôi có thể nhớ cách mình đã làm...\", \"rating\": 0.0},\n  {\"id\": 710724, \"suggestedTranslation\": \"Đúng là một đống hỗn độn...\", \"rating\": 0.0},\n  {\"id\": 710725, \"suggestedTranslation\": \"Ồ. Nó khô hơn tôi tưởng rất nhiều.\", \"rating\": 0.0},\n  {\"id\": 710726, \"suggestedTranslation\": \"Chuyện này sẽ còn kéo dài đến bao giờ nữa chứ?\", \"rating\": 0.0},\n  {\"id\": 710727, \"suggestedTranslation\": \"Ôi phiền phức thật, nó đã biến thành một đống bùn nhão nhoét rồi!\", \"rating\": 0.0},\n  {\"id\": 710728, \"suggestedTranslation\": \"Mỗi người một sở thích.\", \"rating\": 0.0},\n  {\"id\": 710729, \"suggestedTranslation\": \"Can thiệp thêm một chút thì có hại gì đâu cơ chứ?\", \"rating\": 0.0},\n  {\"id\": 710730, \"suggestedTranslation\": \"Nấu ăn tốn thời gian thật đấy, nhìn đống nguyên liệu và cách chế biến kìa!\", \"rating\": 0.0},\n  {\"id\": 710731, \"suggestedTranslation\": \"Đó là vấn đề sinh tồn.\", \"rating\": 0.0},\n  {\"id\": 710732, \"suggestedTranslation\": \"Được rồi, tôi đoán việc bỏ thời gian nấu chín nó là hoàn toàn xứng đáng.\", \"rating\": 0.0},\n  {\"id\": 710733, \"suggestedTranslation\": \"Không hiểu sao việc nấu chín vẫn chẳng làm nó ngon hơn mấy.\", \"rating\": 0.0},\n  {\"id\": 710734, \"suggestedTranslation\": \"Ít ra thì cũng đủ để cầm cự qua ngày lúc này.\", \"rating\": 0.0},\n  {\"id\": 710735, \"suggestedTranslation\": \"Uầy, mấy thứ đó làm tôi nổi hết cả da gà.\", \"rating\": 0.0},\n  {\"id\": 710736, \"suggestedTranslation\": \"Nếu bạn lùi lại một khoảng khá xa và nheo mắt lại, trông nó gần như hợp thời trang.\", \"rating\": 0.0},\n  {\"id\": 710737, \"suggestedTranslation\": \"Cẩn thận gai nhọn đấy.\", \"rating\": 0.0},\n  {\"id\": 710738, \"suggestedTranslation\": \"Bất cứ thứ gì được viết ở đây đều đã bị thời gian xóa nhòa.\", \"rating\": 0.0},\n  {\"id\": 710739, \"suggestedTranslation\": \"Chà, lại một cú thụt lùi nữa.\", \"rating\": 0.0},\n  {\"id\": 710740, \"suggestedTranslation\": \"Đây là lý do tại sao tôi ghét nấu ăn. Nấu ăn mất cả thế kỷ!\", \"rating\": 0.0},\n  {\"id\": 710741, \"suggestedTranslation\": \"Đến giờ chắc nó phải gần chín rồi chứ nhỉ?\", \"rating\": 0.0},\n  {\"id\": 710742, \"suggestedTranslation\": \"Cuối cùng thì cũng có đồ ăn!\", \"rating\": 0.0},\n  {\"id\": 710743, \"suggestedTranslation\": \"Chắc tôi sẽ... kiếm ít hạt để ăn tạm vậy.\", \"rating\": 8.5},\n  {\"id\": 710744, \"suggestedTranslation\": \"Tôi biết đống chất nhầy sủi bọt đó có công dụng mà.\", \"rating\": 0.0},\n  {\"id\": 710745, \"suggestedTranslation\": \"Tôi đã làm những gì mình phải làm.\", \"rating\": 0.0},\n  {\"id\": 710746, \"suggestedTranslation\": \"Điểm hay của ngô là bạn chẳng cần phải bận tâm nấu nướng gì cả.\", \"rating\": 8.5},\n  {\"id\": 710747, \"suggestedTranslation\": \"Giá mà có thêm chút bơ thì tuyệt.\", \"rating\": 8.5},\n  {\"id\": 710748, \"suggestedTranslation\": \"Tôi chưa từng nghĩ ngô lại có thể sặc sỡ đến thế.\", \"rating\": 8.5},\n  {\"id\": 710749, \"suggestedTranslation\": \"Tại sao phải tốn thời gian trồng chúng trong khi tôi có thể ăn luôn bây giờ?\", \"rating\": 0.0},\n  {\"id\": 710750, \"suggestedTranslation\": \"Trông có vẻ như nó thuộc về một thợ rèn.\", \"rating\": 0.0},\n  {\"id\": 710751, \"suggestedTranslation\": \"Cái gì thế này? Một chiếc váy búp bê ngoại cỡ à?\", \"rating\": 0.0},\n  {\"id\": 710752, \"suggestedTranslation\": \"Trông có vẻ như nó thuộc về một tên hề.\", \"rating\": 0.0},\n  {\"id\": 710753, \"suggestedTranslation\": \"Trông có vẻ như nó thuộc về một vị Vua.\", \"rating\": 0.0},\n  {\"id\": 710754, \"suggestedTranslation\": \"Có cái gì đó về bộ trang phục này khiến tôi thấy không ổn lắm.\", \"rating\": 0.0},\n  {\"id\": 710755, \"suggestedTranslation\": \"Một bộ đồ khá lộng lẫy cho một con ngựa.\", \"rating\": 0.0},\n  {\"id\": 710756, \"suggestedTranslation\": \"Trông có vẻ như nó thuộc về một Nữ hoàng.\", \"rating\": 0.0},\n  {\"id\": 710757, \"suggestedTranslation\": \"Trông giống như một... y phục cái cây nhỉ?\", \"rating\": 8.5},\n  {\"id\": 710758, \"suggestedTranslation\": \"Trông có vẻ hơi lạc lõng phải không?\", \"rating\": 0.0},\n  {\"id\": 710759, \"suggestedTranslation\": \"Tôi đoán nó tạo ra một ngọn lửa nhỏ khá ấm cúng đấy.\", \"rating\": 8.5},\n  {\"id\": 710760, \"suggestedTranslation\": \"Trông có vẻ hơi lạc lõng phải không?\", \"rating\": 0.0},\n  {\"id\": 710761, \"suggestedTranslation\": \"Đúng là một bức tượng nhỏ đáng yêu.\", \"rating\": 0.0},\n  {\"id\": 710762, \"suggestedTranslation\": \"Trông có vẻ hơi lạc lõng phải không?\", \"rating\": 0.0},\n  {\"id\": 710763, \"suggestedTranslation\": \"Tôi đoán mình có thể ở lại ngắm nó, chỉ một hoặc hai phút thôi.\", \"rating\": 0.0},\n  {\"id\": 710764, \"suggestedTranslation\": \"Đi nhầm đường à nhóc?\", \"rating\": 0.0},\n  {\"id\": 710765, \"suggestedTranslation\": \"Bộ ngươi không còn việc gì quan trọng hơn để làm ngoài việc nằm ì ra đấy à?\", \"rating\": 0.0},\n  {\"id\": 710766, \"suggestedTranslation\": \"À! Mi đây rồi, đồ cua già!\", \"rating\": 0.0},\n  {\"id\": 710767, \"suggestedTranslation\": \"Hừm, không phải trên đó phải có đá quý sao? Hay là chuyện đó tính sau...\", \"rating\": 0.0},\n  {\"id\": 710768, \"suggestedTranslation\": \"Lắm chuyện phức tạp thật!\", \"rating\": 0.0},\n  {\"id\": 710769, \"suggestedTranslation\": \"Tránh xa ta ra với mấy cái kìm to tướng đó nhé!\", \"rating\": 0.0},\n  {\"id\": 710770, \"suggestedTranslation\": \"Tôi sẽ không để nó làm mình chậm lại đâu.\", \"rating\": 0.0},\n  {\"id\": 710771, \"suggestedTranslation\": \"Đừng có tốn thời gian của tôi nữa, đồ cua!\", \"rating\": 0.0},\n  {\"id\": 710772, \"suggestedTranslation\": \"Còn nhớ ta chứ?\", \"rating\": 0.0},\n  {\"id\": 710773, \"suggestedTranslation\": \"Sinh vật bóng tối! Không, chờ chút, là thứ khác...\", \"rating\": 8.5},\n  {\"id\": 710774, \"suggestedTranslation\": \"Mày không nghĩ là mình đi hơi xa nhà rồi sao?\", \"rating\": 0.0},\n  {\"id\": 710775, \"suggestedTranslation\": \"Tôi không phải kiểu người thích nuôi thú cưng... nhưng sẽ phá lệ vì bạn.\", \"rating\": 0.0},\n  {\"id\": 710776, \"suggestedTranslation\": \"Dòng thời gian này bắt đầu trở nên lố bịch rồi đấy.\", \"rating\": 0.0},\n  {\"id\": 710777, \"suggestedTranslation\": \"Một con mắt thấu triệt vạn vật sẽ là người bạn đồng hành khá hữu ích.\", \"rating\": 0.0},\n  {\"id\": 710778, \"suggestedTranslation\": \"Được rồi, được rồi. Trông mày dễ thương lắm.\", \"rating\": 0.0},\n  {\"id\": 710779, \"suggestedTranslation\": \"Đúng là một sinh vật tò mò nhỉ?\", \"rating\": 0.0},\n  {\"id\": 710780, \"suggestedTranslation\": \"Ồ ồ nhìn cái mặt nhăn nheo bé xíu kìa!\", \"rating\": 0.0},\n  {\"id\": 710781, \"suggestedTranslation\": \"Thời gian trôi rất nhanh, và cậu cũng vậy!\", \"rating\": 0.0},\n  {\"id\": 710782, \"suggestedTranslation\": \"Tôi đang dạy nó hót theo từng giờ đấy.\", \"rating\": 0.0},\n  {\"id\": 710783, \"suggestedTranslation\": \"Tôi nghĩ nó muốn được gãi bụng đấy.\", \"rating\": 0.0},\n  {\"id\": 710784, \"suggestedTranslation\": \"Chỉ cần mày không mang theo điềm gở nào thì chúng ta sẽ hòa hợp thôi.\", \"rating\": 0.0},\n  {\"id\": 710785, \"suggestedTranslation\": \"Đừng có mà mổ vào mấy chiếc đồng hồ quả quýt của ta trong đó đấy!\", \"rating\": 0.0},\n  {\"id\": 710786, \"suggestedTranslation\": \"Tội nghiệp chưa, nó đang dẫn đường thẳng về nhà kìa.\", \"rating\": 0.0},\n  {\"id\": 710787, \"suggestedTranslation\": \"Đó là món đồ trang sức mà tôi thà không để chật túi còn hơn.\", \"rating\": 0.0},\n  {\"id\": 710788, \"suggestedTranslation\": \"Nó cũng thú vị y như cỏ khô mà bạn tưởng tượng vậy.\", \"rating\": 8.5},\n  {\"id\": 710789, \"suggestedTranslation\": \"Tôi cho là bị một khúc gỗ đập vào thì vẫn đau đấy.\", \"rating\": 0.0},\n  {\"id\": 710790, \"suggestedTranslation\": \"Thời gian của nó đang cạn dần rất nhanh.\", \"rating\": 0.0},\n  {\"id\": 710791, \"suggestedTranslation\": \"Tôi sẽ nhét nó vào túi và dùng vào việc khác sau.\", \"rating\": 0.0},\n  {\"id\": 710792, \"suggestedTranslation\": \"Con người đã xây dựng công trình bằng những khối đá từ nhiều thế kỷ nay rồi.\", \"rating\": 0.0},\n  {\"id\": 710793, \"suggestedTranslation\": \"Lẽ ra tôi biết mình không nên dính líu vào!\", \"rating\": 0.0},\n  {\"id\": 710794, \"suggestedTranslation\": \"Lẽ ra tôi không nên dính vào mấy chuyện này.\", \"rating\": 0.0},\n  {\"id\": 710795, \"suggestedTranslation\": \"Mọi thứ thật quá quen thuộc.\", \"rating\": 0.0},\n  {\"id\": 710796, \"suggestedTranslation\": \"Chà, cái này mới mẻ đấy.\", \"rating\": 0.0},\n  {\"id\": 710797, \"suggestedTranslation\": \"Xem ra chúng ta chẳng rút được kinh nghiệm gì từ quá khứ cả.\", \"rating\": 0.0},\n  {\"id\": 710798, \"suggestedTranslation\": \"Ôi phiền phức thật. Tôi nghĩ mình vừa nhớ ra điều gì đó...\", \"rating\": 0.0},\n  {\"id\": 710799, \"suggestedTranslation\": \"Chúng có vẻ dễ vỡ... nhưng tôi không nghĩ làm thế là khôn ngoan đâu.\", \"rating\": 0.0},\n  {\"id\": 710800, \"suggestedTranslation\": \"Một món ăn vô cùng mạnh mẽ.\", \"rating\": 0.0},\n  {\"id\": 710801, \"suggestedTranslation\": \"Không phải thứ tôi mong đợi được thấy khi đi dạo trên bãi biển.\", \"rating\": 0.0},\n  {\"id\": 710802, \"suggestedTranslation\": \"Có lẽ điều đó vốn dĩ phải xảy ra.\", \"rating\": 0.0},\n  {\"id\": 710803, \"suggestedTranslation\": \"Chà, chuyện gì đã làm thì cũng xong rồi. Ít nhất là lúc này.\", \"rating\": 0.0},\n  {\"id\": 710804, \"suggestedTranslation\": \"Khoảng thời gian của nó trên thế gian này đã bị cắt ngắn.\", \"rating\": 0.0},\n  {\"id\": 710805, \"suggestedTranslation\": \"Đúng là một cái cây.\", \"rating\": 0.0},\n  {\"id\": 710806, \"suggestedTranslation\": \"Lo chuyện của mình đi, cái cây phiền phức kia!\", \"rating\": 0.0},\n  {\"id\": 710807, \"suggestedTranslation\": \"Chắc chắn là một cách để giết thời gian.\", \"rating\": 0.0},\n  {\"id\": 710808, \"suggestedTranslation\": \"Tôi chắc chắn là có ai đó thích nó.\", \"rating\": 0.0},\n  {\"id\": 710809, \"suggestedTranslation\": \"Tưởng là mình vừa thay hoa rồi chứ. Hay là lúc sau nhỉ?\", \"rating\": 0.0},\n  {\"id\": 710810, \"suggestedTranslation\": \"Đẹp như mới.\", \"rating\": 0.0},\n  {\"id\": 710811, \"suggestedTranslation\": \"Đẹp quá.\", \"rating\": 0.0},\n  {\"id\": 710812, \"suggestedTranslation\": \"Tôi thề là mình vừa mới thay cái này xong.\", \"rating\": 0.0},\n  {\"id\": 710813, \"suggestedTranslation\": \"Phù du.\", \"rating\": 0.0},\n  {\"id\": 710814, \"suggestedTranslation\": \"Ánh sáng di chuyển nhanh đến thế nào ở cái xó này nhỉ?\", \"rating\": 0.0},\n  {\"id\": 710815, \"suggestedTranslation\": \"Trông có vẻ như nó được hoàn thành trong chớp mắt.\", \"rating\": 0.0},\n  {\"id\": 710816, \"suggestedTranslation\": \"Một khung vải trống, chứa đựng vô vàn khả năng vô tận.\", \"rating\": 0.0},\n  {\"id\": 710817, \"suggestedTranslation\": \"Một khoảnh khắc được lưu giữ trong thời gian.\", \"rating\": 0.0},\n  {\"id\": 710818, \"suggestedTranslation\": \"Cứ giữ cái sừng của mi cho kỹ đi!\", \"rating\": 0.0},\n  {\"id\": 710819, \"suggestedTranslation\": \"Nó cần được cắt tóc rồi đấy, dù tôi không phải là người hay chê bai ai...\", \"rating\": 0.0},\n  {\"id\": 710820, \"suggestedTranslation\": \"Chúng ta thực sự phải làm lại chuyện này sao?\", \"rating\": 0.0},\n  {\"id\": 710821, \"suggestedTranslation\": \"Cẩn thận trước vẫn hơn.\", \"rating\": 0.0},\n  {\"id\": 710822, \"suggestedTranslation\": \"Và nằm im đấy nhé!\", \"rating\": 0.0},\n  {\"id\": 710823, \"suggestedTranslation\": \"Đừng có mà hòng!\", \"rating\": 0.0},\n  {\"id\": 710824, \"suggestedTranslation\": \"Cảm giác như chúng ta đang quay lại thời kỳ băng đá vậy.\", \"rating\": 8.5},\n  {\"id\": 710825, \"suggestedTranslation\": \"Phần giúp nó hoạt động đã biến mất. Thật là điển hình.\", \"rating\": 0.0},\n  {\"id\": 710826, \"suggestedTranslation\": \"Tôi nghĩ mình đã chế tạo cái này ở tương lai rồi.\", \"rating\": 0.0},\n  {\"id\": 710827, \"suggestedTranslation\": \"Tôi cá là sinh vật đó không lường trước được ngày tàn của mình lại kết thúc thế này.\", \"rating\": 0.0},\n  {\"id\": 710828, \"suggestedTranslation\": \"Cái này trông giống như mảnh chìa khóa của một câu đố...\", \"rating\": 8.5},\n  {\"id\": 710829, \"suggestedTranslation\": \"Nó đang bị điều khiển bởi con quái thú đó!\", \"rating\": 0.0},\n  {\"id\": 710830, \"suggestedTranslation\": \"Nó chưa có đủ thời gian để mọc lại.\", \"rating\": 0.0},\n  {\"id\": 710831, \"suggestedTranslation\": \"Thật không may là nó chẳng có tác dụng gì trước cát bụi thời gian cả.\", \"rating\": 0.0},\n  {\"id\": 710832, \"suggestedTranslation\": \"Nó sẽ giúp tôi không bị ngấm nước quá nhiều.\", \"rating\": 0.0},\n  {\"id\": 710833, \"suggestedTranslation\": \"Tôi sẽ không phải lo bị sũng nước nữa!\", \"rating\": 0.0},\n  {\"id\": 710834, \"suggestedTranslation\": \"Có một sự đáng ngờ đến mức khó cưỡng ở nó...\", \"rating\": 0.0},\n  {\"id\": 710835, \"suggestedTranslation\": \"Tín hiệu rất yếu.\", \"rating\": 0.0},\n  {\"id\": 710836, \"suggestedTranslation\": \"Nó là một loại thiết bị định vị mục tiêu.\", \"rating\": 0.0},\n  {\"id\": 710837, \"suggestedTranslation\": \"Thứ này đang phát điên lên rồi!\", \"rating\": 0.0},\n  {\"id\": 710838, \"suggestedTranslation\": \"Tôi đang đi đúng hướng rồi.\", \"rating\": 0.0},\n  {\"id\": 710839, \"suggestedTranslation\": \"Chắc là đang đến khá gần rồi đây.\", \"rating\": 0.0},\n  {\"id\": 710840, \"suggestedTranslation\": \"Không biết nó dùng để làm gì nhỉ.\", \"rating\": 0.0},\n  {\"id\": 710841, \"suggestedTranslation\": \"Trông có vẻ như nó cần một chiếc chìa khóa lớn.\", \"rating\": 8.5},\n  {\"id\": 710842, \"suggestedTranslation\": \"Bây giờ cỗ máy có thể hoạt động rồi!\", \"rating\": 0.0},\n  {\"id\": 710843, \"suggestedTranslation\": \"Cái thanh đó trông có vẻ hữu ích!\", \"rating\": 0.0},\n  {\"id\": 710844, \"suggestedTranslation\": \"Không có ai rảnh rỗi hơn để dựng nó lên à?\", \"rating\": 0.0},\n  {\"id\": 710845, \"suggestedTranslation\": \"Bạn phải đặt các cột chống trước hay sau nhỉ? Thôi kệ đi.\", \"rating\": 0.0},\n  {\"id\": 710846, \"suggestedTranslation\": \"Tôi không nhớ là những con búp bê hồi nhỏ của mình lại to và nhiều lông đến thế.\", \"rating\": 0.0},\n  {\"id\": 710847, \"suggestedTranslation\": \"Thời gian không còn nhiều nữa. Chúng ta tranh thủ thôi.\", \"rating\": 0.0},\n  {\"id\": 710848, \"suggestedTranslation\": \"Một chiếc thuyền ván làm liền. Phải thán phục độ hiệu quả của nó đấy.\", \"rating\": 8.5},\n  {\"id\": 710849, \"suggestedTranslation\": \"Tôi không thích ý tưởng ở trong bụng của một con rồng chút nào...\", \"rating\": 0.0},\n  {\"id\": 710850, \"suggestedTranslation\": \"Warly luôn tìm ra những sự kết hợp độc đáo như vậy.\", \"rating\": 0.0},\n  {\"id\": 710851, \"suggestedTranslation\": \"Ôi trời, tôi thực sự hy vọng hôm nay có thể tránh được việc né tránh những con bọ quái vật phun lửa.\", \"rating\": 0.0},\n  {\"id\": 710852, \"suggestedTranslation\": \"Bây giờ thì tôi không còn phải lo đồ đạc bị cháy rụi nữa, tôi có thể lo lắng về mọi thứ khác.\", \"rating\": 0.0},\n  {\"id\": 710853, \"suggestedTranslation\": \"Đủ lớn để cất giữ an toàn tất cả mấy món đồ trang sức của tôi.\", \"rating\": 0.0},\n  {\"id\": 710854, \"suggestedTranslation\": \"Có lẽ tôi sẽ dành chút thời gian để sưởi ấm những khúc xương già cỗi này.\", \"rating\": 8.5},\n  {\"id\": 710855, \"suggestedTranslation\": \"Giá mà tôi có thể quay ngược thời gian và hủy bỏ quyết định đó. Giá như.\", \"rating\": 0.0},\n  {\"id\": 710856, \"suggestedTranslation\": \"Có lẽ tôi sẽ dành chút thời gian để sưởi ấm những khúc xương già cỗi này.\", \"rating\": 8.5},\n  {\"id\": 710857, \"suggestedTranslation\": \"Có lẽ tôi sẽ dành chút thời gian để sưởi ấm những khúc xương già cỗi này.\", \"rating\": 8.5},\n  {\"id\": 710858, \"suggestedTranslation\": \"Còn lâu mới là thứ kỳ lạ nhất tôi từng ăn ở quanh đây.\", \"rating\": 0.0},\n  {\"id\": 710859, \"suggestedTranslation\": \"Tôi luôn quên mất bên trong nó trông lại như thế đấy.\", \"rating\": 0.0},\n  {\"id\": 710860, \"suggestedTranslation\": \"Phải thừa nhận là nó trông ấn tượng thật.\", \"rating\": 0.0},\n  {\"id\": 710861, \"suggestedTranslation\": \"Tại sao phải tốn thời gian trồng chúng trong khi tôi có thể ăn luôn bây giờ?\", \"rating\": 0.0},\n  {\"id\": 710862, \"suggestedTranslation\": \"Câu nói cổ xưa đó thế nào nhỉ? Hai cái đầu tốt hơn một cái?\", \"rating\": 0.0},\n  {\"id\": 710863, \"suggestedTranslation\": \"Khi có phân vân, hãy nướng nó thành bánh.\", \"rating\": 0.0},\n  {\"id\": 710864, \"suggestedTranslation\": \"Hừ, ai lại muốn làm kẻ về đích cuối chứ?\", \"rating\": 0.0},\n  {\"id\": 710865, \"suggestedTranslation\": \"Vật liệu chống cháy đã phục vụ tôi rất tốt trong quá khứ. Và cả tương lai nữa, nghĩ lại thì là vậy.\", \"rating\": 0.0},\n  {\"id\": 710866, \"suggestedTranslation\": \"Dù trông hơi khó chịu nhưng nó có thể hữu ích đấy.\", \"rating\": 0.0},\n  {\"id\": 710867, \"suggestedTranslation\": \"Hóa ra viên đá đó khá là hữu ích.\", \"rating\": 0.0},\n  {\"id\": 710868, \"suggestedTranslation\": \"Nó phát ra từ sâu thẳm dưới lòng đất.\", \"rating\": 0.0},\n  {\"id\": 710869, \"suggestedTranslation\": \"Ai mà biết nó đã trôi nổi trên đại dương bao lâu rồi chứ?\", \"rating\": 0.0},\n  {\"id\": 710870, \"suggestedTranslation\": \"Đó là một diễn biến không mấy may mắn.\", \"rating\": 0.0},\n  {\"id\": 710871, \"suggestedTranslation\": \"Bây giờ nó chẳng giúp ích gì cho tôi mấy nữa.\", \"rating\": 0.0},\n  {\"id\": 710872, \"suggestedTranslation\": \"Tôi nên kiểm tra rễ cây nhân lúc đang ở đây.\", \"rating\": 0.0},\n  {\"id\": 710873, \"suggestedTranslation\": \"Cái cây đó đã chết từ lâu rồi.\", \"rating\": 0.0},\n  {\"id\": 710874, \"suggestedTranslation\": \"Tôi đang vội đây, thế này là đủ ngon rồi.\", \"rating\": 0.0},\n  {\"id\": 710875, \"suggestedTranslation\": \"Sao tôi cứ hay quên là thịt nấu chín ngon hơn biết bao nhỉ...\", \"rating\": 8.5},\n  {\"id\": 710876, \"suggestedTranslation\": \"Hái kiểu này dễ hơn nhiều.\", \"rating\": 0.0},\n  {\"id\": 710877, \"suggestedTranslation\": \"Không có thời gian hái đâu, tôi mang theo tất cả đi luôn đây!\", \"rating\": 0.0},\n  {\"id\": 710878, \"suggestedTranslation\": \"Mang cái này lại gần trại sẽ tiết kiệm cho tôi khối thời gian quý báu đấy.\", \"rating\": 0.0},\n  {\"id\": 710879, \"suggestedTranslation\": \"Tôi có thể nghĩ ra một chỗ tốt hơn cho nó.\", \"rating\": 0.0},\n  {\"id\": 710880, \"suggestedTranslation\": \"Tôi có thể đặt nó ở đâu đó sau. Hoặc thậm chí sớm hơn.\", \"rating\": 0.0},\n  {\"id\": 710881, \"suggestedTranslation\": \"Mong là không có con khỉ nào đang ẩn nấp trong đó.\", \"rating\": 0.0},\n  {\"id\": 710882, \"suggestedTranslation\": \"Tôi có thể đặt nó ở đâu đó sau. Hoặc thậm chí sớm hơn.\", \"rating\": 0.0},\n  {\"id\": 710883, \"suggestedTranslation\": \"Đó là những gì nó đáng phải nhận.\", \"rating\": 0.0},\n  {\"id\": 710884, \"suggestedTranslation\": \"Quả là một cách lặp đi lặp lại đến chán ngắt để tiêu tốn thời gian.\", \"rating\": 0.0},\n  {\"id\": 710885, \"suggestedTranslation\": \"Không phải là vũ khí thông thường cho lắm, nhưng mỗi người một sở thích.\", \"rating\": 0.0},\n  {\"id\": 710886, \"suggestedTranslation\": \"Quả là một cách lặp đi lặp lại đến chán ngắt để tiêu tốn thời gian.\", \"rating\": 0.0},\n  {\"id\": 710887, \"suggestedTranslation\": \"Quả là một cách lặp đi lặp lại đến chán ngắt để tiêu tốn thời gian.\", \"rating\": 0.0},\n  {\"id\": 710888, \"suggestedTranslation\": \"Chà, ít ra thì nó cũng hiệu quả.\", \"rating\": 0.0},\n  {\"id\": 710889, \"suggestedTranslation\": \"Quả là một cách lặp đi lặp lại đến chán ngắt để tiêu tốn thời gian.\", \"rating\": 0.0},\n  {\"id\": 710890, \"suggestedTranslation\": \"Không phải là vũ khí thông thường cho lắm, nhưng mỗi người một sở thích.\", \"rating\": 0.0},\n  {\"id\": 710891, \"suggestedTranslation\": \"Tôi không bao giờ có thể quên được cái mùi thế này.\", \"rating\": 0.0},\n  {\"id\": 710892, \"suggestedTranslation\": \"Nó ăn ngon hơn ngửi, nhưng cũng chẳng thơm ho gì cho cam.\", \"rating\": 0.0},\n  {\"id\": 710893, \"suggestedTranslation\": \"Trong tất cả những thứ tôi trồng, đây lại là thứ phát triển tốt nhất.\", \"rating\": 0.0},\n  {\"id\": 710894, \"suggestedTranslation\": \"Tại sao phải tốn thời gian trồng chúng trong khi tôi có thể ăn luôn bây giờ?\", \"rating\": 0.0},\n  {\"id\": 710895, \"suggestedTranslation\": \"Được rồi, dùng bụi bẩn làm nguyên liệu là một lựa chọn tồi. Đây là lý do tôi không nấu ăn đấy!\", \"rating\": 0.0},\n  {\"id\": 710896, \"suggestedTranslation\": \"Tôi rất cần một con như bạn trong xưởng của tôi ở nhà đấy.\", \"rating\": 0.0},\n  {\"id\": 710897, \"suggestedTranslation\": \"Một thùng chứa bụi ấm cúng.\", \"rating\": 0.0},\n  {\"id\": 710898, \"suggestedTranslation\": \"Nếu phần còn lại của tôi có đóng băng đi nữa thì ít ra đôi tai vẫn cứ ấm áp.\", \"rating\": 0.0},\n  {\"id\": 710899, \"suggestedTranslation\": \"Tôi nghĩ mình vừa thấy nó quằn quại...\", \"rating\": 0.0},\n  {\"id\": 710900, \"suggestedTranslation\": \"Ồ tốt quá. Món tủ của tôi đây rồi.\", \"rating\": 0.0},\n  {\"id\": 710901, \"suggestedTranslation\": \"Nó trông hơi giống một viên kẹo dẻo khổng lồ nếu bạn nheo mắt lại.\", \"rating\": 0.0},\n  {\"id\": 710902, \"suggestedTranslation\": \"Chà, ảo mộng tan vỡ rồi.\", \"rating\": 0.0},\n  {\"id\": 710903, \"suggestedTranslation\": \"Tôi sẽ ăn cà tím thừa trong nhiều tuần liền cho mà xem.\", \"rating\": 8.5},\n  {\"id\": 710904, \"suggestedTranslation\": \"Tại sao phải tốn thời gian trồng chúng trong khi tôi có thể ăn luôn bây giờ?\", \"rating\": 0.0},\n  {\"id\": 710905, \"suggestedTranslation\": \"Đẹp đẽ, thực tế.\", \"rating\": 0.0},\n  {\"id\": 710906, \"suggestedTranslation\": \"Đỡ cho tôi công đi kiếm củi.\", \"rating\": 0.0},\n  {\"id\": 710907, \"suggestedTranslation\": \"Lẽ ra mọi chuyện có thể khá hơn thế.\", \"rating\": 0.0},\n  {\"id\": 710908, \"suggestedTranslation\": \"Ai đó quên cắm hoa vào bình rồi. Không khéo lại là mình...\", \"rating\": 0.0},\n  {\"id\": 710909, \"suggestedTranslation\": \"Tốt như mới.\", \"rating\": 0.0},\n  {\"id\": 710910, \"suggestedTranslation\": \"Tôi tự đặt ra quy tắc là không tin tưởng mấy cái bàn sang chảnh nhặt được ngoài hoang dã.\", \"rating\": 0.0},\n  {\"id\": 710911, \"suggestedTranslation\": \"Ôi không, tôi lại quên thay bóng đèn nữa à?\", \"rating\": 0.0},\n  {\"id\": 710912, \"suggestedTranslation\": \"Tuổi tác của nó bắt đầu lộ rõ rồi kìa.\", \"rating\": 0.0},\n  {\"id\": 710913, \"suggestedTranslation\": \"Có lẽ điều đó vốn dĩ phải xảy ra.\", \"rating\": 0.0},\n  {\"id\": 710914, \"suggestedTranslation\": \"Chà, chuyện gì đã làm thì cũng xong rồi. Ít nhất là lúc này.\", \"rating\": 0.0},\n  {\"id\": 710915, \"suggestedTranslation\": \"Khoảng thời gian của nó trên thế gian này đã bị cắt ngắn.\", \"rating\": 0.0},\n  {\"id\": 710916, \"suggestedTranslation\": \"Lại một cái cây nữa.\", \"rating\": 0.0},\n  {\"id\": 710917, \"suggestedTranslation\": \"Có lẽ điều đó vốn dĩ phải xảy ra.\", \"rating\": 0.0},\n  {\"id\": 710918, \"suggestedTranslation\": \"Chà, chuyện gì đã làm thì cũng xong rồi. Ít nhất là lúc này.\", \"rating\": 0.0},\n  {\"id\": 710919, \"suggestedTranslation\": \"Khoảng thời gian của nó trên thế gian này đã bị cắt ngắn.\", \"rating\": 0.0},\n  {\"id\": 710920, \"suggestedTranslation\": \"Trông nó có vẻ ốm yếu.\", \"rating\": 0.0},\n  {\"id\": 710921, \"suggestedTranslation\": \"Tôi không thích có mắt cứ nhìn chằm chằm vào mình chút nào...\", \"rating\": 0.0},\n  {\"id\": 710922, \"suggestedTranslation\": \"Thật kỳ quặc... Tôi phải thử nó ngay mới được!\", \"rating\": 0.0},\n  {\"id\": 710923, \"suggestedTranslation\": \"Tôi không nghĩ thứ đó nên ở đây...\", \"rating\": 0.0},\n  {\"id\": 710924, \"suggestedTranslation\": \"Mắt tôi không tốt lắm đâu, nhưng tôi chưa muốn tìm mắt thay thế lúc này đâu nhé!\", \"rating\": 0.0},\n  {\"id\": 710925, \"suggestedTranslation\": \"Nó đang chuẩn bị nở! Tôi phải canh chừng nó mới được.\", \"rating\": 0.0},\n  {\"id\": 710926, \"suggestedTranslation\": \"Thôi đừng nhìn nữa! Lo chuyện của mi đi!\", \"rating\": 0.0},\n  {\"id\": 710927, \"suggestedTranslation\": \"Ôi chao, tôi THÍCH thứ này đấy!\", \"rating\": 0.0},\n  {\"id\": 710928, \"suggestedTranslation\": \"Nên đặt nó ở đâu, đặt nó ở đâu đây...\", \"rating\": 0.0},\n  {\"id\": 710929, \"suggestedTranslation\": \"Phí hoài bao nhiêu thời gian!\", \"rating\": 0.0},\n  {\"id\": 710930, \"suggestedTranslation\": \"Làm vườn tốn thời gian thật đấy.\", \"rating\": 0.0},\n  {\"id\": 710931, \"suggestedTranslation\": \"Sao mi không chịu lớn nhanh hơn chút cơ chứ?\", \"rating\": 0.0},\n  {\"id\": 710932, \"suggestedTranslation\": \"Thêm chút phân bón chắc sẽ đẩy nhanh tốc độ lên đấy.\", \"rating\": 0.0},\n  {\"id\": 710933, \"suggestedTranslation\": \"Cuốc đất thật là chán ngắt.\", \"rating\": 0.0},\n  {\"id\": 710934, \"suggestedTranslation\": \"Bao nhiêu thời gian và công sức... tiêu tan hết...\", \"rating\": 0.0},\n  {\"id\": 710935, \"suggestedTranslation\": \"Cuối cùng thì!!\", \"rating\": 0.0},\n  {\"id\": 710936, \"suggestedTranslation\": \"Tôi đoán đôi khi sự kiên nhẫn cũng được đền đáp.\", \"rating\": 0.0},\n  {\"id\": 710937, \"suggestedTranslation\": \"Chờ chút, hình như tôi đâu có định trồng thứ đó!\", \"rating\": 8.5}\n]",
