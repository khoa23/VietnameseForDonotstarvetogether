            "text": "[\n  {\"id\":708838,\"suggestedTranslation\":\"Mẹ mà biết tớ làm vỡ bộ đồ sứ tinh xảo của bà thì mẹ giết tớ mất.\",\"rating\":9.0},\n  {\"id\":708839,\"suggestedTranslation\":\"Tớ không hứng thú lắm với trò chơi cờ bàn đâu.\",\"rating\":9.0},\n  {\"id\":708840,\"suggestedTranslation\":\"Tớ không hứng thú lắm với trò chơi cờ bàn đâu.\",\"rating\":9.0},\n  {\"id\":708841,\"suggestedTranslation\":\"Bớt đi được một món đồ dùng để mang theo cùng bộ đồ cắm trại!\",\"rating\":9.0},\n  {\"id\":708842,\"suggestedTranslation\":\"Trông như một con ngựa gỗ bình thường.\",\"rating\":9.0},\n  {\"id\":708843,\"suggestedTranslation\":\"Tớ quá lớn tuổi để chơi đồ chơi rồi.\",\"rating\":9.0},\n  {\"id\":708844,\"suggestedTranslation\":\"Tớ thà có một chiếc kèn đồng còn hơn.\",\"rating\":9.0},\n  {\"id\":708845,\"suggestedTranslation\":\"Woby thích nó kìa.\",\"rating\":9.0},\n  {\"id\":708846,\"suggestedTranslation\":\"Ối, nó bị cong mất rồi.\",\"rating\":9.0},\n  {\"id\":708847,\"suggestedTranslation\":\"Tớ thích nghe chuyện kể hay lắm. Hừm...\",\"rating\":9.0},\n  {\"id\":708848,\"suggestedTranslation\":\"Bảo vệ gót chân của bạn kìa!\",\"rating\":9.0},\n  {\"id\":708849,\"suggestedTranslation\":\"Woby có vẻ không thích nó cho lắm.\",\"rating\":9.0},\n  {\"id\":708850,\"suggestedTranslation\":\"Nó thậm chí còn chẳng có mùi giống cây thông thật!\",\"rating\":9.0},\n  {\"id\":708851,\"suggestedTranslation\":\"Bớt đi được một chiếc đĩa phải rửa!\",\"rating\":9.0},\n  {\"id\":708852,\"suggestedTranslation\":\"Tự hỏi không biết mình có dùng nó để bắt tín hiệu radio được không...\",\"rating\":9.0},\n  {\"id\":708853,\"suggestedTranslation\":\"Tớ không hứng thú lắm với trò chơi cờ bàn đâu.\",\"rating\":9.0},\n  {\"id\":708854,\"suggestedTranslation\":\"Tớ không hứng thú lắm với trò chơi cờ bàn đâu.\",\"rating\":9.0},\n  {\"id\":708855,\"suggestedTranslation\":\"Dễ thôi, tớ biết cách thắt rất nhiều loại nút thắt đấy!\",\"rating\":9.0},\n  {\"id\":708856,\"suggestedTranslation\":\"Nhìn mấy cái nào to hơn rồi thì mấy cái này nhàm chán lắm.\",\"rating\":9.0},\n  {\"id\":708857,\"suggestedTranslation\":\"Nhìn mấy cái nào to hơn rồi thì mấy cái này nhàm chán lắm.\",\"rating\":9.0},\n  {\"id\":708858,\"suggestedTranslation\":\"Nó sẽ nói cho tớ biết tương lai chứ?\",\"rating\":9.0},\n  {\"id\":708859,\"suggestedTranslation\":\"Ái chà, tớ cứ tưởng đó là một con nhện thật chứ...\",\"rating\":9.0},\n  {\"id\":708860,\"suggestedTranslation\":\"Chẳng có chuyện gì xấu xảy ra khi ước nguyện với bàn tay khỉ đâu!\",\"rating\":9.0},\n  {\"id\":708861,\"suggestedTranslation\":\"Trông như có ai uống hết rồi ấy.\",\"rating\":9.0},\n  {\"id\":708862,\"suggestedTranslation\":\"Đấy chỉ là đồ giả thôi, tớ muốn xem răng nanh ma cà rồng thật cơ!\",\"rating\":9.0},\n  {\"id\":708863,\"suggestedTranslation\":\"Tớ mong là tên ma cà rồng đó vẫn ổn.\",\"rating\":9.0},\n  {\"id\":708864,\"suggestedTranslation\":\"Tớ suýt có thể nhìn thấu không gian bằng cái này đấy!\",\"rating\":9.0},\n  {\"id\":708865,\"suggestedTranslation\":\"Chắc hai tay tớ phải luân phiên nhau làm việc rồi.\",\"rating\":9.0},\n  {\"id\":708866,\"suggestedTranslation\":\"Chỉ là tớ tưởng tượng thôi hay mắt của nó đang liếc theo tớ thật thế?\",\"rating\":9.0},\n  {\"id\":708867,\"suggestedTranslation\":\"Tớ chẳng biết ra đây để đo đạc cái gì nữa.\",\"rating\":9.0},\n  {\"id\":708868,\"suggestedTranslation\":\"Trông giống như một con quái vật chất nhờn đã trốn thoát.\",\"rating\":9.0},\n  {\"id\":708869,\"suggestedTranslation\":\"Trông như ai đó đã ném hai món đồ chơi vào nhau ấy.\",\"rating\":9.0},\n  {\"id\":708870,\"suggestedTranslation\":\"Lại thêm một món đồ chơi mà tớ đã quá tuổi để chơi rồi.\",\"rating\":9.0},\n  {\"id\":708871,\"suggestedTranslation\":\"Hả. Tớ không thể tìm thấy loài thực vật đó trong sổ tay của mình.\",\"rating\":9.0},\n  {\"id\":708872,\"suggestedTranslation\":\"Nó không bắt được bất kỳ đài phát thanh ưa thích nào của tớ cả...\",\"rating\":9.0},\n  {\"id\":708873,\"suggestedTranslation\":\"Trông nó giống như một thứ gì đó đến từ ngoài không gian.\",\"rating\":9.0},\n  {\"id\":708874,\"suggestedTranslation\":\"Tự hỏi liệu chúng ta có bao giờ khám phá không gian bên ngoài không.\",\"rating\":9.0},\n  {\"id\":708875,\"suggestedTranslation\":\"Ôi không, có phải con robot đã làm rơi những thứ này không?\",\"rating\":9.0},\n  {\"id\":708876,\"suggestedTranslation\":\"Trò trẻ con ấy mà.\",\"rating\":9.0},\n  {\"id\":708877,\"suggestedTranslation\":\"Tớ chắc chắn mình sẽ tìm được cách dùng cho nó.\",\"rating\":9.0},\n  {\"id\":708878,\"suggestedTranslation\":\"Không biết khi nào bạn sẽ cần một cái nút dự phòng đâu.\",\"rating\":9.0},\n  {\"id\":708879,\"suggestedTranslation\":\"Lửa đang bùng cháy quá... à thực ra là nó đang bốc cháy TRÊN cái cân, đó mới là vấn đề!\",\"rating\":9.0},\n  {\"id\":708880,\"suggestedTranslation\":\"Thật phí phạm vật tư quá.\",\"rating\":9.0},\n  {\"id\":708881,\"suggestedTranslation\":\"Cứ đợi đấy, huy hiệu câu cá lớn nhất sẽ thuộc về tớ!\",\"rating\":9.0},\n  {\"id\":708882,\"suggestedTranslation\":\"Trọng lượng: {weight}\\nĐược câu bởi: {owner}\",\"rating\":9.0},\n  {\"id\":708883,\"suggestedTranslation\":\"Trọng lượng: {weight}\\nĐược câu bởi: {owner}\\nNó nặng gần bằng cậu đấy, Woby!\",\"rating\":9.0},\n  {\"id\":708884,\"suggestedTranslation\":\"Tớ thắng rồi! Huy hiệu của tớ đâu?\\nTrọng lượng: {weight}\\nĐược câu bởi: {owner}\",\"rating\":9.0},\n  {\"id\":708885,\"suggestedTranslation\":\"Trọng lượng: {weight}\\nĐược câu bởi: {owner}\\nKhá ấn tượng phải không Woby?\",\"rating\":9.0},\n  {\"id\":708886,\"suggestedTranslation\":\"Này! Đó không phải lò lửa đâu!\",\"rating\":9.0},\n  {\"id\":708887,\"suggestedTranslation\":\"Đó là những gì xảy ra khi bạn không thực hành an toàn lửa đấy.\",\"rating\":9.0},\n  {\"id\":708888,\"suggestedTranslation\":\"Có huy hiệu nào cho việc trồng được loại rau củ lớn nhất không nhỉ?\",\"rating\":9.0},\n  {\"id\":708889,\"suggestedTranslation\":\"Trọng 