},\n  {\n    \"id\": 707953,\n    \"suggestedTranslation\": \"Tớ nghĩ lũ quái vật đang đến kìa!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 707954,\n    \"suggestedTranslation\": \"Ý tưởng sáng dạ của ai thế nhỉ? Hiểu chưa? Vì nó sáng mà? Thôi bỏ đi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 707955,\n    \"suggestedTranslation\": \"Cái đó chắắắắn là bị nguyền rủa rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 707956,\n    \"suggestedTranslation\": \"Ni tơ ở đây hay ở đó. Heh...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 707957,\n    \"suggestedTranslation\": \"Ồ. Trông giống một cục đá lớn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 707958,\n    \"suggestedTranslation\": \"Heh. Dụng cụ của tớ sẽ không bị tuột mất với cái này đâu!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 707959,\n    \"suggestedTranslation\": \"Đừng có liếm dưới đất đấy, Woby!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 707960,\n    \"suggestedTranslation\": \"Chà, tớ có thể nhìn thấu cả lớp đất luôn!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 707961,\n    \"suggestedTranslation\": \"Tớ từng đi chèo thuyền canoe với đội Hướng đạo sinh Cây Thông của mình.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 707962,\n    \"suggestedTranslation\": \"Tớ từng đi chèo thuyền canoe với đội Hướng đạo sinh Cây Thông của mình.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 707963,\n    \"suggestedTranslation\": \"Sao cái mái chèo đó sắc thế nhỉ? Ai đó có thể bị thương đấy!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 707964,\n    \"suggestedTranslation\": \"Một cái hồ vô hình á?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 707965,\n    \"suggestedTranslation\": \"Chúng ta được cứu rồi, Woby!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 707966,\n    \"suggestedTranslation\": \"Cái đó PHẢI là một con quái-- (thở dài) không, chỉ là một cục bùn thôi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 707967,\n    \"suggestedTranslation\": \"Chỉ là một phao câu đơn giản.\