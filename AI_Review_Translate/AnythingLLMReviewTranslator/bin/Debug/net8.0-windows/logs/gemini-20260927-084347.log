            "text": "[\n  {\n    \"id\": 714238,\n    \"suggestedTranslation\": \"Ta cứ tưởng không bao giờ còn gặp lại ngươi nữa, bạn hiền!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 714239,\n    \"suggestedTranslation\": \"Điệu nhảy trên không của ngươi thật dễ chịu làm sao...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 714240,\n    \"suggestedTranslation\": \"Đừng để tuột khỏi đôi tay vụng về của ta nhé.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 714241,\n    \"suggestedTranslation\": \"Ngon tuyệt! Khu vực!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 714242,\n    \"suggestedTranslation\": \"Tự hỏi mình có thể làm món gì với mấy thứ này nhỉ?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 714243,\n    \"suggestedTranslation\": \"Ước gì ngươi giống gà tây hơn là kền kền...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 714244,\n    \"suggestedTranslation\": \"Hừm, mùi thơm thật đấy!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 714245,\n    \"suggestedTranslation\": \"Nó sắp hỏng rồi kìa.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 714246,\n    \"suggestedTranslation\": \"Miếng thịt đang chuyển mùi rồi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 714247,\n    \"suggestedTranslation\": \"Một món ăn tốn không ít thời gian, nhưng rất đáng để chờ đợi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 714248,\n    \"suggestedTranslation\": \"Ta cá là vị của nó rất sắc bén đấy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 714249,\n    \"suggestedTranslation\": \"Nó vẫn sẽ sống để mà châm chích tiếp.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 714250,\n    \"suggestedTranslation\": \"Một bông hoa thật đẹp từ một vị khách thật gai góc!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 714251,\n    \"suggestedTranslation\": \"Mong là nuốt xuống nó không bị châm chích.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 714252,\n    \"suggestedTranslation\": \"Giá mà có chút bánh ngô và phô mai chảy...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\