            "text": "[\n  {\"id\":708538,\"suggestedTranslation\":\"Nhện khá là hữu ích đấy chứ.\",\"rating\":0.0},\n  {\"id\":708539,\"suggestedTranslation\":\"Có cái gì đó bên trong kìa!\",\"rating\":0.0},\n  {\"id\":708540,\"suggestedTranslation\":\"Chắc tôi có thể dạy nó chơi vài bài hát học được hồi ở Hướng đạo sinh.\",\"rating\":0.0},\n  {\"id\":708541,\"suggestedTranslation\":\"Có nhức tai lắm không, Woby?\",\"rating\":0.0},\n  {\"id\":708542,\"suggestedTranslation\":\"Ừm, trông có vẻ bị ám đấy.\",\"rating\":0.0},\n  {\"id\":708543,\"suggestedTranslation\":\"Trông khá là đẹp phết.\",\"rating\":0.0},\n  {\"id\":708544,\"suggestedTranslation\":\"Cậu có nghe thấy gì không, Woby?\",\"rating\":0.0},\n  {\"id\":708545,\"suggestedTranslation\":\"Chúng khiến tôi thấy cứ kỳ lạ thế nào ấy.\",\"rating\":0.0},\n  {\"id\":708546,\"suggestedTranslation\":\"Nếu tìm thấy đóa hoa nào, tôi sẽ mang chúng về đây.\",\"rating\":0.0},\n  {\"id\":708547,\"suggestedTranslation\":\"Đây có phải là bộ xương thật không nhỉ?\",\"rating\":0.0},\n  {\"id\":708548,\"suggestedTranslation\":\"May mà chúng có cái sọ dày thật, đội cái này làm mũ thì hết sảy!\",\"rating\":0.0},\n  {\"id\":708549,\"suggestedTranslation\":\"Cậu nghĩ đó là bộ xương quái vật phải không, Woby?\",\"rating\":0.0},\n  {\"id\":708550,\"suggestedTranslation\":\"Tội nghiệp %s. Chắc là %s nguy hiểm hơn tôi tưởng...\",\"rating\":0.0},\n  {\"id\":708551,\"suggestedTranslation\":\"Tội nghiệp %s. Chắc là %s nguy hiểm hơn tôi tưởng...\",\"rating\":0.0},\n  {\"id\":708552,\"suggestedTranslation\":\"Tội nghiệp %s. Chắc là %s nguy hiểm hơn tôi tưởng...\",\"rating\":0.0},\n  {\"id\":708553,\"suggestedTranslation\":\"Tội nghiệp %s. Chắc là %s nguy hiểm hơn tôi tưởng...\",\"rating\":0.0},\n  {\"id\":708554,\"suggestedTranslation\":\"Tôi nghĩ mình có thể điêu khắc cái này! Tôi khá giỏi mấy môn thủ công mỹ nghệ đấy.\",\"rating\":0.0},\n  {\"id\":708555,\"suggestedTranslation\":\"Chắc chắn phải có thứ gì đó hay ho ở trỏng rồi.\",\"rating\":0.0},\n  {\"id\":708556,\"suggestedTranslation\":\"Cái này nhân đạo hơn bom thối đấy.\",\"rating\":0.0},\n  {\"id\":708557,\"suggestedTranslation\":\"Bạn không thể biết trước mình sẽ đụng độ thứ gì ngoài hoang dã đâu.\",\"rating\":0.0},\n  {\"id\":708558,\"suggestedTranslation\":\"Thực ra tôi không nên nhặt những thứ không phải của mình.\",\"rating\":0.0},\n  {\"id\":708559,\"suggestedTranslation\":\"Một Hướng đạo sinh Cây Thông chân chính luôn chuẩn bị sẵn đạn dược dự phòng!\",\"rating\":0.0},\n  {\"id\":708560,\"suggestedTranslation\":\"Mấy viên này có võ phết đấy!\",\"rating\":0.0},\n  {\"id\":708561,\"suggestedTranslation\":\"Gần như lạnh lẽo giống mấy chương trình phát thanh ưa thích của tôi!\",\"rating\":0.0},\n  {\"id\":708562,\"suggestedTranslation\":\"Nhớp nhúa. Đúng kiểu tôi thích!\",\"rating\":0.0},\n  {\"id\":708563,\"suggestedTranslation\":\"Mấy viên đạn này mạ vàng đấy! Nghĩa đen luôn!\",\"rating\":0.0},\n  {\"id\":708564,\"suggestedTranslation\":\"Woby, chúng ta sẽ kết thúc thật HOÀNH TRÁNG nhé!\",\"rating\":0.0},\n  {\"id\":708565,\"suggestedTranslation\":\"Ngọt ngào!\",\"rating\":0.0},\n  {\"id\":708566,\"suggestedTranslation\":\"Ghê rợn thật đấy! Hừm.\",\"rating\":0.0},\n  {\"id\":708567,\"suggestedTranslation\":\"Đâm đau thấu xương!\",\"rating\":0.0},\n  {\"id\":708568,\"suggestedTranslation\":\"Ước gì chúng không quá khó kiếm!\",\"rating\":0.0},\n  {\"id\":708569,\"suggestedTranslation\":\"Giờ thì tôi có thể nện chúng bằng mặt trăng rồi!\",\"rating\":0.0},\n  {\"id\":708570,\"suggestedTranslation\":\"Ghê quá... nhưng đánh lạc hướng được là tốt rồi.\",\"rating\":0.0},\n  {\"id\":708571,\"suggestedTranslation\":\"Đúng vậy, Woby. Chúng ta quá đỉnh!\",\"rating\":0.0},\n  {\"id\":708572,\"suggestedTranslation\":\"Chúng không phải loại tốt nhất, nhưng vẫn dùng được.\",\"rating\":0.0},\n  {\"id\":708573,\"suggestedTranslation\":\"Chúng sẽ được một phen bất ngờ cho xem!\",\"rating\":0.0},\n  {\"id\":708574,\"suggestedTranslation\":\"Mấy viên này sẽ làm chúng chậm lại!\",\"rating\":0.0},\n  {\"id\":708575,\"suggestedTranslation\":\"Tốt hơn hết là nên cẩn thận với mấy thứ này.\",\"rating\":0.0},\n  {\"id\":708576,\"suggestedTranslation\":\"Ma thuật bóng tối khá là tiện lợi đấy chứ, tôi hiểu tại sao người Cổ đại lại thích nó rồi!\",\"rating\":0.0},\n  {\"id\":708577,\"suggestedTranslation\":\"Đã đến lúc độ chế cây Súng Cao Su quen thuộc của tôi chưa nhỉ?\",\"rating\":0.0},\n  {\"id\":708578,\"suggestedTranslation\":\"Rợn tóc gáy! Tôi thích thế.\",\"rating\":0.0},\n  {\"id\":708579,\"suggestedTranslation\":\"Hừm. Thơm mùi thịt xông khói! Nhưng đừng có ăn đấy Woby!\",\"rating\":0.0},\n  {\"id\":708580,\"suggestedTranslation\":\"Nó cứ giật giật kìa!\",\"rating\":0.0},\n  {\"id\":708581,\"suggestedTranslation\":\"Chất chơi người dơi đến tận xương tủy!\",\"rating\":0.0},\n  {\"id\":708582,\"suggestedTranslation\":\"Bắt đầu sang xịn mịn rồi đấy!\",\"rating\":0.0},\n  {\"id\":708583,\"suggestedTranslation\":\"Tôi có thể bắn súng cao su hoài không chán!\",\"rating\":0.0},\n  {\"id\":708584,\"suggestedTranslation\":\"Có lực giật phết đấy!\",\"rating\":0.0},\n  {\"id\":708585,\"suggestedTranslation\":\"Á chà, siêu dính luôn!\",\"rating\":0.0},\n  {\"id\":708586,\"suggestedTranslation\":\"Hơi giống băng dính khúc côn cầu!\",\"rating\":0.0},\n  {\"id\":708587,\"suggestedTranslation\":\"Ghê nhưng mà hiệu quả!\",\"rating\":0.0},\n  {\"id\":708588,\"suggestedTranslation\":\"Cảm ơn nhé, quái vật bóng tối!\",\"rating\":0.0},\n  {\"id\":708589,\"suggestedTranslation\":\"Chào bạn nhỏ!\",\"rating\":0.0},\n  {\"id\":708590,\"suggestedTranslation\":\"Có ai biết thuật ướp xác không vậy?\",\"rating\":0.0},\n  {\"id\":708591,\"suggestedTranslation\":\"Có ai biết thuật ướp xác không vậy?\",\"rating\":0.0},\n  {\"id\":708592,\"suggestedTranslation\":\"Cái thứ nhờ nhớt đó là gì vậy? Tôi phải nhìn kỹ hơn mới được!\",\"rating\":0.0},\n  {\"id\":708593,\"suggestedTranslation\":\"Cái này sẽ bảo vệ bộ não của tôi an toàn. Không biết khi nào lại đụng độ thây ma đâu.\",\"rating\":0.0},\n  {\"id\":708594,\"suggestedTranslation\":\"Tôi phải xem có gì trong đó mới được!\",\"rating\":0.0},\n  {\"id\":708595,\"suggestedTranslation\":\"Dãi Sên Rùa kìa!\",\"rating\":0.0},\n  {\"id\":708596,\"suggestedTranslation\":\"Xin lỗi Sên Rùa nhé.\",\"rating\":0.0},\n  {\"id\":708597,\"suggestedTranslation\":\"Chào chú chim nhỏ! Cậu có muốn kể cho tôi nghe gì không?\",\"rating\":0.0},\n  {\"id\":708598,\"suggestedTranslation\":\"Thấy hơi... đói bụng hả? Hì... ý tôi là, vì cậu là chim mà?\",\"rating\":0.0},\n  {\"id\":708599,\"suggestedTranslation\":\"Suỵt, phải thật giữ trật tự đấy Woby.\",\"rating\":0.0},\n  {\"id\":708600,\"suggestedTranslation\":\"Ôi không! Mình quên cho ăn à?\",\"rating\":0.0},\n  {\"id\":708601,\"suggestedTranslation\":\"Chắc tôi nên quay lại với ai biết nói tiếng ma...\",\"rating\":0.0},\n  {\"id\":708602,\"suggestedTranslation\":\"Chỉ là một miếng thịt nhỏ thôi.\",\"rating\":0.0},\n  {\"id\":708603,\"suggestedTranslation\":\"Chẳng khác nào một miếng thịt khô vụn.\",\"rating\":0.0},\n  {\"id\":708604,\"suggestedTranslation\":\"Con này có vẻ cắn đau đấy.\",\"rating\":0.0},\n  {\"id\":708605,\"suggestedTranslation\":\"Hừm.\",\"rating\":0.0},\n  {\"id\":708606,\"suggestedTranslation\":\"Rất vui được gặp bạn!\",\"rating\":0.0},\n  {\"id\":708607,\"suggestedTranslation\":\"Tôi đã thấy bạn quanh quẩn rồi đấy! Hừm.\",\"rating\":0.0},\n  {\"id\":708608,\"suggestedTranslation\":\"Chào bạn nhỏ!\",\"rating\":0.0},\n  {\"id\":708609,\"suggestedTranslation\":\"Hình như tôi phải để nó ngấm trong chốc lát.\",\"rating\":0.0},\n  {\"id\":708610,\"suggestedTranslation\":\"Tôi đoán nó sắp xong rồi đấy.\",\"rating\":0.0},\n  {\"id\":708611,\"suggestedTranslation\":\"Chà, trông có vẻ như nó đang phát huy tác dụng rồi đấy.\",\"rating\":0.0},\n  {\"id\":708612,\"suggestedTranslation\":\"Chắc chắn là xong rồi đấy!\",\"rating\":0.0},\n  {\"id\":708613,\"suggestedTranslation\":\"Cá là cậu thực ra rất hiền lành đúng không!\",\"rating\":0.0},\n  {\"id\":708614,\"suggestedTranslation\":\"Nó có một cái đầu nhọn... hì...\",\"rating\":0.0},\n  {\"id\":708615,\"suggestedTranslation\":\"Tôi có thể lao đến đâm một nhát nhanh gọn với cái này.\",\"rating\":0.0},\n  {\"id\":708616,\"suggestedTranslation\":\"Nó đi thẳng vào vấn đề chính luôn.\",\"rating\":0.0},\n  {\"id\":708617,\"suggestedTranslation\":\"Không phải đâu Woby, đó không phải là một cành cây! Ờ thì, hình như ĐÚNG là cành cây...\",\"rating\":0.0},\n  {\"id\":708618,\"suggestedTranslation\":\"Sốc chưa kìa! Hiểu ý tôi chứ?\",\"rating\":0.0},\n  {\"id\":708619,\"suggestedTranslation\":\"Thiết bị chuyên dụng mang theo gia vị.\",\"rating\":0.0},\n  {\"id\":708620,\"suggestedTranslation\":\"Thêm chút gia vị chẳng hại ai bao giờ.\",\"rating\":0.0},\n  {\"id\":708621,\"suggestedTranslation\":\"Tốt cho sức khỏe lắm đấy!\",\"rating\":0.0},\n  {\"id\":708622,\"suggestedTranslation\":\"Nó giúp đồ ăn khi cắm trại đỡ nhạt nhẽo hơn một chút.\",\"rating\":0.0},\n  {\"id\":708623,\"suggestedTranslation\":\"Ăn nhiều quá sẽ phát ốm đấy.\",\"rating\":0.0},\n  {\"id\":708624,\"suggestedTranslation\":\"Ôi, tội nghiệp chú nhện nhỏ.\",\"rating\":0.0},\n  {\"id\":708625,\"suggestedTranslation\":\"Ồ, cậu là một con nhện to lớn đấy!\",\"rating\":0.0},\n  {\"id\":708626,\"suggestedTranslation\":\"Đừng để ý đến tôi nhé!\",\"rating\":0.0},\n  {\"id\":708627,\"suggestedTranslation\":\"Đó là một thói quen tốt.\",\"rating\":0.0},\n  {\"id\":708628,\"suggestedTranslation\":\"Trông nó có vẻ chết rồi đấy, Woby. Nhưng cứ cẩn thận vẫn hơn.\",\"rating\":0.0},\n  {\"id\":708629,\"suggestedTranslation\":\"Mình quên thiêu nó đi mất rồi. Ôi chao!\",\"rating\":0.0},\n  {\"id\":708630,\"suggestedTranslation\":\"Ồ, chắc đó là nơi lũ nhện sống! To khủng khiếp luôn!\",\"rating\":0.0},\n  {\"id\":708631,\"suggestedTranslation\":\"Cậu ta sắp giành được huy hiệu Thủ công mỹ nghệ rồi đấy.\",\"rating\":0.0},\n  {\"id\":708632,\"suggestedTranslation\":\"Ôi, toàn là nhện con không kìa!\",\"rating\":0.0},\n  {\"id\":708633,\"suggestedTranslation\":\"Cái này rất hợp để bỏ vào bộ sơ cứu của tôi đấy.\",\"rating\":0.0},\n  {\"id\":708634,\"suggestedTranslation\":\"Woby cứ gừ gừ vào mặt tôi khi tôi đội nó...\",\"rating\":0.0},\n  {\"id\":708635,\"suggestedTranslation\":\"Ai đó cần phải phủi bụi thường xuyên hơn đấy, mọi thứ phủ đầy mạng nhện rồi kìa!\",\"rating\":0.0},\n  {\"id\":708636,\"suggestedTranslation\":\"Ai đó cần phải phủi bụi thường xuyên hơn đấy, mọi thứ phủ đầy mạng nhện rồi kìa!\",\"rating\":0.0},\n  {\"id\":708637,\"suggestedTranslation\":\"Tôi chưa từng nghe việc loài nhện lại có nữ hoàng bao giờ, thú vị thật đấy!\",\"rating\":0.0},\n  {\"id\":708638,\"suggestedTranslation\":\"Chúng ta đã làm đúng, Woby.\",\"rating\":0.0},\n  {\"id\":708639,\"suggestedTranslation\":\"An nghỉ nhé, Nữ hoàng.\",\"rating\":0.0},\n  {\"id\":708640,\"suggestedTranslation\":\"Lẽ ra chúng ta nên thiêu nó đi. Ôi chao.\",\"rating\":0.0},\n  {\"id\":708641,\"suggestedTranslation\":\"Úi! Cậu làm tôi giật mình đấy!\",\"rating\":0.0},\n  {\"id\":708642,\"suggestedTranslation\":\"Ồ, đúng là một chú nhện nhỏ hữu ích!\",\"rating\":0.0},\n  {\"id\":708643,\"suggestedTranslation\":\"Nó giống như một bộ sơ cứu dành cho nhện vậy!\",\"rating\":0.0},\n  {\"id\":708644,\"suggestedTranslation\":\"Úi! Cậu làm tôi giật mình đấy!\",\"rating\":0.0},\n  {\"id\":708645,\"suggestedTranslation\":\"Ồ, nó chết rồi.\",\"rating\":0.0},\n  {\"id\":708646,\"suggestedTranslation\":\"Ồ, sao chúng lại biến thành thế kia nhỉ? Tôi phải lại gần xem mới được!\",\"rating\":0.0},\n  {\"id\":708647,\"suggestedTranslation\":\"Chắc tôi có thể đến gần lúc chúng đang ngủ.\",\"rating\":0.0},\n  {\"id\":708648,\"suggestedTranslation\":\"Ơ hay, sao tôi lại muốn lũ nhện biến đi cơ chứ?\",\"rating\":0.0},\n  {\"id\":708649,\"suggestedTranslation\":\"Ồ ố ô! Nhìn cậu kìa!\",\"rating\":0.0},\n  {\"id\":708650,\"suggestedTranslation\":\"Xin lỗi nhé, cậu khơi màu trước mà!\",\"rating\":0.0},\n  {\"id\":708651,\"suggestedTranslation\":\"Nhìn màu sắc trên người con kìa!\",\"rating\":0.0},\n  {\"id\":708652,\"suggestedTranslation\":\"Chắc tôi nên để mặc chúng thì hơn...\",\"rating\":0.0},\n  {\"id\":708653,\"suggestedTranslation\":\"Ồ, nhìn chúng bơi trên nước nhanh chưa kìa, Woby!\",\"rating\":0.0},\n  {\"id\":708654,\"suggestedTranslation\":\"Này Webber, gọi mấy con nhện ra đây nào!\",\"rating\":0.0},\n  {\"id\":708655,\"suggestedTranslation\":\"Hợ, cá ươn!\",\"rating\":0.0},\n  {\"id\":708656,\"suggestedTranslation\":\"Chắc tôi không nên ăn cái này đâu...\",\"rating\":0.0},\n  {\"id\":708657,\"suggestedTranslation\":\"Đừng có ăn mấy cái bào tử đấy nhé Woby, cây nấm sẽ mọc trong bụng cậu mất đấy!\",\"rating\":0.0},\n  {\"id\":708658,\"suggestedTranslation\":\"Mấy con bọ trong túi tôi chắc thích chút ánh sáng đấy.\",\"rating\":0.0},\n  {\"id\":708659,\"suggestedTranslation\":\"Chắc tôi không nên chạm vào nó đâu.\",\"rating\":0.0},\n  {\"id\":708660,\"suggestedTranslation\":\"Khí đầm lầy á! Ồ, hóa ra chỉ là mấy bào tử nữa thôi.\",\"rating\":0.0},\n  {\"id\":708661,\"suggestedTranslation\":\"Mấy con bọ trong túi tôi chắc thích chút ánh sáng đấy.\",\"rating\":0.0},\n  {\"id\":708662,\"suggestedTranslation\":\"Mong là mình không vô tình nuốt nhầm một cái.\",\"rating\":0.0},\n  {\"id\":708663,\"suggestedTranslation\":\"Mấy con bọ trong túi tôi chắc thích chút ánh sáng đấy.\",\"rating\":0.0},\n  {\"id\":708664,\"suggestedTranslation\":\"Không biết đó là kích cỡ tối đa của chúng, hay đây chỉ là mấy con mực con...\",\"rating\":0.0},\n  {\"id\":708665,\"suggestedTranslation\":\"Tôi vừa thấy lạnh sống lưng xong.\",\"rating\":0.0},\n  {\"id\":708666,\"suggestedTranslation\":\"Gần như tốt hơn cả lửa trại.\",\"rating\":0.0},\n  {\"id\":708667,\"suggestedTranslation\":\"Ừm, cái đó đúng là có ma thuật rồi.\",\"rating\":0.0},\n  {\"id\":708668,\"suggestedTranslation\":\"Đúng là đau đầu... hì.\",\"rating\":0.0},\n  {\"id\":708669,\"suggestedTranslation\":\"Biết đâu nó cũng muốn nướng kẹo dẻo cùng nhỉ?\",\"rating\":0.0},\n  {\"id\":708670,\"suggestedTranslation\":\"Woby, sao thế hả? Chỉ là cái bàn thôi mà.\",\"rating\":0.0},\n  {\"id\":708671,\"suggestedTranslation\":\"Woby, sao thế hả? Chỉ là cái bàn thôi mà.\",\"rating\":0.0},\n  {\"id\":708672,\"suggestedTranslation\":\"Biết đâu nó cũng muốn nướng kẹo dẻo cùng nhỉ?\",\"rating\":0.0},\n  {\"id\":708673,\"suggestedTranslation\":\"Mọi người hay nhầm lẫn măng đá và thạch nhũ, nhưng tôi thì phân biệt được rõ ràng nhé!\",\"rating\":0.0},\n  {\"id\":708674,\"suggestedTranslation\":\"Đúng là một cột... thứ này cao thật!\",\"rating\":0.0},\n  {\"id\":708675,\"suggestedTranslation\":\"Một bộ xương sống bằng xương bằng thịt!\",\"rating\":0.0},\n  {\"id\":708676,\"suggestedTranslation\":\"Biết đâu hắn lại biết gì đó về người bọ từng sống ở đây!\",\"rating\":0.0},\n  {\"id\":708677,\"suggestedTranslation\":\"Không biết tôi có bắt được một con không nhỉ!\",\"rating\":0.0},\n  {\"id\":708678,\"suggestedTranslation\":\"Tôi có bao nhiêu là câu hỏi luôn!! Cậu có thể cảm nhận mọi thứ mà không có da không? Cậu có ăn không? Cậu nhìn bằng cách nào thế? ...Này, cậu đi đâu đấy?\",\"rating\":0.0},\n  {\"id\":708679,\"suggestedTranslation\":\"Mọi Hướng đạo sinh Cây Thông đều biết cách dò theo bản đồ.\",\"rating\":0.0},\n  {\"id\":708680,\"suggestedTranslation\":\"Xin lỗi nhé...\",\"rating\":0.0},\n  {\"id\":708681,\"suggestedTranslation\":\"Trông y chang cậu ấy luôn!\",\"rating\":0.0},\n  {\"id\":708682,\"suggestedTranslation\":\"Tôi không nghĩ nó có khiếu âm nhạc đâu. Hì... nói hay đấy, Walter.\",\"rating\":0.0},\n  {\"id\":708683,\"suggestedTranslation\":\"Nó bị dây leo mọc phủ kín hết cả rồi.\",\"rating\":0.0},\n  {\"id\":708684,\"suggestedTranslation\":\"Tôi bắt đầu nghĩ gã Maxwell đó có hơi tự cao tự đại rồi đấy.\",\"rating\":0.0},\n  {\"id\":708685,\"suggestedTranslation\":\"Không biết ai đã làm ra mấy thứ này nhỉ?\",\"rating\":0.0},\n  {\"id\":708686,\"suggestedTranslation\":\"Trông giống như một món đồ trong bảo tàng vậy.\",\"rating\":0.0},\n  {\"id\":708687,\"suggestedTranslation\":\"Cũng được, tôi đoán thế.\",\"rating\":0.0},\n  {\"id\":708688,\"suggestedTranslation\":\"Cái đó thì đúng là mời gọi lũ chim đến đậu lên đầu mà.\",\"rating\":0.0},\n  {\"id\":708689,\"suggestedTranslation\":\"Dùng để đan những chiếc áo len cực kỳ ngứa.\",\"rating\":0.0},\n  {\"id\":708690,\"suggestedTranslation\":\"Nào Thuyền phó Woby, chúng ta đi ra khơi thôi!\",\"rating\":0.0},\n  {\"id\":708691,\"suggestedTranslation\":\"Lắp thêm bánh lái có lẽ là một ý hay đấy.\",\"rating\":0.0},\n  {\"id\":708692,\"suggestedTranslation\":\"Áaaa! Tránh ra xa tôi nhanh lên, làm ơn!\",\"rating\":0.0},\n  {\"id\":708693,\"suggestedTranslation\":\"Xin lỗi Woby, cái đó không dành cho cậu đâu.\",\"rating\":0.0},\n  {\"id\":708694,\"suggestedTranslation\":\"Xin lỗi Woby, cái đó không dành cho cậu đâu.\",\"rating\":0.0},\n  {\"id\":708695,\"suggestedTranslation\":\"Woby, không được đặt chân lên bàn!\",\"rating\":0.0},\n  {\"id\":708696,\"suggestedTranslation\":\"Woby, không được đặt chân lên bàn!\",\"rating\":0.0},\n  {\"id\":708697,\"suggestedTranslation\":\"Chúng ta nên thử sửa nó xem!\",\"rating\":0.0},\n  {\"id\":708698,\"suggestedTranslation\":\"Đấy mới là đi nhặt đồ chứ, Woby!\",\"rating\":0.0},\n  {\"id\":708699,\"suggestedTranslation\":\"Chiếc mũ đó mà đem đi kiểm tra đồng phục thì thể nào cũng rớt.\",\"rating\":0.0},\n  {\"id\":708700,\"suggestedTranslation\":\"Một món rau được nhồi thêm rau.\",\"rating\":0.0},\n  {\"id\":708701,\"suggestedTranslation\":\"Tôi có thể nhét thêm chút nữa vào mồm đây.\",\"rating\":0.0},\n  {\"id\":708702,\"suggestedTranslation\":\"Chúng khá hữu ích cho mấy vết cắt và vết bỏng nhẹ.\",\"rating\":0.0},\n  {\"id\":708703,\"suggestedTranslation\":\"Phơi khô hoàn hảo!\",\"rating\":0.0},\n  {\"id\":708704,\"suggestedTranslation\":\"Chúng thuộc họ xương rồng đấy!\",\"rating\":0.0},\n  {\"id\":708705,\"suggestedTranslation\":\"Trông cũng được. Nhưng tôi thích cây trồng ngoài trời hơn.\",\"rating\":0.0},\n  {\"id\":708706,\"suggestedTranslation\":\"Sao con trai này lại to thế nhỉ?\",\"rating\":0.0},\n  {\"id\":708707,\"suggestedTranslation\":\"Tôi không mở nó ra được.\",\"rating\":0.0},\n  {\"id\":708708,\"suggestedTranslation\":\"Ngăn nắp thật đấy!\",\"rating\":0.0},\n  {\"id\":708709,\"suggestedTranslation\":\"Đừng lo Woby, tôi chắc là nó ổn thôi!\",\"rating\":0.0},\n  {\"id\":708710,\"suggestedTranslation\":\"Ừm. Có lẽ tôi nói hơi sớm thì phải...\",\"rating\":0.0},\n  {\"id\":708711,\"suggestedTranslation\":\"Cái đó thì chẳng đi đâu được đâu!\",\"rating\":0.0},\n  {\"id\":708712,\"suggestedTranslation\":\"Đừng lo Woby, tôi chắc là nó ổn thôi!\",\"rating\":0.0},\n  {\"id\":708713,\"suggestedTranslation\":\"Sao nó lại dễ phá hủy thế nhỉ?\",\"rating\":0.0},\n  {\"id\":708714,\"suggestedTranslation\":\"Hoàn toàn không thể phá hủy!\",\"rating\":0.0},\n  {\"id\":708715,\"suggestedTranslation\":\"Cá là có vài bí mật thú vị đang ẩn giấu bên dưới đấy!\",\"rating\":0.0},\n  {\"id\":708716,\"suggestedTranslation\":\"Cá là có vài bí mật thú vị đang ẩn giấu bên dưới đấy!\",\"rating\":0.0},\n  {\"id\":708717,\"suggestedTranslation\":\"No nê thật đấy!\",\"rating\":0.0},\n  {\"id\":708718,\"suggestedTranslation\":\"Trông cái này không giống đồ phiêu lưu cho lắm.\",\"rating\":0.0},\n  {\"id\":708719,\"suggestedTranslation\":\"Sẽ không phải là ngày lễ nếu thiếu nó!\",\"rating\":0.0},\n  {\"id\":708720,\"suggestedTranslation\":\"Nó làm đầu tôi thấy hơi ong ong... nhưng chắc là không sao đâu!\",\"rating\":0.0},\n  {\"id\":708721,\"suggestedTranslation\":\"Một thanh kiếm không gian! Tuyệt đấy!\",\"rating\":0.0},\n  {\"id\":708722,\"suggestedTranslation\":\"Kẻ keo kiệt nào đã phá hỏng bữa tiệc thế này?\",\"rating\":0.0},\n  {\"id\":708723,\"suggestedTranslation\":\"Bàn đã được dọn xong và sẵn sàng phục vụ đồ ăn rồi!\",\"rating\":0.0},\n  {\"id\":708724,\"suggestedTranslation\":\"Mời mọi người xơi nhé!\",\"rating\":0.0},\n  {\"id\":708725,\"suggestedTranslation\":\"Ta ăn cái đó lúc nào chẳng được, Tiệc Mùa Đông phải đặc biệt chứ!\",\"rating\":0.0},\n  {\"id\":708726,\"suggestedTranslation\":\"Nó có đủ chỗ cho tất cả dụng cụ câu cá của tôi.\",\"rating\":0.0},\n  {\"id\":708727,\"suggestedTranslation\":\"Cái này trông khá dễ làm đấy.\",\"rating\":0.0},\n  {\"id\":708728,\"suggestedTranslation\":\"Không phải khoe đâu, nhưng tôi có huy hiệu câu cá thật đấy nhé.\",\"rating\":0.0},\n  {\"id\":708729,\"suggestedTranslation\":\"Đừng ăn nhiều quá kẻo lại đau bụng đấy.\",\"rating\":0.0},\n  {\"id\":708730,\"suggestedTranslation\":\"Ối! Cậu biết bay không? Hay cậu giống đà điểu hơn?\",\"rating\":0.0},\n  {\"id\":708731,\"suggestedTranslation\":\"Quả trứng gì mà to thế!\",\"rating\":0.0},\n  {\"id\":708732,\"suggestedTranslation\":\"Đôi khi tự nhiên là thế đấy.\",\"rating\":0.0},\n  {\"id\":708733,\"suggestedTranslation\":\"Nào Woby, giúp tôi sưởi ấm nó đi.\",\"rating\":0.0},\n  {\"id\":708734,\"suggestedTranslation\":\"Nó đang nở kìa! Nó đang nở thật rồi!\",\"rating\":0.0},\n  {\"id\":708735,\"suggestedTranslation\":\"Ôi thôi, thành trứng ốp la mất nếu chúng ta không làm mát nó xuống đấy.\",\"rating\":0.0},\n  {\"id\":708736,\"suggestedTranslation\":\"Mấy quả trứng này mất bao lâu để nở thế nhỉ?\",\"rating\":0.0},\n  {\"id\":708737,\"suggestedTranslation\":\"Nó sẽ nở bất cứ lúc nào thôi, tôi chắc chắn đấy!\",\"rating\":0.0},\n  {\"id\":708738,\"suggestedTranslation\":\"Nó đang bảo vệ tổ của mình...\",\"rating\":0.0},\n  {\"id\":708739,\"suggestedTranslation\":\"Trứng tàng hình à? Ồ không, hóa ra chỉ là trống không thôi.\",\"rating\":0.0},\n  {\"id\":708740,\"suggestedTranslation\":\"Bữa sáng cỡ bự cho quái vật đấy!\",\"rating\":0.0},\n  {\"id\":708741,\"suggestedTranslation\":\"Úi, món này ngon phết đấy!\",\"rating\":0.0},\n  {\"id\":708742,\"suggestedTranslation\":\"Chẳng ai hiểu chúng ta cả, phải không?\",\"rating\":0.0},\n  {\"id\":708743,\"suggestedTranslation\":\"Đói à? Để xem tôi có gì nào.\",\"rating\":0.0},\n  {\"id\":708744,\"suggestedTranslation\":\"Ngủ ngon nhé!\",\"rating\":0.0},\n  {\"id\":708745,\"suggestedTranslation\":\"Chúng chỉ cáu kỉnh vì đói bụng thôi.\",\"rating\":0.0},\n  {\"id\":708746,\"suggestedTranslation\":\"Nào Woby, chúng ta đi tìm mấy viên ngọc tím thôi.\",\"rating\":0.0},\n  {\"id\":708747,\"suggestedTranslation\":\"Mọi thứ đã sẵn sàng!\",\"rating\":0.0},\n  {\"id\":708748,\"suggestedTranslation\":\"Nào Woby, chúng ta còn nhiều việc phải khám phá lắm đấy!\",\"rating\":0.0},\n  {\"id\":708749,\"suggestedTranslation\":\"Trông nó đích thị là một thứ... ma thuật nào đó.\",\"rating\":0.0},\n  {\"id\":708750,\"suggestedTranslation\":\"Hừm, nó vẫn thiếu thứ gì đó...\",\"rating\":0.0},\n  {\"id\":708751,\"suggestedTranslation\":\"Tôi nghĩ mình sắp hoàn thành rồi đấy, Woby!\",\"rating\":0.0},\n  {\"id\":708752,\"suggestedTranslation\":\"Không biết bên trong có gì nhỉ?\",\"rating\":0.0},\n  {\"id\":708753,\"suggestedTranslation\":\"Cái này trông phức tạp phết...\",\"rating\":0.0},\n  {\"id\":708754,\"suggestedTranslation\":\"Chính xác thì cái này là cái quái gì vậy?\",\"rating\":0.0},\n  {\"id\":708755,\"suggestedTranslation\":\"Cái này trông có vẻ quan trọng.\",\"rating\":0.0},\n  {\"id\":708756,\"suggestedTranslation\":\"Nhưng hành trình di chuyển mới là một nửa thú vị!\",\"rating\":0.0},\n  {\"id\":708757,\"suggestedTranslation\":\"Chắc tôi dựng lều gần đống lửa trại quá rồi.\",\"rating\":0.0},\n  {\"id\":708758,\"suggestedTranslation\":\"Tôi luôn ngủ ngon hơn khi ở trong lều.\",\"rating\":0.0},\n  {\"id\":708759,\"suggestedTranslation\":\"Tôi muốn thấy sinh vật lạ gắn liền với nó quá!\",\"rating\":0.0},\n  {\"id\":708760,\"suggestedTranslation\":\"Một món quà lưu niệm từ sinh vật đầm lầy.\",\"rating\":0.0},\n  {\"id\":708761,\"suggestedTranslation\":\"Bạn có thể tìm thấy công dụng cho hầu hết mọi thứ trong tự nhiên.\",\"rating\":0.0},\n  {\"id\":708762,\"suggestedTranslation\":\"Trông cái cột đó kỳ cục thật.\",\"rating\":0.0},\n  {\"id\":708763,\"suggestedTranslation\":\"Tôi hơi muốn chọc vào nó một tí.\",\"rating\":0.0},\n  {\"id\":708764,\"suggestedTranslation\":\"Mấy cái này đều là của cùng một sinh vật à?\",\"rating\":0.0},\n  {\"id\":708765,\"suggestedTranslation\":\"Này, có một cái đường hầm kìa! Đi thôi Woby!\",\"rating\":0.0},\n  {\"id\":708766,\"suggestedTranslation\":\"Chắc nó không thể sáng mãi được đâu.\",\"rating\":0.0},\n  {\"id\":708767,\"suggestedTranslation\":\"Ôi không, tôi nghĩ thứ bóng tối đó đã làm cái cây đổ bệnh rồi...\",\"rating\":0.0},\n  {\"id\":708768,\"suggestedTranslation\":\"ÚI! Quá bất bình thường luôn!\",\"rating\":0.0},\n  {\"id\":708769,\"suggestedTranslation\":\"Ồ! Không bình thường chút nào!\",\"rating\":0.0},\n  {\"id\":708770,\"suggestedTranslation\":\"Ơ, chẳng lẽ tụi mình không thể bật nó lên một lát sao?\",\"rating\":0.0},\n  {\"id\":708771,\"suggestedTranslation\":\"Ma quái thật đấy!\",\"rating\":0.0},\n  {\"id\":708772,\"suggestedTranslation\":\"Ôi, tiếc quá cái rương trông gọn gàng thế cơ mà...\",\"rating\":0.0},\n  {\"id\":708773,\"suggestedTranslation\":\"Không biết nó đến đây bằng cách nào nhỉ?\",\"rating\":0.0},\n  {\"id\":708774,\"suggestedTranslation\":\"Cậu nói sao đây, Woby? Hay chúng ta ghé vào xem thử nhé?\",\"rating\":0.0},\n  {\"id\":708775,\"suggestedTranslation\":\"Mấy cục đá từ một nền văn minh cổ đại!\",\"rating\":0.0},\n  {\"id\":708776,\"suggestedTranslation\":\"Chỉ đang lo việc bận của mình thôi, Woby. Hừm.\",\"rating\":0.0},\n  {\"id\":708777,\"suggestedTranslation\":\"Woby, mở to mắt ra mà tìm xem còn mấy mảnh vụn này nữa không đấy!\",\"rating\":0.0},\n  {\"id\":708778,\"suggestedTranslation\":\"Hộc, mùi nồng quá.\",\"rating\":0.0},\n  {\"id\":708779,\"suggestedTranslation\":\"Mong là nó không quá giận tôi...\",\"rating\":0.0},\n  {\"id\":708780,\"suggestedTranslation\":\"Đó là hổ ăn thịt người thật á? Tôi cứ tưởng chúng phải to hơn chứ.\",\"rating\":0.0},\n  {\"id\":708781,\"suggestedTranslation\":\"Biết đâu nó cũng chẳng biết mình đang đi đâu nữa.\",\"rating\":0.0},\n  {\"id\":708782,\"suggestedTranslation\":\"Tôi nghĩ nó ngửi thấy gì đó ở gần đây rồi!\",\"rating\":0.0},\n  {\"id\":708783,\"suggestedTranslation\":\"Trông có vẻ nó không đánh hơi thấy mùi gì cả.\",\"rating\":0.0},\n  {\"id\":708784,\"suggestedTranslation\":\"Nhìn kìa, nó tìm thấy rồi!\",\"rating\":0.0},\n  {\"id\":708785,\"suggestedTranslation\":\"Chắc chúng ta nên thử tìm ở chỗ khác đi.\",\"rating\":0.0},\n  {\"id\":708786,\"suggestedTranslation\":\"Nào Woby, chúng ta đi theo nó thôi!\",\"rating\":0.0},\n  {\"id\":708787,\"suggestedTranslation\":\"Úi, xin lỗi nhé! Hổ ăn thịt người nào mà trông cũng y chang nhau...\",\"rating\":0.0},\n  {\"id\":708788,\"suggestedTranslation\":\"Này! Không cho phép cỏ dại mọc trong vườn đâu nhé!\",\"rating\":0.0},\n  {\"id\":708789,\"suggestedTranslation\":\"Đến cả cỏ dại cũng có ích khi ở chốn hoang dã đấy!\",\"rating\":0.0},\n  {\"id\":708790,\"suggestedTranslation\":\"Phơi khô hoàn hảo!\",\"rating\":0.0},\n  {\"id\":708791,\"suggestedTranslation\":\"Một con quái vật ếch khổng lồ bằng xương bằng thịt!\",\"rating\":0.0},\n  {\"id\":708792,\"suggestedTranslation\":\"Tôi không nghĩ hắn thích chúng ta cho lắm đâu.\",\"rating\":0.0},\n  {\"id\":708793,\"suggestedTranslation\":\"Sao thế Woby? Chỉ là một cái hố bình thường dưới đất thôi mà.\",\"rating\":0.0},\n  {\"id\":708794,\"suggestedTranslation\":\"Đừng có nhát gan thế chứ Woby, chỉ là một cây cóc nấm thôi mà!\",\"rating\":0.0},\n  {\"id\":708795,\"suggestedTranslation\":\"Này! Cái gì trong kia thế nhỉ?\",\"rating\":0.0},\n  {\"id\":708796,\"suggestedTranslation\":\"Mẹ có trồng mấy khóm cà chua ở sau vườn nhà.\",\"rating\":0.0},\n  {\"id\":708797,\"suggestedTranslation\":\"Nó chỉ làm nó nhũn ra thêm thôi...\",\"rating\":0.0},\n  {\"id\":708798,\"suggestedTranslation\":\"Nó còn to hơn cả cậu nữa đấy Woby! Ờ thì, ít ra là so với một phiên bản của cậu.\",\"rating\":0.0},\n  {\"id\":708799,\"suggestedTranslation\":\"Chúng ta nên trồng chúng ở đâu đây, Woby?\",\"rating\":0.0},\n  {\"id\":708800,\"suggestedTranslation\":\"Trông có vẻ lạc quẻ giữa chốn hoang dã này thật.\",\"rating\":0.0},\n  {\"id\":708801,\"suggestedTranslation\":\"Cậu nghĩ hắn có thể dạy tôi cách kéo thỏ ra từ trong đó không?\",\"rating\":0.0},\n  {\"id\":708802,\"suggestedTranslation\":\"Ở Anh người ta dùng cái này thay cho đèn pin à?\",\"rating\":0.0},\n  {\"id\":708803,\"suggestedTranslation\":\"Anh họ tôi ở Bờ Đông từng làm món này cho chúng tôi ăn, ngon tuyệt cú mèo!\",\"rating\":0.0},\n  {\"id\":708804,\"suggestedTranslation\":\"Đi thôi!\",\"rating\":0.0},\n  {\"id\":708805,\"suggestedTranslation\":\"Sẵn sàng cho một hành trình tiến vào vùng đất không rõ chưa Woby?\",\"rating\":0.0},\n  {\"id\":708806,\"suggestedTranslation\":\"Nó đã sẵn sàng đưa chúng ta đi đâu đó rồi kìa!\",\"rating\":0.0},\n  {\"id\":708807,\"suggestedTranslation\":\"Hèn gì cô ta cáu kỉnh, hóa ra có một cái hố trong bụng!\",\"rating\":0.0},\n  {\"id\":708808,\"suggestedTranslation\":\"Món ăn vặt tủ của mọi nhà thám hiểm gan dạ!\",\"rating\":0.0},\n  {\"id\":708809,\"suggestedTranslation\":\"Cậu ta có cánh tay khỏe thật đấy.\",\"rating\":0.0},\n  {\"id\":708810,\"suggestedTranslation\":\"Tất nhiên là tôi biết nó là gì rồi! Nó là... ừm... ờ...\",\"rating\":0.0},\n  {\"id\":708811,\"suggestedTranslation\":\"Chúng tôi được học cách làm mấy cái này ở hội Hướng đạo sinh Cây Thông đấy.\",\"rating\":0.0},\n  {\"id\":708812,\"suggestedTranslation\":\"Cậu ta làm việc này khá thật đấy!\",\"rating\":0.0},\n  {\"id\":708813,\"suggestedTranslation\":\"Giờ thì chỉ toàn cục đá thôi.\",\"rating\":0.0},\n  {\"id\":708814,\"suggestedTranslation\":\"Xin lỗi Woby, mấy thứ đó không phải đồ ăn vặt đâu.\",\"rating\":0.0},\n  {\"id\":708815,\"suggestedTranslation\":\"Cẩn thận đấy Woby, nóng lắm đấy!\",\"rating\":0.0},\n  {\"id\":708816,\"suggestedTranslation\":\"Trông có vẻ ấm áp dễ chịu nhỉ. Ờ, mà hình như hơi quá ấm thì phải...\",\"rating\":0.0},\n  {\"id\":708817,\"suggestedTranslation\":\"N-này, cẩn thận đấy!\",\"rating\":0.0},\n  {\"id\":708818,\"suggestedTranslation\":\"Tôi thích sao biển lắm!\",\"rating\":0.0},\n  {\"id\":708819,\"suggestedTranslation\":\"Bọn tôi có được học làm mấy cái bẫy thế này trong hội Hướng đạo sinh Cây Thông đâu...\",\"rating\":0.0},\n  {\"id\":708820,\"suggestedTranslation\":\"Cái đó có thể làm ai đó bị thương đấy!\",\"rating\":0.0},\n  {\"id\":708821,\"suggestedTranslation\":\"Đồ đạc của tôi!!\",\"rating\":0.0},\n  {\"id\":708822,\"suggestedTranslation\":\"Nó không phải rương đồ chơi đâu, đây là rương VẬT TƯ rất ra trò đấy.\",\"rating\":0.0},\n  {\"id\":708823,\"suggestedTranslation\":\"Cứ nhìn xem nó chứa được bao nhiêu vật tư sinh tồn quan trọng kìa!\",\"rating\":0.0},\n  {\"id\":708824,\"suggestedTranslation\":\"Biết đâu bên trong lại có kho báu hải tặc bị nguyền rủa thì sao!\",\"rating\":0.0},\n  {\"id\":708825,\"suggestedTranslation\":\"Tránh ra nào, mấy cái cây! Tôi chỉ muốn xem có gì đằng kia thôi!\",\"rating\":0.0},\n  {\"id\":708826,\"suggestedTranslation\":\"May là chúng ta tìm được công dụng khác cho mấy quả sung ngoài việc ăn chúng...\",\"rating\":0.0},\n  {\"id\":708827,\"suggestedTranslation\":\"Cẩn thận đấy, Wobes!\",\"rating\":0.0},\n  {\"id\":708828,\"suggestedTranslation\":\"Giờ thì chúng ta có thể khai thác nó rồi!\",\"rating\":0.0},\n  {\"id\":708829,\"suggestedTranslation\":\"Làm sao để giải thoát cục đá đây? Thật là một câu hỏi nhức nhối để rìu giải quyết!\",\"rating\":0.0},\n  {\"id\":708830,\"suggestedTranslation\":\"Nó sẽ lớn lên thật cao và khỏe mạnh cho xem!\",\"rating\":0.0},\n  {\"id\":708831,\"suggestedTranslation\":\"Chúng ta nên trồng cây con này ở đâu đây, Woby?\",\"rating\":0.0},\n  {\"id\":708832,\"suggestedTranslation\":\"Cái này trông có vẻ gây ra khối sát thương đấy.\",\"rating\":0.0},\n  {\"id\":708833,\"suggestedTranslation\":\"Mấy thứ này sẽ làm đạn súng cao su hoàn hảo luôn.\",\"rating\":0.0},\n  {\"id\":708834,\"suggestedTranslation\":\"Chắc mấy cái này sẽ mang lại nụ cười cho ai đó thôi. Hiểu ý tôi chứ?\",\"rating\":0.0},\n  {\"id\":708835,\"suggestedTranslation\":\"Cậu ấy bảo rất thích khi tôi kể về bộ sưu tập bọ của mình đấy!\",\"rating\":0.0},\n  {\"id\":708836,\"suggestedTranslation\":\"Vẫn đang ngue nguẩy kìa.\",\"rating\":0.0},\n  {\"id\":708837,\"suggestedTranslation\":\"Tôi cứ nghĩ cách đây một giây cô ta nhìn sang hướng khác cơ chứ...\",\"rating\":0.0}\n]",
