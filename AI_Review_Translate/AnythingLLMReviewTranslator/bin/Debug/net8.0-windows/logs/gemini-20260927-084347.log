\n  },\n  {\n    \"id\": 713581,\n    \"suggestedTranslation\": \"À, tôi vừa có những giấc mơ tuyệt làm sao!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713582,\n    \"suggestedTranslation\": \"Tôi đang thiếu các nguyên liệu cần thiết.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713583,\n    \"suggestedTranslation\": \"Tôi vừa bị phun nước chút xíu thôi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713584,\n    \"suggestedTranslation\": \"Tôi không thích âm thanh đó chút nào đâu!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713585,\n    \"suggestedTranslation\": \"Tôi sắp đến nhà bếp trên chín tầng mây đây.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713586,\n    \"suggestedTranslation\": \"Hừm... Xét cho cùng thì có lẽ tôi thích làm thực thần hơn là chiến đấu.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713587,\n    \"suggestedTranslation\": \"Thôi vậy, đằng nào thì tôi cũng thích dùng ga tự nhiên hơn điện.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713588,\n    \"suggestedTranslation\": \"Trông có vẻ hơi ẩm ướt ở đây rồi nhỉ?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713589,\n    \"suggestedTranslation\": \"À... Tôi đã chuyển từ cứng cáp sang mềm mại rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713590,\n    \"suggestedTranslation\": \"Ôi trời, xét cho cùng thì có vẻ tôi bắt đầu thấy mệt rồi đây...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713591,\n    \"suggestedTranslation\": \"Á không, tôi nghĩ mình sắp hết hơi rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713592,\n    \"suggestedTranslation\": \"Mong là việc đó giúp ích.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713593,\n    \"suggestedTranslation\": \"Giờ ăn tối sắp đến rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713594,\n    \"suggestedTranslation\": \"Không ngon miệng cho lắm.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713595,\n    \"suggestedTranslation\": \"Hơi khô một chút.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713596,\n    \"suggestedTranslation\": \"Tuyệt diệu!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713597,\n    \"suggestedTranslation\": \"Rõ ràng là không ăn được.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713598,\n    \"suggestedTranslation\": \"Ái! Bụng tôi...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713599,\n    \"suggestedTranslation\": \"Ngon tuyệt cú mèo!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713600,\n    \"suggestedTranslation\": \"Eo ôi. Chẳng có chút điểm cộng nào luôn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713601,\n    \"suggestedTranslation\": \"Tôi muốn đổi món khác cơ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713602,\n    \"suggestedTranslation\": \"Nhạt nhẽo quá.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713603,\n    \"suggestedTranslation\": \"Tôi muốn ăn thứ gì đó khác cơ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713604,\n    \"suggestedTranslation\": \"Tôi chịu nổi món ăn này nữa rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713605,\n    \"suggestedTranslation\": \"Đủ lắm rồi đấy!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713606,\n    \"suggestedTranslation\": \"Eo ôi! Sao mình lại để thứ đó chạm vào môi cơ chứ?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713607,\n    \"suggestedTranslation\": \"Cái đó đã quá hạn sử dụng rồi...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713608,\n    \"suggestedTranslation\": \"Quá tuyệt diệu!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713609,\n    \"suggestedTranslation\": \"Thành thật mà nói, tôi cảm thấy xúc phạm với gợi ý đó đấy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713610,\n    \"suggestedTranslation\": \"Mấy người kia có lẽ sẽ thích món này!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713611,\n    \"suggestedTranslation\": \"Nó chẳng bằng súp gà của Maman.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 713612,\n    \"suggestedTranslation\": \"Thật kinh khủng làm sao khi người ta không còn nhận ra thế giới xung quanh mình nữ