            "text": "[\n  {\"id\": 713038, \"suggestedTranslation\": \"Tôi cứ có linh cảm nó sắp chạy đến nơi rồi.\", \"rating\": 9.0},\n  {\"id\": 713039, \"suggestedTranslation\": \"Ăn một cái rồi là khó dừng lại lắm.\", \"rating\": 9.0},\n  {\"id\": 713040, \"suggestedTranslation\": \"Ưm, kẹo bạc hà!\", \"rating\": 9.0},\n  {\"id\": 713041, \"suggestedTranslation\": \"\\\"Vĩnh cửu\\\" á? Hừ!\", \"rating\": 9.0},\n  {\"id\": 713042, \"suggestedTranslation\": \"Tôi chưa bao giờ hiểu nổi tại sao lại đi làm món tráng miệng trông giống một khúc gỗ cả.\", \"rating\": 9.0},\n  {\"id\": 713043, \"suggestedTranslation\": \"Thôi được, chắc ăn chút bánh pudding thôi.\", \"rating\": 9.0},\n  {\"id\": 713044, \"suggestedTranslation\": \"Thứ gì đó ấm nóng để nhâm nhi.\", \"rating\": 9.0},\n  {\"id\": 713045, \"suggestedTranslation\": \"Một cốc ngọt ngào nóng hổi.\", \"rating\": 9.0},\n  {\"id\": 713046, \"suggestedTranslation\": \"Một ly eggnog lạnh pha chút thì chắc sẽ sảng khoái đây.\", \"rating\": 9.0},\n  {\"id\": 713047, \"suggestedTranslation\": \"Tôi không sao cưỡng lại việc sưu tầm đồ linh tinh được.\", \"rating\": 9.0},\n  {\"id\": 713048, \"suggestedTranslation\": \"À. Ký ức ùa về.\", \"rating\": 9.0},\n  {\"id\": 713049, \"suggestedTranslation\": \"Chắc tôi bỏ lỡ món này rồi.\", \"rating\": 9.0},\n  {\"id\": 713050, \"suggestedTranslation\": \"Một gia đình đáng yêu làm sao.\", \"rating\": 9.0},\n  {\"id\": 713051, \"suggestedTranslation\": \"Đây có phải là loại nến điện mà tôi từng nghe nói đến không?\", \"rating\": 9.0},\n  {\"id\": 713052, \"suggestedTranslation\": \"Lẽ ra tôi nên dành nhiều thời gian hơn cho cô ấy.\", \"rating\": 9.0},\n  {\"id\": 713053, \"suggestedTranslation\": \"Tôi cá là do mấy cây nến điện kiểu mới châm ngòi đấy.\", \"rating\": 9.0},\n  {\"id\": 713054, \"suggestedTranslation\": \"Cây cối đôi khi cũng bị vậy mà.\", \"rating\": 9.0},\n  {\"id\": 713055, \"suggestedTranslation\": \"Đó là một cây thông đã trưởng thành.\", \"rating\": 9.0},\n  {\"id\": 713056, \"suggestedTranslation\": \"Một cây non trong chiếc xô gỗ nhỏ.\", \"rating\": 9.0},\n  {\"id\": 713057, \"suggestedTranslation\": \"Lại làm mất vui rồi.\", \"rating\": 9.0},\n  {\"id\": 713058, \"suggestedTranslation\": \"Hình như nó chỉ nhận quả thông thôi.\", \"rating\": 9.0},\n  {\"id\": 713059, \"suggestedTranslation\": \"Có cái gì đó đang ngó ra từ bên trong...\", \"rating\": 9.0},\n  {\"id\": 713060, \"suggestedTranslation\": \"So với bọn này thì tôm hùm thường trông thân thiện chán.\", \"rating\": 9.0},\n  {\"id\": 713061, \"suggestedTranslation\": \"Tôi thấy tương lai của bạn sắp phải vào nồi nước sôi rồi đấy.\", \"rating\": 9.0},\n  {\"id\": 713062, \"suggestedTranslation\": \"Nó chết rồi thì mình không nên để phí phạm.\", \"rating\": 9.0},\n  {\"id\": 713063, \"suggestedTranslation\": \"Đến giờ ăn tối rồi!\", \"rating\": 9.0},\n  {\"id\": 713064, \"suggestedTranslation\": \"Tôi thực sự ngạc nhiên khi cậu thanh niên đó quản được cô nhóc này.\", \"rating\": 9.0},\n  {\"id\": 713065, \"suggestedTranslation\": \"Tôi thực sự ngạc nhiên khi cậu thanh niên đó quản được cô nhóc này.\", \"rating\": 9.0},\n  {\"id\": 713066, \"suggestedTranslation\": \"Ôi, xin đừng có chảy nước dãi lên người tôi...\", \"rating\": 9.0},\n  {\"id\": 713067, \"suggestedTranslation\": \"Ôi, xin đừng có chảy nước dãi lên người tôi...\", \"rating\": 9.0},\n  {\"id\": 713068, \"suggestedTranslation\": \"Chắc là với một tách trà thật đặc thì... thôi dẹp đi.\", \"rating\": 9.0},\n  {\"id\": 713069, \"suggestedTranslation\": \"Không ai thích kẻ bắt nạt đâu, %s!\", \"rating\": 9.0},\n  {\"id\": 713070, \"suggestedTranslation\": \"Tôi không nghĩ đó là cách dùng thời gian khôn ngoan đâu, %s...\", \"rating\": 9.0},\n  {\"id\": 713071, \"suggestedTranslation\": \"Xin lỗi %s, không có thời gian tán gẫu đâu.\", \"rating\": 9.0},\n  {\"id\": 713072, \"suggestedTranslation\": \"%s! Chuyện này xảy ra khi nào vậy hả?!\", \"rating\": 9.0},\n  {\"id\": 713073, \"suggestedTranslation\": \"%s! Sao anh lại có thể làm thế chứ?!\", \"rating\": 9.0},\n  {\"id\": 713074, \"suggestedTranslation\": \"Lần sau tất cả chúng ta nên nhớ cẩn thận hơn.\", \"rating\": 9.0},\n  {\"id\": 713075, \"suggestedTranslation\": \"Tôi cho là tập thể dục cũng có lúc có nơi của nó.\", \"rating\": 9.0},\n  {\"id\": 713076, \"suggestedTranslation\": \"Dừng ngay cái trò đó lại lập tức cho tôi!\", \"rating\": 9.0},\n  {\"id\": 713077, \"suggestedTranslation\": \"Tôi biết anh đang bực bội, nhưng làm vậy chẳng giải quyết được gì đâu!\", \"rating\": 9.0},\n  {\"id\": 713078, \"suggestedTranslation\": \"Ôi trời, chuyện gì đã xảy ra với anh thế này?\", \"rating\": 9.0},\n  {\"id\": 713079, \"suggestedTranslation\": \"Ngay cả cái chết cũng không hóa giải được lời nguyền sao?\", \"rating\": 9.0},\n  {\"id\": 713080, \"suggestedTranslation\": \"Dù họ là ai thì cũng đi mất rồi, con quái vật đã chiếm lấy thể xác họ rồi!\", \"rating\": 9.0},\n  {\"id\": 713081, \"suggestedTranslation\": \"Ít ra thì lòng dạ họ vẫn hướng thiện.\", \"rating\": 9.0},\n  {\"id\": 713082, \"suggestedTranslation\": \"Trông từng trải thật đấy!\", \"rating\": 9.0},\n  {\"id\": 713083, \"suggestedTranslation\": \"Hành động đó thật thô lỗ và chẳng để làm gì cả, %s!\", \"rating\": 9.0},\n  {\"id\": 713084, \"suggestedTranslation\": \"Hừm. Tôi thề là tôi thấy anh ta biến thành Hươu Sừng Tấm cơ mà.\", \"rating\": 9.0},\n  {\"id\": 713085, \"suggestedTranslation\": \"Chờ tôi một lát nhé %s, mọi chuyện sẽ như chưa từng có gì xảy ra!\", \"rating\": 9.0},\n  {\"id\": 713086, \"suggestedTranslation\": \"Chà, %s đúng là khó đoán thật, nhưng anh lại làm được đấy.\", \"rating\": 9.0},\n  {\"id\": 713087, \"suggestedTranslation\": \"Xin lỗi %s, không có thời gian chào hỏi xã giao đâu!\", \"rating\": 9.0},\n  {\"id\": 713088, \"suggestedTranslation\": \"Đừng lo, tôi sẽ đưa cậu trở lại nguyên hình ngay thôi!\", \"rating\": 9.0},\n  {\"id\": 713089, \"suggestedTranslation\": \"Hừm. Tôi thề là tôi thấy anh ta biến thành hải ly cơ mà.\", \"rating\": 9.0},\n  {\"id\": 713090, \"suggestedTranslation\": \"Mọi chuyện chưa kết thúc với anh đâu, %s. Trừ khi tôi không cứu được!\", \"rating\": 9.0},\n  {\"id\": 713091, \"suggestedTranslation\": \"Hừm. Tôi thề là tôi thấy anh ta biến thành Ngỗng cơ mà.\", \"rating\": 9.0},\n  {\"id\": 713092, \"suggestedTranslation\": \"Đừng lo %s, tôi không để mọi chuyện kết thúc với anh thế này đâu!\", \"rating\": 9.0},\n  {\"id\": 713093, \"suggestedTranslation\": \"Anh đã cướp đi sinh mạng của họ! Tại sao chứ?!\", \"rating\": 9.0},\n  {\"id\": 713094, \"suggestedTranslation\": \"Cậu thực sự có một tấm lòng lớn như bộ râu của mình vậy, %s.\", \"rating\": 9.0},\n  {\"id\": 713095, \"suggestedTranslation\": \"Nó hết làm ghế được rồi.\", \"rating\": 9.0},\n  {\"id\": 713096, \"suggestedTranslation\": \"Tôi nhớ thời của tôi, người ta gọi đó là cái ghế.\", \"rating\": 9.0},\n  {\"id\": 713097, \"suggestedTranslation\": \"Có người ngồi rồi.\", \"rating\": 9.0},\n  {\"id\": 713098, \"suggestedTranslation\": \"Ở cái chốn này thì ngày tháng của nó không còn nhiều đâu.\", \"rating\": 9.0},\n  {\"id\": 713099, \"suggestedTranslation\": \"Một cái bàn. Thế giới này đúng là lắm điều kỳ diệu.\", \"rating\": 9.0},\n  {\"id\": 713100, \"suggestedTranslation\": \"Đúng vậy, có cái gì đó ở trên bàn kìa.\", \"rating\": 9.0},\n  {\"id\": 713101, \"suggestedTranslation\": \"Nhàm chán y như một đống đất bình thường vậy.\", \"rating\": 9.0},\n  {\"id\": 713102, \"suggestedTranslation\": \"Có cái gì đó cứ văng vẳng trong đầu tôi... à, chắc không có gì đâu.\", \"rating\": 9.0},\n  {\"id\": 713103, \"suggestedTranslation\": \"Giờ thì tôi nhớ ra rồi!\", \"rating\": 9.0},\n  {\"id\": 713104, \"suggestedTranslation\": \"Nó đang nghỉ ngơi, tạm thời là thế.\", \"rating\": 9.0},\n  {\"id\": 713105, \"suggestedTranslation\": \"Không phải cách di chuyển tôi thích, nhưng lúc cấp bách thì cứ xài tạm.\", \"rating\": 9.0},\n  {\"id\": 713106, \"suggestedTranslation\": \"Tôi thà tự đi bằng đôi chân của mình còn hơn.\", \"rating\": 9.0},\n  {\"id\": 713107, \"suggestedTranslation\": \"Một món ăn nhẹ phát sáng tuyệt vời!\", \"rating\": 9.0},\n  {\"id\": 713108, \"suggestedTranslation\": \"Có vài nếp nhăn thì đã sao đâu chứ!\", \"rating\": 9.0},\n  {\"id\": 713109, \"suggestedTranslation\": \"Có cái gì đó cứ văng vẳng trong đầu tôi... à, chắc không có gì đâu.\", \"rating\": 9.0},\n  {\"id\": 713110, \"suggestedTranslation\": \"Ôi trời ơi... cậu chịu ngồi yên một chỗ được không hả?!\", \"rating\": 9.0},\n  {\"id\": 713111, \"suggestedTranslation\": \"%s có vẻ không được thông minh cho lắm...\", \"rating\": 9.0},\n  {\"id\": 713112, \"suggestedTranslation\": \"%s! Cậu cao lên kể từ lần cuối chúng ta gặp nhau à?\", \"rating\": 9.0},\n  {\"id\": 713113, \"suggestedTranslation\": \"Đừng lo lắng %s, tôi kiểm soát được hết mọi thứ!\", \"rating\": 9.0},\n  {\"id\": 713114, \"suggestedTranslation\": \"Đồ sát nhân! Tôi sẽ tống cổ cậu xuống lại cái nơi cậu chui lên!\", \"rating\": 9.0},\n  {\"id\": 713115, \"suggestedTranslation\": \"Nhắc tôi đừng bao giờ chết nữa đấy.\", \"rating\": 9.0},\n  {\"id\": 713116, \"suggestedTranslation\": \"Tôi nghĩ nó hỏng rồi.\", \"rating\": 9.0},\n  {\"id\": 713117, \"suggestedTranslation\": \"Đó là củ cà rốt sống động nhất mà tôi từng thấy.\", \"rating\": 9.0},\n  {\"id\": 713118, \"suggestedTranslation\": \"Đừng có ngọ nguậy nữa!\", \"rating\": 9.0},\n  {\"id\": 713119, \"suggestedTranslation\": \"Nó đang chợp mắt một chút thôi.\", \"rating\": 9.0},\n  {\"id\": 713120, \"suggestedTranslation\": \"Đúng là một sinh vật nhỏ ngộ nghĩnh.\", \"rating\": 9.0},\n  {\"id\": 713121, \"suggestedTranslation\": \"Thật tiếc khi chúng lại ngon miệng đến thế.\", \"rating\": 9.0},\n  {\"id\": 713122, \"suggestedTranslation\": \"Chắc là nó chẳng có việc gì hay ho hơn để làm rồi.\", \"rating\": 9.0},\n  {\"id\": 713123, \"suggestedTranslation\": \"Tôi thấy yên tâm phần nào khi biết nó ở gần đây.\", \"rating\": 9.0},\n  {\"id\": 713124, \"suggestedTranslation\": \"Chúng ta quen nhau từ lâu rồi phải không?\", \"rating\": 9.0},\n  {\"id\": 713125, \"suggestedTranslation\": \"Việc đó có thực sự cần thiết không vậy, %s?\", \"rating\": 9.0},\n  {\"id\": 713126, \"suggestedTranslation\": \"%s là một tên tiểu yêu khó đoán thật...\", \"rating\": 9.0},\n  {\"id\": 713127, \"suggestedTranslation\": \"Tôi có cảm giác anh còn đi nhiều nơi hơn cả tôi đấy, %s.\", \"rating\": 9.0},\n  {\"id\": 713128, \"suggestedTranslation\": \"Chỉnh sửa thời gian một chút là cậu lại ngon lành ngay thôi!\", \"rating\": 9.0},\n  {\"id\": 713129, \"suggestedTranslation\": \"Cậu đi quá giới hạn rồi đấy %s, đây không phải trò đùa đâu!\", \"rating\": 9.0},\n  {\"id\": 713130, \"suggestedTranslation\": \"Cậu không lén gặm miếng nào lúc tôi không để ý đấy chứ?\", \"rating\": 9.0},\n  {\"id\": 713131, \"suggestedTranslation\": \"Đa năng á? Tốt.\", \"rating\": 9.0},\n  {\"id\": 713132, \"suggestedTranslation\": \"Tốt nhất là tránh cái chết đi cho đỡ phiền.\", \"rating\": 9.0},\n  {\"id\": 713133, \"suggestedTranslation\": \"Ít ra thì chúng không phải là những linh hồn lang thang.\", \"rating\": 9.0},\n  {\"id\": 713134, \"suggestedTranslation\": \"Cậu lại đang gây chuyện gì à, %s?\", \"rating\": 9.0},\n  {\"id\": 713135, \"suggestedTranslation\": \"Chuyện này không có kết cục tốt đẹp đâu...\", \"rating\": 9.0},\n  {\"id\": 713136, \"suggestedTranslation\": \"Xin lỗi %s, tôi không ở lại tán gẫu được đâu!\", \"rating\": 9.0},\n  {\"id\": 713137, \"suggestedTranslation\": \"Đừng có làm phiền tôi, tôi sẽ đưa cậu về nhanh nhất có thể!\", \"rating\": 9.0},\n  {\"id\": 713138, \"suggestedTranslation\": \"Tránh ra! Giữa tôi và cậu, thì tôi chọn sống!\", \"rating\": 9.0},\n  {\"id\": 713139, \"suggestedTranslation\": \"Tôi nghĩ cô và tôi sẽ hợp nhau lắm đấy, %s.\", \"rating\": 9.0},\n  {\"id\": 713140, \"suggestedTranslation\": \"À, dòng thời gian vương quốc Người Cá \\\"khai sáng\\\". Tiêu đời chúng ta rồi.\", \"rating\": 9.0},\n  {\"id\": 713141, \"suggestedTranslation\": \"Dò