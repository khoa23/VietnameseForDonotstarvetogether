            "text": "[\n  {\n    \"id\": 712438,\n    \"suggestedTranslation\": \"Tôi không nghĩ con nhện đó được lắp ráp đúng cách.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712439,\n    \"suggestedTranslation\": \"Nó vẫn đứng yên, tạm thời là vậy.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712440,\n    \"suggestedTranslation\": \"Ước gì cô ta dùng nó thường xuyên hơn.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712441,\n    \"suggestedTranslation\": \"Đừng làm phiền tôi!\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712442,\n    \"suggestedTranslation\": \"Tôi chọn sự sống cho mình thay vì hắn.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712443,\n    \"suggestedTranslation\": \"Ôi phiền phức thật, tôi ghét mấy đứa có sọc lắm.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712444,\n    \"suggestedTranslation\": \"Ít ra nó không gây rắc rối gì.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712445,\n    \"suggestedTranslation\": \"Biến đi! Sao cứ ở lì trên cây nhà ngươi làm gì?\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712446,\n    \"suggestedTranslation\": \"Ồ, hắn đang tổ chức một buổi tiệc nhện nhỏ à?\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712447,\n    \"suggestedTranslation\": \"Úi chà, thối hoắc rồi!\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712448,\n    \"suggestedTranslation\": \"Thứ từng là thức ăn.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712449,\n    \"suggestedTranslation\": \"Ít ra chúng cũng làm mọi thứ tươi sáng hơn một chút.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712450,\n    \"suggestedTranslation\": \"Mong là nó không bắt đầu mọc lên ở trong đó.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712451,\n    \"suggestedTranslation\": \"Cẩn thận nào...\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712452,\n    \"suggestedTranslation\": \"Trôi đi nào.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712453,\n    \"suggestedTranslation\": \"Mong là nó không bắt đầu mọc lên ở trong đó.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712454,\n    \"suggestedTranslation\": \"Chúng đang tìm chỗ để bám vào đấy.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712455,\n    \"suggestedTranslation\": \"Mong là nó không bắt đầu mọc lên ở trong đó.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712456,\n    \"suggestedTranslation\": \"Làm ơn thắp sáng đường đi mà đừng có phiền phức thế được không?!\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712457,\n    \"suggestedTranslation\": \"Nếu nó giúp tôi không bị chết vì sốc nhiệt thì tôi mãn nguyện rồi.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712458,\n    \"suggestedTranslation\": \"Một ngôi sao bé nhỏ, chuyện gì có thể xảy ra chứ?\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712459,\n    \"suggestedTranslation\": \"Tôi thích giữ mọi thứ ở một khoảng cách an toàn hơn.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712460,\n    \"suggestedTranslation\": \"Ôi phiền phức thật, cứ tưởng đó là la bàn chứ.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712461,\n    \"suggestedTranslation\": \"Ngươi không bao giờ bắt được ta đâu! Ta đã qua mặt ngươi và lũ đồng bọn mọi lúc mọi nơi!\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712462,\n    \"suggestedTranslation\": \"Tôi biết anh đang trốn trong đó đấy.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712463,\n    \"suggestedTranslation\": \"Tôi biết anh đang trốn trong đó đấy.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712464,\n    \"suggestedTranslation\": \"Ngươi không bao giờ bắt được ta đâu! Ta đã qua mặt ngươi và lũ đồng bọn mọi lúc mọi nơi!\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712465,\n    \"suggestedTranslation\": \"Thấy một hòn đá tảng nghĩa là thấy tất cả.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712466,\n    \"suggestedTranslation\": \"Ồ, tuyệt thật. Đi tiếp nào?\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712467,\n    \"suggestedTranslation\": \"Đây là một ý tồi. Tôi thấy hối hận rồi.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712468,\n    \"suggestedTranslation\": \"Đây là một ý RẤT tồi.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712469,\n    \"suggestedTranslation\": \"Ái! Cút khỏi đây mau!\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712470,\n    \"suggestedTranslation\": \"Cuối cùng thì ngươi cũng khôn ra được chút nào chưa?\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712471,\n    \"suggestedTranslation\": \"Xem ra tôi không phải là kẻ duy nhất hay quên chỗ cất đồ.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712472,\n    \"suggestedTranslation\": \"Lúc đó thì hình như đó là một ý hay.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712473,\n    \"suggestedTranslation\": \"Tôi vẫn chưa tài nào hiểu nổi ai đã làm ra cái này...\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712474,\n    \"suggestedTranslation\": \"Thật tò mò khi tất cả chúng hình như đều bị hỏng ở cùng một vị trí...\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712475,\n    \"suggestedTranslation\": \"Có cái gì đó rất lạ ở nó...\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712476,\n    \"suggestedTranslation\": \"\\\"Ai đó\\\" có quá nhiều thời gian rảnh rỗi...\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712477,\n    \"suggestedTranslation\": \"Tôi có thể ngắm chúng sau, chúng có chạy đi đâu được đâu.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712478,\n    \"suggestedTranslation\": \"Tôi không có nhiều sự kiên nhẫn với nghệ thuật cho lắm.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712479,\n    \"suggestedTranslation\": \"Tôi đã thấy nó rồi và có lẽ sẽ còn thấy lại nó lần nữa.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712480,\n    \"suggestedTranslation\": \"Tôi vẫn không chắc ai đã để mấy thứ này ở đây.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712481,\n    \"suggestedTranslation\": \"Có vài thứ ở đây được hiểu theo nghĩa đen hoàn toàn.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712482,\n    \"suggestedTranslation\": \"Đôi tay tội nghiệp của tôi sắp nổi chai sần vì đi biển thế này đây.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712483,\n    \"suggestedTranslation\": \"Mong là tôi không quên lắp cái đó vào thuyền ván.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712484,\n    \"suggestedTranslation\": \"Một vết ong đốt suýt chút nữa là thành.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712485,\n    \"suggestedTranslation\": \"Tôi tin rằng vào thời của tôi, người ta gọi đó là cái ghế.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712486,\n    \"suggestedTranslation\": \"Nó có người ngồi rồi.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712487,\n    \"suggestedTranslation\": \"Một cái bàn. Sự kỳ diệu không bao giờ chấm dứt.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712488,\n    \"suggestedTranslation\": \"Đúng vậy, có cái gì đó trên đó kìa.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712489,\n    \"suggestedTranslation\": \"Có lẽ thời của nó đã đến.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712490,\n    \"suggestedTranslation\": \"Nó đúng là tiết kiệm thời gian thật.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712491,\n    \"suggestedTranslation\": \"Tôi có thể ăn mặc như một bác nông dân, vui phết chứ bộ!\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712492,\n    \"suggestedTranslation\": \"Toàn rau củ từ trong ra ngoài.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712493,\n    \"suggestedTranslation\": \"Tôi không bao giờ thấy quá no để ăn thêm một ít bánh nhồi đâu.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712494,\n    \"suggestedTranslation\": \"Tôi đoán về mặt kỹ thuật thì nó ăn được.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712495,\n    \"suggestedTranslation\": \"Thơm quá.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712496,\n    \"suggestedTranslation\": \"E rằng tôi không thể dừng lại để ngắm nghía mọi cảnh vật đâu.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712497,\n    \"suggestedTranslation\": \"Tôi có vẻ không bao giờ giữ chúng sống nổi lâu.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712498,\n    \"suggestedTranslation\": \"Cái vỏ sò khổng lồ thế này chắc chắn phải có thứ gì đó thú vị bên trong.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712499,\n    \"suggestedTranslation\": \"Ôi phiền phức thật! Mở ra xem nào, cái đồ này!\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712500,\n    \"suggestedTranslation\": \"Tôi có thể nhét cả một cửa hàng mồi câu vào trỏng luôn ấy chứ.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712501,\n    \"suggestedTranslation\": \"Mọi thứ rồi sẽ xuống cấp theo thời gian. Ờ thì, hầu hết mọi thứ.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712502,\n    \"suggestedTranslation\": \"Thời gian đã chẳng đối xử nhẹ nhàng gì.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712503,\n    \"suggestedTranslation\": \"Tự hỏi nó sẽ trụ được bao lâu đây.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712504,\n    \"suggestedTranslation\": \"Mọi thứ rồi sẽ xuống cấp theo thời gian. Ờ thì, hầu hết mọi thứ.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712505,\n    \"suggestedTranslation\": \"Có cái gì là trường tồn đâu cơ chứ?\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712506,\n    \"suggestedTranslation\": \"Hừm. Thời gian sẽ trả lời.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712507,\n    \"suggestedTranslation\": \"Ồ! Tôi tưởng cái đó xong rồi chứ.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712508,\n    \"suggestedTranslation\": \"Ồ! Tôi tưởng cái đó xong rồi chứ.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712509,\n    \"suggestedTranslation\": \"Hoàn hảo cho những ai không thể quyết định nổi.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712510,\n    \"suggestedTranslation\": \"Trông nó giống thứ mà một vị giáo sư già ra vẻ ta đây hay mặc.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712511,\n    \"suggestedTranslation\": \"Một công thức kỳ lạ, nhưng tôi không thể nói là mình không thích nó.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712512,\n    \"suggestedTranslation\": \"Chà... Tôi đoán vẫn còn thời gian để làm một tách trà nhanh.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712513,\n    \"suggestedTranslation\": \"Ồ, tôi khá thích món đó đấy.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712514,\n    \"suggestedTranslation\": \"Bữa tối có lẽ phải đợi một chút.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712515,\n    \"suggestedTranslation\": \"Một cái bàn trống thì chẳng có gì để ngắm cho cam.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712516,\n    \"suggestedTranslation\": \"Một bàn ăn được chuẩn bị tinh tươm.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712517,\n    \"suggestedTranslation\": \"Ôi phiền phức thật, dạo này là mùa nào rồi nhỉ?\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712518,\n    \"suggestedTranslation\": \"Cuối cùng thì những cái túi tội nghiệp của tôi cũng được giải thoát khỏi lưỡi câu và mồi câu cá rồi.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712519,\n    \"suggestedTranslation\": \"Tôi không nghĩ mình từng thấy loại dụng cụ câu này bao giờ. Hoặc có lẽ tôi quên mất tiêu rồi...\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712520,\n    \"suggestedTranslation\": \"Câu cá thật phiền phức, mất biết bao nhiêu thời gian và sự chuẩn bị!\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712521,\n    \"suggestedTranslation\": \"Tôi sẽ không bao giờ quên, baba thường hay mua mấy cái này về cho chúng tôi vào những dịp đặc biệt.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712522,\n    \"suggestedTranslation\": \"Tự hỏi làm sao chúng giữ được thăng bằng hay vậy.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712523,\n    \"suggestedTranslation\": \"Một chú chim trong tương lai.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712524,\n    \"suggestedTranslation\": \"Nó có vị như thời gian bị đánh cắp vậy.\",\n    \"rating\": 0.0\n  },\n  {\n    \"id\": 712525,\n    \"suggestedTranslation\": \"Tôi không nên để nó ở ngoài lạnh.\",\n    \"rating\": 0.0\n  },\n  {\n   