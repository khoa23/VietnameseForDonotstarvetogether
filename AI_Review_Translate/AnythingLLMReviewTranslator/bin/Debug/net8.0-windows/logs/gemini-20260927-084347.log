            "text": "[\n  {\"id\": 709738, \"suggestedTranslation\": \"Trông có vẻ không có ai ở đây cả.\", \"rating\": 9.0},\n  {\"id\": 709739, \"suggestedTranslation\": \"Ừm, nếu anh ta không chịu bắt đầu cuộc thi thì tôi không đứng đợi đâu.\", \"rating\": 9.0},\n  {\"id\": 709740, \"suggestedTranslation\": \"Chẳng có ai ở đây cả.\", \"rating\": 9.0},\n  {\"id\": 709741, \"suggestedTranslation\": \"Cậu ta đang bận.\", \"rating\": 9.0},\n  {\"id\": 709742, \"suggestedTranslation\": \"Tôi chắc chắn mình đã thấy cái này trước đây rồi.\", \"rating\": 9.0},\n  {\"id\": 709743, \"suggestedTranslation\": \"Không có trong dòng thời gian này.\", \"rating\": 9.0},\n  {\"id\": 709744, \"suggestedTranslation\": \"Ha! Thành công!\", \"rating\": 9.0},\n  {\"id\": 709745, \"suggestedTranslation\": \"Tôi nghĩ mình đã hoàn thành mọi việc cần làm rồi.\", \"rating\": 9.0},\n  {\"id\": 709746, \"suggestedTranslation\": \"Có cái gì đó đang đến.\", \"rating\": 9.0},\n  {\"id\": 709747, \"suggestedTranslation\": \"Thất bại là mẹ thành công, hãy đảo ngược thời gian và thử lại.\", \"rating\": 9.0},\n  {\"id\": 709748, \"suggestedTranslation\": \"Mặt đất đang cố nuốt chửng tôi kìa!\", \"rating\": 9.0},\n  {\"id\": 709749, \"suggestedTranslation\": \"Tiếng ầm ầm kinh khủng gì thế này?\", \"rating\": 9.0},\n  {\"id\": 709750, \"suggestedTranslation\": \"Có cái gì đó đang dịch chuyển!\", \"rating\": 9.0},\n  {\"id\": 709751, \"suggestedTranslation\": \"Này, cầm lấy cái này rồi để tôi đi trong bình yên!\", \"rating\": 9.0},\n  {\"id\": 709752, \"suggestedTranslation\": \"Cứ cầm lấy cái này rồi tôi sẽ đi.\", \"rating\": 9.0},\n  {\"id\": 709753, \"suggestedTranslation\": \"Đã đến lúc tiếp tục hành trình rồi.\", \"rating\": 9.0},\n  {\"id\": 709754, \"suggestedTranslation\": \"Nó đang cho tôi thấy những họa tiết kỳ lạ... Tôi không nghĩ mình từng thấy chúng trước đây.\", \"rating\": 9.0},\n  {\"id\": 709755, \"suggestedTranslation\": \"Nơi này giống như một chiếc đồng hồ chưa được lên dây cót vậy.\", \"rating\": 9.0},\n  {\"id\": 709756, \"suggestedTranslation\": \"Tôi biết cái này. Hoặc có lẽ tôi sẽ sớm biết thôi.\", \"rating\": 9.0},\n  {\"id\": 709757, \"suggestedTranslation\": \"Đến lúc di chuyển thôi!\", \"rating\": 9.0},\n  {\"id\": 709758, \"suggestedTranslation\": \"Tôi cần phải ra khỏi đây!\", \"rating\": 9.0},\n  {\"id\": 709759, \"suggestedTranslation\": \"Có chuyện gì đó đang xảy ra... Tôi không thể ở lại đây được!\", \"rating\": 9.0},\n  {\"id\": 709760, \"suggestedTranslation\": \"Tôi muốn đấm cái gì đó quá đi!!\", \"rating\": 9.0},\n  {\"id\": 709761, \"suggestedTranslation\": \"Tôi chưa bao giờ cảm thấy tràn đầy năng lượng thế này!\", \"rating\": 9.0},\n  {\"id\": 709762, \"suggestedTranslation\": \"Tôi cảm thấy hoàn toàn chống nước rồi.\", \"rating\": 9.0},\n  {\"id\": 709763, \"suggestedTranslation\": \"Thật kỳ lạ, tôi cảm thấy an toàn hơn một chút.\", \"rating\": 9.0},\n  {\"id\": 709764, \"suggestedTranslation\": \"Cuối cùng thì tôi cũng không phải lãng phí thời gian để ngủ nữa!\", \"rating\": 9.0},\n  {\"id\": 709765, \"suggestedTranslation\": \"Thế này mới phải chứ! Tôi sẽ làm xong mọi thứ trong chớp mắt!\", \"rating\": 9.0},\n  {\"id\": 709766, \"suggestedTranslation\": \"oOooOooo!!\", \"rating\": 9.0},\n  {\"id\": 709767, \"suggestedTranslation\": \"Ôi phiền phức thật. Mấy con ong đó thực sự làm tôi phát bực!\", \"rating\": 9.0},\n  {\"id\": 709768, \"suggestedTranslation\": \"Ôi không không không! Thuyền ván đang bị ngập nước rồi!!\", \"rating\": 9.0},\n  {\"id\": 709769, \"suggestedTranslation\": \"Không, đợi đã! Tôi cần thêm thời gian!!\", \"rating\": 9.0},\n  {\"id\": 709770, \"suggestedTranslation\": \"Gieo nhân nào gặt quả nấy.\", \"rating\": 9.0},\n  {\"id\": 709771, \"suggestedTranslation\": \"Lần này thì nó có vẻ không đáng sợ cho lắm.\", \"rating\": 9.0},\n  {\"id\": 709772, \"suggestedTranslation\": \"Tôi suýt nữa thì bị thiêu thành than rồi!\", \"rating\": 9.0},\n  {\"id\": 709773, \"suggestedTranslation\": \"Ở đây này!\", \"rating\": 9.0},\n  {\"id\": 709774, \"suggestedTranslation\": \"\\nTôi đã sửa những chiếc đồng hồ phức tạp, sửa cái này chắc chắn sẽ dễ thôi!\", \"rating\": 9.0},\n  {\"id\": 709775, \"suggestedTranslation\": \"Ôi phiền phức thật, tôi sẽ phải đi nhặt vài thứ trước đã.\", \"rating\": 9.0},\n  {\"id\": 709776, \"suggestedTranslation\": \"Tôi sẽ không thể làm được nếu không có bàn chế tạo tử tế.\", \"rating\": 9.0},\n  {\"id\": 709777, \"suggestedTranslation\": \"Tôi vẫn chưa thực sự hiểu rõ cái đó lắm.\", \"rating\": 9.0},\n  {\"id\": 709778, \"suggestedTranslation\": \"Sẽ hiệu quả hơn nếu đặt nó gần Rạp Giám Khảo hơn.\", \"rating\": 9.0},\n  {\"id\": 709779, \"suggestedTranslation\": \"Tại sao tôi có vẻ như không thể...? Ồ không...\", \"rating\": 9.0},\n  {\"id\": 709780, \"suggestedTranslation\": \"Không có thời gian để ngủ đâu!\", \"rating\": 9.0},\n  {\"id\": 709781, \"suggestedTranslation\": \"Đây không phải lúc để đứng ì ra đấy!\", \"rating\": 9.0},\n  {\"id\": 709782, \"suggestedTranslation\": \"Sao tôi lại vớ phải một con Cà Ruột chậm chạp thế này chứ?\", \"rating\": 9.0},\n  {\"id\": 709783, \"suggestedTranslation\": \"Ôi không... chắc là cái khiếu định hướng tệ hại của tôi đã lây sang nó rồi.\", \"rating\": 9.0},\n  {\"id\": 709784, \"suggestedTranslation\": \"Đi sai đường rồi, quay lại đi!\", \"rating\": 9.0},\n  {\"id\": 709785, \"suggestedTranslation\": \"Theo hiệu lệnh của tôi, ba, một, hai... CHẠY!\", \"rating\": 9.0},\n  {\"id\": 709786, \"suggestedTranslation\": \"Không không không! Mọi thứ đang sụp đổ hết rồi!\", \"rating\": 9.0},\n  {\"id\": 709787, \"suggestedTranslation\": \"Mọi chuyện vẫn ổn.\", \"rating\": 9.0},\n  {\"id\": 709788, \"suggestedTranslation\": \"only_used_by_wx78\", \"rating\": 9.0},\n  {\"id\": 709789, \"suggestedTranslation\": \"Họ tìm thấy tôi rồi... K-không! Tránh ra!\", \"rating\": 9.0},\n  {\"id\": 709790, \"suggestedTranslation\": \"only_used_by_winona\", \"rating\": 9.0},\n  {\"id\": 709791, \"suggestedTranslation\": \"Để tôi yên!\", \"rating\": 9.0},\n  {\"id\": 709792, \"suggestedTranslation\": \"only_used_by_winona\", \"rating\": 9.0},\n  {\"id\": 709793, \"suggestedTranslation\": \"only_used_by_wolfgang\", \"rating\": 9.0},\n  {\"id\": 709794, \"suggestedTranslation\": \"only_used_by_wolfgang\", \"rating\": 9.0},\n  {\"id\": 709795, \"suggestedTranslation\": \"only_used_by_wolfgang\", \"rating\": 9.0},\n  {\"id\": 709796, \"suggestedTranslation\": \"only_used_by_wolfgang\", \"rating\": 9.0},\n  {\"id\": 709797, \"suggestedTranslation\": \"only_used_by_wolfgang\", \"rating\": 9.0},\n  {\"id\": 709798, \"suggestedTranslation\": \"only_used_by_wolfgang\", \"rating\": 9.0},\n  {\"id\": 709799, \"suggestedTranslation\": \"only_used_by_wolfgang\", \"rating\": 9.0},\n  {\"id\": 709800, \"suggestedTranslation\": \"only_used_by_wolfgang\", \"rating\": 9.0},\n  {\"id\": 709801, \"suggestedTranslation\": \"only_used_by_wolfgang\", \"rating\": 9.0},\n  {\"id\": 709802, \"suggestedTranslation\": \"Brrr... t-từ bao giờ mà trời lạnh thế này?\", \"rating\": 9.0},\n  {\"id\": 709803, \"suggestedTranslation\": \"Tôi không biết cơ chế đơn giản này làm sao mà hỏng được, nhưng mà...\", \"rating\": 9.0},\n  {\"id\": 709804, \"suggestedTranslation\": \"À, tôi cảm thấy khỏe mạnh như vần thơ vậy!\", \"rating\": 9.0},\n  {\"id\": 709805, \"suggestedTranslation\": \"Ôi phiền phức thật. Tôi lại quên mất gì rồi phải không nhỉ?\", \"rating\": 9.0},\n  {\"id\": 709806, \"suggestedTranslation\": \"Một chút nước thì chắc chẳng có gì phải lo đâu.\", \"rating\": 9.0},\n  {\"id\": 709807, \"suggestedTranslation\": \"Ôi phiền phức thật, lại đến thời điểm này trong năm rồi sao?\", \"rating\": 9.0},\n  {\"id\": 709808, \"suggestedTranslation\": \"Đợi đã, dừng lại! Tôi cần thêm thời gian--!\", \"rating\": 9.0},\n  {\"id\": 709809, \"suggestedTranslation\": \"Phù, không biết chuyện gì vừa nhập vào tôi nữa...\", \"rating\": 9.0},\n  {\"id\": 709810, \"suggestedTranslation\": \"Tôi sẽ nhớ cảm giác có điện trên đầu ngón tay lắm đây.\", \"rating\": 9.0},\n  {\"id\": 709811, \"suggestedTranslation\": \"Ôi phiền phức thật, tôi đang quen dần với việc chống nước rồi cơ mà.\", \"rating\": 9.0},\n  {\"id\": 709812, \"suggestedTranslation\": \"Bỗng nhiên tôi lại thấy hơi kém an toàn...\", \"rating\": 9.0},\n  {\"id\": 709813, \"suggestedTranslation\": \"Chắc tôi không thể tránh việc đi ngủ mãi được.\", \"rating\": 9.0},\n  {\"id\": 709814, \"suggestedTranslation\": \"Không! Bây giờ tôi không thể chậm lại được đâu!\", \"rating\": 9.0},\n  {\"id\": 709815, \"suggestedTranslation\": \"Trông nó đã khá hơn rồi đấy.\", \"rating\": 9.0},\n  {\"id\": 709816, \"suggestedTranslation\": \"only_used_by_wx78\", \"rating\": 9.0},\n  {\"id\": 709817, \"suggestedTranslation\": \"Tôi phải nhanh lên thôi, sắp hết ban ngày rồi.\", \"rating\": 9.0},\n  {\"id\": 709818, \"suggestedTranslation\": \"only_used_by_warly\", \"rating\": 9.0},\n  {\"id\": 709819, \"suggestedTranslation\": \"only_used_by_warly\", \"rating\": 9.0},\n  {\"id\": 709820, \"suggestedTranslation\": \"Mmm!\", \"rating\": 9.0},\n  {\"id\": 709821, \"suggestedTranslation\": \"Tôi không ăn cái đó đâu!\", \"rating\": 9.0},\n  {\"id\": 709822, \"suggestedTranslation\": \"Úi... Tôi thấy không khỏe chút nào...\", \"rating\": 9.0},\n  {\"id\": 709823, \"suggestedTranslation\": \"only_used_by_warly\", \"rating\": 9.0},\n  {\"id\": 709824, \"suggestedTranslation\": \"only_used_by_warly\", \"rating\": 9.0},\n  {\"id\": 709825, \"suggestedTranslation\": \"only_used_by_warly\", \"rating\": 9.0},\n  {\"id\": 709826, \"suggestedTranslation\": \"only_used_by_warly\", \"rating\": 9.0},\n  {\"id\": 709827, \"suggestedTranslation\": \"only_used_by_warly\", \"rating\": 9.0},\n  {\"id\": 709828, \"suggestedTranslation\": \"only_used_by_warly\", \"rating\": 9.0},\n  {\"id\": 709829, \"suggestedTranslation\": \"only_used_by_warly\", \"rating\": 9.0},\n  {\"id\": 709830, \"suggestedTranslation\": \"Tôi có thể quay lại thời điểm trước khi ăn món đó không?\", \"rating\": 9.0},\n  {\"id\": 709831, \"suggestedTranslation\": \"Tôi nghĩ món đó hơi cũ rồi.\", \"rating\": 9.0},\n  {\"id\": 709832, \"suggestedTranslation\": \"only_used_by_warly\", \"rating\": 9.0},\n  {\"id\": 709833, \"suggestedTranslation\": \"Đây có thể là vấn đề sinh tồn, nhưng tôi VẪN CÒN chút tiêu chuẩn đấy.\", \"rating\": 9.0},\n  {\"id\": 709834, \"suggestedTranslation\": \"Có lẽ tôi nên chia sẻ một ít cho những người khác...\", \"rating\": 9.0},\n  {\"id\": 709835, \"suggestedTranslation\": \"Giống như một tách trà ngon vậy.\", \"rating\": 9.0},\n  {\"id\": 709836, \"suggestedTranslation\": \"Bắt tay vào việc thôi nào.\", \"rating\": 9.0},\n  {\"id\": 709837, \"suggestedTranslation\": \"Sức mạnh chính là hiệu suất!\", \"rating\": 9.0},\n  {\"id\": 709838, \"suggestedTranslation\": \"Hộc. Món đó quá mạnh rồi.\", \"rating\": 9.0},\n  {\"id\": 709839, \"suggestedTranslation\": \"Oof...\", \"rating\": 9.0},\n  {\"id\": 709840, \"suggestedTranslation\": \"Tôi đang... quá già cho việc này rồi...\", \"rating\": 9.0},\n  {\"id\": 709841, \"suggestedTranslation\": \"Hộc... hừ...\", \"rating\": 9.0},\n  {\"id\": 709842, \"suggestedTranslation\": \"Tôi thường... làm việc với... những thứ nhỏ hơn...\", \"rating\": 9.0},\n  {\"id\": 709843, \"suggestedTranslation\": \"Hrrrrgh!\", \"rating\": 9.0},\n  {\"id\": 709844, \"suggestedTranslation\": \"Nào... cố lên...! Tôi còn... nhiều việc phải làm...!\", \"rating\": 9.0},\n  {\"id\": 709845, \"suggestedTranslation\": \"Ồ phải rồi... cứ để thợ làm đồng hồ... gánh vác việc nặng nhọc...!\", \"rating\": 9.0},\n  {\"id\": 709846, \"suggestedTranslation\": \"Tốt nhất là tôi không nên... trật khớp gì cả...\", \"rating\": 9.0},\n  {\"id\": 709847, \"suggestedTranslation\": \"Nặng... hộc... quá...\", \"rating\": 9.0},\n  {\"id\": 709848, \"suggestedTranslation\": \"only_used_by_winona\", \"rating\": 9.0},\n  {\"id\": 709849, \"suggestedTranslation\": \"only_used_by_winona\", \"rating\": 9.0},\n  {\"id\": 709850, \"suggestedTranslation\": \"only_used_by_winona\", \"rating\": 9.0},\n  {\"id\": 709851, \"suggestedTranslation\": \"Không! Tôi sẽ không để bóng đêm nuốt chửng mình đâu!!\", \"rating\": 9.0},\n  {\"id\": 709852, \"suggestedTranslation\": \"Phù...\", \"rating\": 9.0},\n  {\"id\": 709853, \"suggestedTranslation\": \"Cảm giác dài như cả thế kỷ vậy!\", \"rating\": 9.0},\n  {\"id\": 709854, \"suggestedTranslation\": \"Tôi cảm thấy ớn lạnh, có ai để quên cửa liên không gian mở à?\", \"rating\": 9.0},\n  {\"id\": 709855, \"suggestedTranslation\": \"Chắc chúng ta phải đợi đến hoàng hôn để kết thúc cuộc cãi vã này thôi.\", \"rating\": 9.0},\n  {\"id\": 709856, \"suggestedTranslation\": \"Chà, cuối cùng thì cũng chịu tới!\", \"rating\": 9.0},\n  {\"id\": 709857, \"suggestedTranslation\": \"Thời của cái quạt này đã hết rồi.\", \"rating\": 9.0},\n  {\"id\": 709858, \"suggestedTranslation\": \"Tôi nghĩ mình đã biết đủ về phân bón để dùng cho cả đời rồi đấy.\", \"rating\": 9.0},\n  {\"id\": 709859, \"suggestedTranslation\": \"Úi chà, tôi thấy không khỏe chút nào...\", \"rating\": 9.0},\n  {\"id\": 709860, \"suggestedTranslation\": \"Cứu với! Tôi bị trúng độc rồi!\", \"rating\": 9.0},\n  {\"id\": 709861, \"suggestedTranslation\": \"Phù... may là tác dụng không kéo dài vĩnh viễn.\", \"rating\": 9.0},\n  {\"id\": 709862, \"suggestedTranslation\": \"Đó là pháo sáng à? Tôi phải mau đi xem có chuyện gì mới được!\", \"rating\": 9.0},\n  {\"id\": 709863, \"suggestedTranslation\": \"Tôi thấy cuộc đời mình xẹt qua trước mắt... mà chẳng theo thứ tự nào cả.\", \"rating\": 9.0},\n  {\"id\": 709864, \"suggestedTranslation\": \"Tôi ghét phần này nhất!\", \"rating\": 9.0},\n  {\"id\": 709865, \"suggestedTranslation\": \"Tôi cần nghỉ ngơi.\", \"rating\": 9.0},\n  {\"id\": 709866, \"suggestedTranslation\": \"only_used_by_warly\", \"rating\": 9.0},\n  {\"id\": 709867, \"suggestedTranslation\": \"T-tôi được tự do rồi... tôi còn sống... h-ha! Ha h-haha! Hahahaha!!\", \"rating\": 9.0},\n  {\"id\": 709868, \"suggestedTranslation\": \"only_used_by_wurt\", \"rating\": 9.0},\n  {\"id\": 709869, \"suggestedTranslation\": \"Dừng lại đi, tôi từ chối chấp nhận cái chết!\", \"rating\": 9.0},\n  {\"id\": 709870, \"suggestedTranslation\": \"Nó xua đuổi những bóng tối. Tốt.\", \"rating\": 9.0},\n  {\"id\": 709871, \"suggestedTranslation\": \"Thật đáng tiếc, khoảng thời gian không bị mưa axit làm phiền của tôi đã hết rồi.\", \"rating\": 9.0},\n  {\"id\": 709872, \"suggestedTranslation\": \"Lớp bảo vệ chống cháy của tôi đã hết hạn rồi.\", \"rating\": 9.0},\n  {\"id\": 709873, \"suggestedTranslation\": \"Thật hiệu quả làm sao.\", \"rating\": 9.0},\n  {\"id\": 709874, \"suggestedTranslation\": \"Đúng là phí phạm thời gian.\", \"rating\": 9.0},\n  {\"id\": 709875, \"suggestedTranslation\": \"Điều đó thực sự làm những bánh răng trong đầu tôi quay đấy!\", \"rating\": 9.0},\n  {\"id\": 709876, \"suggestedTranslation\": \"Tôi phải thoát khỏi cái nóng này ngay...\", \"rating\": 9.0},\n  {\"id\": 709877, \"suggestedTranslation\": \"Đợi chút... bạn có nghe thấy tiếng gì không?\", \"rating\": 9.0},\n  {\"id\": 709878, \"suggestedTranslation\": \"Đã bao lâu rồi từ lần ăn cuối nhỉ?\", \"rating\": 9.0},\n  {\"id\": 709879, \"suggestedTranslation\": \"Lối mòn này có vẻ ít rủi ro hơn.\", \"rating\": 9.0},\n  {\"id\": 709880, \"suggestedTranslation\": \"Chắc chắn có con thú vừa đi qua đây cách đây vài phút.\", \"rating\": 9.0},\n  {\"id\": 709881, \"suggestedTranslation\": \"Mất dấu rồi. Chắc tôi phải quay lại tìm theo dấu vết cũ quá.\", \"rating\": 9.0},\n  {\"id\": 709882, \"suggestedTranslation\": \"Mọi thứ ẩm ướt quá, tôi không phí thời gian với cái này đâu.\", \"rating\": 9.0},\n  {\"id\": 709883, \"suggestedTranslation\": \"Tôi không nghĩ mình sẽ thích thứ tìm thấy ở cuối con đường này đâu...\", \"rating\": 9.0},\n  {\"id\": 709884, \"suggestedTranslation\": \"Nó không trốn thoát khỏi tôi lần này đâu!\", \"rating\": 9.0},\n  {\"id\": 709885, \"suggestedTranslation\": \"Ai ở ngoài đó thế?! Có cái gì đang the