            "text": "[\n  {\"id\":713938,\"suggestedTranslation\":\"Những viên ngọc có vẻ rất quan trọng.\",\"rating\":9.0},\n  {\"id\":713939,\"suggestedTranslation\":\"Nặng và nóng.\",\"rating\":9.0},\n  {\"id\":713940,\"suggestedTranslation\":\"Một bộ giáp tuyệt hảo.\",\"rating\":9.0},\n  {\"id\":713941,\"suggestedTranslation\":\"Cỏ thì bảo vệ được mấy chứ?\",\"rating\":9.0},\n  {\"id\":713942,\"suggestedTranslation\":\"Nặng cả tấn.\",\"rating\":9.0},\n  {\"id\":713943,\"suggestedTranslation\":\"Giáp cổ đại.\",\"rating\":9.0},\n  {\"id\":713944,\"suggestedTranslation\":\"Tôi phải mặc cái đó á?\",\"rating\":9.0},\n  {\"id\":713945,\"suggestedTranslation\":\"À. Cảm giác thèm ăn của tôi giảm hẳn dưới sự bảo vệ của nó.\",\"rating\":9.0},\n  {\"id\":713946,\"suggestedTranslation\":\"Nó cho phép tôi rúc đầu vào mai như rùa.\",\"rating\":9.0},\n  {\"id\":713947,\"suggestedTranslation\":\"Một lớp vỏ cứng để bảo vệ phần nội tạng mềm mại, ngon lành của tôi.\",\"rating\":9.0},\n  {\"id\":713948,\"suggestedTranslation\":\"Chắc chắn, nhưng cực kỳ dễ bắt lửa.\",\"rating\":9.0},\n  {\"id\":713949,\"suggestedTranslation\":\"Tôi sẽ phải thật cẩn thận khi mặc nó lên người.\",\"rating\":9.0},\n  {\"id\":713950,\"suggestedTranslation\":\"Phong cách mới đấy nhỉ?\",\"rating\":9.0},\n  {\"id\":713951,\"suggestedTranslation\":\"Một lớp vỏ cứng bên ngoài.\",\"rating\":9.0},\n  {\"id\":713952,\"suggestedTranslation\":\"Pha chế đặc trưng của mấy củ rau nhỏ.\",\"rating\":9.0},\n  {\"id\":713953,\"suggestedTranslation\":\"Tôi có bị điên không khi mặc thứ này?\",\"rating\":9.0},\n  {\"id\":713954,\"suggestedTranslation\":\"Nó có thực sự giữ tôi an toàn không?\",\"rating\":9.0},\n  {\"id\":713955,\"suggestedTranslation\":\"Đó là bộ giáp sáng lấp lánh của một hiệp sĩ!\",\"rating\":9.0},\n  {\"id\":713956,\"suggestedTranslation\":\"Giòn rụm nhỉ?\",\"rating\":9.0},\n  {\"id\":713957,\"suggestedTranslation\":\"Đây chắc hẳn là một bảng hiệu.\",\"rating\":9.0},\n  {\"id\":713958,\"suggestedTranslation\":\"Tôi sẽ viết một lời nhắn dễ thương cho người tiếp theo.\",\"rating\":9.0},\n  {\"id\":713959,\"suggestedTranslation\":\"Chín quá lửa rồi.\",\"rating\":9.0},\n  {\"id\":713960,\"suggestedTranslation\":\"Đây chắc hẳn là một bảng hiệu.\",\"rating\":9.0},\n  {\"id\":713961,\"suggestedTranslation\":\"Tôi sẽ viết một lời nhắn dễ thương cho người tiếp theo.\",\"rating\":9.0},\n  {\"id\":713962,\"suggestedTranslation\":\"Tôi nhớ phô mai phủ tro. Tôi nhớ phô mai lắm rồi, chấm hết.\",\"rating\":9.0},\n  {\"id\":713963,\"suggestedTranslation\":\"Xương mắt đã phải hy sinh trong những chuyến phiêu lưu của tôi.\",\"rating\":9.0},\n  {\"id\":713964,\"suggestedTranslation\":\"Bông hoa bất thường giờ chỉ còn là tro tàn.\",\"rating\":9.0},\n  {\"id\":713965,\"suggestedTranslation\":\"Nó không còn nữa rồi.\",\"rating\":9.0},\n  {\"id\":713966,\"suggestedTranslation\":\"Cỏ sẻ!\",\"rating\":9.0},\n  {\"id\":713967,\"suggestedTranslation\":\"À, một món ăn đặc biệt.\",\"rating\":9.0},\n  {\"id\":713968,\"suggestedTranslation\":\"Măng tây nướng. Thật là tuyệt!\",\"rating\":9.0},\n  {\"id\":713969,\"suggestedTranslation\":\"Tuyệt cú mèo! Bạn sẽ làm nên một món ăn tuyệt vời đấy!\",\"rating\":9.0},\n  {\"id\":713970,\"suggestedTranslation\":\"Chúng sẽ lớn lên thành mấy loại rau củ tươi ngon.\",\"rating\":9.0},\n  {\"id\":713971,\"suggestedTranslation\":\"Tôi nghĩ nó đang nạp năng lượng.\",\"rating\":9.0},\n  {\"id\":713972,\"suggestedTranslation\":\"Nó đang trong giai đoạn hồi phục.\",\"rating\":9.0},\n  {\"id\":713973,\"suggestedTranslation\":\"Có điều gì đó không an toàn đang xảy ra.\",\"rating\":9.0},\n  {\"id\":713974,\"suggestedTranslation\":\"Tất cả các mảnh ghép đã trở lại vị trí cũ.\",\"rating\":9.0},\n  {\"id\":713975,\"suggestedTranslation\":\"Nó đã sẵn sàng.\",\"rating\":9.0},\n  {\"id\":713976,\"suggestedTranslation\":\"Cái này có vẻ rất quý giá.\",\"rating\":9.0},\n  {\"id\":713977,\"suggestedTranslation\":\"Tắt rồi, tạm thời là thế.\",\"rating\":9.0},\n  {\"id\":713978,\"suggestedTranslation\":\"Có một thế lực kỳ lạ đằng sau thứ này.\",\"rating\":9.0},\n  {\"id\":713979,\"suggestedTranslation\":\"Đây có phải là một dạng ngôn ngữ nào đó không nhỉ?\",\"rating\":9.0},\n  {\"id\":713980,\"suggestedTranslation\":\"Hình vẽ rất nhiều hải sản chưa được sơ chế. Tôi đói quá.\",\"rating\":9.0},\n  {\"id\":713981,\"suggestedTranslation\":\"Cái phiến đá này mòn hết cả rồi.\",\"rating\":9.0},\n  {\"id\":713982,\"suggestedTranslation\":\"Thế giới ngập tràn trong nước sốt đậu đen lên men hảo hạng.\",\"rating\":9.0},\n  {\"id\":713983,\"suggestedTranslation\":\"Những con tôm đang được bóc vỏ.\",\"rating\":9.0},\n  {\"id\":713984,\"suggestedTranslation\":\"Lũ tôm đã thăng hoa thành sự ngon miệng tuyệt đỉnh.\",\"rating\":9.0},\n  {\"id\":713985,\"suggestedTranslation\":\"Khi tôi quay lưng đi, cứ như thể tôi nghe thấy tiếng nó thở.\",\"rating\":9.0},\n  {\"id\":713986,\"suggestedTranslation\":\"Một người bạn đồng hành đáng tin cậy ở chốn này.\",\"rating\":9.0},\n  {\"id\":713987,\"suggestedTranslation\":\"Tôi có cảm xúc lẫn lộn về thịt bê.\",\"rating\":9.0},\n  {\"id\":713988,\"suggestedTranslation\":\"Chúc ngủ ngon, miếng bít tết nhỏ.\",\"rating\":9.0},\n  {\"id\":713989,\"suggestedTranslation\":\"Nó luôn yểm trợ cho tôi.\",\"rating\":9.0},\n  {\"id\":713990,\"suggestedTranslation\":\"Trứng ốp la lòng đào... thịt xông khói giòn rụm... Tôi chết cũng mãn nguyện...\",\"rating\":9.0},\n  {\"id\":713991,\"suggestedTranslation\":\"Tôi còn gì để mất nữa đâu?\",\"rating\":9.0},\n  {\"id\":713992,\"suggestedTranslation\":\"Sặc sỡ làm sao!\",\"rating\":9.0},\n  {\"id\":713993,\"suggestedTranslation\":\"Nó... không hẳn là phong cách của tôi cho lắm.\",\"rating\":9.0},\n  {\"id\":713994,\"suggestedTranslation\":\"À! Một buổi tiệc mừng!\",\"rating\":9.0},\n  {\"id\":713995,\"suggestedTranslation\":\"Một thiết kế khá kỳ lạ. Mà nghĩ lại thì, nó được làm bởi một kẻ kỳ cục mà.\",\"rating\":9.0},\n  {\"id\":713996,\"suggestedTranslation\":\"Thật là một gói quà tử tế!\",\"rating\":9.0},\n  {\"id\":713997,\"suggestedTranslation\":\"Nó đã bị vắt kiệt hơi sức rồi.\",\"rating\":9.0},\n  {\"id\":713998,\"suggestedTranslation\":\"Tôi không chắc thứ đó an toàn cỡ nào nữa.\",\"rating\":9.0},\n  {\"id\":713999,\"suggestedTranslation\":\"À, tôi vừa tình cờ vớ được mấy quả chuối tươi!\",\"rating\":9.0},\n  {\"id\":714000,\"suggestedTranslation\":\"Lẽ ra tôi nên cho thêm một nhúm quế vào.\",\"rating\":9.0},\n  {\"id\":714001,\"suggestedTranslation\":\"Có lẽ không phải món phức tạp nhất của tôi, nhưng ngon không kém đâu.\",\"rating\":9.0},\n  {\"id\":714002,\"suggestedTranslation\":\"Sơ cứu cơ bản.\",\"rating\":9.0},\n  {\"id\":714003,\"suggestedTranslation\":\"Mong là tôi không làm rơi nó vào súp.\",\"rating\":9.0},\n  {\"id\":714004,\"suggestedTranslation\":\"À, tôi hiếm khi có cơ hội nấu ăn với mấy thứ này lắm!\",\"rating\":9.0},\n  {\"id\":714005,\"suggestedTranslation\":\"Một sự kết hợp nguyên liệu không giống ai, nhưng bù lại rất ngon!\",\"rating\":9.0},\n  {\"id\":714006,\"suggestedTranslation\":\"Có những thí nghiệm ẩm thực thành công hơn những cái khác.\",\"rating\":9.0},\n  {\"id\":714007,\"suggestedTranslation\":\"À, ngon tuyệt! Món này thành phẩm khá là ổn đấy!\",\"rating\":9.0},\n  {\"id\":714008,\"suggestedTranslation\":\"Tôi nghĩ chúng ta có thể làm tốt hơn thế một chút!\",\"rating\":9.0},\n  {\"id\":714009,\"suggestedTranslation\":\"Ngon khó cưỡng!\",\"rating\":9.0},\n  {\"id\":714010,\"suggestedTranslation\":\"Được làm từ chất liệu cứng cáp!\",\"rating\":9.0},\n  {\"id\":714011,\"suggestedTranslation\":\"Ước gì tôi có một cây gậy...\",\"rating\":9.0},\n  {\"id\":714012,\"suggestedTranslation\":\"Một dụng cụ gớm ghiếc.\",\"rating\":9.0},\n  {\"id\":714013,\"suggestedTranslation\":\"Tôi không muốn làm phiền giấc ngủ yên bình của chúng đâu.\",\"rating\":9.0},\n  {\"id\":714014,\"suggestedTranslation\":\"Được ngâm bồn thì thích phải biết.\",\"rating\":9.0},\n  {\"id\":714015,\"suggestedTranslation\":\"Đây sẽ là một nguyên liệu đầy thử thách đây.\",\"rating\":9.0},\n  {\"id\":714016,\"suggestedTranslation\":\"Thật là kinh hoàng! Lãng phí đồ ăn ngon quá đi mất!\",\"rating\":9.0},\n  {\"id\":714017,\"suggestedTranslation\":\"Có lẽ cho thêm chút nước ướp thì tốt hơn.\",\"rating\":9.0},\n  {\"id\":714018,\"suggestedTranslation\":\"Khi không dùng để chứa bài ca, có lẽ nó dùng để đựng súp được không nhỉ?\",\"rating\":9.0},\n  {\"id\":714019,\"suggestedTranslation\":\"Tôi không biết cô ấy lại là một ca sĩ cừ khôi đến vậy đấy!\",\"rating\":9.0},\n  {\"id\":714020,\"suggestedTranslation\":\"Tôi không biết cô ấy lại là một ca sĩ cừ khôi đến vậy đấy!\",\"rating\":9.0},\n  {\"id\":714021,\"suggestedTranslation\":\"Tôi không biết cô ấy lại là một ca sĩ cừ khôi đến vậy đấy!\",\"rating\":9.0},\n  {\"id\":714022,\"suggestedTranslation\":\"Shakespeare ư? Tự hỏi làm sao một người Viking lại có được thứ này...\",\"rating\":9.0},\n  {\"id\":714023,\"suggestedTranslation\":\"Tôi không biết cô ấy lại là một ca sĩ cừ khôi đến vậy đấy!\",\"rating\":9.0},\n  {\"id\":714024,\"suggestedTranslation\":\"Shakespeare ư? Tự hỏi làm sao một người Viking lại có được thứ này...\",\"rating\":9.0},\n  {\"id\":714025,\"suggestedTranslation\":\"Tôi không biết cô ấy lại là một ca sĩ cừ khôi đến vậy đấy!\",\"rating\":9.0},\n  {\"id\":714026,\"suggestedTranslation\":\"Tôi không biết cô ấy lại là một ca sĩ cừ khôi đến vậy đấy!\",\"rating\":9.0},\n  {\"id\":714027,\"suggestedTranslation\":\"Tôi không biết cô ấy lại là một ca sĩ cừ khôi đến vậy đấy!\",\"rating\":9.0},\n  {\"id\":714028,\"suggestedTranslation\":\"Tôi không biết cô ấy lại là một ca sĩ cừ khôi đến vậy đấy!\",\"rating\":9.0},\n  {\"id\":714029,\"suggestedTranslation\":\"Hmm, làm nước dùng từ cánh dơi thì sao nhỉ?\",\"rating\":9.0},\n  {\"id\":714030,\"suggestedTranslation\":\"Cần thêm tỏi...\",\"rating\":9.0},\n  {\"id\":714031,\"suggestedTranslation\":\"Ghê tởm.\",\"rating\":9.0},\n  {\"id\":714032,\"suggestedTranslation\":\"Ồ, tôi không ưa ngươi chút nào đâu!\",\"rating\":9.0},\n  {\"id\":714033,\"suggestedTranslation\":\"Gấu Lửng đút lò flambé.\",\"rating\":9.0},\n  {\"id\":714034,\"suggestedTranslation\":\"Mọi chuyện đã kết thúc.\",\"rating\":9.0},\n  {\"id\":714035,\"suggestedTranslation\":\"Ôi trời. Lại thêm một phần ăn nữa!\",\"rating\":9.0},\n  {\"id\":714036,\"suggestedTranslation\":\"Cái này sẽ giữ cho nguyên liệu của tôi luôn tươi ngon.\",\"rating\":9.0},\n  {\"id\":714037,\"suggestedTranslation\":\"Nơi trú ẩn lông lá tránh khỏi thời tiết khắc nghiệt.\",\"rating\":9.0},\n  {\"id\":714038,\"suggestedTranslation\":\"Cảm giác ấm áp.\",\"rating\":9.0},\n  {\"id\":714039,\"suggestedTranslation\":\"Chú bò lai nào mặc cái này chắc chắn sẽ rất may mắn!\",\"rating\":9.0},\n  {\"id\":714040,\"suggestedTranslation\":\"Ấm cúng.\",\"rating\":9.0},\n  {\"id\":714041,\"suggestedTranslation\":\"Khá hơn mặt đất trống một chút. Hơi ngứa ngáy.\",\"rating\":9.0},\n  {\"id\":714042,\"suggestedTranslation\":\"Nơi nào có ong, nơi đó có mật ong!\",\"rating\":9.0},\n  {\"id\":714043,\"suggestedTranslation\":\"Chào cục mật ong nhé.\",\"rating\":9.0},\n  {\"id\":714044,\"suggestedTranslation\":\"Bị caramel hóa một cách thảm hại.\",\"rating\":9.0},\n  {\"id\":714045,\"suggestedTranslation\":\"Trúng quả đậm mật ong rồi!\",\"rating\":9.0},\n  {\"id\":714046,\"suggestedTranslation\":\"Nhà của những chú ong thợ làm mật!\",\"rating\":9.0},\n  {\"id\":714047,\"suggestedTranslation\":\"Hết mật ong mất rồi...\",\"rating\":9.0},\n  {\"id\":714048,\"suggestedTranslation\":\"Trúng quả đậm mật ong rồi!\",\"rating\":9.0},\n  {\"id\":714049,\"suggestedTranslation\":\"Còn một chút mật ong nè.\",\"rating\":9.0},\n  {\"id\":714050,\"suggestedTranslation\":\"Bị caramel hóa một cách thảm hại.\",\"rating\":9.0},\n  {\"id\":714051,\"suggestedTranslation\":\"Thưa quý cô, tôi tin là mật ong của cô đã sẵn sàng rồi đấy!\",\"rating\":9.0},\n  {\"id\":714052,\"suggestedTranslation\":\"Đó là một tổ ong nhỏ của những chú thợ làm mật!\",\"rating\":9.0},\n  {\"id\":714053,\"suggestedTranslation\":\"Hết mật ong mất rồi...\",\"rating\":9.0},\n  {\"id\":714054,\"suggestedTranslation\":\"Thưa quý cô, tôi tin là mật ong của cô đã sẵn sàng rồi đấy!\",\"rating\":9.0},\n  {\"id\":714055,\"suggestedTranslation\":\"Còn một chút mật ong nè.\",\"rating\":9.0},\n  {\"id\":714056,\"suggestedTranslation\":\"Nó đúng là đồ thịt chết tiệt.\",\"rating\":9.0},\n  {\"id\":714057,\"suggestedTranslation\":\"Ái chà không! Ra đi khi tuổi đời còn trẻ - nhầm, khi đang ở đỉnh cao sự sống!\",\"rating\":9.0},\n  {\"id\":714058,\"suggestedTranslation\":\"Con này khá điềm tĩnh.\",\"rating\":9.0},\n  {\"id\":714059,\"suggestedTranslation\":\"Đúng rồi, bạn tôi ơi. Tôi dẫn đường, bạn theo sau.\",\"rating\":9.0},\n  {\"id\":714060,\"suggestedTranslation\":\"Thịt đây rồi.\",\"rating\":9.0},\n  {\"id\":714061,\"suggestedTranslation\":\"Chúng ta hợp nhau như bít tết với bơ tỏi thơm lừng vậy.\",\"rating\":9.0},\n  {\"id\":714062,\"suggestedTranslation\":\"Ngẩng cao đầu lên nào, nó sẽ mọc lại thôi.\",\"rating\":9.0},\n  {\"id\":714063,\"suggestedTranslation\":\"Nó đang sôi máu lên kìa!\",\"rating\":9.0},\n  {\"id\":714064,\"suggestedTranslation\":\"Ngươi thích ăn uống nhiều như ta vậy.\",\"rating\":9.0},\n  {\"id\":714065,\"suggestedTranslation\":\"Tôi nghĩ mình thực sự có thể thuần hóa con này đấy.\",\"rating\":9.0},\n  {\"id\":714066,\"suggestedTranslation\":\"Miếng thăn bò đang say giấc nồng...\",\"rating\":9.0},\n  {\"id\":714067,\"suggestedTranslation\":\"Con thú cưng của tôi cần thêm thịt da béo bở hơn chút nữa.\",\"rating\":9.0},\n  {\"id\":714068,\"suggestedTranslation\":\"Vừa khít luôn.\",\"rating\":9.0},\n  {\"id\":714069,\"suggestedTranslation\":\"Thú cưng của tôi xứng đáng được ăn một món thật ngon lành.\",\"rating\":9.0},\n  {\"id\":714070,\"suggestedTranslation\":\"Con thú mất lông là phần lời cho tôi.\",\"rating\":9.0},\n  {\"id\":714071,\"suggestedTranslation\":\"Đút lò flambé.\",\"rating\":9.0},\n  {\"id\":714072,\"suggestedTranslation\":\"Trình bày là rất quan trọng!\",\"rating\":9.0},\n  {\"id\":714073,\"suggestedTranslation\":\"Và giờ thì, trang trí cho miếng bít tết nào!\",\"rating\":9.0},\n  {\"id\":714074,\"suggestedTranslation\":\"Tôi nên tự tay làm nó nhỉ?\",\"rating\":9.0},\n  {\"id\":714075,\"suggestedTranslation\":\"Đây không phải là chuông gọi ăn tối sao?\",\"rating\":9.0},\n  {\"id\":714076,\"suggestedTranslation\":\"Ôi không không không, tôi ghét bị chích lắm!\",\"rating\":9.0},\n  {\"id\":714077,\"suggestedTranslation\":\"Trang phục thiết yếu để thu hoạch mật ong.\",\"rating\":9.0},\n  {\"id\":714078,\"suggestedTranslation\":\"Tôi có thể nghe thấy hoạt động bên trong đó.\",\"rating\":9.0},\n  {\"id\":714079,\"suggestedTranslation\":\"Ong được vũ khí hóa.\",\"rating\":9.0},\n  {\"id\":714080,\"suggestedTranslation\":\"Tôi thấy tội cho kẻ nào dẫm phải thứ này.\",\"rating\":9.0},\n  {\"id\":714081,\"suggestedTranslation\":\"Mật ong của ngươi quá ngon nên tôi mới phải trộm đấy!\",\"rating\":9.0},\n  {\"id\":714082,\"suggestedTranslation\":\"Tôi không nghĩ là mật ong đó sẽ ngon lành gì cho cam.\",\"rating\":9.0},\n  {\"id\":714083,\"suggestedTranslation\":\"Tôi không nhớ cái này ở đây trước đó đâu.\",\"rating\":9.0},\n  {\"id\":714084,\"suggestedTranslation\":\"Cái này chắc chắn to hơn trước rồi.\",\"rating\":9.0},\n  {\"id\":714085,\"suggestedTranslation\":\"Chất bảo quản hạng nhất.\",\"rating\":9.0},\n  {\"id\":714086,\"suggestedTranslation\":\"Nước hoa độc hại!\",\"rating\":9.0},\n  {\"id\":714087,\"suggestedTranslation\":\"Chúng ta đâu nhất thiết phải đánh nhau, đúng chứ?\",\"rating\":9.0},\n  {\"id\":714088,\"suggestedTranslation\":\"Tôi có nên rung nó lên không nhỉ?\",\"rating\":9.0},\n  {\"id\":714089,\"suggestedTranslation\":\"Đúng là một anh chàng ngốc nghếch.\",\"rating\":9.0},\n  {\"id\":714090,\"suggestedTranslation\":\"To kinh khủng!\",\"rating\":9.0},\n  {\"id\":714091,\"suggestedTranslation\":\"Tội nghiệp anh bạn nhỏ.\",\"rating\":9.0},\n  {\"id\":714092,\"suggestedTranslation\":\"Tôi được bảo rằng tên