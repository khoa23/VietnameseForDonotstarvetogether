            "text": "[\n  {\"id\":708238,\"suggestedTranslation\":\"Ham mê nướng thịt ghê.\",\"rating\":8.5},\n  {\"id\":708239,\"suggestedTranslation\":\"Dùng để nướng những miếng thịt nhỏ.\",\"rating\":8.5},\n  {\"id\":708240,\"suggestedTranslation\":\"Đó là một dụng cụ làm ruộng.\",\"rating\":8.5},\n  {\"id\":708241,\"suggestedTranslation\":\"Chắc chắn cái Két Sắt này sẽ có ích đấy.\",\"rating\":8.5},\n  {\"id\":708242,\"suggestedTranslation\":\"Cất nó vào túi cho đến khi tới công viên vậy.\",\"rating\":8.5},\n  {\"id\":708243,\"suggestedTranslation\":\"Hừm. Làm mình nhớ nhà quá.\",\"rating\":8.5},\n  {\"id\":708244,\"suggestedTranslation\":\"Khai sáng thật đấy.\",\"rating\":8.5},\n  {\"id\":708245,\"suggestedTranslation\":\"Công việc lặp đi lặp lại hàng ngày.\",\"rating\":8.5},\n  {\"id\":708246,\"suggestedTranslation\":\"Cái nhà nhỏ gì mà xấu xí thế.\",\"rating\":8.5},\n  {\"id\":708247,\"suggestedTranslation\":\"Có khoa học nào trong đó không?\",\"rating\":8.5},\n  {\"id\":708248,\"suggestedTranslation\":\"Mình có thể dùng vài thứ đồ ở đây.\",\"rating\":8.5},\n  {\"id\":708249,\"suggestedTranslation\":\"Đây là những cây nấm ăn được.\",\"rating\":8.5},\n  {\"id\":708250,\"suggestedTranslation\":\"Đấy là nấm á? Bí mất rồi đây.\",\"rating\":8.5},\n  {\"id\":708251,\"suggestedTranslation\":\"Mình không nghĩ nó sẽ mọc lại đâu.\",\"rating\":8.5},\n  {\"id\":708252,\"suggestedTranslation\":\"Trông giòn ghê.\",\"rating\":8.5},\n  {\"id\":708253,\"suggestedTranslation\":\"Một phản ứng hóa học thành công.\",\"rating\":8.5},\n  {\"id\":708254,\"suggestedTranslation\":\"Một nắm hạt kỳ lạ.\",\"rating\":8.5},\n  {\"id\":708255,\"suggestedTranslation\":\"Nó cần nguyên liệu để vận hành khoa học.\",\"rating\":8.5},\n  {\"id\":708256,\"suggestedTranslation\":\"Dùng để thiêu đốt mọi thứ một cách khoa học.\",\"rating\":8.5},\n  {\"id\":708257,\"suggestedTranslation\":\"Thuật ngữ khoa học là: \\\"Vật sắc nhọn\\\".\",\"rating\":8.5},\n  {\"id\":708258,\"suggestedTranslation\":\"Nhận lấy này, sinh vật kia!\",\"rating\":8.5},\n  {\"id\":708259,\"suggestedTranslation\":\"Trông như thật vậy.\",\"rating\":8.5},\n  {\"id\":708260,\"suggestedTranslation\":\"Đã lâu lắm rồi nó không còn được nối với nguồn nước nữa.\",\"rating\":8.5},\n  {\"id\":708261,\"suggestedTranslation\":\"Hóa ra chìa khóa chính là chìa khóa để vào trong.\",\"rating\":8.5},\n  {\"id\":708262,\"suggestedTranslation\":\"Khóa chặt lắm.\",\"rating\":8.5},\n  {\"id\":708263,\"suggestedTranslation\":\"Một tượng đài mang tính tượng đài.\",\"rating\":8.5},\n  {\"id\":708264,\"suggestedTranslation\":\"Tro lại với tro.\",\"rating\":8.5},\n  {\"id\":708265,\"suggestedTranslation\":\"Cục đá tảng đó đang sống kìa!\",\"rating\":8.5},\n  {\"id\":708266,\"suggestedTranslation\":\"Chúng chết rồi.\",\"rating\":8.5},\n  {\"id\":708267,\"suggestedTranslation\":\"Nó chỉ đang tùy cơ ứng biến thôi.\",\"rating\":8.5},\n  {\"id\":708268,\"suggestedTranslation\":\"Nó đang ngủ, tạm thời là vậy.\",\"rating\":8.5},\n  {\"id\":708269,\"suggestedTranslation\":\"Một cái đĩa được mạ bạc.\",\"rating\":8.5},\n  {\"id\":708270,\"suggestedTranslation\":\"Một mạch nước mặn nhỏ.\",\"rating\":8.5},\n  {\"id\":708271,\"suggestedTranslation\":\"Lại một ngõ cụt nữa.\",\"rating\":8.5},\n  {\"id\":708272,\"suggestedTranslation\":\"Trông có vẻ mang tính khoa học đấy.\",\"rating\":8.5},\n  {\"id\":708273,\"suggestedTranslation\":\"Chiếc nồi này chứa được nhiều nguyên liệu hơn.\",\"rating\":8.5},\n  {\"id\":708274,\"suggestedTranslation\":\"Những quả táo của mặt đất.\",\"rating\":8.5},\n  {\"id\":708275,\"suggestedTranslation\":\"Một thí nghiệm nhiệt độ thành công.\",\"rating\":8.5},\n  {\"id\":708276,\"suggestedTranslation\":\"Một nắm hạt kỳ lạ.\",\"rating\":8.5},\n  {\"id\":708277,\"suggestedTranslation\":\"Nó có vài nỗi niềm vướng bận.\",\"rating\":8.5},\n  {\"id\":708278,\"suggestedTranslation\":\"Dành cho nghệ thuật nấu ăn dựa trên sự treo lơ lửng.\",\"rating\":8.5},\n  {\"id\":708279,\"suggestedTranslation\":\"Bắt đầu nấu nướng thôi!\",\"rating\":8.5},\n  {\"id\":708280,\"suggestedTranslation\":\"Mình cần làm ngọt cái nồi này lên.\",\"rating\":8.5},\n  {\"id\":708281,\"suggestedTranslation\":\"Mình không nghĩ bệ tế sẽ muốn thứ đó đâu.\",\"rating\":8.5},\n  {\"id\":708282,\"suggestedTranslation\":\"Chắc là mình nói nhầm rồi.\",\"rating\":8.5},\n  {\"id\":708283,\"suggestedTranslation\":\"Trên con đường đến chốn hư vô.\",\"rating\":8.5},\n  {\"id\":708284,\"suggestedTranslation\":\"Bị làm mồi cho kẻ khác.\",\"rating\":8.5},\n  {\"id\":708285,\"suggestedTranslation\":\"Có gì đó đã làmụt tắt chiếc ống khói đó.\",\"rating\":8.5},\n  {\"id\":708286,\"suggestedTranslation\":\"Có gì đó đã làmụt tắt chiếc ống khói đó.\",\"rating\":8.5},\n  {\"id\":708287,\"suggestedTranslation\":\"Ai đó đã đánh bại thời gian. Theo đúng nghĩa đen.\",\"rating\":8.5},\n  {\"id\":708288,\"suggestedTranslation\":\"Cái đồng hồ đó vừa bị đấm một cú.\",\"rating\":8.5},\n  {\"id\":708289,\"suggestedTranslation\":\"Không có ai ở đây cả.\",\"rating\":8.5},\n  {\"id\":708290,\"suggestedTranslation\":\"Thứ gì đó đã phá hủy thị trấn này.\",\"rating\":8.5},\n  {\"id\":708291,\"suggestedTranslation\":\"Tự hỏi bọn họ đã chọc giận ai cơ chứ.\",\"rating\":8.5},\n  {\"id\":708292,\"suggestedTranslation\":\"Không còn đáng yêu... à nhầm, đáng làm cửa nữa.\",\"rating\":8.5},\n  {\"id\":708293,\"suggestedTranslation\":\"Ai đó đã đánh lên tận mái nhà.\",\"rating\":8.5},\n  {\"id\":708294,\"suggestedTranslation\":\"Đó là một cái két sắt. Để cất giữ mọi thứ an toàn.\",\"rating\":8.5},\n  {\"id\":708295,\"suggestedTranslation\":\"Nó sẽ không mở ra nếu không có chìa khóa.\",\"rating\":8.5},\n  {\"id\":708296,\"suggestedTranslation\":\"Mm, cá tươi kìa.\",\"rating\":8.5},\n  {\"id\":708297,\"suggestedTranslation\":\"Đã sẵn sàng lên bàn ăn rồi.\",\"rating\":8.5},\n  {\"id\":708298,\"suggestedTranslation\":\"Toàn là muối không đấy.\",\"rating\":8.5},\n  {\"id\":708299,\"suggestedTranslation\":\"Muối. Khoáng chất ngon nhất.\",\"rating\":8.5},\n  {\"id\":708300,\"suggestedTranslation\":\"Khoa học cần phải có thời gian.\",\"rating\":8.5},\n  {\"id\":708301,\"suggestedTranslation\":\"Muối đã bám đầy trên dây thừng rồi.\",\"rating\":8.5},\n  {\"id\":708302,\"suggestedTranslation\":\"Dùng để thu hoạch muối từ cái ao.\",\"rating\":8.5},\n  {\"id\":708303,\"suggestedTranslation\":\"Nó có vị ngọt.\",\"rating\":8.5},\n  {\"id\":708304,\"suggestedTranslation\":\"Chúng ta có thể dùng nó để lấy nhựa cây từ các thân cây.\",\"rating\":8.5},\n  {\"id\":708305,\"suggestedTranslation\":\"Mình không thể lấy thêm gì từ cái đó nữa rồi.\",\"rating\":8.5},\n  {\"id\":708306,\"suggestedTranslation\":\"Thôi cứ némừm lửa cho rồi.\",\"rating\":8.5},\n  {\"id\":708307,\"suggestedTranslation\":\"Gieo cái gì cơ?\",\"rating\":8.5},\n  {\"id\":708308,\"suggestedTranslation\":\"Dụng cụ phòng thí nghiệm dùng để mổ xẻ phẫu thuật.\",\"rating\":8.5},\n  {\"id\":708309,\"suggestedTranslation\":\"Đậm đà hương vị đấy.\",\"rating\":8.5},\n  {\"id\":708310,\"suggestedTranslation\":\"Nó làm mình nhớ đến lũ quái vật xúc tu đó.\",\"rating\":8.5},\n  {\"id\":708311,\"suggestedTranslation\":\"Mình không thể lấy thêm gì từ bụi cây này nữa rồi.\",\"rating\":8.5},\n  {\"id\":708312,\"suggestedTranslation\":\"Mình có thể nghiền nó ra để làm gia vị.\",\"rating\":8.5},\n  {\"id\":708313,\"suggestedTranslation\":\"Nó tràn ngập nhựa cây ngon tuyệt hảo.\",\"rating\":8.5},\n  {\"id\":708314,\"suggestedTranslation\":\"Cái cây đi đâu mất tiêu rồi nhỉ? Bí mất rồi đây.\",\"rating\":8.5},\n  {\"id\":708315,\"suggestedTranslation\":\"Đó là cách cậu thu hút kiến đấy.\",\"rating\":8.5},\n  {\"id\":708316,\"suggestedTranslation\":\"Ra đây nào, nhựa cây ơi.\",\"rating\":8.5},\n  {\"id\":708317,\"suggestedTranslation\":\"Nhựa cây vàng óng ngọt ngào.\",\"rating\":8.5},\n  {\"id\":708318,\"suggestedTranslation\":\"Trông nó có vẻ ốm yếu.\",\"rating\":8.5},\n  {\"id\":708319,\"suggestedTranslation\":\"Đó là một con lợn siêu nhiều lông.\",\"rating\":8.5},\n  {\"id\":708320,\"suggestedTranslation\":\"Chắc ngài là người nắm quyền ở quanh đây à?\",\"rating\":8.5},\n  {\"id\":708321,\"suggestedTranslation\":\"Nó đang ngủ, tạm thời là vậy.\",\"rating\":8.5},\n  {\"id\":708322,\"suggestedTranslation\":\"Nó đã qua thời hoàng kim rồi.\",\"rating\":8.5},\n  {\"id\":708323,\"suggestedTranslation\":\"Nhà của con lợn nào đó đã bị tàn phá rồi.\",\"rating\":8.5},\n  {\"id\":708324,\"suggestedTranslation\":\"Thêm vị ngọt cho hỗn hợp.\",\"rating\":8.5},\n  {\"id\":708325,\"suggestedTranslation\":\"Nó có màu đỏ vì chứa đầy khoa học trong đó.\",\"rating\":8.5},\n  {\"id\":708326,\"suggestedTranslation\":\"Nấu ăn rất dễ nếu bạn hiểu về hóa học.\",\"rating\":8.5},\n  {\"id\":708327,\"suggestedTranslation\":\"Một nắm hạt kỳ lạ.\",\"rating\":8.5},\n  {\"id\":708328,\"suggestedTranslation\":\"Biết đâu chúng lại sẵn lòng trao đổi nhỉ.\",\"rating\":8.5},\n  {\"id\":708329,\"suggestedTranslation\":\"Biết đâu chúng lại sẵn lòng trao đổi nhỉ.\",\"rating\":8.5},\n  {\"id\":708330,\"suggestedTranslation\":\"Đó là một củ củ cải tím sống.\",\"rating\":8.5},\n  {\"id\":708331,\"suggestedTranslation\":\"Nấu ăn là khoa học trong thực tiễn.\",\"rating\":8.5},\n  {\"id\":708332,\"suggestedTranslation\":\"Một nắm hạt kỳ lạ.\",\"rating\":8.5},\n  {\"id\":708333,\"suggestedTranslation\":\"Trông có vẻ hơi sần sùi hạt.\",\"rating\":8.5},\n  {\"id\":708334,\"suggestedTranslation\":\"Một nắm hạt kỳ lạ.\",\"rating\":8.5},\n  {\"id\":708335,\"suggestedTranslation\":\"Một con thỏ sừng thực thụ kìa! Lại đây nào bé con!\",\"rating\":8.5},\n  {\"id\":708336,\"suggestedTranslation\":\"Nhìn kìa, cặp sừng không hề được dán keo hay gì đâu nhé!\",\"rating\":8.5},\n  {\"id\":708337,\"suggestedTranslation\":\"Đứa nào đội cái đó chắc chắn là kẻ đầu đất rồi! Ồ, Walter!\",\"rating\":8.5},\n  {\"id\":708338,\"suggestedTranslation\":\"Chúng ta tìm thấy hang của nó rồi!\",\"rating\":8.5},\n  {\"id\":708339,\"suggestedTranslation\":\"Trông giống như một vụ sập hang.\",\"rating\":8.5},\n  {\"id\":708340,\"suggestedTranslation\":\"Đó là hậu quả của việc bất cẩn với lửa đấy.\",\"rating\":8.5},\n  {\"id\":708341,\"suggestedTranslation\":\"Liệu chúng có bao giờ mơ thấy ăn cà rốt rồi tỉnh dậy thấy nhà mình biến mất không nhỉ?\",\"rating\":8.5},\n  {\"id\":708342,\"suggestedTranslation\":\"Mình không thể thổi nổi một nốt nhạc! Heh. Hay đấy, Walter.\",\"rating\":8.5},\n  {\"id\":708343,\"suggestedTranslation\":\"Woby ơi, giờ cậu không phải mang vác mọi thứ một mình nữa rồi!\",\"rating\":8.5},\n  {\"id\":708344,\"suggestedTranslation\":\"Ai mà đang cáu kỉnh thế nhỉ?\",\"rating\":8.5},\n  {\"id\":708345,\"suggestedTranslation\":\"Phần ấn tượng nhất của con thỏ. Heh.\",\"rating\":8.5},\n  {\"id\":708346,\"suggestedTranslation\":\"Ai đó đang có tâm trạng tồi tệ kìa!\",\"rating\":8.5},\n  {\"id\":708347,\"suggestedTranslation\":\"Bắt lấy nó đi, Woby!\",\"rating\":8.5},\n  {\"id\":708348,\"suggestedTranslation\":\"Trông nó có vẻ thân thiện!\",\"rating\":8.5},\n  {\"id\":708349,\"suggestedTranslation\":\"Phải luôn sẵn sàng ứng phó với thời tiết chứ!\",\"rating\":8.5},\n  {\"id\":708350,\"suggestedTranslation\":\"Tự hỏi mình có làm được một cái cho Woby không nhỉ.\",\"rating\":8.5},\n  {\"id\":708351,\"suggestedTranslation\":\"Dù sao thì nó cũng chẳng hữu ích cho lắm.\",\"rating\":8.5},\n  {\"id\":708352,\"suggestedTranslation\":\"Một Hướng đạo sinh Cây Thông có thể đánh hơi thấy mùi mưa từ cách xa cả dặm.\",\"rating\":8.5},\n  {\"id\":708353,\"suggestedTranslation\":\"Hóa ra trong đó không hề có con chuột nào thật cả.\",\"rating\":8.5},\n  {\"id\":708354,\"suggestedTranslation\":\"Mình vừa tìm thấy một sợi râu trên cằm, chắc vài bữa nữa râu mình sẽ mọc đầy mặt thôi.\",\"rating\":8.5},\n  {\"id\":708355,\"suggestedTranslation\":\"Mình có thể nghe cái này suốt đời luôn!\",\"rating\":8.5},\n  {\"id\":708356,\"suggestedTranslation\":\"Đúng thế đấy, Woby! Đỉnh của chóp luôn!\",\"rating\":8.5},\n  {\"id\":708357,\"suggestedTranslation\":\"Tuy không bằng Chương trình Phát thanh Đêm khuya, nhưng cũng khá ổn đấy.\",\"rating\":8.5},\n  {\"id\":708358,\"suggestedTranslation\":\"Woby thích hú theo lắm đúng không cô gái?\",\"rating\":8.5},\n  {\"id\":708359,\"suggestedTranslation\":\"Tuy không bằng Chương trình Phát thanh Đêm khuya, nhưng cũng khá ổn đấy.\",\"rating\":8.5},\n  {\"id\":708360,\"suggestedTranslation\":\"Woby thích hú theo lắm đúng không cô gái?\",\"rating\":8.5},\n  {\"id\":708361,\"suggestedTranslation\":\"Woby thích hú theo lắm đúng không cô gái?\",\"rating\":8.5},\n  {\"id\":708362,\"suggestedTranslation\":\"Tuy không bằng Chương trình Phát thanh Đêm khuya, nhưng cũng khá ổn đấy.\",\"rating\":8.5},\n  {\"id\":708363,\"suggestedTranslation\":\"Ồ, bài này hay đấy!\",\"rating\":8.5},\n  {\"id\":708364,\"suggestedTranslation\":\"Kinh điển tức thì!\",\"rating\":8.5},\n  {\"id\":708365,\"suggestedTranslation\":\"Woby thích hú theo lắm đúng không cô gái?\",\"rating\":8.5},\n  {\"id\":708366,\"suggestedTranslation\":\"Tuy không bằng Chương trình Phát thanh Đêm khuya, nhưng cũng khá ổn đấy.\",\"rating\":8.5},\n  {\"id\":708367,\"suggestedTranslation\":\"Mình nghĩ viên ngọc này có phép thuật đấy.\",\"rating\":8.5},\n  {\"id\":708368,\"suggestedTranslation\":\"Mình thích hiệu ứng ánh sáng đầy kịch tính này!\",\"rating\":8.5},\n  {\"id\":708369,\"suggestedTranslation\":\"Con mắt này trông đỏ ngầu như máu!\",\"rating\":8.5},\n  {\"id\":708370,\"suggestedTranslation\":\"Nó đang kêu lủng lẳng kìa.\",\"rating\":8.5},\n  {\"id\":708371,\"suggestedTranslation\":\"Nhìn cái đó là biết có độc rồi.\",\"rating\":8.5},\n  {\"id\":708372,\"suggestedTranslation\":\"Nấu lên rồi thì nó có bớt độc đi không nhỉ?\",\"rating\":8.5},\n  {\"id\":708373,\"suggestedTranslation\":\"Chắc là không nên hái cái đó đâu.\",\"rating\":8.5},\n  {\"id\":708374,\"suggestedTranslation\":\"Có một cây nấm đang trốn ở dưới kìa.\",\"rating\":8.5},\n  {\"id\":708375,\"suggestedTranslation\":\"Liệu nó có mọc lại không nhỉ?\",\"rating\":8.5},\n  {\"id\":708376,\"suggestedTranslation\":\"Ôi không, ai lại không tuân thủ quy tắc an toàn khi dùng lửa thế này?\",\"rating\":8.5},\n  {\"id\":708377,\"suggestedTranslation\":\"Một cảnh tượng khá bình thường ở đầm lầy.\",\"rating\":8.5},\n  {\"id\":708378,\"suggestedTranslation\":\"Chẳng còn gì để thu hoạch ở đây nữa.\",\"rating\":8.5},\n  {\"id\":708379,\"suggestedTranslation\":\"Mất khối thời gian mới thu thập được ngần ấy bụi bẩn đấy.\",\"rating\":8.5},\n  {\"id\":708380,\"suggestedTranslation\":\"Trông mình có ngầu như cảm giác lúc này không nhỉ?\",\"rating\":8.5},\n  {\"id\":708381,\"suggestedTranslation\":\"Nó còn cổ hơn cả mấy món đồ linh tinh ở nhà ông nội mình nữa.\",\"rating\":8.5},\n  {\"id\":708382,\"suggestedTranslation\":\"Trông có giống lửa trại chút nào không hả?!\",\"rating\":8.5},\n  {\"id\":708383,\"suggestedTranslation\":\"Mình chưa bao giờ biết khoa học lại đóng vai trò quan trọng trong việc sinh tồn đến thế.\",\"rating\":8.5},\n  {\"id\":708384,\"suggestedTranslation\":\"Ước gì mọi thứ đừng có bén lửa nữa.\",\"rating\":8.5},\n  {\"id\":708385,\"suggestedTranslation\":\"Họ chưa từng dạy tụi mình về thuật giả kim ở trường.\",\"rating\":8.5},\n  {\"id\":708386,\"suggestedTranslation\":\"Chắc phép thuật này không chống được lửa rồi.\",\"rating\":8.5},\n  {\"id\":708387,\"suggestedTranslation\":\"Nó có thực sự là phép thuật không thế?\",\"rating\":8.5},\n  {\"id\":708388,\"suggestedTranslation\":\"Chắc đó cũng là một cách để chấm dứt bí ẩn này.\",\"rating\":8.5},\n  {\"id\":708389,\"suggestedTranslation\":\"Mình thực sự không hiểu cái này hoạt động thế nào nữa.\",\"rating\":8.5},\n  {\"id\":708390,\"suggestedTranslation\":\"Nó thay đổi vẻ bề ngoài, nhưng bản chất bên trong thì vẫn thế.\",\"rating\":8.5},\n  {\"id\":708391,\"suggestedTranslation\":\"Phí phạm nguyên liệu quá...\",\"rating\":8.5},\n  {\"id\":708392,\"suggestedTranslation\":\"Mình cứ tưởng hồi sinh người chết phải cần nhiều cần gạt và điện giật hơn cơ.\",\"rating\":8.5},\n  {\"id\":708393,\"suggestedTranslation\":\"Chắc chắn nó đã được sử dụng bởi một nền văn minh cổ đại!\",\"rating\":8.5},\n  {\"id\":708394,\"suggestedTranslation\":\"Cậu đã bao giờ nghe câu chuyện về trái tim đang đập được giấu dưới ván sàn chưa?\",\"rating\":8.5},\n  {\"id\":708395,\"suggestedTranslation\":\"Cậu ta có chiếc mũi rất thính cho kiểu công việc này đấy.\",\"rating\":8.5},\n  {\"id\":708396,\"suggestedTranslation\":\"Woby cũng muốn ăn kìa!\",\"rating\":8.5},\n  {\"id\":708397,\"suggestedTranslation\":\"Tự hỏi chúng đến đây bằng cách nào nhỉ?\",\"rating\":8.5},\n  {\"id\":708398,\"suggestedTranslation\":\"Cậu có thấy vui khi ở trong túi áo của tôi không?\",\"rating\":8.5},\n  {\"id\":708399,\"suggestedTranslation\":\"Sổ tay của mình không có loại màu này...\",\"rating\":8.5},\n  {\"id\":708400,\"suggestedTranslation\":\"Chúng cực kỳ nhiều lông tơ luôn.\",\"rating\":8.5},\n  {\"id\":708401,\"suggestedTranslation\":\"Cái này thực sự dùng để khâu vá đấy á?\",\"rating\":8.5},\n  {\"id\":708402,\"suggestedTranslation\":\"Đừng lo, một Hướng đạo sinh Cây Thông luôn sẵn sàng giúp đỡ những ai gặp khó khăn!\",\"rating\":8.5},\n  {\"id\":708403,\"suggestedTranslation\":\"Nó sẽ hữu ích hơn nếu được đập thành những mảnh nhỏ hơn.\",\"rating\":8.5},\n  {\"id\":708404,\"suggestedTranslation\":\"Có lẽ mình có thể làm một cái Lò Lửa.\",\"rating\":8.5},\n  {\"id\":708405,\"suggestedTranslation\":\"Chao ôi! Nhìn cậu kìa!\",\"rating\":8.5},\n  {\"id\":708406,\"suggestedTranslation\":\"Mình không nghĩ nó sẽ ra quả sớm đâu.\",\"rating\":8.5},\n  {\"id\":708407,\"suggestedTranslation\":\"Nó đang bốc cháy!\",\"rating\":8.5},\n  {\"id\":708408,\"suggestedTranslation\":\"Chắc bụi cây mặt trăng trông nó phải thế này nhỉ?\",\"rating\":8.5},\n  {\"id\":708409,\"suggestedTranslation\":\"Có gì đó không ổn với nó à?\",\"rating\":8.5},\n  {\"id\":708410,\"suggestedTranslation\":\"Cái cây đó đang mọc ra... cục đá á?\",\"rating\":8.5},\n  {\"id\":708411,\"suggestedTranslation\":\"Chúng ta đã hái hết quả rồi còn đâu.\",\"rating\":8.5},\n  {\"id\":708412,\"suggestedTranslation\":\"Mình không nghĩ nó thích thời tiết nóng nực này đâu.\",\"rating\":8.5},\n  {\"id\":708413,\"suggestedTranslation\":\"Nó cứng như đá tảng vậy!\",\"rating\":8.5},\n  {\"id\":708414,\"suggestedTranslation\":\"Cuối cùng thì nó cũng chín! ...Mình nghĩ thế.\",\"rating\":8.5},\n  {\"id\":708415,\"suggestedTranslation\":\"Thế này thì đỡ hơn rồi.\",\"rating\":8.5},\n  {\"id\":708416,\"suggestedTranslation\":\"Ồ, nó đang lớn lên kìa!\",\"rating\":8.5},\n  {\"id\":708417,\"suggestedTranslation\":\"Cái này thực sự làm bạn lạnh thấu xương đấy.\",\"rating\":8.5},\n  {\"id\":708418,\"suggestedTranslation\":\"Băng đá đôi khi cũng thế mà.\",\"rating\":8.5},\n  {\"id\":708419,\"suggestedTranslation\":\"Băng đá đôi khi cũng thế mà.\",\"rating\":8.5},\n  {\"id\":708420,\"suggestedTranslation\":\"Một hố nham thạch đã đóng vảy ở trên.\",\"rating\":8.5},\n  {\"id\":708421,\"suggestedTranslation\":\"Lớp dung nham đang đóng váng lại rồi.\",\"rating\":8.5},\n  {\"id\":708422,\"suggestedTranslation\":\"Vừa đẹp lại vừa ấm cúng.\",\"rating\":8.5},\n  {\"id\":708423,\"suggestedTranslation\":\"Trông có vẻ dễ vỡ đấy.\",\"rating\":8.5},\n  {\"id\":708424,\"suggestedTranslation\":\"Tự hỏi nó ảnh hưởng thế nào đến người sói nhỉ. Chắc mình phải hỏi anh Woodie mới được.\",\"rating\":8.5},\n  {\"id\":708425,\"suggestedTranslation\":\"Thứ gì mà có thể biến nó thành đá thế nhỉ?\",\"rating\":8.5},\n  {\"id\":708426,\"suggestedTranslation\":\"Thứ gì mà có thể biến nó thành đá thế nhỉ?\",\"rating\":8.5},\n  {\"id\":708427,\"suggestedTranslation\":\"Tự hỏi nó hoạt động thế nào nhỉ?\",\"rating\":8.5},\n  {\"id\":708428,\"suggestedTranslation\":\"Chao ôi! Trông nó còn nguy hiểm hơn mấy con bình thường nhiều!\",\"rating\":8.5},\n  {\"id\":708429,\"suggestedTranslation\":\"Một món đồ không thể thiếu trong bất kỳ bộ dụng cụ thám hiểm nào.\",\"rating\":8.5},\n  {\"id\":708430,\"suggestedTranslation\":\"Mấy thứ này cơ bản của H... hướng đạo sinh mà... ừm, tờ hướng dẫn đâu rồi nhỉ?\",\"rating\":8.5},\n  {\"id\":708431,\"suggestedTranslation\":\"Dạo này Winona hay đeo mấy cái đó lắm.\",\"rating\":8.5},\n  {\"id\":708432,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":8.5},\n  {\"id\":708433,\"suggestedTranslation\":\"Cái đó hỏng thật rồi.\",\"rating\":8.5},\n  {\"id\":708434,\"suggestedTranslation\":\"Kiếm được nó đúng là mệt bở hơi tai.\",\"rating\":8.5},\n  {\"id\":708435,\"suggestedTranslation\":\"Một đống cục đá siêu cổ. Mà chắc cục đá nào chẳng cổ...\",\"rating\":8.5},\n  {\"id\":708436,\"suggestedTranslation\":\"Ta là vua! Các ngươi phải nghe lời ta nói!\",\"rating\":8.5},\n  {\"id\":708437,\"suggestedTranslation\":\"Mình chưa bao giờ giỏi bóng chày... nhưng biết đâu cầm chiếc gậy này vào thì mình lại giỏi nhỉ!\",\"rating\":8.5},\n  {\"id\":708438,\"suggestedTranslation\":\"Chúng ta có thể sửa nó lại bằng sự quyết tâm của Hướng đạo sinh Cây Thông!\",\"rating\":8.5},\n  {\"id\":708439,\"suggestedTranslation\":\"Chắc chắn PHẢI có món gì ngon ở trong đó rồi, nhìn nó kìa!\",\"rating\":8.5},\n  {\"id\":708440,\"suggestedTranslation\":\"Làm sao để mở nó ra đây? Có cao kiến gì không Woby?\",\"rating\":8.5},\n  {\"id\":708441,\"suggestedTranslation\":\"Đeo yên cưỡi suốt thế thì chắc chẳng thoải mái gì đâu.\",\"rating\":8.5},\n  {\"id\":708442,\"suggestedTranslation\":\"Chắc cậu cần một cái yên cưỡi để cưỡi một số loài động vật.\",\"rating\":8.5},\n  {\"id\":708443,\"suggestedTranslation\":\"Thấy chưa? Bọ cũng hữu ích theo nhiều cách đấy chứ!\",\"rating\":8.5},\n  {\"id\":708444,\"suggestedTranslation\":\"Chỗ ngồi tuyệt đấy chứ!\",\"rating\":8.5},\n  {\"id\":708445,\"suggestedTranslation\":\"Nó gần như thoải mái bằng việc ngồi trên bộ lông của Woby vậy.\",\"rating\":8.5},\n  {\"id\":708446,\"suggestedTranslation\":\"Cậu muốn thử không Woby? Đừng lo, mình đùa thôi mà!\",\"rating\":8.5},\n  {\"id\":708447,\"suggestedTranslation\":\"Sao lại chỉ cho có một miếng bánh ngô giòn thế này?!\",\"rating\":8.5},\n  {\"id\":708448,\"suggestedTranslation\":\"Muối rất tuyệt để bảo quản nguồn dự trữ của bạn.\",\"rating\":8.5},\n  {\"id\":708449,\"suggestedTranslation\":\"Đừng có ăn cái đó đấy Woby, cái đó dành cho bò lai mà!\",\"rating\":8.5},\n  {\"id\":708450,\"suggestedTranslation\":\"Cậu đâu phải bò lai đâu Woby.\",\"rating\":8.5},\n  {\"id\":708451,\"suggestedTranslation\":\"Này, mình nghĩ đó là muối đấy!\",\"rating\":8.5},\n  {\"id\":708452,\"suggestedTranslation\":\"Biết đâu có Medusa ở gần đây... một Medusa muối...\",\"rating\":8.5},\n  {\"id\":708453,\"suggestedTranslation\":\"Thật may là chúng có thể mọc lại!\",\"rating\":8.5},\n  {\"id\":708454,\"suggestedTranslation\":\"Chẳng còn gì để thu hoạch nữa.\",\"rating\":8.5},\n  {\"id\":708455,\"suggestedTranslation\":\"Về mặt kỹ thuật thì chú ta không phải chó, nhưng vẫn là một bé ngoan!\",\"rating\":8.5},\n  {\"id\":708456,\"suggestedTranslation\":\"Trông ra dáng ra phết!\",\"rating\":8.5},\n  {\"id\":708457,\"suggestedTranslation\":\"Chao ôi! Cậu làm cách nào hay thế?\",\"rating\":8.5},\n  {\"id\":708458,\"suggestedTranslation\":\"Này, cẩn thận chứ! Suýt nữa cậu đánh trúng mình rồi đấy!\",\"rating\":8.5},\n  {\"id\":708459,\"suggestedTranslation\":\"Này, cái đó ở đâu chui ra thế nhỉ?\",\"rating\":8.5},\n  {\"id\":708460,\"suggestedTranslation\":\"Mình thề là vừa có cái gì ở đây lúc nãy mà.\",\"rating\":8.5},\n  {\"id\":708461,\"suggestedTranslation\":\"Ai đó kiếm ít nước mau lên!\",\"rating\":8.5},\n  {\"id\":708462,\"suggestedTranslation\":\"Trông không khỏe mạnh cho lắm.\",\"rating\":8.5},\n  {\"id\":708463,\"suggestedTranslation\":\"Nó phải trông như thế này thật à?\",\"rating\":8.5},\n  {\"id\":708464,\"suggestedTranslation\":\"Đó là một cây con.\",\"rating\":8.5},\n  {\"id\":708465,\"suggestedTranslation\":\"Giờ thì nó chẳng bao giờ lớn thành cây được nữa rồi.\",\"rating\":8.5},\n  {\"id\":708466,\"suggestedTranslation\":\"Chắc ngoài trời nóng quá đây mà.\",\"rating\":8.5},\n  {\"id\":708467,\"suggestedTranslation\":\"Hay thật đấy! Muốn quét mình luôn không?\",\"rating\":8.5},\n  {\"id\":708468,\"suggestedTranslation\":\"Mình đoán điều đó làm nó trông có vẻ đáng sợ hơn một chút.\",\"rating\":8.5},\n  {\"id\":708469,\"suggestedTranslation\":\"Giờ thì chẳng còn dùng được mấy nữa rồi.\",\"rating\":8.5},\n  {\"id\":708470,\"suggestedTranslation\":\"Ai mà thèm sợ cái đó cơ chứ?\",\"rating\":8.5},\n  {\"id\":708471,\"suggestedTranslation\":\"Mình nghĩ thời gian để sơ cứu đã qua lâu lắm rồi.\",\"rating\":8.5},\n  {\"id\":708472,\"suggestedTranslation\":\"Mình nên thêm nó vào cuốn sổ lưu niệm mới được!\",\"rating\":8.5},\n  {\"id\":708473,\"suggestedTranslation\":\"Con lợn vằn đó to đến mức mình có thể lấy tấm đệm vai của nó làm mũ luôn!\",\"rating\":8.5},\n  {\"id\":708474,\"suggestedTranslation\":\"Chao ôi! Giống như ống nhòm vậy, nhưng mà... ừm, ngược lại cơ!\",\"rating\":8.5},\n  {\"id\":708475,\"suggestedTranslation\":\"Cái này trông không khó lắm đâu! Hay là có nhỉ...\",\"rating\":8.5},\n  {\"id\":708476,\"suggestedTranslation\":\"Chúng ta chẳng có sẵn một Lò Lửa ngon lành rồi sao?\",\"rating\":8.5},\n  {\"id\":708477,\"suggestedTranslation\":\"Đã đến lúc làm nghệ thuật thủ công rồi.\",\"rating\":8.5},\n  {\"id\":708478,\"suggestedTranslation\":\"Này Woby, nhìn này! Mình bắt đầu giỏi món này rồi đấy!\",\"rating\":8.5},\n  {\"id\":708479,\"suggestedTranslation\":\"Một phần của bức tượng này trông có vẻ cổ hơn phần kia.\",\"rating\":8.5},\n  {\"id\":708480,\"suggestedTranslation\":\"Xong rồi!\",\"rating\":8.5},\n  {\"id\":708481,\"suggestedTranslation\":\"Hửm? Hình như mình nghe thấy có gì đó đang chuyển động trong đó.\",\"rating\":8.5},\n  {\"id\":708482,\"suggestedTranslation\":\"Cậu đánh hơi ra mảnh còn thiếu được không Woby?\",\"rating\":8.5},\n  {\"id\":708483,\"suggestedTranslation\":\"Cái đó làm gì ở đây thế nhỉ?\",\"rating\":8.5},\n  {\"id\":708484,\"suggestedTranslation\":\"Có cái gì đó rất kỳ lạ về nó.\",\"rating\":8.5},\n  {\"id\":708485,\"suggestedTranslation\":\"Trông khá hơn rồi đấy.\",\"rating\":8.5},\n  {\"id\":708486,\"suggestedTranslation\":\"Hửm? Hình như mình nghe thấy có gì đó đang chuyển động trong đó.\",\"rating\":8.5},\n  {\"id\":708487,\"suggestedTranslation\":\"Nó vỡ tung tóe hết cả rồi.\",\"rating\":8.5},\n  {\"id\":708488,\"suggestedTranslation\":\"Đúng là một cách để \\\"lên đỉnh\\\"... à nhầm, có đầu. Hiểu ý mình chứ?\",\"rating\":8.5},\n  {\"id\":708489,\"suggestedTranslation\":\"Mình nghĩ có thứ gì khác đang ẩn giấu trong khối đá cẩm thạch đó.\",\"rating\":8.5},\n  {\"id\":708490,\"suggestedTranslation\":\"Việc đó dễ ẹc hà.\",\"rating\":8.5},\n  {\"id\":708491,\"suggestedTranslation\":\"Hửm? Hình như mình nghe thấy có gì đó đang chuyển động trong đó.\",\"rating\":8.5},\n  {\"id\":708492,\"suggestedTranslation\":\"Có cái gì đó đang bị thiếu...\",\"rating\":8.5},\n  {\"id\":708493,\"suggestedTranslation\":\"Nó lọt vào đây bằng cách nào thế?\",\"rating\":8.5},\n  {\"id\":708494,\"suggestedTranslation\":\"Lẽ ra chúng ta nên cẩn thận hơn với tài nguyên của mình mới phải.\",\"rating\":8.5},\n  {\"id\":708495,\"suggestedTranslation\":\"Chúng ta sẽ cần một chiếc Thuyền ván xịn hơn.\",\"rating\":8.5},\n  {\"id\":708496,\"suggestedTranslation\":\"Tràn ngập hương vị!\",\"rating\":8.5},\n  {\"id\":708497,\"suggestedTranslation\":\"Có cục đá phía mạn trái kìa!\",\"rating\":8.5},\n  {\"id\":708498,\"suggestedTranslation\":\"Nó trống không kìa Woby. Hãy tìm cái gì đó bỏ vào xem nào.\",\"rating\":8.5},\n  {\"id\":708499,\"suggestedTranslation\":\"Tự hỏi có huy hiệu nào bắt giữ quả cầu phát sáng không nhỉ.\",\"rating\":8.5},\n  {\"id\":708500,\"suggestedTranslation\":\"Không bao giờ là thừa túi đựng cả!\",\"rating\":8.5},\n  {\"id\":708501,\"suggestedTranslation\":\"Mấy chú chim thật tốt bụng khi biết chia sẻ đấy.\",\"rating\":8.5},\n  {\"id\":708502,\"suggestedTranslation\":\"Sống ở chốn hoang dã thì có gì dùng nấy thôi.\",\"rating\":8.5},\n  {\"id\":708503,\"suggestedTranslation\":\"Làm bản đồ ở đây thú vị hơn nhiều!\",\"rating\":8.5},\n  {\"id\":708504,\"suggestedTranslation\":\"Phải kiểm tra lại xem tất cả các huy hiệu của mình đã chắc chắn chưa đã!\",\"rating\":8.5},\n  {\"id\":708505,\"suggestedTranslation\":\"Ôi không, cứ như mình ngửi thấy mùi lửa trại đang cháy ở đâu đây!\",\"rating\":8.5},\n  {\"id\":708506,\"suggestedTranslation\":\"Mình không hiểu sao nhiều người lại nghĩ ma nơ canh đáng sợ nữa.\",\"rating\":8.5},\n  {\"id\":708507,\"suggestedTranslation\":\"Nó tiện lợi ghê!\",\"rating\":8.5},\n  {\"id\":708508,\"suggestedTranslation\":\"Thực ra ngài Maxwell cũng khá vui tính khiêm bạn đã quen đấy chứ.\",\"rating\":8.5},\n  {\"id\":708509,\"suggestedTranslation\":\"Ước gì cái bóng của mình có thể giúp mình làm việc nhà nhỉ.\",\"rating\":8.5},\n  {\"id\":708510,\"suggestedTranslation\":\"Nhìn cái kìa! Tự hỏi thứ gì giữ cho nó sống được hay vậy?\",\"rating\":8.5},\n  {\"id\":708511,\"suggestedTranslation\":\"Ước gì mình có thể nhìn rõ hơn vào bên trong...\",\"rating\":8.5},\n  {\"id\":708512,\"suggestedTranslation\":\"Cẩn thận mất chân đấy! Hiểu chứ, Wobes? Mất chân đấy!\",\"rating\":8.5},\n  {\"id\":708513,\"suggestedTranslation\":\"Không đâu Woby. Mình không nghĩ nó muốn được gãi bụng đâu.\",\"rating\":8.5},\n  {\"id\":708514,\"suggestedTranslation\":\"Hai đầu thì có tốt hơn một đầu không ta?\",\"rating\":8.5},\n  {\"id\":708515,\"suggestedTranslation\":\"Trông chúng có vẻ vui đấy!\",\"rating\":8.5},\n  {\"id\":708516,\"suggestedTranslation\":\"Cá là chúng thân thiện đấy!\",\"rating\":8.5},\n  {\"id\":708517,\"suggestedTranslation\":\"Đúng là một đứa ngốc nghếch!\",\"rating\":8.5},\n  {\"id\":708518,\"suggestedTranslation\":\"Mình nghĩ nó chỉ muốn có bạn thôi.\",\"rating\":8.5},\n  {\"id\":708519,\"suggestedTranslation\":\"Ồ ồ, hay ghê! Con đó bay được kìa!\",\"rating\":8.5},\n  {\"id\":708520,\"suggestedTranslation\":\"Woby, hình như nó vừa nháy mắt với mình kìa!\",\"rating\":8.5},\n  {\"id\":708521,\"suggestedTranslation\":\"Giống sơ cứu nhưng mà bằng phép thuật.\",\"rating\":8.5},\n  {\"id\":708522,\"suggestedTranslation\":\"Nó tiện lợi thật đấy! Hiểu chưa? Vì nó có tay mà!\",\"rating\":8.5},\n  {\"id\":708523,\"suggestedTranslation\":\"Đừng lo, khoản dựng đồ này thì mình giỏi lắm!\",\"rating\":8.5},\n  {\"id\":708524,\"suggestedTranslation\":\"Á chà, hữu ích ghê cơ!\",\"rating\":8.5},\n  {\"id\":708525,\"suggestedTranslation\":\"Đừng có ngửi quanh đấy nhé Woby.\",\"rating\":8.5},\n  {\"id\":708526,\"suggestedTranslation\":\"Nhìn kích thước hàm răng kìa!\",\"rating\":8.5},\n  {\"id\":708527,\"suggestedTranslation\":\"Tốt hơn hết là nên cẩn thận bị bỏng lạnh đấy!\",\"rating\":8.5},\n  {\"id\":708528,\"suggestedTranslation\":\"Cậu có thể làm rất nhiều thứ từ muối đấy!\",\"rating\":8.5},\n  {\"id\":708529,\"suggestedTranslation\":\"Đập nó ra xem bên trong có gì nào.\",\"rating\":8.5},\n  {\"id\":708530,\"suggestedTranslation\":\"Mình cứ nghĩ là nó đang cười chứ.\",\"rating\":8.5},\n  {\"id\":708531,\"suggestedTranslation\":\"Bạn sẽ không biết mình tìm được gì đâu nếu chịu khó đào bới một chút.\",\"rating\":8.5},\n  {\"id\":708532,\"suggestedTranslation\":\"Chính mình là người đặt tên cho nó đấy!\",\"rating\":8.5},\n  {\"id\":708533,\"suggestedTranslation\":\"Đừng có ăn cái đó đấy Woby! Cậu sẽ ngất xỉu ngay lập tức đấy.\",\"rating\":8.5},\n  {\"id\":708534,\"suggestedTranslation\":\"Đó thực sự là bánh ngọt hả?\",\"rating\":8.5},\n  {\"id\":708535,\"suggestedTranslation\":\"Trông kỳ cục ghê! Mình giữ nó được không?\",\"rating\":8.5},\n  {\"id\":708536,\"suggestedTranslation\":\"Phí phạm nguyên liệu quá...\",\"rating\":8.5},\n  {\"id\":708537,\"suggestedTranslation\":\"Một chỗ râm mát để chợp mắt nhanh.\",\"rating\":8.5}\n]",
