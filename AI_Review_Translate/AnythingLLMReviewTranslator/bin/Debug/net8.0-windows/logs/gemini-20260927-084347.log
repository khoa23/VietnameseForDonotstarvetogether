        "parts": [
          {
            "text": "[\n  {\"id\":714538,\"suggestedTranslation\":\"Tôi rất cần một người bạn ở thế giới khắc nghiệt này.\",\"rating\":9.0},\n  {\"id\":714539,\"suggestedTranslation\":\"Luôn thủ sẵn một chút hành bên mình không bao giờ là thừa cả.\",\"rating\":9.0},\n  {\"id\":714540,\"suggestedTranslation\":\"Con bé tên là \\\"Flambé\\\" và nó cực kỳ đáng yêu.\",\"rating\":9.0},\n  {\"id\":714541,\"suggestedTranslation\":\"Mon ami, bạn không tính thử bánh của tôi sao?\",\"rating\":9.0},\n  {\"id\":714542,\"suggestedTranslation\":\"Bạn có muốn tôi làm cho ít Thịt Xông Khói và Trứng không?\",\"rating\":9.0},\n  {\"id\":714543,\"suggestedTranslation\":\"Con bé là chỗ dựa tuyệt vời trong những lúc căng thẳng.\",\"rating\":9.0},\n  {\"id\":714544,\"suggestedTranslation\":\"Chú mèo nhỏ ngọt ngào.\",\"rating\":9.0},\n  {\"id\":714545,\"suggestedTranslation\":\"Đây là Lambchop, trợ thủ nhà bếp nhỏ của tôi.\",\"rating\":9.0},\n  {\"id\":714546,\"suggestedTranslation\":\"Ánh sáng của đời tôi!\",\"rating\":9.0},\n  {\"id\":714547,\"suggestedTranslation\":\"Tôi sẽ không bao giờ ăn thịt bạn đâu.\",\"rating\":9.0},\n  {\"id\":714548,\"suggestedTranslation\":\"Chú cún nhỏ kìa!\",\"rating\":9.0},\n  {\"id\":714549,\"suggestedTranslation\":\"Chắc là súp quạ nhỉ?\",\"rating\":9.0},\n  {\"id\":714550,\"suggestedTranslation\":\"Nào, cưng của tôi.\",\"rating\":9.0},\n  {\"id\":714551,\"suggestedTranslation\":\"Tôi đang lần theo hương thơm của nó!\",\"rating\":9.0},\n  {\"id\":714552,\"suggestedTranslation\":\"Nó đem lại cho tôi một cảm giác kỳ lạ, chẳng lành chút nào...\",\"rating\":9.0},\n  {\"id\":714553,\"suggestedTranslation\":\"Mình nên chế tạo gì đây?\",\"rating\":9.0},\n  {\"id\":714554,\"suggestedTranslation\":\"Đây mà là kiếm à, tăm xỉa răng thì có!\",\"rating\":9.0},\n  {\"id\":714555,\"suggestedTranslation\":\"Hừm, lạ thật.\",\"rating\":9.0},\n  {\"id\":714556,\"suggestedTranslation\":\"Ngửi cứ như mùi cây cỏ.\",\"rating\":9.0},\n  {\"id\":714557,\"suggestedTranslation\":\"Đá ép, bày trí đẹp mắt đấy.\",\"rating\":9.0},\n  {\"id\":714558,\"suggestedTranslation\":\"Tôi quyết định sẽ thấy sợ!\",\"rating\":9.0},\n  {\"id\":714559,\"suggestedTranslation\":\"Tôi không biết nên thấy sợ hay thấy thương nữa.\",\"rating\":9.0},\n  {\"id\":714560,\"suggestedTranslation\":\"Tôi có thể sẽ hối hận, nhưng tôi thấy muốn giúp sinh vật tội nghiệp này.\",\"rating\":9.0},\n  {\"id\":714561,\"suggestedTranslation\":\"Có lẽ hắn ta cũng không tệ đến thế.\",\"rating\":9.0},\n  {\"id\":714562,\"suggestedTranslation\":\"Ồ không! Quý ngài Heo đang sôi máu lên rồi!\",\"rating\":9.0},\n  {\"id\":714563,\"suggestedTranslation\":\"Ah zut, hòn đá đó cứng quá tôi không phá nổi.\",\"rating\":9.0},\n  {\"id\":714564,\"suggestedTranslation\":\"Hay là mình giải cứu sinh vật tội nghiệp đó nhỉ?\",\"rating\":9.0},\n  {\"id\":714565,\"suggestedTranslation\":\"Tôi không khuyến khích món này đâu.\",\"rating\":9.0},\n  {\"id\":714566,\"suggestedTranslation\":\"Hừm... cho vào súp chắc sẽ ngon đây.\",\"rating\":9.0},\n  {\"id\":714567,\"suggestedTranslation\":\"Tạm biệt nhé, cái cây.\",\"rating\":9.0},\n  {\"id\":714568,\"suggestedTranslation\":\"Giòn rụm, phải không nào?\",\"rating\":9.0},\n  {\"id\":714569,\"suggestedTranslation\":\"Đã cắt lát!\",\"rating\":9.0},\n  {\"id\":714570,\"suggestedTranslation\":\"Một bó lá.\",\"rating\":9.0},\n  {\"id\":714571,\"suggestedTranslation\":\"Xin miễn nhé!\",\"rating\":9.0},\n  {\"id\":714572,\"suggestedTranslation\":\"Maman rất thích mấy lá bài của bà.\",\"rating\":9.0},\n  {\"id\":714573,\"suggestedTranslation\":\"Làm sao bằng tác phẩm của Rodin được.\",\"rating\":9.0},\n  {\"id\":714574,\"suggestedTranslation\":\"Chúng ta phải thay ngay mấy thứ này thôi.\",\"rating\":9.0},\n  {\"id\":714575,\"suggestedTranslation\":\"Giờ thì tất cả chúng ta có thể tỏa sáng hơn một chút rồi.\",\"rating\":9.0},\n  {\"id\":714576,\"suggestedTranslation\":\"Đẹp đấy, dù tôi thích bột mì hơn.\",\"rating\":9.0},\n  {\"id\":714577,\"suggestedTranslation\":\"Trông mờ tịt rồi kìa.\",\"rating\":9.0},\n  {\"id\":714578,\"suggestedTranslation\":\"Con xin lỗi, Maman.\",\"rating\":9.0},\n  {\"id\":714579,\"suggestedTranslation\":\"Ánh sáng!\",\"rating\":9.0},\n  {\"id\":714580,\"suggestedTranslation\":\"Cũng ổn.\",\"rating\":9.0},\n  {\"id\":714581,\"suggestedTranslation\":\"Nghệ thuật của tôi được thể hiện trong nhà bếp.\",\"rating\":9.0},\n  {\"id\":714582,\"suggestedTranslation\":\"Tôi rất khao khát được nhìn thấy khuôn mặt của Maman.\",\"rating\":9.0},\n  {\"id\":714583,\"suggestedTranslation\":\"Chẳng phải chúng nên có hai chiếc sừng sao?\",\"rating\":9.0},\n  {\"id\":714584,\"suggestedTranslation\":\"Hãy tưởng tượng xem... món thịt nai hầm vang đỏ béo ngậy mọng nước.\",\"rating\":9.0},\n  {\"id\":714585,\"suggestedTranslation\":\"Tôi từng có một bếp trưởng nước sốt trông y như thế này.\",\"rating\":9.0},\n  {\"id\":714586,\"suggestedTranslation\":\"Xong việc. Chín kỹ luôn rồi.\",\"rating\":9.0},\n  {\"id\":714587,\"suggestedTranslation\":\"Mùi mới kém hấp dẫn làm sao.\",\"rating\":9.0},\n  {\"id\":714588,\"suggestedTranslation\":\"Chúa tôi! Chuyện gì đang xảy ra thế này?\",\"rating\":9.0},\n  {\"id\":714589,\"suggestedTranslation\":\"Nếu không chịu được nhiệt, hãy đóng băng nhà bếp lại.\",\"rating\":9.0},\n  {\"id\":714590,\"suggestedTranslation\":\"Thiếu mất thành phần bí mật (SEEcret) rồi.\",\"rating\":9.0},\n  {\"id\":714591,\"suggestedTranslation\":\"Tôi sẽ làm ngay đây!\",\"rating\":9.0},\n  {\"id\":714592,\"suggestedTranslation\":\"Con mắt khổng lồ... nấu súp à?\",\"rating\":9.0},\n  {\"id\":714593,\"suggestedTranslation\":\"Trông giống một chiếc chìa khóa phải không nào?\",\"rating\":9.0},\n  {\"id\":714594,\"suggestedTranslation\":\"Ồ nai hươu ơi!\",\"rating\":9.0},\n  {\"id\":714595,\"suggestedTranslation\":\"Quá hạn sử dụng lâu lắm rồi.\",\"rating\":9.0},\n  {\"id\":714596,\"suggestedTranslation\":\"Đeo kính bảo hộ sẽ rất hữu ích đây. Đôi mắt của tôi rất quý giá.\",\"rating\":9.0},\n  {\"id\":714597,\"suggestedTranslation\":\"Nó hút sạch độ ẩm đi.\",\"rating\":9.0},\n  {\"id\":714598,\"suggestedTranslation\":\"Nó giúp tôi khô ráo hơn cả bánh quy cứng.\",\"rating\":9.0},\n  {\"id\":714599,\"suggestedTranslation\":\"Hiệu quả đấy chứ, phải không?\",\"rating\":9.0},\n  {\"id\":714600,\"suggestedTranslation\":\"Không, tôi là người theo chủ nghĩa truyền thống.\",\"rating\":9.0},\n  {\"id\":714601,\"suggestedTranslation\":\"Làm bừa bộn cả lên rồi đấy, phải không nào?\",\"rating\":9.0},\n  {\"id\":714602,\"suggestedTranslation\":\"Hừm, tìm tiếp nào.\",\"rating\":9.0},\n  {\"id\":714603,\"suggestedTranslation\":\"Một chiếc gậy dò đường được tinh chỉnh tinh tế.\",\"rating\":9.0},\n  {\"id\":714604,\"suggestedTranslation\":\"Tôi gần như ngửi thấy mùi của nó rồi!\",\"rating\":9.0},\n  {\"id\":714605,\"suggestedTranslation\":\"Tôi bắt được manh mối rồi!\",\"rating\":9.0},\n  {\"id\":714606,\"suggestedTranslation\":\"Ấm lên rồi, ấm lên rồi...!\",\"rating\":9.0},\n  {\"id\":714607,\"suggestedTranslation\":\"Đây là thớt chặt thịt à?\",\"rating\":9.0},\n  {\"id\":714608,\"suggestedTranslation\":\"Làm sao để bật nó lên đây?\",\"rating\":9.0},\n  {\"id\":714609,\"suggestedTranslation\":\"Công tác chuẩn bị đã hoàn tất!\",\"rating\":9.0},\n  {\"id\":714610,\"suggestedTranslation\":\"Trông có vẻ quan trọng đấy.\",\"rating\":9.0},\n  {\"id\":714611,\"suggestedTranslation\":\"Mọi thứ cần thiết để dựng lên một cái bến tàu.\",\"rating\":9.0},\n  {\"id\":714612,\"suggestedTranslation\":\"Bến tàu của tôi cần thêm chút trang trí.\",\"rating\":9.0},\n  {\"id\":714613,\"suggestedTranslation\":\"Quá đáng yêu!\",\"rating\":9.0},\n  {\"id\":714614,\"suggestedTranslation\":\"Y như một chiếc thuyền ván đựng nước sốt, chỉ là thiếu nước sốt thôi.\",\"rating\":9.0},\n  {\"id\":714615,\"suggestedTranslation\":\"Chỉ cần thêm nước, và voilà!\",\"rating\":9.0},\n  {\"id\":714616,\"suggestedTranslation\":\"Tôi có thể làm phần giữa của con rồng.\",\"rating\":9.0},\n  {\"id\":714617,\"suggestedTranslation\":\"Một chút vị cay để đánh thức vị giác.\",\"rating\":9.0},\n  {\"id\":714618,\"suggestedTranslation\":\"Tôi không hợp với việc này đâu.\",\"rating\":9.0},\n  {\"id\":714619,\"suggestedTranslation\":\"Ooh la la, kho chứa chống cháy.\",\"rating\":9.0},\n  {\"id\":714620,\"suggestedTranslation\":\"Kho chứa chống cháy, rất rộng rãi!\",\"rating\":9.0},\n  {\"id\":714621,\"suggestedTranslation\":\"Đó là một lò luyện mạ vàng.\",\"rating\":9.0},\n  {\"id\":714622,\"suggestedTranslation\":\"Liệu có sửa được không nhỉ?\",\"rating\":9.0},\n  {\"id\":714623,\"suggestedTranslation\":\"Ngọn lửa đẹp làm sao!\",\"rating\":9.0},\n  {\"id\":714624,\"suggestedTranslation\":\"Tôi tin là nó đang \\\"liếc\\\" tôi đấy.\",\"rating\":9.0},\n  {\"id\":714625,\"suggestedTranslation\":\"Thật là kỳ lạ và độc đáo!\",\"rating\":9.0},\n  {\"id\":714626,\"suggestedTranslation\":\"Thêm chút bánh pudding và hạt chia thì tuyệt...\",\"rating\":9.0},\n  {\"id\":714627,\"suggestedTranslation\":\"Trái cây tươi ngon quá! Mình nên làm món gì với bạn đây?\",\"rating\":9.0},\n  {\"id\":714628,\"suggestedTranslation\":\"Những nguyên liệu cho tương lai, chỉ chờ ngày đơm hoa kết trái!\",\"rating\":9.0},\n  {\"id\":714629,\"suggestedTranslation\":\"Ồ! Tôi được làm phần đầu rồng à?\",\"rating\":9.0},\n  {\"id\":714630,\"suggestedTranslation\":\"Vỏ bánh xốp giòn, phần nhân chua ngọt... đúng là tuyệt phẩm!\",\"rating\":9.0},\n  {\"id\":714631,\"suggestedTranslation\":\"Tôi rất vui vì được góp vui cho lễ hội.\",\"rating\":9.0},\n  {\"id\":714632,\"suggestedTranslation\":\"Chạm vào nóng rẫy tay!\",\"rating\":9.0},\n  {\"id\":714633,\"suggestedTranslation\":\"Vừa đáng sợ vừa đẹp đẽ.\",\"rating\":9.0},\n  {\"id\":714634,\"suggestedTranslation\":\"Đầu tôi có vẻ an toàn hơn hẳn rồi.\",\"rating\":9.0},\n  {\"id\":714635,\"suggestedTranslation\":\"Thêm một ít hòn đá kỳ lạ đó nữa.\",\"rating\":9.0},\n  {\"id\":714636,\"suggestedTranslation\":\"Nó nhẹ một cách đáng ngạc nhiên.\",\"rating\":9.0},\n  {\"id\":714637,\"suggestedTranslation\":\"Cây Gỗ Mục nướng flambé!\",\"rating\":9.0},\n  {\"id\":714638,\"suggestedTranslation\":\"Cháy đen thui luôn rồi.\",\"rating\":9.0},\n  {\"id\":714639,\"suggestedTranslation\":\"Đã chặt gọn gàng.\",\"rating\":9.0},\n  {\"id\":714640,\"suggestedTranslation\":\"Cái cây này dành quá nhiều thời gian ở ngoài biển rồi.\",\"rating\":9.0},\n  {\"id\":714641,\"suggestedTranslation\":\"Thịt đùi!\",\"rating\":9.0},\n  {\"id\":714642,\"suggestedTranslation\":\"Có thể phết thêm một lớp sốt tỏi mật ong nhẹ...\",\"rating\":9.0},\n  {\"id\":714643,\"suggestedTranslation\":\"À, tôi vừa kiếm được vài quả chuối tươi!\",\"rating\":9.0},\n  {\"id\":714644,\"suggestedTranslation\":\"Mình có nên hồi sinh nó lại không nhỉ?\",\"rating\":9.0},\n  {\"id\":714645,\"suggestedTranslation\":\"Giờ thì tôi có thể có dâu rừng tươi bất cứ lúc nào mình muốn!\",\"rating\":9.0},\n  {\"id\":714646,\"suggestedTranslation\":\"Mình có nên hồi sinh nó lại không nhỉ?\",\"rating\":9.0},\n  {\"id\":714647,\"suggestedTranslation\":\"Mình có nên hồi sinh nó lại không nhỉ?\",\"rating\":9.0},\n  {\"id\":714648,\"suggestedTranslation\":\"Tôi khuyên là không nên ăn mấy thứ đó đâu.\",\"rating\":9.0},\n  {\"id\":714649,\"suggestedTranslation\":\"Mình có nên hồi sinh nó lại không nhỉ?\",\"rating\":9.0},\n  {\"id\":714650,\"suggestedTranslation\":\"Ha! Đố ai ăn được tôi đấy!\",\"rating\":9.0},\n  {\"id\":714651,\"suggestedTranslation\":\"Tất cả cơ bắp tay của tôi đều có được từ việc đánh lòng trắng trứng đấy.\",\"rating\":9.0},\n  {\"id\":714652,\"suggestedTranslation\":\"Dùng để làm mềm thịt và làm rét.\",\"rating\":9.0},\n  {\"id\":714653,\"suggestedTranslation\":\"Tất cả cơ bắp tay của tôi đều có được từ việc đánh lòng trắng trứng đấy.\",\"rating\":9.0},\n  {\"id\":714654,\"suggestedTranslation\":\"Tất cả cơ bắp tay của tôi đều có được từ việc đánh lòng trắng trứng đấy.\",\"rating\":9.0},\n  {\"id\":714655,\"suggestedTranslation\":\"À. Vậy cái này là để \\\"làm ấm\\\", phải không?\",\"rating\":9.0},\n  {\"id\":71465