            "text": "[\n  {\"id\": 711538, \"suggestedTranslation\": \"Thời gian đã để lại dấu ấn lên ngôi nhà này.\", \"rating\": 9.0},\n  {\"id\": 711539, \"suggestedTranslation\": \"Số phận thật bất công với nó.\", \"rating\": 9.0},\n  {\"id\": 711540, \"suggestedTranslation\": \"Hơi xập xìu một chút, nhưng đúng là cải tiến hơn đấy!\", \"rating\": 9.0},\n  {\"id\": 711541, \"suggestedTranslation\": \"Lấy lòng hắn có lẽ là một ý hay đấy.\", \"rating\": 9.0},\n  {\"id\": 711542, \"suggestedTranslation\": \"Có vẻ như chế độ quân chủ đã kết thúc đột ngột.\", \"rating\": 9.0},\n  {\"id\": 711543, \"suggestedTranslation\": \"Đúng là... tấm thảm xấu tệ mà tôi từng thấy.\", \"rating\": 9.0},\n  {\"id\": 711544, \"suggestedTranslation\": \"Thật là lãng phí thời gian và sức lực một cách tồi tệ!\", \"rating\": 9.0},\n  {\"id\": 711545, \"suggestedTranslation\": \"Ghép lại cái này chắc sẽ mất khối thời gian...\", \"rating\": 9.0},\n  {\"id\": 711546, \"suggestedTranslation\": \"Mấy sinh vật có vảy tội nghiệp trông có vẻ lạc lõng khi không có vua.\", \"rating\": 9.0},\n  {\"id\": 711547, \"suggestedTranslation\": \"Tên người cá nhỏ đó thực sự đang vực dậy nơi này đấy.\", \"rating\": 9.5},\n  {\"id\": 711548, \"suggestedTranslation\": \"Tôi nghi ngờ trong đó chẳng có gì đáng để mất thời gian đâu.\", \"rating\": 9.0},\n  {\"id\": 711549, \"suggestedTranslation\": \"Tôi nghi ngờ trong đó chẳng có gì đáng để mất thời gian đâu.\", \"rating\": 9.0},\n  {\"id\": 711550, \"suggestedTranslation\": \"Bọn chúng lúc nào cũng trông thế này à?\", \"rating\": 9.0},\n  {\"id\": 711551, \"suggestedTranslation\": \"Cách chọn vua mới kỳ lạ làm sao!\", \"rating\": 9.0},\n  {\"id\": 711552, \"suggestedTranslation\": \"Từng là người cá. Giờ thì không phải nữa rồi.\", \"rating\": 9.5},\n  {\"id\": 711553, \"suggestedTranslation\": \"Tôi nghi ngờ nó sẽ chống chọi lại được với thời gian.\", \"rating\": 9.0},\n  {\"id\": 711554, \"suggestedTranslation\": \"Tôi nghi ngờ trong đó chẳng có gì đáng để mất thời gian đâu.\", \"rating\": 9.0},\n  {\"id\": 711555, \"suggestedTranslation\": \"Tôi nghi ngờ trong đó chẳng có gì đáng để mất thời gian đâu.\", \"rating\": 9.0},\n  {\"id\": 711556, \"suggestedTranslation\": \"Tôi nghi ngờ nó sẽ chống chọi lại được với thời gian.\", \"rating\": 9.0},\n  {\"id\": 711557, \"suggestedTranslation\": \"Ồ! Có một mẩu giấy bên trong kìa!\", \"rating\": 9.0},\n  {\"id\": 711558, \"suggestedTranslation\": \"Bạn không bao giờ biết khi nào mình cần một cái chai rỗng đâu.\", \"rating\": 9.5},\n  {\"id\": 711559, \"suggestedTranslation\": \"Thôi được rồi. Đã đến lúc tiếp tục tiến lên.\", \"rating\": 9.0},\n  {\"id\": 711560, \"suggestedTranslation\": \"Tôi không biết cậu ta tìm đâu ra thời gian cho những việc thế này nữa.\", \"rating\": 9.0},\n  {\"id\": 711561, \"suggestedTranslation\": \"Collagen trong cái này cực tốt để chống lão hóa. Nhưng đồng hồ phép thuật thì tốt hơn.\", \"rating\": 9.0},\n  {\"id\": 711562, \"suggestedTranslation\": \"Đúng là một bước tiến so với cây đèn lồng cầm tay cổ điển.\", \"rating\": 9.5},\n  {\"id\": 711563, \"suggestedTranslation\": \"Đại dương có vẻ cần thêm chút ánh sáng đấy.\", \"rating\": 9.0},\n  {\"id\": 711564, \"suggestedTranslation\": \"Không bao giờ là quá già để tận hưởng chút niềm vui!\", \"rating\": 9.0},\n  {\"id\": 711565, \"suggestedTranslation\": \"Nó sẽ cho mọi người thấy tôi ở đâu, còn tôi ở thời gian nào lại là chuyện khác.\", \"rating\": 9.0},\n  {\"id\": 711566, \"suggestedTranslation\": \"Rõ ràng ai đó đã nghĩ nó đủ quan trọng để viết lên bảng hiệu.\", \"rating\": 9.5},\n  {\"id\": 711567, \"suggestedTranslation\": \"Chắc tôi vẽ nhanh cái gì đó thôi.\", \"rating\": 9.0},\n  {\"id\": 711568, \"suggestedTranslation\": \"Tôi nên mang nó cất vào đâu đó mới được.\", \"rating\": 9.0},\n  {\"id\": 711569, \"suggestedTranslation\": \"Ồhhhh. Đúng rồi. Là ngươi.\", \"rating\": 9.0},\n  {\"id\": 711570, \"suggestedTranslation\": \"Lần trước mình có mở nó ra không nhỉ? Tôi không nhớ nữa...\", \"rating\": 9.0},\n  {\"id\": 711571, \"suggestedTranslation\": \"Thật may là tôi đã không kết liễu đời mình ở đầu nhọn của chiếc sừng này.\", \"rating\": 9.0},\n  {\"id\": 711572, \"suggestedTranslation\": \"Giờ thì nó đúng là kinh tởm.\", \"rating\": 9.0},\n  {\"id\": 711573, \"suggestedTranslation\": \"Nó y hệt như một cái túi chườm nóng gớm ghiếc vậy.\", \"rating\": 9.0},\n  {\"id\": 711574, \"suggestedTranslation\": \"Trông cay đến mức nguy hiểm.\", \"rating\": 9.0},\n  {\"id\": 711575, \"suggestedTranslation\": \"Tôi đã mất đủ thời gian để đối phó với trò tai quái của ngươi rồi đấy!\", \"rating\": 9.5},\n  {\"id\": 711576, \"suggestedTranslation\": \"Cuối cùng cũng bắt được ngươi, con sâu bọ nhỏ bé!\", \"rating\": 9.0},\n  {\"id\": 711577, \"suggestedTranslation\": \"Lại là một trong mấy tên sinh vật phiền phức đó.\", \"rating\": 9.0},\n  {\"id\": 711578, \"suggestedTranslation\": \"Hmph, thế mà người ta cứ bảo tôi là đồ điên!\", \"rating\": 9.0},\n  {\"id\": 711579, \"suggestedTranslation\": \"Đúng là một chỗ ở tồi tệ để gọi là nhà.\", \"rating\": 9.0},\n  {\"id\": 711580, \"suggestedTranslation\": \"Cái mũ trông buồn cười ghê. Để tôi đội thử xem!\", \"rating\": 9.0},\n  {\"id\": 711581, \"suggestedTranslation\": \"Tôi cứ tưởng chúng to hơn chứ... chắc trí nhớ của tôi đã phóng đại nó lên rồi.\", \"rating\": 9.0},\n  {\"id\": 711582, \"suggestedTranslation\": \"Bọn chúng lại chuẩn bị giở trò cũ rồi đấy.\", \"rating\": 9.0},\n  {\"id\": 711583, \"suggestedTranslation\": \"Ít ra chúng cũng làm cho việc nhớ ai sống ở đây trở nên dễ dàng hơn.\", \"rating\": 9.0},\n  {\"id\": 711584, \"suggestedTranslation\": \"Thật đáng tiếc. Dù sao thì...\", \"rating\": 9.0},\n  {\"id\": 711585, \"suggestedTranslation\": \"Tôi thích sống vững chãi trên mặt đất hơn, cảm ơn nhé.\", \"rating\": 9.0},\n  {\"id\": 711586, \"suggestedTranslation\": \"Cái này... chính là cách mọi thứ bắt đầu phải không?\", \"rating\": 9.0},\n  {\"id\": 711587, \"suggestedTranslation\": \"Lẽ ra tôi nên nhớ ra sớm hơn. Giờ thì quá muộn rồi.\", \"rating\": 9.0},\n  {\"id\": 711588, \"suggestedTranslation\": \"Cũng chỉ là một cái cột, chẳng có gì đáng chú ý cả.\", \"rating\": 9.0},\n  {\"id\": 711589, \"suggestedTranslation\": \"Và bạn có gì để biện minh cho mớ thủ đoạn này không hả, hử?\", \"rating\": 9.0},\n  {\"id\": 711590, \"suggestedTranslation\": \"Mong là không có con khỉ nào đang trốn trong đó.\", \"rating\": 9.0},\n  {\"id\": 711591, \"suggestedTranslation\": \"Nếu đã ra khơi, thì ít ra tôi cũng phải trông ra dáng hải tặc chứ.\", \"rating\": 9.0},\n  {\"id\": 711592, \"suggestedTranslation\": \"Ồ, đội nó vào khiến người ta cảm thấy có chút nghịch ngợm đấy...\", \"rating\": 9.0},\n  {\"id\": 711593, \"suggestedTranslation\": \"Chắc rốt cuộc là tôi không đói lắm đâu...\", \"rating\": 9.0},\n  {\"id\": 711594, \"suggestedTranslation\": \"Nếu có lúc nào muốn tự sát bằng thịt ươn, chắc chắn tôi sẽ thử món này.\", \"rating\": 9.5},\n  {\"id\": 711595, \"suggestedTranslation\": \"Mọi sức sống đã bị hút cạn khỏi nó rồi.\", \"rating\": 9.0},\n  {\"id\": 711596, \"suggestedTranslation\": \"Ngửi mùi thôi đã thấy giảm đi vài năm tuổi thọ rồi.\", \"rating\": 9.5},\n  {\"id\": 711597, \"suggestedTranslation\": \"Hình như có kẻ không muốn chúng ta dùng thứ này.\", \"rating\": 9.0},\n  {\"id\": 711598, \"suggestedTranslation\": \"Tôi khá chắc là nó rất quan trọng cho việc gì đó.\", \"rating\": 9.0},\n  {\"id\": 711599, \"suggestedTranslation\": \"Tất nhiên rồi! Giờ thì tôi nhớ ra rồi!\", \"rating\": 9.0},\n  {\"id\": 711600, \"suggestedTranslation\": \"Lẽ ra phải có chuyện khác xảy ra chứ nhỉ? Tôi không nhớ nữa...\", \"rating\": 9.0},\n  {\"id\": 711601, \"suggestedTranslation\": \"Tôi có cảm giác khó chịu rằng nó không nên trông như thế này.\", \"rating\": 9.0},\n  {\"id\": 711602, \"suggestedTranslation\": \"Thật không công bằng khi vòng đời của chúng lại ngắn ngủi đến vậy.\", \"rating\": 9.0},\n  {\"id\": 711603, \"suggestedTranslation\": \"Túi của tôi hơi chật chội đấy, làm ơn đừng để bị bẹp dí nhé!\", \"rating\": 9.0},\n  {\"id\": 711604, \"suggestedTranslation\": \"Dù sao thì loài ngài cũng có sống được bao lâu đâu.\", \"rating\": 9.0},\n  {\"id\": 711605, \"suggestedTranslation\": \"Một con ngài biến thành cây thì chẳng còn gì là lạ lẫm nữa.\", \"rating\": 9.0},\n  {\"id\": 711606, \"suggestedTranslation\": \"Tôi sẽ không phí thời gian để ngắm mặt trăng dưới này đâu.\", \"rating\": 9.0},\n  {\"id\": 711607, \"suggestedTranslation\": \"Lo lắng về mặt trăng làm gì? Tôi còn khối việc phải đối phó dưới này đây.\", \"rating\": 9.0},\n  {\"id\": 711608, \"suggestedTranslation\": \"Ôi phiền phức thật, LẠI LÀ cái dòng thời gian này...\", \"rating\": 9.0},\n  {\"id\": 711609, \"suggestedTranslation\": \"Ồ tốt quá, trăng tròn kìa!\", \"rating\": 9.0},\n  {\"id\": 711610, \"suggestedTranslation\": \"Đang là trăng non. Tốt nhất là tôi nên cẩn thận...\", \"rating\": 9.0},\n  {\"id\": 711611, \"suggestedTranslation\": \"Mặt trăng đang khuyết dần.\", \"rating\": 9.0},\n  {\"id\": 711612, \"suggestedTranslation\": \"Mặt trăng đang tròn dần.\", \"rating\": 9.0},\n  {\"id\": 711613, \"suggestedTranslation\": \"Nó sẽ làm mặt kính đồng hồ hoàn hảo đấy, giá như nó chịu hợp tác với ma thuật bóng tối.\", \"rating\": 9.5},\n  {\"id\": 711614, \"suggestedTranslation\": \"Công cụ bén thì chặt cây mới nhanh!\", \"rating\": 9.0},\n  {\"id\": 711615, \"suggestedTranslation\": \"Nó sẽ không duy trì trạng thái nạp năng lượng lâu đâu.\", \"rating\": 9.0},\n  {\"id\": 711616, \"suggestedTranslation\": \"Mấy mảnh thủy tinh sắc nhọn mọc lên từ mặt đất, chuyện gì có thể xảy ra được cơ chứ?\", \"rating\": 9.0},\n  {\"id\": 711617, \"suggestedTranslation\": \"Có lẽ tôi nên coi những mũi nhọn bằng thủy tinh này là bảng hiệu để tránh xa ra.\", \"rating\": 9.5},\n  {\"id\": 711618, \"suggestedTranslation\": \"Nào, mình có thấy viên ngọc nào rơi vãi quanh đây không nhỉ?\", \"rating\": 9.0},\n  {\"id\": 711619, \"suggestedTranslation\": \"Trông nó hơi giống một chiếc chìa khóa phải không?\", \"rating\": 9.5},\n  {\"id\": 711620, \"suggestedTranslation\": \"Tôi chưa bao giờ nghĩ rằng mình sẽ được tận mắt nhìn thấy một mảnh của mặt trăng.\", \"rating\": 9.0},\n  {\"id\": 711621, \"suggestedTranslation\": \"Nó giống như một mặt trăng cỡ bỏ túi vậy.\", \"rating\": 9.0},\n  {\"id\": 711622, \"suggestedTranslation\": \"Tự hỏi ai là người đã làm ra mấy thứ này nhỉ?\", \"rating\": 9.0},\n  {\"id\": 711623, \"suggestedTranslation\": \"Bọn chúng trang trí nhà cửa tệ thật đấy, phải không?\", \"rating\": 9.0},\n  {\"id\": 711624, \"suggestedTranslation\": \"Ồ tuyệt vời làm sao, lại có thứ sắc nhọn để vấp ngã rồi.\", \"rating\": 9.0},\n  {\"id\": 711625, \"suggestedTranslation\": \"Nó đang tràn trề tiềm năng chưa được khai phá!\", \"rating\": 9.0},\n  {\"id\": 711626, \"suggestedTranslation\": \"May mắn là nó được thiết kế đủ chỗ để đeo kính bên dưới.\", \"rating\": 9.0},\n  {\"id\": 711627, \"suggestedTranslation\": \"Một hạt bụi mang theo những khả năng mạnh mẽ.\", \"rating\": 9.0},\n  {\"id\": 711628, \"suggestedTranslation\": \"Năng lượng không thể kìm chế.\", \"rating\": 9.0},\n  {\"id\": 711629, \"suggestedTranslation\": \"Tưởng là bắt được một con rồi chứ...\", \"rating\": 9.0},\n  {\"id\": 711630, \"suggestedTranslation\": \"Năng lượng có phần được kìm chế hơn.\", \"rating\": 9.0},\n  {\"id\": 711631, \"suggestedTranslation\": \"Chúng ta có nên kìm chế nguồn năng lượng đó không?\", \"rating\": 9.0},\n  {\"id\": 711632, \"suggestedTranslation\": \"Thỉnh thoảng táy máy mấy thứ phép thuật kỳ lạ cũng chẳng có gì là sai.\", \"rating\": 9.0},\n  {\"id\": 711633, \"suggestedTranslation\": \"Tôi cực kỳ ghét việc bỏ dở bất cứ thứ gì.\", \"rating\": 9.0},\n  {\"id\": 711634, \"suggestedTranslation\": \"Các mảnh ghép đang dần khớp lại với nhau.\", \"rating\": 9.0},\n  {\"id\": 711635, \"suggestedTranslation\": \"Giá mà tôi khám phá ra sức mạnh này trước... à mà thôi, chắc nó là chuyện quá khứ rồi.\", \"rating\": 9.0},\n  {\"id\": 711636, \"suggestedTranslation\": \"Tôi sẽ tận dụng nó tốt hơn cái lão cua già đó.\", \"rating\": 9.0},\n  {\"id\": 711637, \"suggestedTranslation\": \"Nó đang cho tôi thấy một nơi... đó là điềm báo hay ký ức nhỉ?\", \"rating\": 9.0},\n  {\"id\": 711638, \"suggestedTranslation\": \"Ước gì nó đừng có thì thầm đáng sợ kiểu đó nữa.\", \"rating\": 9.0},\n  {\"id\": 711639, \"suggestedTranslation\": \"Tôi nghĩ mình biết nó muốn đi đâu rồi.\", \"rating\": 9.0},\n  {\"id\": 711640, \"suggestedTranslation\": \"Bạn có cảm nhận được tiếng lách tách của những khả năng đang tràn ngập trong không khí không?\", \"rating\": 9.0},\n  {\"id\": 711641, \"suggestedTranslation\": \"Chắc chắn có thứ gì đó kẹt trong đó rồi. Tự hỏi xem...\", \"rating\": 9.0},\n  {\"id\": 711642, \"suggestedTranslation\": \"Chắc chắn có thứ gì đó kẹt trong đó rồi. Tự hỏi xem...\", \"rating\": 9.0},\n  {\"id\": 711643, \"suggestedTranslation\": \"Chắc chắn có thứ gì đó kẹt trong đó rồi. Tự hỏi xem...\", \"rating\": 9.0},\n  {\"id\": 711644, \"suggestedTranslation\": \"Đây không phải là nơi nó cần đến.\", \"rating\": 9.0},\n  {\"id\": 711645, \"suggestedTranslation\": \"Có cảm giác như những bánh xe số phận đã bắt đầu chuyển động...\", \"rating\": 9.0},\n  {\"id\": 711646, \"suggestedTranslation\": \"Một cây nấm đột biến, chuyện gì có thể xảy ra cơ chứ?\", \"rating\": 9.5},\n  {\"id\": 711647, \"suggestedTranslation\": \"Sao nó cứ phải có mùi giống phô mai cũ thế nhỉ?\", \"rating\": 9.0},\n  {\"id\": 711648, \"suggestedTranslation\": \"Tôi có linh cảm không lành rằng mình đã làm chuyện này trước đây rồi...\", \"rating\": 9.0},\n  {\"id\": 711649, \"suggestedTranslation\": \"Tiến độ đang được thực hiện từ từ.\", \"rating\": 9.0},\n  {\"id\": 711650, \"suggestedTranslation\": \"Nó xong rồi...\", \"rating\": 9.0},\n  {\"id\": 711651, \"suggestedTranslation\": \"Không khí xung quanh nó tràn ngập tiềm năng.\", \"rating\": 9.0},\n  {\"id\": 711652, \"suggestedTranslation\": \"Tốt hơn là tôi nên cẩn thận chân cẳng khi ở quanh đây.\", \"rating\": 9.0},\n  {\"id\": 711653, \"suggestedTranslation\": \"Thỉnh thoảng nó lại phát ra tiếng kêu tút tút nhỏ dễ thương phết.\", \"rating\": 9.0},\n  {\"id\": 711654, \"suggestedTranslation\": \"Chắc đó chỉ là quy luật tự nhiên vào một số thời điểm thôi.\", \"rating\": 9.0},\n  {\"id\": 711655, \"suggestedTranslation\": \"Đó là dấu chấm hết cho cái cây này.\", \"rating\": 9.0},\n  {\"id\": 711656, \"suggestedTranslation\": \"Chẳng dại gì mà đứng chờ nó mọc lại đâu.\", \"rating\": 9.0},\n  {\"id\": 711657, \"suggestedTranslation\": \"Trông nó có vẻ đã ngả sang màu xám rồi.\", \"rating\": 9.0},\n  {\"id\": 711658, \"suggestedTranslation\": \"Nó đã chuyển sang màu trắng hoàn toàn.\", \"rating\": 9.0},\n  {\"id\": 711659, \"suggestedTranslation\": \"Thơm thật đấy.\", \"rating\": 9.0},\n  {\"id\": 711660, \"suggestedTranslation\": \"Tôi không bao giờ quên được cái khuôn mặt thế này.\", \"rating\": 9.0},\n  {\"id\": 711661, \"suggestedTranslation\": \"Một sinh mệnh hoàn toàn mới sắp sửa bắt đầu.\", \"rating\": 9.0},\n  {\"id\": 711662, \"suggestedTranslation\": \"Có cái gì đó đang mách bảo tôi nên dè chừng khi ở quanh đây.\", \"rating\": 9.0},\n  {\"id\": 711663, \"suggestedTranslation\": \"Thật mừng vì có ai đó quanh đây biết nấu ăn.\", \"rating\": 9.0},\n  {\"id\": 711664, \"suggestedTranslation\": \"Nó đang cố hút cạn sự sống của tôi kìa!\", \"rating\": 9.0},\n  {\"id\": 711665, \"suggestedTranslation\": \"Đáng đời ngươi!\", \"rating\": 9.0},\n  {\"id\": 711666, \"suggestedTranslation\": \"Mong là nó hiệu quả cũng như sự kinh tởm của nó vậy.\", \"rating\": 9.0},\n  {\"id\": 711667, \"suggestedTranslation\": \"Ít ra thứ này cũng giúp khu vườn của tôi mọc nhanh hơn.\", \"rating\": 9.0},\n  {\"id\": 711668, \"suggestedTranslation\": \"Thôi cảm ơn.\", \"rating\": 9.0},\n  {\"id\": 711669, \"suggestedTranslation\": \"Mong là thứ này sẽ có tác dụng...\", \"rating\": 9.0},\n  {\"id\": 711670, \"suggestedTranslation\": \"Chắc tôi sắp nôn tới nơi rồi...\", \"rating\": 9.0},\n  {\"id\": 711671, \"suggestedTranslation\": \"BÂY GIỜ thì chúng trông đáng yêu đấy...\", \"rating\": 9.0},\n  {\"id\": 711672, \"suggestedTranslation\": \"Đằng nào bọn chúng có dùng mấy thứ đó nữa đâu.\", \"rating\": 9.0},\n  {\"id\": 711673, \"suggestedTranslation\": \"Đừng hòng bắt được tôi chui vào trong đó.\", \"rating\": 9.0},\n  {\"id\": 711674, \"suggestedTranslation\": \"Nó làm ấm người từ trong ra ngoài.\", \"rating\": 9.0},\n  {\"id\": 711675, \"suggestedTranslation\": \"Mấy bộ phận của cơ chế này trông... quen quen...\", \"rating\": 9.0},\n  {\"id\": 711676, \"suggestedTranslation\": \"Tôi có cảm giác như mình đang bị theo dõi...\", \"rating\": 9.0},\n  {\"id\": 711677, \"suggestedTranslation\": \"Cái này sẽ tiết kiệm cho tôi khối thời gian quý giá đấy!\", \"rating\": 9.0},\n  {\"id\": 711678, \"suggestedTranslation\": \"Cây nấm này còn tệ hơn đa số những loại khác.\", \"rating\": 9.5},\n  {\"id\": 711679, \"suggestedTranslation\": \"Biết ngay là mình có lý do khi không thích nấm mà!\", \"rating\": 9.0},\n  {\"id\": 711680, \"suggestedTranslation\": \"Tôi không thích ý tưởng có cây nấm mọc trên đầu mình chút nào.\", \"rating\": 9.5},\n  {\"id\": 711681, \"suggestedTranslation\": \"Giờ thì chúng có mùi giống như đồ mục nát bị cháy.\", \"rating\": 9.0},\n  {\"id\": 711682, \"suggestedTranslation\": \"Eo ôi. Bọn chúng có mùi đồ mục nát.\", \"rating\": 9.0},\n  {\"id\": 711683, \"suggestedTranslation\": \"Cuối cùng thì nó cũng tạo ra được một đống lửa trại nho nhỏ dễ chịu.\", \"rating\": 9.5},\n  {\"id\": 711684, \"suggestedTranslation\": \"Tôi ngạc nhiên là không có cây nấm nào mọc ra từ khúc gỗ mục này đấy.\", \"rating\": 9.5},\n  {\"id\": 711685, \"suggestedTranslation\": \"Mấy cây nấm đang sinh sôi nảy nở kìa.\", \"rating\": 9.0},\n  {\"id\": 711686, \"suggestedTranslation\": \"Nó qua thời kỳ đỉnh cao lâu rồi.\", \"rating\": 9.0},\n  {\"id\": 711687, \"suggestedTranslation\": \"Tôi nghĩ nó đã đông cứng ngắc rồi.\", \"rating\": 9.0},\n  {\"id\": 711688, \"suggestedTranslation\": \"Ồ tuyệt... nấm.\", \"rating\": 9.0},\n  {\"id\": 711689, \"suggestedTranslation\": \"Tôi sẽ làm gì với đống nấm này đây?\", \"rating\": 9.0},\n  {\"id\": 711690, \"suggestedTranslation\": \"Chắc đã đến lúc tìm nguồn sáng mới rồi.\", \"rating\": 9.0},\n  {\"id\": 711691, \"suggestedTranslation\": \"Cây nấm gì mà hình thù kỳ lạ thế.\", \"rating\": 9.5},\n  {\"id\": 711692, \"suggestedTranslation\": \"Ánh sáng tạo ra mà không cần dầu hay diêm chưa bao giờ ngừng làm tôi kinh ngạc.\", \"rating\": 9.0},\n  {\"id\": 711693, \"suggestedTranslation\": \"Chắc đã đến lúc tìm nguồn sáng mới rồi.\", \"rating\": 9.0},\n  {\"id\": 711694, \"suggestedTranslation\": \"Thêm vài bào tử có màu sắc vào chắc sẽ làm nơi này sáng sủa hơn đấy.\", \"rating\": 9.0},\n  {\"id\": 711695, \"suggestedTranslation\": \"Được rồi, nấm phát sáng thì tôi còn đánh giá cao được.\", \"rating\": 9.0},\n  {\"id\": 711696, \"suggestedTranslation\": \"Tôi sẽ không sớm quên được cái mùi này đâu.\", \"rating\": 9.0},\n  {\"id\": 711697, \"suggestedTranslation\": \"Ugh, nó đang cố mọc thêm nấm kìa.\", \"rating\": 9.0},\n  {\"id\": 711698, \"suggestedTranslation\": \"Từ trước đến nay tôi vốn không thích nấm.\", \"rating\": 9.0},\n  {\"id\": 711699, \"suggestedTranslation\": \"Lại nấm nữa. Thật là tuyệt vời.\", \"rating\": 9.0},\n  {\"id\": 711700, \"suggestedTranslation\": \"Tôi sẽ không sớm quên được cái mùi này đâu.\", \"rating\": 9.0},\n  {\"id\": 711701, \"suggestedTranslation\": \"Lại đến mùa bào tử nữa à?\", \"rating\": 9.0},\n  {\"id\": 711702, \"suggestedTranslation\": \"Không cẩn thận là tôi vấp phải một cái trong số này mất.\", \"rating\": 9.0},\n  {\"id\": 711703, \"suggestedTranslation\": \"Tôi sẽ không sớm quên được cái mùi này đâu.\", \"rating\": 9.0},\n  {\"id\": 711704, \"suggestedTranslation\": \"Đừng có mà dại dột dính mấy cái bào tử đó lên người tôi đấy!\", \"rating\": 9.0},\n  {\"id\": 711705, \"suggestedTranslation\": \"Tự hỏi sao nó lại lớn thế nhỉ? Đúng hơn l