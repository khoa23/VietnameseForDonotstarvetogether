            "text": "[\n  {\"id\":714720,\"suggestedTranslation\":\"Cô ấy bị kẹt rồi!\",\"rating\":9.0},\n  {\"id\":714838,\"suggestedTranslation\":\"Phần bên trong của mấy cỗ máy hư hỏng này.\",\"rating\":9.0},\n  {\"id\":714839,\"suggestedTranslation\":\"Trông không ngon miệng chút nào.\",\"rating\":9.0},\n  {\"id\":714840,\"suggestedTranslation\":\"Có ai đó đang trôi nổi trong đống thạch kìa.\",\"rating\":9.0},\n  {\"id\":714841,\"suggestedTranslation\":\"Có cái gì đó đang trôi nổi trong đống thạch.\",\"rating\":9.0},\n  {\"id\":714842,\"suggestedTranslation\":\"Tôi sẽ không phết thứ đó lên bánh mì nướng đâu.\",\"rating\":9.0},\n  {\"id\":714843,\"suggestedTranslation\":\"Trông thật chả thèm muốn chút nào.\",\"rating\":9.0},\n  {\"id\":714844,\"suggestedTranslation\":\"Đúng là một... cách bảo quản thức ăn thú vị.\",\"rating\":9.0},\n  {\"id\":714845,\"suggestedTranslation\":\"Cần phải lắp ráp một chút.\",\"rating\":9.0},\n  {\"id\":714846,\"suggestedTranslation\":\"Khảm ngọc vào!\",\"rating\":9.0},\n  {\"id\":714847,\"suggestedTranslation\":\"Voila!\",\"rating\":9.0},\n  {\"id\":714848,\"suggestedTranslation\":\"Cháy xém rồi.\",\"rating\":9.0},\n  {\"id\":714849,\"suggestedTranslation\":\"Nó đã ra đi rồi.\",\"rating\":9.0},\n  {\"id\":714850,\"suggestedTranslation\":\"Thật là trái tự nhiên.\",\"rating\":9.0},\n  {\"id\":714851,\"suggestedTranslation\":\"Bạn có thể... đưa tôi về với Maman thân yêu không?\",\"rating\":9.0},\n  {\"id\":714852,\"suggestedTranslation\":\"Có cái gì đó bên trong!\",\"rating\":9.0},\n  {\"id\":714853,\"suggestedTranslation\":\"Nó trống rỗng.\",\"rating\":9.0},\n  {\"id\":714854,\"suggestedTranslation\":\"Tôi nghĩ tốt nhất là nên tránh xa đường đi của chúng.\",\"rating\":9.0},\n  {\"id\":714855,\"suggestedTranslation\":\"Tôi đảm bảo rằng chuyện đó không có ý cá nhân đâu.\",\"rating\":9.0},\n  {\"id\":714856,\"suggestedTranslation\":\"Tôi có thể mời bạn một quả ớt ma không?\",\"rating\":9.0},\n  {\"id\":714857,\"suggestedTranslation\":\"Nhìn nó khiến tôi cảm thấy... thật bình yên.\",\"rating\":9.0},\n  {\"id\":714858,\"suggestedTranslation\":\"Tôi tự hỏi. Liệu người chết có biết nếm vị không nhỉ?\",\"rating\":9.0},\n  {\"id\":714859,\"suggestedTranslation\":\"Tôi không chắc về một số nguyên liệu đó đâu, tiểu thư à.\",\"rating\":9.0},\n  {\"id\":714860,\"suggestedTranslation\":\"Tôi không chắc về một số nguyên liệu đó đâu, tiểu thư à.\",\"rating\":9.0},\n  {\"id\":714861,\"suggestedTranslation\":\"Tôi không chắc về một số nguyên liệu đó đâu, tiểu thư à.\",\"rating\":9.0},\n  {\"id\":714862,\"suggestedTranslation\":\"Tôi không chắc về một số nguyên liệu đó đâu, tiểu thư à.\",\"rating\":9.0},\n  {\"id\":714863,\"suggestedTranslation\":\"Tôi không chắc về một số nguyên liệu đó đâu, tiểu thư à.\",\"rating\":9.0},\n  {\"id\":714864,\"suggestedTranslation\":\"Tôi không chắc về một số nguyên liệu đó đâu, tiểu thư à.\",\"rating\":9.0},\n  {\"id\":714865,\"suggestedTranslation\":\"Tôi không chắc về một số nguyên liệu đó đâu, tiểu thư à.\",\"rating\":9.0},\n  {\"id\":714866,\"suggestedTranslation\":\"Tôi không chắc về một số nguyên liệu đó đâu, tiểu thư à.\",\"rating\":9.0},\n  {\"id\":714867,\"suggestedTranslation\":\"Tôi không chắc về một số nguyên liệu đó đâu, tiểu thư à.\",\"rating\":9.0},\n  {\"id\":714868,\"suggestedTranslation\":\"Dành cho tôi sao?\",\"rating\":9.0},\n  {\"id\":714869,\"suggestedTranslation\":\"Tôi có thể giấu vài cái bánh quy bên trong cho lũ trẻ.\",\"rating\":9.0},\n  {\"id\":714870,\"suggestedTranslation\":\"Lớp kem trang trí trên mấy mái nhà kia - thật tuyệt vời!\",\"rating\":9.0},\n  {\"id\":714871,\"suggestedTranslation\":\"Tao bắt được mày đấy, Lợn Bánh Gừng!\",\"rating\":9.0},\n  {\"id\":714872,\"suggestedTranslation\":\"Trông thì ngọt ngào, nhưng hành động lại chua ngoa!\",\"rating\":9.0},\n  {\"id\":714873,\"suggestedTranslation\":\"Làm tôi nhớ đến mấy bức tượng băng đá trong phòng ăn của tàu.\",\"rating\":9.0},\n  {\"id\":714874,\"suggestedTranslation\":\"Thật tốt để thái và cắt hạt lựu!\",\"rating\":9.0},\n  {\"id\":714875,\"suggestedTranslation\":\"Tôi thích đồ trang trí của mình ít... đâm chọc hơn một chút.\",\"rating\":9.0},\n  {\"id\":714876,\"suggestedTranslation\":\"Tôi nghĩ mình thích nó đấy.\",\"rating\":9.0},\n  {\"id\":714877,\"suggestedTranslation\":\"Ngủ ngon nhé, bạn tôi ơi.\",\"rating\":9.0},\n  {\"id\":714878,\"suggestedTranslation\":\"Thật là phí phạm.\",\"rating\":9.0},\n  {\"id\":714879,\"suggestedTranslation\":\"Đẹp thật đấy!\",\"rating\":9.0},\n  {\"id\":714880,\"suggestedTranslation\":\"Trông giống kẹo cao su, nếm lại giống sàn nhà.\",\"rating\":9.0},\n  {\"id\":714881,\"suggestedTranslation\":\"Một món ngon bé nhỏ.\",\"rating\":9.0},\n  {\"id\":714882,\"suggestedTranslation\":\"Công thức đặc biệt của riêng tôi!\",\"rating\":9.0},\n  {\"id\":714883,\"suggestedTranslation\":\"Ha! Ngươi chẳng còn chút xiên nướng nào để mà dùng nữa rồi!\",\"rating\":9.0},\n  {\"id\":714884,\"suggestedTranslation\":\"Tôi rất tiếc về chiếc sừng của bạn, bạn tôi ơi.\",\"rating\":9.0},\n  {\"id\":714885,\"suggestedTranslation\":\"Thực ra bạn là một linh hồn khá hiền lành đấy chứ, phải không bạn tôi ơi?\",\"rating\":9.0},\n  {\"id\":714886,\"suggestedTranslation\":\"Lạy chúa, đừng xiên tôi mà!\",\"rating\":9.0},\n  {\"id\":714887,\"suggestedTranslation\":\"Tôi suýt nữa thì bị cái thứ đó đâm xuyên qua người!\",\"rating\":9.0},\n  {\"id\":714888,\"suggestedTranslation\":\"Tôi có thể làm cái này thành phô mai không nhỉ?\",\"rating\":9.0},\n  {\"id\":714889,\"suggestedTranslation\":\"Ồ. Trước giờ tôi chưa bao giờ thấy mình hợp thời trang cả!\",\"rating\":9.0},\n  {\"id\":714890,\"suggestedTranslation\":\"Một chiếc rìu bằng vàng!\",\"rating\":9.0},\n  {\"id\":714891,\"suggestedTranslation\":\"Trông đẹp phết.\",\"rating\":9.0},\n  {\"id\":714892,\"suggestedTranslation\":\"Một chiếc nĩa vàng cho người khổng lồ, phải không?\",\"rating\":9.0},\n  {\"id\":714893,\"suggestedTranslation\":\"Sáng loáng.\",\"rating\":9.0},\n  {\"id\":714894,\"suggestedTranslation\":\"Dụng cụ tốt thực sự tạo nên sự khác biệt đấy.\",\"rating\":9.0},\n  {\"id\":714895,\"suggestedTranslation\":\"Vàng như lòng đỏ trứng, tỏa sáng rực rỡ!\",\"rating\":9.0},\n  {\"id\":714896,\"suggestedTranslation\":\"Có một con ngỗng bị vặt lông ở đây.\",\"rating\":9.0},\n  {\"id\":714897,\"suggestedTranslation\":\"Tôi có thể xin ít phân bón ở đây được không?\",\"rating\":9.0},\n  {\"id\":714898,\"suggestedTranslation\":\"Tôi không bao giờ để cháy thứ gì trong bếp cả.\",\"rating\":9.0},\n  {\"id\":714899,\"suggestedTranslation\":\"Nó đang cảm thấy không khỏe đấy.\",\"rating\":9.0},\n  {\"id\":714900,\"suggestedTranslation\":\"Nó bắt đầu trông có vẻ hơi kì cục rồi.\",\"rating\":9.0},\n  {\"id\":714901,\"suggestedTranslation\":\"Một nguyên liệu phổ biến cho sự thành công quanh đây.\",\"rating\":9.0},\n  {\"id\":714902,\"suggestedTranslation\":\"Đã bị vặt sạch sẽ!\",\"rating\":9.0},\n  {\"id\":714903,\"suggestedTranslation\":\"Quá nóng đối với bạn rồi.\",\"rating\":9.0},\n  {\"id\":714904,\"suggestedTranslation\":\"Cậu ta có vẻ là một linh hồn hiền lành.\",\"rating\":9.0},\n  {\"id\":714905,\"suggestedTranslation\":\"Chút súp ngon lành có làm bạn thấy khá hơn không?\",\"rating\":9.0},\n  {\"id\":714906,\"suggestedTranslation\":\"Nó có vẻ không nguy hiểm lắm.\",\"rating\":9.0},\n  {\"id\":714907,\"suggestedTranslation\":\"Có chút bóng râm vẫn hơn là không có gì.\",\"rating\":9.0},\n  {\"id\":714908,\"suggestedTranslation\":\"Nó đang thiếu chiếc chìa khóa chính.\",\"rating\":9.0},\n  {\"id\":714909,\"suggestedTranslation\":\"Nó đã đầy rồi!\",\"rating\":9.0},\n  {\"id\":714910,\"suggestedTranslation\":\"Đậm đà và ngập tràn hương vị.\",\"rating\":9.0},\n  {\"id\":714911,\"suggestedTranslation\":\"Để xây dựng khéo léo hơn!\",\"rating\":9.0},\n  {\"id\":714912,\"suggestedTranslation\":\"À, một điểm thu hút hiếm có!\",\"rating\":9.0},\n  {\"id\":714913,\"suggestedTranslation\":\"Miễn là nó không chớp mắt.\",\"rating\":9.0},\n  {\"id\":714914,\"suggestedTranslation\":\"Chắc tôi không nên dùng cái này để khuấy súp đâu.\",\"rating\":9.0},\n  {\"id\":714915,\"suggestedTranslation\":\"Đừng chen chúc mấy cây nấm chứ.\",\"rating\":9.0},\n  {\"id\":714916,\"suggestedTranslation\":\"Có thể phết thêm một lớp bơ và hẹ tây...\",\"rating\":9.0},\n  {\"id\":714917,\"suggestedTranslation\":\"Nấm rơm nhỏ bé!\",\"rating\":9.0},\n  {\"id\":714918,\"suggestedTranslation\":\"Nó tự ăn chính mình à...?\",\"rating\":9.0},\n  {\"id\":714919,\"suggestedTranslation\":\"Tôi đang vô cùng háo hức chờ nó mọc lại!\",\"rating\":9.0},\n  {\"id\":714920,\"suggestedTranslation\":\"Trời ạ, đẹp làm sao!\",\"rating\":9.0},\n  {\"id\":714921,\"suggestedTranslation\":\"Trời ạ, đẹp làm sao!\",\"rating\":9.0},\n  {\"id\":714922,\"suggestedTranslation\":\"Gọi là Greatamole thì đúng hơn!\",\"rating\":9.0},\n  {\"id\":714923,\"suggestedTranslation\":\"Phân của loài dơi.\",\"rating\":9.0},\n  {\"id\":714924,\"suggestedTranslation\":\"Bùm!\",\"rating\":9.0},\n  {\"id\":714925,\"suggestedTranslation\":\"Thỉnh thoảng ăn mấy thứ này cũng khá thú vị đấy.\",\"rating\":9.0},\n  {\"id\":714926,\"suggestedTranslation\":\"Mấy đứa trẻ sẽ thích nó hơn tôi đấy.\",\"rating\":9.0},\n  {\"id\":714927,\"suggestedTranslation\":\"Có rất ít thứ tôi yêu thích hơn sô-cô-la sữa.\",\"rating\":9.0},\n  {\"id\":714928,\"suggestedTranslation\":\"Tôi chắc là nó ngon hơn vẻ bề ngoài của nó.\",\"rating\":9.0},\n  {\"id\":714929,\"suggestedTranslation\":\"Nó hơi ngọt quá so với khẩu vị của tôi.\",\"rating\":9.0},\n  {\"id\":714930,\"suggestedTranslation\":\"Nó dính vào răng tôi, nhưng hoàn toàn bõ công.\",\"rating\":9.0},\n  {\"id\":714931,\"suggestedTranslation\":\"Theo ý kiến chuyên môn của tôi thì vẫn có những loại kẹo ngon hơn.\",\"rating\":9.0},\n  {\"id\":714932,\"suggestedTranslation\":\"Cho thêm chút bơ và muối thì tuyệt.\",\"rating\":9.0},\n  {\"id\":714933,\"suggestedTranslation\":\"Kẹo cam thảo chỉ dành cho những khẩu vị tinh tế nhất thôi.\",\"rating\":9.0},\n  {\"id\":714934,\"suggestedTr