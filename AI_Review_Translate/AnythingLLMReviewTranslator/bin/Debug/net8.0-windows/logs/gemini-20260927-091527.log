            "text": "[\n  {\"id\":715480,\"suggestedTranslation\":\"Ai mà bình thường lại muốn châm ngòi cho NHIỀU cơn ác mộng hơn chứ?\",\"rating\":9.0},\n  {\"id\":715481,\"suggestedTranslation\":\"Mon dieu, lớp vỏ đang nứt ra kìa!\",\"rating\":9.0},\n  {\"id\":715482,\"suggestedTranslation\":\"Tôi bị điên hay cái ánh sáng này chẳng giúp ích gì cho hoàn cảnh của tôi vậy?\",\"rating\":9.0},\n  {\"id\":715483,\"suggestedTranslation\":\"Thực ra nó không đáng sợ như cái tên của nó đâu.\",\"rating\":9.0},\n  {\"id\":715484,\"suggestedTranslation\":\"Có vẻ như mọi thứ vẫn ổn.\",\"rating\":9.0},\n  {\"id\":715485,\"suggestedTranslation\":\"Cơn ác mộng này sắp kết thúc rồi!\",\"rating\":9.0},\n  {\"id\":715486,\"suggestedTranslation\":\"Vô phép thuật.\",\"rating\":9.0},\n  {\"id\":715487,\"suggestedTranslation\":\"Giữ vững nào.\",\"rating\":9.0},\n  {\"id\":715488,\"suggestedTranslation\":\"Đang dịu dần.\",\"rating\":9.0},\n  {\"id\":715489,\"suggestedTranslation\":\"Tôi cảm thấy có chút phép thuật sắp xuất hiện!\",\"rating\":9.0},\n  {\"id\":715490,\"suggestedTranslation\":\"Giờ phép thuật!\",\"rating\":9.0},\n  {\"id\":715491,\"suggestedTranslation\":\"Tôi thấy tràn đầy điện năng!\",\"rating\":9.0},\n  {\"id\":715492,\"suggestedTranslation\":\"Thứ này chém mượt như mơ!\",\"rating\":9.0},\n  {\"id\":715493,\"suggestedTranslation\":\"Thật tò mò làm sao.\",\"rating\":9.0},\n  {\"id\":715494,\"suggestedTranslation\":\"Thêm một chút axit vào hỗn hợp đã tạo ra những khối này.\",\"rating\":9.0},\n  {\"id\":715495,\"suggestedTranslation\":\"Một lớp phủ mặn cho các dụng cụ khác nhau của tôi.\",\"rating\":9.0},\n  {\"id\":715496,\"suggestedTranslation\":\"Có lẽ mặt đất nên được rắc một lớp muối để tạo kết cấu.\",\"rating\":9.0},\n  {\"id\":715497,\"suggestedTranslation\":\"Tốt nhất là tôi nên đảm bảo cây trồng của chúng ta được nuôi dưỡng tốt với các chất dinh dưỡng phù hợp!\",\"rating\":9.0},\n  {\"id\":715498,\"suggestedTranslation\":\"Một cây mái chèo.\",\"rating\":9.0},\n  {\"id\":715499,\"suggestedTranslation\":\"Một cây mái chèo đẹp và nhẹ.\",\"rating\":9.0},\n  {\"id\":715500,\"suggestedTranslation\":\"Nó cắt xuyên qua nước và kẻ thù mượt như bơ!\",\"rating\":9.0},\n  {\"id\":715501,\"suggestedTranslation\":\"Chẳng có gì ngoài bùn cả.\",\"rating\":9.0},\n  {\"id\":715502,\"suggestedTranslation\":\"Tôi có thể nghỉ ngơi một chút đây.\",\"rating\":9.0},\n  {\"id\":715503,\"suggestedTranslation\":\"À, tôi đã hy vọng thứ gì đó ngon hơn cơ.\",\"rating\":9.0},\n  {\"id\":715504,\"suggestedTranslation\":\"Đơn giản, không phức tạp, hoàn hảo!\",\"rating\":9.0},\n  {\"id\":715505,\"suggestedTranslation\":\"Lông vũ hóa ra lại rất hữu ích để câu cá đấy!\",\"rating\":9.0},\n  {\"id\":715506,\"suggestedTranslation\":\"Lông vũ hóa ra lại rất hữu ích để câu cá đấy!\",\"rating\":9.0},\n  {\"id\":715507,\"suggestedTranslation\":\"Đôi khi việc câu cá đòi hỏi sự nhẹ nhàng.\",\"rating\":9.0},\n  {\"id\":715508,\"suggestedTranslation\":\"Không tệ chút nào!\",\"rating\":9.0},\n  {\"id\":715509,\"suggestedTranslation\":\"Có phao câu thì việc câu cá có thể sẽ dễ dàng hơn đấy.\",\"rating\":9.0},\n  {\"id\":715510,\"suggestedTranslation\":\"Thế giới này có thể tôi luyện những người giỏi nhất trong chúng ta, bạn của tôi ơi.\",\"rating\":9.0},\n  {\"id\":715511,\"suggestedTranslation\":\"Lông vũ hóa ra lại rất hữu ích để câu cá đấy!\",\"rating\":9.0},\n  {\"id\":715512,\"suggestedTranslation\":\"Lông vũ hóa ra lại rất hữu ích để câu cá đấy!\",\"rating\":9.0},\n  {\"id\":715513,\"suggestedTranslation\":\"Tôi tốt nhất nên xử lý cái này thật cẩn thận.\",\"rating\":9.0},\n  {\"id\":715514,\"suggestedTranslation\":\"Một món ăn nặng cho một con cá nặng ký, phải không?\",\"rating\":9.0},\n  {\"id\":715515,\"suggestedTranslation\":\"Đầu bếp phải có nguyên liệu tươi, dù trời mưa hay nắng!\",\"rating\":9.0},\n  {\"id\":715516,\"suggestedTranslation\":\"Một con mồi lạnh ngắt, mua từ một chủ cửa hàng băng giá.\",\"rating\":9.0},\n  {\"id\":715517,\"suggestedTranslation\":\"Không hấp dẫn cho lắm, nhưng lũ cá có vẻ thích nó.\",\"rating\":9.0},\n  {\"id\":715518,\"suggestedTranslation\":\"Không hấp dẫn cho lắm, nhưng lũ cá có vẻ thích nó.\",\"rating\":9.0},\n  {\"id\":715519,\"suggestedTranslation\":\"Không hấp dẫn cho lắm, nhưng lũ cá có vẻ thích nó.\",\"rating\":9.0},\n  {\"id\":715520,\"suggestedTranslation\":\"Không hấp dẫn cho lắm, nhưng lũ cá nhỏ có vẻ thích nó.\",\"rating\":9.0},\n  {\"id\":715521,\"suggestedTranslation\":\"Không hấp dẫn cho lắm, nhưng lũ cá nhỏ có vẻ thích nó.\",\"rating\":9.0},\n  {\"id\":715522,\"suggestedTranslation\":\"Không hấp dẫn cho lắm, nhưng lũ cá nhỏ có vẻ thích nó.\",\"rating\":9.0},\n  {\"id\":715523,\"suggestedTranslation\":\"Tự hỏi không biết những món ngon dưới đáy biển nào đang chờ tôi nhỉ?\",\"rating\":9.0},\n  {\"id\":715524,\"suggestedTranslation\":\"Tôi đã từng làm việc với những nguyên liệu trông tệ hơn thế này.\",\"rating\":9.0},\n  {\"id\":715525,\"suggestedTranslation\":\"Mày sẽ làm nên một bữa tối cá tuyệt vời đấy!\",\"rating\":9.0},\n  {\"id\":715526,\"suggestedTranslation\":\"Hừm, tự hỏi mấy chiếc gai đó có độc không nhỉ.\",\"rating\":9.0},\n  {\"id\":715527,\"suggestedTranslation\":\"À phải rồi, vắt thêm một ít chanh, chút ớt...\",\"rating\":9.0},\n  {\"id\":715528,\"suggestedTranslation\":\"À, thêm chút bơ, chút muối, và mày sẽ vô cùng ngon miệng đấy!\",\"rating\":9.0},\n  {\"id\":715529,\"suggestedTranslation\":\"Vảy của nó có độ óng ánh thật đáng yêu.\",\"rating\":9.0},\n  {\"id\":715530,\"suggestedTranslation\":\"Vảy của nó có độ óng ánh thật đáng yêu.\",\"rating\":9.0},\n  {\"id\":715531,\"suggestedTranslation\":\"Tôi thích dùng cá tươi hơn, chứ không phải cá đông lạnh...\",\"rating\":9.0},\n  {\"id\":715532,\"suggestedTranslation\":\"Thịt của nó có vị ngọt thanh tạo nên một số món ăn thú vị.\",\"rating\":9.0},\n  {\"id\":715533,\"suggestedTranslation\":\"Thứ này vừa đủ làm món khai vị!\",\"rating\":9.0},\n  {\"id\":715534,\"suggestedTranslation\":\"Một miếng thịt nhỏ ngon lành!\",\"rating\":9.0},\n  {\"id\":715535,\"suggestedTranslation\":\"Nhỏ nhưng chắc chắn sẽ rất ngon nếu có các gia vị kèm theo phù hợp!\",\"rating\":9.0},\n  {\"id\":715536,\"suggestedTranslation\":\"Tôi thực sự ước mình có những con cá lớn hơn để câu.\",\"rating\":9.0},\n  {\"id\":715537,\"suggestedTranslation\":\"Con cá này đã được nấu chín chưa vậy?\",\"rating\":9.0},\n  {\"id\":715538,\"suggestedTranslation\":\"Thịt có kết cấu khô và hơi giòn một cách kỳ lạ.\",\"rating\":9.0},\n  {\"id\":715539,\"suggestedTranslation\":\"Nó gần như quá đẹp để ăn... gần như thế.\",\"rating\":9.0},\n  {\"id\":715540,\"suggestedTranslation\":\"Mon dieu! Tôi sẽ là kẻ bị nấu chín mất nếu cứ đứng quá gần!\",\"rating\":9.0},\n  {\"id\":715541,\"suggestedTranslation\":\"Tôi chưa bao giờ bị đồ ăn phun nước bọt vào mặt trước đây.\",\"rating\":9.0},\n  {\"id\":715542,\"suggestedTranslation\":\"Cứ nghĩ rằng chúng có thể mọc xa tận ngoài biển thế này!\",\"rating\":9.0},\n  {\"id\":715543,\"suggestedTranslation\":\"Tôi không nghĩ thứ đó sẽ vừa túi áo tôi đâu...\",\"rating\":9.0},\n  {\"id\":715544,\"suggestedTranslation\":\"Một món quà lưu niệm lớn từ những chuyến hành trình trên biển của chúng ta.\",\"rating\":9.0},\n  {\"id\":715545,\"suggestedTranslation\":\"Thở dài. Lại một dây leo không có nho.\",\"rating\":9.0},\n  {\"id\":715546,\"suggestedTranslation\":\"Có lẽ tôi cứ mặc kệ nó thì hơn.\",\"rating\":9.0},\n  {\"id\":715547,\"suggestedTranslation\":\"Cháy xém rồi.\",\"rating\":9.0},\n  {\"id\":715548,\"suggestedTranslation\":\"Không bao giờ biết mình có thể tìm thấy gì!\",\"rating\":9.0},\n  {\"id\":715549,\"suggestedTranslation\":\"Ai đó đang thực sự khuấy nồi súp lên kìa.\",\"rating\":9.0},\n  {\"id\":715550,\"suggestedTranslation\":\"À, hải sản tươi sống!\",\"rating\":9.0},\n  {\"id\":715551,\"suggestedTranslation\":\"Xem ra tối nay sẽ không có cá cho bữa tối rồi.\",\"rating\":9.0},\n  {\"id\":715552,\"suggestedTranslation\":\"À, ngon! Nó đã được sửa xong rồi.\",\"rating\":9.0},\n  {\"id\":715553,\"suggestedTranslation\":\"Tôi thích nấu cá hơn là đi bắt chúng.\",\"rating\":9.0},\n  {\"id\":715554,\"suggestedTranslation\":\"Tôi đã có thể ngửi thấy mùi món cá ăn tối của mình đang ninh trong sốt bơ rồi.\",\"rating\":9.0},\n  {\"id\":715555,\"suggestedTranslation\":\"Tôi sẽ dùng lưới để đánh bắt một bữa tiệc thị soạn cho chúng ta!\",\"rating\":9.0},\n  {\"id\":715556,\"suggestedTranslation\":\"Không gì buồn hơn một cái đĩa trống không!\",\"rating\":9.0},\n  {\"id\":715557,\"suggestedTranslation\":\"Thế là tạm đủ cho bây giờ.\",\"rating\":9.0},\n  {\"id\":715558,\"suggestedTranslation\":\"Ăn đi nào, những người bạn cá của tôi! Vẫn còn rất nhiều ở chỗ đó đấy.\",\"rating\":9.0},\n  {\"id\":715559,\"suggestedTranslation\":\"Không gì buồn hơn một cái đĩa trống không!\",\"rating\":9.0},\n  {\"id\":715560,\"suggestedTranslation\":\"Thế là tạm đủ cho bây giờ.\",\"rating\":9.0},\n  {\"id\":715561,\"suggestedTranslation\":\"Ăn đi nào, những người bạn cá của tôi! Vẫn còn rất nhiều ở chỗ đó đấy.\",\"rating\":9.0},\n  {\"id\":715562,\"suggestedTranslation\":\"Thật là ồn ào!\",\"rating\":9.0},\n  {\"id\":715563,\"suggestedTranslation\":\"Có nhiều công dụng như số lớp của nó vậy.\",\"rating\":9.0},\n  {\"id\":715564,\"suggestedTranslation\":\"Tôi thích dùng việc này cho mục đích tốt hơn.\",\"rating\":9.0},\n  {\"id\":715565,\"suggestedTranslation\":\"Bạn không bao giờ có thể có đủ hành cả.\",\"rating\":9.0},\n  {\"id\":715566,\"suggestedTranslation\":\"Nguyên liệu tươi ngon nào sẽ mọc lên từ những thứ này đây?\",\"rating\":9.0},\n  {\"id\":715567,\"suggestedTranslation\":\"Nó lấp lánh giống như đôi mắt của maman.\",\"rating\":9.0},\n  {\"id\":715568,\"suggestedTranslation\":\"Nó làm tôi cảm thấy thật kỳ diệu.\",\"rating\":9.0},\n  {\"id\":715569,\"suggestedTranslation\":\"Có mặt phút trước, biến mất phút sau!\",\"rating\":9.0},\n  {\"id\":715570,\"suggestedTranslation\":\"Tôi nhớ cam quá...\",\"rating\":9.0},\n  {\"id\":715571,\"suggestedTranslation\":\"Con mắt này sẽ canh chừng mọi thứ.\",\"rating\":9.0},\n  {\"id\":715572,\"suggestedTranslation\":\"Khi tôi cầm nó, nó làm cho thế giới có cảm giác như... đang trôi đi rất nhanh.\",\"rating\":9.0},\n  {\"id\":715573,\"suggestedTranslation\":\"Thịt của nó chắc chắn vừa có mùi cá vừa có mùi thú rừng.\",\"rating\":9.0},\n  {\"id\":715574,\"suggestedTranslation\":\"Tôi chẳng thấy gì ở đó cả.\",\"rating\":9.0},\n  {\"id\":715575,\"suggestedTranslation\":\"Chúng ta có nên đột kích cái phòng đựng thức ăn này không nhỉ?\",\"rating\":9.0},\n  {\"id\":715576,\"suggestedTranslation\":\"Chúng ta đang bị ướt sũng rồi đây.\",\"rating\":9.0},\n  {\"id\":715577,\"suggestedTranslation\":\"C'est dommage, đây không phải là một cái cây ra quả.\",\"rating\":9.0},\n  {\"id\":715578,\"suggestedTranslation\":\"Chỉ là một bé con nhỏ xíu thôi.\",\"rating\":9.0},\n  {\"id\":715579,\"suggestedTranslation\":\"Nó sẽ làm thành một chiếc đĩa đựng thức ăn tuyệt vời đấy.\",\"rating\":9.0},\n  {\"id\":715580,\"suggestedTranslation\":\"Nó chỉ vừa mới bắt đầu lớn lên thôi.\",\"rating\":9.0},\n  {\"id\":715581,\"suggestedTranslation\":\"Nó khá là tráng lệ đấy.\",\"rating\":9.0},\n  {\"id\":715582,\"suggestedTranslation\":\"Một món ăn truyền thống của Ý trong dịp Giáng sinh.\",\"rating\":9.0},\n  {\"id\":715583,\"suggestedTranslation\":\"Thứ này sẽ như âm nhạc rót vào tai ai đó cho xem.\",\"rating\":9.0},\n  {\"id\":715584,\"suggestedTranslation\":\"Tôi có thể viết các công thức nấu ăn của mình lên đây.\",\"rating\":9.0},\n  {\"id\":715585,\"suggestedTranslation\":\"Một chiếc bánh Pavlova hoàn hảo!\",\"rating\":9.0},\n  {\"id\":715586,\"suggestedTranslation\":\"Quả là một quý gentleman không lịch sự cho lắm.\",\"rating\":9.0},\n  {\"id\":715587,\"suggestedTranslation\":\"Một vị khách cực ngầu.\",\"rating\":9.0},\n  {\"id\":715588,\"suggestedTranslation\":\"Mmm, hương thơm đó kìa!\",\"rating\":9.0},\n  {\"id\":715589,\"suggestedTranslation\":\"Nó sắp hỏng đến nơi rồi kìa.\",\"rating\":9.0},\n  {\"id\":715590,\"suggestedTranslation\":\"Thịt đang chuyển màu rồi!\",\"rating\":9.0},\n  {\"id\":715591,\"suggestedTranslation\":\"Cuối cùng thì tôi cũng có thể làm ra loại sốt cay nổi tiếng của mình rồi!\",\"rating\":9.0},\n  {\"id\":715592,\"suggestedTranslation\":\"Tôi thích làm cho các món ăn của mình bùng nổ hương vị!\",\"rating\":9.0},\n  {\"id\":715593,\"suggestedTranslation\":\"Việc nướng lên thực sự làm nổi bật hương vị.\",\"rating\":9.0},\n  {\"id\":715594,\"suggestedTranslation\":\"Quả ớt thật ấn tượng làm sao!\",\"rating\":9.0},\n  {\"id\":715595,\"suggestedTranslation\":\"Nguyên liệu tươi ngon nào sẽ mọc lên từ thứ này đây?\",\"rating\":9.0},\n  {\"id\":715596,\"suggestedTranslation\":\"Một anh bạn có gu thưởng thức tuyệt vời.\",\"rating\":9.0},\n  {\"id\":715597,\"suggestedTranslation\":\"Có ai muốn tôi làm cho mát người không nào?\",\"rating\":9.0},\n  {\"id\":715598,\"suggestedTranslation\":\"Chín quá tay rồi.\",\"rating\":9.0},\n  {\"id\":715599,\"suggestedTranslation\":\"Tôi nên tặng nó thứ gì đó đặc biệt mới được.\",\"rating\":9.0},\n  {\"id\":715600,\"suggestedTranslation\":\"Tôi nên bày tỏ sự biết ơn một chút. Tôi đã ăn rất nhiều đùi gà tây rồi đấy.\",\"rating\":9.0},\n  {\"id\":715601,\"suggestedTranslation\":\"Mmmmm, những chiếc túi chứa đầy niềm vui bùng nổ vị giác!\",\"rating\":9.0},\n  {\"id\":715602,\"suggestedTranslation\":\"Tuyệt vời khi trộn salad.\",\"rating\":9.0},\n  {\"id\":715603,\"suggestedTranslation\":\"Một nguyên liệu tuyệt hảo!\",\"rating\":9.0},\n  {\"id\":715604,\"suggestedTranslation\":\"Không tuyệt lắm khi trộn salad.\",\"rating\":9.0},\n  {\"id\":715605,\"suggestedTranslation\":\"Một nguyên liệu tuyệt hảo!\",\"rating\":9.0},\n  {\"id\":715606,\"suggestedTranslation\":\"Cái cây này được làm bằng đá.\",\"rating\":9.0},\n  {\"id\":715607,\"suggestedTranslation\":\"Hừm. Không an toàn để làm két sắt đâu đấy!\",\"rating\":9.0},\n  {\"id\":715608,\"suggestedTranslation\":\"Một bài hát có thể gợi lại rất nhiều ký ức. Có lẽ là quá nhiều rồi.\",\"rating\":