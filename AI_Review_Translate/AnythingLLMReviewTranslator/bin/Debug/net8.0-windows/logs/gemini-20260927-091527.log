\n  },\n  {\n    \"id\": 716712,\n    \"suggestedTranslation\": \"Ta không thấy có gì bất thường ở đây cả.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 716713,\n    \"suggestedTranslation\": \"Sâu!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 716714,\n    \"suggestedTranslation\": \"Đó không phải là cái hố lót răng bình thường trên mặt đất đâu!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 716715,\n    \"suggestedTranslation\": \"Mình thực sự định làm thế này sao?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 716716,\n    \"suggestedTranslation\": \"Những thứ này còn có thể trông tệ hơn nữa sao?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 716717,\n    \"suggestedTranslation\": \"Tỏa ra hương vị tuyệt vời.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 716718,\n    \"suggestedTranslation\": \"Không tươi lắm, nhưng ta đoán hương vị vẫn ổn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 716719,\n    \"suggestedTranslation\": \"Ta không thấy có gì bất thường ở đây cả.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 716720,\n    \"suggestedTranslation\": \"Cậu sẽ chẳng kết bạn được với cách đó đâu, %s.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 716721,\n    \"suggestedTranslation\": \"Lửa không an toàn cho cậu đâu, %s.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 716722,\n    \"suggestedTranslation\": \"Xin chào, %s!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 716723,\n    \"suggestedTranslation\": \"Đợi đã, bạn tôi ơi, ta sẽ tìm một trái tim.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 716724,\n    \"suggestedTranslation\": \"Ta không bao giờ có thể làm bạn với một sinh vật như thế.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 716725,\n    \"suggestedTranslation\": \"%s là một củ rau nhỏ bụng tốt.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 716726,\n    \"suggestedTranslation\": \"Không biết vị của cậu sẽ như thế nào nhỉ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 716727,\n    \"suggestedTranslation\": \"Tôi... nghĩ là mình từ