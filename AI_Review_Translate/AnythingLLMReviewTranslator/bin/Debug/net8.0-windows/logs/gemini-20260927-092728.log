          {
            "text": "[\n  {\"id\":717374,\"suggestedTranslation\":\"Dường như ta có một chiến hữu mới.\",\"rating\":9.0},\n  {\"id\":717375,\"suggestedTranslation\":\"Hiện nguyên hình đi, yêu ma!\",\"rating\":9.0},\n  {\"id\":717376,\"suggestedTranslation\":\"Nghe này! Ánh sáng gì mà quái dị thế!\",\"rating\":9.0},\n  {\"id\":717377,\"suggestedTranslation\":\"Aha! Nơi trú ẩn!\",\"rating\":9.5},\n  {\"id\":717378,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":10.0},\n  {\"id\":717379,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":10.0},\n  {\"id\":717380,\"suggestedTranslation\":\"Không chiếc lồng nào giam giữ được ta!\",\"rating\":9.5},\n  {\"id\":717381,\"suggestedTranslation\":\"Ngươi dám bảo vệ họ hàng rau củ của mình chống lại ta à? Xông lên!\",\"rating\":9.0},\n  {\"id\":717382,\"suggestedTranslation\":\"Một nỗ lực vô ích.\",\"rating\":9.5},\n  {\"id\":717383,\"suggestedTranslation\":\"Lăn nó thêm nữa cũng vô ích thôi.\",\"rating\":9.5},\n  {\"id\":717384,\"suggestedTranslation\":\"Ta suýt chết đuối rồi!\",\"rating\":9.0},\n  {\"id\":717385,\"suggestedTranslation\":\"Lũ ác quỷ quái đản nào thế này?!\",\"rating\":9.0},\n  {\"id\":717386,\"suggestedTranslation\":\"Ta chẳng màng gì đến mấy loại thực vật này hay mớ rau chúng đẻ ra.\",\"rating\":9.0},\n  {\"id\":717387,\"suggestedTranslation\":\"Mọc hay không thì tùy.\",\"rating\":9.5},\n  {\"id\":717388,\"suggestedTranslation\":\"Có lẽ kẻ nào đó yếu đuối mới đi trò chuyện với cây cối, trong lúc ta đi săn.\",\"rating\":9.0},\n  {\"id\":717389,\"suggestedTranslation\":\"Chẳng chiến binh đáng sợ nào lại bị bắt gặp đang nói chuyện với cây cối cả.\",\"rating\":9.0},\n  {\"id\":717390,\"suggestedTranslation\":\"Ta phải đi săn, chứ không phải làm vườn!\",\"rating\":9.5},\n  {\"id\":717391,\"suggestedTranslation\":\"Ái chà, ta bị chích rồi!\",\"rating\":9.0},\n  {\"id\":717392,\"suggestedTranslation\":\"Than ôi, nó chẳng còn nữa rồi.\",\"rating\":9.0},\n  {\"id\":717393,\"suggestedTranslation\":\"Ta sẽ tự mình kết thúc cuộc săn này!\",\"rating\":9.5},\n  {\"id\":717394,\"suggestedTranslation\":\"Người dẫn đường của ta đã ngã xuống, và ta chẳng biết đi hướng nào nữa!\",\"rating\":9.0},\n  {\"id\":717395,\"suggestedTranslation\":\"Nó đang cố thu hút sự chú ý của ta.\",\"rating\":9.5},\n  {\"id\":717396,\"suggestedTranslation\":\"Có kẻ nhanh tay hơn ta rồi!\",\"rating\":9.5},\n  {\"id\":717397,\"suggestedTranslation\":\"Ta cảm thấy có một con thú nhỏ đang lảng vảng...\",\"rating\":9.5},\n  {\"id\":717398,\"suggestedTranslation\":\"Không có con thú nhỏ nào ở khu vực này cả.\",\"rating\":9.5},\n  {\"id\":717399,\"suggestedTranslation\":\"Tiến lên, mãnh thú!!\",\"rating\":9.5},\n  {\"id\":717400,\"suggestedTranslation\":\"Nào chúng ta cùng xuất phát!\",\"rating\":9.5},\n  {\"id\":717401,\"suggestedTranslation\":\"Con quái vật đã quay trở lại nơi nó sinh ra.\",\"rating\":9.5},\n  {\"id\":717402,\"suggestedTranslation\":\"Đừng để con quái vật nuôi ý định trốn thoát.\",\"rating\":9.5},\n  {\"id\":717403,\"suggestedTranslation\":\"Đồ quỷ trơn trượt!\",\"rating\":9.5},\n  {\"id\":717404,\"suggestedTranslation\":\"Công cụ nghèo nàn này không đủ sức để phá vỡ nó.\",\"rating\":9.0},\n  {\"id\":717405,\"suggestedTranslation\":\"Ánh sáng của ta đã tắt ngấm!\",\"rating\":9.5},\n  {\"id\":717406,\"suggestedTranslation\":\"Đừng sợ! Ta đã đến đây!\",\"rating\":9.5},\n  {\"id\":717407,\"suggestedTranslation\":\"Đó không nằm trong kế hoạch.\",\"rating\":9.5},\n  {\"id\":717408,\"suggestedTranslation\":\"Nó không thuộc về thế giới này.\",\"rating\":9.5},\n  {\"id\":717409,\"suggestedTranslation\":\"Kìa! Một binh đoàn hắc ám đến để trợ giúp ta!\",\"rating\":9.0},\n  {\"id\":717410,\"suggestedTranslation\":\"Nguyền rủa thật! Tại sao ta không thể cứ thế mà tiến đến đó?\",\"rating\":9.0},\n  {\"id\":717411,\"suggestedTranslation\":\"Biển cả đã không cướp đi mạng sống của ta ngày hôm nay.\",\"rating\":9.0},\n  {\"id\":717412,\"suggestedTranslation\":\"Con thú nhỏ đang cận kề cửa tử.\",\"rating\":9.5},\n  {\"id\":717413,\"suggestedTranslation\":\"Kẻ thù này đòi hỏi một thứ mạnh mẽ hơn!\",\"rating\":9.5},\n  {\"id\":717414,\"suggestedTranslation\":\"Cân nặng: {weight}\",\"rating\":10.0},\n  {\"id\":717415,\"suggestedTranslation\":\"Cân nặng: {weight}\\nNhờ các vị thần, ta đã tóm được một con quái vật!\",\"rating\":9.0},\n  {\"id\":717416,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":10.0},\n  {\"id\":717417,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":10.0},\n  {\"id\":717418,\"suggestedTranslation\":\"Ta là một nữ chiến binh ướt sũng.\",\"rating\":9.5},\n  {\"id\":717419,\"suggestedTranslation\":\"Cái này có được tính là đi tắm không nhỉ?\",\"rating\":9.5},\n  {\"id\":717420,\"suggestedTranslation\":\"Đường ngắm của ta không chuẩn xác rồi...\",\"rating\":9.5},\n  {\"id\":717421,\"suggestedTranslation\":\"Nỗ lực của ta chỉ hoài công vô ích.\",\"rating\":9.5},\n  {\"id\":717422,\"suggestedTranslation\":\"Ta cảm thấy sự ban phước của Odin đang ở bên mình!\",\"rating\":9.0},\n  {\"id\":717423,\"suggestedTranslation\":\"Lời chúc phúc đã phai nhạt.\",\"rating\":9.5},\n  {\"id\":717424,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":717425,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":717426,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":717427,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":717428,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":717429,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":717430,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":717431,\"suggestedTranslation\":\"Đó là một cuộc phiêu lưu thật cẩu thả.\",\"rating\":9.5},\n  {\"id\":717432,\"suggestedTranslation\":\"Mặt đất rung chuyển khi kẻ thù đang tiến đến!\",\"rating\":9.5},\n  {\"id\":717433,\"suggestedTranslation\":\"Một tên khổ