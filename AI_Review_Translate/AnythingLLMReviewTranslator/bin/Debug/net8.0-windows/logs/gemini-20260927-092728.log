            "text": "[\n  {\"id\":717074,\"suggestedTranslation\":\"Ta đã nắm rõ cách thức của nó rồi.\",\"rating\":9.0},\n  {\"id\":717075,\"suggestedTranslation\":\"Khỉ thật!\",\"rating\":9.0},\n  {\"id\":717076,\"suggestedTranslation\":\"Hết sạch rồi.\",\"rating\":9.0},\n  {\"id\":717077,\"suggestedTranslation\":\"Chẳng còn một giọt.\",\"rating\":9.0},\n  {\"id\":717078,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":9.0},\n  {\"id\":717079,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":9.0},\n  {\"id\":717080,\"suggestedTranslation\":\"only_used_by_wx78\",\"rating\":9.0},\n  {\"id\":717081,\"suggestedTranslation\":\"Nó không chịu nằm yên!\",\"rating\":9.0},\n  {\"id\":717082,\"suggestedTranslation\":\"Món ăn này cần một cái đĩa khác.\",\"rating\":9.0},\n  {\"id\":717083,\"suggestedTranslation\":\"Ta đã dùng một cái đĩa rồi.\",\"rating\":9.0},\n  {\"id\":717084,\"suggestedTranslation\":\"Ta phải chú ý đến nhịp điệu của đại dương.\",\"rating\":9.0},\n  {\"id\":717085,\"suggestedTranslation\":\"Một chiến binh Viking không bao giờ bỏ cuộc!\",\"rating\":9.0},\n  {\"id\":717086,\"suggestedTranslation\":\"Kiên nhẫn là bạn của chiến binh!\",\"rating\":9.0},\n  {\"id\":717087,\"suggestedTranslation\":\"Đó không phải là việc của một chiến binh!\",\"rating\":9.0},\n  {\"id\":717088,\"suggestedTranslation\":\"Các chiến binh chân chính phải biết chờ đến lượt.\",\"rating\":9.0},\n  {\"id\":717089,\"suggestedTranslation\":\"Sẽ không khôn ngoan nếu chọc giận lũ thú câu cá đâu.\",\"rating\":9.0},\n  {\"id\":717090,\"suggestedTranslation\":\"Nó thuộc về chiến binh sắt.\",\"rating\":9.0},\n  {\"id\":717091,\"suggestedTranslation\":\"Sẽ là bất lịch sự nếu táy máy đồ đạc của đồng minh.\",\"rating\":9.0},\n  {\"id\":717092,\"suggestedTranslation\":\"Ta sẽ không dây dưa vào thứ đó.\",\"rating\":9.0},\n  {\"id\":717093,\"suggestedTranslation\":\"Nó không dành cho ta.\",\"rating\":9.0},\n  {\"id\":717094,\"suggestedTranslation\":\"Ta chỉ cưỡi nó nếu nó là kẻ chiến thắng.\",\"rating\":9.0},\n  {\"id\":717095,\"suggestedTranslation\":\"Hãy để nó ngủ. Rồi ta sẽ xén lông nó sau.\",\"rating\":9.0},\n  {\"id\":717096,\"suggestedTranslation\":\"Không đáng để xén lông.\",\"rating\":9.0},\n  {\"id\":717097,\"suggestedTranslation\":\"Nhưng có gì để tỉa đâu!\",\"rating\":9.0},\n  {\"id\":717098,\"suggestedTranslation\":\"Con quái thú này không thuộc về ta.\",\"rating\":9.0},\n  {\"id\":717099,\"suggestedTranslation\":\"Lại từ đầu nữa sao? Không! Vẫn phải diễn tiếp!\",\"rating\":9.0},\n  {\"id\":717100,\"suggestedTranslation\":\"Hơi tiếc, nó đã thoát khỏi cơn thịnh nộ của ta rồi.\",\"rating\":9.0},\n  {\"id\":717101,\"suggestedTranslation\":\"Khỉ thật! Chỗ đó có người chiếm rồi.\",\"rating\":9.0},\n  {\"id\":717102,\"suggestedTranslation\":\"Lũ quái vật rau củ phải vào vị trí để cuộc đua bắt đầu chứ!\",\"rating\":9.0},\n  {\"id\":717103,\"suggestedTranslation\":\"Nó đã chứa đầy ắp đồ rồi.\",\"rating\":9.0},\n  {\"id\":717104,\"suggestedTranslation\":\"Người bạn kiên trung của ta hiện đang cần dùng thứ đó.\",\"rating\":9.0},\n  {\"id\":717105,\"suggestedTranslation\":\"Ta e rằng nó không nằm ở đó.\",\"rating\":9.0},\n  {\"id\":717106,\"suggestedTranslation\":\"Nó thuộc về chiến binh sắt.\",\"rating\":9.0},\n  {\"id\":717107,\"suggestedTranslation\":\"Sẽ là bất lịch sự nếu táy máy đồ đạc của đồng minh.\",\"rating\":9.0},\n  {\"id\":717108,\"suggestedTranslation\":\"Ta sẽ không dây dưa vào thứ đó.\",\"rating\":9.0},\n  {\"id\":717109,\"suggestedTranslation\":\"Nó không dành cho ta.\",\"rating\":9.0},\n  {\"id\":717110,\"suggestedTranslation\":\"Tri thức đó bị các vị thần cấm đoán.\",\"rating\":9.0},\n  {\"id\":717111,\"suggestedTranslation\":\"Ta đã nắm rõ tri thức đó rồi.\",\"rating\":9.0},\n  {\"id\":717112,\"suggestedTranslation\":\"Đây không phải lúc hay chốn này.\",\"rating\":9.0},\n  {\"id\":717113,\"suggestedTranslation\":\"Đó là một tấm bản đồ không có chỉ dẫn.\",\"rating\":9.0},\n  {\"id\":717114,\"suggestedTranslation\":\"Bản đồ này dành cho vùng đất xa xôi nào đó...\",\"rating\":9.0},\n  {\"id\":717115,\"suggestedTranslation\":\"only_used_by_walter\",\"rating\":9.0},\n  {\"id\":717116,\"suggestedTranslation\":\"Con quái thú đó thuộc về kẻ khác.\",\"rating\":9.0},\n  {\"id\":717117,\"suggestedTranslation\":\"Ta đã chọn được con thú của mình rồi.\",\"rating\":9.0},\n  {\"id\":717118,\"suggestedTranslation\":\"Ta không thể.\",\"rating\":9.0},\n  {\"id\":717119,\"suggestedTranslation\":\"Nó hỏng rồi.\",\"rating\":9.0},\n  {\"id\":717120,\"suggestedTranslation\":\"Nó không phải của ta.\",\"rating\":9.0},\n  {\"id\":717121,\"suggestedTranslation\":\"Không phải lúc có trận chiến cần phải thắng!\",\"rating\":9.0},\n  {\"id\":717122,\"suggestedTranslation\":\"Vì bộ râu của Odin, ta sẽ tìm ra chiếc chìa khóa phù hợp!\",\"rating\":9.0},\n  {\"id\":717123,\"suggestedTranslation\":\"Chìa khóa thực sự chắc ở đâu đó ngoài kia.\",\"rating\":9.0},\n  {\"id\":717124,\"suggestedTranslation\":\"Ta không thể gói thứ không tồn tại!\",\"rating\":9.0},\n  {\"id\":717125,\"suggestedTranslation\":\"Ta e là mình không thể!\",\"rating\":9.0},\n  {\"id\":717126,\"suggestedTranslation\":\"Ta sẽ kiên nhẫn chờ đến lượt mình.\",\"rating\":9.0},\n  {\"id\":717127,\"suggestedTranslation\":\"Biết đâu có cuộc thi khác ở nơi nào đó.\",\"rating\":9.0},\n  {\"id\":717128,\"suggestedTranslation\":\"Hắn trốn ở đâu rồi nhỉ?\",\"rating\":9.0},\n  {\"id\":717129,\"suggestedTranslation\":\"Hắn đang lang thang khắp các vùng đất.\",\"rating\":9.0},\n  {\"id\":717130,\"suggestedTranslation\":\"Hắn đang bận rộn với nhiệm vụ của mình.\",\"rating\":9.0},\n  {\"id\":717131,\"suggestedTranslation\":\"Điều này ta đã biết.\",\"rating\":9.0},\n  {\"id\":717132,\"suggestedTranslation\":\"Nếu ta làm không được, thì chẳng ai làm được!\",\"rating\":9.0},\n  {\"id\":717133,\"suggestedTranslation\":\"Ta có thể quay lại chiến trận được chưa?\",\"rating\":9.0},\n  {\"id\":717134,\"suggestedTranslation\":\"Chiến thắng! Nào, chúng ta đi thôi.\",\"rating\":9.0},\n  {\"id\":717135,\"suggestedTranslation\":\"Hiện hình đi, lũ kẻ thù có cánh!\",\"rating\":9.0},\n  {\"id\":717136,\"suggestedTranslation\":\"Trở lại Thế giới Bên kia, chiến thắng sẽ thuộc về ta!\",\"rating\":9.0},\n  {\"id\":717137,\"suggestedTranslation\":\"Mặt đất đang nổi loạn chống lại chúng ta!\",\"rating\":9.0},\n  {\"id\":717138,\"suggestedTranslation\":\"Đó là bước chân của một người khổng lồ!\",\"rating\":9.0},\n  {\"id\":717139,\"suggestedTranslation\":\"Điều gì đang làm phiền mẹ Gaia vậy?\",\"rating\":9.0},\n  {\"id\":717140,\"suggestedTranslation\":\"Một gói quà, để ngươi không nuốt chửng chúng ta.\",\"rating\":9.0},\n  {\"id\":717141,\"suggestedTranslation\":\"Một cống vật dâng lên ngài, sư tử vĩ đại!\",\"rating\":9.0},\n  {\"id\":717142,\"suggestedTranslation\":\"Hỡi sư tử vĩ đại, hôm nay chúng ta dâng cống vật!\",\"rating\":9.0},\n  {\"id\":717143,\"suggestedTranslation\":\"Các vị thần đã ban cho ta một tầm nhìn... một dạng máy móc nào đó?\",\"rating\":9.0},\n  {\"id\":717144,\"suggestedTranslation\":\"Nó không đủ năng lượng để thực hiện nhiệm vụ.\",\"rating\":9.0},\n  {\"id\":717145,\"suggestedTranslation\":\"Ta đã thấy viễn cảnh này rồi.\",\"rating\":9.0},\n  {\"id\":717146,\"suggestedTranslation\":\"Lũ quái thú sẽ sớm trỗi dậy!\",\"rating\":9.0},\n  {\"id\":717147,\"suggestedTranslation\":\"Các vị thần đang nổi giận!\",\"rating\":9.0},\n  {\"id\":717148,\"suggestedTranslation\":\"Có nguy hiểm đang ẩn giấu trong gió!\",\"rating\":9.0},\n  {\"id\":717149,\"suggestedTranslation\":\"Tinh thần chiến binh trong ta đang bừng sáng!\",\"rating\":9.0},\n  {\"id\":717150,\"suggestedTranslation\":\"Ta đã được ban sức mạnh của Thor!\",\"rating\":9.0},\n  {\"id\":717151,\"suggestedTranslation\":\"Chút nước nôi này có nghĩa gì với một người Viking!\",\"rating\":9.0},\n  {\"id\":717152,\"suggestedTranslation\":\"Ha! Không đòn tấn công nào dọa được ta!\",\"rating\":9.0},\n  {\"id\":717153,\"suggestedTranslation\":\"Giấc ngủ không còn có thể khuất phục ta nữa!\",\"rating\":9.0},\n  {\"id\":717154,\"suggestedTranslation\":\"Tránh ra nào, ta sẽ làm xong việc này trong nháy mắt!\",\"rating\":9.0},\n  {\"id\":717155,\"suggestedTranslation\":\"\\\"Bằng ngón tay cái nhột nhột, điều kỳ quái đang đến đây!\\\"\",\"rating\":9.0},\n  {\"id\":717156,\"suggestedTranslation\":\"\\\"Cái chết, điểm đến tất yếu, sẽ đến khi nó phải đến,\\\" nhưng không phải hôm nay, hỡi các đồng minh của ta!\",\"rating\":9.0},\n  {\"id\":717157,\"suggestedTranslation\":\"\\\"Đồ khốn! Đồ vô lại! Đồ béo ú! Ta sẽ cho ngươi biết tay!\\\"\",\"rating\":9.0},\n  {\"id\":717158,\"suggestedTranslation\":\"oOooOOOo!!\",\"rating\":9.0},\n  {\"id\":717159,\"suggestedTranslation\":\"Lùi lại, lũ sinh vật có ngạnh nhỏ!\",\"rating\":9.0},\n  {\"id\":717160,\"suggestedTranslation\":\"Thuyền của chúng ta bị rò rỉ rồi!\",\"rating\":9.0},\n  {\"id\":717161,\"suggestedTranslation\":\"Một chiến binh Viking không bao giờ bỏ rơi con tàu của mình!\",\"rating\":9.0},\n  {\"id\":717162,\"suggestedTranslation\":\"Urg! Ta phải thuần phục thứ vũ khí cong này mới được.\",\"rating\":9.0},\n  {\"id\":717163,\"suggestedTranslation\":\"Nỗi sợ! Ta đã chiến thắng ngươi!\",\"rating\":9.0},\n  {\"id\":717164,\"suggestedTranslation\":\"Bởi ngọn lửa của Hel!\",\"rating\":9.0},\n  {\"id\":717165,\"suggestedTranslation\":\"Lại đây nào, bé bự!\",\"rating\":9.0},\n  {\"id\":717166,\"suggestedTranslation\":\"\\nTa có thể sửa chữa cái này.\",\"rating\":9.0},\n  {\"id\":717167,\"suggestedTranslation\":\"Ta phải đi tìm thêm nguyên liệu!\",\"rating\":9.0},\n  {\"id\":717168,\"suggestedTranslation\":\"Ta e rằng nó vượt quá khả năng của ta lúc này.\",\"rating\":9.0},\n  {\"id\":717169,\"suggestedTranslation\":\"Ta vẫn chưa học được cách làm ra thứ này.\",\"rating\":9.0},\n  {\"id\":717170,\"suggestedTranslation\":\"Nó quá xa khu lễ hội!\",\"rating\":9.0},\n  {\"id\":717171,\"suggestedTranslation\":\"Đồ khốn! Thứ bị nguyền rủa này không chịu rời bỏ ta!\",\"rating\":9.0},\n  {\"id\":717172,\"suggestedTranslation\":\"Hỡi Odin, tỉnh dậy đi!\",\"rating\":9.0},\n  {\"id\":717173,\"suggestedTranslation\":\"Không! Ngươi không được chần chừ!\",\"rating\":9.0},\n  {\"id\":717174,\"suggestedTranslation\":\"Đẩy nhanh bước chân lên, đồ gặm nhấm!\",\"rating\":9.0},\n  {\"id\":717175,\"suggestedTranslation\":\"Rau củ ngốc nghếch, đường đua ở đằng kia cơ mà!\",\"rating\":9.0},\n  {\"id\":717176,\"suggestedTranslation\":\"Ngươi không thể tin tưởng một củ rau làm nên trò chiến gì đâu.\",\"rating\":9.0},\n  {\"id\":717177,\"suggestedTranslation\":\"Tiến lên, hướng tới chiến thắng!\",\"rating\":9.0},\n  {\"id\":717178,\"suggestedTranslation\":\"Cục đá sẽ mưa xuống từ trên cao!\",\"rating\":9.0},\n  {\"id\":717179,\"suggestedTranslation\":\"Mọi chuyện vẫn ổn.\",\"rating\":9.0},\n  {\"id\":717180,\"suggestedTranslation\":\"Ra đây mau!\",\"rating\":9.0},\n  {\"id\":717181,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":9.0},\n  {\"id\":717182,\"suggestedTranslation\":\"Đồ hèn nhát!\",\"rating\":9.0},\n  {\"id\":717183,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":9.0},\n  {\"id\":717184,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":9.0},\n  {\"id\":717185,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":9.0},\n  {\"id\":717186,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":9.0},\n  {\"id\":717187,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":9.0},\n  {\"id\":717188,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":9.0},\n  {\"id\":717189,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":9.0},\n  {\"id\":717190,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":9.0},\n  {\"id\":717191,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":9.0},\n  {\"id\":717192,\"suggestedTranslation\":\"Brrr! Đồ lông thú của ta đâu rồi!\",\"rating\":9.0},\n  {\"id\":717193,\"suggestedTranslation\":\"Ta e là mình sắp lạc đường rồi!\",\"rating\":9.0},\n  {\"id\":717194,\"suggestedTranslation\":\"Ta là một chiến binh đã được nghỉ ngơi đầy đủ!\",\"rating\":9.0},\n  {\"id\":717195,\"suggestedTranslation\":\"Ta thiếu vật tư rồi.\",\"rating\":9.0},\n  {\"id\":717196,\"suggestedTranslation\":\"Trơn tru để sẵn sàng chiến đấu.\",\"rating\":9.0},\n  {\"id\":717197,\"suggestedTranslation\":\"Một đối thủ xứng tầm đang đến gần.\",\"rating\":9.0},\n  {\"id\":717198,\"suggestedTranslation\":\"Đó là ánh sáng của Valhalla sao?\",\"rating\":9.0},\n  {\"id\":717199,\"suggestedTranslation\":\"Trở lại mức độ đáng sợ bình thường của ta.\",\"rating\":9.0},\n  {\"id\":717200,\"suggestedTranslation\":\"Ta... cho là mình không xứng đáng.\",\"rating\":9.0},\n  {\"id\":717201,\"suggestedTranslation\":\"Thủy triều đã xoay chuyển theo chiều hướng ẩm ướt hơn.\",\"rating\":9.0},\n  {\"id\":717202,\"suggestedTranslation\":\"Ta đã mất lợi thế phòng thủ rồi!\",\"rating\":9.0},\n  {\"id\":717203,\"suggestedTranslation\":\"Ta e là khả năng chống lại giấc ngủ của mình đã suy giảm.\",\"rating\":9.0},\n  {\"id\":717204,\"suggestedTranslation\":\"Ta nghĩ mình đã làm tròn phần việc của mình rồi.\",\"rating\":9.0},\n  {\"id\":717205,\"suggestedTranslation\":\"Hãy biến đi, tai họa quái ác!\",\"rating\":9.0},\n  {\"id\":717206,\"suggestedTranslation\":\"Mặt trời đang lặn, bóng đêm đang chờ ở gần bên.\",\"rating\":9.0},\n  {\"id\":717207,\"suggestedTranslation\":\"Thịt làm tim ta rung lên khúc hoan ca!\",\"rating\":9.0},\n  {\"id\":717208,\"suggestedTranslation\":\"Đây không phải là thức ăn xứng tầm với một chiến binh.\",\"rating\":9.0},\n  {\"id\":717209,\"suggestedTranslation\":\"Ối, ta thấy không khỏe chút nào.\",\"rating\":9.0},\n  {\"id\":717210,\"suggestedTranslation\":\"Ugh, đồ tươi vẫn ngon hơn.\",\"rating\":9.0},\n  {\"id\":717211,\"suggestedTranslation\":\"Đó là thịt cũ rích.\",\"rating\":9.0},\n  {\"id\":717212,\"suggestedTranslation\":\"Thứ ăn này không xứng tầm với một chiến binh.\",\"rating\":9.0},\n  {\"id\":717213,\"suggestedTranslation\":\"Nhiều hơn cả mức đủ để chia sẻ đấy!\",\"rating\":9.0},\n  {\"id\":717214,\"suggestedTranslation\":\"Nó chỉ xoa dịu được trong một khoảnh khắc ngắn ngủi.\",\"rating\":9.0},\n  {\"id\":717215,\"suggestedTranslation\":\"Những tầm nhìn từ Helheim!\",\"rating\":9.0},\n  {\"id\":717216,\"suggestedTranslation\":\"Ta chính là cả một tiểu đoàn.\",\"rating\":9.0},\n  {\"id\":717217,\"suggestedTranslation\":\"Thật là quá mức!\",\"rating\":9.0},\n  {\"id\":717218,\"suggestedTranslation\":\"Hff... Không gì có thể làm chùn bước một chiến binh!\",\"rating\":9.0},\n  {\"id\":717219,\"suggestedTranslation\":\"Hộc... Hộc...\",\"rating\":9.0},\n  {\"id\":717220,\"suggestedTranslation\":\"Chỉ là... chuyện nhỏ...\",\"rating\":9.0},\n  {\"id\":717221,\"suggestedTranslation\":\"Nào... kéo lên...!\",\"rating\":9.0},\n  {\"id\":717222,\"suggestedTranslation\":\"Gnnngh...\",\"rating\":9.0},\n  {\"id\":717223,\"suggestedTranslation\":\"Nhanh nhẹn... như Sleipnir...\",\"rating\":9.0},\n  {\"id\":717224,\"suggestedTranslation\":\"Mạnh mẽ... như Thor...\",\"rating\":9.0},\n  {\"id\":717225,\"suggestedTranslation\":\"Bền bỉ... như Freya...\",\"rating\":9.0},\n  {\"id\":717226,\"suggestedTranslation\":\"Ta sẽ... chiến thắng!\",\"rating\":9.0},\n  {\"id\":717227,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":9.0},\n  {\"id\":717228,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":9.0},\n  {\"id\":717229,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":9.0},\n  {\"id\":717230,\"suggestedTranslation\":\"Và tấm màn nhung khép lại.\",\"rating\":9.0},\n  {\"id\":717231,\"suggestedTranslation\":\"Ta bước vào ánh sáng!\",\"rating\":9.0},\n  {\"id\":717232,\"suggestedTranslation\":\"Tạ ơn Odin, ta được tự do rồi!\",\"rating\":9.0},\n  {\"id\":717233,\"suggestedTranslation\":\"Biến đi, con quỷ dòm ngó. Vào chiến trận thôi!\",\"rating\":9.0},\n  {\"id\":717234,\"suggestedTranslation\":\"Ngươi định trốn chạy trận chiến này sao? Asgard không tôn vinh kẻ hèn!\",\"rating\":9.0},\n  {\"id\":717235,\"suggestedTranslation\":\"Ngươi đã quay lại, giờ hãy kết thúc trận chiến này đi!\",\"rating\":9.0},\n  {\"id\":717236,\"suggestedTranslation\":\"Ta lại làm mất cái quạt khác nữa rồi!\",\"rating\":9.0},\n  {\"id\":717237,\"suggestedTranslation\":\"Chiến binh thì cần quái gì loại tri thức này?\",\"rating\":9.0},\n  {\"id\":717238,\"suggestedTranslation\":\"Ta cảm thấy cơ thể mình đang bốc cháy!\",\"rating\":9.0},\n  {\"id\":717239,\"suggestedTranslation\":\"Cái cây chết tiệt với mấy cái gai lửa! Đấu sòng phẳng với ta xem nào!\",\"rating\":9.0},\n  {\"id\":717240,\"suggestedTranslation\":\"Lời nguyền lửa cháy đã qua đi.\",\"rating\":9.0},\n  {\"id\":717241,\"suggestedTranslation\":\"Đồng minh đang gọi ta kìa!\",\"rating\":9.0},\n  {\"id\":717242,\"suggestedTranslation\":\"Phải, ta từ chối ngươi, Njord!\",\"rating\":9.0},\n  {\"id\":717243,\"suggestedTranslation\":\"Nguyền rủa ngươi, Njord!\",\"rating\":9.0},\n  {\"id\":717244,\"suggestedTranslation\":\"Tạm nghỉ một chút để lấy lại sức mạnh!\",\"rating\":9.0},\n  {\"id\":717245,\"suggestedTranslation\":\"only_used_by_warly\",\"rating\":9.0},\n  {\"id\":717246,\"suggestedTranslation\":\"Tự do! Câu chuyện vẫn còn tiếp diễn!\",\"rating\":9.0},\n  {\"id\":717247,\"suggestedTranslation\":\"only_used_by_wurt\",\"rating\":9.0},\n  {\"id\":717248,\"suggestedTranslation\":\"Chúng đang làm ta phát điên mất...!\",\"rating\":9.0},\n  {\"id\":717249,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":9.0},\n  {\"id\":717250,\"suggestedTranslation\":\"Nó xua tan bóng tối kìa!\",\"rating\":9.0},\n  {\"id\":717251,\"suggestedTranslation\":\"Khả năng phòng thủ trước cơn mưa axit của ta đã cạn kiệt!\",\"rating\":9.0},\n  {\"id\":717252,\"suggestedTranslation\":\"Một lần nữa ngọn lửa lại có thể thiêu đốt lớp da phàm trần của ta.\",\"rating\":9.0},\n  {\"id\":717253,\"suggestedTranslation\":\"Nhanh hơn cả khi ta tự tay cưỡi Hermod Nhanh Nhẹn!\",\"rating\":9.0},\n  {\"id\":717254,\"suggestedTranslation\":\"Khỉ thật! Ta chẳng nhúc nhích được mảy may nào cả!\",\"rating\":9.0},\n  {\"id\":717255,\"suggestedTranslation\":\"Ta là một thợ thủ công xuất sắc.\",\"rating\":9.0},\n  {\"id\":717256,\"suggestedTranslation\":\"Mặt trời gay gắt làm ta mệt mỏi.\",\"rating\":9.0},\n  {\"id\":717257,\"suggestedTranslation\":\"Lũ quái thú đang đến gần...\",\"rating\":9.0},\n  {\"id\":717258,\"suggestedTranslation\":\"Ta thèm một bữa tiệc làm sao!\",\"rating\":9.0},\n  {\"id\":717259,\"suggestedTranslation\":\"Có lẽ ta nên bắt đầu với con mồi dễ hơn.\",\"rating\":9.0},\n  {\"id\":717260,\"suggestedTranslation\":\"Suỵt... Sinh Vật Lạ đang ở gần kìa.\",\"rating\":9.0},\n  {\"id\":717261,\"suggestedTranslation\":\"Ta mất dấu rồi.\",\"rating\":9.0},\n  {\"id\":717262,\"suggestedTranslation\":\"Quá nhiều bùn để có thể lần theo dấu vết.\",\"rating\":9.0},\n  {\"id\":717263,\"suggestedTranslation\":\"Một trận chiến đang chờ ở cuối vết dấu này. Tiến lên!\",\"rating\":9.0},\n  {\"id\":717264,\"suggestedTranslation\":\"Con mồi sẽ không ngờ tới sự hiện diện của ta đâu...\",\"rating\":9.0},\n  {\"id\":717265,\"suggestedTranslation\":\"Bản năng chiến binh mách bảo ta có gì đó không đúng...\",\"rating\":9.0},\n  {\"id\":717266,\"suggestedTranslation\":\"Lại thêm phân cho ngươi nữa nhé?\",\"rating\":9.0},\n  {\"id\":717267,\"suggestedTranslation\":\"Ta mang hết nổi rồi!\",\"rating\":9.0},\n  {\"id\":717268,\"suggestedTranslation\":\"Các chiến hữu, hãy cùng ăn mừng món quà hào phóng này nào!\",\"rating\":9.0},\n  {\"id\":717269,\"suggestedTranslation\":\"Chào ngươi, bé bự nhỏ nhắn!\",\"rating\":9.0},\n  {\"id\":717270,\"suggestedTranslation\":\"Bắt được ngươi rồi nhé, bé thú nhỏ!\",\"rating\":9.0},\n  {\"id\":717271,\"suggestedTranslation\":\"Ngươi hợp làm bàn hoa sân khấu đấy, ta suýt chẳng thấy ngươi đâu!\",\"rating\":9.0},\n  {\"id\":717272,\"suggestedTranslation\":\"Ngươi chơi rất tốt, nhưng vẫn chưa đủ đâu!\",\"rating\":9.0},\n  {\"id\":717273,\"suggestgredTranslation\":\"Ngươi không thoát khỏi đôi mắt tinh tường của ta đâu!\"