g\":9.5},\n  {\"id\":717453,\"suggestedTranslation\":\"Ngươi muốn gì vậy, bóng ma?\",\"rating\":9.5},\n  {\"id\":717454,\"suggestedTranslation\":\"Ngươi muốn gì vậy, bóng ma?\",\"rating\":9.5},\n  {\"id\":717455,\"suggestedTranslation\":\"Ngươi muốn gì vậy, bóng ma?\",\"rating\":9.5},\n  {\"id\":717456,\"suggestedTranslation\":\"Ngươi muốn gì vậy, bóng ma?\",\"rating\":9.5},\n  {\"id\":717457,\"suggestedTranslation\":\"Ngươi muốn gì vậy, bóng ma?\",\"rating\":9.5},\n  {\"id\":717458,\"suggestedTranslation\":\"Ngươi muốn gì vậy, bóng ma?\",\"rating\":9.5},\n  {\"id\":717459,\"suggestedTranslation\":\"Cho ta à?\",\"rating\":9.5},\n  {\"id\":717460,\"suggestedTranslation\":\"Nó đang đợi cái gì thế nhỉ?!\",\"rating\":9.5},\n  {\"id\":717461,\"suggestedTranslation\":\"Có lẽ tốt nhất chúng ta nên đường ai nấy đi...\",\"rating\":9.5},\n  {\"id\":717462,\"suggestedTranslation\":\"Giác quan chiến binh của ta bảo rằng không nên dây dưa với nó.\",\"rating\":9.0},\n  {\"id\":717463,\"suggestedTranslation\":\"Nó đang tích tụ sức mạnh.\",\"rating\":9.5},\n  {\"id\":717464,\"suggestedTranslation\":\"Thứ phép thuật kỳ lạ gì thế này!\",\"rating\":9.5},\n  {\"id\":717465,\"suggestedTranslation\":\"Cho ta à?\",\"rating\":9.5},\n  {\"id\":717466,\"suggestedTranslation\":\"Nó đang làm gì thế nhỉ?\",\"rating\":9.5},\n  {\"id\":717467,\"suggestedTranslation\":\"Có điềm dữ đang kéo đến.\",\"rating\":9.5},\n  {\"id\":717468,\"suggestedTranslation\":\"Côn trùng hèn hạ, ngươi dám bắt chước bước đi của ta à?\",\"rating\":9.0},\n  {\"id\":717469,\"suggestedTranslation\":\"Con côn trùng được bất tử hóa, nhưng lại bất động.\",\"rating\":9.5},\n  {\"id\":717470,\"suggestedTranslation\":\"Sao chúng ta còn chần chừ gì nữa? Cuộc chiến đang chờ kìa!\",\"rating\":9.0},\n  {\"id\":717471,\"suggestedTranslation\":\"Những chiến thắng của ta sẽ được ghi nhớ!\",\"rating\":9.5},\n  {\"id\":717472,\"suggestedTranslation\":\"Có một cái cây đang ẩn nấp bên trong đấy.\",\"rating\":9.5},\n  {\"id\":717473,\"suggestedTranslation\":\"Cái cây non đã bị nấu chín rồi.\",\"rating\":9.5},\n  {\"id\":717474,\"suggestedTranslation\":\"Hãy lớn lên thật khỏe mạnh nhé, mấy cành cây nhỏ!\",\"rating\":9.5},\n  {\"id\":717475,\"suggestedTranslation\":\"Cuộc phiêu lưu đang vẫy gọi.\",\"rating\":9.5},\n  {\"id\":717476,\"suggestedTranslation\":\"Một ân huệ từ Nhà Vô Địch bị đánh bại của Mani.\",\"rating\":9.0},\n  {\"id\":717477,\"suggestedTranslation\":\"Ngay cả một mảnh vỡ đơn lẻ cũng chứa đựng một phần sức mạnh của Mani.\",\"rating\":9.0},\n  {\"id\":717478,\"suggestedTranslation\":\"Nó đang đưa linh hồn của chiến binh này sang cõi tiếp theo.\",\"rating\":9.0},\n  {\"id\":717479,\"suggestedTranslation\":\"Chắc là trận chiến chưa kết thúc nhanh thế chứ nhỉ?\",\"rating\":9.5},\n  {\"id\":717480,\"suggestedTranslation\":\"Mani đã phái chiến binh vĩ đại nhất của ngài đến để khiêu chiến với ta!\",\"rating\":9.0},\n  {\"id\":717481,\"suggestedTranslation\":\"Liệu sức mạnh của ngươi có xứng đáng với sự báo thù mà ngươi tìm kiếm không?\",\"rating\":9.0},\n  {\"id\":717482,\"suggestedTranslation\":\"Nó làm lóa mắt ta với vẻ rực rỡ không gì sánh bằng.\",\"rating\":9.5},\n  {\"id\":717483,\"suggestedTranslation\":\"Chỉ có vậy thôi sao, Nhà Vô Địch?\",\"rating\":9.5},\n  {\"id\":717484,\"suggestedTranslation\":\"Xem ra ngươi quả là một đối thủ xứng tầm...\",\"rating\":9.5},\n  {\"id\":717485,\"suggestedTranslation\":\"Ngươi nghĩ ta bị kẹt ở đây cùng ngươi á? Hừ! Chính ngươi mới là kẻ bị kẹt cùng ta đấy!\",\"rating\":9.0},\n  {\"id\":717486,\"suggestedTranslation\":\"Nào, hãy kết thúc chuyện này đi!\",\"rating\":9.5},\n  {\"id\":717487,\"suggestedTranslation\":\"Xem ra cuối cùng ta cũng đánh bại được nó rồi.\",\"rating\":9.5},\n  {\"id\":717488,\"suggestedTranslation\":\"Hãy cẩn thận, lữ khách! Con quái vật có thể vẫn sẽ trỗi dậy lần nữa!\",\"rating\":9.0},\n  {\"id\":717489,\"suggestedTranslation\":\"Chỉ có kẻ hèn mới đánh gục đối thủ khi họ đang ngủ!\",\"rating\":9.5},\n  {\"id\":717490,\"suggestedTranslation\":\"Tên khổng lồ báng bổ! Odin hẳn sẽ thò con mắt độc nhất của mình ra mà nhìn ngươi đấy!\",\"rating\":9.0},\n  {\"id\":717491,\"suggestedTranslation\":\"Nó màu đỏ, và là một chiến binh. Giống y như ta!\",\"rating\":9.5},\n  {\"id\":717492,\"suggestedTranslation\":\"Nó nhẹ tựa lông hồng nhờ sức mạnh Viking của ta!\",\"rating\":9.5},\n  {\"id\":717493,\"suggestedTranslation\":\"Ta sẽ chế tạo con tàu tuyệt vời nhất vùng này!\",\"rating\":9.5},\n  {\"id\":717494,\"suggestedTranslation\":\"Ta chẳng màng đến loại hoa quả nào, huống chi là thứ cứng như đá!\",\"rating\":9.5},\n  {\"id\":717495,\"suggestedTranslation\":\"Nó đang quằn quại trên mặt đất! Là quả mọng hay quái thú đây?!\",\"rating\":9.0},\n  {\"id\":717496,\"suggestedTranslation\":\"Quả mọng đáng ghét đã ngừng quằn quại rồi.\",\"rating\":9.5},\n  {\"id\":717497,\"suggestedTranslation\":\"Có ngọn lửa cháy bên trong, mà cây vẫn sống sao?\",\"rating\":9.5},\n  {\"id\":717498,\"suggestedTranslation\":\"Nó đã bị đốn hạ.\",\"rating\":9.5},\n  {\"id\":717499,\"suggestedTranslation\":\"Cảnh tượng của nó khiến sống lưng ta lạnh toát.\",\"rating\":9.5},\n  {\"id\":717500,\"suggestedTranslation\":\"Có lẽ thế lại hay.\",\"rating\":9.5},\n  {\"id\":717501,\"suggestedTranslation\":\"Vùng đất này có vẻ hợp với nó đấy.\",\"rating\":9.5},\n  {\"id\":717502,\"suggestedTranslation\":\"Nó có lẽ vẫn sẽ lớn khi mùa khác qua đi.\",\"rating\":9.5},\n  {\"id\":717503,\"suggestedTranslation\":\"Sao ngươi lại nản chí thế? Vùng đất này không hợp với ngươi à?\",\"rating\":9.5},\n  {\"id\":717504,\"suggestedTranslation\":\"Đừng sợ, ta sẽ tìm cho ngươi một nơi để đâm chồi bén rễ.\",\"rating\":9.5},\n  {\"id\":717505,\"suggestedTranslation\":\"Nó phải được trả về với đất mẹ.\",\"rating\":9.5},\n  {\"id\":717506,\"suggestedTranslation\":\"Mấy thứ đồ chế tạo này tốt nhất là nên hữu dụng đấy.\",\"rating\":9.0},\n  {\"id\":717507,\"suggestedTranslation\":\"Cái này đang không hoạt động.\",\"rating\":9.5},\n  {\"id\":717508,\"suggestedTranslation\":\"Sự phản bội nào đã diễn ra ở đây thế này?\",\"rating\":9.5},\n  {\"id\":717509,\"suggestedTranslation\":\"Kho báu mang hào quang bí ẩn.\",\"rating\":9.5},\n  {\"id\":717510,\"suggestedTranslation\":\"Ồ! Ta thích một cuộc săn lùng ra trò.\",\"rating\":9.5},\n  {\"id\":717511,\"suggestedTranslation\":\"Ta đã giật lấy chúng từ biển cả.\",\"rating\":9.5},\n  {\"id\":717512,\"suggestedTranslation\":\"Đó chính là vị sư tử hùng mạnh!\",\"rating\":9.5},\n  {\"id\":717513,\"suggestedTranslation\":\"Chúng ta đã chọc giận nó rồi!\",\"rating\":9.5},\n  {\"id\":717514,\"suggestedTranslation\":\"Sư tử đang mỉm cười với chúng ta.\",\"rating\":9.5},\n  {\"id\":717515,\"suggestedTranslation\":\"Một chiếc mũ giáp có thể thay đổi cả mặt đất dưới chân ta!\",\"rating\":9.5},\n  {\"id\":717516,\"suggestedTranslation\":\"Một món quà cống nạp thích hợp!\",\"rating\":9.5},\n  {\"id\":717517,\"suggestedTranslation\":\"Ta chẳng sợ con thú nào, dù là phàm trần hay kim loại!\",\"rating\":9.5},\n  {\"id\":717518,\"suggestedTranslation\":\"Lính canh này có vẻ đang ngủ quên ở cột gác.\",\"rating\":9.5},\n  {\"id\":717519,\"suggestedTranslation\":\"Ngọn lửa đã chiến thắng tuyệt đối.\",\"rating\":9.5},\n  {\"id\":717520,\"suggestedTranslation\":\"Chắc là nên làm gì đó trong lúc chờ đợi.\",\"rating\":9.5},\n  {\"id\":717521,\"suggestedTranslation\":\"Chắc không lâu nữa đâu!\",\"rating\":9.5},\n  {\"id\":717522,\"suggestedTranslation\":\"Chúng ta có gì đây nhỉ?\",\"rating\":9.5},\n  {\"id\":717523,\"suggestedTranslation\":\"Không có thịt bên trong, nên ta chẳng thèm quan tâm.\",\"rating\":9.5},\n  {\"id\":717524,\"suggestedTranslation\":\"Ngươi sẽ thì thầm sự thật cho ta nghe chứ, giống như Mímir đã làm với Odin?\",\"rating\":9.0},\n  {\"id\":717525,\"suggestedTranslation\":\"Hãy hé lộ bí mật của ngươi cho ta, hỡi cỗ máy kỳ lạ!\",\"rating\":9.5},\n  {\"id\":717526,\"suggestedTranslation\":\"Nơi này đã bị lãng quên từ lâu.\",\"rating\":9.5},\n  {\"id\":717527,\"suggestedTranslation\":\"Những con người này từng tôn sùng Mani.\",\"rating\":9.5},\n  {\"id\":717528,\"suggestedTranslation\":\"Hay là ta cứ đâm nó một nhát nhỉ?\",\"rating\":9.5},\n  {\"id\":717529,\"suggestedTranslation\":\"Nếu đây là một cánh cổng, thì nó đã bị khóa chặt rồi.\",\"rating\":9.5},\n  {\"id\":717530,\"suggestedTranslation\":\"Lại một cánh cổng giữa các thế giới nữa á?\",\"rating\":9.5},\n  {\"id\":717531,\"suggestedTranslation\":\"Nó gọi xuống một bảng hiệu từ chính Mani!\",\"rating\":9.5},\n  {\"id\":717532,\"suggestedTranslation\":\"Nhiệm vụ của nó đã hoàn thành.\",\"rating\":9.5},\n  {\"id\":717533,\"suggestedTranslation\":\"Đó chính là cỗ máy trong tầm nhìn của ta.\",\"rating\":9.5},\n  {\"id\":717534,\"suggestedTranslation\":\"Những cổ văn này quá xa lạ với ta.\",\"rating\":9.5},\n  {\"id\":717535,\"suggestedTranslation\":\"Có lẽ chúng đang kể về những trận chiến cổ xưa.\",\"rating\":9.5},\n  {\"id\":717536,\"suggestedTranslation\":\"Những cổ văn này quá xa lạ với ta.\",\"rating\":9.5},\n  {\"id\":717537,\"suggestedTranslation\":\"Có lẽ chúng đang kể về những trận chiến cổ xưa.\",\"rating\":9.5},\n  {\"id\":717538,\"suggestedTranslation\":\"Những cổ văn này quá xa lạ với ta.\",\"rating\":9.5},\n  {\"id\":717539,\"suggestedTranslation\":\"Nó canh gác những sảnh đường này.\",\"rating\":9.5},\n  {\"id\":717540,\"suggestedTranslation\":\"Nó đang nghỉ ngơi.\",\"rating\":9.5},\n  {\"id\":717541,\"suggestedTranslation\":\"Ngươi đi đâu đấy, hỡi ngọn lửa ma trơi?\",\"rating\":9.5},\n  {\"id\":717542,\"suggestedTranslation\":\"Nó đòi hỏi một vật tế lễ.\",\"rating\":9.5},\n  {\"id\":717543,\"suggestedTranslation\":\"Cái này đã được dâng vật tế lễ rồi.\",\"rating\":9.5},\n  {\"id\":717544,\"suggestedTranslation\":\"Bộ giáp tuyệt vời cho những trận chiến nảy lửa.\",\"rating\":9.5},\n  {\"id\":717545,\"suggestedTranslation\":\"Nó sẽ phục vụ ta tốt, dù cho nguồn gốc có thế nào đi nữa.\",\"rating\":9.0},\n  {\"id\":717546,\"suggestedTranslation\":\"Giáp cỏ á. Không trụ được lâu đâu.\",\"rating\":9.5},\n  {\"id\":717547,\"suggestgTranslation\":\"Gần như không thể xuyên thủng!\",\"rating\":9.5},\n  {\"id\":717548,\"suggestedTranslation\":\"Bộ giáp xứng tầm với chính Odin!\",\"rating\":9.5},\n  {\"id\":717549,\"suggestedTranslation\":\"Thật là một bộ giáp ma quái!\",\"rating\":9.5},\n  {\"id\":717550,\"suggestedTranslation\":\"Nó làm dịu đi nỗi đau của cơn đói. Lông thú tốt đấy.\",\"rating\":9.0},\n  {\"id\":717551,\"suggestedTranslation\":\"Cũng coi như là một cái khiên.\",\"rating\":9.5},\n  {\"id\":717552,\"suggestedTranslation\":\"Nó ban cho người mặc tốc độ bước chân sánh ngang với chính Hermod.\",\"rating\":9.0},\n  {\"id\":717553,\"suggestedTranslation\":\"Một chiếc áo giáp cây đi mượn.\",\"rating\":9.5},\n  {\"id\":717554,\"suggestedTranslation\":\"Đồng đội của ta chắc hẳn là một chiến binh mạnh mẽ.\",\"rating\":9.5},\n  {\"id\":717555,\"suggestedTranslation\":\"Mặc vào thì tốt hơn là ăn chúng, ta đoán thế.\",\"rating\":9.5},\n  {\"id\":717556,\"suggestedTranslation\":\"Bộ giáp được chế tạo từ một kẻ thù đã gục ngã.\",\"rating\":9.5},\n  {\"id\":717557,\"suggestedTranslation\":\"Thứ này sẽ giúp đồng minh thực vật của ta mạnh mẽ hơn trong chiến đấu.\",\"rating\":9.5},\n  {\"id\":717558,\"suggestedTranslation\":\"Mạnh thật đấy, nhưng nhức đầu quá...\",\"rating\":9.5},\n  {\"id\":717559,\"suggestedTranslation\":\"Bộ trang phục này mời gọi sự điên loạn...\",\"rating\":9.5},\n  {\"id\":717560,\"suggestedTranslation\":\"Ta sẽ tự hào khoác lên mình bộ giáp của hiệp sĩ này.\",\"rating\":9.5},\n  {\"id\":717561,\"suggestedTranslation\":\"Dấu tích của một trận chiến đã qua.\",\"rating\":9.5},\n  {\"id\":717562,\"suggestedTranslation\":\"Một bảng hiệu được đặt rất đúng chỗ.\",\"rating\":9.5},\n  {\"id\":717563,\"suggestedTranslation\":\"Ta sẽ chỉ ra con đường dẫn đến chiến thắng!\",\"rating\":9.5},\n  {\"id\":717564,\"suggestedTranslation\":\"Dấu tích của một trận chiến đã qua.\",\"rating\":9.5},\n  {\"id\":717565,\"suggestedTranslation\":\"Một bảng hiệu được đặt rất đúng chỗ.\",\"rating\":9.5},\n  {\"id\":717566,\"suggestedTranslation\":\"Ta sẽ chỉ ra con đường dẫn đến chiến thắng!\",\"rating\":9.5},\n  {\"id\":717567,\"suggestedTranslation\":\"Tàn tích của ngọn lửa.\",\"rating\":9.5},\n  {\"id\":717568,\"suggestedTranslation\":\"Xương mắt không thể sang được thế giới này.\",\"rating\":9.5},\n  {\"id\":717569,\"suggestedTranslation\":\"Bông hoa phải ở lại thế giới quê nhà của nó.\",\"rating\":9.5},\n  {\"id\":717570,\"suggestedTranslation\":\"Nó bị thiêu rụi rồi. Biến mất rồi.\",\"rating\":9.5},\n  {\"id\":717571,\"suggestedTranslation\":\"Rau củ ư! Ta sẽ không đời nào tiêu thụ ngươi đâu!\",\"rating\":9.5},\n  {\"id\":717572,\"suggestedTranslation\":\"Ta sẽ không ăn thứ này!\",\"rating\":9.5},\n  {\"id\":717573,\"suggestedTranslation\":\"Lửa không làm cho nó dễ nuốt hơn đâu.\",\"rating\":9.5},\n  {\"id\":717574,\"suggestedTranslation\":\"Ngọn giáo này không bao giờ sánh được với của ta đâu.\",\"rating\":9.5},\n  {\"id\":717575,\"suggestedTranslation\":\"Mấy thứ này chẳng có tích sự gì với ta cả!\",\"rating\":9.5},\n  {\"id\":717576,\"suggestedTranslation\":\"Chẳng mấy chốc nó sẽ mở ra con đường!\",\"rating\":9.5},\n  {\"id\":717577,\"suggestedTranslation\":\"Nó sẽ không hoạt động lại trong một thời gian nữa.\",\"rating\":9.5},\n  {\"id\":717578,\"suggestedTranslation\":\"Mưu mẹo! Bifrost đúng là của Loki rồi!\",\"rating\":9.5},\n  {\"id\":717579,\"suggestedTranslation\":\"Đó chính là Bifrost!\",\"rating\":9.5},\n  {\"id\":717580,\"suggestedTranslation\":\"Ánh sáng soi đường dẫn lối!\",\"rating\":9.5},\n  {\"id\":717581,\"suggestedTranslation\":\"Chìa khóa mở Bifrost của Heimdallr.\",\"rating\":9.5},\n  {\"id\":717582,\"suggestedTranslation\":\"Một cái bồn cổ để chứa ngọn lửa.\",\"rating\":9.5},\n  {\"id\":717583,\"suggestedTranslation\":\"Một ngọn lửa báng bổ.\",\"rating\":9.5},\n  {\"id\":717584,\"suggestedTranslation\":\"Chữ viết của các vị thần không dành cho chúng ta.\",\"rating\":9.5},\n  {\"id\":717585,\"suggestedTranslation\":\"Đây là bức chân dung của một dân tộc cổ đại. Họ sống trong cảnh khốn cùng.\",\"rating\":9.5},\n  {\"id\":717586,\"suggestedTranslation\":\"Chẳng có bức tranh nào ở đây cả. Chỉ có đá thôi.\",\"rating\":9.5},\n  {\"id\":717587,\"suggestedTranslation\":\"Một cái ác to lớn đang càn quét khắp vùng đất.\",\"rating\":9.5},\n  {\"id\":717588,\"suggestedTranslation\":\"Rất nhiều người đã bị chẻ làm đôi!\",\"rating\":9.5},\n  {\"id\":717589,\"suggestedTranslation\":\"Một thành phố lấp lánh, được các vị thần ban phước.\",\"rating\":9.5},\n  {\"id\":717590,\"suggestedTranslation\":\"Ta ngửi thấy sự sợ hãi của chúng!\",\"rating\":9.5},\n  {\"id\":717591,\"suggestedTranslation\":\"Để chặt và phá hủy!\",\"rating\":9.5},\n  {\"id\":717592,\"suggestedTranslation\":\"Quái thú tí hon.\",\"rating\":9.5},\n  {\"id\":717593,\"suggestedTranslation\":\"Con quái vật tí hon đang ngủ say.\",\"rating\":9.5},\n  {\"id\":717594,\"suggestedTranslation\":\"Một kho vũ khí di động.\",\"rating\":9.5},\n  {\"id\":717595,\"suggestedTranslation\":\"Thịt và trứng!\",\"rating\":9.5},\n  {\"id\":717596,\"suggestedTranslation\":\"Được thôi! Thêm một ván nữa nào, hỡi tên lừa đảo xảo trá!\",\"rating\":9.5},\n  {\"id\":717597,\"suggestedTranslation\":\"Phí thật! Con quái vật chết tiệt!\",\"rating\":9.5},\n  {\"id\":717598,\"suggestedTranslation\":\"Một sự nhạo báng cao su đối với sự sống.\",\"rating\":9.5},\n  {\"id\":717599,\"suggestedTranslation\":\"Nó đã nuốt chửng nguyên cả mấy đứa nhỏ rồi!\",\"rating\":9.5},\n  {\"id\":717600,\"suggestedTranslation\":\"Sức mạnh kỳ lạ của nó đã phai nhạt.\",\"rating\":9.5},\n  {\"id\":717601,\"suggestedTranslation\":\"Ban cho ta tốc độ của Hermod!\",\"rating\":9.5},\n  {\"id\":717602,\"suggestedTranslation\":\"Nhiều màu sắc quá! Ta muốn cất cao tiếng hát!\",\"rating\":9.5},\n  {\"id\":717603,\"suggestedTranslation\":\"Cái này chỉ dùng để nổi phềnh phềnh thôi, chứ đánh đấm gì tầm này.\",\"rating\":9.5},\n  {\"id\":717604,\"suggestedTranslation\":\"Ta chẳng có chút công dụng nào với một thực vật mọc đầy những thứ không phải thịt.\",\"rating\":9.0},\n  {\"id\":717605,\"suggestedTranslation\":\"Món cám khỉ.\",\"rating\":9.5},\n  {\"id\":717606,\"suggestedTranslation\":\"Bằng cách nào đó ta lại tìm ra cách làm cho nó KÉM hấp dẫn hơn nữa!\",\"rating\":9.5},\n  {\"id\":717607,\"suggestedTranslation\":\"Để chữa lành cả những vết thương chiến trận sâu nhất.\",\"rating\":9.5},\n  {\"id\":717608,\"suggestedTranslation\":\"Nếu ta có một miếng băng cho mỗi vết thương da thịt...\",\"rating\":9.5},\n  {\"id\":717609,\"suggestedTranslation\":\"Đó chỉ là một chút thịt biển cỏn con.\",\"rating\":9.5},\n  {\"id\":717610,\"suggestedTranslation\":\"Tại sao lại giấu thịt bên trong chiếc túi bánh mì này cơ chứ?\",\"rating\":9.5},\n  {\"id\":717611,\"suggestedTranslation\":\"Dành cho những ai có ý chí sắt đá, và dạ dày thép.\",\"rating\":9.5},\n  {\"id\":717612,\"suggestedTranslation\":\"Ta thèm ăn nữa!\",\"rating\":9.5},\n  {\"id\":717613,\"suggestedTranslation\":\"Ngươi sẽ tìm được một ngôi nhà mới trong bụng ta.\",\"rating\":9.5},\n  {\"id\":717614,\"suggestedTranslation\":\"Nó đánh bay cơn đói của ta một cách gọn gàng!\",\"rating\":9.5},\n  {\"id\":717615,\"suggestedTranslation\":\"Một ngàn phàm nhân cũng không thể phá vỡ nổi hòn đá này.\",\"rating\":9.5},\n  {\"id\":717616,\"suggestedTranslation\":\"Thịt có cánh.\",\"rating\":9.5},\n  {\"id\":717617,\"suggestedTranslation\":\"Giáo có cánh!\",\"rating\":9.5},\n  {\"id\":717618,\"suggestedTranslation\":\"Chúng đang trốn dưới sân khấu kìa.\",\"rating\":9.5},\n  {\"id\":717619,\"suggestedTranslation\":\"Ta sẽ ném ngươi vào cái vạc của trái đất!\",\"rating\":9.5},\n  {\"id\":717620,\"suggestedTranslation\":\"Một chiến lợi phẩm từ cuộc săn.\",\"rating\":9.5},\n  {\"id\":717621,\"suggestedTranslation\":\"Một chiến binh sẽ không bao giờ thèm mặc thứ như thế này!\",\"rating\":9.5},\n  {\"id\":717622,\"suggestedTranslation\":\"Nếu đó là thịt, ta sẽ ăn tuốt!\",\"rating\":9.5},\n  {\"id\":717623,\"suggestedTranslation\":\"Nó giữ âm nhạc của ta giống như những mũi tên trong ống đựng.\",\"rating\":9.5},\n  {\"id\":717624,\"suggestedTranslation\":\"Những nốt nhạc truyền vào vũ khí của ta sự sắc bén của chúng!\",\"rating\":9.5},\n  {\"id\":717625,\"suggestedTranslation\":\"Một màn trình diễn rực lửa sẽ bảo vệ ta khỏi ánh mắt thiêu đốt của kẻ thù.\",\"rating\":9.5},\n  {\"id\":717626,\"suggestedTranslation\":\"Ta sẽ tấu khúc ca cho kẻ thù trên hành trình đến Valhalla!\",\"rating\":9.5},\n  {\"id\":717627,\"suggestedTranslation\":\"Chính lời nói của ta cũng đủ làm kẻ thù run sợ!\",\"rating\":9.5},\n  {\"id\":717628,\"suggestedTranslation\":\"Một giai điệu đủ sống động để đánh thức người chết!\",\"rating\":9.5},\n  {\"id\":717629,\"suggestedTranslation\":\"Một lời lăng mạ nhắm trúng đích có thể xoay chuyển cục diện trận chiến.\",\"rating\":9.5},\n  {\"id\":717630,\"suggestedTranslation\":\"Đừng sợ, bài ca của ta sẽ chỉ cho chúng ta ánh sáng.\",\"rating\":9.5},\n  {\"id\":717631,\"suggestedTranslation\":\"Một bản thánh ca sôi nổi để truyền cảm hứng dũng cảm trong chiến đấu!\",\"rating\":9.5},\n  {\"id\":717632,\"suggestedTranslation\":\"Một bài ca chiến đấu hào hùng để đầu óc minh mẫn.\",\"rating\":9.5},\n  {\"id\":717633,\"suggestedTranslation\":\"Ta sẽ ca ngợi bóng đêm ngọt ngào.\",\"rating\":9.5},\n  {\"id\":717634,\"suggestedTranslation\":\"Giống như đôi cánh trên mũ giáp của ta, chỉ là nhiều thịt hơn.\",\"rating\":9.5},\n  {\"id\":717635,\"suggestedTranslation\":\"Cánh đen đã được nấu chín.\",\"rating\":9.5},\n  {\"id\":717636,\"suggestedTranslation\":\"Lông của mấy kẻ điên.\",\"rating\":9.5},\n  {\"id\":717637,\"suggestedTranslation\":\"Quái thú hay kẻ cuồng chiến đây?\",\"rating\":9.5},\n  {\"id\":717638,\"suggestedTranslation\":\"Mong rằng chúng ta sẽ gặp lại nhau ở Valhalla.\",\"rating\":9.5},\n  {\"id\":717639,\"suggestedTranslation\":\"Ngươi quả là một đối thủ xứng tầm.\",\"rating\":9.5},\n  {\"id\":717640,\"suggestedTranslation\":\"Sinh vật lạ vẫn còn sức chiến đấu đấy!\",\"rating\":9.5},\n  {\"id\":717641,\"suggestedTranslation\":\"Nó sẽ giữ cho chiến lợi phẩm của ta luôn tươi ngon.\",\"rating\":9.5},\n  {\"id\":717642,\"suggestedTranslation\":\"CHIẾN-CUỒNG!\",\"rating\":9.5},\n  {\"id\":717643,\"suggestedTranslation\":\"Nó đã chiến đấu anh dũng, nhưng bộ da giờ là của ta.\",\"rating\":9.5},\n  {\"id\":717644,\"suggestedTranslation\":\"Chẳng cần may mắn gì cho kẻ có kỹ năng chiến đấu cả.\",\"rating\":9.5},\n  {\"id\":717645,\"suggestedTranslation\":\"Một chiếc giường lông thú sang trọng!\",\"rating\":9.5},\n  {\"id\":717646,\"suggestedTranslation\":\"Công cụ cho những giấc ngủ ngắn anh dũng.\",\"rating\":9.5},\n  {\"id\":717647,\"suggestedTranslation\":\"Những chiến binh tí hon! Ta không biết mình có thích chúng không nữa.\",\"rating\":9.5},\n  {\"id\":717648,\"suggestedTranslation\":\"Bình tĩnh nào!\",\"rating\":9.5},\n  {\"id\":717649,\"suggestedTranslation\":\"Tổ ong đang chìm trong tĩnh lặng.\",\"rating\":9.5},\n  {\"id\":717650,\"suggestedTranslation\":\"Đó là một kho báu mật ong!\",\"rating\":9.5},\n  {\"id\":717651,\"suggestedTranslation\":\"Một hộp ngọt ngào chứa đầy những chiến binh tí hon.\",\"rating\":9.5},\n  {\"id\":717652,\"suggestedTranslation\":\"Mật ong đâu rồi?\",\"rating\":9.5},\n  {\"id\":717653,\"suggestedTranslation\":\"Đó là một kho báu mật ong!\",\"rating\":9.5},\n  {\"id\":717654,\"suggestedTranslation\":\"Chút mật ong cỏn con. Cần thêm kiên nhẫn.\",\"rating\":9.5},\n  {\"id\":717655,\"suggestedTranslation\":\"Tổ ong đang chìm trong tĩnh lặng.\",\"rating\":9.5},\n  {\"id\":717656,\"suggestedTranslation\":\"Đó là một kho báu mật ong!\",\"rating\":9.5},\n  {\"id\":717657,\"suggestedTranslation\":\"Mụ già khó tính đó sẽ lấy đầu ta nếu ta dám ăn trộm một giọt mật ong đấy.\",\"rating\":9.0},\n  {\"id\":717658,\"suggestedTranslation\":\"Mật ong đâu rồi?\",\"rating\":9.5},\n  {\"id\":717659,\"suggestedTranslation\":\"Đó là một kho báu mật ong!\",\"rating\":9.5},\n  {\"id\":717660,\"suggestedTranslation\":\"Chút mật ong cỏn con. Cần thêm kiên nhẫn.\",\"rating\":9.5},\n  {\"id\":717661,\"suggestedTranslation\":\"Một chiến mã đã gục ngã.\",\"rating\":9.5},\n  {\"id\":717662,\"suggestedTranslation\":\"Xem ra Valhalla vẫn chưa muốn nhận chiến mã của ta đâu.\",\"rating\":9.5},\n  {\"id\":717663,\"suggestedTranslation\":\"Con vật cuối cùng cũng biết rõ vai trò của nó rồi.\",\"rating\":9.5},\n  {\"id\":717664,\"suggestedTranslation\":\"Đi theo nào bé con.\",\"rating\":9.5},\n  {\"id\":717665,\"suggestedTranslation\":\"Những con thú có lông cổ xưa!\",\"rating\":9.5},\n  {\"id\":717666,\"suggestedTranslation\":\"Một con thú kiêu hãnh và cao quý, gắn kết với một nữ chiến binh kiêu hãnh và cao quý.\",\"rating\":9.0},\n  {\"id\":717667,\"suggestedTranslation\":\"Ngươi có lạnh không khi không có lớp lông dày?\",\"rating\":9.5},\n  {\"id\":717668,\"suggestedTranslation\":\"Chiến mã uy nghiêm của một nữ chiến binh hùng mạnh!\",\"rating\":9.5},\n  {\"id\":717669,\"suggestedTranslation\":\"Miếng nước bọt của ta cứ chảy ra khi nhìn nó...\",\"rating\":9.5},\n  {\"id\":717670,\"suggestedTranslation\":\"Với con chiến mã kiên cường ở bên, tối nay chúng ta xuất kích!\",\"rating\":9.5},\n  {\"id\":717671,\"suggestedTranslation\":\"Nghe giống dì Hilda ghê.\",\"rating\":9.5},\n  {\"id\":717672,\"suggestedTranslation\":\"Ta phải giữ cho con thú của mình được ăn no và sẵn sàng chiến đấu.\",\"rating\":9.5},\n  {\"id\":717673,\"suggestedTranslation\":\"Cái đó hợp với ta đấy.\",\"rating\":9.5}\n]",
