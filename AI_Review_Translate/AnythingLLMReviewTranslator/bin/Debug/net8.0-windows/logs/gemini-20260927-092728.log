: 717061, \"suggestedTranslation\": \"only_used_by_wendy\", \"rating\": 9.0},\n  {\"id\": 717062, \"suggestedTranslation\": \"only_used_by_wendy\", \"rating\": 9.0},\n  {\"id\": 717063, \"suggestedTranslation\": \"Đó không phải là chiếc cần câu ta cần.\", \"rating\": 9.0},\n  {\"id\": 717064, \"suggestedTranslation\": \"Làm vậy thì thật không phải phép khi táy máy đồ đạc của đồng minh.\", \"rating\": 9.0},\n  {\"id\": 717065, \"suggestedTranslation\": \"Một câu chuyện bi thương đầy đau khổ và khốn cùng!\", \"rating\": 9.0},\n  {\"id\": 717066, \"suggestedTranslation\": \"Khỉ thật! Trống không.\", \"rating\": 9.0},\n  {\"id\": 717067, \"suggestedTranslation\": \"Đồ chết tiệt! Kẹt rồi!\", \"rating\": 9.0},\n  {\"id\": 717068, \"suggestedTranslation\": \"Đó không phải là món báu vật đáng để lấy.\", \"rating\": 9.0},\n  {\"id\": 717069, \"suggestedTranslation\": \"Có kẻ đã hớt tay trên của ta rồi!\", \"rating\": 9.0},\n  {\"id\": 717070, \"suggestedTranslation\": \"Ngươi không phải là kẻ ta đang tìm kiếm.\", \"rating\": 9.0},\n  {\"id\": 717071, \"suggestedTranslation\": \"Chủ nhân của ngươi đâu rồi, hỡi con thú rau củ?\", \"rating\": 9.0},\n  {\"id\": 717072, \"suggestedTranslation\": \"Vũ khí đó chẳng có chút vinh quang nào cả!\", \"rating\": 9.0},\n  {\"id\": 717073, \"suggestedTranslation\": \"Ta không cần phải biết thêm nữa.\", \"rating\": 9.0}\n]",
