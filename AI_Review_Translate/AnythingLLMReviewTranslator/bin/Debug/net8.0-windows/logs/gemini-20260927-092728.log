      "content": {
        "parts": [
          {
            "text": "[\n  {\"id\":718574,\"suggestedTranslation\":\"Một bụi gai nhọn.\",\"rating\":9.0},\n  {\"id\":718575,\"suggestedTranslation\":\"Ngươi là phù thủy biển ư? Hay chỉ là một mụ già lẩm cẩm?\",\"rating\":9.0},\n  {\"id\":718576,\"suggestedTranslation\":\"Để sưởi ấm dòng máu của ta chống lại cái lạnh thấu xương của Niflheim!\",\"rating\":9.0},\n  {\"id\":718577,\"suggestedTranslation\":\"Một loại thuốc để xua tan cơn điên loạn.\",\"rating\":9.0},\n  {\"id\":718578,\"suggestedTranslation\":\"Nó làm dịu đi cơn bão cuồng nộ trong lòng.\",\"rating\":9.0},\n  {\"id\":718579,\"suggestedTranslation\":\"Nhờ ngụm nước này, các quái thú mặt trăng sẽ không màng đến chúng ta!\",\"rating\":9.0},\n  {\"id\":718580,\"suggestedTranslation\":\"Nó giúp trấn tĩnh tâm can của một chiến binh.\",\"rating\":9.0},\n  {\"id\":718581,\"suggestedTranslation\":\"Thứ đồ uống của kẻ cuồng chiến!\",\"rating\":9.0},\n  {\"id\":718582,\"suggestedTranslation\":\"Nó sẽ dập tắt hơi thở hừng hực đầy thị nộ của Surtr.\",\"rating\":9.0},\n  {\"id\":718583,\"suggestedTranslation\":\"Một thứ linh dược để hồi phục sinh lực cho chiến binh!\",\"rating\":9.0},\n  {\"id\":718584,\"suggestedTranslation\":\"Nó không còn nữa.\",\"rating\":9.0},\n  {\"id\":718585,\"suggestedTranslation\":\"Nó tỏa sáng rực rỡ tựa hào quang của Baldur.\",\"rating\":9.0},\n  {\"id\":718586,\"suggestedTranslation\":\"Ta sẽ lo việc đó.\",\"rating\":9.0},\n  {\"id\":718587,\"suggestedTranslation\":\"Con cua sẽ cư trú ở nơi ta thấy thích hợp.\",\"rating\":9.0},\n  {\"id\":718588,\"suggestedTranslation\":\"Cho một hành trình nhanh chóng đến chỗ mụ phù thủy biển.\",\"rating\":9.0},\n  {\"id\":718589,\"suggestedTranslation\":\"Ta thích thứ nước pha chế nào nhỉ?\",\"rating\":9.0},\n  {\"id\":718590,\"suggestedTranslation\":\"Mụ phù thủy biển đang pha chế thức uống của ả.\",\"rating\":9.0},\n  {\"id\":718591,\"suggestedTranslation\":\"Ta nghĩ Odin đang thèm thứ đồ uống của mụ phù thủy.\",\"rating\":9.0},\n  {\"id\":718592,\"suggestedTranslation\":\"Mụ phù thủy biển đã bỏ chiếc cột của mình rồi!\",\"rating\":9.0},\n  {\"id\":718593,\"suggestedTranslation\":\"Nó sẽ tiếp thêm sinh lực cho bất kỳ chiến binh mệt mỏi nào.\",\"rating\":9.0},\n  {\"id\":718594,\"suggestedTranslation\":\"Lạ thật, ta không thấy tên khổng lồ lửa nào cả...\",\"rating\":9.0},\n  {\"id\":718595,\"suggestedTranslation\":\"Có lẽ một tên khổng lồ lửa đang ngủ say bên dưới!\",\"rating\":9.0},\n  {\"id\":718596,\"suggestedTranslation\":\"Công trình này bao giờ mới xong đây?\",\"rating\":9.0},\n  {\"id\":718597,\"suggestedTranslation\":\"Mụ phù thủy biển có vẻ hài lòng với nó.\",\"rating\":9.0},\n  {\"id\":718598,\"suggestedTranslation\":\"Mụ già đó cư ngụ ở đây sao?\",\"rating\":9.0},\n  {\"id\":718599,\"suggestedTranslation\":\"Đừng có dán mắt vào đống giẻ rách bị nguyền rủa của mụ phù thủy biển!\",\"rating\":9.0},\n  {\"id\":718600,\"suggestedTranslation\":\"Nó đang nhảy múa theo nhịp gió thổi.\",\"rating\":9.0},\n  {\"id\":718601,\"suggestedTranslation\":\"Công sức của chúng ta đã được đền đáp!\",\"rating\":9.0},\n  {\"id\":718602,\"suggestedTranslation\":\"Một mẻ vỏ sò tươi mới để trang hoàng cho chiến lũy của chúng ta.\",\"rating\":9.0},\n  {\"id\":718603,\"suggestedTranslation\":\"Trận chiến đã thắng lợi, nhưng cái giá phải trả là gì?\",\"rating\":9.0},\n  {\"id\":718604,\"suggestedTranslation\":\"Ta sẽ bảo vệ nó bằng cả tính mạng!\",\"rating\":9.0},\n  {\"id\":718605,\"suggestedTranslation\":\"Người Viking không đội mũ có sừng.\",\"rating\":9.0},\n  {\"id\":718606,\"suggestedTranslation\":\"Nơi nào có lò sưởi, nơi đó là nhà!\",\"rating\":9.0},\n  {\"id\":718607,\"suggestedTranslation\":\"Dấu tích của một trận chiến đã qua.\",\"rating\":9.0},\n  {\"id\":718608,\"suggestedTranslation\":\"Một bảng hiệu được đặt ở vị trí vô cùng đắc địa.\",\"rating\":9.0},\n  {\"id\":718609,\"suggestedTranslation\":\"Ta sẽ viết nên một khúc ca khải hoàn!\",\"rating\":9.0},\n  {\"id\":718610,\"suggestedTranslation\":\"Dính dấp và kinh tởm.\",\"rating\":9.0},\n  {\"id\":718611,\"suggestedTranslation\":\"Chẳng làm được cái tổ ong ra hồn đâu.\",\"rating\":9.0},\n  {\"id\":718612,\"suggestedTranslation\":\"Một bữa tiệc thịnh soạn!\",\"rating\":9.0},\n  {\"id\":718613,\"suggestedTranslation\":\"Một bữa tiệc thịnh soạn!\",\"rating\":9.0},\n  {\"id\":718614,\"suggestedTranslation\":\"Ta mới khao khát chiến trận làm sao.\",\"rating\":9.0},\n  {\"id\":718615,\"suggestedTranslation\":\"Cảnh tượng đó làm tê tái cả trái tim chiến binh dũng cảm của ta.\",\"rating\":9.0},\n  {\"id\":718616,\"suggestedTranslation\":\"Một chiến binh tự tạo ra vận may cho mình, nhưng việc chối bỏ sự ban ơn của Odin là một sự ngu ngốc.\",\"rating\":9.0},\n  {\"id\":718617,\"suggestedTranslation\":\"Một bài kiểm tra thực sự cho ý chí.\",\"rating\":9.0},\n  {\"id\":718618,\"suggestedTranslation\":\"Nó thấm đẫm sức mạnh của mặt trăng!\",\"rating\":9.0},\n  {\"id\":718619,\"suggestedTranslation\":\"Lạ thật, ta không thấy tên khổng lồ lửa nào cả...\",\"rating\":9.0},\n  {\"id\":718620,\"suggestedTranslation\":\"Có lẽ một tên khổng lồ lửa đang ngủ say bên dưới!\",\"rating\":9.0},\n  {\"id\":718621,\"suggestedTranslation\":\"Ồ không! Tên khổng lồ bị kẹt rồi!\",\"rating\":9.0},\n  {\"id\":718622,\"suggestedTranslation\":\"Hậu duệ của Fenrir!\",\"rating\":9.0},\n  {\"id\":718623,\"suggestedTranslation\":\"Một kẻ thù đã gục ngã.\",\"rating\":9.0},\n  {\"id\":718624,\"suggestedTranslation\":\"Hỏa táng.\",\"rating\":9.0},\n  {\"id\":718625,\"suggestedTranslation\":\"Hãy ngủ ngon nhé, kẻ thù đã gục ngã.\",\"rating\":9.0},\n  {\"id\":718626,\"suggestedTranslation\":\"Kẻ chết lại cất bước!\",\"rating\":9.0},\n  {\"id\":718627,\"suggestedTranslation\":\"Những con chó săn này thực sự là chiến binh đích thực.\",\"rating\":9.0},\n  {\"id\":718628,\"suggestedTranslation\":\"Tín vật của một cuộc chinh phạt thành công.\",\"rating\":9.0},\n  {\"id\":718629,\"suggestedTranslation\":\"Một vũ khí tầm xa tuyệt đẹp. Thích hợp cho kẻ hèn nhát.\",\"rating\":9.0},\n  {\"id\":718630,\"suggestedTranslation\":\"Nó yểm bùa lên lũ thú cứng đầu.\",\"rating\":9.0},\n  {\"id\":718631,\"suggestedTranslation\":\"Một người bạn đồng hành trung thành, nếu thực sự có một người như vậy.\",\"rating\":9.0},\n  {\"id\":718632,\"suggestedTranslation\":\"Một tinh linh nước được che chở kỹ càng!\",\"rating\":9.0},\n  {\"id\":718633,\"suggestedTranslation\":\"Một nạn nhân xấu số của chiến tranh.\",\"rating\":9.0},\n  {\"id\":718634,\"suggestedTranslation\":\"Làm ta nhớ đến quê hương.\",\"rating\":9.0},\n  {\"id\":718635,\"suggestedTranslation\":\"Không còn nghi ngờ gì nữa, đây là cái bẫy do những tên khổng lồ băng đá độc ác để lại.\",\"rating\":9.0},\n  {\"id\":718636,\"suggestedTranslation\":\"Nó chẳng chịu nổi cái nóng dữ dội này.\",\"rating\":9.0},\n  {\"id\":718637,\"suggestedTranslation\":\"Nó chẳng chịu nổi cái nóng dữ dội này.\",\"rating\":9.0},\n  {\"id\":718638,\"suggestedTranslation\":\"Mùa đông ngự trị bên trong!\",\"rating\":9.0},\n  {\"id\":718639,\"suggestedTranslation\":\"Thứ đó làm ê buốt cả răng ta.\",\"rating\":9.0},\n  {\"id\":718640,\"suggestedTranslation\":\"Một cục giá lạnh.\",\"rating\":9.0},\n  {\"id\":718641,\"suggestedTranslation\":\"Những chiếc răng băng giá!\",\"rating\":9.0},\n  {\"id\":718642,\"suggestedTranslation\":\"Một chiếc ba lô làm từ quái vật.\",\"rating\":9.0},\n  {\"id\":718643,\"suggestedTranslation\":\"Một gói quà từ Ullr!\",\"rating\":9.0},\n  {\"id\":718644,\"suggestedTranslation\":\"Ma thuật của người Jotunn!\",\"rating\":9.0},\n  {\"id\":718645,\"suggestedTranslation\":\"Một cây quyền pháp xứng tầm với chính Skadi.\",\"rating\":9.0},\n  {\"id\":718646,\"suggestedTranslation\":\"Quái thú của ta sẽ không sợ cái lạnh.\",\"rating\":9.0},\n  {\"id\":718647,\"suggestedTranslation\":\"Ối!\",\"rating\":9.0},\n  {\"id\":718648,\"suggestedTranslation\":\"Ta chẳng nghi ngờ gì về hòn đá tảng này cả.\",\"rating\":9.0},\n  {\"id\":718649,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":9.0},\n  {\"id\":718650,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":9.0},\n  {\"id\":718651,\"suggestedTranslation\":\"Một chiến binh chẳng cần đến những thứ thế này.\",\"rating\":9.0},\n  {\"id\":718652,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":9.0},\n  {\"id\":718653,\"suggestedTranslation\":\"Kẻ chiến binh tuyệt vời trong gương kia là ai vậy?\",\"rating\":9.0},\n  {\"id\":718654,\"suggestedTranslation\":\"Đó là một loại si-rô có mùi vô cùng ốm yếu.\",\"rating\":9.0},\n  {\"id\":718655,\"suggestedTranslation\":\"Hà! Ít ra loài thực vật này cũng có chút khí phách!\",\"rating\":9.0},\n  {\"id\":718656,\"suggestedTranslation\":\"Dính dấp và kinh tởm.\",\"rating\":9.0},\n  {\"id\":718657,\"suggestedTranslation\":\"Thành quả của một lão nông trồng cục kẹo chăm chỉ.\",\"rating\":9.0},\n  {\"id\":718658,\"suggestedTranslation\":\"Biết đâu lại có báu vật bên trong?\",\"rating\":9.0},\n  {\"id\":718659,\"suggestedTranslation\":\"Liệu phần thưởng trên đỉnh núi có xứng đáng với sự nguy hiểm mà nó đòi hỏi?\",\"rating\":9.0},\n  {\"id\":718660,\"suggestedTranslation\":\"Thật là một sự nhục nhã nếu bị đè chết bởi một đống phế liệu rơi xuống...\",\"rating\":9.0},\n  {\"id\":718661,\"suggestedTranslation\":\"Một bữa ăn đơn giản, nhưng rất ngon.\",\"rating\":9.0},\n  {\"id\":718662,\"suggestedTranslation\":\"Một bữa tiệc thịnh soạn!\",\"rating\":9.0},\n  {\"id\":718663,\"suggestedTranslation\":\"Thứ rau củ biển ngốc nghếch.\",\"rating\":9.0},\n  {\"id\":718664,\"suggestedTranslation\":\"Ta đời nào đổi mũ chiến của mình lấy thứ này.\",\"rating\":9.0},\n  {\"id\":718665,\"suggestedTranslation\":\"Nó còn tệ hơn lúc trước nữa.\",\"rating\":9.0},\n  {\"id\":718666,\"suggestedTranslation\":\"Ta căm ghét nó.\",\"rating\":9.0},\n  {\"id\":718667,\"suggestedTranslation\":\"Một kẻ thách thức!\",\"rating\":9.0},\n  {\"id\":718668,\"suggestedTranslation\":\"Một kẻ thù đã bị chinh phục.\",\"rating\":9.0},\n  {\"id\":718669,\"suggestedTranslation\":\"Than ôi, nó sẽ không còn lắc lư được nữa.\",\"rating\":9.0},\n  {\"id\":718670,\"suggestedTranslation\":\"Một bạn đấu tập cho mấy con thú nhỏ.\",\"rating\":9.0},\n  {\"id\":718671,\"suggestedTranslation\":\"Đừng sợ mấy con thú nhỏ nhé, nó sẽ được dựng lên ngay lập tức!\",\"rating\":9.0},\n  {\"id\":718672,\"suggestedTranslation\":\"Xem ra cuộc săn đã kết thúc.\",\"rating\":9.0},\n  {\"id\":718673,\"suggestedTranslation\":\"Mấy con thú nhỏ phải học cách săn mồi chứ!\",\"rating\":9.0},\n  {\"id\":718674,\"suggestedTranslation\":\"Ta sẽ dựng nó với tốc độ của Hermod!\",\"rating\":9.0},\n  {\"id\":718675,\"suggestedTranslation\":\"Làm chỗ ẩn nấp giờ thì không ổn lắm đâu.\",\"rating\":9.0},\n  {\"id\":718676,\"suggestedTranslation\":\"Một căn hộ áp mái dành cho mấy con thú nhỏ.\",\"rating\":9.0},\n  {\"id\":718677,\"suggestedTranslation\":\"Mấy con thú nhỏ ra ngoài rồi, đi tìm chúng thôi!\",\"rating\":9.0},\n  {\"id\":718678,\"suggestedTranslation\":\"Chúng ta phải đưa chúng về nhà thật nhanh!\",\"rating\":9.0},\n  {\"id\":718679,\"suggestedTranslation\":\"Mọi thứ cần thiết để xây một nơi trú ẩn cho những con thú tí hon.\",\"rating\":9.0},\n  {\"id\":718680,\"suggestedTranslation\":\"Một con thú nhỏ có tài gây rối.\",\"rating\":9.0},\n  {\"id\":718681,\"suggestedTranslation\":\"Một con thú nhỏ với đôi tai không hề nhỏ chút nào.\",\"rating\":9.0},\n  {\"id\":718682,\"suggestedTranslation\":\"Một con thú nhỏ đặc biệt giỏi trốn tìm.\",\"rating\":9.0},\n  {\"id\":718683,\"suggestedTranslation\":\"Một con thú nhỏ trông có vẻ rất dễ bắt lửa.\",\"rating\":9.0},\n  {\"id\":718684,\"suggestedTranslation\":\"Một con thú nhỏ được trang bị vũ khí ở đuôi. Thật hung tợn!\",\"rating\":9.0},\n  {\"id\":718685,\"suggestedTranslation\":\"Một con thú nhỏ được ban cho con mắt thứ ba để tìm thêm nhiều chỗ ẩn nấp.\",\"rating\":9.0},\n  {\"id\":718686,\"suggestedTranslation\":\"Lại đây nào, thú cưng tí hon! Ta sẽ ban cho ngươi một gói quà mang tên chiến binh!\",\"rating\":9.0},\n  {\"id\":718687,\"suggestedTranslation\":\"Một con thú nhỏ vô cùng nghiêm túc.\",\"rating\":9.0},\n  {\"id\":718688,\"suggestedTranslation\":\"Một con thú nhỏ mang trái tim của một dã thú hùng mạnh.\",\"rating\":9.0},\n  {\"id\":718689,\"suggestedTranslation\":\"Một con thú nhỏ với bộ trang phục tuyệt vời.\",\"rating\":9.0},\n  {\"id\":718690,\"suggestedTranslation\":\"Hôm nay ta sẽ giải thoát cho bầy hươu của ngươi!\",\"rating\":9.0},\n  {\"id\":718691,\"suggestedTranslation\":\"Ngươi sẽ hé lộ những điều kỳ diệu gì đây?\",\"rating\":9.0},\n  {\"id\":718692,\"suggestedTranslation\":\"Một bí mật, được giữ kín bằng ổ khóa và chìa khóa!\",\"rating\":9.0},\n  {\"id\":718693,\"suggestedTranslation\":\"Ta ngửi thấy mùi chiến trận thoảng trong gió!\",\"rating\":9.0},\n  {\"id\":718694,\"suggestedTranslation\":\"Ta không nghĩ mình sẽ cưỡi con ngựa đó đâu.\",\"rating\":9.0},\n  {\"id\":718695,\"suggestedTranslation\":\"Đi cùng ta nào, chiến binh! Tiến lên vinh quang!\",\"rating\":9.0},\n  {\"id\":718696,\"suggestedTranslation\":\"Nó tuân theo mệnh lệnh của kẻ khác.\",\"rating\":9.0},\n  {\"id\":718697,\"suggestedTranslation\":\"Lại đây, hiệp sĩ nổi loạn, hãy thử tài xem nào!\",\"rating\":9.0},\n  {\"id\":718698,\"suggestedTranslation\":\"Sinh vật này không còn nữa rồi.\",\"rating\":9.0},\n  {\"id\":718699,\"suggestedTranslation\":\"Sinh vật thân yêu... ta sắp ăn thịt ngươi rồi đấy.\",\"rating\":9.0},\n  {\"id\":718700,\"suggestedTranslation\":\"Con quái vật thịt tội nghiệp chẳng hề hay biết gì.\",\"rating\":9.0},\n  {\"id\":718701,\"suggestg_translation\":\"Cái vòi đã trở nên béo tốt hơn rồi.\",\"rating\":9.0},\n  {\"id\":718702,\"suggestedTranslation\":\"Ngươi không dọa được ta đâu, con dê kia!\",\"rating\":9.0},\n  {\"id\":718703,\"suggestedTranslation\":\"Bản thân cái túi này đã là một món quà rồi.\",\"rating\":9.0},\n  {\"id\":718704,\"suggestedTranslation\":\"Một chiếc đèn lồng để đẩy lùi bóng đêm.\",\"rating\":9.0},\n  {\"id\":718705,\"suggestedTranslation\":\"Mắt ta thấy những củ khoai tây tệ hại, nhưng vị thịt thì không lẫn đi đâu được!\",\"rating\":9.0},\n  {\"id\":718706,\"suggestedTranslation\":\"Ta sẽ không khuất phục trước ý thích của kẻ thù.\",\"rating\":9.0},\n  {\"id\":718707,\"suggestedTranslation\":\"Đó là một bộ giáp xứng tầm.\",\"rating\":9.0},\n  {\"id\":718708,\"suggestedTranslation\":\"Thứ đó không xứng mặt chiến binh!\",\"rating\":9.0},\n  {\"id\":718709,\"suggestedTranslation\":\"Người mặc nó sẽ nhanh chân lẹ bước.\",\"rating\":9.0},\n  {\"id\":718710,\"suggestedTranslation\":\"Nó không được chắc chắn như một chiến binh mong đợi.\",\"rating\":9.0},\n  {\"id\":718711,\"suggestedTranslation\":\"Làm cho người mặc có răng sắc bén.\",\"rating\":9.0},\n  {\"id\":718712,\"suggestedTranslation\":\"Làm cho người mặc có tâm trí sắc sảo.\",\"rating\":9.0},\n  {\"id\":718713,\"suggestedTranslation\":\"Ta sẽ mặc giáp để chuẩn bị cho chiến trận!\",\"rating\":9.0},\n  {\"id\":718714,\"suggestedTranslation\":\"Hãy hạ gục cờ hiệu của kẻ địch nào!\",\"rating\":9.0},\n  {\"id\":718715,\"suggestedTranslation\":\"Tiếng gọi chiến trận đã trỗi dậy trong ngươi!\",\"rating\":9.0},\n  {\"id\":718716,\"suggestedTranslation\":\"Thật là hèn nhát khi chỉ đứng nhìn cuộc chiến.\",\"rating\":9.0},\n  {\"id\":718717,\"suggestedTranslation\":\"Ôi trái tim ta hãy ngừng đập đi! Đây chính là vua của các loại mũ chiến!\",\"rating\":9.0},\n  {\"id\":718718,\"suggestedTranslation\":\"Tên khổng lồ lửa của ngươi sẽ chiến đấu sát cánh bên chúng ta.\",\"rating\":9.0},\n  {\"id\":718719,\"suggestedTranslation\":\"Ta sẽ không dây dưa với thứ ma thuật kinh khủng của ngươi đâu.\",\"rating\":9.0},\n  {\"id\":718720,\"suggestedTranslation\":\"Sleipnir đã ban cho nó sự nhanh nhẹn.\",\"rating\":9.0},\n  {\"id\":718721,\"suggestedTranslation\":\"Một loạt đạn lửa từ địa ngục Hel.\",\"rating\":9.0},\n  {\"id\":718722,\"suggestedTranslation\":\"Ẩn chứa bên trong là một lời chúc phúc từ Freya.\",\"rating\":9.0},\n  {\"id\":718723,\"suggestedTranslation\":\"Nó chứa đầy những lời chúc phúc của Freya.\",\"rating\":9.0},\n  {\"id\":718724,\"suggestedTranslation\":\"Một lưỡi đao hùng mạnh cho một trận chiến vĩ đại!\",\"rating\":9.0},\n  {\"id\":718725,\"suggestedTranslation\":\"Cầu Vồng đang tự che giấu mình.\",\"rating\":9.0},\n  {\"id\":718726,\"suggestedTranslation\":\"Cầu Vồng đã mở ra!\",\"rating\":9.0},\n  {\"id\":718727,\"suggestedTranslation\":\"Cặp sừng sắc bén như ngọn giáo của nữ chiến binh Valkyrie.\",\"rating\":9.0},\n  {\"id\":718728,\"suggestedTranslation\":\"Cây rìu của ngươi hôm nay tràn ngập niềm đam mê sục sôi!\",\"rating\":9.0},\n  {\"id\":718729,\"suggestedTranslation\":\"Đó là cánh cổng giữa các cõi.\",\"rating\":9.0},\n  {\"id\":718730,\"suggestedTranslation\":\"Chúng ta lao xuống, trở lại cõi hư không!\",\"rating\":9.0},\n  {\"id\":718731,\"suggestedTranslation\":\"Hỡi viên đá ma thuật, hãy tiếp sức cho tinh thần ta!\",\"rating\":9.0},\n  {\"id\":718732,\"suggestedTranslation\":\"Đúng là thứ ma thuật cực kỳ tàn độc!\",\"rating\":9.0},\n  {\"id\":718733,\"suggestedTranslation\":\"Hãy tiếp sức cho ta bằng sức mạnh Nox của ngươi!\",\"rating\":9.0},\n  {\"id\":718734,\"suggestedTranslation\":\"Nó vốn không được làm ra cho chiến binh.\",\"rating\":9.0},\n  {\"id\":718735,\"suggestedTranslation\":\"Một kẻ thù đầy lửa!\",\"rating\":9.0},\n  {\"id\":718736,\"suggestedTranslation\":\"Những đồng đội tốt nhất thường được kết giao trong khói lửa chiến tranh.\",\"rating\":9.0},\n  {\"id\":718737,\"suggestedTranslation\":\"Một quả trứng rồng!\",\"rating\":9.0},\n  {\"id\":718738,\"suggestedTranslation\":\"Quả trứng này trông có vẻ lạnh lẽo.\",\"rating\":9.0},\n  {\"id\":718739,\"suggestedTranslation\":\"Nó ấm áp và dễ chịu quá.\",\"rating\":9.0},\n  {\"id\":718740,\"suggestedTranslation\":\"Nó tỏa sáng vẻ mãn nguyện.\",\"rating\":9.0},\n  {\"id\":718741,\"suggestedTranslation\":\"Một người bạn trung thành và nồng nhiệt.\",\"rating\":9.0},\n  {\"id\":718742,\"suggestedTranslation\":\"Ngươi phải ăn để duy trì ngọn lửa trong người đấy.\",\"rating\":9.0},\n  {\"id\":718743,\"suggestedTranslation\":\"Ngọn lửa của nó đangụ tắt dần.\",\"rating\":9.0},\n  {\"id\":718744,\"suggestedTranslation\":\"Một chiếc nanh trứng đáng sợ!\",\"rating\":9.0},\n  {\"id\":718745,\"suggestedTranslation\":\"Nó có đáng sợ mấy đâu, phải không?\",\"rating\":9.0},\n  {\"id\":718746,\"suggestedTranslation\":\"Những vũng dung nham của ngươi chẳng thấm vào đâu với ta cả!\",\"rating\":9.0},\n  {\"id\":718747,\"suggestedTranslation\":\"Ta sẽ không đầu hàng trước những hố lửa đâu!\",\"rating\":9.0},\n  {\"id\":718748,\"suggestedTranslation\":\"Đá được khạc ra từ trái tim rực lửa của mặt đất!\",\"rating\":9.0},\n  {\"id\":718749,\"suggestedTranslation\":\"Nó có mùi hoàn toàn không giống thịt chút nào.\",\"rating\":9.0},\n  {\"id\":718750,\"suggestedTranslation\":\"Món này sẽ tạm ổn cho đến khi ta tìm được thịt thật.\",\"rating\":9.0},\n  {\"id\":718751,\"suggestedTranslation\":\"Một viễn cảnh ác mộng... nhưng dù sao vẫn là thức ăn.\",\"rating\":9.0},\n  {\"id\":718752,\"suggestedTranslation\":\"Đó là một sinh vật cổ đại trong rừng sâu.\",\"rating\":9.0},\n  {\"id\":718753,\"suggestedTranslation\":\"Vật cúng tế cho một sinh vật rừng cổ đại.\",\"rating\":9.0},\n  {\"id\":718754,\"suggestedTranslation\":\"Đó là một sinh vật cổ đại trong rừng sâu.\",\"rating\":9.0},\n  {\"id\":718755,\"suggestedTranslation\":\"Thứ thực vật ngớ ngẩn màu xanh da trời.\",\"rating\":9.0},\n  {\"id\":718756,\"suggestedTranslation\":\"Thứ này sẽ đưa ta trở lại phong độ đỉnh cao.\",\"rating\":9.0},\n  {\"id\":718757,\"suggestedTranslation\":\"Tỏa sáng đi!\",\"rating\":9.0},\n  {\"id\":718758,\"suggestedTranslation\":\"Ánh sáng của nó thật đáng hoan nghênh.\",\"rating\":9.0},\n  {\"id\":718759,\"suggestedTranslation\":\"Nó thắp lên ngọn lửa trong tim ta!\",\"rating\":9.0},\n  {\"id\":718760,\"suggestedTranslation\":\"Dẫn đường đi, côn trùng cao quý.\",\"rating\":9.0},\n  {\"id\":718761,\"suggestedTranslation\":\"Sét đánh đã biến ngươi thành một chiến binh kỳ lân!\",\"rating\":9.0},\n  {\"id\