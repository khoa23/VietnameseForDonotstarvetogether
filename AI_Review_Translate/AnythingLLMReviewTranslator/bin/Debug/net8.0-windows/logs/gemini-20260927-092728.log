ting\":9.0},\n  {\"id\":718783,\"suggestedTranslation\":\"Nó phảng phất mùi tử khí.\",\"rating\":9.0},\n  {\"id\":718784,\"suggestedTranslation\":\"Nó phảng phất mùi tử khí.\",\"rating\":9.0},\n  {\"id\":718785,\"suggestedTranslation\":\"Nó phảng phất mùi tử khí.\",\"rating\":9.0},\n  {\"id\":718786,\"suggestedTranslation\":\"Hôm nay thần kỳ lân đang mỉm cười với ta!\",\"rating\":9.0},\n  {\"id\":718787,\"suggestedTranslation\":\"Nó cũng hay đấy, nhưng chẳng bằng ngọn giáo.\",\"rating\":9.0},\n  {\"id\":718788,\"suggestedTranslation\":\"Nó làm hổ thẹn uy lực của Yggdrasil.\",\"rating\":9.0},\n  {\"id\":718789,\"suggestedTranslation\":\"Con ếch này đã chứng kiến quá nhiều điều.\",\"rating\":9.0},\n  {\"id\":718790,\"suggestedTranslation\":\"Một chiếc mũ chiến đáng gờm, đang bốc cháy với ngọn lửa phi phàm!\",\"rating\":9.0},\n  {\"id\":718791,\"suggestedTranslation\":\"Nó có một lớp da đáng gờm, đối với một thứ không phải thịt.\",\"rating\":9.0},\n  {\"id\":718792,\"suggestedTranslation\":\"Ngay cả bộ giáp bền chắc nhất đôi khi cũng cần được sửa chữa.\",\"rating\":9.0},\n  {\"id\":718793,\"suggestedTranslation\":\"Thật kỳ lạ... và đẹp đẽ.\",\"rating\":9.0},\n  {\"id\":718794,\"suggestedTranslation\":\"Một khoảng mở, nhưng ta không thể bước qua được.\",\"rating\":9.0},\n  {\"id\":718795,\"suggestedTranslation\":\"Loài thực vật hung ác, ta sẽ cho ngươi một cái chết nhanh gọn để tỏ lòng tôn kính!\",\"rating\":9.0},\n  {\"id\":718796,\"suggestedTranslation\":\"Hà! Ngươi phải làm tốt hơn thế chứ!\",\"rating\":9.0},\n  {\"id\":718797,\"suggestedTranslation\":\"Ta sẽ rèn ra những vũ khí sánh ngang với cả các vị thần!\",\"rating\":9.0},\n  {\"id\":718798,\"suggestedTranslation\":\"Lò rèn phải được xây dựng ngay lập tức!\",\"rating\":9.0},\n  {\"id\":718799,\"suggestedTranslation\":\"Ta sẽ không sập bẫy mấy trò lừa phỉnh của ngươi đâu, linh hồn ạ!\",\"rating\":9.0},\n  {\"id\":718800,\"suggestedTranslation\":\"Nảy mầm từ vầng hào quang rực rỡ của một vị thần hùng mạnh.\",\"rat