            "text": "[\n  {\"id\": 719474, \"suggestedTranslation\": \"Ta không có kiên nhẫn với ngươi đâu, nhựa cây!\", \"rating\": 9.0},\n  {\"id\": 719475, \"suggestedTranslation\": \"Ta đã lấy được mật hoa rồi!\", \"rating\": 9.0},\n  {\"id\": 719476, \"suggestedTranslation\": \"Nó đã bị thương rồi!\", \"rating\": 9.0},\n  {\"id\": 719477, \"suggestedTranslation\": \"Ngươi sẽ trở thành một chiến binh đáng kính đấy.\", \"rating\": 9.0},\n  {\"id\": 719478, \"suggestedTranslation\": \"Bệ hạ của ngươi.\", \"rating\": 9.0},\n  {\"id\": 719479, \"suggestedTranslation\": \"Nó đang ngủ say sưa.\", \"rating\": 9.0},\n  {\"id\": 719480, \"suggestedTranslation\": \"Chỗ trú ẩn của kẻ thù ta.\", \"rating\": 9.0},\n  {\"id\": 719481, \"suggestedTranslation\": \"Đã bị san bằng thành tro bụi.\", \"rating\": 9.0},\n  {\"id\": 719482, \"suggestedTranslation\": \"Mật hoa của các vị thần, dành cho các vị thần.\", \"rating\": 9.0},\n  {\"id\": 719483, \"suggestedTranslation\": \"Làm thế này không chọc giận các vị thần sao?\", \"rating\": 9.0},\n  {\"id\": 719484, \"suggestedTranslation\": \"Ruột đỏ đấy, nhưng mà chẳng phải thịt!\", \"rating\": 9.0},\n  {\"id\": 719485, \"suggestedTranslation\": \"Chỉ là một nắm hạt, dành cho thứ không phải thịt.\", \"rating\": 9.0},\n  {\"id\": 719486, \"suggestedTranslation\": \"Chuẩn bị trao đổi hàng hóa nào!\", \"rating\": 9.0},\n  {\"id\": 719487, \"suggestedTranslation\": \"Đúng là một con quái vật đội mũ phớt ngang tàng.\", \"rating\": 9.0},\n  {\"id\": 719488, \"suggestedTranslation\": \"Các vị thần có khẩu vị thật lạ lùng.\", \"rating\": 9.0},\n  {\"id\": 719489, \"suggestedTranslation\": \"Ach! Ta sẽ không ăn ngươi đâu!\", \"rating\": 9.0},\n  {\"id\": 719490, \"suggestedTranslation\": \"Chỉ là một nắm hạt, dành cho thứ không phải thịt.\", \"rating\": 9.0},\n  {\"id\": 719491, \"suggestedTranslation\": \"Ồ, lúa mì vinh quang!\", \"rating\": 9.0},\n  {\"id\": 719492, \"suggestedTranslation\": \"Chỉ là một nắm hạt, dành cho thứ không phải thịt.\", \"rating\": 9.0},\n  {\"id\": 719493, \"suggestedTranslation\": \"Nhảy vào miệng ta đi!\", \"rating\": 9.0},\n  {\"id\": 719494, \"suggestedTranslation\": \"Không thể trốn thoát đâu!\", \"rating\": 9.0},\n  {\"id\": 719495, \"suggestedTranslation\": \"Thật nực cười.\", \"rating\": 9.0},\n  {\"id\": 719496, \"suggestedTranslation\": \"Đến giờ biểu diễn rồi, lũ thỏ!\", \"rating\": 9.0},\n  {\"id\": 719497, \"suggestedTranslation\": \"Chắc là giờ giải lao của lũ thỏ rồi.\", \"rating\": 9.0},\n  {\"id\": 719498, \"suggestedTranslation\": \"Đáng đời lắm, củ cà rốt khổng lồ.\", \"rating\": 9.0},\n  {\"id\": 719499, \"suggestedTranslation\": \"Làm sao với một củ cà rốt to thế này đây?\", \"rating\": 9.0},\n  {\"id\": 719500, \"suggestedTranslation\": \"Lũ thỏ tốt nhất nên nghe theo tiếng gọi của ta.\", \"rating\": 9.0},\n  {\"id\": 719501, \"suggestedTranslation\": \"Lũ thỏ thề sẽ bảo vệ chiến lợi phẩm của ta bên trong hang của chúng.\", \"rating\": 9.0},\n  {\"id\": 719502, \"suggestedTranslation\": \"Ta sẽ gửi ngươi đến cánh đồng cà rốt vô tận.\", \"rating\": 9.0},\n  {\"id\": 719503, \"suggestedTranslation\": \"Việc bị sát hại bởi gạc thỏ sẽ là một sự sỉ nhục tuyệt vời dành cho kẻ thù của ta.\", \"rating\": 9.0},\n  {\"id\": 719504, \"suggestedTranslation\": \"Đáng yêu làm sao!\", \"rating\": 9.0},\n  {\"id\": 719505, \"suggestedTranslation\": \"Ta phải bắt sống nó!\", \"rating\": 9.0},\n  {\"id\": 719506, \"suggestedTranslation\": \"Chúa công nhỏ bé đang tìm kiếm giao thương!\", \"rating\": 9.0},\n  {\"id\": 719507, \"suggestedTranslation\": \"Áo giáp chống mưa.\", \"rating\": 9.0},\n  {\"id\": 719508, \"suggestedTranslation\": \"Chúng ta sẽ chiến đấu trong mưa.\", \"rating\": 9.0},\n  {\"id\": 719509, \"suggestedTranslation\": \"Thời kỳ tiên tri của nó đã chấm dứt.\", \"rating\": 9.0},\n  {\"id\": 719510, \"suggestedTranslation\": \"Nó tiên báo sự kéo đến của những cơn mưa.\", \"rating\": 9.0},\n  {\"id\": 719511, \"suggestedTranslation\": \"Một đống rau củ. Thôi khỏi cảm ơn.\", \"rating\": 9.0},\n  {\"id\": 719512, \"suggestedTranslation\": \"Một lưỡi dao nhỏ, nhưng dù sao vẫn là lưỡi dao.\", \"rating\": 9.0},\n  {\"id\": 719513, \"suggestedTranslation\": \"Thật tử tế khi ngăn không cho nó lọt vào tai đồng minh của ta.\", \"rating\": 9.0},\n  {\"id\": 719514, \"suggestedTranslation\": \"Đó là một bản ballad về vận may tốt lành!\", \"rating\": 9.0},\n  {\"id\": 719515, \"suggestedTranslation\": \"Âm nhạc là nguồn dinh dưỡng cho linh hồn ngươi!\", \"rating\": 9.0},\n  {\"id\": 719516, \"suggestedTranslation\": \"Hãy chơi một khúc ca chiến trận sôi động nào!\", \"rating\": 9.0},\n  {\"id\": 719517, \"suggestedTranslation\": \"Giai điệu của ngươi thật du dương làm sao.\", \"rating\": 9.0},\n  {\"id\": 719518, \"suggestedTranslation\": \"Những nhạc công chơi với niềm đam mê biết bao!\", \"rating\": 9.0},\n  {\"id\": 719519, \"suggestedTranslation\": \"Giai điệu của ngươi thật du dương làm sao.\", \"rating\": 9.0},\n  {\"id\": 719520, \"suggestedTranslation\": \"Nhịp độ đó chẳng khiến tim người ta đập rộn ràng vì phấn khích sao?\", \"rating\": 9.0},\n  {\"id\": 719521, \"suggestedTranslation\": \"Màn kết thúc đỉnh cao!\", \"rating\": 9.0},\n  {\"id\": 719522, \"suggestedTranslation\": \"Một khúc tình ca dành cho những hồn ma và ác quỷ.\", \"rating\": 9.0},\n  {\"id\": 719523, \"suggestedTranslation\": \"Âm nhạc là nguồn dinh dưỡng cho linh hồn ngươi!\", \"rating\": 9.0},\n  {\"id\": 719524, \"suggestedTranslation\": \"Âm nhạc là nguồn dinh dưỡng cho linh hồn ngươi!\", \"rating\": 9.0},\n  {\"id\": 719525, \"suggestedTranslation\": \"Nó rất nóng khi chạm vào.\", \"rating\": 9.0},\n  {\"id\": 719526, \"suggestedTranslation\": \"Một lá bùa may mắn để phòng chống màn đêm.\", \"rating\": 9.0},\n  {\"id\": 719527, \"suggestedTranslation\": \"Con mắt của Odin, hãy ban cho chúng ta sự khôn ngoan!\", \"rating\": 9.0},\n  {\"id\": 719528, \"suggestedTranslation\": \"Một lời chúc phúc cho vận may tốt lành!\", \"rating\": 9.0},\n  {\"id\": 719529, \"suggestedTranslation\": \"Dù ngon miệng hay không, ta cũng không muốn.\", \"rating\": 9.0},\n  {\"id\": 719530, \"suggestedTranslation\": \"Ta không muốn nó, nhưng thật mừng vì nó đã sống sót qua thử thách lửa.\", \"rating\": 9.0},\n  {\"id\": 719531, \"suggestedTranslation\": \"Ít ra nó có màu sắc đẹp mắt.\", \"rating\": 9.0},\n  {\"id\": 719532, \"suggestedTranslation\": \"Và hãy cứ nằm yên dưới đó đi!\", \"rating\": 9.0},\n  {\"id\": 719533, \"suggestedTranslation\": \"Đáng đời lắm.\", \"rating\": 9.0},\n  {\"id\": 719534, \"suggestedTranslation\": \"Hẹn gặp lại ở Asgard nhé, sậy ơi!\", \"rating\": 9.0},\n  {\"id\": 719535, \"suggestedTranslation\": \"Đúng là những khóm sậy kiên cường.\", \"rating\": 9.0},\n  {\"id\": 719536, \"suggestedTranslation\": \"Bị cắt gọt khi đang ở độ tuổi đẹp nhất.\", \"rating\": 9.0},\n  {\"id\": 719537, \"suggestedTranslation\": \"Bụi đã được nung thành một khối đặc.\", \"rating\": 9.0},\n  {\"id\": 719538, \"suggestedTranslation\": \"Ha! Mặt trời chẳng phải chiến binh nào nếu không thể xuyên thủng thứ này.\", \"rating\": 9.0},\n  {\"id\": 719539, \"suggestedTranslation\": \"Xứng đáng với Asgard.\", \"rating\": 9.0},\n lại {\"id\": 719540, \"suggestedTranslation\": \"Tro lại về với tro.\", \"rating\": 9.0},\n  {\"id\": 719541, \"suggestedTranslation\": \"Ta thích chiến đấu hơn là khoa học.\", \"rating\": 9.0},\n  {\"id\": 719542, \"suggestedTranslation\": \"Bụi lại về với bụi.\", \"rating\": 9.0},\n  {\"id\": 719543, \"suggestedTranslation\": \"Có lẽ khoa học có thể nâng cao kỹ năng chiến đấu của ta.\", \"rating\": 9.0},\n  {\"id\": 719544, \"suggestedTranslation\": \"Sức mạnh kỳ lạ của nó đã không thể bảo vệ nó khỏi lửa.\", \"rating\": 9.0},\n  {\"id\": 719545, \"suggestedTranslation\": \"Một thứ huyền bí.\", \"rating\": 9.0},\n  {\"id\": 719546, \"suggestedTranslation\": \"Sẽ không còn miếng thịt nào xuất hiện từ đây nữa!\", \"rating\": 9.0},\n  {\"id\": 719547, \"suggestedTranslation\": \"Đó là một cỗ máy ngớ ngẩn chuy