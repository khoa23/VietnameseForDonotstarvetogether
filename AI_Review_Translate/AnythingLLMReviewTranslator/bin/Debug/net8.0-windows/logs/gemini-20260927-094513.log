          {
            "text": "[\n  {\"id\": 719774, \"suggestedTranslation\": \"Đồng đội của ta!\", \"rating\": 9.0},\n  {\"id\": 719775, \"suggestedTranslation\": \"Sức mạnh của Thor đang tuôn chảy bên trong nó.\", \"rating\": 9.0},\n  {\"id\": 719776, \"suggestedTranslation\": \"Ta sẽ dùng cái này để mang theo những món thịt ngon lành!\", \"rating\": 9.0},\n  {\"id\": 719777, \"suggestedTranslation\": \"Chứa đầy dịch cay nồng.\", \"rating\": 9.0},\n  {\"id\": 719778, \"suggestedTranslation\": \"Mùi hăng của nó làm xộc mũi ta.\", \"rating\": 9.0},\n  {\"id\": 719779, \"suggestedTranslation\": \"Nó có vị mặn mòi của biển cả.\", \"rating\": 9.0},\n  {\"id\": 719780, \"suggestedTranslation\": \"Dòng nước ngọt ngào của kẻ thù.\", \"rating\": 9.0},\n  {\"id\": 719781, \"suggestedTranslation\": \"Gục ngã trong chiến trận, giống như bao kẻ trước nó.\", \"rating\": 9.0},\n  {\"id\": 719782, \"suggestedTranslation\": \"Tám chân mà vẫn không phải đối thủ của ta!\", \"rating\": 9.0},\n  {\"id\": 719783, \"suggestedTranslation\": \"Ta sẽ cho nó một trận đấu công bằng bằng cách chờ nó tỉnh giấc.\", \"rating\": 9.0},\n  {\"id\": 719784, \"suggestedTranslation\": \"Một vật tế thần tầm thường.\", \"rating\": 9.0},\n  {\"id\": 719785, \"suggestedTranslation\": \"Và đây sẽ không phải con nhện chết cuối cùng đâu.\", \"rating\": 9.0},\n  {\"id\": 719786, \"suggestedTranslation\": \"Nguyền rủa thật!\", \"rating\": 9.0},\n  {\"id\": 719787, \"suggestedTranslation\": \"Tiêu diệt chúng từ gốc rễ!\", \"rating\": 9.0},\n  {\"id\": 719788, \"suggestedTranslation\": \"Nhóc nhện đã tập tọng học nghệ thuật rồi cơ à?\", \"rating\": 9.0},\n  {\"id\": 719789, \"suggestedTranslation\": \"Dẫm nát chúng thì thật phí phạm những trận chiến trong tương lai.\", \"rating\": 9.0},\n  {\"id\": 719790, \"suggestedTranslation\": \"Được giật ra từ bụng của một con nhện bị hạ sát.\", \"rating\": 9.0},\n  {\"id\": 719791, \"suggestedTranslation\": \"Cách hoàn hảo để xâm nhập trại địch.\", \"rating\": 9.0},\n  {\"id\": 719792, \"suggestedTranslation\": \"Mạng nhện. Chẳng bao giờ là điềm lành cả.\", \"rating\": 9.0},\n  {\"id\": 719793, \"suggestedTranslation\": \"Mạng nhện. Chẳng bao giờ là điềm lành cả.\", \"rating\": 9.0},\n  {\"id\": 719794, \"suggestedTranslation\": \"Cuối cùng, một bài kiểm tra thực sự cho năng lực của ta.\", \"rating\": 9.0},\n  {\"id\": 719795, \"suggestedTranslation\": \"Mong ngươi được vinh danh trong ngọn lửa thiêu.\", \"rating\": 9.0},\n  {\"id\": 719796, \"suggestedTranslation\": \"Nơi đây an nghỉ một đối thủ xứng tầm.\", \"rating\": 9.0},\n  {\"id\": 719797, \"suggestedTranslation\": \"Được nghỉ ngơi là quyền của ngươi, chứ không phải cái sự tỉnh giấc chết tiệt này.\", \"rating\": 9.0},\n  {\"id\": 719798, \"suggestedTranslation\": \"Ngươi lén lút thật đấy!\", \"rating\": 9.0},\n  {\"id\": 719799, \"suggestedTranslation\": \"Ngươi là thầy thuốc của gia tộc mình à?\", \"rating\": 9.0},\n  {\"id\": 719800, \"suggestedTranslation\": \"Nó chỉ hợp với đám quái vật nhỏ nanh nọc thôi.\", \"rating\": 9.0},\n  {\"id\": 719801, \"suggestedTranslation\": \"Ta sẽ nghiền nát ngươi!\", \"rating\": 9.0},\n  {\"id\": 719802, \"suggestedTranslation\": \"Nó đã trút hơi thở cuối cùng.\", \"rating\": 9.0},\n  {\"id\": 719803, \"suggestedTranslation\": \"Chắc chắn là một trong những con quái vật của Hel rồi!\", \"rating\": 9.0},\n  {\"id\": 719804, \"suggestedTranslation\": \"Nó đang ngủ say.\", \"rating\": 9.0},\n  {\"id\": 719805, \"suggestedTranslation\": \"Nhóc nhện dùng nó để quản lý bầy đàn của mình.\", \"rating\": 9.0},\n  {\"id\": 719806, \"suggestedTranslation\": \"Con đó hung hăng phết.\", \"rating\": 9.0},\n  {\"id\": 719807, \"suggestedTranslation\": \"Chiến thắng lại thuộc về ta!\", \"rating\": 9.0},\n  {\"id\": 719808, \"suggestedTranslation\": \"Nhà vô địch của loài nhện. Vào chiến trận nào!\", \"rating\": 9.0},\n  {\"id\": 719809, \"suggestedTranslation\": \"Tấn công kẻ thù đang ngủ là hành vi hèn nhát.\", \"rating\": 9.0},\n  {\"id\": 719810, \"suggestedTranslation\": \"Nhào vô đây, hỡi những kẻ đi trên nước!\", \"rating\": 9.0},\n  {\"id\": 719811, \"suggestedTranslation\": \"Đó là một chiếc tù và chiến tranh của loài nhện.\", \"rating\": 9.0},\n  {\"id\": 719812, \"suggestedTranslation\": \"Ngươi sực nức mùi thất bại của chính mình.\", \"rating\": 9.0},\n  {\"id\": 719813, \"suggestedTranslation\": \"Thời gian chỉ làm món ăn này trở nên tởm lợm chứ chẳng khôn ngoan hơn đâu.\", \"rating\": 9.0},\n  {\"id\": 719814, \"suggestedTranslation\": \"Hãy yên nghỉ nhé, tinh linh ngọn lửa nhân hậu.\", \"rating\": 9.0},\n  {\"id\": 719815, \"suggestedTranslation\": \"Ta sẽ chiếu ánh sáng này đến bất cứ nơi nào ta muốn.\", \"rating\": 9.0},\n  {\"id\": 719816, \"suggestedTranslation\": \"Nó mang sức mạnh có thể bùng nổ...\", \"rating\": 9.0},\n  {\"id\": 719817, \"suggestedTranslation\": \"Hãy yên nghỉ nhé, tinh linh rừng xanh nhân hậu.\", \"rating\": 9.0},\n  {\"id\": 719818, \"suggestedTranslation\": \"Ta sẽ chiếu ánh sáng này đến bất cứ nơi nào ta muốn.\", \"rating\": 9.0},\n  {\"id\": 719819, \"suggestedTranslation\": \"Hãy yên nghỉ nhé, tinh linh sông ngòi nhân hậu.\", \"rating\": 9.0},\n  {\"id\": 719820, \"suggestedTranslation\": \"Ta sẽ chiếu ánh sáng này đến bất cứ nơi nào ta muốn.\", \"rating\": 9.0},\n  {\"id\": 719821, \"suggestedTranslation\": \"Nó soi sáng chuyến hành trình của ta qua làn nước đục ngầu.\", \"rating\": 9.0},\n  {\"id\": 719822, \"suggestedTranslation\": \"Lạnh lẽo như trái tim của một người khổng lồ băng.\", \"rating\": 9.0},\n  {\"id\": 719823, \"suggestedTranslation\": \"Nhìn kìa! Một gói quà từ Wotan!\", \"rating\": 9.0},\n  {\"id\": 719824, \"suggestedTranslation\": \"Tấn công từ xa không phải cách chiến đấu ưa thích của ta.\", \"rating\": 9.0},\n  {\"id\": 719825, \"suggestedTranslation\": \"Một cơn bão đau thương.\", \"rating\": 9.0},\n  {\"id\": 719826, \"suggestedTranslation\": \"Tránh xa đống lửa của ta ra!\", \"rating\": 9.0},\n  {\"id\": 719827, \"suggestedTranslation\": \"Chỉ là một chiếc bàn thôi.\", \"rating\": 9.0},\n  {\"id\": 719828, \"suggestedTranslation\": \"Chỉ là một chiếc bàn thôi.\", \"rating\": 9.0},\n  {\"id\": 719829, \"suggestedTranslation\": \"Tránh xa đống lửa của ta ra!\", \"rating\": 9.0},\n  {\"id\": 719830, \"suggestedTranslation\": \"Tảng đá trong hang.\", \"rating\": 9.0},\n  {\"id\": 719831, \"suggestedTranslation\": \"Đá tảng có chóp nhọn.\", \"rating\": 9.0},\n  {\"id\": 719832, \"suggestedTranslation\": \"Nó sống lại để chiến đấu thêm lần nữa!\", \"rating\": 9.0},\n  {\"id\": 719833, \"suggestedTranslation\": \"Đây không phải là một con quái vật vô tri!\", \"rating\": 9.0},\n  {\"id\": 719834, \"suggestedTranslation\": \"Một con ác ma được dệt nên từ màn đêm!\", \"rating\": 9.0},\n  {\"id\": 719835, \"suggestedTranslation\": \"Kẻ thù của kẻ thù là đồng minh của ta.\", \"rating\": 9.0},\n  {\"id\": 719836, \"suggestedTranslation\": \"Chúng ta lên đường tìm kiếm chiến lợi phẩm ẩn giấu thôi!\", \"rating\": 9.0},\n  {\"id\": 719837, \"suggestedTranslation\": \"Hành động đó không được tôn trọng cho lắm.\", \"rating\": 9.0},\n  {\"id\": 719838, \"suggestedTranslation\": \"Một sự tôn kính tò mò dành cho các vị thần.\", \"rating\": 9.0},\n  {\"id\": 719839, \"suggestedTranslation\": \"Chắc hẳn đó là Gunnar. Lũ rắn đã cướp mất đầu ông ấy.\", \"rating\": 9.0},\n  {\"id\": 719840, \"suggestedTranslation\": \"Nó được bao quanh bởi một bụi cây gai góc.\", \"rating\": 9.0},\n  {\"id\": 719841, \"suggestedTranslation\": \"Kẻ phản diện nay hóa anh hùng!\", \"rating\": 9.0},\n  {\"id\": 719842, \"suggestedTranslation\": \"Vẻ ngoài mỏng manh nhưng cứng như đá. Thật đáng ngưỡng mộ.\", \"rating\": 9.0},\n  {\"id\": 719843, \"suggestedTranslation\": \"Điều gì đang dằn vặt ngươi vậy, thiếu nữ xinh đẹp?\", \"rating\": 9.0},\n  {\"id\": 719844, \"suggestedTranslation\": \"Một chiến binh nhỏ bé kiên cường.\", \"rating\": 9.0},\n  {\"id\": 719845, \"suggestedTranslation\": \"Đó là một chậu đá!\", \"rating\": 9.0},\n  {\"id\": 719846, \"suggestedTranslation\": \"Nó hoàn toàn có thể đánh bại len thường trong chiến đấu.\", \"rating\": 9.0},\n  {\"id\": 719847, \"suggestedTranslation\": \"Cầu thần Njord dẫn đường cho chuyến hải trình của chúng ta.\", \"rating\": 9.0},\n  {\"id\": 719848, \"suggestedTranslation\": \"Một phần quan trọng của một chiến thuyền vĩ đại.\", \"rating\": 9.0},\n  {\"id\": 719849, \"suggestedTranslation\": \"Thanh kiếm trên lưng của một con ong.\", \"rating\": 9.0},\n  {\"id\": 719850, \"suggestedTranslation\": \"Một chiến binh thì không ngồi.\", \"rating\": 9.0},\n  {\"id\": 719851, \"suggestedTranslation\": \"Đứng dậy đi, lính túc trực!\", \"rating\": 9.0},\n  {\"id\": 719852, \"suggestedTranslation\": \"Chẳng có cảnh tượng nào đáng buồn hơn một chiếc bàn trống trơn. Đi cướp bóc thôi!\", \"rating\": 9.0},\n  {\"id\": 719853, \"suggestedTranslation\": \"Không phải chiến lợi phẩm ấn tượng gì cho cam.\", \"rating\": 9.0},\n  {\"id\": 719854, \"suggestedTranslation\": \"Chúng ta không bao giờ được quên những đồng đội đã ngã xuống.\", \"rating\": 9.0},\n  {\"id\": 719855, \"suggestedTranslation\": \"Hãy tiến lên và thu gom chiến lợi phẩm chiến tranh.\", \"rating\": 9.0},\n  {\"id\": 719856, \"suggestedTranslation\": \"Một chiếc mũ để hạ nhiệt sau một trận chiến ồn ào.\", \"rating\": 9.0},\n  {\"id\": 719857, \"suggestedTranslation\": \"Nhồi nhét rau củ thì nó cũng không biến thành thịt được đâu.\", \"rating\": 9.0},\n  {\"id\": 719858, \"suggestedTranslation\": \"Nó mang hương vị của thịt. Ta sẽ nếm thử một miếng thịt.\", \"rating\": 9.0},\n  {\"id\": 719859, \"suggestedTranslation\": \"Đây không phải là thức ăn.\", \"rating\": 9.0},\n  {\"id\": 719860, \"suggestedTranslation\": \"Nó sẽ trở thành vật phẩm dâng hiến xứng đáng nhất cho các vị thần!\", \"rating\": 9.0},\n  {\"id\": 719861, \"suggestedTranslation\": \"Mảng xanh tươi tốt.\", \"rating\": 9.0},\n  {\"id\": 719862, \"suggestedTranslation\": \"Một bữa tiệc cho đôi mắt của ta!\", \"rating\": 9.0},\n  {\"id\": 719863, \"suggestedTranslation\": \"Biết đâu đây là gói quà từ thần Venus thì sao?\", \"rating\": 9.0},\n  {\"id\": 719864, \"suggestedTranslation\": \"Khỉ thật! Khóa chặt quá!\", \"rating\": 9.0},\n  {\"id\": 719865, \"suggestedTranslation\": \"Khoảng trống dồi dào cho mồi của ta!\", \"rating\": 9.0},\n  {\"id\": 719866, \"suggestedTranslation\": \"Trụ cột cao quý này đã chịu đựng rất nhiều vì chúng ta.\", \"rating\": 9.0},\n  {\"id\": 719867, \"suggestedTranslation\": \"Chúng ta sẽ xây dựng lại!\", \"rating\": 9.0},\n  {\"id\": 719868, \"suggestedTranslation\": \"Một đài tưởng niệm hào hùng cho sự kiên cường của chúng ta!\", \"rating\": 9.0},\n  {\"id\": 719869, \"suggestedTranslation\": \"Trụ cột cao quý này đã chịu đựng rất nhiều vì chúng ta.\", \"rating\": 9.0},\n  {\"id\": 719870, \"suggestedTranslation\": \"Kẻ hùng mạnh nay cũng ngã ngựa.\", \"rating\": 9.0},\n  {\"id\": 719871, \"suggestedTranslation\": \"Thậm chí có thể chống lại cả Ragnarok.\", \"rating\": 9.0},\n  {\"id\": 719872, \"suggestedTranslation\": \"Việc xây dựng đã bắt đầu!\", \"rating\": 9.0},\n  {\"id\": 719873, \"suggestedTranslation\": \"Việc xây dựng đã bắt đầu!\", \"rating\": 9.0},\n  {\"id\": 719874, \"suggestedTranslation\": \"Không có gì hợp với thịt hơn là nhiều thịt hơn nữa!\", \"rating\": 9.0},\n  {\"id\": 719875, \"suggestedTranslation\": \"Đó là một chiếc áo lê đẹp, nhưng chẳng có chút khả năng phòng thủ nào cả.\", \"rating\": 9.0},\n  {\"id\": 719876, \"suggestedTranslation\": \"Kẹo dẻo trên thịt... quả là một sự lựa chọn kỳ lạ, nhưng không hiểu sao lại ngon phết!\", \"rating\": 9.0},\n  {\"id\": 719877, \"suggestedTranslation\": \"Một chiến binh không tham gia \\\"giờ uống trà\\\".\", \"rating\": 9.0},\n  {\"id\": 719878, \"suggestedTranslation\": \"Liệu ta có xứng đáng cầm một vũ khí rực rỡ đến thế không?\", \"rating\": 9.0},\n  {\"id\": 719879, \"suggestedTranslation\": \"Nó đã bị lửa thiêu rụi.\", \"rating\": 9.0},\n  {\"id\": 719880, \"suggestedTranslation\": \"Một bàn tiệc xứng tầm Valhalla!\", \"rating\": 9.0},\n  {\"id\": 719881, \"suggestedTranslation\": \"Bữa tiệc xứng đáng cho Đại sảnh đường!\", \"rating\": 9.0},\n  {\"id\": 719882, \"suggestedTranslation\": \"Nó không xứng đáng có một chỗ ở đây.\", \"rating\": 9.0},\n  {\"id\": 719883, \"suggestedTranslation\": \"Một thợ săn khôn ngoan luôn đối xử cẩn trọng với công cụ của họ.\", \"rating\": 9.0},\n  {\"id\": 719884, \"suggestedTranslation\": \"Cuốn cuộn giấy này mang những bí mật câu cá ẩn giấu!\", \"rating\": 9.0},\n  {\"id\": 719885, \"suggestedTranslation\": \"Ta sẽ tạo ra một thứ vũ khí câu cá có một không hai!\", \"rating\": 9.0},\n  {\"id\": 719886, \"suggestedTranslation\": \"Câu chuyện về viên kẹo bơ cứng này sẽ được kể mãi.\", \"rating\": 9.0},\n  {\"id\": 719887, \"suggestedTranslation\": \"Một loài chim đáng sợ! Nhưng ta không hề sợ hãi.\", \"rating\": 9.0},\n  {\"id\": 719888, \"suggestedTranslation\": \"Nó sẽ lớn lên thành một đối thủ đáng gờm.\", \"rating\": 9.0},\n  {\"id\": 719889, \"suggestedTranslation\": \"Là mày hoặc tao thôi, chú chim ạ.\", \"rating\": 9.0},\n  {\"id\": 719890, \"suggestedTranslation\": \"Trứng này mà sống sót qua mùa đông phương Bắc thì hơi phí.\", \"rating\": 9.0},\n  {\"id\": 719891, \"suggestedTranslation\": \"Tự phá kén mà chui ra đi, chú chim!\", \"rating\": 9.0},\n  {\"id\": 719892, \"suggestedTranslation\": \"Sinh ra từ ngọn lửa! Trừ khi nó bị nấu chín đến chết.\", \"rating\": 9.0},\n  {\"id\": 719893, \"suggestedTranslation\": \"Còn một khoảng thời gian nữa chú chim này mới chào đời.\", \"rating\": 9.0},\n  {\"id\": 719894, \"suggestedTranslation\": \"Nó sẽ sớm tỉnh giấc chào thế giới này.\", \"rating\": 9.0},\n  {\"id\": 719895, \"suggestedTranslation\": \"Một chiến binh có lông đang ẩn nấp bên trong.\", \"rating\": 9.0},\n  {\"id\": 719896, \"suggestedTranslation\": \"Một chú chim chiến non nớt sẽ sớm chào đời.\", \"rating\": 9.0},\n  {\"id\": 719897, \"suggestedTranslation\": \"Bữa sáng tuyệt hảo của một chiến binh!\", \"rating\": 9.0},\n  {\"id\": 719898, \"suggestedTranslation\": \"Ố ho! Chiếc vỏ bánh mì này che giấu một miếng thịt tẩm gia vị!\", \"rating\": 9.0},\n  {\"id\": 719899, \"suggestedTranslation\": \"Ngươi chưa sẵn sàng ra trận đâu, chú chim ạ.\", \"rating\": 9.0},\n  {\"id\": 719900, \"suggestedTranslation\": \"Ta hy vọng ngươi thích rau... còn thịt là của ta.\", \"rating\": 9.0},\n  {\"id\": 719901, \"suggestedTranslation\": \"Nó đang tích tụ sức mạnh.\", \"rating\": 9.0},\n  {\"id\": 719902, \"suggestedTranslation\": \"Lao vào chiến đấu với ta là lựa chọn của ngươi đấy, chú chim ạ.\", \"rating\": 9.0},\n  {\"id\": 719903, \"suggestedTranslation\": \"Nó cần ngọc tím.\", \"rating\": 9.0},\n  {\"id\": 719904, \"suggestedTranslation\": \"Nó sẽ khai thác tốc độ tuyệt đỉnh của ta.\", \"rating\": 9.0},\n  {\"id\": 719905, \"suggestedTranslation\": \"Tiến tới Asgard!\", \"rating\": 9.0},\n  {\"id\": 719906, \"suggestedTranslation\": \"Cây cầu dẫn đến thế giới khác.\", \"rating\": 9.0},\n  {\"id\": 719907, \"suggestedTranslation\": \"Cây cầu vẫn chưa ổn định.\", \"rating\": 9.0},\n  {\"id\": 719908, \"suggestedTranslation\": \"Cây cầu vẫn chưa hoàn thiện.\", \"rating\": 9.0},\n  {\"id\": 719909, \"suggestedTranslation\": \"Có lẽ nó chứa đựng bí mật về Bifrost của vùng đất này.\", \"rating\": 9.0},\n  {\"id\": 719910, \"suggestedTranslation\": \"Một tay quay chắc chắn.\", \"rating\": 9.0},\n  {\"id\": 719911, \"suggestedTranslation\": \"Thật kém sang. Thậm chí đó còn chẳng phải thịt kim loại.\", \"rating\": 9.0},\n  {\"id\": 719912, \"suggestedTranslation\": \"Nó có vẻ giống với Bifrost.\", \"rating\": 9.0},\n  {\"id\": 719913, \"suggestedTranslation\": \"Lướt qua bầu trời và biển cả!\", \"rating\": 9.0},\n  {\"id\": 719914, \"suggestedTranslation\": \"Nó đã bị san phẳng.\", \"rating\": 9.0},\n  {\"id\": 719915, \"suggestedTranslation\": \"Ngủ đêm nay, và chuẩn bị chiến đấu vào ngày mai.\", \"rating\": 9.0},\n  {\"id\": 719916, \"suggestedTranslation\": \"Trông nó dữ dội đấy. Xông vào trận chiến nào!\", \"rating\": 9.0},\n  {\"id\": 719917, \"suggestedTranslation\": \"Nhớt nhát, nhưng nguy hiểm. Ta thích thế.\", \"rating\": 9.0},\n  {\"id\": 719918, \"suggestedTranslation\": \"Một lớp da dai.\", \"rating\": 9.0},\n  {\"id\": 719919, \"suggestedTranslation\": \"Ta sẽ đâm ngọn giáo của mình vào đống xúc tu đó!\", \"rating\": 9.0},\n  {\"id\": 719920, \"suggestedTranslation\": \"Một kẻ thù xúc tu cao lớn.\", \"rating\": 9.0},\n  {\"id\": 719921, \"suggestedTranslation\": \"Một phần phụ gớm ghiếc, đang quơ quào.\", \"rating\": 9.0},\n  {\"id\": 719922, \"suggestedTranslation\": \"Hang ổ của kẻ thù cao nhất của ta!\", \"rating\": 9.0},\n  {\"id\": 719923, \"suggestedTranslation\": \"Bifrost đã bị phong ấn, nhưng được bao lâu?\", \"rating\": 9.0},\n  {\"id\": 719924, \"suggestedTranslation\": \"Thứ gì đó tồi tệ đã chiếm quyền kiểm soát...\", \"rating\": 9.0},\n  {\"id\": 719925, \"suggestedTranslation\": \"Nhìn kìa! Sự vĩ đại của Bifrost!!\", \"rating\": 9.0},\n  {\"id\": 719926, \"suggestedTranslation\": \"Ta có thể cảm nhận được sự ấm áp của Bifrost từ bên trong nó!\", \"rating\": 9.0},\n  {\"id\": 719927, \"suggestedTranslation\": \"Con quái vật sẽ không thể khủng bố cõi này lần nữa đâu!\", \"rating\": 9.0},\n  {\"id\": 719928, \"suggestedTranslation\": \"Có thứ gì đó đang đến gần...\", \"rating\": 9.0},\n  {\"id\": 719929, \"suggestedTranslation\": \"Đã bị ngọn lửa thiêu rụi.\", \"rating\": 9.0},\n  {\"id\": 719930, \"suggestedTranslation\": \"Đó sẽ là nơi tuyệt vời để cất giữ vũ khí của ta.\", \"rating\": 9.0},\n  {\"id\": 719931, \"suggestedTranslation\": \"Mắt ta hoa lên à? Cái rương đang tỏa ra thứ ánh sáng lởm chởm kìa!\", \"rating\": 9.0},\n  {\"id\": 719932, \"suggestedTranslation\": \"Chất liệu này sở hữu sức mạnh khổng lồ!\", \"rating\": 9.0},\n  {\"id\": 719933, \"suggestedTranslation\": \"Ngay cả con mồi nhỏ nhất cũng đừng mong trốn thoát.\", \"rating\": 9.0},\n  {\"id\": 719934, \"suggestedTranslation\": \"Trông giống như hạt ngô nổ bóng bẩy.\", \"rating\": 9.0},\n  {\"id\": 719935, \"suggestedTranslation\": \"Đó là mồi nhử người khổng lồ băng của Loki.\", \"rating\": 9.0},\n  {\"id\": 719936, \"suggestedTranslation\": \"Khỉ thật! Chúng ta sẽ bắt đầu cuộc săn này mà không có sự trợ giúp của ngươi.\", \"rating\": 9.0},\n  {\"id\": 719937, \"suggestedTranslation\": \"Một con mãnh thú xứng đáng với chiếc vương miện của nó. Nó sẽ dẫn chúng ta đến chiến thắng!\", \"rating\": 9.0},\n  {\"id\": 719938, \"suggestedTranslation\": \"Chúng ta không đủ nhanh nhẹn.\", \"rating\": 9.0},\n  {\"id\": 719939, \"suggestedTranslation\": \"Ngươi có cảm nhận được sự hiện diện của một con quái vật nhỏ quanh đây không?\", \"rating\": 9.0},\n  {\"id\": 719940, \"suggestedTranslation\": \"Dường như chẳng có con quái nhỏ nào quanh đây cả.\", \"rating\": 9.0},\n  {\"id\": 719941, \"suggestedTranslation\": \"Vinh quang thuộc về ngươi, mãnh thú hùng mạnh!\", \"rating\": 9.0},\n  {\"id\": 719942, \"suggestedTranslation\": \"Chắc chúng ở quá xa nên nó không đánh hơi được mùi.\", \"rating\": 9.0},\n  {\"id\": 719943, \"suggestedTranslation\": \"Nó đang vào việc rồi!\", \"rating\": 9.0},\n  {\"id\": 719944, \"suggestedTranslation\": \"Nó đang đánh hơi vụ khác rồi!\", \"rating\": 9.0},\n  {\"id\": 719945, \"suggestedTranslation\": \"Biến khỏi tầm mắt ta đi, loài cỏ dại hèn nhát!\", \"rating\": 9.0},\n  {\"id\": 719946, \"suggestedTranslation\": \"Hừm, hóa ra cái thứ cỏ dại quái quỷ đó cũng có ích đấy chứ.\", \"rating\": 9.0},\n  {\"id\": 719947, \"suggestedTranslation\": \"Nó sẽ trở thành vật phẩm dâng hiến xứng đáng nhất cho các vị thần!\", \"rating\": 9.0},\n  {\"id\": 719948, \"suggestedTranslation\": \"Ha! Cuối cùng cũng tìm được đối thủ xứng tầm!\", \"rating\": 9.0},\n  {\"id\": 719949, \"suggestedTranslation\": \"Cứ tung hết chiêu đi, ta sẽ không nương tay đâu!\", \"rating\": 9.0},\n  {\"id\": 719950, \"suggestedTranslation\": \"Một khe nứt trên mặt đất.\", \"rating\": 9.0},\n  {\"id\": 719951, \"suggestedTranslation\": \"Ngươi sẽ phải khuất phục trước lưỡi kiếm của ta, cóc nấm ạ!\", \"rating\": 9.0},\n  {\"id\": 719952, \"suggestedTranslation\": \"Có thứ gì đó đang trồi lên!\", \"rating\": 9.0},\n  {\"id\": 719953, \"suggestedTranslation\": \"Nó đừng hòng bước qua môi ta!\", \"rating\": 9.0},\n  {\"id\": 719954, \"suggestedTranslation\": \"Nó khoe ruột đỏ au, thế mà chẳng phải thịt!\", \"rating\": 9.0},\n  {\"id\": 719955, \"suggestedTranslation\": \"Nó chỉ hợp để ném thôi.\", \"rating\": 9.0},\n  {\"id\": 719956, \"suggestedTranslation\": \"Chỉ là một nhúm hạt giống dành cho món không phải thịt.\", \"rating\": 9.0},\n  {\"id\": 719957, \"suggestedTranslation\": \"Nó không hợp với trang phục của ta.\", \"rating\": 9.0},\n  {\"id\": 719958, \"suggestedTranslation\": \"Nó đã bị nhúng tay bởi ma thuật hắc ám.\", \"rating\": 9.0},\n  {\"id\": 719959, \"suggestedTranslation\": \"Hoàn hảo cho một cuộc tập kích ban đêm.\", \"rating\": 9.0},\n  {\"id\": 719960, \"suggestedTranslation\": \"Bánh nướng đã lấy lại được danh dự!\", \"rating\": 9.0},\n  {\"id\": 719961, \"suggestedTranslation\": \"Bằng sức mạnh của cát!\", \"rating\": 9.0},\n  {\"id\": 719962, \"suggestedTranslation\": \"Để đỡ đần cho chuyến đi của đồng minh.\", \"rating\": 9.0},\n  {\"id\": 719963, \"suggestedTranslation\": \"Ta sẽ rời bỏ cái nơi quái quỷ này!\", \"rating\": 9.0},\n  {\"id\": 719964, \"suggestedTranslation\": \"Một món quà từ vị sư tử dũng mãnh!\", \"rating\": 9.0},\n  {\"id\": 719965, \"suggestedTranslation\": \"Thịt của quả hạch không phải là thịt thật.\", \"rating\": 9.0},\n  {\"id\": 719966, \"suggestedTranslation\": \"Hãy chiến đấu thật vinh quang!\", \"rating\": 9.0},\n  {\"id\": 719967, \"suggestedTranslation\": \"Một kỳ quan khoa học.\", \"rating\": 9.0},\n  {\"id\": 719968, \"suggestedTranslation\": \"Một chiếc bẫy được chế tạo tốt. Tối nay chúng ta mở tiệc lớn!\", \"rating\": 9.0},\n  {\"id\": 719969, \"suggestedTranslation\": \"Một cái bẫy cực kỳ khôn ngoan để đối phó với kẻ thù.\", \"rating\": 9.0},\n  {\"id\": 719970, \"suggestedTranslation\": \"Ngọn lửa của nó đã tắt.\", \"rating\": 9.0},\n  {\"id\": 719971, \"suggestedTranslation\": \"Một chiến binh luôn luôn sẵn sàng.\", \"rating\": 9.0},\n  {\"id\": 719972, \"suggestedTranslation\": \"Khốn cho ngón chân của bất kỳ kẻ nào dám truy đuổi ta!\", \"rating\": 9.0},\n  {\"id\": 719973, \"suggestedTranslation\": \"Kẻ thù của ta sẽ phải hối hận vì dám qua mặt ta... hoặc qua mặt thứ đó.\", \"rating\": 9.0},\n  {\"id\": 719974, \"suggestedTranslation\": \"Ta sẽ không bị hạ gục dễ dàng thế đâu.\", \"rating\": 9.0},\n  {\"id\": 719975, \"suggestedTranslation\": \"Bản năng chiến binh của ta trỗi dậy - nhưng tại sao chứ!\", \"rating\": 9.0},\n  {\"id\": 719976, \"suggestedTranslation\": \"Một cái bẫy đầy hiểm độc.\", \"rating\": 9.0},\n  {\"id\": 719977, \"suggestedTranslation\": \"Thật lãng phí một cây chùy xuất sắc khi vùi sâu dưới đất.\", \"rating\": 9.0},\n  {\"id\": 719978, \"suggestedTranslation\": \"Các bức tường của nó đã bị lửa thiêu rụi.\", \"rating\": 9.0},\n  {\"id\": 719979, \"suggestedTranslation\": \"Nơi cất giấu mũ giáp và giáo của ta trong lúc nghỉ ngơi.\", \"rating\": 9.0},\n  {\"id\": 719980, \"suggestedTranslation\": \"Đủ chỗ chứa cả một kho vũ khí!\", \"rating\": 9.0},\n  {\"id\": 719981, \"suggestedTranslation\": \"Ta luôn trong tư thế sẵn sàng.\", \"rating\": 9.0},\n  {\"id\": 719982, \"suggestedTranslation\": \"Đường cùng rồi! Ta phải đứng lên chiến đấu.\", \"rating\": 9.0},\n  {\"id\": 719983, \"suggestedTranslation\": \"Một vật tế dâng lên những cái cây, mong chúng chuyển nó đến tận Yggdrasil vĩ đại.\", \"rating\": 9.0},\n  {\"id\": 71984, \"suggestedTranslation\": \"Ngọn lửa đang nuốt chửng cây non cao quý! Phải, khúc ca cuối cùng của nó sắp hạ màn rồi.\", \"rating\": 9.0},\n  {\"id\": 719985, \"suggestedTranslation\": \"Giờ thì chiến lợi phẩm đã chín muồi để thu hoạch.\", \"rating\": 9.0},\n  {\"id\": 719986, \"suggestedTranslation\": \"Cây non cứng cáp này quả là một nhà vô địch vĩ đại, khi đang cõng trên mình một tảng đá đủ sức nghiền nát những kẻ thù yếu đuối hơn!\", \"rating\": 9.0},\n  {\"id\": 719987, \"suggestedTranslation\": \"Một mầm xanh có chút giá trị, hoặc truyền thuyết là thế.\", \"rating\": 9.0},\n  {\"id\": 719988, \"suggestedTranslation\": \"Người ta nói hạt giống khiêm tốn này mang tiềm năng to lớn.\", \"rating\": 9.0},\n  {\"id\": 719989, \"suggestedTranslation\": \"Ta sẽ san bằng kẻ thù bằng món vũ khí của Poseidon!\", \"rating\": 9.0},\n  {\"id\": 719990, \"suggestedTranslation\": \"Đồ chơi không làm cho một chiến binh vĩ đại như ta bận tâm.\", \"rating\": 9.0},\n  {\"id\": 719991, \"suggestedTranslation\": \"Một vật kỷ niệm chiến thắng.\", \"rating\": 9.0},\n  {\"id\": 719992, \"suggestedTranslation\": \"Một chiến binh khoác giáp. Ta nghe nói nó tên là \\\"Hal\\\".\", \"rating\": 9.0},\n  {\"id\": 719993, \"suggestedTranslation\": \"Tàn tích từ bùa chú của quý cô Wicker? Quả là một người phụ nữ dữ dội.\", \"rating\": 9.0},\n  {\"id\": 719994, \"suggestedTranslation\": \"Một người phụ nữ nhỏ bé, kỳ quặc.\", \"rating\": 9.0},\n  {\"id\": 719995, \"suggestedTranslation\": \"Trà là thứ xa xỉ mà chiến binh không thể kham nổi.\", \"rating\": 9.0},\n  {\"id\": 719996, \"suggestedTranslation\": \"Một chiến binh cao quý.\", \"rating\": 9.0},\n  {\"id\": 719997, \"suggestedTranslation\": \"Một chiến binh cao quý.\", \"rating\": 9.0},\n  {\"id\": 719998, \"suggestedTranslation\": \"Một thứ vũ khí tồi.\", \"rating\": 9.0},\n  {\"id\": 719999, \"suggestedTranslation\": \"Ta phải chỉ bảo cho kẻ trẻ tuổi về chiến thuật chiến đấu.\", \"rating\": 9.0},\n  {\"id\": 720000, \"suggestedTranslation\": \"Một món đồ chơi vô tích sự.\", \"rating\": 9.0},\n  {\"id\": 720001, \"suggestedTranslation\": \"Khúc đệm cho bản trường ca chiến thắng của ta.\", \"rating\": 9.0},\n  {\"id\": 720002, \"suggestedTranslation\": \"Cuối cùng cũng có một két sắt an toàn để đấu kiếm cùng các đồng minh mới.\", \"rating\": 9.0},\n  {\"id\": 720003, \"suggestedTranslation\": \"Dụng cụ nấu nướng không làm ta hứng thú.\", \"rating\": 9.0},\n  {\"id\": 720004, \"suggestedTranslation\": \"Nó không chịu nổi sự khắc nghiệt của chiến trận đâu.\", \"rating\": 9.0},\n  {\"id\": 720005, \"suggestedTranslation\": \"Không hữu dụng bằng tù và chiến trận.\", \"rating\": 9.0},\n  {\"id\": 720006, \"suggestedTranslation\": \"Ban cho ta may mắn trên chiến trường!\", \"rating\": 9.0},\n  {\"id\": 720007, \"suggestedTranslation\": \"Có lẽ mùi hôi thối sẽ xua đuổi được kẻ thù.\", \"rating\": 9.0},\n  {\"id\": 720008, \"suggestedTranslation\": \"Các đồng minh của ta sẽ trân trọng bài học sinh tồn mà ta vừa truyền đạt.\", \"rating\": 9.0},\n  {\"id\": 720009, \"suggestedTranslation\": \"Đoạn dây yếu ớt, mỏng manh này nhắc nhở ta... phải tôi luyện Maxwell cho cứng cáp lên mới được!\", \"rating\": 9.0},\n  {\"id\": 720010, \"suggestedTranslation\": \"Ngay cả kẻ yếu đuối cũng có thể tham gia trận chiến vĩ đại trên bàn cờ.\", \"rating\": 9.0},\n  {\"id\": 720011, \"suggestedTranslation\": \"Ngay cả kẻ yếu đuối cũng có thể tham gia trận chiến vĩ đại trên bàn cờ.\", \"rating\": 9.0},\n  {\"id\": 720012, \"suggestedTranslation\": \"Ngay cả ngọn giáo của ta cũng không thể gỡ nổi nút thắt này.\", \"rating\": 9.0},\n  {\"id\": 720013, \"suggestedTranslation\": \"Đó không phải kỳ lân.\", \"rating\": 9.0},\n  {\"id\": 720014, \"suggestedTranslation\": \"Đó không phải kỳ lân.\", \"rating\": 9.0},\n  {\"id\": 720015, \"suggestedTranslation\": \"Hãy hé lộ định mệnh của ta đi, hỡi các nữ thần vận mệnh vĩ đại!\", \"rating\": 9.0},\n  {\"id\": 720016, \"suggestedTranslation\": \"Sinh vật lạ đã bị giam cầm vĩnh viễn trên chiếc nhẫn.\", \"rating\": 9.0},\n  {\"id\": 720017, \"suggestedTranslation\": \"Biến đi, ma thuật tồi tệ!\", \"rating\": 9.0},\n  {\"id\": 720018, \"suggestedTranslation\": \"Chắc chắn đó là một thứ độc dược.\", \"rating\": 9.0},\n  {\"id\": 720019, \"suggestedTranslation\": \"Bằng chứng về sự tồn tại của thây ma. Hãy cảnh giác, các đồng minh của ta!\", \"rating\": 9.0},\n  {\"id\": 720020, \"suggestedTranslation\": \"Để xua đuổi bầy tôi của Loki.\", \"rating\": 9.0},\n  {\"id\": 720021, \"suggestedTranslation\": \"Có một thế giới nhỏ bé bị giam giữ bên trong!\", \"rating\": 9.0},\n  {\"id\": 720022, \"suggestedTranslation\": \"Vũ trang lên nào! Khiêu chiến đã được đưa ra!\", \"rating\": 9.0},\n  {\"id\": 720023, \"suggestedTranslation\": \"Một người đàn ông nhỏ bé, kỳ quặc.\", \"rating\": 9.0},\n  {\"id\": 720024, \"suggestedTranslation\": \"Ta chẳng có chút nhu cầu nào với thứ này.\", \"rating\": 9.0},\n  {\"id\": 720025, \"suggestedTranslation\": \"Biết đâu có loại thần dược nào đó ẩn giấu bên trong?\", \"rating\": 9.0},\n  {\"id\": 720026, \"suggestedTranslation\": \"Đây chẳng phải là đối thủ xứng tầm với ta.\", \"rating\": 9.0},\n  {\"id\": 720027, \"suggestedTranslation\": \"Đây là loại sinh vật nào thế nhỉ?\", \"rating\": 9.0},\n  {\"id\": 720028, \"suggestedTranslation\": \"Nó đã gục ngã trong chiến trận.\", \"rating\": 9.0},\n  {\"id\": 720029, \"suggestedTranslation\": \"Ngươi có thể kể những câu chuyện gì đây, linh hồn bị giam cầm?\", \"rating\": 9.0},\n  {\"id\": 720030, \"suggestedTranslation\": \"Đúng là một cỗ máy đáng ngờ!\", \"rating\": 9.0},\n  {\"id\": 720031, \"suggestedTranslation\": \"Nó sẽ đưa ta đến Asgard chứ?\", \"rating\": 9.0},\n  {\"id\": 720032, \"suggestedTranslation\": \"Công nghệ vô dụng.\", \"rating\": 9.0},\n  {\"id\": 720033, \"suggestedTranslation\": \"Không có thời gian chơi đùa! Ta phải huấn luyện các đồng minh mới!\", \"rating\": 9.0},\n  {\"id\": 720034, \"suggestedTranslation\": \"Dùng tạm làm vũ khí khi túng quẫn thì cũng ổn phết.\", \"rating\": 9.0},\n  {\"id\": 720035, \"suggestedTranslation\": \"Chẳng thể làm ra bộ giáp tử tế nào từ mấy thứ này được.\", \"rating\": 9.0},\n  {\"id\": 720036, \"suggestedTranslation\": \"Lạy các vị thần, cái chậu cá đó đang bốc cháy kìa!\", \"rating\": 9.0},\n  {\"id\": 720037, \"suggestedTranslation\": \"Chẳng còn lại gì ngoài tro tàn.\", \"rating\": 9.0},\n  {\"id\": 72