,\n  {\"id\": 719163, \"suggestedTranslation\": \"Ngươi dám nhổ nước bọt vào một chiến binh Viking à?\", \"rating\": 8.5},\n  {\"id\": 719164, \"suggestedTranslation\": \"Nó đã được tôi luyện bởi biển cả.\", \"rating\": 8.5},\n  {\"id\": 719165, \"suggestedTranslation\": \"Mong rằng rễ của cây thế giới sẽ vươn xa và rộng khắp!\", \"rating\": 8.5},\n  {\"id\": 719166, \"suggestedTranslation\": \"Cái cây kia sẽ che chở chúng ta khỏi ánh mặt trời độc ác.\", \"rating\": 8.5},\n  {\"id\": 719167, \"suggestedTranslation\": \"Những sợi dây thừng rủ xuống từ cành của Yggdrasil.\", \"rating\": 8.5},\n  {\"id\": 719168, \"suggestedTranslation\": \"Tổ của loài quái vật đi trên mặt nước!\", \"rating\": 8.5},\n  {\"id\": 719169, \"suggestedTranslation\": \"Đã bị ngọn lửa thiêu rụi.\", \"rating\": 8.5},\n  {\"id\": 719170, \"suggestedTranslation\": \"Chiến lợi phẩm từ biển!\", \"rating\": 8.5},\n  {\"id\": 719171, \"suggestedTranslation\": \"Ồ, xoáy nước tươi đẹp. Chúng ta hãy cùng chèo vào cái miệng đói khát của ngươi nào.\", \"rating\": 8.5},\n  {\"id\": 719172, \"suggestedTranslation\": \"Njord đã ban ơn phước của ngài cho chúng ta!\", \"rating\": 8.5},\n  {\"id\": 719173, \"suggestedTranslation\": \"Trời ạ! Món thịt biển đã trốn thoát khỏi chúng ta rồi!\", \"rating\": 8.5}\n]",
