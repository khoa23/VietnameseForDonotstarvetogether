            "text": "[\n  {\"id\":720674,\"suggestedTranslation\":\"Thứ yếu ớt này cần trò chuyện để lớn sao? Người Viking phát triển mạnh trong sự im lặng khắc kỷ!\",\"rating\":8.5},\n  {\"id\":720675,\"suggestedTranslation\":\"Nó có vẻ ôm hận với họ hàng cỏ dại của mình.\",\"rating\":8.5},\n  {\"id\":720676,\"suggestedTranslation\":\"Nó đang khát nước.\",\"rating\":8.5},\n  {\"id\":720677,\"suggestedTranslation\":\"Ngươi không hài lòng với đất mình có à? Đừng mong ta giúp ngươi!\",\"rating\":8.5},\n  {\"id\":720678,\"suggestedTranslation\":\"Mảnh đất nhỏ này không thể nuôi nổi từng ấy thứ không phải thịt.\",\"rating\":8.5},\n  {\"id\":720679,\"suggestedTranslation\":\"Nó không đủ khả năng chống chọi với thời tiết theo mùa.\",\"rating\":8.5},\n  {\"id\":720680,\"suggestedTranslation\":\"Nó đang chịu đủ loại khổ sở.\",\"rating\":8.5},\n  {\"id\":720681,\"suggestedTranslation\":\"Ngọn lửa sẽ sớm thiêu rụi nó thôi.\",\"rating\":8.5},\n  {\"id\":720682,\"suggestedTranslation\":\"Quá tối, ngay cả cho việc chiến đấu.\",\"rating\":8.5},\n  {\"id\":720683,\"suggestedTranslation\":\"Cả xương lẫn thịt.\",\"rating\":8.5},\n  {\"id\":720684,\"suggestedTranslation\":\"Nó nếm y như thịt gà ấy!\",\"rating\":8.5},\n  {\"id\":720685,\"suggestedTranslation\":\"Vị thần bầu trời đã nổi giận!\",\"rating\":8.5},\n  {\"id\":720686,\"suggestedTranslation\":\"Khổ nỗi! Phải chi ta chộp lấy nó sớm hơn.\",\"rating\":8.5},\n  {\"id\":720687,\"suggestedTranslation\":\"Nó vốn không có duyên thành bữa ăn.\",\"rating\":8.5},\n  {\"id\":720688,\"suggestedTranslation\":\"Chúng ta sẽ sống để chiến đấu vào ngày mai!\",\"rating\":8.5},\n  {\"id\":720689,\"suggestedTranslation\":\"chỉ_dùng_bởi_wendy\",\"rating\":9.0},\n  {\"id\":720690,\"suggestedTranslation\":\"Ta tưởng mình vừa thấy tên lang băm có lông vũ đó quanh đây chứ...\",\"rating\":8.5},\n  {\"id\":720691,\"suggestedTranslation\":\"Nó trống không.\",\"rating\":8.5},\n  {\"id\":720692,\"suggestedTranslation\":\"Có vẻ như hắn còn nhiều việc quan trọng hơn phải giải quyết.\",\"rating\":8.5},\n  {\"id\":720693,\"suggestedTranslation\":\"Có vẻ chúng ta đang thiếu người tham gia.\",\"rating\":8.5},\n  {\"id\":720694,\"suggestedTranslation\":\"Môi trường này không thích hợp cho một trò chơi công bằng.\",\"rating\":8.5},\n  {\"id\":720695,\"suggestedTranslation\":\"Giờ chơi kết thúc rồi.\",\"rating\":8.5},\n  {\"id\":720696,\"suggestedTranslation\":\"Ta sẽ phải tìm chìa khóa thôi.\",\"rating\":8.5},\n  {\"id\":720697,\"suggestedTranslation\":\"Không, thế thì buồn cười lắm.\",\"rating\":8.5},\n  {\"id\":720698,\"suggestedTranslation\":\"Cuối cùng cũng xong. Có vẻ đám chim đã giải tán rồi.\",\"rating\":8.5},\n  {\"id\":720699,\"suggestedTranslation\":\"chỉ_dùng_bởi_wurt\",\"rating\":9.0},\n  {\"id\":720700,\"suggestedTranslation\":\"Đồ đồng nát người máy.\",\"rating\":8.5},\n  {\"id\":720701,\"suggestedTranslation\":\"Đó chẳng phải việc của con cóc nhỏ sao?\",\"rating\":8.5},\n  {\"id\":720702,\"suggestedTranslation\":\"Willow, con gấu kinh tởm của cô đang nổi điên kìa!\",\"rating\":8.5},\n  {\"id\":720703,\"suggestedTranslation\":\"Nếu đã định tự làm nhục bản thân, ít ra ta phải làm cho đàng hoàng.\",\"rating\":8.5},\n  {\"id\":720704,\"suggestedTranslation\":\"chỉ_dùng_bởi_wendy\",\"rating\":9.0},\n  {\"id\":720705,\"suggestedTranslation\":\"Đồ uống thế thì nặng quá rồi.\",\"rating\":8.5},\n  {\"id\":720706,\"suggestedTranslation\":\"chỉ_dùng_bởi_wx78\",\"rating\":9.0},\n  {\"id\":720707,\"suggestedTranslation\":\"chỉ_dùng_bởi_wx78\",\"rating\":9.0},\n  {\"id\":720708,\"suggestedTranslation\":\"Hiện tại hắn đang bận giải quyết việc khác rồi.\",\"rating\":8.5},\n  {\"id\":720709,\"suggestedTranslation\":\"Ta phải đợi để lấy lại sức mạnh.\",\"rating\":8.5},\n  {\"id\":720710,\"suggestedTranslation\":\"Không cần làm lại lần nữa đâu.\",\"rating\":8.5},\n  {\"id\":720711,\"suggestedTranslation\":\"Ta không thể làm thế khi nó còn phủ đầy pha lê trăng.\",\"rating\":8.5},\n  {\"id\":720712,\"suggestedTranslation\":\"chỉ_dùng_bởi_wendy\",\"rating\":9.0},\n  {\"id\":720713,\"suggestedTranslation\":\"Ta phải đợi á?!\",\"rating\":8.5},\n  {\"id\":720714,\"suggestedTranslation\":\"Nuôi một con thú cưng là đủ trách nhiệm rồi.\",\"rating\":8.5},\n  {\"id\":720715,\"suggestedTranslation\":\"Dù tay có dài, ta vẫn không với tới được.\",\"rating\":8.5},\n  {\"id\":720716,\"suggestedTranslation\":\"Ta đã chiêu mộ một con mèo trúc nhỏ rồi.\",\"rating\":8.5},\n  {\"id\":720717,\"suggestedTranslation\":\"Mấy thứ chết tiệt đó di chuyển nhanh quá!\",\"rating\":8.5},\n  {\"id\":720718,\"suggestedTranslation\":\"Tránh xa lông mày của ta ra cái đống lửa đó!\",\"rating\":8.5},\n  {\"id\":720719,\"suggestedTranslation\":\"Có ai đó đang dùng rồi.\",\"rating\":8.5},\n  {\"id\":720720,\"suggestedTranslation\":\"chỉ_dùng_bởi_willow\",\"rating\":9.0},\n  {\"id\":720721,\"suggestedTranslation\":\"chỉ_dùng_bởi_willow\",\"rating\":9.0},\n  {\"id\":720722,\"suggestedTranslation\":\"chỉ_dùng_bởi_winona\",\"rating\":9.0},\n  {\"id\":720723,\"suggestedTranslation\":\"chỉ_dùng_bởi_winona\",\"rating\":9.0},\n  {\"id\":720724,\"suggestedTranslation\":\"Ta sợ tâm trí mình không chịu nổi áp lực này...\",\"rating\":8.5},\n  {\"id\":720725,\"suggestedTranslation\":\"chỉ_dùng_bởi_willow\",\"rating\":9.0},\n  {\"id\":720726,\"suggestedTranslation\":\"chỉ_dùng_bởi_willow\",\"rating\":9.0},\n  {\"id\":720727,\"suggestedTranslation\":\"chỉ_dùng_bởi_wurt\",\"rating\":9.0},\n  {\"id\":720728,\"suggestedTranslation\":\"Ta cần một chiếc nón chóp cao để trò này hiệu quả.\",\"rating\":8.5},\n  {\"id\":720729,\"suggestedTranslation\":\"Ồ. Tiêu sạch mấy chiếc khăn tay xịn của ta rồi.\",\"rating\":8.5},\n  {\"id\":720730,\"suggestedTranslation\":\"Làm sao bạn có thể cải thiện sự hoàn hảo chứ?\",\"rating\":8.5},\n  {\"id\":720731,\"suggestedTranslation\":\"Họ đang cần nó gấp hơn nhiều.\",\"rating\":8.5},\n  {\"id\":720732,\"suggestedTranslation\":\"Ta nghĩ ngươi quên mất thứ gì đó rồi đấy, bạn tôi...\",\"rating\":8.5},\n  {\"id\":720733,\"suggestedTranslation\":\"Chẳng có gì để ta làm việc với nó cả.\",\"rating\":8.5},\n  {\"id\":720734,\"suggestedTranslation\":\"Sạc đầy!\",\"rating\":8.5},\n  {\"id\":720735,\"suggestedTranslation\":\"Ai lại để nó cạn pin thế này?\",\"rating\":8.5},\n  {\"id\":720736,\"suggestedTranslation\":\"Nó không đáng để ta bận tâm.\",\"rating\":8.5},\n  {\"id\":720737,\"suggestedTranslation\":\"Cái này quá nhỏ bé nếu so sánh.\",\"rating\":8.5},\n  {\"id\":720738,\"suggestedTranslation\":\"Chà, ta cần thứ gì đó để xây dựng chứ.\",\"rating\":8.5},\n  {\"id\":720739,\"suggestedTranslation\":\"Ta không thích dùng chung đâu.\",\"rating\":8.5},\n  {\"id\":720740,\"suggestedTranslation\":\"Nó cần những bản vẽ hoàn toàn khác cơ.\",\"rating\":8.5},\n  {\"id\":720741,\"suggestedTranslation\":\"Đó là phần sai rồi.\",\"rating\":8.5},\n  {\"id\":720742,\"suggestedTranslation\":\"Ta sẽ dâng lễ vật một khi mối nguy hiểm trước mắt qua đi.\",\"rating\":8.5},\n  {\"id\":720743,\"suggestedTranslation\":\"Chẳng có gì diễn ra theo đúng kế hoạch cả.\",\"rating\":8.5},\n  {\"id\":720744,\"suggestedTranslation\":\"Hừm. Ngươi cho quá nhiều muối rồi đấy.\",\"rating\":8.5},\n  {\"id\":720745,\"suggestedTranslation\":\"Ta phải lại gần hơn nữa.\",\"rating\":8.5},\n  {\"id\":720746,\"suggestedTranslation\":\"Có cái mũ ngốc nghếch vướng đường kìa.\",\"rating\":8.5},\n  {\"id\":720747,\"suggestedTranslation\":\"Có kẻ đang chiếm dụng kìa.\",\"rating\":8.5},\n  {\"id\":720748,\"suggestedTranslation\":\"Nó sắp tan chảy rồi.\",\"rating\":8.5},\n  {\"id\":720749,\"suggestedTranslation\":\"Ta không định chồng nó cao hơn nữa đâu.\",\"rating\":8.5},\n  {\"id\":720750,\"suggestedTranslation\":\"Hừ, trống không! Ta sẽ làm sau vậy.\",\"rating\":8.5},\n  {\"id\":720751,\"suggestedTranslation\":\"Ta thà không chạm tay vào cái bếp lò nóng bỏng đó đâu, cảm ơn nhé.\",\"rating\":8.5},\n  {\"id\":720752,\"suggestedTranslation\":\"Nó đang có người dùng.\",\"rating\":8.5},\n  {\"id\":720753,\"suggestedTranslation\":\"Trước tiên ta phải lấy đồ bên trong ra đã.\",\"rating\":8.5},\n  {\"id\":720754,\"suggestedTranslation\":\"Đứng yên xem nào!\",\"rating\":8.5},\n  {\"id\":720755,\"suggestedTranslation\":\"Trí nhớ của ta không đủ tốt để vẽ lại từ đó.\",\"rating\":8.5},\n  {\"id\":720756,\"suggestedTranslation\":\"Sao mấy cái cây cứ phải khó tính thế nhỉ?\",\"rating\":8.5},\n  {\"id\":720757,\"suggestedTranslation\":\"Khỉ thật! Vô vọng rồi.\",\"rating\":8.5},\n  {\"id\":720758,\"suggestedTranslation\":\"Tay nghề của ta đangụt giảm rồi đây.\",\"rating\":8.5},\n  {\"id\":720759,\"suggestedTranslation\":\"Ta phải thử mới được.\",\"rating\":8.5},\n  {\"id\":720760,\"suggestedTranslation\":\"Hiện tại nó đang bận.\",\"rating\":8.5},\n  {\"id\":720761,\"suggestedTranslation\":\"Nó từ chối khuất phục trước ý muốn của ta.\",\"rating\":8.5},\n  {\"id\":720762,\"suggestedTranslation\":\"Có vẻ ta phải kiên nhẫn chờ thời cơ vậy.\",\"rating\":8.5},\n  {\"id\":720763,\"suggestedTranslation\":\"Hừ! Sân chơi vẫn chưa hoàn thành!\",\"rating\":8.5},\n  {\"id\":720764,\"suggestedTranslation\":\"Hừm. Kén chọn ghê.\",\"rating\":8.5},\n  {\"id\":720765,\"suggestedTranslation\":\"Người chết thì cần gì mấy thứ đó chứ.\",\"rating\":8.5},\n  {\"id\":720766,\"suggestedTranslation\":\"Thứ đó đã có thể chế tạo ở đây rồi.\",\"rating\":8.5},\n  {\"id\":720767,\"suggestedTranslation\":\"Chúng ta đã đặt thứ gì đó lên bệ thờ rồi.\",\"rating\":8.5},\n  {\"id\":720768,\"suggestedTranslation\":\"Ta không nghĩ vậy đâu.\",\"rating\":8.5},\n  {\"id\":720769,\"suggestedTranslation\":\"Ta không nghĩ thế đâu. Họ có thể vẫn còn đang giận dữ đấy.\",\"rating\":8.5},\n  {\"id\":720770,\"suggestedTranslation\":\"Một khúc gỗ sống sẽ phù hợp hơn với việc này.\",\"rating\":8.5},\n  {\"id\":720771,\"suggestedTranslation\":\"Một cây nấm sẽ phù hợp hơn với việc này.\",\"rating\":8.5},\n  {\"id\":720772,\"suggestedTranslation\":\"Thứ chết tiệt này từ chối mọc!\",\"rating\":8.5},\n  {\"id\":720773,\"suggestedTranslation\":\"Đó là sự lãng phí ma thuật một cách nghiệp dư.\",\"rating\":8.5},\n  {\"id\":720774,\"suggestedTranslation\":\"Nó sẽ không hoạt động ở trong này đâu.\",\"rating\":8.5},\n  {\"id\":720775,\"suggestedTranslation\":\"Ta không phí thời gian vào trò khỉ gió này đâu.\",\"rating\":8.5},\n  {\"id\":720776,\"suggestedTranslation\":\"Đó không phải là vật hy sinh hay ho cho lắm, đúng không?\",\"rating\":8.5},\n  {\"id\":720777,\"suggestedTranslation\":\"Ngay cả Đại ảo thuật gia Maxwell cũng không thể vắt ra phép thuật từ thứ đó.\",\"rating\":8.5},\n  {\"id\":720778,\"suggestedTranslation\":\"Thứ đó chắc chắn không phải để điêu khắc.\",\"rating\":8.5},\n  {\"id\":720779,\"suggestedTranslation\":\"Hừm. Không, không phải thế này.\",\"rating\":8.5},\n  {\"id\":720780,\"suggestedTranslation\":\"Ta còn nhiều việc lớn hơn phải lo lúc này.\",\"rating\":8.5},\n  {\"id\":720781,\"suggestedTranslation\":\"Hừ. Ta không thèm dính líu gì đến đống hỗn độn đó đâu.\",\"rating\":8.5},\n  {\"id\":720782,\"suggestedTranslation\":\"Quá muộn để làm việc đó rồi.\",\"rating\":8.5},\n  {\"id\":720783,\"suggestedTranslation\":\"Cô ta đang phớt lờ ta... thật là hỗn xược!\",\"rating\":8.5},\n  {\"id\":720784,\"suggestedTranslation\":\"Nó đã bất tỉnh nhân sự hoàn toàn rồi.\",\"rating\":8.5},\n  {\"id\":720785,\"suggestedTranslation\":\"Đã có người chiếm.\",\"rating\":8.5},\n  {\"id\":720786,\"suggestedTranslation\":\"Sự lịch lãm của nó sẽ bị phí hoài trong túi ta mất.\",\"rating\":8.5},\n  {\"id\":720787,\"suggestedTranslation\":\"Chẳng có gì trong đó để nhận lễ vật của chúng ta cả. Tạm thời là thế.\",\"rating\":8.5},\n  {\"id\":720788,\"suggestedTranslation\":\"Không có gì. Tự hỏi nó sẽ phản ứng thế nào với nhiên liệu nhỉ...\",\"rating\":8.5},\n  {\"id\":720789,\"suggestedTranslation\":\"Đó là sự lãng phí ma thuật một cách nghiệp dư.\",\"rating\":8.5},\n  {\"id\":720790,\"suggestedTranslation\":\"Đống xương này được lắp ráp quá ư là nghiệp dư.\",\"rating\":8.5},\n  {\"id\":720791,\"suggestedTranslation\":\"Khi nào bạn rảnh nhé.\",\"rating\":8.5},\n  {\"id\":720792,\"suggestedTranslation\":\"Người chết thì cần gì mấy thứ đó chứ.\",\"rating\":8.5},\n  {\"id\":720793,\"suggestedTranslation\":\"Đưa họ nhiều hơn mức họ có thể mang thì chẳng có ích gì.\",\"rating\":8.5},\n  {\"id\":720794,\"suggestedTranslation\":\"Hừm... Ta để bạn nghỉ ngơi vậy.\",\"rating\":8.5},\n  {\"id\":720795,\"suggestedTranslation\":\"Khi nào bạn rảnh nhé.\",\"rating\":8.5},\n  {\"id\":720796,\"suggestedTranslation\":\"Người chết thì cần gì mấy thứ đó chứ.\",\"rating\":8.5},\n  {\"id\":720797,\"suggestedTranslation\":\"Đưa họ nhiều hơn mức họ có thể mang thì chẳng có ích gì.\",\"rating\":8.5},\n  {\"id\":720798,\"suggestedTranslation\":\"Hừm... Ta để bạn nghỉ ngơi vậy.\",\"rating\":8.5},\n  {\"id\":720799,\"suggestedTranslation\":\"Thứ đó đã có thể chế tạo ở đây rồi.\",\"rating\":8.5},\n  {\"id\":720800,\"suggestedTranslation\":\"Hừm. Nó không đáng để ta bận tâm.\",\"rating\":8.5},\n  {\"id\":720801,\"suggestedTranslation\":\"Tất nhiên là nó chỉ có tác dụng với người cá rồi.\",\"rating\":8.5},\n  {\"id\":720802,\"suggestedTranslation\":\"Ta chẳng có quyền lực gì với chúng cả.\",\"rating\":8.5},\n  {\"id\":720803,\"suggestedTranslation\":\"Con quái thú đã sẵn sàng để được đánh giá.\",\"rating\":8.5},\n  {\"id\":720804,\"suggestedTranslation\":\"Có lẽ đợi đến khi con quái thú bình tĩnh lại và chịu hợp lý hơn vậy.\",\"rating\":8.5},\n  {\"id\":720805,\"suggestedTranslation\":\"Nghe đây bạn hiền, tôi sẽ cần một con bò lai đấy.\",\"rating\":8.5},\n  {\"id\":720806,\"suggestedTranslation\":\"Lại đây xem nào, đồ ngốc có lông!\",\"rating\":8.5},\n  {\"id\":720807,\"suggestedTranslation\":\"Chà, việc đó không diễn ra đúng như kế hoạch của ta cho lắm.\",\"rating\":8.5},\n  {\"id\":720808,\"suggestedTranslation\":\"Bất tiện thật đấy.\",\"rating\":8.5},\n  {\"id\":720809,\"suggestedTranslation\":\"Khỉ thật!\",\"rating\":8.5},\n  {\"id\":720810,\"suggestedTranslation\":\"Ta đã chọn rồi. Không thể quay đầu.\",\"rating\":8.5},\n  {\