ing\":0.0},\n  {\"id\":721006,\"suggestedTranslation\":\"Ồ, quả là một thứ kinh hoàng tuyệt mỹ.\",\"rating\":0.0},\n  {\"id\":721007,\"suggestedTranslation\":\"Nó sẽ quay lại thôi.\",\"rating\":0.0},\n  {\"id\":721008,\"suggestedTranslation\":\"Ta đã chờ ngày ngươi quay lại lâu lắm rồi. Kết thúc chuyện này thôi.\",\"rating\":0.0},\n  {\"id\":721009,\"suggestedTranslation\":\"Hết chỗ nghỉ ngơi rồi kìa.\",\"rating\":0.0},\n  {\"id\":721010,\"suggestedTranslation\":\"Ta đang biết nhiều hơn mức cần thiết về cái thứ này rồi đấy.\",\"rating\":0.0},\n  {\"id\":721011,\"suggestedTranslation\":\"Hừ, đám tầm ma quái gở đó!\",\"rating\":0.0},\n  {\"id\":721012,\"suggestedTranslation\":\"Độc của cây tầm ma đang thiêu đốt huyết quản của ta!\",\"rating\":0.0},\n  {\"id\":721013,\"suggestedTranslation\":\"Mọi chuyện tồi tệ nhất đã qua rồi.\",\"rating\":0.0},\n  {\"id\":721014,\"suggestedTranslation\":\"Ta có bắt buộc phải chạy đến mỗi lần nhìn thấy một quả pháo sáng không nhỉ?\",\"rating\":0.0},\n  {\"id\":721015,\"suggestedTranslation\":\"Có những thứ kinh hoàng không thể tả xiết ở bên dưới.\",\"rating\":0.0},\n  {\"id\":721016,\"suggestedTranslation\":\"A!\",\"rating\":0.0},\n  {\"id\":721017,\"suggestedTranslation\":\"Ta không làm nổi nữa!\",\"rating\":0.0},\n  {\"id\":721018,\"suggestedTranslation\":\"only_used_by_warly\",\"rating\":0.0},\n  {\"id\":721019,\"suggestedTranslation\":\"Cuối cùng cũng được tự do!\",\"rating\":0.0},\n  {\"id\":721020,\"suggestedTranslation\":\"only_used_by_wurt\",\"rating\":0.0},\n  {\"id\":721021,\"suggestedTranslation\":\"Chúng đang thì thầm xuyên qua tận sâu thẳm tâm trí ta...!\",\"rating\":0.0},\n  {\"id\":721022,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":0.0},\n  {\"id\":721023,\"suggestedTranslation\":\"Ứ hự! Đau quá!\",\"rating\":0.0},\n  {\"id\":721024,\"suggestedTranslation\":\"Tốt nhất là ta đừng có đi dạo dưới mưa axit vào lúc này.\",\"rating\":0.0},\n  {\"id\":721025,\"suggestedTranslation\":\"Hết lớp bảo vệ khỏi lửa rồi