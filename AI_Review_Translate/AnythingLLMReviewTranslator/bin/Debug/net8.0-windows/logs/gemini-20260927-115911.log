ting\":0.0},\n  {\"id\":720945,\"suggestedTranslation\":\"Không! Lối kia cơ mà!\",\"rating\":0.0},\n  {\"id\":720946,\"suggestedTranslation\":\"Bắt đầu!\",\"rating\":0.0},\n  {\"id\":720947,\"suggestedTranslation\":\"Trần nhà sắp sập rồi!\",\"rating\":0.0},\n  {\"id\":720948,\"suggestedTranslation\":\"Ổn cả thôi.\",\"rating\":0.0},\n  {\"id\":720949,\"suggestedTranslation\":\"Ta đoán tốt nhất là nên giữ thể diện...\",\"rating\":0.0},\n  {\"id\":720950,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":0.0},\n  {\"id\":720951,\"suggestedTranslation\":\"Ái! Nhẹ tay thôi chứ, Charlie!\",\"rating\":0.0},\n  {\"id\":720952,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":0.0},\n  {\"id\":720953,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":0.0},\n  {\"id\":720954,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":0.0},\n  {\"id\":720955,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":0.0},\n  {\"id\":720956,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":0.0},\n  {\"id\":720957,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":0.0},\n  {\"id\":720958,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":0.0},\n  {\"id\":720959,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":0.0},\n  {\"id\":720960,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":0.0},\n  {\"id\":720961,\"suggestedTranslation\":\"Trái tim ta đang nguội lạnh dần.\",\"rating\":0.0},\n  {\"id\":720962,\"suggestedTranslation\":\"La bàn đã vỡ thành từng mảnh rồi.\",\"rating\":0.0},\n  {\"id\":720963,\"suggestedTranslation\":\"Giấc ngủ đó có phần thư thái hơn bình thường một chút.\",\"rating\":0.0},\n  {\"id\":720964,\"suggestedTranslation\":\"Hừm... ta không làm được việc đó.\",\"rating\":0.0},\n  {\"id\":720965,\"suggestedTranslation\":\"Ẩm ướt thì chẳng lịch thiệp chút nào.\",\"rating\":0.0},\n  {\"id\":720966,\"suggestedTranslation\":\"Ta nghe thấy tiếng một kẻ đang đến gần.\",\"rating\":0.0},\n  {\"id\":720967,\"suggestedTranslation\":\"Này bạn ơi, trông ta có vẻ không ổn cho lắm...\",\"rating\":0.0},\n  {\"id\":720968,\"suggestedTranslation\":\"Sức mạnh của ta đã rời đi rồi.\",\"rating\":0.0},\n  {\"id\":720969,\"suggestedTranslation\":\"Tiếc thật. Ta bắt đầu thấy thích cảm giác đó rồi cơ mà.\",\"rating\":0.0},\n  {\"id\":720970,\"suggestedTranslation\":\"Ta đang phải đối mặt với thời tiết khắc nghiệt rồi!\",\"rating\":0.0},\n  {\"id\":720971,\"suggestedTranslation\":\"Ta đã trở nên dễ bị tổn thương rồi!\",\"rating\":0.0},\n  {\"id\":720972,\"suggestedTranslation\":\"Ta đang buồn ngủ dần đây.\",\"rating\":0.0},\n  {\"id\":720973,\"suggestedTranslation\":\"Sự nhiệt huyết của ta với việc này đã cạn kiệt rồi.\",\"rating\":0.0},\n  {\"id\":720974,\"suggestedTranslation\":\"Thế là xong việc đó.\",\"rating\":0.0},\n  {\"id\":720975,\"suggestedTranslation\":\"Trời sắp tối rồi. Charlie chuẩn bị thức dậy đấy.\",\"rating\":0.0},\n  {\"id\":720976,\"suggestedTranslation\":\"(Ực!)\",\"rating\":0.0},\n  {\"id\":720977,\"suggestedTranslation\":\"Ta không đời nào cho thứ đó bén mảng tới miệng mình đâu.\",\"rating\":0.0},\n  {\"id\":720978,\"suggestedTranslation\":\"Ái! Đau miệng quá!\",\"rating\":0.0},\n  {\"id\":720979,\"suggestedTranslation\":\"Thứ đó thối rữa thật rồi.\",\"rating\":0.0},\n  {\"id\":720980,\"suggestedTranslation\":\"Thứ đó đã quá hạn sử dụng rồi.\",\"rating\":0.0},\n  {\"id\":720981,\"suggestedTranslation\":\"Một người văn minh không bao giờ ăn những thứ như thế.\",\"rating\":0.0},\n  {\"id\":720982,\"suggestedTranslation\":\"Ta nghĩ chia sẻ món này với những người khác mới là điều phải phép.\",\"rating\":0.0},\n  {\"id\":720983,\"suggestedTranslation\":\"Đúng chỗ ngứa rồi đấy.\",\"rating\":0.0},\n  {\"id\":720984,\"suggestedTranslation\":\"Ta thà ngủ giấc ngàn thu còn hơn.\",\"rating\":0.0},\n  {\"id\":720985,\"suggestedTranslation\":\"Hãy tôn trọng cơ bắp của ta đi!\",\"rating\":0.0},\n  {\"id\":720986,\"suggestedTranslation\":\"Đó là một