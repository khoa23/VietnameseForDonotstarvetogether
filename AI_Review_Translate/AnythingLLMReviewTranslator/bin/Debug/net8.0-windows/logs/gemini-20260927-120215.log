":9.0},\n  {\"id\":721816,\"suggestedTranslation\":\"Ta chịu chết không biết đó là cái quái gì.\",\"rating\":9.0},\n  {\"id\":721817,\"suggestedTranslation\":\"Đây không phải là cái tẩu. Đáng tiếc thật.\",\"rating\":9.0},\n  {\"id\":721818,\"suggestedTranslation\":\"Cũng được đấy, nhưng vết gỉ sét đâu? Ống xả đâu rồi?\",\"rating\":9.0},\n  {\"id\":721819,\"suggestedTranslation\":\"Các quân cờ đang chuyển động!\",\"rating\":9.0},\n  {\"id\":721820,\"suggestedTranslation\":\"Con cá mập cô độc ăn đáy biển.\",\"rating\":9.0},\n  {\"id\":721821,\"suggestedTranslation\":\"Ta rất thích cái này đấy.\",\"rating\":9.0},\n  {\"id\":721822,\"suggestedTranslation\":\"Ít ra bức tượng không bốc mùi tệ như bản gốc.\",\"rating\":9.0},\n  {\"id\":721823,\"suggestedTranslation\":\"Cặp đôi phiền phức nhất mà ta từng thấy.\",\"rating\":9.0},\n  {\"id\":721824,\"suggestedTranslation\":\"Giờ thì ai mới sợ bị nghiền nát nào?\",\"rating\":9.0},\n  {\"id\":721825,\"suggestedTranslation\":\"Đó là kết quả của một chuỗi quyết định tồi tệ.\",\"rating\":9.0},\n  {\"id\":721826,\"suggestedTranslation\":\"Ta căm ghét nó.\",\"rating\":9.0},\n  {\"id\":721827,\"suggestedTranslation\":\"Đó là một con chó hư.\",\"rating\":9.0},\n  {\"id\":721828,\"suggestedTranslation\":\"Ta vẫn còn ngửi thấy hơi thở của nó.\",\"rating\":9.0},\n  {\"id\":721829,\"suggestedTranslation\":\"Thật tuyệt khi được gợi nhớ về những chiến thắng của mình.\",\"rating\":9.0},\n  {\"id\":721830,\"suggestedTranslation\":\"Quyết định nhanh lên xem nào! Bạn hay thù đây?\",\"rating\":9.0},\n  {\"id\":721831,\"suggestedTranslation\":\"Cứ để thứ này dưới lòng đất đi.\",\"rating\":9.0},\n  {\"id\":721832,\"suggestedTranslation\":\"Con quái vật nhỏ phiền phức. Nhưng cũng có khối việc ra trò đấy.\",\"rating\":9.0},\n  {\"id\":721833,\"suggestedTranslation\":\"Đừng có nhìn ta nữa!\",\"rating\":9.0},\n  {\"id\":721834,\"suggestedTranslation\":\"Nó đang đợi cái gì thế nhỉ?\",\"rating\":9.0},\n  {\"id\":721835,\"suggestedTranslation\":\"Hừ. Trang trí bằng dây điện với bánh răng thế thôi chứ dùng phép thuật là ta nhận ra ngay.\",\"rating\":9.0},\n  {\"id\":721836,\"suggestedTranslation\":\"Là bẫy đấy!\",\"rating\":9.0},\n  {\"id\":721837,\"suggestedTranslation\":\"Này, mồi câu đó trông không ổn lắm đâu.\",\"rating\":9.0},\n  {\"id\":721838,\"suggestedTranslation\":\"Ta đã khôn ngoan khi thấy hoài nghi đấy.\",\"rating\":9.0},\n  {\"id\":721839,\"suggestedTranslation\":\"Ta không tin tưởng nó đâu.\",\"rating\":9.0},\n  {\"id\":721840,\"suggestedTranslation\":\"Con quái thú đất nung này đang hừng hực khí thế rồi.\",\"rating\":9.0},\n  {\"id\":721841,\"suggestedTranslation\":\"Thật là mất tự nhiên một cách thú vị.\",\"rating\":9.0},\n  {\"id\":721842,\"suggestedTranslation\":\"Ta sắp phát điên rồi đây.\",\"rating\":9.0},\n  {\"id\":721843,\"suggestedTranslation\":\"Thật dễ chịu làm sao.\",\"rating\":9.0},\n  {\"id\":721844,\"suggestedTranslation\":\"Thế này thì tạm thời giữ chân Charlie được đấy.\",\"rating\":9.0},\n  {\"id\":721845,\"suggestedTranslation\":\"Nó cần thêm nhiên liệu.\",\"rating\":9.0},\n  {\"id\":721846,\"suggestedTranslation\":\"Vừa lạnh lẽo vừa rực lửa.\",\"rating\":9.0},\n  {\"id\":721847,\"suggestedTranslation\":\"Thứ đó không quay lại đâu.\",\"rating\":9.0},\n  {\"id\":721848,\"suggestedTranslation\":\"Ai đó nên chăm chút cho cái lò lửa đó đi.\",\"rating\":9.0},\n  {\"id\":721849,\"suggestedTranslation\":\"Một cái lò lửa.\",\"rating\":9.0},\n  {\"id\":721850,\"suggestedTranslation\":\"Một ngọn lửa lạnh đang bùng cháy dữ dội.\",\"rating\":9.0},\n  {\"id\":721851,\"suggestedTranslation\":\"Nó sắp tàn rồi kìa.\",\"rating\":9.0},\n  {\"id\":721852,\"suggestedTranslation\":\"Trời lạnh quá.\",\"rating\":9.0},\n  {\"id\":721853,\"suggestedTranslation\":\"Nó đã hơi ấm lên rồi.\",\"rating\":9.0},\n  {\"id\":721854,\"suggestedTranslation\":\"Ngươi thực sự nghĩ ta sẽ bới tung đống đó lên à?\",\"rating\":9.0},\n  {\"id\":721855,\"suggestedTranslation\":\"Hướng Đông.\",\"rating\":9.0},\n  {\"id\":721856,\"suggestedTranslation\":\"Ta lạc đường mất rồi.\",\"rating\":9.0},\n  {\"id\":721857,\"suggestedTranslation\":\"Hướng Bắc.\",\"rating\":9.0},\n  {\"id\":721858,\"suggestedTranslation\":\"Hướng Đông Bắc.\",\"rating\":9.0},\n  {\"id\":721859,\"suggestedTranslation\":\"Hướng Tây Bắc.\",\"rating\":9.0},\n  {\"id\":721860,\"suggestedTranslation\":\"Hướng Nam.\",\"rating\":9.0},\n  {\"id\":721861,\"suggestedTranslation\":\"Hướng Đông Nam.\",\"rating\":9.0},\n  {\"id\":721862,\"suggestedTranslation\":\"Hướng Tây Nam.\",\"rating\":9.0},\n  {\"id\":721863,\"suggestedTranslation\":\"Hướng Tây.\",\"rating\":9.0},\n  {\"id\":721864,\"suggestedTranslation\":\"Ta thà không làm bẩn đôi tay mình còn hơn.\",\"rating\":9.0},\n  {\"id\":721865,\"suggestedTranslation\":\"Thế này là đủ dùng rồi.\",\"rating\":9.0},\n  {\"id\":721866,\"suggestedTranslation\":\"Mùi của nó kinh khủng y như ngươi tưởng tượng vậy.\",\"rating\":9.0},\n  {\"id\":721867,\"suggestedTranslation\":\"Khô khan tích cực.\",\"rating\":9.0},\n  {\"id\":721868,\"suggestedTranslation\":\"Ghê tởm.\",\"rating\":9.0},\n  {\"id\":721869,\"suggestedTranslation\":\"Chẳng khác gì đống bùn nhão nhoét hôi hám.\",\"rating\":9.0},\n  {\"id\":721870,\"suggestedTranslation\":\"Ta chán ngấy đống phân rác này đến tận cổ rồi.\",\"rating\":9.0},\n  {\"id\":721871,\"suggestedTranslation\":\"Chắc ta nên chế tạo cái này thôi.\",\"rating\":9.0},\n  {\"id\":721872,\"suggestedTranslation\":\"Được thôi. Nếu ta đã làm chủ được hắc pháp, nấu ăn chắc cũng chẳng khó lắm nhỉ?\",\"rating\":9.0},\n  {\"id\":721873,\"suggestedTranslation\":\"Nó đã mất đi phần lớn sức mạnh rồi.\",\"rating\":9.0},\n  {\"id\":721874,\"suggestedTranslation\":\"Giờ thì đỡ có mùi chuồng trại hơn rồi đấy.\",\"rating\":9.0},\n  {\"id\":721875,\"suggestedTranslation\":\"Nó vẫn dơ bẩn lắm.\",\"rating\":9.0},\n  {\"id\":721876,\"suggestedTranslation\":\"Chà, ít ra nó không còn giãy giụa nữa.\",\"rating\":9.0},\n  {\"id\":721877,\"suggestedTranslation\":\"Tránh xa ta ra, đồ quỷ!\",\"rating\":9.0},\n  {\"id\":721878,\"suggestedTranslation\":\"Trông chẳng bảnh bao chút nào cả.\",\"rating\":9.0},\n  {\"id\":721879,\"suggestedTranslation\":\"Hừ. Ta đoán cái này có ích đấy.\",\"rating\":9.0},\n  {\"id\":721880,\"suggestedTranslation\":\"Chữ viết mờ quá không đọc nổi.\",\"rating\":9.0},\n  {\"id\":721881,\"suggestedTranslation\":\"Hơi quá lửa so với gu của ta.\",\"rating\":9.0},\n  {\"id\":721882,\"suggestedTranslation\":\"Đợi chút nào...\",\"rating\":9.0},\n  {\"id\":721883,\"suggestedTranslation\":\"Nó đến kìa!\",\"rating\":9.0},\n  {\"id\":721884,\"suggestedTranslation\":\"Cuối cùng cũng có con sâu ngon lành để ăn.\",\"rating\":9.0},\n  {\"id\":721885,\"suggestedTranslation\":\"Mới nghĩ đến thôi mà nước miếng đã tứa ra rồi.\",\"rating\":9.0},\n  {\"id\":721886,\"suggestedTranslation\":\"Ghê thế.\",\"rating\":9.0},\n  {\"id\":721887,\"suggestedTranslation\":\"Chuyện về những chiếc đuôi.\",\"rating\":9.0},\n  {\"id\":721888,\"suggestedTranslation\":\"Giàu fructose lắm đấy.\",\"rating\":9.0},\n  {\"id\":721889,\"suggestedTranslation\":\"Ít ra cũng tinh tế hơn một chút.\",\"rating\":9.0},\n  {\"id\":721890,\"suggestedTranslation\":\"Bắp gì mà quá nhiều so với một người bình thường.\",\"rating\":9.0},\n  {\"id\":721891,\"suggestedTranslation\":\"Làm mấy việc lao động này quá tầm với ta.\",\"rating\":9.0},\n  {\"id\":721892,\"suggestedTranslation\":\"Có vẻ như trang phục đã được chuẩn bị sẵn.\",\"rating\":9.0},\n  {\"id\":721893,\"suggestedTranslation\":\"Có vẻ như trang phục đã được chuẩn bị sẵn.\",\"rating\":9.0},\n  {\"id\":721894,\"suggestedTranslation\":\"Có vẻ như trang phục đã được chuẩn bị sẵn.\",\"rating\":9.0},\n  {\"id\":721895,\"suggestedTranslation\":\"Ta nghĩ bộ đó mặc vừa khít với ta đấy.\",\"rating\":9.0},\n  {\"id\":721896,\"suggestedTranslation\":\"Có vẻ như trang phục đã được chuẩn bị sẵn.\",\"rating\":9.0},\n  {\"id\":721897,\"suggestedTranslation\":\"Ta đoán nó hợp với cái đầu ngựa hách dịch kia đấy.\",\"rating\":9.0},\n  {\"id\":721898,\"suggestedTranslation\":\"Có vẻ như trang phục đã được chuẩn bị sẵn.\",\"rating\":9.0},\n  {\"id\":721899,\"suggestedTranslation\":\"Có vẻ như trang phục đã được chuẩn bị sẵn.\",\"rating\":9.0},\n  {\"id\":721900,\"suggestedTranslation\":\"Thêm chút lửa cho có không khí kịch tính nào.\",\"rating\":9.0},\n  {\"id\":721901,\"suggestedTranslation\":\"Một bức tượng mộc mạc. Có lẽ có thể cải thiện nó được.\",\"rating\":9.0},\n  {\"id\":721902,\"suggestedTranslation\":\"Thêm chút lửa cho có không khí kịch tính nào.\",\"rating\":9.0},\n  {\"id\":721903,\"suggestedTranslation\":\"Trông thật là điềm gở một cách thú vị.\",\"rating\":9.0},\n  {\"id\":721904,\"suggestedTranslation\":\"Thêm chút lửa cho có không khí kịch tính nào.\",\"rating\":9.0},\n  {\"id\":721905,\"suggestedTranslation\":\"Có thứ gì đó rất lôi cuốn ở nó.\",\"rating\":9.0},\n  {\"id\":721906,\"suggestedTranslation\":\"Tiếc là không vừa cỡ của ta.\",\"rating\":9.0},\n  {\"id\":721907,\"suggestedTranslation\":\"Ta dám cá là mình đã tống hết tụi mày xuống dưới lòng đất rồi cơ mà.\",\"rating\":9.0},\n  {\"id\":721908,\"suggestedTranslation\":\"Này bạn hiền, sao chúng ta không thử dàn xếp chuyện này nhỉ?\",\"rating\":9.0},\n  {\"id\":721909,\"suggestedTranslation\":\"Ta đoán chúng ta không thể cứ để yên mọi chuyện được nhỉ?\",\"rating\":9.0},\n  {\"id\":721910,\"suggestedTranslation\":\"Nhắm cái hướng ngươi bắn mấy thứ đó lại xem nào!\",\"rating\":9.0},\n  {\"id\":721911,\"suggestedTranslation\":\"Tốt nhất là tránh xa cái đó ra.\",\"rating\":9.0},\n  {\"id\":721912,\"suggestedTranslation\":\"Lúc nào cũng có thứ vướng víu cản đường.\",\"rating\":9.0},\n  {\"id\":721913,\"suggestedTranslation\":\"Ta sẵn sàng đổi cả mạng lấy một đĩa bánh cua đấy.\",\"rating\":9.0},\n  {\"id\":721914,\"suggestedTranslation\":\"Cấp quản lý trung gian.\",\"rating\":9.0},\n  {\"id\":721915,\"suggestedTranslation\":\"Có phải hòn đá đó đang nhìn chằm chằm vào ta không?\",\"rating\":9.0},\n  {\"id\":721916,\"suggestedTranslation\":\"Ngươi không phải người ở đây phải không, bạn hiền?\",\"rating\":9.0},\n  {\"id\":721917,\"suggestedTranslation\":\"Y như những ngày xưa cũ.\",\"rating\":9.0},\n  {\"id\":721918,\"suggestedTranslation\":\"Đứng yên xem nào, cái thứ cứ giật giật này?\",\"rating\":9.0},\n  {\"id\":721919,\"suggestedTranslation\":\"Nói cho ta nghe, ngươi nhìn thấy gì thế, nhóc con?\",\"rating\":9.0}\n]",
