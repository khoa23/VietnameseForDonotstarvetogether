            "text": "[\n  {\"id\":721620,\"suggestedTranslation\":\"Kẻ sành sỏi tử thi.\",\"rating\":9.0},\n  {\"id\":721621,\"suggestedTranslation\":\"Đỡ bận mắt.\",\"rating\":9.0},\n  {\"id\":721622,\"suggestedTranslation\":\"Ghê quá.\",\"rating\":9.0},\n  {\"id\":721623,\"suggestedTranslation\":\"Hoàn toàn dị hợm.\",\"rating\":9.0},\n  {\"id\":721624,\"suggestedTranslation\":\"Thịt cuốn trong lá bắp cải. Thật là hào hứng làm sao.\",\"rating\":9.0},\n  {\"id\":721625,\"suggestedTranslation\":\"Thực vật phồng rộp.\",\"rating\":9.0},\n  {\"id\":721626,\"suggestedTranslation\":\"Xương rồng á? Cứ như bánh kếp xương rồng ấy!\",\"rating\":9.0},\n  {\"id\":721627,\"suggestedTranslation\":\"Phần này của cây xương rồng lúc nào cũng ổn cả.\",\"rating\":9.0},\n  {\"id\":721628,\"suggestedTranslation\":\"Đưa thứ đó vào miệng chắc chắn không khôn ngoan chút nào.\",\"rating\":9.0},\n  {\"id\":721629,\"suggestedTranslation\":\"Món xương rồng ăn được.\",\"rating\":9.0},\n  {\"id\":721630,\"suggestedTranslation\":\"Ta không nghĩ mình thực sự đánh giá cao những bờ biển đầy nắng đó.\",\"rating\":9.0},\n  {\"id\":721631,\"suggestedTranslation\":\"Ta sắp phát điên rồi đây.\",\"rating\":9.0},\n  {\"id\":721632,\"suggestedTranslation\":\"Thật dễ chịu làm sao.\",\"rating\":9.0},\n  {\"id\":721633,\"suggestedTranslation\":\"Thế này thì tạm thời giữ chân Charlie được đấy.\",\"rating\":9.0},\n  {\"id\":721634,\"suggestedTranslation\":\"Nó cần thêm nhiên liệu.\",\"rating\":9.0},\n  {\"id\":721635,\"suggestedTranslation\":\"Rực lửa.\",\"rating\":9.0},\n  {\"id\":721636,\"suggestedTranslation\":\"Thứ đó không quay lại đâu.\",\"rating\":9.0},\n  {\"id\":721637,\"suggestedTranslation\":\"Mấy thứ này cứ chui vào thế giới của ta kiểu gì nhỉ?\",\"rating\":9.0},\n  {\"id\":721638,\"suggestedTranslation\":\"Mồi nhử.\",\"rating\":9.0},\n  {\"id\":721639,\"suggestedTranslation\":\"Trông ngươi khủng khiếp thật đấy.\",\"rating\":9.0},\n  {\"id\":721640,\"suggestedTranslation\":\"Đó là túi đường của chúng ta.\",\"rating\":9.0},\n  {\"id\":721641,\"suggestedTranslation\":\"Trên đó có khắc hình những thứ chạy nhanh.\",\"rating\":9.0},\n  {\"id\":721642,\"suggestedTranslation\":\"Trông nặng thật đấy. Ai đó nên nạp nó vào đại bác đi.\",\"rating\":9.0},\n  {\"id\":721643,\"suggestedTranslation\":\"Thế là quá đủ vui vẻ cho một ngày rồi.\",\"rating\":9.0},\n  {\"id\":721644,\"suggestedTranslation\":\"Nơi này sắp biến thành gánh xiếc đến nơi rồi.\",\"rating\":9.0},\n  {\"id\":721645,\"suggestedTranslation\":\"Bộ quanh đây ta phải làm mọi thứ à?\",\"rating\":9.0},\n  {\"id\":721646,\"suggestedTranslation\":\"Ồ tuyệt. Chắc không ai muốn người ta nghĩ quanh đây chúng ta có gu thẩm mỹ đâu nhỉ?\",\"rating\":9.0},\n  {\"id\":721647,\"suggestedTranslation\":\"Xem ra công việc quanh đây chẳng bao giờ là hết.\",\"rating\":9.0},\n  {\"id\":721648,\"suggestedTranslation\":\"Tuyệt vời. Nó còn sến súa hơn cả tưởng tượng của ta.\",\"rating\":9.0},\n  {\"id\":721649,\"suggestedTranslation\":\"Xem ra công việc quanh đây chẳng bao giờ là hết.\",\"rating\":9.0},\n  {\"id\":721650,\"suggestedTranslation\":\"Thêm một thứ làm vướng víu mặt đất.\",\"rating\":9.0},\n  {\"id\":721651,\"suggestedTranslation\":\"Chính xác thì có gì tuyệt vời ở nó chứ?\",\"rating\":9.0},\n  {\"id\":721652,\"suggestedTranslation\":\"Những thứ tồi tàn. Thời của ta thì người ta tạc tượng đàng hoàng cơ...\",\"rating\":9.0},\n  {\"id\":721653,\"suggestedTranslation\":\"Sự tò mò lúc nào cũng hại chết ta.\",\"rating\":9.0},\n  {\"id\":721654,\"suggestedTranslation\":\"Sự tò mò lúc nào cũng hại chết ta.\",\"rating\":9.0},\n  {\"id\":721655,\"suggestedTranslation\":\"Sự tò mò lúc nào cũng hại chết ta.\",\"rating\":9.0},\n  {\"id\":721656,\"suggestedTranslation\":\"Một nguồn sáng nghèo nàn. Nhưng thế là đủ.\",\"rating\":9.0},\n  {\"id\":721657,\"suggestedTranslation\":\"Xem ra công việc quanh đây chẳng bao giờ là hết.\",\"rating\":9.0},\n  {\"id\":721658,\"suggestedTranslation\":\"Ít ra nó cũng nhỏ và có thể xoay sở được phần nào.\",\"rating\":9.0},\n  {\"id\":721659,\"suggestedTranslation\":\"Xem ra công việc quanh đây chẳng bao giờ là hết.\",\"rating\":9.0},\n  {\"id\":721660,\"suggestedTranslation\":\"Chắc ngươi không đùa đấy chứ?\",\"rating\":9.0},\n  {\"id\":721661,\"suggestedTranslation\":\"Mấy đạo cụ này vẫn còn nhiều điều để chê trách.\",\"rating\":9.0},\n  {\"id\":721662,\"suggestedTranslation\":\"Chắc ta lại phải tự dựng cái này lên à?\",\"rating\":9.0},\n  {\"id\":721663,\"suggestedTranslation\":\"Chúng đang giấu cái gì dưới đó thế...\",\"rating\":9.0},\n  {\"id\":721664,\"suggestedTranslation\":\"Nó cần phải trả phí.\",\"rating\":9.0},\n  {\"id\":721665,\"suggestedTranslation\":\"Ta sẽ chơi, nhưng ta sẽ không thấy vui đâu.\",\"rating\":9.0},\n  {\"id\":721666,\"suggestedTranslation\":\"Nhỏ bé và dễ bảo làm sao. Nó đi tới nơi ta hướng dẫn.\",\"rating\":9.0},\n  {\"id\":721667,\"suggestedTranslation\":\"Đây có phải gậy gạt bóng đúng quy chuẩn không đấy?\",\"rating\":9.0},\n  {\"id\":721668,\"suggestedTranslation\":\"Một sân chơi do chính tay ta tạo ra á?\",\"rating\":9.0},\n  {\"id\":721669,\"suggestedTranslation\":\"Sân chơi này quá tầm thường đối với ta.\",\"rating\":9.0},\n  {\"id\":721670,\"suggestedTranslation\":\"Khó nhằn ư? Để xem thế nào đã.\",\"rating\":9.0},\n  {\"id\":721671,\"suggestedTranslation\":\"Chắc sẽ là một vòng chơi ra trò đây.\",\"rating\":9.0},\n  {\"id\":721672,\"suggestedTranslation\":\"Ngươi cứ phải đứng cản đường ta mãi à?\",\"rating\":9.0},\n  {\"id\":721673,\"suggestedTranslation\":\"Ai đó tắt cái cái quạt chết tiệt kia đi được không?\",\"rating\":9.0},\n  {\"id\":721674,\"suggestedTranslation\":\"Nó nhắc nhở những người chơi kém cỏi rằng thế giới này có điểm dừng.\",\"rating\":9.0},\n  {\"id\":721675,\"suggestedTranslation\":\"Lên hay xuống? Quyết định nhanh lên xem nào!\",\"rating\":9.0},\n  {\"id\":721676,\"suggestedTranslation\":\"Làm ta nhớ đến cái thứ chết tiệt đó.\",\"rating\":9.0},\n  {\"id\":721677,\"suggestedTranslation\":\"Nó phóng quả bóng lên tận trời xanh, miễn phải chịu cái cảnh lăn lóc kém sang.\",\"rating\":9.0},\n  {\"id\":721678,\"suggestedTranslation\":\"Cẩn thận chỗ ngươi ném bóng của ta đấy.\",\"rating\":9.0},\n  {\"id\":721679,\"suggestedTranslation\":\"Trò trẻ con, nhưng thắng thì ta cũng chẳng thấyy áy náy gì đâu.\",\"rating\":9.0},\n  {\"id\":721680,\"suggestedTranslation\":\"Hiển nhiên là nó nằm ở đoạn cuối rồi.\",\"rating\":9.0},\n  {\"id\":721681,\"suggestedTranslation\":\"Tốn cả một đồng xu cơ á?!\",\"rating\":9.0},\n  {\"id\":721682,\"suggestedTranslation\":\"Hừ! Sân chơi vẫn chưa làm xong mà!\",\"rating\":9.0},\n  {\"id\":721683,\"suggestedTranslation\":\"Nó được trả tiền rồi mà!\",\"rating\":9.0},\n  {\"id\":721684,\"suggestedTranslation\":\"Nó phải nằm ở đầu sân chứ lị!\",\"rating\":9.0},\n  {\"id\":721685,\"suggestedTranslation\":\"Quay lại đây ngay, cái máy móc chết tiệt này!\",\"rating\":9.0},\n  {\"id\":721686,\"suggestedTranslation\":\"Chắc ta lại phải tự dựng cái này lên à?\",\"rating\":9.0},\n  {\"id\":721687,\"suggestedTranslation\":\"Nó cần phải trả phí.\",\"rating\":9.0},\n  {\"id\":721688,\"suggestedTranslation\":\"Đúng là một trò vô bổ...\",\"rating\":9.0},\n  {\"id\":721689,\"suggestedTranslation\":\"Chúng đang giấu cái gì dưới đó thế...\",\"rating\":9.0},\n  {\"id\":721690,\"suggestedTranslation\":\"Ta khá chắc là cái này...\",\"rating\":9.0},\n  {\"id\":721691,\"suggestedTranslation\":\"Chắc ta lại phải tự dựng cái này lên à?\",\"rating\":9.0},\n  {\"id\":721692,\"suggestedTranslation\":\"Nó cần phải trả phí.\",\"rating\":9.0},\n  {\"id\":721693,\"suggestedTranslation\":\"Chỉ là chuyện ghi nhớ đơn giản thôi. Để ta cho ngươi thấy nó dễ thế nào nhé.\",\"rating\":9.0},\n  {\"id\":721694,\"suggestedTranslation\":\"Chắc ta lại phải tự dựng cái này lên à?\",\"rating\":9.0},\n  {\"id\":721695,\"suggestedTranslation\":\"Nó cần phải trả phí.\",\"rating\":9.0},\n  {\"id\":721696,\"suggestedTranslation\":\"Ta đoán vài kẻ sẽ thấy cái này thú vị đấy.\",\"rating\":9.0},\n  {\"id\":721697,\"suggestedTranslation\":\"Nó cần phải trả phí.\",\"rating\":9.0},\n  {\"id\":721698,\"suggestedTranslation\":\"Chà, ta đoán việc đập phá chút đỉnh cũng giúp thư giãn đấy.\",\"rating\":9.0},\n  {\"id\":721699,\"suggestedTranslation\":\"Chắc ta lại phải tự dựng cái này lên à?\",\"rating\":9.0},\n  {\"id\":721700,\"suggestedTranslation\":\"Nó cần phải trả phí.\",\"rating\":9.0},\n  {\"id\":721701,\"suggestedTranslation\":\"Lại một trò giải trí vô bổ nữa.\",\"rating\":9.0},\n  {\"id\":721702,\"suggestedTranslation\":\"Chúng đang giấu cái gì dưới đó thế...\",\"rating\":9.0},\n  {\"id\":721703,\"suggestedTranslation\":\"Ta chắc chắn là nó bịp bợm rồi.\",\"rating\":9.0},\n  {\"id\":721704,\"suggestedTranslation\":\"Chắc ta lại phải tự dựng cái này lên à?\",\"rating\":9.0},\n  {\"id\":721705,\"suggestedTranslation\":\"Nó cần phải trả phí.\",\"rating\":9.0},\n  {\"id\":721706,\"suggestedTranslation\":\"Một chiến thắng vô nghĩa.\",\"rating\":9.0},\n  {\"id\":721707,\"suggestedTranslation\":\"Mới mẻ thật đấy.\",\"rating\":9.0},\n  {\"id\":721708,\"suggestedTranslation\":\"Chúng ta sắp bị tràn ngập rồi.\",\"rating\":9.0},\n  {\"id\":721709,\"suggestedTranslation\":\"Được rồi. Ta sẽ chơi mấy trò ngớ ngẩn của các người.\",\"rating\":9.0},\n  {\"id\":721710,\"suggestedTranslation\":\"Nhìn hắn kìa, cứ đi lại ngúng nguẩy như thể làm chủ cả cái xứ này không bằng.\",\"rating\":9.0},\n  {\"id\":721711,\"suggestedTranslation\":\"Nó có bầu không khí lễ hội vừa đúng với ý ta. Tức là chẳng có tí nào.\",\"rating\":9.0},\n  {\"id\":721712,\"suggestedTranslation\":\"Mấy con chim có vẻ thích thú đấy. Đúng là có những sinh vật chẳng có tí gu thẩm mỹ nào.\",\"rating\":9.0},\n  {\"id\":721713,\"suggestedTranslation\":\"Ta nghĩ đó là đống rác rưởi lớn nhất mà người ta có thể tống lên một cái cây đấy.\",\"rating\":9.0},\n  {\"id\":721714,\"suggestedTranslation\":\"Nó thật là... hừm... kỳ quặc.\",\"rating\":9.0},\n  {\"id\":721715,\"suggestedTranslation\":\"Ta hơi nghi ngờ việc ở đó có thứ gì ta muốn.\",\"rating\":9.0},\n  {\"id\":721716,\"suggestedTranslation\":\"Bộ quanh đây ta phải làm mọi thứ à?\",\"rating\":9.0},\n  {\"id\":721717,\"suggestedTranslation\":\"Một chiếc vé đổi thưởng. Hứng thú thật đấy.\",\"rating\":9.0},\n  {\"id\":721718,\"suggestedTranslation\":\"Ồ tuyệt. Giờ ta có thể lấy vài món đồ vô tích sự từ Gian hàng giải thưởng rồi.\",\"rating\":9.0},\n  {\"id\":721719,\"suggestedTranslation\":\"Ta không hiểu sao mình lại dành nhiều thời gian cho việc này nữa.\",\"rating\":9.0},\n  {\"id\":721720,\"suggestedTranslation\":\"Dễ chịu đúng như những gì ngươi tưởng tượng đấy.\",\"rating\":9.0},\n  {\"id\":721721,\"suggestedTranslation\":\"Quá ư là lòe loẹt so với gu của ta.\",\"rating\":9.0},\n  {\"id\":721722,\"suggestedTranslation\":\"Ít ra nó cũng giúp ta đỡ được cái nóng khốn khổ này.\",\"rating\":9.0},\n  {\"id\":721723,\"suggestedTranslation\":\"Nó có thể chống lại phần nào ánh nắng oi bức của mặt trời.\",\"rating\":9.0},\n  {\"id\":721724,\"suggestedTranslation\":\"Cũng sang phết... đối với công cụ của một kẻ lao động.\",\"rating\":9.0},\n  {\"id\":721725,\"suggestedTranslation\":\"Tiếc thật.\",\"rating\":9.0},\n  {\"id\":721726,\"suggestedTranslation\":\"Ta chưa từng thích làm mộc. Mạt cưa bay tứ tung khắp nơi.\",\"rating\":9.0},\n  {\"id\":721727,\"suggestedTranslation\":\"Ghê tởm.\",\"rating\":9.0},\n  {\"id\":721728,\"suggestedTranslation\":\"Củ cà rốt đó thật đáng sợ!\",\"rating\":9.0},\n  {\"id\":721729,\"suggestedTranslation\":\"Ngươi tưởng lừa được ta à?\",\"rating\":9.0},\n  {\"id\":721730,\"suggestedTranslation\":\"Ta chắc chắn nó mang bệnh rồi.\",\"rating\":9.0},\n  {\"id\":721731,\"suggestedTranslation\":\"Bắt đầu thấy tủi thân vì bị bỏ rơi rồi à?\",\"rating\":9.0},\n  {\"id\":721732,\"suggestedTranslation\":\"Ta không phải fan của rau củ đâu.\",\"rating\":9.0},\n  {\"id\":721733,\"suggestedTranslation\":\"Ít ra cũng tinh tế hơn một chút.\",\"rating\":9.0},\n  {\"id\":721734,\"suggestedTranslation\":\"Một củ cà rốt to đ