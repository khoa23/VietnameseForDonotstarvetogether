            "text": "[\n  {\"id\":723966,\"suggestedTranslation\":\"Cuối cùng. Chắc đó là thứ hắn đang tìm.\",\"rating\":9.0},\n  {\"id\":723967,\"suggestedTranslation\":\"Đây có phải thứ hắn muốn không? Sao lão ngốc đó không mô tả kỹ hơn cơ chứ?!\",\"rating\":9.0},\n  {\"id\":723968,\"suggestedTranslation\":\"Liệu đây có phải thứ hắn đang tìm?\",\"rating\":9.0},\n  {\"id\":723969,\"suggestedTranslation\":\"Nhảy xuống chắc sẽ hỏng hết bộ đồ của ta mất.\",\"rating\":9.0},\n  {\"id\":723970,\"suggestedTranslation\":\"Nhảy xuống chắc sẽ hỏng hết bộ đồ của ta mất.\",\"rating\":9.0},\n  {\"id\":723971,\"suggestedTranslation\":\"Nhảy xuống chắc sẽ hỏng hết bộ đồ của ta mất.\",\"rating\":9.0},\n  {\"id\":723972,\"suggestedTranslation\":\"Nếu đã phải bước lên tấm ván thì ta cũng phải thật phong cách.\",\"rating\":9.0},\n  {\"id\":723973,\"suggestedTranslation\":\"Lucy làm việc rất tốt.\",\"rating\":9.0},\n  {\"id\":723974,\"suggestedTranslation\":\"À. Ấm cúng ghê.\",\"rating\":9.0},\n  {\"id\":723975,\"suggestedTranslation\":\"Ta biết thưởng thức những thứ tinh tế.\",\"rating\":9.0},\n  {\"id\":723976,\"suggestedTranslation\":\"Ta đã bảo ngươi rồi mà.\",\"rating\":9.0},\n  {\"id\":723977,\"suggestedTranslation\":\"Đúng là một thùng thuốc súng.\",\"rating\":9.0},\n  {\"id\":723978,\"suggestedTranslation\":\"Mấy mảnh tường bỏ túi á? Chuẩn luôn.\",\"rating\":9.0},\n  {\"id\":723979,\"suggestedTranslation\":\"Ta thích dựng tường ngăn cách bản thân với thế giới.\",\"rating\":9.0},\n  {\"id\":723980,\"suggestedTranslation\":\"Nên đặt cái này ở đâu đây?\",\"rating\":9.0},\n  {\"id\":723981,\"suggestedTranslation\":\"Một bức tường cổ.\",\"rating\":9.0},\n  {\"id\":723982,\"suggestedTranslation\":\"Một bức tường cổ.\",\"rating\":9.0},\n  {\"id\":723983,\"suggestedTranslation\":\"Mấy mảnh tường bỏ túi á? Chuẩn luôn.\",\"rating\":9.0},\n  {\"id\":723984,\"suggestedTranslation\":\"Thô kệch và vô vị.\",\"rating\":9.0},\n  {\"id\":723985,\"suggestedTranslation\":\"Thô kệch và vô vị.\",\"rating\":9.0},\n  {\"id\":723986,\"suggestedTranslation\":\"Cái này sẽ chặn được đám lóc nhóc.\",\"rating\":9.0},\n  {\"id\":723987,\"suggestedTranslation\":\"Cái này sẽ chặn được đám lóc nhóc.\",\"rating\":9.0},\n  {\"id\":723988,\"suggestedTranslation\":\"Mấy mảnh tường bỏ túi á? Chuẩn luôn.\",\"rating\":9.0},\n  {\"id\":723989,\"suggestedTranslation\":\"Không bền, cũng chẳng dễ cháy.\",\"rating\":9.0},\n  {\"id\":723990,\"suggestedTranslation\":\"Bền vừa phải, nhưng dễ cháy.\",\"rating\":9.0},\n  {\"id\":723991,\"suggestedTranslation\":\"Mấy mảnh tường bỏ túi á? Chuẩn luôn.\",\"rating\":9.0},\n  {\"id\":723992,\"suggestedTranslation\":\"Ngươi không nhận ra ta à?\",\"rating\":9.0},\n  {\"id\":723993,\"suggestedTranslation\":\"Sản xuất tại Scotland.\",\"rating\":9.0},\n  {\"id\":723994,\"suggestedTranslation\":\"Tốt nhất là không nên nấn ná khi mùa đông đến.\",\"rating\":9.0},\n  {\"id\":723995,\"suggestedTranslation\":\"Lão Hải Tượng chắc ở gần đây thôi.\",\"rating\":9.0},\n  {\"id\":723996,\"suggestedTranslation\":\"Ta sẽ dùng cái này vào việc có ích hơn.\",\"rating\":9.0},\n  {\"id\":723997,\"suggestedTranslation\":\"Ta không muốn gây gổ đâu!\",\"rating\":9.0},\n  {\"id\":723998,\"suggestedTranslation\":\"Chẳng phải chính ngươi cứ lải nhải về an toàn lửa sao?\",\"rating\":9.0},\n  {\"id\":723999,\"suggestedTranslation\":\"Chào nhé, ngài %s.\",\"rating\":9.0},\n  {\"id\":724000,\"suggestedTranslation\":\"Có lẽ ngươi có thể thêm cái này vào bộ sưu tập truyện ma của mình đấy.\",\"rating\":9.0},\n  {\"id\":724001,\"suggestedTranslation\":\"Thú vị thật, %s. Ta không ngờ ngươi lại làm thế đấy.\",\"rating\":9.0},\n  {\"id\":724002,\"suggestedTranslation\":\"Ta e là mình không thể cho cậu huy hiệu được, chỉ có lời cảm ơn thôi.\",\"rating\":9.0},\n  {\"id\":724003,\"suggestedTranslation\":\"Không hợp với phong cách của ta lắm.\",\"rating\":9.0},\n  {\"id\":724004,\"suggestedTranslation\":\"Ai chọc tức cậu à, %s?\",\"rating\":9.0},\n  {\"id\":724005,\"suggestedTranslation\":\"Còn lâu ta mới đi chất vấn cách làm của cậu, %s.\",\"rating\":9.0},\n  {\"id\":724006,\"suggestedTranslation\":\"Chào ngày mới, cô %s.\",\"rating\":9.0},\n  {\"id\":724007,\"suggestedTranslation\":\"Cuối cùng thời gian cũng bắt kịp cô rồi nhỉ?\",\"rating\":9.0},\n  {\"id\":724008,\"suggestedTranslation\":\"Tên sát nhân khát máu! Ta sẽ cho ngươi thấy sức mạnh thực sự!\",\"rating\":9.0},\n  {\"id\":724009,\"suggestedTranslation\":\"Sự trợ giúp của cậu rất đúng lúc đấy, %s.\",\"rating\":9.0},\n  {\"id\":724010,\"suggestedTranslation\":\"Nó thối hơn bình thường đấy.\",\"rating\":9.0},\n  {\"id\":724011,\"suggestedTranslation\":\"Ta cứ tưởng ngửi thấy gì trong không khí chứ. Hôm nay ngươi bán gì thế?\",\"rating\":9.0},\n  {\"id\":724012,\"suggestedTranslation\":\"Ôi.\",\"rating\":9.0},\n  {\"id\":724013,\"suggestedTranslation\":\"Sự bảnh bao xuất phát từ tâm hồn.\",\"rating\":9.0},\n  {\"id\":724014,\"suggestedTranslation\":\"Thời trang bất chấp công năng.\",\"rating\":9.0},\n  {\"id\":724015,\"suggestedTranslation\":\"Con đầu đàn!\",\"rating\":9.0},\n  {\"id\":724016,\"suggestedTranslation\":\"Thế là giải quyết xong.\",\"rating\":9.0},\n  {\"id\":724017,\"suggestedTranslation\":\"Tốt nhất là nên xử lý nó cho nhanh.\",\"rating\":9.0},\n  {\"id\":724018,\"suggestedTranslation\":\"Có thứ gì đó đã chiếm lấy nó rồi!\",\"rating\":9.0},\n  {\"id\":724019,\"suggestedTranslation\":\"Chúng nhỏ hơn ta nhớ... mềm yếu rồi sao, Charlie?\",\"rating\":9.0},\n  {\"id\":724020,\"suggestedTranslation\":\"Đã thiêu rụi thành tro.\",\"rating\":9.0},\n  {\"id\":724021,\"suggestedTranslation\":\"Cần phải có đuốc.\",\"rating\":9.0},\n  {\"id\":724022,\"suggestedTranslation\":\"Mọi chuẩn bị đã hoàn tất.\",\"rating\":9.0},\n  {\"id\":724023,\"suggestedTranslation\":\"Hôm nay trông %s có vẻ không được bình thường.\",\"rating\":9.0},\n  {\"id\":724024,\"suggestedTranslation\":\"Gần đây %s hay châm những ngọn lửa đáng ngờ đấy.\",\"rating\":9.0},\n  {\"id\":724025,\"suggestedTranslation\":\"Chào nhé, ngài %s.\",\"rating\":9.0},\n  {\"id\":724026,\"suggestedTranslation\":\"Ồ, thật đáng tiếc.\",\"rating\":9.0},\n  {\"id\":724027,\"suggestedTranslation\":\"Ăn cái này đi!\",\"rating\":9.0},\n  {\"id\":724028,\"suggestedTranslation\":\"Cảm ơn vì đã giúp đỡ nhé, %s.\",\"rating\":9.0},\n  {\"id\":724029,\"suggestedTranslation\":\"Cái này có ích đấy.\",\"rating\":9.0},\n  {\"id\":724030,\"suggestedTranslation\":\"Trông nguy hiểm phết.\",\"rating\":9.0},\n  {\"id\":724031,\"suggestedTranslation\":\"Ngươi có biết bộ đồ này đắt thế nào không?\",\"rating\":9.0},\n  {\"id\":724032,\"suggestedTranslation\":\"Thế là ta phải đi lang thang tìm nước à?\",\"rating\":9.0},\n  {\"id\":724033,\"suggestedTranslation\":\"Chắc chắn là có người khác làm được mấy việc vặt này chứ?\",\"rating\":9.0},\n  {\"id\":724034,\"suggestedTranslation\":\"Chủ yếu là nước. Thứ nước ngọt ngào và đầy chất xơ.\",\"rating\":9.0},\n  {\"id\":724035,\"suggestedTranslation\":\"Đây là một cách để hạ nhiệt. Lại còn dính dớp nữa.\",\"rating\":9.0},\n  {\"id\":724036,\"suggestedTranslation\":\"Vụ án quả dưa vẫn chưa có lời giải.\",\"rating\":9.0},\n  {\"id\":724037,\"suggestedTranslation\":\"Dưa hấu nướng.\",\"rating\":9.0},\n  {\"id\":724038,\"suggestedTranslation\":\"Toàn là dưa hấu là dưa hấu.\",\"rating\":9.0},\n  {\"id\":724039,\"suggestedTranslation\":\"Chắc ta đem trồng được mấy thứ thực vật này đấy.\",\"rating\":9.0},\n  {\"id\":724040,\"suggestedTranslation\":\"Ta cá vẻ ngoài mỏng manh đó chỉ là chiêu trò để ta lơi lỏng cảnh giác thôi.\",\"rating\":9.0},\n  {\"id\":724041,\"suggestedTranslation\":\"Ta nên nhổ ngươi đi như một thứ cỏ dại.\",\"rating\":9.0},\n  {\"id\":724042,\"suggestedTranslation\":\"Ta đoán chuẩn rồi.\",\"rating\":9.0},\n  {\"id\":724043,\"suggestedTranslation\":\"Sao ta lại muốn chúng lan rộng ra cơ chứ?\",\"rating\":9.0},\n  {\"id\":724044,\"suggestedTranslation\":\"Higgsbury, tôi nghĩ dùng cái xô là đủ rồi chứ...\",\"rating\":9.0},\n  {\"id\":724045,\"suggestedTranslation\":\"Cái này mọc lên đây từ bao giờ thế?\",\"rating\":9.0},\n  {\"id\":724046,\"suggestedTranslation\":\"Ta đã tìm ra gốc rễ của vấn đề rồi đây.\",\"rating\":9.0},\n  {\"id\":724047,\"suggestedTranslation\":\"Động lực của %s là gì nhỉ?\",\"rating\":9.0},\n  {\"id\":724048,\"suggestedTranslation\":\"Ngọn lửa tiếp theo ngươi châm sẽ là giàn hoả táng đấy.\",\"rating\":9.0},\n  {\"id\":724049,\"suggestedTranslation\":\"Chào nhé, cô %s.\",\"rating\":9.0},\n  {\"id\":724050,\"suggestedTranslation\":\"Cô có muốn một trái tim không, %s?\",\"rating\":9.0},\n  {\"id\":724051,\"suggestedTranslation\":\"Nữ chiến binh khát máu! Chấm dứt tại đây thôi!\",\"rating\":9.0},\n  {\"id\":724052,\"suggestedTranslation\":\"%s có khả năng điều khiển cõi âm cực kỳ xuất sắc.\",\"rating\":9.0},\n  {\"id\":724053,\"suggestedTranslation\":\"Ừm... dù sao thì đó cũng chẳng phải vương miện.\",\"rating\":9.0},\n  {\"id\":724054,\"suggestedTranslation\":\"Giờ thì cô ta đang làm màu đấy à.\",\"rating\":9.0},\n  {\"id\":724055,\"suggestedTranslation\":\"Đúng là thực tế một cách bất ngờ đối với cô ta.\",\"rating\":9.0},\n  {\"id\":724056,\"suggestedTranslation\":\"Nó đông cứng vì sợ hãi rồi.\",\"rating\":9.0},\n  {\"id\":724057,\"suggestedTranslation\":\"Sự hứng thú của ta với tờ giấy sáp này đang lụi tàn...\",\"rating\":9.0},\n  {\"id\":724058,\"suggestedTranslation\":\"Ta lạ gì ánh mắt đó nữa, %s. Ngươi lại đang mưu tính gì đấy?\",\"rating\":9.0},\n  {\"id\":724059,\"suggestedTranslation\":\"Đừng làm hỏng chuyện của chúng ta đấy, %s.\",\"rating\":9.0},\n  {\"id\":724060,\"suggestedTranslation\":\"Đúng là một kẻ bảnh bao!\",\"rating\":9.0},\n  {\"id\":724061,\"suggestedTranslation\":\"Ta sẽ phải trả giá bằng máu để hồi sinh ngươi đấy, %s.\",\"rating\":9.0},\n  {\"id\":724062,\"suggestedTranslation\":\"Ngựa quen đường cũ... và ngươi cũng sẽ bỏ mạng thôi!\",\"rating\":9.0},\n  {\"id\":724063,\"suggestedTranslation\":\"Chỉ nên tin tưởng chính mình thôi nhỉ, %s?\",\"rating\":9.0},\n  {\"id\":724064,\"suggested