slation\":\"Nó đang rỉ ra tinh hoa ác mộng kìa.\",\"rating\":9.0},\n  {\"id\":722997,\"suggestedTranslation\":\"Chúng teo tóp lại hết cả rồi.\",\"rating\":9.0},\n  {\"id\":722998,\"suggestedTranslation\":\"Tôi nghĩ trông nó đẹp hơn rất nhiều theo cách này.\",\"rating\":9.0},\n  {\"id\":722999,\"suggestedTranslation\":\"Tôi phải đeo găng tay khi làm việc này thôi.\",\"rating\":9.0},\n  {\"id\":723000,\"suggestedTranslation\":\"Cái thứ chết tiệt đó!\",\"rating\":9.0},\n  {\"id\":723001,\"suggestedTranslation\":\"Ai mà chẳng thích đào mỏ một chút chứ.\",\"rating\":9.0},\n  {\"id\":723002,\"suggestedTranslation\":\"Nó hoạt động hiệu quả một cách đáng ngạc nhiên.\",\"rating\":9.0},\n  {\"id\":723003,\"suggestedTranslation\":\"Chắc tôi không còn kén chọn được nữa rồi.\",\"rating\":9.0},\n  {\"id\":723004,\"suggestedTranslation\":\"Hắn là một tên lươn lẹo.\",\"rating\":9.0},\n  {\"id\":723005,\"suggestedTranslation\":\"Một kẻ nóng tính đây.\",\"rating\":9.0},\n  {\"id\":723006,\"suggestedTranslation\":\"Dơ dáy thật.\",\"rating\":9.0},\n  {\"id\":723007,\"suggestedTranslation\":\"Hư hỏng đến tận xương tủy.\",\"rating\":9.0},\n  {\"id\":723008,\"suggestedTranslation\":\"Hắn là một tên lươn lẹo.\",\"rating\":9.0},\n  {\"id\":723009,\"suggestedTranslation\":\"Một kẻ nóng tính đây.\",\"rating\":9.0},\n  {\"id\":723010,\"suggestedTranslation\":\"Dơ dáy thật.\",\"rating\":9.0},\n  {\"id\":723011,\"suggestedTranslation\":\"Hư hỏng đến tận xương tủy.\",\"rating\":9.0},\n  {\"id\":723012,\"suggestedTranslation\":\"Ghê tởm. Tên côn đồ gớm ghiếc.\",\"rating\":9.0},\n  {\"id\":723013,\"suggestedTranslation\":\"Ồ, làm thế thì mất mặt quá.\",\"rating\":9.0},\n  {\"id\":723014,\"suggestedTranslation\":\"Lợn quay đây!\",\"rating\":9.0},\n  {\"id\":723015,\"suggestedTranslation\":\"Hừm... đáng yêu ghê nhỉ.\",\"rating\":9.0},\n  {\"id\":723016,\"suggestedTranslation\":\"Để xem mi trốn vào đâu được nữa nào.\",\"rating\":9.0},\n  {\"id\":723017,\"suggestedTranslation\":\"Nếu là hắn, tôi cũng sẽ chạy vào trong đó thôi.\",\"rating\":9.0},\n  {\"id\":723018,\"suggestedTranslation\":\"Đó không phải là một cấu trúc vững chắc.\",\"rating\":9.0},\n  {\"id\":723019,\"suggestedTranslation\":\"Tao sẽ huff và tao sẽ puff cho bay nhà mày luôn!\",\"rating\":9.0},\n  {\"id\":723020,\"suggestedTranslation\":\"Đó là một kẻ biết sắp xếp ưu tiên cuộc sống đấy!\",\"rating\":9.0},\n  {\"id\":723021,\"suggestedTranslation\":\"Ta phong cho ngươi danh hiệu, \\\"Thịt xông khói\\\".\",\"rating\":9.0},\n  {\"id\":723022,\"suggestedTranslation\":\"Nó ngốc nghếch, nhưng là của tôi.\",\"rating\":9.0},\n  {\"id\":723023,\"suggestedTranslation\":\"Đúng là một tên ngốc chảy dãi.\",\"rating\":9.0},\n  {\"id\":723024,\"suggestedTranslation\":\"Chúng bắt đầu biết tổ chức rồi đấy.\",\"rating\":9.0},\n  {\"id\":723025,\"suggestedTranslation\":\"Kẻ đó đã trở nên hoang dã rồi.\",\"rating\":9.0},\n  {\"id\":723026,\"suggestedTranslation\":\"Thế này thì chẳng ích gì đâu.\",\"rating\":9.0},\n  {\"id\":723027,\"suggestedTranslation\":\"Nó cần một loại thịt gì đó.\",\"rating\":9.0},\n  {\"id\":723028,\"suggestedTranslation\":\"Trông cổ kính làm sao.\",\"rating\":9.0},\n  {\"id\":723029,\"suggestedTranslation\":\"Là hắn hoặc tôi thôi.\",\"rating\":9.0},\n  {\"id\":723030,\"suggestedTranslation\":\"Cái đó thật sự tởm lợm.\",\"rating\":9.0},\n  {\"id\":723031,\"suggestedTranslation\":\"Tuyệt thật. Giờ thì lũ chúng nó có cả lửa rồi.\",\"rating\":9.0},\n  {\"id\":723032,\"suggestedTranslation\":\"Hoàn hảo. Tôi sẽ cố không tiêu hết sạch nó vào một chỗ.\",\"rating\":9.0},\n  {\"id\":723033,\"suggestedTranslation\":\"Lũ lợn đó ngày càng trở nên ranh mãnh hơn rồi.\",\"rating\":9.0},\n  {\"id\":723034,\"suggestedTranslation\":\"Một kẻ thích dã ngoại hơn có lẽ sẽ làm được điều gì đó từ cái này.\",\"rating\":9.0},\n  {\"id\":723035,\"suggestedTranslation\":\"Hừ, có vẻ nó thuộc về mặt đất thì đúng hơn.\",\"rating\":9.0},\n  {\"id\":723036,\"suggestedTranslation\":\"Đó không hẳn là một cảnh tượng chào đón gì cho cam.\",\"rating\":9.0},\n  {\"id\":723037,\"suggestedTranslation\":\"Hoan hô.\",\"rating\":9.0},\n  {\"id\":723038,\"suggestedTranslation\":\"Công cụ lựa chọn hàng đầu của những kẻ theo chủ nghĩa hoàn hảo.\",\"rating\":9.0},\n  {\"id\":723039,\"suggestedTranslation\":\"Một nỗ lực yếu ớt nhằm đánh lừa những kẻ tâm trí kém cỏi.\",\"rating\":9.0},\n  {\"id\":723040,\"suggestedTranslation\":\"Hơi nóng đã biến thứ này thành một bữa ăn phù hợp.\",\"rating\":9.0},\n  {\"id\":723041,\"suggestedTranslation\":\"Tôi thực sự phải đội cái cỗ máy kỳ quặc đó lên đầu á?\",\"rating\":9.0},\n  {\"id\":723042,\"suggestedTranslation\":\"Đó là một loài thực vật thông thường.\",\"rating\":9.0},\n  {\"id\":723043,\"suggestedTranslation\":\"Nó đang lớn kìa.\",\"rating\":9.0},\n  {\"id\":723044,\"suggestedTranslation\":\"Nó đã sẵn sàng rồi.\",\"rating\":9.0},\n  {\"id\":723045,\"suggestedTranslation\":\"Nó không đủ sức chịu đựng cái nóng này.\",\"rating\":9.0},\n  {\"id\":723046,\"suggestedTranslation\":\"Tôi nghĩ cô ta đang tận hưởng việc này hơi quá đà rồi đấy.\",\"rating\":9.0},\n  {\"id\":723047,\"suggestedTranslation\":\"Chắc ai đó thích ngựa lắm đây.\",\"rating\":9.0},\n  {\"id\":723048,\"suggestedTranslation\":\"Nó khá là lỗi thời rồi.\",\"rating\":9.0},\n  {\"id\":723049,\"suggestedTranslation\":\"Phải công nhận đây là một góc nhìn độc đáo đấy.\",\"rating\":9.0},\n  {\"id\":723050,\"suggestedTranslation\":\"%s trông có vẻ không đang tin cậy cho lắm...\",\"rating\":9.0},\n  {\"id\":723051,\"suggestedTranslation\":\"%s vừa mới châm lửa đốt nhà kìa.\",\"rating\":9.0},\n  {\"id\":723052,\"suggestedTranslation\":\"Chào mừng nhé, %s.\",\"rating\":9.0},\n  {\"id\":723053,\"suggestedTranslation\":\"%s đang cần sự trợ giúp hình trái tim kìa.\",\"rating\":9.0},\n  {\"id\":723054,\"suggestedTranslation\":\"Tên sát nhân tàn ác! Ta sẽ bất chấp tất cả để ngăn ngươi lại!\",\"rating\":9.0},\n  {\"id\":723055,\"suggestedTranslation\":\"%s đang neo giữ những linh hồn lạc lối với thế giới này.\",\"rating\":9.0},\n  {\"id\":723056,\"suggestedTranslation\":\"Cậu đã thay đổi rồi đấy.\",\"rating\":9.0},\n  {\"id\":723057,\"suggestedTranslation\":\"Jack à? Khoan đã, không phải.\",\"rating\":9.0},\n  {\"id\":723058,\"suggestedTranslation\":\"Không ai khác chính là quân bốn tép!\",\"rating\":9.0},\n  {\"id\":723059,\"suggestedTranslation\":\"Mấy cái dụng cụ cầm tay nhỏ xíu, đúng là cổ kính thật.\",\"rating\":9.0},\n  {\"id\":723060,\"suggestedTranslation\":\"Cẩn thận đấy, thưa quý cô. Tôi biết con đường này cuối cùng sẽ dẫn đến đâu đấy.\",\"rating\":9.0},\n  {\"id\":723061,\"suggestedTranslation\":\"Xem ra lần này cô ta sẽ phải chờ đợi thôi.\",\"rating\":9.0},\n  {\"id\":723062,\"suggestedTranslation\":\"Cô ta chẳng hiểu hết được sức mạnh mà mình đang đùa giỡn lớn đến mức nào đâu.\",\"rating\":9.0},\n  {\"id\":723063,\"suggestedTranslation\":\"Cẩn thận đấy, thưa quý cô. Tôi biết con đường này cuối cùng sẽ dẫn đến đâu đấy.\",\"rating\":9.0},\n  {\"id\":723064,\"suggestedTranslation\":\"Xem ra lần này cô ta sẽ phải chờ đợi thôi.\",\"rating\":9.0},\n  {\"id\":723065,\"suggestedTranslation\":\"Ít ra thì nó không có mùi, không giống như mấy phương tiện di chuyển khác.\",\"rating\":9.0}\n]",
