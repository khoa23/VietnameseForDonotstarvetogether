nslation\":\"Món... ưa thích của ta... cô ấy vẫn nhớ.\",\"rating\":9.0},\n  {\"id\":724183,\"suggestedTranslation\":\"Lè loẹt, hệt như cái bữa tiệc lố bịch này vậy.\",\"rating\":9.0},\n  {\"id\":724184,\"suggestedTranslation\":\"Đúng là thứ đáng để đánh đổi cả mạng sống.\",\"rating\":9.0},\n  {\"id\":724185,\"suggestedTranslation\":\"Một món đồ trang trí dễ phát nổ.\",\"rating\":9.0},\n  {\"id\":724186,\"suggestedTranslation\":\"Thứ này có gì đó quen quen...\",\"rating\":9.0},\n  {\"id\":724187,\"suggestedTranslation\":\"Thật là phù phiếm.\",\"rating\":9.0},\n  {\"id\":724188,\"suggestedTranslation\":\"Lão cua già đó cũng có chút tài nghệ đấy chứ.\",\"rating\":9.0},\n  {\"id\":724189,\"suggestedTranslation\":\"Đúng là một phép màu của Đêm Đông.\",\"rating\":9.0},\n  {\"id\":724190,\"suggestedTranslation\":\"Xem ra là vậy rồi.\",\"rating\":9.0},\n  {\"id\":724191,\"suggestedTranslation\":\"Vui vẻ đến khốn khổ.\",\"rating\":9.0},\n  {\"id\":724192,\"suggestedTranslation\":\"Chúng ta không còn việc gì hay ho hơn để làm với thời gian à?\",\"rating\":9.0},\n  {\"id\":724193,\"suggestedTranslation\":\"Xem ra là vậy rồi.\",\"rating\":9.0},\n  {\"id\":724194,\"suggestedTranslation\":\"Không khí lễ hội mới ghê làm sao.\",\"rating\":9.0},\n  {\"id\":724195,\"suggestedTranslation\":\"Loài sinh vật nào lại sống trong đó thế nhỉ?\",\"rating\":9.0},\n  {\"id\":724196,\"suggestedTranslation\":\"Hồi ta còn quản lý thì chúng đâu có thế này.\",\"rating\":9.0},\n  {\"id\":724197,\"suggestedTranslation\":\"Ta thà không có mấy cái càng nhọn hoắt, kẹp đau đớn ấy còn hơn.\",\"rating\":9.0},\n  {\"id\":724198,\"suggestedTranslation\":\"Tuyệt vời.\",\"rating\":9.0},\n  {\"id\":724199,\"suggestedTranslation\":\"Ta quên mang yếm ăn rồi.\",\"rating\":9.0},\n  {\"id\":724200,\"suggestedTranslation\":\"Ta thà không để lông dính đầy bộ đồ của mình.\",\"rating\":9.0},\n  {\"id\":724201,\"suggestedTranslation\":\"Ta thà không để lông dính đầy bộ đồ của mình.\",\"rating\":9.0},\n  {\"id\":724202,\"suggestedTranslation\":\"Nó cứ chảy nước dãi...\",\"rating\":9.0},\n  {\"id\":724203,\"suggestedTranslation\":\"Nó cứ chảy nước dãi...\",\"rating\":9.0},\n  {\"id\":724204,\"suggestedTranslation\":\"Hình như ta thấy Wilson đang gặm một cái thì phải.\",\"rating\":9.0},\n  {\"id\":724205,\"suggestedTranslation\":\"Tên lực điền %s trông có vẻ hơi mất trí.\",\"rating\":9.0},\n  {\"id\":724206,\"suggestedTranslation\":\"Cậu định đốt cái đó thật à, %s?\",\"rating\":9.0},\n  {\"id\":724207,\"suggestedTranslation\":\"Chào ngày mới nhé, ngài %s.\",\"rating\":9.0},\n  {\"id\":724208,\"suggestedTranslation\":\"Đi tìm tim thôi. Để ta chuẩn bị làm phép.\",\"rating\":9.0},\n  {\"id\":724209,\"suggestedTranslation\":\"Tên sát nhân khát máu! Chiêm ngưỡng sức mạnh của ta đi!\",\"rating\":9.0},\n  {\"id\":724210,\"suggestedTranslation\":\"%s gắn kết các linh hồn lạc lối với thế giới này.\",\"rating\":9.0},\n  {\"id\":724211,\"suggestedTranslation\":\"À phải rồi. Còn gì kích thích hơn tiếng thét của một chiếc còi chứ?\",\"rating\":9.0},\n  {\"id\":724212,\"suggestedTranslation\":\"Con khỉ đó là một hiểm họa.\",\"rating\":9.0},\n  {\"id\":724213,\"suggestedTranslation\":\"Kẻ nào cho phép con khỉ nghịch lửa thế hả?!\",\"rating\":9.0},\n  {\"id\":724214,\"suggestedTranslation\":\"Nhìn cái gì mà nhìn, hả khỉ?\",\"rating\":9.0},\n  {\"id\":724215,\"suggestedTranslation\":\"Thật đáng tiếc.\",\"rating\":9.0},\n  {\"id\":724216,\"suggestedTranslation\":\"Đã đến lúc ta phải tiễn sinh vật đó lên đường rồi.\",\"rating\":9.0},\n  {\"id\":724217,\"suggestedTranslation\":\"Ít ra con khỉ đó trông có vẻ đã được huấn luyện cẩn thận.\",\"rating\":9.0},\n  {\"id\":724218,\"suggestedTranslation\":\"Quá xù xì so với gu của ta.\",\"rating\":9.0},\n  {\"id\":724219,\"suggestedTranslation\":\"%s đang làm trái tự nhiên rồi đấy...\",\"rating\":9.0},\n  {\"id\":724220,\"suggestedTranslation\":\"Ha! Lời nguyền thú vị thật đấy.\",\"rating\":9.0},\n  {\"id\":724221,\"suggestedTranslation\":\"Yew don't look so wood.\",\"rating\":9.0},\n  {\"id\":724222,\"suggestedTranslation\":\"Với sở thích của cậu thì đi châm lửa có khôn ngoan không thế?\",\"rating\":9.0},\n  {\"id\":724223,\"suggestedTranslation\":\"Chào nhé, ngài %s.\",\"rating\":9.0},\n  {\"id\":724224,\"suggestedTranslation\":\"Cái đầu gỗ đó rất cần một trái tim đấy.\",\"rating\":9.0},\n  {\"id\":724225,\"suggestedTranslation\":\"Trông hình dạng cậu vừa biến thành chẳng oai chút nào cả.\",\"rating\":9.0},\n  {\"id\":724226,\"suggestedTranslation\":\"Xem ra cậu gặp rắc rối to rồi đấy, bạn hiền.\",\"rating\":9.0},\n  {\"id\":724227,\"suggestedTranslation\":\"Tuyệt vời. Lại thêm một con Hươu Sừng Tấm chập mạch.\",\"rating\":9.0},\n  {\"id\":724228,\"suggestedTranslation\":\"Ta mặc kệ cậu Hươu Sừng Tấm suy ngẫm nhé, để ta đi tìm trái tim đây.\",\"rating\":9.0},\n  {\"id\":724229,\"suggestedTranslation\":\"Đồ quái vật! Đến lúc biến thành cái cây rồi đấy...!\",\"rating\":9.0},\n  {\"id\":724230,\"suggestedTranslation\":\"%s có vẻ rất thấu hiểu các linh hồn của khu rừng.\",\"rating\":9.0},\n  {\"id\":724231,\"suggestedTranslation\":\"Thế lại hay hơn.\",\"rating\":9.0},\n  {\"id\":724232,\"suggestedTranslation\":\"Không hiểu sao cứ nghĩ đến chuyện ngồi xuống là ta lại thấy hoảng.\",\"rating\":9.0},\n  {\"id\":724233,\"suggestedTranslation\":\"Tốt lắm. Ngồi đó đi. Mãi mãi luôn nhé.\",\"rating\":9.0},\n  {\"id\":724234,\"suggestedTranslation\":\"Dằng nào thì nó cũng có hợp với trang trí đâu.\",\"rating\":9.0},\n  {\"id\":724235,\"suggestedTranslation\":\"Lẽ ra phải có ai dọn bàn này chứ.\",\"rating\":9.0},\n  {\"id\":724236,\"suggestedTranslation\":\"Lẽ ra phải có ai dọn bàn này chứ.\",\"rating\":9.0},\n  {\"id\":724237,\"suggestedTranslation\":\"Có cái gì đó đang động đậy.\",\"rating\":9.0},\n  {\"id\":724238,\"suggestedTranslation\":\"Đừng hòng lừa được ta, thực vật ạ.\",\"rating\":9.0},\n  {\"id\":724239,\"suggestedTranslation\":\"Không phải do ta tạo ra con đó đâu! Thật đấy!\",\"rating\":9.0},\n  {\"id\":724240,\"suggestedTranslation\":\"Biết đằng kia trông thế nào còn đáng sợ hơn.\",\"rating\":9.0},\n  {\"id\":724241,\"suggestedTranslation\":\"Ta đảm bảo ngửi còn tệ hơn cả nhìn đấy.\",\"rating\":9.0},\n  {\"id\":724242,\"suggestedTranslation\":\"Trông nó có vẻ ốm yếu.\",\"rating\":9.0},\n  {\"id\":724243,\"suggestedTranslation\":\"Đúng là một mẹo hay ho.\",\"rating\":9.0},\n  {\"id\":724244,\"suggestedTranslation\":\"Cái này không ngon lắm.\",\"rating\":9.0},\n  {\"id\":724245,\"suggestedTranslation\":\"Đừng hòng lừa được ta, thực vật ạ.\",\"rating\":9.0},\n  {\"id\":724246,\"suggestedTranslation\":\"Đã đến lúc ngươi làm như cái cây rồi cút đi cho rồi.\",\"rating\":9.0},\n  {\"id\":724247,\"suggestedTranslation\":\"%s lại vừa đi châm lửa khắp nơi phải không nhỉ?\",\"rating\":9.0},\n  {\"id\":724248,\"suggestedTranslation\":\"Chào nhé, ngài %s.\",\"rating\":9.0},\n  {\"id\":724249,\"suggestedTranslation\":\"Thật đáng tiếc. Giờ thì ta không bao giờ biết viên ngọc đó làm gì nữa rồi.\",\"rating\":9.0},\n  {\"id\":724250,\"suggestedTranslation\":\"Đừng lo, %s. Ta sẽ cho ngươi bay màu một cách nhanh gọn.\",\"rating\":9.0},\n  {\"id\":724251,\"suggestedTranslation\":\"Chắc cậu ta cũng có vài công dụng đấy.\",\"rating\":9.0},\n  {\"id\":724252,\"suggestedTranslation\":\"Ghê tởm thật.\",\"rating\":9.0},\n  {\"id\":724253,\"suggestedTranslation\":\"Củ cà rốt đó thật kinh tởm!\",\"rating\":9.0},\n  {\"id\":724254,\"suggestedTranslation\":\"Ngươi tưởng lừa được ta à?\",\"rating\":9.0},\n  {\"id\":724255,\"suggestedTranslation\":\"Ta chắc là nó bị bệnh rồi.\",\"rating\":9.0},\n  {\"id\":724256,\"suggestedTranslation\":\"Chúng chẳng cởi mở cho lắm.\",\"rating\":9.0},\n  {\"id\":724257,\"suggestedTranslation\":\"Ta cá là nó rất ngon.\",\"rating\":9.0},\n  {\"id\":724258,\"suggestedTranslation\":\"Giấc ngủ chỉ là sự trốn tránh tạm thời thôi.\",\"rating\":9.0},\n  {\"id\":724259,\"suggestedTranslation\":\"Cuối cùng cũng có một dạng đột biến thực sự hữu ích.\",\"rating\":9.0},\n  {\"id\":724260,\"suggestedTranslation\":\"Kẻ nào đã đào bới con quái vật này lên thế hả?\",\"rating\":9.0},\n  {\"id\":724261,\"suggestedTranslation\":\"Đừng để ta dùng ma thuật trói ngươi lại đấy, tiểu yêu.\",\"rating\":9.0},\n  {\"id\":724262,\"suggestedTranslation\":\"Ta ngửi thấy mùi lửa và lưu huỳnh à?\",\"rating\":9.0},\n  {\"id\":724263,\"suggestedTranslation\":\"Chào nhé, ngài %s.\",\"rating\":9.0},\n  {\"id\":724264,\"suggestedTranslation\":\"Đáng đời ngươi lắm, tên tiểu yêu nhiều chuyện.\",\"rating\":9.0},\n  {\"id\":724265,\"suggestedTranslation\":\"Thế là đủ lắm rồi! Chuẩn bị bị trục xuất đi, tiểu yêu!\",\"rating\":9.0}\n]",
