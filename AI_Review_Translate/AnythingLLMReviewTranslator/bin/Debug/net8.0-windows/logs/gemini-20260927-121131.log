nslation\": \"Này Bà Lão! Nhìn lượng mật ong chúng làm được kìa!\", \"rating\": 0.0},\n  {\"id\": 725186, \"suggestedTranslation\": \"Làm việc nhanh lên, lũ ong!\", \"rating\": 0.0},\n  {\"id\": 725187, \"suggestedTranslation\": \"Chúng tôi thấy nó đi quanh đây một phút trước mà.\", \"rating\": 0.0},\n  {\"id\": 725188, \"suggestedTranslation\": \"Con Bò Lai tội nghiệp của chúng ta! Thật bất công!\", \"rating\": 0.0},\n  {\"id\": 725189, \"suggestedTranslation\": \"Con này thích chúng ta!\", \"rating\": 0.0},\n  {\"id\": 725190, \"suggestedTranslation\": \"Nó có vẻ muốn ở lại quanh đây.\", \"rating\": 0.0},\n  {\"id\": 725191, \"suggestedTranslation\": \"Con Bò Lai siêu to khổng lồ!\", \"rating\": 0.0},\n  {\"id\": 725192, \"suggestedTranslation\": \"Đó là bạn của chúng ta!\", \"rating\": 0.0},\n  {\"id\": 725193, \"suggestedTranslation\": \"Cạo lông mượt thế!\", \"rating\": 0.0},\n  {\"id\": 725194, \"suggestedTranslation\": \"Chúng tôi hơi sợ con này.\", \"rating\": 0.0},\n  {\"id\": 725195, \"suggestedTranslation\": \"Chúng tôi thích ôm ấp con này!\", \"rating\": 0.0},\n  {\"id\": 725196, \"suggestedTranslation\": \"Con này trông có vẻ nhanh nhẹn.\", \"rating\": 0.0},\n  {\"id\": 725197, \"suggestedTranslation\": \"Ngủ sâu nhé, Bò Lai.\", \"rating\": 0.0},\n  {\"id\": 725198, \"suggestedTranslation\": \"Chúng ta chăm sóc Bò Lai rất kỹ.\", \"rating\": 0.0},\n  {\"id\": 725199, \"suggestedTranslation\": \"Người mặc sẽ hòa nhập hoàn hảo.\", \"rating\": 0.0},\n  {\"id\": 725200, \"suggestedTranslation\": \"Bò Lai ngoan xứng đáng được thưởng.\", \"rating\": 0.0},\n  {\"id\": 725201, \"suggestedTranslation\": \"Lông Dày.\", \"rating\": 0.0},\n  {\"id\": 725202, \"suggestedTranslation\": \"Hừm...\", \"rating\": 0.0},\n  {\"id\": 725203, \"suggestedTranslation\": \"Chúng ta muốn Bò Lai của mình trông thật bảnh!\", \"rating\": 0.0},\n  {\"id\": 725204, \"suggestedTranslation\": \"Cậu sẽ trông thật tuyệt khi chúng ta làm xong!\", \"rating\": 0.0},\n  {\"id\": 725205, \"suggestedTranslation\": \"Chúng ta nên dựng nó lên thôi.\", \"rating\": 0.0},\n  {\"id\": 725206, \"suggestedTranslation\": \"Bò Lai rất thích cái chuông này, và cả ai rung nó nữa!\", \"rating\": 0.0},\n  {\"id\": 725207, \"suggestedTranslation\": \"Trông xù lông thế mà dữ dằn ghê!!\", \"rating\": 0.0},\n  {\"id\": 725208, \"suggestedTranslation\": \"Đó là một pháo đài mặt!\", \"rating\": 0.0},\n  {\"id\": 725209, \"suggestedTranslation\": \"Đúng là một tổ ong bận rộn.\", \"rating\": 0.0},\n  {\"id\": 725210, \"suggestedTranslation\": \"Cậu có muốn làm Bẫy ong của tớ không?\", \"rating\": 0.0},\n  {\"id\": 725211, \"suggestedTranslation\": \"Tôi thực sự không thể ngấm nổi cậu.\", \"rating\": 0.0},\n  {\"id\": 725212, \"suggestedTranslation\": \"Lũ ong không phải bạn chúng ta!\", \"rating\": 0.0},\n  {\"id\": 725213, \"suggestedTranslation\": \"Không phải mạng nhện. Chúng ta không đi lên đó được.\", \"rating\": 0.0},\n  {\"id\": 725214, \"suggestedTranslation\": \"Tự hỏi lũ ong đang làm gì thế!\", \"rating\": 0.0},\n  {\"id\": 725215, \"suggestedTranslation\": \"Ôi, phiền phức thật!\", \"rating\": 0.0},\n  {\"id\": 725216, \"suggestedTranslation\": \"Thứ này làm tôi nổi mẩn.\", \"rating\": 0.0},\n  {\"id\": 725217, \"suggestedTranslation\": \"Chúng ta chỉ được phép xịt nó lên thực vật thôi.\", \"rating\": 0.0},\n  {\"id\": 725218, \"suggestedTranslation\": \"Bộ giáp đó chắc là nặng lắm.\", \"rating\": 0.0},\n  {\"id\": 725219, \"suggestedTranslation\": \"Đúng là lượng chuông vừa vặn.\", \"rating\": 0.0},\n  {\"id\": 725220, \"suggestedTranslation\": \"Con gấu bông đó đang di chuyển kìa!\", \"rating\": 0.0},\n  {\"id\": 725221, \"suggestedTranslation\": \"Vừa đáng sợ vừa đáng yêu cùng một lúc!!\", \"rating\": 0.0},\n  {\"id\": 725222, \"suggestedTranslation\": \"Nó hỏng bét hết cả rồi.\", \"rating\": 0.0},\n  {\"id\": 725223, \"suggestedTranslation\": \"Một con gấu bông.\", \"rating\": 0.0},\n  {\"id\": 725224, \"suggestedTranslation\": \"Túi nước trái cây.\", \"rating\": 0.0},\n  {\"id\": 725225, \"suggestedTranslation\": \"Túi nước trái cây ấm áp.\", \"rating\": 0.0},\n  {\"id\": 725226, \"suggestedTranslation\": \"Ngon quá! Đi tìm thêm nào!\", \"rating\": 0.0},\n  {\"id\": 725227, \"suggestedTranslation\": \"Chúng thật là chắc bụng!\", \"rating\": 0.0},\n  {\"id\": 725228, \"suggestedTranslation\": \"Nó đã cạn kiệt thức ăn thực vật rồi.\", \"rating\": 0.0},\n  {\"id\": 725229, \"suggestedTranslation\": \"Ôi không! Cháy rồi!\", \"rating\": 0.0},\n  {\"id\": 725230, \"suggestedTranslation\": \"Có lẽ nó cần chút súp gà chăng?\", \"rating\": 0.0},\n  {\"id\": 725231, \"suggestedTranslation\": \"Cậu ổn chứ, bụi cây nhỏ?\", \"rating\": 0.0},\n  {\"id\": 725232, \"suggestedTranslation\": \"Chín mọng để hái rồi.\", \"rating\": 0.0},\n  {\"id\": 725233, \"suggestedTranslation\": \"Hẹn gặp lại nhé, Dâu Rừng!\", \"rating\": 0.0},\n  {\"id\": 725234, \"suggestedTranslation\": \"Trời nóng quá chịu không nổi hả?\", \"rating\": 0.0},\n  {\"id\": 725235, \"suggestedTranslation\": \"Nó cần chút phân bón!\", \"rating\": 0.0},\n  {\"id\": 725236, \"suggestedTranslation\": \"Ôi không! Cháy rồi!\", \"rating\": 0.0},\n  {\"id\": 725237, \"suggestedTranslation\": \"Có lẽ nó cần chút súp gà chăng?\", \"rating\": 0.0},\n  {\"id\": 725238, \"suggestedTranslation\": \"Cậu ổn chứ, bụi cây nhỏ?\", \"rating\": 0.0},\n  {\"id\": 725239, \"suggestedTranslation\": \"Mấy quả Dâu Rừng đó trông mọng nước quá!\", \"rating\": 0.0},\n  {\"id\": 725240, \"suggestedTranslation\": \"Nó đang tranh thủ chợp mắt đấy.\", \"rating\": 0.0},\n  {\"id\": 725241, \"suggestedTranslation\": \"Ầi, cậu buồn à?\", \"rating\": 0.0},\n  {\"id\": 725242, \"suggestedTranslation\": \"Nó ngọt đến mức gần như có vị giống cục kẹo vậy!\", \"rating\": 0.0},\n  {\"id\": 725243, \"suggestedTranslation\": \"Ồ, nó giống như một loại bánh mì ngọt!\", \"rating\": 0.0},\n  {\"id\": 725244, \"suggestedTranslation\": \"AAAAAAAAAH!\", \"rating\": 0.0},\n  {\"id\": 725245, \"suggestedTranslation\": \"Hóa ra thứ đó ở bên trong!\", \"rating\": 0.0},\n  {\"id\": 725246, \"suggestedTranslation\": \"Chúng ta làm người canh ngục tồi quá.\", \"rating\": 0.0},\n  {\"id\": 725247, \"suggestedTranslation\": \"Đó là nhà tù.\", \"rating\": 0.0},\n  {\"id\": 725248, \"suggestedTranslation\": \"Trông nó có vẻ đói.\", \"rating\": 0.0},\n  {\"id\": 725249, \"suggestedTranslation\": \"Tù nhân.\", \"rating\": 0.0},\n  {\"id\": 725250, \"suggestedTranslation\": \"Ew.\", \"rating\": 0.0},\n  {\"id\": 725251, \"suggestedTranslation\": \"Cậu phải ngủ để sống sót trong nhà tù.\", \"rating\": 0.0},\n  {\"id\": 725252, \"suggestedTranslation\": \"Chúng ta cần cho nó ăn.\", \"rating\": 0.0},\n  {\"id\": 725253, \"suggestedTranslation\": \"Chúng tôi thích mùi đó!\", \"rating\": 0.0},\n  {\"id\": 725254, \"suggestedTranslation\": \"Chọc nó đi!\", \"rating\": 0.0},\n  {\"id\": 725255, \"suggestedTranslation\": \"Chuyện gì đang xảy ra với nó vậy?\", \"rating\": 0.0},\n  {\"id\": 725256, \"suggestedTranslation\": \"Lại đây với cái bẫy tơ của chúng ta nào, lũ chim!\", \"rating\": 0.0},\n  {\"id\": 725257, \"suggestedTranslation\": \"Một quả trứng vỏ cứng.\", \"rating\": 0.0},\n  {\"id\": 725258, \"suggestedTranslation\": \"Chiên giống hệt cách mẹ làm.\", \"rating\": 0.0},\n  {\"id\": 725259, \"suggestedTranslation\": \"Chúng ta nghĩ có gì đó không ổn với con chim đó...\", \"rating\": 0.0},\n  {\"id\": 725260, \"suggestedTranslation\": \"Đừng có nhổ nước bọt vào chúng tao!\", \"rating\": 0.0},\n  {\"id\": 725261, \"suggestedTranslation\": \"Ngươi không chơi theo luật cờ vua ông nội dạy tôi rồi.\", \"rating\": 0.0},\n  {\"id\": 725262, \"suggestedTranslation\": \"Á đau!\", \"rating\": 0.0},\n  {\"id\": 725263, \"suggestedTranslation\": \"Quân tượng của những giấc mơ xấu.\", \"rating\": 0.0},\n  {\"id\": 725264, \"suggestedTranslation\": \"Chúng ta vẽ một hình đầu lâu đáng sợ lên đó! Nhưng chúng ta lại dùng mực đen...\", \"rating\": 0.0},\n  {\"id\": 725265, \"suggestedTranslation\": \"Hơn thổi hơi nóng một bậc.\", \"rating\": 0.0},\n  {\"id\": 725266, \"suggestedTranslation\": \"Chúng tôi thích chiến đấu từ xa.\", \"rating\": 0.0},\n  {\"id\": 725267, \"suggestedTranslation\": \"Mấy cái đó trông vui phết!\", \"rating\": 0.0},\n  {\"id\": 725268, \"suggestedTranslation\": \"Cũng giống như thổi bong bóng vậy.\", \"rating\": 0.0},\n  {\"id\": 725269, \"suggestedTranslation\": \"Thuốc ngủ đường hàng không.\", \"rating\": 0.0},\n  {\"id\": 725270, \"suggestedTranslation\": \"Đúng là một cú sốc điện cho cơ thể.\", \"rating\": 0.0},\n  {\"id\": 725271, \"suggestedTranslation\": \"Chắc là nó cũng đẹp.\", \"rating\": 0.0},\n  {\"id\": 725272, \"suggestedTranslation\": \"Lấp lánh và mát lạnh.\", \"rating\": 0.0},\n  {\"id\": 725273, \"suggestedTranslation\": \"Này! Có ai đánh rơi mắt không vậy?\", \"rating\": 0.0},\n  {\"id\": 725274, \"suggestedTranslation\": \"\\\"Làm theo hướng dẫn\\\", mẹ vẫn thường nói thế.\", \"rating\": 0.0},\n  {\"id\": 725275, \"suggestedTranslation\": \"Cái này có vẻ đặc biệt.\", \"rating\": 0.0},\n  {\"id\": 725276, \"suggestedTranslation\": \"Cậu phải điên lắm mới...\", \"rating\": 0.0},\n  {\"id\": 725277, \"suggestedTranslation\": \"May là chúng ta cảm thấy khỏe mạnh.\", \"rating\": 0.0},\n  {\"id\": 725278, \"suggestedTranslation\": \"Vroom vroom, cây nấm.\", \"rating\": 0.0},\n  {\"id\": 725279, \"suggestedTranslation\": \"Trốn à?\", \"rating\": 0.0},\n  {\"id\": 725280, \"suggestedTranslation\": \"Biết đâu nó sẽ mọc lại.\", \"rating\": 0.0},\n  {\"id\": 725281, \"suggestedTranslation\": \"Khúc gỗ, nhưng mà phẳng.\", \"rating\": 0.0},\n  {\"id\": 725282, \"suggestedTranslation\": \"Để chúng tôi yên!\", \"rating\": 0.0},\n  {\"id\": 725283, \"suggestedTranslation\": \"Ngươi trông có vẻ không cứng rắn lắm đâu!\", \"rating\": 0.0},\n  {\"id\": 725284, \"suggestedTranslation\": \"Ồ không, ai đó gặp tai nạn rồi!\", \"rating\": 0.0},\n  {\"id\": 725285, \"suggestedTranslation\": \"Ồ không, ai đó gặp tai nạn rồi!\", \"rating\": 0.0},\n  {\"id\": 725286, \"suggestedTranslation\": \"Ồ không, ai đó gặp tai nạn rồi!\", \"rating\": 0.0},\n  {\"id\": 725287, \"suggestedTranslation\": \"Nó giúp thuyền ván dễ chịu hơn.\", \"rating\": 0.0},\n  {\"id\": 725288, \"suggestedTranslation\": \"Dùng để chữa lành mấy vết bầm dập cho thuyền ván!\", \"rating\": 0.0},\n  {\"id\": 725289, \"suggestedTranslation\": \"Kiểm tra! Đây là một điểm kiểm soát!\", \"rating\": 0.0},\n  {\"id\": 725290, \"suggestedTranslation\": \"Chúng ta được quyền quyết định nó đi đâu sao?\", \"rating\": 0.0},\n  {\"id\": 725291, \"suggestedTranslation\": \"Chào! Muốn đua không?\", \"rating\": 0.0},\n  {\"id\": 725292, \"suggestedTranslation\": \"Cẩn thận! Đừng đâm vào vật nổi!\", \"rating\": 0.0},\n  {\"id\": 725293, \"suggestedTranslation\": \"Cẩn thận! Đừng đâm vào vật nổi!\", \"rating\": 0.0},\n  {\"id\": 725294, \"suggestedTranslation\": \"Chúng ta nên ném vật nổi đi đâu đây?\", \"rating\": 0.0},\n  {\"id\": 725295, \"suggestedTranslation\": \"Chúng ta nên ném vật nổi đi đâu đây?\", \"rating\": 0.0},\n  {\"id\": 725296, \"suggestedTranslation\": \"Cậu ấy thật tốt khi cổ vũ chúng ta.\", \"rating\": 0.0},\n  {\"id\": 725297, \"suggestedTranslation\": \"Ai về đích cuối là quả trứng thối!\", \"rating\": 0.0},\n  {\"id\": 725298, \"suggestedTranslation\": \"Chúng ta nên bắt đầu ở đây? Hay ở đằng kia? Hay đằng nọ?\", \"rating\": 0.0},\n  {\"id\": 725299, \"suggestedTranslation\": \"Đó là nơi chúng ta giấu tất cả món đồ chơi yêu thích.\", \"rating\": 0.0},\n  {\"id\": 725300, \"suggestedTranslation\": \"Đóng một chiếc thuyền ván mới cho trông cũ kỹ á? Chúng ta không hiểu nổi...\", \"rating\": 0.0},\n  {\"id\": 725301, \"suggestedTranslation\": \"Giờ thì chúng ta sẽ thắng trò đua thuyền đụng rồi!\", \"rating\": 0.0},\n  {\"id\": 725302, \"suggestedTranslation\": \"Giờ thì chúng ta có thể chơi thuyền đụng rồi!\", \"rating\": 0.0},\n  {\"id\": 725303, \"suggestedTranslation\": \"Nó giúp thuyền ván không bị tổn thương.\", \"rating\": 0.0},\n  {\"id\": 725304, \"suggestedTranslation\": \"Giờ thì chúng ta có thể chơi thuyền đụng rồi!\", \"rating\": 0.0},\n  {\"id\": 725305, \"suggestedTranslation\": \"Nó giúp thuyền ván không bị tổn thương.\", \"rating\": 0.0},\n  {\"id\": 725306, \"suggestedTranslation\": \"Giờ thì chúng ta có thể chơi thuyền đụng rồi!\", \"rating\": 0.0},\n  {\"id\": 725307, \"suggestedTranslation\": \"Giờ thì thuyền ván của chúng ta cũng có nanh vuốt rồi!\", \"rating\": 0.0},\n  {\"id\": 725308, \"suggestedTranslation\": \"Giờ thì chúng ta có thể chơi thuyền đụng rồi!\", \"rating\": 0.0},\n  {\"id\": 725309, \"suggestedTranslation\": \"Biết là không nên nghịch, nhưng Willow bảo vui lắm...\", \"rating\": 0.0},\n  {\"id\": 725310, \"suggestedTranslation\": \"Bà Wickerbottom bảo chúng ta chơi được miễn là bên trong không có đạn đại bác.\", \"rating\": 0.0},\n  {\"id\": 725311, \"suggestedTranslation\": \"Ối, quên mang đạn đại bác mất tiêu rồi!\", \"rating\": 0.0},\n  {\"id\": 725312, \"suggestedTranslation\": \"Nếu chúng ta chế tạo nó, có được chơi cùng không?\", \"rating\": 0.0},\n  {\"id\": 725313, \"suggestedTranslation\": \"Đan một chiếc thuyền ván bằng cỏ chắc không khó hơn đan mạng nhện là mấy.\", \"rating\": 0.0},\n  {\"id\": 725314, \"suggestedTranslation\": \"Cái đó dùng để đóng thuyền ván.\", \"rating\": 0.0},\n  {\"id\": 725315, \"suggestedTranslation\": \"Mau lên, bịp lỗ thủng lại!\", \"rating\": 0.0},\n  {\"id\": 725316, \"suggestedTranslation\": \"Uây!\", \"rating\": 0.0},\n  {\"id\": 725317, \"suggestedTranslation\": \"Chúng ta không biết nam châm có thể mọc to đến thế!\", \"rating\": 0.0},\n  {\"id\": 725318, \"suggestedTranslation\": \"Nó đang nhấp nháy kìa! Tốt đúng không?\", \"rating\": 0.0},\n  {\"id\": 725319, \"suggestedTranslation\": \"Đúng là một cỗ máy nhỏ buồn cười.\", \"rating\": 0.0},\n  {\"id\": 725320, \"suggestedTranslation\": \"Mà anh Wilson bảo mấy mảnh đó lắp vào nhau kiểu gì ấy nhỉ...?\", \"rating\": 0.0},\n  {\"id\": 725321, \"suggestedTranslation\": \"Chúng ta có thể quay thuyền ván như vòng quay ngựa gỗ!\", \"rating\": 0.0},\n  {\"id\": 725322, \"suggestedTranslation\": \"Chúng ta giỏi làm mấy thứ xoay vòng lắm!\", \"rating\": 0.0},\n  {\"id\": 725323, \"suggestedTranslation\": \"Một cái gối xù bông phồng phao!\", \"rating\": 0.0},\n  {\"id\": 725324, \"suggestedTranslation\": \"Cái gối đó đang... nhỏ giọt kìa?\", \"rating\": 0.0},\n  {\"id\": 725325, \"suggestedTranslation\": \"Đây là chiếc gối thơm nhất mà chúng ta từng ngửi thấy!\", \"rating\": 0.0},\n  {\"id\": 725326, \"suggestedTranslation\": \"Á! Cái này gai góc thật đấy...\", \"rating\": 0.0},\n  {\"id\": 725327, \"suggestedTranslation\": \"Đỡ này!\", \"rating\": 0.0},\n  {\"id\": 725328, \"suggestedTranslation\": \"Wormwood đã làm gì đó đặc biệt với nó kìa!\", \"rating\": 0.0},\n  {\"id\": 725329, \"suggestedTranslation\": \"Mấy mảnh xương.\", \"rating\": 0.0},\n  {\"id\": 725330, \"suggestedTranslation\": \"Warly nấu ăn đỉnh thật.\", \"rating\": 0.0},\n  {\"id\": 725331, \"suggestedTranslation\": \"Ngửi giống bữa tối Chủ Nhật.\", \"rating\": 0.0},\n  {\"id\": 725332, \"suggestedTranslation\": \"Ôi không! Chúng ta đã làm việc cực nhọc với tấm khăn lót đó!\", \"rating\": 0.0},\n  {\"id\": 725333, \"suggestedTranslation\": \"Chúng ta đã phụ giúp làm tấm khăn lót đó đấy!\", \"rating\": 0.0},\n  {\"id\": 725334, \"suggestedTranslation\": \"Cứ tưởng nghe thấy tiếng vo ve chứ!\", \"rating\": 0.0},\n  {\"id\": 725335, \"suggestedTranslation\": \"Cái này có hình ảnh minh họa!\", \"rating\": 0.0},\n  {\"id\": 725336, \"suggestedTranslation\": \"Chúng ta không thích cái kết của quyển đó chút nào!\", \"rating\": 0.0},\n  {\"id\": 725337, \"suggestedTranslation\": \"Trong đó có phải chữ nghĩa gì không thế?\", \"rating\": 0.0},\n  {\"id\": 725338, \"suggestedTranslation\": \"Willow cứ cố đốt nó... cứ nghĩ cô ấy sẽ thích cơ chứ!\", \"rating\": 0.0},\n  {\"id\": 725339, \"suggestedTranslation\": \"Đọc sách có thực sự giúp chúng ta câu cá giỏi hơn không?\", \"rating\": 0.0},\n  {\"id\": 725340, \"suggestedTranslation\": \"Chúng ta đọc được chữ nhưng không làm chúng phát huy tác dụng được.\", \"rating\": 0.0},\n  {\"id\": 725341, \"suggestedTranslation\": \"Tại sao phải đọc về hoa trong khi ta có thể hái chúng chứ?\", \"rating\": 0.0},\n  {\"id\": 725342, \"suggestedTranslation\": \"Đọc về rau củ còn chán hơn ăn chúng nữa!\", \"rating\": 0.0},\n  {\"id\": 725343, \"suggestedTranslation\": \"Chắc tụi mình mất cả đời để đọc xong quyển đó quá!\", \"rating\": 0.0},\n  {\"id\": 725344, \"suggestedTranslation\": \"Bà Wickerbottom, cô có thể làm đèn ngủ cho chúng cháu không?\", \"rating\": 0.0},\n  {\"id\": 725345, \"suggestedTranslation\": \"Nó tạo ra chiếc đèn ngủ sáng nhất mà chúng ta từng thấy!\", \"rating\": 0.0},\n  {\"id\": 725346, \"suggestedTranslation\": \"Chúng ta cố không nghĩ về mặt trăng quá nhiều...\", \"rating\": 0.0},\n  {\"id\": 725347, \"suggestedTranslation\": \"\\\"Một trong những cách đơn giản nhất để gọi mưa là giết một con-\\\" ơ...\", \"rating\": 0.0},\n  {\"id\": 725348, \"suggestedTranslation\": \"Nhìn ai đó cầm một cuốn sách nặng làm chúng ta thấy lo lắng sao đó...\", \"rating\": 0.0},\n  {\"id\": 725349, \"suggestedTranslation\": \"Còn gì để biết về cây cối nữa đâu chứ?\", \"rating\": 0.0},\n  {\"id\": 725350, \"suggestedTranslation\": \"Đến... giờ đi ngủ rồi...\", \"rating\": 0.0},\n  {\"id\": 725351, \"suggestedTranslation\": \"Không quá nóng, không quá lạnh, vừa vặn hoàn hảo! Câu chuyện này nghe quen quen nhỉ?\", \"rating\": 0.0},\n  {\"id\": 725352, \"suggestedTranslation\": \"Sao mấy trang sách toàn nhớp nháp thế này?\", \"rating\": 0.0},\n  {\"id\": 725353, \"suggestedTranslation\": \"Sao lại có người sợ nhện cơ chứ?\", \"rating\": 0.0},\n  {\"id\": 725354, \"suggestedTranslation\": \"Boomerangarangarang!\", \"rating\": 0.0},\n  {\"id\": 725355, \"suggestedTranslation\": \"Ai đó bỏ quên bàn chân bên trong kìa!\", \"rating\": 0.0},\n  {\"id\": 725356, \"suggestedTranslation\": \"Ôi không! Biết đâu chúng ta sửa lại được thì sao?\", \"rating\": 0.0},\n  {\"id\": 725357, \"suggestedTranslation\": \"Chúng ta có thể sửa nó bằng chút nhiệt lượng!\", \"rating\": 0.0},\n  {\"id\": 725358, \"suggestedTranslation\": \"Nó xù xì ngứa ngáy hơn là có tác dụng khác.\", \"rating\": 0.0},\n  {\"id\": 725359, \"suggestedTranslation\": \"Tôi không phải côn trùng! Chúng tôi là loài nhện!\", \"rating\": 0.0},\n  {\"id\": 725360, \"suggestedTranslation\": \"Có vài lá rong biển đang nổi lềnh bềnh trên mặt nước kìa!\", \"rating\": 0.0},\n  {\"id\": 725361, \"suggestedTranslation\": \"Chúng ta vừa cho nó cắt tóc đấy.\", \"rating\": 0.0},\n  {\"id\": 725362, \"suggestedTranslation\": \"Nó sẽ vui hơn nếu chúng ta đem đi trồng.\", \"rating\": 0.0},\n  {\"id\": 725363, \"suggestedTranslation\": \"Đó là một trong những món đồ yêu thích của tôi!\", \"rating\": 0.0},\n  {\"id\": 725364, \"suggestedTranslation\": \"Bọc kén thứ gì đó lại để dùng sau thôi!\", \"rating\": 0.0},\n  {\"id\": 725365, \"suggestedTranslation\": \"Nhảy nhót đi nào chú thỏ nhỏ.\", \"rating\": 0.0},\n  {\"id\": 725366, \"suggestedTranslation\": \"Họ bảo chúng ta không được liếm sạch nó...\", \"rating\": 0.0},\n  {\"id\": 725367, \"suggestedTranslation\": \"Cháy rụi hết rồi.\", \"rating\": 0.0},\n  {\"id\": 725368, \"suggestedTranslation\": \"Để trông giống bụi cây hơn!\", \"rating\": 0.0},\n  {\"id\": 725369, \"suggestedTranslation\": \"Bơ ngon hơn.\", \"rating\": 0.0},\n  {\"id\": 725370, \"suggestedTranslation\": \"Nhìn kìa, bay lượn tung tăng vui vẻ chưa.\", \"rating\": 0.0},\n  {\"id\": 725371, \"suggestedTranslation\": \"Giờ thì không vui nổi nữa phải không?\", \"rating\": 0.0},\n  {\"id\": 725372, \"suggestedTranslation\": \"Cậu có biết chiếc bánh nướng nhện không?\", \"rating\": 0.0},\n  {\"id\": 725373, \"suggestedTranslation\": \"Dùng xương bướm xỉa răng.\", \"rating\": 0.0},\n  {\"id\": 725374, \"suggestedTranslation\": \"Các người không tìm thấy xác thối ở đây đâu. Bọn này kẹt thế này rồi.\", \"rating\": 0.0},\n  {\"id\": 725375, \"suggestedTranslation\": \"Chúng tôi rất thích mùi đó!\", \"rating\": 0.0},\n  {\"id\": 725376, \"suggestedTranslation\": \"Chọc nó đi!\", \"rating\": 0.0},\n  {\"id\": 725377, \"suggestedTranslation\": \"Chuyện gì đang xảy ra với nó vậy?\", \"rating\": 0.0},\n  {\"id\": 725378, \"suggestedTranslation\": \"Mong là bà Wickerbottom không phát hiện ra chúng ta không ăn bắp cải...\", \"rating\": 0.0},\n  {\"id\": 725379, \"suggestedTranslation\": \"Nó mọc nhiều thứ tua tủa ra ngoài hơn cả chúng ta nữa.\", \"rating\": 0.0},\n  {\"id\": 725380, \"suggestedTranslation\": \"Bên trong chẳng còn miếng Thịt nào.\", \"rating\": 0.0},\n  {\"id\": 725381, \"suggestedTranslation\": \"Phần này hay ho đấy.\", \"rating\": 0.0},\n  {\"id\": 725382, \"suggestedTranslation\": \"Vẫn chưa thấy đủ à?\", \"rating\": 0.0},\n  {\"id\": 725383, \"suggestedTranslation\": \"Nhận lấy này, mấy thứ gai góc!\", \"rating\": 0.0},\n  {\"id\": 725384, \"suggestedTranslation\": \"Hừm, có gì đó tanh tanh ở đây!\", \"rating\": 0.0},\n  {\"id\": 725385, \"suggestedTranslation\": \"Chúng ta nên ném thứ gì đó vào Lửa trước khi nó tắt.\", \"rating\": 0.0},\n  {\"id\": 725386, \"suggestedTranslation\": \"Đúng là đánh bay cái lạnh. Và Bóng đêm.\", \"rating\": 0.0},\n  {\"id\": 725387, \"suggestedTranslation\": \"Ngọn lửa đó lớn quá!\", \"rating\": 0.0},\n  {\"id\": 725388, \"suggestedTranslation\": \"Lửa đang hơi nhỏ dần rồi.\", \"rating\": 0.0},\n  {\"id\": 725389, \"suggestedTranslation\": \"Vừa vặn và ấm áp.\", \"rating\": 0.0},\n  {\"id\": 725390, \"suggestedTranslation\": \"Rồi, xong.\", \"rating\": 0.0},\n  {\"id\": 725391, \"suggestedTranslation\": \"Đó là một con chim màu vàng.\", \"rating\": 0.0},\n  {\"id\": 725392, \"suggestedTranslation\": \"Tóm được cậu rồi!\", \"rating\": 0.0},\n  {\"id\": 725393, \"suggestedTranslation\": \"Ơ, cậu thấy trong người ổn không đấy?\", \"rating\": 0.0},\n  {\"id\": 725394, \"suggestedTranslation\": \"Kẹo đây, kẹo đây, kẹo đây!\", \"rating\": 0.0},\n  {\"id\": 725395, \"suggestedTranslation\": \"Thêm một điểm chạm nữa cũng không làm chúng ta chậm lại đâu.\", \"rating\": 0.0},\n  {\"id\": 725396, \"suggestedTranslation\": \"Anh Wolfgang bảo hãy nâng bằng đôi chân, mà chúng ta có tận nhiều chân!\", \"rating\": 0.0},\n  {\"id\": 725397, \"suggestedTranslation\": \"Yay!!\", \"rating\": 0.0},\n  {\"id\": 725398, \"suggestedTranslation\": \"Bật nó lên được không? Xin đấy?\", \"rating\": 0.0},\n  {\"id\": 725399, \"suggestedTranslation\": \"Tụi mình nóng lòng được chơi với nó rồi!\", \"rating\": 0.0},\n  {\"id\": 725400, \"suggestedTranslation\": \"Lũ quạ thích đồ lấp lánh lắm phải không?\", \"rating\": 0.0},\n  {\"id\": 725401, \"suggestedTranslation\": \"Chúng ta có thể tự lắp ráp nó!\", \"rating\": 0.0},\n  {\"id\": 725402, \"suggestedTranslation\": \"Ước gì nó to hơn chút để chúng ta cũng được cưỡi!\", \"rating\": 0.0},\n  {\"id\": 725403, \"suggestedTranslation\": \"Chúng ta có thể tự lắp ráp nó!\", \"rating\": 0.0},\n  {\"id\": 725404, \"suggestedTranslation\": \"Đó là một bức tượng gỗ nhỏ.\", \"rating\": 0.0},\n  {\"id\": 725405, \"suggestedTranslation\": \"Oooh, chúng ta nhận được một món đặc biệt!\", \"rating\": 0.0},\n  {\"id\": 725406, \"suggestedTranslation\": \"Chúng ta sẽ sưu tập tất cả luôn!\", \"rating\": 0.0},\n  {\"id\": 725407, \"suggestedTranslation\": \"Nóng lòng muốn xem có gì bên trong quá!\", \"rating\": 0.0},\n  {\"id\": 725408, \"suggestedTranslation\": \"Nóng lòng muốn xem có gì bên trong quá!\", \"rating\": 0.0},\n  {\"id\": 725409, \"suggestedTranslation\": \"Nóng lòng muốn xem có gì bên trong quá!\", \"rating\": 0.0},\n  {\"id\": 725410, \"suggestedTranslation\": \"Đèn ngủ giúp xua tan bóng tối bớt đáng sợ hơn.\", \"rating\": 0.0},\n  {\"id\": 725411, \"suggestedTranslation\": \"Chúng ta có thể tự lắp ráp nó!\", \"rating\": 0.0},\n  {\"id\": 725412, \"suggestedTranslation\": \"Cái cây này bé xíu à!\", \"rating\": 0.0},\n  {\"id\": 725413, \"suggestedTranslation\": \"Chúng ta có thể tự lắp ráp nó!\", \"rating\": 0.0},\n  {\"id\": 725414, \"suggestedTranslation\": \"Bà Wickerbottom lại định lừa chúng ta ăn rau củ nữa hả?\", \"rating\": 0.0},\n  {\"id\": 725415, \"suggestedTranslation\": \"Chúng ta nghĩ Wurt cũng sẽ ăn mấy thứ này đấy.\", \"rating\": 0.0},\n  {\"id\": 725416, \"suggestedTranslation\": \"Chúng ta có thể giúp lũ chim dựng lên.\", \"rating\": 0.0},\n  {\"id\": 725417, \"suggestedTranslation\": \"Đó là một cánh cửa chim nhỏ.\", \"rating\": 0.0},\n  {\"id\": 725418, \"suggestedTranslation\": \"Nó sẽ cho ta chơi nếu đưa thứ gì đó lấp lánh.\", \"rating\": 0.0},\n  {\"id\": 725419, \"suggestedTranslation\": \"Đừng lo mẹ chim ơi, tất cả các bé sẽ được cho ăn hết.\", \"rating\": 0.0},\n  {\"id\": 725420, \"suggestedTranslation\": \"Đừng lo nhé bóng nhỏ! Chúng tôi sẽ đưa bạn vào hố!\", \"rating\": 0.0},\n  {\"id\": 725421, \"suggestedTranslation\": \"Chỉ một cú đánh nhẹ là bóng bay đi!\", \"rating\": 0.0},\n  {\"id\": 725422, \"suggestedTranslation\": \"Chúng ta sẽ làm sân golf mini của riêng mình!\", \"rating\": 0.0},\n  {\"id\": 725423, \"suggestedTranslation\": \"Dễ quá!\", \"rating\": 0.0},\n  {\"id\": 725424, \"suggestedTranslation\": \"Chúng ta sẵn sàng thử thách!\", \"rating\": 0.0},\n  {\"id\": 725425, \"suggestedTranslation\": \"Cái này thì vừa vượn luôn!\", \"rating\": 0.0},\n  {\"id\": 725426, \"suggestedTranslation\": \"Xin phép cho qua nhé!\", \"rating\": 0.0},\n  {\"id\": 725427, \"suggestedTranslation\": \"Gió quá!\", \"rating\": 0.0},\n  {\"id\": 725428, \"suggestedTranslation\": \"Chúng ta phải ở trong hàng rào mới chơi được.\", \"rating\": 0.0},\n  {\"id\": 725429, \"suggestedTranslation\": \"Chúng ta phải canh thời gian cho thật chuẩn.\", \"rating\": 0.0},\n  {\"id\": 725430, \"suggestedTranslation\": \"Ooooh! Xoay vòng vui thật!\", \"rating\": 0.0},\n  {\"id\": 725431, \"suggestedTranslation\": \"Nó làm quả bóng nhảy lên kìa!\", \"rating\": 0.0},\n  {\"id\": 725432, \"suggestedTranslation\": \"Y hệt cái lớn, nhưng dành cho bóng golf!\", \"rating\": 0.0},\n  {\"id\": 725433, \"suggestedTranslation\": \"Chúng ta làm được mà!\", \"rating\": 0.0},\n  {\"id\": 725434, \"suggestedTranslation\": \"Đặt nó cạnh chỗ xuất phát được không?\", \"rating\": 0.0},\n  {\"id\": 725435, \"suggestedTranslation\": \"Tốn một đồng xu! Chúng ta có đồng xu nào không?\", \"rating\": 0.0},\n  {\"id\": 725436, \"suggestedTranslation\": \"Chúng ta nghĩ nó vẫn còn thiếu cờ hố gôn!\", \"rating\": 0.0},\n  {\"id\": 725437, \"suggestedTranslation\": \"Nó có sẵn đồng xu rồi! Chơi được luôn!\", \"rating\": 0.0},\n  {\"id\": 725438, \"suggestedTranslation\": \"Chúng ta bắt đầu ở đâu cũng được sao?\", \"rating\": 0.0},\n  {\"id\": 725439, \"suggestedTranslation\": \"Quay lại đây nào trứng ơi!\", \"rating\": 0.0},\n  {\"id\": 725440, \"suggestedTranslation\": \"Chúng ta có thể giúp lũ chim dựng lên.\", \"rating\": 0.0},\n  {\"id\": 725441, \"suggestedTranslation\": \"Nó sẽ cho ta chơi nếu đưa thứ gì đó lấp lánh.\", \"rating\": 0.0},\n  {\"id\": 725442, \"suggestedTranslation\": \"Chúng ta rất giỏi lùa mấy thứ đấy!\", \"rating\": 0.0},\n  {\"id\": 725443, \"suggestedTranslation\": \"Đó là một cánh cửa chim nhỏ.\", \"rating\": 0.0},\n  {\"id\": 725444, \"suggestedTranslation\": \"Chúng ta khá chắc là cái này! Hoặc có lẽ là cái kia.\", \"rating\": 0.0},\n  {\"id\": 725445, \"suggestedTranslation\": \"Chúng ta luôn tự hỏi cảm giác bỏ trốn để tham gia lễ hội sẽ ra sao.\", \"rating\": 0.0},\n  {\"id\": 725446, \"suggestedTranslation\": \"Nó sẽ cho ta chơi nếu đưa thứ gì đó lấp lánh.\", \"rating\": 0.0},\n  {\"id\": 725447, \"suggestedTranslation\": \"Là cái ở đằng kia kìa! Hay là... cái kia nhỉ...\", \"rating\": 0.0},\n  {\"id\": 725448, \"suggestedTranslation\": \"Chúng ta có thể giúp lũ chim dựng lên.\", \"rating\": 0.0},\n  {\"id\": 725449, \"suggestedTranslation\": \"Nó sẽ cho ta chơi nếu đưa thứ gì đó lấp lánh.\", \"rating\": 0.0},\n  {\"id\": 725450, \"suggestedTranslation\": \"Chúng ta có thể ngồi ngắm quả bóng nhỏ nảy tung tăng cả ngày.