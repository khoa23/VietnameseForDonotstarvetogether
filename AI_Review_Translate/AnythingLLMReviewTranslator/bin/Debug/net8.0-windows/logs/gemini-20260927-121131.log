            "text": "[\n  {\"id\":722150,\"suggestedTranslation\":\"Chắc chắn không phải gu của tôi rồi.\",\"rating\":9.0},\n  {\"id\":722151,\"suggestedTranslation\":\"Đầy tinh chất lá cây.\",\"rating\":9.0},\n  {\"id\":722152,\"suggestedTranslation\":\"Dưới này tối quá.\",\"rating\":9.0},\n  {\"id\":722153,\"suggestedTranslation\":\"Tuyệt thật đấy.\",\"rating\":9.0},\n  {\"id\":722154,\"suggestedTranslation\":\"Ta thích bông hoa đó.\",\"rating\":9.0},\n  {\"id\":722155,\"suggestedTranslation\":\"Nó nhận được đúng những gì đáng có.\",\"rating\":9.0},\n  {\"id\":722156,\"suggestedTranslation\":\"Một bữa ăn xứng tầm dân nghèo.\",\"rating\":9.0},\n  {\"id\":722157,\"suggestedTranslation\":\"Chúng quéo lại hết cả rồi.\",\"rating\":9.0},\n  {\"id\":722158,\"suggestedTranslation\":\"Sẵn sàng cho trận đấu tập rồi đây.\",\"rating\":9.0},\n  {\"id\":722159,\"suggestedTranslation\":\"Chẳng khác gì một loài cỏ dại bình thường.\",\"rating\":9.0},\n  {\"id\":722160,\"suggestedTranslation\":\"Chúng quéo lại hết cả rồi.\",\"rating\":9.0},\n  {\"id\":722161,\"suggestedTranslation\":\"Những bộ trang phục này hoàn toàn phí phạm cho lũ sinh vật hạ đẳng như thế.\",\"rating\":9.0},\n  {\"id\":722162,\"suggestedTranslation\":\"Có lẽ cứ để nó thành từng mảnh thì hơn.\",\"rating\":9.0},\n  {\"id\":722163,\"suggestedTranslation\":\"Liệu thả thứ này ra thế giới có khôn ngoan không nhỉ?\",\"rating\":9.0},\n  {\"id\":722164,\"suggestedTranslation\":\"Nó sẽ thành trò cười cho cả cộng đồng quỷ dữ mất.\",\"rating\":9.0},\n  {\"id\":722165,\"suggestedTranslation\":\"Khởi đầu của một con quái vật ma quái nào đó.\",\"rating\":9.0},\n  {\"id\":722182,\"suggestedTranslation\":\"Món này mà ăn kèm một đĩa phô mai đơn giản thì tuyệt cú mèo.\",\"rating\":9.0},\n  {\"id\":722183,\"suggestedTranslation\":\"Nó trụ không nổi lâu nữa đâu.\",\"rating\":9.0},\n  {\"id\":722184,\"suggestedTranslation\":\"Ta rất ghét phải đổ mồ hôi...\",\"rating\":9.0},\n  {\"id\":722185,\"suggestedTranslation\":\"Không có nhiệt, nó chẳng khác gì một cái rìu bình thường.\",\"rating\":9.0},\n  {\"id\":722186,\"suggestedTranslation\":\"Nếu bắt buộc phải lao động chân tay, ít nhất ta cũng muốn làm sao cho tương đối thoải mái.\",\"rating\":9.0},\n  {\"id\":722187,\"suggestedTranslation\":\"Nó trụ không nổi lâu nữa đâu.\",\"rating\":9.0},\n  {\"id\":722188,\"suggestedTranslation\":\"Ta rất ghét phải đổ mồ hôi...\",\"rating\":9.0},\n  {\"id\":722189,\"suggestedTranslation\":\"Không có nhiệt, nó chẳng khác gì một cái búa bình thường.\",\"rating\":9.0},\n  {\"id\":722190,\"suggestedTranslation\":\"Nếu bắt buộc phải lao động chân tay, ít nhất ta cũng muốn làm sao cho tương đối thoải mái.\",\"rating\":9.0},\n  {\"id\":722191,\"suggestedTranslation\":\"Nó trụ không nổi lâu nữa đâu.\",\"rating\":9.0},\n  {\"id\":722192,\"suggestedTranslation\":\"Ta rất ghét phải đổ mồ hôi...\",\"rating\":9.0},\n  {\"id\":722193,\"suggestedTranslation\":\"Không có nhiệt, nó chẳng khác gì một chiếc cuốc chim bình thường.\",\"rating\":9.0},\n  {\"id\":722194,\"suggestedTranslation\":\"Nếu bắt buộc phải lao động chân tay, ít nhất ta cũng muốn làm sao cho tương đối thoải mái.\",\"rating\":9.0},\n  {\"id\":722195,\"suggestedTranslation\":\"Nó trụ không nổi lâu nữa đâu.\",\"rating\":9.0},\n  {\"id\":722196,\"suggestedTranslation\":\"Ta rất ghét phải đổ mồ hôi...\",\"rating\":9.0},\n  {\"id\":722197,\"suggestedTranslation\":\"Không có nhiệt, nó chẳng khác gì một cái xẻng bình thường.\",\"rating\":9.0},\n  {\"id\":722198,\"suggestedTranslation\":\"Nếu bắt buộc phải lao động chân tay, ít nhất ta cũng muốn làm sao cho tương đối thoải mái.\",\"rating\":9.0},\n  {\"id\":722199,\"suggestedTranslation\":\"Nó trụ không nổi lâu nữa đâu.\",\"rating\":9.0},\n  {\"id\":722200,\"suggestedTranslation\":\"Ta rất ghét phải đổ mồ hôi...\",\"rating\":9.0},\n  {\"id\":722201,\"suggestedTranslation\":\"Không có nhiệt, nó chẳng khác gì một chiếc cuốc làm vườn bình thường.\",\"rating\":9.0},\n  {\"id\":722202,\"suggestedTranslation\":\"Nếu bắt buộc