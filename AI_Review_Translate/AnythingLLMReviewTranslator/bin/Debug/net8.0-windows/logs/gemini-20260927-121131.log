\":0.0},\n  {\"id\":724663,\"suggestedTranslation\":\"Mẹ dặn tôi là không bao giờ được làm thế.\",\"rating\":0.0},\n  {\"id\":724664,\"suggestedTranslation\":\"Chúng ta thật là tài giỏi!\",\"rating\":0.0},\n  {\"id\":724665,\"suggestedTranslation\":\"Chúng ta là siêu anh hùng đấy!\",\"rating\":0.0},\n  {\"id\":724666,\"suggestedTranslation\":\"Chúng ta không thích âm thanh đó chút nào.\",\"rating\":0.0},\n  {\"id\":724667,\"suggestedTranslation\":\"Hết giờ chơi rồi.\",\"rating\":0.0},\n  {\"id\":724668,\"suggestedTranslation\":\"Mặt đất đang sụt xuống kìa!\",\"rating\":0.0},\n  {\"id\":724669,\"suggestedTranslation\":\"Nghe cứ ùng ục ấy!\",\"rating\":0.0},\n  {\"id\":724670,\"suggestedTranslation\":\"Gì thế nhỉ?\",\"rating\":0.0},\n  {\"id\":724671,\"suggestedTranslation\":\"Cho bạn này!\",\"rating\":0.0},\n  {\"id\":724672,\"suggestedTranslation\":\"Biết đâu bây giờ nó sẽ vui hơn.\",\"rating\":0.0},\n  {\"id\":724673,\"suggestedTranslation\":\"Mong là bạn sẽ thích món quà của tụi mình!\",\"rating\":0.0},\n  {\"id\":724674,\"suggestedTranslation\":\"Haha, nhột đại não chúng ta quá!\",\"rating\":0.0},\n  {\"id\":724675,\"suggestedTranslation\":\"Tiếc quá, chẳng có chuyện gì xảy ra cả!\",\"rating\":0.0},\n  {\"id\":724676,\"suggestedTranslation\":\"Cái đó chúng ta học rồi.\",\"rating\":0.0},\n  {\"id\":724677,\"suggestedTranslation\":\"Cái cổng đó vừa làm gì lạ lắm.\",\"rating\":0.0},\n  {\"id\":724678,\"suggestedTranslation\":\"Có chuyện gì đang xảy ra kìa.\",\"rating\":0.0},\n  {\"id\":724679,\"suggestedTranslation\":\"Chuồn khỏi đây thôi.\",\"rating\":0.0},\n  {\"id\":724680,\"suggestedTranslation\":\"Chúng ta thấy khỏe lắm rồi!\",\"rating\":0.0},\n  {\"id\":724681,\"suggestedTranslation\":\"Sức mạnh sấm sét càng lớn thì trách nhiệm càng cao!\",\"rating\":0.0},\n  {\"id\":724682,\"suggestedTranslation\":\"Tránh xa ra, nước đáng ghét!\",\"rating\":0.0},\n  {\"id\":724683,\"suggestedTranslation\":\"Bây giờ chúng ta thấy an toàn hơn hẳn rồi!\",\"rating\":0.0},\n  {\"i