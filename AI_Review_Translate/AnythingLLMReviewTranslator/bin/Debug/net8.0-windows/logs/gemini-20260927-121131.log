nslation\": \"Ghê tởm kinh khủng.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725724,\n    \"suggestedTranslation\": \"Haha, lạ thật đấy.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725725,\n    \"suggestedTranslation\": \"Đừng làm tổn thương chúng tôi và chúng tôi sẽ không làm hại bạn!\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725726,\n    \"suggestedTranslation\": \"Nó từng là cỏ.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725727,\n    \"suggestedTranslation\": \"Dù sao thì nó cũng che được mấy con mắt to nhất của chúng ta.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725728,\n    \"suggestedTranslation\": \"Nó giữ cho bộ lông của tụi mình không bị ướt sũng.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725729,\n    \"suggestedTranslation\": \"Đừng hòng tóm được tụi này, nước nhé!\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725730,\n    \"suggestedTranslation\": \"Hãy rìu tôi một câu hỏi đi!\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725731,\n    \"suggestedTranslation\": \"Tôi không thể dùng món đó được.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725732,\n    \"suggestedTranslation\": \"Một đống đất. Đố ai biết nó đang giấu thứ gì đấy.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725733,\n    \"suggestedTranslation\": \"Không có gì ở gần đây cả.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725734,\n    \"suggestedTranslation\": \"Dẫn đường đi rồi tôi sẽ theo sau.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725735,\n    \"suggestedTranslation\": \"Chúng ta đến gần lắm rồi!\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725736,\n    \"suggestedTranslation\": \"Đi đúng hướng rồi đấy.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725737,\n    \"suggestedTranslation\": \"Có cái gì đó ở gần đây này.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725738,\n    \"suggestedTranslation\": \"Đúng là một điều bí ẩn.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725739,\n    \"suggestedTranslation\": \"Có vẻ như có một hố để cắm chìa khóa ngoại cỡ.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725740,\n    \"suggestedTranslation\": \"Nó đã sẵn sàng hoạt động rồi.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725741,\n    \"suggestedTranslation\": \"Cái gậy chất lừ!\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725742,\n    \"suggestedTranslation\": \"Chúng tôi quyết định từ giờ sẽ làm một con nhện bến tàu đây.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725743,\n    \"suggestedTranslation\": \"Suýt thì chúng ta quên mất mấy cái cọc!\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725744,\n    \"suggestedTranslation\": \"Nhiều bèo nhèo quá...\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725745,\n    \"suggestedTranslation\": \"Chúng ta có thể giúp một tay xây nó!\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725746,\n    \"suggestedTranslation\": \"Nó có đủ mọi thứ mà một chiếc thuyền ván cần!\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725747,\n    \"suggestedTranslation\": \"Tôi không chắc mình muốn chui vào *thêm* một cái bụng nào nữa đâu.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725748,\n    \"suggestedTranslation\": \"Được rồi, tụi mình sẽ ăn salad.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725749,\n    \"suggestedTranslation\": \"Ôi, đừng có lằng nhằng kéo dài nữa chứ.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725750,\n    \"suggestedTranslation\": \"Trông nó y như rương đồ chơi cũ của tôi vậy!\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725751,\n    \"suggestedTranslation\": \"Nó to hơn và xịn hơn hẳn rương đồ chơi cũ của tôi!\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725752,\n    \"suggestedTranslation\": \"Đúng là một cái lò luyện xịn sò!\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725753,\n    \"suggestedTranslation\": \"Mặt mũi cậu bị sao thế kia?\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725754,\n    \"suggestedTranslation\": \"Lò luyện nóng rẫy luôn!\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725755,\n    \"suggestedTranslation\": \"Lò luyện hơi ấm.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725756,\n    \"suggestedTranslation\": \"Trông có vẻ đáng ngờ.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725757,\n    \"suggestedTranslation\": \"Bây giờ trông nó có vẻ ngon hơn rồi.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725758,\n    \"suggestedTranslation\": \"Vừa to khủng khiếp lại vừa ngon tuyệt.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725759,\n    \"suggestedTranslation\": \"Chúng ta có thể trồng thứ gì đó bằng mấy hạt này.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725760,\n    \"suggestedTranslation\": \"Cái phần đầu trông hơi đáng sợ một chút.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725761,\n    \"suggestedTranslation\": \"Ồ! Vừa ngọt lại vừa ngon!!\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725762,\n    \"suggestedTranslation\": \"Tụi mình rất thích cái đuôi!\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725763,\n    \"suggestedTranslation\": \"Vẩy rồng mà nhẹ ghê.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725764,\n    \"suggestedTranslation\": \"Tụi mình không chắc có thích hòn đá đó không nữa.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 725765,\n    \"suggestedTranslation\": \"Một chiếc mũ nhọn xứng đôi với bộ răng nhọn của tụi mình!\",\n    \"rating\": 1.0\n  }\n]",
