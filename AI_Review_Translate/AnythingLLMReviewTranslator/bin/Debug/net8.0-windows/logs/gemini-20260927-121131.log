"suggestedTranslation\":\"Con sinh vật nhỏ bé đó đang định giở trò gì thế nhỉ?\",\"rating\":8.0},\n  {\"id\":722688,\"suggestedTranslation\":\"Một vương quốc không có vua.\",\"rating\":8.0},\n  {\"id\":722689,\"suggestedTranslation\":\"Chúng đang treo cờ hoàng gia kìa.\",\"rating\":8.0},\n  {\"id\":722690,\"suggestedTranslation\":\"Ồ hình như tôi không được mời. Biết sống sao bây giờ đây.\",\"rating\":8.0},\n  {\"id\":722691,\"suggestedTranslation\":\"Ồ hình như tôi không được mời. Biết sống sao bây giờ đây.\",\"rating\":8.0},\n  {\"id\":722692,\"suggestedTranslation\":\"Chúng thậm chí còn trở nên xấu xí hơn mới tài chứ.\",\"rating\":8.0},\n  {\"id\":722693,\"suggestedTranslation\":\"Ở đây việc phong vương dễ thật đấy.\",\"rating\":8.0},\n  {\"id\":722694,\"suggestedTranslation\":\"Cải thiện đáng kể đấy chứ.\",\"rating\":8.0},\n  {\"id\":722695,\"suggestedTranslation\":\"Sao phải chuyên môn hóa khi bạn có thể tàng tàng ở mọi lĩnh vực cơ chứ?\",\"rating\":8.0},\n  {\"id\":722696,\"suggestedTranslation\":\"Tôi chắc chắn bên trong chẳng có thứ gì mình muốn đâu.\",\"rating\":8.0},\n  {\"id\":722697,\"suggestedTranslation\":\"Tôi chắc chắn bên trong chẳng có thứ gì mình muốn đâu.\",\"rating\":8.0},\n  {\"id\":722698,\"suggestedTranslation\":\"Sao phải chuyên môn hóa khi bạn có thể tàng tàng ở mọi lĩnh vực cơ chứ?\",\"rating\":8.0},\n  {\"id\":722699,\"suggestedTranslation\":\"Ai đó đã cẩn thận nén cảm xúc vào chai rồi vứt ra biển lớn.\",\"rating\":8.0},\n  {\"id\":722700,\"suggestedTranslation\":\"Trống rỗng ở bên trong.\",\"rating\":8.0},\n  {\"id\":722701,\"suggestedTranslation\":\"Buổi biểu diễn kết thúc rồi.\",\"rating\":8.0},\n  {\"id\":722702,\"suggestedTranslation\":\"Hừm. Tôi đoán vài kẻ vẫn thích chuộng khoe khoang sức mạnh cơ bắp.\",\"rating\":8.0},\n  {\"id\":722703,\"suggestedTranslation\":\"Phát kinh. Chắc là vẫn còn chút năng lượng tà ác bên trong.\",\"rating\":8.0},\n  {\"id\":722704,\"suggestedTranslation\":\"Rồi con đom đóm cũng sẽ chết đói thôi.\",\"rating\":8.0},\n  {\"id\":722705,\"suggestedTranslation\":\"Đẹp một cách kỳ lạ.\",\"rating\":8.0},\n  {\"id\":722706,\"suggestedTranslation\":\"Cái thiết bị thảm hại này... lại dùng được việc phết.\",\"rating\":8.0},\n  {\"id\":722707,\"suggestedTranslation\":\"Dành cho những ai có máu pháo sáng kịch tính.\",\"rating\":8.5},\n  {\"id\":722708,\"suggestedTranslation\":\"Nó được vẽ bằng một bàn tay vững vàng.\",\"rating\":8.0},\n  {\"id\":722709,\"suggestedTranslation\":\"Hiện tại chẳng có gì trên đó cả.\",\"rating\":8.0},\n  {\"id\":722710,\"suggestedTranslation\":\"Bảng hiệu sẽ vô dụng nếu chẳng có gì để đánh dấu.\",\"rating\":8.5},\n  {\"id\":722711,\"suggestedTranslation\":\"Chà chà, nhiên liệu đã thay đổi ngươi rồi đấy.\",\"rating\":8.0},\n  {\"id\":722712,\"suggestedTranslation\":\"Cảm giác như hắn vẫn còn sống vậy.\",\"rating\":8.0},\n  {\"id\":722713,\"suggestedTranslation\":\"Một kết cục đáng tiếc, người bạn cũ của tôi.\",\"rating\":8.0},\n  {\"id\":722714,\"suggestedTranslation\":\"Nó đã nguội lạnh rồi.\",\"rating\":8.0},\n  {\"id\":722715,\"suggestedTranslation\":\"Chạm vào bỏng tay.\",\"rating\":8.0},\n  {\"id\":722716,\"suggestedTranslation\":\"Trông có vẻ sẽ tàn phá hệ tiêu hóa của tôi đây.\",\"rating\":8.0},\n  {\"id\":722717,\"suggestedTranslation\":\"Tôi sẽ coi đó là một lời \\\"đồng ý\\\".\",\"rating\":8.0},\n  {\"id\":722718,\"suggestedTranslation\":\"Hết đường chạy rồi nhé.\",\"rating\":8.0},\n  {\"id\":722719,\"suggestedTranslation\":\"Cậu có hiểu ý tôi không? Cậu đào sâu được chứ?\",\"rating\":8.0},\n  {\"id\":722720,\"suggestedTranslation\":\"Khiếm nhã thật.\",\"rating\":8.0},\n  {\"id\":722721,\"suggestedTranslation\":\"Tôi có thực sự muốn nhặt thứ gì tìm thấy ở đó không, khi biết rằng nó từng nằm trong mũi loài gặm nhấm?\",\"rating\":8.0},\n  {\"id\":722722,\"suggestedTranslation\":\"Bảo sao chúng có thể đào bới hàng giờ liền.\",\"rating\":8.0},\n  {\"id\":722723,\"suggestedTranslation\":\"Đào sâu vào đi, tao đến bắt mày đây.\",\"rating\":8.5},\n  {\"id\":722724,\"suggestedTranslation\":\"Tôi không có thời gian rảnh với cậu đâu!\",\"rating\":8.0},\n  {\"id\":722725,\"suggestedTranslation\":\"Thật là một cái ổ tởm lợm.\",\"rating\":8.0},\n  {\"id\":722726,\"suggestedTranslation\":\"Chúng vừa bị xông khói ra ngoài kìa.\",\"rating\":8.0},\n  {\"id\":722727,\"suggestedTranslation\":\"Nơi này nhung nhúc mấy tên khỉ vô lại.\",\"rating\":8.0},\n  {\"id\":722728,\"suggestedTranslation\":\"Có cái gì đó không ổn với nó rồi.\",\"rating\":8.0},\n  {\"id\":722729,\"suggestedTranslation\":\"Có kẻ đã táy máy táy máy rồi đây.\",\"rating\":8.0},\n  {\"id\":722730,\"suggestedTranslation\":\"Quả là cổ kính.\",\"rating\":8.0},\n  {\"id\":722731,\"suggestedTranslation\":\"Hừm, tôi khó mà gọi đó là ngai vàng được.\",\"rating\":8.0},\n  {\"id\":722732,\"suggestedTranslation\":\"Tôi không tin tưởng nó đâu.\",\"rating\":8.0},\n  {\"id\":722733,\"suggestedTranslation\":\"Chắc là đầy bọ chét cho xem.\",\"rating\":8.0},\n  {\"id\":722734,\"suggestedTranslation\":\"Ọe, trông tôi cứ như thủy thủ tạt ngang hông ấy.\",\"rating\":8.0},\n  {\"id\":722735,\"suggestedTranslation\":\"Nuốt cái thứ này vào thì không khôn ngoan tẹo nào đâu.\",\"rating\":8.0},\n  {\"id\":722736,\"suggestedTranslation\":\"Gớm ghiếc làm sao.\",\"rating\":8.0},\n  {\"id\":722737,\"suggestedTranslation\":\"Răng tôi già quá rồi để nhai món này.\",\"rating\":8.0},\n  {\"id\":722738,\"suggestedTranslation\":\"Trông chẳng hấp dẫn gì cho cam.\",\"rating\":8.0},\n  {\"id\":722739,\"suggestedTranslation\":\"Tàn tích của một thánh tích cổ đại.\",\"rating\":8.5},\n  {\"id\":722740,\"suggestedTranslation\":\"Tôi cứ tưởng tất cả những thứ này đã bị phá hủy từ muôn kiếp trước rồi cơ.\",\"rating\":8.0},\n  {\"id\":722741,\"suggestedTranslation\":\"Cây quyền sượng được vận hành bởi năng lượng \\\"mặt trăng\\\".\",\"rating\":8.0},\n  {\"id\":722742,\"suggestedTranslation\":\"Tôi nghĩ cần phải có phép thuật gì đó xảy ra thì phải.\",\"rating\":8.0},\n  {\"id\":722743,\"suggestedTranslation\":\"Phí phạm một cây quyền trượng ngon lành.\",\"rating\":8.0},\n  {\"id\":722744,\"suggestedTranslation\":\"Thật thảm hại mà uyển chuyển làm sao.\",\"rating\":8.0},\n  {\"id\":722745,\"suggestedTranslation\":\"Mày không thoát khỏi bàn tay phản diện của tao đâu!\",\"rating\":8.0},\n  {\"id\":722746,\"suggestedTranslation\":\"Tôi phải làm gì với mấy cái này đây?\",\"rating\":8.0},\n  {\"id\":722747,\"suggestedTranslation\":\"Đó là một cây mặt trăng nhỏ bé.\",\"rating\":8.0},\n  {\"id\":722748,\"suggestedTranslation\":\"Hang động cung cấp nơi trú ẩn tránh xa ánh mắt soi mói của \\\"mặt trăng\\\".\",\"rating\":8.0},\n  {\"id\":722749,\"suggestedTranslation\":\"Viên ngọc triệu hồi các mạch nước phun kết hợp với các chu kỳ của \\\"mặt trăng\\\".\",\"rating\":8.0},\n  {\"id\":722750,\"suggestedTranslation\":\"Tôi có thể cảm thấy ánh mắt của nó đang dán vào mình... theo dõi...\",\"rating\":8.0},\n  {\"id\":722751,\"suggestedTranslation\":\"\\\"Mặt trăng\\\" đang treo lơ lửng đầy tròn trên bầu trời.\",\"rating\":8.0},\n  {\"id\":722752,\"suggestedTranslation\":\"\\\"Mặt trăng\\\"... đã tạm thời rút lui rồi.\",\"rating\":8.0},\n  {\"id\":722753,\"suggestedTranslation\":\"\\\"Mặt trăng\\\" đang trong giai đoạn khuyết.\",\"rating\":8.0},\n  {\"id\":722754,\"suggestedTranslation\":\"\\\"Mặt trăng\\\" đang trong giai đoạn tròn.\",\"rating\":8.0},\n  {\"id\":722755,\"suggestedTranslation\":\"Nhưng liệu nó có sắc bén bằng tôi không?\",\"rating\":8.0},\n  {\"id\":722756,\"suggestedTranslation\":\"Đi nào. Rìu tôi xem mặt trăng làm bằng gì đi.\",\"rating\":8.5},\n  {\"id\":722757,\"suggestedTranslation\":\"Gần như sắc bén như tôi, nhưng lại lóe lên thứ ánh sáng lòe loẹt.\",\"rating\":8.0},\n  {\"id\":722758,\"suggestedTranslation\":\"Mảnh vụn \\\"mặt trăng\\\".\",\"rating\":8.0},\n  {\"id\":722759,\"suggestedTranslation\":\"Tôi cho là sự sống luôn tìm ra lối đi riêng.\",\"rating\":8.0},\n  {\"id\":722760,\"suggestedTranslation\":\"Cái này sẽ tạo ra một chiếc bình ma thuật tàm tạm đấy.\",\"rating\":8.0},\n  {\"id\":722761,\"suggestedTranslation\":\"Chúng lúc nào cũng đòi cống phẩm cả.\",\"rating\":8.0},\n  {\"id\":722762,\"suggestedTranslation\":\"Đá tảng mặt trăng.\",\"rating\":8.5},\n  {\"id\":722763,\"suggestedTranslation\":\"Ồ ồ, chút kiến thức mới đây.\",\"rating\":8.0},\n  {\"id\":722764,\"suggestedTranslation\":\"Cái này có vẻ không ổn rồi.\",\"rating\":8.0},\n  {\"id\":722765,\"suggestedTranslation\":\"Tôi thà không thò lò vào trong xem đâu.\",\"rating\":8.0}\n]",
