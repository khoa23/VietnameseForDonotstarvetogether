            "text": "[\n  {\"id\":725766,\"suggestedTranslation\":\"Thêm đá tảng đáng sợ nữa...\",\"rating\":9.0},\n  {\"id\":725767,\"suggestedTranslation\":\"Dễ như ăn kẹo.\",\"rating\":9.0},\n  {\"id\":725768,\"suggestedTranslation\":\"Nó đang bị cháy rụi kìa!\",\"rating\":9.0},\n  {\"id\":725769,\"suggestedTranslation\":\"Cháy rụi hết rồi.\",\"rating\":9.0},\n  {\"id\":725770,\"suggestedTranslation\":\"Chặt đứt hết rồi.\",\"rating\":9.0},\n  {\"id\":725771,\"suggestedTranslation\":\"Trèo lên mấy cái này rất vui.\",\"rating\":9.0},\n  {\"id\":725772,\"suggestedTranslation\":\"Tôi chỉ muốn đánh trống thôi.\",\"rating\":9.0},\n  {\"id\":725773,\"suggestedTranslation\":\"Chúng tôi thích đồ ăn bốc tay.\",\"rating\":9.0},\n  {\"id\":725774,\"suggestedTranslation\":\"Chúng tôi không biết chuối có thể mọc ngoài tự nhiên đấy!\",\"rating\":9.0},\n  {\"id\":725775,\"suggestedTranslation\":\"Xuống đất với cậu này!\",\"rating\":9.0},\n  {\"id\":725776,\"suggestedTranslation\":\"Xuống đất với cậu này!\",\"rating\":9.0},\n  {\"id\":725777,\"suggestedTranslation\":\"Xuống đất với cậu này!\",\"rating\":9.0},\n  {\"id\":725778,\"suggestedTranslation\":\"Xuống đất với cậu này!\",\"rating\":9.0},\n  {\"id\":725779,\"suggestedTranslation\":\"Xù lông!\",\"rating\":9.0},\n  {\"id\":725780,\"suggestedTranslation\":\"Xuống đất với cậu này!\",\"rating\":9.0},\n  {\"id\":725781,\"suggestedTranslation\":\"Giờ thì không ai phải tự làm mình bị thương vì nó nữa rồi.\",\"rating\":9.0},\n  {\"id\":725782,\"suggestedTranslation\":\"Trông có vẻ dễ lắm khi anh Wolfgang làm...\",\"rating\":9.0},\n  {\"id\":725783,\"suggestedTranslation\":\"Ồ! Lạnh quá!\",\"rating\":9.0},\n  {\"id\":725784,\"suggestedTranslation\":\"Trông có vẻ dễ lắm khi anh Wolfgang làm...\",\"rating\":9.0},\n  {\"id\":725785,\"suggestedTranslation\":\"Trông có vẻ dễ lắm khi anh Wolfgang làm...\",\"rating\":9.0},\n  {\"id\":725786,\"suggestedTranslation\":\"Anh Wolfgang bảo cái này dùng để khởi động cơ thể.\",\"rating\":9.0},\n  {\"id\":725787,\"suggestedTranslation\":\"Trông có vẻ dễ lắm khi anh Wolfgang làm...\",\"rating\":9.0},\n  {\"id\":725788,\"suggestedTranslation\":\"Ái! Nóng quá!\",\"rating\":9.0},\n  {\"id\":725789,\"suggestedTranslation\":\"Nồng nặc quá.\",\"rating\":9.0},\n  {\"id\":725790,\"suggestedTranslation\":\"Không thưa ngài, chúng tôi không thích nó.\",\"rating\":9.0},\n  {\"id\":725791,\"suggestedTranslation\":\"Ew... nó còn bốc mùi nồng hơn nữa.\",\"rating\":9.0},\n  {\"id\":725792,\"suggestedTranslation\":\"Chúng ta có thể trồng thứ gì đó bằng mấy cái này.\",\"rating\":9.0},\n  {\"id\":725793,\"suggestedTranslation\":\"Nó không ngon như vẻ bề ngoài đâu.\",\"rating\":9.0},\n  {\"id\":725794,\"suggestedTranslation\":\"Biết đâu nó sẽ giúp chúng ta dọn dẹp đồ đạc nếu chúng ta xin lịch sự.\",\"rating\":9.0},\n  {\"id\":725795,\"suggestedTranslation\":\"Chúng tôi chưa bao giờ giữ phòng sạch sẽ thế này.\",\"rating\":9.0},\n  {\"id\":725796,\"suggestedTranslation\":\"Buộc mấy con thỏ vào đầu, ý hay đấy.\",\"rating\":9.0},\n  {\"id\":725797,\"suggestedTranslation\":\"Rắn nước tươi.\",\"rating\":9.0},\n  {\"id\":725798,\"suggestedTranslation\":\"Chúng ta có thể húp trọn cái này.\",\"rating\":9.0},\n  {\"id\":725799,\"suggestedTranslation\":\"Eo ôi, cà tím.\",\"rating\":9.0},\n  {\"id\":725800,\"suggestedTranslation\":\"Mẹ biết tôi thích món om mà.\",\"rating\":9.0},\n  {\"id\":725801,\"suggestedTranslation\":\"Hoặc là cực kỳ nhiều cà, hoặc là cực kỳ nhiều cây.\",\"rating\":9.0},\n  {\"id\":725802,\"suggestedTranslation\":\"Chúng ta có thể trồng thứ gì đó bằng mấy cái này.\",\"rating\":9.0},\n  {\"id\":725803,\"suggestedTranslation\":\"Liệu Abigail có phiền nếu chúng ta thử một ngụm không?\",\"rating\":9.0},\n  {\"id\":725804,\"suggestedTranslation\":\"Chúng tôi thích cảm giác ấm áp và dễ chịu này!\",\"rating\":9.0},\n  {\"id\":725805,\"suggestedTranslation\":\"Đồ cổ cũng ngớ ngẩn thật đấy.\",\"rating\":9.0},\n  {\"id\":725806,\"suggestedTranslation\":\"Làm tôi nhớ đến lúc đi mua đồ cổ với mẹ.\",\"rating\":9.0},\n  {\"id\":725807,\"suggestedTranslation\":\"Đẹp và sáng sủa!\",\"rating\":9.0},\n  {\"id\":725808,\"suggestedTranslation\":\"Trông tuyệt quá!\",\"rating\":9.0},\n  {\"id\":725809,\"suggestedTranslation\":\"Nó sắp tắt đến nơi rồi.\",\"rating\":9.0},\n  {\"id\":725810,\"suggestedTranslation\":\"Trông chúng thật buồn bã.\",\"rating\":9.0},\n  {\"id\":725811,\"suggestedTranslation\":\"Thật là lãng phí củi đốt một cách vô nghĩa.\",\"rating\":9.0},\n  {\"id\":725812,\"suggestedTranslation\":\"Chỉ có chúng ta mới có thể ngăn chặn cháy rừng.\",\"rating\":9.0},\n  {\"id\":725813,\"suggestedTranslation\":\"Liệu một chiếc băng gạc mát lạnh có giúp khá hơn không, ngài Cây ơi?\",\"rating\":9.0},\n  {\"id\":725814,\"suggestedTranslation\":\"Cây thông phía bên kia hàng rào lúc nào cũng xanh hơn.\",\"rating\":9.0},\n  {\"id\":725815,\"suggestedTranslation\":\"Thật là lãng phí củi đốt một cách vô nghĩa.\",\"rating\":9.0},\n  {\"id\":725816,\"suggestedTranslation\":\"Chỉ có chúng ta mới có thể ngăn chặn cháy rừng.\",\"rating\":9.0},\n  {\"id\":725817,\"suggestedTranslation\":\"Liệu một chiếc băng gạc mát lạnh có giúp khá hơn không, ngài Cây ơi?\",\"rating\":9.0},\n  {\"id\":725818,\"suggestedTranslation\":\"Một loài đang dần tuyệt chủng.\",\"rating\":9.0},\n  {\"id\":725819,\"suggestedTranslation\":\"Hơi đáng sợ, nhưng nó sẽ giúp chúng ta khô ráo.\",\"rating\":9.0},\n  {\"id\":725820,\"suggestedTranslation\":\"Chúng ta thậm chí còn có NHIỀU mắt và răng hơn!\",\"rating\":9.0},\n  {\"id\":725821,\"suggestedTranslation\":\"Chúng tôi không thích ánh nhìn đó chút nào...\",\"rating\":9.0},\n  {\"id\":725822,\"suggestedTranslation\":\"Chúng tôi thường không quá bận tâm về vài con mắt thừa thãi.\",\"rating\":9.0},\n  {\"id\":725823,\"suggestedTranslation\":\"Một con mắt bé bỏng sắp sửa ra đời.\",\"rating\":9.0},\n  {\"id\":725824,\"suggestedTranslation\":\"Luôn luôn cảnh giác.\",\"rating\":9.0},\n  {\"id\":725825,\"suggestedTranslation\":\"Đừng nhìn tôi nữa!\",\"rating\":9.0},\n  {\"id\":725826,\"suggestedTranslation\":\"Dậy đi nào!\",\"rating\":9.0},\n  {\"id\":725827,\"suggestedTranslation\":\"Một nông trại bị san bằng thì chẳng còn là nông trại nữa.\",\"rating\":9.0},\n  {\"id\":725828,\"suggestedTranslation\":\"Tôi sẽ thử làm cái trò làm nông này xem sao.\",\"rating\":9.0},\n  {\"id\":725829,\"suggestedTranslation\":\"Mau lên nào, mấy cây ơi!\",\"rating\":9.0},\n  {\"id\":725830,\"suggestedTranslation\":\"Đất đã khô cằn rồi.\",\"rating\":9.0},\n  {\"id\":725831,\"suggestedTranslation\":\"Chúng ta cần thứ đó để trồng thực vật và hạt.\",\"rating\":9.0},\n  {\"id\":725832,\"suggestedTranslation\":\"Chắc là nó không tốt cho cây đâu.\",\"rating\":9.0},\n  {\"id\":725833,\"suggestedTranslation\":\"Yay, nó đã sẵn sàng để thu hoạch rồi!\",\"rating\":9.0},\n  {\"id\":725834,\"suggestedTranslation\":\"Chà, nhìn nó lớn chưa kìa!\",\"rating\":9.0},\n  {\"id\":725835,\"suggestedTranslation\":\"Này, mày có phải là hoa quả hay rau củ đâu!\",\"rating\":9.0},\n  {\"id\":725836,\"suggestedTranslation\":\"Đó là một loại thực vật!\",\"rating\":9.0},\n  {\"id\":725837,\"suggestedTranslation\":\"Chẳng mấy chốc mà nó sẽ lớn tướng thôi!\",\"rating\":9.0},\n  {\"id\":725838,\"suggestedTranslation\":\"Ồ không... đáng ra chúng ta nên hái nó sớm hơn.\",\"rating\":9.0},\n  {\"id\":725839,\"suggestedTranslation\":\"Eo ôi, xin miễn nhé.\",\"rating\":9.0},\n  {\"id\":725840,\"suggestedTranslation\":\"Lớn lên nào hạt giống ơi, lớn nhanh nào!\",\"rating\":9.0},\n  {\"id\":725841,\"suggestedTranslation\":\"Yay! Chúng ta đang làm một khu vườn!\",\"rating\":9.0},\n  {\"id\":725842,\"suggestedTranslation\":\"Chúng ta sẽ tìm một chỗ thật đẹp cho khu vườn.\",\"rating\":9.0},\n  {\"id\":725843,\"suggestedTranslation\":\"Chúng ta nên dọn dẹp đống đó đi.\",\"rating\":9.0},\n  {\"id\":725844,\"suggestedTranslation\":\"Cái này to thật đấy!\",\"rating\":9.0},\n  {\"id\":725845,\"suggestedTranslation\":\"Trông giống như phải tus cả một đàn chim mới làm được chiếc mũ đó!\",\"rating\":9.0},\n  {\"id\":725846,\"suggestedTranslation\":\"Haha! Nhột quá!\",\"rating\":9.0},\n  {\"id\":725847,\"suggestedTranslation\":\"Chiếc lông màu vàng.\",\"rating\":9.0},\n  {\"id\":725848,\"suggestedTranslation\":\"Chiếc lông màu đen.\",\"rating\":9.0},\n  {\"id\":725849,\"suggestedTranslation\":\"Chiếc lông màu đỏ.\",\"rating\":9.0},\n  {\"id\":725850,\"suggestedTranslation\":\"Chiếc lông màu trắng.\",\"rating\":9.0},\n  {\"id\":725851,\"suggestedTranslation\":\"Cô ấy bị khóa chặt rồi!\",\"rating\":9.0},\n  {\"id\":725852,\"suggestedTranslation\":\"Tôi không nghĩ chúng ta có thể nhảy qua đó đâu.\",\"rating\":9.0},\n  {\"id\":725853,\"suggestedTranslation\":\"Nó có làm gì đâu!\",\"rating\":9.0},\n  {\"id\":725854,\"suggestedTranslation\":\"Chúng ta không sợ bị điện giật đâu.\",\"rating\":9.0},\n  {\"id\":725855,\"suggestedTranslation\":\"Nên đặt nó ở đâu đây nhỉ?\",\"rating\":9.0},\n  {\"id\":725856,\"suggestedTranslation\":\"Bản lề hơi kêu cót két một chút.\",\"rating\":9.0},\n  {\"id\":725857,\"suggestedTranslation\":\"Xây một cái cổng nào!\",\"rating\":9.0},\n  {\"id\":725858,\"suggestedTranslation\":\"Xây một cái hàng rào nào!\",\"rating\":9.0},\n  {\"id\":725859,\"suggestedTranslation\":\"Đó không phải là chiếc hàng rào đẹp mắt gì cho cam.\",\"rating\":9.0},\n  {\"id\":725860,\"suggestedTranslation\":\"Chúng ta được phép dùng nó để đập cột hàng rào, miễn là đừng đập quá mạnh.\",\"rating\":9.0},\n  {\"id\":725861,\"suggestedTranslation\":\"Tôi từng thấy mẹ dùng thứ này trong vườn của mình.\",\"rating\":9.0},\n  {\"id\":725862,\"suggestedTranslation\":\"Măm măm, ngon quá!\",\"rating\":9.0},\n  {\"id\":725863,\"suggestedTranslation\":\"Cái này sẽ vui lắm đây!\",\"rating\":9.0},\n  {\"id\":725864,\"suggestedTranslation\":\"Quả này hơi lạ một chút, nhưng mà ngon!\",\"rating\":9.0},\n  {\"id\":725865,\"suggestedTranslation\":\"Chúng ta chưa từng ăn mì Ý vị ngọt bao giờ!\",\"rating\":9.0},\n  {\"id\":725866,\"suggestedTranslation\":\"Ăn xong chúng ta thích dùng que để chơi đấu kiếm lắm.\",\"rating\":9.0},\n  {\"id\":725867,\"suggestedTranslation\":\"Bây giờ nó là hoa quả nóng hổi.\",\"rating\":9.0},\n  {\"id\":725868,\"suggestedTranslation\":\"Nó dùng phép thuật để làm người ta bị thương.\",\"rating\":9.0},\n  {\"id\":725869,\"suggestedTranslation\":\"Đừng lo cô Wicker, bọn cháu sẽ cẩn thận mà.\",\"rating\":9.0},\n  {\"id\":725870,\"suggestedTranslation\":\"Mấy chú bọ nhỏ khó bắt thật đấy.\",\"rating\":9.0},\n  {\"id\":725871,\"suggestedTranslation\":\"Đi phiêu lưu thôi, trong túi chúng ta có mấy con đom đóm này!\",\"rating\":9.0},\n  {\"id\":725872,\"suggestedTranslation\":\"Dưới chân nó có lửa kìa. Và cả trong người nó nữa.\",\"rating\":9.0},\n  {\"id\":725873,\"suggestedTranslation\":\"Một loại cỏ dại độc gây bỏng rát.\",\"rating\":9.0},\n  {\"id\":725874,\"suggestedTranslation\":\"Chúng ta có hái mấy cái này không nhỉ?\",\"rating\":9.0},\n  {\"id\":725875,\"suggestedTranslation\":\"Một cái bút thì có thể nguy hiểm đến mức nào chứ?\",\"rating\":9.0},\n  {\"id\":725876,\"suggestedTranslation\":\"Ta nên bỏ thêm thứ gì đó vào đống lửa trước khi nó tắt.\",\"rating\":9.0},\n  {\"id\":725877,\"suggestedTranslation\":\"Đúng là tuyệt hơn cái lạnh và bóng đêm nhiều.\",\"rating\":9.0},\n  {\"id\":725878,\"suggestedTranslation\":\"Ngọn lửa lớn thật đấy!\",\"rating\":9.0},\n  {\"id\":725879,\"suggestedTranslation\":\"Đống lửa hơi nhỏ đi rồi thì phải.\",\"rating\":9.0},\n  {\"id\":725880,\"suggestedTranslation\":\"Thật ấm áp và dễ chịu.\",\"rating\":9.0},\n  {\"id\":725881,\"suggestedTranslation\":\"Chà, thế là xong. Nhưng không phải là mãi mãi!\",\"rating\":9.0},\n  {\"id\":725882,\"suggestedTranslation\":\"Chúng ta đâu có khơi mào ngọn lửa đó.\",\"rating\":9.0},\n  {\"id\":725883,\"suggestedTranslation\":\"Sắp cạn nhiên liệu rồi.\",\"rating\":9.0},\n  {\"id\":725884,\"suggestedTranslation\":\"Nó đang tắt.\",\"rating\":9.0},\n  {\"id\":725885,\"suggestedTranslation\":\"Cái này sẽ rất hữu ích trong một trận chiến quả cầu tuyết đấy.\",\"rating\":9.0},\n  {\"id\":725886,\"suggestedTranslation\":\"Đem chiên lên thì tuyệt cú mèo.\",\"rating\":9.0},\n  {\"id\":725887,\"suggestedTranslation\":\"Biết đâu chúng ta sẽ bắt được vài con cá cơm!\",\"rating\":9.0},\n  {\"id\":725888,\"suggestedTranslation\":\"Tôi nhớ những chuyến đi câu cá với ông nội quá.\",\"rating\":9.0},\n  {\"id\":725889,\"suggestedTranslation\":\"Nấu chín lên thì chắc sẽ ngon hơn đấy.\",\"rating\":9.0},\n  {\"id\":725890,\"suggestedTranslation\":\"Măm măm, ngon tuyệt!\",\"rating\":9.0},\n  {\"id\":725891,\"suggestedTranslation\":\"Mọi giọt nước đã bị hút sạch khỏi nó rồi.\",\"rating\":9.0},\n  {\"id\":725892,\"suggestedTranslation\":\"Trông có vẻ hơi tanh.\",\"rating\":9.0},\n  {\"id\":725893,\"suggestedTranslation\":\"Nhiều xương quá.\",\"rating\":9.0},\n  {\"id\":725894,\"suggestedTranslation\":\"Nó dai lắm, nhưng bọn mình không bận tâm đâu!\",\"rating\":9.0},\n  {\"id\":725895,\"suggestedTranslation\":\"Một trong những món ăn yêu thích của tôi! Chỉ tôi thôi nhé.\",\"rating\":9.0},\n  {\"id\":725896,\"suggestedTranslation\":\"Thứ Ba ăn bánh Taco!\",\"rating\":9.0},\n  {\"id\":725897,\"suggestedTranslation\":\"Trông như một hồ cá vậy! Chỉ là chúng ta ăn câu cá thôi...\",\"rating\":9.0},\n  {\"id\":725898,\"suggestedTranslation\":\"Mềm tơi và ẩm mọng. Ngon tuyệt cú mèo.\",\"rating\":9.0},\n  {\"id\":725899,\"suggestedTranslation5:\"Ồ, cảm giác có một cạnh sắc cứa vào da thịt thật thích.\",\"rating\":9.0},\n  {\"id\":725900,\"suggestedTranslation\":\"Ái chà!\",\"rating\":9.0},\n  {\"id\":725901,\"suggestedTranslation\":\"Wheeee!\",\"rating\":9.0},\n  {\"id\":725902,\"suggestedTranslation\":\"Chúng ta có một món đồ chơi vui lắm nhé!\",\"rating\":9.0},\n  {\"id\":725903,\"suggestedTranslation\":\"Hứa là chúng ta sẽ không làm nước bắn tung tóe đâu...\",\"rating\":9.0},\n  {\"id\":725904,\"suggestedTranslation\":\"Chúng tôi đồng ý là hoa rất đẹp.\",\"rating\":9.0},\n  {\"id\":725905,\"suggestedTranslation\":\"Những cánh