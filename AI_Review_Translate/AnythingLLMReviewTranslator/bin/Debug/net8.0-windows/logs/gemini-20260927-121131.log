            "text": "[\n  {\"id\":724866,\"suggestedTranslation\":\"Chúng ta có nên cuộn dây lại một chút không?\",\"rating\":8.5},\n  {\"id\":724867,\"suggestedTranslation\":\"Đừng ăn tụi mình!\",\"rating\":9.0},\n  {\"id\":724868,\"suggestedTranslation\":\"Vở kịch phải diễn như thế này sao?\",\"rating\":8.5},\n  {\"id\":724869,\"suggestedTranslation\":\"Lẽ ra chúng ta không nên phá cái tổ đó!\",\"rating\":8.5},\n  {\"id\":724870,\"suggestedTranslation\":\"Ôi không... có lẽ tụi mình không nên chèo ra xa thế này.\",\"rating\":8.5},\n  {\"id\":724871,\"suggestedTranslation\":\"Con chim hư đốn!\",\"rating\":9.0},\n  {\"id\":724872,\"suggestedTranslation\":\"Mấy cái cây đang mắng chúng ta kìa!!\",\"rating\":8.5},\n  {\"id\":724873,\"suggestedTranslation\":\"Ghê quá!\",\"rating\":9.0},\n  {\"id\":724874,\"suggestedTranslation\":\"Ồ không... tụi mình không chắc là mình thích âm thanh đó đâu.\",\"rating\":8.5},\n  {\"id\":724875,\"suggestedTranslation\":\"Tụi mình rất nóng lòng muốn xem nó là gì!\",\"rating\":8.5},\n  {\"id\":724876,\"suggestedTranslation\":\"Chúng ta học được rất nhiều điều về thực vật này!\",\"rating\":8.5},\n  {\"id\":724877,\"suggestedTranslation\":\"Uiiii--ÁC!\",\"rating\":8.5},\n  {\"id\":724878,\"suggestedTranslation\":\"Chuồn thôi nào!\",\"rating\":9.0},\n  {\"id\":724879,\"suggestedTranslation\":\"Mình không nghĩ đó là do bụng chúng ta đâu.\",\"rating\":8.5},\n  {\"id\":724880,\"suggestedTranslation\":\"Ái chà, sai chỗ mất tiêu!\",\"rating\":8.5},\n  {\"id\":724881,\"suggestedTranslation\":\"Tụi mình nghe thấy có gì đó đang đến! Nghe có vẻ cáu kỉnh đấy!\",\"rating\":8.5},\n  {\"id\":724882,\"suggestedTranslation\":\"Chúng ta thấy một con thỏ kỳ lạ!\",\"rating\":8.5},\n  {\"id\":724883,\"suggestedTranslation\":\"Tụi mình bắt được nó rồi!\",\"rating\":9.0},\n  {\"id\":724884,\"suggestedTranslation\":\"Có cái gì đó đang đào bới xung quanh chúng ta!\",\"rating\":8.5},\n  {\"id\":724885,\"suggestedTranslation\":\"Tụi mình không đánh trúng nó được.\",\"rating\":8.5},\n  {\"id\":724886,\"suggestedTranslation\":\"Cảm giác gần giống như được đi học lại vậy.\",\"rating\":8.5},\n  {\"id\":724887,\"suggestedTranslation\":\"Khỏe hẳn rồi!\",\"rating\":9.0},\n  {\"id\":724888,\"suggestedTranslation\":\"Được rồi đấy!\",\"rating\":9.0},\n  {\"id\":724889,\"suggestedTranslation\":\"Đợi đã, tụi mình sẽ giúp!\",\"rating\":9.0},\n  {\"id\":724890,\"suggestedTranslation\":\"Bệ hạ của chúng ta!\",\"rating\":9.0},\n  {\"id\":724891,\"suggestedTranslation\":\"Vương miện đẹp đấy!\",\"rating\":9.0},\n  {\"id\":724892,\"suggestedTranslation\":\"Mệnh lệnh của ngài là ý nguyện của chúng tôi!\",\"rating\":8.5},\n  {\"id\":724893,\"suggestedTranslation\":\"\\\"Bệ hạ\\\" của chúng ta!\",\"rating\":9.0},\n  {\"id\":724894,\"suggestedTranslation\":\"\\\"Vương miện\\\" đẹp đấy!\",\"rating\":9.0},\n  {\"id\":724895,\"suggestedTranslation\":\"Kể cho tụi mình nghe một câu chuyện cười đi!\",\"rating\":8.5},\n  {\"id\":724896,\"suggestedTranslation\":\"Mọi thứ đã trở lại rồi!\",\"rating\":9.0},\n  {\"id\":724897,\"suggestedTranslation\":\"Nhưng đó là những món quà mà!\",\"rating\":8.5},\n  {\"id\":724898,\"suggestedTranslation\":\"Nó thích chúng ta kìa!\",\"rating\":9.0},\n  {\"id\":724899,\"suggestedTranslation\":\"Chúng ta đã lấp đầy cuốn sổ lưu bút của mình rồi.\",\"rating\":8.5},\n  {\"id\":724900,\"suggestedTranslation\":\"Này! Nó đang bám theo chúng ta kìa!\",\"rating\":8.5},\n  {\"id\":724901,\"suggestedTranslation\":\"Ái! Chơi gian lận! Tụi mình không thấy bạn được!\",\"rating\":8.5},\n  {\"id\":724902,\"suggestedTranslation\":\"Ánh sáng rùng rợn đó là gì vậy?\",\"rating\":8.5},\n  {\"id\":724903,\"suggestedTranslation\":\"Hãy bảo vệ chúng tôi đi, cây ơi!\",\"rating\":8.5},\n  {\"id\":724904,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":10.0},\n  {\"id\":724905,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":10.0},\n  {\"id\":724906,\"suggestedTranslation\":\"Này! Đồ xấu tính!\",\"rating\":9.0},\n  {\"id\":724907,\"suggestedTranslation\":\"Này! Thả ra xem nào!\",\"rating\":9.0},\n  {\"id\":724908,\"suggestedTranslation\":\"Tuyết đâu mất tiêu rồi?\",\"rating\":9.0},\n  {\"id\":724909,\"suggestedTranslation\":\"Tụi mình không thể vo nó to hơn được nữa!\",\"rating\":8.5},\n  {\"id\":724910,\"suggestedTranslation\":\"Tụi mình ướt sũng rồi!\",\"rating\":9.0},\n  {\"id\":724911,\"suggestedTranslation\":\"Này, làm vậy không đẹp chút nào đâu!\",\"rating\":8.5},\n  {\"id\":724912,\"suggestedTranslation\":\"Chào các thực vật nhé! Hôm nay các bạn thế nào rồi?\",\"rating\":8.5},\n  {\"id\":724913,\"suggestedTranslation\":\"Ò ó o, các bạn có cô đơn không? Tụi mình sẽ làm bạn với các bạn!\",\"rating\":8.5},\n  {\"id\":724914,\"suggestedTranslation\":\"Rồi có ngày bạn sẽ lớn phổng và khỏe mạnh... rồi tụi mình sẽ ăn thịt bạn!\",\"rating\":8.5},\n  {\"id\":724915,\"suggestedTranslation\":\"Bạn là một thực vật rất tốt.\",\"rating\":8.5},\n  {\"id\":724916,\"suggestedTranslation\":\"Tụi mình luôn ở đây khi bạn cần ai đó để trò chuyện!\",\"rating\":8.5},\n  {\"id\":724917,\"suggestedTranslation\":\"Ái chà!\",\"rating\":9.0},\n  {\"id\":724918,\"suggestedTranslation\":\"Ối, mồi nhử của tụi mình đi đời nhà ma rồi.\",\"rating\":8.5},\n  {\"id\":724919,\"suggestedTranslation\":\"Dù sao thì tụi mình cảm thấy dùng nó cũng hơi giống gian lận vậy.\",\"rating\":8.5},\n  {\"id\":724920,\"suggestedTranslation\":\"Ôi không... giờ tụi mình phải đi đâu đây?\",\"rating\":8.5},\n  {\"id\":724921,\"suggestedTranslation\":\"Họ muốn quay lại việc tìm kiếm mấy con chồn lông.\",\"rating\":8.5},\n  {\"id\":724922,\"suggestedTranslation\":\"Hoặc là ai đó đã tìm thấy chúng, hoặc con này nhỏ hơn rất nhiều.\",\"rating\":8.5},\n  {\"id\":724923,\"suggestedTranslation\":\"Chắc là tụi mình đang đến gần rồi!\",\"rating\":8.5},\n  {\"id\":724924,\"suggestedTranslation\":\"Có vẻ như nó chẳng tìm thấy manh mối nào ở đây cả.\",\"rating\":8.5},\n  {\"id\":724925,\"suggestedTranslation\":\"Chà! Nó đang dẫn đường cho tụi mình tới chỗ mấy con chồn lông thẳng tiến luôn kìa! ...Thế này có tính là gian lận không nhỉ?\",\"rating\":8.5},\n  {\"id\":724926,\"suggestedTranslation\":\"Chúng ta nên đi sát theo nó.\",\"rating\":9.0},\n  {\"id\":724927,\"suggestedTranslation\":\"Ái chà, con ếch đi mất tiêu rồi!\",\"rating\":8.5},\n  {\"id\":724928,\"suggestedTranslation\":\"Nó đang đảo mắt tìm đường thoát thân kìa.\",\"rating\":8.5},\n  {\"id\":724929,\"suggestedTranslation\":\"Này! Tụi mình đang dùng cái đó mà!\",\"rating\":9.0},\n  {\"id\":724930,\"suggestedTranslation\":\"Tụi mình không nghĩ công cụ này đủ mạnh đâu!\",\"rating\":8.5},\n  {\"id\":724931,\"suggestedTranslation\":\"Ái chà, đèn của tụi mình tắt ngúm rồi!\",\"rating\":8.5},\n  {\"id\":724932,\"suggestedTranslation\":\"Tụi mình tới nơi rồi!\",\"rating\":9.0},\n  {\"id\":724933,\"suggestedTranslation\":\"Ái!\",\"rating\":9.0},\n  {\"id\":724934,\"suggestedTranslation\":\"Ái chà! Nó cần thêm thời gian.\",\"rating\":8.5},\n  {\"id\":724935,\"suggestedTranslation\":\"Ồ, chúng đang giúp chúng ta kìa!\",\"rating\":8.5},\n  {\"id\":724936,\"suggestedTranslation\":\"Này, tụi mình vẫn ở đây mà!\",\"rating\":9.0},\n  {\"id\":724937,\"suggestedTranslation\":\"Bộ lông của tụi mình ướt sũng nước rồi!\",\"rating\":8.5},\n  {\"id\":724938,\"suggestedTranslation\":\"Tụi mình nghĩ nó không thể đua được nữa đâu...\",\"rating\":8.5},\n  {\"id\":724939,\"suggestedTranslation\":\"Tụi mình cần thứ gì đó mạnh hơn!\",\"rating\":9.0},\n  {\"id\":724940,\"suggestedTranslation\":\"Cân nặng: {weight}\",\"rating\":9.0},\n  {\"id\":724941,\"suggestedTranslation\":\"Cân nặng: {weight}\\nUầy, nặng thế nhỉ!\",\"rating\":8.5},\n  {\"id\":724942,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":10.0},\n  {\"id\":724943,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":10.0},\n  {\"id\":724944,\"suggestedTranslation\":\"Tụi mình ẩm ướt khó chịu quá đi mất.\",\"rating\":8.5},\n  {\"id\":724945,\"suggestedTranslation\":\"Ướt như một cái bồn tắm mà tụi mình không tài nào bò ra được.\",\"rating\":8.5},\n  {\"id\":724946,\"suggestedTranslation\":\"Ôi! Tụi mình trượt mất rồi.\",\"rating\":9.0},\n  {\"id\":724947,\"suggestedTranslation\":\"Hic... chẳng có gì cả.\",\"rating\":9.0},\n  {\"id\":724948,\"suggestedTranslation\":\"Này! Mọi thứ lấp lánh hết cả lên kìa!\",\"rating\":8.5},\n  {\"id\":724949,\"suggestedTranslation\":\"Hic, tụi mình đang chơi vui mà!\",\"rating\":8.5},\n  {\"id\":724950,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":724951,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":724952,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":724953,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":724954,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":724955,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":724956,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":724957,\"suggestedTranslation\":\"Đó là một cái hố đáng sợ!\",\"rating\":8.5},\n  {\"id\":724958,\"suggestedTranslation\":\"Ôi không. Tụi mình không làm bạn với giun đất đâu!\",\"rating\":8.5},\n  {\"id\":724959,\"suggestedTranslation\":\"Ái chà! Con giun TO đang bò tới kìa!\",\"rating\":8.5},\n  {\"id\":724960,\"suggestedTranslation\":\"Uiiii! Hả?\",\"rating\":9.0},\n  {\"id\":724961,\"suggestedTranslation\":\"only_used_by_wx78\",\"rating\":10.0},\n  {\"id\":724962,\"suggestedTranslation\":\"Tụi mình nóng lòng muốn con bò lai mặc thử nó rồi!\",\"rating\":8.5},\n  {\"id\":724963,\"suggestedTranslation\":\"Chúng ta chưa đứng đủ gần điểm xuất phát!\",\"rating\":8.5},\n  {\"id\":724964,\"suggestedTranslation\":\"Ôi! Tụi mình quên dựng các trạm kiểm soát mất tiêu rồi!\",\"rating\":8.5},\n  {\"id\":724965,\"suggestedTranslation\":\"Chúng ta nên chừa chút chỗ trống, nhỡ có ai muốn tham gia cùng thì sao!\",\"rating\":8.5},\n  {\"id\":724966,\"suggestedTranslation\":\"Chà, chắc mấy con ngựa đó đang phải làm việc vặt lúc này rồi.\",\"rating\":8.5},\n  {\"id\":724967,\"suggestedTranslation\":\"Cẩn thận mấy con chim đấy!\",\"rating\":9.0},\n  {\"id\":724968,\"suggestedTranslation\":\"Hy vọng là chúng ta có độc!\",\"rating\":9.0},\n  {\"id\":724969,\"suggestedTranslation\":\"Đỡ đòn đây!\",\"rating\":9.0},\n  {\"id\":724970,\"suggestedTranslation\":\"Tụi mình ghét nó! Con heo gớm ghiếc!\",\"rating\":8.5},\n  {\"id\":724971,\"suggestedTranslation\":\"Tụi mình sẽ nhốt bạn vào mạng nhện!\",\"rating\":8.5},\n  {\"id\":724972,\"suggestedTranslation\":\"Này, muốn chơi không?\",\"rating\":9.0},\n  {\"id\":724973,\"suggestedTranslation\":\"Sao chúng ta lại không thể hòa hợp với nhau cơ chứ?!\",\"rating\":8.5},\n  {\"id\":724974,\"suggestedTranslation\":\"Thôi nào, thế nào tụi mình cũng thắng thôi!\",\"rating\":8.5},\n  {\"id\":724975,\"suggestedTranslation\":\"Hẹn mày dịp khác nhé, heo ạ.\",\"rating\":9.0},\n  {\"id\":724976,\"suggestedTranslation\":\"Đồ chạy nhanh!\",\"rating\":9.0},\n  {\"id\":724977,\"suggestedTranslation\":\"Thực ra tụi mình không muốn làm bạn bị thương đâu.\",\"rating\":8.5},\n  {\"id\":724978,\"suggestedTranslation\":\"Bình tĩnh nào, bạn hiền.\",\"rating\":9.0},\n  {\"id\":724979,\"suggestedTranslation\":\"Tụi mình hơi già để chơi trò ú oà rồi.\",\"rating\":8.5},\n  {\"id\":724980,\"suggestedTranslation\":\"Tụi mình hơi già để chơi trò ú oà rồi.\",\"rating\":8.5},\n  {\"id\":724981,\"suggestedTranslation\":\"Tụi mình hơi già để chơi trò ú oà rồi.\",\"rating\":8.5},\n  {\"id\":724982,\"suggestedTranslation\":\"Tụi mình hơi già để chơi trò ú oà rồi.\",\"rating\":8.5},\n  {\"id\":724983,\"suggestedTranslation\":\"Tụi mình hơi già để chơi trò ú oà rồi.\",\"rating\":8.5},\n  {\"id\":724984,\"suggestedTranslation\":\"Tụi mình hơi già để chơi trò ú oà rồi.\",\"rating\":8.5},\n  {\"id\":724985,\"suggestedTranslation\":\"Những cánh hoa xinh xắn!\",\"rating\":9.0},\n  {\"id\":724986,\"suggestedTranslation\":\"Mấy bông hoa đáng sợ quá!\",\"rating\":8.5},\n  {\"id\":724987,\"suggestedTranslation\":\"Đặt nó xuống mau! Đặt xuống!\",\"rating\":9.0},\n  {\"id\":724988,\"suggestedTranslation\":\"Liệu cô ấy có nghe thấy chúng ta trong đó không?\",\"rating\":8.5},\n  {\"id\":724989,\"suggestedTranslation\":\"Nào Abigail, Wendy nhớ cậu lắm đấy!\",\"rating\":8.5},\n  {\"id\":724990,\"suggestedTranslation\":\"Alooo? Cậu có muốn ra ngoài bây giờ không?\",\"rating\":8.5},\n  {\"id\":724991,\"suggestedTranslation\":\"Mình nghĩ nó đang lắng nghe chúng ta đấy!\",\"rating\":8.5},\n  {\"id\":724992,\"suggestedTranslation\":\"Trông bắt đầu nổi da gà rồi đấy!\",\"rating\":8.5},\n  {\"id\":724993,\"suggestedTranslation\":\"Nó làm chúng ta ngứa ngáy và râm ran dọc sống lưng!\",\"rating\":8.5},\n  {\"id\":724994,\"suggestedTranslation\":\"Này! Gian lận!\",\"rating\":9.0},\n  {\"id\":724995,\"suggestedTranslation\":\"May quá nó chỉ là một bức tượng!\",\"rating\":9.0},\n  {\"id\":724996,\"suggestedTranslation\":\"Tụi mình sẽ kéo nó!\",\"rating\":9.0},\n  {\"id\":724997,\"suggestedTranslation\":\"Nó cho tôi một mục đích sống.\",\"rating\":8.5},\n  {\"id\":724998,\"suggestedTranslation\":\"Cây hay thức ăn đây, có cái gì đó ở bên trong kìa.\",\"rating\":8.5},\n  {\"id\":724999,\"suggestedTranslation\":\"Được nướng trên lửa hồng.\",\"rating\":9.0},\n  {\"id\":725000,\"suggestedTranslation\":\"Mong bạn có một cuộc sống lâu dài và tự do.\",\"rating\":8.5},\n  {\"id\":725001,\"suggestedTranslation\":\"Có điềm dữ đang kéo đến đây.\",\"rating\":8.5},\n  {\"id\":725002,\"suggestedTranslation\":\"Tụi mình nhìn thấy mấy thứ khi đội nó lên...\",\"rating\":8.5},\n  {\"id\":725003,\"suggestedTranslation\":\"Ối không... có lẽ chúng ta chắp vá chúng lại được không nhỉ?\",\"rating\":8.5},\n  {\"id\":725004,\"suggestedTranslation\":\"Nó đang hút hết mấy thứ phát sáng kìa!\",\"rating\":8.5},\n  {\"id\":725005,\"suggestedTranslation\":\"Phù, sợ hú vía!\",\"rating\":9.0},\n  {\"id\":725006,\"suggestedTranslation\":\"Ái! Trông nó có vẻ cáu rồi kìa!\",\"rating\":8.5},\n  {\"id\":725007,\"suggestedTranslation\":\"Trông nó có vẻ cáu kỉnh hơn trước rồi đấy!\",\"rating\":8.5},\n  {\"id\":725008,\"suggestedTranslation\":\"Sáng quá đi mất!\",\"rating\":9.0},\n  {\"id\":725009,\"suggestedTranslation\":\"Hết chưa vậy?\",\"rating\":9.0},\n  {\"id\":725010,\"suggestedTranslation\":\"Ôi không... tụi mình nghĩ vừa làm nó cáu hơn rồi...\",\"rating\":8.5},\n  {\"id\":725011,\"suggestedTranslation\":\"Ái chà, sắc quá đi mất!\",\"rating\":9.0},\n  {\"id\":725012,\"suggestedTranslation\":\"Tụi mình xin lỗi! Tụi mình xin lỗi mà!\",\"rating\":8.5},\n  {\"id\":725013,\"suggestedTranslation\":\"Tụi mình không rõ nó đã làm gì, nhưng trông nó không đứng dậy nổi nữa đâu!\",\"rating\":8.5},\n  {\"id\":725014,\"suggestedTranslation\":\"Cẩn thận đấy! Nó có thể đứng dậy lại đấy!\",\"rating\":8.5},\n  {\"id\":725015,\"suggestedTranslation\":\"Bây giờ mà lăn ra ngủ thì tồi tệ phải biết.\",\"rating\":8.5},\n  {\"id\":725016,\"suggestedTranslation\":\"Nhện không gian ba chân à?\",\"rating\":9.0},\n  {\"id\":725017,\"suggestedTranslation\":\"Chắc đây là một chiếc vòng cổ đẹp.\",\"rating\":8.5},\n  {\"id\":725018,\"suggestedTranslation\":\"Nó thực sự, thực sự rất nặng.\",\"rating\":9.0},\n  {\"id\":725019,\"suggestedTranslation\":\"Cái đó dùng để làm dây neo.\",\"rating\":9.0},\n  {\"id\":725020,\"suggestedTranslation\":\"Cứng quá không cắn nổi.\",\"rating\":9.0},\n  {\"id\":725021,\"suggestedTranslation\":\"Ừm... tụi mình có chắc là nó không chứa đầy nhện con không vậy?\",\"rating\":8.5},\n  {\"id\":725022,\"suggestedTranslation\":\"Nó chẳng giúp mắt chúng ta sáng hơn, nhưng ít nhất cũng đỡ đau bụng hơn một chút.\",\"rating\":8.5},\n  {\"id\":725023,\"suggestedTranslation\":\"Hic, nóng quá không trèo lên được.\",\"rating\":8.5},\n  {\"id\":725024,\"suggestedTranslation\":\"Tội nghiệp ngài Cây.\",\"rating\":9.0},\n  {\"id\":725025,\"suggestedTranslation\":\"Trông có vẻ đáng sợ, nhưng không có nghĩa là nó xấu đâu!\",\"rating\":8.5},\n  {\"id\":725026,\"suggestedTranslation\":\"Tội nghiệp ngài Cây.\",\"rating\":9.0},\n  {\"id\":725027,\"suggestedTranslation\":\"Tụi mình nghĩ nó thích ngôi nhà mới này đấy.\",\"rating\":8.5},\n  {\"id\":725028,\"suggestedTranslation\":\"Không sao đâu, cậu cứ lớn lên khi nào sẵn sàng nhé.\",\"rating\":8.5},\n  {\"id\":725029,\"suggestedTranslation\":\"Sao thế nhỉ? Cậu không thích ở đó à?\",\"rating\":8.5},\n  {\"id\":725030,\"suggestedTranslation\":\"Tụi mình sẽ tìm một mái nhà thật tốt cho bạn!\",\"rating\":8.5},\n  {\"id\":725031,\"suggestedTranslation\":\"Tụi mình muốn xem nó sẽ mọc thành cái gì!\",\"rating\":8.5},\n  {\"id\":725032,\"suggestedTranslation\":\"Cổ xưa và đầy bí ẩn.\",\"rating\":9.0},\n  {\"id\":725033,\"suggestedTranslation\":\"Nó đã bị đập nát rồi.\",\"rating\":9.0},\n  {\"id\":725034,\"suggestedTranslation\":\"Họ đang giận nhau à?\",\"rating\":9.0},\n  {\"id\":725035,\"suggestedTranslation\":\"Nó đang nhấp nhô một cách kỳ lạ.\",\"rating\":8.5},\n  {\"id\":725036,\"suggestedTranslation\":\"Dù là gì đi nữa, nó đi một hàng đơn.\",\"rating\":8.5},\n  {\"id\":725037,\"suggestedTranslation\":\"Trông vừa giống đồ ăn của người vừa giống đồ ăn của nhện!\",\"rating\":8.5},\n  {\"id\":725038,\"suggestedTranslation\":\"Bạn nhiều lông ghê. Tụi mình thích thế.\",\"rating\":8.5},\n  {\"id\":725039,\"suggestedTranslation\":\"Tôi nghĩ nó đang khó chịu đấy.\",\"rating\":8.5},\n  {\"id\":725040,\"suggestedTranslation\":\"Có thêm bạn côn trùng lúc nào cũng thật tuyệt.\",\"rating\":8.5},\n  {\"id\":725041,\"suggestedTranslation\":\"Tụi mình có thể giả vờ làm Kiến Sư Tử!\",\"rating\":9.0},\n  {\"id\":725042,\"suggestedTranslation\":\"Lâu đài cát!!\",\"rating\":9.0},\n  {\"id\":725043,\"suggestedTranslation\":\"Chúng ta đã làm nó nổi giận rồi!\",\"rating\":8.5},\n  {\"id\":725044,\"suggestedTranslation\":\"Ai đó đã bỏ quên mấy bộ phận này ở đây.\",\"rating\":8.5},\n  {\"id\":725045,\"suggestedTranslation\":\"Chắc ai đó đã để lửa cháy suốt.\",\"rating\":9.0