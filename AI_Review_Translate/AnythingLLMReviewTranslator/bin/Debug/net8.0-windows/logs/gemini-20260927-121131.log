            "text": "[\n  {\"id\":722466,\"suggestedTranslation\":\"Gần mực thì đen, gần đèn thì rạng.\",\"rating\":8.5},\n  {\"id\":722467,\"suggestedTranslation\":\"Cậu bị làm sao thế hả?\",\"rating\":8.5},\n  {\"id\":722468,\"suggestedTranslation\":\"Tôi còn nói gì được về cái xác bẩn thỉu này nữa đây?\",\"rating\":8.5},\n  {\"id\":722469,\"suggestedTranslation\":\"Họ hàng xa của bò lai.\",\"rating\":8.5},\n  {\"id\":722470,\"suggestedTranslation\":\"Nó đang mặc áo khoác mùa đông đấy.\",\"rating\":8.5},\n  {\"id\":722471,\"suggestedTranslation\":\"Mong là nó đã được làm sạch kỹ trước khi chúng ta nhồi sung vào trong.\",\"rating\":8.5},\n  {\"id\":722472,\"suggestedTranslation\":\"Cậu bắt tôi thế nào được!\",\"rating\":8.5},\n  {\"id\":722473,\"suggestedTranslation\":\"Nhẹ thật đấy.\",\"rating\":8.5},\n  {\"id\":722474,\"suggestedTranslation\":\"Mong là nó giữ Bọn Chúng tránh xa ra.\",\"rating\":8.5},\n  {\"id\":722475,\"suggestedTranslation\":\"Cũng tạm được.\",\"rating\":8.5},\n  {\"id\":722476,\"suggestedTranslation\":\"Trông cồng kềnh thật đấy.\",\"rating\":8.5},\n  {\"id\":722477,\"suggestedTranslation\":\"Có vẻ nặng đấy.\",\"rating\":8.5},\n  {\"id\":722478,\"suggestedTranslation\":\"Gần như vô dụng.\",\"rating\":8.5},\n  {\"id\":722479,\"suggestedTranslation\":\"Vô dụng một cách nhanh chóng.\",\"rating\":8.5},\n  {\"id\":722480,\"suggestedTranslation\":\"Nó cung cấp một mức độ bảo vệ vừa đủ dùng.\",\"rating\":8.5},\n  {\"id\":722481,\"suggestedTranslation\":\"Cái này dành cho kẻ thích dùng sức đây.\",\"rating\":8.5},\n  {\"id\":722482,\"suggestedTranslation\":\"Khả năng bảo vệ khá ổn sẽ giúp tăng cường sức mạnh cho tôi.\",\"rating\":8.5},\n  {\"id\":722483,\"suggestedTranslation\":\"Thêm chút giáp thì chẳng bao giờ thừa cả.\",\"rating\":8.5},\n  {\"id\":722484,\"suggestedTranslation\":\"Chúng ta phải phá hủy Cờ Hiệu Chiến Đấu đó.\",\"rating\":8.5},\n  {\"id\":722485,\"suggestedTranslation\":\"Thế mà cái thứ đó vẫn đang lê lết xung quanh đấy à.\",\"rating\":8.5},\n  {\"id\":722486,\"suggestedTranslation\":\"Ngài có vẻ ảo tưởng nặng rồi đấy, ngài tốt ạ.\",\"rating\":8.5},\n  {\"id\":722487,\"suggestedTranslation\":\"Cậu phải có cái cổ dày lắm mới đội nổi thứ này.\",\"rating\":8.5},\n  {\"id\":722488,\"suggestedTranslation\":\"Ngươi sẽ phải phục vụ bọn ta.\",\"rating\":8.5},\n  {\"id\":722489,\"suggestedTranslation\":\"Tôi phải có được nó.\",\"rating\":8.5},\n  {\"id\":722490,\"suggestedTranslation\":\"Vớ vẩn thật.\",\"rating\":8.5},\n  {\"id\":722491,\"suggestedTranslation\":\"Không phải gu của tôi lắm.\",\"rating\":8.5},\n  {\"id\":722492,\"suggestedTranslation\":\"Tôi rất cần sự sảng khoái này.\",\"rating\":8.5},\n  {\"id\":722493,\"suggestedTranslation\":\"Tự cung tự cấp dưới dạng vòng hoa.\",\"rating\":8.5},\n  {\"id\":722494,\"suggestedTranslation\":\"Quá thô lỗ so với gu của tôi.\",\"rating\":8.5},\n  {\"id\":722495,\"suggestedTranslation\":\"Chìa khóa là chìa khóa.\",\"rating\":8.5},\n  {\"id\":722496,\"suggestedTranslation\":\"Chuẩn không cần chỉnh.\",\"rating\":8.5},\n  {\"id\":722497,\"suggestedTranslation\":\"Cái đó không hợp với tôi đâu.\",\"rating\":8.5},\n  {\"id\":722498,\"suggestedTranslation\":\"Tôi chẳng có hứng dùng cái đó chút nào.\",\"rating\":8.5},\n  {\"id\":722499,\"suggestedTranslation\":\"Dính vào nó chỉ chuốc thêm phiền phức thôi.\",\"rating\":8.0},\n  {\"id\":722500,\"suggestedTranslation\":\"Hãy chấm dứt chương này trong chuyến hành trình của chúng ta nào.\",\"rating\":8.0},\n  {\"id\":722501,\"suggestedTranslation\":\"Nó sẽ nhanh chóng hồi lại sức mạnh cho tôi.\",\"rating\":8.0},\n  {\"id\":722502,\"suggestedTranslation\":\"Đó là một cánh cổng một chiều.\",\"rating\":8.0},\n  {\"id\":722503,\"suggestedTranslation\":\"Tôi không bao giờ đội một thứ kém sang thế này đâu.\",\"rating\":8.0},\n  {\"id\":722504,\"suggestedTranslation\":\"Một vòng hoa tạm ổn, nhỡ đâu tôi muốn hồi máu.\",\"rating\":8.0},\n  {\"id\":722505,\"suggestedTranslation\":\"Quái vật bỉ ổi! Biết điều đi!\",\"rating\":8.0},\n  {\"id\":722506,\"suggestedTranslation\":\"Nó chẳng đe dọa gì ở trạng thái này cả.\",\"rating\":8.0},\n  {\"id\":722507,\"suggestedTranslation\":\"Nó còn sống trong đó kìa.\",\"rating\":8.0},\n  {\"id\":722508,\"suggestedTranslation\":\"Biết ngay là tôi sẽ làm một ông bố tồi tệ mà.\",\"rating\":8.0},\n  {\"id\":722509,\"suggestedTranslation\":\"Tôi tự hào mà nói rằng nó rất thoải mái và ấm cúng đấy.\",\"rating\":8.0},\n  {\"id\":722510,\"suggestedTranslation\":\"Nó vui khi có tôi, và tôi cũng vậy.\",\"rating\":8.0},\n  {\"id\":722511,\"suggestedTranslation\":\"Ngươi không phải quái vật địa ngục đúng không? Khônggg. Chỉ là bị hiểu lầm thôi!\",\"rating\":8.0},\n  {\"id\":722512,\"suggestedTranslation\":\"Nó đang đói. Sao lại đói cơ chứ?\",\"rating\":8.0},\n  {\"id\":722513,\"suggestedTranslation\":\"Tôi nghĩ nó sắp chết đến nơi rồi!\",\"rating\":8.0},\n  {\"id\":722514,\"suggestedTranslation\":\"Răng sữa của trùng nham.\",\"rating\":8.5},\n  {\"id\":722515,\"suggestedTranslation\":\"Giờ thì nó lạnh và khô rồi.\",\"rating\":8.0},\n  {\"id\":722516,\"suggestedTranslation\":\"Phun lửa kìa.\",\"rating\":8.0},\n  {\"id\":722517,\"suggestedTranslation\":\"Hơi nóng một chút, nhưng có thể dùng để nấu ăn lúc nguy cấp.\",\"rating\":8.0},\n  {\"id\":722518,\"suggestedTranslation\":\"Mỗi ngày tôi lại cục súc hơn một tảng đá.\",\"rating\":8.5},\n  {\"id\":722519,\"suggestedTranslation\":\"Tầm thường đến lạ.\",\"rating\":8.0},\n  {\"id\":722520,\"suggestedTranslation\":\"Thật là tẻ nhạt.\",\"rating\":8.0},\n  {\"id\":722521,\"suggestedTranslation\":\"Tôi đánh giá cao nỗ lực trình bày món ăn này.\",\"rating\":8.0},\n  {\"id\":722522,\"suggestedTranslation\":\"Sinh vật kinh tởm!\",\"rating\":8.0},\n  {\"id\":722523,\"suggestedTranslation\":\"Mang đậm chất dân dã làm sao.\",\"rating\":8.0},\n  {\"id\":722524,\"suggestedTranslation\":\"Sinh vật kinh tởm!\",\"rating\":8.0},\n  {\"id\":722525,\"suggestedTranslation\":\"Loài nấm này đã sống sót qua thời mạt vận.\",\"rating\":8.0},\n  {\"id\":722526,\"suggestedTranslation\":\"Ai lại đi tiêm thứ rác rưởi này vào người chứ?\",\"rating\":8.0},\n  {\"id\":722527,\"suggestedTranslation\":\"Rồi nó cũng sẽ cạn năng lượng thôi.\",\"rating\":8.0},\n  {\"id\":722528,\"suggestedTranslation\":\"Ồ hay nhỉ. Hòn đảo này lúc nào cũng nhung nhúc sâu bọ.\",\"rating\":8.0},\n  {\"id\":722529,\"suggestedTranslation\":\"Chắc là cũng dùng được việc.\",\"rating\":8.0},\n  {\"id\":722530,\"suggestedTranslation\":\"Cuối cùng cũng có một dạng đột biến thực sự hữu ích.\",\"rating\":8.0},\n  {\"id\":722531,\"suggestedTranslation\":\"Xung trậN!\",\"rating\":8.0},\n  {\"id\":722532,\"suggestedTranslation\":\"Nó đang nhai cái quái gì thế nhỉ?\",\"rating\":8.0},\n  {\"id\":722533,\"suggestedTranslation\":\"Làm một cái sừng đẹp phết đấy.\",\"rating\":8.0},\n  {\"id\":722534,\"suggestedTranslation\":\"Năng lượng đang chạy qua đó kìa.\",\"rating\":8.0},\n  {\"id\":722535,\"suggestedTranslation\":\"Được bảo vệ chút đỉnh.\",\"rating\":8.0},\n  {\"id\":722536,\"suggestedTranslation\":\"Hổ phụ sinh hổ tử.\",\"rating\":8.0},\n  {\"id\":722537,\"suggestedTranslation\":\"Tôi thích tiếng kêu của chúng khi đem đi đốt.\",\"rating\":8.0},\n  {\"id\":722538,\"suggestedTranslation\":\"Nó có mặt kìa.\",\"rating\":8.0},\n  {\"id\":722539,\"suggestedTranslation\":\"À. Lại có cơ hội nuôi dưỡng thứ kinh tởm nào đó rồi.\",\"rating\":8.0},\n  {\"id\":722540,\"suggestedTranslation\":\"Chỉ mấy ngày nữa là thành thảm họa.\",\"rating\":8.0},\n  {\"id\":722541,\"suggestedTranslation\":\"Ồ, tôi rất thích những thứ tinh tế.\",\"rating\":8.0},\n  {\"id\":722542,\"suggestedTranslation\":\"Cuối cùng cũng có thứ hợp với khẩu vị tinh tế của tôi.\",\"rating\":8.0},\n  {\"id\":722543,\"suggestedTranslation\":\"Chà. Vui phết đấy chứ trước khi tàn cuộc.\",\"rating\":8.0},\n  {\"id\":722544,\"suggestedTranslation\":\"Chỉ là một khúc gỗ thôi. Còn gì để nói nữa đâu?\",\"rating\":8.0},\n  {\"id\":722545,\"suggestedTranslation\":\"Hừm, dạo này ai cũng được phong làm lãnh chúa nhỉ.\",\"rating\":8.0},\n  {\"id\":722546,\"suggestedTranslation\":\"Tốt nhất là tôi nên mặc kệ nó đi.\",\"rating\":8.0},\n  {\"id\":722547,\"suggestedTranslation\":\"Tốt nhất là tôi nên mặc kệ nó đi.\",\"rating\":8.0},\n  {\"id\":722548,\"suggestedTranslation\":\"Tốt nhất là tôi nên mặc kệ nó đi.\",\"rating\":8.0},\n  {\"id\":722549,\"suggestedTranslation\":\"Tốt nhất là tôi nên mặc kệ nó đi.\",\"rating\":8.0},\n  {\"id\":722550,\"suggestedTranslation\":\"Tốt nhất là tôi nên mặc kệ nó đi.\",\"rating\":8.0},\n  {\"id\":722551,\"suggestedTranslation\":\"Tốt nhất là tôi nên mặc kệ nó đi.\",\"rating\":8.0},\n  {\"id\":722552,\"suggestedTranslation\":\"Tốt nhất là tôi nên mặc kệ nó đi.\",\"rating\":8.0},\n  {\"id\":722553,\"suggestedTranslation\":\"Tốt nhất là tôi nên mặc kệ nó đi.\",\"rating\":8.0},\n  {\"id\":722554,\"suggestedTranslation\":\"Tốt nhất là tôi nên mặc kệ nó đi.\",\"rating\":8.0},\n  {\"id\":722555,\"suggestedTranslation\":\"Tốt nhất là tôi nên mặc kệ nó đi.\",\"rating\":8.0},\n  {\"id\":722556,\"suggestedTranslation\":\"Đối với tôi thì vàng nào chẳng là vàng.\",\"rating\":8.0},\n  {\"id\":722557,\"suggestedTranslation\":\"À. Dạo này thế nào rồi, Lucy?\",\"rating\":8.0},\n  {\"id\":722558,\"suggestedTranslation\":\"Cái này từ đâu chui ra thế?\",\"rating\":8.0},\n  {\"id\":722559,\"suggestedTranslation\":\"Gớm ghiếc.\",\"rating\":8.0},\n  {\"id\":722560,\"suggestedTranslation\":\"Trông có vẻ bất mĩ tuyệt đẹp.\",\"rating\":8.0},\n  {\"id\":722561,\"suggestedTranslation\":\"Cuối cùng thì cái thứ khốn kiếp đó cũng ngỏm rồi.\",\"rating\":8.0},\n  {\"id\":722562,\"suggestedTranslation\":\"Vẫn có những thứ sửa chữa được.\",\"rating\":8.0},\n  {\"id\":722563,\"suggestedTranslation\":\"Tinh thể á? Ra dáng phong cách Bohemian ghê.\",\"rating\":8.0},\n  {\"id\":722564,\"suggestedTranslation\":\"Tôi không thích cái nhìn của cái này chút nào.\",\"rating\":8.0},\n  {\"id\":722565,\"suggestedTranslation\":\"Tôi không nghĩ nó đến từ vùng này đâu.\",\"rating\":8.0},\n 