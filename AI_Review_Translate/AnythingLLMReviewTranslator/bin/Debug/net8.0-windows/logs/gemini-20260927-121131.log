            "text": "[\n  {\"id\": 723066, \"suggestedTranslation\": \"Ít ra thì nó không có mùi, không như mấy phương tiện di chuyển khác.\", \"rating\": 9.0},\n  {\"id\": 723067, \"suggestedTranslation\": \"Hừm. Ta nghĩ cô ta cố tình đặt nó ở trên đó.\", \"rating\": 9.0},\n  {\"id\": 723068, \"suggestedTranslation\": \"Cẩn thận đấy, thưa quý cô. Ta biết con đường này rồi sẽ dẫn đến đâu.\", \"rating\": 9.0},\n  {\"id\": 723069, \"suggestedTranslation\": \"Có vẻ như lần này cô ta sẽ phải chờ đợi rồi.\", \"rating\": 9.0},\n  {\"id\": 723070, \"suggestedTranslation\": \"Cẩn thận đấy, thưa quý cô. Ta biết con đường này rồi sẽ dẫn đến đâu.\", \"rating\": 9.0},\n  {\"id\": 723071, \"suggestedTranslation\": \"Có vẻ như lần này cô ta sẽ phải chờ đợi rồi.\", \"rating\": 9.0},\n  {\"id\": 723072, \"suggestedTranslation\": \"Cẩn thận đấy, thưa quý cô. Ta biết con đường này rồi sẽ dẫn đến đâu.\", \"rating\": 9.0},\n  {\"id\": 723073, \"suggestedTranslation\": \"Có vẻ như lần này cô ta sẽ phải chờ đợi rồi.\", \"rating\": 9.0},\n  {\"id\": 723074, \"suggestedTranslation\": \"Cái đó... trông có vẻ đau đấy.\", \"rating\": 9.0},\n  {\"id\": 723075, \"suggestedTranslation\": \"Ta để nó cạnh đồng hồ quả quýt và lược bỏ túi của mình.\", \"rating\": 9.0},\n  {\"id\": 723076, \"suggestedTranslation\": \"Thật cổ kính làm sao.\", \"rating\": 9.0},\n  {\"id\": 723077, \"suggestedTranslation\": \"Đừng có mà đậu lên vai ta. Hiểu chứ, bạn hiền?\", \"rating\": 9.0},\n  {\"id\": 723078, \"suggestedTranslation\": \"Hơi mang tính kịch nghệ một chút nhỉ?\", \"rating\": 9.0},\n  {\"id\": 723079, \"suggestedTranslation\": \"Thường thì ta sẽ bắt ai đó tách hạt giúp mình.\", \"rating\": 9.0},\n  {\"id\": 723080, \"suggestedTranslation\": \"Ít ra thì cũng tinh tế hơn một chút.\", \"rating\": 9.0},\n  {\"id\": 723081, \"suggestedTranslation\": \"Ta đoán ăn hết cái này chắc tốn khối thời gian.\", \"rating\": 9.0},\n  {\"id\": 723082, \"suggestedTranslation\": \"Mấy việc lao động tay chân thế này không xứng với tầm vóc của ta.\", \"rating\": 9.0},\n  {\"id\": 723083, \"suggestedTranslation\": \"Ta có thể thấy mặt mình phản chiếu trên mặt nước.\", \"rating\": 9.0},\n  {\"id\": 723084, \"suggestedTranslation\": \"Nó trườn tuột xuống tận bên dưới.\", \"rating\": 9.0},\n  {\"id\": 723085, \"suggestedTranslation\": \"Tươi rói từ đáy nước đục ngầu.\", \"rating\": 9.0},\n  {\"id\": 723086, \"suggestedTranslation\": \"Chỉ là một ít tảo thôi.\", \"rating\": 9.0},\n  {\"id\": 723087, \"suggestedTranslation\": \"Đó là quy luật của mọi sinh vật phàm trần.\", \"rating\": 9.0},\n  {\"id\": 723088, \"suggestedTranslation\": \"Nó nhất thiết phải gây ra tiếng động kinh khủng thế này sao?\", \"rating\": 9.0},\n  {\"id\": 723089, \"suggestedTranslation\": \"Ta phải tập kiên nhẫn thôi...\", \"rating\": 9.0},\n  {\"id\": 723090, \"suggestedTranslation\": \"Nó sẽ xong sớm thôi.\", \"rating\": 9.0},\n  {\"id\": 723091, \"suggestedTranslation\": \"Hy vọng là có thứ gì đó dễ nuốt ra lò từ đây.\", \"rating\": 9.0},\n  {\"id\": 723092, \"suggestedTranslation\": \"Trống rỗng một cách thảm hại chẳng có lấy chút thực phẩm nào.\", \"rating\": 9.0},\n  {\"id\": 723093, \"suggestedTranslation\": \"Một công cụ của nghệ thuật ẩm thực hắc ám.\", \"rating\": 9.0},\n  {\"id\": 723094, \"suggestedTranslation\": \"Lửa theo yêu cầu ư? Có lẽ ta đã đánh giá thấp tên lính cây trẻ tuổi đó rồi.\", \"rating\": 9.0},\n  {\"id\": 723095, \"suggestedTranslation\": \"Cuối cùng thì cũng có chút hương vị.\", \"rating\": 9.0},\n  {\"id\": 723096, \"suggestedTranslation\": \"À. Sự nghiền ngẫm mỗi ngày.\", \"rating\": 9.0},\n  {\"id\": 723097, \"suggestedTranslation\": \"Ôi, ta nhớ cảm giác được ngủ trong nhà làm sao.\", \"rating\": 9.0},\n  {\"id\": 723098, \"suggestedTranslation\": \"Chắc chắn là người khác có thể dựng nó lên được mà.\", \"rating\": 9.0},\n  {\"id\": 723099, \"suggestedTranslation\": \"Ngươi biết đấy, nó thuộc họ nhà Cà.\", \"rating\": 9.0},\n  {\"id\": 723100, \"suggestedTranslation\": \"Khoai tây là thứ rất có võ, không thể coi thường được đâu.\", \"rating\": 9.0},\n  {\"id\": 723101, \"suggestedTranslation\": \"Nó thật tinh tế làm sao.\", \"rating\": 9.0},\n  {\"id\": 723102, \"suggestedTranslation\": \"Thật là một cách phục vụ khoai tây kỳ lạ.\", \"rating\": 9.0},\n  {\"id\": 723103, \"suggestedTranslation\": \"Khoai tây giờ có thể ăn được rồi đấy.\", \"rating\": 9.0},\n  {\"id\": 723104, \"suggestedTranslation\": \"Nó chứa nhiều tinh bột hơn cả bộ vest đẹp nhất của ta.\", \"rating\": 9.0},\n  {\"id\": 723105, \"suggestedTranslation\": \"Ta phải đem thực vật này đi trồng à?\", \"rating\": 9.0},\n  {\"id\": 723106, \"suggestedTranslation\": \"Thật cổ kính làm sao.\", \"rating\": 9.0},\n  {\"id\": 723107, \"suggestedTranslation\": \"Đây là hiện thân ghê tởm nào của quỷ dữ vậy?\", \"rating\": 9.0},\n  {\"id\": 723108, \"suggestedTranslation\": \"Ngươi không phải người của ta... ngươi từ đâu chui ra vậy?!\", \"rating\": 9.0},\n  {\"id\": 723109, \"suggestedTranslation\": \"Chắc chắn là quanh đây phải có ít nước chứ.\", \"rating\": 9.0},\n  {\"id\": 723110, \"suggestedTranslation\": \"Ta thực sự chẳng màng gì đến chuyện làm vườn.\", \"rating\": 9.0},\n  {\"id\": 723111, \"suggestedTranslation\": \"Dạo này người ta cứ để bất cứ ai lên nắm quyền nhỉ.\", \"rating\": 9.0},\n  {\"id\": 723112, \"suggestedTranslation\": \"Đó là một chú hải âu cổ rụt.\", \"rating\": 9.0},\n  {\"id\": 723113, \"suggestedTranslation\": \"Ta sẽ biến ngươi thành đồ chơi nhồi bông hải âu cổ rụt luôn đấy.\", \"rating\": 9.0},\n  {\"id\": 723114, \"suggestedTranslation\": \"Giấc ngủ chỉ là một sự trốn tránh tạm thời.\", \"rating\": 9.0},\n  {\"id\": 723115, \"suggestedTranslation\": \"Lễ hội Ma Quỷ luôn là ngày lễ yêu thích của ta.\", \"rating\": 9.0},\n  {\"id\": 723116, \"suggestedTranslation\": \"Thật thú vị.\", \"rating\": 9.0},\n  {\"id\": 723117, \"suggestedTranslation\": \"Đã lâu lắm rồi ta mới được ăn một chiếc bánh quy ngon lành.\", \"rating\": 9.0},\n  {\"id\": 723118, \"suggestedTranslation\": \"Gương mặt đẹp đấy.\", \"rating\": 9.0},\n  {\"id\": 723119, \"suggestedTranslation\": \"Không có khuôn mặt thì nó chỉ là một quả bí ngô thôi.\", \"rating\": 9.0},\n  {\"id\": 723120, \"suggestedTranslation\": \"Chà... có lẽ chỉ một miếng thôi vậy.\", \"rating\": 9.0},\n  {\"id\": 723121, \"suggestedTranslation\": \"Ít ra thì cũng tinh tế hơn một chút.\", \"rating\": 9.0},\n  {\"id\": 723122, \"suggestedTranslation\": \"Ồ xin chào, Ngài Sếu.\", \"rating\": 9.0},\n  {\"id\": 723123, \"suggestedTranslation\": \"Thật là ma quái làm sao.\", \"rating\": 9.0},\n  {\"id\": 723124, \"suggestedTranslation\": \"Mấy việc lao động tay chân thế này không xứng với tầm vóc của ta.\", \"rating\": 9.0},\n  {\"id\": 723125, \"suggestedTranslation\": \"Một bài kiểm tra thô sơ về sức mạnh vũ khí của ta.\", \"rating\": 9.0},\n  {\"id\": 723126, \"suggestedTranslation\": \"Ta tự hỏi liệu cô ta có biết về chuyện này không...\", \"rating\": 9.0},\n  {\"id\": 723127, \"suggestedTranslation\": \"Nó đang trò chuyện với bóng tối.\", \"rating\": 9.0},\n  {\"id\": 723128, \"suggestedTranslation\": \"Màu tím mang lại sức mạnh to lớn.\", \"rating\": 9.0},\n  {\"id\": 723129, \"suggestedTranslation\": \"Ta cho rằng đây là một cách sử dụng sức mạnh của viên ngọc khá hữu ích.\", \"rating\": 9.0},\n  {\"id\": 723130, \"suggestedTranslation\": \"Ta không chắc nó hút ma thuật từ thứ này bằng cách nào.\", \"rating\": 9.0},\n  {\"id\": 723131, \"suggestedTranslation\": \"Tốt nhất là nên dâng cúng cho nó thứ gì đó nếu chúng ta còn muốn sống.\", \"rating\": 9.0},\n  {\"id\": 723132, \"suggestedTranslation\": \"Đó là một cái cột.\", \"rating\": 9.0},\n  {\"id\": 723133, \"suggestedTranslation\": \"Dây thường xuân leo.\", \"rating\": 9.0},\n  {\"id\": 723134, \"suggestedTranslation\": \"Hơi quá đà rồi đấy...\", \"rating\": 9.0},\n  {\"id\": 723135, \"suggestedTranslation\": \"Ta thực sự rất thích một bức tượng đẹp.\", \"rating\": 9.0},\n  {\"id\": 723136, \"suggestedTranslation\": \"Sự tận tụy đặt nhầm chỗ.\", \"rating\": 9.0},\n  {\"id\": 723137, \"suggestedTranslation\": \"Nó đã qua thời hoàng kim rồi.\", \"rating\": 9.0},\n  {\"id\": 723138, \"suggestedTranslation\": \"Mấy thứ đó sẽ không bao giờ mọc lại được nữa đâu.\", \"rating\": 9.0},\n  {\"id\": 723139, \"suggestedTranslation\": \"Đồ đựng thức ăn tinh tế.\", \"rating\": 9.0},\n  {\"id\": 723140, \"suggestedTranslation\": \"Ta phải đem thực vật này đi trồng à?\", \"rating\": 9.0},\n  {\"id\": 723141, \"suggestedTranslation\": \"Mang đậm chất gia đình.\", \"rating\": 9.0},\n  {\"id\": 723142, \"suggestedTranslation\": \"Một chút dấu vết thuần hóa nhỏ nhoi.\", \"rating\": 9.0},\n  {\"id\": 723143, \"suggestedTranslation\": \"Ồ, chà chà chà...\", \"rating\": 9.0},\n  {\"id\": 723144, \"suggestedTranslation\": \"Ta sẽ dùng được thứ này đây.\", \"rating\": 9.0},\n  {\"id\": 723145, \"suggestedTranslation\": \"Ta đang tiến bước trên thế giới này.\", \"rating\": 9.0},\n  {\"id\": 723146, \"suggestedTranslation\": \"Chúng ta có lẽ vẫn có thể lươn lẹo thoát khỏi tình cảnh này đấy.\", \"rating\": 9.0},\n  {\"id\": 723147, \"suggestedTranslation\": \"À, thật tao nhã làm sao.\", \"rating\": 9.0},\n  {\"id\": 723148, \"suggestedTranslation\": \"Hoàn hảo khi ăn kèm với một chút bơ.\", \"rating\": 9.0},\n  {\"id\": 723149, \"suggestedTranslation\": \"Bữa tối chắc sẽ đến nơi bất cứ lúc nào.\", \"rating\": 9.0},\n  {\"id\": 723150, \"suggestedTranslation\": \"Có lẽ nó có chút hương vị đấy.\", \"rating\": 9.0},\n  {\"id\": 723151, \"suggestedTranslation\": \"Ta cho là người ta có thể làm bánh nướng bằng thứ này.\", \"rating\": 9.0},\n  {\"id\": 723152, \"suggestedTranslation\": \"Ta nên trộn nó với thứ gì khác mới được.\", \"rating\": 9.0},\n  {\"id\": 723153, \"suggestedTranslation\": \"Để xem con sâu khoái món này thế nào nào.\", \"rating\": 9.0},\n  {\"id\": 723154, \"suggestedTranslation\": \"Đây chính xác là những gì con sâu muốn.\", \"rating\": 9.0},\n  {\"id\": 723155, \"suggestedTranslation\": \"Chà, ta cho là nó sẽ cầm cự giúp con sâu được một lúc.\", \"rating\": 9.0},\n  {\"id\": 723156, \"suggestedTranslation\": \"Không. Nó sẽ không ăn thứ đó đâu.\", \"rating\": 9.0},\n  {\"id\": 723157, \"suggestedTranslation\": \"Đó không phải do ta nấu.\", \"rating\": 9.0},\n  {\"id\": 723158, \"suggestedTranslation\": \"Ta đoán đó là lý do tại sao chẳng có ma cà rồng nào quanh đây cả.\", \"rating\": 9.0},\n  {\"id\": 723159, \"suggestedTranslation\": \"Ta tự hỏi liệu nó còn có tác dụng xua đuổi thây ma nữa không.\", \"rating\": 9.0},\n  {\"id\": 723160, \"suggestedTranslation\": \"Ta phải đem thực vật này đi trồng à?\", \"rating\": 9.0},\n  {\"id\": 723161, \"suggestedTranslation\": \"Nó chẳng có tương lai gì phía trước cả. Thật đáng tiếc.\", \"rating\": 9.0},\n  {\"id\": 723162, \"suggestedTranslation\": \"E rằng xương của ta vốn dĩ rất dễ gãy.\", \"rating\": 9.0},\n  {\"id\": 723163, \"suggestedTranslation\": \"Tôi có thể xem qua hàng hóa của bà được chứ, thưa quý cô?\", \"rating\": 9.0},\n  {\"id\": 723164, \"suggestedTranslation\": \"Ta tin là mình biết nướng thịt đấy.\", \"rating\": 9.0},\n  {\"id\": 723165, \"suggestedTranslation\": \"Chẳng có ích gì cho ta ở đây cả.\", \"rating\": 9.0},\n  {\"id\": 723166, \"suggestedTranslation\": \"Ta thích một cái vỉ nướng lớn hơn cơ.\", \"rating\": 9.0},\n  {\"id\": 723167, \"suggestedTranslation\": \"Ít ra thì nó cũng di động được.\", \"rating\": 9.0},\n  {\"id\": 723168, \"suggestedTranslation\": \"Việc này thật quá thấp hèn đối với ta.\", \"rating\": 9.0},\n  {\"id\": 723169, \"suggestedTranslation\": \"Và chúng cứ nghĩ đồ đạc trong két sắt của mình là an toàn cơ chứ.\", \"rating\": 9.0},\n  {\"id\": 723170, \"suggestedTranslation\": \"Cái này chắc sẽ mở được vài cánh cửa đấy.\", \"rating\": 9.0},\n  {\"id\": 723171, \"suggestedTranslation\": \"Một chút nét văn minh.\", \"rating\": 9.0},\n  {\"id\": 723172, \"suggestedTranslation\": \"Một chút văn minh.\", \"rating\": 9.0},\n  {\"id\": 723173, \"suggestedTranslation\": \"Cái này trông có vẻ đòi hỏi lao động nặng nhọc đấy.\", \"rating\": 9.0},\n  {\"id\": 723174, \"suggestedTranslation\": \"Chỗ ở hôi hám của mấy sinh vật câu cá bẩn thỉu đó.\", \"rating\": 9.0},\n  {\"id\": 723175, \"suggestedTranslation\": \"Để xem hôm nay chúng có gì nào.\", \"rating\": 9.0},\n  {\"id\": 723176, \"suggestedTranslation\": \"Chà, chúng ta có gì ở đây nào?\", \"rating\": 9.0},\n  {\"id\": 723177, \"suggestedTranslation\": \"Nấm cũng có công dụng riêng của nó.\", \"rating\": 9.0},\n  {\"id\": 723178, \"suggestedTranslation\": \"Ta có lẽ có thể làm ra một món đồ trang trí tạm bợ.\", \"rating\": 9.0},\n  {\"id\": 723179, \"suggestedTranslation\": \"Nó trống rỗng y như cái thế giới khô héo này vậy.\", \"rating\": 9.0},\n  {\"id\": 723180, \"suggestedTranslation\": \"Đó là một củ hành hăng hắc.\", \"rating\": 9.0},\n  {\"id\": 723181, \"suggestedTranslation\": \"Nhận lấy cái này đi, củ hành.\", \"rating\": 9.0},\n  {\"id\": 723182, \"suggestedTranslation\": \"Ta phải đem thực vật này đi trồng à?\", \"rating\": 9.0},\n  {\"id\": 723183, \"suggestedTranslation\": \"Thứ này làm cho mọi việc trở nên tiện lợi hơn nhiều.\", \"rating\": 9.0},\n  {\"id\": 723184, \"suggestedTranslation\": \"Đó là một cái lò nướng. Dùng để nấu ăn.\", \"rating\": 9.0},\n  {\"id\": 723185, \"suggestedTranslation\": \"Nhọn hoắt. Giống như ta vậy.\", \"rating\": 9.0},\n  {\"id\": 723186, \"suggestedTranslation\": \"Một loại tượng quỷ đầu thú nào đó.\", \"rating\": 9.0},\n  {\"id\": 723187, \"suggestedTranslation\": \"Chà, trông cũng thu hút đấy chứ.\", \"rating\": 9.0},\n  {\"id\": 723188, \"suggestedTranslation\": \"Giờ thì chỉ là đống đổ nát vô tích sự thôi.\", \"rating\": 9.0},\n  {\"id\": 723189, \"suggestedTranslation\": \"Xem ra chúng ta đã mở được nó rồi.\", \"rating\": 9.0},\n  {\"id\": 723190, \"suggestedTranslation\": \"Nó cần một chìa khóa.\", \"rating\": 9.0},\n  {\"id\": 723191, \"suggestedTranslation\": \"Đó là một đài tưởng niệm cái chết.\", \"rating\": 9.0},\n  {\"id\": 723192, \"suggestedTranslation\": \"Phải rồi, tro lại với tro và đại loại thế.\", \"rating\": 9.0},\n  {\"id\": 723193, \"suggestedTranslation\": \"Ngươi không trốn được ta đâu.\", \"rating\": 9.0},\n  {\"id\": 723194, \"suggestedTranslation\": \"Nó ngỏm rồi.\", \"rating\": 9.0},\n  {\"id\": 723195, \"suggestedTranslation\": \"Mấy con chim chóc vào đây bằng đường nào thế nhỉ?\", \"rating\": 9.0},\n  {\"id\": 723196, \"suggestedTranslation\": \"Ngủ say tít mít.\", \"rating\": 9.0},\n  {\"id\": 723197, \"suggestedTranslation\": \"Sự xa hoa vừa tầm.\", \"rating\": 9.0},\n  {\"id\": 723198, \"suggestedTranslation\": \"Hơi lợ lợ.\", \"rating\": 9.0},\n  {\"id\": 723199, \"suggestedTranslation\": \"Chẳng ai thèm nghe ta nói cả.\", \"rating\": 9.0},\n  {\"id\": 723200, \"suggestedTranslation\": \"Tốt lắm. Ta có thể thoát khỏi đây rồi.\", \"rating\": 9.0},\n  {\"id\": 723201, \"suggestedTranslation\": \"Ngươi biết đấy, ma thuật có thể làm nó sôi nhanh hơn.\", \"rating\": 9.0},\n  {\"id\": 723202, \"suggestedTranslation\": \"Ngươi biết đấy, nó thuộc họ nhà Cà.\", \"rating\": 9.0},\n  {\"id\": 723203, \"suggestedTranslation\": \"Khoai tây giờ có thể ăn được rồi đấy.\", \"rating\": 9.0},\n  {\"id\": 723204, \"suggestedTranslation\": \"Ta phải đem thực vật này đi trồng à?\", \"rating\": 9.0},\n  {\"id\": 723205, \"suggestedTranslation\": \"Ta có thể tận dụng tốt món này đây.\", \"rating\": 9.0},\n  {\"id\": 723206, \"suggestedTranslation\": \"Còn lâu TA mới tự dựng nó lên nhé.\", \"rating\": 9.0},\n  {\"id\": 723207, \"suggestedTranslation\": \"Ta sẽ không đời nào để nó nói chuyện với cái ấm nước đâu.\", \"rating\": 9.0},\n  {\"id\": 723208, \"suggestedTranslation\": \"Ta cần làm cho cái nồi này ngọt ngào hơn.\", \"rating\": 9.0},\n  {\"id\": 723209, \"suggestedTranslation\": \"Ghê tởm.\", \"rating\": 9.0},\n  {\"id\": 723210, \"suggestedTranslation\": \"Một chiếc xe đạp bị méo mó.\", \"rating\": 9.0},\n  {\"id\": 723211, \"suggestedTranslation\": \"Bãi chiến trường xe ngựa.\", \"rating\": 