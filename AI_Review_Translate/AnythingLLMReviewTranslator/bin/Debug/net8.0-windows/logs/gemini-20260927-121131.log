            "text": "[\n  {\"id\":724566,\"suggestedTranslation\":\"Này! Nhường chỗ nào!\",\"rating\":0.0},\n  {\"id\":724567,\"suggestedTranslation\":\"Ối... Họ đang tranh thủ chợp mắt kìa!\",\"rating\":0.0},\n  {\"id\":724568,\"suggestedTranslation\":\"Chúng tôi có thứ này cho bạn này!\",\"rating\":0.0},\n  {\"id\":724569,\"suggestedTranslation\":\"Ừm. Chắc chúng ta nên giữ lại thì hơn.\",\"rating\":0.0},\n  {\"id\":724570,\"suggestedTranslation\":\"Này! Nhường chỗ nào!\",\"rating\":0.0},\n  {\"id\":724571,\"suggestedTranslation\":\"Ối... Họ đang tranh thủ chợp mắt kìa!\",\"rating\":0.0},\n  {\"id\":724572,\"suggestedTranslation\":\"Chúng ta không cần đến hai cái đâu!\",\"rating\":0.0},\n  {\"id\":724573,\"suggestedTranslation\":\"Chúng ta không nghĩ Jimmy muốn chơi đâu.\",\"rating\":0.0},\n  {\"id\":724574,\"suggestedTranslation\":\"Nó không có tác dụng với chúng ta đâu.\",\"rating\":0.0},\n  {\"id\":724575,\"suggestedTranslation\":\"Nào mọi người, theo chúng tôi!\",\"rating\":0.0},\n  {\"id\":724576,\"suggestedTranslation\":\"Bò lai của chúng ta không đi đâu cả.\",\"rating\":0.0},\n  {\"id\":724577,\"suggestedTranslation\":\"Tôi nghĩ chúng đang hơi cáu kỉnh để làm chuyện đó lúc này.\",\"rating\":0.0},\n  {\"id\":724578,\"suggestedTranslation\":\"Chúng ta không có con bò lai nào để buộc vào cả.\",\"rating\":0.0},\n  {\"id\":724579,\"suggestedTranslation\":\"Bò lai của chúng ta ở xa quá!\",\"rating\":0.0},\n  {\"id\":724580,\"suggestedTranslation\":\"Hồi ở nhà tụi mình có đi thuyền mấy đâu.\",\"rating\":0.0},\n  {\"id\":724581,\"suggestedTranslation\":\"Á đau! Dây thừng cọ rát tay chúng ta rồi!\",\"rating\":0.0},\n  {\"id\":724582,\"suggestedTranslation\":\"Suýt nữa thì được rồi!\",\"rating\":0.0},\n  {\"id\":724583,\"suggestedTranslation\":\"Chúng ta khá chắc là mình đã chọn đúng cái rồi!\",\"rating\":0.0},\n  {\"id\":724584,\"suggestedTranslation\":\"Chúng ta không thể chơi nếu không đăng ký một con bò lai vào cuộc thi.\",\"rating\":0.0},\n  {\"id\":724585,\"suggestedTranslation\":\"Chúng ta trèo lên yên cưỡi không kịp rồi!\",\"rating\":0.0},\n  {\"id\":724586,\"suggestedTranslation\":\"Ấy, bạn đang ngủ à?\",\"rating\":0.0},\n  {\"id\":724587,\"suggestedTranslation\":\"Nó giận quá rồi!\",\"rating\":0.0},\n  {\"id\":724588,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":0.0},\n  {\"id\":724589,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":0.0},\n  {\"id\":724590,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":0.0},\n  {\"id\":724591,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":0.0},\n  {\"id\":724592,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":0.0},\n  {\"id\":724593,\"suggestedTranslation\":\"Chúng ta nghĩ mình nên dùng một chiếc cần câu khác.\",\"rating\":0.0},\n  {\"id\":724594,\"suggestedTranslation\":\"Warly sẽ buồn lắm nếu chúng ta nghịch đồ của chú ấy đấy.\",\"rating\":0.0},\n  {\"id\":724595,\"suggestedTranslation\":\"Tôi không nghĩ chúng ta nên nghịch thứ đó đâu...\",\"rating\":0.0},\n  {\"id\":724596,\"suggestedTranslation\":\"Chúng ta chẳng tìm thấy gì bên trong cả!\",\"rating\":0.0},\n  {\"id\":724597,\"suggestedTranslation\":\"Ái! Nó bị kẹt rồi!\",\"rating\":0.0},\n  {\"id\":724598,\"suggestedTranslation\":\"Chúng ta nghĩ là mình đã có đủ mấy chiếc vòng tay này rồi.\",\"rating\":0.0},\n  {\"id\":724599,\"suggestedTranslation\":\"Ôi. Ai đó đang dùng cái đó mất tiêu rồi.\",\"rating\":0.0},\n  {\"id\":724600,\"suggestedTranslation\":\"Ồ! Tụi mình xin lỗi, trông bạn giống một người bạn của tụi mình quá.\",\"rating\":0.0},\n  {\"id\":724601,\"suggestedTranslation\":\"Ối nhầm! Nhầm Cà Ruột rồi!\",\"rating\":0.0},\n  {\"id\":724602,\"suggestedTranslation\":\"Trông chúng cứ giống nhau thế nào ấy...\",\"rating\":0.0},\n  {\"id\":724603,\"suggestedTranslation\":\"Chúng ta không muốn dùng cái đó đâu.\",\"rating\":0.0},\n  {\"id\":724604,\"suggestedTranslation\":\"Chẳng còn gì mà chúng ta cần biết nữa đâu.\",\"rating\":0.0},\n  {\"id\":724605,\"suggestedTranslation\":\"Chúng ta đã biết tất cả mọi thứ về loài thực vật này rồi!\",\"rating\":0.0},\n  {\"id\":724606,\"suggestedTranslation\":\"Ái chà, trượt mất tiêu rồi!\",\"rating\":0.0},\n  {\"id\":724607,\"suggestedTranslation\":\"Ôi, hết nước mất rồi!\",\"rating\":0.0},\n  {\"id\":724608,\"suggestedTranslation\":\"Trời ạ, chúng ta hết sạch nước mất rồi.\",\"rating\":0.0},\n  {\"id\":724609,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":0.0},\n  {\"id\":724610,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":0.0},\n  {\"id\":724611,\"suggestedTranslation\":\"only_used_by_wx78\",\"rating\":0.0},\n  {\"id\":724612,\"suggestedTranslation\":\"Trò xếp hình hai mảnh này khó phết đấy!\",\"rating\":0.0},\n  {\"id\":724613,\"suggestedTranslation\":\"Hừm... Tôi nghĩ chúng ta cần một cái đĩa khác cho món này.\",\"rating\":0.0},\n  {\"id\":724614,\"suggestedTranslation\":\"Chúng ta bày cái này lên đĩa từ nãy rồi mà.\",\"rating\":0.0},\n  {\"id\":724615,\"suggestedTranslation\":\"Chúng ta phải chèo đúng nhịp chứ!\",\"rating\":0.0},\n  {\"id\":724616,\"suggestedTranslation\":\"Ối! Làm lại lần nữa nào!\",\"rating\":0.0},\n  {\"id\":724617,\"suggestedTranslation\":\"Chèo chèo chèo thuyền nào... lần tới chắc sẽ khá hơn một chút.\",\"rating\":0.0},\n  {\"id\":724618,\"suggestedTranslation\":\"Cái đó cấm động vào.\",\"rating\":0.0},\n  {\"id\":724619,\"suggestedTranslation\":\"Không sao đâu, chúng ta đợi bạn làm xong cũng được!\",\"rating\":0.0},\n  {\"id\":724620,\"suggestedTranslation\":\"Chúng ta không nghĩ mình được phép làm thế đâu.\",\"rating\":0.0},\n  {\"id\":724621,\"suggestedTranslation\":\"Chúng ta không thể đâu. Con robot sẽ nổi giận mất.\",\"rating\":0.0},\n  {\"id\":724622,\"suggestedTranslation\":\"Warly sẽ buồn lắm nếu chúng ta nghịch đồ của chú ấy đấy.\",\"rating\":0.0},\n  {\"id\":724623,\"suggestedTranslation\":\"Chúng ta đã hứa là sẽ không nghịch mấy linh hồn đó mà.\",\"rating\":0.0},\n  {\"id\":724624,\"suggestedTranslation\":\"Chúng ta không được phép đâu.\",\"rating\":0.0},\n  {\"id\":724625,\"suggestedTranslation\":\"Nó giận quá rồi!\",\"rating\":0.0},\n  {\"id\":724626,\"suggestedTranslation\":\"Nó cũng có lông giống chúng ta, nhưng chắc nó không thích cạo lông đâu.\",\"rating\":0.0},\n  {\"id\":724627,\"suggestedTranslation\":\"Chưa đến giờ cạo lông đâu!\",\"rating\":0.0},\n  {\"id\":724628,\"suggestedTranslation\":\"Sạch bong kin kít.\",\"rating\":0.0},\n  {\"id\":724629,\"suggestedTranslation\":\"Chúng ta không nên làm thế với con bò lai của người khác đâu.\",\"rating\":0.0},\n  {\"id\":724630,\"suggestedTranslation\":\"Tiếc quá, nó chạy mất tiêu rồi.\",\"rating\":0.0},\n  {\"id\":724631,\"suggestedTranslation\":\"Chúng ta không thể! Có người ở đấy rồi kìa!\",\"rating\":0.0},\n  {\"id\":724632,\"suggestedTranslation\":\"Chúng ta cần tìm vài con Cà Ruột đã!\",\"rating\":0.0},\n  {\"id\":724633,\"suggestedTranslation\":\"Chật cứng rồi!\",\"rating\":0.0},\n  {\"id\":724634,\"suggestedTranslation\":\"Mọi thứ trong đó ổn cả chứ hả?\",\"rating\":0.0},\n  {\"id\":724635,\"suggestedTranslation\":\"Làm thế là phạm luật đấy.\",\"rating\":0.0},\n  {\"id\":724636,\"suggestedTranslation\":\"Chúng ta không thể đâu. Con robot sẽ nổi giận mất.\",\"rating\":0.0},\n  {\"id\":724637,\"suggestedTranslation\":\"Warly sẽ buồn lắm nếu chúng ta nghịch đồ của chú ấy đấy.\",\"rating\":0.0},\n  {\"id\":724638,\"suggestedTranslation\":\"Chúng ta đã hứa là sẽ không nghịch mấy linh hồn đó mà.\",\"rating\":0.0},\n  {\"id\":724639,\"suggestedTranslation\":\"Chúng ta không được phép đâu.\",\"rating\":0.0},\n  {\"id\":724640,\"suggestedTranslation\":\"Chắc cô Wickerbottom sẽ phải giải thích cái này rồi.\",\"rating\":0.0},\n  {\"id\":724641,\"suggestedTranslation\":\"Tôi khá chắc là một trong số chúng ta biết cái đó đấy.\",\"rating\":0.0},\n  {\"id\":724642,\"suggestedTranslation\":\"Chúng ta nên đợi ra ngoài rồi hẵn tính.\",\"rating\":0.0},\n  {\"id\":724643,\"suggestedTranslation\":\"Này... trên bản đồ này không có chữ \\\"X\\\" nào 