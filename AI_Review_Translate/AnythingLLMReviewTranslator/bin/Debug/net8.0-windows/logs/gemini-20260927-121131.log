n  {\"id\":722356,\"suggestedTranslation\":\"Lại một lần nữa tôi thấy mình phải còng lưng làm lụng vì con cua già đó.\",\"rating\":9.0},\n  {\"id\":722357,\"suggestedTranslation\":\"Con cua khó tính muốn tìm một chỗ hoàn hảo cơ đấy.\",\"rating\":9.0},\n  {\"id\":722358,\"suggestedTranslation\":\"Tôi không hiểu thứ phép thuật này lắm, nhưng tôi tôn trọng nó.\",\"rating\":9.0},\n  {\"id\":722359,\"suggestedTranslation\":\"Tôi chẳng bao giờ quyết định nổi mình muốn gì cả.\",\"rating\":9.0},\n  {\"id\":722360,\"suggestedTranslation\":\"Trà của tôi đâu rồi?\",\"rating\":9.0},\n  {\"id\":722361,\"suggestedTranslation\":\"Tôi đoán là bà ta không mua bảo hiểm đâu.\",\"rating\":9.0},\n  {\"id\":722362,\"suggestedTranslation\":\"Con Ngọc Trai đó đâu rồi nhỉ?\",\"rating\":9.0},\n  {\"id\":722363,\"suggestedTranslation\":\"Hừm. Thực ra thì khá là dễ chịu đấy.\",\"rating\":9.0},\n  {\"id\":722364,\"suggestedTranslation\":\"Thế này thì chẳng ích gì cho tôi cả.\",\"rating\":9.0},\n  {\"id\":722365,\"suggestedTranslation\":\"Tôi nhớ một bồn tắm thật dài và thoải mái quá.\",\"rating\":9.0},\n  {\"id\":722366,\"suggestedTranslation\":\"Vâng, vâng, đang thi công. Còn gì mới nữa không?\",\"rating\":9.0},\n  {\"id\":722367,\"suggestedTranslation\":\"Cũng có tiến bộ hơn rồi đấy.\",\"rating\":9.0},\n  {\"id\":722368,\"suggestedTranslation\":\"Đúng là một cái túp lều đáng thương.\",\"rating\":9.0},\n  {\"id\":722369,\"suggestedTranslation\":\"Chúng ta bắt đầu thấy thoải mái quá nhỉ.\",\"rating\":9.0},\n  {\"id\":722370,\"suggestedTranslation\":\"Đáng yêu đấy.\",\"rating\":9.0},\n  {\"id\":722371,\"suggestedTranslation\":\"Thật là... kỳ quặc.\",\"rating\":9.0},\n  {\"id\":722372,\"suggestedTranslation\":\"Đồ trang trí phong cách hàng hải chưa bao giờ là gu của tôi.\",\"rating\":9.0},\n  {\"id\":722373,\"suggestedTranslation\":\"À. Tôi cứ tưởng mình hết người để làm thất vọng rồi chứ.\",\"rating\":9.0},\n  {\"id\":722374,\"suggestedTranslation\":\"Thật là... lạ lẫm khi được tin tưởng đến vậy.\",\"rating\":9.0},\n  {\"id\":722375,\"suggestedTranslation\":\"Khiến người ta cảm thấy mình như hoàng tộc.\",\"rating\":9.0},\n  {\"id\":722376,\"suggestedTranslation\":\"Chẳng có nơi nào sánh bằng nơi này.\",\"rating\":9.0},\n  {\"id\":722377,\"suggestedTranslation\":\"Bằng cách nào đó, giờ nó còn chẳng thèm nói lên điều gì nữa.\",\"rating\":9.0},\n  {\"id\":722378,\"suggestedTranslation\":\"\\\"Bạn đang ở đây\\\"... Ước gì tôi không có ở đây!\",\"rating\":9.0},\n  {\"id\":722379,\"suggestedTranslation\":\"Việc này đòi hỏi sự thâm thúy đấy.\",\"rating\":9.0},\n  {\"id\":722380,\"suggestedTranslation\":\"Ngọt ngào và dính dấp.\",\"rating\":9.0},\n  {\"id\":722381,\"suggestedTranslation\":\"Nó đầy dòi ong bên trong kìa.\",\"rating\":9.0},\n  {\"id\":722382,\"suggestedTranslation\":\"Mềm mại.\",\"rating\":9.0},\n  {\"id\":722383,\"suggestedTranslation\":\"Trông có vẻ trẻ con, nhưng mà ngon phết.\",\"rating\":9.0},\n  {\"id\":722384,\"suggestedTranslation\":\"Hãy gọi bầy thú ra đi!\",\"rating\":9.0},\n  {\"id\":722385,\"suggestedTranslation\":\"Đúng là hàng tuyển đây rồi.\",\"rating\":9.0},\n  {\"id\":722386,\"suggestedTranslation\":\"May mắn á? Chắc vậy, sao lại không chứ?\",\"rating\":9.0},\n  {\"id\":722387,\"suggestedTranslation\":\"Nóng chết đi được!\",\"rating\":9.0},\n  {\"id\":722388,\"suggestedTranslation\":\"Sang trọng thật đấy.\",\"rating\":9.0},\n  {\"id\":722389,\"suggestedTranslation\":\"Thế này thì chẳng ích gì cho tôi cả.\",\"rating\":9.0},\n  {\"id\":722390,\"suggestedTranslation\":\"Tôi nhớ một bồn tắm thật dài và thoải mái quá.\",\"rating\":9.0},\n  {\"id\":722391,\"suggestedTranslation\":\"Tôi có thể tận dụng đống thủy tinh đó đấy.\",\"rating\":9.0},\n  {\"id\":722392,\"suggestedTranslation\":\"Chúng không nhận ra ta!\",\"rating\":9.0},\n  {\"id\":722393,\"suggestedTranslation\":\"Đám quỷ đói khát, đúng chứ?\",\"rating\":9.0},\n  {\"id\":722394,\"suggestedTranslation\":\"Đáng đời lắm.\",\"rating\":9.0},\n  {\"id\":722395,\"suggestedTranslation\":\"Ước gì chúng ta vứt quách cái đó đi.\",\"rating\":9.0},\n  {\"id\":722396,\"suggestedTranslation\":\"Nó đang hồi sinh kìa!\",\"rating\":9.0},\n  {\"id\":722397,\"suggestedTranslation\":\"Đó là một đường hầm dẫn xuống hang chó săn.\",\"rating\":9.0},\n  {\"id\":722398,\"suggestedTranslation\":\"Có thể dùng làm thời trang đấy chứ.\",\"rating\":9.0},\n  {\"id\":722399,\"suggestedTranslation\":\"Răng chó săn á? Vừa chết chóc lại vừa lịch lãm.\",\"rating\":9.0},\n  {\"id\":722400,\"suggestedTranslation\":\"Sao ta lại tìm được cách dùng cái này cơ chứ?\",\"rating\":9.0},\n  {\"id\":722401,\"suggestedTranslation\":\"Thò cái lưỡi của ngươi vào xem nào. Ngươi đang làm dính đầy dãi vào ống quần ta rồi kìa.\",\"rating\":9.0},\n  {\"id\":722402,\"suggestedTranslation\":\"Cho nó ở trong cái bát đó còn hơn là tôi.\",\"rating\":9.0},\n  {\"id\":722403,\"suggestedTranslation\":\"Linh hồn của nó giờ đã được tự do rồi.\",\"rating\":9.0},\n  {\"id\":722404,\"suggestedTranslation\":\"Những tảng băng trôi nhí.\",\"rating\":9.0},\n  {\"id\":722405,\"suggestedTranslation\":\"Băng đá, băng đá, có lẽ vậy.\",\"rating\":9.0},\n  {\"id\":722406,\"suggestedTranslation\":\"Nó tan chảy rồi.\",\"rating\":9.0},\n  {\"id\":722407,\"suggestedTranslation\":\"Nó tan chảy rồi.\",\"rating\":9.0},\n  {\"id\":722408,\"suggestedTranslation\":\"Một mảng mùa đông thu nhỏ trong hộp.\",\"rating\":9.0},\n  {\"id\":722409,\"suggestedTranslation\":\"Kem sundae, sundae, sundae!\",\"rating\":9.0},\n  {\"id\":722410,\"suggestedTranslation\":\"Buộc chút băng đá lên đầu đi kìa.\",\"rating\":9.0},\n  {\"id\":722411,\"suggestedTranslation\":\"Tôi từng có rất nhiều viên ngọc thừa đấy!\",\"rating\":9.0},\n  {\"id\":722412,\"suggestedTranslation\":\"Mấy thứ bên trong đang ngủ đông đấy.\",\"rating\":9.0},\n  {\"id\":722413,\"suggestedTranslation\":\"Cây trượng ngầu đấy.\",\"rating\":9.0},\n  {\"id\":722414,\"suggestedTranslation\":\"Muốn xem một trò hay ho không? Tôi chỉ cần một tình nguyện viên thôi...\",\"rating\":9.0},\n  {\"id\":722415,\"suggestedTranslation\":\"Ta sẽ cho ngươi thấy một màn ảo thuật lạnh gáy.\",\"rating\":9.0},\n  {\"id\":722416,\"suggestedTranslation\":\"Lạnh gáy thật đấy.\",\"rating\":9.0},\n  {\"id\":722417,\"suggestedTranslation\":\"Giờ thì tôi nhìn thấy bản chất thực sự của nó rồi!\",\"rating\":9.0},\n  {\"id\":722418,\"suggestedTranslation\":\"Nó chỉ tồn tại một nửa ở chiều không gian này thôi.\",\"rating\":9.0},\n  {\"id\":722419,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":9.0},\n  {\"id\":722420,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":9.0},\n  {\"id\":722421,\"suggestedTranslation\":\"Cái lão khùng đó giấu đống rác này ở đây từ bao giờ thế hả?!\",\"rating\":9.0},\n  {\"id\":722422,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":9.0},\n  {\"id\":722423,\"suggestedTranslation\":\"Trông mình vẫn lịch lãm đúng không? Cần gì phải soi gương chứ.\",\"rating\":9.0},\n  {\"id\":722424,\"suggestedTranslation\":\"Gớm ghiếc.\",\"rating\":9.0},\n  {\"id\":722425,\"suggestedTranslation\":\"Suýt chút nữa là bộ đồ của tôi vướng vào đám gai đó rồi!\",\"rating\":9.0},\n  {\"id\":722426,\"suggestedTranslation\":\"Nó làm bẩn cả đôi găng tay đẹp của tôi rồi.\",\"rating\":9.0},\n  {\"id\":722427,\"suggestedTranslation\":\"Tôi nghĩ có mười bảy viên trong đó.\",\"rating\":9.0},\n  {\"id\":722428,\"suggestedTranslation\":\"Bộ tôi thực sự bị hạ giá đến mức phải bới rác sao?\",\"rating\":9.0},\n  {\"id\":722429,\"suggestedTranslation\":\"Cái gì thế kia? Có đáng để bận tâm không nhỉ?\",\"rating\":9.0},\n  {\"id\":722430,\"suggestedTranslation\":\"Chỉ một cử động sai là toàn bộ đống đổ nát sẽ sập xuống ngay.\",\"rating\":9.0},\n  {\"id\":722431,\"suggestedTranslation\":\"Chúng ta thậm chí không tiếc nổi chút muối sao?\",\"rating\":9.0},\n  {\"id\":722432,\"suggestedTranslation\":\"Được nướng chín tới hoàn hảo.\",\"rating\":9.0},\n  {\"id\":722433,\"suggestedTranslation\":\"Tôi có thể ăn thứ gì đó không bị nhầy nhụa được không hả trời?\",\"rating\":9.0},\n  {\"id\":722434,\"suggestedTranslation\":\"Anh thực sự mong tôi đội cái này á?\",\"rating\":9.0},\n  {\"id\":722435,\"suggestedTranslation\":\"Món này chẳng ngon hơn tẹo nào cả.\",\"rating\":9.0},\n  {\"id\":722436,\"suggestedTranslation\":\"Đáng buồn là tôi từng ăn những thứ tệ hơn ở ngoài này rồi.\",\"rating\":9.0},\n  {\"id\":722437,\"suggestedTranslation\":\"Con ong đó đang bực bội cái gì thế nhỉ?\",\"rating\":9.0},\n  {\"id\":722438,\"suggestedTranslation\":\"Tôi vừa nắm đuôi con hổ đấy.\",\"rating\":9.0},\n  {\"id\":722439,\"suggestedTranslation\":\"Không có nó thì chúng ta sống sao nổi cơ chứ.\",\"rating\":9.0},\n  {\"id\":722440,\"suggestedTranslation\":\"Mấy sinh vật đó kém cỏi đến mức không phân biệt được chim thật với chim gỗ.\",\"rating\":9.0},\n  {\"id\":722441,\"suggestedTranslation\":\"Chắc là có người khác dựng lên được chứ.\",\"rating\":9.0},\n  {\"id\":722442,\"suggestedTranslation\":\"Tiếc thật đấy.\",\"rating\":9.0},\n  {\"id\":722443,\"suggestedTranslation\":\"Ít ra nó cũng giữ cho chúng bận rộn.\",\"rating\":9.0},\n  {\"id\":722444,\"suggestedTranslation\":\"Lao động chân tay là việc dành cho lũ dưới quyền.\",\"rating\":9.0},\n  {\"id\":722445,\"suggestedTranslation\":\"Chẳng còn chỗ nào để trốn nữa đâu.\",\"rating\":9.0},\n  {\"id\":722446,\"suggestedTranslation\":\"Nhà cho kitcoon á? Mấy con sinh vật thảm hại đó vẫn chưa biết trèo cây à?\",\"rating\":9.0},\n  {\"id\":722447,\"suggestedTranslation\":\"Chúng không ở đây, chúng đang đi trốn rồi.\",\"rating\":9.0},\n  {\"id\":722448,\"suggestedTranslation\":\"Chúng ta sắp hết thời gian để tìm hết mấy tên nhóc con này rồi.\",\"rating\":9.0},\n  {\"id\":722449,\"suggestedTranslation\":\"Tôi chẳng hiểu sao mình phải xây nhà cho chúng. Chúng cần học cách trèo cây như những con trưởng thành chứ.\",\"rating\":9.0},\n  {\"id\":722450,\"suggestedTranslation\":\"Đúng là một sinh vật thảm hại. Chắc lớn lên nó sẽ chuyên đi móc túi tôi mất.\",\"rating\":9.0},\n  {\"id\":722451,\"suggestedTranslation\":\"Đúng là một sinh vật thảm hại. Đôi tai đó trông thật lố bịch.\",\"rating\":9.0},\n  {\"id\":722452,\"suggestedTranslation\":\"Đúng là một sinh vật thảm hại. Nó bị vướng víu vì quá nhiều lông.\",\"rating\":9.0},\n  {\"id\":722453,\"suggestedTranslation\":\"Đúng là một sinh vật thảm hại. Nhìn nó thôi là tôi đã thấy ngứa ngáy rồi.\",\"rating\":9.0},\n  {\"id\":722454,\"suggestedTranslation\":\"Đúng là một sinh vật thảm hại. Nó có mùi lưu huỳnh.\",\"rating\":9.0},\n  {\"id\":722455,\"suggestedTranslation\":\"Đúng là một sinh vật thảm hại. Nó cần phải đi nha sĩ.\",\"rating\":9.0},\n  {\"id\":722456,\"suggestedTranslation\":\"Tôi đặt tên cho quá nhiều sinh vật rồi, cảm giác mới lạ bay sạch.\",\"rating\":9.0},\n  {\"id\":722457,\"suggestedTranslation\":\"Đúng là một sinh vật thảm hại. Thậm chí nó còn chẳng có vẻ duyên dáng của một con mèo trúc.\",\"rating\":9.0},\n  {\"id\":722458,\"suggestedTranslation\":\"Đúng là một sinh vật thảm hại. Nó đang cố ra vẻ làm một con thú uy nghiêm hơn.\",\"rating\":9.0},\n  {\"id\":722459,\"suggestedTranslation\":\"Đúng là một sinh vật thảm hại, lại còn mặc bộ đồ loè loẹt thế này.\",\"rating\":9.0},\n  {\"id\":722460,\"suggestedTranslation\":\"Chà, đúng là một sinh vật kỳ vĩ và đáng sợ.\",\"rating\":9.0},\n  {\"id\":722461,\"suggestedTranslation\":\"Phép thuật đã biến đổi chiếc sừng của con quái thú này.\",\"rating\":9.0},\n  {\"id\":722462,\"suggestedTranslation\":\"Kho báu hắc ám nào đang ẩn giấu bên trong nhỉ?\",\"rating\":9.0},\n  {\"id\":722463,\"suggestedTranslation\":\"Tay nghề chế tác chất lượng thật đấy!\",\"rating\":9.0},\n  {\"id\":722464,\"suggestedTranslation\":\"Trông nó vượt quá khả năng sửa chữa rồi.\",\"rating\":9.0},\n  {\"id\":722465,\"suggestedTranslation\":\"Cố mà theo kịp đi.\",\"rating\":9.0}\n]",
