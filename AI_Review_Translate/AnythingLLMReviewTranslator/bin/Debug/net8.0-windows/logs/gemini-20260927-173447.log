\":9.0},\n  {\"id\":728085,\"suggestedTranslation\":\"Triệu hồi ngươi đây, quả cầu ánh sáng ấm áp!\",\"rating\":9.0},\n  {\"id\":728086,\"suggestedTranslation\":\"Không ổn rồi đây...\",\"rating\":9.0},\n  {\"id\":728087,\"suggestedTranslation\":\"Bọn mình nên tặng nó thứ gì đó. Có lẽ là cái gì đó thật bông xốp!\",\"rating\":9.0},\n  {\"id\":728088,\"suggestedTranslation\":\"Cùng chế tạo đồ đạc nào!\",\"rating\":9.0},\n  {\"id\":728089,\"suggestedTranslation\":\"Mềm mại và đáng yêu làm sao!\",\"rating\":9.0},\n  {\"id\":728090,\"suggestedTranslation\":\"Bọn mình nên đem khoe nó với trọng tài!\",\"rating\":9.0},\n  {\"id\":728091,\"suggestedTranslation\":\"Mềm mại và đáng yêu làm sao!\",\"rating\":9.0},\n  {\"id\":728092,\"suggestedTranslation\":\"Bọn mình nên đem khoe nó với trọng tài!\",\"rating\":9.0},\n  {\"id\":728093,\"suggestedTranslation\":\"Mềm mại và đáng yêu làm sao!\",\"rating\":9.0},\n  {\"id\":728094,\"suggestedTranslation\":\"Bọn mình nên đem khoe nó với trọng tài!\",\"rating\":9.0},\n  {\"id\":728095,\"suggestedTranslation\":\"Mềm mại và đáng yêu làm sao!\",\"rating\":9.0},\n  {\"id\":728096,\"suggestedTranslation\":\"Bọn mình nên đem khoe nó với trọng tài!\",\"rating\":9.0},\n  {\"id\":728097,\"suggestedTranslation\":\"Mềm mại và đáng yêu làm sao!\",\"rating\":9.0},\n  {\"id\":728098,\"suggestedTranslation\":\"Bọn mình nên đem khoe nó với trọng tài!\",\"rating\":9.0},\n  {\"id\":728099,\"suggestedTranslation\":\"Mềm mại và đáng yêu làm sao!\",\"rating\":9.0},\n  {\"id\":728100,\"suggestedTranslation\":\"Bọn mình nên đem khoe nó với trọng tài!\",\"rating\":9.0},\n  {\"id\":728101,\"suggestedTranslation\":\"Mềm mại và đáng yêu làm sao!\",\"rating\":9.0},\n  {\"id\":728102,\"suggestedTranslation\":\"Bọn mình nên đem khoe nó với trọng tài!\",\"rating\":9.0},\n  {\"id\":728103,\"suggestedTranslation\":\"Mềm mại và đáng yêu làm sao!\",\"rating\":9.0},\n  {\"id\":728104,\"suggestedTranslation\":\"Bọn mình nên đem khoe nó với trọng tài!\",\"rating\":9.0},\n  {\"id\":728105,\"suggestedTranslation\":\"Mềm mại và đáng yêu làm sao!\",\"rating\":9.0},\n  {\"id\":728106,\"suggestedTranslation\":\"Bọn mình nên đem khoe nó với trọng tài!\",\"rating\":9.0},\n  {\"id\":728107,\"suggestedTranslation\":\"Nó chỉ cho chúng ta cách may trang phục Bò Lai. Ờ thì, một phần của nó thôi...\",\"rating\":9.0},\n  {\"id\":728108,\"suggestedTranslation\":\"Nó chỉ cho chúng ta cách may trang phục Bò Lai. Ờ thì, một phần của nó thôi...\",\"rating\":9.0},\n  {\"id\":728109,\"suggestedTranslation\":\"Nó chỉ cho chúng ta cách may trang phục Bò Lai. Ờ thì, một phần của nó thôi...\",\"rating\":9.0},\n  {\"id\":728110,\"suggestedTranslation\":\"Bò Lai của chúng ta đã sẵn sàng cho cuộc thi chưa nhỉ?\",\"rating\":9.0},\n  {\"id\":728111,\"suggestedTranslation\":\"Xây nó ở... đằng kia đi!\",\"rating\":9.0},\n  {\"id\":728112,\"suggestedTranslation\":\"Bọn mình cực kỳ giỏi dùng tơ và chỉ đấy!\",\"rating\":9.0},\n  {\"id\":728113,\"suggestedTranslation\":\"Chúng ta chỉ cần dựng nó lên trước đã.\",\"rating\":9.0},\n  {\"id\":728114,\"suggestedTranslation\":\"Xin chào ngài Trọng tài? Chúng ta bắt đầu cuộc thi được chưa nhỉ?\",\"rating\":9.0},\n  {\"id\":728115,\"suggestedTranslation\":\"Bọn mình cần tìm một chỗ đẹp để tổ chức cuộc thi.\",\"rating\":9.0},\n  {\"id\":728116,\"suggestedTranslation\":\"Không ổn rồi đây...\",\"rating\":9.0},\n  {\"id\":728117,\"suggestedTranslation\":\"Chúng ta nên tặng nó một món quà!\",\"rating\":9.0},\n  {\"id\":728118,\"suggestedTranslation\":\"Cậu có món gì vui cho bọn mình chơi không?\",\"rating\":9.0},\n  {\"id\":728119,\"suggestedTranslation\":\"Ôi không...\",\"rating\":9.0},\n  {\"id\":728120,\"suggestedTranslation\":\"Bọn mình sẽ trở thành huấn luyện viên cừ khôi nhất!\",\"rating\":9.0},\n  {\"id\":728121,\"suggestedTranslation\":\"Chúng bắt đầu quen dần với nó rồi kìa!\",\"rating\":9.0},\n  {\"id\":728122,\"suggestedTranslation\":\"Bọn mình nên tìm chỗ nào đó để đặt cái này.\",\"rating\":9.0},\n  {\"id\":728123,\"suggestedTranslation\":\"Ôi không...\",\"rating\":9.0},\n  {\"id\":728124,\"suggestedTranslation\":\"Chúng ta cần phải sẵn sàng cho mọi tình huống.\",\"rating\":9.0},\n  {\"id\":728125,\"suggestedTranslation\":\"Trông có vẻ vui phết đấy!\",\"rating\":9.0},\n  {\"id\":728126,\"suggestedTranslation\":\"Tất cả những thứ chúng ta cần để xây phòng gym cho Cà Ruột của mình.\",\"rating\":9.0},\n  {\"id\":728127,\"suggestedTranslation\":\"Ôi không...\",\"rating\":9.0},\n  {\"id\":728128,\"suggestedTranslation\":\"\\\"Bánh xe trong phòng gym cứ quay vòng vòng.\\\"\",\"rating\":9.0},\n  {\"id\":728129,\"suggestedTranslation\":\"Nhìn nó chạy kìa!\",\"rating\":9.0},\n  {\"id\":728130,\"suggestedTranslation\":\"Cái này sẽ giúp Cà Ruột của chúng ta chạy nhanh hơn đấy!\",\"rating\":9.0},\n  {\"id\":728131,\"suggestedTranslation\":\"Ôi không...\",\"rating\":9.0},\n  {\"id\":728132,\"suggestedTranslation\":\"Nhìn kìa! Nó có cả một sợi dây thừng nhảy nhỏ xíu luôn!\",\"rating\":9.0},\n  {\"id\":728133,\"suggestedTranslation\":\"Ôi, đáng yêu quá đi!\",\"rating\":9.0},\n  {\"id\":728134,\"suggestedTranslation\":\"Cái này sẽ vui lắm đây!\",\"rating\":9.0},\n  {\"id\":728135,\"suggestedTranslation\":\"Xem điểm kiểm soát này đi!\",\"rating\":9.0},\n  {\"id\":728136,\"suggestedTranslation\":\"Có thể sẽ bị lạc nếu không có mấy cái mốc này đấy.\",\"rating\":9.0},\n  {\"id\":728137,\"suggestedTranslation\":\"Dùng pháo hoa có lẽ là một ý tồi rồi...\",\"rating\":9.0},\n  {\"id\":728138,\"suggestedTranslation\":\"Bọn mình hy vọng người bạn nhỏ không bị lạc đường trên đàng đi.\",\"rating\":9.0},\n  {\"id\":728139,\"suggestedTranslation\":\"Bọn mình làm được rồi! Bọn mình thắng rồi!!\",\"rating\":9.0},\n  {\"id\":728140,\"suggestedTranslation\":\"Ồ, {winner}! Cậu đã dạy Cà Ruột của mình cách đua thế nào vậy?\",\"rating\":9.0},\n  {\"id\":728141,\"suggestedTranslation\":\"Bọn mình nóng lòng muốn xem ai sẽ vượt qua vạch đích đầu tiên quá!\",\"rating\":9.0},\n  {\"id\":728142,\"suggestedTranslation\":\"Chắc chắn bọn mình sẽ thắng!\",\"rating\":9.0},\n  {\"id\":728143,\"suggestedTranslation\":\"Nên bắt đầu cuộc đua ở đâu nhỉ?\",\"rating\":9.0},\n  {\"id\":728144,\"suggestedTranslation\":\"Mình không nghĩ chúng ta dùng được nó nữa đâu...\",\"rating\":9.0},\n  {\"id\":728145,\"suggestedTranslation\":\"Bọn mình vẫn luôn tin tưởng cậu, dù cái cân có nói gì đi nữa.\",\"rating\":9.0},\n  {\"id\":728146,\"suggestedTranslation\":\"Chà! Cậu đã luyện tập chăm chỉ lắm đấy!\",\"rating\":9.0},\n  {\"id\":728147,\"suggestedTranslation\":\"Bọn mình thừa biết Cà Ruột của tụi mình là đỉnh nhất rồi!\",\"rating\":9.0},\n  {\"id\":728148,\"suggestedTranslation\":\"Bọn mình nóng lòng muốn xem Cà Ruột của mình giỏi đến mức nào rồi.\",\"rating\":9.0},\n  {\"id\":728149,\"suggestedTranslation\":\"Hừm, chúng ta nên trồng chúng ở đâu nhỉ?\",\"rating\":9.0},\n  {\"id\":728150,\"suggestedTranslation\":\"Tự hỏi cái gì sẽ mọc lên đây!\",\"rating\":9.0},\n  {\"id\":728151,\"suggestedTranslation\":\"Bám thật chặt vào đáy biển nhé, được chứ?\",\"rating\":9.0},\n  {\"id\":728152,\"suggestedTranslation\":\"Cái đó dùng để làm dây neo.\",\"rating\":9.0},\n  {\"id\":728153,\"suggestedTranslation\":\"Điều này làm bọn mình buồn đấy.\",\"rating\":9.0},\n  {\"id\":728154,\"suggestedTranslation\":\"Bọn mình nghĩ nó muốn đồ bị cháy!\",\"rating\":9.0},\n  {\"id\":728155,\"suggestedTranslation\":\"Bọn mình rất thích chế tạo đồ đạc!\",\"rating\":9.0},\n  {\"id\":728156,\"suggestedTranslation\":\"Ước gì móng vuốt của bọn mình cũng to thế này.\",\"rating\":9.0},\n  {\"id\":728157,\"suggestedTranslation\":\"Bọn mình lái trong cuộc đua được chứ? Xin đấyyy?\",\"rating\":9.0},\n  {\"id\":728158,\"suggestedTranslation\":\"Cái đó dùng để làm bánh lái.\",\"rating\":9.0},\n  {\"id\":728159,\"suggestedTranslation\":\"Bọn mình được chơi hai lượt trên đó chứ?\",\"rating\":9.0},\n  {\"id\":728160,\"suggestedTranslation\":\"Bọn mình có thể hóa thành một chú ngựa!\",\"rating\":9.0},\n  {\"id\":728161,\"suggestedTranslation\":\"Ái