            "text": "[\n  {\"id\":727429,\"suggestedTranslation\":\"Nó cần thứ gì đó để tập trung sức mạnh.\",\"rating\":1.0},\n  {\"id\":727430,\"suggestedTranslation\":\"Có vẻ sẵn sàng để dùng rồi.\",\"rating\":1.0},\n  {\"id\":727431,\"suggestedTranslation\":\"Chúng ta có thể dùng cái này để đến thế giới mới!\",\"rating\":1.0},\n  {\"id\":727432,\"suggestedTranslation\":\"Tớ nghe thấy âm thanh từ thế giới khác!\",\"rating\":1.0},\n  {\"id\":727433,\"suggestedTranslation\":\"Nó vẫn không hoạt động!\",\"rating\":1.0},\n  {\"id\":727434,\"suggestedTranslation\":\"Tớ không nghĩ chúng ta đã xong đâu!\",\"rating\":1.0},\n  {\"id\":727435,\"suggestedTranslation\":\"Sức mạnh trong chiếc hộp này thật không thể tưởng tượng nổi.\",\"rating\":1.0},\n  {\"id\":727436,\"suggestedTranslation\":\"Một tay quay có thể chịu được va đập.\",\"rating\":1.0},\n  {\"id\":727437,\"suggestedTranslation\":\"Có vẻ cái này đi kèm với thứ gì đó...\",\"rating\":1.0},\n  {\"id\":727438,\"suggestedTranslation\":\"Tớ nghĩ vẫn còn nhiều bộ phận khác.\",\"rating\":1.0},\n  {\"id\":727439,\"suggestedTranslation\":\"Chỉ nhìn vào nó thôi cũng làm não tớ thấy mụ mẫm rồi.\",\"rating\":1.0},\n  {\"id\":727440,\"suggestedTranslation\":\"Ngọn lửa đã thiêu rụi nó.\",\"rating\":1.0},\n  {\"id\":727441,\"suggestedTranslation\":\"Đã quá giờ đi ngủ của chúng ta rồi!\",\"rating\":1.0},\n  {\"id\":727442,\"suggestedTranslation\":\"Nếu ai đó giẫm lên chúng ta, chúng ta cũng sẽ nổi điên lên thôi.\",\"rating\":1.0},\n  {\"id\":727443,\"suggestedTranslation\":\"Chúng ta có thể đánh bọn chúng bằng mấy cái đầu nhọn!\",\"rating\":1.0},\n  {\"id\":727444,\"suggestedTranslation\":\"Nhiều đốm quá!\",\"rating\":1.0},\n  {\"id\":727445,\"suggestedTranslation\":\"Nó to quá!\",\"rating\":1.0},\n  {\"id\":727446,\"suggestedTranslation\":\"Nó to quá!\",\"rating\":1.0},\n  {\"id\":727447,\"suggestedTranslation\":\"Ôi, nó chỉ là một đứa bé thôi!\",\"rating\":1.0},\n  {\"id\":727448,\"suggestedTranslation\":\"Ồ hố, nhảy vào thôi nào!\",\"rating\":1.0},\n  {\"id\":727449,\"suggestedTranslation\":\"Ồ không! Chúng ta làm mất cái cây nhỏ ở đâu rồi nhỉ?\",\"rating\":1.0},\n  {\"id\":727450,\"suggestedTranslation\":\"Ối ồ... cái cây bị ốm à?\",\"rating\":1.0},\n  {\"id\":727451,\"suggestedTranslation\":\"CHÚNG TA KHÔNG LẮC NÓ ĐÂU, HỨA LUÔN!!\",\"rating\":1.0},\n  {\"id\":727452,\"suggestedTranslation\":\"Đẹp quá! Bọn mình muốn lắc nó quá!\",\"rating\":1.0},\n  {\"id\":727453,\"suggestedTranslation\":\"Tớ nghĩ chúng ta chơi với Ngài Cầu Mắt thế là đủ rồi.\",\"rating\":1.0},\n  {\"id\":727454,\"suggestedTranslation\":\"Chúng ta lắc nhẹ một tí thôi cũng được nhỉ?\",\"rating\":1.0},\n  {\"id\":727455,\"suggestedTranslation\":\"Ôi, chiếc rương đó xinh xắn làm sao.\",\"rating\":1.0},\n  {\"id\":727456,\"suggestedTranslation\":\"Bọn mình chẳng tìm thấy món đồ chơi nào bên trong cả.\",\"rating\":1.0},\n  {\"id\":727457,\"suggestedTranslation\":\"Tớ cá là có rất nhiều đồ chơi ở trong đấy!\",\"rating\":1.0},\n  {\"id\":727458,\"suggestedTranslation\":\"Cục đá sang chảnh!\",\"rating\":1.0},\n  {\"id\":727459,\"suggestedTranslation\":\"Chúng ta có thể làm điều đó bằng bộ râu của mình!\",\"rating\":1.0},\n  {\"id\":727460,\"suggestedTranslation\":\"Mấy mảnh đá tảng sang chảnh nhỏ.\",\"rating\":1.0},\n  {\"id\":727461,\"suggestedTranslation\":\"Nó nóng thật đấy.\",\"rating\":1.0},\n  {\"id\":727462,\"suggestedTranslation\":\"Bọn mình sẽ cố hết sức để tự tìm chúng.\",\"rating\":1.0},\n  {\"id\":727463,\"suggestedTranslation\":\"Tâu bệ hạ!\",\"rating\":1.0},\n  {\"id\":727464,\"suggestedTranslation\":\"Ôi, chúng ta không nhanh tay bằng rồi.\",\"rating\":1.0},\n  {\"id\":727465,\"suggestedTranslation\":\"Có chú mèo con nào ở gần đây không hả bệ hạ?\",\"rating\":1.0},\n  {\"id\":727466,\"suggestedTranslation\":\"Trông có vẻ không có gì ở quanh đây cả...\",\"rating\":1.0},\n  {\"id\":727467,\"suggestedTranslation\":\"Chà! Làm tốt lắm, điện hạ!\",\"rating\":1.0},\n  {\"id\":727468,\"suggestedTranslation\":\"Chắc chú mèo con ở ngoài tầm đánh hơi của nó rồi nhỉ?\",\"rating\":1.0},\n  {\"id\":727469,\"suggestedTranslation\":\"Nó đang đánh hơi thấy gì đó kìa!\",\"rating\":1.0},\n  {\"id\":727470,\"suggestedTranslation\":\"Bây giờ nó đang giúp người khác mất rồi.\",\"rating\":1.0},\n  {\"id\":727471,\"suggestedTranslation\":\"Nó cứ thích làm bừa khu vườn của chúng ta.\",\"rating\":1.0},\n  {\"id\":727472,\"suggestedTranslation\":\"Nó giúp chữa lành mấy vết thương nhỏ.\",\"rating\":1.0},\n  {\"id\":727473,\"suggestedTranslation\":\"Có phải chúng ta vừa hái mấy thứ này không nhỉ?\",\"rating\":1.0},\n  {\"id\":727474,\"suggestedTranslation\":\"Ái chà! Con ếch to ghê!\",\"rating\":1.0},\n  {\"id\":727475,\"suggestedTranslation\":\"Đáng sợ toadally!\",\"rating\":1.0},\n  {\"id\":727476,\"suggestedTranslation\":\"Cậu nghĩ chúng ta chui vừa không?\",\"rating\":1.0},\n  {\"id\":727477,\"suggestedTranslation\":\"Nấm kìa! Là cây nấm đấy!\",\"rating\":1.0},\n  {\"id\":727478,\"suggestedTranslation\":\"Tớ nghĩ nó cần được giúp đỡ để trồi lên.\",\"rating\":1.0},\n  {\"id\":727479,\"suggestedTranslation\":\"Đó là quả hay rau vậy nhỉ?\",\"rating\":1.0},\n  {\"id\":727480,\"suggestedTranslation\":\"Đó là một củ-quả được nấu chín. Hay là quả-rau?\",\"rating\":1.0},\n  {\"id\":727481,\"suggestedTranslation\":\"To và mọng nước.\",\"rating\":1.0},\n  {\"id\":727482,\"suggestedTranslation\":\"Chúng ta có thể tìm hiểu xem chúng là gì bằng cách đem đi trồng.\",\"rating\":1.0},\n  {\"id\":727483,\"suggestedTranslation\":\"Giống cái mà bố thường đội.\",\"rating\":1.0},\n  {\"id\":727484,\"suggestedTranslation\":\"Không hẳn giống cái mà bố hay đội.\",\"rating\":1.0},\n  {\"id\":727485,\"suggestedTranslation\":\"Cái này sẽ giữ an toàn cho két sắt của chúng ta.\",\"rating\":1.0},\n  {\"id\":727486,\"suggestedTranslation\":\"Bọn mình chưa bao giờ ăn bánh nếp có thịt trước đây cả.\",\"rating\":1.0},\n  {\"id\":727487,\"suggestedTranslation\":\"Tớ hy vọng không ai bị nhức đầu cả.\",\"rating\":1.0},\n  {\"id\":727488,\"suggestedTranslation\":\"Lơ lửng và kỳ lạ.\",\"rating\":1.0},\n  {\"id\":727489,\"suggestedTranslation\":\"Tớ nghĩ nó đã sẵn sàng rồi!\",\"rating\":1.0},\n  {\"id\":727490,\"suggestedTranslation\":\"Tớ không biết cục đá lại có mùi đấy.\",\"rating\":1.0},\n  {\"id\":727491,\"suggestedTranslation\":\"Giòn rụm và tốt cho sức khỏe.\",\"rating\":1.0},\n  {\"id\":727492,\"suggestedTranslation\":\"Không đùa giỡn gì nữa nhé, ngài kia!\",\"rating\":1.0},\n  {\"id\":727493,\"suggestedTranslation\":\"Một món đồ vặt được chế tạo rất khéo léo!\",\"rating\":1.0},\n  {\"id\":727494,\"suggestedTranslation\":\"Giờ thì chúng ta có thể bắt thức ăn rồi!\",\"rating\":1.0},\n  {\"id\":727495,\"suggestedTranslation\":\"Đó là một chiếc bẫy thực vật đầy gai góc!\",\"rating\":1.0},\n  {\"id\":727496,\"suggestedTranslation\":\"Bây giờ nó chỉ là mấy cục đá thôi.\",\"rating\":1.0},\n  {\"id\":727497,\"suggestedTranslation\":\"Nếu có kẻ bắt nạt nào đuổi theo, chúng ta biết phải làm gì rồi đấy!\",\"rating\":1.0},\n  {\"id\":727498,\"suggestedTranslation\":\"Sàn nhà là dung nham rồi!\",\"rating\":1.0},\n  {\"id\":727499,\"suggestedTranslation\":\"Chân chúng ta nóng quá chịu không nổi!\",\"rating\":1.0},\n  {\"id\":727500,\"suggestedTranslation\":\"Ái chà, thứ đó đói bụng thật đấy!\",\"rating\":1.0},\n  {\"id\":727501,\"suggestedTranslation\":\"Sao mà con sao biển dễ thương thế!\",\"rating\":1.0},\n  {\"id\":727502,\"suggestedTranslation\":\"Cái này sẽ làm kẻ thù của chúng ta đau đấy.\",\"rating\":1.0},\n  {\"id\":727503,\"suggestedTranslation\":\"Ai lại đặt cái này ở đây chứ? Chúng ta có thể bị thương đấy!\",\"rating\":1.0},\n  {\"id\":727504,\"suggestedTranslation\":\"Bây giờ thì nó chẳng còn mấy hữu ích với chúng ta nữa rồi.\",\"rating\":1.0},\n  {\"id\":727505,\"suggestedTranslation\":\"Chúng ta có thể cất đồ chơi trong này!\",\"rating\":1.0},\n  {\"id\":727506,\"suggestedTranslation\":\"Hãy nghĩ xem có bao nhiêu món đồ chơi chúng ta có thể nhét vào trong đó nào!\",\"rating\":1.0},\n  {\"id\":727507,\"suggestedTranslation\":\"Liếc nhìn vào trong một tí chắc không sao đâu...\",\"rating\":1.0},\n  {\"id\":727508,\"suggestedTranslation\":\"Nó đang ngáng đường chúng ta!\",\"rating\":1.0},\n  {\"id\":727509,\"suggestedTranslation\":\"Giá như chúng ta có một ít bơ đậu phộng.\",\"rating\":1.0},\n  {\"id\":727510,\"suggestedTranslation\":\"Tránh đường ra nào!\",\"rating\":1.0},\n  {\"id\":727511,\"suggestedTranslation\":\"Chúng ta sẽ khai thác nó!\",\"rating\":1.0},\n  {\"id\":727512,\"suggestedTranslation\":\"Khi cành cây gãy...\",\"rating\":1.0},\n  {\"id\":727513,\"suggestedTranslation\":\"Chúng lớn nhanh thật đấy!\",\"rating\":1.0},\n  {\"id\":727514,\"suggestedTranslation\":\"Hạt mầm nhỏ dễ thương làm sao!\",\"rating\":1.0},\n  {\"id\":727515,\"suggestedTranslation\":\"Bọn mình không biết chơi thế nào, nhưng cứ thử xem sao!\",\"rating\":1.0},\n  {\"id\":727516,\"suggestedTranslation\":\"Chúng ta vẫn có thể chơi với mấy thứ này, nếu siêu sáng tạo một chút.\",\"rating\":1.0},\n  {\"id\":727517,\"suggestedTranslation\":\"Y hệt thứ mà ông hay đeo!\",\"rating\":1.0},\n  {\"id\":727518,\"suggestedTranslation\":\"Bíp bốp!\",\"rating\":1.0},\n  {\"id\":727519,\"suggestedTranslation\":\"Sờ vào giống da thuộc thế.\",\"rating\":1.0},\n  {\"id\":727520,\"suggestedTranslation\":\"Nó đang nhìn chúng ta kìa.\",\"rating\":1.0},\n  {\"id\":727521,\"suggestedTranslation\":\"Bọn mình thèm cacao nóng quá.\",\"rating\":1.0},\n  {\"id\":727522,\"suggestedTranslation\":\"Bọn mình không biết chơi trò này thế nào cả.\",\"rating\":1.0},\n  {\"id\":727523,\"suggestedTranslation\":\"Bọn mình không biết chơi trò này thế nào cả.\",\"rating\":1.0},\n  {\"id\":727524,\"suggestedTranslation\":\"Dĩa thìa kết hợp. Dĩa thìa kết hợp. Hahaha!\",\"rating\":1.0},\n  {\"id\":727525,\"suggestedTranslation\":\"Bọn mình thích đồ chơi.\",\"rating\":1.0},\n  {\"id\":727526,\"suggestedTranslation\":\"Món đồ chơi này hoạt động không tốt lắm.\",\"rating\":1.0},\n  {\"id\":727527,\"suggestedTranslation