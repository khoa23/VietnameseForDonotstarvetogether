rating\":9.0},\n  {\"id\":728200,\"suggestedTranslation\":\"Ôi chao, cậu cần ai đó để trò chuyện à?\",\"rating\":9.0},\n  {\"id\":728201,\"suggestedTranslation\":\"Chúng ta nên nhổ cỏ dại thôi... dù bọn mình không thích làm thế cho lắm.\",\"rating\":9.0},\n  {\"id\":728202,\"suggestedTranslation\":\"Chúng ta nên tưới chút nước cho nó.\",\"rating\":9.0},\n  {\"id\":728203,\"suggestedTranslation\":\"Có lẽ nó cần đất tốt hơn chăng?\",\"rating\":9.0},\n  {\"id\":728204,\"suggestedTranslation\":\"Chúng ta trồng quá nhiều thực vật chật ních cả lại với nhau rồi!\",\"rating\":9.0},\n  {\"id\":728205,\"suggestedTranslation\":\"Bọn mình không nghĩ nó thích thời tiết này cho lắm đâu.\",\"rating\":9.0},\n  {\"id\":728206,\"suggestedTranslation\":\"Thực vật này trông thảm hại quá!\",\"rating\":9.0},\n  {\"id\":728207,\"suggestedTranslation\":\"Ủa ôi. Mình ngửi thấy mùi cháy!\",\"rating\":9.0},\n  {\"id\":728208,\"suggestedTranslation\":\"Tất cả các con mắt của bọn mình ngừng hoạt động rồi!\",\"rating\":9.0},\n  {\"id\":728209,\"suggestedTranslation\":\"Lỡ nó nở trong bụng bọn mình thì sao?\",\"rating\":9.0},\n  {\"id\":728210,\"suggestedTranslation\":\"Nó... gợi cho mình nhớ đến món ăn của mẹ...\",\"rating\":9.0},\n  {\"id\":728211,\"suggestedTranslation\":\"Đừng ăn bọn mình!\",\"rating\":9.0},\n  {\"id\":728212,\"suggestedTranslation\":\"Ôi không! Bọn mình làm cháy tiêu rồi!\",\"rating\":9.0},\n  {\"id\":728213,\"suggestedTranslation\":\"Ôi không! Đó đâu phải là một công thức nấu ăn!\",\"rating\":9.0},\n  {\"id\":728214,\"suggestedTranslation\":\"Tôi sẵn sàng để về nhà rồi!\",\"rating\":9.0},\n  {\"id\":728215,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":9.0},\n  {\"id\":728216,\"suggestedTranslation\":\"Ngài Quạ? Ngài có ở đây không?\",\"rating\":9.0},\n  {\"id\":728217,\"suggestedTranslation\":\"Bỏ hoang. Mặc cho ruồi nhặng bu quanh.\",\"rating\":9.0},\n  {\"id\":728218,\"suggestedTranslation\":\"Chắc hẳn ông ấy có nhiều việc quan trọng hơn để làm.\",\"rating\":9.0},\n  {\"id\":728219,\"suggestedTranslation\":\"Nếu chúng ta chơi bây giờ, chúng sẽ không có cơ hội chiến thắng đâu.\",\"rating\":9.0},\n  {\"id\":728220,\"suggestedTranslation\":\"Nếu chúng ta chơi bây giờ, chúng sẽ chẳng tìm nổi chỗ để trốn đâu.\",\"rating\":9.0},\n  {\"id\":728221,\"suggestedTranslation\":\"Nếu chơi nữa, Abigail sẽ mệt mất.\",\"rating\":9.0},\n  {\"id\":728222,\"suggestedTranslation\":\"Tôi không thể mở nó nếu không có chìa khóa.\",\"rating\":9.0},\n  {\"id\":728223,\"suggestedTranslation\":\"Không. Thật ngớ ngẩn.\",\"rating\":9.0},\n  {\"id\":728224,\"suggestedTranslation\":\"Lũ quạ đã rời bỏ nơi này... Tôi nghĩ mình sẽ nhớ chúng đấy.\",\"rating\":9.0},\n  {\"id\":728225,\"suggestedTranslation\":\"only_used_by_wurt\",\"rating\":9.0},\n  {\"id\":728226,\"suggestedTranslation\":\"Tôi không nên chạm vào đồ của cái máy đó.\",\"rating\":9.0},\n  {\"id\":728227,\"suggestedTranslation\":\"Chúng chỉ tuân lệnh Wurt thôi.\",\"rating\":9.0},\n  {\"id\":728228,\"suggestedTranslation\":\"Nó đang làm việc tốt nhất của mình kìa.\",\"rating\":9.0},\n  {\"id\":728229,\"suggestedTranslation\":\"Tôi thậm chí còn chẳng có cái gối nào để chiến đấu...\",\"rating\":9.0},\n  {\"id\":728230,\"suggestedTranslation\":\"Tôi cần phải rưới nó lên bông hoa của Abby.\",\"rating\":9.0},\n  {\"id\":728231,\"suggestedTranslation\":\"Quá sức rồi.\",\"rating\":9.0},\n  {\"id\":728232,\"suggestedTranslation\":\"only_used_by_wx78\",\"rating\":9.0},\n  {\"id\":728233,\"suggestedTranslation\":\"only_used_by_wx78\",\"rating\":9.0},\n  {\"id\":728234,\"suggestedTranslation\":\"Ồ. Chắc ông ấy bận quá...\",\"rating\":9.0},\n  {\"id\":728235,\"suggestedTranslation\":\"Tôi không thể... Tôi thấy không khỏe chút nào...\",\"rating\":9.0},\n  {\"id\":728236,\"suggestedTranslation\":\"Đã được làm rồi mà.\",\"rating\":9.0},\n  {\"id\":728237,\"suggestedTranslation\":\"Nó phủ đầy thủy tinh rồi...\",\"rating\":9.0},\n  {\"id\":728238,\"suggestedTranslation\":\"Tôi chỉ có thể đưa một linh hồn đến đích tại một thời điểm...\",\"rating\":9.0},\n  {\"id\":728239,\"suggestedTranslation\":\"Tôi phải đợi đã.\",\"rating\":9.0},\n  {\"id\":728240,\"suggestedTranslation\":\"Tôi chỉ có thể có một...\",\"rating\":9.0},\n  {\"id\":728241,\"suggestedTranslation\":\"Tôi không thể đặt thứ đó từ vị trí cao thế này được.\",\"rating\":9.0},\n  {\"id\":728242,\"suggestedTranslation\":\"Càng có nhiều bạn, tình cảm càng nông cạn.\",\"rating\":9.0},\n  {\"id\":728243,\"suggestedTranslation\":\"Tôi đã quá muộn...\",\"rating\":9.0},\n  {\"id\":728244,\"suggestedTranslation\":\"Nó đang cháy kìa.\",\"rating\":9.0},\n  {\"id\":728245,\"suggestedTranslation\":\"Quả bí ngô đó đang bị đâm thủng rồi.\",\"rating\":9.0},\n  {\"id\":728246,\"suggestedTranslation\":\"only_used_by_willow\",\"rating\":9.0},\n  {\"id\":728247,\"suggestedTranslation\":\"only_used_by_willow\",\"rating\":9.0},\n  {\"id\":728248,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":9.0},\n  {\"id\":728249,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":9.0},\n  {\"id\":728250,\"suggestedTranslation\":\"only_used_by_willow\",\"rating\":9.0},\n  {\"id\":728251,\"suggestedTranslation\":\"only_used_by_willow\",\"rating\":9.0},\n  {\"id\":728252,\"suggestedTranslation\":\"only_used_by_wurt\",\"rating\":9.0},\n  {\"id\":728253,\"suggestedTranslation\":\"Chắc tôi sẽ không thay đổi trang phục sớm đâu.\",\"rating\":9.0},\n  {\"id\":728254,\"suggestedTranslation\":\"Có nghĩa lý gì chứ.\",\"rating\":9.0},\n  {\"id\":728255,\"suggestedTranslation\":\"Tôi muốn dùng cái đó sau bạn. Ý tôi là nếu bạn không phiền.\",\"rating\":9.0},\n  {\"id\":728256,\"suggestedTranslation\":\"Chẳng có gì ở đây để tôi chải chuốt cả...\",\"rating\":9.0},\n  {\"id\":728257,\"suggestedTranslation\":\"Có lẽ đợi khi bộ lông của nó mọc ra đã.\",\"rating\":9.0},\n  {\"id\":728258,\"suggestedTranslation\":\"Đã sạc đầy.\",\"rating\":9.0},\n  {\"id\":728259,\"suggestedTranslation\":\"Nó ngỏm rồi.\",\"rating\":9.0},\n  {\"id\":728260,\"suggestedTranslation\":\"Nó đã bị bắt đi quá sớm...\",\"rating\":9.0},\n  {\"id\":728261,\"suggestedTranslation\":\"Của tôi nhỏ quá...\",\"rating\":9.0},\n  {\"id\":728262,\"suggestedTranslation\":\"Không có gì xuất phát từ hư vô cả.\",\"rating\":9.0},\n  {\"id\":728263,\"suggestedTranslation\":\"Chẳng ai muốn chia sẻ với tôi cả.\",\"rating\":9.0},\n  {\"id\":728264,\"suggestedTranslation\":\"Tôi chẳng làm được việc gì nên hồn.\",\"rating\":9.0},\n  {\"id\":728265,\"suggestedTranslation\":\"Nó không nằm ở đó. Tôi hiểu cảm giác ấy mà.\",\"rating\":9.0},\n  {\"id\":728266,\"suggestedTranslation\":\"Có lẽ khi cuộc đời tôi bớt nguy hiểm hơn một chút.\",\"rating\":9.0},\n  {\"id\":728267,\"suggestedTranslation\":\"Ồ. Chưa ai từng dạy tôi nấu ăn cả.\",\"rating\":9.0},\n  {\"id\":728268,\"suggestedTranslation\":\"Bạn đang nấu gì thế...? Thơm quá...\",\"rating\":9.0},\n  {\"id\":728269,\"suggestedTranslation\":\"Nó... ở xa quá...\",\"rating\":9.0},\n  {\"id\":728270,\"suggestedTranslation\":\"Tôi không thể làm bẹp cái mũ tội nghiệp đó đâu.\",\"rating\":9.0},\n  {\"id\":728271,\"suggestedTranslation\":\"Tôi sẽ không làm phiền đâu.\",\"rating\":9.0},\n  {\"id\":728272,\"suggestedTranslation\":\"Vô ích thôi. Hết cứu nổi rồi.\",\"rating\":9.0},\n  {\"id\":728273,\"suggestedTranslation\":\"Nó cao quá.\",\"rating\":9.0},\n  {\"id\":728274,\"suggestedTranslation\":\"Nó trống không. Tôi sẽ thử lại sau.\",\"rating\":9.0},\n  {\"id\":728275,\"suggestedTranslation\":\"Mẹ đã cảnh báo tôi không được chạm vào nồi khi nó đang nấu mà.\",\"rating\":9.0},\n  {\"id\":728276,\"suggestedTranslation\":\"Có ai đó trong đó kìa.\",\"rating\":9.0},\n  {\"id\":728277,\"suggestedTranslation\":\"Bên trong nó không trống rỗng, không giống như tôi.\",\"rating\":9.0},\n  {\"id\":728278,\"suggestedTranslation\":\"Thất bại.\",\"rating\":9.0},\n  {\"id\":728279,\"suggestedTranslation\":\"Tôi vẽ đẹp hơn khi có mẫu tham khảo...\",\"rating\":9.0},\n  {\"id\":728280,\"suggestedTranslation\":\"Có lẽ nếu tôi muốn khu vườn của mình chết một cách chậm rãi và đau đớn...\",\"rating\":9.0},\n  {\"id\":728281,\"suggestedTranslation\":\"Tôi chẳng bắt được gì ngoài này với chiếc cần câu mỏng manh này đâu.\",\"rating\":9.0},\n  {\"id\":728282,\"suggestedTranslation\":\"Đó là kẻ song sinh xấu xa.\",\"rating\":9.0},\n  {\"id\":728283,\"suggestedTranslation\":\"Sao nó không hoạt động vậy, Abigail?\",\"rating\":9.0},\n  {\"id\":728284,\"suggestedTranslation\":\"Nó đang bận nên chẳng thèm để ý đến tôi...\",\"rating\":9.0},\n  {\"id\":728285,\"suggestedTranslation\":\"Nó chẳng có ý chí sống sót gì cả.\",\"rating\":9.0},\n  {\"id\":728286,\"suggestedTranslation\":\"Chúng đã bắt đầu mà không có tôi...\",\"rating\":9.0},\n  {\"id\":728287,\"suggestedTranslation\":\"Nó chưa hoàn thiện. Giống như tôi vậy.\",\"rating\":9.0},\n  {\"id\":728288,\"suggestedTranslation\":\"Đó không phải thứ nó muốn.\",\"rating\":9.0},\n  {\"id\":728289,\"suggestedTranslation\":\"Nơi chúng đến chẳng cần đến tài sản vật chất đâu.\",\"rating\":9.0},\n  {\"id\":728290,\"suggestedTranslation\":\"Ồ... thông tin của tôi vô dụng rồi...\",\"rating\":9.0},\n  {\"id\":728291,\"suggestedTranslation\":\"Nó vẫn chưa ăn vật hiến tế gần nhất của chúng ta...\",\"rating\":9.0},\n  {\"id\":728292,\"suggestedTranslation\":\"Không... Tôi không thể...\",\"rating\":9.0},\n  {\"id\":728293,\"suggestedTranslation\":\"Có những thứ nên nằm yên dưới suối vàng.\",\"rating\":9.0},\n  {\"id\":728294,\"suggestedTranslation\":\"Nó không cần thứ đó. Nó cần một khúc gỗ ma thuật.\",\"rating\":9.0},\n  {\"id\":728295,\"suggestedTranslation\":\"Nó không cần thứ đó. Nó cần một cây nấm.\",\"rating\":9.0},\n  {\"id\":728296,\"suggestedTranslation\":\"Chúng sẽ không sống nổi ở đây đâu.\",\"rating\":9.0},\n  {\"id\":728297,\"suggestedTranslation\":\"Tôi làm sai rồi... lại nữa...\",\"rating\":9.0},\n  {\"id\":728298,\"suggestedTranslation\":\"Tôi không thể... không phải ở trong này.\",\"rating\":9.0},\n  {\"id\":728299,\"suggestedTranslation\":\"Xin lỗi... Tôi không hiểu bạn đang định nói gì...\",\"rating\":9.0},\n  {\"id\":728300,\"suggestedTranslation\":\"Đó có lẽ không phải là cách tốt nhất...\",\"rating\":9.0},\n  {\"id\":728301,\"suggestedTranslation\":\"Tôi không nghĩ cái đó sẽ hoạt động ở đó đâu...\",\"rating\":9.0},\n  {\"id\":728302,\"suggestedTranslation\":\"Tôi nghĩ cái đó... sai rồi...\",\"rating\":9.0},\n  {\"id\":728303,\"suggestedTranslation\":\"Đó không phải là thứ đúng đắn...\",\"rating\":9.0},\n  {\"id\":728304,\"suggestedTranslation\":\"Nguy hiểm cận kề. Không có thời gian để chơi đùa đâu.\",\"rating\":9.0},\n  {\"id\":728305,\"suggestedTranslation\":\"Giúp tôi dọn dẹp đi, Abigail.\",\"rating\":9.0},\n  {\"id\":728306,\"suggestedTranslation\":\"Đã quá muộn để chơi trò chơi rồi.\",\"rating\":9.0},\n  {\"id\":728307,\"suggestedTranslation\":\"Cô ấy không có thời gian cho một kẻ như tôi đâu.\",\"rating\":9.0},\n  {\"id\":728308,\"suggestedTranslation\":\"Để lúc khác đi. Nó đang tận hưởng cái chết tạm thời ngay lúc này...\",\"rating\":9.0},\n  {\"id\":728309,\"suggestedTranslation\":\"Chẳng còn chỗ nữa...\",\"rating\":9.0},\n  {\"id\":728310,\"suggestedTranslation\":\"Tôi có cảm giác con nhện sẽ làm nhàu nát hết nó trong túi tôi mất.\",\"rating\":9.0},\n  {\"id\":728311,\"suggestedTranslation\":\"Tôi đoán nó cần thêm thời gian để hồi phục sau tất cả những gì đã trải qua.\",\"rating\":9.0},\n  {\"id\":728312,\"suggestedTranslation\":\"Nó đã từ chối gói quà của tôi...\",\"rating\":9.0},\n  {\"id\":728313,\"suggestedTranslation\":\"Tôi làm sai rồi... lại nữa...\",\"rating\":9.0},\n  {\"id\":728314,\"suggestedTranslation\":\"Những chiếc xương này được lắp ráp một cách kỳ quái...\",\"rating\":9.0},\n  {\"id\":728315,\"suggestedTranslation\":\"Ồ... Tôi biết bạn đang bận...\",\"rating\":9.0},\n  {\"id\":728316,\"suggestedTranslation\":\"Nơi chúng đến chẳng cần đến tài sản vật chất đâu.\",\"rating\":9.0},\n  {\"id\":728317,\"suggestedTranslation\":\"Chúng đã quá gánh nặng bởi thế giới này rồi...\",\"rating\":9.0},\n  {\"id\":728318,\"suggestedTranslation\":\"Trông chúng bình yên quá... Tôi sẽ quay lại sau vậy.\",\"rating\":9.0},\n  {\"id\":728319,\"suggestedTranslation\":\"Ồ... Tôi biết bạn đang bận...\",\"rating\":9.0},\n  {\"id\":728320,\"suggestedTranslation\":\"Nơi chúng đến chẳng cần đến tài sản vật chất đâu.\",\"rating\":9.0},\n  {\"id\":728321,\"suggestedTranslation\":\"Chúng đã quá gánh nặng bởi thế giới này rồi...\",\"rating\":9.0},\n  {\"id\":728322,\"suggestedTranslation\":\"Trông chúng bình yên quá... Tôi sẽ quay lại sau vậy.\",\"rating\":9.0},\n  {\"id\":728323,\"suggestedTranslation\":\"Ồ... thông tin của tôi vô dụng rồi...\",\"rating\":9.0},\n  {\"id\":728324,\"suggestedTranslation\":\"Nó chẳng thèm đếm xỉa gì đến tôi đâu...\",\"rating\":9.0},\n  {\"id\":728325,\"suggestedTranslation\":\"Hãy để lũ người cá trì hoãn điều không thể tránh khỏi đi.\",\"rating\":9.0},\n  {\"id\":728326,\"suggestedTranslation\":\"Chúng là bạn của Webber, không phải bạn của tôi.\",\"rating\":9.0},\n  {\"id\":728327,\"suggestedTranslation\":\"Bò lai của tôi chỉ có thể rời đi khi tôi muốn.\",\"rating\":9.0},\n  {\"id\":728328,\"suggestedTranslation\":\"Tôi không nghĩ mình có thể xoay sở được khi chúng đang ở tâm trạng này.\",\"rating\":9.0}\n]",
