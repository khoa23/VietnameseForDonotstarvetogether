            "text": "[\n  {\"id\":726529,\"suggestedTranslation\":\"Chúng ta bắt nó được đấy!\",\"rating\":9.0},\n  {\"id\":726530,\"suggestedTranslation\":\"Hửm? Bạn cần gì ở chúng tôi à?\",\"rating\":9.0},\n  {\"id\":726531,\"suggestedTranslation\":\"Đừng lo, các bạn sẽ sớm được đoàn tụ thôi.\",\"rating\":9.0},\n  {\"id\":726532,\"suggestedTranslation\":\"Lại được ở bên nhau rồi!\",\"rating\":9.0},\n  {\"id\":726533,\"suggestedTranslation\":\"Chúng tôi nghĩ nó báo hiệu chúng ta đang đến gần hơn.\",\"rating\":9.0},\n  {\"id\":726534,\"suggestedTranslation\":\"Nó muốn về nhà.\",\"rating\":9.0},\n  {\"id\":726535,\"suggestedTranslation\":\"Nó không nói chuyện được như chúng ta, nhưng nó là bạn.\",\"rating\":9.0},\n  {\"id\":726536,\"suggestedTranslation\":\"Nó muốn được về với những người khác.\",\"rating\":9.0},\n  {\"id\":726537,\"suggestedTranslation\":\"Nó không muốn ở đây. Chúng ta cũng vậy.\",\"rating\":9.0},\n  {\"id\":726538,\"suggestedTranslation\":\"Có gì ở trong đó nhỉ?\",\"rating\":9.0},\n  {\"id\":726539,\"suggestedTranslation\":\"Ồ không, có ai đó bị kẹt trong hòn đá tảng kia kìa!\",\"rating\":9.0},\n  {\"id\":726540,\"suggestedTranslation\":\"Ồ không, có ai đó bị kẹt trong hòn đá tảng kia kìa!\",\"rating\":9.0},\n  {\"id\":726541,\"suggestedTranslation\":\"Ồ không, có ai đó bị kẹt trong hòn đá tảng kia kìa!\",\"rating\":9.0},\n  {\"id\":726542,\"suggestedTranslation\":\"Nó muốn đến một trong những khe nứt trên mặt đất đó.\",\"rating\":9.0},\n  {\"id\":726543,\"suggestedTranslation\":\"Nó cô đơn lắm, nó muốn có bạn bè.\",\"rating\":9.0},\n  {\"id\":726544,\"suggestedTranslation\":\"Trông nó kỳ lạ thật.\",\"rating\":9.0},\n  {\"id\":726545,\"suggestedTranslation\":\"Bọn mình không chắc về cái này lắm...\",\"rating\":9.0},\n  {\"id\":726546,\"suggestedTranslation\":\"Phải xây dựng nhiều thứ quá, chúng ta đi chơi thay vì thế được không?\",\"rating\":9.0},\n  {\"id\":726547,\"suggestedTranslation\":\"Sắp xong rồi đấy!\",\"rating\":9.0},\n  {\"id\":726548,\"suggestedTranslation\":\"Trông khá ấn tượng đấy... dù nó là cái gì đi nữa!\",\"rating\":9.0},\n  {\"id\":726549,\"suggestedTranslation\":\"Nó đang cố nói chuyện đấy, bọn mình nghĩ vậy!\",\"rating\":9.0},\n  {\"id\":726550,\"suggestedTranslation\":\"Đừng dẫm lên vết nứt nhé!\",\"rating\":9.0},\n  {\"id\":726551,\"suggestedTranslation\":\"Úi chà! Sao chúng ta không nghĩ ra nhỉ?\",\"rating\":9.0},\n  {\"id\":726552,\"suggestedTranslation\":\"Mong là cây cối không cảm thấy đau đớn.\",\"rating\":9.0},\n  {\"id\":726553,\"suggestedTranslation\":\"Nó chết rồi.\",\"rating\":9.0},\n  {\"id\":726554,\"suggestedTranslation\":\"Xin lỗi nhé, cây ơi.\",\"rating\":9.0},\n  {\"id\":726555,\"suggestedTranslation\":\"Cái cây xinh xắn làm sao!\",\"rating\":9.0},\n  {\"id\":726556,\"suggestedTranslation\":\"Bọn mình thích bông hoa này!\",\"rating\":9.0},\n  {\"id\":726557,\"suggestedTranslation\":\"Có phải chúng ta vừa hái chúng không nhỉ?\",\"rating\":9.0},\n  {\"id\":726558,\"suggestedTranslation\":\"Trông ả không vui chút nào khi thấy chúng ta.\",\"rating\":9.0},\n  {\"id\":726559,\"suggestedTranslation\":\"Chắc làm được một bữa sáng khổng lồ đấy!\",\"rating\":9.0},\n  {\"id\":726560,\"suggestedTranslation\":\"Cho mấy đứa bé đi ngủ mà.\",\"rating\":9.0},\n  {\"id\":726561,\"suggestedTranslation\":\"Chúng mình rất thích lúc Warly nấu ăn cho bọn mình.\",\"rating\":9.0},\n  {\"id\":726562,\"suggestedTranslation\":\"Biến đi!\",\"rating\":9.0},\n  {\"id\":726563,\"suggestedTranslation\":\"Chúng ta nên đập bẹp ngóm ngươi đi thôi.\",\"rating\":9.0},\n  {\"id\":726564,\"suggestedTranslation\":\"Trông vừa kinh vừa ngon là thế nào nhỉ.\",\"rating\":9.0},\n  {\"id\":726565,\"suggestedTranslation\":\"Nó sẽ giúp mấy cái cây nhỏ lớn nhanh và khỏe mạnh!\",\"rating\":9.0},\n  {\"id\":726566,\"suggestedTranslation\":\"Bọn mình chỉ mừng là nó không dành cho mình.\",\"rating\":9.0},\n  {\"id\":726567,\"suggestedTranslation\":\"Bọn mình giữ nó lại được không?\",\"rating\":9.0},\n  {\"id\":726568,\"suggestedTranslation\":\"Liệu chúng ta có thể cho máu vào lại bên trong không nhỉ?\",\"rating\":9.0},\n  {\"id\":726569,\"suggestedTranslation\":\"Mấy đứa nhỏ đang đói bụng kìa.\",\"rating\":9.0},\n  {\"id\":726570,\"suggestedTranslation\":\"Có lẽ thế hơi quá đáng nhỉ.\",\"rating\":9.0},\n  {\"id\":726571,\"suggestedTranslation\":\"Trực giác tìm đồ loot của chúng ta đang nổi lên rồi kìa.\",\"rating\":9.0},\n  {\"id\":726572,\"suggestedTranslation\":\"Làm ấm người chúng ta lên ngay lập tức!\",\"rating\":9.0},\n  {\"id\":726573,\"suggestedTranslation\":\"Nó đẹp... đẹp đến đáng sợ!\",\"rating\":9.0},\n  {\"id\":726574,\"suggestedTranslation\":\"Trời ơi. Lấp lánh quá đi!\",\"rating\":9.0},\n  {\"id\":726575,\"suggestedTranslation\":\"Kiêm luôn hai nhiệm vụ.\",\"rating\":9.0},\n  {\"id\":726576,\"suggestedTranslation\":\"Đúng là một anh chàng vui tính.\",\"rating\":9.0},\n  {\"id\":726577,\"suggestedTranslation\":\"Nấm phát nổ!\",\"rating\":9.0},\n  {\"id\":726578,\"suggestedTranslation\":\"Đúng là cái mũ trùm nấm!\",\"rating\":9.0},\n  {\"id\":726579,\"suggestedTranslation\":\"Lẽ ra bọn mình nên chặt nó đi mới phải!\",\"rating\":9.0},\n  {\"id\":726580,\"suggestedTranslation\":\"Tớ nghĩ nó đang làm chuyện xấu đấy!\",\"rating\":9.0},\n  {\"id\":726581,\"suggestedTranslation\":\"Lửa rất nguy hiểm, chắc là vậy.\",\"rating\":9.0},\n  {\"id\":726582,\"suggestedTranslation\":\"Chẳng có cây nấm nào cả.\",\"rating\":9.0},\n  {\"id\":726583,\"suggestedTranslation\":\"Trông chúng có vẻ hạnh phúc.\",\"rating\":9.0},\n  {\"id\":726584,\"suggestedTranslation\":\"Trông ghê tởm làm sao.\",\"rating\":9.0},\n  {\"id\":726585,\"suggestedTranslation\":\"Trông các bạn có vẻ lạnh lẽo nhỉ.\",\"rating\":9.0},\n  {\"id\":726586,\"suggestedTranslation\":\"Ôi, chúng bé xíu luôn kìa.\",\"rating\":9.0},\n  {\"id\":726587,\"suggestedTranslation\":\"Chà! Nhiều nấm quá!\",\"rating\":9.0},\n  {\"id\":726588,\"suggestedTranslation\":\"Chà, đúng là chẳng nấm-vui chút nào.\",\"rating\":9.0},\n  {\"id\":726589,\"suggestedTranslation\":\"Nó vẫn cần được bật lên kìa.\",\"rating\":9.0},\n  {\"id\":726590,\"suggestedTranslation\":\"Nó đang tỏa ra một ánh sáng dễ chịu.\",\"rating\":9.0},\n  {\"id\":726591,\"suggestedTranslation\":\"Ồ. Bọn mình bắt đầu thấy có thiện cảm với nó rồi đấy.\",\"rating\":9.0},\n  {\"id\":726592,\"suggestedTranslation\":\"Có lẽ màn đêm sẽ bớt đáng sợ hơn một chút rồi.\",\"rating\":9.0},\n  {\"id\":726593,\"suggestedTranslation\":\"Chúng tôi yêu tất cả các màu sắc này!\",\"rating\":9.0},\n  {\"id\":726594,\"suggestedTranslation\":\"Ngửi kỳ cục ghê.\",\"rating\":9.0},\n  {\"id\":726595,\"suggestedTranslation\":\"Hahah! Chà, thối kinh khủng luôn!\",\"rating\":9.0},\n  {\"id\":726596,\"suggestedTranslation\":\"To một cách khó chịu luôn đấy.\",\"rating\":9.0},\n  {\"id\":726597,\"suggestedTranslation\":\"Nó vừa to vừa kỳ dị!\",\"rating\":9.0},\n  {\"id\":726598,\"suggestedTranslation\":\"Ngửi kỳ cục ghê.\",\"rating\":9.0},\n  {\"id\":726599,\"suggestedTranslation\":\"Giờ thì nó tròn xoe và mềm oặt luôn rồi!\",\"rating\":9.0},\n  {\"id\":726600,\"suggestedTranslation\":\"To hơn một cây nấm bình thường.\",\"rating\":9.0},\n  {\"id\":726601,\"suggestedTranslation\":\"Ngửi kỳ cục ghê.\",\"rating\":9.0},\n  {\"id\":726602,\"suggestedTranslation\":\"Nghe vui tai phết!\",\"rating\":9.0},\n  {\"id\":726603,\"suggestedTranslation\":\"Sao nó lại to thế nhỉ?\",\"rating\":9.0},\n  {\"id\":726604,\"suggestedTranslation\":\"Ngửi kỳ cục ghê.\",\"rating\":9.0},\n  {\"id\":726605,\"suggestedTranslation\":\"Cái này trông thân thiện phết!\",\"rating\":9.0},\n  {\"id\":726606,\"suggestedTranslation\":\"Nó còn đáng sợ hơn trước nữa!\",\"rating\":9.0},\n  {\"id\":726607,\"suggestedTranslation\":\"Xin chào, chú chim kỳ lạ!\",\"rating\":9.0},\n  {\"id\":726608,\"suggestedTranslation\":\"Làm bọn mình hơi thèm ăn rồi đấy.\",\"rating\":9.0},\n  {\"id\":726609,\"suggestedTranslation\":\"Ngươi muốn gì hả?\",\"rating\":9.0},\n  {\"id\":726610,\"suggestedTranslation\":\"Ái! Bọn mình xin lỗi mà!\",\"rating\":9.0},\n  {\"id\":726611,\"suggestedTranslation\":\"Nó ngỏm rồi!\",\"rating\":9.0},\n  {\"id\":726612,\"suggestedTranslation\":\"Ồ! Sao cậu lại lột được lớp da bên ngoài thế?\",\"rating\":9.0},\n  {\"id\":726613,\"suggestedTranslation\":\"Ngủ ngon nhé, cún con gớm ghiếc.\",\"rating\":9.0},\n  {\"id\":726614,\"suggestedTranslation\":\"Đấy không phải là một chú cún ngoan đâu!\",\"rating\":9.0},\n  {\"id\":726615,\"suggestedTranslation\":\"Nó ngỏm rồi!\",\"rating\":9.0},\n  {\"id\":726616,\"suggestedTranslation\":\"Nó còn quái dị hơn cả bọn mình nữa!\",\"rating\":9.0},\n  {\"id\":726617,\"suggestedTranslation\":\"Bọn mình không muốn đến gần đâu.\",\"rating\":9.0},\n  {\"id\":726618,\"suggestedTranslation\":\"Ai muốn ăn bánh quy nào?\",\"rating\":9.0},\n  {\"id\":726619,\"suggestedTranslation\":\"Trông ngon miệng phết nhỉ?\",\"rating\":9.0},\n  {\"id\":726620,\"suggestedTranslation\":\"Công thức này do chính tay bọn mình nghĩ ra đấy!\",\"rating\":9.0},\n  {\"id\":726621,\"suggestedTranslation\":\"Bọn mình làm chiếc bánh quy này đặc biệt lắm đấy!\",\"rating\":9.0},\n  {\"id\":726622,\"suggestedTranslation\":\"Bọn mình làm cho nó trông y hệt bạn của chúng ta luôn!\",\"rating\":9.0},\n  {\"id\":726623,\"suggestedTranslation\":\"Bọn mình biết chắc là chúng sẽ thích cho mà xem!\",\"rating\":9.0},\n  {\"id\":726624,\"suggestedTranslation\":\"Cái này làm ra thành công phết đấy!\",\"rating\":9.0},\n  {\"id\":726625,\"suggestedTranslation\":\"Hoa lúc nào cũng đẹp cả.\",\"rating\":9.0},\n  {\"id\":726626,\"suggestedTranslation\":\"Bố hay đội một chiếc mũ ngủ y hệt như thế.\",\"rating\":9.0},\n  {\"id\":726627,\"suggestedTranslation\":\"Nó khiến da gà da vịt chúng ta nổi cả lên.\",\"rating\":9.0},\n  {\"id\":726628,\"suggestedTranslation\":\"Vừa lạnh vừa trơn tuột.\",\"rating\":9.0},\n  {\"id\":726629,\"suggestedTranslation\":\"Ưm... tụi mình không nghĩ là mặt đất trước kia lại như thế này đâu.\",\"rating\":9.0},\n  {\"id\":726630,\"suggestedTranslation\":\"Không hẳn là loại đèn ngủ ưa thích của mình rồi.\",\"rating\":9.0},\n  {\"id\":726631,\"suggestedTranslation\":\"Hơi đáng sợ một chút, nhưng mà ngon.\",\"rating\":9.0},\n  {\"id\":726632,\"suggestedTranslation\":\"Mọi thứ đều ổn cả.\",\"rating\":9.0},\n  {\"id\":726633,\"suggestedTranslation\":\"Trở lại với chúng tôi đi, ban ngày!\",\"rating\":9.0},\n  {\"id\":726634,\"suggestedTranslation\":\"Ở đây không có nhiều ma thuật lắm.\",\"rating\":9.0},\n  {\"id\":726635,\"suggestedTranslation\":\"Ổn định, tạm thời là thế.\",\"rating\":9.0},\n  {\"id\":726636,\"suggestedTranslation\":\"Ma thuật trôi tuột xuống hố rồi.\",\"rating\":9.0},\n  {\"id\":726637,\"suggestedTranslation\":\"Có điềm gì sắp xảy ra kìa.\",\"rating\":9.0},\n  {\"id\":726638,\"suggestedTranslation\":\"Nó đang ngập tràn ma thuật hơn đấy!\",\"rating\":9.0},\n  {\"id\":726639,\"suggestedTranslation\":\"Đèn chong đêm ơi, sáng rực rỡ nhé!\",\"rating\":9.0},\n  {\"id\":726640,\"suggestedTranslation\":\"Cậu cũng nhìn thấy cái này chứ?\",\"rating\":9.0},\n  {\"id\":726641,\"suggestedTranslation\":\"Bọn mình phải làm gì với cái này đây?\",\"rating\":9.0},\n  {\"id\":726642,\"suggestedTranslation\":\"Đó là một đống đá tảng lớn!\",\"rating\":9.0},\n  {\"id\":726643,\"suggestedTranslation\":\"Nó giúp những ngón tay nhện của chúng ta bám dính cực tốt!\",\"rating\":9.0},\n  {\"id\":726644,\"suggestedTranslation\":\"Bọn mình sẽ rắc nó khắp nơi để không ai bị trượt ngã nữa!\",\"rating\":9.0},\n  {\"id\":726645,\"suggestedTranslation\":\"Nó cho chúng ta biết đất tốt thế nào, và cả khối thứ khác nữa!\",\"rating\":9.0},\n  {\"id\":726646,\"suggestedTranslation\":\"Nhiều chân hơn nghĩa là chèo thuyền nhanh hơn!\",\"rating\":9.0},\n  {\"id\":726647,\"suggestedTranslation\":\"Chèo thuyền cũng vui phết chứ bộ!\",\"rating\":9.0},\n  {\"id\":726648,\"suggestedTranslation\":\"Làm ơn đừng đè bẹp bọn mình nhé!\",\"rating\":9.0},\n  {\"id\":726649,\"suggestedTranslation\":\"Chúng ta có thể làm bánh bùn đấy!\",\"rating\":9.0},\n  {\"