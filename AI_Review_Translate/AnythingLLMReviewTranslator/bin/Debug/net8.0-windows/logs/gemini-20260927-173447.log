,\n  {\"id\":726709,\"suggestedTranslation\":\"Chúng ta có thể lấy thêm mà!\",\"rating\":9.0},\n  {\"id\":726710,\"suggestedTranslation\":\"Bọn mình cần luyện tập thêm nữa.\",\"rating\":9.0},\n  {\"id\":726711,\"suggestedTranslation\":\"Nó làm tất cả chúng tôi cay xè cả mắt!\",\"rating\":9.0},\n  {\"id\":726712,\"suggestedTranslation\":\"Mắt chúng ta hết chảy nước rồi nè.\",\"rating\":9.0},\n  {\"id\":726713,\"suggestedTranslation\":\"Nó làm tất cả chúng tôi chảy nước mắt luôn!\",\"rating\":9.0},\n  {\"id\":726714,\"suggestedTranslation\":\"Chúng ta có thể tìm xem chúng là gì bằng cách trồng chúng xuống đất.\",\"rating\":9.0},\n  {\"id\":726715,\"suggestedTranslation\":\"Chúng tôi thấy tám triệu con mắt đang phản chiếu lại. Tuyệt thật đấy!\",\"rating\":9.0},\n  {\"id\":726716,\"suggestedTranslation\":\"Phù. Phải cẩn thận hướng nó đi đâu đấy nhé!\",\"rating\":9.0},\n  {\"id\":726717,\"suggestedTranslation\":\"Nhiều chân thì việc nhẹ nhàng hơn, cái này cũng vậy.\",\"rating\":9.0},\n  {\"id\":726718,\"suggestedTranslation\":\"Viên ngọc ơi, cậu có vui vì chúng ta tìm thấy cậu không nè?\",\"rating\":9.0},\n  {\"id\":726719,\"suggestedTranslation\":\"Hòn đá tảng này giúp tôi tìm thấy bạn bè của mình!\",\"rating\":9.0},\n  {\"id\":726720,\"suggestedTranslation\":\"Dịch chuyển tức thời cho chúng ta cơ hội để cho tất cả các chân được nghỉ ngơi.\",\"rating\":9.0},\n  {\"id\":726721,\"suggestedTranslation\":\"Này, đừng có động vào đồ của bọn tôi!\",\"rating\":9.0},\n  {\"id\":726722,\"suggestedTranslation\":\"Bọn mình chẳng thấy gì cả.\",\"rating\":9.0},\n  {\"id\":726723,\"suggestedTranslation\":\"Bọn mình thấy có quà vặt bên trong kìa!\",\"rating\":9.0},\n  {\"id\":726724,\"suggestedTranslation\":\"Bọn mình gặp rắc rối to rồi.\",\"rating\":9.0},\n  {\"id\":726725,\"suggestedTranslation\":\"Trông khó trèo quá.\",\"rating\":9.0},\n  {\"id\":726726,\"suggestedTranslation\":\"Nó vẫn chưa lớn lên được.\",\"rating\":9.0},\n  {\"id\":726727,\"suggestedTranslation\":\"Liệu chúng ta có thể dùng nó làm đồ thủ công mỹ nghệ không nhỉ?\",\"rating\":9.0},\n  {\"id\":726728,\"suggestedTranslation\":\"Ôi, một cây con kìa!\",\"rating\":9.0},\n  {\"id\":726729,\"suggestedTranslation\":\"Đồ đựng thời trang ghê.\",\"rating\":9.0},\n  {\"id\":726730,\"suggestedTranslation\":\"Chắc chắn đây không phải bánh trái cây trá hình chứ?\",\"rating\":9.0},\n  {\"id\":726731,\"suggestedTranslation\":\"Một nhạc cụ được chế tạo rất tốt.\",\"rating\":9.0},\n  {\"id\":726732,\"suggestedTranslation\":\"Chúng ta có thể làm bài tập về nhà rồi.\",\"rating\":9.0},\n  {\"id\":726733,\"suggestedTranslation\":\"Bọn mình thích bất cứ thứ gì có đường!\",\"rating\":9.0},\n  {\"id\":726734,\"suggestedTranslation\":\"Các cậu không muốn làm bạn côn trùng với bọn mình sao?\",\"rating\":9.0},\n  {\"id\":726735,\"suggestedTranslation\":\"Phần thời gian còn lại trong năm chúng sống ở đâu nhỉ?\",\"rating\":9.0},\n  {\"id\":726736,\"suggestedTranslation\":\"Măm măm.\",\"rating\":9.0},\n  {\"id\":726737,\"suggestedTranslation\":\"Nó chết rồi, tụi mình nghĩ vậy?\",\"rating\":9.0},\n  {\"id\":726738,\"suggestedTranslation\":\"Bọn mình không hiểu nổi!\",\"rating\":9.0},\n  {\"id\":726739,\"suggestedTranslation\":\"Nó mới nhỏ và đáng yêu làm sao!\",\"rating\":9.0},\n  {\"id\":726740,\"suggestedTranslation\":\"No căng bụng đến mức sắp nổ tung luôn rồi!\",\"rating\":9.0},\n  {\"id\":726741,\"suggestedTranslation\":\"Tớ cá là nó cay đấy.\",\"rating\":9.0},\n  {\"id\":726742,\"suggestedTranslation\":\"Trông có vẻ cay phết đấy.\",\"rating\":9.0},\n  {\"id\":726743,\"suggestedTranslation\":\"Trồng những thứ này xuống rồi xem cây gì mọc lên nào.\",\"rating\":9.0},\n  {\"id\":726744,\"suggestedTranslation\":\"Quay lại đây mau! Tớ chỉ muốn ăn cậu thôi mà!\",\"rating\":9.0},\n  {\"id\":726745,\"suggestedTranslation\":\"To quá đi mất!!\",\"rating\":9.0},\n  {\"id\":726746,\"suggestedTranslation\":\"Lửa đã thiêu rụi nó rồi.\",\"rating\":9.0},\n  {\"id\":726747,\"suggestedTranslation\":\"Cái vại trống không.\",\"rating\":9.0},\n  {\"id\":726748,\"suggestedTranslation\":\"Bọn mình muốn tặng nó thứ gì đó!\",\"rating\":9.0},\n  {\"id\":726749,\"suggestedTranslation\":\"Trông nó không giống bánh nếp cho lắm...\",\"rating\":9.0},\n  {\"id\":726750,\"suggestedTranslation\":\"Sặc sỡ làm sao.\",\"rating\":9.0},\n  {\"id\":726751,\"suggestedTranslation\":\"Có phải chúng ta vừa hái chúng không nhỉ?\",\"rating\":9.0},\n  {\"id\":726752,\"suggestedTranslation\":\"Chúng làm đầu bọn mình nhức hết cả lên.\",\"rating\":9.0},\n  {\"id\":726753,\"suggestedTranslation\":\"Có phải chúng ta vừa hái chúng không nhỉ?\",\"rating\":9.0},\n  {\"id\":726754,\"suggestedTranslation\":\"Toàn là đá chứ chẳng có tí vỏ cây nào cả.\",\"rating\":9.0},\n  {\"id\":726755,\"suggestedTranslation\":\"Đúng là một bãi nước mũi!\",\"rating\":9.0},\n  {\"id\":726756,\"suggestedTranslation\":\"Chúng ta có thể nghe cái đó mãi mãi luôn.\",\"rating\":9.0},\n  {\"id\":726757,\"suggestedTranslation\":\"Cục đá này sẽ thuộc về chúng ta!\",\"rating\":9.0},\n  {\"id\":726758,\"suggestedTranslation\":\"Bọn tao đến đây, tụi cục đá!\",\"rating\":9.0},\n  {\"id\":726759,\"suggestedTranslation\":\"Trông có vẻ ngon đấy nhưng mà... cá muối chua á?\",\"rating\":9.0},\n  {\"id\":726760,\"suggestedTranslation\":\"Hình xăm ngầu đấy!\",\"rating\":9.0},\n  {\"id\":726761,\"suggestedTranslation\":\"Úi chà! Ổng đang nổi giận kìa.\",\"rating\":9.0},\n  {\"id\":726762,\"suggestedTranslation\":\"Để bọn tôi yên đi!\",\"rating\":9.0},\n  {\"id\":726763,\"suggestedTranslation\":\"Ước gì ổng đừng đánh bọn mình nhiều thế.\",\"rating\":9.0},\n  {\"id\":726764,\"suggestedTranslation\":\"Hình xăm ngầu đấy!\",\"rating\":9.0},\n  {\"id\":726765,\"suggestedTranslation\":\"Úi chà! Ổng đang nổi giận kìa.\",\"rating\":9.0},\n  {\"id\":726766,\"suggestedTranslation\":\"Để bọn tôi yên đi!\",\"rating\":9.0},\n  {\"id\":726767,\"suggestedTranslation\":\"Ước gì ổng đừng đánh bọn mình nhiều thế.\",\"rating\":9.0},\n  {\"id\":726768,\"suggestedTranslation\":\"Bọn mình không muốn dây dưa với kẻ đó đâu.\",\"rating\":9.0},\n  {\"id\":726769,\"suggestedTranslation\":\"Nó đựng được nhiều đồ phết đấy!\",\"rating\":9.0},\n  {\"id\":726770,\"suggestedTranslation\":\"Kinh quá.\",\"rating\":9.0},\n  {\"id\":726771,\"suggestedTranslation\":\"Bọn mình chỉ muốn làm bạn thôi mà.\",\"rating\":9.0},\n  {\"id\":726772,\"suggestedTranslation\":\"Hết chảnh chọe được nữa chưa, heo ơi!\",\"rating\":9.0},\n  {\"id\":726773,\"suggestedTranslation\":\"Tớ nhìn thấy một con heo qua khung cửa sổ kìa!\",\"rating\":9.0},\n  {\"id\":726774,\"suggestedTranslation\":\"Một ngôi nhà cao gầy dành cho một chú heo lùn tịt.\",\"rating\":9.0},\n  {\"id\":726775,\"suggestedTranslation\":\"Sao họ lại ghét tôi cơ chứ?\",\"rating\":9.0},\n  {\"id\":726776,\"suggestedTranslation\":\"Vua của bọn chuyên bắt nạt!\",\"rating\":9.0},\n  {\"id\":726777,\"suggestedTranslation\":\"Hắn sẽ không dám bắt nạt chúng ta nữa đâu.\",\"rating\":9.0},\n  {\"id\":726778,\"suggestedTranslation\":\"Tớ chưa bao giờ nghĩ chúng ta lại có thể làm bạn đấy!\",\"rating\":9.0},\n  {\"id\":726779,\"suggestedTranslation\":\"Ôi, cậu chán ngắt chẳng có gì vui cả.\",\"rating\":9.0},\n  {\"id\":726780,\"suggestedTranslation\":\"Trông họ có vẻ tức giận kìa.\",\"rating\":9.0},\n  {\"id\":726781,\"suggestedTranslation\":\"Giờ thì hắn mọc đầy lông lá luôn rồi!\",\"rating\":9.0},\n  {\"id\":726782,\"suggestedTranslation\":\"Ôi... tiếc thật đấy.\",\"rating\":9.0},\n  {\"id\":726783,\"suggestedTranslation\":\"Chúng ta nên kiếm ít thịt cúng cho nó thôi.\",\"rating\":9.0},\n  {\"id\":726784,\"suggestedTranslation\":\"Bọn mình có thể chế tạo mấy thứ vui phết rồi đây!\",\"rating\":9.0},\n  {\"id\":726785,\"suggestedTranslation\":\"Nhận lấy này!\",\"rating\":9.0},\n  {\"id\":726786,\"suggestedTranslation\":\"Heo con ơi heo con, cho tôi vào với!\",\"rating\":9.0},\n  {\"id\":726787,\"suggestedTranslation\":\"Giá mà bọn mình đến gần hơn được chút nữa.\",\"rating\":9.0},\n  {\"id\":726788,\"suggestedTranslation\":\"Chà! Chúng ta có một người bạn heo chính hiệu luôn kìa!\",\"rating\":9.0},\n  {\"id\":726789,\"suggestedTranslation\":\"Tuyệt ghê! Vua Lợn chắc sẽ thích cái này đấy.\",\"rating\":9.0},\n  {\"id\":726790,\"suggestedTranslation\":\"Nó đang tràn đầy sức sống kìa.\",\"rating\":9.0},\n  {\"id\":726791,\"suggestedTranslation\":\"Lớn lên nào, lớn nhanh lên!\",\"rating\":9.0},\n  {\"id\":726792,\"suggestedTranslation\":\"Đó là một lá cờ hải tặc!\",\"rating\":9.0},\n  {\"id\":726793,\"suggestedTranslation\":\"Bọn mình tìm thấy kho báu rồi!\",\"rating\":9.0},\n  {\"id\":726794,\"suggestedTranslation\":\"Một công cụ tuyệt vời để nghịch đất cát.\",\"rating\":9.0},\n  {\"id\":726795,\"suggestedTranslation\":\"Nó mềm oặt luôn.\",\"rating\":9.0},\n  {\"id\":726796,\"suggestedTranslation\":\"Ngửi có vẻ hơi thối rồi đấy.\",\"rating\":9.0},\n  {\"id\":726797,\"suggestedTranslation\":\"Nó đang dạy chúng ta rất nhiều điều về thực vật đấy!\",\"rating\":9.0},\n  {\"id\":726798,\"suggestedTranslation\":\"Không biết bao giờ mới ra hoa nhỉ?\",\"rating\":9.0},\n  {\"id\":726799,\"suggestedTranslation\":\"Xong chưa thế nhỉ?\",\"rating\":9.0},\n  {\"id\":726800,\"suggestedTranslation\":\"Chúng ta đã cùng nhau vun trồng nó đấy!\",\"rating\":9.0},\n  {\"id\":726801,\"suggestedTranslation\":\"Nó khô đét và chết ngắc rồi.\",\"rating\":9.0},\n  {\"id\":726802,\"suggestedTranslation\":\"Đúng là một vở kịch hài hước!\",\"rating\":9.0},\n  {\"id\":726803,\"suggestedTranslation\":\"Nó có một cái kết có hậu không nhỉ?\",\"rating\":9.0},\n  {\"id\":726804,\"suggestedTranslation\":\"Nặng ghê cơ!\",\"rating\":9.0},\n  {\"id\":726805,\"suggestedTranslation\":\"Không đáng sợ đâu. Bọn mình sẽ không lấy tay che mắt lại đâu.\",\"rating\":9.0},\n  {\"id\":726806,\"suggestedTranslation\":\"%s trông có vẻ đểu cáng nhỉ.\",\"rating\":9.0},\n  {\"id\":726807,\"suggestedTranslation\":\"%s, cậu vừa châm lửa đấy à!\",\"rating\":9.0},\n  {\"id\":726808,\"suggestedTranslation\":\"Này! Chào %s nhé!\",\"rating\":9.0},\n  {\"id\":726809,\"suggestedTranslation\":\"Đừng lo, %s, tụi mình sẽ tìm trái tim cho cậu!\",\"rating\":9.0},\n  {\"id\":726810,\"suggestedTranslation\":\"Quá đáng vừa thôi! Xử hắn đi!\",\"rating\":9.0},\n  {\"id\":726811,\"suggestedTranslation\":\"%s đối xử cực kỳ tốt với lũ hồn ma luôn.\",\"rating\":9.0},\n  {\"id\":726812,\"suggestedTranslation\":\"Còn nhớ bọn mình chứ?\",\"rating\":9.0},\n  {\"id\":726813,\"suggestedTranslation\":\"Sẽ tự trở thành người bạn tốt nhất của chính mình!\",\"rating\":9.0},\n  {\"id\":726814,\"suggestedTranslation\":\"Có phải lá bài chúng ta vừa làm mất không nhỉ?\",\"rating\":9.0},\n  {\"id\":726815,\"suggestedTranslation\":\"Bọn mình chơi cùng đồ đạc của cô Wanda được chứ? Bọn mình sẽ cẩn thận mà!\",\"rating\":9.0},\n  {\"id\":726816,\"suggestedTranslation\":\"Liệu chúng ta có thay đổi điều gì nếu có thể quay ngược thời gian không?\",\"rating\":9.0},\n  {\"id\":726817,\"suggestedTranslation\":\"Nó đang nghỉ ngơi.\",\"rating\":9.0},\n  {\"id\":726818,\"suggestedTranslation\":\"Mấy mảnh đồng hồ nhỏ xíu.\",\"rating\":9.0},\n  {\"id\":726819,\"suggestedTranslation\":\"Liệu chúng ta có thay đổi điều gì nếu có thể quay ngược thời gian không?\",\"rating\":9.0},\n  {\"id\":726820,\"suggestedTranslation\":\"Nó đang nghỉ ngơi.\",\"rating\":9.0},\n  {\"id\":726821,\"suggestedTranslation\":\"Trông có vẻ hơi đáng sợ...\",\"rating\":9.0},\n  {\"id\":726822,\"suggestedTranslation\":\"Trông có vẻ hơi đáng sợ...\",\"rating\":9.0},\n  {\"id\":726823,\"suggestedTranslation\":\"Trông như một cú rơi dài thườn thượt.\",\"rating\":9.0},\n  {\"id\":726824,\"suggestedTranslation\":\"Liệu chúng ta có thay đổi điều gì nếu có thể quay ngược thời gian không?\",\"rating\":9.0},\n  {\"id\":726825,\"suggestedTranslation\":\"Nó đang nghỉ ngơi.\",\"rating\":9.0},\n  {\"id\":726826,\"suggestedTranslation\":\"Liệu chúng ta có thay đổi điều gì nếu có thể quay ngược thời gian không?\",\"rating\":9.0},\n  {\"id\":726827,\"suggestedTranslation\":\"Nó đang nghỉ ngơi.\",\"rat