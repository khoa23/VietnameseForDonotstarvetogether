g\": 9.0\n  },\n  {\n    \"id\": 726277,\n    \"suggestedTranslation\": \"Chúng ta không chắc lắm về món này...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726278,\n    \"suggestedTranslation\": \"Cái thứ đó từ đâu ra thế hả?!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726279,\n    \"suggestedTranslation\": \"Ôi, một cái cây nhỏ đang nổi giận kìa!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726280,\n    \"suggestedTranslation\": \"Cái thứ đó từ đâu ra thế hả?!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726281,\n    \"suggestedTranslation\": \"Nó rất thích ở dưới này.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726282,\n    \"suggestedTranslation\": \"Tớ ghét phải uống thuốc lắm!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726283,\n    \"suggestedTranslation\": \"Vừa sáng lại vừa ngon.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726284,\n    \"suggestedTranslation\": \"Ái chà đừng ngại chứ, tụi mình thân thiện lắm!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726285,\n    \"suggestedTranslation\": \"Nhẹ hơn cái gì cơ?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726286,\n    \"suggestedTranslation\": \"Chúng ta nghĩ nó có lẽ quá lớn để nhét vào lọ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726287,\n    \"suggestedTranslation\": \"Nó đang phát sáng kìa.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726288,\n    \"suggestedTranslation\": \"Bố tớ từng nuôi dê.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726289,\n    \"suggestedTranslation\": \"Thứ này có thể làm một vũ khí tốt đấy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726290,\n    \"suggestedTranslation\": \"Nó trông đang phát sáng kìa!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726291,\n    \"suggestedTranslation\": \"Thứ này có thể giúp chúng ta an toàn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726292,\n    \"suggestedTranslation\": \"Ánh mắt hắn đang hằn học kìa.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726293,\n    \"suggestedTranslation\"