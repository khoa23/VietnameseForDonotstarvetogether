            "text": "[\n  {\"id\":726829,\"suggestedTranslation\":\"Nó đang nghỉ ngơi.\",\"rating\":9.0},\n  {\"id\":726830,\"suggestedTranslation\":\"Chúng ta chưa từng biết đồng hồ lại nguy hiểm đến vậy.\",\"rating\":9.0},\n  {\"id\":726831,\"suggestedTranslation\":\"Tự hỏi con cá của chúng ta nặng bao nhiêu nhỉ!\",\"rating\":9.0},\n  {\"id\":726832,\"suggestedTranslation\":\"Yay! Chúng ta thích bánh quy!\",\"rating\":9.0},\n  {\"id\":726833,\"suggestedTranslation\":\"Cô ấy là bạn của chúng ta!\",\"rating\":9.0},\n  {\"id\":726834,\"suggestedTranslation\":\"Chúng ta là hải tặc Râu Nhện khét tiếng! Arr!\",\"rating\":9.0},\n  {\"id\":726835,\"suggestedTranslation\":\"Chúng ta không ngờ nó lại lớn được thế này.\",\"rating\":9.0},\n  {\"id\":726836,\"suggestedTranslation\":\"Nó rất tốt cho chúng ta!\",\"rating\":9.0},\n  {\"id\":726837,\"suggestedTranslation\":\"Chúng ta còn không thể vòng cả tay ôm hết nó nữa!\",\"rating\":9.0},\n  {\"id\":726838,\"suggestedTranslation\":\"Chúng ta có thể trồng thứ gì đó bằng mấy cái này.\",\"rating\":9.0},\n  {\"id\":726839,\"suggestedTranslation\":\"Nước không hợp với bộ lông của chúng ta lắm.\",\"rating\":9.0},\n  {\"id\":726840,\"suggestedTranslation\":\"Rắn nước ngọt đây.\",\"rating\":9.0},\n  {\"id\":726841,\"suggestedTranslation\":\"Nó có thể đem đi chiên được đấy.\",\"rating\":9.0},\n  {\"id\":726842,\"suggestedTranslation\":\"Chỉ là một loài thực vật dưới ao bình thường thôi.\",\"rating\":9.0},\n  {\"id\":726843,\"suggestedTranslation\":\"Phân củ chuối.\",\"rating\":9.0},\n  {\"id\":726844,\"suggestedTranslation\":\"Lắc nào, lắc nào, lắc nào!\",\"rating\":9.0},\n  {\"id\":726845,\"suggestedTranslation\":\"Lâu thế nhỉ!\",\"rating\":9.0},\n  {\"id\":726846,\"suggestedTranslation\":\"Đồ ăn sẽ sẵn sàng sớm thôi!\",\"rating\":9.0},\n  {\"id\":726847,\"suggestedTranslation\":\"Mmmm! Ăn thôi nào!\",\"rating\":9.0},\n  {\"id\":726848,\"suggestedTranslation\":\"Hừm, chẳng có gì trong đó cả.\",\"rating\":9.0},\n  {\"id\":726849,\"suggestedTranslation\":\"Làm ra đồ ngon đấy!\",\"rating\":9.0},\n  {\"id\":726850,\"suggestedTranslation\":\"Chúng ta có thể giữ ấm và thoải mái trong các chuyến phiêu lưu!\",\"rating\":9.0},\n  {\"id\":726851,\"suggestedTranslation\":\"Xong hết rồi.\",\"rating\":9.0},\n  {\"id\":726852,\"suggestedTranslation\":\"Ồ! Chúng ta nghiền nó được chứ, làm ơn?\",\"rating\":9.0},\n  {\"id\":726853,\"suggestedTranslation\":\"Yay, chúng ta đang cắm trại!\",\"rating\":9.0},\n  {\"id\":726854,\"suggestedTranslation\":\"Để chúng ta giúp một tay!\",\"rating\":9.0},\n  {\"id\":726855,\"suggestedTranslation\":\"Oa! Củ khoai tây kìa!\",\"rating\":9.0},\n  {\"id\":726856,\"suggestedTranslation\":\"Chúng ta đã lén nhìn vào trong, vài củ trông giống cục đá hơn là khoai tây...\",\"rating\":9.0},\n  {\"id\":726857,\"suggestedTranslation\":\"Nó trông sang chảnh quá.\",\"rating\":9.0},\n  {\"id\":726858,\"suggestedTranslation\":\"Oa! Vừa ngầu, LẠI vừa ăn được!\",\"rating\":9.0},\n  {\"id\":726859,\"suggestedTranslation\":\"Bây giờ nó là một củ khoai tây nấu chín.\",\"rating\":9.0},\n  {\"id\":726860,\"suggestedTranslation\":\"Ngài Wolfgang sẽ vui lắm đây!\",\"rating\":9.0},\n  {\"id\":726861,\"suggestedTranslation\":\"Chúng ta có thể tìm xem chúng là gì bằng cách đem đi trồng.\",\"rating\":9.0},\n  {\"id\":726862,\"suggestedTranslation\":\"Mẹ sẽ thích cây dương xỉ xinh xắn này đấy.\",\"rating\":9.0},\n  {\"id\":726863,\"suggestedTranslation\":\"Mẹ chưa từng cho tôi ăn mấy thứ này.\",\"rating\":9.0},\n  {\"id\":726864,\"suggestedTranslation\":\"Này, cô Wickerbottom bảo chúng ta không được lấy những thứ không thuộc về mình!\",\"rating\":9.0},\n  {\"id\":726865,\"suggestedTranslation\":\"Chúng ta phải đi múc nước ở đâu đó thôi.\",\"rating\":9.0},\n  {\"id\":726866,\"suggestedTranslation\":\"Bình Tưới Nước ở nhà chúng ta trông chẳng giống thế này tẹo nào.\",\"rating\":9.0},\n  {\"id\":726867,\"suggestedTranslation\":\"Hắn là một tên bắt nạt to xác!\",\"rating\":9.0},\n  {\"id\":726868,\"suggestedTranslation\":\"Trông nó là một chú chim dễ thương.\",\"rating\":9.0},\n  {\"id\":726869,\"suggestedTranslation\":\"Ta bắt được ngươi rồi nhé.\",\"rating\":9.0},\n  {\"id\":726870,\"suggestedTranslation\":\"Chúc ngủ ngon nhé.\",\"rating\":9.0},\n  {\"id\":726871,\"suggestedTranslation\":\"Đó là một quả bí ngô khổng lồ!\",\"rating\":9.0},\n  {\"id\":726872,\"suggestedTranslation\":\"Vui vui vui vui vui.\",\"rating\":9.0},\n  {\"id\":726873,\"suggestedTranslation\":\"Ngon tuyệt!\",\"rating\":9.0},\n  {\"id\":726874,\"suggestedTranslation\":\"Ối, nó vẫn còn thiếu vài con mắt.\",\"rating\":9.0},\n  {\"id\":726875,\"suggestedTranslation\":\"Nó còn thiếu mắt và miệng kìa.\",\"rating\":9.0},\n  {\"id\":726876,\"suggestedTranslation\":\"Chúng ta muốn một lát thật to, làm ơn!\",\"rating\":9.0},\n  {\"id\":726877,\"suggestedTranslation\":\"Bây giờ nó ấm áp cả rồi.\",\"rating\":9.0},\n  {\"id\":726878,\"suggestedTranslation\":\"Y hệt như hồi chúng ta hay làm ở nhà!\",\"rating\":9.0},\n  {\"id\":726879,\"suggestedTranslation\":\"Cùng chạm khắc một khuôn mặt thật đáng sợ lên đó nào!\",\"rating\":9.0},\n  {\"id\":726880,\"suggestedTranslation\":\"Chúng ta có thể trồng thứ gì đó bằng mấy cái này.\",\"rating\":9.0},\n  {\"id\":726881,\"suggestedTranslation\":\"Wigfrid đang dạy chúng ta cách đấu tập với nó đấy!\",\"rating\":9.0},\n  {\"id\":726882,\"suggestedTranslation\":\"Nó đang làm lóa cả đôi mắt nhện tội nghiệp của chúng ta!\",\"rating\":9.0},\n  {\"id\":726883,\"suggestedTranslation\":\"Cậu có nghe thấy gì không?\",\"rating\":9.0},\n  {\"id\":726884,\"suggestedTranslation\":\"Tôi có thể thấy tri thức đang bơi lội bên trong.\",\"rating\":9.0},\n  {\"id\":726885,\"suggestedTranslation\":\"Giờ thì chúng ta không cần phải để lại vết bánh mì vụn nữa rồi!\",\"rating\":9.0},\n  {\"id\":726886,\"suggestedTranslation\":\"Chúng ta hi vọng nó ngon.\",\"rating\":9.0},\n  {\"id\":726887,\"suggestedTranslation\":\"Tôi nghĩ nó đang đói.\",\"rating\":9.0},\n  {\"id\":726888,\"suggestedTranslation\":\"Đủ đẹp rồi.\",\"rating\":9.0},\n  {\"id\":726889,\"suggestedTranslation\":\"Dây thường xuân mọc khắp nơi.\",\"rating\":9.0},\n  {\"id\":726890,\"suggestedTranslation\":\"Chao ôi. Cô ấy trông thật xinh đẹp.\",\"rating\":9.0},\n  {\"id\":726891,\"suggestedTranslation\":\"Nó trông giống con dê thân thiện mà chúng ta từng gặp.\",\"rating\":9.0},\n  {\"id\":726892,\"suggestedTranslation\":\"Quanh đây có rất nhiều tượng dê.\",\"rating\":9.0},\n  {\"id\":726893,\"suggestedTranslation\":\"Cứ từ từ thôi ông bạn già.\",\"rating\":9.0},\n  {\"id\":726894,\"suggestedTranslation\":\"Hic... đám dâu rừng biến đâu mất tiêu rồi.\",\"rating\":9.0},\n  {\"id\":726895,\"suggestedTranslation\":\"Bây giờ chúng ta đã có chỗ để đặt đồ ăn rồi.\",\"rating\":9.0},\n  {\"id\":726896,\"suggestedTranslation\":\"Chúng ta có thể tìm xem chúng là gì bằng cách đem đi trồng.\",\"rating\":9.0},\n  {\"id\":726897,\"suggestedTranslation\":\"Chúng ta có thể nấu đồ ăn trong đó.\",\"rating\":9.0},\n  {\"id\":726898,\"suggestedTranslation\":\"Nó hơi nhỏ chút.\",\"rating\":9.0},\n  {\"id\":726899,\"suggestedTranslation\":\"Chúng ta có thể đổi nó lấy một thứ nhỏ nhặt gì đó.\",\"rating\":9.0},\n  {\"id\":726900,\"suggestedTranslation\":\"Tự hỏi chúng ta có thể mua gì với thứ này nhỉ.\",\"rating\":9.0},\n  {\"id\":726901,\"suggestedTranslation\":\"Chúng ta có thể mua cả đống đồ với thứ này luôn.\",\"rating\":9.0},\n  {\"id\":726902,\"suggestedTranslation\":\"Bà quý cô tốt bụng bảo chúng ta cần ba cái cơ.\",\"rating\":9.0},\n  {\"id\":726903,\"suggestedTranslation\":\"Cua trông hơi giống loài nhện nhỉ.\",\"rating\":9.0},\n  {\"id\":726904,\"suggestedTranslation\":\"Chúng ta không muốn ăn nó đâu.\",\"rating\":9.0},\n  {\"id\":726905,\"suggestedTranslation\":\"Chúng ta có thể bẫy những chú cua nhỏ bằng cái này.\",\"rating\":9.0},\n  {\"id\":726906,\"suggestedTranslation\":\"Biết đâu chúng ta làm được một đĩa salad.\",\"rating\":9.0},\n  {\"id\":726907,\"suggestedTranslation\":\"Đứng một mình thì chẳng để làm gì cả.\",\"rating\":9.0},\n  {\"id\":726908,\"suggestedTranslation\":\"Cái này chắc không được tính là salad đâu nhỉ.\",\"rating\":9.0},\n  {\"id\":726909,\"suggestedTranslation\":\"Giờ chúng ta có thể đặt nó lên bệ thờ rồi.\",\"rating\":9.0},\n  {\"id\":726910,\"suggestedTranslation\":\"Bà cô dê bảo đây là thứ mà Gnaw muốn.\",\"rating\":9.0},\n  {\"id\":726911,\"suggestedTranslation\":\"Đây là thứ nó muốn, nhưng trông hơi còi cọc thì phải.\",\"rating\":9.0},\n  {\"id\":726912,\"suggestedTranslation\":\"Chúng ta nghĩ Gnaw muốn một món khác cơ.\",\"rating\":9.0},\n  {\"id\":726913,\"suggestedTranslation\":\"Không sao đâu. Lần sau sẽ khá hơn mà.\",\"rating\":9.0},\n  {\"id\":726914,\"suggestedTranslation\":\"Maxwell nói cậu có thể dùng nó để xua đuổi quái vật.\",\"rating\":9.0},\n  {\"id\":726915,\"suggestedTranslation\":\"Nó có xua đuổi được chúng ta đâu!\",\"rating\":9.0},\n  {\"id\":726916,\"suggestedTranslation\":\"Chúng ta có thể tìm xem chúng là gì bằng cách đem đi trồng.\",\"rating\":9.0},\n  {\"id\":726917,\"suggestedTranslation\":\"Xin chào! Tớ là Webber!\",\"rating\":9.0},\n  {\"id\":726918,\"suggestedTranslation\":\"Sữa rất tốt cho xương của chúng ta. Cả trong lẫn ngoài!\",\"rating\":9.0},\n  {\"id\":726919,\"suggestedTranslation\":\"Con của cô có muốn chơi cùng không?\",\"rating\":9.0},\n  {\"id\":726920,\"suggestedTranslation\":\"Chúng ta phải cẩn thận khi nấu nướng.\",\"rating\":9.0},\n  {\"id\":726921,\"suggestedTranslation\":\"Chúng ta có thể dùng nó để làm đồ ăn ngon.\",\"rating\":9.0},\n  {\"id\":726922,\"suggestedTranslation\":\"Chúng ta nên nấu món gì đây?\",\"rating\":9.0},\n  {\"id\":726923,\"suggestedTranslation\":\"Đi tìm chỗ để đặt nó xuống thôi.\",\"rating\":9.0},\n  {\"id\":726924,\"suggestedTranslation\":\"Tôi biết cách dùng cái này!\",\"rating\":9.0},\n  {\"id\":726925,\"suggestedTranslation\":\"Tuyệt quá! Tự hỏi nó mở khóa cái gì nhỉ?\",\"rating\":9.0},\n  {\"id\":726926,\"suggestedTranslation\":\"Chúng ta muốn đến công viên.\",\"rating\":9.0},\n  {\"id\":726927,\"suggestedTranslation\":\"Đó là loại đèn đường họ hay có trong thành phố.\",\"rating\":9.0},\n  {\"id\":726928,\"suggestedTranslation\":\"Chúng ta cao suýt soát cây đèn này rồi đấy.\",\"rating\":9.0},\n  {\"id\":726929,\"suggestedTranslation\":\"Chúng ta muốn làm công việc nghiền ngũ cốc!\",\"rating\":9.0},\n  {\"id\":726930,\"suggestedTranslation\":\"Trông nó không được ấm cúng cho lắm.\",\"rating\":9.0},\n  {\"id\":726931,\"suggestedTranslation\":\"Họ có món đồ chơi nào không nhỉ?\",\"rating\":9.0},\n  {\"id\":726932,\"suggestedTranslation\":\"Chỗ đó toàn là đồ ngon thôi.\",\"rating\":9.0},\n  {\"id\":726933,\"suggestedTranslation\":\"Tôi không thích nấm.\",\"rating\":9.0},\n  {\"id\":726934,\"suggestedTranslation\":\"Mấy cây nấm đó bé tí xíu à.\",\"rating\":9.0},\n  {\"id\":726935,\"suggestedTranslation\":\"Hết nấm nhỏ để hái rồi.\",\"rating\":9.0},\n  {\"id\":726936,\"suggestedTranslation\":\"Nó làm tất cả chúng ta cay xè cả mắt!\",\"rating\":9.0},\n  {\"id\":726937,\"suggestedTranslation\":\"Mắt chúng ta hết cay rồi nè.\",\"rating\":9.0},\n  {\"id\":726938,\"suggestedTranslation\":\"Chúng ta có thể tìm xem chúng là gì bằng cách đem đi trồng.\",\"rating\":9.0},\n  {\"id\":726939,\"suggestedTranslation\":\"Mẹ dặn tôi phải cẩn thận khi đứng gần lò nướng.\",\"rating\":9.0},\n  {\"id\":726940,\"suggestedTranslation\":\"Chúng ta phải lắp ráp cái này thôi.\",\"rating\":9.0},\n  {\"id\":726941,\"suggestedTranslation\":\"Trông nó có vẻ sắc nhọn đấy.\",\"rating\":9.0},\n  {\"id\":726942,\"suggestedTranslation\":\"Tớ nghĩ nó trông khá xinh xắn.\",\"rating\":9.0},\n  {\"id\":726943,\"suggestedTranslation\":\"Nó trông cứ như thật vậy.\",\"rating\":9.0},\n  {\"id\":726944,\"suggestedTranslation\":\"Chẳng có xu nào trong đó cả. Chắc chẳng ai ước nguyện gì đâu.\",\"rating\":9.0},\n  {\"id\":726945,\"suggestedTranslation\":\"Công viên. Công viên. Công viên!\",\"rating\":9.0},\n  {\"id\":726946,\"suggestedTranslation\":\"Nó bị khóa rồi. Tôi nghĩ chúng