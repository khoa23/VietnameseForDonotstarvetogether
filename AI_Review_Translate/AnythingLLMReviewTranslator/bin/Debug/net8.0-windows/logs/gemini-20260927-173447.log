,\n  {\"id\":726669,\"suggestedTranslation\":\"Ái! Sắc quá đấy!\",\"rating\":9.0},\n  {\"id\":726670,\"suggestedTranslation\":\"Ái! Sắc quá đấy!\",\"rating\":9.0},\n  {\"id\":726671,\"suggestedTranslation\":\"Tự hỏi không biết chúng ta sẽ đi câu cá gì đây!\",\"rating\":9.0},\n  {\"id\":726672,\"suggestedTranslation\":\"Eo ôi, nó dính đầy bùn kìa!\",\"rating\":9.0},\n  {\"id\":726673,\"suggestedTranslation\":\"Cậu mà ăn kèm với chút khoai tây chiên thì ngon tuyệt cú mèo luôn.\",\"rating\":9.0},\n  {\"id\":726674,\"suggestedTranslation\":\"Ái chà, con này toàn gai là gai!\",\"rating\":9.0},\n  {\"id\":726675,\"suggestedTranslation\":\"Con này bắt khó ghê luôn á.\",\"rating\":9.0},\n  {\"id\":726676,\"suggestedTranslation\":\"Cái này có được tính là ăn rau củ không ta?\",\"rating\":9.0},\n  {\"id\":726677,\"suggestedTranslation\":\"Trông nó có mấy cái râu kìa!\",\"rating\":9.0},\n  {\"id\":726678,\"suggestedTranslation\":\"Trông nó có mấy cái râu kìa!\",\"rating\":9.0},\n  {\"id\":726679,\"suggestedTranslation\":\"Đúng là một que kem cá!\",\"rating\":9.0},\n  {\"id\":726680,\"suggestedTranslation\":\"Nhìn kìa, nó có một bộ ria mép nhỏ xíu luôn!\",\"rating\":9.0},\n  {\"id\":726681,\"suggestedTranslation\":\"Bé xíu luôn nè!\",\"rating\":9.0},\n  {\"id\":726682,\"suggestedTranslation\":\"Ôi, đúng là một chú nhóc tì.\",\"rating\":9.0},\n  {\"id\":726683,\"suggestedTranslation\":\"Trông cũng dễ thương đấy. Tiếc là bọn mình sắp ăn thịt nó rồi.\",\"rating\":9.0},\n  {\"id\":726684,\"suggestedTranslation\":\"Bọn mình biết chắc là sẽ đi câu cá to hơn được mà!\",\"rating\":9.0},\n  {\"id\":726685,\"suggestedTranslation\":\"Ủa, con cá này dị ghê ta!\",\"rating\":9.0},\n  {\"id\":726686,\"suggestedTranslation\":\"Nếu gom một đống cá thế này lại rồi nhảy vào thì sao nhỉ?\",\"rating\":9.0},\n  {\"id\":726687,\"suggestedTranslation\":\"Wendy đã nổi giận khi tụi mình bảo nó làm tụi mình nhớ đến cậu ấy...\",\"rating\":9.0},\n  {\"id\":726688,\"suggestedTranslation\":\"Ái! Ái chà! Nóng