  {\"id\":727942,\"suggestedTranslation\":\"Bọn mình muốn giữ lại một cái cho riêng mình.\",\"rating\":9.0},\n  {\"id\":727943,\"suggestedTranslation\":\"Bọn mình thích bà Ngọc trai.\",\"rating\":9.0},\n  {\"id\":727944,\"suggestedTranslation\":\"Khôngggg! Cái cây kìa!\",\"rating\":9.0},\n  {\"id\":727945,\"suggestedTranslation\":\"Hic... Sao lại thế...\",\"rating\":9.0},\n  {\"id\":727946,\"suggestedTranslation\":\"Đại Tiệc Mùa Đông! Đến Đại Tiệc Mùa Đông rồi kìa!\",\"rating\":9.0},\n  {\"id\":727947,\"suggestedTranslation\":\"Nó vẫn cần phải lớn thêm chút nữa.\",\"rating\":9.0},\n  {\"id\":727948,\"suggestedTranslation\":\"Hic... Sao lại thế...\",\"rating\":9.0},\n  {\"id\":727949,\"suggestedTranslation\":\"Chỉ là một cái bồn trồng cây nhàm chán không có cây thôi.\",\"rating\":9.0},\n  {\"id\":727950,\"suggestedTranslation\":\"Tự hỏi sinh vật nào sống trong đó nhỉ?\",\"rating\":9.0},\n  {\"id\":727951,\"suggestedTranslation\":\"Trông chúng không giống bình thường cho lắm nhỉ?\",\"rating\":9.0},\n  {\"id\":727952,\"suggestedTranslation\":\"Tốt nhất là chúng ta nên tránh xa cái đám kẹp nhọn đó ra.\",\"rating\":9.0},\n  {\"id\":727953,\"suggestedTranslation\":\"Nó không động đậy gì nữa rồi.\",\"rating\":9.0},\n  {\"id\":727954,\"suggestedTranslation\":\"Ngon, ngon, ngon!\",\"rating\":9.0},\n  {\"id\":727955,\"suggestedTranslation\":\"Woby to lớn, lông xù và hoàn hảo để ôm ấp!\",\"rating\":9.0},\n  {\"id\":727956,\"suggestedTranslation\":\"Woby to lớn, lông xù và hoàn hảo để ôm ấp!\",\"rating\":9.0},\n  {\"id\":727957,\"suggestedTranslation\":\"Bọn mình có hẳn tám chiếc tay để vuốt ve cơ mà!\",\"rating\":9.0},\n  {\"id\":727958,\"suggestedTranslation\":\"Bọn mình có hẳn tám chiếc tay để vuốt ve cơ mà!\",\"rating\":9.0},\n  {\"id\":727959,\"suggestedTranslation\":\"Một phần cho Woby, một phần cho bọn mình!\",\"rating\":9.0},\n  {\"id\":727960,\"suggestedTranslation\":\"Này %s, trông cậu có vẻ đang phiền muộn chuyện gì đấy.\",\"rating\":9.0},\n  {\"id\":727961,\"suggestedTranslation\":\"%s, không được đâu!! Lửa có thể làm cậu bị thương đấy!\",\"rating\":9.0},\n  {\"id\":727962,\"suggestedTranslation\":\"Chào %s! Dạo này cậu có chăm chỉ tập thể hình không đấy?\",\"rating\":9.0},\n  {\"id\":727963,\"suggestedTranslation\":\"Bọn mình chắc chắn cậu là hồn ma khỏe mạnh nhất rồi. Nhưng kiếm một trái tim trước đã nào.\",\"rating\":9.0},\n  {\"id\":727964,\"suggestedTranslation\":\"Cậu chỉ là một tên bắt nạt to xác thôi!\",\"rating\":9.0},\n  {\"id\":727965,\"suggestedTranslation\":\"%s tốt tính lắm! Chỉ là ước gì anh ấy đừng làm rối tung phần tóc trên đầu bọn mình lên.\",\"rating\":9.0},\n  {\"id\":727966,\"suggestedTranslation\":\"Anh Wolfgang thích chơi còi lắm, y như bọn mình vậy!\",\"rating\":9.0},\n  {\"id\":727967,\"suggestedTranslation\":\"Này, quá đáng thế nhỉ!\",\"rating\":9.0},\n  {\"id\":727968,\"suggestedTranslation\":\"Không, chúng ta không được nghịch lửa!\",\"rating\":9.0},\n  {\"id\":727969,\"suggestedTranslation\":\"Chào Khỉ con!\",\"rating\":9.0},\n  {\"id\":727970,\"suggestedTranslation\":\"Đừng lo, bọn mình sẽ giúp cậu khỏe lại ngay!\",\"rating\":9.0},\n  {\"id\":727971,\"suggestedTranslation\":\"Bọn mình nghĩ không nên chơi với con khỉ đó nữa đâu.\",\"rating\":9.0},\n  {\"id\":727972,\"suggestedTranslation\":\"Bọn mình biết cậu là một chú khỉ tốt mà!\",\"rating\":9.0},\n  {\"id\":727973,\"suggestedTranslation\":\"Một cái hốc ấm cúng cho cái đầu của chúng ta.\",\"rating\":9.0},\n  {\"id\":727974,\"suggestedTranslation\":\"Hôm nay trông %s có vẻ nổi giận.\",\"rating\":9.0},\n  {\"id\":727975,\"suggestedTranslation\":\"%s đang giở chứng gặm nhấm kìa.\",\"rating\":9.0},\n  {\"id\":727976,\"suggestedTranslation\":\"Bọn mình sờ tai cậu được không, hay móng vuốt sẽ xuyên qua luôn?\",\"rating\":9.0},\n  {\"id\":727977,\"suggestedTranslation\":\"Ừm. Bọn mình nghĩ cậu vừa nhóm lửa đấy, %s.\",\"rating\":9.0},\n  {\"id\":727978,\"suggestedTranslation\":\"Chào %s, chào Lucy nhé!\",\"rating\":9.0},\n  {\"id\":727979,\"suggestedTranslation\":\"Muốn đi săn trái tim cùng bọn mình không, %s?\",\"rating\":9.0},\n  {\"id\":727980,\"suggestedTranslation\":\"Cậu đến để kể chuyện cổ tích cho bọn mình nghe à?\",\"rating\":9.0},\n  {\"id\":727981,\"suggestedTranslation\":\"Đừng lo, bọn mình sẽ đưa cậu trở lại bình thường! Ờ thì, gần như bình thường.\",\"rating\":9.0},\n  {\"id\":727982,\"suggestedTranslation\":\"Oà! Cậu cho bọn mình quá giang trên lưng được không %s?\",\"rating\":9.0},\n  {\"id\":727983,\"suggestedTranslation\":\"Liệu bọn mình có tìm được trái tim nào đủ lớn cho cậu không nhỉ?\",\"rating\":9.0},\n  {\"id\":727984,\"suggestedTranslation\":\"Cậu cần đối xử với mọi người tử tế hơn đấy, %s!\",\"rating\":9.0},\n  {\"id\":727985,\"suggestedTranslation\":\"%s cục tính nhưng tốt bụng lắm.\",\"rating\":9.0},\n  {\"id\":727986,\"suggestedTranslation\":\"Bọn mình cứ tưởng ngửi thấy mùi khét.\",\"rating\":9.0},\n  {\"id\":727987,\"suggestedTranslation\":\"Mẹ bảo tôi không bao giờ được ngồi yên một chỗ.\",\"rating\":9.0},\n  {\"id\":727988,\"suggestedTranslation\":\"Mẹ bảo tôi không bao giờ được ngồi yên một chỗ.\",\"rating\":9.0},\n  {\"id\":727989,\"suggestedTranslation\":\"Tiếc thật đấy.\",\"rating\":9.0},\n  {\"id\":727990,\"suggestedTranslation\":\"Tôi nhớ cảm giác ngồi vẽ ở cái bàn này.\",\"rating\":9.0},\n  {\"id\":727991,\"suggestedTranslation\":\"Tôi nhớ cảm giác ngồi vẽ ở cái bàn này.\",\"rating\":9.0},\n  {\"id\":727992,\"suggestedTranslation\":\"Chỉ là chút đất cát thôi, có gì ghê gớm đâu.\",\"rating\":9.0},\n  {\"id\":727993,\"suggestedTranslation\":\"Chuyện gì tồi tệ có thể xảy ra được cơ chứ?\",\"rating\":9.0},\n  {\"id\":727994,\"suggestedTranslation\":\"Đồ bò sát ngoằn ngoèo!\",\"rating\":9.0},\n  {\"id\":727995,\"suggestedTranslation\":\"Tôi nghĩ thứ đó còn sống đấy.\",\"rating\":9.0},\n  {\"id\":727996,\"suggestedTranslation\":\"Tôi từng trải qua những thứ tồi tệ hơn nhiều rồi.\",\"rating\":9.0},\n  {\"id\":727997,\"suggestedTranslation\":\"Kinh quá, cái đó trông ốm yếu đờ đẫn thế!\",\"rating\":9.0},\n  {\"id\":727998,\"suggestedTranslation\":\"Nó đang bừng sáng kìa.\",\"rating\":9.0},\n  {\"id\":727999,\"suggestedTranslation\":\"Đố cậu dám ăn nó đấy!\",\"rating\":9.0},\n  {\"id\":728000,\"suggestedTranslation\":\"Chuyện gì tồi tệ có thể xảy ra được cơ chứ?\",\"rating\":9.0},\n  {\"id\":728001,\"suggestedTranslation\":\"Này, %s! Bạn bè không được đánh nhau đâu nhé!\",\"rating\":9.0},\n  {\"id\":728002,\"suggestedTranslation\":\"Bọn mình nghĩ việc cậu ở gần két sắt là không an toàn đâu.\",\"rating\":9.0},\n  {\"id\":728003,\"suggestedTranslation\":\"Này, bạn tốt %s của bọn mình đây mà!\",\"rating\":9.0},\n  {\"id\":728004,\"suggestedTranslation\":\"Tội nghiệp %s! Cậu ấy đã chết vì cô đơn!\",\"rating\":9.0},\n  {\"id\":728005,\"suggestedTranslation\":\"Wickerbottom bảo chúng ta không được làm bạn nữa!\",\"rating\":9.0},\n  {\"id\":728006,\"suggestedTranslation\":\"%s lúc nào cũng cổ vũ cho bọn mình!\",\"rating\":9.0},\n  {\"id\":728007,\"suggestedTranslation\":\"Ôi không!\",\"rating\":9.0},\n  {\"id\":728008,\"suggestedTranslation\":\"Chào bạn nhỏ!\",\"rating\":9.0},\n  {\"id\":728009,\"suggestedTranslation\":\"Bọn mình sẽ giữ két sắt cho cậu.\",\"rating\":9.0},\n  {\"id\":728010,\"suggestedTranslation\":\"Chúc ngủ ngon nhé.\",\"rating\":9.0},\n  {\"id\":728011,\"suggestedTranslation\":\"Nó có mùi hoa quả thơm phức.\",\"rating\":9.0},\n  {\"id\":728012,\"suggestedTranslation\":\"Trông có vẻ khá ngon đấy.\",\"rating\":9.0},\n  {\"id\":728013,\"suggestedTranslation\":\"Chúc ngủ ngon!\",\"rating\":9.0},\n  {\"id\":728014,\"suggestedTranslation\":\"Bọn mình nghĩ nó quá to để nhét vừa cái lọ rồi.\",\"rating\":9.0},\n  {\"id\":728015,\"suggestedTranslation\":\"Chà.\",\"rating\":9.0},\n  {\"id\":728016,\"suggestedTranslation\":\"Này, chơi cho đàng hoàng vào nhé, %s!\",\"rating\":9.0},\n  {\"id\":728017,\"suggestedTranslation\":\"Đừng có chơi khăm nữa chứ, ngài Ác quỷ!\",\"rating\":9.0},\n  {\"id\":728018,\"suggestedTranslation\":\"Chào %s! Sừng của cậu trông đẹp đấy!\",\"rating\":9.0},\n  {\"id\":728019,\"suggestedTranslation\":\"Ôi không, %s! Cậu bị thương rồi!\",\"rating\":9.0},\n  {\"id\":728020,\"suggestedTranslation\":\"Ôi không! %s, cậu vừa làm gì thế hả!\",\"rating\":9.0},\n  {\"id\":728021,\"suggestedTranslation\":\"Ông nội vẫn luôn nói tiếng cười là liều thuốc tốt nhất!\",\"rating\":9.0},\n  {\"id\":728022,\"suggestedTranslation\":\"Vứt dưới đất rồi thì có tính là ăn trộm không nhỉ?\",\"rating\":9.0},\n  {\"id\":728023,\"suggestedTranslation\":\"Đề phòng trường hợp có chuyện xấu xảy ra.\",\"rating\":9.0},\n  {\"id\":728024,\"suggestedTranslation\":\"Có linh hồn nhện nào trong đó không nhỉ?\",\"rating\":9.0},\n  {\"id\":728025,\"suggestedTranslation\":\"Này, dừng lại đi! Không được đánh nhau!\",\"rating\":9.0},\n  {\"id\":728026,\"suggestedTranslation\":\"Bọn mình... nghĩ là không được làm thế đâu...\",\"rating\":9.0},\n  {\"id\":728027,\"suggestedTranslation\":\"Chào %s! Cậu đang làm gì đấy?\",\"rating\":9.0},\n  {\"id\":728028,\"suggestedTranslation\":\"Đừng lo! Bọn mình chắc chắn quanh đây có một trái tim mà!\",\"rating\":9.0}\n]",
