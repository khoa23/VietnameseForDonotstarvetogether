\":1.0},\n  {\"id\":727647,\"suggestedTranslation\":\"Sao nó không hoạt động ở đây nhỉ?\",\"rating\":1.0},\n  {\"id\":727648,\"suggestedTranslation\":\"Này, ngươi không phải nhện thật đâu!\",\"rating\":1.0},\n  {\"id\":727649,\"suggestedTranslation\":\"Chúng ta làm được rồi!\",\"rating\":1.0},\n  {\"id\":727650,\"suggestedTranslation\":\"Chúng ta sẽ kéo nó một cú thật mạnh!\",\"rating\":1.0},\n  {\"id\":727651,\"suggestedTranslation\":\"Nó cao quá chúng ta không trèo qua được.\",\"rating\":1.0},\n  {\"id\":727652,\"suggestedTranslation\":\"Vui phết chứ nhỉ!\",\"rating\":1.0},\n  {\"id\":727653,\"suggestedTranslation\":\"Cậu nghĩ nó có thể giúp chúng ta về nhà không?\",\"rating\":1.0},\n  {\"id\":727654,\"suggestedTranslation\":\"Trông có vẻ thiếu một mảnh.\",\"rating\":1.0},\n  {\"id\":727655,\"suggestedTranslation\":\"Chúng ta không trèo ra được á? Được thôi!\",\"rating\":1.0},\n  {\"id\":727656,\"suggestedTranslation\":\"Chúng ta lấy được chứ?\",\"rating\":1.0},\n  {\"id\":727657,\"suggestedTranslation\":\"Nó mất tiêu rồi!\",\"rating\":1.0},\n  {\"id\":727658,\"suggestedTranslation\":\"Có lẽ chúng ta nên để lại một sợi dây thừng để có thể trèo ngược lên.\",\"rating\":1.0},\n  {\"id\":727659,\"suggestedTranslation\":\"Ồ, quả bóng kìa!\",\"rating\":1.0},\n  {\"id\":727660,\"suggestedTranslation\":\"Ồ, chúng ta biết một trò chơi vui với cái này đấy.\",\"rating\":1.0},\n  {\"id\":727661,\"suggestedTranslation\":\"Áaaa!! Đừng có đè bẹp bọn mình!\",\"rating\":1.0},\n  {\"id\":727662,\"suggestedTranslation\":\"Chúng ta đang xây thứ gì đó vui lắm đây!\",\"rating\":1.0},\n  {\"id\":727663,\"suggestedTranslation\":\"Chúng ta sẽ đặt nó ở vị trí tuyệt nhất!\",\"rating\":1.0},\n  {\"id\":727664,\"suggestedTranslation\":\"Cậu sẽ chơi cùng bọn mình chứ?\",\"rating\":1.0},\n  {\"id\":727665,\"suggestedTranslation\":\"Cao quá! Mong là nó không đổ lên người chúng ta!\",\"rating\":1.0},\n  {\"id\":727666,\"suggestedTranslation\":\"Sao nó không bật lên nhỉ? Thiếu cái gì vậy?\",\"rating\":1.0},\n  {\"id\":727667,\"suggestedTranslation\":\"Nó dùng để làm gì thế nhỉ?\",\"rating\":1.0},\n  {\"id\":727668,\"suggestedTranslation\":\"Nó tạo ra cái gì vậy? Đồ chơi à?\",\"rating\":1.0},\n  {\"id\":727669,\"suggestedTranslation\":\"Mấy hình vẽ đẹp đấy.\",\"rating\":1.0},\n  {\"id\":727670,\"suggestedTranslation\":\"Trông anh ấy không ổn lắm.\",\"rating\":1.0},\n  {\"id\":727671,\"suggestedTranslation\":\"Ôi không...\",\"rating\":1.0},\n  {\"id\":727672,\"suggestedTranslation\":\"Trông bọn chúng có vẻ hung dữ!\",\"rating\":1.0},\n  {\"id\":727673,\"suggestedTranslation\":\"Ái chà, nó hỏng mất tiêu rồi!\",\"rating\":1.0},\n  {\"id\":727674,\"suggestedTranslation\":\"Bọn mình thích trò này đấy.\",\"rating\":1.0},\n  {\"id\":727675,\"suggestedTranslation\":\"Sao nó không bật lên nhỉ?\",\"rating\":1.0},\n  {\"id\":727676,\"suggestedTranslation\":\"Ái chà, nó hỏng rồi.\",\"rating\":1.0},\n  {\"id\":727677,\"suggestedTranslation\":\"Chúng ta biết nó hoạt động thế nào rồi!\",\"rating\":1.0},\n  {\"id\":727678,\"suggestedTranslation\":\"Đừng có mà lừa bọn mình ăn rau nữa nhé!\",\"rating\":1.0},\n  {\"id\":727679,\"suggestedTranslation\":\"Hợ, thôi xin cảm ơn.\",\"rating\":1.0},\n  {\"id\":727680,\"suggestedTranslation\":\"Đó là một thức uống có pha rau củ.\",\"rating\":1.0},\n  {\"id\":727681,\"suggestedTranslation\":\"Sang chảnh quá! Mong là làm nó không quá khó...\",\"rating\":1.0},\n  {\"id\":727682,\"suggestedTranslation\":\"Nó hoàn toàn không phải là tơ nhện.\",\"rating\":1.0},\n  {\"id\":727683,\"suggestedTranslation\":\"Trông chúng ta khá là đáng sợ đấy.\",\"rating\":1.0},\n  {\"id\":727684,\"suggestedTranslation\":\"Ồ hố, vui phết!\",\"rating\":1.0},\n  {\"id\":727685,\"suggestedTranslation\":\"Mẹ mà thấy chúng ta giỏi món này thế nào chắc sẽ tự hào lắm đây!\",\"rating\":1.0},\n  {\"id\":727686,\"suggestedTranslation\":\"Hồi ở trang trại chú ấy có bao giờ dùng thứ này đâu.\",\"rating\":1.0},\n  {\"id\":727687,\"suggestedTranslation\":\"Nó giữ cho chúng ta khô ráo, lại còn che mát nữa chứ!\",\"rating\":1.0},\n  {\"id\":727688,\"suggestedTranslation\":\"WUAO! Thạch gelatin kìa!\",\"rating\":1.0},\n  {\"id\":727689,\"suggestedTranslation\":\"Ngon tuyệt!\",\"rating\":1.0},\n  {\"id\":727690,\"suggestedTranslation\":\"Nó có cho người ta ngồi lên đi nhờ không nhỉ?\",\"rating\":1.0},\n  {\"id\":727691,\"suggestedTranslation\":\"Hy vọng lần này nó sẽ đỡ cáu kỉnh hơn.\",\"rating\":1.0},\n  {\"id\":727692,\"suggestedTranslation\":\"Một món đồ chơi vừa vui vừa nguy hiểm để lắp ráp!\",\"rating\":1.0},\n  {\"id\":727693,\"suggestedTranslation\":\"Thêm nhiều bộ phận nữa!\",\"rating\":1.0},\n  {\"id\":727694,\"suggestedTranslation\":\"May mà chúng ta có nhiều hơn ba chân!\",\"rating\":1.0},\n  {\"id\":727695,\"suggestedTranslation\":\"Bọn mình chỉ muốn chơi đùa thôi mà!\",\"rating\":1.0},\n  {\"id\":727696,\"suggestedTranslation\":\"Bọn mình thích những điều bất ngờ!\",\"rating\":1.0},\n  {\"id\":727697,\"suggestedTranslation\":\"Nó tạo ra một bức tường giả vờ đấy!\",\"rating\":1.0},\n  {\"id\":727698,\"suggestedTranslation\":\"Chúng ta không sửa được, nhưng lấy được linh kiện bên trong của nó.\",\"rating\":1.0},\n  {\"id\":727699,\"suggestedTranslation\":\"Thiên vị quá! Sao chúng ta lại không biết bay cơ chứ!\",\"rating\":1.0},\n  {\"id\":727700,\"suggestedTranslation\":\"Chúng ta chơi cùng nó được không?\",\"rating\":1.0},\n  {\"id\":727701,\"suggestedTranslation\":\"Chúng ta có thể dùng cái đó để sửa một cái bị hỏng không?\",\"rating\":1.0},\n  {\"id\":727702,\"suggestedTranslation\":\"Chúng ta có thể sửa nó, hoặc tháo lấy linh kiện bên trong!\",\"rating\":1.0},\n  {\"id\":727703,\"suggestedTranslation\":\"Bọn mình thích cách nó cứ xoay tít thò lò mãi không thôi.\",\"rating\":1.0},\n  {\"id\":727704,\"suggestedTranslation\":\"Mấy con robot nhỏ khó chịu.\",\"rating\":1.0},\n  {\"id\":727705,\"suggestedTranslation\":\"Chúng ta chơi cùng nó được không?\",\"rating\":1.0},\n  {\"id\":727706,\"suggestedTranslation\":\"Bọn mình muốn chơi với món đồ chơi này!\",\"rating\":1.0},\n  {\"id\":727707,\"suggestedTranslation\":\"Có thêm một giọng nói trong đầu thì thấm tháp gì chứ?\",\"rating\":1.0},\n  {\"id\":727708,\"suggestedTranslation\":\"Bọn mình thích mấy trò giải đố!\",\"rating\":1.0},\n  {\"id\":727709,\"suggestedTranslation\":\"Giờ thì chúng ta không được bước qua vạch nữa à?\",\"rating\":1.0},\n  {\"id\":727710,\"suggestedTranslation\":\"Chúng ta sẽ có thêm chỗ để chơi đùa.\",\"rating\":1.0},\n  {\"id\":727711,\"suggestedTranslation\":\"Đến lượt chúng ta kéo rồi đấy!\",\"rating\":1.0},\n  {\"id\":727712,\"suggestedTranslation\":\"Chúng ta có thể xây cái gì vui vui không nhỉ?\",\"rating\":1.0},\n  {\"id\":727713,\"suggestedTranslation\":\"Chúng ta có thể chạm vào chiếc găng tay này!\",\"rating\":1.0},\n  {\"id\":727714,\"suggestedTranslation\":\"Nó là thật á? Bọn mình không hiểu nổi.\",\"rating\":1.0},\n  {\"id\":727715,\"suggestedTranslation\":\"Chúng ta không được phép chơi đùa trong đống sắt vụn, dù thèm đến mấy đi nữa.\",\"rating\":1.0},\n  {\"id\":727716,\"suggestedTranslation\":\"Đó là một câu chuyện à?\",\"rating\":1.0},\n  {\"id\":727717,\"suggestedTranslation\":\"Chúng ta có nên giúp ông ấy không nhỉ? Tớ thì không phiền đâu, nhưng ông ấy có vẻ không chắc lắm...\",\"rating\":1.0},\n  {\"id\":727718,\"suggestedTranslation\":\"Chào bác, bác có trò gì chúng ta chơi thay vì thế này không ạ?\",\"rating\":1.0},\n  {\"id\":727719,\"suggestedTranslation\":\"Chúng ta có nên chơi trò đuổi bắt theo người dẫn đầu không nhỉ?\",\"rating\":1.0},\n  {\"id\":727720,\"suggestedTranslation\":\"Đó có phải thứ chúng ta đang tìm không?\",\"rating\":1.0},\n  {\"id\":727721,\"suggestedTranslation\":\"Trông giống một loại công cụ nào đó... biết đâu chính là thứ ông ấy đang tìm!\",\"rating\":1.0},\n  {\"id\":727722,\"suggestedTranslation\":\"Chúng ta tìm thấy rồi! Ông ấy sẽ vui lắm cho mà xem!\",\"rating\":1.0},\n  {\"id\":727723,\"suggestedTranslation\":\"Bọn mình tìm được một chiếc dụng cụ rồi! Liệu có phải 