{\n    \"id\": 727162,\n    \"suggestedTranslation\": \"Chà! Trông đẹp quá!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727163,\n    \"suggestedTranslation\": \"Trông đẹp phết nhỉ!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727164,\n    \"suggestedTranslation\": \"Đấy! Lại ngon lành ngay!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727165,\n    \"suggestedTranslation\": \"Mình nghĩ nó bị kẹt trong đó rồi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727166,\n    \"suggestedTranslation\": \"Đầu của chú đâu rồi, ngài gì ơi?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727167,\n    \"suggestedTranslation\": \"Mình nghĩ nó đang nhìn tụi mình kìa!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727168,\n    \"suggestedTranslation\": \"Mình nghĩ nó giúp hòn đảo trông gắn kết hơn đấy.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727169,\n    \"suggestedTranslation\": \"Trông ngầu đấy!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727170,\n    \"suggestedTranslation\": \"Mình nghĩ nó bị kẹt trong đó rồi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727171,\n    \"suggestedTranslation\": \"Ụ oà, quái vật!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727172,\n    \"suggestedTranslation\": \"Có ai đánh rơi cái này không nhỉ?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727173,\n    \"suggestedTranslation\": \"Hơi đáng sợ một chút, nhưng tụi mình không thích phán xét.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727174,\n    \"suggestedTranslation\": \"Ồ! Mảnh đó là mũi của hắn.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727175,\n    \"suggestedTranslation\": \"Mình nghĩ nó bị kẹt trong đó rồi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727176,\n    \"suggestedTranslation\": \"Nó đang trốn đấy!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727177,\n    \"suggestedTranslation\": \"Nhìn giống cái... cây xương rồng nhỉ? Không, không phải.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727178,\n    \"suggestedTranslation\": \"Lửa nguy hiểm lắm.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727179,\n    \"suggestedTranslation\": \"Có đủ thứ trò vui để làm ngoài biển khơi luôn.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727180,\n    \"suggestedTranslation\": \"Tụi mình có thể ăn cái này hoài luôn!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727181,\n    \"suggestedTranslation\": \"Mong là không có ai đâm thuyền ván vào đó!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727182,\n    \"suggestedTranslation\": \"Tự hỏi cái gì sẽ chui vào trong đó nhỉ.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727183,\n    \"suggestedTranslation\": \"Ôi nó phát sáng kìa. Chạm vào được không nhỉ?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727184,\n    \"suggestedTranslation\": \"Tụi mình sẽ nhét đầy hạt vào trong này!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727185,\n    \"suggestedTranslation\": \"Một sinh linh nhỏ bé bị kẹt bên trong. Xin chia buồn.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727186,\n    \"suggestedTranslation\": \"Thời gian nảy mầm của chúng đã chấm dứt.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727187,\n    \"suggestedTranslation\": \"Chà! Chắc nó nhìn được xa lắm đây!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727188,\n    \"suggestedTranslation\": \"Mẹ từng hay lo khoản may vá cho tụi mình.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727189,\n    \"suggestedTranslation\": \"Hic, tụi mình muốn chơi trò hóa trang cơ...\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727190,\n    \"suggestedTranslation\": \"Cùng chơi hóa trang nào!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727191,\n    \"suggestedTranslation\": \"Nó dính lắm, như mạng nhện vậy.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727192,\n    \"suggestedTranslation\": \"Tụi mình sẽ nhảy cùng bạn, Ngài Bóng tối!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727193,\n    \"suggestedTranslation\": \"Đôi khi mấy thứ đáng sợ cũng dễ thương phết.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727194,\n    \"suggestedTranslation\": \"Sao nó lại làm mình thấy tồi tệ thế này?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727195,\n    \"suggestedTranslation\": \"T-tụi mình nghĩ là không nên nhìn xuống dưới đó đâu...\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727196,\n    \"suggestedTranslation\": \"Nó nhiều chân hơn tụi mình luôn!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727197,\n    \"suggestedTranslation\": \"Ôi chao, tội nghiệp ghê.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727198,\n    \"suggestedTranslation\": \"Nó đang trừng trừng nhìn tụi mình kìa!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727199,\n    \"suggestedTranslation\": \"Tự hỏi đi kiểu đó tụi nó có bị chóng mặt không...\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727200,\n    \"suggestedTranslation\": \"Tụi mình không muốn bị nuốt chửng lần nữa đâu!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727201,\n    \"suggestedTranslation\": \"Nó đang cười với tụi mình kìa! Chắc nó muốn chơi cùng đấy!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727202,\n    \"suggestedTranslation\": \"Chắc nó chỉ muốn có bạn chơi cùng thôi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727203,\n    \"suggestedTranslation\": \"Hic, bất công quá, ước gì tụi mình cũng có cánh!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727204,\n    \"suggestedTranslation\": \"Tụi mình sẽ cẩn thận. Hứa luôn!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727205,\n    \"suggestedTranslation\": \"Tụi mình có thể cứu bò lai rồi!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727206,\n    \"suggestedTranslation\": \"Tụi mình thích làm đồ thủ công bằng giấy và keo hơn...\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727207,\n    \"suggestedTranslation\": \"Nên đặt nó ở đâu đây?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727208,\n    \"suggestedTranslation\": \"Tụi mình không thích ở gần cái đó chút nào.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 727209,\n    \"suggestedTranslati