            "text": "[\n  {\n    \"id\": 726229,\n    \"suggestedTranslation\": \"Chúng ta có thể nhét thêm vào nhưng sợ không dám chạm vào thứ hắn để bên trong.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726230,\n    \"suggestedTranslation\": \"Mặt trời bị nhốt trong đó kìa.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726231,\n    \"suggestedTranslation\": \"Chúng giống như bánh kếp làm từ khoai tây vậy!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726232,\n    \"suggestedTranslation\": \"Có lẽ chúng ta nên nhường nó cho ai đó cứng cỏi hơn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726233,\n    \"suggestedTranslation\": \"Chúng ta sẽ là một con nhện bất khả xâm phạm!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726234,\n    \"suggestedTranslation\": \"Ồ, tớ không nghĩ cái đó an toàn lắm đâu.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726235,\n    \"suggestedTranslation\": \"Chúng ta sẽ lướt đi cực kỳ nhanh với thứ đó.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726236,\n    \"suggestedTranslation\": \"An toàn là trên hết!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726237,\n    \"suggestedTranslation\": \"Chúng ta rất thích bộ giáp này.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726238,\n    \"suggestedTranslation\": \"Bộ giáp này trông khá được đấy chứ!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726239,\n    \"suggestedTranslation\": \"Chúng ta nên mặc giáp để an toàn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726240,\n    \"suggestedTranslation\": \"Này, giúp tôi phá hủy Cờ Hiệu Chiến Đấu này đi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726241,\n    \"suggestedTranslation\": \"Ồ! Willow mang theo Bernie kìa!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726242,\n    \"suggestedTranslation\": \"Biết đâu lão ấy là người tốt?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726243,\n    \"suggestedTranslation\": \"Chiếc mũ giáp đó thực sự rất đỉnh!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726244,\n    \"suggestedTranslation\": \"Chào nhé, người đá tảng!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726245,\n    \"suggestedTranslation\": \"Trông có vẻ hay ho, nhưng tụi mình không muốn nó đâu.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726246,\n    \"suggestedTranslation\": \"Cái đó có thể giúp chúng ta di chuyển nhanh hơn đấy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726247,\n    \"suggestedTranslation\": \"Nó giống như bãi nước bọt bốc lửa vậy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726248,\n    \"suggestedTranslation\": \"Nó làm cho một ngày của bạn tươi sáng hơn một chút.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726249,\n    \"suggestedTranslation\": \"Nó khiến bạn cảm thấy dễ chịu hơn một chút khi đội nó lên.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726250,\n    \"suggestedTranslation\": \"Thanh kiếm đó quá lớn để chúng ta mang theo!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726251,\n    \"suggestedTranslation\": \"Nó không có chìa khóa.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726252,\n    \"suggestedTranslation\": \"Trông khá hơn hẳn rồi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726253,\n    \"suggestedTranslation\": \"Trông nó như được làm ra cho loài nhện vậy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726254,\n    \"suggestedTranslation\": \"Trông cậu khác quá, Lucy. Cậu mới đi cắt tóc à?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726255,\n    \"suggestedTranslation\": \"Đây không phải nhà!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726256,\n    \"suggestedTranslation\": \"Đã đến lúc về... \\\"nhà\\\" thôi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726257,\n    \"suggestedTranslation\": \"Nó lấp lánh thật đấy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726258,\n    \"suggestedTranslation\": \"Đó là cổng của kẻ xấu!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 726259,\n    \"suggestedTranslation\": \"Chúng ta rất thích chiếc mũ đó!\",\n    \"rating\": 9.0\n  },\n  {\n    