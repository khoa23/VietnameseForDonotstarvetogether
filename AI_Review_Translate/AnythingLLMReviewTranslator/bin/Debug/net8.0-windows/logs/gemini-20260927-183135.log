.0\n  },\n  {\n    \"id\": 731412,\n    \"suggestedTranslation\": \"Giá mà việc đóng cửa trái tim với thế giới này lại dễ dàng đến thế...\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731413,\n    \"suggestedTranslation\": \"Dù ngươi có xoay sở xua đuổi bóng đêm đi chăng nữa, nó vẫn sẽ quay lại mà thôi.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731414,\n    \"suggestedTranslation\": \"Chúng đã phải nhọc công giấu nó đến vậy... Tại sao nhỉ?\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731415,\n    \"suggestedTranslation\": \"Nó đã đánh mất thứ gì đó quan trọng...\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731416,\n    \"suggestedTranslation\": \"Đó là một bước nhảy vọt của niềm tin.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731417,\n    \"suggestedTranslation\": \"Nó kìa...\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731418,\n    \"suggestedTranslation\": \"Tôi có cảm giác chúng ta đã châm ngòi cho một chuỗi sự kiện không thể đảo ngược.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731419,\n    \"suggestedTranslation\": \"Một sợi dây thừng chắc chắn và một cú rơi nhanh sẽ đưa tôi sang thế giới bên kia.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731420,\n    \"suggestedTranslation\": \"Trông khá đẹp đấy chứ.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731421,\n    \"suggestedTranslation\": \"Nó sẽ không đưa tôi đến nơi duy nhất mà tôi muốn đến.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731422,\n    \"suggestedTranslation\": \"Nó không muốn tôi ở đây... Tôi cũng chẳng trách nó đâu...\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731423,\n    \"suggestedTranslation\": \"Vẫn chưa có sự sống nào trong đó cả.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731424,\n    \"suggestedTranslation\": \"Tiềm năng lớn chứa đựng trong hình hài nhỏ bé.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731425,\n    \"suggestedTranslation\": \"Nó sinh ra để canh gác. Đến một ngày, nó cũng sẽ gục ngã tại cột của mình.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731426,\n    \"suggestedTranslation\": \"Chúng có vẻ đang đứng canh gác thứ gì đó.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731427,\n    \"suggestedTranslation\": \"Nó đang thiếu đi tia lửa của sự sống.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731428,\n    \"suggestedTranslation\": \"Tôi không phải là kẻ duy nhất bị thiếu mất vài mảnh ghép.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731429,\n    \"suggestedTranslation\": \"Nó có thể tạo ra thứ gì để giúp chúng ta đây?\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731430,\n    \"suggestedTranslation\": \"Ý nghĩa ở đâu chứ?\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731431,\n    \"suggestedTranslation\": \"Ông ấy đã đầu hàng.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731432,\n    \"suggestedTranslation\": \"Biết bao cái chết.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731433,\n    \"suggestedTranslation\": \"Chúng ta vốn không được sinh ra để rời khỏi nơi này.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731434,\n    \"suggestedTranslation\": \"Đã hỏng.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731435,\n    \"suggestedTranslation\": \"Không biết điều gì sẽ xảy ra với chúng ta trong khoảng thời gian lửng lơ đó nhỉ.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731436,\n    \"suggestedTranslation\": \"Không có nguồn điện.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731437,\n    \"suggestedTranslation\": \"Nó bị hỏng rồi.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731438,\n    \"suggestedTranslation\": \"Ánh sáng giữa bóng đêm.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731439,\n    \"suggestedTranslation\": \"Một chế độ ăn lành mạnh để sống lâu hơn. Thật kinh khủng.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731440,\n    \"suggestedTranslation\": \"Đã chết và đang phân hủy.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 731441,\n    \"suggestedTranslation\": \"Chẳng làm cuộc đời tôi thú vị hơn chút nào.\",\n    \"rating\": 1.0\n  