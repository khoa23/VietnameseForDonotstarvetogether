ion\":\"Thật thư giãn khi nhìn những giây trôi qua.\",\"rating\":1.0},\n  {\"id\":730578,\"suggestedTranslation\":\"Năng lượng của nó đã cạn kiệt.\",\"rating\":1.0},\n  {\"id\":730579,\"suggestedTranslation\":\"Bộ lòng của đồng hồ.\",\"rating\":1.0},\n  {\"id\":730580,\"suggestedTranslation\":\"Thật thư giãn khi nhìn những giây trôi qua.\",\"rating\":1.0},\n  {\"id\":730581,\"suggestedTranslation\":\"Năng lượng của nó đã cạn kiệt.\",\"rating\":1.0},\n  {\"id\":730582,\"suggestedTranslation\":\"Tôi sẽ tìm thấy gì nếu lao đầu xuống hang thỏ nhỉ?\",\"rating\":1.0},\n  {\"id\":730583,\"suggestedTranslation\":\"Tôi sẽ tìm thấy gì nếu lao đầu xuống hang thỏ nhỉ?\",\"rating\":1.0},\n  {\"id\":730584,\"suggestedTranslation\":\"Tôi sợ rằng quá khứ cũng khủng khiếp chẳng kém gì tương lai.\",\"rating\":1.0},\n  {\"id\":730585,\"suggestedTranslation\":\"Thật thư giãn khi nhìn những giây trôi qua.\",\"rating\":1.0},\n  {\"id\":730586,\"suggestedTranslation\":\"Năng lượng của nó đã cạn kiệt.\",\"rating\":1.0},\n  {\"id\":730587,\"suggestedTranslation\":\"Abigail... em có nghĩ rằng...?\",\"rating\":1.0},\n  {\"id\":730588,\"suggestedTranslation\":\"Năng lượng của nó đã cạn kiệt.\",\"rating\":1.0},\n  {\"id\":730589,\"suggestedTranslation\":\"Thật thư giãn khi nhìn những giây trôi qua.\",\"rating\":1.0},\n  {\"id\":730590,\"suggestedTranslation\":\"Năng lượng của nó đã cạn kiệt.\",\"rating\":1.0},\n  {\"id\":730591,\"suggestedTranslation\":\"Chẳng có gì đau đớn bằng ký ức của chính mình.\",\"rating\":1.0},\n  {\"id\":730592,\"suggestedTranslation\":\"Hành động của tôi nặng bao nhiêu cân?\",\"rating\":1.0},\n  {\"id\":730593,\"suggestedTranslation\":\"Chắc là... ăn một cái cũng không sao đâu...\",\"rating\":1.0},\n  {\"id\":730594,\"suggestedTranslation\":\"Tôi thích một con quạ hơn.\",\"rating\":1.0},\n  {\"id\":730595,\"suggestedTranslation\":\"Chiếc mũ của một tên cướp biển cắt cổ.\",\"rating\":1.0},\n  {\"id\":730596,\"suggestedTranslation\":\"Nhiều hạt đỏ mọng nước để nhai và n