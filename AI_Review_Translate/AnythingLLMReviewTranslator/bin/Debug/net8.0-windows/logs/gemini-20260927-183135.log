            "text": "[\n  {\"id\":730480,\"suggestedTranslation\":\"Nó nhìn thấu vạn vật, mà lại chẳng thấy gì.\",\"rating\":1.0},\n  {\"id\":730481,\"suggestedTranslation\":\"Mỗi lần dùng là người sử dụng lại chết đi rồi được tái sinh.\",\"rating\":1.0},\n  {\"id\":730482,\"suggestedTranslation\":\"Có thật là chúng nắm tay nhau khi ngủ trên biển để không bị lạc nhau không?\",\"rating\":1.0},\n  {\"id\":730483,\"suggestedTranslation\":\"Chẳng có gì trong đó cả.\",\"rating\":1.0},\n  {\"id\":730484,\"suggestedTranslation\":\"Nếu em lấy những thứ ở đó, sinh vật lạ này có thể sẽ chết đói mất.\",\"rating\":1.0},\n  {\"id\":730485,\"suggestedTranslation\":\"Em có linh cảm là nó sẽ kết thúc ngoài biển khơi.\",\"rating\":1.0},\n  {\"id\":730486,\"suggestedTranslation\":\"Vẻ bề ngoài cứng rắn của ngươi sẽ không bảo vệ ngươi khỏi thế giới này đâu.\",\"rating\":1.0},\n  {\"id\":730487,\"suggestedTranslation\":\"Nó vẫn còn cơ hội để lớn lên.\",\"rating\":1.0},\n  {\"id\":730488,\"suggestedTranslation\":\"Ta đã cảnh báo ngươi là bộ giáp của ngươi không bảo vệ nổi ngươi đâu.\",\"rating\":1.0},\n  {\"id\":730489,\"suggestedTranslation\":\"Một cái cây chỉ vừa mới bắt đầu sự sống.\",\"rating\":1.0},\n  {\"id\":730490,\"suggestedTranslation\":\"Cuộc đời là một canh bạc.\",\"rating\":1.0},\n  {\"id\":730491,\"suggestedTranslation\":\"Nó... ngon thật.\",\"rating\":1.0},\n  {\"id\":730492,\"suggestedTranslation\":\"Âm nhạc là cánh cửa dẫn đến linh hồn trống rỗng của em.\",\"rating\":1.0},\n  {\"id\":730493,\"suggestedTranslation\":\"Dùng để ghi lại nỗi đau của em.\",\"rating\":1.0},\n  {\"id\":730494,\"suggestedTranslation\":\"Nó giòn tan và mỏng manh, giống như chính cuộc đời vậy.\",\"rating\":1.0},\n  {\"id\":730495,\"suggestedTranslation\":\"Abigail sẽ bảo vệ em.\",\"rating\":1.0},\n  {\"id\":730496,\"suggestedTranslation\":\"Lên đồ lồng lộn thế này, nhưng đi đâu đây?\",\"rating\":1.0},\n  {\"id\":730497,\"suggestedTranslation\":\"Giờ thì nó thực sự được tự do rồi. À thì, tự do như một con chim không biết bay vậy.\",\"rating\":1.0},\n  {\"id\":730498,\"suggestedTranslation\":\"Con chim tội nghiệp.\",\"rating\":1.0},\n  {\"id\":730499,\"suggestedTranslation\":\"Có những số phận còn tồi tệ hơn cả cái chết.\",\"rating\":1.0},\n  {\"id\":730500,\"suggestedTranslation\":\"Nó trông thật nhỏ bé và tầm thường.\",\"rating\":1.0},\n  {\"id\":730501,\"suggestedTranslation\":\"Non ngon đến mức em suýt quên mất nỗi buồn tê tái của mình.\",\"rating\":1.0},\n  {\"id\":730502,\"suggestedTranslation\":\"Cái cây nhỏ bé này có thể làm gì để lấp đầy cuộc đời trống rỗng của em đây?\",\"rating\":1.0},\n  {\"id\":730503,\"suggestedTranslation\":\"Đó là một lượng ớt cực kỳ đáng kể đấy.\",\"rating\":1.0},\n  {\"id\":730504,\"suggestedTranslation\":\"Liệu em có sống đủ lâu để chứng kiến nó lớn lên không?\",\"rating\":1.0},\n  {\"id\":730505,\"suggestedTranslation\":\"Con chim ngốc nghếch! Tránh xa đám dâu rừng ra!\",\"rating\":1.0},\n  {\"id\":730506,\"suggestedTranslation\":\"Nó... mềm một cách đáng ngạc nhiên.\",\"rating\":1.0},\n  {\"id\":730507,\"suggestedTranslation\":\"Đen tối như trái tim em vậy.\",\"rating\":1.0},\n  {\"id\":730508,\"suggestedTranslation\":\"Nó trống rỗng...\",\"rating\":1.0},\n  {\"id\":730509,\"suggestedTranslation\":\"Nó đang khao khát một vật hiến tế.\",\"rating\":1.0},\n  {\"id\":730510,\"suggestedTranslation\":\"Một chiếc túi nhỏ chứa đầy dưỡng chất đáng yêu.\",\"rating\":1.0},\n  {\"id\":730511,\"suggestedTranslation\":\"Niềm vui của nó thật phản cảm...\",\"rating\":1.0},\n  {\"id\":730512,\"suggestedTranslation\":\"Em thích mùi của chúng.\",\"rating\":1.0},\n  {\"id\":730513,\"suggestedTranslation\":\"Chúng được tô điểm bằng màu sắc linh hồn tôi.\",\"rating\":1.0},\n  {\"id\":730514,\"suggestedTranslation\":\"Em thích mùi của chúng.\",\"rating\":1.0},\n  {\"id\":730515,\"suggestedTranslation\":\"Giờ thì nó sẽ không bao giờ chết nữa...\",\"rating\":1.0},\n  {\"id\":730516,\"suggestedTranslation\":\"Con quái vật khốn khổ đó chắc hẳn đã bị