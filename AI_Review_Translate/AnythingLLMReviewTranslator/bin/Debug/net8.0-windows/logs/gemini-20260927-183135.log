            "text": "[\n  {\"id\":729880,\"suggestedTranslation\":\"Có lẽ nó sẽ xoa dịu linh hồn tôi, dẫu chỉ trong chốc lát.\",\"rating\":9.0},\n  {\"id\":729881,\"suggestedTranslation\":\"Chẳng còn gì cho tôi ở nơi này...\",\"rating\":9.0},\n  {\"id\":729882,\"suggestedTranslation\":\"Khi ta ngắm nhìn hình bóng mình, một con ma đang nhìn chằm chằm lại.\",\"rating\":9.0},\n  {\"id\":729883,\"suggestedTranslation\":\"Tôi không phiền khi phải chờ đợi đâu.\",\"rating\":9.0},\n  {\"id\":729884,\"suggestedTranslation\":\"Chẳng đáng để cứu vãn chút nào.\",\"rating\":9.0},\n  {\"id\":729885,\"suggestedTranslation\":\"Có lẽ những thứ vỡ nát rồi cũng sẽ được hàn gắn... theo thời gian...\",\"rating\":9.0},\n  {\"id\":729886,\"suggestedTranslation\":\"Việc nhà giúp tâm trí bận rộn hơn.\",\"rating\":9.0},\n  {\"id\":729887,\"suggestedTranslation\":\"Thật dễ chịu.\",\"rating\":9.0},\n  {\"id\":729888,\"suggestedTranslation\":\"Cuối cùng thì công sức của tôi cũng được đền đáp.\",\"rating\":9.0},\n  {\"id\":729889,\"suggestedTranslation\":\"Abigail thích vỏ sò.\",\"rating\":9.0},\n  {\"id\":729890,\"suggestedTranslation\":\"Dường như tôi chỉ mang lại đau khổ trên bước đường của mình...\",\"rating\":9.0},\n  {\"id\":729891,\"suggestedTranslation\":\"Tôi sẽ là người chăm sóc nó.\",\"rating\":9.0},\n  {\"id\":729892,\"suggestedTranslation\":\"Những âm mưu đen tối nào từng được nhào nặn bên dưới thế?\",\"rating\":9.0},\n  {\"id\":729893,\"suggestedTranslation\":\"Một sự giả lập thảm hại...\",\"rating\":9.0},\n  {\"id\":729894,\"suggestedTranslation\":\"Quả thật rất phù du.\",\"rating\":9.0},\n  {\"id\":729895,\"suggestedTranslation\":\"Một dấu vết được để lại, dẫu có mong manh đến đâu.\",\"rating\":9.0},\n  {\"id\":729896,\"suggestedTranslation\":\"Bề mặt trống trơn này rồi sẽ sớm hé lộ một bí mật.\",\"rating\":9.0},\n  {\"id\":729897,\"suggestedTranslation\":\"Một món quà ngọt ngào nhưng chóng tàn.\",\"rating\":9.0},\n  {\"id\":729898,\"suggestedTranslation\":\"Những mảnh tổ ong vương vãi khắp nơi.\",\"rating\":9.0},\n  {\"id\":729899,\"suggestedTranslation\":\"Một lớp sốt ngọt ngào cho cái ôm ngọt ngào của sinh vật này.\",\"rating\":9.0},\n  {\"id\":729900,\"suggestedTranslation\":\"Thịt cắt thành từng miếng nhỏ. Giống hệt trái tim tôi.\",\"rating\":9.0},\n  {\"id\":729901,\"suggestedTranslation\":\"Nghe giống như có một con bò lai đang bị kẹt bên trong.\",\"rating\":9.0},\n  {\"id\":729902,\"suggestedTranslation\":\"Vẫn còn rất nhiều nỗi kinh hoàng đang chờ đợi phía trước.\",\"rating\":9.0},\n  {\"id\":729903,\"suggestedTranslation\":\"Liệu nó có làm thay đổi điều gì cho tôi không?\",\"rating\":9.0},\n  {\"id\":729904,\"suggestedTranslation\":\"Abigail ghét đồ ăn cay.\",\"rating\":9.0},\n  {\"id\":729905,\"suggestedTranslation\":\"Tôi không thấy việc này giúp ích được gì cả.\",\"rating\":9.0},\n  {\"id\":729906,\"suggestedTranslation\":\"Chẳng còn gì cho tôi ở nơi này...\",\"rating\":9.0},\n  {\"id\":729907,\"suggestedTranslation\":\"Khi ta ngắm nhìn hình bóng mình, một con ma đang nhìn chằm chằm lại.\",\"rating\":9.0},\n  {\"id\":729908,\"suggestedTranslation\":\"Phía trên là thủy tinh đặc.\",\"rating\":9.0},\n  {\"id\":729909,\"suggestedTranslation\":\"Tránh xa ra, tay sai hèn hạ của cái ác!\",\"rating\":9.0},\n  {\"id\":729910,\"suggestedTranslation\":\"Tàn tích của một con quái thú độc ác.\",\"rating\":9.0},\n  {\"id\":729911,\"suggestedTranslation\":\"Thượng lộ bình an.\",\"rating\":9.0},\n  {\"id\":729912,\"suggestedTranslation\":\"Nó chết rồi.\",\"rating\":9.0},\n  {\"id\":729913,\"suggestedTranslation\":\"Lẽ ra ngươi nên nằm yên dưới mồ thì hơn.\",\"rating\":9.0},\n  {\"id\":729914,\"suggestedTranslation\":\"Nhà của những sinh vật tồi tệ nhất.\",\"rating\":9.0},\n  {\"id\":729915,\"suggestedTranslation\":\"Bị nhổ bật tận gốc.\",\"rating\":9.0},\n  {\"id\":729916,\"suggestedTranslation\":\"Mang đến cái chết ngọt ngào từ khoảng cách xa.\",\"rating\":9.0},\n  {\"id\":729917,\"suggestedTranslation\":\"Việc tôi không nghe thấy không có nghĩa là nó im lặng.\",\"rating\":9.0},\n  {\"id\":729918,\"suggestedTranslation\":\"Nó thật ngây thơ đến mức đáng ghen tị.\",\"rating\":9.0},\n  {\"id\":729919,\"suggestedTranslation\":\"Nó vẫn chưa nổi lên.\",\"rating\":9.0},\n  {\"id\":729920,\"suggestedTranslation\":\"Nó đã trở về trạng thái tự nhiên.\",\"rating\":9.0},\n  {\"id\":729921,\"suggestedTranslation\":\"Những mảnh vỡ tan trong trái tim tôi.\",\"rating\":9.0},\n  {\"id\":729922,\"suggestedTranslation\":\"Ồ, ước gì con tàu của tôi lao vút qua nó.\",\"rating\":9.0},\n  {\"id\":729923,\"suggestedTranslation\":\"Nó đã tan đi một chút rồi.\",\"rating\":9.0},\n  {\"id\":729924,\"suggestedTranslation\":\"Nó đã tan đi một chút rồi.\",\"rating\":9.0},\n  {\"id\":729925,\"suggestedTranslation\":\"Nó lạnh giá hệt như trái tim tôi.\",\"rating\":9.0},\n  {\"id\":729926,\"suggestedTranslation\":\"Kem tươi không bao giờ có thể thay thế được Abigail.\",\"rating\":9.0},\n  {\"id\":729927,\"suggestedTranslation\":\"Giữ cho đầu óc thật tỉnh táo.\",\"rating\":9.0},\n  {\"id\":729928,\"suggestedTranslation\":\"Hắn có một trái tim lạnh lẽo và vô hồn.\",\"rating\":9.0},\n  {\"id\":729929,\"suggestedTranslation\":\"Không gì có thể cách ly chúng ta khỏi những nỗi kinh hoàng của thế giới này.\",\"rating\":9.0},\n  {\"id\":729930,\"suggestedTranslation\":\"Một cây quyền năng để đóng băng.\",\"rating\":9.0},\n  {\"id\":729931,\"suggestedTranslation\":\"Giá lạnh và thống khổ.\",\"rating\":9.0},\n  {\"id\":729932,\"suggestedTranslation\":\"Trái tim tôi vốn dĩ đã lạnh giá như băng đá.\",\"rating\":9.0},\n  {\"id\":729933,\"suggestedTranslation\":\"Nó phản chiếu sự lạnh giá mà tôi cảm nhận ở bên trong.\",\"rating\":9.0},\n  {\"id\":729934,\"suggestedTranslation\":\"Nó đang gọi tên tôi.\",\"rating\":9.0},\n  {\"id\":729935,\"suggestedTranslation\":\"Nó lạnh ngắt và đen thui.\",\"rating\":9.0},\n  {\"id\":729936,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":10.0},\n  {\"id\":729937,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":10.0},\n  {\"id\":729938,\"suggestedTranslation\":\"Chúng không thể cho tôi thấy thứ mình đang tìm kiếm.\",\"rating\":9.0},\n  {\"id\":729939,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":10.0},\n  {\"id\":729940,\"suggestedTranslation\":\"Khi nhìn vào gương, cứ như thể Abigail đang ở đây vậy.\",\"rating\":9.0},\n  {\"id\":729941,\"suggestedTranslation\":\"Tôi muốn một loại thuốc độc nào đỡ hôi hơn một chút, làm ơn.\",\"rating\":9.0},\n  {\"id\":729942,\"suggestedTranslation\":\"Tôi đoán mình phải xứng đáng nhận lấy điều này.\",\"rating\":9.0},\n  {\"id\":729943,\"suggestedTranslation\":\"Lượng mứt hoàn hảo.\",\"rating\":9.0},\n  {\"id\":729944,\"suggestedTranslation\":\"Những hạt đậu sẽ chẳng bao giờ biết đến sự sống.\",\"rating\":9.0},\n  {\"id\":729945,\"suggestedTranslation\":\"Liệu có thứ gì đáng giá ẩn giấu sâu bên trong không?\",\"rating\":9.0},\n  {\"id\":729946,\"suggestedTranslation\":\"Em có thấy cái gì ở trên đó không, Abigail?\",\"rating\":9.0},\n  {\"id\":729947,\"suggestedTranslation\":\"Nó sắp sụp đổ rồi... biết đâu tôi sẽ ở đây khi điều đó xảy ra.\",\"rating\":9.0},\n  {\"id\":729948,\"suggestedTranslation\":\"Bình thường là được rồi. Tại sao phải mong đợi điều gì hơn thế?\",\"rating\":9.0},\n  {\"id\":729949,\"suggestedTranslation\":\"Thịt xiên xuyên thẳng qua trung tâm.\",\"rating\":9.0},\n  {\"id\":729950,\"suggestedTranslation\":\"Nó... tôi không biết nữa. Thở dài.\",\"rating\":9.0},\n  {\"id\":729951,\"suggestedTranslation\":\"Những sợi rong biển quá trơn trượt, nó sắp rã ra rồi.\",\"rating\":9.0},\n  {\"id\":729952,\"suggestedTranslation\":\"Những gì chúng ta làm để duy trì sự sống.\",\"rating\":9.0},\n  {\"id\":729953,\"suggestedTranslation\":\"Chúng ta lôi nó ra khỏi đại dương, rồi lại hút cạn đại dương khỏi nó.\",\"rating\":9.0},\n  {\"id\":729954,\"suggestedTranslation\":\"Một con ong không có lương tâm.\",\"rating\":9.0},\n  {\"id\":729955,\"suggestedTranslation\":\"Hãy yên lặng nào, bé con.\",\"rating\":9.0},\n  {\"id\":729956,\"suggestedTranslation\":\"Sẽ chẳng còn niềm vui nào nữa.\",\"rating\":9.0},\n  {\"id\":729957,\"suggestedTranslation\":\"Đây không phải là gia cầm thật.\",\"rating\":9.0},\n  {\"id\":729958,\"suggestedTranslation\":\"Nó chỉ tạo ra sự phân tâm nhất thời mà thôi.\",\"rating\":9.0},\n  {\"id\":729959,\"suggestedTranslation\":\"Hạnh phúc chỉ là Phù du.\",\"rating\":9.0},\n  {\"id\":729960,\"suggestedTranslation\":\"Nó đánh lừa chúng bằng lời hứa về sự sống.\",\"rating\":9.0},\n  {\"id\":729961,\"suggestedTranslation\":\"Nó chỉ tạo ra sự phân tâm nhất thời mà thôi.\",\"rating\":9.0},\n  {\"id\":729962,\"suggestedTranslation\":\"Mọi thứ đều phải kết thúc.\",\"rating\":9.0},\n  {\"id\":729963,\"suggestedTranslation\":\"Nơi những dã thú lui tới.\",\"rating\":9.0},\n  {\"id\":729964,\"suggestedTranslation\":\"Chúng đã bỏ rơi tôi lại phía sau...\",\"rating\":9.0},\n  {\"id\":729965,\"suggestedTranslation\":\"Dòng chảy thời gian thật vô tình.\",\"rating\":9.0},\n  {\"id\":729966,\"suggestedTranslation\":\"Ồ, ước gì được trẻ trung và không bận tâm đến những âu lo của cuộc đời.\",\"rating\":9.0},\n  {\"id\":729967,\"suggestedTranslation\":\"Nhỏ bé và ngây thơ. Giống như tôi ngày trước...\",\"rating\":9.0},\n  {\"id\":729968,\"suggestedTranslation\":\"Nhỏ bé và ngây thơ. Giống như tôi ngày trước...\",\"rating\":9.0},\n  {\"id\":729969,\"suggestedTranslation\":\"Nhỏ bé và ngây thơ. Giống như tôi ngày trước...\",\"rating\":9.0},\n  {\"id\":729970,\"suggestedTranslation\":\"Nhỏ bé và ngây thơ. Giống như tôi ngày trước...\",\"rating\":9.0},\n  {\"id\":729971,\"suggestedTranslation\":\"Nhỏ bé và ngây thơ. Giống như tôi ngày trước...\",\"rating\":9.0},\n  {\"id\":729972,\"suggestedTranslation\":\"Nhỏ bé và ngây thơ. Giống như tôi ngày trước...\",\"rating\":9.0},\n  {\"id\":729973,\"suggestedTranslation\":\"Thật quá đau lòng khi trở nên gắn bó với một thứ gì đó.\",\"rating\":9.0},\n  {\"id\":729974,\"suggestedTranslation\":\"Nhỏ bé và ngây thơ. Giống như tôi ngày trước...\",\"rating\":9.0},\n  {\"id\":729975,\"suggestedTranslation\":\"Nhỏ bé và ngây thơ. Giống như tôi ngày trước...\",\"rating\":9.0},\n  {\"id\":729976,\"suggestedTranslation\":\"Nhỏ bé và ngây thơ. Giống như tôi ngày trước...\",\"rating\":9.0},\n  {\"id\":729977,\"suggestedTranslation\":\"Tôi nhìn thấy hắn trong những giấc mơ...\",\"rating\":9.0},\n  {\"id\":729978,\"suggestedTranslation\":\"Chìa khóa dẫn đến sự thịnh vượng của chúng ta...\",\"rating\":9.0},\n  {\"id\":729979,\"suggestedTranslation\":\"Liệu chúng ta có nên lén nhìn vào bên trong không...?\",\"rating\":9.0},\n  {\"id\":729980,\"suggestedTranslation\":\"Một cỗ mã tấu lạnh lùng, vô hồn.\",\"rating\":9.0},\n  {\"id\":729981,\"suggestedTranslation\":\"Lại một trận chiến nữa bị thời gian vùi lấp.\",\"rating\":9.0},\n  {\"id\":729982,\"suggestedTranslation\":\"Bạn mới trung thành làm sao.\",\"rating\":9.0},\n  {\"id\":729983,\"suggestedTranslation\":\"Ngươi phục vụ ai thế, hiệp sĩ thân mến?\",\"rating\":9.0},\n  {\"id\":729984,\"suggestedTranslation\":\"Đồ vũ phu, tất cả các người!\",\"rating\":9.0},\n  {\"id\":729985,\"suggestedTranslation\":\"Không hiểu sao, nó lại an ủi tôi.\",\"rating\":9.0},\n  {\"id\":729986,\"suggestedTranslation\":\"Một loài thú cô độc.\",\"rating\":9.0},\n  {\"id\":729987,\"suggestedTranslation\":\"Nó hiên ngang chống lại thời tiết khắc nghiệt.\",\"rating\":9.0},\n  {\"id\":729988,\"suggestedTranslation\":\"Thật khủng khiếp.\",\"rating\":9.0},\n  {\"id\":729989,\"suggestedTranslation\":\"Xin chào, sinh vật bỉ ổi đến từ địa ngục.\",\"rating\":9.0},\n  {\"id\":729990,\"suggestedTranslation\":\"Nó có mùi dê.\",\"rating\":9.0},\n  {\"id\":729991,\"suggestedTranslation\":\"Soi sáng con đường, một cách u tối.\",\"rating\":9.0},\n  {\"id\":729992,\"suggestedTranslation\":\"Chúng... khá ngon đấy chứ.\",\"rating\":9.0},\n  {\"id\":729993,\"suggestedTranslation\":\"Thế giới này chẳng có gì ngoài nỗi đau.\",\"rating\":9.0},\n  {\"id\":729994,\"suggestedTranslation\":\"Lớp bảo vệ nặng nề cho trái tim một người.\",\"rating\":9.0},\n  {\"id\":729995,\"suggestedTranslation\":\"Giá như trái tim tôi cũng nhẹ nhàng được như thế.\",\"rating\":9.0},\n  {\"id\":729996,\"suggestedTranslation\":\"Chúng phải bắt được tôi thì mới tổn thương được tôi.\",\"rating\":9.0},\n  {\"id\":729997,\"suggestedTranslation\":\"Bảo vệ khung xương mỏng manh của tôi.\",\"rating\":9.0},\n  {\"id\":729998,\"suggestedTranslation\":\"Ngay cả giáp của chúng ta cũng có nanh vuốt.\",\"rating\":9.0},\n  {\"id\":729999,\"suggestedTranslation\":\"Nó sẽ khôi phục lại sức mạnh cho một người.\",\"rating\":9.0},\n  {\"id\":730000,\"suggestedTranslation\":\"Nó bảo vệ khỏi sát thương, nhưng không khỏi nỗi buồn.\",\"rating\":9.0},\n  {\"id\":730001,\"suggestedTranslation\":\"Cờ Hiệu Chiến Đấu đó cần phải bị phá hủy...\",\"rating\":9.0},\n  {\"id\":730002,\"suggestedTranslation\":\"Bạn dạo này thế nào rồi, Bernie?\",\"rating\":9.0},\n  {\"id\":730003,\"suggestedTranslation\":\"Một kẻ nhẫn tâm.\",\"rating\":9.0},\n  {\"id\":730004,\"suggestedTranslation\":\"Tôi tiên cảm thấy một làn sóng chết chóc.\",\"rating\":9.0},\n  {\"id\":730005,\"suggestedTranslation\":\"Khi nào thì ngươi mới được giải thoát khỏi sự đày đọa này?\",\"rating\":9.0},\n  {\"id\":730006,\"suggestedTranslation\":\"Có một sức mạnh hiểm độc ẩn chứa bên trong.\",\"rating\":9.0},\n  {\"id\":730007,\"suggestedTranslation5\":\"Nhưng còn những con chim thì sao?\",\"rating\":9.0},\n  {\"id\":730008,\"suggestedTranslation\":\"Một trận mưa bom đau khổ.\",\"rating\":9.0},\n  {\"id\":730009,\"suggestedTranslation\":\"Nó làm dịu cơn đau thể xác, nhưng không xoa dịu được trái tim.\",\"rating\":9.0},\n  {\"id\":730010,\"suggestedTranslation\":\"Nhưng liệu nó có chữa lành linh hồn tôi không?\",\"rating\":9.0},\n  {\"id\":730011,\"suggestedTranslation\":\"Nó quá nặng. Giống như linh hồn tôi vậy.\",\"rating\":9.0},\n  {\"id\":730012,\"suggestedTranslation\":\"Trống rỗng hệt như trái tim tôi.\",\"rating\":9.0},\n  {\"id\":730013,\"suggestedTranslation\":\"Ngập tràn như những nỗi buồn của tôi.\",\"rating\":9.0},\n  {\"id\":730014,\"suggestedTranslation\":\"Nó mang thêm đau khổ vào thế giới này.\",\"rating\":9.0},\n  {\"id\":730015,\"suggestedTranslation\":\"Lại gặp nhau rồi, Lucy.\",\"rating\":9.0},\n  {\"id\":730016,\"suggestedTranslation\":\"Tôi không dám hy vọng nó sẽ đưa mình về nhà.\",\"rating\":9.0},\n  {\"id\":730017,\"suggestedTranslation\":\"Xin chúc các vị một ngày tốt lành.\",\"rating\":9.0},\n  {\"id\":730018,\"suggestedTranslation\":\"Tôi sẽ có thể tấn công thường xuyên hơn...\",\"rating\":9.0},\n  {\"id\":730019,\"suggestedTranslation\":\"Đó là nơi chúng chui ra từ...\",\"rating\":9.0},\n  {\"id\":730020,\"suggestedTranslation\":\"Đánh mạnh hơn, mạnh mẽ hơn...\",\"rating\":9.0},\n  {\"id\":730021,\"suggestedTranslation\":\"Người đội nó sẽ trở thành một thế lực thiện lương.\",\"rating\":9.0},\n  {\"id\":730022,\"suggestedTranslation\":\"Nó đang cháy rực với ngọn lửa địa ngục.\",\"rating\":9.0},\n  {\"id\":730023,\"suggestedTranslation\":\"Máu lạnh.\",\"rating\":9.0},\n  {\"id\":730024,\"suggestedTranslation\":\"Liệu có đáng để đặt cược vào tương lai của ngươi không?\",\"rating\":9.0},\n  {\"id\":730025,\"suggestedTranslation\":\"Quả trứng này gần như lạnh ngắt giống như trái tim tôi.\",\"rating\":9.0},\n  {\"id\":730026,\"suggestedTranslation\":\"Quả trứng thì ấm áp, nhưng trái tim tôi vẫn lạnh giá.\",\"rating\":9.0},\n  {\"id\":730027,\"suggestedTranslation\":\"Hãy tận hưởng hạnh phúc khi nó còn kéo dài nhé, trùng nham nhỏ.\",\"rating\":9.0},\n  {\"id\":730028,\"suggestedTranslation\":\"Một tia hy vọng thắp sáng bóng đêm.\",\"rating\":9.0},\n  {\"id\":730029,\"suggestedTranslation\":\"Nó đang chịu đựng sự cắn xé của cơn đói.\",\"rating\":9.0},\n  {\"id\":730030,\"suggestedTranslation\":\"Nó đang tiến gần đến cái chết.\",\"rating\":9.0},\n  {\"id\":730031,\"suggestedTranslation\":\"Thật vậy, đó là một chiếc răng.\",\"rating\":9.0},\n  {\"id\":730032,\"suggestedTranslation\":\"Nó đã nguội đi và 