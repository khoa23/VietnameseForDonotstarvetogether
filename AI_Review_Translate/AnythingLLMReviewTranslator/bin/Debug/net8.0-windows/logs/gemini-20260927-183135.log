rating\":1.0},\n  {\"id\":730537,\"suggestedTranslation\":\"Cứ tận hưởng đi chừng nào còn có thể, Tệ hạ.\",\"rating\":1.0},\n  {\"id\":730538,\"suggestedTranslation\":\"Bây giờ thì hắn thấy khỏe hơn rồi đấy.\",\"rating\":1.0},\n  {\"id\":730539,\"suggestedTranslation\":\"Em vẫn cảm thấy cô đơn.\",\"rating\":1.0},\n  {\"id\":730540,\"suggestedTranslation\":\"Chúng thật là xa cách.\",\"rating\":1.0},\n  {\"id\":730541,\"suggestedTranslation\":\"Đúng là phong cách Orwell.\",\"rating\":1.0},\n  {\"id\":730542,\"suggestedTranslation\":\"Một sinh vật của màn đêm!\",\"rating\":1.0},\n  {\"id\":730543,\"suggestedTranslation\":\"Tro lại với tro.\",\"rating\":1.0},\n  {\"id\":730544,\"suggestedTranslation\":\"Nó cần một vật hiến tế bằng thịt.\",\"rating\":1.0},\n  {\"id\":730545,\"suggestedTranslation\":\"Một lời ca tụng sự tham ăn.\",\"rating\":1.0},\n  {\"id\":730546,\"suggestedTranslation\":\"Tấm da của một con heo từng tồn tại.\",\"rating\":1.0},\n  {\"id\":730547,\"suggestedTranslation\":\"Nơi lũ heo được cuộn tròn trong chăn.\",\"rating\":1.0},\n  {\"id\":730548,\"suggestedTranslation\":\"Nó xuyên thủng bóng đêm.\",\"rating\":1.0},\n  {\"id\":730549,\"suggestedTranslation\":\"Nó trả tiền cho một tình bạn mong manh.\",\"rating\":1.0},\n  {\"id\":730550,\"suggestedTranslation\":\"Lại thêm một món đồ chơi vô tích sự nữa.\",\"rating\":1.0},\n  {\"id\":730551,\"suggestedTranslation\":\"Một mầm sống nhỏ bé, ẩn mình trong cái chết giòn tan.\",\"rating\":1.0},\n  {\"id\":730552,\"suggestedTranslation\":\"Một cái cây sẽ sớm mọc lên thôi.\",\"rating\":1.0},\n  {\"id\":730553,\"suggestedTranslation\":\"Mấy con khỉ đó thật thiếu trí tưởng tượng. Tao còn thấy mấy bức vẽ của trẻ con rùng rợn hơn thế này nhiều.\",\"rating\":1.0},\n  {\"id\":730554,\"suggestedTranslation\":\"Ồ... liệu em đã... tìm thấy kho báu chưa?\",\"rating\":1.0},\n  {\"id\":730555,\"suggestedTranslation\":\"Đúng là một công cụ ma quái!\",\"rating\":1.0},\n  {\"id\":730556,\"suggestedTranslation\":\"Nó có mùi hôi t