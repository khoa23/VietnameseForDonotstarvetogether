            "text": "[\n  {\"id\":730780,\"suggestedTranslation\":\"Nó đang lang thang vô định, hoàn toàn phớt lờ số phận của mình.\",\"rating\":9.0},\n  {\"id\":730781,\"suggestedTranslation\":\"Nó đang ở trong vòng tay an toàn của tôi.\",\"rating\":9.0},\n  {\"id\":730782,\"suggestedTranslation\":\"Được rồi. Nó đáng yêu đấy.\",\"rating\":9.0},\n  {\"id\":730783,\"suggestedTranslation\":\"Tôi quá lớn để rơi xuống dưới đó.\",\"rating\":9.0},\n  {\"id\":730784,\"suggestedTranslation\":\"Nó bị bịt kín rồi. Giờ thì chẳng ai rơi xuống đó được nữa đâu.\",\"rating\":9.0},\n  {\"id\":730785,\"suggestedTranslation\":\"Nó nấu không ngon lắm.\",\"rating\":9.0},\n  {\"id\":730786,\"suggestedTranslation\":\"Nó không dễ ăn như vẻ bề ngoài đâu.\",\"rating\":9.0},\n  {\"id\":730787,\"suggestedTranslation\":\"Chắc là nó tấu lên một khúc nhạc đưa tang.\",\"rating\":9.0},\n  {\"id\":730788,\"suggestedTranslation\":\"Nó giống như một ngôi mộ cho đống đồ đạc của tôi vậy.\",\"rating\":9.0},\n  {\"id\":730789,\"suggestedTranslation\":\"Ngươi đang làm ta nổi giận đấy.\",\"rating\":9.0},\n  {\"id\":730790,\"suggestedTranslation\":\"Chết dưới gạc thỏ á. Dễ thương ghê.\",\"rating\":9.0},\n  {\"id\":730791,\"suggestedTranslation\":\"Tâm trạng nó đang tồi tệ lắm đấy.\",\"rating\":9.0},\n  {\"id\":730792,\"suggestedTranslation\":\"Tôi nên quan sát kỹ hơn mới được.\",\"rating\":9.0},\n  {\"id\":730793,\"suggestedTranslation\":\"Trông hắn có vẻ khá thân thiện.\",\"rating\":9.0},\n  {\"id\":730794,\"suggestedTranslation\":\"Tôi rất thích nhảy vào vũng nước cùng Abigail.\",\"rating\":9.0},\n  {\"id\":730795,\"suggestedTranslation\":\"Trời mưa mà không bị ướt thì có gì là vui chứ?\",\"rating\":9.0},\n  {\"id\":730796,\"suggestedTranslation\":\"Điều đó có nghĩa là ánh nắng cũng đã chết rồi sao?\",\"rating\":9.0},\n  {\"id\":730797,\"suggestedTranslation\":\"Nó đo mức độ mây phủ. Tôi thích những lúc u ám thế này.\",\"rating\":9.0},\n  {\"id\":730798,\"suggestedTranslation\":\"Một nùi rau củ nấu chín. Thật lôi cuốn làm sao.\",\"rating\":9.0},\n  {\"id\":730799,\"suggestedTranslation\":\"Cái này chỉ dùng để cạo râu thôi.\",\"rating\":9.0},\n  {\"id\":730800,\"suggestedTranslation\":\"Tôi tự hỏi liệu mình có bao giờ được nghe lại bài hát đó nữa không.\",\"rating\":9.0},\n  {\"id\":730801,\"suggestedTranslation\":\"Nó làm tâm trạng tôi tươi tắn hơn, dẫu chỉ là trong chốc lát.\",\"rating\":9.0},\n  {\"id\":730802,\"suggestedTranslation\":\"Bản nhạc này có làm tâm hồn bạn khá lên chút nào không, Abigail?\",\"rating\":9.0},\n  {\"id\":730803,\"suggestedTranslation\":\"Bản nhạc này có làm tâm hồn bạn khá lên chút nào không, Abigail?\",\"rating\":9.0},\n  {\"id\":730804,\"suggestedTranslation\":\"Bản nhạc này có làm tâm hồn bạn khá lên chút nào không, Abigail?\",\"rating\":9.0},\n  {\"id\":730805,\"suggestedTranslation\":\"Bản nhạc này có làm tâm hồn bạn khá lên chút nào không, Abigail?\",\"rating\":9.0},\n  {\"id\":730806,\"suggestedTranslation\":\"Tôi tự hỏi liệu cha còn nghe bộ sưu tập đĩa hát của ông ấy không.\",\"rating\":9.0},\n  {\"id\":730807,\"suggestedTranslation\":\"Một giai điệu mang điềm báo ngọt ngào.\",\"rating\":9.0},\n  {\"id\":730808,\"suggestedTranslation\":\"Tôi tự hỏi liệu cha còn nghe bộ sưu tập đĩa hát của ông ấy không.\",\"rating\":9.0},\n  {\"id\":730809,\"suggestedTranslation\":\"Thích thật đấy.\",\"rating\":9.0},\n  {\"id\":730810,\"suggestedTranslation\":\"Tôi tự hỏi liệu cha còn nghe bộ sưu tập đĩa hát của ông ấy không.\",\"rating\":9.0},\n  {\"id\":730811,\"suggestedTranslation\":\"Tôi tự hỏi liệu cha còn nghe bộ sưu tập đĩa hát của ông ấy không.\",\"rating\":9.0},\n  {\"id\":730812,\"suggestedTranslation\":\"Đỏ như máu trong tim tôi.\",\"rating\":9.0},\n  {\"id\":730813,\"suggestedTranslation\":\"Một ánh sáng dẫn đường cho tôi.\",\"rating\":9.0},\n  {\"id\":730814,\"suggestedTranslation\":\"Giờ thì Wolfgang sẽ không bị \\\"lạc\\\" nữa khi tôi rủ anh ấy chơi cùng.\",\"rating\":9.0},\n  {\"id\":730815,\"suggestedTranslation\":\"Điều gì đang ẩn giấu bên trong nhỉ?\",\"rating\":9.0},\n  {\"id\":730816,\"suggestedTranslation\":\"Một cây nấm tri kỷ.\",\"rating\":9.0},\n  {\"id\":730817,\"suggestedTranslation\":\"Mọi thứ đều có thể nhào nặn được.\",\"rating\":9.0},\n  {\"id\":730818,\"suggestedTranslation\":\"Ẩm ướt.\",\"rating\":9.0},\n  {\"id\":730819,\"suggestedTranslation\":\"Tôi cũng sẽ trốn đi, nếu có thể.\",\"rating\":9.0},\n  {\"id\":730820,\"suggestedTranslation\":\"Đã được thu hoạch.\",\"rating\":9.0},\n  {\"id\":730821,\"suggestedTranslation\":\"Chẳng mấy chốc sẽ thành tro bụi.\",\"rating\":9.0},\n  {\"id\":730822,\"suggestedTranslation\":\"Đó chỉ là một đám cây sậy thôi.\",\"rating\":9.0},\n  {\"id\":730823,\"suggestedTranslation\":\"Chúng đã bị giật đứt từ trước rồi.\",\"rating\":9.0},\n  {\"id\":730824,\"suggestedTranslation\":\"Bụi chuyển thành... bụi đặc hơn một chút.\",\"rating\":9.0},\n  {\"id\":730825,\"suggestedTranslation\":\"Cái gì cũng có thể thành áo ghi-lê cả.\",\"rating\":9.0},\n  {\"id\":730826,\"suggestedTranslation\":\"Một tàn tích từ thế giới cổ đại.\",\"rating\":9.0},\n  {\"id\":730827,\"suggestedTranslation\":\"Nó bị thiêu rụi đến mức không thể thốt nên lời.\",\"rating\":9.0},\n  {\"id\":730828,\"suggestedTranslation\":\"Tôi sẽ học những điều không thể nói nên lời.\",\"rating\":9.0},\n  {\"id\":730829,\"suggestedTranslation\":\"Nó bị thiêu rụi đến mức không thể thốt nên lời.\",\"rating\":9.0},\n  {\"id\":730830,\"suggestedTranslation\":\"Tôi sẽ học những điều không thể nói nên lời.\",\"rating\":9.0},\n  {\"id\":730831,\"suggestedTranslation\":\"Nó bị thiêu rụi đến mức không thể thốt nên lời.\",\"rating\":9.0},\n  {\"id\":730832,\"suggestedTranslation\":\"Tôi đã học được những điều không thể nói nên lời.\",\"rating\":9.0},\n  {\"id\":730833,\"suggestedTranslation\":\"Sự điên loạn mang đến lửa.\",\"rating\":9.0},\n  {\"id\":730834,\"suggestedTranslation\":\"Đây chỉ là một bước ngắn cách sự điên loạn.\",\"rating\":9.0},\n  {\"id\":730835,\"suggestedTranslation\":\"Sự thay đổi... không phải lúc nào cũng tồi tệ.\",\"rating\":9.0},\n  {\"id\":730836,\"suggestedTranslation\":\"Tôi mừng vì chiếc két sắt dự phòng đó đã biến mất.\",\"rating\":9.0},\n  {\"id\":730837,\"suggestedTranslation\":\"Nó chỉ đang trì hoãn cái kết tất yếu thôi.\",\"rating\":9.0},\n  {\"id\":730838,\"suggestedTranslation\":\"Một sự bảo vệ vô vọng.\",\"rating\":9.0},\n  {\"id\":730839,\"suggestedTranslation\":\"Mọi lựa chọn đều quan trọng.\",\"rating\":9.0},\n  {\"id\":730840,\"suggestedTranslation\":\"Tình nghĩa anh em sẽ không cứu được ngươi đâu.\",\"rating\":9.0},\n  {\"id\":730841,\"suggestedTranslation\":\"Ngày lễ đã phải kết thúc sớm với chú chim tội nghiệp này.\",\"rating\":9.0},\n  {\"id\":730842,\"suggestedTranslation\":\"Điều đó có nghĩa là mùa xuân sắp đến á? Mong là không phải thế.\",\"rating\":9.0},\n  {\"id\":730843,\"suggestedTranslation\":\"Nó thích bị kẹt trong túi của tôi.\",\"rating\":9.0},\n  {\"id\":730844,\"suggestedTranslation\":\"Cuộc sống nơi vùng đất hoang vu, băng giá.\",\"rating\":9.0},\n  {\"id\":730845,\"suggestedTranslation\":\"Nó mềm quá. Nó chính là kẻ thù của tôi.\",\"rating\":9.0},\n  {\"id\":730846,\"suggestedTranslation\":\"Ước gì được bọc trong một lớp vỏ cứng cáp và vô cảm...\",\"rating\":9.0},\n  {\"id\":730847,\"suggestedTranslation\":\"Không biết họ đã làm những gì nhỉ.\",\"rating\":9.0},\n  {\"id\":730848,\"suggestedTranslation\":\"Ngay cả thứ đó cũng chẳng phải là vĩnh cửu.\",\"rating\":9.0},\n  {\"id\":730849,\"suggestedTranslation\":\"Mấy cục đá nhỏ ấy mà.\",\"rating\":9.0},\n  {\"id\":730850,\"suggestedTranslation\":\"Chúng đã chứng kiến những cảnh tượng khủng khiếp nhường nào.\",\"rating\":9.0},\n  {\"id\":730851,\"suggestedTranslation\":\"Nó sẽ không bao giờ ra quả nữa đâu.\",\"rating\":9.0},\n  {\"id\":730852,\"suggestedTranslation\":\"Ồ. Nó đang cháy kìa.\",\"rating\":9.0},\n  {\"id\":730853,\"suggestedTranslation\":\"Nó đã bị vấy bẩn. Đã nhiễm bệnh rồi.\",\"rating\":9.0},\n  {\"id\":730854,\"suggestedTranslation\":\"Sự đồi bại đang lan rộng bên trong nó.\",\"rating\":9.0},\n  {\"id\":730855,\"suggestedTranslation\":\"Nó vừa ra quả kìa.\",\"rating\":9.0},\n  {\"id\":730856,\"suggestedTranslation\":\"Nó chẳng có gì để cho tôi cả.\",\"rating\":9.0},\n  {\"id\":730857,\"suggestedTranslation\":\"Tôi cũng thấy tơi tả chẳng kém gì nó.\",\"rating\":9.0},\n  {\"id\":730858,\"suggestedTranslation\":\"Nó mọc trên cây, nhưng trông giống một hòn đá tảng.\",\"rating\":9.0},\n  {\"id\":730859,\"suggestedTranslation\":\"Giờ tôi ăn được nó rồi.\",\"rating\":9.0},\n  {\"id\":730860,\"suggestedTranslation\":\"Lúc này thì có khi nó lại ngon thật đấy.\",\"rating\":9.0},\n  {\"id\":730861,\"suggestedTranslation\":\"Sao ngươi cứ phải kiên trì làm gì?\",\"rating\":9.0},\n  {\"id\":730862,\"suggestedTranslation\":\"Một khối băng giá lạnh, vô cảm to lớn.\",\"rating\":9.0},\n  {\"id\":730863,\"suggestedTranslation\":\"Một vũng nước băng đá tan mát lạnh to lớn.\",\"rating\":9.0},\n  {\"id\":730864,\"suggestedTranslation\":\"Một vũng nước băng đá tan mát lạnh to lớn.\",\"rating\":9.0},\n  {\"id\":730865,\"suggestedTranslation\":\"Có một ngọn lửa trong bụng hố lửa kìa.\",\"rating\":9.0},\n  {\"id\":730866,\"suggestedTranslation\":\"Bóng tối đang xâm chiếm.\",\"rating\":9.0},\n  {\"id\":730867,\"suggestedTranslation\":\"Dung nham đang bốc lửa.\",\"rating\":9.0},\n  {\"id\":730868,\"suggestedTranslation\":\"Dung nham đã mất đi ý chí cháy bùng...\",\"rating\":9.0},\n  {\"id\":730869,\"suggestedTranslation\":\"Nó đã đi một quãng đường thật dài...\",\"rating\":9.0},\n  {\"id\":730870,\"suggestedTranslation\":\"Giờ thì nó sẽ không bao giờ chết nữa...\",\"rating\":9.0},\n  {\"id\":730871,\"suggestedTranslation\":\"Giờ thì nó sẽ không bao giờ chết nữa...\",\"rating\":9.0},\n  {\"id\":730872,\"suggestedTranslation\":\"Một con Xe? Hay là một tòa lâu đài nhỉ?\",\"rating\":9.0},\n  {\"id\":730873,\"suggestedTranslation\":\"Thời gian mài mòn vạn vật.\",\"rating\":9.0},\n  {\"id\":730874,\"suggestedTranslation\":\"Đó sẽ là lối thoát dễ dàng khỏi nơi này.\",\"rating\":9.0},\n  {\"id\":730875,\"suggestedTranslation\":\"Một sợi dây thừng bắc qua vực sâu.\",\"rating\":9.0},\n  {\"id\":730876,\"suggestedTranslation\":\"Mong là cậu sẽ tìm thấy cô ấy.\",\"rating\":9.0},\n  {\"id\":730877,\"suggestedTranslation\":\"only_used_by_winona\",\"rating\":9.0},\n  {\"id\":730878,\"suggestedTranslation\":\"Quy luật của vạn vật.\",\"rating\":9.0},\n  {\"id\":730879,\"suggestedTranslation\":\"Chúng ta đã cướp nó từ miệng của những con ong non.\",\"rating\":9.0},\n  {\"id\":730880,\"suggestedTranslation\":\"Những mảnh vụn đá vỡ.\",\"rating\":9.0},\n  {\"id\":730881,\"suggestedTranslation\":\"Abigail chắc chắn sẽ rất thích chiếc vương miện này.\",\"rating\":9.0},\n  {\"id\":730882,\"suggestedTranslation\":\"Nó sở hữu sức mạnh của các bậc tiền bối.\",\"rating\":9.0},\n  {\"id\":730883,\"suggestedTranslation\":\"Một đống những giấc mơ tan vỡ.\",\"rating\":9.0},\n  {\"id\":730884,\"suggestedTranslation\":\"Nó mang hơi thở của cái chết.\",\"rating\":9.0},\n  {\"id\":730885,\"suggestedTranslation\":\"Nó đang phán xét tận sâu tâm can tôi.\",\"rating\":9.0},\n  {\"id\":730886,\"suggestedTranslation\":\"Tôi chỉ đang lấy lại những gì thuộc về mình thôi.\",\"rating\":9.0},\n  {\"id\":730887,\"suggestedTranslation\":\"Cứ như thể nó chưa đủ gánh nặng bởi ách thống trị của cuộc đời vậy...\",\"rating\":9.0},\n  {\"id\":730888,\"suggestedTranslation\":\"Quá nhiều sự kỳ quặc khiến tôi khó tiêu.\",\"rating\":9.0},\n  {\"id\":730889,\"suggestedTranslation\":\"Ngồi càng cao thì ngã càng đau.\",\"rating\":9.0},\n  {\"id\":730890,\"suggestedTranslation\":\"Ồ, cách chúng ta bắt những sinh vật khác phải phục tùng ý đồ đen tối của mình kìa.\",\"rating\":9.0},\n  {\"id\":730891,\"suggestedTranslation\":\"Nó có cánh, nhưng sẽ chẳng bao giờ bay được.\",\"rating\":9.0},\n  {\"id\":730892,\"suggestedTranslation\":\"Tôi chẳng có mấy tâm trạng để nhảy nhót đâu.\",\"rating\":9.0},\n  {\"id\":730893,\"suggestedTranslation\":\"Nó chỉ kéo dài thêm cái kết tất yếu thôi.\",\"rating\":9.0},\n  {\"id\":730894,\"suggestedTranslation\":\"Lũ thú đang khao khát nó...\",\"rating\":9.0},\n  {\"id\":730895,\"suggestedTranslation\":\"Mặn chát như nước mắt vậy.\",\"rating\":9.0},\n  {\"id\":730896,\"suggestedTranslation\":\"Gần như mặn đắng bằng những giọt nước mắt cay đắng của tôi.\",\"rating\":9.0},\n  {\"id\":730897,\"suggestedTranslation\":\"Những hình thù đó trông không tự nhiên chút nào.\",\"rating\":9.0},\n  {\"id\":730898,\"suggestedTranslation\":\"Vòng lặp lại bắt đầu.\",\"rating\":9.0},\n  {\"id\":730899,\"suggestedTranslation\":\"Nó đã bị phá hủy hoàn toàn rồi.\",\"rating\":9.0},\n  {\"id\":730900,\"suggestedTranslation\":\"Ngươi không phải chó săn... nhưng tôi sẽ châm chước cho qua.\",\"rating\":9.0},\n  {\"id\":730901,\"suggestedTranslation\":\"Đến lượt tôi đóng vai thuyền trưởng rồi đây.\",\"rating\":9.0},\n  {\"id\":730902,\"suggestedTranslation\":\"Sự nhạo báng đối với một tuổi thơ được cưng chiều.\",\"rating\":9.0},\n  {\"id\":730903,\"suggestedTranslation\":\"Hãy nhắm thẳng vào tim tôi này...\",\"rating\":9.0},\n  {\"id\":730904,\"suggestedTranslation\":\"Nó đang gọi tôi kìa.\",\"rating\":9.0},\n  {\"id\":730905,\"suggestedTranslation\":\"Ngay cả ngọn tháp đá này cũng bỏ rơi tôi.\",\"rating\":9.0},\n  {\"id\":730906,\"suggestedTranslation\":\"Đã hiến dâng cho ngọn lửa.\",\"rating\":9.0},\n  {\"id\":730907,\"suggestedTranslation\":\"Nó không còn sống được bao lâu nữa đâu...\",\"rating\":9.0},\n  {\"id\":730908,\"suggestedTranslation\":\"Nó đang ở bên bờ vực...\",\"rating\":9.0},\n  {\"id\":730909,\"suggestedTranslation\":\"Nó đang cố gắng lớn lên đấy.\",\"rating\":9.0},\n  {\"id\":730910,\"suggestedTranslation\":\"Hẹn lần sau nhé, cây nhỏ.\",\"rating\":9.0},\n  {\"id\":730911,\"suggestedTranslation\":\"Cái nóng oi bức đã đánh gục cây này rồi.\",\"rating\":9.0},\n  {\"id\":730912,\"suggestedTranslation\":\"Nếu may mắn, nó có thể khiến tôi buồn ngủ đến chết mất.\",\"rating\":9.0},\n  {\"id\":730913,\"suggestedTranslation\":\"Chọc tức lũ quạ lúc nào cũng là điềm gở cả.\",\"rating\":9.0},\n  {\"id\":730914,\"suggestedTranslation\":\"Giờ thì lũ quạ sẽ được yên thân rồi.\",\"rating\":9.0},\n  {\"id\":730915,\"suggestedTranslation\":\"Ai lại muốn xua đuổi lũ quạ làm gì chứ?\",\"rating\":9.0},\n  {\"id\":730916,\"suggestedTranslation\":\"Ngọn lửa đã thanh tẩy linh hồn khốn khổ và tội nghiệp này.\",\"rating\":9.0},\n  {\"id\":730917,\"suggestedTranslation\":\"Một trang sách lạc lõng và cô độc.\",\"rating\":9.0},\n  {\"id\":730918,\"suggestedTranslation\":\"Đầu tôi sẽ an toàn. Tuy nhiên, lòng tự trọng của tôi thì...\",\"rating\":9.0},\n  {\"id\":730919,\"suggestedTranslation\":\"Tôi sẽ chẳng tìm thấy thứ mình muốn đâu, dù có nhìn xa đến đâu đi nữa.\",\"rating\":9.0},\n  {\"id\":730920,\"suggestedTranslation\":\"Abigail... Cậu làm Thần Chết đi, còn tớ sẽ làm nhà điêu khắc...\",\"rating\":9.0},\n  {\"id\":730921,\"suggestedTranslation\":\"...Mình không thể thất vọng... Nếu mình chẳng mong đợi điều gì...\",\"rating\":9.0},\n  {\"id\":730922,\"suggestedTranslation\":\"Trông... v-vui phết nhỉ...\",\"rating\":9.0},\n  {\"id\":730923,\"suggestedTranslation\":\"Được đẽo gọt từ đá.\",\"rating\":9.0},\n  {\"id\":730924,\"suggestedTranslation\":\"Một sự tha hóa tuyệt đẹp đang gặm nhấm phần đế của nó...\",\"rating\":9.0},\n  {\"id\":730925,\"suggestedTranslation\":\"Không phải ai cũng có thể hàn gắn lại sau khi tan vỡ.\",\"rating\":9.0},\n  {\"id\":730926,\"suggestedTranslation\":\"Nó muốn ra ngoài...\",\"rating\":9.0},\n  {\"id\":730927,\"suggestedTranslation\":\"Đá cẩm thạch càng mòn đi, bức tượng càng lớn lên.\",\"rating\":9.0},\n  {\"id\":730928,\"suggestedTranslation\":\"Thứ này chui đến đây bằng cách nào thế?\",\"rating\":9.0},\n  {\"id\":730929,\"suggestedTranslation\":\"Có một vẻ đẹp bệnh hoạn ẩn chứa bên trong...\",\"rating\":9.0},\n  {\"id\":730930,\"suggestedTranslation\":\"Ước gì phần còn lại của chúng ta có thể lành lặn trở lại.\",\"rating\":9.0},\n  {\"id\":730931,\"suggestedTranslation\":\"Nó muốn ra ngoài...\",\"rating\":9.0},\n  {\"id\":730932,\"suggestedTranslation\":\"Tôi đoán ai trong chúng ta cũng có phần con quỷ ẩn giấu bên trong cả.\",\"rating\":9.0},\n  {\"id\":730933,\"suggestedTranslation\":\"Chém đầu hắn đi! Hi hi.\",\"rating\":9.0},\n  {\"id\":730934,\"suggestedTranslation\":\"Tôi thấy... buồn nôn quá...\",\"rating\":9.0},\n  {\"id\":730935,\"suggestedTranslation\":\"Nó đã được hàn gắn lại rồi. May mắn thật.\",\"rating\":9.0},\n  {\"id\":730936,\"suggestedTranslation\":\"Nó muốn ra ngoài...\",\"rating\":9.0},\n  {\"id\":730937,\"suggestedTranslation\":\"Có lẽ nó muốn che giấu sự xấu hổ về hình hài quái dị của mình chăng?\",\"rating\":9.0},\n  {\"id\":730938,\"suggestedTranslation\":\"Những mảnh đá cẩm thạch kỳ lạ...\",\"rating\":9.0},\n  {\"id\":730939,\"suggestedTranslation\":\"Lại thêm một câu chuyện nữa trong chuỗi sự việc bất hạnh kéo dài.\",\"rating\":9.0},\n  {\"id\":730940,\"suggestedTranslation\":\"Nghĩ đến những con sóng làm tôi thấy buồn nôn.\",\"rating\":9.0},\n  {\"id\":730941,\"suggestedTranslation\":\"Đại dương từng tràn ngập sự sống. Giờ thì hết rồi.\",\"rating\":9.0},\n  {\"id\":730942,\"suggestedTranslation\":\"Tôi có thể lái thuyền đâm thẳng vào nó và phó mặc bản thân cho số phận chìm dưới đáy nước.\",\"rating\":9.0},\n  {\"id\":730943,\"suggestedTranslation\":\"Tôi cũng thấy thế đấy.\",\"rating\":9.0},\n  {\"id\":730944,\"suggestedTranslation\":\"Chắc là sướng lắm nhỉ.\",\"rating\":9.0},\n  {\"id\":730945,\"suggestedTranslation\":\"Lại thêm một gánh nặng nữa đè lên đôi vai tôi.\",\"rating\":9.0},\n  {\"id\":730946,\"suggestedTranslation\":\"Sự sống, hoặc ít ra là hy vọng về nó.\",\"rating\":9.0},\n  {\"id\":730947,\"suggestedTranslation\":\"Ngọn lửa đã thiêu rụi sự sống của chúng rồi.\",\"rating\":9.0},\n  {\"id\":730948,\"suggestedTranslation\":\"Ban cho chúng tôi đôi mắt sáng soi...\",\"rating\":9.0},\n  {\"id\":730949,\"suggestedTranslation\":\"Lại thêm một công cụ để kìm hãm sự mục rữa tất yếu.\",\"rating\":9.0},\n  {\"id\":730950,\"suggestedTranslation\":\"Thứ vỏ cháy xém này là tất cả những gì còn sót lại.\",\"rating\":9.0},\n  {\"id\":730951,\"suggestedTranslation\":\"Một sự nhạo báng đối với sự sống.\",\"rating\":9.0},\n  {\"id\":730952,\"suggestedTranslation\":\"Nó không vá được cái hố... mà chỉ che đậy nó lại mà thôi.\",\"rating\":9.0},\n  {\"id\":730953,\"suggestedTranslation\":\"Cha từng hay nhảy mấy điệu nhảy ngớ ngẩn thế đấy.\",\"rating\":9.0},\n  {\"id\":730954,\"suggestedTranslation\":\"Hắn có phải anh trai ngươi không?\",\"rating\":9.0},\n  {\"id\":730955,\"suggestedTranslation\":\"Nó đập với nỗi buồn bao la trùm cả đất trời và thấu tận những vùng biển sâu thẳm nhất.\",\"rating\":9.0},\n  {\"id\":730956,\"suggestedTranslation\":\"Cõi hư vô cuồn cuộn không hồi kết... thật thanh tịnh làm sao.\",\"rating\":9.0},\n  {\"id\":730957,\"suggestedTranslation\":\"Sức mạnh thật lớn lao.\",\"rating\":9.0},\n  {\"id\":730958,\"suggestedTranslation\":\"Đối với tôi, thế giới này như đang đảo lộn.\",\"rating\":9.0},\n  {\"id\":730959,\"suggestedTranslation\":\"Hai cái đầu có nhận thức được sự tồn tại của nhau không nhỉ?\",\"rating\":9.0},\n  {\"id\":730960,\"suggestedTranslation\":\"Lại thêm một cơn ác mộng nữa đến hành hạ tôi.\",\"rating\":9.0},\n  {\"id\":730961,\"suggestedTranslation\":\"Liệu bóng đêm có cuối cùng nuốt chửng lấy tôi không?\",\"rating\":9.0},\n  {\"id\":730962,\"suggestedTranslation\":\"Ngươi là gì thế? Thần Chết Nhăn Nhở à?\",\"rating\":9.0},\n  {\"id\":730963,\"suggestedTranslation\":\"Ký sinh trùng.\",\"rating\":9.0},\n  {\"id\":730964,\"suggestedTranslation\":\"Chẳng có khuôn mặt nào ẩn dưới chiếc mũ trùm đó cả.\",\"rating\":9.0},\n  {\"id\":730965,\"suggestedTranslation\":\"Một sứ giả mang đến cái chết tuyệt đẹp.\",\"rating\":9.0},\n  {\"id\":730966,\"suggestedTranslation\":\"Tiếc là nó chỉ dùng được cho bò lai thôi.\",\"rating\":9.0},\n  {\"id\":730967,\"suggestedTranslation\":\"Tôi sẽ tạo ra những thứ khủng khiếp gì đây?\",\"rating\":9.0},\n  {\"id\":730968,\"suggestedTranslation\":\"Tôi đoán nếu thử thì mình cũng có thể chắp vá nó lại được.\",\"rating\":9.0},\n  {\"id\":730969,\"suggestedTranslation\":\"Từ một trái tim chưa từng biết đến sự bình yên.\",\"rating\":9.0},\n  {\"id\":730970,\"suggestedTranslation\":\"Thì có khác biệt gì đâu chứ?\",\"rating\":9.0},\n  {\"id\":730971,\"suggestedTranslation\":\"Ngươi đến để đưa ta xuống nấm mồ dưới nước à?\",\"rating\":9.0},\n  {\"id\":730972,\"suggestedTranslation\":\"Cú cắn của nó cũng chẳng lạnh lẽo hơn thực tại là bao.\",\"rating\":9.0},\n  {\"id\":730973,\"suggestedTranslation\":\"Chúng ta nên làm gì đây, Abigail?\",\"rating\":9.0},\n  {\"id\":730974,\"suggestedTranslation\":\"Chúng túm tụm lại với nhau... chia cắt chúng ra thì thật là tệ...\",\"rating\":9.0},\n  {\"id\":730975,\"suggestedTranslation\":\"Chẳng thứ gì có thể thực sự che chở bạn khỏi những nỗi kinh hoàng của thế giới tàn nhẫn này.\",\"rating\":9.0},\n  {\"id\":730976,\"suggestedTranslation\":\"Những bí mật khủng khiếp nào sẽ bị đào bới lên với thứ này đây?\",\"rating\":9.0},\n  {\"id\":730977,\"suggestedTranslation\":\"Có những thứ nên được chôn giấu mãi mãi... nhưng không phải hôm nay.\",\"rating\":9.0},\n  {\"id\":730978,\"suggestedTranslation\":\"Liệu nó có mang lại cho tôi một giấc ngủ không mộng mị không?\",\"rating\":9.0},\n  {\"id\":730979,\"suggestedTranslation\":\"Nó sẽ làm tôi lớn lên chứ? Hay là thu nhỏ lại nhỉ? Nấm mọc ngộ nghĩnh thật đấy.\",\"rating\":9.0},\n  {\"id\":730980,\"suggestedTranslation\":\"Một lời nhắc nhở về cái chết mà chúng ta đã gây ra.\",\"rating\":9.0},\n  {\"id\":730981,\"suggestedTranslation\":\"Một khung cảnh hé lộ ngọn lửa của địa ngục.\",\"rating\":9.0},\n  {\"id\":730982,\"suggestedTranslation\":\"Giấc ngủ trưa chẳng khác nào một màn dạo đầu của cái chết.\",\"rating\":9.0},\n  {\"id\":730983,\"suggestedTranslation\":\"Trơn tuột và mịn màng làm sao.\",\"rating\":9.0},\n  {\"id\":730984,\"suggestedTranslation\":\"Ước gì trong tim tôi vẫn còn một