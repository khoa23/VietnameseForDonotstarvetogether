ranslation\":\"Món này sẽ làm con quái vật hài lòng, nhưng không lâu đâu.\",\"rating\":1.0},\n  {\"id\":730673,\"suggestedTranslation\":\"Con quái vật không muốn thứ đó đâu.\",\"rating\":1.0},\n  {\"id\":730674,\"suggestedTranslation\":\"Thật phí phạm.\",\"rating\":1.0},\n  {\"id\":730675,\"suggestedTranslation\":\"Nó làm thức ăn đậm đà hơn.\",\"rating\":1.0},\n  {\"id\":730676,\"suggestedTranslation\":\"Nó có mùi hơi thơm.\",\"rating\":1.0},\n  {\"id\":730677,\"suggestedTranslation\":\"Sự sống chứa đựng bên trong chúng là một bí ẩn.\",\"rating\":1.0},\n  {\"id\":730678,\"suggestedTranslation\":\"Thời thơ ấu của mi là gì thế này?\",\"rating\":1.0},\n  {\"id\":730679,\"suggestedTranslation\":\"Nhưng lại không có mật ong.\",\"rating\":1.0},\n  {\"id\":730680,\"suggestedTranslation\":\"Chào quý bà. Có muốn trao đổi gì không?\",\"rating\":1.0},\n  {\"id\":730681,\"suggestedTranslation\":\"Nó không thể làm cho cuộc sống ngon miệng hơn đâu.\",\"rating\":1.0},\n  {\"id\":730682,\"suggestedTranslation\":\"Tôi không muốn mang cái này đi khắp nơi đâu.\",\"rating\":1.0},\n  {\"id\":730683,\"suggestedTranslation\":\"Nó nấu được một ít thức ăn.\",\"rating\":1.0},\n  {\"id\":730684,\"suggestedTranslation\":\"Nó chỉ hoạt động khi tôi đặt nó xuống đâu đó thôi.\",\"rating\":1.0},\n  {\"id\":730685,\"suggestedTranslation\":\"Để cày xới lớp đất đã hỏng.\",\"rating\":1.0},\n  {\"id\":730686,\"suggestedTranslation\":\"Đó là chìa khóa của một thứ quý giá.\",\"rating\":1.0},\n  {\"id\":730687,\"suggestedTranslation\":\"Chìa khóa dẫn đến một nơi tuyệt đẹp, đã bị khóa kín từ lâu.\",\"rating\":1.0},\n  {\"id\":730688,\"suggestedTranslation\":\"Nó chiếu sáng những thứ chẳng quan trọng gì.\",\"rating\":1.0},\n  {\"id\":730689,\"suggestedTranslation\":\"Ánh sáng duy nhất trong đời tôi chính là Abigail.\",\"rating\":1.0},\n  {\"id\":730690,\"suggestedTranslation\":\"Tôi bị nghiền nát trên hòn đá nghiền của cuộc đời.\",\"rating\":1.0},\n  {\"id\":730691,\"suggestedTranslation\":\"Sự cô lập đã không đối xử tốt với nó.\",\"rating\":1.0},\n  {\"id\":730692,\"suggestedTranslation\":\"Tôi cũng đang mang theo gánh nặng của mình mà.\",\"rating\":1.0},\n  {\"id\":730693,\"suggestedTranslation\":\"Chẳng có gì trong đó mang lại hạnh phúc cho tôi cả.\",\"rating\":1.0},\n  {\"id\":730694,\"suggestedTranslation\":\"Biết đâu chúng ta may mắn và chúng có độc thì sao.\",\"rating\":1.0},\n  {\"id\":730695,\"suggestedTranslation\":\"Chúng phát triển trên cái gốc cây do cái chết tạo ra.\",\"rating\":1.0},\n  {\"id\":730696,\"suggestedTranslation\":\"Mọi thứ rồi cũng sẽ chết. Kể cả nấm.\",\"rating\":1.0},\n  {\"id\":730697,\"suggestedTranslation\":\"Tôi không bao giờ khóc.\",\"rating\":1.0},\n  {\"id\":730698,\"suggestedTranslation\":\"Nó sẽ không bao giờ làm ai khóc nữa đâu.\",\"rating\":1.0},\n  {\"id\":730699,\"suggestedTranslation\":\"Sự sống chứa đựng bên trong chúng là một bí ẩn.\",\"rating\":1.0},\n  {\"id\":730700,\"suggestedTranslation\":\"Trông ổn phết.\",\"rating\":1.0},\n  {\"id\":730701,\"suggestedTranslation\":\"Hà... Bận tâm làm gì nhỉ?\",\"rating\":1.0},\n  {\"id\":730702,\"suggestedTranslation\":\"Trông nguy hiểm đấy.\",\"rating\":1.0},\n  {\"id\":730703,\"suggestedTranslation\":\"Có cánh, nhưng chẳng phải thiên thần gì cả.\",\"rating\":1.0},\n  {\"id\":730704,\"suggestedTranslation\":\"Abigail cần một bức tượng.\",\"rating\":1.0},\n  {\"id\":730705,\"suggestedTranslation\":\"Đã khô cạn từ lâu.\",\"rating\":1.0},\n  {\"id\":730706,\"suggestedTranslation\":\"Bây giờ tôi có thể vào công viên rồi.\",\"rating\":1.0},\n  {\"id\":730707,\"suggestedTranslation\":\"Tôi cần chìa khóa để vào.\",\"rating\":1.0},\n  {\"id\":730708,\"suggestedTranslation\":\"Một đài tưởng niệm. Nhưng không phải dành cho Abigail.\",\"rating\":1.0},\n  {\"id\":730709,\"suggestedTranslation\":\"Tro lại với tro.\",\"rating\":1.0},\n  {\"id\":730710,\"suggestedTranslation\":\"Nếu tôi có một cái vỏ như vậy, tôi sẽ chẳng bao giờ thò mặt ra ngoài.\",\"rating\":1.0},\n  {\"id\":730711,\"suggestedTranslation\":\"Lạnh lẽo và bất động.\",\"rating\":1.0},\n  {\"id\":730712,\"suggestedTranslation\":\"Mày có muốn thành bánh nướng không, chú chim nhỏ?\",\"rating\":1.0},\n  {\"id\":730713,\"suggestedTranslation\":\"Nó đang tập dượt cho giấc ngủ ngàn thu đấy.\",\"rating\":1.0},\n  {\"id\":730714,\"suggestedTranslation\":\"Giá như cuộc đời dâng tặng tôi mọi thứ trên đĩa bạc.\",\"rating\":1.0},\n  {\"id\":730715,\"suggestedTranslation\":\"Nước, nước, ở khắp mọi nơi...\",\"rating\":1.0},\n  {\"id\":730716,\"suggestedTranslation\":\"Ở đây không có màn đêm. Quả là một sự thay đổi thú vị.\",\"rating\":1.0},\n  {\"id\":730717,\"suggestedTranslation\":\"Có lẽ tôi sẽ hạnh phúc hơn ở thế giới bên kia.\",\"rating\":1.0},\n  {\"id\":730718,\"suggestedTranslation\":\"Chúng ta nấu ăn để né tránh cái chết.\",\"rating\":1.0},\n  {\"id\":730719,\"suggestedTranslation\":\"Nó có mắt, nhưng chẳng bao giờ khóc.\",\"rating\":1.0},\n  {\"id\":730720,\"suggestedTranslation\":\"Giờ thì đôi mắt của nó sẽ không bao giờ mở ra nữa.\",\"rating\":1.0},\n  {\"id\":730721,\"suggestedTranslation\":\"Sự sống chứa đựng bên trong chúng là một bí ẩn.\",\"rating\":1.0},\n  {\"id\":730722,\"suggestedTranslation\":\"Cái móc treo chính là thắt cổ tròng cho cái nồi.\",\"rating\":1.0},\n  {\"id\":730723,\"suggestedTranslation\":\"Nó dùng để treo nồi lên trên lửa.\",\"rating\":1.0},\n  {\"id\":730724,\"suggestedTranslation\":\"Chúng ta sẽ nấu ăn, hoặc chúng ta sẽ chết.\",\"rating\":1.0},\n  {\"id\":730725,\"suggestedTranslation\":\"Sự ngọt ngào sinh ra sự ngọt ngào.\",\"rating\":1.0},\n  {\"id\":730726,\"suggestedTranslation\":\"Thời của nó đã đến rồi.\",\"rating\":1.0},\n  {\"id\":730727,\"suggestedTranslation\":\"Không gì thoát khỏi thảm họa này.\",\"rating\":1.0},\n  {\"id\":730728,\"suggestedTranslation\":\"Nó đã bị lãng quên rồi.\",\"rating\":1.0},\n  {\"id\":730729,\"suggestedTranslation\":\"Chẳng còn gì để cầu nguyện nữa.\",\"rating\":1.0},\n  {\"id\":730730,\"suggestedTranslation\":\"Nơi này từng là một mái ấm hạnh phúc.\",\"rating\":1.0},\n  {\"id\":730731,\"suggestedTranslation\":\"Lò sưởi của nó giờ chẳng còn nhà để về.\",\"rating\":1.0},\n  {\"id\":730732,\"suggestedTranslation\":\"Thời gian chỉ là ảo ảnh.\",\"rating\":1.0},\n  {\"id\":730733,\"suggestedTranslation\":\"Thời gian là đồng minh của tử thần.\",\"rating\":1.0},\n  {\"id\":730734,\"suggestedTranslation\":\"Cái chết đã đến đây rồi.\",\"rating\":1.0},\n  {\"id\":730735,\"suggestedTranslation\":\"Đúng là một thị trấn ma.\",\"rating\":1.0},\n  {\"id\":730736,\"suggestedTranslation\":\"Một thảm kịch nào đó đã giáng xuống ngôi nhà này.\",\"rating\":1.0},\n  {\"id\":730737,\"suggestedTranslation\":\"Một cánh cửa dẫn đến hư vô.\",\"rating\":1.0},\n  {\"id\":730738,\"suggestedTranslation\":\"Mái nhà không thể bảo vệ bạn khi cái chết gõ cửa.\",\"rating\":1.0},\n  {\"id\":730739,\"suggestedTranslation\":\"Hãy thử nhìn trộm vào bên trong xem nào...\",\"rating\":1.0},\n  {\"id\":730740,\"suggestedTranslation\":\"Đã khóa, giống như trái tim tôi vậy.\",\"rating\":1.0},\n  {\"id\":730741,\"suggestedTranslation\":\"Nó quằn quại khi sự sống từ từ rời bỏ cơ thể.\",\"rating\":1.0},\n  {\"id\":730742,\"suggestedTranslation\":\"Giờ thì trông không còn hoạt bát thế nữa nhỉ.\",\"rating\":1.0},\n  {\"id\":730743,\"suggestedTranslation\":\"Nó làm tăng hương vị...\",\"rating\":1.0},\n  {\"id\":730744,\"suggestedTranslation\":\"Nó cần được nghiền nhỏ trước khi chúng ta có thể dùng.\",\"rating\":1.0},\n  {\"id\":730745,\"suggestedTranslation\":\"Vẫn chưa có muối.\",\"rating\":1.0},\n  {\"id\":730746,\"suggestedTranslation\":\"Có muối để thu hoạch rồi kìa.\",\"rating\":1.0},\n  {\"id\":730747,\"suggestedTranslation\":\"Nó dùng để thu thập muối từ dưới ao.\",\"rating\":1.0},\n  {\"id\":730748,\"suggestedTranslation\":\"Máu của cây.\",\"rating\":1.0},\n  {\"id\":730749,\"suggestedTranslation\":\"Để thu thập máu của cây.\",\"rating\":1.0},\n  {\"id\":730750,\"suggestedTranslation\":\"Chúng ta sẽ bỏ mạng trước khi cái này mọc lại cho xem.\",\"rating\":1.0},\n  {\"id\":730751,\"suggestedTranslation\":\"Ngọt đắng hệt như cuộc đời.\",\"rating\":1.0},\n  {\"id\":730752,\"suggestedTranslation\":\"Trồng hạt đòi hỏi một sự lạc quan mà tôi không có.\",\"rating\":1.0},\n  {\"id\":730753,\"suggestedTranslation\":\"Chẳng phải tất cả cuộc đời đều là một cuộc tàn sát sao?\",\"rating\":1.0},\n  {\"id\":730754,\"suggestedTranslation\":\"Chỉ một chút thôi.\",\"rating\":1.0},\n  {\"id\":730755,\"suggestedTranslation\":\"Tôi đoán là nó ăn được.\",\"rating\":1.0},\n  {\"id\":730756,\"suggestedTranslation\":\"Chúng ta đã lấy sạch mọi thứ có thể lấy rồi.\",\"rating\":1.0},\n  {\"id\":730757,\"suggestedTranslation\":\"Chúng ta đã giật nó khỏi ngôi nhà trên bụi cây.\",\"rating\":1.0},\n  {\"id\":730758,\"suggestedTranslation\":\"Nó mang một vẻ đẹp bệnh hoạn.\",\"rating\":1.0},\n  {\"id\":730759,\"suggestedTranslation\":\"Mọi thứ rồi cũng phải chấm dứt.\",\"rating\":1.0},\n  {\"id\":730760,\"suggestedTranslation\":\"Tất cả sự hy sinh đó đều đổ sông đổ biển.\",\"rating\":1.0},\n  {\"id\":730761,\"suggestedTranslation\":\"Nhói đau như dao đâm vào tim. Một trái tim cây.\",\"rating\":1.0},\n  {\"id\":730762,\"suggestedTranslation\":\"Bây giờ tôi có thể thu hoạch nó rồi.\",\"rating\":1.0},\n  {\"id\":730763,\"suggestedTranslation\":\"Sự sống của nó đang lụi tàn.\",\"rating\":1.0},\n  {\"id\":730764,\"suggestedTranslation\":\"Chúng bớt xa cách hơn so với đồng loại của chúng.\",\"rating\":1.0},\n  {\"id\":730765,\"suggestedTranslation\":\"Dạo này thế nào rồi, thưa ngài?\",\"rating\":1.0},\n  {\"id\":730766,\"suggestedTranslation\":\"Ông ấy đang tập dượt cho giấc ngủ ngàn thu đấy.\",\"rating\":1.0},\n  {\"id\":730767,\"suggestedTranslation\":\"Tôi chẳng thấy chút niềm vui nào trong ngôi nhà này cả.\",\"rating\":1.0},\n  {\"id\":730768,\"suggestedTranslation\":\"Chẳng phải nhà cũng chẳng phải tổ.\",\"rating\":1.0},\n  {\"id\":730769,\"suggestedTranslation\":\"Không ngọt ngào bằng Abigail.\",\"rating\":1.0},\n  {\"id\":730770,\"suggestedTranslation\":\"Đỏ như máu tim.\",\"rating\":1.0},\n  {\"id\":730771,\"suggestedTranslation\":\"Phần thịt của nó giờ trông đẫm máu hơn nhiều.\",\"rating\":1.0},\n  {\"id\":730772,\"suggestedTranslation\":\"Sự sống chứa đựng bên trong chúng là một bí ẩn.\",\"rating\":1.0},\n  {\"id\":730773,\"suggestedTranslation\":\"Dạo này thế nào rồi?\",\"rating\":1.0},\n  {\"id\":730774,\"suggestedTranslation\":\"Dạo này thế nào rồi?\",\"rating\":1.0},\n  {\"id\":730775,\"suggestedTranslation\":\"Đó là... một củ cải tím.\",\"rating\":1.0},\n  {\"id\":730776,\"suggestedTranslation\":\"Củ cải tím giờ đã được nấu chín.\",\"rating\":1.0},\n  {\"id\":730777,\"suggestedTranslation\":\"Sự sống chứa đựng bên trong chúng là một bí ẩn.\",\"rating\":1.0},\n  {\"id\":730778,\"suggestedTranslation\":\"Chúng ta có thể nghiền nó thành bột mì.\",\"rating\":1.0},\n  {\"id\":730779,\"suggestedTranslation\":\"Sự sống chứa đựng bên trong chúng là một bí ẩn.\",\"rating\":1.0}\n]",
