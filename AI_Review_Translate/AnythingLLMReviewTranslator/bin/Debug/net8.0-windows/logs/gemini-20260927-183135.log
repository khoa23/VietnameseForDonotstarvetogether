            "text": "[\n  {\"id\": 729580, \"suggestedTranslation\": \"Đúng là một con mắt co giãn thật.\", \"rating\": 9.0},\n  {\"id\": 729581, \"suggestedTranslation\": \"Tôi là kẻ chiêm ngưỡng con mắt.\", \"rating\": 9.0},\n  {\"id\": 729582, \"suggestedTranslation\": \"Hãy đề phòng con mắt ác quỷ.\", \"rating\": 9.0},\n  {\"id\": 729583, \"suggestedTranslation\": \"Tôi có thể cảm nhận được sự nhức nhối từ ánh nhìn sắc lẹm của chúng...\", \"rating\": 9.0},\n  {\"id\": 729584, \"suggestedTranslation\": \"Thêm một thảm họa nữa sắp được mang đến thế giới này.\", \"rating\": 9.0},\n  {\"id\": 729585, \"suggestedTranslation\": \"Chúng tuân lệnh mọi mong muốn của chủ nhân.\", \"rating\": 9.0},\n  {\"id\": 729586, \"suggestedTranslation\": \"Tôi không biết tại sao nó lại giúp tôi.\", \"rating\": 9.0},\n  {\"id\": 729587, \"suggestedTranslation\": \"Tôi nghĩ nó cần được đặt xuống.\", \"rating\": 9.0},\n  {\"id\": 729588, \"suggestedTranslation\": \"Mặt đất này đã bị thiêu rụi và chết chóc.\", \"rating\": 9.0},\n  {\"id\": 729589, \"suggestedTranslation\": \"Tôi nên gieo hạt nào đây?\", \"rating\": 9.0},\n  {\"id\": 729590, \"suggestedTranslation\": \"Những chồi lá cuộn tròn vươn lên từ lớp bùn lầy.\", \"rating\": 9.0},\n  {\"id\": 729591, \"suggestedTranslation\": \"Mặt đất này lạnh lẽo và chết chóc.\", \"rating\": 9.0},\n  {\"id\": 729592, \"suggestedTranslation\": \"Tôi phải chuẩn bị cho những cái hạt được an táng.\", \"rating\": 9.0},\n  {\"id\": 729593, \"suggestedTranslation\": \"Bao nhiêu công sức, tan thành mây khói...\", \"rating\": 9.0},\n  {\"id\": 729594, \"suggestedTranslation\": \"Thật tàn nhẫn làm sao, khi giờ đây tôi phải cướp đi thành quả lao động của bạn.\", \"rating\": 9.0},\n  {\"id\": 729595, \"suggestedTranslation\": \"Sao mà nó có thể lớn đến thế nhỉ?\", \"rating\": 9.0},\n  {\"id\": 729596, \"suggestedTranslation\": \"Đó là bi kịch số phận của mọi loài cỏ dại, bị xua đuổi khỏi khu vườn.\", \"rating\": 9.0},\n  {\"id\": 729597, \"suggestedTranslation\": \"Một loài thực vật.\", \"rating\": 9.0},\n  {\"id\": 729598, \"suggestedTranslation\": \"Bất chấp những điều kinh hoàng của thế giới, nó vẫn kiên quyết sống tiếp.\", \"rating\": 9.0},\n  {\"id\": 729599, \"suggestedTranslation\": \"Tôi chẳng thể làm gì cho nó được nữa.\", \"rating\": 9.0},\n  {\"id\": 729600, \"suggestedTranslation\": \"Chết chóc và mục rữa.\", \"rating\": 9.0},\n  {\"id\": 729601, \"suggestedTranslation\": \"Dưới đó có lạnh không, khi đơn độc nằm trong lòng đất?\", \"rating\": 9.0},\n  {\"id\": 729602, \"suggestedTranslation\": \"Nó đang chiến đấu với mặt đất.\", \"rating\": 9.0},\n  {\"id\": 729603, \"suggestedTranslation\": \"Chắc tôi phải tìm một chỗ cho khu vườn thôi.\", \"rating\": 9.0},\n  {\"id\": 729604, \"suggestedTranslation\": \"Ngươi không thuộc về nơi này.\", \"rating\": 9.0},\n  {\"id\": 729605, \"suggestedTranslation\": \"Cái đó sẽ tạo ra một luồng gió kha khá đấy.\", \"rating\": 9.0},\n  {\"id\": 729606, \"suggestedTranslation\": \"Quác quác!\", \"rating\": 9.0},\n  {\"id\": 729607, \"suggestedTranslation\": \"M...mình có thể vẽ nguệch ngoạc gì đó... Khi không có ai nhìn.\", \"rating\": 9.0},\n  {\"id\": 729608, \"suggestedTranslation\": \"Một chiếc lông chim hoàng yến, vàng óng như chiếc lồng son.\", \"rating\": 9.0},\n  {\"id\": 729609, \"suggestedTranslation\": \"Một chiếc lông mềm mại, đen nhánh tựa bóng đêm vĩnh hằng.\", \"rating\": 9.0},\n  {\"id\": 729610, \"suggestedTranslation\": \"Một chiếc lông chim Đỏ, đỏ như máu.\", \"rating\": 9.0},\n  {\"id\": 729611, \"suggestedTranslation\": \"Một chiếc lông chim Tuyết, trắng tựa ánh sáng cuối đường hầm.\", \"rating\": 9.0},\n  {\"id\": 729612, \"suggestedTranslation\": \"Tôi tự hỏi cô ta đã làm gì.\", \"rating\": 9.0},\n  {\"id\": 729613, \"suggestedTranslation\": \"Kiểu như một hàng rào cảm xúc vậy. Nhưng bằng gỗ.\", \"rating\": 9.0},\n  {\"id\": 729614, \"suggestedTranslation\": \"Quả là một chiếc cột cô độc.\", \"rating\": 9.0},\n  {\"id\": 729615, \"suggestedTranslation\": \"Nó hoàn thành mục đích của mình qua sự kết nối.\", \"rating\": 9.0},\n  {\"id\": 729616, \"suggestedTranslation\": \"Thế này thì chẳng có ích gì cho ai cả.\", \"rating\": 9.0},\n  {\"id\": 729617, \"suggestedTranslation\": \"Nó sẽ nhốt người ở trong, hay chắn người ở ngoài đây?\", \"rating\": 9.0},\n  {\"id\": 729618, \"suggestedTranslation\": \"Chúng ta có thể dùng nó để dựng một cái cổng.\", \"rating\": 9.0},\n  {\"id\": 729619, \"suggestedTranslation\": \"Chúng ta có thể dùng nó để làm hàng rào.\", \"rating\": 9.0},\n  {\"id\": 729620, \"suggestedTranslation\": \"Ngay cả những mảnh vụn bị bỏ đi này cũng có ích.\", \"rating\": 9.0},\n  {\"id\": 729621, \"suggestedTranslation\": \"Những chiếc hàng rào lộn xộn cần phải được chỉnh đốn lại.\", \"rating\": 9.0},\n  {\"id\": 729622, \"suggestedTranslation\": \"Một xô chất nhờn.\", \"rating\": 9.0},\n  {\"id\": 729623, \"suggestedTranslation\": \"Nó có vẻ vui tươi ngang ngửa tâm trạng tôi lúc này.\", \"rating\": 9.0},\n  {\"id\": 729624, \"suggestedTranslation\": \"Nó sặc sỡ đến mức làm tôi nhức cả mắt.\", \"rating\": 9.0},\n  {\"id\": 729625, \"suggestedTranslation\": \"Abigail luôn bảo với tôi rằng bên trong chúng toàn là ong bắp cày.\", \"rating\": 9.0},\n  {\"id\": 729626, \"suggestedTranslation\": \"Quả vả đang co rúm trong lớp vỏ mì ống.\", \"rating\": 9.0},\n  {\"id\": 729627, \"suggestedTranslation\": \"Những miếng quả vả trông giống như những trái tim nhỏ bị đâm thủng.\", \"rating\": 9.0},\n  {\"id\": 729628, \"suggestedTranslation\": \"Mấy con ong bắp cày bên trong hình như đã bị thiêu rụi rồi.\", \"rating\": 9.0},\n  {\"id\": 729629, \"suggestedTranslation\": \"Để gọi cái chết từ bầu trời.\", \"rating\": 9.0},\n  {\"id\": 729630, \"suggestedTranslation\": \"Chỉ cần châm lửa là xong.\", \"rating\": 9.0},\n  {\"id\": 729631, \"suggestedTranslation\": \"Một đốm sáng nhỏ nhoi trong bóng tối.\", \"rating\": 9.0},\n  {\"id\": 729632, \"suggestedTranslation\": \"Những ánh đèn nhỏ bé, bị lưu lạc khỏi thế giới bên ngoài túi áo tôi.\", \"rating\": 9.0},\n  {\"id\": 729633, \"suggestedTranslation\": \"Tính tình của nó dữ dội như lửa.\", \"rating\": 9.0},\n  {\"id\": 729634, \"suggestedTranslation\": \"Chúng đốt đau khủng khiếp.\", \"rating\": 9.0},\n  {\"id\": 729635, \"suggestedTranslation\": \"Tôi thích mùi của chúng.\", \"rating\": 9.0},\n  {\"id\": 729636, \"suggestedTranslation\": \"Cha có một cái y hệt thế này. Nhưng tôi nghi ngờ nó chưa từng tạo ra ngọn lửa nào.\", \"rating\": 9.0},\n  {\"id\": 729637, \"suggestedTranslation\": \"Đừng bỏ cuộc, ngọn lửa nhỏ nhé!\", \"rating\": 9.0},\n  {\"id\": 729638, \"suggestedTranslation\": \"Một ngọn lửa để xua đuổi những nỗi kinh hoàng.\", \"rating\": 9.0},\n  {\"id\": 729639, \"suggestedTranslation\": \"Ngọn lửa này cháy với đầy nhiệt huyết!\", \"rating\": 9.0},\n  {\"id\": 729640, \"suggestedTranslation\": \"Nó đang mất đi ý chí muốn tiếp tục.\", \"rating\": 9.0},\n  {\"id\": 729641, \"suggestedTranslation\": \"Thật là một sự an ủi.\", \"rating\": 9.0},\n  {\"id\": 729642, \"suggestedTranslation\": \"Thứ này có thể thắp sáng lại, không như trái tim tôi.\", \"rating\": 9.0},\n  {\"id\": 729643, \"suggestedTranslation\": \"Cả thế giới này sẽ phải cháy rụi trước cây quyền năng này.\", \"rating\": 9.0},\n  {\"id\": 729644, \"suggestedTranslation\": \"Nó sắp cạn sạch nhiên liệu rồi.\", \"rating\": 9.0},\n  {\"id\": 729645, \"suggestedTranslation\": \"Yên tĩnh như một cái xác.\", \"rating\": 9.0},\n  {\"id\": 729646, \"suggestedTranslation\": \"Tôi không hiểu sao cậu lại phải bận tâm. Tất cả chúng ta rồi sẽ thành tro bụi thôi.\", \"rating\": 9.0},\n  {\"id\": 729647, \"suggestedTranslation\": \"Nó đã giãy giụa tuyệt vọng để giành lấy sự sống. Thật đáng thương hại.\", \"rating\": 9.0},\n  {\"id\": 729648, \"suggestedTranslation\": \"Để câu cá và bứt chúng khỏi cuộc sống bình yên.\", \"rating\": 9.0},\n  {\"id\": 729649, \"suggestedTranslation\": \"Với thứ này, lũ cá sẽ bị lôi ra khỏi chốn bình yên quý giá trong ao của chúng.\", \"rating\": 9.0},\n  {\"id\": 729650, \"suggestedTranslation\": \"Nó đã bị chặt đầu rồi.\", \"rating\": 9.0},\n  {\"id\": 729651, \"suggestedTranslation\": \"Nướng đúng cách sẽ chấm dứt ngay mấy cú giãy giụa.\", \"rating\": 9.0},\n  {\"id\": 729652, \"suggestedTranslation\": \"Phần xác khô quắt của một con cá.\", \"rating\": 9.0},\n  {\"id\": 729653, \"suggestedTranslation\": \"Dưới biển còn đầy cá. Hy vọng là mấy con to hơn.\", \"rating\": 9.0},\n  {\"id\": 729654, \"suggestedTranslation\": \"Nó sẽ... cầm cự... giúp tôi lúc này.\", \"rating\": 9.0},\n  {\"id\": 729655, \"suggestedTranslation\": \"Teo tóp lại gần như chẳng còn gì.\", \"rating\": 9.0},\n  {\"id\": 729656, \"suggestedTranslation\": \"Những khối cá được đúc hoàn hảo.\", \"rating\": 9.0},\n  {\"id\": 729657, \"suggestedTranslation\": \"Hy vọng là không còn chiếc xương nào sót lại bên trong.\", \"rating\": 9.0},\n  {\"id\": 729658, \"suggestedTranslation\": \"Cảm giác hơi tàn nhẫn khi bẫy chúng ngay trong tầm mắt của sự tự do.\", \"rating\": 9.0},\n  {\"id\": 729659, \"suggestedTranslation\": \"Nướng đúng cách sẽ chấm dứt ngay mấy cú giãy giụa.\", \"rating\": 9.0},\n  {\"id\": 729660, \"suggestedTranslation\": \"Một hòn đá sắc nhọn tựa lưỡi dao.\", \"rating\": 9.0},\n  {\"id\": 729661, \"suggestedTranslation\": \"Tôi biết là nó không kéo dài được lâu mà.\", \"rating\": 9.0},\n  {\"id\": 729662, \"suggestedTranslation\": \"Nó cũng vực dậy tinh thần tôi... chút ít.\", \"rating\": 9.0},\n  {\"id\": 729663, \"suggestedTranslation\": \"Tôi nên giữ lại cái này cho lúc tối trời nhất.\", \"rating\": 9.0},\n  {\"id\": 729664, \"suggestedTranslation\": \"Đâu cần phải có nước mới chết đuối được.\", \"rating\": 9.0},\n  {\"id\": 729665, \"suggestedTranslation\": \"Chúng thật tươi sáng và vui vẻ. Kinh tởm.\", \"rating\": 9.0},\n  {\"id\": 729666, \"suggestedTranslation\": \"Gai góc và đỏ như máu...\", \"rating\": 9.0},\n  {\"id\": 729667, \"suggestedTranslation\": \"Nhưng tôi đang để tang cơ mà...\", \"rating\": 9.0},\n  {\"id\": 729668, \"suggestedTranslation\": \"Hừ, lại hoa nữa.\", \"rating\": 9.0},\n  {\"id\": 729669, \"suggestedTranslation\": \"Trông nó có vẻ mỏng manh.\", \"rating\": 9.0},\n  {\"id\": 729670, \"suggestedTranslation\": \"Có một nỗi buồn man mác trong cách nó lập lòe.\", \"rating\": 9.0},\n  {\"id\": 729671, \"suggestedTranslation\": \"Ít ra chúng còn đỡ hơn mấy bông hoa kia.\", \"rating\": 9.0},\n  {\"id\": 729672, \"suggestedTranslation\": \"Đây là số phận chung của vạn vật.\", \"rating\": 9.0},\n  {\"id\": 729673, \"suggestedTranslation\": \"Hãy dẫn tôi đến Aarnivalkea.\", \"rating\": 9.0},\n  {\"id\": 729674, \"suggestedTranslation\": \"Tôi thích mùi của chúng.\", \"rating\": 9.0},\n  {\"id\": 729675, \"suggestedTranslation\": \"Một món đồ của kẻ chết để tôi mặc lên người. Vui quá nhỉ.\", \"rating\": 9.0},\n  {\"id\": 729676, \"suggestedTranslation\": \"Đối với cỏ dại thì chúng khá xinh đấy chứ.\", \"rating\": 9.0},\n  {\"id\": 729677, \"suggestedTranslation\": \"Tôi thích mùi của chúng.\", \"rating\": 9.0},\n  {\"id\": 729678, \"suggestedTranslation\": \"Trông rất ra dáng trang nghiêm.\", \"rating\": 9.0},\n  {\"id\": 729679, \"suggestedTranslation\": \"Đó là cái chết được bảo quản lại.\", \"rating\": 9.0},\n  {\"id\": 729680, \"suggestedTranslation\": \"Thứ kinh hoàng nào mà chúng ta đã hồi sinh ở đây hôm nay thế?\", \"rating\": 9.0},\n  {\"id\": 729681, \"suggestedTranslation\": \"Thần chết cũng có khiếu hài hước đấy chứ.\", \"rating\": 9.0},\n  {\"id\": 729682, \"suggestedTranslation\": \"Chúng ta phải tìm thêm các mảnh khác.\", \"rating\": 9.0},\n  {\"id\": 729683, \"suggestedTranslation\": \"Tôi có thể gọi món này kèm kem được không?\", \"rating\": 9.0},\n  {\"id\": 729684, \"suggestedTranslation\": \"Ồ. Có vẻ như nó rất thân thiện.\", \"rating\": 9.0},\n  {\"id\": 729685, \"suggestedTranslation\": \"Cuộc đời thật nhỏ bé và ngắn ngủi.\", \"rating\": 9.0},\n  {\"id\": 729686, \"suggestedTranslation\": \"Nó thật nhỏ bé và đầy nốt sần.\", \"rating\": 9.0},\n  {\"id\": 729687, \"suggestedTranslation\": \"Nó đang ngủ.\", \"rating\": 9.0},\n  {\"id\": 729688, \"suggestedTranslation\": \"Thực ra thì... rất ngon đấy...\", \"rating\": 9.0},\n  {\"id\": 729689, \"suggestedTranslation\": \"Tôi chưa bao giờ nghĩ đùi ếch lại có thể ngon mắt đến thế.\", \"rating\": 9.0},\n  {\"id\": 729690, \"suggestedTranslation\": \"Bứt ra trực tiếp từ con ếch.\", \"rating\": 9.0},\n  {\"id\": 729691, \"suggestedTranslation\": \"Chắc chắn là không còn co giật nữa rồi.\", \"rating\": 9.0},\n  {\"id\": 729692, \"suggestedTranslation\": \"Ngọt ngào và chỉ hơi nhớt một chút.\", \"rating\": 9.0},\n  {\"id\": 729693, \"suggestedTranslation\": \"Cái này sẽ chẳng giúp ích gì cho trái tim lạnh giá của tôi đâu.\", \"rating\": 9.0},\n  {\"id\": 729694, \"suggestedTranslation\": \"Nó thích ở một mình hơn.\", \"rating\": 9.0},\n  {\"id\": 729695, \"suggestedTranslation\": \"Trông cậu ngon miệng quá đấy.\", \"rating\": 9.0},\n  {\"id\": 729696, \"suggestedTranslation\": \"Nó đang chìm đalam vào giấc ngủ ngàn thu.\", \"rating\": 9.0},\n  {\"id\": 729697, \"suggestedTranslation\": \"Chúng chẳng hề tôn trọng sự sống.\", \"rating\": 9.0},\n  {\"id\": 729698, \"suggestedTranslation\": \"Giờ thì ngươi có thể đổi vua lấy chúa được rồi đấy.\", \"rating\": 9.0},\n  {\"id\": 729699, \"suggestedTranslation\": \"Ngọt, chua thanh và nằm gọn trong ly.\", \"rating\": 9.0},\n  {\"id\": 729700, \"suggestedTranslation\": \"Nó sẽ chẳng sống được lâu trên thế giới này đâu...\", \"rating\": 9.0},\n  {\"id\": 729701, \"suggestedTranslation\": \"Ngọn lửa rực rỡ nhất sẽ tàn lụi nhanh nhất...\", \"rating\": 9.0},\n  {\"id\": 729702, \"suggestedTranslation\": \"Nó đã mất đi hơi ấm từng có.\", \"rating\": 9.0},\n  {\"id\": 729703, \"suggestedTranslation\": \"Tôi có thể tìm thấy chút hơi ấm an ủi nhỏ nhoi từ nó.\", \"rating\": 9.0},\n  {\"id\": 729704, \"suggestedTranslation\": \"Nó sẽ chẳng sống được lâu trên thế giới này đâu...\", \"rating\": 9.0},\n  {\"id\": 729705, \"suggestedTran