731032,\"suggestedTranslation\":\"Walter đang tỏ ra nghiêm túc với chiếc súng cao su của cậu ấy kìa.\",\"rating\":9.0},\n  {\"id\":731033,\"suggestedTranslation\":\"A, được sống đơn giản biết bao.\",\"rating\":9.0},\n  {\"id\":731034,\"suggestedTranslation\":\"Cái túi rỗng đựng cơn đói khát.\",\"rating\":9.0},\n  {\"id\":731035,\"suggestedTranslation\":\"Cái túi rỗng đựng cơn đói khát.\",\"rating\":9.0},\n  {\"id\":731036,\"suggestedTranslation\":\"Nó cứ mải miết đuổi theo mấy cục đá một cách vô hồn.\",\"rating\":9.0},\n  {\"id\":731037,\"suggestedTranslation\":\"Nó chắc chắn chẳng giúp ích gì cho người chủ cũ cả.\",\"rating\":9.0},\n  {\"id\":731038,\"suggestedTranslation\":\"Lũ slurtle chui ra ngoài khi chúng lớn vượt quá cái vỏ.\",\"rating\":9.0},\n  {\"id\":731039,\"suggestedTranslation\":\"Nó lấp lánh vẻ mong đợi nhớp nhúa.\",\"rating\":9.0},\n  {\"id\":731040,\"suggestedTranslation\":\"Những mảnh vỡ của những giấc mơ tan tành.\",\"rating\":9.0},\n  {\"id\":731041,\"suggestedTranslation\":\"Chào bạn nhỏ nhé.\",\"rating\":9.0},\n  {\"id\":731042,\"suggestedTranslation\":\"Bên trong cậu trống rỗng lắm hả?\",\"rating\":9.0},\n  {\"id\":731043,\"suggestedTranslation\":\"Hãy mơ về một nơi tốt đẹp hơn nhé.\",\"rating\":9.0},\n  {\"id\":731044,\"suggestedTranslation\":\"Một cái hố đen nuốt trọn hạt giống mãi mãi không về.\",\"rating\":9.0},\n  {\"id\":731045,\"suggestedTranslation\":\"Lại thêm một sinh mệnh phải đứt gánh giữa đường.\",\"rating\":9.0},\n  {\"id\":731046,\"suggestedTranslation\":\"Nó có mùi của sự sợ hãi bé nhỏ.\",\"rating\":9.0},\n  {\"id\":731047,\"suggestedTranslation\":\"Thịt đã được làm khô và trở nên ngon lành.\",\"rating\":9.0},\n  {\"id\":731048,\"suggestedTranslation\":\"Cái chết sẽ là một sự giải thoát.\",\"rating\":9.0},\n  {\"id\":731049,\"suggestedTranslation\":\"Tôi nhớ cảm giác vui vẻ ngày trước.\",\"rating\":9.0},\n  {\"id\":731050,\"suggestedTranslation\":\"Cái lạnh giữ nó lại.\",\"rating\":9.0},\n  {\"id\":731051,\"suggestedTranslation\":\"Nó có tiềm năng đấy.\",\"rating\":9.0},\n  {\"id\":731052,\"suggestedTranslation\":\"Con kia có cái vỏ lớn hơn kìa.\",\"rating\":9.0},\n  {\"id\":731053,\"suggestedTranslation\":\"Chúng ta bón phân cho đất trồng bằng phần vỏ phân hủy của họ hàng chúng dưới đại dương.\",\"rating\":9.0},\n  {\"id\":731054,\"suggestedTranslation\":\"Nó có mùi hôi của cái chết... nhưng lại mang đến sự sống.\",\"rating\":9.0},\n  {\"id\":731055,\"suggestedTranslation\":\"Nó đang phân hủy rất tốt đấy.\",\"rating\":9.0},\n  {\"id\":731056,\"suggestedTranslation\":\"Nó đã hoàn tất rồi đây.\",\"rating\":9.0},\n  {\"id\":731057,\"suggestedTranslation\":\"Tôi nên chấm dứt sự khổ sở này cho nó thì hơn.\",\"rating\":9.0},\n  {\"id\":731058,\"suggestedTranslation\":\"Kẻ nào cầm nó sẽ trở thành kẻ hủy diệt thế giới.\",\"rating\":9.0},\n  {\"id\":731059,\"suggestedTranslation\":\"Để cắt và chém...\",\"rating\":9.0},\n  {\"id\":731060,\"suggestedTranslation\":\"Một món vũ khí thật tàn bạo...\",\"rating\":9.0},\n  {\"id\":731061,\"suggestedTranslation\":\"Trông có vẻ hơi bi lụy quá nhỉ.\",\"rating\":9.0},\n  {\"id\":731062,\"suggestedTranslation\":\"Sức mạnh hủy diệt thật kinh khủng...\",\"rating\":9.0},\n  {\"id\":731063,\"suggestedTranslation\":\"Để chống lại sự tàn phá của thời gian... ít ra là cho thức ăn của tôi.\",\"rating\":9.0},\n  {\"id\":731064,\"suggestedTranslation\":\"Tràn trề sức sống hơn mức tôi thường thấy.\",\"rating\":9.0},\n  {\"id\":731065,\"suggestedTranslation\":\"Mùi của nó rất tốt trong việc giữ mọi người ở khoảng cách xa.\",\"rating\":9.0},\n  {\"id\":731066,\"suggestedTranslation\":\"Để xát vào những vết thương.\",\"rating\":9.0},\n  {\"id\":731067,\"suggestedTranslation\":\"Không ngọt ngào bằng Abigail.\",\"rating\":9.0},\n  {\"id\":731068,\"suggestedTranslation\":\"Rồi chúng ta sẽ gặp lại nhau vào một ngày nào đó.\",\"rating\":9.0},\n  {\"id\":731069,\"suggestedTranslation\":\"Một sinh vật của màn đêm!\",\"rating\":9.0},\n  {\"id\":731070,\"suggestedTranslation\":\"Ác quỷ đang ngủ say.\",\"rating\":9.0},\n  {\"id\":731071,\"suggestedTranslation\":\"Như thế lại là tốt nhất.\",\"rating\":9.0},\n  {\"id\":731072,\"suggestedTranslation\":\"Mong là nó không phải bạn của Webber.\",\"rating\":9.0},\n  {\"id\":731073,\"suggestedTranslation\":\"Thế thì không ổn chút nào.\",\"rating\":9.0},\n  {\"id\":731074,\"suggestedTranslation\":\"Một ổ chứa đầy sự dơ bẩn và đồi bại.\",\"rating\":9.0},\n  {\"id\":731075,\"suggestedTranslation\":\"Tự hỏi không biết mình có nên mượn mấy cây bút chì màu không nhỉ...\",\"rating\":9.0},\n  {\"id\":731076,\"suggestedTranslation\":\"Một gói nhỏ chứa đầy chết chóc và hủy diệt.\",\"rating\":9.0},\n  {\"id\":731077,\"suggestedTranslation\":\"Ngay cả khi chết đi, con quái vật này vẫn gây ra đau đớn.\",\"rating\":9.0},\n  {\"id\":731078,\"suggestedTranslation\":\"Đã đến lúc nhìn chằm chằm vào vực sâu rồi.\",\"rating\":9.0},\n  {\"id\":731079,\"suggestedTranslation\":\"Nó bị nhiễm trùng rồi.\",\"rating\":9.0}\n]",
