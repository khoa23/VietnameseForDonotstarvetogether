ting\":1.0},\n  {\"id\":729512,\"suggestedTranslation\":\"Nó chứa được vô số thứ, và nhất quyết không chịu cháy.\",\"rating\":1.0},\n  {\"id\":729513,\"suggestedTranslation\":\"Hàm răng của nó còn chẳng thèm nghiến lại.\",\"rating\":1.0},\n  {\"id\":729514,\"suggestedTranslation\":\"Thật thảm hại.\",\"rating\":1.0},\n  {\"id\":729515,\"suggestedTranslation\":\"Không cần phải cúi người kiểm tra xem nó có nóng không đâu. Tôi cảm nhận được từ đây rồi.\",\"rating\":1.0},\n  {\"id\":729516,\"suggestedTranslation\":\"Cháy nóng... nhưng không sáng...\",\"rating\":1.0},\n  {\"id\":729517,\"suggestedTranslation\":\"Cái này chẳng có hình thù gì giống rồng cả.\",\"rating\":1.0},\n  {\"id\":729518,\"suggestedTranslation\":\"Vẫn không phải là rồng. Ít ra thì nó đã chết rồi.\",\"rating\":1.0},\n  {\"id\":729519,\"suggestedTranslation\":\"Nó suýt biến thành một con rồng đấy.\",\"rating\":1.0},\n  {\"id\":729520,\"suggestedTranslation\":\"Đó là một hạt giống.\",\"rating\":1.0},\n  {\"id\":729521,\"suggestedTranslation\":\"Cậu có đôi mắt to ghê.\",\"rating\":1.0},\n  {\"id\":729522,\"suggestedTranslation\":\"Ừ thì, ít ra bây giờ nó là một cái bánh nướng.\",\"rating\":1.0},\n  {\"id\":729523,\"suggestedTranslation\":\"Đó chỉ là một câu chuyện bịa đặt thôi.\",\"rating\":1.0},\n  {\"id\":729524,\"suggestedTranslation\":\"Những chiếc vẩy đầy đau đớn.\",\"rating\":1.0},\n  {\"id\":729525,\"suggestedTranslation\":\"Nó thật lạnh lẽo... và đẹp đẽ.\",\"rating\":1.0},\n  {\"id\":729526,\"suggestedTranslation\":\"Có ích gì chứ?\",\"rating\":1.0},\n  {\"id\":729527,\"suggestedTranslation\":\"Tôi có dám tưởng tượng nó lớn lên từ loại bóng tối nào không nhỉ?\",\"rating\":1.0},\n  {\"id\":729528,\"suggestedTranslation\":\"Bạc phếch như những khúc xương phơi ngoài nắng.\",\"rating\":1.0},\n  {\"id\":729529,\"suggestedTranslation\":\"Ồ. Nó đang cháy kìa.\",\"rating\":1.0},\n  {\"id\":729530,\"suggestedTranslation\":\"Nỗi thống khổ của ngươi giờ đã chấm dứt.\",\"rating\":1.0},\n  {\"id\":729531,\"suggestedTranslation\":\"Nó đã tận số dưới tay chúng ta.\",\"rating\":1.0},\n  {\"id\":729532,\"suggestedTranslation\":\"Tàn tích bạc phếch của một cái cây chết.\",\"rating\":1.0},\n  {\"id\":729533,\"suggestedTranslation\":\"Phát ra tiếng bịp khá hay, lại còn bổ dưỡng nữa!\",\"rating\":1.0},\n  {\"id\":729534,\"suggestedTranslation\":\"Bớt sống đi, ngon miệng hơn rồi.\",\"rating\":1.0},\n  {\"id\":729535,\"suggestedTranslation\":\"Chuối mọc dưới ánh nắng mặt trời... thật bất tự nhiên làm sao.\",\"rating\":1.0},\n  {\"id\":729536,\"suggestedTranslation\":\"Thật đáng thương. Ngươi chẳng còn nhà để về.\",\"rating\":1.0},\n  {\"id\":729537,\"suggestedTranslation\":\"Cảm giác bị bứt khỏi ngôi nhà của mình ra sao hả?\",\"rating\":1.0},\n  {\"id\":729538,\"suggestedTranslation\":\"Tôi thích nó chết hơn, nhưng chắc nên trả nó về với đất mẹ.\",\"rating\":1.0},\n  {\"id\":729539,\"suggestedTranslation\":\"Tôi thích nó chết hơn, nhưng chắc nên trả nó về với đất mẹ.\",\"rating\":1.0},\n  {\"id\":729540,\"suggestedTranslation\":\"Ồ. Chúng mềm quá. Lại còn xù nữa chứ.\",\"rating\":1.0},\n  {\"id\":729541,\"suggestedTranslation\":\"Tôi thích nó chết hơn, nhưng chắc nên trả nó về với đất mẹ.\",\"rating\":1.0},\n  {\"id\":729542,\"suggestedTranslation\":\"Tiếc thật, nó không nghiền nát tôi luôn khi có cơ hội.\",\"rating\":1.0},\n  {\"id\":729543,\"suggestedTranslation\":\"Ồ. Nó nặng lắm đấy.\",\"rating\":1.0},\n  {\"id\":729544,\"suggestedTranslation\":\"Nó làm tôi lạnh thấu xương.\",\"rating\":1.0},\n  {\"id\":729545,\"suggestedTranslation\":\"Ai lại muốn mang một gánh nặng như thế chứ...\",\"rating\":1.0},\n  {\"id\":729546,\"suggestedTranslation\":\"Nó nặng gần bằng trái tim tôi vậy.\",\"rating\":1.0},\n  {\"id\":729547,\"suggestedTranslation\":\"Nó có thể sưởi ấm thể xác, nhưng chẳng thể sưởi ấm trái tim.\",\"rating\":1.0},\n  {\"id\":729548,\"suggestedTranslation\":\"Tất cả chúng ta đều mang một sức nặng lớn. Chỉ là của anh ta... có vẻ đen tối hơn một chút thôi.\",\"rating\":1.0},\n  {\"id\":729549,\"suggestedTranslation\":\"Nó gây ra nỗi đau bỏng rát.\",\"rating\":1.0},\n  {\"id\":729550,\"suggestedTranslation\":\"Gai góc và bốc mùi!\",\"rating\":1.0},\n  {\"id\":729551,\"suggestedTranslation\":\"Bớt gai hơn, nhưng lại càng bốc mùi hơn!\",\"rating\":1.0},\n  {\"id\":729552,\"suggestedTranslation\":\"Sao cái này lại phải mọc to đến thế cơ chứ?\",\"rating\":1.0},\n  {\"id\":729553,\"suggestedTranslation\":\"Đó là một mầm cây đang chờ ngày đơm hoa kết trái.\",\"rating\":1.0},\n  {\"id\":729554,\"suggestedTranslation\":\"Một món tráng miệng chẳng hề ngọt ngào...\",\"rating\":1.0},\n  {\"id\":729555,\"suggestedTranslation\":\"Chúng sinh ra hình như chỉ để dọn dẹp. Quả là một cuộc đời tẻ nhạt.\",\"rating\":1.0},\n  {\"id\":729556,\"suggestedTranslation\":\"Tội nghiệp, ngôi nhà của chúng không còn an toàn trước chúng ta nữa rồi.\",\"rating\":1.0},\n  {\"id\":729557,\"suggestedTranslation\":\"Cái chết cay đắng của chúng mang lại sự bảo vệ khỏi cái lạnh buốt giá.\",\"rating\":1.0},\n  {\"id\":729558,\"suggestedTranslation\":\"Một con lươn.\",\"rating\":1.0},\n  {\"id\":729559,\"suggestedTranslation\":\"Một con lươn đã được nấu chín.\",\"rating\":1.0},\n  {\"id\":729560,\"suggestedTranslation\":\"Gần giống như cây ô đầu chết người. Suýt thì phải.\",\"rating\":1.0},\n  {\"id\":729561,\"suggestedTranslation\":\"Nấu chín loại độc dược này càng làm nó bớt độc hơn.\",\"rating\":1.0},\n  {\"id\":729562,\"suggestedTranslation\":\"Đáng tiếc là nó không có độc, dù mang sắc tím ố bệnh.\",\"rating\":1.0},\n  {\"id\":729563,\"suggestedTranslation\":\"Đó là một mầm cây đang chờ ngày đơm hoa kết trái.\",\"rating\":1.0},\n  {\"id\":729564,\"suggestedTranslation\":\"Giá mà lúc đó tôi có thể giúp được cậu.\",\"rating\":1.0},\n  {\"id\":729565,\"suggestedTranslation\":\"Ít ra nó cũng sưởi ấm đôi tay tôi.\",\"rating\":1.0},\n  {\"id\":729566,\"suggestedTranslation\":\"Chẳng có gì là vĩnh cửu cả.\",\"rating\":1.0},\n  {\"id\":729567,\"suggestedTranslation\":\"Phiên bản bóng tối của nghệ thuật nhồi xác. Tôi thích nó.\",\"rating\":1.0},\n  {\"id\":729568,\"suggestedTranslation\":\"Nó đang tỏa sáng... tạm thời là thế.\",\"rating\":1.0},\n  {\"id\":729569,\"suggestedTranslation\":\"Chúng ta đã bứt những bông hoa khỏi ngôi nhà của chúng để giải trí.\",\"rating\":1.0},\n  {\"id\":729570,\"suggestedTranslation\":\"Rồi nó cũng sẽ chết mà thôi.\",\"rating\":1.0},\n  {\"id\":729571,\"suggestedTranslation\":\"Tôi nghĩ trông nó đáng yêu hơn thế này...\",\"rating\":1.0},\n  {\"id\":729572,\"suggestedTranslation\":\"Nó đang cháy rực rỡ.\",\"rating\":1.0},\n  {\"id\":729573,\"suggestedTranslation\":\"Đã bị vắt kiệt và tiêu đời.\",\"rating\":1.0},\n  {\"id\":729574,\"suggestedTranslation\":\"Mọi thứ đều phải chết.\",\"rating\":1.0},\n  {\"id\":729575,\"suggestedTranslation\":\"Thiên nhiên thật là nhàm chán.\",\"rating\":1.0},\n  {\"id\":729576,\"suggestedTranslation\":\"Nó đang cháy rực rỡ.\",\"rating\":1.0},\n  {\"id\":729577,\"suggestedTranslation\":\"Đã bị vắt kiệt và tiêu đời.\",\"rating\":1.0},\n  {\"id\":729578,\"suggestedTranslation\":\"Mọi thứ đều phải chết.\",\"rating\":1.0},\n  {\"id\":729579,\"suggestedTranslation\":\"Vòng đời của nó sắp kết thúc rồi.\",\"rating\":1.0}\n]",
