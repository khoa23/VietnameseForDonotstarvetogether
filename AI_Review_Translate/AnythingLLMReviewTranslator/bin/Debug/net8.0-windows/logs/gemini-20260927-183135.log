n    \"id\": 729256,\n    \"suggestedTranslation\": \"Bản đồ tuyệt nhất là khi có vẽ quái vật ở viền xung quanh.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 729257,\n    \"suggestedTranslation\": \"Ta tự hỏi liệu nó có một người sinh đôi không nhỉ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 729258,\n    \"suggestedTranslation\": \"Mọi con mèo rồi cũng phải chết.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 729259,\n    \"suggestedTranslation\": \"Ta có thể cuộn mình và chết trong đó.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 729260,\n    \"suggestedTranslation\": \"Không gì tuyệt bằng việc đội một thứ nồng nặc mùi tử khí lên đầu.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 729261,\n    \"suggestedTranslation\": \"Vòng luân hồi đã khép lại.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 729262,\n    \"suggestedTranslation\": \"Hãy gọi ta là Sisyphus đi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 729263,\n    \"suggestedTranslation\": \"Gần ngay trước mắt, mà sao xa xôi quá.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 729264,\n    \"suggestedTranslation\": \"Mấy vỏ chuối trông nguy hiểm đấy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 729265,\n    \"suggestedTranslation\": \"Cái chết và sự thống khổ không bao giờ chấm dứt.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 729266,\n    \"suggestedTranslation\": \"Chuối nghiền ấm nóng ngon hơn nhiều.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 729267,\n    \"suggestedTranslation\": \"Tội nghiệp thực vật, bị giam cầm cách biệt với ánh mặt trời.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 729268,\n    \"suggestedTranslation\": \"Ai đó đang cố ngăn chặn thế giới ngầm trỗi dậy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 729269,\n    \"suggestedTranslation\": \"Chẳng còn chỗ cho ta ở bữa tiệc hang động đó đâu...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 729270,\n    \"suggestedTranslation\": \"Ta còn bận phát điên nên chẳng có thời gian đi xuống cái hang đó đâu.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 729271,\n    \"suggestedTranslation\": \"Một thế lực tà ác vĩ đại đang ẩn nấp bên dưới bề mặt.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 729272,\n    \"suggestedTranslation\": \"Ai đó đang cố ngăn chặn thế giới ngầm trỗi dậy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 729273,\n    \"suggestedTranslation\": \"Ồ... Ta đoán mình không được mời đến bữa tiệc trên mặt đất rồi...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 729274,\n    \"suggestedTranslation\": \"Rời đi làm gì? Ánh sáng ở đây rất tôn lên làn da của ta.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 729275,\n    \"suggestedTranslation\": \"Mặt đất đang vẫy gọi kìa.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 729276,\n    \"suggestedTranslation\": \"Một chút sắc màu giữa chốn hiu hắt.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 729277,\n    \"suggestedTranslation\": \"Nó chết rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 729278,\n    \"suggestedTranslation\": \"Nó chết rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 729279,\n    \"suggestedTranslation\": \"Nó đã từng xuất hiện trên mặt đất bao giờ chưa nhỉ?\",\n    \"rating\": 9.0\n  }\n]",
