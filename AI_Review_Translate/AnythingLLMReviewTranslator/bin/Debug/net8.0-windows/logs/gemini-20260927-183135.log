            "text": "[\n  {\"id\": 731080, \"suggestedTranslation\": \"Nó bị nhiễm khuẩn rồi.\", \"rating\": 8.5},\n  {\"id\": 731081, \"suggestedTranslation\": \"Trông thật uy quyền trong bộ dạng ghê rợn ấy.\", \"rating\": 8.5},\n  {\"id\": 731082, \"suggestedTranslation\": \"Em ấy có thể nghỉ ngơi rồi.\", \"rating\": 8.5},\n  {\"id\": 731083, \"suggestedTranslation\": \"Con bé chỉ đang bảo vệ các con của mình thôi.\", \"rating\": 8.5},\n  {\"id\": 731084, \"suggestedTranslation\": \"Đôi khi chết đi lại tốt hơn.\", \"rating\": 8.5},\n  {\"id\": 731085, \"suggestedTranslation\": \"Bóng đêm đã hút sạch màu sắc từ bộ lông của chúng.\", \"rating\": 8.5},\n  {\"id\": 731086, \"suggestedTranslation\": \"Nó chỉ đang kéo dài sự không thể tránh khỏi thôi. Buồn làm sao.\", \"rating\": 8.5},\n  {\"id\": 731087, \"suggestedTranslation\": \"Chỉ là một khoảng thời gian tạm nghỉ khỏi nỗi đau của thế giới này.\", \"rating\": 8.5},\n  {\"id\": 731088, \"suggestedTranslation\": \"Một con nhện hèn nhát.\", \"rating\": 8.5},\n  {\"id\": 731089, \"suggestedTranslation\": \"Đó là quy luật của vạn vật.\", \"rating\": 8.5},\n  {\"id\": 731090, \"suggestedTranslation\": \"Cái chết bước đi trên cẳng chân.\", \"rating\": 8.5},\n  {\"id\": 731091, \"suggestedTranslation\": \"Nó đang ngủ say.\", \"rating\": 8.5},\n  {\"id\": 731092, \"suggestedTranslation\": \"Dường như chẳng có gì tôi thử là hoạt động hiệu quả cả.\", \"rating\": 8.5},\n  {\"id\": 731093, \"suggestedTranslation\": \"Nó đang nhai thứ gì đó.\", \"rating\": 8.5},\n  {\"id\": 731094, \"suggestedTranslation\": \"Hỡi chiến binh dũng cảm, than ôi.\", \"rating\": 8.5},\n  {\"id\": 731095, \"suggestedTranslation\": \"Một chiến binh của màn đêm!\", \"rating\": 8.5},\n  {\"id\": 731096, \"suggestedTranslation\": \"Tôi phải cẩn thận mới được.\", \"rating\": 8.5},\n  {\"id\": 731097, \"suggestedTranslation\": \"Cân chân của nó trông thật mảnh mai và yếu ớt, như thể sẽ gãy ngay chỉ với một cú đá nhẹ...\", \"rating\": 8.5},\n  {\"id\": 731098, \"suggestedTranslation\": \"Tôi không nghĩ mình muốn chơi đùa với thứ đó đâu.\", \"rating\": 8.5},\n  {\"id\": 731099, \"suggestedTranslation\": \"Tạm biệt nhé, bạn hiền.\", \"rating\": 8.5},\n  {\"id\": 731100, \"suggestedTranslation\": \"Cuối cùng rồi mọi thứ cũng trở thành tro bụi.\", \"rating\": 8.5},\n  {\"id\": 731101, \"suggestedTranslation\": \"Cuộc đời nó ngắn ngủi, nhưng thật đẹp.\", \"rating\": 8.5},\n  {\"id\": 731102, \"suggestedTranslation\": \"Đã có bao nhiêu sinh mệnh ngã xuống. Nhưng chiếc két sắt này thì an toàn.\", \"rating\": 8.5},\n  {\"id\": 731103, \"suggestedTranslation\": \"Bùm, sinh vật nhỏ bé giống chồn đã biến mất.\", \"rating\": 8.5},\n  {\"id\": 731104, \"suggestedTranslation\": \"Nó chẳng có khái niệm gì về thời gian hay sự mất mát.\", \"rating\": 8.5},\n  {\"id\": 731105, \"suggestedTranslation\": \"Đã có bao nhiêu sinh mệnh ngã xuống. Nhưng chiếc két sắt này thì an toàn.\", \"rating\": 8.5},\n  {\"id\": 731106, \"suggestedTranslation\": \"Hãy tự do nhé, bé con!\", \"rating\": 8.5},\n  {\"id\": 731107, \"suggestedTranslation\": \"Đã có bao nhiêu sinh mệnh ngã xuống. Nhưng chiếc két sắt này thì an toàn.\", \"rating\": 8.5},\n  {\"id\": 731108, \"suggestedTranslation\": \"Ánh mắt rực rỡ cho những thời khắc đen tối.\", \"rating\": 8.5},\n  {\"id\": 731109, \"suggestedTranslation\": \"Những vì sao cũng lụi tàn giống như mọi thứ khác...\", \"rating\": 8.5},\n  {\"id\": 731110, \"suggestedTranslation\": \"Tôi suýt có thể nhìn ra một hệ mặt trời thu nhỏ.\", \"rating\": 8.5},\n  {\"id\": 731111, \"suggestedTranslation\": \"Nó sẽ giúp tôi đảm bảo không ai đến quá gần.\", \"rating\": 8.5},\n  {\"id\": 731112, \"suggestedTranslation\": \"Ngoài kia thời tiết đúng là tệ thật.\", \"rating\": 8.5},\n  {\"id\": 731113, \"suggestedTranslation\": \"Một sinh vật bóng tối luôn tìm kiếm ánh sáng... thật đáng thương...\", \"rating\": 8.5},\n  {\"id\": 731114, \"suggestedTranslation\": \"Trái tim tôi nhói đau trước vẻ đẹp ấy.\", \"rating\": 8.5},\n  {\"id\": 731115, \"suggestedTranslation\": \"Trái tim tôi nhói đau trước vẻ đẹp ấy.\", \"rating\": 8.5},\n  {\"id\": 731116, \"suggestedTranslation\": \"Một sinh vật bóng tối luôn tìm kiếm ánh sáng... thật đáng thương...\", \"rating\": 8.5},\n  {\"id\": 731117, \"suggestedTranslation\": \"Trái đất dâng hiến món quà của mình.\", \"rating\": 8.5},\n  {\"id\": 731118, \"suggestedTranslation\": \"Mặt đất vươn lên.\", \"rating\": 8.5},\n  {\"id\": 731119, \"suggestedTranslation\": \"Ngay cả cái chết cũng không phải là vĩnh viễn.\", \"rating\": 8.5},\n  {\"id\": 731120, \"suggestedTranslation\": \"Ngươi cũng biết đau buồn sao?\", \"rating\": 8.5},\n  {\"id\": 731121, \"suggestedTranslation\": \"Cái chết sẽ là một sự dung túng.\", \"rating\": 8.5},\n  {\"id\": 731122, \"suggestedTranslation\": \"Anh ta đang bị ám ảnh bởi quá khứ...\", \"rating\": 8.5},\n  {\"id\": 731123, \"suggestedTranslation\": \"Chẳng có tấm bản đồ nào dẫn tôi đến thứ trái tim mình tìm kiếm cả.\", \"rating\": 8.5},\n  {\"id\": 731124, \"suggestedTranslation\": \"Cái chết đã cướp đi nó rồi.\", \"rating\": 8.5},\n  {\"id\": 731125, \"suggestedTranslation\": \"Đó LÀ cái gì thế kia?!\", \"rating\": 8.5},\n  {\"id\": 731126, \"suggestedTranslation\": \"Có lẽ những bức tượng này sẽ bầu bạn với tôi.\", \"rating\": 8.5},\n  {\"id\": 731127, \"suggestedTranslation\": \"Bị bỏ hoang và cỏ dại mọc đầy.\", \"rating\": 8.5},\n  {\"id\": 731128, \"suggestedTranslation\": \"Mọi chuyện có diễn ra theo đúng kế hoạch của ngươi không?\", \"rating\": 8.5},\n  {\"id\": 731129, \"suggestedTranslation\": \"Lạnh lẽo, và những viên đá cứng nhắc...\", \"rating\": 8.5},\n  {\"id\": 731130, \"suggestedTranslation\": \"Mỗi chúng ta đều đeo rất nhiều lớp mặt nạ...\", \"rating\": 8.5},\n  {\"id\": 731131, \"suggestedTranslation\": \"Một suy nghĩ ớn lạnh... điều gì sẽ xảy ra nếu đằng sau lớp mặt nạ chẳng có gì?\", \"rating\": 8.5},\n  {\"id\": 731132, \"suggestedTranslation\": \"Đó là một chiếc bình hoa đáng yêu.\", \"rating\": 8.5},\n  {\"id\": 731133, \"suggestedTranslation\": \"Thứ này chẳng mang lại chút hy vọng ấm áp nào.\", \"rating\": 8.5},\n  {\"id\": 731134, \"suggestedTranslation\": \"Nhưng tôi vẫn là kẻ mất phương hướng.\", \"rating\": 8.5},\n  {\"id\": 731135, \"suggestedTranslation\": \"Nó có thể dùng làm một chiếc bánh lái...\", \"rating\": 8.5},\n  {\"id\": 731136, \"suggestedTranslation\": \"Nhọn hoắt và chết chóc.\", \"rating\": 8.5},\n  {\"id\": 731137, \"suggestedTranslation\": \"Abigail?\", \"rating\": 8.5},\n  {\"id\": 731138, \"suggestedTranslation\": \"Cẩn thận cậu đang ngồi lên Abigail đấy.\", \"rating\": 8.5},\n  {\"id\": 731139, \"suggestedTranslation\": \"Nơi trốn tìm yêu thích của Abigail.\", \"rating\": 8.5},\n  {\"id\": 731140, \"suggestedTranslation\": \"Nơi trốn tìm yêu thích của Abigail.\", \"rating\": 8.5},\n  {\"id\": 731141, \"suggestedTranslation\": \"Liệu một cỗ máy có thực sự chết được không?\", \"rating\": 8.5},\n  {\"id\": 731142, \"suggestedTranslation\": \"Nó thiếu đi một linh hồn.\", \"rating\": 8.5},\n  {\"id\": 731143, \"suggestedTranslation\": \"Khi mặt trời thiêu đốt không thương tiếc, sự sống vẫn tìm cách sinh tồn. Hừ.\", \"rating\": 8.5},\n  {\"id\": 731144, \"suggestedTranslation\": \"Cây độc dược. Chắc là không chứa đầy chất độc đâu.\", \"rating\": 8.5},\n  {\"id\": 731145, \"suggestedTranslation\": \"Có lẽ làm đầy chiếc bụng này sẽ giúp tôi thấy đỡ trống trải hơn bên trong.\", \"rating\": 8.5},\n  {\"id\": 731146, \"suggestedTranslation\": \"Bị bứt khỏi sự an toàn của ngôi nhà sa mạc.\", \"rating\": 8.5},\n  {\"id\": 731147, \"suggestedTranslation\": \"Tôi thích mùi hương của chúng.\", \"rating\": 8.5},\n  {\"id\": 731148, \"suggestedTranslation\": \"Sự sống thật kiên cường.\", \"rating\": 8.5},\n  {\"id\": 731149, \"suggestedTranslation\": \"Cái lồng dát vàng này làm bằng gốm đấy.\", \"rating\": 8.5},\n  {\"id\": 731150, \"suggestedTranslation\": \"Chẳng có kho báu nào có thể thay thế được những gì tôi đã mất.\", \"rating\": 8.5},\n  {\"id\": 731151, \"suggestedTranslation\": \"Dĩ nhiên rồi. Nó bị khóa mà.\", \"rating\": 8.5},\n  {\"id\": 731152, \"suggestedTranslation\": \"Tôi chẳng thấy có gì gọi là hoành tráng ở thứ này cả.\", \"rating\": 8.5},\n  {\"id\": 731153, \"suggestedTranslation\": \"Những vết nứt đã bắt đầu xuất hiện...\", \"rating\": 8.5},\n  {\"id\": 731154, \"suggestedTranslation\": \"Chẳng có gì tốt đẹp là tồn tại mãi mãi...\", \"rating\": 8.5},\n  {\"id\": 731155, \"suggestedTranslation\": \"Nó hứa hẹn sự bảo vệ, nhưng được bao lâu chứ?\", \"rating\": 8.5},\n  {\"id\": 731156, \"suggestedTranslation\": \"Những vết nứt đã bắt đầu xuất hiện...\", \"rating\": 8.5},\n  {\"id\": 731157, \"suggestedTranslation\": \"Cuối cùng thì tất cả chúng ta đều sẽ sụp đổ.\", \"rating\": 8.5},\n  {\"id\": 731158, \"suggestedTranslation\": \"Thật đáng sợ, nhưng cũng thật an ủi.\", \"rating\": 8.5},\n  {\"id\": 731159, \"suggestedTranslation\": \"Cái gì đang ẩn giấu bên dưới tấm vải che đó vậy?\", \"rating\": 8.5},\n  {\"id\": 731160, \"suggestedTranslation\": \"Cái gì đang ẩn giấu bên dưới tấm vải che đó vậy?\", \"rating\": 8.5},\n  {\"id\": 731161, \"suggestedTranslation\": \"Mọi chuyện có thể còn tồi tệ hơn.\", \"rating\": 8.5},\n  {\"id\": 731162, \"suggestedTranslation\": \"Những mảnh xác của sinh vật, được làm thành một chiếc áo lê!\", \"rating\": 8.5},\n  {\"id\": 731163, \"suggestedTranslation\": \"Ồ Abigail, cậu có nhớ mẹ thường làm món này mỗi năm không?\", \"rating\": 8.5},\n  {\"id\": 731164, \"suggestedTranslation\": \"Cậu có muốn tham gia một bữa tiệc trà không, Abigail?\", \"rating\": 8.5},\n  {\"id\": 731165, \"suggestedTranslation\": \"Một ngọn hải đăng lấp lánh của nỗi đau.\", \"rating\": 8.5},\n  {\"id\": 731166, \"suggestedTranslation\": \"Có vẻ như thời gian ăn mừng đã kết thúc.\", \"rating\": 8.5},\n  {\"id\": 731167, \"suggestedTranslation\": \"Một chiếc bàn để tụ họp.\", \"rating\": 8.5},\n  {\"id\": 731168, \"suggestedTranslation\": \"Ước gì Abigail có thể thưởng thức một ít.\", \"rating\": 8.5},\n  {\"id\": 731169, \"suggestedTranslation\": \"Giống như tôi, nó chẳng thuộc về nơi này.\", \"rating\": 8.5},\n  {\"id\": 731170, \"suggestedTranslation\": \"Ít nhất tôi sẽ không phải nhét mồi câu vào túi quần nữa.\", \"rating\": 8.5},\n  {\"id\": 731171, \"suggestedTranslation\": \"Những phương pháp mới để cướp đi cuộc sống yên bình của loài cá.\", \"rating\": 8.5},\n  {\"id\": 731172, \"suggestedTranslation\": \"Hãy cẩn thận đấy hỡi mọi loài cá.\", \"rating\": 8.5},\n  {\"id\": 731173, \"suggestedTranslation\": \"Ai mà ngờ những thứ ngọt ngào thế này lại tồn tại ở đây chứ?\", \"rating\": 8.5},\n  {\"id\": 731174, \"suggestedTranslation\": \"Được giải thoát khỏi xiềng xích của bầu trời.\", \"rating\": 8.5},\n  {\"id\": 731175, \"suggestedTranslation\": \"Tràn trề tiềm năng.\", \"rating\": 8.5},\n  {\"id\": 731176, \"suggestedTranslation\": \"Bao nhiêu tiềm năng, vụt mất sạch. Ăn kèm thịt xông khói cũng không tệ.\", \"rating\": 8.5},\n  {\"id\": 731177, \"suggestedTranslation\": \"Bị bóng đêm làm cho lạnh cóng.\", \"rating\": 8.5},\n  {\"id\": 731178, \"suggestedTranslation\": \"Một sinh vật nhỏ bé, mỏng manh đang vật lộn tìm ánh sáng.\", \"rating\": 8.5},\n  {\"id\": 731179, \"suggestedTranslation\": \"Nó không chịu nổi sức nóng đâu.\", \"rating\": 8.5},\n  {\"id\": 731180, \"suggestedTranslation\": \"Một cuộc đời bắt đầu sớm thì cũng sẽ kết thúc sớm.\", \"rating\": 8.5},\n  {\"id\": 731181, \"suggestedTranslation\": \"Sắp rồi.\", \"rating\": 8.5},\n  {\"id\": 731182, \"suggestedTranslation\": \"Quả trứng đó đại diện cho một sự sống mới. Hừ.\", \"rating\": 8.5},\n  {\"id\": 731183, \"suggestedTranslation\": \"Cái tổ trống không. Trống hoác. Cằn cỗi. Một khoảng không.\", \"rating\": 8.5},\n  {\"id\": 731184, \"suggestedTranslation\": \"Một sinh mạng bị tước đoạt... và được bọc trong xúc xích chiên.\", \"rating\": 8.5},\n  {\"id\": 731185, \"suggestedTranslation\": \"Những chiếc túi ấm áp nhỏ bé trong thế giới lạnh lẽo này.\", \"rating\": 8.5},\n  {\"id\": 731186, \"suggestedTranslation\": \"Cậu cũng sẽ bỏ đi sao?\", \"rating\": 8.5},\n  {\"id\": 731187, \"suggestedTranslation\": \"Tất cả chúng ta đều cố gắng lấp đầy khoảng trống.\", \"rating\": 8.5},\n  {\"id\": 731188, \"suggestedTranslation\": \"Nghỉ ngơi đi.\", \"rating\": 8.5},\n  {\"id\": 731189, \"suggestedTranslation\": \"Bản chất thật của ngươi đã lộ diện!\", \"rating\": 8.5},\n  {\"id\": 731190, \"suggestedTranslation\": \"Tâm điểm thật vô hồn.\", \"rating\": 8.5},\n  {\"id\": 731191, \"suggestedTranslation\": \"Năng lượng đang tuôn chảy qua nó.\", \"rating\": 8.5},\n  {\"id\": 731192, \"suggestedTranslation\": \"Tôi chắc chắn cõi tiếp theo sẽ còn khủng khiếp hơn nữa!\", \"rating\": 8.5},\n  {\"id\": 731193, \"suggestedTranslation\": \"Chẳng có điều gì tốt đẹp từ thứ này đâu.\", \"rating\": 8.5},\n  {\"id\": 731194, \"suggestedTranslation\": \"Nó vẫn bị khóa chặt.\", \"rating\": 8.5},\n  {\"id\": 731195, \"suggestedTranslation\": \"Nó được xây một nửa, hay đã bị phá hủy một nửa nhỉ?\", \"rating\": 8.5},\n  {\"id\": 731196, \"suggestedTranslation\": \"Nó chứa đựng một tia sáng sự sống thiết yếu.\", \"rating\": 8.5},\n  {\"id\": 731197, \"suggestedTranslation\": \"Trông có vẻ phức tạp.\", \"rating\": 8.5},\n  {\"id\": 731198, \"suggestedTranslation\": \"Thật là một tạo vật gớm ghiếc!\", \"rating\": 8.5},\n  {\"id\": 731199, \"suggestedTranslation\": \"Nó không có cạnh sắc nào cả.\", \"rating\": 8.5},\n  {\"id\": 731200, \"suggestedTranslation\": \"Chúng ta có thể trốn thoát nếu nó mạnh hơn.\", \"rating\": 8.5},\n  {\"id\": 731201, \"suggestedTranslation\": \"Một khung cảnh hé lộ trước ngọn lửa địa ngục.\", \"rating\": 8.5},\n  {\"id\": 731202, \"suggestedTranslation\": \"Giấc ngủ chỉ là sự hé lộ trước cái chết.\", \"rating\": 8.5},\n  {\"id\": 731203, \"suggestedTranslation\": \"Dài, mỏng và nguy hiểm!\", \"rating\": 8.5},\n  {\"id\": 731204, \"suggestedTranslation\": \"Nhọn, nhầy nhụa và nguy hiểm.\", \"rating\": 8.5},\n  {\"id\": 731205, \"suggestedTranslation\": \"Tốt nhất là không nên nhắc đến chúng.\", \"rating\": 8.5},\n  {\"id\": 731206, \"suggestedTranslation\": \"Cái này khác biệt đấy.\", \"rating\": 8.5},\n  {\"id\": 731207, \"suggestedTranslation\": \"Thì ra đây là những gì diễn ra dưới lòng đất.\", \"rating\": 8.5},\n  {\"id\": 731208, \"suggestedTranslation\": \"Mấy đứa bé kìa!\", \"rating\": 8.5},\n  {\"id\": 731209, \"suggestedTranslation\": \"Nó sẽ quay lại vào một ngày nào đó.\", \"rating\": 8.5},\n  {\"id\": 731210, \"suggestedTranslation\": \"Mọi vẻ đẹp đều phai mờ theo thời gian.\", \"rating\": 8.5},\n  {\"id\": 731211, \"suggestedTranslation\": \"Bóng đêm của thế giới này đã làm vấy bẩn nó.\", \"rating\": 8.5},\n  {\"id\": 731212, \"suggestedTranslation\": \"À... vậy là nó đã trốn thoát rồi.\", \"rating\": 8.5},\n  {\"id\": 731213, \"suggestedTranslation\": \"Biết bao vẻ đẹp chứa đựng bên trong, liệu nó có bao giờ trốn thoát không?\", \"rating\": 8.5},\n  {\"id\": 731214, \"suggestedTranslation\": \"Hãy để nó bị niêm phong vĩnh viễn.\", \"rating\": 8.5},\n  {\"id\": 731215, \"suggestedTranslation\": \"Abigail, có phải cậu đang làm thế không?\", \"rating\": 8.5},\n  {\"id\": 731216, \"suggestedTranslation\": \"Nó vốn không thuộc về thế giới này.\", \"rating\": 8.5},\n  {\"id\": 731217, \"suggestedTranslation\": \"Những thứ khủng khiếp nào đang ẩn giấu bên trong thế?\", \"rating\": 8.5},\n  {\"id\": 731218, \"suggestedTranslation\": \"Tôi cảm thấy ánh sáng kỳ lạ của nó đang kéo mình lại gần, như thiêu thân lao vào lửa.\", \"rating\": 8.5},\n  {\"id\": 731219, \"suggestedTranslation\": \"Sự hiện diện của nó đánh dấu rìa của vùng đất không rõ.\", \"rating\": 8.5},\n  {\"id\": 731220, \"suggestedTranslation\": \"Chiếc vợt rồi sẽ đến tìm tất cả chúng ta.\", \"rating\": 8.5},\n  {\"id\": 731221, \"suggestedTranslation\": \"Những mảnh vỡ của một vật liệu mạnh mẽ.\", \"rating\": 8.5},\n  {\"id\": 731222, \"suggestedTranslation\": \"Một hòn than hồng cháy rực với bản chất của những cơn ác mộng.\", \"rating\":