            "text": "[\n  {\"id\":731933,\"suggestedTranslation\":\"Ánh sáng dịu nhẹ này... thật dễ chịu.\",\"rating\":9.0},\n  {\"id\":731934,\"suggestedTranslation\":\"Chút an ủi ít ỏi đó giờ đã biến mất.\",\"rating\":9.0},\n  {\"id\":731935,\"suggestedTranslation\":\"Tôi nên tìm một chỗ phù hợp cho nó.\",\"rating\":9.0},\n  {\"id\":731936,\"suggestedTranslation\":\"Chiếc chuông tạm thời vẫn đang im lìm.\",\"rating\":9.0},\n  {\"id\":731937,\"suggestedTranslation\":\"Tôi có thể... chơi tiếp không?\",\"rating\":9.0},\n  {\"id\":731938,\"suggestedTranslation\":\"Có lẽ nó sẽ... v-vui nhỉ?\",\"rating\":9.0},\n  {\"id\":731939,\"suggestedTranslation\":\"Tôi nghĩ... tôi muốn ăn một chút bánh ngọt.\",\"rating\":9.0},\n  {\"id\":731940,\"suggestedTranslation\":\"Giờ môi tôi đã chuyển sang màu xanh rồi...\",\"rating\":9.0},\n  {\"id\":731941,\"suggestedTranslation\":\"Tôi xin lỗi Abigail, nếu được tôi đã chia sẻ rồi.\",\"rating\":9.0},\n  {\"id\":731942,\"suggestedTranslation\":\"Nó dính quá.\",\"rating\":9.0},\n  {\"id\":731943,\"suggestedTranslation\":\"Tội nghiệp ngài Thỏ.\",\"rating\":9.0},\n  {\"id\":731944,\"suggestedTranslation\":\"Ngài có đói không, ngài Thỏ?\",\"rating\":9.0},\n  {\"id\":731945,\"suggestedTranslation\":\"Tôi nên bày tỏ sự kính trọng.\",\"rating\":9.0},\n  {\"id\":731946,\"suggestedTranslation\":\"Một trận quyết đấu tử thần có lẽ sẽ giúp giết thời gian.\",\"rating\":9.0},\n  {\"id\":731947,\"suggestedTranslation\":\"Tiếc thật, nó đẹp mà.\",\"rating\":9.0},\n  {\"id\":731948,\"suggestedTranslation\":\"Nó thực sự mang lại chút phấn chấn.\",\"rating\":9.0},\n  {\"id\":731949,\"suggestedTranslation\":\"Ta có nên thắp sáng bóng đêm này không?\",\"rating\":9.5},\n  {\"id\":731950,\"suggestedTranslation\":\"Cũng dễ đoán trước thôi.\",\"rating\":9.0},\n  {\"id\":731951,\"suggestedTranslation\":\"Có lẽ vật gì thu hút vật nấy.\",\"rating\":9.0},\n  {\"id\":731952,\"suggestedTranslation\":\"Abigail rất thích những điều bất ngờ.\",\"rating\":9.0},\n  {\"id\":731953,\"suggestedTranslation\":\"Nó thực sự khá đẹp đấy chứ.\",\"rating\":9.0},\n  {\"id\":731954,\"suggestedTranslation\":\"Hết rồi.\",\"rating\":9.0},\n  {\"id\":731955,\"suggestedTranslation\":\"Tôi nên buông bỏ thứ gì để làm hài lòng nó đây?\",\"rating\":9.0},\n  {\"id\":731956,\"suggestedTranslation\":\"Sao cậu biết tôi điên?\",\"rating\":9.0},\n  {\"id\":731957,\"suggestedTranslation\":\"H F... Tôi không biết nữa.\",\"rating\":9.0},\n  {\"id\":731958,\"suggestedTranslation\":\"Ít ra thì thực vật trông có vẻ vẫn ổn.\",\"rating\":9.5},\n  {\"id\":731959,\"suggestedTranslation\":\"Thứ gì quanh đây đang làm nó thấy khó sống đây.\",\"rating\":9.0},\n  {\"id\":731960,\"suggestedTranslation\":\"Nó cô đơn quá... nó cần gia đình...\",\"rating\":9.0},\n  {\"id\":731961,\"suggestedTranslation\":\"Có lẽ nó chỉ cần được trấn an đôi chút.\",\"rating\":9.0},\n  {\"id\":731962,\"suggestedTranslation\":\"Khu vườn hơi bừa bộn một chút...\",\"rating\":9.0},\n  {\"id\":731963,\"suggestedTranslation\":\"Có lẽ nó cần chút nước chăng?\",\"rating\":9.0},\n  {\"id\":731964,\"suggestedTranslation\":\"Nó đang khát dưỡng chất trầm trọng.\",\"rating\":9.0},\n  {\"id\":731965,\"suggestedTranslation\":\"Nó ở quá gần mấy cây khác... sắp ngột ngạt đến nơi rồi...\",\"rating\":9.0},\n  {\"id\":731966,\"suggestedTranslation\":\"Nó vốn không được sinh ra để chịu đựng sự khắc nghiệt của mùa này.\",\"rating\":9.0},\n  {\"id\":731967,\"suggestedTranslation\":\"Nó đích thực là đang đau khổ. Đúng là đồng bệnh tương lân.\",\"rating\":9.0},\n  {\"id\":731968,\"suggestedTranslation\":\"Nó sắp bị ngọn lửa nuốt chửng rồi.\",\"rating\":9.0},\n  {\"id\":731969,\"suggestedTranslation\":\"Bóng đêm kìa! Tối quá rồi!\",\"rating\":9.5},\n  {\"id\":731970,\"suggestedTranslation\":\"Tôi đã tha cho nó khỏi sự dằn vặt của việc phải sống.\",\"rating\":9.0},\n  {\"id\":731971,\"suggestedTranslation\":\"Abigail, cảm giác như tớ vừa nếm được món ăn của mẹ vậy...\",\"rating\":9.0},\n  {\"id\":731972,\"suggestedTranslation