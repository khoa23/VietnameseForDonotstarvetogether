            "text": "[\n  {\n    \"id\": 732833,\n    \"suggestedTranslation\": \"Phải thừa nhận là hiệu ứng của nó khá nổi bật.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732834,\n    \"suggestedTranslation\": \"Sẽ khôn ngoan hơn nếu trang bị cho thuyền ván một lớp rào chắn bảo vệ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732835,\n    \"suggestedTranslation\": \"Nó không phải là đồ chơi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732836,\n    \"suggestedTranslation\": \"Một vũ khí cực kỳ hiệu quả trong chiến đấu trên biển, khi được nạp đạn đầy đủ.\",\n    \"rating\": 9.0\n  },\n    {\n    \"id\": 732837,\n    \"suggestedTranslation\": \"Vẫn còn vấn đề nhỏ về đạn dược đây, thân mến...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732838,\n    \"suggestedTranslation\": \"Thật không may, đây là một sự phòng ngừa cần thiết.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732839,\n    \"suggestedTranslation\": \"Độ bền của nó còn là một dấu hỏi, nhưng tạm dùng lúc này thì được.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732840,\n    \"suggestedTranslation\": \"Nó sẽ giúp chúng ta ra nước.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732841,\n    \"suggestedTranslation\": \"Tàu của chúng ta đang bị ngập nước.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732842,\n    \"suggestedTranslation\": \"Lực từ mạnh mẽ sẽ kéo con tàu của tôi về phía mục tiêu của nó.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732843,\n    \"suggestedTranslation\": \"Thiết kế của nó có phần kỳ cục, nhưng lý thuyết thì hoàn toàn hợp lý.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732844,\n    \"suggestedTranslation\": \"Hải đăng nam châm đã được kích hoạt.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732845,\n    \"suggestedTranslation\": \"Nó sẽ thu hút các nam châm điện lớn, nhưng chỉ khi được kích hoạt.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732846,\n    \"suggestedTranslation\": \"Lát nữa tôi phải nói chuyện với anh ta về mấy câu dài dòng trong hướng dẫn mới được.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732847,\n    \"suggestedTranslation\": \"Nó cho phép tôi xoay boong tàu trong khi vẫn giữ nguyên hướng đi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732848,\n    \"suggestedTranslation\": \"Nó sẽ cải thiện khả năng điều khiển của thuyền ván.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732849,\n    \"suggestedTranslation\": \"Những sợi lông của bò lai tạo nên lớp đệm tuyệt vời.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732850,\n    \"suggestedTranslation\": \"Thật là một cách tận dụng tảo biển đầy thú vị.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732851,\n    \"suggestedTranslation\": \"Nó tỏa ra một hương thơm hoa cỏ nhẹ nhàng.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732852,\n    \"suggestedTranslation\": \"Cái này có vẻ không thích hợp cho một giấc ngủ đêm ngon giấc.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732853,\n    \"suggestedTranslation\": \"Năng lượng không ổn định, hầu như chỉ được giữ lại nhờ lớp biểu bì thực vật cứng cáp.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732854,\n    \"suggestedTranslation\": \"Người bạn xanh tươi của chúng ta có vẻ đã dùng phép thuật của cậu ấy lên cái này.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732855,\n    \"suggestedTranslation\": \"Tàn tích của một cuộc đời sống trọn vẹn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732856,\n    \"suggestedTranslation\": \"Cực kỳ đậm đà. Tôi không ngại ăn thêm chén nữa đâu.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732857,\n    \"suggestedTranslation\": \"Không giống cách mẹ hay làm lắm, nhưng mùi thơm tuyệt cú mèo!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732858,\n    \"suggestedTranslation\": \"Ít có gì đau lòng bằng cảnh những cuốn sách bị phá hủy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732859,\n    \"suggestedTranslation\": \"Những bộ óc ham học hỏi nên luôn có quyền tiếp cận thư viện.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732860,\n    \"suggestedTranslation\": \"Tôi bắt đầu khá thích việc nuôi ong rồi đấy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732861,\n    \"suggestedTranslation\": \"Bản đã được kiểm duyệt, nhưng có loài tôi thích nhất: Megascops kennicottii.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732862,\n    \"suggestedTranslation\": \"Chuyện tồi tệ nào có thể xảy ra được cơ chứ?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732863,\n    \"suggestedTranslation\": \"Một cuốn sách phép triệu hồi mạnh mẽ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732864,\n    \"suggestedTranslation\": \"Ngay cả bất hạnh cũng mang lại cơ hội học hỏi. Những sai lầm trong quá khứ sẽ không lặp lại.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732865,\n    \"suggestedTranslation\": \"Nó bắt đầu bằng một cú lừa khá cuốn hút.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732866,\n    \"suggestedTranslation\": \"Một cuốn sách về hóa đá gia tốc.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732867,\n    \"suggestedTranslation\": \"Những thực vật đã chết buộc lại với nhau để giúp tôi hỗ trợ những thực vật còn sống.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732868,\n    \"suggestedTranslation\": \"Toàn những mẹo hay nhất của tôi để giúp khu vườn đơm hoa kết trái.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732869,\n    \"suggestedTranslation\": \"Nhân loại đã canh tác hoa màu từ nhiều thế kỷ, và vẫn còn rất nhiều điều để học hỏi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732870,\n    \"suggestedTranslation\": \"Tôi thích đọc vài cuốn sách nhẹ nhàng vào buổi tối.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732871,\n    \"suggestedTranslation\": \"Tôi đã cho nó một đánh giá rực rỡ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732872,\n    \"suggestedTranslation\": \"Việc nghiên cứu các kho lưu trữ cổ đại hóa ra lại mang tính giáo dục cao.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 732873,\n    \"suggestedTranslation\": \"Một hướng dẫn súc tích, không có bất kỳ lời lẽ