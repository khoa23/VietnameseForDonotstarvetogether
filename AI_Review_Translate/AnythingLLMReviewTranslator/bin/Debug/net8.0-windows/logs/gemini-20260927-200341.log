          {
            "text": "[\n  {\"id\": 732533, \"suggestedTranslation\": \"Nó đã quay trở lại với nguồn năng lượng mặt trăng sục sôi.\", \"rating\": 9.0},\n  {\"id\": 732534, \"suggestedTranslation\": \"Cái này thật sự rất độc đáo.\", \"rating\": 9.0},\n  {\"id\": 732535, \"suggestedTranslation\": \"Ta nghi ngờ nó sẽ nằm im bất động được lâu đâu.\", \"rating\": 9.0},\n  {\"id\": 732536, \"suggestedTranslation\": \"Thật thú vị, có vẻ như nó tận dụng các khía cạnh của bệ thờ để chiến đấu.\", \"rating\": 9.0},\n  {\"id\": 732537, \"suggestedTranslation\": \"Ta nên cố gắng để không bị kẹt trong các hàng rào của nó.\", \"rating\": 9.0},\n  {\"id\": 732538, \"suggestedTranslation\": \"Nếu giả thuyết của ta chính xác, đây sẽ là hình thái cuối cùng của nó.\", \"rating\": 9.0},\n  {\"id\": 732539, \"suggestedTranslation\": \"Khi đã rút cạn năng lượng, ta nghi ngờ nó có thể tái tạo lại được.\", \"rating\": 9.0},\n  {\"id\": 732540, \"suggestedTranslation\": \"Thật thú vị, có vẻ như nó vẫn giữ lại nguồn năng lượng cung cấp cho nó.\", \"rating\": 9.0},\n  {\"id\": 732541, \"suggestedTranslation\": \"Chúng có vẻ gây ra hiệu ứng buồn ngủ. Tốt nhất là nên tránh xa.\", \"rating\": 9.0},\n  {\"id\": 732542, \"suggestedTranslation\": \"Một sự kết hợp kỳ lạ giữa các bộ phận máy móc và năng lượng mặt trăng có tri giác.\", \"rating\": 9.0},\n  {\"id\": 732543, \"suggestedTranslation\": \"Một thánh tích từ thời đại khác.\", \"rating\": 9.5},\n  {\"id\": 732544, \"suggestedTranslation\": \"Một sợi dây neo cho tàu của chúng ta.\", \"rating\": 9.5},\n  {\"id\": 732545, \"suggestedTranslation\": \"Nó sẽ cho phép chúng ta tạo ra một sợi dây neo cho các con tàu của mình.\", \"rating\": 9.5},\n  {\"id\": 732546, \"suggestedTranslation\": \"Ta đoán rằng việc thiêu rụi lớp vỏ bọc cứng bên ngoài có thể sẽ hé lộ thứ gì đó ở bên trong.\", \"rating\": 9.0},\n  {\"id\": 732547, \"suggestedTranslation\": \"Nếu tiêu thụ nó, tầm nhìn trong bóng đêm của người dùng có vẻ sẽ được cải thiện.\", \"rating\": 9.5},\n  {\"id\": 732548, \"suggestedTranslation\": \"Dễ tiêu hóa hơn một chút, nhưng lại không có tác dụng cải thiện thị lực.\", \"rating\": 9.0},\n  {\"id\": 732549, \"suggestedTranslation\": \"Thật thú vị làm sao, có vẻ như nó tự sinh ra nhiệt từ bên trong.\", \"rating\": 9.0},\n  {\"id\": 732550, \"suggestedTranslation\": \"Thật đáng tiếc làm sao.\", \"rating\": 9.0},\n  {\"id\": 732551, \"suggestedTranslation\": \"Liệu cảm giác bất an mà ta cảm thấy có phải là một phần cơ chế phòng thủ của nó không?\", \"rating\": 9.0},\n  {\"id\": 732552, \"suggestedTranslation\": \"Đúng như ta nghĩ, cảm giác bất an đã qua đi.\", \"rating\": 9.0},\n  {\"id\": 732553, \"suggestedTranslation\": \"Nó có vẻ đang phát triển rất tốt.\", \"rating\": 9.0},\n  {\"id\": 732554, \"suggestedTranslation\": \"Có lẽ đây không phải là thời điểm thích hợp trong năm để nó phát triển mạnh.\", \"rating\": 9.0},\n  {\"id\": 732555, \"suggestedTranslation\": \"Đây có lẽ không phải là môi trường thích hợp cho nó.\", \"rating\": 9.0},\n  {\"id\": 732556, \"suggestedTranslation\": \"Ta sẽ cố gắng tìm một môi trường phù hợp cho nó.\", \"rating\": 9.0},\n  {\"id\": 732557, \"suggestedTranslation\": \"Thật khó để xác định loài ở giai đoạn phát triển này.\", \"rating\": 9.0},\n  {\"id\": 732558, \"suggestedTranslation\": \"Một tượng đài kính cẩn dành cho vị thần đã chết từ lâu.\", \"rating\": 9.0},\n  {\"id\": 732559, \"suggestedTranslation\": \"Một số bộ phận của cái này đã bị thiếu.\", \"rating\": 9.0},\n  {\"id\": 732560, \"suggestedTranslation\": \"Thật rõ ràng kẻ chủ谋 trong số những tàn tích này là ai.\", \"rating\": 9.0},\n  {\"id\": 732561, \"suggestedTranslation\": \"Cái này có vẻ gắn kết một cách huyền bí với thế giới.\", \"rating\": 9.5},\n  {\"id\": 732562, \"suggestedTranslation\": \"Một bảng hiệu thể hiện hoạt động của động vật. Dẫn hướng đi ra ngoài.\", \"rating\": 9.5},\n  {\"id\": 732563, \"suggestedTranslation\": \"Ồ, ta hiểu rồi! Một loài sinh vật biển hoàn toàn mới!\", \"rating\": 9.0},\n  {\"id\": 732564, \"suggestedTranslation\": \"À. Ngươi hẳn là thủ phạm đằng sau mọi hoạt động địa chấn này.\", \"rating\": 9.0},\n  {\"id\": 732565, \"suggestedTranslation\": \"Panthera auropunctata trông có vẻ đang cáu kỉnh.\", \"rating\": 9.0},\n  {\"id\": 732566, \"suggestedTranslation\": \"Nó đã được làm dịu đi bằng các vật phẩm cống nạp.\", \"rating\": 9.0},\n  {\"id\": 732567, \"suggestedTranslation\": \"Nó khá tiện lợi cho việc làm vườn.\", \"rating\": 9.0},\n  {\"id\": 732568, \"suggestedTranslation\": \"Nó có vẻ là một món đồ chơi của trẻ con.\", \"rating\": 9.0},\n  {\"id\": 732569, \"suggestedTranslation\": \"Một tác phẩm kỹ thuật cổ đại ấn tượng.\", \"rating\": 9.0},\n  {\"id\": 732570, \"suggestedTranslation\": \"Các bộ phận này có vẻ không còn hoạt động được nữa.\", \"rating\": 9.0},\n  {\"id\": 732571, \"suggestedTranslation\": \"Bây giờ thì nó thực sự bị bỏ hoang rồi.\", \"rating\": 9.0},\n  {\"id\": 732572, \"suggestedTranslation\": \"Nó còn một chút thời gian nữa mới sẵn sàng.\", \"rating\": 9.0},\n  {\"id\": 732573, \"suggestedTranslation\": \"Sắp xong rồi!\", \"rating\": 9.0},\n  {\"id\": 732574, \"suggestedTranslation\": \"Đến giờ ăn tối rồi!\", \"rating\": 9.0},\n  {\"id\": 732575, \"suggestedTranslation\": \"Ta nghi ngờ nó phải có một mục đích cụ thể dành riêng cho những căn phòng này.\", \"rating\": 9.0},\n  {\"id\": 732576, \"suggestedTranslation\": \"Nó có vẻ cần một nguồn năng lượng bên ngoài để kích hoạt.\", \"rating\": 9.0},\n  {\"id\": 732577, \"suggestedTranslation\": \"Bằng cách nào đó, người xưa đã nghĩ ra cách lưu trữ tri thức dưới dạng chất lỏng.\", \"rating\": 9.0},\n  {\"id\": 732578, \"suggestedTranslation\": \"Nó có vẻ thiếu một nguồn năng lượng.\", \"rating\": 9.0},\n  {\"id\": 732579, \"suggestedTranslation\": \"Những căn phòng này có vẻ xuất hiện trước phần còn lại của tàn tích.\", \"rating\": 9.0},\n  {\"id\": 732580, \"suggestedTranslation\": \"Chắc phải có một cuốn sổ tay hướng dẫn ở đâu đó.\", \"rating\": 9.0},\n  {\"id\": 732581, \"suggestedTranslation\": \"Thật đáng tiếc, nó có vẻ không còn hoạt động được nữa.\", \"rating\": 9.0},\n  {\"id\": 732582, \"suggestedTranslation\": \"Thiết kế này gợi nhớ đến những Cổng Không Gian mà chúng ta từng đi qua trước đây.\", \"rating\": 9.0},\n  {\"id\": 732583, \"suggestedTranslation\": \"Con đường khám phá đang chờ đón.\", \"rating\": 9.0},\n  {\"id\": 732584, \"suggestedTranslation\": \"Có vẻ như không còn cổ vật nào để tìm kiếm nữa.\", \"rating\": 9.0},\n  {\"id\": 732585, \"suggestedTranslation\": \"Thật hào hứng làm sao! Công nghệ này rất có thể đã không được sử dụng trong hàng trăm năm qua!\", \"rating\": 9.5},\n  {\"id\": 732586, \"suggestedTranslation\": \"Thật hấp dẫn! Những ký hiệu này có vẻ là nền tảng mà ngôn ngữ của họ phát triển từ đó.\", \"rating\": 9.0},\n  {\"id\": 732587, \"suggestedTranslation\": \"Sự ra đời của nhiên liệu bóng tối hẳn đã tác động rất lớn đến nền văn hóa của họ.\", \"rating\": 9.5},\n  {\"id\": 732588, \"suggestedTranslation\": \"Những ký hiệu này chắc phải có trước thời điểm họ phát hiện ra nhiên liệu bóng tối.\", \"rating\": 9.5},\n  {\"id\": 732589, \"suggestedTranslation\": \"Ký hiệu này cứ lặp đi lặp lại mãi... giá như ta có thể giải mã được ý nghĩa của nó.\", \"rating\": 9.0},\n  {\"id\": 732590, \"suggestedTranslation\": \"Cái này cần phải được nghiên cứu thêm.\", \"rating\": 9.0},\n  {\"id\": 732591, \"suggestedTranslation\": \"Nó có vẻ là một hệ thống bảo mật cực kỳ tiên tiến.\", \"rating\": 9.0},\n  {\"id\": 732592, \"suggestedTranslation\": \"Ta tự hỏi mục đích ban đầu của nó là gì.\", \"rating\": 9.0},\n  {\"id\": 732593, \"suggestedTranslation\": \"Đi theo nó có vẻ là một ý kiến không khôn ngoan.\", \"rating\": 9.0},\n  {\"id\": 732594, \"suggestedTranslation\": \"Nó có vẻ cần một viên ngọc cụ thể để kích hoạt.\", \"rating\": 9.0},\n  {\"id\": 732595, \"suggestedTranslation\": \"Các bệ đỡ có vẻ thu hút năng lượng từ những viên ngọc này.\", \"rating\": 9.0},\n  {\"id\": 732596, \"suggestedTranslation\": \"Giáp pháo hoa!\", \"rating\": 9.0},\n  {\"id\": 732597, \"suggestedTranslation\": \"Cực kỳ bền bỉ, và nhẹ đến ngạc nhiên.\", \"rating\": 9.0},\n  {\"id\": 732598, \"suggestedTranslation\": \"Hiệu quả đến ngạc nhiên khi xếp đủ các lớp.\", \"rating\": 9.0},\n  {\"id\": 732599, \"suggestedTranslation\": \"Một sự lựa chọn vật liệu khá thú vị.\", \"rating\": 9.0},\n  {\"id\": 732600, \"suggestedTranslation\": \"Một bộ giáp Thulecite cứng cáp.\", \"rating\": 9.0},\n  {\"id\": 732601, \"suggestedTranslation\": \"Bây giờ nó là một bộ giáp ngoại cốt cách rồi. Hô hô!\", \"rating\": 9.0},\n  {\"id\": 732602, \"suggestedTranslation\": \"Một món trang phục kỳ diệu và kinh tởm.\", \"rating\": 9.0},\n  {\"id\": 732603, \"suggestedTranslation\": \"Nó khá là rộng rãi đấy.\", \"rating\": 9.0},\n  {\"id\": 732604, \"suggestedTranslation\": \"Ta thực sự ước gì nó đừng quá ồn ào như thế.\", \"rating\": 9.0},\n  {\"id\": 732605, \"suggestedTranslation\": \"Giáp tấm thô sơ được chắp vá từ các khúc gỗ.\", \"rating\": 9.5},\n  {\"id\": 732606, \"suggestedTranslation\": \"Ta tin rằng người bạn của chúng ta đã tự đan nó đấy.\", \"rating\": 9.0},\n  {\"id\": 732607, \"suggestedTranslation\": \"Cái này sẽ rất được lòng đám người thỏ đây.\", \"rating\": 9.0},\n  {\"id\": 732608, \"suggestedTranslation\": \"Bộ giáp làm từ thực vật mang lại hiệu quả bất ngờ.\", \"rating\": 9.5},\n  {\"id\": 732609, \"suggestedTranslation\": \"Làm từ thực vật, tạo ra từ thực vật, và được mặc bởi thực vật.\", \"rating\": 9.5},\n  {\"id\": 732610, \"suggestedTranslation\": \"Một lớp màn bảo vệ chuyển hướng các đòn tấn công sang một chiều không gian khác.\", \"rating\": 9.0},\n  {\"id\": 732611, \"suggestedTranslation\": \"Giáp chống lại sát thương siêu hình.\", \"rating\": 9.0},\n  {\"id\": 732612, \"suggestedTranslation\": \"Bông hồng trang trí trên bộ giáp này chính là huy hiệu của người chế tác.\", \"rating\": 9.0},\n  {\"id\": 732613, \"suggestedTranslation\": \"Bây giờ thì nó chẳng giúp ích được mấy nữa.\", \"rating\": 9.0},\n  {\"id\": 732614, \"suggestedTranslation\": \"Một trợ giúp điều hướng. \\\"Lối đó kìa\\\".\", \"rating\": 9.0},\n  {\"id\": 732615, \"suggestedTranslation\": \"Cơ hội để chỉ đường.\", \"rating\": 9.0},\n  {\"id\": 732616, \"suggestedTranslation\": \"Bây giờ thì nó chẳng giúp ích được mấy nữa.\", \"rating\": 9.0},\n  {\"id\": 732617, \"suggestedTranslation\": \"Một trợ giúp điều hướng. \\\"Lối đó kìa\\\".\", \"rating\": 9.0},\n  {\"id\": 732618, \"suggestedTranslation\": \"Cơ hội để chỉ đường.\", \"rating\": 9.0},\n  {\"id\": 732619, \"suggestedTranslation\": \"Một ít cặn không chứa nước vẫn còn lại sau ngọn lửa.\", \"rating\": 9.5},\n  {\"id\": 732620, \"suggestedTranslation\": \"Xương mắt có vẻ đã bị cháy rụi hoàn toàn.\", \"rating\": 9.0},\n  {\"id\": 732621, \"suggestedTranslation\": \"Bông hoa có vẻ đã bị thiêu rụi hoàn toàn.\", \"rating\": 9.5},\n  {\"id\": 732622, \"suggestedTranslation\": \"Thứ này từng là một cái gì đó, nhưng giờ chỉ là một đống tro tàn.\", \"rating\": 9.0},\n  {\"id\": 732623, \"suggestedTranslation\": \"Một nguồn cung cấp chất xơ tuyệt vời cho chế độ ăn uống.\", \"rating\": 9.0},\n  {\"id\": 732624, \"suggestedTranslation\": \"Hơi bốc mùi, nhưng khá bổ dưỡng.\", \"rating\": 9.0},\n  {\"id\": 732625, \"suggestedTranslation\": \"Nó thải ra các hợp chất lưu huỳnh khi được tiêu hóa.\", \"rating\": 9.0},\n  {\"id\": 732626, \"suggestedTranslation\": \"Đúng là một nguồn cung cấp chất xơ tuyệt vời!\", \"rating\": 9.0},\n  {\"id\": 732627, \"suggestedTranslation\": \"Nó chưa thể bắt đầu lớn lên cho đến khi được đem đi trồng đâu, cưng ạ.\", \"rating\": 9.0},\n  {\"id\": 732628, \"suggestedTranslation\": \"Nó đang tích trữ năng lượng.\", \"rating\": 9.0},\n  {\"id\": 732629, \"suggestedTranslation\": \"Chúng ta phải kiên nhẫn.\", \"rating\": 9.0},\n  {\"id\": 732630, \"suggestedTranslation\": \"Tốt nhất là chúng ta không nên ở quanh đây khi nó phát nổ.\", \"rating\": 9.0},\n  {\"id\": 732631, \"suggestedTranslation\": \"Không biết cái đó dẫn đến đâu nhỉ?\", \"rating\": 9.0},\n  {\"id\": 732632, \"suggestedTranslation\": \"Chuyện đó đã được giải quyết rồi.\", \"rating\": 9.0},\n  {\"id\": 732633, \"suggestedTranslation\": \"Chìa khóa mở cánh cổng cũ đó.\", \"rating\": 9.5},\n  {\"id\": 732634, \"suggestedTranslation\": \"Ta nghi ngờ nó được cung cấp năng lượng bởi thứ nhiên liệu kinh khủng đó.\", \"rating\": 9.0},\n  {\"id\": 732635, \"suggestedTranslation\": \"Quả nhiên. Nó đã nhận được năng lượng từ chiếc chìa khóa.\", \"rating\": 9.5},\n  {\"id\": 732636, \"suggestedTranslation\": \"Sẽ mất rất nhiều thời gian để giải mã đấy.\", \"rating\": 9.0},\n  {\"id\": 732637, \"suggestedTranslation\": \"Một bức tranh tường cổ đại về một nền văn minh không phải động vật có vú.\", \"rating\": 9.5},\n  {\"id\": 732638, \"suggestedTranslation\": \"Bức tranh tường này đã bị bào mòn quá mức để có thể giải mã.\", \"rating\": 9.0},\n  {\"id\": 732639, \"suggestedTranslation\": \"Một cái bóng tối tăm, hoặc có lẽ là một thực thể nào đó, đã áp đảo nền văn minh này.\", \"rating\": 9.5},\n  {\"id\": 732640, \"suggestedTranslation\": \"Những người dân đang lột xác khỏi lớp vỏ ngoài của họ trong bức tranh này.\", \"rating\": 9.0},\n  {\"id\": 732641, \"suggestedTranslation\": \"Thành phố trông có vẻ thịnh vượng hơn hẳn theo cấp số nhân.\", \"rating\": 9.0},\n  {\"id\": 732642, \"suggestedTranslation\": \"Nó từ chối tuân theo các định luật của thế giới này.\", \"rating\": 9.0},\n  {\"id\": 732643, \"suggestedTranslation\": \"Một mặt phẳng nghiêng kép được gắn vào một cần gạt.\", \"rating\": 9.5},\n  {\"id\": 732644, \"suggestedTranslation\": \"Nhìn cái mặt cưng chưa kìa! (Hèm!)\", \"rating\": 9.0},\n  {\"id\": 732645, \"suggestedTranslation\": \"Lúc ngủ trông chú ta còn đáng yêu hơn nữa.\", \"rating\": 9.0},\n  {\"id\": 732646, \"suggestedTranslation\": \"Cái đó có thể mang theo rất nhiều sách đấy.\", \"rating\": 9.0},\n  {\"id\": 732647, \"suggestedTranslation\": \"Trứng màu xanh lam và thịt xông khói!\", \"rating\": 9.0},\n  {\"id\": 732648, \"suggestedTranslation\": \"Người ta phải biết khi nào thời gian cho các trò chơi đã kết thúc. Bây giờ chưa phải lúc đó.\", \"rating\": 9.0},\n  {\"id\": 732649, \"suggestedTranslation\": \"Có thể dùng như một vật đánh lạc hướng thích hợp.\", \"rating\": 9.0},\n  {\"id\": 732650, \"suggestedTranslation\": \"Ta tin rằng nó ngầm gợi lên hình ảnh của một loài Thỏ.\", \"rating\": 9.0},\n  {\"id\": 732651, \"suggestedTranslation\": \"Thỉnh thoảng có một chút niềm vui vừa phải sẽ rất tốt cho chúng ta đấy.\", \"rating\": 9.0},\n  {\"id\": 732652, \"suggestedTranslation\": \"Chắc không còn đủ không khí bên trong để phân tích thành phần của nó nữa...\", \"rating\": 9.0},\n  {\"id\": 732653, \"suggestedTranslation\": \"Thành phần hóa học trong hơi thở của cậu thanh niên này hẳn rất hấp dẫn.\", \"rating\": 9.0},\n  {\"id\": 732654, \"suggestedTranslation\": \"Những thứ này có vẻ phù phiếm.\", \"rating\": 9.0},\n  {\"id\": 732655, \"suggestedTranslation\": \"Ta hoan hô sự cố gắng thực tế của em đấy, cưng ạ.\", \"rating\": 9.0},\n  {\"id\": 732656, \"suggestedTranslation\": \"Quả của nó rất giống với chủng dưới lòng đất.\", \"rating\": 9.0},\n  {\"id\": 732657, \"suggestedTranslation\": \"À, ta đang cần một chút đồ giải khát đây.\", \"rating\": 9.0},\n  {\"id\": 732658, \"suggestedTranslation\": \"Chà, chẳng phải rất sảng khoái sao?\", \"rating\": 9.0},\n  {\"id\": 732659, \"suggestedTranslation\": \"Băng gạc y tế.\", \"rating\": 9.0},\n  {\"id\": 732660, \"suggestedTranslation\": \"Một miếng băng gạc tinh tế làm từ cánh bướm.\", \"rating\": 9.5},\n  {\"id\": 732661, \"suggestedTranslation\": \"Người thời cổ đại từng tin rằng loài ngỗng lớn lên từ hà biển. Bạn có thể tưởng tượng được không?\", \"rating\": 9.5},\n  {\"id\": 732662, \"suggestedTranslation\": \"Một sự kết hợp khá thú vị.\", \"rating\": 9.0},\n  {\"id\": 732663, \"suggestedTranslation\": \"Ta không nghĩ là mình có thể nuốt trôi món đó đâu.\", \"rating\": 9.0},\n  {\"id\": 732664, \