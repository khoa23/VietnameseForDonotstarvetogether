            "text": "[\n  {\n    \"id\": 734026,\n    \"suggestedTranslation\": \"Đúng như ta nghi ngờ. Có nồng độ cặn dư nguyệt thực cao.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734027,\n    \"suggestedTranslation\": \"Mấy con bướm đêm và cái cây đã đột biến cùng nhau ở đây.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734028,\n    \"suggestedTranslation\": \"Trông có vẻ nó mất tác dụng trong điều kiện dưới lòng đất.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734029,\n    \"suggestedTranslation\": \"Có điều gì rất kỳ lạ đang diễn ra ở đây.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734030,\n    \"suggestedTranslation\": \"Thật tò mò, nước phản ứng tương tự như những gì ta đã quan sát thấy trong hang động.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734031,\n    \"suggestedTranslation\": \"Chu kỳ mặt trăng này đã đi đến hồi kết.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734032,\n    \"suggestedTranslation\": \"Chu kỳ của mặt trăng lại bắt đầu.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734033,\n    \"suggestedTranslation\": \"Mặt trăng đang khuyết dần.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734034,\n    \"suggestedTranslation\": \"Mặt trăng đang tròn dần.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734035,\n    \"suggestedTranslation\": \"Có lẽ ta nên giữ lại một mẫu để nghiên cứu thành phần cấu tạo.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734036,\n    \"suggestedTranslation\": \"Luôn hướng tới hiệu quả cao hơn.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734037,\n    \"suggestedTranslation\": \"Năng lượng có vẻ không ổn định, ta phải nhanh tay nếu muốn dùng nó vào việc gì đó.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734038,\n    \"suggestedTranslation\": \"Nó có vẻ là khoáng chất, nhưng thực ra có thể là chất hữu cơ.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734039,\n    \"suggestedTranslation\": \"Trông nó giống một cái tổ nào đó.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734040,\n    \"suggestedTranslation\": \"Sẽ tạo thành một dụng cụ đo đạc bản đồ hữu ích nếu được trang trí phù hợp.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734041,\n    \"suggestedTranslation\": \"Thật tò mò. Trông nó khá giống một chiếc chìa khóa.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734042,\n    \"suggestedTranslation\": \"Hàm ý về một thể thiên văn? Thật thú vị.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734043,\n    \"suggestedTranslation\": \"Một quả cầu tri thức lơ lửng.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734044,\n    \"suggestedTranslation\": \"Thật là một sự biến đổi khó hiểu.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734045,\n    \"suggestedTranslation\": \"Những sinh vật tội nghiệp và gớm ghiếc đó đang làm tổ ở đây.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734046,\n    \"suggestedTranslation\": \"Lớp kính dường như đã ổn định.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734047,\n    \"suggestedTranslation\": \"Nó đang tỏa ra một nguồn năng lượng phát sáng mờ ảo.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734048,\n    \"suggestedTranslation\": \"Một thiết kế khá kỳ lạ, nhưng lại hiệu quả đến bất ngờ.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734049,\n    \"suggestedTranslation\": \"Ta tưởng đó là một dạng điện năng, nhưng có vẻ nó hoàn toàn là thứ gì khác...\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734050,\n    \"suggestedTranslation\": \"Nguồn năng lượng đó trông có vẻ rất dễ biến động.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734051,\n    \"suggestedTranslation\": \"Nó không mang điện tích.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734052,\n    \"suggestedTranslation\": \"Thiết bị này có vẻ giữ cho năng lượng được chứa đựng bên trong, bằng cách nào đó.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734053,\n    \"suggestedTranslation\": \"Nguồn năng lượng đó đã đi lạc hướng.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734054,\n    \"suggestedTranslation\": \"Giọng nói cho biết nó có kiến thức muốn chia sẻ.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734055,\n    \"suggestedTranslation\": \"Nó nói sẽ chia sẻ một bí mật với ta nếu ta hoàn thành nó.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734056,\n    \"suggestedTranslation\": \"Ngươi đã sẵn sàng chia sẻ tri thức của mình với ta chưa?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734057,\n    \"suggestedTranslation\": \"Nó nói vẫn còn rất nhiều kiến thức chưa được khám phá.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734058,\n    \"suggestedTranslation\": \"Nào, hãy đưa ngươi trở lại nơi ngươi thuộc về.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734059,\n    \"suggestedTranslation\": \"Ta tin là nó đang cố gắng giao tiếp với ta bằng thần giao cách cảm.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734060,\n    \"suggestedTranslation\": \"Nó đang truyền tải một cảm giác cấp bách vào tâm trí ta.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734061,\n    \"suggestedTranslation\": \"Năng lượng của nó đang khuấy động các góc khuất trong tâm trí ta.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734062,\n    \"suggestedTranslation\": \"E rằng mục đích của nó vẫn còn vượt quá sự hiểu biết của ta lúc này.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734063,\n    \"suggestedTranslation\": \"Ta nghĩ tốt nhất là nên đập lấy nó ra.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734064,\n    \"suggestedTranslation\": \"Ta nghĩ tốt nhất là nên đập lấy nó ra.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734065,\n    \"suggestedTranslation\": \"Ta nghĩ tốt nhất là nên đập lấy nó ra.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734066,\n    \"suggestedTranslation\": \"Nó đang phóng hình ảnh của một bệ thờ vào tâm trí ta.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734067,\n    \"suggestedTranslation\": \"Nó đang truyền đạt nhu cầu cần được tái tạo lại.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734068,\n    \"suggestedTranslation\": \"Nó có vẻ sở hữu đặc tính gây buồn ngủ mạnh mẽ.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734069,\n    \"suggestedTranslation\": \"Thật kỳ lạ. Khi nấu chín, chúng dường như đóng vai trò như một chất kích thích.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734070,\n    \"suggestedTranslation\": \"E rằng ta vẫn chưa thể xác định được chức năng của nó.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734071,\n    \"suggestedTranslation\": \"Các mảnh ghép đang dần vào đúng vị trí.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734072,\n    \"suggestedTranslation\": \"Đúng như ta nghi ngờ, nó được tạo ra để hoạt động như một dạng pin.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734073,\n    \"suggestedTranslation\": \"Đây không phải là loại phép thuật giống như thứ ta từng thấy từ nhiên liệu của Maxwell.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734074,\n    \"suggestedTranslation\": \"Các chu kỳ mặt trăng ở đây bắt đầu trở nên dễ hiểu hơn nhiều rồi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734075,\n    \"suggestedTranslation\": \"Chúa ơi, việc đó chắc hẳn phải đòi hỏi rất nhiều sự kiên trì!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734076,\n    \"suggestedTranslation\": \"Chậc. Thật là lãng phí tài nguyên.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734077,\n    \"suggestedTranslation\": \"Đã hóa than, cháy trụi hoàn toàn.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734078,\n    \"suggestedTranslation\": \"Chẳng còn mấy thứ dùng được.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734079,\n    \"suggestedTranslation\": \"Nó dường như đã bị biến đổi bởi năng lượng mặt trăng xung quanh.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734080,\n    \"suggestedTranslation\": \"Thật là một mẫu vật kỳ lạ.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734081,\n    \"suggestedTranslation\": \"Quá trình làm khô giúp làm nổi bật hương thơm.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734082,\n    \"suggestedTranslation\": \"Ta đặt tên cho nó là Alces canadensis.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734083,\n    \"suggestedTranslation\": \"Thật là một kỳ quan!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734084,\n    \"suggestedTranslation\": \"Có dịp nào đó ta rất muốn nghiên cứu tập tính giao phối của nó.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734085,\n    \"suggestedTranslation\": \"Cậu ấy thật là có tài.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734086,\n    \"suggestedTranslation\": \"Một con Haemagogus Devorator cái đang khát máu.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734087,\n    \"suggestedTranslation\": \"Nó đã được cất giữ an toàn.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734088,\n    \"suggestedTranslation\": \"Hoàn toàn kinh tởm. Làm da gà da vịt ta nổi hết cả lên.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734089,\n    \"suggestedTranslation\": \"Có mối tương quan trực tiếp giữa hiệu quả của phân bón và mùi của nó.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734090,\n    \"suggestedTranslation\": \"Việc truyền máu tươi dường như giúp tăng cường lượng máu tổng thể của người cá.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734091,\n    \"suggestedTranslation\": \"Chất pheromone khiến người ta trở nên tàng hình trước những kẻ hút máu bị nguyền rủa.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734092,\n    \"suggestedTranslation\": \"Cái dạ dày của một con muỗi, tràn ngập máu.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734093,\n    \"suggestedTranslation\": \"Ta đoán là nó cũng sêm sêm như những gì ta mong đợi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734094,\n    \"suggestedTranslation\": \"Một gò mả đã bị mạo phạm.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734095,\n    \"suggestedTranslation\": \"Một gò mả.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734096,\n    \"suggestedTranslation\": \"Hương vị của niềm vui mùa Giáng sinh.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734097,\n    \"suggestedTranslation\": \"Hừm... Cái này có lẽ cần phải đọc thêm sách.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734098,\n    \"suggestedTranslation\": \"Thiết kế của nó hoàn toàn mang phong cách ngoài hành tinh.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734099,\n    \"suggestedTranslation\": \"Khá thực dụng, nó vừa hoạt động như một chiếc rìu vừa như một chiếc cuốc chim.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734100,\n    \"suggestedTranslation\": \"Ta nên xếp các ngươi vào giới Động vật hay giới Nấm đây?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734101,\n    \"suggestedTranslation\": \"Mọi người, hãy tránh xa con Agaricus dễ bay hơi đó ra!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734102,\n    \"suggestedTranslation\": \"Ồ. Trông có vẻ nhăn nheo thật thú vị.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734103,\n    \"suggestedTranslation\": \"Một cây Agaricus cháy cao chót vót.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734104,\n    \"suggestedTranslation\": \"Chúng ta phải tiêu diệt cái cây Agaricus cao chót vót đó.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734105,\n    \"suggestedTranslation\": \"Đã hóa than bởi phản ứng hóa học tỏa nhiệt.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734106,\n    \"suggestedTranslation\": \"Trước tiên phải gieo cấy một mẫu vật cắt nhỏ hoặc bào tử nấm vào đó.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734107,\n    \"suggestedTranslation\": \"Một sản lượng nấm tuyệt vời.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734108,\n    \"suggestedTranslation\": \"Tình trạng phân hủy đã quá nâng cao để có thể nuôi dưỡng bất kỳ mẫu vật nào.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734109,\n    \"suggestedTranslation\": \"Sự phát triển của nó đã bị chặn lại bởi cái lạnh khắc nghiệt.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734110,\n    \"suggestedTranslation\": \"Lũ nấm đang đơm quả khá đẹp mắt.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 734111,\n    \"suggestedTranslation\": \"Chúng ta nên hái chúng trước kh