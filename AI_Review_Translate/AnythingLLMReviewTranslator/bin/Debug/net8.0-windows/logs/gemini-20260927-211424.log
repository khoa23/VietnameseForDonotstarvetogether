            "text": "[\n  {\"id\":733413,\"suggestedTranslation\":\"Một miếng thịt câu cá có mùi nồng.\",\"rating\":8.5},\n  {\"id\":733416,\"suggestedTranslation\":\"Thịt câu cá.\",\"rating\":8.5},\n  {\"id\":733418,\"suggestedTranslation\":\"Mặn mà, nhưng cũng đủ thỏa mãn.\",\"rating\":8.5},\n  {\"id\":733421,\"suggestedTranslation\":\"Một cơ chế thông minh để giữ hải sản tươi ngon.\",\"rating\":8.5},\n  {\"id\":733430,\"suggestedTranslation\":\"Thật là mang tính ăn mừng làm sao.\",\"rating\":8.5},\n  {\"id\":733431,\"suggestedTranslation\":\"Dồi dào chất dinh dưỡng!\",\"rating\":8.5},\n  {\"id\":733432,\"suggestedTranslation\":\"Bạn có thể đọc sách dưới ánh sáng đó.\",\"rating\":8.5},\n  {\"id\":733433,\"suggestedTranslation\":\"Nó sẽ không thể sống sót trong những điều kiện này.\",\"rating\":8.5},\n  {\"id\":733434,\"suggestedTranslation\":\"Hiếm khi nào người ta thấy một bông hoa có hào quang mạnh mẽ đến vậy.\",\"rating\":8.5},\n  {\"id\":733435,\"suggestedTranslation\":\"Bông hoa này thiếu các yếu tố thiết yếu để phát triển.\",\"rating\":8.5},\n  {\"id\":733436,\"suggestedTranslation\":\"Chúng có thể có một chút giá trị dinh dưỡng.\",\"rating\":8.5},\n  {\"id\":733437,\"suggestedTranslation\":\"Quá trình phơi khô làm tăng thêm hương thơm.\",\"rating\":8.5},\n  {\"id\":733438,\"suggestedTranslation\":\"Đồ bảo hộ cho các hoạt động va chạm mạnh.\",\"rating\":8.5},\n  {\"id\":733439,\"suggestedTranslation\":\"Loại này có thể dùng để pha một mẻ trà thảo mộc khá dễ chịu.\",\"rating\":8.5},\n  {\"id\":733440,\"suggestedTranslation\":\"Quá trình phơi khô làm tăng thêm hương thơm.\",\"rating\":8.5},\n  {\"id\":733441,\"suggestedTranslation\":\"Dường như khá vô lý khi cố gắng làm cho một con bò lai trông có vẻ uy nghi.\",\"rating\":8.5},\n  {\"id\":733442,\"suggestedTranslation\":\"Di tích hóa cứng được bảo tồn bởi các quá trình trầm tích.\",\"rating\":8.5},\n  {\"id\":733443,\"suggestedTranslation\":\"Ồ! Một mẫu vật xứng đáng có mặt trong viện bảo tàng!\",\"rating\":8.5},\n  {\"id\":733444,\"suggestedTranslation\":\"Sự thiếu hiểu biết về cổ sinh vật học đã tạo ra một cái cớ thảm hại cho một sinh vật.\",\"rating\":8.5},\n  {\"id\":733445,\"suggestedTranslation\":\"Vẫn còn những mảnh của bộ xương chưa được lắp ráp.\",\"rating\":8.5},\n  {\"id\":733446,\"suggestedTranslation\":\"Những ngón tay dính dớp sẽ theo sau đó.\",\"rating\":8.5},\n  {\"id\":733447,\"suggestedTranslation\":\"Con này có vẻ thuộc một phân loài khác, dễ chịu hơn.\",\"rating\":8.5},\n  {\"id\":733448,\"suggestedTranslation\":\"Được coi là một món ăn ngon ở một số quốc gia.\",\"rating\":8.5},\n  {\"id\":733449,\"suggestedTranslation\":\"Một động vật bốn chân lưỡng cư.\",\"rating\":8.5},\n  {\"id\":733450,\"suggestedTranslation\":\"Nó đang ngủ.\",\"rating\":8.5},\n  {\"id\":733451,\"suggestedTranslation\":\"Tôi rất sẵn lòng xung phong nếm thử.\",\"rating\":8.5},\n  {\"id\":733452,\"suggestedTranslation\":\"Đó là một lựa chọn thú vị khi phục vụ nó dưới dạng bánh mì kẹp.\",\"rating\":8.5},\n  {\"id\":733453,\"suggestedTranslation\":\"Chúng vẫn còn giật giật một chút.\",\"rating\":8.5},\n  {\"id\":733454,\"suggestedTranslation\":\"Không khác gì cánh gà.\",\"rating\":8.5},\n  {\"id\":733455,\"suggestedTranslation\":\"Nó có hương vị khá độc đáo.\",\"rating\":8.5},\n  {\"id\":733456,\"suggestedTranslation\":\"Món này sẽ rất hợp khi đọc một cuốn sách ngắn.\",\"rating\":8.5},\n  {\"id\":733457,\"suggestedTranslation\":\"Thực vật và động vật đã hợp nhất thành một trong mẫu vật này.\",\"rating\":8.5},\n  {\"id\":733458,\"suggestedTranslation\":\"Nó có mùi khá ngon.\",\"rating\":8.5},\n  {\"id\":733459,\"suggestedTranslation\":\"Nó đang chìm trong giấc ngủ sâu.\",\"rating\":8.5},\n  {\"id\":733460,\"suggestedTranslation\":\"Những kẻ phiền phức đó đang gây ra không ít rắc rối cho chính chúng.\",\"rating\":8.5},\n  {\"id\":733461,\"suggestedTranslation\":\"Có vẻ như tôi có thể kiểm soát phần nào những con côn trùng này bằng thứ này.\",\"rating\":8.5},\n  {\"id\":733462,\"suggest