          {
            "text": "[\n  {\"id\":734926,\"suggestedTranslation\":\"Món này luôn rất được ưa chuộng trong các buổi tụ tập ngày lễ.\",\"rating\":1.0},\n  {\"id\":734927,\"suggestedTranslation\":\"Cứ như thể mọi lo âu và phiền muộn của tôi đang tan biến vậy.\",\"rating\":1.0},\n  {\"id\":734928,\"suggestedTranslation\":\"Năng lượng đã được ổn định đủ để tạo thành một lưỡi kiếm hoạt động được.\",\"rating\":1.0},\n  {\"id\":734929,\"suggestedTranslation\":\"Trời ạ, thế này thì không ổn chút nào.\",\"rating\":1.0},\n  {\"id\":734930,\"suggestedTranslation\":\"Đủ rộng cho khách khứa.\",\"rating\":1.0},\n  {\"id\":734931,\"suggestedTranslation\":\"Một lượng thức ăn đáng kể!\",\"rating\":1.0},\n  {\"id\":734932,\"suggestedTranslation\":\"Chắc chắn là nhầm loại rồi.\",\"rating\":1.0},\n  {\"id\":734933,\"suggestedTranslation\":\"Đồ đạc ngăn nắp là chìa khóa cho một tâm trí ngăn nắp.\",\"rating\":1.0},\n  {\"id\":734934,\"suggestedTranslation\":\"Thú vị thật! Chúng sẽ cải thiện đáng kể khả năng câu cá của tôi đấy!\",\"rating\":1.0},\n  {\"id\":734935,\"suggestedTranslation\":\"Tôi có thể tăng cơ hội thành công của mình với các dụng cụ câu cá tốt hơn.\",\"rating\":1.0},\n  {\"id\":734936,\"suggestedTranslation\":\"Món đó tệ lắm cho răng của bạn đấy, cưng ơi.\",\"rating\":1.0},\n  {\"id\":734937,\"suggestedTranslation\":\"Magnus Avis, đã phát triển hoàn thiện.\",\"rating\":1.0},\n  {\"id\":734938,\"suggestedTranslation\":\"Nó cần được ấp.\",\"rating\":1.0},\n  {\"id\":734939,\"suggestedTranslation\":\"Tràn ngập cholesterol.\",\"rating\":1.0},\n  {\"id\":734940,\"suggestedTranslation\":\"Cẩn thận không có ngày chết cóng đấy!\",\"rating\":1.0},\n  {\"id\":734941,\"suggestedTranslation\":\"Quá trình phát triển có vẻ đang tiến triển.\",\"rating\":1.0},\n  {\"id\":734942,\"suggestedTranslation\":\"Việc tiếp xúc với nhiệt độ quá cực đoan có thể dẫn đến tử vong.\",\"rating\":1.0},\n  {\"id\":734943,\"suggestedTranslation\":\"Nước sôi thì chả bao giờ thấy.\",\"rating\":1.0},\n  {\"id\":734944,\"suggestedTranslation\":\"Chẳng mấy chốc chúng ta sẽ gặt hái được thành quả lao động của mình.\",\"rating\":1.0},\n  {\"id\":734945,\"suggestedTranslation\":\"Quả trứng Magnus Avis thật to lớn làm sao!\",\"rating\":1.0},\n  {\"id\":734946,\"suggestedTranslation\":\"Cái tổ trống không. Chẳng mấy chốc chu kỳ sẽ lại bắt đầu.\",\"rating\":1.0},\n  {\"id\":734947,\"suggestedTranslation\":\"Giống như hầu hết các món ăn an ủi tâm hồn, nó có lẽ sẽ tàn phá các mạch máu.\",\"rating\":1.0},\n  {\"id\":734948,\"suggestedTranslation\":\"Vị cay thực ra khá nhẹ, rất hợp ý tôi.\",\"rating\":1.0},\n  {\"id\":734949,\"suggestedTranslation\":\"Một chú chim tuổi vị thành niên.\",\"rating\":1.0},\n  {\"id\":734950,\"suggestedTranslation\":\"Làm ơn giữ âm lượng giọng nói của bạn ở mức tối thiểu.\",\"rating\":1.0},\n  {\"id\":734951,\"suggestedTranslation\":\"Nó có vẻ đã quá phấn khích.\",\"rating\":1.0},\n  {\"id\":734952,\"suggestedTranslation\":\"Một chú chim hư hỏng!\",\"rating\":1.0},\n  {\"id\":734953,\"suggestedTranslation\":\"Tôi không nghĩ nó đã được cấp nguồn.\",\"rating\":1.0},\n  {\"id\":734954,\"suggestedTranslation\":\"Trông nó có vẻ đã sẵn sàng.\",\"rating\":1.0},\n  {\"id\":734955,\"suggestedTranslation\":\"Cỗ máy này có thể dùng để du hành giữa các thế giới.\",\"rating\":1.0},\n  {\"id\":734956,\"suggestedTranslation\":\"Hòn đá rune này có các đặc tính hình học độc đáo!\",\"rating\":1.0},\n  {\"id\":734957,\"suggestedTranslation\":\"Thiết bị cần được kích hoạt.\",\"rating\":1.0},\n  {\"id\":734958,\"suggestedTranslation\":\"Thiết bị vẫn chưa được hoàn thiện hoàn toàn.\",\"rating\":1.0},\n  {\"id\":734959,\"suggestedTranslation\":\"Một bộ điều chỉnh dòng điện.\",\"rating\":1.0},\n  {\"id\":734960,\"suggestedTranslation\":\"Nó ứng dụng các nguyên lý cơ học cơ bản.\",\"rating\":1.0},\n  {\"id\":734961,\"suggestedTranslation\":\"Không hẳn hữu cơ cũng chẳng hoàn toàn vô cơ!\",\"rating\":1.0},\n  {\"id\":734962,\"suggestedTranslation\":\"Một hình xuyến gồm hợp kim và dây điện.\",\"rating\":1.0},\n  {\"id\":734963,\"suggestedTranslation\":\"Viên ngọc có vẻ đang tập trung nhiên liệu Ác Mộng.\",\"rating\":1.0},\n  {\"id\":734964,\"suggestedTranslation\":\"Dù sao thì nó cũng chẳng giúp ích gì cho tôi mấy.\",\"rating\":1.0},\n  {\"id\":734965,\"suggestedTranslation\":\"Ngủ trong đó sẽ làm tôi bị cứng cổ mất.\",\"rating\":1.0},\n  {\"id\":734966,\"suggestedTranslation\":\"Một nỗi kinh hoàng đang chờ đợi trong bùn.\",\"rating\":1.0},\n  {\"id\":734967,\"suggestedTranslation\":\"Đừng bao giờ túm lấy cái đầu nhọn.\",\"rating\":1.0},\n  {\"id\":734968,\"suggestedTranslation\":\"Hừm, cơ quan sinh sản.\",\"rating\":1.0},\n  {\"id\":734969,\"suggestedTranslation\":\"Tôi tự hỏi chúng sinh sản thế nào nhỉ?\",\"rating\":1.0},\n  {\"id\":734970,\"suggestedTranslation\":\"Phần bên dưới nhiều hơn hẳn phần bên trên!\",\"rating\":1.0},\n  {\"id\":734971,\"suggestedTranslation\":\"Một nỗi kinh hoàng bé nhỏ đang chờ đợi trong bùn.\",\"rating\":1.0},\n  {\"id\":734972,\"suggestedTranslation\":\"Có vẻ như tất cả chúng đều được kết nối với nhau theo cách nào đó.\",\"rating\":1.0},\n  {\"id\":734973,\"suggestedTranslation\":\"Nó có vẻ đã cạn kiệt năng lượng, nhưng tôi không biết trong bao lâu.\",\"rating\":1.0},\n  {\"id\":734974,\"suggestedTranslation\":\"Nhiên liệu Ác Mộng có vẻ đã tác động tiêu cực đến nó.\",\"rating\":1.0},\n  {\"id\":734975,\"suggestedTranslation\":\"Ý nghĩa của việc này là sao cơ chứ?!\",\"rating\":1.0},\n  {\"id\":734976,\"suggestedTranslation\":\"Thứ này chắc chắn không thuộc về thế giới này. Thật tò mò.\",\"rating\":1.0},\n  {\"id\":734977,\"suggestedTranslation\":\"Nó nên tiếp tục ở trạng thái không hoạt động, miễn là không bị quấy rầy.\",\"rating\":1.0},\n  {\"id\":734978,\"suggestedTranslation\":\"Tôi tin rằng nó đang tích trữ năng lượng, nhưng với mục đích gì cơ chứ?\",\"rating\":1.0},\n  {\"id\":734979,\"suggestedTranslation\":\"Ôi trời...\",\"rating\":1.0},\n  {\"id\":734980,\"suggestedTranslation\":\"Tôi tự hỏi làm sao nó l