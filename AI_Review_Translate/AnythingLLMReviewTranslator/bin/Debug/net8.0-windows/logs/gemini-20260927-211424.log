 {\"id\": 734644, \"suggestedTranslation\": \"Hơi lòe loẹt so với sở thích của tôi, nhưng có vẻ hữu ích.\", \"rating\": 9.0},\n  {\"id\": 734645, \"suggestedTranslation\": \"Một dụng cụ để giáng những đòn tàn khốc.\", \"rating\": 9.0},\n  {\"id\": 734646, \"suggestedTranslation\": \"Chỉ cần chịu khó một chút là có thể sửa cho nó hoạt động lại được.\", \"rating\": 9.0},\n  {\"id\": 734647, \"suggestedTranslation\": \"Một chiều không gian nhỏ bị ràng buộc chặt chẽ bởi phép thuật.\", \"rating\": 9.0},\n  {\"id\": 734648, \"suggestedTranslation\": \"Phép thuật đang hoạt động kìa.\", \"rating\": 9.0},\n  {\"id\": 734649, \"suggestedTranslation\": \"Một thiết bị để tháo dỡ cưỡng bức.\", \"rating\": 9.0},\n  {\"id\": 734650, \"suggestedTranslation\": \"Một thiết bị thô sơ dùng để cưỡi ngựa.\", \"rating\": 9.0},\n  {\"id\": 734651, \"suggestedTranslation\": \"Cái ăng-ten trang trí là một điểm nhấn đáng yêu.\", \"rating\": 9.0},\n  {\"id\": 734652, \"suggestedTranslation\": \"Một chiếc yên cưỡi bò lai được trang bị cho chiến đấu.\", \"rating\": 9.0},\n  {\"id\": 734653, \"suggestedTranslation\": \"Một chỗ ngồi ưa thích của các vị tướng và lãnh chúa đủ loại.\", \"rating\": 9.0},\n  {\"id\": 734654, \"suggestedTranslation\": \"Hiển nhiên là một con thú dùng trong chiến trận thì phải được mặc giáp kỹ lưỡng.\", \"rating\": 9.0},\n  {\"id\": 734655, \"suggestedTranslation\": \"Ôi trời, món đó có chút vị hăng đấy!\", \"rating\": 9.0},\n  {\"id\": 734656, \"suggestedTranslation\": \"Thứ này sẽ giúp ngăn thức ăn bị hỏng.\", \"rating\": 9.0},\n  {\"id\": 734657, \"suggestedTranslation\": \"Một khối natri clorua để dụ dỗ thú hoang.\", \"rating\": 9.0},\n  {\"id\": 734658, \"suggestedTranslation\": \"Bò lai liếm muối để hấp thụ các chất dinh dưỡng thiết yếu.\", \"rating\": 9.0},\n  {\"id\": 734659, \"suggestedTranslation\": \"Nó đang phát triển theo hình dạng hình học kỳ lạ.\", \"rating\": 9.0},\n  {\"id\": 734660, \"suggestedTranslation\": \"Thật tò mò... chính xác thì những hình thù đó được cấu tạo thế nào nhỉ?\", \"rating\": 9.0},\n  {\"id\": 734661, \"suggestedTranslation\": \"Ồ chà... chúng có vẻ hình thành theo cách đó một cách tự nhiên.\", \"rating\": 9.0},\n  {\"id\": 734662, \"suggestedTranslation\": \"Muối đã được thu hoạch xong rồi.\", \"rating\": 9.0},\n  {\"id\": 734663, \"suggestedTranslation\": \"Tôi thích mèo hơn.\", \"rating\": 9.0},\n  {\"id\": 734664, \"suggestedTranslation\": \"Nó mang lại cho người đội một vẻ ngoài khá uy quyền.\", \"rating\": 9.0},\n  {\"id\": 734665, \"suggestedTranslation\": \"Quả là một tài năng phi thường!\", \"rating\": 9.0},\n  {\"id\": 734666, \"suggestedTranslation\": \"Panthera auropunctata hôm nay lại hư đốn rồi.\", \"rating\": 9.0},\n  {\"id\": 734667, \"suggestedTranslation\": \"Thật hấp dẫn. Tôi sẽ phải nghiên cứu các ký hiệu này sau.\", \"rating\": 9.0},\n  {\"id\": 734668, \"suggestedTranslation\": \"Nó có vẻ đã chìm xuống đất.\", \"rating\": 9.0},\n  {\"id\": 734669, \"suggestedTranslation\": \"Sự cháy!\", \"rating\": 9.0},\n  {\"id\": 734670, \"suggestedTranslation\": \"Nó mắc một thứ bệnh nông nghiệp vượt quá khả năng chữa trị của tôi.\", \"rating\": 9.0},\n  {\"id\": 734671, \"suggestedTranslation\": \"Hừm... Trông có vẻ giòn hơn bình thường.\", \"rating\": 9.0},\n  {\"id\": 734672, \"suggestedTranslation\": \"Đó là một cái cây nhỏ.\", \"rating\": 9.0},\n  {\"id\": 734673, \"suggestedTranslation\": \"Lạ thật. Tôi cứ tưởng thế là nó chết rồi chứ.\", \"rating\": 9.0},\n  {\"id\": 734674, \"suggestedTranslation\": \"Trời nóng quá nên nó héo rồi.\", \"rating\": 9.0},\n  {\"id\": 734675, \"suggestedTranslation\": \"Một phân tích vô cùng kỹ lưỡng. Làm tốt lắm!\", \"rating\": 9.0},\n  {\"id\": 734676, \"suggestedTranslation\": \"Hừm. Tôi đoán là nó rất dễ bén lửa.\", \"rating\": 9.0},\n  {\"id\": 734677, \"suggestedTranslation\": \"Tiếc thật. Cậu ta đúng là một anh chàng vui tính.\", \"rating\": 9.0},\n  {\"id\": 734678, \"suggestedTranslation\": \"À, tuyệt vời. Khỏi phải vắt quần áo lên cành cây cho nhàu nhĩ nữa.\", \"rating\": 9.0},\n  {\"id\": 734679, \"suggestedTranslation\": \"Trông bạn không đáng tin cậy lắm đâu, cưng ạ.\", \"rating\": 9.0},\n  {\"id\": 734680, \"suggestedTranslation\": \"Thật là một cảnh tượng gớm ghiếc! Một trang sách bị xé rách!\", \"rating\": 9.0},\n  {\"id\": 734681, \"suggestedTranslation\": \"Có lẽ chúng ta nên đem giặt sạch nó trước nhỉ?\", \"rating\": 9.0},\n  {\"id\": 734682, \"suggestedTranslation\": \"Nó dường như làm tăng theo cấp số nhân tầm nhìn của người đeo.\", \"rating\": 9.0},\n  {\"id\": 734683, \"suggestedTranslation\": \"Ồ, tôi chưa bao giờ coi mình là một nghệ sĩ lớn cả!\", \"rating\": 9.0},\n  {\"id\": 734684, \"suggestedTranslation\": \"Thật đáng tiếc. Nó là một món đồ trang trí đáng yêu.\", \"rating\": 9.0},\n  {\"id\": 734685, \"suggestedTranslation\": \"Một phương pháp sản xuất gốm sứ. Không hiểu sao chúng ta lại dùng nó để làm tượng.\", \"rating\": 9.0},\n  {\"id\": 734686, \"suggestedTranslation\": \"Tôi tin rằng tất cả chúng ta đều đang rất cần một nơi để giải tỏa cảm xúc.\", \"rating\": 9.0},\n  {\"id\": 734687, \"suggestedTranslation\": \"Có một sự hung dữ gần như hoang dã trong những đường đục đẽo.\", \"rating\": 9.0},\n  {\"id\": 734688, \"suggestedTranslation\": \"Một công việc sửa chữa xuất sắc.\", \"rating\": 9.0},\n  {\"id\": 734689, \"suggestedTranslation\": \"Có cái gì đó đang cựa quậy bên trong.\", \"rating\": 9.0},\n  {\"id\": 734690, \"suggestedTranslation\": \"Hóa ra thứ ẩn nấp bên trong là đây.\", \"rating\": 9.0},\n  {\"id\": 734691, \"suggestedTranslation\": \"Tôi nhấc được nó đấy. Tôi nhanh nhẹn hơn vẻ bề ngoài nhiều.\", \"rating\": 9.0},\n  {\"id\": 734692, \"suggestedTranslation\": \"Rất có thẩm mỹ.\", \"rating\": 9.0},\n  {\"id\": 734693, \"suggestedTranslation\": \"Cấu trúc đã hoàn chỉnh trở lại.\", \"rating\": 9.0},\n  {\"id\": 734694, \"suggestedTranslation\": \"Có cái gì đó đang cựa quậy bên trong.\", \"rating\": 9.0},\n  {\"id\": 734695, \"suggestedTranslation\": \"Người ta nói mọi khối đá đều ẩn chứa một bức tượng bên trong.\", \"rating\": 9.0},\n  {\"id\": 734696, \"suggestedTranslation\": \"Bạn phải dùng lực từ đầu gối đấy, cưng ạ.\", \"rating\": 9.0},\n  {\"id\": 734697, \"suggestedTranslation\": \"Tôi cảm nhận được một chút hơi hướng ma thuật nhẹ nhàng. Lạ thật.\", \"rating\": 9.0},\n  {\"id\": 734698, \"suggestedTranslation\": \"Chúng ta có lẽ nên để mắt tới cái này.\", \"rating\": 9.0},\n  {\"id\": 734699, \"suggestedTranslation\": \"Có cái gì đó đang cựa quậy bên trong.\", \"rating\": 9.0},\n  {\"id\": 734700, \"suggestedTranslation\": \"Nó ở trong một tình trạng tồi tệ làm sao!\", \"rating\": 9.0},\n  {\"id\": 734701, \"suggestedTranslation\": \"Cái đó mà khiêng là dễ gãy lưng lắm đấy.\", \"rating\": 9.0},\n  {\"id\": 734702, \"suggestedTranslation\": \"Thật vô trách nhiệm.\", \"rating\": 9.0},\n  {\"id\": 734703, \"suggestedTranslation\": \"Thật tốt khi giữ cho tâm trí bận rộn khi ở trên biển.\", \"rating\": 9.0},\n  {\"id\": 734704, \"suggestedTranslation\": \"Tôi có thể cảm thấy chứng ợ nóng rồi đấy!\", \"rating\": 9.0},\n  {\"id\": 734705, \"suggestedTranslation\": \"Sẽ chẳng hay ho gì nếu đâm vào đó đâu.\", \"rating\": 9.0},\n  {\"id\": 734706, \"suggestedTranslation\": \"Tôi chưa từng bắt gặp thứ này trong bất kỳ cuốn sách nào cả.\", \"rating\": 9.0},\n  {\"id\": 734707, \"suggestedTranslation\": \"Vật phát sáng bên trong tỏa ra một loại năng lượng nào đó.\", \"rating\": 9.0},\n  {\"id\": 734708, \"suggestedTranslation\": \"Dùng để cất giữ và vận chuyển hạt giống một cách tiện lợi.\", \"rating\": 9.0},\n  {\"id\": 734709, \"suggestedTranslation\": \"Một nắm hạt giống không thể nhận dạng.\", \"rating\": 9.0},\n  {\"id\": 734710, \"suggestedTranslation\": \"Một món ăn vặt thực vật phôi được nướng thơm!\", \"rating\": 9.0},\n  {\"id\": 734711, \"suggestedTranslation\": \"À! Một quả cầu tiên tri.\", \"rating\": 9.0},\n  {\"id\": 734712, \"suggestedTranslation\": \"Một dụng cụ đơn giản cho các công việc gia đình.\", \"rating\": 9.0},\n  {\"id\": 734713, \"suggestedTranslation\": \"Thật tiếc, nó có lẽ đã hữu ích rồi.\", \"rating\": 9.0},\n  {\"id\": 734714, \"suggestedTranslation\": \"Tuyệt vời! Một nơi để phơi phóng các thiết bị ẩm mốc.\", \"rating\": 9.0},\n  {\"id\": 734715, \"suggestedTranslation\": \"Một loại keo dính chất lượng cao, tốt cho việc vá víu nhỏ.\", \"rating\": 9.0},\n  {\"id\": 734716, \"suggestedTranslation\": \"...Có ai ghé thăm cậu ta gần đây không vậy?\", \"rating\": 9.0},\n  {\"id\": 734717, \"suggestedTranslation\": \"Chà, tôi đoán là chúng ta rất cần thêm một tay đấy... Hừm.\", \"rating\": 9.0},\n  {\"id\": 734718, \"suggestedTranslation\": \"Thứ này... Đây không phải là phép thuật của trẻ con.\", \"rating\": 9.0},\n  {\"id\": 734719, \"suggestedTranslation\": \"Vừa tò mò vừa đáng lo ngại ở mức độ như nhau.\", \"rating\": 9.0},\n  {\"id\": 734720, \"suggestedTranslation\": \"Lớp giáp đá kinh hoàng của sinh vật lạ có tính chất gần như không thể xuyên thủng.\", \"rating\": 9.0},\n  {\"id\": 734721, \"suggestedTranslation\": \"Con quái vật bóng tối đã bị lật ngửa. Tuy nhiên, tôi e là tư thế bất lợi đó sẽ không kéo dài đâu.\", \"rating\": 9.0},\n  {\"id\": 734722, \"suggestedTranslation\": \"Một con quái vật bóng tối hai đầu. Thật kỳ lạ.\", \"rating\": 9.0},\n  {\"id\": 734723, \"suggestedTranslation\": \"Tôi khuyên là không nên khiêu chiến với nó bằng tay không.\", \"rating\": 9.0},\n  {\"id\": 734724, \"suggestedTranslation\": \"Một con quái vật bóng tối vô cùng tham lam.\", \"rating\": 9.0},\n  {\"id\": 734725, \"suggestedTranslation\": \"Một người khôn ngoan sẽ tránh xa cái hàm đầy răng đó ra.\", \"rating\": 9.0},\n  {\"id\": 734726, \"suggestedTranslation\": \"Một loại ký sinh trùng đến từ cõi khác.\", \"rating\": 9.0},\n  {\"id\": 734727, \"suggestedTranslation\": \"Cánh của nó dường như dùng để tạo đà, chứ không phải để bay lơ lửng trên không.\", \"rating\": 9.0},\n  {\"id\": 734728, \"suggestedTranslation\": \"Có cái giá phải trả khi sử dụng những dụng cụ như thế này.\", \"rating\": 9.0},\n  {\"id\": 734729, \"suggestedTranslation\": \"Nó hồi sinh con bò lai đã chết bằng một cơ chế đơn giản: ma thuật.\", \"rating\": 9.0},\n  {\"id\": 734730, \"suggestedTranslation\": \"Tôi không thích loại phép thuật này cho lắm.\", \"rating\": 9.0},\n  {\"id\": 734731, \"suggestedTranslation\": \"Nó không thể sử dụng được cho đến khi được lắp ráp xong.\", \"rating\": 9.0},\n  {\"id\": 734732, \"suggestedTranslation\": \"Đây quả thực là ma thuật hắc ám.\", \"rating\": 9.0},\n  {\"id\": 734733, \"suggestedTranslation\": \"Thế này thì không đạt yêu cầu chút nào.\", \"rating\": 9.0},\n  {\"id\": 734734, \"suggestedTranslation\": \"Thật hấp dẫn! Toàn bộ hàm răng dường như được cấu thành từ đá sống!\", \"rating\": 9.0},\n  {\"id\": 734735, \"suggestedTranslation\": \"Tên côn đồ này đã phá vỡ vô số quy luật tự nhiên, và tôi hoàn toàn không chấp nhận điều đó.\", \"rating\": 9.0},\n  {\"id\": 734736, \"suggestedTranslation\": \"Nó sử dụng muối theo nhiều cách khác nhau.\", \"rating\": 9.0},\n  {\"id\": 734737, \"suggestedTranslation\": \"Một tập hợp các loài thân mềm thật thú vị!\", \"rating\": 9.0},\n  {\"id\": 734738, \"suggestedTranslation\": \"Nó có vẻ phù hợp cho các biện pháp tấn công hơn là phòng thủ như người ta tưởng.\", \"rating\": 9.0},\n  {\"id\": 734739, \"suggestedTranslation\": \"Đó là một cái xẻng. Chắc cậu đã thấy nó bao giờ rồi chứ?\", \"rating\": 9.0},\n  {\"id\": 734740, \"suggestedTranslation\": \"Một dụng cụ đào bới hiệu quả đến ngạc nhiên.\", \"rating\": 9.0},\n  {\"id\": 734741, \"suggestedTranslation\": \"Sự kết hợp bốc mùi này sẽ làm bất kỳ sinh vật nào ăn phải ngất xỉu.\", \"rating\": 9.0},\n  {\"id\": 734742, \"suggestedTranslation\": \"Tôi không cho rằng thứ đó đủ tiêu chuẩn là \\\"bánh\\\" đâu, cưng ạ.\", \"rating\": 9.0},\n  {\"id\": 734743, \"suggestedTranslation\": \"Da ếch phải luôn ẩm ướt, nếu không chúng sẽ ngạt thở. Không phải là con này bận tâm đâu.\", \"rating\": 9.0},\n  {\"id\": 734744, \"suggestedTranslatio