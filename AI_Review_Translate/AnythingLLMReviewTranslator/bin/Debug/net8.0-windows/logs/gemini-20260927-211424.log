.5},\n  {\"id\":733588,\"suggestedTranslation\":\"Bản thân tôi luôn là một người hâm mộ kẹo cam thảo đen.\",\"rating\":8.5},\n  {\"id\":733589,\"suggestedTranslation\":\"Ăn chúng có vẻ hơi tiếc.\",\"rating\":8.5},\n  {\"id\":733590,\"suggestedTranslation\":\"Tôi thà các em không ăn những thứ này chút nào.\",\"rating\":8.5},\n  {\"id\":733591,\"suggestedTranslation\":\"Các em cứ lấy những cái nào mình không thích nhé, các bé yêu.\",\"rating\":8.5},\n  {\"id\":733592,\"suggestedTranslation\":\"Đáng yêu làm sao!\",\"rating\":8.5},\n  {\"id\":733593,\"suggestedTranslation\":\"Tốt nhất là tôi không nên nghe thấy chuyện đau bụng nào sau đó đấy.\",\"rating\":8.5},\n  {\"id\":733594,\"suggestedTranslation\":\"Dũng khí đóng chai.\",\"rating\":8.5},\n  {\"id\":733595,\"suggestedTranslation\":\"Một lọ thần dược ấn tượng.\",\"rating\":8.5},\n  {\"id\":733596,\"suggestedTranslation\":\"Không mạnh mẽ như tôi mong đợi.\",\"rating\":8.5},\n  {\"id\":733597,\"suggestedTranslation\":\"Nó có vẻ dễ bắt lửa.\",\"rating\":8.5},\n  {\"id\":733598,\"suggestedTranslation\":\"Nó dường như xúc tác cho một sự đột biến.\",\"rating\":8.5},\n  {\"id\":733599,\"suggestedTranslation\":\"Một hồn ma trang trí dùng để treo ở đâu đó.\",\"rating\":8.5},\n  {\"id\":733600,\"suggestedTranslation\":\"Một đợt bầy đàn động vật có vú bay lượn.\",\"rating\":8.5},\n  {\"id\":733601,\"suggestedTranslation\":\"Một vật trang trí cây cối thuộc loài nhện.\",\"rating\":8.5},\n  {\"id\":733602,\"suggestedTranslation\":\"Tôi thực sự nên trang trí lại.\",\"rating\":8.5},\n  {\"id\":733603,\"suggestedTranslation\":\"Một vật trang trí như thế này nên được treo lên.\",\"rating\":8.5},\n  {\"id\":733604,\"suggestedTranslation\":\"Một con quạ thế này sẽ ở trên cây tốt hơn.\",\"rating\":8.5},\n  {\"id\":733605,\"suggestedTranslation\":\"Đây có lẽ không phải là cách sử dụng tài nguyên hiệu quả nhất.\",\"rating\":8.5},\n  {\"id\":733606,\"suggestedTranslation\":\"Công cụ của một người thợ.\",\"rating\":8.5},\n  {\"id\":733607,\