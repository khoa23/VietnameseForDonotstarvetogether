            "text": "[\n  {\"id\":735013,\"suggestedTranslation\":\"Phép thuật của viên sỏi mật đã được kích hoạt.\",\"rating\":9.0},\n  {\"id\":735014,\"suggestedTranslation\":\"Một viên sỏi mật hình thành trong ruột của một con thú lớn.\",\"rating\":9.0},\n  {\"id\":735015,\"suggestedTranslation\":\"Mmmm, tự nhiên thật!\",\"rating\":9.0},\n  {\"id\":735016,\"suggestedTranslation\":\"Tôi e là chỉ có cơ bắp mà không có não.\",\"rating\":9.0},\n  {\"id\":735017,\"suggestedTranslation\":\"Đây là một công nghệ khá tiên tiến.\",\"rating\":9.0},\n  {\"id\":735018,\"suggestedTranslation\":\"Một cái bẫy đơn giản gồm gậy và giỏ.\",\"rating\":9.0},\n  {\"id\":735019,\"suggestedTranslation\":\"Những chiếc gai nhỏ trên bụi cây khiến chúng khá khó chịu.\",\"rating\":9.0},\n  {\"id\":735020,\"suggestedTranslation\":\"Những viên đá đã nguội. Két sắt hoàn toàn an toàn.\",\"rating\":8.5},\n  {\"id\":735021,\"suggestedTranslation\":\"Chuẩn bị trước không bao giờ thừa đâu, cưng ạ.\",\"rating\":9.0},\n  {\"id\":735022,\"suggestedTranslation\":\"Dẫm lên đó sẽ cực kỳ có hại cho máu đấy.\",\"rating\":8.5},\n  {\"id\":735023,\"suggestedTranslation\":\"Trời vẫn còn khá nóng.\",\"rating\":9.0},\n  {\"id\":735024,\"suggestedTranslation\":\"Nó đi săn tương tự như loài Dionaea muscipula.\",\"rating\":9.0},\n  {\"id\":735025,\"suggestedTranslation\":\"Nếu là tôi, tôi sẽ cẩn thận với cái đó đấy.\",\"rating\":9.0},\n  {\"id\":735026,\"suggestedTranslation\":\"Nó được bao phủ bởi một lớp dịch tiêu hóa của loài chó mỏng manh.\",\"rating\":9.0},\n  {\"id\":735027,\"suggestedTranslation\":\"Một nỗ lực vụng về nhằm lừa phỉnh tôi.\",\"rating\":9.0},\n  {\"id\":735028,\"suggestedTranslation\":\"Bộ xương cháy xém của một chiếc rương đựng đồ.\",\"rating\":9.5},\n  {\"id\":735029,\"suggestedTranslation\":\"Một chiếc rương đựng đồ.\",\"rating\":9.5},\n  {\"id\":735030,\"suggestedTranslation\":\"Một chiếc rương đựng đồ lớn.\",\"rating\":9.5},\n  {\"id\":735031,\"suggestedTranslation\":\"Trông có vẻ đáng ngờ...\",\"rating\":9.0},\n  {\"id\":735032,\"suggestedTranslation\":\"Thực vật mọc rậm rạp ở đây.\",\"rating\":9.0},\n  {\"id\":735033,\"suggestedTranslation\":\"Hỗn hợp quả vả này có vẻ thúc đẩy cây cối phát triển nhanh chóng.\",\"rating\":9.0},\n  {\"id\":735034,\"suggestedTranslation\":\"Đốt cháy cấu trúc hỗ trợ cây cối sẽ giúp tiếp cận các khoáng chất mà không bị cản trở.\",\"rating\":9.0},\n  {\"id\":735035,\"suggestedTranslation\":\"Tảng đá đã sẵn sàng để khai thác.\",\"rating\":9.0},\n  {\"id\":735036,\"suggestedTranslation\":\"Tính toàn vẹn cấu trúc của thực vật có vẻ thừa sức chịu đựng khối lượng đáng kể của tảng đá.\",\"rating\":9.0},\n  {\"id\":735037,\"suggestedTranslation\":\"Cây Tảng Đá dần tích tụ khoáng chất từ môi trường xung quanh, trưởng thành cho đến khi có thể thu hoạch.\",\"rating\":9.5},\n  {\"id\":735038,\"suggestedTranslation\":\"Hạt giống của Cây Tảng Đá vĩ đại.\",\"rating\":9.5},\n  {\"id\":735039,\"suggestedTranslation\":\"Nó tạo ra sóng âm đúng nghĩa đen!\",\"rating\":9.0},\n  {\"id\":735040,\"suggestedTranslation\":\"Đúng là một bộ dụng cụ cọ rửa bình sữa dễ thương! Tiếc là chúng đều bị tan chảy rồi.\",\"rating\":9.0},\n  {\"id\":735041,\"suggestedTranslation\":\"Tôi không thích ý ám chỉ đó đâu, cưng ạ.\",\"rating\":9.0},\n  {\"id\":735042,\"suggestedTranslation\":\"À, đó là một mô hình thu nhỏ của con robot tinh nghịch đó.\",\"rating\":9.0},\n  {\"id\":735043,\"suggestedTranslation\":\"Một cơ bắp thủy tĩnh được đặt gần một thứ gì đó hút ẩm.\",\"rating\":9.0},\n  {\"id\":735044,\"suggestedTranslation\":\"Đúng là một quý cô nhỏ kỳ lạ một cách đáng yêu và tích cực.\",\"rating\":9.0},\n  {\"id\":735045,\"suggestedTranslation\":\"Tôi nghĩ nó khá đáng yêu, bất chấp những vết nứt do tuổi tác để lại...\",\"rating\":9.0},\n  {\"id\":735046,\"suggestedTranslation\":\"Trong cờ vua thời Trung cổ, quân này được gọi là con voi.\",\"rating\":9.0},\n  {\"id\":735047,\"suggestedTranslation\":\"Rãnh trên quân cờ này tượng trưng cho chiếc mũ đội đầu nghi lễ của giám mục.\",\"rating\":9.0},\n  {\"id\":735048,\"suggestedTranslation\":\"Đây sẽ là một dụng cụ ăn uống thiết thực nếu nó không bị cong.\",\"rating\":9.0},\n  {\"id\":735049,\"suggestedTranslation\":\"Hãy cẩn thận với người Hy Lạp mang quà đến.\",\"rating\":9.0},\n  {\"id\":735050,\"suggestedTranslation\":\"Một minh họa hay về sự tiến động con quay hồi chuyển.\",\"rating\":9.0},\n  {\"id\":735051,\"suggestedTranslation\":\"Một nhạc cụ màng giả.\",\"rating\":9.0},\n  {\"id\":735052,\"suggestedTranslation\":\"Một công cụ tự lực.\",\"rating\":9.0},\n  {\"id\":735053,\"suggestedTranslation\":\"Tôi có một công thức làm bánh trứng đường tuyệt vời.\",\"rating\":9.0},\n  {\"id\":735054,\"suggestedTranslation\":\"Bà tôi thường hay đan len.\",\"rating\":9.0},\n  {\"id\":735055,\"suggestedTranslation\":\"Nó làm tôi nhớ đến quê nhà.\",\"rating\":9.0},\n  {\"id\":735056,\"suggestedTranslation\":\"Đúng là một chú mèo con đáng yêu làm sao. Thở dài.\",\"rating\":9.0},\n  {\"id\":735057,\"suggestedTranslation\":\"Thật là một mùi hương khó chịu.\",\"rating\":9.0},\n  {\"id\":735058,\"suggestedTranslation\":\"Trông nó giống một chiếc cốc nguyên thủy được làm từ củ.\",\"rating\":9.0},\n  {\"id\":735059,\"suggestedTranslation\":\"Tôi nhớ những tiện nghi ở nhà.\",\"rating\":9.0},\n  {\"id\":735060,\"suggestedTranslation\":\"Ngày xửa ngày xưa, nó từng được gọi là \\\"tháp\\\".\",\"rating\":9.0},\n  {\"id\":735061,\"suggestedTranslation\":\"Gọi nó là \\\"lâu đài\\\" hoàn toàn là sai lầm.\",\"rating\":9.0},\n  {\"id\":735062,\"suggestedTranslation\":\"Ôi, tôi rất thích nhà thơ du ca.\",\"rating\":9.0},\n  {\"id\":735063,\"suggestedTranslation\":\"Quân mã sẽ mạnh hơn khi chúng hoạt động ở trung tâm.\",\"rating\":9.0},\n  {\"id\":735064,\"suggestedTranslation\":\"Trong tiếng Đức, nó được gọi là \\\"springer\\\".\",\"rating\":9.0},\n  {\"id\":735065,\"suggestedTranslation\":\"Ồ, tôi đã hy vọng có được một quả cầu pha lê đẹp đẽ.\",\"rating\":9.0},\n  {\"id\":735066,\"suggestedTranslation\"