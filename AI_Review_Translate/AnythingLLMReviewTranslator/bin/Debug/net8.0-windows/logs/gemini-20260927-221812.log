            "text": "[\n  {\"id\":736515,\"suggestedTranslation\":\"Khô cong luôn. Sẵn sàng bắt lửa rồi!\",\"rating\":9.0},\n  {\"id\":736516,\"suggestedTranslation\":\"Ai bảo mi được phép ngừng lớn hả?!\",\"rating\":9.0},\n  {\"id\":736517,\"suggestedTranslation\":\"Đúng rồi!! Cháy đi!!\",\"rating\":9.5},\n  {\"id\":736518,\"suggestedTranslation\":\"Đốt lũ ốm yếu này đi!\",\"rating\":9.0},\n  {\"id\":736519,\"suggestedTranslation\":\"Ghê quá. Mi bốc mùi rồi đấy.\",\"rating\":9.0},\n  {\"id\":736520,\"suggestedTranslation\":\"Sẵn sàng hái thôi!\",\"rating\":9.0},\n  {\"id\":736521,\"suggestedTranslation\":\"Ra thêm điiii!\",\"rating\":9.0},\n  {\"id\":736522,\"suggestedTranslation\":\"Nó đang bốc cháy kìa.\",\"rating\":9.0},\n  {\"id\":736523,\"suggestedTranslation\":\"Đây là phần tuyệt nhất!\",\"rating\":9.0},\n  {\"id\":736524,\"suggestedTranslation\":\"Mừm, tao vẫn ngửi thấy mùi lửa nè.\",\"rating\":9.0},\n  {\"id\":736525,\"suggestedTranslation\":\"Cái quái gì trên thế giới này thế!\",\"rating\":9.0},\n  {\"id\":736526,\"suggestedTranslation\":\"Áaaa! Châm lửa đốt nó đi!\",\"rating\":9.0},\n  {\"id\":736527,\"suggestedTranslation\":\"Ít ra thì giờ nó cũng chịu im miệng.\",\"rating\":9.0},\n  {\"id\":736528,\"suggestedTranslation\":\"Nhà tù cho chim!\",\"rating\":9.0},\n  {\"id\":736529,\"suggestedTranslation\":\"Làm gì mà cứ nhao nhác lên thế nhỉ?\",\"rating\":9.0},\n  {\"id\":736530,\"suggestedTranslation\":\"Hà! Tóm được mi rồi nhé!\",\"rating\":9.0},\n  {\"id\":736531,\"suggestedTranslation\":\"Chắc phải dọn dẹp cái này đi thôi.\",\"rating\":9.0},\n  {\"id\":736532,\"suggestedTranslation\":\"Đồ chim ngốc. Dậy ngay!\",\"rating\":9.0},\n  {\"id\":736533,\"suggestedTranslation\":\"Nó cứ kêu hoài không chịu ngớt!\",\"rating\":9.0},\n  {\"id\":736534,\"suggestedTranslation\":\"Cháy đi, chim nhỏ, cháy đi.\",\"rating\":9.0},\n  {\"id\":736535,\"suggestedTranslation\":\"Để ta làm vinh hạnh này nhé?\",\"rating\":9.0},\n  {\"id\":736536,\"suggestedTranslation\":\"Tôi còn phải nói ra nữa chắc?\",\"rating\":9.0},\n  {\"id\":736537,\"suggestedTranslation\":\"Chuẩn bị tómấy con chim đáng sợ đó thôi.\",\"rating\":9.0},\n  {\"id\":736538,\"suggestedTranslation\":\"Nó cứ có mùi như mông chim ấy.\",\"rating\":9.0},\n  {\"id\":736539,\"suggestedTranslation\":\"Gớm ghiếc. Phần lòng đỏ cứ lỏng loẹt ra kìa.\",\"rating\":9.0},\n  {\"id\":736540,\"suggestedTranslation\":\"Trông nó cứ như muốn ngoạm tao một miếng ấy.\",\"rating\":9.0},\n  {\"id\":736541,\"suggestedTranslation\":\"Ồ thế á?! Trò này chơi hai người được đấy... PHỊT!\",\"rating\":9.0},\n  {\"id\":736542,\"suggestedTranslation\":\"Quân tượng kìa!\",\"rating\":9.0},\n  {\"id\":736543,\"suggestedTranslation\":\"Á đauuuuu!\",\"rating\":9.0},\n  {\"id\":736544,\"suggestedTranslation\":\"Áhh!\",\"rating\":9.0},\n  {\"id\":736545,\"suggestedTranslation\":\"Trông như nó bị thui đen xì rồi ấy.\",\"rating\":9.0},\n  {\"id\":736546,\"suggestedTranslation\":\"Đó là thứ tôi thích nhất trên đời đấy.\",\"rating\":9.0},\n  {\"id\":736547,\"suggestedTranslation\":\"Phịt! Giờ thì mi ngỏm rồi nhé!\",\"rating\":9.0},\n  {\"id\":736548,\"suggestedTranslation\":\"Ồ, sức mạnh lửa kìa!\",\"rating\":9.0},\n  {\"id\":736549,\"suggestedTranslation\":\"Tập thổi lửa trước cho quen.\",\"rating\":9.0},\n  {\"id\":736550,\"suggestedTranslation\":\"Mấy thứ bị gây tê châm lửa dễ hơn đấy.\",\"rating\":9.0},\n  {\"id\":736551,\"suggestedTranslation\":\"Sét cũng kha khá giống lửa nhỉ.\",\"rating\":9.0},\n  {\"id\":736552,\"suggestedTranslation\":\"Ghét cái thứ này thế không biết.\",\"rating\":9.0},\n  {\"id\":736553,\"suggestedTranslation\":\"Hừ. Viên này xấu xí quá.\",\"rating\":9.0},\n  {\"id\":736554,\"suggestedTranslation\":\"Đấy đâu phải tròng mắt! Là đá tảng mà!\",\"rating\":9.0},\n  {\"id\":736555,\"suggestedTranslation\":\"Cái này sẽ đỡ phải mò mẫm thử nghiệm chán chê.\",\"rating\":9.0},\n  {\"id\":736556,\"suggestedTranslation\":\"Ồ. Nó không thèm cháy kìa!!\",\"rating\":9.0},\n  {\"id\":736557,\"suggestedTranslation\":\"Nó có mùi như tất tập gym ấy!\",\"rating\":9.0},\n  {\"id\":736558,\"suggestedTranslation\":\"Được biến đổi bởi lửa!\",\"rating\":9.0},\n  {\"id\":736559,\"suggestedTranslation\":\"Cây nấm ngốc nghếch.\",\"rating\":9.0},\n  {\"id\":736560,\"suggestedTranslation\":\"Này! Mi đấy! Trồi lên đây mau!\",\"rating\":9.0},\n  {\"id\":736561,\"suggestedTranslation\":\"Biết đâu nó sẽ mọc lại vào một ngày nào đó.\",\"rating\":9.0},\n  {\"id\":736562,\"suggestedTranslation\":\"Ván Ép. Chúng sẽ cháy thôi, cũng như mộc bình thường ấy mà.\",\"rating\":9.0},\n  {\"id\":736563,\"suggestedTranslation\":\"Thu cái mõm đó lại cho tôi nhờ!\",\"rating\":9.0},\n  {\"id\":736564,\"suggestedTranslation\":\"Trông hắn ta có vẻ tàn tạ phết.\",\"rating\":9.0},\n  {\"id\":736565,\"suggestedTranslation\":\"Rồi xong, đi tong cái đó luôn.\",\"rating\":9.0},\n  {\"id\":736566,\"suggestedTranslation\":\"Rồi xong, đi tong cái đó luôn.\",\"rating\":9.0},\n  {\"id\":736567,\"suggestedTranslation\":\"Rồi xong, đi tong cái đó luôn.\",\"rating\":9.0},\n  {\"id\":736568,\"suggestedTranslation\":\"Sửa đồ chán ngắt, nhưng mà bắt buộc phải làm.\",\"rating\":9.0},\n  {\"id\":736569,\"suggestedTranslation\":\"Ít ra nó cũng chặn nước được một lúc.\",\"rating\":9.0},\n  {\"id\":736570,\"suggestedTranslation\":\"Chuẩn luôn. Đó là Điểm Kiếm Soát.\",\"rating\":9.0},\n  {\"id\":736571,\"suggestedTranslation\":\"Thứ này mà cũng nổi được á?\",\"rating\":9.0},\n  {\"id\":736572,\"suggestedTranslation\":\"Mong là cái thứ đó không dám chơi gian.\",\"rating\":9.0},\n  {\"id\":736573,\"suggestedTranslation\":\"Đừng có mà dám đâm vào thuyền ván của tôi đấy!\",\"rating\":9.0},\n  {\"id\":736574,\"suggestedTranslation\":\"Đừng có mà dám đâm vào thuyền ván của tôi đấy!\",\"rating\":9.0},\n  {\"id\":736575,\"suggestedTranslation\":\"Biết đâu mình lại nghịch vui được với cái này nhỉ...\",\"rating\":9.0},\n  {\"id\":736576,\"suggestedTranslation\":\"Biết đâu mình lại nghịch vui được với cái này nhỉ...\",\"rating\":9.0},\n  {\"id\":736577,\"suggestedTranslation\":\"Được rồi nhóc con, sẵn sàng xem ta chiến thắng chưa nào?\",\"rating\":9.0},\n  {\"id\":736578,\"suggestedTranslation\":\"Nhanh chóng cho xong chuyện này đi nào.\",\"rating\":9.0},\n  {\"id\":736579,\"suggestedTranslation\":\"NHẤT ĐỊNH phải ném xuống nước á?\",\"rating\":9.0},\n  {\"id\":736580,\"suggestedTranslation\":\"Mong là mớ đồ đạc của tôi sẽ khô ráo trong đó.\",\"rating\":9.0},\n  {\"id\":736581,\"suggestedTranslation\":\"Ew, ngửi cổ lỗ sĩ ghê!\",\"rating\":9.0},\n  {\"id\":736582,\"suggestedTranslation\":\"Vững chắc phết. Đi tông vào cái gì xem nào.\",\"rating\":9.0},\n  {\"id\":736583,\"suggestedTranslation\":\"Chế vài cái đệm va chắc vẫn hơn là chìm thuyền.\",\"rating\":9.0},\n  {\"id\":736584,\"suggestedTranslation\":\"Ewww, nhờn rít quá!\",\"rating\":9.0},\n  {\"id\":736585,\"suggestedTranslation\":\"Chế vài cái đệm va chắc vẫn hơn là chìm thuyền.\",\"rating\":9.0},\n  {\"id\":736586,\"suggestedTranslation\":\"Ừ-hả, chẳng có gì vững chãi hơn vỏ sò đâu.\",\"rating\":9.0},\n  {\"id\":736587,\"suggestedTranslation\":\"Chế vài cái đệm va chắc vẫn hơn là chìm thuyền.\",\"rating\":9.0},\n  {\"id\":736588,\"suggestedTranslation\":\"Được rồi, thuyền ván có răng trông cũng ngầu phết đấy.\",\"rating\":9.0},\n  {\"id\":736589,\"suggestedTranslation\":\"Chế vài cái đệm va chắc vẫn hơn là chìm thuyền.\",\"rating\":9.0},\n  {\"id\":736590,\"suggestedTranslation\":\"Phần vui duy nhất khi đi biển chính là được khai hỏa đại bác.\",\"rating\":9.0},\n  {\"id\":736591,\"suggestedTranslation\":\"Chưa nạp đạn á? Chán ngắt.\",\"rating\":9.0},\n  {\"id\":736592,\"suggestedTranslation\":\"Khỉ thật, hết đạn mất tiêu... này Wes, mày vẫn luôn muốn thử làm người đạn pháo đúng không?\",\"rating\":9.0},\n  {\"id\":736593,\"suggestedTranslation\":\"Cái gì mà ta xây được thì ta được châm lửa đốt.\",\"rating\":9.0},\n  {\"id\":736594,\"suggestedTranslation\":\"Nhưng mà cho xuống nước thì nó sẽ bớt dễ bắt lửa hơn đấy!\",\"rating\":9.0},\n  {\"id\":736595,\"suggestedTranslation\":\"Đó chính là cái phần thuyền ván của thuyền ván.\",\"rating\":9.0},\n  {\"id\":736596,\"suggestedTranslation\":\"Tôi chỉ biết cách giải quyết các rắc rối bằng lửa thôi.\",\"rating\":9.0},\n  {\"id\":736597,\"suggestedTranslation\":\"Được rồiiiii, chắc là nó dùng tốt chán.\",\"rating\":9.0},\n  {\"id\":736598,\"suggestedTranslation\":\"Tuyệt, giờ thì tôi vác một cục nam châm ngốc nghếch to đùng rồi đây.\",\"rating\":9.0},\n  {\"id\":736599,\"suggestedTranslation\":\"Chắc là nó đang hoạt động đấy.\",\"rating\":9.0},\n  {\"id\":736600,\"suggestedTranslation\":\"Tuyệt, giờ thì tôi có một cục nam châm ngốc nghếch bé tí rồi đây.\",\"rating\":9.0},\n  {\"id\":736601,\"suggestedTranslation\":\"Wilson! Sao ông bắt tôi gom đống rác này lại với nhau chứ hả?!\",\"rating\":9.0},\n  {\"id\":736602,\"suggestedTranslation\":\"Hehehe, xem tụi mình quay nhanh tới mức nào trước khi thấy chóng mặt nào!\",\"rating\":9.0},\n  {\"id\":736603,\"suggestedTranslation\":\"Đượcccc rồi, tôi sẽ lắp cái cần điều hướng chết tiệt này lên cái thuyền ván chết tiệt.\",\"rating\":9.0},\n  {\"id\":736604,\"suggestedTranslation\":\"Bernie ôm thích hơn một chiếc gối lông lá cũ kỹ.\",\"rating\":9.0},\n  {\"id\":736605,\"suggestedTranslation\":\"Ew, chiếc gối này toàn rác ướt sũng!\",\"rating\":9.0},\n  {\"id\":736606,\"suggestedTranslation\":\"Chắc đó là một công dụng của hoa.\",\"rating\":9.0},\n  {\"id\":736607,\"suggestedTranslation\":\"Chắc chắn đây là chiếc gối tệ nhất quả đất.\",\"rating\":9.0},\n  {\"id\":736608,\"suggestedTranslation\":\"Hừ. Liệu hồn đấy!\",\"rating\":9.0},\n  {\"id\":736609,\"suggestedTranslation\":\"Wormwood chắc chắn đã táy máy cái món đó rồi.\",\"rating\":9.0},\n  {\"id\":736610,\"suggestedTranslation\":\"Tôi không nghĩ chúng dùng làm bùi nhùi tốt đâu.\",\"rating\":9.0},\n  {\"id\":736611,\"suggestedTranslation\":\"Tôi sẽ HÚT SẠCH nó cho coi!\",\"rating\":9.0},\n  {\"id\":736612,\"suggestedTranslation\":\"Cứ thêm lửa vào thức ăn là xong xuôi!\",\"rating\":9.0},\n  {\"id\":736613,\"suggestedTranslation\":\"Cái gì cháy thì đã cháy rồi, nghĩ ngợi nhiều làm gì cho mệt, đúng không?\",\"rating\":9.0},\n  {\"id\":736614,\"suggestedTranslation\":\"Này, ờ... cô Wickerbottom từng làm việc ở thư viện nào thế nhỉ?\",\"rating\":9.0},\n  {\"id\":736615,\"suggestedTranslation\":\"\\\"Quy tắc số một: không châm lửa đốt tổ ong\\\"? Sách vở ngốc nghếch!\",\"rating\":9.0},\n  {\"id\":736616,\"suggestedTranslation\":\"Đọc ít thôi, đốt nhiều vào!\",\"rating\":9.0},\n  {\"id\":736617,\"suggestedTranslation\":\"Đó là cuốn sách yêu thích của tôi!\",\"rating\":9.0},\n  {\"id\":736618,\"suggestedTranslation\":\"Trông cũng hay ho đấy, với một cuốn sách.\",\"rating\":9.0},\n  {\"id\":736619,\"suggestedTranslation\":\"Thấy cái gì là châm lửa đốt cái đó. Tôi cần quái gì sách dạy mấy chuyện này!\",\"rating\":9.0},\n  {\"id\":736620,\"suggestedTranslation\":\"Thứ duy nhất chán hơn câu cá chính là đọc sách về câu cá.\",\"rating\":9.0},\n  {\"id\":736621,\"suggestedTranslation\":\"Trông chẳng khác gì củi mồi đối với tôi.\",\"rating\":9.0},\n  {\"id\":736622,\"suggestedTranslation\":\"Ứ, ai thèm quan tâm chứ?\",\"rating\":9.0},\n  {\"id\":736623,\"suggestedTranslation\":\"Ứ, ai thèm quan tâm chứ?\",\"rating\":9.0},\n  {\"id\":736624,\"suggestedTranslation\":\"Vừa đẹp lại vừa dày, đốt chắc là cháy lâu phết đấy.\",\"rating\":9.0},\n  {\"id\":736625,\"suggestedTranslation\":\"Chà, lại thêm một cuốn sách tôi thèm đọc bao giờ!\",\"rating\":9.0},\n  {\"id\":736626,\"suggestedTranslation\":\"Đừng có bắt tôi đọc sách nữa!\",\"rating\":9.0},\n  {\"id\":736627,\"suggestedTranslation\":\"Lại một cuốn sách nhảm nhí về cái gì đấy.\",\"rating\":9.0},\n  {\"id\":736628,\"suggestedTranslation\":\"Hừ, ghét mưa ghét gió lắm!\",\"rating\":9.0},\n  {\"id\":736629,\"suggestedTranslation\":\"Sao mọi thứ có thể nhét vừa vào đó được nhỉ?\",\"rating\":9.0},\n  {\"id\":736630,\"suggestedTranslation\":\"Này, sách củi mồi kìa!\",\"rating\":9.0},\n  {\"id\":736631,\"suggestedTranslation\":\"Chán-ngắt!\",\"rating\":9.0},\n  {\"id\":736632,\"suggestedTranslation\":\"Ngá-ooo-oo-p.\",\"rating\":9.0},\n  {\"id\":736633,\"suggestedTranslation\":\"Trông giống củi mồi đối với tôi!\",\"rating\":9.0},\n  {\"id\":736634,\"suggestedTranslation\":\"Ew, ai mà thèm đọc sách về nhện chứ?\",\"rating\":9.0},\n  {\"id\":736635,\"suggestedTranslation\":\"Nó không phải là thứ vũ khí hào hứng cho lắm.\",\"rating\":9.0},\n  {\"id\":736636,\"suggestedTranslation\":\"Hừ, ngửi cứ như mùi bàn chân cũ!\",\"rating\":9.0},\n  {\"id\":736637,\"suggestedTranslation\":\"Chà, có vẻ như nó hỏng bét rồi.\",\"rating\":9.0},\n  {\"id\":736638,\"suggestedTranslation\":\"Châm chút lửa chắc là sửa được. Lửa chữa lành tất cả!\",\"rating\":9.0},\n  {\"id\":736639,\"suggestedTranslation\":\"Nó có mùi như tóc cháy ấy.\",\"rating\":9.0},\n  {\"id\":736640,\"suggestedTranslation\":\"Chẳng trùm vừa cái đầu to của Webber đâu.\",\"rating\":9.0},\n  {\"id\":736641,\"suggestedTranslation\":\"Cá là chúng ta ăn được món đó.\",\"rating\":9.0},\n  {\"id\":736642,\"suggestedTranslation\":\"Chẳng còn gì để lấy nữa.\",\"rating\":9.0},\n  {\"id\":736643,\"suggestedTranslation\":\"Haha! Thứ này tuyệt phết.\",\"rating\":9.0},\n  {\"id\":736644,\"suggestedTranslation\":\"Giờ thì tao có thể đốt một đống thứ cùng một lúc rồi!\",\"rating\":9.0},\n  {\"id\":736645,\"suggestedTranslation\":\"Chắc chúng ta có thể giấu vài thứ gớm ghiếc vào trong.\",\"rating\":9.0},\n  {\"id\":736646,\"suggestedTranslation\":\"Hừ. Trông ngốc nghếch hết chỗ nói.\",\"rating\":9.0},\n  {\"id\":736647,\"suggestedTranslation\":\"Nó sưởi ấm từ trong ra ngoài luôn.\",\"rating\":9.0},\n  {\"id\":736648,\"suggestedTranslation\":\"Cái đó cháy nhanh quá mức cần thiết rồi đấy.\",\"rating\":9.0},\n  {\"id\":736649,\"suggestedTranslation\":\"Quá ư là thụ động!\",\"rating\":9.0},\n  {\"id\":736650,\"suggestedTranslation\":\"Ngon phết, lại có thêm chút vị côn trùng nữa chứ.\",\"rating\":9.0},\n  {\"id\":736651,\"suggestedTranslation\":\"Bay đi nào, bướm ơi!\",\"rating\":9.0},\n  {\"id\":736652,\"suggestedTranslation\":\"Tôi muốn bóp nát nó quá.\",\"rating\":9.0},\n  {\"id\":736653,\"suggestedTranslation\":\"Hì hì, nhìn con bướm bị kẹt trong bánh nướng kìa.\",\"rating\":9.0},\n  {\"id\":736654,\"suggestedTranslation\":\"Hết bay lượn nổi nhé con bướm kia!\",\"rating\":9.0},\n  {\"id\":736655,\"suggestedTranslation\":\"Cái cổ của mi gớm ghiếc thật đấy.\",\"rating\":9.0},\n  {\"id\":736656,\"suggestedTranslation\":\"Cháy đi, diều hâu, cháy đi.\",\"rating\":9.0},\n  {\"id\":736657,\"suggestedTranslation\":\"Để ta làm vinh hạnh này nhé?\",\"rating\":9.0},\n  {\"id\":736658,\"suggestedTranslation\":\"Tôi còn phải nói ra nữa chắc?\",\"rating\":9.0},\n  {\"id\":736659,\"suggestedTranslation\":\"Ừm, mấy món cuộn này hợp ý tôi đấy.\",\"rating\":9.0},\n  {\"id\":736660,\"suggestedTranslation\":\"Gai nhọn! Điểm yếu của tôi! Sao mi hay thế?\",\"rating\":9.0},\n  {\"id\":736661,\"suggestedTranslation\":\"Cứ cho là hòa đi.\",\"rating\":9.0},\n  {\"id\":736662,\"suggestedTranslation\":\"Lại thêm một bông hoa nữa.\",\"rating\":9.0},\n  {\"id\":736663,\"suggestedTranslation\":\"Trông vẫn có vẻ nguy hiểm.\",\"rating\":9.0},\n  {\"id\":736664,\"suggestedTranslation\":\"Giờ thì trông có vẻ ổn rồi đấy.\",\"rating\":9.0},\n  {\"id\":736665,\"suggestedTranslation\":\"Ối dào. Câu cá được cuộn trong rong biển.\",\"rating\":9.0},\n  {\"id\":736666,\"suggestedTranslation\":\"Ơ kìa. Nó sắp tàn mất rồi!\",\"rating\":9.0},\n  {\"id\":736667,\"suggestedTranslation\":\"Tôi thích lửa.\",\"rating\":9.0},\n  {\"id\":736668,\"suggestedTranslation\":\"CHÁY ĐI! CHÁY NHANH HƠN NỮA ĐI!\",\"rating\":9.0},\n  {\"id\":736669,\"suggestedTranslation\":\"Ngọn lửa này bé tí và chán ngắt.\",\"rating\":9.0},\n  {\"id\":736670,\"suggestedTranslation\":\"Cháy đi!\",\"rating\":9.0},\n  {\"id\":736671,\"suggestedTranslation\":\"Hic. Tiêu đời rồi.\",\"rating\":9.0},\n  {\"id\":736672,\"suggestedTranslation\":\"Mà lăn đùng ra chết là tao té gấ