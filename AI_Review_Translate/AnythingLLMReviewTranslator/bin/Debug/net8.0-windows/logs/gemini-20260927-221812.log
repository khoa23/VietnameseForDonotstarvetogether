            "text": "[\n  {\"id\": 735915, \"suggestedTranslation\": \"Tôi biếtnnnn cái đó rồi, trời ạ!\", \"rating\": 0.0},\n  {\"id\": 735916, \"suggestedTranslation\": \"Đọc cái này ở đây chẳng có ích gì.\", \"rating\": 0.0},\n  {\"id\": 735917, \"suggestedTranslation\": \"Hừ. Mấy con khỉ làm bản đồ tệ thật đấy.\", \"rating\": 0.0},\n  {\"id\": 735918, \"suggestedTranslation\": \"Cái quái gì... bản đồ này sai bét nhè!\", \"rating\": 0.0},\n  {\"id\": 735919, \"suggestedTranslation\": \"only_used_by_walter\", \"rating\": 0.0},\n  {\"id\": 735920, \"suggestedTranslation\": \"Ai đó nhanh tay lấy mất rồi.\", \"rating\": 0.0},\n  {\"id\": 735921, \"suggestedTranslation\": \"Có một con Bò Lai là đủ đối phó rồi.\", \"rating\": 0.0},\n  {\"id\": 735922, \"suggestedTranslation\": \"Ừm... cách đó không khả thi đâu.\", \"rating\": 0.0},\n  {\"id\": 735923, \"suggestedTranslation\": \"Đồ bỏ đi thì sửa thế nào được.\", \"rating\": 0.0},\n  {\"id\": 735924, \"suggestedTranslation\": \"Tôi quan tâm đến cái đó làm gì?\", \"rating\": 0.0},\n  {\"id\": 735925, \"suggestedTranslation\": \"Nhưng cái thứ to xác xấu xí đó đang bám đuôi tôi kìa!\", \"rating\": 0.0},\n  {\"id\": 735926, \"suggestedTranslation\": \"Ý bạn là còn một chiếc chìa khóa khác nữa á?!\", \"rating\": 0.0},\n  {\"id\": 735927, \"suggestedTranslation\": \"Cái đồ chết tiệt này không chịu hoạt động!\", \"rating\": 0.0},\n  {\"id\": 735928, \"suggestedTranslation\": \"Tôi không đời nào gói không khí đâu!\", \"rating\": 0.0},\n  {\"id\": 735929, \"suggestedTranslation\": \"Tôi không viết lên đó được.\", \"rating\": 0.0},\n  {\"id\": 735930, \"suggestedTranslation\": \"Tôi muốn viết khi nào bạn làm xong cơ!\", \"rating\": 0.0},\n  {\"id\": 735931, \"suggestedTranslation\": \"Chắc hắn đang ở đâu đó quanh đây.\", \"rating\": 0.0},\n  {\"id\": 735932, \"suggestedTranslation\": \"Này anh bạn kỳ cục! AlOOOO?\", \"rating\": 0.0},\n  {\"id\": 735933, \"suggestedTranslation\": \"Tôi chịu chẳng biết ổng đang ở đâu.\", \"rating\": 0.0},\n  {\"id\": 735934, \"suggestedTranslation\": \"Gã này bị cái quái gì thế nhỉ?\", \"rating\": 0.0},\n  {\"id\": 735935, \"suggestedTranslation\": \"Ugh, tôi biết cái này từ trước rồi!\", \"rating\": 0.0},\n  {\"id\": 735936, \"suggestedTranslation\": \"Tôi khônggggg thể.\", \"rating\": 0.0},\n  {\"id\": 735937, \"suggestedTranslation\": \"Di chuyển đi, mũi tên! DI CHUYỂN NÀO!\", \"rating\": 0.0},\n  {\"id\": 735938, \"suggestedTranslation\": \"TÔI LÀM ĐƯỢC RỒI!\", \"rating\": 0.0},\n  {\"id\": 735939, \"suggestedTranslation\": \"Chà, không ổn chút nào rồi.\", \"rating\": 0.0},\n  {\"id\": 735940, \"suggestedTranslation\": \"LẦN NÀY anh thắng đấy, Maxwell.\", \"rating\": 0.0},\n  {\"id\": 735941, \"suggestedTranslation\": \"Mặt đất đang nứt ra kìa!\", \"rating\": 0.0},\n  {\"id\": 735942, \"suggestedTranslation\": \"Đi cẩn thận vào!\", \"rating\": 0.0},\n  {\"id\": 735943, \"suggestedTranslation\": \"Động đất!\", \"rating\": 0.0},\n  {\"id\": 735944, \"suggestedTranslation\": \"Này, tôi mang quà cho bạn nè!\", \"rating\": 0.0},\n  {\"id\": 735945, \"suggestedTranslation\": \"Đến giờ ăn rồi!\", \"rating\": 0.0},\n  {\"id\": 735946, \"suggestedTranslation\": \"Kiến Sư Tử vĩ đại! Nhận lấy lễ vật này đi, hoặc bất cứ thứ gì tương tự.\", \"rating\": 0.0},\n  {\"id\": 735947, \"suggestedTranslation\": \"Ugh, nó đang nhồi nhét mấy thứ mọt sách vào đầu tôi kìa!\", \"rating\": 0.0},\n  {\"id\": 735948, \"suggestedTranslation\": \"Chà, đúng là hồi hộp thật đấy.\", \"rating\": 0.0},\n  {\"id\": 735949, \"suggestedTranslation\": \"Xì. Thấy từ tám hoánh rồi.\", \"rating\": 0.0},\n  {\"id\": 735950, \"suggestedTranslation\": \"Chắc tôi không nên ở đây đâu.\", \"rating\": 0.0},\n  {\"id\": 735951, \"suggestedTranslation\": \"Nghe có vẻ nguy hiểm đấy!\", \"rating\": 0.0},\n  {\"id\": 735952, \"suggestedTranslation\": \"Cái gì thế nhỉ?!\", \"rating\": 0.0},\n  {\"id\": 735953, \"suggestedTranslation\": \"Mày muốn gây sự hả?!\", \"rating\": 0.0},\n  {\"id\": 735954, \"suggestedTranslation\": \"Tôi chưa bao giờ thử dùng điện để nhóm lửa cả!\", \"rating\": 0.0},\n  {\"id\": 735955, \"suggestedTranslation\": \"Ha! Nhận lấy này, nước nhé!\", \"rating\": 0.0},\n  {\"id\": 735956, \"suggestedTranslation\": \"Nhào vô đây, mấy tên ngốc!\", \"rating\": 0.0},\n  {\"id\": 735957, \"suggestedTranslation\": \"Yeah! Tôi sẽ thức suốt đời luôn!\", \"rating\": 0.0},\n  {\"id\": 735958, \"suggestedTranslation\": \"Đống động lực này chui ra từ đâu thế không biết nữa?!\", \"rating\": 0.0},\n  {\"id\": 735959, \"suggestedTranslation\": \"oOoOooOo!!\", \"rating\": 0.0},\n  {\"id\": 735960, \"suggestedTranslation\": \"Aaaah! Mấy con bọ chích chích!\", \"rating\": 0.0},\n  {\"id\": 735961, \"suggestedTranslation\": \"Ghê tởm, tôi ghét nước lắm.\", \"rating\": 0.0},\n  {\"id\": 735962, \"suggestedTranslation\": \"Tôi sắp chết đuối rồi!!\", \"rating\": 0.0},\n  {\"id\": 735963, \"suggestedTranslation\": \"Cái boomerang ngốc nghếch!\", \"rating\": 0.0},\n  {\"id\": 735964, \"suggestedTranslation\": \"Haha! Mấy con dơi đó không còn dọa được tôi nữa đâu!\", \"rating\": 0.0},\n  {\"id\": 735965, \"suggestedTranslation\": \"Ước gì tôi cứ để nó chìm trong biển lửa...\", \"rating\": 0.0},\n  {\"id\": 735966, \"suggestedTranslation\": \"Này bò lai! Lại đây mau!\", \"rating\": 0.0},\n  {\"id\": 735967, \"suggestedTranslation\": \"\\nTôi nghĩ mình sửa được cái này!\", \"rating\": 0.0},\n  {\"id\": 735968, \"suggestedTranslation\": \"Uuugh tôi cần thêm nguyên liệu!\", \"rating\": 0.0},\n  {\"id\": 735969, \"suggestedTranslation\": \"Tôi không chế tạo nó ở đây được!\", \"rating\": 0.0},\n  {\"id\": 735970, \"suggestedTranslation\": \"Ừ thì... tôi thực ra vẫn chưa hiểu rõ cách làm cái đó.\", \"rating\": 0.0},\n  {\"id\": 735971, \"suggestedTranslation\": \"Sao ban giám khảo có thể thấy con bò lai của tôi ở xa thế này chứ?\", \"rating\": 0.0},\n  {\"id\": 735972, \"suggestedTranslation\": \"Khoan, sao thứ này lại quay lại túi tôi thế này? Không phải tôi vừa...?\", \"rating\": 0.0},\n  {\"id\": 735973, \"suggestedTranslation\": \"Này! DẬY NGAY!!\", \"rating\": 0.0},\n  {\"id\": 735974, \"suggestedTranslation\": \"Phản xạ kém thế nhỉ, hả?\", \"rating\": 0.0},\n  {\"id\": 735975, \"suggestedTranslation\": \"Ừm, chúng ta đi nhanh hơn chút được không vậy?!\", \"rating\": 0.0},\n  {\"id\": 735976, \"suggestedTranslation\": \"Cà Ruột ngốc ơi, mày đi nhầm hướng rồi kìa!\", \"rating\": 0.0},\n  {\"id\": 735977, \"suggestedTranslation\": \"Này! Vạch đích ở ĐẰNG KIA cơ mà!\", \"rating\": 0.0},\n  {\"id\": 735978, \"suggestedTranslation\": \"Được rồi, cùng nhau giành giải thưởng đó nào!\", \"rating\": 0.0},\n  {\"id\": 735979, \"suggestedTranslation\": \"Tôi tranh thủ bảo vệ cái đầu của mình mới được!\", \"rating\": 0.0},\n  {\"id\": 735980, \"suggestedTranslation\": \"Tuyệt cú mèo luôn!\", \"rating\": 0.0},\n  {\"id\": 735981, \"suggestedTranslation\": \"Tôi không sợ ngươi đâu!\", \"rating\": 0.0},\n  {\"id\": 735982, \"suggestedTranslation\": \"only_used_by_winona\", \"rating\": 0.0},\n  {\"id\": 735983, \"suggestedTranslation\": \"ÁI CHÀ! Đồ khốn!\", \"rating\": 0.0},\n  {\"id\": 735984, \"suggestedTranslation\": \"only_used_by_wolfgang\", \"rating\": 0.0},\n  {\"id\": 735985, \"suggestedTranslation\": \"only_used_by_wolfgang\", \"rating\": 0.0},\n  {\"id\": 735986, \"suggestedTranslation\": \"only_used_by_wolfgang\", \"rating\": 0.0},\n  {\"id\": 735987, \"suggestedTranslation\": \"only_used_by_wolfgang\", \"rating\": 0.0},\n  {\"id\": 735988, \"suggestedTranslation\": \"only_used_by_wolfgang\", \"rating\": 0.0},\n  {\"id\": 735989, \"suggestedTranslation\": \"only_used_by_wolfgang\", \"rating\": 0.0},\n  {\"id\": 735990, \"suggestedTranslation\": \"only_used_by_wolfgang\", \"rating\": 0.0},\n  {\"id\": 735991, \"suggestedTranslation\": \"only_used_by_wolfgang\", \"rating\": 0.0},\n  {\"id\": 735992, \"suggestedTranslation\": \"only_used_by_wolfgang\", \"rating\": 0.0},\n  {\"id\": 735993, \"suggestedTranslation\": \"Cái lạnh này! Nó buốt quá!\", \"rating\": 0.0},\n  {\"id\": 735994, \"suggestedTranslation\": \"Ái chà cái kim la bàn kẹt cứng rồi!\", \"rating\": 0.0},\n  {\"id\": 735995, \"suggestedTranslation\": \"Chà, tôi thực sự cần giấc ngủ đó đấy!\", \"rating\": 0.0},\n  {\"id\": 735996, \"suggestedTranslation\": \"Tôi thiếu mất thứ gì đó rồi.\", \"rating\": 0.0},\n  {\"id\": 735997, \"suggestedTranslation\": \"Ối không!\", \"rating\": 0.0},\n  {\"id\": 735998, \"suggestedTranslation\": \"Nghe cứ như tiếng của một gã quái vật to xác hung ác ấy!\", \"rating\": 0.0},\n  {\"id\": 735999, \"suggestedTranslation\": \"Một ánh sáng rực cháy!\", \"rating\": 0.0},\n  {\"id\": 736000, \"suggestedTranslation\": \"Khônggggg tôi vẫn còn muốn đấm đá thêm cơ mà!\", \"rating\": 0.0},\n  {\"id\": 736001, \"suggestedTranslation\": \"Dù sao thì tôi vẫn thích châm lửa theo kiểu truyền thống hơn.\", \"rating\": 0.0},\n  {\"id\": 736002, \"suggestedTranslation\": \"Ugh. Lại phải quay lại canh mấy vũng nước rồi.\", \"rating\": 0.0},\n  {\"id\": 736003, \"suggestedTranslation\": \"Chắc đây không phải thời điểm tốt để gây sự đâu.\", \"rating\": 0.0},\n  {\"id\": 736004, \"suggestedTranslation\": \"Không! Tôi chưa muốn thấy mệt lúc này đâu!\", \"rating\": 0.0},\n  {\"id\": 736005, \"suggestedTranslation\": \"Chà. Động lực bay màu rồi.\", \"rating\": 0.0},\n  {\"id\": 736006, \"suggestedTranslation\": \"Xì. Dùng lửa chắc cũng hiệu quả ngang ngửa.\", \"rating\": 0.0},\n  {\"id\": 736007, \"suggestedTranslation\": \"Trời sắp tối rồi. Tôi cần lửa!\", \"rating\": 0.0},\n  {\"id\": 736008, \"suggestedTranslation\": \"Ngon tuyệt!\", \"rating\": 0.0},\n  {\"id\": 736009, \"suggestedTranslation\": \"Làm sao mà tôi ăn nổi thứ này chứ!\", \"rating\": 0.0},\n  {\"id\": 736010, \"suggestedTranslation\": \"Hừ! Ghê chết đi được!\", \"rating\": 0.0},\n  {\"id\": 736011, \"suggestedTranslation\": \"Ăn dở tệ!\", \"rating\": 0.0},\n  {\"id\": 736012, \"suggestedTranslation\": \"Ăn hơi bị gớm.\", \"rating\": 0.0},\n  {\"id\": 736013, \"suggestedTranslation\": \"Eo ôi, còn lâu nhé!\", \"rating\": 0.0},\n  {\"id\": 736014, \"suggestedTranslation\": \"Đượccccc rồi, tôi sẽ chia sẻ với mọi người.\", \"rating\": 0.0},\n  {\"id\": 736015, \"suggestedTranslation\": \"Đúng là thứ mình cần!\", \"rating\": 0.0},\n  {\"id\": 736016, \"suggestedTranslation\": \"Nhưng tôi thấy rõ bằng ánh lửa rồi mà.\", \"rating\": 0.0},\n  {\"id\": 736017, \"suggestedTranslation\": \"Tôi có thể nhấc bổng cả Wolfgang luôn ấy chứ!\", \"rating\": 0.0},\n  {\"id\": 736018, \"suggestedTranslation\": \"Phù! Mạnh quá mức cần thiết rồi đấy.\", \"rating\": 0.0},\n  {\"id\": 736019, \"suggestedTranslation\": \"Ughhh!\", \"rating\": 0.0},\n  {\"id\": 736020, \"suggestedTranslation\": \"Tập thể dục... tệ hại thật!\", \"rating\": 0.0},\n  {\"id\": 736021, \"suggestedTranslation\": \"Hnnfhg!\", \"rating\": 0.0},\n  {\"id\": 736022, \"suggestedTranslation\": \"Sao mình lại phải làm thế này cơ chứ...?!\", \"rating\": 0.0},\n  {\"id\": 736023, \"suggestedTranslation\": \"Oooof!!\", \"rating\": 0.0},\n  {\"id\": 736024, \"suggestedTranslation\": \"Unghhh!\", \"rating\": 0.0},\n  {\"id\": 736025, \"suggestedTranslation\": \"Chắc chắn... không đáng chút nào đâu!\", \"rating\": 0.0},\n  {\"id\": 736026, \"suggestedTranslation\": \"Hai tay tôi cứ như đang bốc lửa vậy!\", \"rating\": 0.0},\n  {\"id\": 736027, \"suggestedTranslation\": \"Ughhhh! Ướt đẫm mồ hôi rồi!\", \"rating\": 0.0},\n  {\"id\": 736028, \"suggestedTranslation\": \"Cái này... đúng là... tồi tệ nhất...\", \"rating\": 0.0},\n  {\"id\": 736029, \"suggestedTranslation\": \"Tôi cảm nhận được sức nóng... ghét thật đấy!\", \"rating\": 0.0},\n  {\"id\": 736030, \"suggestedTranslation\": \"only_used_by_winona\", \"rating\": 0.0},\n  {\"id\": 736031, \"suggestedTranslation\": \"only_used_by_winona\", \"rating\": 0.0},\n  {\"id\": 736032, \"suggestedTranslation\": \"only_used_by_winona\", \"rating\": 0.0},\n  {\"id\": 736033, \"suggestedTranslation\": \"Tôi vứt cái bật lửa ở xó nào rồi nhỉ!?\", \"rating\": 0.0},\n  {\"id\": 736034, \"suggestedTranslation\": \"Ồ, thấy được rồi! Cứ tưởng tôi bị mù rồi chứ.\", \"rating\": 0.0},\n  {\"id\": 736035, \"suggestedTranslation\": \"Sao lại có thứ quái quỷ đó tồn tại cơ chứ?!\", \"rating\": 0.0},\n  {\"id\": 736036, \"suggestedTranslation\": \"Eo ôi, nó lòi ra ngoài kìa!!\", \"rating\": 0.0},\n  {\"id\": 736037, \"suggestedTranslation\": \"Đồ hèn, đứng lại đừng chạy nữa mau!!\", \"rating\": 0.0},\n  {\"id\": 736038, \"suggestedTranslation\": \"Mày quay lại đây chỉ để BỊ ĐỐT hả?\", \"rating\": 0.0},\n  {\"id\": 736039, \"suggestedTranslation\": \"Cái đồ ngốc nghếch hỏng mất tiêu rồi!\", \"rating\": 0.0},\n  {\"id\": 736040, \"suggestedTranslation\": \"Chao ôi, thú vị ghê. Thật mừng vì tôi đã dành thời gian học cái đó thay vì làm bất cứ việc gì khác.\", \"rating\": 0.0},\n  {\"id\": 736041, \"suggestedTranslation\": \"Ái chà, buốt quá!! Nhưng theo kiểu không vui tí nào!\", \"rating\": 0.0},\n  {\"id\": 736042, \"suggestedTranslation\": \"Có lửa đang chảy trong huyết quản tôi này!\", \"rating\": 0.0},\n  {\"id\": 736043, \"suggestedTranslation\": \"Hừ. Suýt nữa thì tôi quen với nó luôn rồi đấy.\", \"rating\": 0.0},\n  {\"id\": 736044, \"suggestedTranslation\": \"Ồ, hay phết! Ai đó vừa bắn pháo sáng lên trời kìa!\", \"rating\": 0.0},\n  {\"id\": 736045, \"suggestedTranslation\": \"Cái gì vừa chạm vào chân tôi thế.\", \"rating\": 0.0},\n  {\"id\": 736046, \"suggestedTranslation\": \"Tôi ghét phải chờ đợi lắm!\", \"rating\": 0.0},\n  {\"id\": 736047, \"suggestedTranslation\": \"Tôi kiệt sức rồi!\", \"rating\": 0.0},\n  {\"id\": 736048, \"suggestedTranslation\": \"only_used_by_warly\", \"rating\": 0.0},\n  {\"id\": 736049, \"suggestedTranslation\": \"Tôi được tự do rồi! Đến lúc châm lửa thôi!\", \"rating\": 0.0},\n  {\"id\": 736050, \"suggestedTranslation\": \"only_used_by_wurt\", \"rating\": 0.0},\n  {\"id\": 736051, \"suggestedTranslation\": \"Đốt... Tất cả phải thiêu rụi...\", \"rating\": 0.0},\n  {\"id\": 736052, \"suggestedTranslation\": \"only_used_by_wendy\", \"rating\": 0.0},\n  {\"id\": 736053, \"suggestedTranslation\": \"Này! Cái bình xịt kỳ cục gì thế này?!\", \"rating\": 0.0},\n  {\"id\": 736054, \"suggestedTranslation\": \"Chắc thuốc chống axit hết tác dụng rồi, kiểu bỏng này thì TÔI KHÔNG THÍCH đâu.\", \"rating\": 0.0},\n  {\"id\": 736055, \"suggestedTranslation\": \"Cao nhiệt của tôi sắp hết tác dụng rồi. Mặc kệ đi!\", \"rating\": 0.0},\n  {\"id\": 736056, \"suggestedTranslation\": \"Về nhà Ngọc trai rồi!\", \"rating\": 0.0},\n  {\"id\": 736057, \"suggestedTranslation\": \"Cái quái gì thế nhỉ?\", \"rating\": 0.0},\n  {\"id\": 736058, \"suggestedTranslation\": \"Nhiều thông tin quá!\", \"rating\": 0.0},\n  {\"id\": 736059, \"suggestedTranslation\": \"Sức nóng gay gắt quá!\", \"rating\": 0.0},\n  {\"id\": 736060, \"suggestedTranslation\": \"Lòi mặt ra mau!\", \"rating\": 0.0},\n  {\"id\": 736061, \"suggestedTranslation\": \"Tôi cần đồ ăn!\", \"rating\": 0.0},\n  {\"id\": 736062, \"suggestedTranslation\": \"Tôi không sợ đâu, chỉ là... thích đi hướng này hơn thôi!\", \"rating\": 0.0},\n  {\"id\": 736063, \"suggestedTranslation\": \"Tôi sẽ tóm được ngươi!\", \"rating\": 0.0},\n  {\"id\": 736064, \"suggestedTranslation\": \"Ối... hắn trốn mất tiêu rồi.\", \"rating\": 0.0},\n  {\"id\": 736065, \"suggestedTranslation\": \"Chán thế, mất hút dấu vết trong đám bùn mất rồi.\", \"rating\": 0.0},\n  {\"id\": 736066, \"suggestedTranslation\": \"Tôi không thích mấy vết tích đó cho lắm... không phải tôi sợ hay gì đâu nhé!\", \"rating\": 0.0},\n  {\"id\": 736067, \"suggestedTranslation\": \"Heh... tôi đón lõng được chúng rồi!\", \"rating\": 0.0},\n  {\"id\": 736068, \"suggestedTranslation\": \"Bạn có nghe thấy gì không? Ơ... chắc là do tôi tưởng tượng thôi...\", \"rating\": 0.0},\n  {\"id\": 736069, \"suggestedTranslation\": \"Trông nó có vẻ vui hơn chút rồi.\", \"rating\": 0.0},\n  {\"id\": 736070, \"suggestedTranslation\": \"Tôi mang thế này là kịch kim rồi đấy!!\", \"rating\": 0.0},\n  {\"id\":