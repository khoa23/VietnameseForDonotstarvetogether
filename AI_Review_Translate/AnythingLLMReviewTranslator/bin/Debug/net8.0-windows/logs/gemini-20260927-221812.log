            "text": "[\n  {\"id\":735315,\"suggestedTranslation\":\"Đó quả là một cách tận dụng dưa hấu.\",\"rating\":8.5},\n  {\"id\":735316,\"suggestedTranslation\":\"Quả dưa hoàn toàn bị kẹt trong lớp băng giá.\",\"rating\":8.5},\n  {\"id\":735317,\"suggestedTranslation\":\"Nướng rất đẹp mắt.\",\"rating\":8.5},\n  {\"id\":735318,\"suggestedTranslation\":\"Kết quả của việc nghiên cứu, lập kế hoạch và chăm sóc cẩn thận.\",\"rating\":8.5},\n  {\"id\":735319,\"suggestedTranslation\":\"Nó không thể mọc lên nếu chưa được trồng đâu, thân yêu ạ.\",\"rating\":8.5},\n  {\"id\":735320,\"suggestedTranslation\":\"Tôi không quen thuộc với loại thực vật biển này.\",\"rating\":8.5},\n  {\"id\":735321,\"suggestedTranslation\":\"Cái này chắc là một con non.\",\"rating\":8.5},\n  {\"id\":735322,\"suggestedTranslation\":\"Tốt nhất là chúng ta nên tránh xa những thứ đó.\",\"rating\":8.5},\n  {\"id\":735323,\"suggestedTranslation\":\"Có lẽ tôi sẽ quay lại việc làm vườn.\",\"rating\":8.5},\n  {\"id\":735324,\"suggestedTranslation\":\"Đó chỉ là lẽ thường tình.\",\"rating\":8.5},\n  {\"id\":735325,\"suggestedTranslation\":\"Tôi tự hỏi điều gì đã giúp nó phát triển vượt bậc như vậy?\",\"rating\":8.5},\n  {\"id\":735326,\"suggestedTranslation\":\"Tôi đề nghị chúng ta tránh tông vào chúng bằng thuyền ván của mình.\",\"rating\":8.5},\n  {\"id\":735327,\"suggestedTranslation\":\"Cậu không gây rắc rối đấy chứ, %s?\",\"rating\":8.5},\n  {\"id\":735328,\"suggestedTranslation\":\"\\\"Vì ngọn lửa của Hel\\\" chỉ là một cách nói thôi, em yêu.\",\"rating\":8.5},\n  {\"id\":735329,\"suggestedTranslation\":\"Ồ, chào mừng %s thân mến!\",\"rating\":8.5},\n  {\"id\":735330,\"suggestedTranslation\":\"%s, tôi đã bảo cậu không được cầm giáo chạy nhảy cơ mà. Chậc.\",\"rating\":8.5},\n  {\"id\":735331,\"suggestedTranslation\":\"Câu chuyện của cậu kết thúc ở đây thôi, %s!\",\"rating\":8.5},\n  {\"id\":735332,\"suggestedTranslation\":\"Tôi đánh giá cao sự tận tụy của cậu với sự sống còn của nhóm, %s.\",\"rating\":8.5},\n  {\"id\":735333,\"suggestedTranslation\":\"Những lời nhảm nhí sai lệch thời gian.\",\"rating\":8.5},\n  {\"id\":735334,\"suggestedTranslation\":\"Tôi e là nó còn xa rời tính chính xác lịch sử hơn nữa.\",\"rating\":8.5},\n  {\"id\":735335,\"suggestedTranslation\":\"Tôi rất vui khi thấy cô ấy khám phá thêm các chiến thuật phòng thủ.\",\"rating\":8.5},\n  {\"id\":735336,\"suggestedTranslation\":\"Được bảo quản một cách hoàn hảo.\",\"rating\":8.5},\n  {\"id\":735337,\"suggestedTranslation\":\"Giờ chúng ta chỉ cần dây thừng để cố định nó lại.\",\"rating\":8.5},\n  {\"id\":735338,\"suggestedTranslation\":\"Lại giở trò cũ ra đấy à, %s?\",\"rating\":8.5},\n  {\"id\":735339,\"suggestedTranslation\":\"Bây giờ lại châm lửa à, %s? Cẩn thận đấy nhé.\",\"rating\":8.5},\n  {\"id\":735340,\"suggestedTranslation\":\"Ồ, chào mừng %s thân mến!\",\"rating\":8.5},\n  {\"id\":735341,\"suggestedTranslation\":\"Đau lắm phải không em? Để tôi mang cho em một trái tim.\",\"rating\":8.5},\n  {\"id\":735342,\"suggestedTranslation\":\"Lừa tôi một lần thì thật đáng trách ở bạn. Lừa tôi hai lần... bạn chết chắc!\",\"rating\":8.5},\n  {\"id\":735343,\"suggestedTranslation\":\"Vẫn có phần tốt đẹp trong con người cậu, %s.\",\"rating\":8.5},\n  {\"id\":735344,\"suggestedTranslation\":\"Tôi không đời nào để ĐÓ bước vào thư viện CỦA TÔI đâu!\",\"rating\":8.5},\n  {\"id\":735345,\"suggestedTranslation\":\"Thế là đủ trò đùa giỡn rồi đấy, nhện con ạ.\",\"rating\":8.5},\n  {\"id\":735346,\"suggestedTranslation\":\"Ai đã đưa diêm cho cậu vậy, %s?\",\"rating\":8.5},\n  {\"id\":735347,\"suggestedTranslation\":\"Ồ, chào mừng %s thân mến!\",\"rating\":8.5},\n  {\"id\":735348,\"suggestedTranslation\":\"Tôi sẽ mang cho cậu một miếng băng cá nhân màu sắc xinh xắn khi cậu được hồi sinh.\",\"rating\":8.5},\n  {\"id\":735349,\"suggestedTranslation\":\"Ai đó cần phải dạy lại phép lịch sự cho cậu đấy, %s!\",\"rating\":8.5},\n  {\"id\":735350,\"suggestedTranslation\":\"Cậu là một cậu bé ngọt ngào, %s.\",\"rating\":8.5},\n  {\"id\":735351,\"suggestedTranslation\":\"Đó là một chiếc hộp sọ vô cùng bất thường.\",\"rating\":8.5},\n  {\"id\":735352,\"suggestedTranslation\":\"Đúng là một con nhện nhỏ đáng yêu làm sao!\",\"rating\":8.5},\n  {\"id\":735353,\"suggestedTranslation\":\"Lại một loài cỏ dại phá hoại khu vườn.\",\"rating\":8.5},\n  {\"id\":735354,\"suggestedTranslation\":\"%s! Thế là quá đủ rồi đấy, cô bé!\",\"rating\":8.5},\n  {\"id\":735355,\"suggestedTranslation\":\"Ai đã đưa vật liệu dễ cháy cho cháu vậy, %s?\",\"rating\":8.5},\n  {\"id\":735356,\"suggestedTranslation\":\"Ồ, chào mừng %s thân mến!\",\"rating\":8.5},\n  {\"id\":735357,\"suggestedTranslation\":\"Trời ạ, thế này thì không ổn chút nào. Để tôi tìm cho cháu một trái tim nhé, %s.\",\"rating\":8.5},\n  {\"id\":735358,\"suggestedTranslation\":\"Ai đó cần phải dạy lại phép lịch sự cho cậu đấy, %s!\",\"rating\":8.5},\n  {\"id\":735359,\"suggestedTranslation\":\"Cháu thật đáng yêu, %s. Và lại có kỹ năng đặc biệt để xử lý các hồn ma nữa chứ!\",\"rating\":8.5},\n  {\"id\":735360,\"suggestedTranslation\":\"Cái chết không phải là điểm dừng.\",\"rating\":8.5},\n  {\"id\":735361,\"suggestedTranslation\":\"Có vẻ như nó gây ra trạng thái biến hình thành hải ly.\",\"rating\":8.5},\n  {\"id\":735362,\"suggestedTranslation\":\"Một... tác phẩm nghệ thuật miêu tả loài ngỗng Canada.\",\"rating\":8.5},\n  {\"id\":735363,\"suggestedTranslation\":\"Sẽ có người vấp phải cái này mất thôi, em yêu.\",\"rating\":8.5},\n  {\"id\":735364,\"suggestedTranslation\":\"Ngôn ngữ cơ thể của anh ta nói lên tất cả.\",\"rating\":8.5},\n  {\"id\":735365,\"suggestedTranslation\":\"Đừng có khóc lóc với tôi khi cậu tự làm mình bỏng nhé, anh bạn.\",\"rating\":8.5},\n  {\"id\":735366,\"suggestedTranslation\":\"À, anh chàng kịch câm. Chào mừng, %s thân mến!\",\"rating\":8.5},\n  {\"id\":735367,\"suggestedTranslation\":\"Tội nghiệp ghê. %s cần một dây neo trái tim để níu giữ anh ấy lại cõi trần này.\",\"rating\":8.5},\n  {\"id\":735368,\"suggestedTranslation\":\"Họ sẽ kể lại những giai thoại về thất bại của cậu cho mà xem, %s!\",\"rating\":8.5},\n  {\"id\":735369,\"suggestedTranslation\":\"Cậu là một thanh niên ưu tú, %s.\",\"rating\":8.5},\n  {\"id\":735370,\"suggestedTranslation\":\"Ồ không. Không, không, không. Thế này thì hỏng hẳn rồi.\",\"rating\":8.5},\n  {\"id\":735371,\"suggestedTranslation\":\"Cái này có lẽ sẽ hữu ích đấy.\",\"rating\":8.5},\n  {\"id\":735372,\"suggestedTranslation\":\"Biết đâu có thứ gì hữu ích ở bên trong nhỉ?\",\"rating\":8.5},\n  {\"id\":735373,\"suggestedTranslation\":\"Một công cụ để rèn luyện sự phục tùng thông qua nỗi đau.\",\"rating\":8.5},\n  {\"id\":735374,\"suggestedTranslation\":\"Sự vô đạo đức của %s đang tạo ra những lỗ hổng trong các phỏng đoán đa vũ trụ của tôi.\",\"rating\":8.5},\n  {\"id\":735375,\"suggestedTranslation\":\"Việc đốt sách thật là bất lịch sự làm sao, %s.\",\"rating\":8.5},\n  {\"id\":735376,\"suggestedTranslation\":\"Ồ, chào %s! Thật bất ngờ khi gặp cậu ở đây.\",\"rating\":8.5},\n  {\"id\":735377,\"suggestedTranslation\":\"Cuối cùng thì tất cả sách tự trợ giúp của chúng ta cũng được mang ra dùng rồi nhỉ, %s?\",\"rating\":8.5},\n  {\"id\":735378,\"suggestedTranslation\":\"Tôi chính là nhà phê bình khắt khe nhất của chính mình!\",\"rating\":8.5},\n  {\"id\":735379,\"suggestedTranslation\":\"Kiến thức của chúng ta rất hữu dụng phải không, %s?\",\"rating\":8.5},\n  {\"id\":735380,\"suggestedTranslation\":\"Cậu rất thích thử thách giới hạn phải không, em yêu?\",\"rating\":8.5},\n  {\"id\":735381,\"suggestedTranslation\":\"Tôi đã dặn thế nào về việc châm lửa rồi nhỉ, em yêu?\",\"rating\":8.5},\n  {\"id\":735382,\"suggestedTranslation\":\"Ồ, chào mừng %s thân mến!\",\"rating\":8.5},\n  {\"id\":735383,\"suggestedTranslation\":\"Nếu em cứ liếc mắt kiểu ma quỷ đó thì nó sẽ dính luôn thế đấy, em yêu.\",\"rating\":8.5},\n  {\"id\":735384,\"suggestedTranslation\":\"Cậu BẮT BUỘC phải tôn trọng người lớn tuổi đấy, %s!\",\"rating\":8.5},\n  {\"id\":735385,\"suggestedTranslation\":\"Em đang làm rất tốt đấy, %s.\",\"rating\":8.5},\n  {\"id\":735386,\"suggestedTranslation\":\"only_used_by_willow\",\"rating\":10.0},\n  {\"id\":735387,\"suggestedTranslation\":\"Tôi sẽ kéo tai cậu lôi về căn cứ nếu cần đấy, %s.\",\"rating\":8.5},\n  {\"id\":735388,\"suggestedTranslation\":\"%s cần phải được uốn nắn một trận nghiêm khắc mới được.\",\"rating\":8.5},\n  {\"id\":735389,\"suggestedTranslation\":\"Chào mừng, %s thân mến! Các định lý của cậu tiến triển đến đâu rồi?\",\"rating\":8.5},\n  {\"id\":735390,\"suggestedTranslation\":\"Tôi đã bảo cậu mặc áo khoác vào cơ mà? Để tôi đi lấy tim...\",\"rating\":8.5},\n  {\"id\":735391,\"suggestedTranslation\":\"Có vẻ như chúng ta đã bước vào một cuộc đấu trí rồi đấy, %s!\",\"rating\":8.5},\n  {\"id\":735392,\"suggestedTranslation\":\"Hóa ra nhà khoa học các cậu cũng biết đôi chút đấy chứ!\",\"rating\":8.5},\n  {\"id\":735393,\"suggestedTranslation\":\"Loài người đã sử dụng tời kéo trong hàng trăm năm qua.\",\"rating\":8.5},\n  {\"id\":735394,\"suggestedTranslation\":\"Tôi tóm được gì đó rồi!\",\"rating\":8.5},\n  {\"id\":735395,\"suggestedTranslation\":\"Thực hành và sự chính xác sẽ tạo nên sự hoàn hảo!\",\"rating\":8.5},\n  {\"id\":735396,\"suggestedTranslation\":\"Hơi thô lỗ một chút phải không, %s?\",\"rating\":8.5},\n  {\"id\":735397,\"suggestedTranslation\":\"Đó không phải là ngọn lửa theo đúng quy chuẩn đâu, em yêu.\",\"rating\":8.5},\n  {\"id\":735398,\"suggestedTranslation\":\"Ồ, chào mừng %s thân mến!\",\"rating\":8.5},\n  {\"id\":735399,\"suggestedTranslation\":\"Chậc. Em có đội mũ bảo hộ không đấy, em yêu?\",\"rating\":8.5},\n  {\"id\":735300,\"suggestedTranslation\":\"Tôi sẽ không dung thứ cho sự tàn nhẫn đâu!\",\"rating\":8.5},\n  {\"id\":735401,\"suggestedTranslation\":\"%s quả là một người tháo vát cái gì cũng biết làm.\",\"rating\":8.5},\n  {\"id\":735402,\"suggestedTranslation\":\"Trời ạ, ai đã làm thế này cơ chứ?\",\"rating\":8.5},\n  {\"id\":735403,\"suggestedTranslation\":\"Tôi rất hy