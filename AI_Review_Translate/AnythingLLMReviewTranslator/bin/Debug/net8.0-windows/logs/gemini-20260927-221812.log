            "text": "[\n  {\"id\":736215,\"suggestedTranslation\":\"Ái! Đau đấy, đồ khốn!\",\"rating\":9.0},\n  {\"id\":736216,\"suggestedTranslation\":\"Gi hả? Cảm ơn nhé mọi người!\",\"rating\":9.0},\n  {\"id\":736217,\"suggestedTranslation\":\"Không hoạt động á? Thế thì thôi, châm lửa đốt luôn đi.\",\"rating\":9.0},\n  {\"id\":736218,\"suggestedTranslation\":\"Tuyệt, giờ thì ướt như chuột lột rồi.\",\"rating\":9.0},\n  {\"id\":736219,\"suggestedTranslation\":\"Trông con đó có vẻ tả tơi nhỉ.\",\"rating\":9.0},\n  {\"id\":736220,\"suggestedTranslation\":\"Vô tích sự! Ta cần thứ gì mạnh hơn!\",\"rating\":9.0},\n  {\"id\":736221,\"suggestedTranslation\":\"Trọng lượng: {weight}\",\"rating\":9.5},\n  {\"id\":736222,\"suggestedTranslation\":\"Trọng lượng: {weight}\\nỐi giời, nặng thế nhỉ!\",\"rating\":9.0},\n  {\"id\":736223,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":10.0},\n  {\"id\":736224,\"suggestedTranslation\":\"only_used_by_wendy\",\"rating\":10.0},\n  {\"id\":736225,\"suggestedTranslation\":\"Cái này không ổn rồi đây!\",\"rating\":9.0},\n  {\"id\":736226,\"suggestedTranslation\":\"Tao ghét lắm đấy!\",\"rating\":9.0},\n  {\"id\":736227,\"suggestedTranslation\":\"Ôi trời! Suýt nữa thì tóm được rồi!\",\"rating\":9.0},\n  {\"id\":736228,\"suggestedTranslation\":\"Có vẻ ta vừa vớt được một bãi rỗng tuếch.\",\"rating\":9.0},\n  {\"id\":736229,\"suggestedTranslation\":\"Cảm giác như có những đốm lửa nhỏ đang bay quanh mình vậy!\",\"rating\":9.0},\n  {\"id\":736230,\"suggestedTranslation\":\"Ôi trời. Chắc đến lúc phải tạo ra vài tia lửa thật sự rồi!\",\"rating\":9.0},\n  {\"id\":736231,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":736232,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":736233,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":736234,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":736235,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":736236,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":736237,\"suggestedTranslation\":\"only_used_by_wolfgang\",\"rating\":10.0},\n  {\"id\":736238,\"suggestedTranslation\":\"Tôi phải đốt sạch đống quần áo này mới được!\",\"rating\":9.0},\n  {\"id\":736239,\"suggestedTranslation\":\"Tao KHÔNG muốn thấy thứ vừa phát ra tiếng đó đâu!\",\"rating\":9.0},\n  {\"id\":736240,\"suggestedTranslation\":\"Đừng có ở lại hóng cái đó nữa.\",\"rating\":9.0},\n  {\"id\":736241,\"suggestedTranslation\":\"Thất bại!\",\"rating\":9.0},\n  {\"id\":736242,\"suggestedTranslation\":\"only_used_by_wx78\",\"rating\":10.0},\n  {\"id\":736243,\"suggestedTranslation\":\"Tôi nghĩ giờ mình có thể làm một bộ trang phục Bò Lai mới rồi.\",\"rating\":9.0},\n  {\"id\":736244,\"suggestedTranslation\":\"Mọi người dồn lại gần tháp khởi đầu đi để chúng ta giải quyết nhanh nào!\",\"rating\":9.0},\n  {\"id\":736245,\"suggestedTranslation\":\"Hừm, tao quên đặt mấy cái trạm kiểm soát ngốc nghếch đó rồi!\",\"rating\":9.0},\n  {\"id\":736246,\"suggestedTranslation\":\"Chắc tôi nên chừa ra chút chỗ, nhỡ có ai khác tham gia.\",\"rating\":9.0},\n  {\"id\":736247,\"suggestedTranslation\":\"Xì. Mấy con ngựa đó chắc đang bận rộn làm việc của loài ngựa.\",\"rating\":9.0},\n  {\"id\":736248,\"suggestedTranslation\":\"Chim tấn công!\",\"rating\":9.0},\n  {\"id\":736249,\"suggestedTranslation\":\"Mày biến thành thịt hươu rồi đấy!\",\"rating\":9.0},\n  {\"id\":736250,\"suggestedTranslation\":\"Mày sống tao chết!\",\"rating\":9.0},\n  {\"id\":736251,\"suggestedTranslation\":\"Con lợn đần!\",\"rating\":9.0},\n  {\"id\":736252,\"suggestedTranslation\":\"Lại đây mau!\",\"rating\":9.0},\n  {\"id\":736253,\"suggestedTranslation\":\"Grrrrar!\",\"rating\":9.0},\n  {\"id\":736254,\"suggestedTranslation\":\"Eo ôi, giết nó đi!\",\"rating\":9.0},\n  {\"id\":736255,\"suggestedTranslation\":\"Biết điều thì tốt!\",\"rating\":9.0},\n  {\"id\":736256,\"suggestedTranslation\":\"Quay lại đây, miếng sườn heo!\",\"rating\":9.0},\n  {\"id\":736257,\"suggestedTranslation\":\"Lần sau tao tính sổ mày!\",\"rating\":9.0},\n  {\"id\":736258,\"suggestedTranslation\":\"Xì. Để lát nữa tao giết nó sau.\",\"rating\":9.0},\n  {\"id\":736259,\"suggestedTranslation\":\"Giờ thì đâu còn cứng đầu nữa nhỉ!\",\"rating\":9.0},\n  {\"id\":736260,\"suggestedTranslation\":\"Này, chuyện gì đã xảy ra với cậu vậy?\",\"rating\":9.0},\n  {\"id\":736261,\"suggestedTranslation\":\"Này, chuyện gì đã xảy ra với cậu vậy?\",\"rating\":9.0},\n  {\"id\":736262,\"suggestedTranslation\":\"Này, chuyện gì đã xảy ra với cậu vậy?\",\"rating\":9.0},\n  {\"id\":736263,\"suggestedTranslation\":\"Này, chuyện gì đã xảy ra với cậu vậy?\",\"rating\":9.0},\n  {\"id\":736264,\"suggestedTranslation\":\"Này, chuyện gì đã xảy ra với cậu vậy?\",\"rating\":9.0},\n  {\"id\":736265,\"suggestedTranslation\":\"Này, chuyện gì đã xảy ra với cậu vậy?\",\"rating\":9.0},\n  {\"id\":736266,\"suggestedTranslation\":\"Trông dễ bắt lửa phết.\",\"rating\":9.0},\n  {\"id\":736267,\"suggestedTranslation\":\"Tôi không muốn dây dưa với thứ đó đâu.\",\"rating\":9.0},\n  {\"id\":736268,\"suggestedTranslation\":\"Nó đang khoét một hố trong túi tôi kìa. Heh.\",\"rating\":9.0},\n  {\"id\":736269,\"suggestedTranslation\":\"Eo ôi, dị hợm quá!\",\"rating\":9.0},\n  {\"id\":736270,\"suggestedTranslation\":\"Đốt quách nó đi cũng là một lựa chọn.\",\"rating\":9.0},\n  {\"id\":736271,\"suggestedTranslation\":\"Ừ thì được, giờ nó bay lơ lửng rồi đấy, muốn sao nữa.\",\"rating\":9.0},\n  {\"id\":736272,\"suggestedTranslation\":\"Trông dễ bắt lửa phết.\",\"rating\":9.0},\n  {\"id\":736273,\"suggestedTranslation\":\"Eo ôi, dị hợm quá!\",\"rating\":9.0},\n  {\"id\":736274,\"suggestedTranslation\":\"Đốt quách nó đi cũng là một lựa chọn.\",\"rating\":9.0},\n  {\"id\":736275,\"suggestedTranslation\":\"Đồ bắt chước!\",\"rating\":9.0},\n  {\"id\":736276,\"suggestedTranslation\":\"Đúng là kẻ ám ảnh với côn trùng.\",\"rating\":9.0},\n  {\"id\":736277,\"suggestedTranslation\":\"Kéo nó lên đi cho rồi!\",\"rating\":9.0},\n  {\"id\":736278,\"suggestedTranslation\":\"Tôi ghét cái mũi tên đó!\",\"rating\":9.0},\n  {\"id\":736279,\"suggestedTranslation\":\"Chào nhé, hạt mầm cây ơi.\",\"rating\":9.0},\n  {\"id\":736280,\"suggestedTranslation\":\"Xem ra mày không thể mọc thành cây được nữa rồi.\",\"rating\":9.0},\n  {\"id\":736281,\"suggestedTranslation\":\"Cậu sẽ sớm thành một cái cây thật sự thôi.\",\"rating\":9.0},\n  {\"id\":736282,\"suggestedTranslation\":\"Biết đâu cái đó dẫn về nhà.\",\"rating\":9.0},\n  {\"id\":736283,\"suggestedTranslation\":\"Nó làm đầu tôi kêu inh ỏi cả lên...\",\"rating\":9.0},\n  {\"id\":736284,\"suggestedTranslation\":\"Bất ngờ thật, bẻ đôi cái thứ đó khó phết.\",\"rating\":9.0},\n  {\"id\":736285,\"suggestedTranslation\":\"Cái máy quái quỷ gì thế kia?\",\"rating\":9.0},\n  {\"id\":736286,\"suggestedTranslation\":\"Heh. Nhận lấy này mặt trăng, hay bất cứ thứ gì!\",\"rating\":9.0},\n  {\"id\":736287,\"suggestedTranslation\":\"Hừ, tao BIẾT ngay là chúng ta không nên dây dưa với đống khoa học nhảm nhí này mà.\",\"rating\":9.0},\n  {\"id\":736288,\"suggestedTranslation\":\"Nó đang đỏ rực và nóng bỏng!\",\"rating\":9.0},\n  {\"id\":736289,\"suggestedTranslation\":\"Tôi cá là cái đó đấy.\",\"rating\":9.0},\n  {\"id\":736290,\"suggestedTranslation\":\"Lần này thì tóm gọn mày nhé.\",\"rating\":9.0},\n  {\"id\":736291,\"suggestedTranslation\":\"Mày nghĩ mày cứng lắm hả?! Cháy đi!\",\"rating\":9.0},\n  {\"id\":736292,\"suggestedTranslation\":\"Tránh đường cho tao nhờ mấy thứ này cái!\",\"rating\":9.0},\n  {\"id\":736293,\"suggestedTranslation\":\"Trông cũng đẹp đấy, nhưng khi nó cháy lên thì còn đẹp hơn nữa!\",\"rating\":9.0},\n  {\"id\":736294,\"suggestedTranslation\":\"Chắc là cuối cùng cũng xong rồi.\",\"rating\":9.0},\n  {\"id\":736295,\"suggestedTranslation\":\"Ơ này, lão già kia? Lão có lẽ không muốn đến gần thế đâu...\",\"rating\":9.0},\n  {\"id\":736296,\"suggestedTranslation\":\"Này, thế thì chơi xấu quá đấy!\",\"rating\":9.0},\n  {\"id\":736297,\"suggestedTranslation\":\"Giờ phải làm sao đây? Chẳng có gì để đốt cả!\",\"rating\":9.0},\n  {\"id\":736298,\"suggestedTranslation\":\"Tôi chịu chết không biết nó làm gì, nhưng đeo vào thấy thích phết!\",\"rating\":9.0},\n  {\"id\":736299,\"suggestedTranslation\":\"Thả neo xuống vui hơn kéo nó lên nhiều.\",\"rating\":9.0},\n  {\"id\":736300,\"suggestedTranslation\":\"Ô ô, chế một cái dây neo nào.\",\"rating\":9.0},\n  {\"id\":736301,\"suggestedTranslation\":\"Đẹp quá, ném nó vào lửa thôi!\",\"rating\":9.0},\n  {\"id\":736302,\"suggestedTranslation\":\"Eo ôi, quả mọng đó... đang ngọ nguậy kìa?\",\"rating\":9.0},\n  {\"id\":736303,\"suggestedTranslation\":\"Nó đứng im rồi. Cảm ơn lửa nhé!\",\"rating\":9.0},\n  {\"id\":736304,\"suggestedTranslation\":\"Nó... nó đẹp quá...\",\"rating\":9.0},\n  {\"id\":736305,\"suggestedTranslation\":\"Khônnnnnnggggg!!\",\"rating\":9.0},\n  {\"id\":736306,\"suggestedTranslation\":\"Cái cây gì mà xấu thế.\",\"rating\":9.0},\n  {\"id\":736307,\"suggestedTranslation\":\"Nó để lại cái gốc cũng xấu nốt.\",\"rating\":9.0},\n  {\"id\":736308,\"suggestedTranslation\":\"Sắp thành cây rồi đấy.\",\"rating\":9.0},\n  {\"id\":736309,\"suggestedTranslation\":\"Sao thế nhỉ? Ngoài trời lạnh quá à? Hay nóng quá?\",\"rating\":9.0},\n  {\"id\":736310,\"suggestedTranslation\":\"Tôi không nghĩ nó thích loại đất này đâu.\",\"rating\":9.0},\n  {\"id\":736311,\"suggestedTranslation\":\"Chắc mày đang thèm đất lắm đúng không, hả?\",\"rating\":9.0},\n  {\"id\":736312,\"suggestedTranslation\":\"Hừm. Hạt giống trông dị thật.\",\"rating\":9.0},\n  {\"id\":736313,\"suggestedTranslation\":\"Ô kìa! Một cái điện đàm liên lạc thế giới bên kia.\",\"rating\":9.0},\n  {\"id\":736314,\"suggestedTranslation\":\"Người chết không qua đây được đâu.\",\"rating\":9.0},\n  {\"id\":736315,\"suggestedTranslation\":\"Ồ vâng. Nhìn phát là tôi biết ngay trò đâm sau lưng rồi.\",\"rating\":9.0},\n  {\"id\":736316,\"suggestedTranslation\":\"Xí, chả thèm cháy cho.\",\"rating\":9.0},\n  {\"id\":736317,\"suggestedTranslation\":\"Nó dẫn đến người bạn mới của tôi kìa.\",\"rating\":9.0},\n  {\"id\":736318,\"suggestedTranslation\":\"Vị mặn chát với tởm lợm thế nào ấy.\",\"rating\":9.0},\n  {\"id\":736319,\"suggestedTranslation\":\"Mày muốn gì hả?!\",\"rating\":9.0},\n  {\"id\":736320,\"suggestedTranslation\":\"Sắp có động đất xảy ra rồi đây.\",\"rating\":9.0},\n  {\"id\":736321,\"suggestedTranslation\":\"Tâm trạng cậu đang tốt nhỉ.\",\"rating\":9.0},\n  {\"id\":736322,\"suggestedTranslation\":\"Phì, cái mũ trông ngốc nghếch thật. Mà tôi thích đấy.\",\"rating\":9.0},\n  {\"id\":736323,\"suggestedTranslation\":\"Toàn một đống rác.\",\"rating\":9.0},\n  {\"id\":736324,\"suggestedTranslation\":\"Cháy đi, đồ côn trùng!\",\"rating\":9.0},\n  {\"id\":736325,\"suggestedTranslation\":\"Chỉ là một đống linh kiện hỏng.\",\"rating\":9.0},\n  {\"id\":736326,\"suggestedTranslation\":\"Ít ra nó cũng ra đi trong vinh quang.\",\"rating\":9.0},\n  {\"id\":736327,\"suggestedTranslation\":\"Ngọn lửa vẫn còn phải làm việc vất vả đấy.\",\"rating\":9.0},\n  {\"id\":736328,\"suggestedTranslation\":\"Lửa đang làm rất tốt việc của nó!\",\"rating\":9.0},\n  {\"id\":736329,\"suggestedTranslation\":\"Lửa làm cho mọi thứ trở nên tuyệt hơn. Ngon!\",\"rating\":9.0},\n  {\"id\":736330,\"suggestedTranslation\":\"Lửa là phát minh cổ đại tuyệt vời nhất từ trước đến nay!\",\"rating\":9.0},\n  {\"id\":736331,\"suggestedTranslation\":\"Tuyệt. Chúng ta bật thứ bí ẩn lên và lại nhận được một thứ bí ẩn khác.\",\"rating\":9.0},\n  {\"id\":736332,\"suggestedTranslation\":\"Hừ, tôi thấy sắp có câu đố xuất hiện rồi đấy...\",\"rating\":9.0},\n  {\"id\":736333,\"suggestedTranslation\":\"Trông có vẻ hỏng rồi.\",\"rating\":9.0},\n  {\"id\":736334,\"suggestedTranslation\":\"Hừm. Mấy cái này trông khác với mấy bức tượng dưới đây nhỉ.\",\"rating\":9.0},\n  {\"id\":736335,\"suggestedTranslation\":\"Không cháy á? Thôi, hết cách rồi đấy.\",\"rating\":9.0},\n  {\"id\":736336,\"suggestedTranslation\":\"Lẽ ra phải biết mọi chuyện không dễ ăn thế rồi.\",\"rating\":9.0},\n  {\"id\":736337,\"suggestedTranslation\":\"Lại một cánh cổng nữa á? Đừng nói là...?\",\"rating\":9.0},\n  {\"id\":736338,\"suggestedTranslation\":\"Chỉ đường đi nào!\",\"rating\":9.0},\n  {\"id\":736339,\"suggestedTranslation\":\"Chắc chẳng còn gì để tìm nữa rồi.\",\"rating\":9.0},\n  {\"id\":736340,\"suggestedTranslation\":\"Nó đang lẩm bẩm một mình kìa.\",\"rating\":9.0},\n  {\"id\":736341,\"suggestedTranslation\":\"Toàn mấy câu thần chú lảm nhảm cổ rích.\",\"rating\":9.0},\n  {\"id\":736342,\"suggestedTranslation\":\"Không cháy được thì tôi mặc kệ.\",\"rating\":9.0},\n  {\"id\":736343,\"suggestedTranslation\":\"Toàn mấy câu thần chú lảm nhảm cổ rích.\",\"rating\":9.0},\n  {\"id\":736344,\"suggestedTranslation\":\"Không cháy được thì tôi mặc kệ.\",\"rating\":9.0},\n  {\"id\":736345,\"suggestedTranslation\":\"Toàn mấy câu thần chú lảm nhảm cổ rích.\",\"rating\":9.0},\n  {\"id\":736346,\"suggestedTranslation\":\"Ừ, trông đáng ngờ phết đấy.\",\"rating\":9.0},\n  {\"id\":736347,\"suggestedTranslation\":\"Dù nó là gì thì cũng đang hỏng bét rồi.\",\"rating\":9.0},\n  {\"id\":736348,\"suggestedTranslation\":\"Này! Quay lại đây mau!\",\"rating\":9.0},\n  {\"id\":736349,\"suggestedTranslation\":\"Có cái gì đó đang thiếu ở đây.\",\"rating\":9.0},\n  {\"id\":736350,\"suggestedTranslation\":\"Tôi chắc là sẽ chẳng ai phiền nếu tôi mượn một viên ngọc đó đâu.\",\"rating\":9.0},\n  {\"id\":736351,\"suggestedTranslation\":\"Yeah! Thêm LỬA nữa đi nào!!!\",\"rating\":9.0},\n  {\"id\":736352,\"suggestedTranslation\":\"Cũng tạm ổn đấy.\",\"rating\":9.0},\n  {\"id\":736353,\"suggestedTranslation\":\"Phí phạm nguyên liệu dễ cháy thật.\",\"rating\":9.0},\n  {\"id\":736354,\"suggestedTranslation\":\"Đã đi đánh nhau thì tốt nhất nên mặc giáp vào.\",\"rating\":9.0},\n  {\"id\":736355,\"suggestedTranslation\":\"Con người bình thường chắc không nên mặc cái này đâu.\",\"rating\":9.0},\n  {\"id\":736356,\"suggestedTranslation\":\"Mặc cái này vào thì đố ai đánh trúng được tôi!\",\"rating\":9.0},\n  {\"id\":736357,\"suggestedTranslation\":\"Eo ôi, tởm! Tởm! Tởm! Tởm! Ghê qúa đi mất!\",\"rating\":9.0},\n  {\"id\":736358,\"suggestedTranslation\":\"Giảm phòng thủ! Tăng tấn công!\",\"rating\":9.0},\n  {\"id\":736359,\"suggestedTranslation\":\"Trông có vẻ chống lửa khá tốt đấy, nhưng chỉ có một cách để kiểm chứng thôi...\",\"rating\":9.0},\n  {\"id\":736360,\"suggestedTranslation\":\"Giờ thì tôi có thể chinh phục cả thế giới rồi!\",\"rating\":9.0},\n  {\"id\":736361,\"suggestedTranslation\":\"Tôi nghĩ Wormwood làm nó đấy.\",\"rating\":9.0},\n  {\"id\":736362,\"suggestedTranslation\":\"Mấy củ này nướng lên ăn được không ta?\",\"rating\":9.0},\n  {\"id\":736363,\"suggestedTranslation\":\"Tôi mặc lên trông đẹp hẳn ra.\",\"rating\":9.0},\n  {\"id\":736364,\"suggestedTranslation\":\"Chắc chắn là đồ của Wormwood rồi.\",\"rating\":9.0},\n  {\"id\":736365,\"suggestedTranslation\":\"Cảm giác như được quấn trong làn khói vậy.\",\"rating\":9.0},\n  {\"id\":736366,\"suggestedTranslation\":\"Tôi nghĩ mình mặc đồ đỏ trông rất hợp.\",\"rating\":9.0},\n  {\"id\":736367,\"suggestedTranslation\":\"Trông có vẻ chịu được một trận đòn ra trò đấy.\",\"rating\":9.0},\n  {\"id\":736368,\"suggestedTranslation\":\"Nó ghi là \\\"Đừng chơi diêm\\\", nhưng chữ \\\"Đừng\\\" đã bị gạch đi rồi.\",\"rating\":9.0},\n  {\"id\":736369,\"suggestedTranslation\":\"Đọc ít thôi! Đốt nhiều vào!\",\"rating\":9.0},\n  {\"id\":736370,\"suggestedTranslation\":\"Tôi có thể vẽ nguệch ngoạc vài thứ hay ho vào đây.\",\"rating\":9.0},\n  {\"id\":736371,\"suggestedTranslation\":\"Nó ghi là \\\"Đừng chơi diêm\\\", nhưng chữ \\\"Đừng\\\" đã bị gạch đi rồi.\",\"rating\":9.0},\n  {\"id\":736372,\"suggestedTranslation\":\"Đọc ít thôi! Đốt nhiều vào!\",\"rating\":9.0},\n  {\"id\":736373,\"suggestedTranslation\":\"Tôi có thể vẽ nguệch ngoạc vài thứ hay ho vào đây.\",\"rati