            "text": "[\n  {\"id\":737137,\"suggestedTranslation\":\"Vứt đại nó dưới đất thì có ích gì chứ.\",\"rating\":9.0},\n  {\"id\":737138,\"suggestedTranslation\":\"Không phải là hàng rào đẹp nhất trên thế giới, nhưng mà dùng được.\",\"rating\":9.0},\n  {\"id\":737139,\"suggestedTranslation\":\"Ta sắp đi đánh nhau với một cái hàng rào rồi đấy!\",\"rating\":9.0},\n  {\"id\":737140,\"suggestedTranslation\":\"Một cái xô đầy những thứ ghê tởm.\",\"rating\":9.0},\n  {\"id\":737141,\"suggestedTranslation\":\"Trông cứ như có lễ hội vậy!\",\"rating\":9.0},\n  {\"id\":737142,\"suggestedTranslation\":\"Cần thêm pháo hoa nữa thì tôi mới gọi nó là \\\"có lễ hội\\\" được.\",\"rating\":9.0},\n  {\"id\":737143,\"suggestedTranslation\":\"Trông giống hoa quả dành cho người già ấy.\",\"rating\":9.0},\n  {\"id\":737144,\"suggestedTranslation\":\"Tôi sẽ không từ chối một đĩa mì Ý đâu.\",\"rating\":9.0},\n  {\"id\":737145,\"suggestedTranslation\":\"Khi ăn xong đồ ăn, tôi có thể đốt cái que này!\",\"rating\":9.0},\n  {\"id\":737146,\"suggestedTranslation\":\"Như mọi khi, lửa đã làm cho nó ngon hơn.\",\"rating\":9.0},\n  {\"id\":737147,\"suggestedTranslation\":\"Thế giờ tôi chỉ cần vẫy nó lên và LỬA SẼ XUẤT HIỆN á?\",\"rating\":9.0},\n  {\"id\":737148,\"suggestedTranslation\":\"Đốt lên nào!\",\"rating\":9.0},\n  {\"id\":737149,\"suggestedTranslation\":\"Ước gì bọn chúng đừng chạy trốn!\",\"rating\":9.0},\n  {\"id\":737150,\"suggestedTranslation\":\"Chúng trông như những đốm lửa nhỏ trong túi tôi vậy!\",\"rating\":9.0},\n  {\"id\":737151,\"suggestedTranslation\":\"Thực ra tôi lại hơi thích con đó đấy.\",\"rating\":9.0},\n  {\"id\":737152,\"suggestedTranslation\":\"Ý bạn là sao khi bảo nó là cỏ dại? Với tôi thì trông nó cải tiến hơn hẳn đấy chứ!\",\"rating\":9.0},\n  {\"id\":737153,\"suggestedTranslation\":\"Mừm... Khô quá. Dễ bắt lửa quá cơ.\",\"rating\":9.0},\n  {\"id\":737154,\"suggestedTranslation\":\"Này, tôi đang cảm thấy rất có cảm hứng để viết đấy!\",\"rating\":9.0},\n  {\"id\":737155,\"suggestedTranslation\":\"Ối không. Nó sắp tàn rồi!\",\"rating\":9.0},\n  {\"id\":737156,\"suggestedTranslation\":\"Tôi có thể ngồi ngắm nó cả tiếng đồng hồ.\",\"rating\":9.0},\n  {\"id\":737157,\"suggestedTranslation\":\"CHÁY ĐI! CHÁY NHANH LÊN NỮA!\",\"rating\":9.0},\n  {\"id\":737158,\"suggestedTranslation\":\"Ngọn lửa này nhỏ và nhàm chán quá.\",\"rating\":9.0},\n  {\"id\":737159,\"suggestedTranslation\":\"Cháy đi!\",\"rating\":9.0},\n  {\"id\":737160,\"suggestedTranslation\":\"Làm cho lửa quay trở lại đi!\",\"rating\":9.0},\n  {\"id\":737161,\"suggestedTranslation\":\"Đó chính là món đồ chơi tuyệt vời nhất của tôi.\",\"rating\":9.0},\n  {\"id\":737162,\"suggestedTranslation\":\"Sắp hết rồi.\",\"rating\":9.0},\n  {\"id\":737163,\"suggestedTranslation\":\"Và đừng có mở lên nữa đấy!\",\"rating\":9.0},\n  {\"id\":737164,\"suggestedTranslation\":\"Ước gì cái nắp của cậu chịu khép lại và đừng có dập lửa nữa.\",\"rating\":9.0},\n  {\"id\":737165,\"suggestedTranslation\":\"Con cá trơn tuột!\",\"rating\":9.0},\n  {\"id\":737166,\"suggestedTranslation\":\"Tôi thích ném mấy thứ này để bắt mấy thứ khác!\",\"rating\":9.0},\n  {\"id\":737167,\"suggestedTranslation\":\"Câu câu trả lời với cần câu, dây và chì.\",\"rating\":9.0},\n  {\"id\":737168,\"suggestedTranslation\":\"Cần lửa!\",\"rating\":9.0},\n  {\"id\":737169,\"suggestedTranslation\":\"Bớt trơn hơn một chút rồi vì nó tìm được lửa đấy.\",\"rating\":9.0},\n  {\"id\":737170,\"suggestedTranslation\":\"Mùi cá lắm, thật sự rất tanh mùi cá.\",\"rating\":9.0},\n  {\"id\":737171,\"suggestedTranslation\":\"Tôi thích sushi, nhưng tôi thích món nào nướng lửa trực tiếp hơn.\",\"rating\":9.0},\n  {\"id\":737172,\"suggestedTranslation\":\"Cá và lửa rất hợp nhau khi đi câu cá.\",\"rating\":9.0},\n  {\"id\":737173,\"suggestedTranslation\":\"Mùi cá lắm, thật sự rất tanh mùi cá.\",\"rating\":9.0},\n  {\"id\":737174,\"suggestedTranslation\":\"Thấy gì thì được nấy. Những thanh cá câu.\",\"rating\":9.0},\n  {\"id\":737175,\"suggestedTranslation\":\"Cầm nắm bánh taco thật tiện lợi.\",\"rating\":9.0},\n  {\"id\":737176,\"suggestedTranslation\":\"Bộ chúng ta vừa... tạo một cái hố trên thuyền ván à?\",\"rating\":9.0},\n  {\"id\":737177,\"suggestedTranslation\":\"Bớt trơn hơn một chút rồi vì nó tìm được lửa đấy.\",\"rating\":9.0},\n  {\"id\":737178,\"suggestedTranslation\":\"Đồ mồi lửa của kẻ nghèo.\",\"rating\":9.0},\n  {\"id\":737179,\"suggestedTranslation\":\"Hàizz.\",\"rating\":9.0},\n  {\"id\":737180,\"suggestedTranslation\":\"Lửa chính là ma thuật!\",\"rating\":9.0},\n  {\"id\":737181,\"suggestedTranslation\":\"Tôi rất ghét phải chia sẻ cái này đấy.\",\"rating\":9.0},\n  {\"id\":737182,\"suggestedTranslation\":\"Ồ tuyệt, tôi ghét chết đuối lắm.\",\"rating\":9.0},\n  {\"id\":737183,\"suggestedTranslation\":\"Tôi không có thời gian để lãng phí vào mấy bông hoa đâu.\",\"rating\":9.0},\n  {\"id\":737184,\"suggestedTranslation\":\"Cụ thể là tôi muốn đốt bông hoa này cơ.\",\"rating\":9.0},\n  {\"id\":737185,\"suggestedTranslation\":\"Một vòng hoa hào quang. Tiếc là nó không phải là vòng hoa hào quang đang cháy.\",\"rating\":9.0},\n  {\"id\":737186,\"suggestedTranslation\":\"Tôi thà ăn một cái bát đầy ngọn lửa còn hơn.\",\"rating\":9.0},\n  {\"id\":737187,\"suggestedTranslation\":\"Bên trong nó đang cháy kìa.\",\"rating\":9.0},\n  {\"id\":737188,\"suggestedTranslation\":\"Ngọn lửa bên trong nó đang tắt dần.\",\"rating\":9.0},\n  {\"id\":737189,\"suggestedTranslation\":\"Hừ, thứ đó ngửi khủng khiếp thật.\",\"rating\":9.0},\n  {\"id\":737190,\"suggestedTranslation\":\"Trông có vẻ là củi mồi tốt đấy.\",\"rating\":9.0},\n  {\"id\":737191,\"suggestedTranslation\":\"Nhiên liệu cho lửa đây.\",\"rating\":9.0},\n  {\"id\":737192,\"suggestedTranslation\":\"Mừm... Khô quá. Dễ bắt lửa quá cơ.\",\"rating\":9.0},\n  {\"id\":737193,\"suggestedTranslation\":\"Thể thao khó thật đấy.\",\"rating\":9.0},\n  {\"id\":737194,\"suggestedTranslation\":\"Lại mấy bông hoa ngốc nghếch nữa.\",\"rating\":9.0},\n  {\"id\":737195,\"suggestedTranslation\":\"Mừm... Khô quá. Dễ bắt lửa quá cơ.\",\"rating\":9.0},\n  {\"id\":737196,\"suggestedTranslation\":\"Hừm, trông nó có vẻ ngột ngạt và nghiêm túc quá nhỉ.\",\"rating\":9.0},\n  {\"id\":737197,\"suggestedTranslation\":\"Đó chỉ là mấy mảnh xương cũ ghê tởm thôi!\",\"rating\":9.0},\n  {\"id\":737198,\"suggestedTranslation\":\"Trông cũng tạm ổn đấy chứ.\",\"rating\":9.0},\n  {\"id\":737199,\"suggestedTranslation\":\"Trông nực cười không chịu nổi.\",\"rating\":9.0},\n  {\"id\":737200,\"suggestedTranslation\":\"Cần thêm mấy mảnh cũ kỹ gớm ghiếc nữa.\",\"rating\":9.0},\n  {\"id\":737201,\"suggestedTranslation\":\"Ô là la.\",\"rating\":9.0},\n  {\"id\":737202,\"suggestedTranslation\":\"Này, con này thực sự đang giúp ích đấy chứ!\",\"rating\":9.0},\n  {\"id\":737203,\"suggestedTranslation\":\"Cho nó biết tay rồi đấy!\",\"rating\":9.0},\n  {\"id\":737204,\"suggestedTranslation\":\"Nó ẩm quá nên không đốt được.\",\"rating\":9.0},\n  {\"id\":737205,\"suggestedTranslation\":\"Chúng trông rất đáng yêu lúc ngủ.\",\"rating\":9.0},\n  {\"id\":737206,\"suggestedTranslation\":\"Ồ hóa ra, cả đống ếch luôn kìa.\",\"rating\":9.0},\n  {\"id\":737207,\"suggestedTranslation\":\"Nếu bạn nhắm mắt lại thì nuốt nó xuống sẽ dễ hơn một chút đấy.\",\"rating\":9.0},\n  {\"id\":737208,\"suggestedTranslation\":\"Nó vẫn giật giật thỉnh thoảng kìa. Hơi nổi da gà đấy.\",\"rating\":9.0},\n  {\"id\":737209,\"suggestedTranslation\":\"Lửa đã làm nó ngừng giật. Lửa là tuyệt nhất.\",\"rating\":9.0},\n  {\"id\":737210,\"suggestedTranslation\":\"Tất cả lượng quả vả đó gần như lấn át luôn vị của ếch rồi.\",\"rating\":9.0},\n  {\"id\":737211,\"suggestedTranslation\":\"Eo, lạnh ngắt à.\",\"rating\":9.0},\n  {\"id\":737212,\"suggestedTranslation\":\"Bọn chúng khá là đáng yêu đấy.\",\"rating\":9.0},\n  {\"id\":737213,\"suggestedTranslation\":\"Mừm... Thanh long nướng.\",\"rating\":9.0},\n  {\"id\":737214,\"suggestedTranslation\":\"Ngủ ngon nhé, nhóc con.\",\"rating\":9.0},\n  {\"id\":737215,\"suggestedTranslation\":\"Biến đi, mấy con bọ ngốc nghếch này!\",\"rating\":9.0},\n  {\"id\":737216,\"suggestedTranslation\":\"Giờ tôi mới là người ra lệnh đấy! Dù chỉ là ra lệnh cho ruồi giấm thôi, nhưng vẫn tính nhé.\",\"rating\":9.0},\n  {\"id\":737217,\"suggestedTranslation\":\"Ngon tuyệt, trái cây kìa!\",\"rating\":9.0},\n  {\"id\":737218,\"suggestedTranslation\":\"Trông nó không ổn lắm đâu...\",\"rating\":9.0},\n  {\"id\":737219,\"suggestedTranslation\":\"Tôi thích các công cụ của mình nóng bỏng tay cơ.\",\"rating\":9.0},\n  {\"id\":737220,\"suggestedTranslation\":\"Ái chà chà, toàn bộ cái sức nóng tuyệt vời đó bay đi đâu hết rồi?\",\"rating\":9.0},\n  {\"id\":737221,\"suggestedTranslation\":\"Tôi sẽ chẳng bao giờ dùng bất kỳ cái rìu nào khác nữa đâu.\",\"rating\":9.0},\n  {\"id\":737222,\"suggestedTranslation\":\"Trông nó không ổn lắm đâu...\",\"rating\":9.0},\n  {\"id\":737223,\"suggestedTranslation\":\"Tôi thích các công cụ của mình nóng bỏng tay cơ.\",\"rating\":9.0},\n  {\"id\":737224,\"suggestedTranslation\":\"Ái chà chà, toàn bộ cái sức nóng tuyệt vời đó bay đi đâu hết rồi?\",\"rating\":9.0},\n  {\"id\":737225,\"suggestedTranslation\":\"Tôi sẽ chẳng bao giờ dùng bất kỳ cái búa nào khác nữa đâu.\",\"rating\":9.0},\n  {\"id\":737226,\"suggestedTranslation\":\"Trông nó không ổn lắm đâu...\",\"rating\":9.0},\n  {\"id\":737227,\"suggestedTranslation\":\"Tôi thích các công cụ của mình nóng bỏng tay cơ.\",\"rating\":9.0},\n  {\"id\":737228,\"suggestedTranslation\":\"Ái chà chà, toàn bộ cái sức nóng tuyệt vời đó bay đi đâu hết rồi?\",\"rating\":9.0},\n  {\"id\":737229,\"suggestedTranslation\":\"Tôi sẽ chẳng bao giờ dùng bất kỳ cái cuốc chim nào khác nữa đâu.\",\"rating\":9.0},\n  {\"id\":737230,\"suggestedTranslation\":\"Trông nó không ổn lắm đâu...\",\"rating\":9.0},\n  {\"id\":737231,\"suggestedTranslation\":\"Tôi thích các công cụ của mình nóng bỏng tay cơ.\",\"rating\":9.0},\n  {\"id\":737232,\"suggestedTranslation\":\"Ái chà chà, toàn bộ cái sức nóng tuyệt vời đó bay đi đâu hết rồi?\",\"rating\":9.0},\n  {\"id\":737233,\"suggestedTranslation\":\"Tôi sẽ chẳng bao giờ dùng bất kỳ cái xẻng nào khác nữa đâu.\",\"rating\":9.0},\n  {\"id\":737234,\"suggestedTranslation\":\"Trông nó không ổn lắm đâu...\",\"rating\":9.0},\n  {\"id\":737235,\"suggestedTranslation\":\"Tôi thích các công cụ của mình nóng bỏng tay cơ.\",\"rating\":9.0},\n  {\"id\":737236,\"suggestedTranslation\":\"Ái chà chà, toàn bộ cái sức nóng tuyệt vời đó bay đi đâu hết rồi?\",\"rating\":9.0},\n  {\"id\":737237,\"suggestedTranslation\":\"Tôi sẽ không bao giờ dùng bất kỳ chiếc cuốc làm vườn nào khác nữa.\",\"rating\":9.0},\n  {\"id\":737238,\"suggestedTranslation\":\"Đen và trắng lại còn xù lông khắp nơi!\",\"rating\":9.0},\n  {\"id\":737239,\"suggestedTranslation\":\"Eo ôi, rợn tóc gáy thật đấy!\",\"rating\":9.0},\n  {\"id\":737240,\"suggestedTranslation\":\"Bọn chúng chắc chắn biến mất với một tiếng nổ lớn rồi.\",\"rating\":9.0},\n  {\"id\":737241,\"suggestedTranslation\":\"Nhìn cái đồ trang trí sân cỏ to đùng ngốc nghếch này đi kìa!\",\"rating\":9.0},\n  {\"id\":737242,\"suggestedTranslation\":\"Ít ra thì nó không còn bốc mùi nữa.\",\"rating\":9.0},\n  {\"id\":737243,\"suggestedTranslation\":\"Chỉ là vài tép tỏi thôi mà.\",\"rating\":9.0},\n  {\"id\":737244,\"suggestedTranslation\":\"Lửa đã làm cho nó ngon hơn.\",\"rating\":9.0},\n  {\"id\":737245,\"suggestedTranslation\":\"Cá là hơi thở của tôi sẽ thơm phức nếu tôi ăn cả củ to đùng này đấy.\",\"rating\":9.0},\n  {\"id\":737246,\"suggestedTranslation\":\"Chỉ là một đám hạt giống thôi mà.\",\"rating\":9.0},\n  {\"id\":737247,\"suggestedTranslation\":\"Tôi thích đồ ăn nóng hơn.\",\"rating\":9.0},\n  {\"id\":737248,\"suggestedTranslation\":\"Mấy thứ này chắc là làm cho chúng cử động được.\",\"rating\":9.0},\n  {\"id\":737249,\"suggestedTranslation\":\"Ghê quá. Thôi, cảm ơn.\",\"rating\":9.0},\n  {\"id\":737250,\"suggestedTranslation\":\"Có lẽ tôi nên giúp một tay.\",\"rating\":9.0},\n  {\"id\":737251,\"suggestedTranslation\":\"Dù trong đó có là gì đi nữa, tôi cũng không thèm đến mức đó đâu.\",\"rating\":9.0},\n  {\"id\":737252,\"suggestedTranslation\":\"Tôi sẽ không nhầm thứ đó với mứt đâu.\",\"rating\":9.0},\n  {\"id\":737253,\"suggestedTranslation\":\"Chắc là nó đang hoạt động đấy nhỉ?\",\"rating\":9.0},\n  {\"id\":737254,\"suggestedTranslation\":\"Chẳng có gì trong đống nhầy nhụa đó cả.\",\"rating\":9.0},\n  {\"id\":737255,\"suggestedTranslation\":\"Đúng là kiểu tái chế công năng nhỉ.\",\"rating\":9.0},\n  {\"id\":737256,\"suggestedTranslation\":\"Trống hoác luôn!\",\"rating\":9.0},\n  {\"id\":737257,\"suggestedTranslation\":\"Tự hỏi làm sao bọn chúng lại lơ lửng được nhỉ?\",\"rating\":9.0},\n  {\"id\":737258,\"suggestedTranslation\":\"Àhh, thế này mới đúng chứ.\",\"rating\":9.0},\n  {\"id\":737259,\"suggestedTranslation\":\"Kinh tởm!\",\"rating\":9.0},\n  {\"id\":737260,\"suggestedTranslation\":\"Chuẩn luôn, hoàn toàn có thể tránh được mà.\",\"rating\":9.0},\n  {\"id\":737261,\"suggestedTranslation\":\"Có cảm giác như chúng đang nói chuyện ngay trong đầu tôi vậy!\",\"rating\":9.0},\n  {\"id\":737262,\"suggestedTranslation\":\"Hạ! Tóm được ngươi rồi nhé!\",\"rating\":9.0},\n  {\"id\":737263,\"suggestedTranslation\":\"Trống rỗng!\",\"rating\":9.0},\n  {\"id\":737264,\"suggestedTranslation\":\"Bọn chúng cực kỳ ghét đám sinh vật bóng tối đó đấy.\",\"rating\":9.0},\n  {\"id\":737265,\"suggestedTranslation\":\"Tôi đã làm gì sai với các người cơ chứ?\",\"rating\":9.0},\n  {\"id\":737266,\"suggestedTranslation\":\"Ngươi không thể giết thứ đã chết rồi đâu.\",\"rating\":9.0},\n  {\"id\":737267,\"suggestedTranslation\":\"Tuyệt thật. Lại một bông hoa ma quái nữa.\",\"rating\":9.0},\n  {\"id\":737268,\"suggestedTranslation\":\"Đẹp phết. Chắc vậy.\",\"rating\":9.0},\n  {\"id\":737269,\"suggestedTranslation\":\"Có lẽ ai đó nên kiểm tra xem nó có dễ bén lửa không đi. Tôi xin tự nguyện!\",\"rating\":9.0},\n  {\"id\":737270,\"suggestedTranslation\":\"Có lẽ ai đó nên kiểm tra xem nó có dễ bén lửa không đi. Tôi xin tự nguyện!\",\"rating\":9.0},\n  {\"id\":737271,\"suggestedTranslation\":\"Có lẽ ai đó nên kiểm tra xem nó có dễ bén lửa không đi. Tôi xin tự nguyện!\",\"rating\":9.0},\n  {\"id\":737272,\"suggestedTranslation\":\"Có lẽ ai đó nên kiểm tra xem nó có dễ bén lửa không đi. Tôi xin tự nguyện!\",\"rating\":9.0},\n  {\"id\":737273,\"suggestedTranslation\":\"Có lẽ ai đó nên kiểm tra xem nó có dễ bén lửa không đi. Tôi xin tự nguyện!\",\"rating\":9.0},\n  {\"id\":737274,\"suggestedTranslation\":\"Có lẽ ai đó nên kiểm tra xem nó có dễ bén lửa không đi. Tôi xin tự nguyện!\",\"rating\":9.0},\n  {\"id\":737275,\"suggestedTranslation\":\"Có lẽ ai đó nên kiểm tra xem nó có dễ bén lửa không đi. Tôi xin tự nguyện!\",\"rating\":9.0},\n  {\"id\":737276,\"suggestedTranslation\":\"Có lẽ ai đó nên kiểm tra xem nó có dễ bén lửa không đi. Tôi xin tự nguyện!\",\"rating\":9.0},\n  {\"id\":737277,\"suggestedTranslation\":\"Có lẽ ai đó nên kiểm tra xem nó có dễ bén lửa không đi. Tôi xin tự nguyện!\",\"rating\":9.0},\n  {\"id\":737278,\"suggestedTranslation\":\"Món quà này dành cho tôi đúng không nào?!\",\"rating\":9.0},\n  {\"id\":737279,\"suggestedTranslation\":\"Mấy cái dải ruy-băng cháy cực kỳ ngon lành luôn!\",\"rating\":9.0},\n  {\"id\":737280,\"suggestedTranslation\":\"Tôi gần như không nỡ đốt cái này luôn ấy chứ.\",\"rating\":9.0},\n  {\"id\":737281,\"suggestedTranslation\":\"Này đứng lại đó mau!\",\"rating\":9.0},\n  {\"id\":737282,\"suggestedTranslation\":\"Đồ ngọt thì không nên ăn thịt người chứ!\",\"rating\":9.0},\n  {\"id\":737283,\"suggestedTranslation\":\"Thấy chưa? Lửa giải quyết được tất cả mọi thứ.\",\"rating\":9.0},\n  {\"id\":737284,\"suggestedTranslation\":\"Haha, thứ này đủ sức chặt đứt phăng một cách tay đấy!\",\"rating\":9.0},\n  {\"id\":737285,\"suggestedTranslation\":\"Không thể tin nổi là nó lại thành công đấy!\",\"rating\":9.0},\n  {\"id\":737286,\"suggestedTranslation\":\"Nó xù lông! Và nhớp nháp nữa...\",\"rating\":9.0},\n  {\"id\":737287,\"suggestedTranslation\":\"Được rồi, tôi đoán nó cũng hơi dễ thương đấy.\",\"rating\":9.0},\n  {\"id\":737288,\"suggestedTranslation\":\"Tự hỏi không biết nó có cháy được không nhỉ...\",\"rating\":9.0},\n  {\"id\":737289,\"suggestedTranslation\":\"Sao cái quái gì cũng phải là hoa thế hả?!\",\"rating\":9.0},\n  {\"id\":737290,\"suggestedTranslation\":\"Nó sền sệt và kỳ quặc quá.\",\"rating\":9.0},\n  {\"id\":737291,\"suggestedTranslation\":\"Chúng nhỏ xíu luôn!\",\"rating\":9.0},\n  {\"id\":737292,\"suggestedTranslation\":\"Chắc chắn là cái đó chuẩn bị trôi vào mồm tôi rồi đấy.\",\"rating\":9.0},\n  {\"id\":737293,\"suggestedTranslation\":\"Mất cái sừng rồi thì đâu còn cứng đầu nữa, phải không?\",\"rating\":9.0},\n  {\"id\":737294,\"suggestedTranslation\":\"Ha! Nhìn mày ngốc nghếch làm sao khi không có sừng đấy.\",\"rating\":9.0},\n  {\"id\":737295,\"suggestedTranslation\":\"Phải thế chứ! Giờ mày làm việc cho TAO rồi đấy!\",\"rating\":9.0},\n  {\"id\":737296,\"suggestgTranslation\":\"Trời ạ, nhìn cái mũi của con đó kìa!\",\"rating\":9.0},\n  {\"id\":737297,\"suggestedTranslation\":\"Ha ha, tuyệt phết.\",\"rating\":9.0},\n  {\"id\":737298,\"suggestedTranslation\":\"Nó xù lông do nhiễm điện. Ghê thật đấy.\",\"rating\":9.0},\n  {\"id\":737299,\"suggestedTranslation\":\"Trông ngầu ghê nơi!\",\"rating\":9.0},\n  {\"id\":737300,\"suggestedTranslation\":\"Nó sẽ không đốt cháy cây cối được đâu, nhưng ít ra thì nó sáng bóng.\",\"rating\":9.0},\n  {\"id\":737301,\"suggestedTranslation\":\"Nó sẽ không đốt cháy cục đá nào được đâu, nhưng ít ra thì nó sáng bóng.\",\"rating\":9.0},\n  {\"id\":737302,\"suggestedTranslation\":\"Nó sẽ không đốt cháy mặt đất được đâu, nhưng ít ra thì nó sáng bóng.\",\"rating\":9.0},\n  {\"id\":737303,\"suggestedTranslation\":\"Nó sẽ không tạo ra những hố lửa bập bùng đâu, nhưng ít ra thì nó sáng bóng.\",\"rating\":9.0},\n  {\"id\":737304,\"suggestedTranslation\":\"Nó sẽ không giúp lửa lớn hơn đâu, nhưng ít ra thì nó sáng bóng.\",\"rating\":9.0},\n  {\"id\":737305,\"suggestedTranslation\":\"Chúng ta nên tiêu tiền vào đâu đây nhỉ??\",\"rating\":9.0},\n  {\"id\":737306,\"suggestedTranslation\":\"Trông êm ái quá cơ!\",\"rating\":9.0},\n  {\"id\":737307,\"suggestedTranslation\":\"Nó cần phân bón.\",\"rating\":9.0},\n  {\"id\":737308,\"suggestedTranslation\":\"Lửa kìa! Wẩu!\",\"rating\":9.0},\n  {\"id\":737309,\"suggestedTranslation\":\"Đốt sạch lũ ốm yếu đi!\",\"rating\":9.0},\n  {\"id\":737310,\"suggestedTranslation\":\"Eo. Mày hôi quá đấy.\",\"rating\":9.0},\n  {\"id\":737311,\"suggestedTranslation\":\"Đây là một bụi cỏ dễ bắt lửa.\",\"rating\":9.0},\n  {\"id\":737312,\"suggestedTranslation\":\"Gốc cỏ thì cũng chẳng có ích gì mấy.\",\"rating\":9.0},\n  {\"id\":737313,\"suggestedTranslation\":\"Đẹp, khô ráo, và sẵn sàng để bị đốt cháy rồi!\",\"rating\":9.0},\n  {\"id\":737314,\"suggestedTranslation\":\"Nó cần phải đi cắt tóc rồi đấy.\",\"rating\":9.0},\n  {\"id\":737315,\"suggestedTranslation\":\"Nhân đôi sự kinh tởm!\",\"rating\":9.0},\n  {\"id\":737316,\"suggestedTranslation\":\"Ghê.\",\"rating\":9.0},\n  {\"id\":737317,\"suggestedTranslation\":\"Đẹp hết chỗ chê luôn!\",\"rating\":9.0},\n  {\"id\":737318,\"suggestedTranslation\":\"Chẳng có ai ở nhà cả.\",\"rating\":9.0},\n  {\"id\":737319,\"suggestedTranslation\":\"Hồn ma thì có cháy được không nhỉ?\",\"rating\":9.0},\n  {\"id\":737320,\"suggestedTranslation\":\"Đúng rồi! Rưới thêm nước sốt thịt vào nữa nào!\",\"rating\":9.0},\n  {\"id\":737321,\"suggestedTranslation\":\"Tôi cảm thấy đầu óc mình được mở mang khi đeo nó đấy.\",\"rating\":9.0},\n  {\"id\":737322,\"suggestedTranslation\":\"Viên này mang lại cảm giác nhẹ tênh.\",\"rating\":9.0},\n  {\"id\":737323,\"suggestedTranslation\":\"Một cục đá tảng ngốc nghếch to đùng.\",\"rating\":9.0},\n  {\"id\":737324,\"suggestedTranslation\":\"Nó không nhóm lửa được đâu nhưng chắc vẫn hữu dụng chán.\",\"rating\":9.0},\n  {\"id\":737325,\"suggestedTranslation\":\"Nhàm chán!\",\"rating\":9.0},\n  {\"id\":737326,\"suggestedTranslation\":\"Nó đã được biến đổi bởi lửa rồi!\",\"rating\":9.0},\n  {\"id\":737327,\"suggestedTranslation\":\"Cây nấm ngốc nghếch.\",\"rating\":9.0},\n  {\"id\":737328,\"suggestedTranslation\":\"Này! Ngươi! Lên đây mau!\",\"rating\":9.0},\n  {\"id\":737329,\"suggestedTranslation\":\"Biết đâu nó sẽ mọc lại vào một ngày nào đó.\",\"rating\":9.0},\n  {\"id\":737330,\"suggestedTranslation\":\"Eo ôi, cả cái xó này vừa ẩm thấp vừa gớm ghiếc! Tôi ghét nó lắm!\",\"rating\":9.0},\n  {\"id\":737331,\"suggestedTranslation\":\"Eo ôi, cả cái xó này vừa ẩm thấp vừa gớm ghiếc! Tôi ghét nó lắm!\",\"rating\":9.0},\n  {\"id\":737332,\"suggestedTranslation\":\"Chúa tôi ơi, ngon phết đấy chứ!\",\"rating\":9.0},\n  {\"id\":737333,\"suggestedTranslation\":\"Nó cháy cũng như phân bình thường thôi.\",\"rating\":9.0},\n  {\"id\":737334,\"suggestedTranslation\":\"Ôiiii chao ôi! Sáng lấp lánh kìa!\",\"rating\":9.0},\n  {\"id\":737335,\"suggestedTranslation\":\"Cái này ngon hơn hẳn một quả táo bình thường rồi!\",\"rating\":9.0},\n  {\"id\":737336,\"suggestedTranslation\":\"Đúg rồiiii! Kẹo mút kìa!\",\"rating\":9.0},\n  {\"id\":737337,\"suggestedTranslation\":\"Tôi sẽ cần khoảng một tá mấy cái này đấy.\",\"rating\":9.0},\n  {\"id\":737338,\"suggestedTranslation\":\"Ghê quá! Kinh tởm thật đấy!\",\"rating\":9.0},\n  {\"id\":737339,\"suggestedTranslation\":\"Nó có vị hơi hăng hăng.\",\"rating\":9.0},\n  {\"id\":737340,\"suggestedTranslation\":\"Mừm! Đốt cháy khoang miệng sướng gì đâu!\",\"rating\":9.0},\n  {\"id\":737341,\"suggestedTranslation\":\"Bộ người ta thực sự ăn mấy thứ này hay chỉ coi nó như một trò đùa nhạt nhẽo vậy?\",\"rating\":9.0},\n  {\"id\":737342,\"suggestedTranslation\":\"Eo ôi vị ngô!\",\"rating\":9.0},\n  {\"id\":737343,\"suggestedTranslation\":\"Ghê quá! Tôi ghét cam thảo đen lắm!\",\"rating\":9.0},\n  {\"id\":737344,\"suggestedTranslation\":\"Mấy cái này đúng là ăn 'meo'-ng ngập mồm luôn.\",\"rating\":9.0},\n  {\"id\":737345,\"suggestgTranslation\":\"Này Wolfgang, ăn thử một cái rồi nói cho bọn tôi biết nó là vị gì đi!\",\"rating\":9.0},\n  {\"id\":737346,\"suggestedTranslation\":\"Đốt sạch chúng đi!!!\",\"rating\":9.0},\n  {\"id\":737347,\"suggestedTranslation\":\"Đúg rồiiii! Kẹo mút kìa!\",\"rating\":9.0},\n  {\"id\":737348,\"suggestedTranslation\":\"Tại sao một thứ ngon lành thế này lại trông gớm ghiếc cơ chứ!\",\"rating\":9.0},\n  {\"id\":737349,\"suggestedTranslation\":\"Cảm giác như có lửa đốt trong bụng tôi vậy.\",\"rating\":9.0},\n  {\"id\":737350,\"suggestedTranslation\":\"À. Hàng nặng đô đây.\",\"rating\":9.0},\n  {\"id\":737351,\"suggestgTranslation\":\"Ước gì nó mạnh hơn một chút nữa.\",\"rating\":9.0},\n  {\"id\":737352,\"suggestedTranslation\":\"Tôi không nghĩ là có thể làm cho lửa trở nên tuyệt vời hơn được nữa đâu.\",\"rating\":9.0},\n  {\"id\":737353,\"suggestedTranslation\":\"Nước ép đột biến nóng hổi vừa thổi vừa ăn!\",\"rating\":9.0},\n  {\"id\":737354,\"suggestedTranslation\":\"Tôi châm lửa đốt nó được không nhỉ?\",\"rating\":9.0},\n  {\"id\":737355,\"suggestedTranslation\":\"Tôi nên trang trí cho lễ Halloween thôi.\",\"rating\":9.0},\n  {\"id\":737356,\"suggestedTranslation\":\"Hừ. Tôi ghét mấy kẻ hống hách đó lắm.\",\"rating\":9.0},\n  {\"id\":737357,\"suggestedTranslation\":\"Ước gì nó dễ bắt lửa một chút.\",\"rating\":9.0},\n  {\"id\":737358,\"suggestedTranslation\":\"Tôi nên treo nó ở đâu đó để dọa người ta mới được.\",\"rating\":9.0},\n  {\"id\":737359,\"suggestedTranslation\":\"Tôi chuẩn bị treo cậu lên cây đấy nhé.\",\"rating\":9.0},\n  {\"id\":737360,\"suggestedTranslation\":\"Hân hạnh được làm thịt bạn!\",\"rating\":9.0},\n  {\"id\":737361,\"suggestedTranslation\":\"Tôi thích mấy dụng cụ sắc bén hơn cơ.\",\"rating\":9.0},\n  {\"id\":737362,\"suggestedTranslation\":\"Vũ khí trông chán ngắt.\",\"rating\":9.0},\n  {\"id\":737363,\"suggestedTranslation\":\"Bernie ôm thích hơn một cái gối lông cũ rích.\",\"rating\":9.0},\n  {\"id\":737364,\"suggestedTranslation\":\"Eo, cái gối này toàn rác ướt sũng!\",\"rating\":9.0},\n  {\"id\":737365,\"suggestedTranslation\":\"Chắc đó là một công dụng của hoa đấy.\",\"rating\":9.0},\n  {\"id\":737366,\"suggestedTranslation\":\"Cái gối tồi tệ nhất quả đất. Tôi nóng lòng muốn nện ai đó bằng nó quá!\",\"rating\":9.0},\n  {\"id\":737367,\"suggestedTranslation\":\"Haha, gớm ghiếc thật! Khoan đã, tôi không phải là người phải ăn nó đúng không?\",\"rating\":9.0},\n  {\"id\":737368,\"suggestedTranslation\":\"Tự hỏi không biết nó cháy có đẹp bằng hoa thật không cơ chứ.\",\"rating\":9.0},\n  {\"id\":737369,\"suggestedTranslation\":\"Nó xót quá! Nhưng mà lửa đâu rồi nhỉ?\",\"rating\":9.0},\n  {\"id\":737370,\"suggestedTranslation\":\"Kinh thật. Của tôi hết nhé.\",\"rating\":9.0},\n  {\"id\":737371,\"suggestedTranslation\":\"Tại sao tôi lại muốn có bất cứ thứ gì chen giữa tôi và những ngọn lửa đẹp đẽ của mình cơ chứ?\",\"rating\":9.0},\n  {\"id\":737372,\"suggestedTranslation\":\"Tôi cũng có thể thử xem sao.\",\"rating\":9.0},\n  {\"id\":737373,\"suggestedTranslation\":\"Nó lạnh như đá.\",\"rating\":9.0},\n  {\"id\":737374,\"suggestedTranslation\":\"Đóng băng cứng ngắc.\",\"rating\":9.0},\n  {\"id\":737375,\"suggestedTranslation\":\"Một ngọn lửa sẽ làm thứ này sống động lên đấy!\",\"rating\":9.0},\n  {\"id\":737376,\"suggestedTranslation\":\"Nhìn cách nó phát sáng kìa!\",\"rating\":9.0},\n  {\"id\":737377,\"suggestgTranslation\":\"Không ngọn lửa, chẳng có chút hơi ấm nào... thế thì vui vẻ chỗ nào chứ?\",\"rating\":9.0},\n  {\"id\":737378,\"suggestedTranslation\":\"Ugh, cái đồ lén lút đáng ghét này!!\",\"rating\":9.0},\n  {\"id\":737379,\"suggestedTranslation\":\"Mấy bông hồng đó trông sẽ rất đẹp khi chúng bốc cháy đấy.\",\"rating\":9.0},\n  {\"id\":737380,\"suggestedTranslation\":\"Heh. Tôi hơi thích bà ta rồi đấy.\",\"rating\":9.0},\n  {\"id\":737381,\"suggestedTranslation\":\"Trà này uống ấm cúng gần bằng ngọn lửa rồi đấy. Gần như thôi.\",\"rating\":9.0},\n  {\"id\":737382,\"suggestedTranslation\":\"Màu tím là hương vị yêu thích của tôi.\",\"rating\":9.0},\n  {\"id\":737383,\"suggestedTranslation\":\"Nó làm cho mấy thứ bóng tối biến mất á? Vâng, xin hãy làm thế đi.\",\"rating\":9.0},\n  {\"id\":737384,\"suggestedTranslation\":\"Chắc là hàng nhập khẩu rồi.\",\"rating\":9.0},\n  {\"id\":737385,\"suggestedTranslation\":\"Thứ này làm giảm bớt sự căng thẳng đấy.\",\"rating\":9.0},\n  {\"id\":737386,\"suggestedTranslation\":\"Tại sao không nhỉ? Cùng nổi điên một chút xem nào.\",\"rating\":9.0},\n  {\"id\":737387,\"suggestedTranslation\":\"Tôi thích thế giới chìm trong biển lửa, nhưng trà của tôi thì phải có đá.\",\"rating\":9.0},\n  {\"id\":737388,\"suggestedTranslation\":\"Tốt cho sức khỏe á? Chà, chẳng có gì vui vẻ cả.\",\"rating\":9.0},\n  {\"id\":737389,\"suggestedTranslation\":\"Ý là sao chứ, tôi không đốt được nó á?!\",\"rating\":9.0},\n  {\"id\":737390,\"suggestedTranslation\":\"Tôi thích ánh sáng ấm áp.\",\"rating\":9.0},\n  {\"id\":737391,\"suggestedTranslation\":\"Tôi có nên thắp sáng mọi thứ lên không nhỉ?\",\"rating\":9.0},\n  {\"id\":737392,\"suggestedTranslation\":\"Bà ta sống ở đâu thì có gì quan trọng cơ chứ?\",\"rating\":9.0},\n  {\"id\":737393,\"suggestedTranslation\":\"Tôi thích mấy lối đi tắt.\",\"rating\":9.0},\n  {\"id\":737394,\"suggestedTranslation\":\"Pha trà cho tôi đi, Pearl!\",\"rating\":9.0},\n  {\"id\":737395,\"suggestgTranslation\":\"Lâu thế không biết!\",\"rating\":9.0},\n  {\"id\":737396,\"suggestedTranslation\":\"Đừng có nhìn tôi!\",\"rating\":9.0},\n  {\"id\":737397,\"suggestedTranslation\":\"Pearl đâu rồi nhỉ?\",\"rating\":9.0},\n  {\"id\":737398,\"suggestedTranslation\":\"Trông đẹp và ấm áp phết!\",\"rating\":9.0},\n  {\"id\":737399,\"suggestedTranslation\":\"Còn gì tuyệt hơn suối nước nóng cơ chứ? Một lò lửa chứ sao!\",\"rating\":9.0},\n  {\"id\":737400,\"suggestedTranslation\":\"Ấm áp và dễ chịu quá!\",\"rating\":9.0},\n  {\"id\":737401,\"suggestedTranslation\":\"Sao lâu thế nhỉ?\",\"rating\":9.0},\n  {\"id\":737402,\"suggestedTranslation\":\"Tôi chưa bao giờ cần một 