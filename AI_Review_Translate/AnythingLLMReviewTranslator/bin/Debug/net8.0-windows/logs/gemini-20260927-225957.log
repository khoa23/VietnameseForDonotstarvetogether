ng\": 9.0},\n  {\"id\": 736855, \"suggestedTranslation\": \"Làm tôi nhớ đến một người ở khu phố cũ.\", \"rating\": 9.0},\n  {\"id\": 736856, \"suggestedTranslation\": \"Hết cứng đầu rồi đấy à?\", \"rating\": 9.0},\n  {\"id\": 736857, \"suggestedTranslation\": \"Ngươi nhìn cái gì thế hả?\", \"rating\": 9.0},\n  {\"id\": 736858, \"suggestedTranslation\": \"Tuyệt thật, lại thêm một bức tượng rợn tóc gáy.\", \"rating\": 9.0},\n  {\"id\": 736859, \"suggestedTranslation\": \"Hết cao ngạo được nữa rồi hả?\", \"rating\": 9.0},\n  {\"id\": 736860, \"suggestedTranslation\": \"Thứ đó là tồi tệ nhất.\", \"rating\": 9.0},\n  {\"id\": 736861, \"suggestedTranslation\": \"Con robot sát thủ ngốc nghếch.\", \"rating\": 9.0},\n  {\"id\": 736862, \"suggestedTranslation\": \"TÔI ĐÃ BẢO là nên đốt nó đi, nhưng không, có ai thèm nghe tôi đâu...\", \"rating\": 9.0},\n  {\"id\": 736863, \"suggestedTranslation\": \"Mong là nó bị khó tiêu.\", \"rating\": 9.0},\n  {\"id\": 736864, \"suggestedTranslation\": \"Quá nhiều thuyền, thiếu lửa quá.\", \"rating\": 9.0},\n  {\"id\": 736865, \"suggestedTranslation\": \"Đôi khi nó đúng là một tên khốn thực sự.\", \"rating\": 9.0},\n  {\"id\": 736866, \"suggestedTranslation\": \"Vẫn gớm ghiếc như ngày nào.\", \"rating\": 9.0},\n  {\"id\": 736867, \"suggestedTranslation\": \"Nó xù lông quá!\", \"rating\": 9.0},\n  {\"id\": 736868, \"suggestedTranslation\": \"Nhìn chằm chằm là bất lịch sự đấy.\", \"rating\": 9.0},\n  {\"id\": 736869, \"suggestedTranslation\": \"Ít ra thì nó không còn nhìn tôi nữa.\", \"rating\": 9.0},\n  {\"id\": 736870, \"suggestedTranslation\": \"Thêm chỗ để nhét đồ à? Nghe được đấy chứ!\", \"rating\": 9.0},\n  {\"id\": 736871, \"suggestedTranslation\": \"Hơi kinh tởm.\", \"rating\": 9.0},\n  {\"id\": 736872, \"suggestedTranslation\": \"Eo, cá mà cũng ăn thứ kinh tởm đó á?\", \"rating\": 9.0},\n  {\"id\": 736873, \"suggestedTranslation\": \"Con chó này lạnh lùng như đá!\", \"rating\": 9.0},\n  {\"id\": 736874, \"suggestedTranslation\": \"C