            "text": "[\n  {\"id\": 740186, \"suggestedTranslation\": \"Dai hơn mình tưởng một chút.\", \"rating\": 0.0},\n  {\"id\": 740187, \"suggestedTranslation\": \"Không gì bằng một nồi mì đầy ắp.\", \"rating\": 0.0},\n  {\"id\": 740188, \"suggestedTranslation\": \"Tuyệt thật, đúng là một hòn đá tảng.\", \"rating\": 0.0},\n  {\"id\": 740189, \"suggestedTranslation\": \"Lũ gặm nhấm biết bay.\", \"rating\": 0.0},\n  {\"id\": 740190, \"suggestedTranslation\": \"Hà! Khôn khéo đấy.\", \"rating\": 0.0},\n  {\"id\": 740191, \"suggestedTranslation\": \"Mình sẽ cứ để mặc chỗ đó.\", \"rating\": 0.0},\n  {\"id\": 740192, \"suggestedTranslation\": \"Mình không phải kiểu người màu mè.\", \"rating\": 0.0},\n  {\"id\": 740193, \"suggestedTranslation\": \"Bắt được mũi mi rồi nhé!\", \"rating\": 0.0},\n  {\"id\": 740194, \"suggestedTranslation\": \"Khá là thực tế nếu bạn hỏi tôi.\", \"rating\": 0.0},\n  {\"id\": 740195, \"suggestedTranslation\": \"Tôi không kén cá chọn canh đâu.\", \"rating\": 0.0},\n  {\"id\": 740196, \"suggestedTranslation\": \"Cái ống đựng bản nhạc gì mà sang chảnh thế.\", \"rating\": 0.0},\n  {\"id\": 740197, \"suggestedTranslation\": \"Nhạc kịch hơi bị trưởng giả đối với tôi.\", \"rating\": 0.0},\n  {\"id\": 740198, \"suggestedTranslation\": \"Nhạc kịch hơi bị trưởng giả đối với tôi.\", \"rating\": 0.0},\n  {\"id\": 740199, \"suggestedTranslation\": \"Nhạc kịch hơi bị trưởng giả đối với tôi.\", \"rating\": 0.0},\n  {\"id\": 740200, \"suggestedTranslation\": \"Mấy thứ này hợp với Charlie hơn...\", \"rating\": 0.0},\n  {\"id\": 740201, \"suggestedTranslation\": \"Nhạc kịch hơi bị trưởng giả đối với tôi.\", \"rating\": 0.0},\n  {\"id\": 740202, \"suggestedTranslation\": \"Mấy thứ này hợp với Charlie hơn...\", \"rating\": 0.0},\n  {\"id\": 740203, \"suggestedTranslation\": \"Nhạc kịch hơi bị trưởng giả đối với tôi.\", \"rating\": 0.0},\n  {\"id\": 740204, \"suggestedTranslation\": \"Nhạc kịch hơi bị trưởng giả đối với tôi.\", \"rating\": 0.0},\n  {\"id\": 740205, \"suggestedTranslation\": \"Nhạc kịch hơi bị trưởng giả đối với tôi.\", \"rating\": 0.0},\n  {\"id\": 740206, \"suggestedTranslation\": \"Nhạc kịch hơi bị trưởng giả đối với tôi.\", \"rating\": 0.0},\n  {\"id\": 740207, \"suggestedTranslation\": \"Nhiều thịt ngạc nhiên đấy.\", \"rating\": 0.0},\n  {\"id\": 740208, \"suggestedTranslation\": \"Thịt nào chẳng là thịt.\", \"rating\": 0.0},\n  {\"id\": 740209, \"suggestedTranslation\": \"Hà! Ghê tởm thật.\", \"rating\": 0.0},\n  {\"id\": 740210, \"suggestedTranslation\": \"Nhào vô đi, anh bạn to xác!\", \"rating\": 0.0},\n  {\"id\": 740211, \"suggestedTranslation\": \"Nó sẽ còn bốc khói trong mấy ngày tới đấy.\", \"rating\": 0.0},\n  {\"id\": 740212, \"suggestedTranslation\": \"Cậu bạn to xác đã ngãm củ tỏi rồi.\", \"rating\": 0.0},\n  {\"id\": 740213, \"suggestedTranslation\": \"Ồ chà...\", \"rating\": 0.0},\n  {\"id\": 740214, \"suggestedTranslation\": \"Cái cặp lồng cơm kỳ dị nhất mà tôi từng thấy.\", \"rating\": 0.0},\n  {\"id\": 740215, \"suggestedTranslation\": \"Một chiếc áo ghi lê ấm áp thực sự.\", \"rating\": 0.0},\n  {\"id\": 740216, \"suggestedTranslation\": \"Lướt tay qua sờ rất chi là dễ chịu.\", \"rating\": 0.0},\n  {\"id\": 740217, \"suggestedTranslation\": \"Mong là nó đem lại cho tôi chút may mắn trong cuộc thi.\", \"rating\": 0.0},\n  {\"id\": 740218, \"suggestedTranslation\": \"Ngủ trên lông thú vẫn hơn là đống rơm.\", \"rating\": 0.0},\n  {\"id\": 740219, \"suggestedTranslation\": \"Đi ngả lưng thôi. Theo đúng nghĩa đen.\", \"rating\": 0.0},\n  {\"id\": 740220, \"suggestedTranslation\": \"Nó là một con ong chăm chỉ đáng kinh ngạc.\", \"rating\": 0.0},\n  {\"id\": 740221, \"suggestedTranslation\": \"Những người lao động phải biết quan tâm lẫn nhau chứ.\", \"rating\": 0.0},\n  {\"id\": 740222, \"suggestedTranslation\": \"Hỏa hoạn nhà xưởng rồi!\", \"rating\": 0.0},\n  {\"id\": 740223, \"suggestedTranslation\": \"Làm tốt lắm, lũ ong!\", \"rating\": 0.0},\n  {\"id\": 740224, \"suggestedTranslation\": \"Trông như dây chuyền lắp ráp trong đó vậy. Bận rộn ghê!\", \"rating\": 0.0},\n  {\"id\": 740225, \"suggestedTranslation\": \"Đạo đức nghề nghiệp xuất sắc của lũ ong đâu rồi hả?!\", \"rating\": 0.0},\n  {\"id\": 740226, \"suggestedTranslation\": \"Làm tốt lắm, lũ ong!\", \"rating\": 0.0},\n  {\"id\": 740227, \"suggestedTranslation\": \"Các bạn đã làm việc chăm chỉ rồi.\", \"rating\": 0.0},\n  {\"id\": 740228, \"suggestedTranslation\": \"Hỏa hoạn nhà xưởng rồi!\", \"rating\": 0.0},\n  {\"id\": 740229, \"suggestedTranslation\": \"Làm tốt lắm, lũ ong!\", \"rating\": 0.0},\n  {\"id\": 740230, \"suggestedTranslation\": \"Hừm. Cấu trúc thú vị đấy.\", \"rating\": 0.0},\n  {\"id\": 740231, \"suggestedTranslation\": \"Đạo đức nghề nghiệp xuất sắc của lũ ong đâu rồi hả?!\", \"rating\": 0.0},\n  {\"id\": 740232, \"suggestedTranslation\": \"Làm tốt lắm, lũ ong!\", \"rating\": 0.0},\n  {\"id\": 740233, \"suggestedTranslation\": \"Các bạn đã làm việc chăm chỉ rồi.\", \"rating\": 0.0},\n  {\"id\": 740234, \"suggestedTranslation\": \"Thật là đáng tiếc.\", \"rating\": 0.0},\n  {\"id\": 740235, \"suggestedTranslation\": \"Chưa đến lúc của nó mà.\", \"rating\": 0.0},\n  {\"id\": 740236, \"suggestedTranslation\": \"Giờ chúng ta là bạn rồi.\", \"rating\": 0.0},\n  {\"id\": 740237, \"suggestedTranslation\": \"Có vẻ như tôi vừa kết bạn.\", \"rating\": 0.0},\n  {\"id\": 740238, \"suggestedTranslation\": \"Heh. Anh bạn to xác.\", \"rating\": 0.0},\n  {\"id\": 740239, \"suggestedTranslation\": \"Chúng ta là chiến hữu đấy!\", \"rating\": 0.0},\n  {\"id\": 740240, \"suggestedTranslation\": \"Hà! Trông thật là thô thiển.\", \"rating\": 0.0},\n  {\"id\": 740241, \"suggestedTranslation\": \"Thu cái thái độ đó lại trước khi tôi phải dạy dỗ mi nhé!\", \"rating\": 0.0},\n  {\"id\": 740242, \"suggestedTranslation\": \"Mi đang trở nên yếu ớt rồi đấy!\", \"rating\": 0.0},\n  {\"id\": 740243, \"suggestedTranslation\": \"Chà! Mi đang ở phong độ đỉnh cao đấy!\", \"rating\": 0.0},\n  {\"id\": 740244, \"suggestedTranslation\": \"Lười biếng.\", \"rating\": 0.0},\n  {\"id\": 740245, \"suggestedTranslation\": \"Đến giờ cho ăn rồi!\", \"rating\": 0.0},\n  {\"id\": 740246, \"suggestedTranslation\": \"Trông có vẻ bí hiểm.\", \"rating\": 0.0},\n  {\"id\": 740247, \"suggestedTranslation\": \"Con Bò Lai của tôi đã làm việc rất vất vả, nó xứng đáng nhận được phần thưởng.\", \"rating\": 0.0},\n  {\"id\": 740248, \"suggestedTranslation\": \"Hơi hôi, nhưng mà ấm.\", \"rating\": 0.0},\n  {\"id\": 740249, \"suggestedTranslation\": \"Chắc tôi phải xây cái khác thôi.\", \"rating\": 0.0},\n  {\"id\": 740250, \"suggestedTranslation\": \"Hơi bị cầu kỳ đối với một con Bò Lai đấy.\", \"rating\": 0.0},\n  {\"id\": 740251, \"suggestedTranslation\": \"Nào, hãy làm cho con Bò Lai này trông thậtảnh bảnh nào.\", \"rating\": 0.0},\n  {\"id\": 740252, \"suggestedTranslation\": \"Tốt hơn là nên bắt tay vào xây dựng thôi!\", \"rating\": 0.0},\n  {\"id\": 740253, \"suggestedTranslation\": \"Mấy con Bò Lai có vẻ thích cái chuông đó lắm!\", \"rating\": 0.0},\n  {\"id\": 740254, \"suggestedTranslation\": \"Chế độ quân chủ là một hệ thống cai trị lỗi thời!\", \"rating\": 0.0},\n  {\"id\": 740255, \"suggestedTranslation\": \"Tôn trọng loài ong đồng nghĩa với việc tôn trọng ngòi đốt của chúng.\", \"rating\": 0.0},\n  {\"id\": 740256, \"suggestedTranslation\": \"Làm việc chăm chỉ ghê.\", \"rating\": 0.0},\n  {\"id\": 740257, \"suggestedTranslation\": \"Nghe giống tiếng động cơ vo ve.\", \"rating\": 0.0},\n  {\"id\": 740258, \"suggestedTranslation\": \"Gã đó chẳng bao giờ quan tâm đến người khác cả. Pfft.\", \"rating\": 0.0},\n  {\"id\": 740259, \"suggestedTranslation\": \"Đó là nữ hoàng của loài ong!\", \"rating\": 0.0},\n  {\"id\": 740260, \"suggestedTranslation\": \"Dính dấp quá. Tôi thà không giẫm lên nó còn hơn.\", \"rating\": 0.0},\n  {\"id\": 740261, \"suggestedTranslation\": \"Tôi dám cá là thứ đó đã to lên rồi.\", \"rating\": 0.0},\n  {\"id\": 740262, \"suggestedTranslation\": \"Í ẹ! Lấy búa nện cho nó một phát mới được.\", \"rating\": 0.0},\n  {\"id\": 740263, \"suggestedTranslation\": \"Ngửi cũng khá ổn.\", \"rating\": 0.0},\n  {\"id\": 740264, \"suggestedTranslation\": \"Tôi chưa bao giờ thích nước hoa. Giờ thì lại càng ghét hơn\", \"rating\": 0.0},\n  {\"id\": 740265, \"suggestedTranslation\": \"Cút về chuồng của mi đi.\", \"rating\": 0.0},\n  {\"id\": 740266, \"suggestedTranslation\": \"Lúc nào cũng có một cuộc chen lấn khi chuông báo tan làm vang lên.\", \"rating\": 0.0},\n  {\"id\": 740267, \"suggestedTranslation\": \"Nó là người máy à? Mình có thể nhìn trộm bên trong không?\", \"rating\": 0.0},\n  {\"id\": 740268, \"suggestedTranslation\": \"Cô bé đó biết cách làm cho ra trò phết.\", \"rating\": 0.0},\n  {\"id\": 740269, \"suggestedTranslation\": \"Cậu nhóc này cần được tút tát lại chút ít.\", \"rating\": 0.0},\n  {\"id\": 740270, \"suggestedTranslation\": \"Cậu nhóc này đã được cưng chiều lắm đây.\", \"rating\": 0.0},\n  {\"id\": 740271, \"suggestedTranslation\": \"Một nắm Dâu Rừng rời rạc.\", \"rating\": 0.0},\n  {\"id\": 740272, \"suggestedTranslation\": \"Hơi xém ở vài chỗ, nhưng tôi không bận tâm đâu.\", \"rating\": 0.0},\n  {\"id\": 740273, \"suggestedTranslation\": \"Chúng mọng nước thật đấy!\", \"rating\": 0.0},\n  {\"id\": 740274, \"suggestedTranslation\": \"Chúng vẫn cực kỳ mọng nước luôn.\", \"rating\": 0.0},\n  {\"id\": 740275, \"suggestedTranslation\": \"Cần chút thứ từ phía sau của một con thú.\", \"rating\": 0.0},\n  {\"id\": 740276, \"suggestedTranslation\": \"Giờ thì tôi chẳng làm gì hơn được nữa rồi.\", \"rating\": 0.0},\n  {\"id\": 740277, \"suggestedTranslation\": \"Có lẽ bạn nên xin nghỉ bệnh đi...\", \"rating\": 0.0},\n  {\"id\": 740278, \"suggestedTranslation\": \"Eo ôi! Nó có mùi thế này là sao chứ?\", \"rating\": 0.0},\n  {\"id\": 740279, \"suggestedTranslation\": \"Mình ăn được mấy thứ này không ta?\", \"rating\": 0.0},\n  {\"id\": 740280, \"suggestedTranslation\": \"Hái sạch bách luôn.\", \"rating\": 0.0},\n  {\"id\": 740281, \"suggestedTranslation\": \"Rõ ràng là cậu chưa từng làm việc trong phòng lò hơi bao giờ rồi.\", \"rating\": 0.0},\n  {\"id\": 740282, \"suggestedTranslation\": \"Kiệt sức hoàn toàn. Hay là chưa nhỉ?\", \"rating\": 0.0},\n  {\"id\": 740283, \"suggestedTranslation\": \"Giờ thì tôi chẳng làm gì hơn được nữa rồi.\", \"rating\": 0.0},\n  {\"id\": 740284, \"suggestedTranslation\": \"Có lẽ bạn nên xin nghỉ bệnh đi...\", \"rating\": 0.0},\n  {\"id\": 740285, \"suggestedTranslation\": \"Eo ôi! Nó có mùi thế này là sao chứ?\", \"rating\": 0.0},\n  {\"id\": 740286, \"suggestedTranslation\": \"Trông có vẻ ngon đấy. Mong là chúng không có độc.\", \"rating\": 0.0},\n  {\"id\": 740287, \"suggestedTranslation\": \"Hái sạch bách luôn.\", \"rating\": 0.0},\n  {\"id\": 740288, \"suggestedTranslation\": \"Pssh. Cái nóng này thì thấm vào đâu.\", \"rating\": 0.0},\n  {\"id\": 740289, \"suggestedTranslation\": \"Đưa nó qua đây nào!\", \"rating\": 0.0},\n  {\"id\": 740290, \"suggestedTranslation\": \"Tôi sẽ thử xem sao!\", \"rating\": 0.0},\n  {\"id\": 740291, \"suggestedTranslation\": \"Ít ra thì nó không đi giày bảo hộ mũi thép!\", \"rating\": 0.0},\n  {\"id\": 740292, \"suggestedTranslation\": \"Suỵt! Cút ra chỗ khác đi!\", \"rating\": 0.0},\n  {\"id\": 740293, \"suggestedTranslation\": \"Hình như đến lượt tôi cho nó ăn thì phải.\", \"rating\": 0.0},\n  {\"id\": 740294, \"suggestedTranslation\": \"Đó mới đúng là tác phẩm kim loại chất lượng.\", \"rating\": 0.0},\n  {\"id\": 740295, \"suggestedTranslation\": \"Này! Đến lượt tôi cho chim ăn chưa đấy?\", \"rating\": 0.0},\n  {\"id\": 740296, \"suggestedTranslation\": \"Nó chỉ là một con tốt thí thôi.\", \"rating\": 0.0},\n  {\"id\": 740297, \"suggestedTranslation\": \"Thôi thì... cứ giấu nhẹm nó đi vậy.\", \"rating\": 0.0},\n  {\"id\": 740298, \"suggestedTranslation\": \"Sao cậu lại mệt mỏi chứ? Cuộc sống của cậu sướng như tiên còn gì.\", \"rating\": 0.0},\n  {\"id\": 740299, \"suggestedTranslation\": \"Con chim tội nghiệp này chỉ còn l