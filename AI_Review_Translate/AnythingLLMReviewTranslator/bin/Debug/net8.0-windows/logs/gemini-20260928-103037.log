            "text": "[\n  {\"id\": 743188, \"suggestedTranslation\": \"Hừm. Cái đó không ổn rồi.\", \"rating\": 9.0},\n  {\"id\": 743189, \"suggestedTranslation\": \"Tập trung vào phần thưởng nào!\", \"rating\": 9.0},\n  {\"id\": 743190, \"suggestedTranslation\": \"Úi chà! Cuộc đua gì mà đỉnh thế!\", \"rating\": 9.0},\n  {\"id\": 743191, \"suggestedTranslation\": \"Hà! Cuộc đua hay đấy {winner}, nhưng lần sau tôi sẽ thắng cho xem.\", \"rating\": 9.0},\n  {\"id\": 743192, \"suggestedTranslation\": \"Giờ thì, đặt vạch đích ở đâu đây...\", \"rating\": 9.0},\n  {\"id\": 743193, \"suggestedTranslation\": \"Ai rồi cũng phải bắt đầu từ đâu đó chứ.\", \"rating\": 9.0},\n  {\"id\": 743194, \"suggestedTranslation\": \"Tốt hơn là nên dựng cuộc đua lên thôi!\", \"rating\": 9.0},\n  {\"id\": 743195, \"suggestedTranslation\": \"Ái chà, cái này không đúng tiêu chuẩn rồi.\", \"rating\": 9.0},\n  {\"id\": 743196, \"suggestedTranslation\": \"Vẫn còn chỗ để cải thiện đấy.\", \"rating\": 9.0},\n  {\"id\": 743197, \"suggestedTranslation\": \"Tôi nghĩ chúng ta vừa tóm được một nhà vô địch thực thụ rồi đấy!\", \"rating\": 9.0},\n  {\"id\": 743198, \"suggestedTranslation\": \"Được rồi, để xem tôi có những gì nào.\", \"rating\": 9.0},\n  {\"id\": 743199, \"suggestedTranslation\": \"Đến lúc xem con Cà Ruột của tôi có ra gì không rồi.\", \"rating\": 9.0},\n  {\"id\": 743200, \"suggestedTranslation\": \"Mấy cái hạt.\", \"rating\": 9.0},\n  {\"id\": 743201, \"suggestedTranslation\": \"Tự hỏi cái gì sẽ mọc lên từ đám này nhỉ?\", \"rating\": 9.0},\n  {\"id\": 743202, \"suggestedTranslation\": \"Làm phô trương quá cho một thứ sẽ dành phần lớn thời gian dưới nước.\", \"rating\": 9.0},\n  {\"id\": 743203, \"suggestedTranslation\": \"Ai đó phải lắp ráp cái dây neo này, chắc là tôi rồi.\", \"rating\": 9.0},\n  {\"id\": 743204, \"suggestedTranslation\": \"Chắc là tôi phải lường trước việc này mới đúng.\", \"rating\": 9.0},\n  {\"id\": 743205, \"suggestedTranslation\": \"Mày có muốn gặm chút than không?\", \"rating\": 9.0},\n  {\"id\": 743206, \"suggestedTranslation\": \"Để xem mày có gì nào!\", \"rating\": 9.0},\n  {\"id\": 743207, \"suggestedTranslation\": \"Tôi lúc nào cũng cần thêm một tay để chèo, móng vuốt cũng được!\", \"rating\": 9.0},\n  {\"id\": 743208, \"suggestedTranslation\": \"May là tôi có một trực giác phương hướng tuyệt vời đấy.\", \"rating\": 9.0},\n  {\"id\": 743209, \"suggestedTranslation\": \"Cái bánh lái đó không tự lắp ráp đâu.\", \"rating\": 9.0},\n  {\"id\": 743210, \"suggestedTranslation\": \"Ôi đáng yêu chưa kìa.\", \"rating\": 9.0},\n  {\"id\": 743211, \"suggestedTranslation\": \"Cụng ly cho sự xông pha đâm đầu vào tường nào.\", \"rating\": 9.0},\n  {\"id\": 743212, \"suggestedTranslation\": \"Cháy đen thui luôn!\", \"rating\": 9.0},\n  {\"id\": 743213, \"suggestedTranslation\": \"Thế mày muốn hàng xịn hả?\", \"rating\": 9.0},\n  {\"id\": 743214, \"suggestedTranslation\": \"Đúng là một kẻ cứng đầu khó chiều mà.\", \"rating\": 9.0},\n  {\"id\": 743215, \"suggestedTranslation\": \"Làm bạn chạy nhanh như ngựa trên hai chân.\", \"rating\": 9.0},\n  {\"id\": 743216, \"suggestedTranslation\": \"Tiện để đấu thương đấy... nếu đó là sở thích của bạn.\", \"rating\": 9.0},\n  {\"id\": 743217, \"suggestedTranslation\": \"Đấy mới gọi là một bữa thị soạn chứ!\", \"rating\": 9.0},\n  {\"id\": 743218, \"suggestedTranslation\": \"Tôi sẽ đem cho con heo hoặc thứ gì đó ăn vậy.\", \"rating\": 9.0},\n  {\"id\": 743219, \"suggestedTranslation\": \"Một thứ gì đó để nhai chơi.\", \"rating\": 9.0},\n  {\"id\": 743220, \"suggestedTranslation\": \"Hơi mộc mạc so với gu của tôi, nhưng đủ dùng.\", \"rating\": 9.0},\n  {\"id\": 743221, \"suggestedTranslation\": \"Nhìn chả có gì đặc biệt khi không có ánh sáng.\", \"rating\": 9.0},\n  {\"id\": 743222, \"suggestedTranslation\": \"Phải tìm một chỗ tốt cho nó mới được.\", \"rating\": 9.0},\n  {\"id\": 743223, \"suggestedTranslation\": \"Hơi mộc mạc so với gu của tôi, nhưng đủ dùng.\", \"rating\": 9.0},\n  {\"id\": 743224, \"suggestedTranslation\": \"Nhìn chả có gì đặc biệt khi không có ánh sáng.\", \"rating\": 9.0},\n  {\"id\": 743225, \"suggestedTranslation\": \"Phải tìm một chỗ tốt cho nó mới được.\", \"rating\": 9.0},\n  {\"id\": 743226, \"suggestedTranslation\": \"Hè. Làm chị cả đã rèn luyện tôi rất tốt cho việc này.\", \"rating\": 9.0},\n  {\"id\": 743227, \"suggestedTranslation\": \"Trông có vẻ là một cách hay để xả hơi đấy.\", \"rating\": 9.0},\n  {\"id\": 743228, \"suggestedTranslation\": \"Tốt hơn là nên bắt tay vào xây thôi!\", \"rating\": 9.0},\n  {\"id\": 743229, \"suggestedTranslation\": \"Chắc nghỉ ăn một chút bánh ngọt cũng chẳng hại gì đâu.\", \"rating\": 9.0},\n  {\"id\": 743230, \"suggestedTranslation\": \"Không tài nào đoán được vị của nó, nhưng tôi thích!\", \"rating\": 9.0},\n  {\"id\": 743231, \"suggestedTranslation\": \"Trông nó giống mấy món tráng miệng kiểu cách của Warly vậy.\", \"rating\": 9.0},\n  {\"id\": 743232, \"suggestedTranslation\": \"Vị ngọt trên một chiếc que.\", \"rating\": 9.0},\n  {\"id\": 743233, \"suggestedTranslation\": \"Chắc thế là đủ rồi.\", \"rating\": 9.0},\n  {\"id\": 743234, \"suggestedTranslation\": \"Tôi đoán là nó đang thèm thứ gì đó.\", \"rating\": 9.0},\n  {\"id\": 743235, \"suggestedTranslation\": \"Tất cả chuyện này chỉ vì lũ thỏ thôi sao?\", \"rating\": 9.0},\n  {\"id\": 743236, \"suggestedTranslation\": \"Cái này sẽ lôi cổ đám lười biếng đó khỏi cái mông lông lá của chúng!\", \"rating\": 9.0},\n  {\"id\": 743237, \"suggestedTranslation\": \"Không phải làm thế đâu.\", \"rating\": 9.0},\n  {\"id\": 743238, \"suggestedTranslation\": \"Cũng được đấy.\", \"rating\": 9.0},\n  {\"id\": 743239, \"suggestedTranslation\": \"Đèn tiệc tùng à? Hừm...\", \"rating\": 9.0},\n  {\"id\": 743240, \"suggestedTranslation\": \"Thật đáng tiếc làm sao.\", \"rating\": 9.0},\n  {\"id\": 743241, \"suggestedTranslation\": \"Con giun này trông có vẻ đói lả rồi.\", \"rating\": 9.0},\n  {\"id\": 743242, \"suggestedTranslation\": \"Được rồi, giun ạ. Mày có gì cho tao nào?\", \"rating\": 9.0},\n  {\"id\": 743243, \"suggestedTranslation\": \"Mấy con giun đó ăn diện để đi tiệc kìa.\", \"rating\": 9.0},\n  {\"id\": 743244, \"suggestedTranslation\": \"Ôi. Tôi đang dùng cái đó mà.\", \"rating\": 9.0},\n  {\"id\": 743245, \"suggestedTranslation\": \"Tự hỏi nó đang chờ vật phẩm cúng tế nào nhỉ?\", \"rating\": 9.0},\n  {\"id\": 743246, \"suggestedTranslation\": \"Nhóc con này đúng là một nguồn cảm hứng lớn.\", \"rating\": 9.0},\n  {\"id\": 743247, \"suggestedTranslation\": \"Tuyệt vời! Chịu chết không biết đó là cái quái gì luôn.\", \"rating\": 9.0},\n  {\"id\": 743248, \"suggestedTranslation\": \"Khỏe như voi!\", \"rating\": 9.0},\n  {\"id\": 743249, \"suggestedTranslation\": \"Có cái gì đó đang làm nó khó chịu.\", \"rating\": 9.0},\n  {\"id\": 743250, \"suggestedTranslation\": \"Chắc là hơi cô đơn khi chỉ có một mình ở đây nhỉ?\", \"rating\": 9.0},\n  {\"id\": 743251, \"suggestedTranslation\": \"Nó cần được tâm sự một trận ra trò đấy.\", \"rating\": 9.0},\n  {\"id\": 743252, \"suggestedTranslation\": \"Tôi phải quay lại việc nhổ cỏ thôi.\", \"rating\": 9.0},\n  {\"id\": 743253, \"suggestedTranslation\": \"Trông cậu có vẻ cần được tưới nước đấy.\", \"rating\": 9.0},\n  {\"id\": 743254, \"suggestedTranslation\": \"Tốt hơn là nên bón thêm chất dinh dưỡng cho nó.\", \"rating\": 9.0},\n  {\"id\": 743255, \"suggestedTranslation\": \"Mấy cái cây tội nghiệp chen chúc nhau như cá mòi trong khu vườn này!\", \"rating\": 9.0},\n  {\"id\": 743256, \"suggestedTranslation\": \"Tôi không nghĩ đây là mùa thích hợp cho nó đâu.\", \"rating\": 9.0},\n  {\"id\": 743257, \"suggestedTranslation\": \"Có cả một danh sách dài dặc những thứ đang có vấn đề với cái này.\", \"rating\": 9.0},\n  {\"id\": 743258, \"suggestedTranslation\": \"Cái đó sắp bén lửa đấy!\", \"rating\": 9.0},\n  {\"id\": 743259, \"suggestedTranslation\": \"Tầm nhìn kém gây ra tai nạn lao động đấy!\", \"rating\": 9.0},\n  {\"id\": 743260, \"suggestedTranslation\": \"Tiếng rắc đó thật là ám ảnh.\", \"rating\": 9.0},\n  {\"id\": 743261, \"suggestedTranslation\": \"Tôi nhớ kỳ nghỉ cuối cùng mà gia đình chúng tôi quây quần bên nhau.\", \"rating\": 9.0},\n  {\"id\": 743262, \"suggestedTranslation\": \"R-rồng mây đẹp phết... Ồ hố.\", \"rating\": 9.0},\n  {\"id\": 743263, \"suggestedTranslation\": \"Thật phí phạm thức ăn làm sao!\", \"rating\": 9.0},\n  {\"id\": 743264, \"suggestedTranslation\": \"Các nguyên liệu kết hợp không đúng rồi.\", \"rating\": 9.0},\n  {\"id\": 743265, \"suggestedTranslation\": \"Chuồn lẹ khi còn có thể thôi!\", \"rating\": 9.0},\n  {\"id\": 743267, \"suggestedTranslation\": \"Người chim đâu rồi? Tưởng hắn ở đây chứ...\", \"rating\": 9.0},\n  {\"id\": 743268, \"suggestedTranslation\": \"Cơ bắp của Wolfgang đã dọa mấy chú mèo con chạy mất tiêu rồi à?\", \"rating\": 9.0},\n  {\"id\": 743269, \"suggestedTranslation\": \"Hắn là một con chim rất bận rộn, phải điều hành hội chợ cơ mà!\", \"rating\": 9.0},\n  {\"id\": 743270, \"suggestedTranslation\": \"Wolfgang chơi công bằng, ít mèo con đi thì còn gì là vui nữa?\", \"rating\": 9.0},\n  {\"id\": 743271, \"suggestedTranslation\": \"Wolfgang chơi công bằng, ở đây chẳng có chỗ nào cho mèo con trốn cả!\", \"rating\": 9.0},\n  {\"id\": 743272, \"suggestedTranslation\": \"Thế là đủ trò chơi cho Wolfgang rồi.\", \"rating\": 9.0},\n  {\"id\": 743273, \"suggestedTranslation\": \"Để Wolfgang vào với!\", \"rating\": 9.0},\n  {\"id\": 743274, \"suggestedTranslation\": \"Cái này không phải cho người vải. Wolfgang giữ nhé.\", \"rating\": 9.0},\n  {\"id\": 743275, \"suggestedTranslation\": \"Có vẻ lũ chim dời hội chợ đi chỗ khác rồi.\", \"rating\": 9.0},\n  {\"id\": 743277, \"suggestedTranslation\": \"Đó là đồ của người máy.\", \"rating\": 9.0},\n  {\"id\": 743278, \"suggestedTranslation\": \"Người cá chỉ tin tưởng mỗi Wurt.\", \"rating\": 9.0},\n  {\"id\": 743279, \"suggestedTranslation\": \"Gấu sát thủ khổng lồ chỉ đi theo cô nàng đuốc nhỏ thôi.\", \"rating\": 9.0},\n  {\"id\": 743280, \"suggestedTranslation\": \"Wolfgang cần gối để đánh nhau!\", \"rating\": 9.0},\n  {\"id\": 743282, \"suggestedTranslation\": \"Ghê quá! Không, thế là quá nhiều rồi.\", \"rating\": 9.0},\n  {\"id\": 743285, \"suggestedTranslation\": \"Quan tòa đang bận.\", \"rating\": 9.0},\n  {\"id\": 743286, \"suggestedTranslation\": \"Wolfgang đang choáng váng không làm nổi việc này.\", \"rating\": 9.0},\n  {\"id\": 743287, \"suggestedTranslation\": \"Đã được làm đẹp rồi.\", \"rating\": 9.0},\n  {\"id\": 743288, \"suggestedTranslation\": \"Bị phủ đầy những thứ sắc nhọn nhìn xuyên thấu rồi!\", \"rating\": 9.0},\n  {\"id\": 743290, \"suggestedTranslation\": \"Wolfgang phải đợi.\", \"rating\": 9.0},\n  {\"id\": 743291, \"suggestedTranslation\": \"Wolfgang có bạn thú cưng rồi!\", \"rating\": 9.0},\n  {\"id\": 743292, \"suggestedTranslation\": \"Bò lông cao quá. Tôi không với tới.\", \"rating\": 9.0},\n  {\"id\": 743293, \"suggestedTranslation\": \"Wolfgang đã có bạn lông xù tốt bụng rồi.\", \"rating\": 9.0},\n  {\"id\": 743294, \"suggestedTranslation\": \"Chim nhỏ nhanh quá!\", \"rating\": 9.0},\n  {\"id\": 743295, \"suggestedTranslation\": \"Wolfgang đang cháy!\", \"rating\": 9.0},\n  {\"id\": 743296, \"suggestedTranslation\": \"Quả bí ngô này không dành cho Wolfgang.\", \"rating\": 9.0},\n  {\"id\": 743304, \"suggestedTranslation\": \"Đồ lót ngày thường của Wolfgang đang cháy á? Wolfgang buồn đấy.\", \"rating\": 9.0},\n  {\"id\": 743305, \"suggestedTranslation\": \"Quần áo chỉ tốt để xé bằng cơ bắp cuồn cuộn thôi!\", \"rating\": 9.0},\n  {\"id\": 743306, \"suggestedTranslation\": \"Wolfgang sẽ đợi họ đi rồi mới thay. Cậu ấy ngại lắm.\", \"rating\": 9.0},\n  {\"id\": 743307, \"suggestedTranslation\": \"Wolfgang cần bò lai để buộc vào.\", \"rating\": 9.0},\n  {\"id\": 743308, \"suggestedTranslation\": \"Sẽ đợi tóc mọc lại đã.\", \"rating\": 9.0},\n  {\"id\": 743309, \"suggestedTranslation\": \"Nó chứa đầy năng lượng hùng mạnh!\", \"rating\": 9.0},\n  {\"id\": 743310, \"suggestedTranslation\": \"Á chà, năng lượng yếu quá!\", \"rating\": 9.0},\n  {\"id\": 743311, \"suggestedTranslation\": \"Cá bé không đủ hùng mạnh!\", \"rating\": 9.0},\n  {\"id\": 743312, \"suggestedTranslation\": \"Wolfgang có thể nhấc nó lên quá dễ dàng, không đủ nặng!\", \"rating\": 9.0},\n  {\"id\": 743313, \"suggestedTranslation\": \"Wolfgang cần thứ gì đó để đặt vào đây.\", \"rating\": 9.0},\n  {\"id\": 743314, \"suggestedTranslation\": \"Wolfgang dùng chung được chứ?\", \"rating\": 9.0},\n  {\"id\": 743315, \"suggestedTranslation\": \"Wolfgang cầm nhầm bản vẽ rồi.\", \"rating\": 9.0},\n  {\"id\": 743316, \"suggestedTranslation\": \"Không phải chỗ thích hợp cho việc đó.\", \"rating\": 9.0},\n  {\"id\": 743317, \"suggestedTranslation\": \"Ở đây đáng sợ quá! Sẽ quay lại sau!\", \"rating\": 9.0},\n  {\"id\": 743318, \"suggestedTranslation\": \"Wolfgang không có hứng nấu nướng.\", \"rating\": 9.0},\n  {\"id\": 743319, \"suggestedTranslation\": \"Ồ, thơm quá, bạn ơi!\", \"rating\": 9.0},\n  {\"id\": 743320, \"suggestedTranslation\": \"Cái nồi này rất nhỏ, hay là ở xa quá vậy?\", \"rating\": 9.0},\n  {\"id\": 743321, \"suggestedTranslation\": \"Không thể ấn bẹp cái mũ được.\", \"rating\": 9.0},\n  {\"id\": 743322, \"suggestedTranslation\": \"Chưa đến lượt Wolfgang.\", \"rating\": 9.0},\n  {\"id\": 743323, \"suggestedTranslation\": \"Khônggggg. Nó đang tan chảy kìa. Wolfgang không khóc đâu.\", \"rating\": 9.0},\n  {\"id\": 743324, \"suggestedTranslation\": \"Quá cao, ngay cả đối với Wolfgang.\", \"rating\": 9.0},\n  {\"id\": 743325, \"suggestedTranslation\": \"Ồ, trống không. Wolfgang thử lại sau vậy.\", \"rating\": 9.0},\n  {\"id\": 743326, \"suggestedTranslation\": \"Phải ăn hết bữa ăn ngon lành đã.\", \"rating\": 9.0},\n  {\"id\": 743327, \"suggestedTranslation\": \"Wolfgang muốn dùng sau bạn, nếu được nhé.\", \"rating\": 9.0},\n  {\"id\": 743328, \"suggestedTranslation\": \"Vẫn còn đầy đồ đạc trong đó.\", \"rating\": 9.0},\n  {\"id\": 743329, \"suggestedTranslation\": \"Wolfgang cố tình trượt đấy.\", \"rating\": 9.0},\n  {\"id\": 743330, \"suggestedTranslation\": \"Wolfgang không giỏi vẽ tranh trong đầu ra lắm.\", \"rating\": 9.0},\n  {\"id\": 743331, \"suggestedTranslation\": \"Bây giờ đến lượt Wolfgang tập tạ rồi! Khoan đã...\", \"rating\": 9.0},\n  {\"id\": 743332, \"suggestedTranslation\": \"Đói quá... bụng cứ kêu ọt ọt thì nâng tạ sao nổi...\", \"rating\": 9.0},\n  {\"id\": 743333, \"suggestedTranslation\": \"Wolfgang cần tìm thứ gì đó để nâng!\", \"rating\": 9.0},\n  {\"id\": 743334, \"suggestedTranslation\": \"Cảm giác nóng rát thì hay đấy, nhưng thế này thì hơi quá.\", \"rating\": 9.0},\n  {\"id\": 743335, \"suggestedTranslation\": \"Wolfgang sẽ dẫm nát đám lửa té xỉu này trước.\", \"rating\": 9.0},\n  {\"id\": 743336, \"suggestedTranslation\": \"Wolfgang không muốn một bên tay khỏe hơn tay kia đâu!\", \"rating\": 9.0},\n  {\"id\": 743337, \"suggestedTranslation\": \"Nước muối không tốt cho thực vật.\", \"rating\": 9.0},\n  {\"id\": 743338, \"suggestedTranslation\": \"Wolfgang không với tới cá bằng chiếc cần nhỏ xíu được!\", \"rating\": 9.0},\n  {\"id\": 743339, \"suggestedTranslation\": \"Lừa Wolfgang à, nhà ngươi cứ chờ đấy!\", \"rating\": 9.0},\n  {\"id\": 743340, \"suggestedTranslation\": \"Wolfgang nhét tim vào cô bé ma nhưng chẳng có chuyện gì xảy ra!\", \"rating\": 9.0},\n  {\"id\": 743341, \"suggestedTranslation\": \"Wolfgang Hùng Mạnh sẽ thử lại sớm thôi!\", \"rating\": 9.0},\n  {\"id\": 743342, \"suggestedTranslation\": \"Không có tác dụng.\", \"rating\": 9.0},\n  {\"id\": 743343, \"suggestedTranslation\": \"Mọi người đang chơi vui vẻ, Wolfgang có thể chờ.\", \"rating\": 9.0},\n  {\"id\": 743344, \"suggestedTranslation\": \"Wolfgang cần dựng xong đường đua trước đã.\", \"rating\": 9.0},\n  {\"id\": 743345, \"suggestedTranslation\": \"Haha! Wolfgang cứ nghĩ thử làm thế sẽ buồn cười lắm chứ!\", \"rating\": 9.0},\n  {\"id\": 743346, \"suggestedTranslation\": \"Cậu biết là nó chết rồi chứ, đúng không?\", \"rating\": 9.0},\n  {\"id\": 743347, \"suggestedTranslation\": \"Công thức nhỏ đã có sẵn trong đó rồi!\", \"rating\": 9.0},\n  {\"id\": 743348, \"suggestedTranslation\": \"Nó phải thưởng thức món ăn ngon đầu tiên từ Wolfgang trước đã!\", \"rating\": 9.0},\n  {\"id\": 743349, \"suggestedTranslation\": \"Wolfgang không nghĩ cái đó để ở đây.\", \"rating\": 9.0},\n  {\"id\": 743350, \"suggestedTranslation\": \"Không!\", \"rating\": 9.0},\n  {\"id\": 743351, \"suggestedTranslation\": \"Cần một khúc gỗ nhỏ có khuôn mặt.\", \"rating\": 9.0},\n  {\"id\": 743352, \"suggestedTranslation\": \"Chắc là cần một cây nấm nhỏ xíu.\", \"rating\": 9.0},\n  {\"id\": 743353, \"suggestedTranslation\": \"Tại sao đám nấm mãi không lớn nhỉ?\", \"rating\": 9.0},\n  {\"id\": 743354, \"suggestedTranslation\": \"Ngay cả cơ bắp hùng mạnh cũng không nhét vừa được!\", \"rating\": 9.0},\n  {\"id\": 743355, \"suggestedTranslation\": \"Ở trong này đáng sợ quá, anh chàng hài hước không làm việc nổi.\", \"rating\": 9.0},\n  {\"id\": 743356, \"suggestedTranslation\": \"Wolfgang không nói được tiếng khỉ.\", \"rating\": 9.0},\n  {\"id\": 743357, \"suggestedTranslation\": \"Wolfgang chỉ phục vụ những món ăn ngon nhất!\", \"rating\": 9.0},\n  {\"id\": 743358, \"suggestedTranslation\": \"Ngay cả cơ bắp hùng mạnh cũng không nhét vừa được!\", \"rating\": 9.0},\n  {\"id\": 743359, \"suggestedTranslation\": \"Vật liệu không đủ cứng cáp để tạc tượng mạnh mẽ!\", \"rating\": 9.0},\n  {\"id\": 743360, \"suggestedTranslation\": \"Tôi không nghĩ cái bục nhỏ sẽ thích điều đó.\", \"rating\": 9.0},\n  {\"id\": 743361, \"suggestedTranslation\": \"Nguy hiểm quá, không chơi trò đó lúc này được!\", \"rating\": 9.0},\n  {\"id\": 743362, \"suggestedTranslation\": \"Wolfgang dọn dẹp trước đã.\", \"rating\": 9.0},\n  {\"id\": 743363, \"suggestedTranslation\": \"Trời tối rồi. Không chơi trò chơi nữa.\", \"rating\": 9.0},\n  {\"id\": 743364, \"suggestedTranslation\": \"Quý cô lông lá đang bận. Wolfgang sẽ đợi.\", \"rating\": 9.0},\n  {\"id\": 743365, \