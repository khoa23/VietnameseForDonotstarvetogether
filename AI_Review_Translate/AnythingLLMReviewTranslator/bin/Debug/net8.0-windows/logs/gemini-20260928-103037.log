          {
            "text": "[\n  {\"id\":740786,\"suggestedTranslation\":\"Chắc nó muốn dùng Voxola hả?\",\"rating\":9.0},\n  {\"id\":740787,\"suggestedTranslation\":\"Ít ra mình cũng lắp ráp đúng cách.\",\"rating\":9.0},\n  {\"id\":740788,\"suggestedTranslation\":\"Đó là Voxola mà! Nó làm gì ở đây thế này?\",\"rating\":9.0},\n  {\"id\":740789,\"suggestedTranslation\":\"Việc xây cầu cảng cứ để tôi lo.\",\"rating\":9.0},\n  {\"id\":740790,\"suggestedTranslation\":\"Tôi không thích nhìn thấy linh kiện \\\"thừa thãi\\\" vứt bừa bãi đâu...\",\"rating\":9.0},\n  {\"id\":740791,\"suggestedTranslation\":\"Nhiều bèo nhèo cần phải khâu quá...\",\"rating\":9.0},\n  {\"id\":740792,\"suggestedTranslation\":\"Nó không tự xây lên được đâu.\",\"rating\":9.0},\n  {\"id\":740793,\"suggestedTranslation\":\"Bé cưng này có đủ mọi thứ bạn cần luôn!\",\"rating\":9.0},\n  {\"id\":740794,\"suggestedTranslation\":\"Cái bụng của con quái vật đấy!\",\"rating\":9.0},\n  {\"id\":740795,\"suggestedTranslation\":\"Không thể tin nổi Warly lại bắt tôi ăn xà lách đấy.\",\"rating\":9.0},\n  {\"id\":740796,\"suggestedTranslation\":\"Nhìn cái mỏ hàn bay lượn này xem!\",\"rating\":9.0},\n  {\"id\":740797,\"suggestedTranslation\":\"Dành cho kẻ chảnh chọe nhất.\",\"rating\":9.0},\n  {\"id\":740798,\"suggestedTranslation\":\"Chảnh đấy, nhưng mà bền.\",\"rating\":9.0},\n  {\"id\":740799,\"suggestedTranslation\":\"Khá là sang chảnh cho một cái lò sưởi đấy chứ.\",\"rating\":9.0},\n  {\"id\":740800,\"suggestedTranslation\":\"Chúng ta phải sửa nó thôi.\",\"rating\":9.0},\n  {\"id\":740801,\"suggestedTranslation\":\"Đấy mới gọi là lò sưởi chứ.\",\"rating\":9.0},\n  {\"id\":740802,\"suggestedTranslation\":\"Cần thêm chút công lực nữa.\",\"rating\":9.0},\n  {\"id\":740803,\"suggestedTranslation\":\"Quả chảnh chọe.\",\"rating\":9.0},\n  {\"id\":740804,\"suggestedTranslation\":\"Đã nấu bay cái vẻ chảnh chọe của nó đi rồi.\",\"rating\":9.0},\n  {\"id\":740805,\"suggestedTranslation\":\"Chúng ta sẽ ăn thứ này dài dài cho xem!\",\"rating\":9.0},\n  {\"id\":740806,\"suggestedTranslation\":\"Một nắm hạt.\",\"rating\":9.0},\n  {\"id\":740807,\"suggestedTranslation\":\"Tiến lên và chiếm lĩnh trung tâm nào!\",\"rating\":9.0},\n  {\"id\":740808,\"suggestedTranslation\":\"Thịt bò đâu mất rồi?\",\"rating\":9.0},\n  {\"id\":740809,\"suggestedTranslation\":\"Đó mới là phần quan trọng.\",\"rating\":9.0},\n  {\"id\":740810,\"suggestedTranslation\":\"Phô trương quá nhỉ.\",\"rating\":9.0},\n  {\"id\":740811,\"suggestedTranslation\":\"Nhìn có vẻ độc ác, nhưng mà cứng cáp phết.\",\"rating\":9.0},\n  {\"id\":740812,\"suggestedTranslation\":\"Trông sắc sảo đấy! Theo đúng nghĩa đen luôn.\",\"rating\":9.0},\n  {\"id\":740813,\"suggestedTranslation\":\"Chắc dưới đó mọc đống thứ này lắm đây.\",\"rating\":9.0},\n  {\"id\":740814,\"suggestedTranslation\":\"Hừm. Sến sẩm thật.\",\"rating\":9.0},\n  {\"id\":740815,\"suggestedTranslation\":\"Trời ạ, ngọn lửa đang bùng cháy kìa!\",\"rating\":9.0},\n  {\"id\":740816,\"suggestedTranslation\":\"Trông giống như vừa có tai nạn xảy ra ở đây.\",\"rating\":9.0},\n  {\"id\":740817,\"suggestedTranslation\":\"Tự hỏi cây Gỗ Mục có phải là vật liệu xây dựng tốt không nhỉ?\",\"rating\":9.0},\n  {\"id\":740818,\"suggestedTranslation\":\"Cây này qua thời hoàng kim lâu rồi.\",\"rating\":9.0},\n  {\"id\":740819,\"suggestedTranslation\":\"Không thể nói là cái đùi gà sống nghe hấp dẫn cho lắm đâu.\",\"rating\":9.0},\n  {\"id\":740820,\"suggestedTranslation\":\"Không gì sánh bằng.\",\"rating\":9.0},\n  {\"id\":740821,\"suggestedTranslation\":\"Đỡ phải lặn lội xuống hang động chán.\",\"rating\":9.0},\n  {\"id\":740822,\"suggestedTranslation\":\"Tôi thích làm bẩn đôi tay mình lắm.\",\"rating\":9.0},\n  {\"id\":740823,\"suggestedTranslation\":\"Tôi sẽ trồng lại nó nếu không ai muốn làm.\",\"rating\":9.0},\n  {\"id\":740824,\"suggestedTranslation\":\"Có vẻ cần phải làm vườn chút rồi.\",\"rating\":9.0},\n  {\"id\":740825,\"suggestedTranslation\":\"Chà, nó không tự mọc lại được đâu.\",\"rating\":9.0},\n  {\"id\":740826,\"suggestedTranslation\":\"Toàn là chuyện dài dòng không đấy, tôi nói thật!\",\"rating\":9.0},\n  {\"id\":740827,\"suggestedTranslation\":\"Cần được trồng lại.\",\"rating\":9.0},\n  {\"id\":740828,\"suggestedTranslation\":\"Đừng hòng lừa được tôi, ha!\",\"rating\":9.0},\n  {\"id\":740829,\"suggestedTranslation\":\"Sao không làm việc thực tế đi thay vì cứ nâng mấy cái thứ này hả?\",\"rating\":9.0},\n  {\"id\":740830,\"suggestedTranslation\":\"Kiếm ít băng đá chườm vào đi thôi!\",\"rating\":9.0},\n  {\"id\":740831,\"suggestedTranslation\":\"Làm quá lố cho một thứ chỉ để nhấc lên rồi đặt xuống hết lần này đến lần khác.\",\"rating\":9.0},\n  {\"id\":740832,\"suggestedTranslation\":\"Làm quá lố cho một thứ chỉ để nhấc lên rồi đặt xuống hết lần này đến lần khác.\",\"rating\":9.0},\n  {\"id\":740833,\"suggestedTranslation\":\"Đó là thứ anh ta dùng để khởi động à?\",\"rating\":9.0},\n  {\"id\":740834,\"suggestedTranslation\":\"Làm quá lố cho một thứ chỉ để nhấc lên rồi đặt xuống hết lần này đến lần khác.\",\"rating\":9.0},\n  {\"id\":740835,\"suggestedTranslation\":\"Cậu sẽ thực sự cảm nhận được sức nóng đấy! Hah!\",\"rating\":9.0},\n  {\"id\":740836,\"suggestedTranslation\":\"Mùi nặng đô phết! Tôi nể đấy.\",\"rating\":9.0},\n  {\"id\":740837,\"suggestedTranslation\":\"Uuy! Mùi này đủ sức làm mọc tóc trên đầu anh đấy.\",\"rating\":9.0},\n  {\"id\":740838,\"suggestedTranslation\":\"Đúng là bốc mùi kinh thật.\",\"rating\":9.0},\n  {\"id\":740839,\"suggestedTranslation\":\"Một nắm hạt.\",\"rating\":9.0},\n  {\"id\":740840,\"suggestedTranslation\":\"Ứa gan. Chắc phải nhờ mấy con sâu bướm nhỏ đó dọn dẹp bãi chiến trường này quá.\",\"rating\":9.0},\n  {\"id\":740841,\"suggestedTranslation\":\"Đúng là một chú công nhân nhỏ bền bỉ.\",\"rating\":9.0},\n  {\"id\":740842,\"suggestedTranslation\":\"Xin lỗi mấy nhóc nhé, nhưng ta đang cần một số nguyên liệu từ tụi bây.\",\"rating\":9.0},\n  {\"id\":740843,\"suggestedTranslation\":\"Tôi ghét thời tiết lạnh lắm.\",\"rating\":9.0},\n  {\"id\":740844,\"suggestedTranslation\":\"Trông cậu có vẻ \\\"lươn lẹo\\\" thế nhỉ. Hah!\",\"rating\":9.0},\n  {\"id\":740845,\"suggestedTranslation\":\"Cái gì cũng phải thử một lần trong đời chứ.\",\"rating\":9.0},\n  {\"id\":740846,\"suggestedTranslation\":\"Nhìn nó kì dị chưa kìa! Hah!\",\"rating\":9.0},\n  {\"id\":740847,\"suggestedTranslation\":\"Nấu lên có ngon hơn không nhỉ? Chịu đấy.\",\"rating\":9.0},\n  {\"id\":740848,\"suggestedTranslation\":\"Đúng là để lại ấn tượng mạnh thật. Hah!\",\"rating\":9.0},\n  {\"id\":740849,\"suggestedTranslation\":\"Một nắm hạt.\",\"rating\":9.0},\n  {\"id\":740850,\"suggestedTranslation\":\"Sống ở vùng này chẳng khác nào đi đày cả.\",\"rating\":9.0},\n  {\"id\":740851,\"suggestedTranslation\":\"Ấm áp và dễ chịu phết.\",\"rating\":9.0},\n  {\"id\":740852,\"suggestedTranslation\":\"Tiếc thật đấy.\",\"rating\":9.0},\n  {\"id\":740853,\"suggestedTranslation\":\"Được đóng rất chắc chắn.\",\"rating\":9.0},\n  {\"id\":740854,\"suggestedTranslation\":\"Tôi nhớ đèn quá.\",\"rating\":9.0},\n  {\"id\":740855,\"suggestedTranslation\":\"Chắc chắn là cái này không xê dịch đi đâu được rồi.\",\"rating\":9.0},\n  {\"id\":740856,\"suggestedTranslation\":\"Cái đó trụ không lâu nữa đâu.\",\"rating\":9.0},\n  {\"id\":740857,\"suggestedTranslation\":\"Bó hoa đó qua thời hoàng kim lâu rồi.\",\"rating\":9.0},\n  {\"id\":740858,\"suggestedTranslation\":\"Một đám cháy ấn tượng thật.\",\"rating\":9.0},\n  {\"id\":740859,\"suggestedTranslation\":\"Cháy thành than hoàn toàn rồi.\",\"rating\":9.0},\n  {\"id\":740860,\"suggestedTranslation\":\"Miễn là công việc đã hoàn thành.\",\"rating\":9.0},\n  {\"id\":740861,\"suggestedTranslation\":\"Chỉ là một cái cây thôi.\",\"rating\":9.0},\n  {\"id\":740862,\"suggestedTranslation\":\"Đám cháy ấn tượng đấy.\",\"rating\":9.0},\n  {\"id\":740863,\"suggestedTranslation\":\"Cháy thành than hoàn toàn rồi.\",\"rating\":9.0},\n  {\"id\":740864,\"suggestedTranslation\":\"Mừng là xong việc này rồi.\",\"rating\":9.0},\n  {\"id\":740865,\"suggestedTranslation\":\"Ừ. Đúng là một cái cây rồi.\",\"rating\":9.0},\n  {\"id\":740866,\"suggestedTranslation\":\"Ở dưới này vừa khô ráo lại vừa ấm áp.\",\"rating\":9.0},\n  {\"id\":740867,\"suggestedTranslation\":\"Chắc tôi sẽ được nhìn nhận thế giới qua một góc nhìn hoàn toàn khác đây.\",\"rating\":9.0},\n  {\"id\":740868,\"suggestedTranslation\":\"Trời ạ, gai mắt thật đấy.\",\"rating\":9.0},\n  {\"id\":740869,\"suggestedTranslation\":\"Không thể trách chúng làm việc với gã giám sát to xác đứng lù lù ở đó được.\",\"rating\":9.0},\n  {\"id\":740870,\"suggestedTranslation\":\"Cứ tưởng đến giờ tôi phải quen với mấy chuyện này rồi chứ.\",\"rating\":9.0},\n  {\"id\":740871,\"suggestedTranslation\":\"Biết sao không? Tôi lười thèm hỏi luôn đấy.\",\"rating\":9.0},\n  {\"id\":740872,\"suggestedTranslation\":\"Đúng là một tác phẩm tuyệt vời.\",\"rating\":9.0},\n  {\"id\":740873,\"suggestedTranslation\":\"Để tôi lắp ráp nó cho.\",\"rating\":9.0},\n  {\"id\":740874,\"suggestedTranslation\":\"Tôi rất ghét nhìn thấy công sức đổ sông đổ biển.\",\"rating\":9.0},\n  {\"id\":740875,\"suggestedTranslation\":\"Gieo nhân nào gặt quả nấy.\",\"rating\":9.0},\n  {\"id\":740876,\"suggestedTranslation\":\"Công sức của chúng ta cuối cùng cũng được đền đáp rồi.\",\"rating\":9.0},\n  {\"id\":740877,\"suggestedTranslation\":\"Nó cần được kích thích thêm chút nữa.\",\"rating\":9.0},\n  {\"id\":740878,\"suggestedTranslation\":\"Vậy thì bắt đầu trồng trọt thôi nào!\",\"rating\":9.0},\n  {\"id\":740879,\"suggestedTranslation\":\"Đừng có cháy mấy luống hoa màu nhé!\",\"rating\":9.0},\n  {\"id\":740880,\"suggestedTranslation\":\"Đến lúc thu hoạch rồi!\",\"rating\":9.0},\n  {\"id\":740881,\"suggestedTranslation\":\"Chà chà, quả to phết nhỉ!\",\"rating\":9.0},\n  {\"id\":740882,\"suggestedTranslation\":\"Xem ra tôi phải đi nhổ cỏ dại thôi.\",\"rating\":9.0},\n  {\"id\":740883,\"suggestedTranslation\":\"Một thực vật.\",\"rating\":9.0},\n  {\"id\":740884,\"suggestedTranslation\":\"Có vẻ đang lớn lên rồi.\",\"rating\":9.0},\n  {\"id\":740885,\"suggestedTranslation\":\"Lẽ ra nên hái sớm hơn.\",\"rating\":9.0},\n  {\"id\":740886,\"suggestedTranslation\":\"Phí phạm quá đi mất.\",\"rating\":9.0},\n  {\"id\":740887,\"suggestedTranslation\":\"Còn cả một chặng đường dài phía trước đấy.\",\"rating\":9.0},\n  {\"id\":740888,\"suggestedTranslation\":\"Tiện lợi thật đấy!\",\"rating\":9.0},\n  {\"id\":740889,\"suggestedTranslation\":\"Cái đồ chơi này sẽ giúp chúng ta làm vườn nhanh chóng thôi!\",\"rating\":9.0},\n  {\"id\":740890,\"suggestedTranslation\":\"Dọn sạch đống bừa bộn này đi nào.\",\"rating\":9.0},\n  {\"id\":740891,\"suggestedTranslation\":\"Làm quá lên rồi.\",\"rating\":9.0},\n  {\"id\":740892,\"suggestedTranslation\":\"Ồ lala, điệu đà thế cơ à.\",\"rating\":9.0},\n  {\"id\":740893,\"suggestedTranslation\":\"Chữ viết của tôi xấu lắm.\",\"rating\":9.0},\n  {\"id\":740894,\"suggestedTranslation\":\"Đó không phải là một bảng hiệu tốt đâu.\",\"rating\":9.0},\n  {\"id\":740895,\"suggestedTranslation\":\"Chẳng có mấy tích sự cho lắm.\",\"rating\":9.0},\n  {\"id\":740896,\"suggestedTranslation\":\"Hơi vô dụng chút. Dù sao thì trông cũng đẹp mắt.\",\"rating\":9.0},\n  {\"id\":740897,\"suggestedTranslation\":\"Ước gì mình có chiếc mũ để gài nó vào.\",\"rating\":9.0},\n  {\"id\":740898,\"suggestedTranslation\":\"Cô ta trông có vẻ chẳng vui chút nào cả.\",\"rating\":9.0},\n  {\"id\":740899,\"suggestedTranslation\":\"Một chiếc hàng rào làm thủ công rõ ràng.\",\"rating\":9.0},\n  {\"id\":740900,\"suggestedTranslation\":\"Nó chưa được kết nối nguồn điện.\",\"rating\":9.0},\n  {\"id\":740901,\"suggestedTranslation\":\"Cẩn thận cái râu của mấy cậu khi lại gần mấy thứ này nhé!\",\"rating\":9.0},\n  {\"id\":740902,\"suggestedTranslation\":\"Nó vẫn chưa được cắm xuống đất.\",\"rating\":9.0},\n  {\"id\":740903,\"suggestedTranslation\":\"Một chiếc cổng làm thủ công rõ ràng.\",\"rating\":9.0},\n  {\"id\":740904,\"suggestedTranslation\":\"Giờ chỉ việc lắp ráp nó lại thôi.\",\"rating\":9.0},\n  {\"id\":740905,\"suggestedTranslation\":\"Chỉ cần lắp ráp lại là được.\",\"rating\":9.0},\n  {\"id\":740906,\"suggestedTranslation\":\"Nó làm rất tròn trách nhiệm đấy.\",\"rating\":9.0},\n  {\"id\":740907,\"suggestedTranslation\":\"Mỗi việc đều có dụng cụ thích hợp riêng của nó.\",\"rating\":9.0},\n  {\"id\":740908,\"suggestedTranslation\":\"Mấy loại cây này bao nhiêu phân bón cũng không đủ.\",\"rating\":9.0},\n  {\"id\":740909,\"suggestedTranslation\":\"Được chứ, sao lại không nào.\",\"rating\":9.0},\n  {\"id\":740910,\"suggestedTranslation\":\"Đúng là một thiết kế trông vui tươi thật!\",\"rating\":9.0},\n  {\"id\":740911,\"suggestedTranslation\":\"Hồi ở nhà chưa bao giờ thử, thấy nó cứ làm quá sao ấy đối với tôi.\",\"rating\":9.0},\n  {\"id\":740912,\"suggestedTranslation\":\"Phải công nhận là món này ăn ngon thật!\",\"rating\":9.0},\n  {\"id\":740913,\"suggestedTranslation\":\"Đúng là món bạn muốn mang theo trong giờ nghỉ trưa rồi.\",\"rating\":9.0},\n  {\"id\":740914,\"suggestedTranslation\":\"Hơi chảnh chọe một chút, nhưng phải thừa nhận là ngon phết.\",\"rating\":9.0},\n  {\"id\":740915,\"suggestedTranslation\":\"Trông cũng không khó sử dụng cho lắm.\",\"rating\":9.0},\n  {\"id\":740916,\"suggestedTranslation\":\"Pháo hoa may mắn đây!\",\"rating\":9.0},\n  {\"id\":740917,\"suggestedTranslation\":\"Ánh sáng tự nhiên à? Chắc sẽ hữu ích đấy.\",\"rating\":9.0},\n  {\"id\":740918,\"suggestedTranslation\":\"Tôi nghĩ ra vài công dụng cho mấy bé cưng này rồi đấy.\",\"rating\":9.0},\n  {\"id\":740919,\"suggestedTranslation\":\"Biến đi chỗ khác mau, anh bạn trẻ!\",\"rating\":9.0},\n  {\"id\":740920,\"suggestedTranslation\":\"Đúng là hiểm họa nơi công sở rồi.\",\"rating\":9.0},\n  {\"id\":740921,\"suggestedTranslation\":\"Mấy cái này khô ráo và ngon nghẻ phết.\",\"rating\":9.0},\n  {\"id\":740922,\"suggestedTranslation\":\"Trời ạ, cái bút gì mà nóng bỏng tay thế!\",\"rating\":9.0},\n  {\"id\":740923,\"suggestedTranslation\":\"Sắp tàn hơi đến nơi rồi.\",\"rating\":9.0},\n  {\"id\":740924,\"suggestedTranslation\":\"Ngoài này đúng là khỉ ho cò gáy.\",\"rating\":9.0},\n  {\"id\":740925,\"suggestedTranslation\":\"Đang bùng cháy dữ dội đấy.\",\"rating\":9.0},\n  {\"id\":740926,\"suggestedTranslation\":\"Sắp tắt đến nơi rồi kìa.\",\"rating\":9.0},\n  {\"id\":740927,\"suggestedTranslation\":\"Cũng ấm cúng nhất có thể ở cái chốn này rồi.\",\"rating\":9.0},\n  {\"id\":740928,\"suggestedTranslation\":\"Hồi nhỏ em gái tôi sợ bóng tối lắm.\",\"rating\":9.0},\n  {\"id\":740929,\"suggestedTranslation\":\"Mấy thứ \\\"ma thuật\\\" này đúng là nguy hiểm chết người.\",\"rating\":9.0},\n  {\"id\":740930,\"suggestedTranslation\":\"Cần châm thêm nhiên liệu rồi.\",\"rating\":9.0},\n  {\"id\":740931,\"suggestedTranslation\":\"Chúng ta nên sản xuất hàng loạt mấy thứ này mới được.\",\"rating\":9.0},\n  {\"id\":740932,\"suggestedTranslation\":\"Hãy chứng kiến hiệu suất của tương lai đi!\",\"rating\":9.0},\n  {\"id\":740933,\"suggestedTranslation\":\"Tôi thà ăn để sống qua ngày còn hơn là chết đói.\",\"rating\":9.0},\n  {\"id\":740934,\"suggestedTranslation\":\"Có vẻ hơi bất công cho việc Câu Cá nhỉ.\",\"rating\":9.0},\n  {\"id\":740935,\"suggestedTranslation\":\"Không phải là cách tồi để xả hơi.\",\"rating\":9.0},\n  {\"id\":740936,\"suggestedTranslation\":\"Ăn như thế này có cất vào Két Sắt được không đấy?\",\"rating\":9.0},\n  {\"id\":740937,\"suggestedTranslation\":\"Chẳng có gì hoa mỹ cả, đúng kiểu tôi thích.\",\"rating\":9.0},\n  {\"id\":740938,\"suggestedTranslation\":\"Thơm mùi biển cả ghê.\",\"rating\":9.0},\n  {\"id\":740939,\"suggestedTranslation\":\"Cậu chắc đó là cá chứ? Trông giống tôm tép Câu Cá quá vậy.\",\"rating\":9.0},\n  {\"id\":740940,\"suggestedTranslation\":\"Tôi không bao giờ chối từ một miếng mồi ngon đâu!\",\"rating\":9.0},\n  {\"id\":740941,\"suggestedTranslation\":\"Thơm mùi biển cả ghê.\",\"rating\":9.0},\n  {\"id\":740942,\"suggestedTranslation\":\"Tôi chưa từng thấy con Cá nào có