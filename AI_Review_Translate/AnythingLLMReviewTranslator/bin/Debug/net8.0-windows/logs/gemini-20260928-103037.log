            "text": "[\n  {\"id\": 738937, \"suggestedTranslation\": \"Chắc tôi có thể cột dây thừng nếu muốn quay lại.\", \"rating\": 9.0},\n  {\"id\": 738938, \"suggestedTranslation\": \"Tôi phải làm gì với cái quả bóng ngốc nghếch này đây?\", \"rating\": 9.0},\n  {\"id\": 738939, \"suggestedTranslation\": \"Đẹp ghê. Giờ thì làm gì với nó đây?\", \"rating\": 9.0},\n  {\"id\": 738940, \"suggestedTranslation\": \"Nào nàooo!\", \"rating\": 9.0},\n  {\"id\": 738941, \"suggestedTranslation\": \"Đi nào!\", \"rating\": 9.0},\n  {\"id\": 738942, \"suggestedTranslation\": \"Ai muốn bị nghiền nát nào?!\", \"rating\": 9.0},\n  {\"id\": 738943, \"suggestedTranslation\": \"Đần như cục gạch, nhưng tôi vẫn thích ngươi.\", \"rating\": 9.0},\n  {\"id\": 738944, \"suggestedTranslation\": \"Cái tháp mà không cháy được thì tích sự gì?\", \"rating\": 9.0},\n  {\"id\": 738945, \"suggestedTranslation\": \"Ngươi bị sao thế? Giờ lại muốn gì nữa?\", \"rating\": 9.0},\n  {\"id\": 738946, \"suggestedTranslation\": \"Tuyệt, giờ thì đặt nó ở đâu nhỉ?\", \"rating\": 9.0},\n  {\"id\": 738947, \"suggestedTranslation\": \"Nó có chức năng đốt không?\", \"rating\": 9.0},\n  {\"id\": 738948, \"suggestedTranslation\": \"Thật là ngớ ngẩn.\", \"rating\": 9.0},\n  {\"id\": 738949, \"suggestedTranslation\": \"Cái chất nhầy nhụa gì thế kia?\", \"rating\": 9.0},\n  {\"id\": 738950, \"suggestedTranslation\": \"Lắm lũ côn trùng chết thế.\", \"rating\": 9.0},\n  {\"id\": 738951, \"suggestedTranslation\": \"Nhìn cho kỹ hướng ngươi đang chĩa vào đi!\", \"rating\": 9.0},\n  {\"id\": 738952, \"suggestedTranslation\": \"Đứa quái nào làm hỏng cái này thế?\", \"rating\": 9.0},\n  {\"id\": 738953, \"suggestedTranslation\": \"Mong là nó hoạt động!\", \"rating\": 9.0},\n  {\"id\": 738954, \"suggestedTranslation\": \"Ai đó quên cắm điện rồi.\", \"rating\": 9.0},\n  {\"id\": 738955, \"suggestedTranslation\": \"Cái công tắc chết tiệt bị hỏng.\", \"rating\": 9.0},\n  {\"id\": 738956, \"suggestedTranslation\": \"Đốt cháy chúng nó đi!\", \"rating\": 9.0},\n  {\"id\": 738957, \"suggestedTranslation\": \"Ơ, có rau củ đang ẩn nấp bên dưới kìa!\", \"rating\": 9.0},\n  {\"id\": 738958, \"suggestedTranslation\": \"Một đống bầy nhầy hôi hám to lớn.\", \"rating\": 9.0},\n  {\"id\": 738959, \"suggestedTranslation\": \"Lửa cho lưỡi tôi đây.\", \"rating\": 9.0},\n  {\"id\": 738960, \"suggestedTranslation\": \"Hừ! Nhìn buồn cười phải biết!\", \"rating\": 9.0},\n  {\"id\": 738961, \"suggestedTranslation\": \"Ai nhặt được người đó giữ!\", \"rating\": 9.0},\n  {\"id\": 738962, \"suggestedTranslation\": \"Đố biết được ai thực sự đang trốn dưới cái mũ trùm đó.\", \"rating\": 9.0},\n  {\"id\": 738963, \"suggestedTranslation\": \"Hừm, cái này có vẻ vui đây.\", \"rating\": 9.0},\n  {\"id\": 738964, \"suggestedTranslation\": \"Trông tôi có giống kiểu người hay sửa đồ không? Hừ, đượooo rồi...\", \"rating\": 9.0},\n  {\"id\": 738965, \"suggestedTranslation\": \"Việc làm ruộng vừa bớt nhàm chán đi một chút.\", \"rating\": 9.0},\n  {\"id\": 738966, \"suggestedTranslation\": \"Ít ra nó cũng che được mưa.\", \"rating\": 9.0},\n  {\"id\": 738967, \"suggestedTranslation\": \"NÀY WARLY! Tôi ăn cái này được không?\", \"rating\": 9.0},\n  {\"id\": 738968, \"suggestedTranslation\": \"Chào bánh quế nhé!\", \"rating\": 9.0},\n  {\"id\": 738969, \"suggestedTranslation\": \"Trông đáng ngờ đấy.\", \"rating\": 9.0},\n  {\"id\": 738970, \"suggestedTranslation\": \"Vẫn chưa quá muộn đâu...\", \"rating\": 9.0},\n  {\"id\": 738971, \"suggestedTranslation\": \"Tôi nên thiêu rụi cái này, mà tôi không đùa đâu đấy.\", \"rating\": 9.0},\n  {\"id\": 738972, \"suggestedTranslation\": \"Mấy thứ này làm tôi thấy căng thẳng.\", \"rating\": 9.0},\n  {\"id\": 738973, \"suggestedTranslation\": \"Cái chân robot sát thủ ngốc nghếch.\", \"rating\": 9.0},\n  {\"id\": 738974, \"suggestedTranslation\": \"Tôi biết ngay nó là một con robot sát thủ mà!\", \"rating\": 9.0},\n  {\"id\": 738975, \"suggestedTranslation\": \"Cái đống phế liệu gì ở dưới kia thế?\", \"rating\": 9.0},\n  {\"id\": 738976, \"suggestedTranslation\": \"Có gì ghê gớm đâu, nó ngăn tôi thế nào được.\", \"rating\": 9.0},\n  {\"id\": 738977, \"suggestedTranslation\": \"Xì, tầm này thì nó chỉ là đồ phụ tùng thôi.\", \"rating\": 9.0},\n  {\"id\": 738978, \"suggestedTranslation\": \"Cút đi chỗ khác, mấy cái thùng rác bay lượn!\", \"rating\": 9.0},\n  {\"id\": 738979, \"suggestedTranslation\": \"Làm gì đi chứ!\", \"rating\": 9.0},\n  {\"id\": 738980, \"suggestedTranslation\": \"Phế liệu thừa.\", \"rating\": 9.0},\n  {\"id\": 738981, \"suggestedTranslation\": \"Tôi có thể sửa hoặc rã nó ra lấy phụ tùng, nhưng tôi thiêu rụi luôn được không?\", \"rating\": 9.0},\n  {\"id\": 738982, \"suggestedTranslation\": \"Còn nhớ lúc bọn này tìm cách giết chúng ta không?\", \"rating\": 9.0},\n  {\"id\": 738983, \"suggestedTranslation\": \"Mấy người phiền phức thật đấy!\", \"rating\": 9.0},\n  {\"id\": 738984, \"suggestedTranslation\": \"Làm gì đi chứ!\", \"rating\": 9.0},\n  {\"id\": 738985, \"suggestedTranslation\": \"Đồ chơi hay đấy.\", \"rating\": 9.0},\n  {\"id\": 738986, \"suggestedTranslation\": \"Ồ, hóa ra là một chiếc mũ dạy mọt sách cách đánh nhau!\", \"rating\": 9.0},\n  {\"id\": 738987, \"suggestedTranslation\": \"Tôi phải làm gì với cái này đây?\", \"rating\": 9.0},\n  {\"id\": 738988, \"suggestedTranslation\": \"Làm tôi thấy ngột ngạt quá.\", \"rating\": 9.0},\n  {\"id\": 738989, \"suggestedTranslation\": \"Sao lão ta không tìm đại một hòn đảo lớn hơn chứ?\", \"rating\": 9.0},\n  {\"id\": 738990, \"suggestedTranslation\": \"Gạt cần luôn đi nào.\", \"rating\": 9.0},\n  {\"id\": 738991, \"suggestedTranslation\": \"Chập điện cháy nổ chán chết.\", \"rating\": 9.0},\n  {\"id\": 738992, \"suggestedTranslation\": \"Sao cái găng tay này lại khiến tôi nổi da gà thế nhỉ? Đốt nó đi!\", \"rating\": 9.0},\n  {\"id\": 738993, \"suggestedTranslation\": \"Vô lý hết chỗ nói! Đốt nó đi!\", \"rating\": 9.0},\n  {\"id\": 738994, \"suggestedTranslation\": \"Lẽ ra nên có ai đó đốt đống sắt vụn này đi.\", \"rating\": 9.0},\n  {\"id\": 738995, \"suggestedTranslation\": \"Trông có vẻ quan trọng. Lát nữa tôi đốt.\", \"rating\": 9.0},\n  {\"id\": 738996, \"suggestedTranslation\": \"Hự, người già lúc nào cũng cần người khác giúp cái này cái nọ.\", \"rating\": 9.0},\n  {\"id\": 738997, \"suggestedTranslation\": \"Giờ sao nữa?\", \"rating\": 9.0},\n  {\"id\": 738998, \"suggestedTranslation\": \"Đúng rồi đấy, ông già. Đi chỗ khác chơi đi.\", \"rating\": 9.0},\n  {\"id\": 738999, \"suggestedTranslation\": \"Tôi có cảm giác cái này là của ông già đó.\", \"rating\": 9.0},\n  {\"id\": 739000, \"suggestedTranslation\": \"Hừ, sao ông già đó không tự đi mà lấy chứ?\", \"rating\": 9.0},\n  {\"id\": 739001, \"suggestedTranslation\": \"Ừ, nhìn giống cái Đồ-Cái-Thứ-Gì-Đó thật! Hoặc là cái Cái-Gì-Mà-Gọi-Là...\", \"rating\": 9.0},\n  {\"id\": 739002, \"suggestedTranslation\": \"Chà, trông có vẻ không bắt lửa cho lắm. Đem cho ông già đó luôn vậy.\", \"rating\": 9.0},\n  {\"id\": 739003, \"suggestedTranslation\": \"Trông như đống rác khoa học quái dị nào đó. Chắc đây là thứ ông già đó đang tìm à?\", \"rating\": 9.0},\n  {\"id\": 739004, \"suggestedTranslation\": \"Thế, chúng ta sẽ bắt ai đi ván mộc đây?\", \"rating\": 9.0},\n  {\"id\": 739005, \"suggestedTranslation\": \"Thế, chúng ta sẽ bắt ai đi ván mộc đây?\", \"rating\": 9.0},\n  {\"id\": 739006, \"suggestedTranslation\": \"Thế, chúng ta sẽ bắt ai đi ván mộc đây?\", \"rating\": 9.0},\n  {\"id\": 739007, \"suggestedTranslation\": \"Tôi không thèm đặt chân lên đó đâu, trông có đẹp mấy đi nữa cũng thế!\", \"rating\": 9.0},\n  {\"id\": 739008, \"suggestedTranslation\": \"Cái này dùng để chọc lò thì tuyệt.\", \"rating\": 9.0},\n  {\"id\": 739009, \"suggestedTranslation\": \"Không thể làm tường bằng thứ gì khác khả dĩ hơn được à?\", \"rating\": 9.0},\n  {\"id\": 739010, \"suggestedTranslation\": \"Hựiii, xây dựng mệt mỏi quá đi...\", \"rating\": 9.0},\n  {\"id\": 739011, \"suggestedTranslation\": \"Nó bắt lửa đấy chứ!\", \"rating\": 9.0},\n  {\"id\": 739012, \"suggestedTranslation\": \"Trông dễ bắt lửa thế không biết!\", \"rating\": 9.0},\n  {\"id\": 739013, \"suggestedTranslation\": \"Hừm. Không biết mấy cái này có cháy không nhỉ.\", \"rating\": 9.0},\n  {\"id\": 739014, \"suggestedTranslation\": \"Tạm thời an toàn rồi.\", \"rating\": 9.0},\n  {\"id\": 739015, \"suggestedTranslation\": \"Chắc tôi vác nổi nó đấy.\", \"rating\": 9.0},\n  {\"id\": 739016, \"suggestedTranslation\": \"Và chúng sẽ hì hục hộc tốc thổi bay!\", \"rating\": 9.0},\n  {\"id\": 739017, \"suggestedTranslation\": \"Và chúng sẽ hì hục hộc tốc thổi bay!\", \"rating\": 9.0},\n  {\"id\": 739018, \"suggestedTranslation\": \"Mấy thứ đó có vừa túi tôi không nhỉ?\", \"rating\": 9.0},\n  {\"id\": 739019, \"suggestedTranslation\": \"Trông có nguy cơ gây cháy đấy. Tin tôi đi.\", \"rating\": 9.0},\n  {\"id\": 739020, \"suggestedTranslation\": \"Cái này sẽ có nguy cơ gây cháy đấy. Tin tôi đi.\", \"rating\": 9.0},\n  {\"id\": 739021, \"suggestedTranslation\": \"Ờ. Tạm được.\", \"rating\": 9.0},\n  {\"id\": 739022, \"suggestedTranslation\": \"Ờ. Tạm được.\", \"rating\": 9.0},\n  {\"id\": 739023, \"suggestedTranslation\": \"Mấy cục này nặng bất ngờ đấy.\", \"rating\": 9.0},\n  {\"id\": 739024, \"suggestedTranslation\": \"Nó bén lửa thật đấy!\", \"rating\": 9.0},\n  {\"id\": 739025, \"suggestedTranslation\": \"Cái đó hoàn toàn có thể bén lửa.\", \"rating\": 9.0},\n  {\"id\": 739026, \"suggestedTranslation\": \"Tôi ghét trốn tránh lắm.\", \"rating\": 9.0},\n  {\"id\": 739027, \"suggestedTranslation\": \"Đừng bám theo tôi nữa!\", \"rating\": 9.0},\n  {\"id\": 739028, \"suggestedTranslation\": \"Nhìn cũng hay ho phết.\", \"rating\": 9.0},\n  {\"id\": 739029, \"suggestedTranslation\": \"Tôi không thèm bước vào đó đâu. Ghê quá!\", \"rating\": 9.0},\n  {\"id\": 739030, \"suggestedTranslation\": \"Sao ai cũng có nhà đẹp hơn tôi thế nhỉ?\", \"rating\": 9.0},\n  {\"id\": 739031, \"suggestedTranslation\": \"Húp húp húp.\", \"rating\": 9.0},\n  {\"id\": 739032, \"suggestedTranslation\": \"Tên ngoan hiền đó cuối cùng cũng nổi điên rồi!\", \"rating\": 9.0},\n  {\"id\": 739033, \"suggestedTranslation\": \"Ai mới là kẻ \\\"không biết an toàn phòng cháy\\\" hả, %s?\", \"rating\": 9.0},\n  {\"id\": 739034, \"suggestedTranslation\": \"Chào %s!\", \"rating\": 9.0},\n  {\"id\": 739035, \"suggestedTranslation\": \"Tôi nghĩ cậu ta thực sự đang thấy vui đấy.\", \"rating\": 9.0},\n  {\"id\": 739036, \"suggestedTranslation\": \"Này %s, chúng ta nói chuyện này chút đi...\", \"rating\": 9.0},\n  {\"id\": 739037, \"suggestedTranslation\": \"Rồi rồi, tôi xin lỗi vì đã gọi cậu là đồ ngoan hiền.\", \"rating\": 9.0},\n  {\"id\": 739038, \"suggestedTranslation\": \"Thôi được rồi, thực ra tôi không phải \\\"tham gia\\\" hướng đạo sinh mà là \\\"xâm nhập\\\" hướng đạo sinh.\", \"rating\": 9.0},\n  {\"id\": 739039, \"suggestedTranslation\": \"Này, cẩn thận đấy!\", \"rating\": 9.0},\n  {\"id\": 739040, \"suggestedTranslation\": \"Này %s! Chừa lại chút củi lửa cho tôi với!\", \"rating\": 9.0},\n  {\"id\": 739041, \"suggestedTranslation\": \"Chào %s!\", \"rating\": 9.0},\n  {\"id\": 739042, \"suggestedTranslation\": \"Ờ... Tôi đoán là có gì đó không ổn rồi.\", \"rating\": 9.0},\n  {\"id\": 739043, \"suggestedTranslation\": \"Tương lai của cô vừa tan thành mây khói rồi đấy, kẻ sát nhân!\", \"rating\": 9.0},\n  {\"id\": 739044, \"suggestedTranslation\": \"%s luôn xuất hiện bất cứ khi nào chúng ta cần.\", \"rating\": 9.0},\n  {\"id\": 739045, \"suggestedTranslation\": \"Lạ thật.\", \"rating\": 9.0},\n  {\"id\": 739046, \"suggestedTranslation\": \"Nghe nói anh thu nhận tro à?\", \"rating\": 9.0},\n  {\"id\": 739047, \"suggestedTranslation\": \"Đúng rồi! Cháy đi!\", \"rating\": 9.0},\n  {\"id\": 739048, \"suggestedTranslation\": \"Ối, lửa tắt mất tiêu rồi.\", \"rating\": 9.0},\n  {\"id\": 739049, \"suggestedTranslation\": \"Tôi muốn châm lửa đốt nó quá.\", \"rating\": 9.0},\n  {\"id\": 739050, \"suggestedTranslation\": \