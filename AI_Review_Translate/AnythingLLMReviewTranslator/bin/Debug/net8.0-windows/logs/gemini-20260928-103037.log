{\"id\": 742468, \"suggestedTranslation\": \"Nhóc còn khối việc phải làm đấy, nhóc con.\", \"rating\": 8.5},\n  {\"id\": 742469, \"suggestedTranslation\": \"Ta thấy được cái mỏ rồi nè!\", \"rating\": 8.5},\n  {\"id\": 742470, \"suggestedTranslation\": \"Trông hấp dẫn ghê gớm.\", \"rating\": 8.5},\n  {\"id\": 742471, \"suggestedTranslation\": \"Có kẻ vừa dọn ra khỏi tổ kìa.\", \"rating\": 8.5},\n  {\"id\": 742472, \"suggestedTranslation\": \"Cái gì thế này, loại trứng luộc sang chảnh nào à?\", \"rating\": 8.5},\n  {\"id\": 742473, \"suggestedTranslation\": \"Thế này thì ấm bụng ngay lập tức!\", \"rating\": 8.5},\n  {\"id\": 742474, \"suggestedTranslation\": \"Tất cả chúng ta đều phải trải qua cái sân khấu đầy ngượng ngùng đó.\", \"rating\": 8.5},\n  {\"id\": 742475, \"suggestedTranslation\": \"Ngươi không biết đói là gì à?!\", \"rating\": 8.5},\n  {\"id\": 742476, \"suggestedTranslation\": \"Ngủ ngon nhé, cục bông xù ngượng ngùng.\", \"rating\": 8.5},\n  {\"id\": 742477, \"suggestedTranslation\": \"Đừng có lải nhải nữa, ta sẽ cho ngươi ăn khi có thể!\", \"rating\": 8.5},\n  {\"id\": 742478, \"suggestedTranslation\": \"Vẫn phải mày mò chỉnh chọt thêm chút nữa.\", \"rating\": 8.5},\n  {\"id\": 742479, \"suggestedTranslation\": \"Hoạt động hoàn toàn bình thường.\", \"rating\": 8.5},\n  {\"id\": 742480, \"suggestedTranslation\": \"Được rồi đấy.\", \"rating\": 8.5},\n  {\"id\": 742481, \"suggestedTranslation\": \"Đồ chơi công nghệ này sinh ra là dành cho ta rồi.\", \"rating\": 8.5},\n  {\"id\": 742482, \"suggestedTranslation\": \"Vẫn cần phải mày mò thêm chút ít.\", \"rating\": 8.5},\n  {\"id\": 742483, \"suggestedTranslation\": \"Tiến triển khá phết rồi đây.\", \"rating\": 8.5},\n  {\"id\": 742484, \"suggestedTranslation\": \"Kéo cần gạt / đòn bẩy làm ta thấy dễ chịu hơn hẳn.\", \"rating\": 8.5},\n  {\"id\": 742485, \"suggestedTranslation\": \"Lên dây cót thôi nào. Hà!\", \"rating\": 8.5},\n  {\"id\": 742486, \"suggestedTranslation\": \"Ghê quá. Hàng tự chế.\", \"rating\": 8.5},\n  {\"id\": 742487, \"suggestedTranslation\": \"Đồ kim loại nhỏ xinh ghê.\", \"rating\": 8.5},\n  {\"id\": 742488, \"suggestedTranslation\": \"Ý mi là cái cây gậy này có \\\"ma thuật\\\" á?\", \"rating\": 8.5},\n  {\"id\": 742489, \"suggestedTranslation\": \"Chuẩn luôn. Y như đi cắm trại vậy.\", \"rating\": 8.5},\n  {\"id\": 742490, \"suggestedTranslation\": \"Dựng lều lên là phần tuyệt vời nhất khi đi cắm trại.\", \"rating\": 8.5},\n  {\"id\": 742491, \"suggestedTranslation\": \"Bỏ tay ra mau!\", \"rating\": 8.5},\n  {\"id\": 742492, \"suggestedTranslation\": \"Một cây gậy phang cực đỉnh.\", \"rating\": 8.5},\n  {\"id\": 742493, \"suggestedTranslation\": \"Trông có vẻ lắm đốm ghê ta! Hà!\", \"rating\": 8.5},\n  {\"id\": 742494, \"suggestedTranslation\": \"Mấy thứ này không có hồi kết à?\", \"rating\": 8.5},\n  {\"id\": 742495, \"suggestedTranslation\": \"Đừng có mà tơ tưởng đến chuyện chạm vào người ta.\", \"rating\": 8.5},\n  {\"id\": 742496, \"suggestedTranslation\": \"Bỏ cái tay thối ra, bạn hiền.\", \"rating\": 8.5},\n  {\"id\": 742497, \"suggestedTranslation\": \"Ta từng làm mấy việc tồi tệ hơn thế này nhiều.\", \"rating\": 8.5},\n  {\"id\": 742498, \"suggestedTranslation\": \"Chắc nó đang tranh thủ nghỉ giải lao ăn trưa ấy mà.\", \"rating\": 8.5},\n  {\"id\": 742499, \"suggestedTranslation\": \"Trời ạ, cái cây nhỏ xíu đó trông có vẻ không ổn chút nào.\", \"rating\": 8.5},\n  {\"id\": 742500, \"suggestedTranslation\": \"Ái chà! Chập điện rồi!\", \"rating\": 8.5},\n  {\"id\": 742501, \"suggestedTranslation\": \"Có cái gì đó sai sai ở đây... nhưng mà trông đẹp phết.\", \"rating\": 8.5},\n  {\"id\": 742502, \"suggestedTranslation\": \"Trông có vẻ như đang hỏng hóc rồi.\", \"rating\": 8.5},\n  {\"id\": 742503, \"suggestedTranslation\": \"Nó đang chuẩn bị giở trò gì đấy...\", \"rating\": 8.5},\n  {\"id\": 742504, \"suggestedTranslation\": \"Của thiên lại trả cho địa.\", \"rating\": 8.5},\n  {\"id\": 742505, \"suggestedTranslation\": \"Thôi thì rương miễn phí tội gì không nhận.\", \"rating\": 8.5},\n  {\"id\": 742506, \"suggestedTranslation\": \"Sao cái rương đó trông như đang bị chập mạch thế nhỉ?\", \"rating\": 8.5},\n  {\"id\": 742507, \"suggestedTranslation\": \"Ta rất thích làm việc với mấy nguyên liệu mới.\", \"rating\": 8.5},\n  {\"id\": 742508, \"suggestedTranslation\": \"Đồ đạc ngày xưa làm ra là để dùng cho bền.\", \"rating\": 8.5},\n  {\"id\": 742509, \"suggestedTranslation\": \"Chỉ cần lau chà lại một chút là sáng bóng ngay.\", \"rating\": 8.5},\n  {\"id\": 742510, \"suggestedTranslation\": \"Ngửi cứ giống như xăng ấy.\", \"rating\": 8.5},\n  {\"id\": 742511, \"suggestedTranslation\": \"Xem ra ta phải tự thân vận động tìm chúng nó rồi.\", \"rating\": 8.5},\n  {\"id\": 742512, \"suggestedTranslation\": \"Hừ. Chưa từng nghĩ có ngày mấy con mèo ú này lại đi làm thuê cho TA đâu.\", \"rating\": 8.5},\n  {\"id\": 742513, \"suggestedTranslation\": \"Trông có vẻ có kẻ nào đó hớt tay trên đống đồ này trước rồi.\", \"rating\": 8.5},\n  {\"id\": 742514, \"suggestedTranslation\": \"Ta có cảm giác có một con mèo trúc con ở quanh đây.\", \"rating\": 8.5},\n  {\"id\": 742515, \"suggestedTranslation\": \"Nó không còn đánh hơi được dấu vết nào nữa rồi.\", \"rating\": 8.5},\n  {\"id\": 742516, \"suggestedTranslation\": \"Mắt tinh đấy, đại gia!\", \"rating\": 8.5},\n  {\"id\": 742517, \"suggestedTranslation\": \"Có lẽ hơi xa một chút.\", \"rating\": 8.5},\n  {\"id\": 742518, \"suggestedTranslation\": \"Ồ, nó bắt đầu đánh hơi thấy mùi rồi kìa.\", \"rating\": 8.5},\n  {\"id\": 742519, \"suggestedTranslation\": \"Con đó đang làm việc cho kẻ khác mất rồi.\", \"rating\": 8.5},\n  {\"id\": 742520, \"suggestedTranslation\": \"Mấy thứ ương ngạnh này.\", \"rating\": 8.5},\n  {\"id\": 742521, \"suggestedTranslation\": \"May quá tìm ra được công dụng cho đám cỏ dại đó rồi.\", \"rating\": 8.5},\n  {\"id\": 742522, \"suggestedTranslation\": \"Mấy cái này khô ráo và ngon nghẻ phết.\", \"rating\": 8.5},\n  {\"id\": 742523, \"suggestedTranslation\": \"Ta không quản nổi vụ này đâu!\", \"rating\": 8.5},\n  {\"id\": 742524, \"suggestedTranslation\": \"Nó trâu bò hơn vẻ bề ngoài đấy... nhưng ta cũng thế!\", \"rating\": 8.5},\n  {\"id\": 742525, \"suggestedTranslation\": \"Hố trống hoác chẳng có gì sất.\", \"rating\": 8.5},\n  {\"id\": 742526, \"suggestedTranslation\": \"Ta lo được hết.\", \"rating\": 8.5},\n  {\"id\": 742527, \"suggestedTranslation\": \"Có cái gì ở trong đó kìa.\", \"rating\": 8.5},\n  {\"id\": 742528, \"suggestedTranslation\": \"Phải biết trân trọng rau củ tươi ngon chứ.\", \"rating\": 8.5},\n  {\"id\": 742529, \"suggestedTranslation\": \"Ta thích ăn kiểu rán giòn và còn xanh hơn.\", \"rating\": 8.5},\n  {\"id\": 742530, \"suggestedTranslation\": \"Mi có thể làm nguyên một nồi mì Ý to bự với từng này đấy.\", \"rating\": 8.5},\n  {\"id\": 742531, \"suggestedTranslation\": \"Ta chịu chẳng biết chúng sẽ lớn thành cái gì nữa.\", \"rating\": 8.5},\n  {\"id\": 742532, \"suggestedTranslation\": \"Đúng là tư bản trưởng giả.\", \"rating\": 8.5},\n  {\"id\": 742533, \"suggestedTranslation\": \"Max giỏi giang quá mức trong việc giấu diếm mọi thứ dưới cái mũ của lão ta rồi đấy.\", \"rating\": 8.5},\n  {\"id\": 742534, \"suggestedTranslation\": \"Đôi khi vẻ đẹp lại nằm ở thiết kế tối giản.\", \"rating\": 8.5},\n  {\"id\": 742535, \"suggestedTranslation\": \"Thế này mới gọi là bánh nhân thịt chất lượng chứ!\", \"rating\": 8.5},\n  {\"id\": 742536, \"suggestedTranslation\": \"Hừng hực khí thế lên đường nào.\", \"rating\": 8.5},\n  {\"id\": 742537, \"suggestedTranslation\": \"Nó chạy bằng \\\"ma thuật\\\" thay vì điện năng.\", \"rating\": 8.5},\n  {\"id\": 742538, \"suggestedTranslation\": \"Lên đường mau nào.\", \"rating\": 8.5},\n  {\"id\": 742539, \"suggestedTranslation\": \"Nó chỉ là... một hòn đá tảng thôi. Hừm.\", \"rating\": 8.5},\n  {\"id\": 742540, \"suggestedTranslation\": \"Đủ năng lượng cho một ngày làm việc dài đằng đẵng.\", \"rating\": 8.5},\n  {\"id\": 742541, \"suggestedTranslation\": \"Lão ta chỉ là một gã đầu đất bự con thôi.\", \"rating\": 8.5},\n  {\"id\": 742542, \"suggestedTranslation\": \"Đúng là một tuyệt tác.\", \"rating\": 8.5},\n  {\"id\": 742543, \"suggestedTranslation\": \"Tất cả những cạm bẫy cho một bữa tối ngon lành. Hà!\", \"rating\": 8.5},\n  {\"id\": 742544, \"suggestedTranslation\": \"Cái tên thực vật nhóc con đó đã bày ra đấy.\", \"rating\": 8.5},\n  {\"id\": 742545, \"suggestedTranslation\": \"Nó nguội ngắt rồi kìa.\", \"rating\": 8.5},\n  {\"id\": 742546, \"suggestedTranslation\": \"Có ai thấy thèm tiệc nướng BBQ không nào?\", \"rating\": 8.5},\n  {\"id\": 742547, \"suggestedTranslation\": \"Cẩn thận đấy, chất độc tràn ra nguy hiểm lắm!\", \"rating\": 8.5},\n  {\"id\": 742548, \"suggestedTranslation\": \"Và đó là lý do tại sao cậu nên luôn đi giày bảo hộ đế dày.\", \"rating\": 8.5},\n  {\"id\": 742549, \"suggestedTranslation\": \"Thứ đó đúng là hiểm họa nơi làm việc.\", \"rating\": 8.5},\n  {\"id\": 742550, \"suggestedTranslation\": \"Đi đứng cẩn thận vào đấy.\", \"rating\": 8.5},\n  {\"id\": 742551, \"suggestedTranslation\": \"Hàng loạt cái nanh trông gớm ghiếc thật.\", \"rating\": 8.5},\n  {\"id\": 742552, \"suggestedTranslation\": \"Đó đúng là một mối họa an toàn lao động.\", \"rating\": 8.5},\n  {\"id\": 742553, \"suggestedTranslation\": \"Hy vọng bên trong không có thứ gì ngon lành bị cháy.\", \"rating\": 8.5},\n  {\"id\": 742554, \"suggestedTranslation\": \"Hàng thủ công nên biết ngay là không đạt tiêu chuẩn rồi.\", \"rating\": 8.5},\n  {\"id\": 742555, \"suggestedTranslation\": \"Nó mới được cải tiến và nâng cấp đấy.\", \"rating\": 8.5},\n  {\"id\": 742556, \"suggestedTranslation\": \"Ta chẳng cần phải bận tâm về cái đó làm gì.\", \"rating\": 8.5},\n  {\"id\": 742557, \"suggestedTranslation\": \"Một lùm cây um tùm.\", \"rating\": 8.5},\n  {\"id\": 742558, \"suggestedTranslation\": \"Được rồi hỡi mấy cái cây, đến lúc ăn con sâu của các ngươi rồi đây!\", \"rating\": 8.5},\n  {\"id\": 742559, \"suggestedTranslation\": \"Nó sắp quỵ xuống đến nơi rồi.\", \"rating\": 8.5},\n  {\"id\": 742560, \"suggestedTranslation\": \"Kiểu gì cũng để lại một vết lõm cho xem.\", \"rating\": 8.5},\n  {\"id\": 742561, \"suggestedTranslation\": \"Trông có vẻ hơi nặng phần trên.\", \"rating\": 8.5},\n  {\"id\": 742562, \"suggestedTranslation\": \"Cục cưng nhỏ kiên cường ghê.\", \"rating\": 8.5},\n  {\"id\": 742563, \"suggestedTranslation\": \"Nó chứa đầy tiềm năng.\", \"rating\": 8.5},\n  {\"id\": 742564, \"suggestedTranslation\": \"Ta chẳng sợ phải làm nổi sóng gió đâu! Hà!\", \"rating\": 8.5},\n  {\"id\": 742565, \"suggestedTranslation\": \"Ta chưa bao giờ thích đạn cẩm thạch cho lắm.\", \"rating\": 8.5},\n  {\"id\": 742566, \"suggestedTranslation\": \"Toàn sủa to chứ có cắn được ai đâu. Hà!\", \"rating\": 8.5},\n  {\"id\": 742567, \"suggestedTranslation\": \"Biết đâu con bot này sẽ cho phép ta thò lò mò mẫm bên trong nó.\", \"rating\": 8.5},\n  {\"id\": 742568, \"suggestedTranslation\": \"Này Willow! Thách cô dám ăn nó đấy!\", \"rating\": 8.5},\n  {\"id\": 742569, \"suggestedTranslation\": \"Trông giống lão chủ nhà cũ của ta thế. Hà!\", \"rating\": 8.5},\n  {\"id\": 742570, \"suggestedTranslation\": \"Trà chát không phải gu của ta lắm.\", \"rating\": 8.5},\n  {\"id\": 742571, \"suggestedTranslation\": \"Hơi mang tầm vóc trí thức quá nhỉ, không nghĩ thế à?\", \"rating\": 8.5},\n  {\"id\": 742572, \"suggestedTranslation\": \"Hơi mang tầm vóc trí thức quá nhỉ, không nghĩ thế à?\", \"rating\": 8.5},\n  {\"id\": 742573, \"suggestedTranslation\": \"Thật hoài phí kim loại tốt.\", \"rating\": 8.5},\n  {\"id\": 742574, \"suggestedTranslation\": \"Làm thủ công á. Khiếp.\", \"rating\": 8.5},\n  {\"id\": 742575, \"suggestedTranslation\": \"Đây chính là lý do tại sao chúng ta cần tiêu chuẩn sản xuất.\", \"rating\": 8.5},\n  {\"id\": 742576, \"suggestedTranslation\": \"Chẳng có đoạn phim nào để mà phát ra âm thanh cả.\", \"rating\": 8.5},\n  {\"id\": 742577, \"suggestedTranslation\": \"Ta có thể tự gãi lưng mình đấy! Nhìn này!\", \"rating\": 8.5},\n  {\"id\": 742578, \"suggestedTranslation\": \"Trông đậm chất cơ khí ghê.\", \"rating\": 8.5},\n  {\"id\": 742579, \"suggestedTranslation\": \"Ta chẳng có xó xỉnh nào dùng đến thứ đó cả.\", \"rating\": 8.5},\n  {\"id\": 742580, \"suggestedTranslation\": \"Ta thích tự đi giày bảo hộ cho vừa chân hơn.\", \"rating\": 8.5},\n  {\"id\": 742581, \"suggestedTranslation\": \"Chất lượng đáng tin cậy của một sản phẩm sản xuất hàng loạt!\", \"rating\": 8.5},\n  {\"id\": 742582, \"suggestedTranslation\": \"Hà! Kinh tởm!\", \"rating\": 8.5},\n  {\"id\": 742583, \"suggestedTranslation\": \"Thứ đó là một sự sỉ nhục đối với ngành chế tạo.\", \"rating\": 8.5},\n  {\"id\": 742584, \"suggestedTranslation\": \"Ra ngoài này thì chẳng có mấy ích lợi đâu.\", \"rating\": 8.5},\n  {\"id\": 742585, \"suggestedTranslation\": \"Đó là một con xe.\", \"rating\": 8.5}\n]",
