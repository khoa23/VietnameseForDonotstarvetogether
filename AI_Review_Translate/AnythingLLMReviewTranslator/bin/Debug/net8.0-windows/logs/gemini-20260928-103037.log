nslation\": \"Gai góc quá.\", \"rating\": 0.0},\n  {\"id\": 740427, \"suggestedTranslation\": \"Chắc chúng ta biết ai là kẻ thắng cuộc rồi đấy.\", \"rating\": 0.0},\n  {\"id\": 740428, \"suggestedTranslation\": \"Bớt gai góc hơn nhiều.\", \"rating\": 0.0},\n  {\"id\": 740429, \"suggestedTranslation\": \"Nó có vị khá cay gắt đấy. Hà!\", \"rating\": 0.0},\n  {\"id\": 740430, \"suggestedTranslation\": \"Trông có vẻ an toàn hơn nhiều rồi.\", \"rating\": 0.0},\n  {\"id\": 740431, \"suggestedTranslation\": \"Trông có vẻ sang chảnh phết, nhưng tôi sẽ thử!\", \"rating\": 0.0},\n  {\"id\": 740432, \"suggestedTranslation\": \"Sắp tàn lụi đến nơi rồi.\", \"rating\": 0.0},\n  {\"id\": 740433, \"suggestedTranslation\": \"Hy vọng nó sẽ cháy đủ qua đêm nay.\", \"rating\": 0.0},\n  {\"id\": 740434, \"suggestedTranslation\": \"Một ngọn lửa bùng cháy khỏe khoắn.\", \"rating\": 0.0},\n  {\"id\": 740435, \"suggestedTranslation\": \"Sắp tắt đến nơi rồi.\", \"rating\": 0.0},\n  {\"id\": 740436, \"suggestedTranslation\": \"Ấm cúng nhất có thể khi ở ngoài này rồi.\", \"rating\": 0.0},\n  {\"id\": 740437, \"suggestedTranslation\": \"Em gái tôi sợ bóng tối.\", \"rating\": 0.0},\n  {\"id\": 740438, \"suggestedTranslation\": \"Điều đó gợi lại bao kỷ niệm.\", \"rating\": 0.0},\n  {\"id\": 740439, \"suggestedTranslation\": \"Tôi nên mang nó theo nếu đi thám hiểm hang động.\", \"rating\": 0.0},\n  {\"id\": 740440, \"suggestedTranslation\": \"Tất cả mau ra khỏi mỏ ngay!!\", \"rating\": 0.0},\n  {\"id\": 740441, \"suggestedTranslation\": \"Đó là một túi quà đấy.\", \"rating\": 0.0},\n  {\"id\": 740442, \"suggestedTranslation\": \"Nó chẳng phải Tin Lizzie đâu.\", \"rating\": 0.0},\n  {\"id\": 740443, \"suggestedTranslation\": \"Tốt hơn là nên nạp cái này vào đại bác.\", \"rating\": 0.0},\n  {\"id\": 740444, \"suggestedTranslation\": \"Giờ thì điều đó sẽ làm bạn phấn chấn ngay thôi!\", \"rating\": 0.0},\n  {\"id\": 740445, \"suggestedTranslation\": \"Trông như nó đang nghỉ giải lao vậy.\", \"rating\": 0.0},\n  {\"id\": 740446, \"suggestedTranslation\": \"Chà, thứ này sẽ không tự xây dựng lên đâu.\", \"rating\": 0.0},\n  {\"id\": 740447, \"suggestedTranslation\": \"Nó làm nơi này trông sang hẳn lên nhỉ?\", \"rating\": 0.0},\n  {\"id\": 740448, \"suggestedTranslation\": \"Chắc xây nhanh thôi.\", \"rating\": 0.0},\n  {\"id\": 740449, \"suggestedTranslation\": \"Không biết nên làm gì với cái này nữa sau khi dựng nó lên đây...\", \"rating\": 0.0},\n  {\"id\": 740450, \"suggestedTranslation\": \"Bắt tay vào làm thôi nào! Hà!\", \"rating\": 0.0},\n  {\"id\": 740451, \"suggestedTranslation\": \"Tôi không phải kiểu người thích mấy món đồ lặt vặt.\", \"rating\": 0.0},\n  {\"id\": 740452, \"suggestedTranslation\": \"Bất cứ ai làm ra thứ này đều có tay nghề rất cừ.\", \"rating\": 0.0},\n  {\"id\": 740453, \"suggestedTranslation\": \"Hơi dễ thương đấy, mà đang ngấm dần vào tôi rồi.\", \"rating\": 0.0},\n  {\"id\": 740454, \"suggestedTranslation\": \"Được rồi, tôi phải xem bên trong có gì mới được...\", \"rating\": 0.0},\n  {\"id\": 740455, \"suggestedTranslation\": \"Được rồi, tôi phải xem bên trong có gì mới được...\", \"rating\": 0.0},\n  {\"id\": 740456, \"suggestedTranslation\": \"Được rồi, tôi phải xem bên trong có gì mới được...\", \"rating\": 0.0},\n  {\"id\": 740457, \"suggestedTranslation\": \"Trông hơi mỏng manh so với gu của tôi, nhưng ít ra nó vẫn hoạt động.\", \"rating\": 0.0},\n  {\"id\": 740458, \"suggestedTranslation\": \"Chắc xây nhanh thôi.\", \"rating\": 0.0},\n  {\"id\": 740459, \"suggestedTranslation\": \"Bạn không thể treo xích đu lên nó được đâu, nhưng trông cũng khá đẹp.\", \"rating\": 0.0},\n  {\"id\": 740460, \"suggestedTranslation\": \"Tôi sẽ dựng nó xong trong một nốt nhạc.\", \"rating\": 0.0},\n  {\"id\": 740461, \"suggestedTranslation\": \"Ừm... sảng khoái ghê...?\", \"rating\": 0.0},\n  {\"id\": 740462, \"suggestedTranslation\": \"Chúng sẽ làm tay tôi bám đầy đất bẩn cho mà xem. Hà!\", \"rating\": 0.0},\n  {\"id\": 740463, \"suggestedTranslation\": \"Tôi sẽ dựng nó lên nhanh như chớp.\", \"rating\": 0.0},\n  {\"id\": 740464, \"suggestedTranslation\": \"Trông có vẻ dễ vướng chân vấp ngã đấy.\", \"rating\": 0.0},\n  {\"id\": 740465, \"suggestedTranslation\": \"Hình như tôi chỉ cần một đồng xu là chơi được.\", \"rating\": 0.0},\n  {\"id\": 740466, \"suggestedTranslation\": \"Eo ôi, con chim mẹ đó chắc phải nuôi lắm miệng ăn lắm đây.\", \"rating\": 0.0},\n  {\"id\": 740467, \"suggestedTranslation\": \"Được thiết kế để lăn.\", \"rating\": 0.0},\n  {\"id\": 740468, \"suggestedTranslation\": \"Gậy gạt bóng tin cậy của tôi đây.\", \"rating\": 0.0},\n  {\"id\": 740469, \"suggestedTranslation\": \"Hàng đặc biệt kiểu Winona, tới liền đây!\", \"rating\": 0.0},\n  {\"id\": 740470, \"suggestedTranslation\": \"Cứ làm quen với trò chơi một cách nhẹ nhàng đã.\", \"rating\": 0.0},\n  {\"id\": 740471, \"suggestedTranslation\": \"Cái này có vẻ hơi khoai đấy.\", \"rating\": 0.0},\n  {\"id\": 740472, \"suggestedTranslation\": \"Chắc là trong tầm kiểm soát thôi.\", \"rating\": 0.0},\n  {\"id\": 740473, \"suggestedTranslation\": \"Mi cứ đứng đực ra đó cả ngày thế hả?\", \"rating\": 0.0},\n  {\"id\": 740474, \"suggestedTranslation\": \"Đúng là cái quạt phiền phức.\", \"rating\": 0.0},\n  {\"id\": 740475, \"suggestedTranslation\": \"Đỡ khổ hơn là đi nhặt bóng cả ngày.\", \"rating\": 0.0},\n  {\"id\": 740476, \"suggestedTranslation\": \"Đi lên, đi xuống. Đơn giản vậy thôi.\", \"rating\": 0.0},\n  {\"id\": 740477, \"suggestedTranslation\": \"Đừng trân trân nhìn nó lâu quá đấy.\", \"rating\": 0.0},\n  {\"id\": 740478, \"suggestedTranslation\": \"Bụp một cái là quả bóng gôn bay đi.\", \"rating\": 0.0},\n  {\"id\": 740479, \"suggestedTranslation\": \"Xem nào...\", \"rating\": 0.0},\n  {\"id\": 740480, \"suggestedTranslation\": \"Tôi nổi tiếng với việc đánh một phát vào lỗ đấy.\", \"rating\": 0.0},\n  {\"id\": 740481, \"suggestedTranslation\": \"Chúng ta nên đặt cái lỗ cờ ở đâu nhỉ?\", \"rating\": 0.0},\n  {\"id\": 740482, \"suggestedTranslation\": \"Đời chả có gì miễn phí cả. Thứ này cần có đồng xu!\", \"rating\": 0.0},\n  {\"id\": 740483, \"suggestedTranslation\": \"Sân chơi đã được dựng xong đâu!\", \"rating\": 0.0},\n  {\"id\": 740484, \"suggestedTranslation\": \"Đã trả tiền đầy đủ. Chơi thôi!\", \"rating\": 0.0},\n  {\"id\": 740485, \"suggestedTranslation\": \"Chúng ta nên phát bóng ở đâu đây?\", \"rating\": 0.0}\n]",
