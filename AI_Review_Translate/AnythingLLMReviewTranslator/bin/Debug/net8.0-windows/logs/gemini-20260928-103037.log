            "text": "[\n  {\n    \"id\": 739554,\n    \"suggestedTranslation\": \"Trống. Để lát tôi thử lại.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739555,\n    \"suggestedTranslation\": \"Tôi rất thích chớp thời cơ khi còn nóng, nhưng mà...\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739556,\n    \"suggestedTranslation\": \"Không vội.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 739557,\n    \"suggestedTranslation\": \"Lo dọn sạch nó trước đã thì hơn.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739558,\n    \"suggestedTranslation\": \"Đáng tiếc, hụt mất!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739559,\n    \"suggestedTranslation\": \"Tôi không phải nghệ sĩ gì cho cam.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739560,\n    \"suggestedTranslation\": \"Tôi có linh cảm việc đó không tốt cho đám cây cối đâu.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739561,\n    \"suggestedTranslation\": \"Tôi sẽ cần một chiếc cần khỏe hơn để câu con cá khủng đó!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739562,\n    \"suggestedTranslation\": \"Tôi biết có gì đó không ổn rồi mà.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739563,\n    \"suggestedTranslation\": \"Không ai nên phải mất đi một người chị em cả.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739564,\n    \"suggestedTranslation\": \"Họ đang bận làm việc.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 739565,\n    \"suggestedTranslation\": \"Không nghĩ là cách đó sẽ hiệu quả đâu.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739566,\n    \"suggestedTranslation\": \"Tôi có thể đợi đến khi họ xong việc.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739567,\n    \"suggestedTranslation\": \"Sân chơi vẫn chưa được dựng lên mà!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739568,\n    \"suggestedTranslation\": \"Chắc là nó không nhận món đó đâu.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739569,\n    \"suggestedTranslation\": \"Trông họ có vẻ đã chết. Chết hẳn luôn rồi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739570,\n    \"suggestedTranslation\": \"Chúng ta có bản vẽ này rồi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739571,\n    \"suggestedTranslation\": \"À, một loài chim tuyệt vời, chim bồ nông.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739572,\n    \"suggestedTranslation\": \"Cái đó không đúng rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 739573,\n    \"suggestedTranslation\": \"Có những thứ ngay cả tôi cũng không sửa nổi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739574,\n    \"suggestedTranslation\": \"Nó cần thứ khác cơ.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739575,\n    \"suggestedTranslation\": \"Nó đâu cần thứ này.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739576,\n    \"suggestedTranslation\": \"Bao nhiêu công sức cũng chẳng làm đám này mọc lên được đâu.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739577,\n    \"suggestedTranslation\": \"Tôi chắc là làm được thôi, miễn là có đúng kỹ thuật.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739578,\n    \"suggestedTranslation\": \"Chắc phải làm cái này dưới ánh trăng thôi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739579,\n    \"suggestedTranslation\": \"Tôi chẳng hiểu mấy tiếng la hét của các người đâu!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739580,\n    \"suggestedTranslation\": \"Tôi không muốn dây dưa chọc giận ác ma nào đâu.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739581,\n    \"suggestedTranslation\": \"Cậu coi tôi là thợ kiểu gì thế?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739582,\n    \"suggestedTranslation\": \"Cái đó không dùng để điêu khắc được.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739583,\n    \"suggestedTranslation\": \"Nó không khớp với nhau theo cách đó đâu.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739584,\n    \"suggestedTranslation\": \"Không. Bây giờ để Két Sắt thì không an toàn đâu.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739585,\n    \"suggestedTranslation\": \"Phải dọn dẹp trước đã.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739586,\n    \"suggestedTranslation\": \"Thôi. Để sáng mai hãy tính.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739587,\n    \"suggestedTranslation\": \"Tôi sẽ đợi, cô ấy còn việc phải làm.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739588,\n    \"suggestedTranslation\": \"Họ hết giờ làm việc rồi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739589,\n    \"suggestedTranslation\": \"Phí phạm nguyên liệu chẳng để làm gì.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739590,\n    \"suggestedTranslation\": \"Chẳng có đủ chỗ cho cái đó đâu.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739591,\n    \"suggestedTranslation\": \"Chắc chúng ta phải đợi cái cây mọc lại rồi mới đưa nó gì được.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739592,\n    \"suggestedTranslation\": \"Hay là tôi nên thử cấp nguồn cho nó bằng thứ khác nhỉ?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739593,\n    \"suggestedTranslation\": \"Không-không. Thứ đó không để ở đó.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739594,\n    \"suggestedTranslation\": \"Tôi phải tháo nó ra rồi làm lại thôi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739595,\n    \"suggestedTranslation\": \"Họ đang bận làm việc.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 739596,\n    \"suggestedTranslation\": \"Có vẻ họ chết rồi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739597,\n    \"suggestedTranslation\": \"Họ đang bận rộn không còn tay chân nào.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739598,\n    \"suggestedTranslation\": \"Họ hết giờ làm việc rồi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739599,\n    \"suggestedTranslation\": \"Họ đang bận làm việc.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 739600,\n    \"suggestedTranslation\": \"Có vẻ họ chết rồi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739601,\n    \"suggestedTranslation\": \"Tôi cứ giữ hộ đã nhé. Họ đầy đồ rồi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739602,\n    \"suggestedTranslation\": \"Họ hết giờ làm việc rồi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739603,\n    \"suggestedTranslation\": \"Tôi xử lý cái này xong rồi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739604,\n    \"suggestedTranslation\": \"Tôi chỉ nghĩ anh bạn nhỏ này cần được đánh bóng chút thôi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739605,\n    \"suggestedTranslation\": \"Xin lỗi, hình như nó được làm riêng cho người cá.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739606,\n    \"suggestedTranslation\": \"Xem ra tôi không phải sếp ở đây rồi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739607,\n    \"suggestedTranslation\": \"Đã cột xong hết rồi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739608,\n    \"suggestedTranslation\": \"Nó đang khó chiều lắm, chưa cột được đâu.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739609,\n    \"suggestedTranslation\": \"Tôi tranh thủ đi lùa một con Bò Lai thôi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739610,\n    \"suggestedTranslation\": \"Tôi phải dụ con Bò Lai của mình lại gần hơn.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739611,\n    \"suggestedTranslation\": \"Nghỉ xả hơi chút nào.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739612,\n    \"suggestedTranslation\": \"Tiêu rồi, mất dấu rồi!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739613,\n    \"suggestedTranslation\": \"Chẳng có dấu hiệu nào của Charlie cả.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739614,\n    \"suggestedTranslation\": \"Hừm... Tôi không biết Charlie có từng ở đây không nữa.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739615,\n    \"suggestedTranslation\": \"Chắc chắn là không nên làm thế này rồi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739616,\n    \"suggestedTranslation\": \"Làm lại phát nữa, thật nhẹ nhàng nào...\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 739617,\n    \"suggestedTranslation\": \"Nào, hợp t