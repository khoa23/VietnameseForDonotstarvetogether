: 743384, \"suggestedTranslation\": \"Đang đứng yên tại chỗ.\", \"rating\": 9.0},\n  {\"id\": 743385, \"suggestedTranslation\": \"Quá hung hăng để cột lại!\", \"rating\": 9.0},\n  {\"id\": 743386, \"suggestedTranslation\": \"Wolfgang cần bò lông!\", \"rating\": 9.0},\n  {\"id\": 743387, \"suggestedTranslation\": \"Bò lông ở xa quá.\", \"rating\": 9.0},\n  {\"id\": 743388, \"suggestedTranslation\": \"Tấm vải chắn gió nhỏ bé không thèm nghe lời Wolfgang!\", \"rating\": 9.0},\n  {\"id\": 743389, \"suggestedTranslation\": \"Wolfgang sẽ cho chiếc thuyền nhỏ thấy ai mới là kẻ mạnh mẽ hơn!\", \"rating\": 9.0},\n  {\"id\": 743390, \"suggestedTranslation\": \"Ạch! Hạ cái lều rạp xiếc lớn xuống còn dễ hơn thế này!\", \"rating\": 9.0},\n  {\"id\": 743391, \"suggestedTranslation\": \"Wolfgang đã chọn cái này rồi!\", \"rating\": 9.0},\n  {\"id\": 743392, \"suggestedTranslation\": \"Wolfgang sẽ đợi lần sau vậy.\", \"rating\": 9.0},\n  {\"id\": 743393, \"suggestedTranslation\": \"Bò lông đang có người cưỡi rồi.\", \"rating\": 9.0},\n  {\"id\": 743394, \"suggestedTranslation\": \"Đến giờ dậy rồi, bò lông ơi!\", \"rating\": 9.0},\n  {\"id\": 743395, \"suggestedTranslation\": \"Tôi không cưỡi nó lúc này được! Bò lông đang chứng tỏ bản lĩnh trong chiến đấu!\", \"rating\": 9.0},\n  {\"id\": 743401, \"suggestedTranslation\": \"Không cần cần câu hùng mạnh cho cái ao nhỏ xíu đâu!\", \"rating\": 9.0},\n  {\"id\": 743402, \"suggestedTranslation\": \"Warly nấu ăn rất cừ. Wolfgang sẽ không ngáng đường đâu.\", \"rating\": 9.0},\n  {\"id\": 743403, \"suggestedTranslation\": \"Wolfgang rất mừng vì mình không biết chữ!\", \"rating\": 9.0},\n  {\"id\": 743404, \"suggestedTranslation\": \"Chẳng có gì cả.\", \"rating\": 9.0},\n  {\"id\": 743405, \"suggestedTranslation\": \"Nó kẹt đến nỗi ngay cả Wolfgang cũng không gỡ ra được!\", \"rating\": 9.0},\n  {\"id\": 743406, \"suggestedTranslation\": \"Wolfgang sẽ không sập bẫy khỉ nữa đâu... lần nào nữa!\", \"rating\": 9.0},\n  {\"id\": 743407, \"suggestedTranslation\": \"Wolfgang sẽ đợi bạn mình làm xong.\", \"rating\": 9.0},\n  {\"id\": 743408, \"suggestedTranslation\": \"Đây không phải củ cà rốt chân dài của Wolfgang.\", \"rating\": 9.0},\n  {\"id\": 743409, \"suggestedTranslation\": \"Cà rốt chân dài của Wolfgang trông khác hẳn cơ!\", \"rating\": 9.0},\n  {\"id\": 743410, \"suggestedTranslation\": \"Đó không phải vũ khí hùng mạnh!\", \"rating\": 9.0},\n  {\"id\": 743411, \"suggestedTranslation\": \"Wolfgang biết cái này rồi.\", \"rating\": 9.0},\n  {\"id\": 743412, \"suggestedTranslation\": \"Wolfgang biết loại thực vật này rồi.\", \"rating\": 9.0},\n  {\"id\": 743413, \"suggestedTranslation\": \"Wolfgang cố tình trượt đấy.\", \"rating\": 9.0},\n  {\"id\": 743414, \"suggestedTranslation\": \"Hết nước mất rồi.\", \"rating\": 9.0},\n  {\"id\": 743415, \"suggestedTranslation\": \"Hết nước mất rồi.\", \"rating\": 9.0},\n  {\"id\": 743419, \"suggestedTranslation\": \"Không phải mảnh ghép cho bức tượng nhỏ!\", \"rating\": 9.0},\n  {\"id\": 743420, \"suggestedTranslation\": \"Thức ăn cần dĩa khác.\", \"rating\": 9.0},\n  {\"id\": 743421, \"suggestedTranslation\": \"Wolfgang đặt lên dĩa rồi.\", \"rating\": 9.0},\n  {\"id\": 743422, \"suggestedTranslation\": \"Cần phải chèo đúng lúc!\", \"rating\": 9.0},\n  {\"id\": 743423, \"suggestedTranslation\": \"Wolfgang cần tập trung.\", \"rating\": 9.0},\n  {\"id\": 743424, \"suggestedTranslation\": \"Dễ ợt! Đấy chỉ là chạy đà tập dượt thôi.\", \"rating\": 9.0},\n  {\"id\": 743425, \"suggestedTranslation\": \"Chắc Wolfgang làm sau vậy.\", \"rating\": 9.0},\n  {\"id\": 743426, \"suggestedTranslation\": \"Wolfgang muốn dùng sau bạn, nếu được nhé.\", \"rating\": 9.0},\n  {\"id\": 743427, \"suggestedTranslation\": \"Wolfgang không muốn làm người cá buồn lòng.\", \"rating\": 9.0},\n  {\"id\": 743428, \"suggestedTranslation\": \"Đó là đồ của người máy.\", \"rating\": 9.0},\n  {\"id\": 743429, \"suggestedTranslation\": \"Warly nấu ăn rất cừ. Wolfgang sẽ không ngáng đường đâu.\", \"rating\": 9.0},\n  {\"id\": 743430, \"suggestedTranslation\": \"Không, cảm ơn.\", \"rating\": 9.0},\n  {\"id\": 743431, \"suggestedTranslation\": \"Không dành cho Wolfgang.\", \"rating\": 9.0},\n  {\"id\": 743432, \"suggestedTranslation\": \"Tôi không cưỡi nó lúc này được! Bò lông đang chứng tỏ bản lĩnh trong chiến đấu!\", \"rating\": 9.0},\n  {\"id\": 743433, \"suggestedTranslation\": \"Tôi sẽ đợi cho đến khi nó không nhìn nữa.\", \"rating\": 9.0},\n  {\"id\": 743434, \"suggestedTranslation\": \"Cái đó không cạo được.\", \"rating\": 9.0},\n  {\"id\": 743435, \"suggestedTranslation\": \"Tôi không thể cạo khi không có sợi lông nào.\", \"rating\": 9.0},\n  {\"id\": 743436, \"suggestedTranslation\": \"Đó không phải bò để Wolfgang cạo.\", \"rating\": 9.0},\n  {\"id\": 743437, \"suggestedTranslation\": \"Quay lại đây để Wolfgang ăn thịt mày nào!\", \"rating\": 9.0},\n  {\"id\": 743438, \"suggestedTranslation\": \"Wolfgang tìm chỗ ngâm mình khác vậy.\", \"rating\": 9.0},\n  {\"id\": 743439, \"suggestedTranslation\": \"Wolfgang phải tìm cà rốt chân dài cho cuộc đua!\", \"rating\": 9.0},\n  {\"id\": 743440, \"suggestedTranslation\": \"Tôi sẽ nhét nó vào bằng được!\", \"rating\": 9.0},\n  {\"id\": 743441, \"suggestedTranslation\": \"Wolfgang dùng chung được!\", \"rating\": 9.0},\n  {\"id\": 743442, \"suggestedTranslation\": \"Hừ! Vô tích sự.\", \"rating\": 9.0},\n  {\"id\": 743443, \"suggestedTranslation\": \"Đó là đồ của người máy.\", \"rating\": 9.0},\n  {\"id\": 743444, \"suggestedTranslation\": \"Warly nấu ăn rất cừ. Wolfgang sẽ không ngáng đường đâu.\", \"rating\": 9.0},\n  {\"id\": 743445, \"suggestedTranslation\": \"Không, cảm ơn.\", \"rating\": 9.0},\n  {\"id\": 743446, \"suggestedTranslation\": \"Không dành cho Wolfgang.\", \"rating\": 9.0},\n  {\"id\": 743447, \"suggestedTranslation\": \"Tôi không hiểu gì cả.\", \"rating\": 9.0},\n  {\"id\": 743448, \"suggestedTranslation\": \"Wolfgang biết cái này rồi!\", \"rating\": 9.0},\n  {\"id\": 743449, \"suggestedTranslation\": \"Wolfgang không đọc được ở trong này.\", \"rating\": 9.0},\n  {\"id\": 743450, \"suggestedTranslation\": \"Chữ viết của loài khỉ khó đọc thật.\", \"rating\": 9.0},\n  {\"id\": 743451, \"suggestedTranslation\": \"Mẩu giấy nhỏ không dành cho ở đây!\", \"rating\": 9.0},\n  {\"id\": 743453, \"suggestedTranslation\": \"Con bò lông này đã có bạn rồi.\", \"rating\": 9.0},\n  {\"id\": 743454, \"suggestedTranslation\": \"Wolfgang đã chọn con bò lông tuyệt nhất để làm bạn rồi!\", \"rating\": 9.0},\n  {\"id\": 743455, \"suggestedTranslation\": \"Ngớ ngẩn thật! Không có tác dụng đâu!\", \"rating\": 9.0},\n  {\"id\": 743456, \"suggestedTranslation\": \"Không sửa được nữa rồi... thở dài.\", \"rating\": 9.0},\n  {\"id\": 743457, \"suggestedTranslation\": \"Nó không thuộc về Wolfgang.\", \"rating\": 9.0},\n  {\"id\": 743458, \"suggestedTranslation\": \"Để sau đi! Giờ chúng ta ĐÁNH NHAU!\", \"rating\": 9.0},\n  {\"id\": 743459, \"suggestedTranslation\": \"Sai chìa khóa rồi.\", \"rating\": 9.0},\n  {\"id\": 743460, \"suggestedTranslation\": \"Không phải chìa khóa đúng!\", \"rating\": 9.0},\n  {\"id\": 743461, \"suggestedTranslation\": \"Wolfgang chẳng có mấy thứ nhỏ nhặt để gói cả!\", \"rating\": 9.0},\n  {\"id\": 743462, \"suggestedTranslation\": \"Wolfgang không giỏi mấy chữ cái li ti đâu.\", \"rating\": 9.0},\n  {\"id\": 743463, \"suggestedTranslation\": \"Wolfgang có thể giúp nguệch ngoạc vài nét khi bạn xong việc được không?\", \"rating\": 9.0},\n  {\"id\": 743464, \"suggestedTranslation\": \"Biết đâu cuộc thi ở chỗ khác.\", \"rating\": 9.0},\n  {\"id\": 743465, \"suggestedTranslation\": \"Anh trốn ở đâu vậy, ông chú kỳ lạ?\", \"rating\": 9.0},\n  {\"id\": 743466, \"suggestedTranslation\": \"Chắc hắn đi chạy bộ rồi.\", \"rating\": 9.0},\n  {\"id\": 743467, \"suggestedTranslation\": \"Xin lỗi, Wolfgang không biết là bạn đang bận.\", \"rating\": 9.0},\n  {\"id\": 743468, \"suggestedTranslation\": \"Hà! Nó đã nằm sẵn trong bộ óc vĩ đại của Wolfgang rồi!\", \"rating\": 9.0},\n  {\"id\": 743469, \"suggestedTranslation\": \"Tôi không đủ mạnh mẽ để làm việc đó.\", \"rating\": 9.0},\n  {\"id\": 743470, \"suggestedTranslation\": \"Tôi đang làm nên những điều lớn lao với mũi tên tí hon!\", \"rating\": 9.0},\n  {\"id\": 743471, \"suggestedTranslation\": \"Tôi đã đánh bại mũi tên tí hon rồi!\", \"rating\": 9.0},\n  {\"id\": 743472, \"suggestedTranslation\": \"Wolfgang không sợ. Mới là đứa sợ.\", \"rating\": 9.0},\n  {\"id\": 743473, \"suggestedTranslation\": \"Lần sau tôi sẽ còn hùng mạnh hơn!\", \"rating\": 9.0},\n  {\"id\": 743474, \"suggestedTranslation\": \"Mặt đất đang sụp đổ dưới sức mạnh của Wolfgang!\", \"rating\": 9.0},\n  {\"id\": 743475, \"suggestedTranslation\": \"Wolfgang đã làm nứt mặt đất rồi!\", \"rating\": 9.0},\n  {\"id\": 743476, \"suggestedTranslation\": \"Tiếng gầm rú đó không phải do bụng kêu đâu!\", \"rating\": 9.0},\n  {\"id\": 743477, \"suggestedTranslation\": \"Xin đừng ăn tôi.\", \"rating\": 9.0},\n  {\"id\": 743478, \"suggestedTranslation\": \"Đây là vật cống nạp cho một... người bạn hùng mạnh.\", \"rating\": 9.0},\n  {\"id\": 743479, \"suggestedTranslation\": \"Đừng ăn bạn của Wolfgang, được chứ?\", \"rating\": 9.0},\n  {\"id\": 743480, \"suggestedTranslation\": \"Bộ não của Wolfgang ngập tràn những hình ảnh kỳ lạ!\", \"rating\": 9.0},\n  {\"id\": 743481, \"suggestedTranslation\": \"Không chắc Wolfgang đang mong đợi điều gì nữa.\", \"rating\": 9.0},\n  {\"id\": 743482, \"suggestedTranslation\": \"Wolfgang đã thấy mấy bức tranh trong não này rồi.\", \"rating\": 9.0},\n  {\"id\": 743483, \"suggestedTranslation\": \"Quái vật đang tới kìa!\", \"rating\": 9.0},\n  {\"id\": 743484, \"suggestedTranslation\": \"Wolfgang muốn ra khỏi hang!\", \"rating\": 9.0},\n  {\"id\": 743485, \"suggestedTranslation\": \"Wolfgang không thích cái hang tối tăm này.\", \"rating\": 9.0},\n  {\"id\": 743486, \"suggestedTranslation\": \"Wolfgang còn hùng mạnh hơn cả trước đây!\", \"rating\": 9.0},\n  {\"id\": 743487, \"suggestedTranslation\": \"Tia điện kìa! Tôi thích!\", \"rating\": 9.0},\n  {\"id\": 743488, \"suggestedTranslation\": \"Nước sẽ không làm phiền Wolfgang được đâu!\", \"rating\": 9.0},\n  {\"id\": 743489, \"suggestedTranslation\": \"Hà! Những đòn tấn công yếu ớt đập vào người Wolfgang rồi nảy ra luôn!\", \"rating\": 9.0},\n  {\"id\": 743490, \"suggestedTranslation\": \"Wolfgang còn mạnh hơn cả cơn buồn ngủ!\", \"rating\": 9.0},\n  {\"id\": 743491, \"suggestedTranslation\": \"Cứ nhìn đây, để Wolfgang lo vụ này cho!\", \"rating\": 9.0},\n  {\"id\": 743492, \"suggestedTranslation\": \"Uuuuoooooo!!\", \"rating\": 9.0},\n  {\"id\": 743493, \"suggestedTranslation\": \"Ong! Lũ người bọ chích độc ác!\", \"rating\": 9.0},\n  {\"id\": 743494, \"suggestedTranslation\": \"Mấy giọt nước đang rỉ qua thuyền kìa!\", \"rating\": 9.0},\n  {\"id\": 743495, \"suggestedTranslation\": \"Wolfgang không biết bơi!\", \"rating\": 9.0},\n  {\"id\": 743496, \"suggestedTranslation\": \"Ái! Sao mày lại đánh tao, gậy ném ơi?\", \"rating\": 9.0},\n  {\"id\": 743497, \"suggestedTranslation\": \"Wolfgang rất dũng cảm! Không sợ cái cây ma quái đâu!\", \"rating\": 9.0},\n  {\"id\": 743498, \"suggestedTranslation\": \"Bị cháy thế này là không công bằng!\", \"rating\": 9.0},\n  {\"id\": 743499, \"suggestedTranslation\": \"Lại đây nào, bò lông!\", \"rating\": 9.0},\n  {\"id\": 743500, \"suggestedTranslation\": \"\\nBộ óc hùng mạnh có thể làm cho cái này tốt hơn!\", \"rating\": 9.0},\n  {\"id\": 743501, \"suggestedTranslation\": \"Không ổn rồi, Wolfgang không có đủ nguyên liệu!\", \"rating\": 9.0},\n  {\"id\": 743502, \"suggestedTranslation\": \"Wolfgang sẽ cần một nơi làm việc phù hợp!\", \"rating\": 9.0},\n  {\"id\": 743503, \"suggestedTranslation\": \"Hừm, khoai phết. Wolfgang nên học cách làm mới được.\", \"rating\": 9.0},\n  {\"id\": 743504, \"suggestedTranslation\": \"Làm sao quan tòa thấy được con bò lông đẹp đẽ của Wolfgang từ xa thế này chứ?\", \"rating\": 9.0},\n  {\"id\": 743505, \"suggestedTranslation\": \"Áaaaa! Mấy hạt cườm ma quái lại quay về tìm Wolfgang!\", \"rating\": 9.0},\n  {\"id\": 743506, \"suggestedTranslation\": \"Chưa đến giờ ngủ đâu nhé!\", \"rating\": 9.0},\n  {\"id\": 743507, \"suggestedTranslation\": \"Thế này thì không thắng được đâu! Phải đi thôi!\", \"rating\": 9.0},\n  {\"id\": 743508, \"suggestedTranslation\": \"Cà rốt chân dài phải chạy nhanh hơn chứ!\", \"rating\": 9.0},\n  {\"id\": 743509, \"suggestedTranslation\": \"Không! Sai đường rồi!\", \"rating\": 9.0}\n]",
