    \"id\": 742273,\n    \"suggestedTranslation\": \"Nó đúng là giữ nhịp tốt phết.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 742274,\n    \"suggestedTranslation\": \"Tôi thường không thích đồ trang trí lặt vặt lắm, nhưng cái này thì được.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 742275,\n    \"suggestedTranslation\": \"Chẳng có gì bền chặt hơn tình chị em cả.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 742276,\n    \"suggestedTranslation\": \"Trông đẹp phết đấy, nhóc con.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 742277,\n    \"suggestedTranslation\": \"Ai đang phát ra cái âm thanh kỳ lạ thế nhỉ?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 742278,\n    \"suggestedTranslation\": \"Chúng làm đầu óc tôi quay cuồng hết cả lên.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 742279,\n    \"suggestedTranslation\": \"Trông hơi thưa thớt nhỉ. Chắc mình phải góp thêm một hai bông hoa vào quá.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 742280,\n    \"suggestedTranslation\": \"Một lời nhắc nhở về an toàn lao động.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 742281,\n    \"suggestedTranslation\": \"Làm tôi hơi thấy bứt rứt. Hè hè...\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 742282,\n    \"suggestedTranslation\": \"An nghỉ nhé, dù cậu là cái quái gì đi nữa.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 742283,\n    \"suggestedTranslation\": \"%s đã bị %s tháo tung các bộ phận.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 742284,\n    \"suggestedTranslation\": \"%s đã bị %s tháo tung các bộ phận.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 742285,\n    \"suggestedTranslation\": \"%s đã bị %s tháo tung các bộ phận.\",\n    \"rating\": 8.5\n  }\n]",
