:\"Là nguồn đạm từ cá tốt.\",\"rating\":0.0},\n  {\"id\":744707,\"suggestedTranslation\":\"Ha ha, cái tên buồn cười ghê.\",\"rating\":0.0},\n  {\"id\":744708,\"suggestedTranslation\":\"Wolfgang mong là nó không quá cay.\",\"rating\":0.0},\n  {\"id\":744709,\"suggestedTranslation\":\"Là nhà mới cho cá. Tạm thời là thế.\",\"rating\":0.0},\n  {\"id\":744710,\"suggestedTranslation\":\"Thịt dưới nước vẫn giúp Wolfgang khỏe mạnh.\",\"rating\":0.0},\n  {\"id\":744711,\"suggestedTranslation\":\"Là đá tảng, nhưng mà ừm, có chóp nhọn.\",\"rating\":0.0},\n  {\"id\":744712,\"suggestedTranslation\":\"Buồn làm sao.\",\"rating\":0.0},\n  {\"id\":744713,\"suggestedTranslation\":\"Nó đang dõi theo Wolfgang kìa.\",\"rating\":0.0},\n  {\"id\":744714,\"suggestedTranslation\":\"Wolfgang có một bí mật sáng rực!\",\"rating\":0.0},\n  {\"id\":744715,\"suggestedTranslation\":\"Wolfgang bơi lội cừ khôi lắm, nhưng cứ mang theo cho chắc.\",\"rating\":0.0},\n  {\"id\":744716,\"suggestedTranslation\":\"Chúng rất đẹp.\",\"rating\":0.0},\n  {\"id\":744717,\"suggestedTranslation\":\"Wolfgang định bóp nát nó, nhưng bị nó đâm cho.\",\"rating\":0.0},\n  {\"id\":744718,\"suggestedTranslation\":\"Đẹp quá đi!\",\"rating\":0.0},\n  {\"id\":744719,\"suggestedTranslation\":\"Không phải rau chân vịt, nhưng chắc vẫn dùng được!\",\"rating\":0.0},\n  {\"id\":744720,\"suggestedTranslation\":\"Là thực vật phát sáng.\",\"rating\":0.0},\n  {\"id\":744721,\"suggestedTranslation\":\"Thực vật phát sáng đang mờ dần.\",\"rating\":0.0},\n  {\"id\":744722,\"suggestedTranslation\":\"Không phải khoai tây.\",\"rating\":0.0},\n  {\"id\":744723,\"suggestedTranslation\":\"Ôi, bông này buồn quá.\",\"rating\":0.0},\n  {\"id\":744724,\"suggestedTranslation\":\"Thực vật xinh đẹp giờ đã chết rồi.\",\"rating\":0.0}\n]",
