anslation\":\"Này WX, khi nào thì cậu lắp một cỗ máy phun lửa thế?\",\"rating\":1.0},\n  {\"id\":739337,\"suggestedTranslation\":\"Này WX, khi nào thì cậu lắp một cỗ máy phun lửa thế?\",\"rating\":1.0},\n  {\"id\":739338,\"suggestedTranslation\":\"Này WX, khi nào thì cậu lắp một cỗ máy phun lửa thế?\",\"rating\":1.0},\n  {\"id\":739339,\"suggestedTranslation\":\"Này WX, khi nào thì cậu lắp một cỗ máy phun lửa thế?\",\"rating\":1.0},\n  {\"id\":739340,\"suggestedTranslation\":\"Này WX, khi nào thì cậu lắp một cỗ máy phun lửa thế?\",\"rating\":1.0},\n  {\"id\":739341,\"suggestedTranslation\":\"Này WX, khi nào thì cậu lắp một cỗ máy phun lửa thế?\",\"rating\":1.0},\n  {\"id\":739342,\"suggestedTranslation\":\"WX lúc nào cũng vứt đống đồ đồng nát của mình xung quanh.\",\"rating\":1.0},\n  {\"id\":739343,\"suggestedTranslation\":\"WX được giao hàng miễn phí á? Không công bằng chút nào!\",\"rating\":1.0},\n  {\"id\":739344,\"suggestedTranslation\":\"Biến đi, Scott!\",\"rating\":1.0},\n  {\"id\":739345,\"suggestedTranslation\":\"Tớ đang để mắt tới cậu đấy, đồ chích điện.\",\"rating\":1.0},\n  {\"id\":739346,\"suggestedTranslation\":\"Tớ không tin tưởng WX với thứ này chút nào.\",\"rating\":1.0},\n  {\"id\":739347,\"suggestedTranslation\":\"Cảm giác như đang cố ăn một viên gạch thật sự vậy.\",\"rating\":1.0},\n  {\"id\":739348,\"suggestedTranslation\":\"Ồ cảm ơn nhé, WX.\",\"rating\":1.0},\n  {\"id\":739349,\"suggestedTranslation\":\"Cái tên WX đó lúc nào cũng mưu tính cái gì đó.\",\"rating\":1.0},\n  {\"id\":739350,\"suggestedTranslation\":\"Đồ cũ của WX thì tớ quan tâm làm gì?\",\"rating\":1.0},\n  {\"id\":739352,\"suggestedTranslation\":\"Để tớ thử xem... đứng yên nào, WX!\",\"rating\":1.0},\n  {\"id\":739353,\"suggestedTranslation\":\"Cái quái gì đã nhập vào cậu thế hả?!\",\"rating\":1.0},\n  {\"id\":739354,\"suggestedTranslation\":\"Tớ không quyết định được nó đáng yêu hay rợn tóc gáy nữa.\",\"rating\":1.0},\n  {\"id\":739355,\"suggestedTranslation\":\"Tớ không quyết định được nó đáng yêu hay rợn tóc gáy nữa.\",\"rating\":1.0},\n  {\"id\":739356,\"suggestedTranslation\":\"Tớ không quyết định được nó đáng yêu hay rợn tóc gáy nữa.\",\"rating\":1.0},\n  {\"id\":739357,\"suggestedTranslation\":\"Heh... cậu nghĩ WX sẽ nổi giận thế nào nếu tớ vẽ một chòm râu lên mặt nó nhỉ?\",\"rating\":1.0},\n  {\"id\":739358,\"suggestedTranslation\":\"Cậu còn chờ gì nữa, một cái xoa đầu à?\",\"rating\":1.0},\n  {\"id\":739359,\"suggestedTranslation\":\"Ý cậu là sao khi chỉ có thể nói cho WX biết?\",\"rating\":1.0},\n  {\"id\":739360,\"suggestedTranslation\":\"WX, đồ robot già tham lam!\",\"rating\":1.0},\n  {\"id\":739361,\"suggestedTranslation\":\"Cho mười giây để làm cho nó hoạt động trước khi tớ đốt quách nó đi.\",\"rating\":1.0},\n  {\"id\":739362,\"suggestedTranslation\":\"Nó có vẻ hấp thụ bóng đêm xung quanh.\",\"rating\":1.0},\n  {\"id\":739363,\"suggestedTranslation\":\"Nó lấp lánh kìa.\",\"rating\":1.0},\n  {\"id\":739364,\"suggestedTranslation\":\"Lại một hòn đá tảng nữa!\",\"rating\":1.0},\n  {\"id\":739365,\"suggestedTranslation\":\"Nó có ma thuật đấy.\",\"rating\":1.0},\n  {\"id\":739366,\"suggestedTranslation\":\"Đó là một màn đốt phá ăn mừng!\",\"rating\":1.0},\n  {\"id\":739367,\"suggestedTranslation\":\"Chắc tớ nên cúng cho nó cái gì đó.\",\"rating\":1.0},\n  {\"id\":739368,\"suggestedTranslation\":\"Có pháo hoa nào không?\",\"rating\":1.0},\n  {\"id\":739369,\"suggestedTranslation\":\"Cậu và Bernie sẽ hợp nhau lắm đấy!\",\"rating\":1.0},\n  {\"id\":739370,\"suggestedTranslation\":\"Này giám khảo! Nhìn cái này đi này!\",\"rating\":1.0},\n  {\"id\":739371,\"suggestedTranslation\":\"Cậu và Bernie sẽ hợp nhau lắm đấy!\",\"rating\":1.0},\n  {\"id\":739372,\"suggestedTranslation\":\"Này giám khảo! Nhìn cái này đi này!\",\"rating\":1.0},\n  {\"id\":739373,\"suggestedTranslation\":\"Cậu và Bernie sẽ hợp nhau lắm đấy!\",\"rating\":1.0},\n  {\"id\":739374,\"suggestedTranslation\":\"Này giám khảo! Nhìn cái này đi này!\",\"rating\":1.0},\n  {\"