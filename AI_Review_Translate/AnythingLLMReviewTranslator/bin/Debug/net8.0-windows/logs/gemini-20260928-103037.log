            "text": "[\n  {\"id\":744425,\"suggestedTranslation\":\"Là hướng Bắc.\",\"rating\":0.0},\n  {\"id\":744426,\"suggestedTranslation\":\"Là hướng Đông Bắc.\",\"rating\":0.0},\n  {\"id\":744427,\"suggestedTranslation\":\"Là hướng Tây Bắc.\",\"rating\":0.0},\n  {\"id\":744428,\"suggestedTranslation\":\"Là hướng Nam.\",\"rating\":0.0},\n  {\"id\":744429,\"suggestedTranslation\":\"Là hướng Đông Nam.\",\"rating\":0.0},\n  {\"id\":744430,\"suggestedTranslation\":\"Là hướng Tây Nam.\",\"rating\":0.0},\n  {\"id\":744431,\"suggestedTranslation\":\"Là hướng Tây.\",\"rating\":0.0},\n  {\"id\":744432,\"suggestedTranslation\":\"Là thức ăn cho thực vật.\",\"rating\":0.0},\n  {\"id\":744433,\"suggestedTranslation\":\"Tuyệt quá! Đất đã sẵn sàng!\",\"rating\":0.0},\n  {\"id\":744434,\"suggestedTranslation\":\"Không dùng được nữa rồi.\",\"rating\":0.0},\n  {\"id\":744435,\"suggestedTranslation\":\"Khô quá.\",\"rating\":0.0},\n  {\"id\":744436,\"suggestedTranslation\":\"Là một thùng đất thối.\",\"rating\":0.0},\n  {\"id\":744437,\"suggestedTranslation\":\"Nhão nhoét, sũng nước.\",\"rating\":0.0},\n  {\"id\":744438,\"suggestedTranslation\":\"Đúng là phân cực kỳ dũng mãnh.\",\"rating\":0.0},\n  {\"id\":744439,\"suggestedTranslation\":\"Nếu Wolfgang xây nó, chúng sẽ tới.\",\"rating\":0.0},\n  {\"id\":744440,\"suggestedTranslation\":\"Là cuốn sách chứa những món nhét đầy cái bụng vĩ đại của Wolfgang!\",\"rating\":0.0},\n  {\"id\":744441,\"suggestedTranslation\":\"Người thực vật bé nhỏ này là thức ăn sao?\",\"rating\":0.0},\n  {\"id\":744442,\"suggestedTranslation\":\"Tôi đã làm thịt ngon lên nhờ lửa!\",\"rating\":0.0},\n  {\"id\":744443,\"suggestedTranslation\":\"Tôi vẫn không muốn ăn cái này.\",\"rating\":0.0},\n  {\"id\":744444,\"suggestedTranslation\":\"Nấu lên trông còn nhỏ hơn nữa!\",\"rating\":0.0},\n  {\"id\":744445,\"suggestedTranslation\":\"Con cá có cái mặt trông ngứa đấm thật...\",\"rating\":0.0},\n  {\"id\":744446,\"suggestedTranslation\":\"Giữ cho đầu an toàn và khô ráo!\",\"rating\":0.0},\n  {\"id\":744447,\"suggestedTranslation\":\"Cứng cáo đấy, nhưng không cứng bằng Wolfgang!\",\"rating\":0.0},\n  {\"id\":744448,\"suggestedTranslation\":\"Wolfgang không đọc được mấy chữ vớ vẩn này!\",\"rating\":0.0},\n  {\"id\":744449,\"suggestedTranslation\":\"Cái nồi tèo rồi.\",\"rating\":0.0},\n  {\"id\":744450,\"suggestedTranslation\":\"Cái này mất nhiều thời gian quá.\",\"rating\":0.0},\n  {\"id\":744451,\"suggestedTranslation\":\"Sắp nấu xong rồi!\",\"rating\":0.0},\n  {\"id\":744452,\"suggestedTranslation\":\"Đến giờ ăn rồi!\",\"rating\":0.0},\n  {\"id\":744453,\"suggestedTranslation\":\"Wolfgang sẽ nấu bữa ăn ngon cho bạn bè, bữa ăn tựa như ở nhà!\",\"rating\":0.0},\n  {\"id\":744454,\"suggestedTranslation\":\"Bong bóng, bong bóng.\",\"rating\":0.0},\n  {\"id\":744455,\"suggestedTranslation\":\"Phần mèo ngoe nguẩy!\",\"rating\":0.0},\n  {\"id\":744456,\"suggestedTranslation\":\"Là ngô. Còn mong gì hơn chứ?\",\"rating\":0.0},\n  {\"id\":744457,\"suggestedTranslation\":\"Bụp bụp bụp! Ha ha, cắp ngô buồn cười ghê.\",\"rating\":0.0},\n  {\"id\":744458,\"suggestedTranslation\":\"Cơ bắp của Wolfgang sẽ còn vĩ đại hơn nữa khi nâng bắp khổng lồ!\",\"rating\":0.0},\n  {\"id\":744459,\"suggestedTranslation\":\"Là hạt để gieo trồng.\",\"rating\":0.0},\n  {\"id\":744460,\"suggestedTranslation\":\"Cái trang phục bé xíu này có nhét vừa cơ bắp của Wolfgang không nhỉ?\",\"rating\":0.0},\n  {\"id\":744461,\"suggestedTranslation\":\"Cái trang phục bé xíu này có nhét vừa cơ bắp của Wolfgang không nhỉ?\",\"rating\":0.0},\n  {\"id\":744462,\"suggestedTranslation\":\"Cái trang phục bé xíu này có nhét vừa cơ bắp của Wolfgang không nhỉ?\",\"rating\":0.0},\n  {\"id\":744463,\"suggestedTranslation\":\"Cái trang phục bé xíu này có nhét vừa cơ bắp của Wolfgang không nhỉ?\",\"rating\":0.0},\n  {\"id\":744464,\"suggestedTranslation\":\"Cái trang phục bé xíu này có nhét vừa cơ bắp của Wolfgang không nhỉ?\",\"rating\":0.0},\n  {\"id\":744465,\"suggestedTranslation\":\"Dành cho công chúa ngựa.\",\"rating\":0.0},\n  {\"id\":744466,\"suggestedTranslation\":\"Cái trang phục bé xíu này có nhét vừa cơ bắp của Wolfgang không nhỉ?\",\"rating\":0.0},\n  {\"id\":744467,\"suggestedTranslation\":\"Cái trang phục bé xíu này có nhét vừa cơ bắp của Wolfgang không nhỉ?\",\"rating\":0.0},\n  {\"id\":744468,\"suggestedTranslation\":\"Tượng nhỏ cần lửa!\",\"rating\":0.0},\n  {\"id\":744469,\"suggestedTranslation\":\"Ôi, là bức tượng nhỏ kìa!\",\"rating\":0.0},\n  {\"id\":744470,\"suggestedTranslation\":\"Tượng nhỏ cần lửa!\",\"rating\":0.0},\n  {\"id\":744471,\"suggestedTranslation\":\"Wolfgang thích ngắm bức tượng cừu non dễ thương này.\",\"rating\":0.0},\n  {\"id\":744472,\"suggestedTranslation\":\"Tượng nhỏ cần lửa!\",\"rating\":0.0},\n  {\"id\":744473,\"suggestedTranslation\":\"Bức tượng tí hon đã trở nên vĩ đại rồi!\",\"rating\":0.0},\n  {\"id\":744474,\"suggestedTranslation\":\"Là vương miện ma quái cho cái đầu bé xíu.\",\"rating\":0.0},\n  {\"id\":744475,\"suggestedTranslation\":\"Mấy chú thỏ trông có vẻ đã sẵn sàng đi ngủ.\",\"rating\":0.0},\n  {\"id\":744476,\"suggestedTranslation\":\"Cái này làm Wolfgang vừa sợ vừa thèm ăn.\",\"rating\":0.0},\n  {\"id\":744477,\"suggestedTranslation\":\"Là lâu đài cát khổng lồ!\",\"rating\":0.0},\n  {\"id\":744478,\"suggestedTranslation\":\"Mấy con cua hèn nhát cứ thích ném đá tảng.\",\"rating\":0.0},\n  {\"id\":744479,\"suggestedTranslation\":\"Tránh xa thuyền ván ra, mấy cái kìm to xác!\",\"rating\":0.0},\n  {\"id\":744480,\"suggestedTranslation\":\"Tường gai băng còi cọc không cản được Wolfgang đâu.\",\"rating\":0.0},\n  {\"id\":744481,\"suggestedTranslation\":\"Cua con gan dạ thật đối với một sinh vật ngon miệng thế này.\",\"rating\":0.0},\n  {\"id\":744482,\"suggestedTranslation\":\"Nào, anh bạn cứng đầu. Wolfgang chỉ mới khởi động thôi.\",\"rating\":0.0},\n  {\"id\":744483,\"suggestedTranslation\":\"Wolfgang nghe thấy tiếng động nhỏ bên trong.\",\"rating\":0.0},\n  {\"id\":744484,\"suggestedTranslation\":\"Hành tây là bạn thân nhất của Wolfgang! Đứng sau khoai tây thôi!\",\"rating\":0.0},\n  {\"id\":744485,\"suggestedTranslation\":\"Thú cưng vĩ đại! Rất tuyệt!\",\"rating\":0.0},\n  {\"id\":744486,\"suggestedTranslation\":\"Chân nó trông yếu ớt và gầy giơ xương, nhưng nhảy tốt đấy!\",\"rating\":0.0},\n  {\"id\":744487,\"suggestedTranslation\":\"Mắt nhỏ thì có gì mà đáng sợ!\",\"rating\":0.0},\n  {\"id\":744488,\"suggestedTranslation\":\"Bạn côn trùng bay lượn!\",\"rating\":0.0},\n  {\"id\":744489,\"suggestedTranslation\":\"Cục lông nhỏ là bạn của Wolfgang.\",\"rating\":0.0},\n  {\"id\":744490,\"suggestedTranslation\":\"Đúng là cục bông biết đi!\",\"rating\":0.0},\n  {\"id\":744491,\"suggestedTranslation\":\"Wolfgang mạnh mẽ sẽ bảo vệ sinh vật bướm bay mềm mại này.\",\"rating\":0.0},\n  {\"id\":744492,\"suggestedTranslation\":\"Chim non yếu ớt, nhưng được đấy.\",\"rating\":0.0},\n  {\"id\":744493,\"suggestedTranslation\":\"Tôi gọi nó là Cún-gang!\",\"rating\":0.0},\n  {\"id\":744494,\"suggestedTranslation\":\"Tôi không thích chim. Quá mỏng manh.\",\"rating\":0.0},\n  {\"id\":744495,\"suggestedTranslation\":\"Nó kêuéc éc suốt.\",\"rating\":0.0},\n  {\"id\":744496,\"suggestedTranslation\":\"Là manh mối! Manh mối ngon lành đây!\",\"rating\":0.0},\n  {\"id\":744497,\"suggestedTranslation\":\"Làm Wolfgang nổi hết cả da gà da cóc.\",\"rating\":0.0},\n  {\"id\":744498,\"suggestedTranslation\":\"Là một đống cỏ.\",\"rating\":0.0},\n  {\"id\":744499,\"suggestedTranslation\":\"Thật khó để cắt bằng kiếm gỗ.\",\"rating\":0.0},\n  {\"id\":744500,\"suggestedTranslation\":\"Vị tệ khủng khiếp.\",\"rating\":0.0},\n  {\"id\":744501,\"suggestedTranslation\":\"Là một cụm cây sậy.\",\"rating\":0.0},\n  {\"id\":744502,\"suggestedTranslation\":\"Đá tảng đã bị nghiền nát để làm gạch!\",\"rating\":0.0},\n  {\"id\":744503,\"suggestedTranslation\":\"H-hay là mình làm vài ván vật tay cho hữu nghị nhé?\",\"rating\":0.0},\n  {\"id\":744504,\"suggestedTranslation\":\"Heo con giận dữ nay đã có thêm cơ bắp rồi!\",\"rating\":0.0},\n  {\"id\":744505,\"suggestedTranslation\":\"Heo quái vật bự con trông giờ không cứng rắn lắm đâu.\",\"rating\":0.0},\n  {\"id\":744506,\"suggestedTranslation\":\"Này heo con! Wolfgang rất thích ăn thịt xông khói vào bữa sáng.\",\"rating\":0.0},\n  {\"id\":744507,\"suggestedTranslation\":\"Heo con ngoan. Wolfgang không nhớ lần cuối ăn thịt xông khói là khi nào nữa.\",\"rating\":0.0},\n  {\"id\":744508,\"suggestedTranslation\":\"Wolfgang hùng mạnh... không phá nổi cái trụ.\",\"rating\":0.0},\n  {\"id\":744509,\"suggestedTranslation\":\"Wolfgang hùng mạnh có thể phá tung cái trụ!\",\"rating\":0.0},\n  {\"id\":744510,\"suggestedTranslation\":\"Trông giống thức ăn tà ác.\",\"rating\":0.0},\n  {\"id\":744511,\"suggestedTranslation\":\"Con cá lớn đãmệt ngúm rồi.\",\"rating\":0.0},\n  {\"id\":744512,\"suggestedTranslation\":\"Đã hỏng rồi.\",\"rating\":0.0},\n  {\"id\":744513,\"suggestedTranslation\":\"Giờ nó vừa nhỏ vừa gãy rồi.\",\"rating\":0.0},\n  {\"id\":744514,\"suggestedTranslation\":\"Ha! Mày thua rồi, cây nhỏ ạ!\",\"rating\":0.0},\n  {\"id\":744515,\"suggestedTranslation\":\"Chào cây nhé!\",\"rating\":0.0},\n  {\"id\":744516,\"suggestedTranslation\":\"Là cái cây to lớn và đang nổi giận.\",\"rating\":0.0},\n  {\"id\":744517,\"suggestedTranslation\":\"Xé đôi bộ bài là một trong những kỳ tích sức mạnh nổi tiếng của Wolfgang!\",\"rating\":0.0},\n  {\"id\":744518,\"suggestedTranslation\":\"Thứ nhỏ xíu chẳng có tích sự gì. Đó mới là điểm làm nó sang chảnh.\",\"rating\":0.0},\n  {\"id\":744519,\"suggestedTranslation\":\"Wolfgang sẽ cẩn thận để không làm vỡ.\",\"rating\":0.0},\n  {\"id\":744520,\"suggestedTranslation\":\"Wolfgang không thích bóng tối.\",\"rating\":0.0},\n  {\"id\":744521,\"suggestedTranslation\":\"Bông hoa nhỏ xinh.\",\"rating\":0.0},\n  {\"id\":744522,\"suggestedTranslation\":\"Làm ơn đừng tắt nhé, ánh sáng nhỏ.\",\"rating\":0.0},\n  {\"id\":744523,\"suggestedTranslation\":\"Mấy bông hoa nhỏ yếu ớt hơn bình thường.\",\"rating\":0.0},\n  {\"id\":744524,\"suggestedTranslation\":\"Wolfgang thích ánh sáng nhỏ.\",\"rating\":0.0},\n  {\"id\":744525,\"suggestedTranslation\":\"Là nghệ thuật đấy!\",\"rating\":0.0},\n  {\"id\":744526,\"suggestedTranslation\":\"Là bức tranh về hư vô!\",\"rating\":0.0},\n  {\"id\":744527,\"suggestedTranslation\":\"Lần sau hãy vẽ góc đẹp của Wolfgang nhé!\",\"rating\":0.0},\n  {\"id\":744528,\"suggestedTranslation\":\"Con quái vật lông lá mỏng manh đã trở nên cường tráng hơn.\",\"rating\":0.0},\n  {\"id\":744529,\"suggestedTranslation\":\"Không mạnh mẽ cho lắm. Trông có vẻ mỏng manh hơn.\",\"rating\":0.0},\n  {\"id\":744530,\"suggestedTranslation\":\"Trông nó còn lực lưỡng hơn cả tôi!\",\"rating\":0.0},\n  {\"id\":744531,\"suggestedTranslation\":\"Wolfgang không khóc đâu. Là do khói đấy.\",\"rating\":0.0},\n  {\"id\":744532,\"suggestedTranslation\":\"Ha! Kẻ xấu bự con giờ không còn cứng đầu nữa— chờ đã, chết rồi hả?\",\"rating\":0.0},\n  {\"id\":744533,\"suggestedTranslation\":\"Không-không-không. Đây không phải những gì Wolfgang đã đăng ký ở bảng hiệu.\",\"rating\":0.0},\n  {\"id\":744534,\"suggestedTranslation\":\"Con mắt đáng sợ làm sống lưng Wolfgang lạnh toát.\",\"rating\":0.0},\n  {\"id\":744535,\"suggestedTranslation\":\"Được rồi, con mắt đáng sợ biến mất rồi nhưng giờ trời quá nóng đối với Wolfgang.\",\"rating\":0.0},\n  {\"id\":744536,\"suggestedTranslation\":\"Vẫn chưa xong! Wolfgang sẽ sửa lại cái này.\",\"rating\":0.0},\n  {\"id\":744537,\"suggestedTranslation\":\"Kinh tởm quá đi!\",\"rating\":0.0},\n  {\"id\":744538,\"suggestedTranslation\":\"Chỉ là phần duy nhất dũng mãnh của con quái vật mỏng manh.\",\"rating\":0.0},\n  {\"id\":744539,\"suggestedTranslation\":\"Mày không có cửa chiến đấu với Wolfgang đâu!\",\"rating\":0.0},\n  {\"id\":744540,\"suggestedTranslation\":\"Là một khóm cỏ.\",\"rating\":0.0},\n  {\"id\":744541,\"suggestedTranslation\":\"Cát không thể ngăn cản Wolfgang!\",\"rating\":0.0},\n  {\"id\":744542,\"suggestedTranslation\":\"Tuyệt quá, Wolfgang ghét cảm giác ướt sũng.\",\"rating\":0.0},\n  {\"id\":744543,\"suggestedTranslation\":\"Là bột khô siêu mạnh!\",\"rating\":0.0},\n  {\"id\":744544,\"suggestedTranslation\":\"Đất bẩn thật đấy.\",\"rating\":0.0},\n  {\"id\":744545,\"suggestedTranslation\":\"Cái hộp người máy đang nói chuyện kìa.\",\"rating\":0.0},\n  {\"id\":744546,\"suggestedTranslation\":\"Là cái hộp người máy.\",\"rating\":0.0},\n  {\"id\":744547,\"suggestedTranslation\":\"Cái hộp người máy đang làm tôi sợ đấy!\",\"rating\":0.0},\n  {\"id\":744548,\"suggestedTranslation\":\"Ha! Hay đấy, hộp người máy!\",\"rating\":0.0},\n  {\"id\":744549,\"suggestedTranslation\":\"Cái hộp người máy đang nổi giận rồi...\",\"rating\":0.0},\n  {\"id\":744550,\"suggestedTranslation\":\"Mục đích để làm gì nhỉ?\",\"rating\":0.0},\n  {\"id\":744551,\"suggestedTranslation\":\"Cái thanh này cần chìa khóa để khởi động.\",\"rating\":0.0},\n  {\"id\":744552,\"suggestedTranslation\":\"Thanh định vị đã bật rồi!\",\"rating\":0.0},\n  {\"id\":744553,\"suggestedTranslation\":\"Đúng là cái thanh kỳ quặc.\",\"rating\":0.0},\n  {\"id\":744554,\"suggestedTranslation\":\"Wolfgang sẽ xây bến tàu hùng vĩ, xứng tầm với thuyền ván!\",\"rating\":0.0},\n  {\"id\":744555,\"suggestedTranslation\":\"Cọc gỗ giúp bến tàu càng thêm vững chắc!\",\"rating\":0.0},\n  {\"id\":744556,\"suggestedTranslation\":\"Sẽ làm cho con bò lông xù trông thật đáng yêu!\",\"rating\":0.0},\n  {\"id\":744557,\"suggestedTranslation\":\"Wolfgang sẽ làm một chiếc thuyền ván xinh xắn!\",\"rating\":0.0},\n  {\"id\":744558,\"suggestedTranslation\":\"Thuyền ván của Wolfgang sẽ dũng mãnh như rồng!\",\"rating\":0.0},\n  {\"id\":744559,\"suggestedTranslation\":\"Là phần bụng của con thú dọa nạt bự con.\",\"rating\":0.0},\n  {\"id\":744560,\"suggestedTranslation\":\"Rau củ giúp Wolfgang lớn nhanh và khỏe mạnh.\",\"rating\":0.0},\n  {\"id\":744561,\"suggestedTranslation\":\"Tôi bối rối quá... Là chuồn chuồn hay con ruồi rồng?\",\"rating\":0.0},\n  {\"id\":744562,\"suggestedTranslation\":\"Rương không sợ lửa.\",\"rating\":0.0},\n  {\"id\":744563,\"suggestedTranslation\":\"Rương vĩ đại không sợ lửa!\",\"rating\":0.0},\n  {\"id\":744564,\"suggestedTranslation\":\"Cái nồi vảy để tạo ra hơi nóng.\",\"rating\":0.0},\n  {\"id\":744565,\"suggestedTranslation\":\"Dễ thương quá đi!\",\"rating\":0.0},\n  {\"id\":744566,\"suggestedTranslation\":\"Wolfgang hy vọng nó không làm cháy rìa ria mép.\",\"rating\":0.0},\n  {\"id\":744567,\"suggestedTranslation\":\"Bà cô trí tuệ đã cảnh báo không được chạm tay không vào nồi.\",\"rating\":0.0},\n  {\"id\":744568,\"suggestedTranslation\":\"Là loại quả trông ngộ nghĩnh.\",\"rating\":0.0},\n  {\"id\":744569,\"suggestedTranslation\":\"Nấu chín rồi nhưng trông vẫn ngộ.\",\"rating\":0.0},\n  {\"id\":744570,\"suggestedTranslation\":\"Đừng lo mấy bạn nhỏ yếu ớt ơi, Wolfgang có thể bê quả khổng lồ mà!\",\"rating\":0.0},\n  {\"id\":744571,\"suggestedTranslation\":\"Là hạt để gieo trồng.\",\"rating\":0.0},\n  {\"id\":744572,\"suggestedTranslation\":\"Wolfgang sẽ là mãnh thú dũng mãnh!\",\"rating\":0.0},\n  {\"id\":744573,\"suggestedTranslation\":\"Bánh nướng làm từ quả đỏ ngộ nghĩnh.\",\"rating\":0.0},\n  {\"id\":744574,\"suggestedTranslation\":\"Phần đuôi lực lưỡng!\",\"rating\":0.0},\n  {\"id\":744575,\"suggestedTranslation\":\"Vẩy lấp lánh.\",\"rating\":0.0},\n  {\"id\":744576,\"suggestedTranslation\":\"Chỉ là đá tảng thôi, có gì mà sợ! ...Phải không nhỉ?\",\"rating\":0.0},\n  {\"id\":744577,\"suggestedTranslation\":\"Ha! Đầu của Wolfgang đã cứng như đá tảng rồi!\",\"rating\":0.0},\n  {\"id\":744578,\"suggestedTranslation\":\"Đá tảng đáng sợ xuất phát từ nơi đáng sợ...\",\"rating\":0.0},\n  {\"id\":744579,\"suggestedTranslation\":\"Khúc gỗ nhỏ vừa vặn trong lòng bàn tay tôi!\",\"rating\":0.0},\n  {\"id\":744580,\"suggestedTranslation\":\"Đang bốc cháy kìa!\",\"rating\":0.0},\n  {\"id\":744581,\"suggestedTranslation\":\"Đã bị thiêu rụi.\",\"rating\":0.0},\n  {\"id\":744582,\"suggestedTranslation\":\"C