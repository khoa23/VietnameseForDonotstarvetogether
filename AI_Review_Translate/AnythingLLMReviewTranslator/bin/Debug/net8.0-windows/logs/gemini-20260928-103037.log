            "text": "[\n  {\"id\":739242,\"suggestedTranslation\":\"Chào %s!\",\"rating\":1.0},\n  {\"id\":739243,\"suggestedTranslation\":\"Này %s, cậu có biết tim là một khối cơ không?\",\"rating\":1.0},\n  {\"id\":739244,\"suggestedTranslation\":\"Đốt kẻ sát nhân đi!\",\"rating\":1.0},\n  {\"id\":739245,\"suggestedTranslation\":\"Woah! %s vừa kéo thẳng một linh hồn ra khỏi thế giới bên kia kìa!\",\"rating\":1.0},\n  {\"id\":739246,\"suggestedTranslation\":\"Tớ không thể KHÔNG nghe anh ấy khi anh ấy cầm một chiếc còi sáng bóng!\",\"rating\":1.0},\n  {\"id\":739247,\"suggestedTranslation\":\"Cẩn thận đấy, tớ nghĩ nó bị dại rồi!\",\"rating\":1.0},\n  {\"id\":739248,\"suggestedTranslation\":\"Heh. Con khỉ ngoan.\",\"rating\":1.0},\n  {\"id\":739249,\"suggestedTranslation\":\"Tớ thề là con khỉ này đang bám theo tớ.\",\"rating\":1.0},\n  {\"id\":739250,\"suggestedTranslation\":\"Chuyện gì thế? Cậu ngã từ trên cây xuống à?\",\"rating\":1.0},\n  {\"id\":739251,\"suggestedTranslation\":\"Thứ đó nguy hiểm lắm! Đốt nó đi!\",\"rating\":1.0},\n  {\"id\":739252,\"suggestedTranslation\":\"Cậu khá thông minh đối với một con khỉ bốc mùi đấy.\",\"rating\":1.0},\n  {\"id\":739253,\"suggestedTranslation\":\"Oooh, một chiếc mũ dễ cháy... ý tớ là, một chiếc mũ đẹp!\",\"rating\":1.0},\n  {\"id\":739254,\"suggestedTranslation\":\"Cậu chỉ đang đổ thêm dầu vào lửa thôi, %s!\",\"rating\":1.0},\n  {\"id\":739255,\"suggestedTranslation\":\"Bình tĩnh nào, %s. Muốn mượn Bernie không?\",\"rating\":1.0},\n  {\"id\":739256,\"suggestedTranslation\":\"%s! Vừa rồi buồn cười thật đấy!\",\"rating\":1.0},\n  {\"id\":739257,\"suggestedTranslation\":\"Đốt sạch đi, %s! Đốt trụi đi!\",\"rating\":1.0},\n  {\"id\":739258,\"suggestedTranslation\":\"Chào %s!\",\"rating\":1.0},\n  {\"id\":739259,\"suggestedTranslation\":\"Chắc tớ phải kiếm một trái tim cho %s thôi.\",\"rating\":1.0},\n  {\"id\":739260,\"suggestedTranslation\":\"Ha! Cậu hài hước thật đấy, %s. Hoặc là kêu quàng quạc?\",\"rating\":1.0},\n  {\"id\":739261,\"suggestedTranslation\":\"Đừng có ủ rũ thế chứ, tớ sẽ kiếm cho cậu một trái tim.\",\"rating\":1.0},\n  {\"id\":739262,\"suggestedTranslation\":\"Cậu đùa tớ chắc.\",\"rating\":1.0},\n  {\"id\":739263,\"suggestedTranslation\":\"Sao mặt cậu dài thế nhỉ? Ha!\",\"rating\":1.0},\n  {\"id\":739264,\"suggestedTranslation\":\"Kẻ sát nhân. ĐỐT!\",\"rating\":1.0},\n  {\"id\":739265,\"suggestedTranslation\":\"Trong huyết quản của cậu có chứa xi -rô phong phải không, %s? Cậu ngọt ngào quá đấy!\",\"rating\":1.0},\n  {\"id\":739266,\"suggestedTranslation\":\"Aww, thế là hết.\",\"rating\":1.0},\n  {\"id\":739267,\"suggestedTranslation\":\"Cái đó chắc chắn sẽ cháy được.\",\"rating\":1.0},\n  {\"id\":739268,\"suggestedTranslation\":\"Cậu chắc là muốn ngồi đó chứ? Cái ghế đó có thể tự bốc cháy bất cứ lúc nào đấy.\",\"rating\":1.0},\n  {\"id\":739269,\"suggestedTranslation\":\"Yup. Nó cháy rồi.\",\"rating\":1.0},\n  {\"id\":739270,\"suggestedTranslation\":\"Cái đó chắc chắn sẽ cháy được.\",\"rating\":1.0},\n  {\"id\":739271,\"suggestedTranslation\":\"Cái đó chắc chắn sẽ cháy được.\",\"rating\":1.0},\n  {\"id\":739272,\"suggestedTranslation\":\"Đất bình thường mà cũng di chuyển được à?\",\"rating\":1.0},\n  {\"id\":739273,\"suggestedTranslation\":\"Ánh sáng không có lửa. Thật không tự nhiên chút nào.\",\"rating\":1.0},\n  {\"id\":739274,\"suggestedTranslation\":\"Trông nhiều lông quá!\",\"rating\":1.0},\n  {\"id\":739275,\"suggestedTranslation\":\"Chọc nó bằng một cái gậy xem nào!\",\"rating\":1.0},\n  {\"id\":739276,\"suggestedTranslation\":\"Tự hỏi không biết nó có thích đồ ăn cay không nhỉ?\",\"rating\":1.0},\n  {\"id\":739277,\"suggestedTranslation\":\"Ghê quá. Cái đó chẳng trụ được lâu đâu.\",\"rating\":1.0},\n  {\"id\":739278,\"suggestedTranslation\":\"Ánh sáng không có lửa. Thật không tự nhiên chút nào.\",\"rating\":1.0},\n  {\"id\":739279,\"suggestedTranslation\":\"Cảm giác giống như bàn tay của bà vậy.\",\"rating\":1.0},\n  {\"id\":739280,\"suggestedTranslation\":\"Ánh sáng không có lửa. Thật không tự nhiên chút nào.\",\"rating\":1.0},\n  {\"id\":739281,\"suggestedTranslation\":\"Này! Thu mấy cái dây leo bò lúc nhúc đó lại đi!\",\"rating\":1.0},\n  {\"id\":739282,\"suggestedTranslation\":\"Cậu gan dạ phết đấy đối với một loài thực vật. Tớ thích điều đó!\",\"rating\":1.0},\n  {\"id\":739283,\"suggestedTranslation\":\"Chào %s!\",\"rating\":1.0},\n  {\"id\":739284,\"suggestedTranslation\":\"Tớ nghĩ %s cần được giúp đỡ đấy.\",\"rating\":1.0},\n  {\"id\":739285,\"suggestedTranslation\":\"Tớ sẽ đốt cậu cháy như bùi nhùi cho xem!\",\"rating\":1.0},\n  {\"id\":739286,\"suggestedTranslation\":\"Này, cảm ơn cậu nhiều nhé, %s!\",\"rating\":1.0},\n  {\"id\":739287,\"suggestedTranslation\":\"Eo ơi, nó chết rồi.\",\"rating\":1.0},\n  {\"id\":739288,\"suggestedTranslation\":\"Tớ muốn nướng nó lên!\",\"rating\":1.0},\n  {\"id\":739289,\"suggestedTranslation\":\"Nó cứ ngọ nguậy mãi.\",\"rating\":1.0},\n  {\"id\":739290,\"suggestedTranslation\":\"Nó đang ngáy kìa.\",\"rating\":1.0},\n  {\"id\":739291,\"suggestedTranslation\":\"Chúng trông khá đáng yêu đấy.\",\"rating\":1.0},\n  {\"id\":739292,\"suggestedTranslation\":\"Mmm... Thanh long nướng.\",\"rating\":1.0},\n  {\"id\":739293,\"suggestedTranslation\":\"Ngủ ngon nhé, nhóc con.\",\"rating\":1.0},\n  {\"id\":739294,\"suggestedTranslation\":\"Tớ thà dùng lửa để thắp sáng đường đi còn hơn.\",\"rating\":1.0},\n  {\"id\":739295,\"suggestedTranslation\":\"Chắc là con mẹ rồi.\",\"rating\":1.0},\n  {\"id\":739296,\"suggestedTranslation\":\"Cậu phải đi chơi khăm tất cả mọi người chứ, sao lại chơi KHĂM tớ.\",\"rating\":1.0},\n  {\"id\":739297,\"suggestedTranslation\":\"Haha, ĐÚNG THẾ! %s!!\",\"rating\":1.0},\n  {\"id\":739298,\"suggestedTranslation\":\"Chào %s!\",\"rating\":1.0},\n  {\"id\":739299,\"suggestedTranslation\":\"Trông cậu có vẻ hơi tái mét đấy, đồ đỏ đỏ.\",\"rating\":1.0},\n  {\"id\":739300,\"suggestedTranslation\":\"Quái vật! Kẻ sát nhân! ĐỐT!\",\"rating\":1.0},\n  {\"id\":739301,\"suggestedTranslation\":\"Tớ đoán là %s không chỉ toàn trò quậy phá đâu.\",\"rating\":1.0},\n  {\"id\":739302,\"suggestedTranslation\":\"Đồ đạc của tớ tốt nhất là không nên nằm trong đó.\",\"rating\":1.0},\n  {\"id\":739303,\"suggestedTranslation\":\"Tớ đoán là nó giúp việc chết chóc đỡ phiền phức hơn phần nào.\",\"rating\":1.0},\n  {\"id\":739304,\"suggestedTranslation\":\"Anh ta không nhét linh hồn chúng ta vào trong đó được đâu nhỉ?\",\"rating\":1.0},\n  {\"id\":739305,\"suggestedTranslation\":\"Cậu đúng là một mối họa nhỏ thực sự đấy, phải không?\",\"rating\":1.0},\n  {\"id\":739306,\"suggestedTranslation\":\"Heh, giỏi lắm cô bé!\",\"rating\":1.0},\n  {\"id\":739307,\"suggestedTranslation\":\"Chào %s!\",\"rating\":1.0},\n  {\"id\":739308,\"suggestedTranslation\":\"Trời ạ, chuyện gì đã xảy ra với cậu thế?\",\"rating\":1.0},\n  {\"id\":739309,\"suggestedTranslation\":\"Đừng để tớ phải thổi bay cậu đấy!\",\"rating\":1.0},\n  {\"id\":739310,\"suggestedTranslation\":\"Cảm ơn vì đã giúp một tay, %s... hoặc là, ừm, một chiếc vuốt?\",\"rating\":1.0},\n  {\"id\":739311,\"suggestedTranslation\":\"Heh. Sao phải thích nghi với môi trường trong khi môi trường có thể thích nghi với cậu nhỉ?\",\"rating\":1.0},\n  {\"id\":739312,\"suggestedTranslation\":\"Heh. Sao phải thích nghi với môi trường trong khi môi trường có thể thích nghi với cậu nhỉ?\",\"rating\":1.0},\n  {\"id\":739313,\"suggestedTranslation\":\"Tốt hơn là nên hạ hỏa đi trước khi cậu nổi điên lên đấy, %s!\",\"rating\":1.0},\n  {\"id\":739314,\"suggestedTranslation\":\"Chúng ta đang châm lửa à?! Tớ tham gia với!\",\"rating\":1.0},\n  {\"id\":739315,\"suggestedTranslation\":\"Chào %s!\",\"rating\":1.0},\n  {\"id\":739316,\"suggestedTranslation\":\"Chắc tớ phải kiếm một trái tim cho %s thôi.\",\"rating\":1.0},\n  {\"id\":739317,\"suggestedTranslation\":\"Robot sát thủ! Đốt nó đi!\",\"rating\":1.0},\n  {\"id\":739318,\"suggestedTranslation\":\"Hahaha %s, cậu cũng quan tâm đến chúng tớ cơ à!\",\"rating\":1.0},\n  {\"id\":739319,\"