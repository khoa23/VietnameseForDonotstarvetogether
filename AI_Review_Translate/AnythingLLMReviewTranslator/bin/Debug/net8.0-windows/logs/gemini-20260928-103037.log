            "text": "[\n  {\"id\":737736,\"suggestedTranslation\":\"Tôi không biết Wolfgang đang bực bội cái gì, tôi thấy hiệu ứng lửa quá đỉnh luôn!\",\"rating\":9.0},\n  {\"id\":737737,\"suggestedTranslation\":\"Bạn biết chương trình biểu diễn người mạnh mẽ này cần gì không? Pháo hoa!\",\"rating\":9.0},\n  {\"id\":737738,\"suggestedTranslation\":\"Không, cảm ơn.\",\"rating\":9.0},\n  {\"id\":737739,\"suggestedTranslation\":\"Không phải lửa thật, nhưng vẫn khá vui.\",\"rating\":9.0},\n  {\"id\":737740,\"suggestedTranslation\":\"Hà! Lửa đánh bại nước!\",\"rating\":9.0},\n  {\"id\":737741,\"suggestedTranslation\":\"Chẳng vui tí nào, bắt tôi tập thể dục để giữ mát!\",\"rating\":9.0},\n  {\"id\":737742,\"suggestedTranslation\":\"Tôi NÓNG LÒNG muốn châm lửa cho nó rồi!\",\"rating\":9.0},\n  {\"id\":737743,\"suggestedTranslation\":\"Haha ôi trời, ai mà vẽ CÁI ĐÓ vậy?\",\"rating\":9.0},\n  {\"id\":737744,\"suggestedTranslation\":\"Trông có vẻ hơi trống trải.\",\"rating\":9.0},\n  {\"id\":737745,\"suggestedTranslation\":\"Nó giống một bảng hiệu, nhưng nhỏ hơn.\",\"rating\":9.0},\n  {\"id\":737746,\"suggestedTranslation\":\"Tội nghiệp. Bị kẹt trong mê cung này.\",\"rating\":9.0},\n  {\"id\":737747,\"suggestedTranslation\":\"Tôi muốn có cặp sừng lớn như thế!\",\"rating\":9.0},\n  {\"id\":737748,\"suggestedTranslation\":\"Tự hỏi mấy cái vòng đó có phải là dấu hiệu của tuổi tác không.\",\"rating\":9.0},\n  {\"id\":737749,\"suggestedTranslation\":\"Tốt hơn là nên làm nóng nó lại.\",\"rating\":9.0},\n  {\"id\":737750,\"suggestedTranslation\":\"Gớm ghiếc. Nhưng ít ra nó vừa ngon vừa nóng!\",\"rating\":9.0},\n  {\"id\":737751,\"suggestedTranslation\":\"Oooh, trông có vẻ cay đấy!\",\"rating\":9.0},\n  {\"id\":737752,\"suggestedTranslation\":\"Trồi lên ngó nghiêng cái coi!\",\"rating\":9.0},\n  {\"id\":737753,\"suggestedTranslation\":\"Thoát khỏi lòng đất, lao thẳng vào lửa.\",\"rating\":9.0},\n  {\"id\":737754,\"suggestedTranslation\":\"Trốn ánh sáng à?\",\"rating\":9.0},\n  {\"id\":737755,\"suggestedTranslation\":\"Haha gớm quá! Tôi vừa thấy nó ăn thứ gì đó qua mũi!\",\"rating\":9.0},\n  {\"id\":737756,\"suggestedTranslation\":\"Ê, nó đang ngủ trong bãi nước mũi của chính mình à?\",\"rating\":9.0},\n  {\"id\":737757,\"suggestedTranslation\":\"Tôi không chắc về cái này lắm...\",\"rating\":9.0},\n  {\"id\":737758,\"suggestedTranslation\":\"Nó đào hang trốn khỏi ngọn lửa bầu trời của mặt trời. Thật không tự nhiên.\",\"rating\":9.0},\n  {\"id\":737759,\"suggestedTranslation\":\"Quê chưa cưng! Tôi đốt đống phân này được đấy.\",\"rating\":9.0},\n  {\"id\":737760,\"suggestedTranslation\":\"Quả là một ngôi nhà dễ bắt lửa làm sao.\",\"rating\":9.0},\n  {\"id\":737761,\"suggestedTranslation\":\"Hừ. Chắc đây là lý do chẳng ai cho tôi vào pháo đài cây của họ.\",\"rating\":9.0},\n  {\"id\":737762,\"suggestedTranslation\":\"Uầy, chẳng bao giờ có ai cho tôi vào pháo đài cây của họ cả.\",\"rating\":9.0},\n  {\"id\":737763,\"suggestedTranslation\":\"Ừm, tôi có nên lo lắng về cái đó không nhỉ?\",\"rating\":9.0},\n  {\"id\":737764,\"suggestedTranslation\":\"Mấy cái đồ phế liệu kim loại tung tóe khắp nơi này là sao thế?\",\"rating\":9.0},\n  {\"id\":737765,\"suggestedTranslation\":\"Tự hỏi nó có cháy được không...\",\"rating\":9.0},\n  {\"id\":737766,\"suggestedTranslation\":\"Làm sếp xem chừng là một công việc khá nhàn hạ.\",\"rating\":9.0},\n  {\"id\":737767,\"suggestedTranslation\":\"Trông nó sẽ rất đẹp khi bốc cháy cho xem.\",\"rating\":9.0},\n  {\"id\":737768,\"suggestedTranslation\":\"Tôi đã chôm cái mũ của con khỉ ngốc nghếch đó rồi.\",\"rating\":9.0},\n  {\"id\":737769,\"suggestedTranslation\":\"Ngứa ngứa thế nào ấy...\",\"rating\":9.0},\n  {\"id\":737770,\"suggestedTranslation\":\"Mì, thịt và mấy nhúm tóc. Kinh tởm.\",\"rating\":9.0},\n  {\"id\":737771,\"suggestedTranslation\":\"Gớm ghiếc. Đầy lông lá là lông lá.\",\"rating\":9.0},\n  {\"id\":737772,\"suggestedTranslation\":\"Nó khô khốc và có mùi lạ.\",\"rating\":9.0},\n  {\"id\":737773,\"suggestedTranslation\":\"Kinh quá!\",\"rating\":9.0},\n  {\"id\":737774,\"suggestedTranslation\":\"Ồ nhìn kìa, một đống cục đá vỡ nát!\",\"rating\":9.0},\n  {\"id\":737775,\"suggestedTranslation\":\"Nó đang đợi thứ gì đó từ tôi.\",\"rating\":9.0},\n  {\"id\":737776,\"suggestedTranslation\":\"Ước gì! Nó đang làm điều hoàn toàn trái ngược với việc bốc cháy!\",\"rating\":9.0},\n  {\"id\":737777,\"suggestedTranslation\":\"Lẹ lên coi, hòn đá ngốc nghếch!\",\"rating\":9.0},\n  {\"id\":737778,\"suggestedTranslation\":\"Rõ ràng là sai bét nhè rồi.\",\"rating\":9.0},\n  {\"id\":737779,\"suggestedTranslation\":\"Này, quay lại đây mau!\",\"rating\":9.0},\n  {\"id\":737780,\"suggestedTranslation\":\"Tóm được ngươi rồi nhé.\",\"rating\":9.0},\n  {\"id\":737781,\"suggestedTranslation\":\"Chúng rớt ra từ một con bướm chết, gớm chết đi được.\",\"rating\":9.0},\n  {\"id\":737782,\"suggestedTranslation\":\"Chỉ là một cây con chưa bị đốt cháy thôi.\",\"rating\":9.0},\n  {\"id\":737783,\"suggestedTranslation\":\"Không xài được dưới này đâu.\",\"rating\":9.0},\n  {\"id\":737784,\"suggestedTranslation\":\"Cái quái gì thế? Tôi vẫn nhìn thấy mặt trăng cơ mà!\",\"rating\":9.0},\n  {\"id\":737785,\"suggestedTranslation\":\"Cứ có cảm giác nó đang trừng trừng nhìn tôi ấy.\",\"rating\":9.0},\n  {\"id\":737786,\"suggestedTranslation\":\"Nó tròn hết mức có thể rồi đấy.\",\"rating\":9.0},\n  {\"id\":737787,\"suggestedTranslation\":\"Trăng non! Tuyệt, tôi ghét cái cũ lắm rồi!\",\"rating\":9.0},\n  {\"id\":737788,\"suggestedTranslation\":\"Mặt trăng biến đi đâu mất rồi kìa!\",\"rating\":9.0},\n  {\"id\":737789,\"suggestedTranslation\":\"Mặt trăng đang tròn dần, không như tôi.\",\"rating\":9.0},\n  {\"id\":737790,\"suggestedTranslation\":\"Mà chúng ta cần thủy tinh làm cái quái gì cơ chứ?\",\"rating\":9.0},\n  {\"id\":737791,\"suggestedTranslation\":\"Mặt trăng CĂM THÙ cây cối.\",\"rating\":9.0},\n  {\"id\":737792,\"suggestedTranslation\":\"Cứ như có một ngọn lửa nhỏ ở bên trong ấy.\",\"rating\":9.0},\n  {\"id\":737793,\"suggestedTranslation\":\"Đó là một khối thủy tinh lớn!\",\"rating\":9.0},\n  {\"id\":737794,\"suggestedTranslation\":\"Chúng ta nên thử xông khói bắt chúng xem sao.\",\"rating\":9.0},\n  {\"id\":737795,\"suggestedTranslation\":\"Tuyệt thật. Một hòn đá tảng có lỗ thủng.\",\"rating\":9.0},\n  {\"id\":737796,\"suggestedTranslation\":\"Trông đểu cáng thế nào ấy.\",\"rating\":9.0},\n  {\"id\":737797,\"suggestedTranslation\":\"Với tôi thì nó cũng chỉ là một hòn đá tảng khác thôi.\",\"rating\":9.0},\n  {\"id\":737798,\"suggestedTranslation\":\"Chà, tôi không đốt được nó rồi.\",\"rating\":9.0},\n  {\"id\":737799,\"suggestedTranslation\":\"Ồ nhìn kìa! CỤC ĐÁ! Ựcccc!\",\"rating\":9.0},\n  {\"id\":737800,\"suggestedTranslation\":\"Mong là nó cháy trụi.\",\"rating\":9.0},\n  {\"id\":737801,\"suggestedTranslation\":\"Này, tôi thấy cả hình phản chiếu của mình kìa!\",\"rating\":9.0},\n  {\"id\":737802,\"suggestedTranslation\":\"Cứ như có một ngọn lửa nhỏ bên trong ấy.\",\"rating\":9.0},\n  {\"id\":737803,\"suggestedTranslation\":\"Ít ra tôi sẽ đeo nó trong cơn bão nơi chẳng ai nhìn thấy mình.\",\"rating\":9.0},\n  {\"id\":737804,\"suggestedTranslation\":\"Tôi chuẩn bị sờ vào nó đây.\",\"rating\":9.0},\n  {\"id\":737805,\"suggestedTranslation\":\"Đừng để bị điện giật nhé, ông già.\",\"rating\":9.0},\n  {\"id\":737806,\"suggestedTranslation\":\"Nó trống rỗng.\",\"rating\":9.0},\n  {\"id\":737807,\"suggestedTranslation\":\"Nó kêu lách tách, gần giống như tiếng lửa vậy.\",\"rating\":9.0},\n  {\"id\":737808,\"suggestedTranslation\":\"Tôi cứ có cái thúc giục muốn bắt lấy nó.\",\"rating\":9.0},\n  {\"id\":737809,\"suggestedTranslation\":\"Lắp lại hoàn chỉnh thế này cảm giác dễ chịu phết nhỉ?\",\"rating\":9.0},\n  {\"id\":737810,\"suggestedTranslation\":\"Sắp xong rồi, thề luôn.\",\"rating\":9.0},\n  {\"id\":737811,\"suggestedTranslation\":\"Lại được về bên nhau rồi.\",\"rating\":9.0},\n  {\"id\":737812,\"suggestedTranslation\":\"Sao tôi cứ có linh cảm chúng ta vẫn chưa xong việc nhỉ?\",\"rating\":9.0},\n  {\"id\":737813,\"suggestedTranslation\":\"Biết sao không, sẽ dễ hơn nhiều nếu cậu không nặng đến thế.\",\"rating\":9.0},\n  {\"id\":737814,\"suggestedTranslation\":\"Ừm, tất nhiên là tôi sẽ khuân cậu ra đó rồi.\",\"rating\":9.0},\n  {\"id\":737815,\"suggestedTranslation\":\"Được rồi, được rồi, đi thôi nào.\",\"rating\":9.0},\n  {\"id\":737816,\"suggestedTranslation\":\"Nào, để tôi đưa cậu về nhà nhé.\",\"rating\":9.0},\n  {\"id\":737817,\"suggestedTranslation\":\"Á hay thật đấy! Cái quái gì thế này?!\",\"rating\":9.0},\n  {\"id\":737818,\"suggestedTranslation\":\"Thứ gì đó bên trong đang gọi tôi kìa.\",\"rating\":9.0},\n  {\"id\":737819,\"suggestedTranslation\":\"Thứ gì đó bên trong đang gọi tôi kìa.\",\"rating\":9.0},\n  {\"id\":737820,\"suggestedTranslation\":\"Thứ gì đó bên trong đang gọi tôi kìa.\",\"rating\":9.0},\n  {\"id\":737821,\"suggestedTranslation\":\"Cậu muốn đi đâu nào?\",\"rating\":9.0},\n  {\"id\":737822,\"suggestedTranslation\":\"Cậu nói đúng, tôi thực sự là người hợp nhất để giúp cậu đấy.\",\"rating\":9.0},\n  {\"id\":737823,\"suggestedTranslation\":\"Cây nấm gì mà trông dị thế.\",\"rating\":9.0},\n  {\"id\":737824,\"suggestedTranslation\":\"Lại một lần nữa, lửa làm cho mọi thứ ngon hơn.\",\"rating\":9.0},\n  {\"id\":737825,\"suggestedTranslation\":\"Ưcccc, sao lão già đó không tự xây cái thứ này đi cơ chứ?\",\"rating\":9.0},\n  {\"id\":737826,\"suggestedTranslation\":\"Chắc tôi cứ đốt quách nó đi cho rồi, nhưng giờ lại thấy tò mò tò mò...\",\"rating\":9.0},\n  {\"id\":737827,\"suggestedTranslation\":\"Tuyệt! Vậy nó dùng để làm gì?\",\"rating\":9.0},\n  {\"id\":737828,\"suggestedTranslation\":\"Ghê quá, hình như nó đang thì thầm với tôi.\",\"rating\":9.0},\n  {\"id\":737829,\"suggestedTranslation\":\"Chịu, chắc chúng ta nhét mấy thứ vào đó được đấy.\",\"rating\":9.0},\n  {\"id\":737830,\"suggestedTranslation\":\"À hóa ra cô ấy dùng cách đó để đuổi mấy kẻ rợn người ấy đi à.\",\"rating\":9.0},\n  {\"id\":737831,\"suggestedTranslation\":\"HAHA, ĐÚNG RỒI!\",\"rating\":9.0},\n  {\"id\":737832,\"suggestedTranslation\":\"Tôi không thấy áy náy như mình tưởng tượng.\",\"rating\":9.0},\n  {\"id\":737833,\"suggestedTranslation\":\"Nó không mọc lại được nữa đâu.\",\"rating\":9.0},\n  {\"id\":737834,\"suggestedTranslation\":\"Nó đẹp quá, suýt thì tôi thấy tội lỗi khi đốt nó đấy!\",\"rating\":9.0},\n  {\"id\":737835,\"suggestedTranslation\":\"Cái này trông sẽ còn đẹp hơn nếu nó bốc cháy.\",\"rating\":9.0},\n  {\"id\":737836,\"suggestedTranslation\":\"Mừm... Khô quá. Dễ bén lửa ghê.\",\"rating\":9.0},\n  {\"id\":737837,\"suggestedTranslation\":\"Cái quái gì trên thế giới này thế...\",\"rating\":9.0},\n  {\"id\":737838,\"suggestedTranslation\":\"To bự chảng luôn!\",\"rating\":9.0},\n  {\"id\":737839,\"suggestedTranslation\":\"Ối dồi, nghe mùi như đít chim ấy!\",\"rating\":9.0},\n  {\"id\":737840,\"suggestedTranslation\":\"Trông ngon vãi chưởng!\",\"rating\":9.0},\n  {\"id\":737841,\"suggestedTranslation\":\"Phiền phức vãi!\",\"rating\":9.0},\n  {\"id\":737842,\"suggestedTranslation\":\"Tránh cái vòi đó ra xa tôi mau!\",\"rating\":9.0},\n  {\"id\":737843,\"suggestedTranslation\":\"Quả là một cách ra đi ngứa ngáy làm sao.\",\"rating\":9.0},\n  {\"id\":737844,\"suggestedTranslation\":\"Bản thân đống phân chưa đủ gớm hay sao?\",\"rating\":9.0},\n  {\"id\":737845,\"suggestedTranslation\":\"Cái này làm tôi nhớ đến cơn ác mộng từng gặp hồi trước.\",\"rating\":9.0},\n  {\"id\":737846,\"suggestedTranslation\":\"Chẳng bằng một góc Bernie.\",\"rating\":9.0},\n  {\"id\":737847,\"suggestedTranslation\":\"Máu chắc hẳn đang sủi bọt trong những dòng chảy đục ngầu và đặc quánh.\",\"rating\":9.0},\n  {\"id\":737848,\"suggestedTranslation\":\"Mấy cái lông của nó bị xơ xác rồi.\",\"rating\":9.0},\n  {\"id\":737849,\"suggestedTranslation\":\"Nó chịu còn hơn tôi phải chịu.\",\"rating\":9.0},\n  {\"id\":737850,\"suggestedTranslation\":\"Chắc là đầy đồ chết trôi trong đó rồi.\",\"rating\":9.0},\n  {\"id\":737851,\"suggestedTranslation\":\"À, cảm giác như có một ngọn lửa ấm áp trong bụng vậy.\",\"rating\":9.0},\n  {\"id\":737852,\"suggestedTranslation\":\"Mấy sợi dây leo cứ cuộn mình tránh xa bật lửa của tôi... lạ thật!\",\"rating\":9.0},\n  {\"id\":737853,\"suggestedTranslation\":\"Nó được làm bằng thứ đá đểu nào đó mà tôi không đốt nổi.\",\"rating\":9.0},\n  {\"id\":737854,\"suggestedTranslation\":\"Nó tiện ích thật đấy!\",\"rating\":9.0},\n  {\"id\":737855,\"suggestedTranslation\":\"Kinh quá, nó đang rải bào tử khắp nơi kìa!\",\"rating\":9.0},\n  {\"id\":737856,\"suggestedTranslation\":\"Cô ta sắp nổ tung rồi kìa!\",\"rating\":9.0},\n  {\"id\":737857,\"suggestedTranslation\":\"Tôi không thích có ai táy máy lên đầu mình đâu.\",\"rating\":9.0},\n  {\"id\":737858,\"suggestedTranslation\":\"Sao cách đó lại không hiệu quả cơ chứ?!\",\"rating\":9.0},\n  {\"id\":737859,\"suggestedTranslation\":\"Một cây nấm to gớm ghiếc! Đốt nó đi!\",\"rating\":9.0},\n  {\"id\":737860,\"suggestedTranslation\":\"Vấn đề nấm mốc đã được giải quyết.\",\"rating\":9.0},\n  {\"id\":737861,\"suggestedTranslation\":\"Chỉ là một khúc gỗ ngốc nghếch.\",\"rating\":9.0},\n  {\"id\":737862,\"suggestedTranslation\":\"Gớm chết đi được, chúng đang chiếm lấy chỗ này kìa!\",\"rating\":9.0},\n  {\"id\":737863,\"suggestedTranslation\":\"Kinh tởm. Đốt cho sạch đống đồ thối này đi.\",\"rating\":9.0},\n  {\"id\":737864,\"suggestedTranslation\":\"Tôi chắc là lửa sẽ giải quyết được việc đó.\",\"rating\":9.0},\n  {\"id\":737865,\"suggestedTranslation\":\"Giờ có mấy cây nấm mọc trong đó rồi kìa.\",\"rating\":9.0},\n  {\"id\":737866,\"suggestedTranslation\":\"Trời ạ, ai mà cần lắm nấm thế cơ chứ?\",\"rating\":9.0},\n  {\"id\":737867,\"suggestedTranslation\":\"Thôi nào, biết ngay mà lại.\",\"rating\":9.0},\n  {\"id\":737868,\"suggestedTranslation\":\"Cây nấm ngốc này không chịu phát sáng kìa.\",\"rating\":9.0},\n  {\"id\":737869,\"suggestedTranslation\":\"Không dễ chịu bằng ngọn lửa ấm áp.\",\"rating\":9.0},\n  {\"id\":737870,\"suggestedTranslation\":\"Giờ sao nữa đây?\",\"rating\":9.0},\n  {\"id\":737871,\"suggestedTranslation\":\"Tôi có vài ý tưởng về cách thắp sáng nó đấy. Hì hì.\",\"rating\":9.0},\n  {\"id\":737872,\"suggestedTranslation\":\"Pết, đúng là một ý tưởng sáng suốt nhỉ.\",\"rating\":9.0},\n  {\"id\":737873,\"suggestedTranslation\":\"Tôi phải kiểm tra xem nó còn cháy được không đã.\",\"rating\":9.0},\n  {\"id\":737874,\"suggestedTranslation\":\"Nó đang rải rác mấy thứ rác rưởi khắp nơi kìa.\",\"rating\":9.0},\n  {\"id\":737875,\"suggestedTranslation\":\"Gớm ghiếc. Ngửi như đít yêu tinh ấy.\",\"rating\":9.0},\n  {\"id\":737876,\"suggestedTranslation\":\"Cược là cái này trông sẽ rất đẹp nếu tôi châm lửa đốt nó đấy.\",\"rating\":9.0},\n  {\"id\":737877,\"suggestedTranslation\":\"Tôi phải kiểm tra xem nó còn cháy được không đã.\",\"rating\":9.0},\n  {\"id\":737878,\"suggestedTranslation\":\"Eo, tôi không muốn đến gần đâu.\",\"rating\":9.0},\n  {\"id\":737879,\"suggestedTranslation\":\"Kinh chết đi được. Toàn mùi nấm.\",\"rating\":9.0},\n  {\"id\":737880,\"suggestedTranslation\":\"Tôi phải kiểm tra xem nó còn cháy được không đã.\",\"rating\":9.0},\n  {\"id\":737881,\"suggestedTranslation\":\"Ái! Hôi rình!\",\"rating\":9.0},\n  {\"id\":737882,\"suggestedTranslation\":\"Gớm chết. Cây này đang ốm o khắp người rồi.\",\"rating\":9.0},\n  {\"id\":737883,\"suggestedTranslation\":\"Tôi phải kiểm tra xem nó còn cháy được không đã.\",\"rating\":9.0},\n  {\"id\":737884,\"suggestedTranslation\":\"Cây đó nhận được những gì nó xứng đáng rồi đấy.\",\"rating\":9.0},\n  {\"id\":737885,\"suggestedTranslation\":\"Tôi đã từng kể bạn thân của tôi là một con gấu chưa nhỉ?\",\"rating\":9.0},\n  {\"id\":737886,\"suggestedTranslation\":\"Mày nhìn cái gì hả con chim kỳ quặc kia?\",\"rating\":9.0},\n  {\"id\":737887,\"suggestedTranslation\":\"Kinh tởm!\",\"rating\":9.0},\n  {\"id\":737888,\"suggestedTranslation\":\"Con diều hâu đó lại sắp giở trò gì rồi.\",\"rating\":9.0},\n  {\"id\":737889,\"suggestedTranslation\":\"Ơ... không giận dỗi gì nữa nhé, phải không?\",\"rating\":9.0},\n  {\"id\":737890,\"suggestedTranslation\":\"Đáng đời lắm.\",\"rating\":9.0},\n  {\"id\":737891,\"suggestedTranslation\":\"KINH THẬT! Thứ gì thế kia?!\",\"rating\":9.0},\n  {\"id\":737892,\"suggestedTranslation\":\"Eo ôi, tôi thấy nó đang thở kìa.\",\"rating\":9.0},\n  {\"id\":737893,\"suggestedTranslation\":\"Đừng lo, mày vẫn sẽ ngỏm trong biển lửa thôi.\",\"rating\":9.0},\n  {\"id\":737894,\"suggestedTranslation\":\"Eo, nó chết ngóm rồi kìa.\",\"rating\":9.0},\n  {\"id\":737895,\"suggestedTranslation\":\"ĐỐT NÓ ĐI.\",\"rating\":9.0},\n  {\"id\":737896,\"suggestedTranslation\":\"Tôi không muốn đánh thức nó đâu.\",\"rating\":9.0},\n  {\"id\":737897,\"suggestedTranslation\":\"Eo ôi, có mấy cái chân lòi ra kìa!\",\"rating\":9.0},\n  {\"id\":737898,\"suggestedTranslation\":\"Eo ôi, có mấy cái chân lòi ra kìa!\",\"rating\":9.0},\n  {\"id\":737899,\"suggestedTranslation\":\"Đưa một cái cho Wilson đi, tôi chắc chắn anh ta sẽ rRất thích thử nó đấy! Hì hì.\",\"rating\":9.0},\n  {\"id\":737900,\"suggestedTranslation\":\"Đưa một cái cho Wilson đi, tôi chắc chắn anh ta sẽ rRất thích thử nó đấy! Hì hì.\",\"rating\":9.0},\n  {\"id\":737901,\"suggestedTranslation\":\"Eo ôi, có mấy cái chân lòi ra kìa!\",\"rating\":9.0},\n  {\"id\":737902,\"suggestedTranslation\":\"Đưa một cái cho Wilson đi, tôi chắc chắn anh ta sẽ rRất thích thử nó đấy! Hì hì.\",\"rating\":9.0},\n  {\"id\":737903,\"suggestedTranslation\":\"Đưa một cái cho Wilson đi, tôi chắc chắn anh ta sẽ rRất thích thử nó đấy! Hì hì.\",\"rating\":9.0},\n  {\"id\":737904,\"suggestedTranslation\":\"Mấy bông hoa này khô đi sẽ thành củi khô tuyệt đấy.\",\"rating\":9.0},\n  {\"id\":737905,\"suggestedTranslation\":\"Tôi có mũ ngủ rồi, thế còn chân nến của tôi đâu?\",\"rating\":9.0},\n  {\"id\":737906,\"suggestedTranslation\":\"Nó giống lửa, nhưng có màu tím!\",\"rating\":9.0},\n  {\"id\":737907,\"suggestedTranslation\":\"Eo ôi, nó vẫn còn ấm kìa!\",\"rating\":9.0},\n  {\"id\":737908,\"suggestedTranslation\":\"Chắc là... không tốt lắm đâu...\",\"rating\":9.0},\n  {\"id\":737909,\"suggestedTranslation\":\"Ánh sáng mà không có lửa thì thật không tự nhiên.\",\"rating\":9.0},\n  {\"id\":737910,\"suggestedTranslation\":\"Chắc anh ta không phiền nếu tôi ăn ké một miếng nhỏ đâu nhỉ.\",\"rating\":9.0},\n  {\"id\":737911,\"suggestedTranslation\":\"Trông bình thường đối với tôi.\",\"rating\":9.0},\n  {\"id\":737912,\"suggestedTranslation\":\"Chắc là sắp qua rồi.\",\"rating\":9.0},\n  {\"id\":737913,\"suggestedTranslation\":\"Tôi không nghĩ nó đang hoạt động đâu.\",\"rating\":9.0},\n  {\"id\":737914,\"suggestedTranslation\":\"Nó gần như đang ngân nga ấy.\",\"rating\":9.0},\n  {\"id\":737915,\"suggestedTranslation\":\"Tôi nghĩ nó đang tắt dần rồi.\",\"rating\":9.0},\n  {\"id\":737916,\"suggestedTranslation\":\"Nó đang cảnh báo tôi đấy.\",\"rating\":9.0},\n  {\"id\":737917,\"suggestedTranslation\":\"Nhiên liệu đang hồi sinh rồi!\",\"rating\":9.0},\n  {\"id\":737918,\"suggestedTranslation\":\"Sẽ tuyệt hơn nhiều nếu nó bốc cháy...\",\"rating\":9.0},\n  {\"id\":737919,\"suggestedTranslation\":\"Nó giống như những giấc mơ có thể làm tổn thương vật thật vậy!\",\"rating\":9.0},\n  {\"id\":737920,\"suggestedTranslation\":\"Có những vụ nổ tí hon bị kẹt bên trong đấy.\",\"rating\":9.0},\n  {\"id\":737921,\"suggestedTranslation\":\"Tôi không hiểu sao thứ gì có thể mọc nổi trong trận mưa kỳ quặc đó.\",\"rating\":9.0},\n  {\"id\":737922,\"suggestedTranslation\":\"Để làm gì chứ? Tôi có phản xạ của loài mèo cơ mà!\",\"rating\":9.0},\n  {\"id\":737923,\"suggestedTranslation\":\"Wilson cần cái này hơn. Đồ vụng về!\",\"rating\":9.0},\n  {\"id\":737924,\"suggestedTranslation\":\"Chà, tôi luôn ao ước có tầm nhìn nhìn thấy đất... chưa từng có ai nói thế cả.\",\"rating\":9.0},\n  {\"id\":737925,\"suggestedTranslation\":\"Chèo thuyền ngốc nghếch thật. Sao chúng ta không dùng buồm luôn cho rồi?\",\"rating\":9.0},\n  {\"id\":737926,\"suggestedTranslation\":\"Hừ. Đến lượt người khác chèo được không vậy?\",\"rating\":9.0},\n  {\"id\":737927,\"suggestedTranslation\":\"Này, hóa ra chèo thuyền cũng thú vị phết đấy chứ!\",\"rating\":9.0},\n  {\"id\":737928,\"suggestedTranslation\":\"Toàn là đất cát không.\",\"rating\":9.0},\n  {\"id\":737929,\"suggestedTranslation\":\"Toàn là nước không.\",\"rating\":9.0},\n  {\"id\":737930,\"suggestedTranslation\":\"Chỉ là một cục gớm ghiếc lớn.\",\"rating\":9.0},\n  {\"id\":737931,\"suggestedTranslation\":\"Làm sao tôi đốt được nó khi nó đang ở dưới nước cơ chứ?\",\"rating\":9.0},\n  {\"id\":737932,\"suggestedTranslation\":\"Làm sao tôi đốt được nó khi nó đang ở dưới nước cơ chứ?\",\"rating\":9.0},\n  {\"id\":737933,\"suggestedTranslation\":\"Làm sao tôi đốt được nó khi nó đang ở dưới nước cơ chứ?\",\"rating\":9.0},\n  {\"id\":737934,\"suggestedTranslation\":\"Sẽ thế nào nếu — nghe tôi nói đã nhé — tôi châm lửa đốt nó nhỉ?\",\"rating\":9.0},\n  {\"id\":737935,\"suggestedTranslation\":\"Sẽ thế nào nếu — nghe tôi nói đã nhé — tôi châm lửa đốt nó nhỉ?\",\"rating\":9.0},\n  {\"id\":737936,\"suggestedTranslation\":\"Không cần phao hay thứ gì đó à?\",\"rating\":9.0},\n  {\"id\":737937,\"suggestedTranslation\":\"Làm sao tôi đốt được nó khi nó đang ở dưới nước cơ chứ?\",\"rating\":9.0},\n  {\"id\":737938,\"suggestedTranslation\":\"Làm sao tôi đốt được nó khi nó đang ở dưới nước cơ chứ?\",\"rating\":9.0},\n  {\"id\":737939,\"suggestedTranslation\":\"Làm sao tôi đốt được nó khi nó đang ở dưới nước cơ chứ?\",\"rating\":9.0},\n  {\"id\":737940,\"suggestedTranslation\":\"Khoan, mình đang làm gì ấy nhỉ? Ồ hay quá, một con mồi giả mới!\",\"rating\":9.0},\n  {\"id\":737941,\"suggestedTranslation\":\"Con mồi giả này đang làm mặt quạu với tôi kìa...\",\"rating\":9.0},\n  {\"id\":737942,\"suggestedTranslation\":\"Hừ. Sao tôi lại muốn làm gì đó trời mưa cơ chứ?\",\"rating\":9.0},\n  {\"id\":737943,\"suggestedTranslation\":\"Chắc tôi vừa được câu cá vừa bị cảm lạnh cùng lúc mất.\",\"rating\":9.0},\n  {\"id\":737944,\"suggestedTranslation\":\"Hà! Cá ngốc thật đấy- Ái! Trẻ trâu thật, sắc thế chứ lị.\",\"rating\":9.0},\n  {\"id\":737945,\"suggestedTranslation\":\"Hà! Cá ngốc thật đấy- Ái! Trẻ trâu thật, sắc thế chứ lị.\",\"rating\":9.0},\n  {\"id\":737946,\"suggestedTranslation\":\"Hà! Cá ngốc thật đấy- Ái! Trẻ trâu thật, sắc thế chứ lị.\",\"rating\":9.0},\n  {\"id\":737947,\"suggestedTranslation\":\"Hà! Cá ngốc thật đấy- Ái! Trẻ trâu thật, sắc thế chứ lị.\",\"rating\":9.0},\n  {\"id\":737948,\"suggestedTranslation\":\"Hà! Cá ngốc thật đấy- Ái! Trẻ trâu thật, sắc thế chứ lị.\",\"rating\":9.0},\n  {\"id\":737949,\"suggestedTranslation\":\"Hà! Cá ngốc thật đấy- Ái! Trẻ trâu thật, sắc thế chứ lị.\",\"rating\":9.0},\n  {\"id\":737950,\"suggestedTranslation\":\"Hết chỗ trốn rồi nhé, đồ cá cụ!\",\"rating\":9.0},\n  {\"id\":737951,\"suggestedTranslation\":\"Eo, con đó trông kinh quá!\",\"rating\":9.0},\n  {\"id\":737952,\"suggestedTranslation\":\"Thôi đừng nhìn tôi kiểu đó nữa!\",\"rating\":9.0},\n  {\"id\":737953,\"suggestedTranslation\":\"Có cái quái gì mà hào nhoáng thế nhỉ?\",\"rating\":9.0},\n  {\"id\":737954,\"suggestedTranslation\":\"Hà! Tôi không sợ chút vận rủi cỏn con đâu.\",\"rating\":9.0},\n  {\"id\":737955,\"suggestedTranslation\":\"Cái gì... thế này?\",\"rating\":9.0},\n  {\"id\":737956,\"suggestedTranslation\":\"Cũng khá xinh đối với một sinh vật sống dưới nước.\",\"rating\":9.0},\n  {\"id\":737957,\"suggestedTranslation\":\"Cũng khá xinh đối với một sinh vật sống dưới nước.\",\"rating\":9.0},\n  {\"id\":737958,\"suggestedTranslation\":\"Đố đứa nào dám liếm nó đấy!\",\"rating\":9.0},\n  {\"id\":737959,\"suggestedTranslation\":\"Lại một con cá ngốc khác.\",\"rating\":9.0},\n  {\"id\":737960,\"suggestedTranslation\":\"Chỉ là một con cá nhỏ ngốc nghếch.\",\"rating\":9.0},\n  {\"id\":737961,\"suggestedTranslation\":\"Cái gì thế này-? Nhỏ xíu hà!\",\"rating\":9.0},\n  {\"id\":737962,\"suggestedTranslation\":\"Này! Tao cứ tưởng mày phải là một con cá bự chớ!\",\"rating\":9.0},\n  {\"id\":737963,\"suggestedTranslation\":\"Trông giống con tép hơn đối với tôi đấy.\",\"rating\":9.0},\n  {\"id\":737964,\"suggestedTranslation\":\"Lạ thật...\",\"rating\":9.0},\n  {\"id\":737965,\"suggestedTranslation\":\"Tôi có cảm giác nó sẽ làm bùi nhùi tuyệt vời lắm đấy.\",\"rating\":9.0},\n  {\"id\":737966,\"suggestedTranslation\":\"Cậu... có thứ gì đó đang mọc trên trán kìa.\",\"rating\":9.0},\n  {\"id\":737967,\"suggestedTranslation\":\"Thật đáng buồn... một đồng chí cuồng lửa lại bị ép sống dưới nước cả đời!\",\"rating\":9.0},\n  {\"id\":737968,\"suggestedTranslation\":\"Này! Đi khạc nhổ vào đứa khác mau!\",\"rating\":9.0},\n  {\"id\":737969,\"suggestedTranslation\":\"Heh, tưởng ra đây trên mặt nước là né được bật lửa của tôi chắc?\",\"rating\":9.0},\n  {\"id\":737970,\"suggestedTranslation\":\"Hừ, vẫn còn ướt nhẹp.\",\"rating\":9.0},\n  {\"id\":737971,\"suggestedTranslation\":\"Này, nó sẽ ngăn mặt trời đốt cháy mọi vật kìa!\",\"rating\":9.0},\n  {\"id\":737972,\"suggestedTranslation\":\"Ồ nhìn kìa, một sợi bấc dài thật dài!\",\"rating\":9.0},\n  {\"id\":737973,\"suggestedTranslation\":\"Eo ôi nhìn nó cứ lủng lẳng ở trên kìa!\",\"rating\":9.0},\n  {\"id\":737974,\"suggestedTranslation\":\"Lửa là một thợ trang trí lại nội thất nhanh chóng đấy.\",\"rating\":9.0},\n  {\"id\":737975,\"suggestedTranslation\":\"Một đống rác biển thì có gì mà tôi phải quan tâm chứ.\",\"rating\":9.0},\n  {\"id\":737976,\"suggestedTranslation\":\"Ơ, chúng ta không thể đi đường ngắm cảnh thay thế à?\",\"rating\":9.0},\n  {\"id\":737977,\"suggestedTranslation\":\"Một mẻ khá khẩm đấy.\",\"rating\":9.0},\n  {\"id\":737978,\"suggestedTranslation\":\"Cá ngốc!! Mày không được phép trốn thoát chứ bộ!\",\"rating\":9.0},\n  {\"id\":737979,\"suggestedTranslation\":\"Thế là ổn rồi đấy.\",\"rating\":9.0},\n  {\"id\":737980,\"suggestedTranslation\":\"Nó làm hộ tôi hết mọi việc luôn!\",\"rating\":9.0},\n  {\"id\":737981,\"suggestedTranslation\":\"Cược là lúc này nó đang bắt được khối cá rồi đây.\",\"rating\":9.0},\n  {\"id\":737982,\"suggestedTranslation\":\"Hay là mình dụ dỗ đứa trẻ nào đó xây nó hộ mình nhỉ.\",\"rating\":9.0},\n  {\"id\":737983,\"suggestedTranslation\":\"Chà, vậy tôi phải làm gì với cái này bây giờ?\",\"rating\":9.0},\n  {\"id\":737984,\"suggestedTranslation\":\"Đầy ắp rồi còn gì!\",\"rating\":9.0},\n  {\"id\":737985,\"suggestedTranslation\":\"Tham lam ghê nhỉ?\",\"rating\":9.0},\n  {\"id\":737986,\"suggestedTranslation\":\"Chà, vậy tôi phải làm gì với cái này bây giờ?\",\"rating\":9.0},\n  {\"id\":737987,\"suggestedTranslation\":\"Đầy ắp rồi còn gì!\",\"rating\":9.0},\n  {\"id\":737988,\"suggestedTranslation\":\"Tham lam ghê nhỉ?\",\"rating\":9.0},\n  {\"id\":737989,\"suggestedTranslation\":\"Tôi cũng làm pháo hoa được luôn đấy nhé!\",\"rating\":9.0},\n  {\"id\":737990,\"suggestedTranslation\":\"Nó tròn ủng ra ấy.\",\"rating\":9.0},\n  {\"id\":737991,\"suggestedTranslation\":\"Nướng lên. Phương pháp nấu ăn yêu thích của tôi.\",\"rating\":9.0},\n  {\"id\":737992,\"suggestedTranslation\":\"Tôi phải nghĩ xem nên làm gì với đống hành tây này đây...\",\"rating\":9.0},\n  {\"id\":737993,\"suggestedTranslation\":\"Chỉ là một đám hạt giống thôi.\",\"rating\":9.0},\n  {\"id\":737994,\"suggestedTranslation\":\"Nó lấp lánh và thôi miên, giống như ngọn lửa vậy!\",\"rating\":9.0},\n  {\"id\":737995,\"suggestedTranslation\":\"Phải cầm bằng tay áo kẻo cóng tay mất.\",\"rating\":9.0},\n  {\"id\":737996,\"suggestedTranslation\":\"Nó nhặt mấy thứ đang cháy kìa!\",\"rating\":9.0},\n  {\"id\":737997,\"suggestedTranslation\":\"Nó sẽ làm ngón tay bạn tê rần lên đấy.\",\"rating\":9.0},\n  {\"id\":737998,\"suggestedTranslation\":\"Đó là một hòn đá. Xí!\",\"rating\":9.0},\n  {\"id\":737999,\"suggestedTranslation\":\"Làm tôi nhức cả đầu.\",\"rating\":9.0},\n  {\"id\":738000,\"suggestedTranslation\":\"Đồ cướp biển thối tha!\",\"rating\":9.0},\n  {\"id\":738001,\"suggestedTranslation\":\"Trông có vẻ trống không. Đốt quách nó đi cho rồi.\",\"rating\":9.0},\n  {\"id\":738002,\"suggestedTranslation\":\"Tôi nên lấy thứ gì ở trong đó đã. Rồi đốt nó sau.\",\"rating\":9.0},\n  {\"id\":738003,\"suggestedTranslation\":\"Tôi nghĩ chúng ta đang gặp rắc rối to rồi đấy.\",\"rating\":9.0},\n  {\"id\":738004,\"suggestedTranslation\":\"Oaaah, lại thêm một cái cây để đốt!\",\"rating\":9.0},\n  {\"id\":738005,\"suggestedTranslation\":\"Rồi có ngày mày sẽ lớn đến mức đủ tiêu chuẩn để đốn làm củi đấy.\",\"rating\":9.0},\n  {\"id\":738006,\"suggestedTranslation\":\"Eo ôi, cây cối mà cũng có vẩy á?!\",\"rating\":9.0},\n  {\"id\":738007,\"suggestedTranslation\":\"Vẫn chưa hẳn là một cái cây.\",\"rating\":9.0},\n  {\"id\":738008,\"suggestedTranslation\":\"Hơi bị lòe loẹt đấy.\",\"rating\":9.0},\n  {\"id\":738009,\"suggestedTranslation\":\"Là do mình đói bụng hay mọi thứ trông ngon hơn bình thường vậy?\",\"rating\":9.0},\n  {\"id\":738010,\"suggestedTranslation\":\"Âm nhạc chán ngắt.\",\"rating\":9.0},\n  {\"id\":738011,\"suggestedTranslation\":\"Cược là nó sẽ cháy to lắm đây!\",\"rating\":9.0},\n  {\"id\":738012,\"suggestedTranslation\":\"Trông mỏng manh quá mức, khiến tôi chỉ muốn bóp nát nó thôi.\",\"rating\":9.0},\n  {\"id\":738013,\"suggestedTranslation\":\"Nó có cái mông có vũ trang kìa!\",\"rating\":9.0},\n  {\"id\":738014,\"suggestedTranslation\":\"Chạy đi, mấy vũ công tí hon.\",\"rating\":9.0},\n  {\"id\":738015,\"suggestedTranslation\":\"Cháy đi, chim cánh cụt, cháy đi.\",\"rating\":9.0},\n  {\"id\":738016,\"suggestedTranslation\":\"Để tôi làm vinh dự này nhé?\",\"rating\":9.0},\n  {\"id\":738017,\"suggestedTranslation\":\"Tôi có cần phải nói ra luôn không nhỉ?\",\"rating\":9.0},\n  {\"id\":738018,\"suggestedTranslation\":\"Được. Mấy trái này cay đây.\",\"rating\":9.0},\n  {\"id\":738019,\"suggestedTranslation\":\"Miệng tôi đang bốc cháy nè!\",\"rating\":9.0},\n  {\"id\":738020,\"suggestedTranslation\":\"Quy tắc số một của rau củ: lửa làm chúng ngon hơn.\",\"rating\":9.0},\n  {\"id\":738021,\"suggestedTranslation\":\"Đó là một đống đồ cay xè!\",\"rating\":9.0},\n  {\"id\":738022,\"suggestedTranslation\":\"Chỉ là một đám hạt giống thôi.\",\"rating\":9.0},\n  {\"id\":738023,\"suggestedTranslation\":\"Con chim đáng ghét! Tránh xa mấy trái dâu rừng ngon lành đó ra!\",\"rating\":9.0},\n  {\"id\":738024,\"suggestedTranslation\":\"Đúng là một cái quạt chà bá.\",\"rating\":9.0},\n  {\"id\":738025,\"suggestedTranslation\":\"Ừm, giờ thì nó cháy tiêu rồi.\",\"rating\":9.0},\n  {\"id\":738026,\"suggestedTranslation\":\"Giờ chúng ta phải làm gì tiếp đây?\",\"rating\":9.0},\n  {\"id\":738027,\"suggestedTranslation\":\"Tôi còn chẳng thích lũ chim tham ăn đó ấy chứ!\",\"rating\":9.0},\n  {\"id\":738028,\"suggestedTranslation\":\"Mấy món ngon lành, được niêm phong bằng lửa.\",\"rating\":9.0},\n  {\"id\":738029,\"suggestedTranslation\":\"Mấy bông hoa ngốc nghếch. Chẳng tích sự gì mấy.\",\"rating\":9.0},\n  {\"id\":738030,\"suggestedTranslation\":\"Mừm... Khô quá. Dễ bén lửa ghê.\",\"rating\":9.0},\n  {\"id\":738031,\"suggestedTranslation\":\"Eo, chúng dính dớp thế nào ấy.\",\"rating\":9.0},\n  {\"id\":738032,\"suggestedTranslation\":\"Mừm... Khô quá. Dễ bén lửa ghê.\",\"rating\":9.0},\n  {\"id\":738033,\"suggestedTranslation\":\"Giờ thì tôi đốt nó kiểu gì đây?\",\"rating\":9.0},\n  {\"id\":738034,\"suggestedTranslation\":\"Kinh quá! Đốt nó đi thôi.\",\"rating\":9.0},\n  {\"id\":738035,\"suggestedTranslation\":\"Ồ, Maxwell sẽ thích cái này lắm đây.\",\"rating\":9.0}\n]",
