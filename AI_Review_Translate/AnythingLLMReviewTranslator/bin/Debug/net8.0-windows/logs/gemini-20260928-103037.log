            "text": "[\n  {\"id\":740486,\"suggestedTranslation\":\"Ta tóm lấy ngươi bây giờ!\",\"rating\":9.0},\n  {\"id\":740487,\"suggestedTranslation\":\"Phải làm việc trước khi chơi chứ.\",\"rating\":9.0},\n  {\"id\":740488,\"suggestedTranslation\":\"Có vẻ ta chỉ cần một đồng xu để chơi.\",\"rating\":9.0},\n  {\"id\":740489,\"suggestedTranslation\":\"Mấy quả trứng chạy nhảy thật náo nhiệt!\",\"rating\":9.0},\n  {\"id\":740490,\"suggestedTranslation\":\"Trông có vẻ dễ vấp ngã đấy.\",\"rating\":9.0},\n  {\"id\":740491,\"suggestedTranslation\":\"Chắc chắn là cái đó rồi!\",\"rating\":9.0},\n  {\"id\":740492,\"suggestedTranslation\":\"Mấy con chim này không tự xây nổi một cái hội chợ sao?\",\"rating\":9.0},\n  {\"id\":740493,\"suggestedTranslation\":\"Có vẻ ta chỉ cần một đồng xu để chơi.\",\"rating\":9.0},\n  {\"id\":740494,\"suggestedTranslation\":\"Bắt đầu nào! Hả!\",\"rating\":9.0},\n  {\"id\":740495,\"suggestedTranslation\":\"Phải làm việc trước khi chơi chứ.\",\"rating\":9.0},\n  {\"id\":740496,\"suggestedTranslation\":\"Có vẻ ta chỉ cần một đồng xu để chơi.\",\"rating\":9.0},\n  {\"id\":740497,\"suggestedTranslation\":\"Quả bóng nhỏ này thật khó chiều.\",\"rating\":9.0},\n  {\"id\":740498,\"suggestedTranslation\":\"Có vẻ ta chỉ cần một đồng xu để chơi.\",\"rating\":9.0},\n  {\"id\":740499,\"suggestedTranslation\":\"Chẳng có nút bấm nào ở nhà máy mà xịn sò thế này cả.\",\"rating\":9.0},\n  {\"id\":740500,\"suggestedTranslation\":\"Phải làm việc trước khi chơi chứ.\",\"rating\":9.0},\n  {\"id\":740501,\"suggestedTranslation\":\"Có vẻ ta chỉ cần một đồng xu để chơi.\",\"rating\":9.0},\n  {\"id\":740502,\"suggestedTranslation\":\"Ta tự hào vì là một tay súng cừ khôi đấy! Hả!\",\"rating\":9.0},\n  {\"id\":740503,\"suggestedTranslation\":\"Trông có vẻ dễ vấp ngã đấy.\",\"rating\":9.0},\n  {\"id\":740504,\"suggestedTranslation\":\"Đến lúc tiêu diệt loài dịch hại rồi.\",\"rating\":9.0},\n  {\"id\":740505,\"suggestedTranslation\":\"Phải làm việc trước khi chơi chứ.\",\"rating\":9.0},\n  {\"id\":740506,\"suggestedTranslation\":\"Có vẻ ta chỉ cần một đồng xu để chơi.\",\"rating\":9.0},\n  {\"id\":740507,\"suggestedTranslation\":\"Ồ nhìn kìa, ta đang thắng đấy!\",\"rating\":9.0},\n  {\"id\":740508,\"suggestedTranslation\":\"Không gì qua được một quả bóng cao su kinh điển.\",\"rating\":9.0},\n  {\"id\":740509,\"suggestedTranslation\":\"Ôi, chào bé con nhé!\",\"rating\":9.0},\n  {\"id\":740510,\"suggestedTranslation\":\"Ta đã không đến hội chợ từ hồi còn là một đứa trẻ!\",\"rating\":9.0},\n  {\"id\":740511,\"suggestedTranslation\":\"Đó đúng là một con quạ sang chảnh.\",\"rating\":9.0},\n  {\"id\":740512,\"suggestedTranslation\":\"Hừm... khu vực này cần được trang hoàng lại một chút.\",\"rating\":9.0},\n  {\"id\":740513,\"suggestedTranslation\":\"Trông khá ổn rồi... nhưng ta nghĩ mình còn làm tốt hơn thế.\",\"rating\":9.0},\n  {\"id\":740514,\"suggestedTranslation\":\"Đấy mới là một cái cây đẹp chứ!\",\"rating\":9.0},\n  {\"id\":740515,\"suggestedTranslation\":\"Phải đặt nền móng cho Lễ Hội Quạ thôi.\",\"rating\":9.0},\n  {\"id\":740516,\"suggestedTranslation\":\"Heh, hồi nhỏ ta lúc nào cũng phải giành đồ chơi cho Charlie...\",\"rating\":9.0},\n  {\"id\":740517,\"suggestedTranslation\":\"Hoàn thành tốt công việc là phần thưởng xứng đáng, nhưng có quà thì còn tuyệt hơn!\",\"rating\":9.0},\n  {\"id\":740518,\"suggestedTranslation\":\"Tự hỏi với một chiếc vé thì mình đổi được gì nhỉ...\",\"rating\":9.0},\n  {\"id\":740519,\"suggestedTranslation\":\"Thế mới phải chứ! Cùng xem mấy món quà đó nào!\",\"rating\":9.0},\n  {\"id\":740520,\"suggestedTranslation\":\"Ta cũng có kha khá vé tích lũy rồi đấy!\",\"rating\":9.0},\n  {\"id\":740521,\"suggestedTranslation\":\"Trông như một túi thức ăn cho chim.\",\"rating\":9.0},\n  {\"id\":740522,\"suggestedTranslation\":\"Đó là một chiếc khăn choàng nhỏ xinh.\",\"rating\":9.0},\n  {\"id\":740523,\"suggestedTranslation\":\"Ngạc nhiên là làm khá tốt đấy, xét việc nó được tạo ra bởi lũ chim.\",\"rating\":9.0},\n  {\"id\":740524,\"suggestedTranslation\":\"Thực ra nó khá thiết thực để giữ mát trong những ngày hè oi bức.\",\"rating\":9.0},\n  {\"id\":740525,\"suggestedTranslation\":\"Đó đúng là một lưỡi cưa ngọt lịm.\",\"rating\":9.0},\n  {\"id\":740526,\"suggestedTranslation\":\"Mày không đáng bị thế này.\",\"rating\":9.0},\n  {\"id\":740527,\"suggestedTranslation\":\"Ta... yêu ngươi.\",\"rating\":9.0},\n  {\"id\":740528,\"suggestedTranslation\":\"Trông không ổn chút nào.\",\"rating\":9.0},\n  {\"id\":740529,\"suggestedTranslation\":\"Ngươi là một cục phiền phức màu cam phải không nào?\",\"rating\":9.0},\n  {\"id\":740530,\"suggestedTranslation\":\"Ôi, ta không thể giận nổi ngươi mà.\",\"rating\":9.0},\n  {\"id\":740531,\"suggestedTranslation\":\"Ngủ ngon nhé.\",\"rating\":9.0},\n  {\"id\":740532,\"suggestedTranslation\":\"Em lúc nào cũng có máu cạnh tranh nhỉ, em gái?\",\"rating\":9.0},\n  {\"id\":740533,\"suggestedTranslation\":\"Thức ăn miễn phí từ lòng đất.\",\"rating\":9.0},\n  {\"id\":740534,\"suggestedTranslation\":\"Dễ nhai hơn đấy. Không phải là chuyện đó quan trọng đâu.\",\"rating\":9.0},\n  {\"id\":740535,\"suggestedTranslation\":\"Một đám cà rốt to lớn.\",\"rating\":9.0},\n  {\"id\":740536,\"suggestedTranslation\":\"Hoàn hảo để nhổ lên.\",\"rating\":9.0},\n  {\"id\":740537,\"suggestedTranslation\":\"Một nắm hạt.\",\"rating\":9.0},\n  {\"id\":740538,\"suggestedTranslation\":\"Chà.\",\"rating\":9.0},\n  {\"id\":740539,\"suggestedTranslation\":\"Không sao cả. Ta sẽ lắp cái khác.\",\"rating\":9.0},\n  {\"id\":740540,\"suggestedTranslation\":\"Ít ra đây cũng là chỗ tốt để gác chân lên nghỉ ngơi.\",\"rating\":9.0},\n  {\"id\":740541,\"suggestedTranslation\":\"Nó sẽ giữ cho lũ chuột không bén mảng đến nhà máy.\",\"rating\":9.0},\n  {\"id\":740542,\"suggestedTranslation\":\"Hoang vắng y như một nhà kho cũ.\",\"rating\":9.0},\n  {\"id\":740543,\"suggestedTranslation\":\"Ai rồi cũng phải ngủ thôi.\",\"rating\":9.0},\n  {\"id\":740544,\"suggestedTranslation\":\"Ta trông giống một kẻ buôn lông thú lắm à?\",\"rating\":9.0},\n  {\"id\":740545,\"suggestedTranslation\":\"Ta nghĩ nó có một cái bánh xe bị kêu cót két.\",\"rating\":9.0},\n  {\"id\":740546,\"suggestedTranslation\":\"Trông có vẻ di chuyển được.\",\"rating\":9.0},\n  {\"id\":740547,\"suggestedTranslation\":\"Chỉ là ta không đủ cao thôi.\",\"rating\":9.0},\n  {\"id\":740548,\"suggestedTranslation\":\"Mọi thứ kể từ khi ta đến đây đều điên rồ như chuối cả nải.\",\"rating\":9.0},\n  {\"id\":740549,\"suggestedTranslation\":\"Cây chuối cháy to đùng.\",\"rating\":9.0},\n  {\"id\":740550,\"suggestedTranslation\":\"Chuối ngào đường là tuyệt nhất.\",\"rating\":9.0},\n  {\"id\":740551,\"suggestedTranslation\":\"Đó là, ừm, một cây chuối.\",\"rating\":9.0},\n  {\"id\":740552,\"suggestedTranslation\":\"Tiến vào lòng đất nào!\",\"rating\":9.0},\n  {\"id\":740553,\"suggestedTranslation\":\"Dưới đó chật kín chỗ rồi.\",\"rating\":9.0},\n  {\"id\":740554,\"suggestedTranslation\":\"Thôi, ta không muốn bị bệnh phổi đen đâu.\",\"rating\":9.0},\n  {\"id\":740555,\"suggestedTranslation\":\"Hết ngày này qua ngày khác, lại thêm một cái hang rợn tóc gáy.\",\"rating\":9.0},\n  {\"id\":740556,\"suggestedTranslation\":\"Đi sâu hơn nữa liệu có khôn ngoan không?\",\"rating\":9.0},\n  {\"id\":740557,\"suggestedTranslation\":\"Thôi, trên đó đông nghẹt rồi.\",\"rating\":9.0},\n  {\"id\":740558,\"suggestedTranslation\":\"Ta không cần không khí trong lành đâu.\",\"rating\":9.0},\n  {\"id\":740559,\"suggestedTranslation\":\"Ta hầu như không nhớ mặt mũi trên mặt đất trông thế nào nữa.\",\"rating\":9.0},\n  {\"id\":740560,\"suggestedTranslation\":\"Nhìn ngó cái cây dương xỉ tí xíu này xem!\",\"rating\":9.0},\n  {\"id\":740561,\"suggestedTranslation\":\"Ôi, cây dương xỉ đó chết rồi.\",\"rating\":9.0},\n  {\"id\":740562,\"suggestedTranslation\":\"Nó chết ngắc rồi còn gì.\",\"rating\":9.0},\n  {\"id\":740563,\"suggestedTranslation\":\"Con sinh vật đó là nguồn rắc rối đấy!\",\"rating\":9.0},\n  {\"id\":740564,\"suggestedTranslation\":\"Nó đang ngủ.\",\"rating\":9.0},\n  {\"id\":740565,\"suggestedTranslation\":\"Nó chẳng ngần ngại gì việc xì hơi cả.\",\"rating\":9.0},\n  {\"id\":740566,\"suggestedTranslation\":\"Ngửi có vẻ hơi thối.\",\"rating\":9.0},\n  {\"id\":740567,\"suggestedTranslation\":\"Chẳng có gì hay ho chui ra từ đó đâu.\",\"rating\":9.0},\n  {\"id\":740568,\"suggestedTranslation\":\"Dưới này sẽ sớm ngột ngạt cho mà xem.\",\"rating\":9.0},\n  {\"id\":740569,\"suggestedTranslation\":\"Đúng là độc hại thật đấy.\",\"rating\":9.0},\n  {\"id\":740570,\"suggestedTranslation\":\"Có đường thoát thân thì thật tốt.\",\"rating\":9.0},\n  {\"id\":740571,\"suggestedTranslation\":\"Đó mới là món con sâu ngon lành chứ!\",\"rating\":9.0},\n  {\"id\":740572,\"suggestedTranslation\":\"Nó dính tùm lum hết cả.\",\"rating\":9.0},\n  {\"id\":740573,\"suggestedTranslation\":\"Chắc ta vừa lướt qua cô ấy... nhưng cô ấy đã để lại thứ gì đó.\",\"rating\":9.0},\n  {\"id\":740574,\"suggestedTranslation\":\"Ồ, Charlie. Em lại định lôi chị vào rắc rối gì nữa đây?\",\"rating\":9.0},\n  {\"id\":740575,\"suggestedTranslation\":\"Ngươi muốn gì à?\",\"rating\":9.0},\n  {\"id\":740576,\"suggestedTranslation\":\"Bạn không thể làm hài lòng tất cả mọi người được.\",\"rating\":9.0},\n  {\"id\":740577,\"suggestedTranslation\":\"Ai cũng có vai trò của mình, phải không?\",\"rating\":9.0},\n  {\"id\":740578,\"suggestedTranslation\":\"Charlie, chờ đã!!\",\"rating\":9.0},\n  {\"id\":740579,\"suggestedTranslation\":\"Ai lại đi dựng sân khấu ngoài này cơ chứ? Ồ...\",\"rating\":9.0},\n  {\"id\":740580,\"suggestedTranslation\":\"Một đống phụ tùng.\",\"rating\":9.0},\n  {\"id\":740581,\"suggestedTranslation\":\"Một đống phụ tùng.\",\"rating\":9.0},\n  {\"id\":740582,\"suggestedTranslation\":\"Một đống phụ tùng.\",\"rating\":9.0},\n  {\"id\":740583,\"suggestedTranslation\":\"Ta thích cái này đấy.\",\"rating\":9.0},\n  {\"id\":740584,\"suggestedTranslation\":\"Trông thật đến mức ta có thể cảm nhận được mặt đất đang rung chuyển.\",\"rating\":9.0},\n  {\"id\":740585,\"suggestedTranslation\":\"Bộ mặt cau có phết đấy, anh bạn.\",\"rating\":9.0},\n  {\"id\":740586,\"suggestedTranslation\":\"Đó là một con quái vật vô cùng khó ưa.\",\"rating\":9.0},\n  {\"id\":740587,\"suggestedTranslation\":\"Ôi, trông giống hệt con bò lai của ta vậy.\",\"rating\":9.0},\n  {\"id\":740588,\"suggestedTranslation\":\"Tự hỏi liệu ta có thể tạc được một chiếc mũ giống thế không.\",\"rating\":9.0},\n  {\"id\":740589,\"suggestedTranslation\":\"Ta không thích mấy trò đấu trí đâu.\",\"rating\":9.0},\n  {\"id\":740590,\"suggestedTranslation\":\"Cái đó lẽ ra không được di chuyển mới đúng.\",\"rating\":9.0},\n  {\"id\":740591,\"suggestedTranslation\":\"Ta có cảm giác nó đang nhìn mình.\",\"rating\":9.0},\n  {\"id\":740592,\"suggestedTranslation\":\"Nhìn nó kìa, cứ lười biếng ra đấy!\",\"rating\":9.0},\n  {\"id\":740593,\"suggestedTranslation\":\"Ồ, ngươi có gì thế kia? ...À.\",\"rating\":9.0},\n  {\"id\":740594,\"suggestedTranslation\":\"Một chú cún ngoan nhất mà ta từng thấy.\",\"rating\":9.0},\n  {\"id\":740595,\"suggestedTranslation\":\"Đó là bức tượng của con chó lai khó ưa đó.\",\"rating\":9.0},\n  {\"id\":740596,\"suggestedTranslation\":\"Này Max, hai người có nhiều điểm chung phết đấy!\",\"rating\":9.0},\n  {\"id\":740597,\"suggestedTranslation\":\"Nó sống động đến mức ta gần như ngửi thấy hơi thở hôi thối.\",\"rating\":9.0},\n  {\"id\":740598,\"suggestedTranslation\":\"Con lợn này không biết thế nào là bỏ cuộc đâu.\",\"rating\":9.0},\n  {\"id\":740599,\"suggestedTranslation\":\"Ha. Trông nó có vẻ hơi ngạc nhiên nhỉ?\",\"rating\":9.0},\n  {\"id\":740600,\"suggestedTranslation\":\"Trông cô ta cũng ra gì đấy chứ.\",\"rating\":9.0},\n  {\"id\":740601,\"suggestedTranslation\":\"Ugh, vẫn làm ta nổi da gà.\",\"rating\":9.0},\n  {\"id\":740602,\"suggestedTranslation\":\"Mấy chiến hữu của ta là vô địch đấy.\",\"rating\":9.0},\n  {\"id\":740603,\"suggestedTranslation\":\"Một con mắt (bức tượng) đổi lấy một con mắt (quái vật)!\",\"rating\":9.0},\n  {\"id\":740604,\"suggestedTranslation\":\"Nó bị BUSTed (đập bể/bức tượng). Ha!\",\"rating\":9.0},\n  {\"id\":740605,\"suggestedTranslation\":\"Sống động quá mức khiến ta không thoải mái chút nào.\",\"rating\":9.0},\n  {\"id\":740606,\"suggestedTranslation\":\"Ugh, đừng nhắc ta nhớ đến đồ ăn nữa.\",\"rating\":9.0},\n  {\"id\":740607,\"suggestedTranslation\":\"Ta không biết đây là một kỳ quan kỹ thuật hay một trò ngớ ngẩn nữa. Dù sao thì trông cũng dễ thương đấy.\",\"rating\":9.0},\n  {\"id\":740608,\"suggestedTranslation\":\"Làm ta hơi thấy hoài niệm.\",\"rating\":9.0},\n  {\"id\":740609,\"suggestedTranslation\":\"Sao trông mặt dài thế?\",\"rating\":9.0},\n  {\"id\":740610,\"suggestedTranslation\":\"Cái đó lẽ ra không được di chuyển mới đúng.\",\"rating\":9.0},\n  {\"id\":740611,\"suggestedTranslation\":\"Nó đã gây sự nhầm người rồi đấy.\",\"rating\":9.0},\n  {\"id\":740612,\"suggestedTranslation\":\"Trông anh ta có vẻ chẳng bận tâm đến thế giới ngoài kia.\",\"rating\":9.0},\n  {\"id\":740613,\"suggestedTranslation\":\"Đúng là một tên cục súc mặt đá.\",\"rating\":9.0},\n  {\"id\":740614,\"suggestedTranslation\":\"Bức tượng đó đang khoe mông với ta kìa! HẠ!\",\"rating\":9.0},\n  {\"id\":740615,\"suggestedTranslation\":\"Trông nó giống như đang hò hét vậy.\",\"rating\":9.0},\n  {\"id\":740616,\"suggestedTranslation\":\"Ta có linh cảm không lành về cái này.\",\"rating\":9.0},\n  {\"id\":740617,\"suggestedTranslation\":\"Cái mũ đẹp đấy.\",\"rating\":9.0},\n  {\"id\":740618,\"suggestedTranslation\":\"Có những quả bong bóng sủi lên từ đỉnh đầu kìa.\",\"rating\":9.0},\n  {\"id\":740619,\"suggestedTranslation\":\"Trông có vẻ nặng đấy.\",\"rating\":9.0},\n  {\"id\":740620,\"suggestedTranslation\":\"Cái đó lẽ ra không được di chuyển mới đúng.\",\"rating\":9.0},\n  {\"id\":740621,\"suggestedTranslation\":\"Con cá mập đó đúng là hơi hãm tài.\",\"rating\":9.0},\n  {\"id\":740622,\"suggestedTranslation\":\"Ta thích hắn hơn khi hắn không bám theo stalk ta.\",\"rating\":9.0},\n  {\"id\":740623,\"suggestedTranslation\":\"Ta từng đóng một chiếc ghế đẩu nhưng trông nó không giống thế này.\",\"rating\":9.0},\n  {\"id\":740624,\"suggestedTranslation\":\"Một cặp mắt mới chính là thứ chúng ta cần quanh đây!\",\"rating\":9.0},\n  {\"id\":740625,\"suggestedTranslation\":\"Chào chú em, lùn tịt!\",\"rating\":9.0},\n  {\"id\":740626,\"suggestedTranslation\":\"Thứ kì dị nhất ta từng thấy. Mà ta thì thấy khối thứ kì dị rồi.\",\"rating\":9.0},\n  {\"id\":740627,\"suggestedTranslation\":\"Cũng may cái này không có bộ phận chuyển động nào.\",\"rating\":9.0},\n  {\"id\":740628,\"suggestedTranslation\":\"Đây mới là cún cưng mà ta có thể chơi cùng này.\",\"rating\":9.0},\n  {\"id\":740629,\"suggestedTranslation\":\"Đúng là một con giun to lớn kinh tởm. Blegh.\",\"rating\":9.0},\n  {\"id\":740630,\"suggestedTranslation\":\"Chúng ta vừa chơi một vố cực gắt đấy! Ha!\",\"rating\":9.0},\n  {\"id\":740631,\"suggestedTranslation\":\"Cũng có những lúc vui buồn với gã này.\",\"rating\":9.0},\n  {\"id\":740632,\"suggestedTranslation\":\"Ugh, vẫn làm ta nổi da gà.\",\"rating\":9.0},\n  {\"id\":740633,\"suggestedTranslation\":\"Ai là hộp dụng cụ bé bỏng dễ thương nhất nào?\",\"rating\":9.0},\n  {\"id\":740634,\"suggestedTranslation\":\"Bộ điều khiển hộp dụng cụ.\",\"rating\":9.0},\n  {\"id\":740635,\"suggestedTranslation\":\"Có cái gì đó làm nó khó chịu rồi.\",\"rating\":9.0},\n  {\"id\":740636,\"suggestedTranslation\":\"Trông giống như thứ mà sếp tổng sẽ nghĩ ra.\",\"rating\":9.0},\n  {\"id\":740637,\"suggestedTranslation\":\"Ta đã bảo ngươi rồi mà?!\",\"rating\":9.0},\n  {\"id\":740638,\"suggestedTranslation\":\"Ta ủng hộ bất cứ thứ gì giúp việc câu cá diễn ra nhanh hơn.\",\"rating\":9.0},\n  {\"id\":740639,\"suggestedTranslation\":\"Ta sẽ cho ngươi chạy mất dép luôn, đồ chó lai!\",\"rating\":9.0},\n  {\"id\":740640,\"suggestedTranslation\":\"Thật là đậm chất đất.\",\"rating\":9.0},\n  {\"id\":740641,\"suggestedTranslation\":\"Muốn đấu tay