            "text": "[\n  {\"id\":744725,\"suggestedTranslation\":\"Wolfgang thích hương thơm tinh tế này.\",\"rating\":9.0},\n  {\"id\":744726,\"suggestedTranslation\":\"Để bảo vệ đầu!\",\"rating\":9.0},\n  {\"id\":744727,\"suggestedTranslation\":\"Những bông hoa nhỏ xinh.\",\"rating\":9.0},\n  {\"id\":744728,\"suggestedTranslation\":\"Wolfgang thích hương thơm tinh tế này.\",\"rating\":9.0},\n  {\"id\":744729,\"suggestedTranslation\":\"Ai lại đi may bộ đồ sang trọng cho bò chứ?\",\"rating\":9.0},\n  {\"id\":744730,\"suggestedTranslation\":\"Xương bé tí!\",\"rating\":9.0},\n  {\"id\":744731,\"suggestedTranslation\":\"Trông được đấy! Hùng dũng!\",\"rating\":9.0},\n  {\"id\":744732,\"suggestedTranslation\":\"Ê, chắc chúng ta phải tháo ra thôi.\",\"rating\":9.0},\n  {\"id\":744733,\"suggestedTranslation\":\"Trông chưa xong đâu.\",\"rating\":9.0},\n  {\"id\":744734,\"suggestedTranslation\":\"Bữa xế nam tính.\",\"rating\":9.0},\n  {\"id\":744735,\"suggestedTranslation\":\"Con bọ có ích, nhưng vẫn đáng sợ.\",\"rating\":9.0},\n  {\"id\":744736,\"suggestedTranslation\":\"Là món ngon ở quê tôi đấy.\",\"rating\":9.0},\n  {\"id\":744737,\"suggestedTranslation\":\"Chào chú ếch nhỏ nha.\",\"rating\":9.0},\n  {\"id\":744738,\"suggestedTranslation\":\"Đang ngủ gục rồi.\",\"rating\":9.0},\n  {\"id\":744739,\"suggestedTranslation\":\"Đồ ăn sẽ làm Wolfgang rất khỏe!\",\"rating\":9.0},\n  {\"id\":744740,\"suggestedTranslation\":\"Là bánh mì kẹp với thịt đùi ngon lành.\",\"rating\":9.0},\n  {\"id\":744741,\"suggestedTranslation\":\"Là món ngon ở quê tôi đấy!\",\"rating\":9.0},\n  {\"id\":744742,\"suggestedTranslation\":\"Ăn gần giống thịt gà.\",\"rating\":9.0},\n  {\"id\":744743,\"suggestedTranslation\":\"Vừa ngọt, lại vừa nhớp nháp.\",\"rating\":9.0},\n  {\"id\":744744,\"suggestedTranslation\":\"Lạnh và ngon! LY NỮA NÀO!\",\"rating\":9.0},\n  {\"id\":744745,\"suggestedTranslation\":\"Là bụi cây leo nhỏ xíu!\",\"rating\":9.0},\n  {\"id\":744746,\"suggestedTranslation\":\"Bụi cây leo thơm ngon quá chừng.\",\"rating\":9.0},\n  {\"id\":744747,\"suggestedTranslation\":\"Wolfgang sẽ không làm phiền đâu.\",\"rating\":9.0},\n  {\"id\":744748,\"suggestedTranslation\":\"Wolfgang không thích bọ!\",\"rating\":9.0},\n  {\"id\":744749,\"suggestedTranslation\":\"Thứ kỳ cục thu hút mấy con ruồi có ích nhưng đáng sợ.\",\"rating\":9.0},\n  {\"id\":744750,\"suggestedTranslation\":\"Là một cốc trái cây nhỏ xíu.\",\"rating\":9.0},\n  {\"id\":744751,\"suggestedTranslation\":\"Đang nứt toác ra rồi.\",\"rating\":9.0},\n  {\"id\":744752,\"suggestedTranslation\":\"Cái rìu nóng làm Wolfgang thấy rực lửa!\",\"rating\":9.0},\n  {\"id\":744753,\"suggestedTranslation\":\"Giờ thì nguội rồi.\",\"rating\":9.0},\n  {\"id\":744754,\"suggestedTranslation\":\"Giữ cho Wolfgang luôn ấm áp dễ chịu.\",\"rating\":9.0},\n  {\"id\":744755,\"suggestedTranslation\":\"Đang nứt toác ra rồi.\",\"rating\":9.0},\n  {\"id\":744756,\"suggestedTranslation\":\"Cái búa nóng làm Wolfgang thấy rực lửa!\",\"rating\":9.0},\n  {\"id\":744757,\"suggestedTranslation\":\"Giờ thì nguội rồi.\",\"rating\":9.0},\n  {\"id\":744758,\"suggestedTranslation\":\"Giữ cho Wolfgang luôn ấm áp dễ chịu.\",\"rating\":9.0},\n  {\"id\":744759,\"suggestedTranslation\":\"Đang nứt toác ra rồi.\",\"rating\":9.0},\n  {\"id\":744760,\"suggestedTranslation\":\"Cái cuốc chim nóng làm Wolfgang thấy rực lửa!\",\"rating\":9.0},\n  {\"id\":744761,\"suggestedTranslation\":\"Giờ thì nguội rồi.\",\"rating\":9.0},\n  {\"id\":744762,\"suggestedTranslation\":\"Giữ cho Wolfgang luôn ấm áp dễ chịu.\",\"rating\":9.0},\n  {\"id\":744763,\"suggestedTranslation\":\"Đang nứt toác ra rồi.\",\"rating\":9.0},\n  {\"id\":744764,\"suggestedTranslation\":\"Cái xẻng nóng làm Wolfgang thấy rực lửa!\",\"rating\":9.0},\n  {\"id\":744765,\"suggestedTranslation\":\"Giờ thì nguội rồi.\",\"rating\":9.0},\n  {\"id\":744766,\"suggestedTranslation\":\"Giữ cho Wolfgang luôn ấm áp dễ chịu.\",\"rating\":9.0},\n  {\"id\":744767,\"suggestedTranslation\":\"Đang nứt toác ra rồi.\",\"rating\":9.0},\n  {\"id\":744768,\"suggestedTranslation\":\"Cái cuốc làm vườn nóng làm Wolfgang thấy rực lửa!\",\"rating\":9.0},\n  {\"id\":744769,\"suggestedTranslation\":\"Giờ thì nguội rồi.\",\"rating\":9.0},\n  {\"id\":744770,\"suggestedTranslation\":\"Giữ cho Wolfgang luôn ấm áp dễ chịu.\",\"rating\":9.0},\n  {\"id\":744771,\"suggestedTranslation\":\"Lông từ gấu à?\",\"rating\":9.0},\n  {\"id\":744772,\"suggestedTranslation\":\"Trông rợn tóc gáy và bò lúc nhúc!\",\"rating\":9.0},\n  {\"id\":744773,\"suggestedTranslation\":\"Bọ phát nổ!\",\"rating\":9.0},\n  {\"id\":744774,\"suggestedTranslation\":\"Làm Wolfgang thấy không thoải mái!\",\"rating\":9.0},\n  {\"id\":744775,\"suggestedTranslation\":\"Wolfgang không thích thế đâu.\",\"rating\":9.0},\n  {\"id\":744776,\"suggestedTranslation\":\"Hương vị tuyệt vời để hầm đấy.\",\"rating\":9.0},\n  {\"id\":744777,\"suggestedTranslation\":\"Hương vị giờ ngon lắm rồi.\",\"rating\":9.0},\n  {\"id\":744778,\"suggestedTranslation\":\"Tỏi bao nhiêu cũng không đủ!\",\"rating\":9.0},\n  {\"id\":744779,\"suggestedTranslation\":\"Những hạt giống nhỏ xíu để vùi xuống đất.\",\"rating\":9.0},\n  {\"id\":744780,\"suggestedTranslation\":\"Nếm ngon lắm đấy!\",\"rating\":9.0},\n  {\"id\":744781,\"suggestedTranslation\":\"À ha! Ai mới là kẻ lực lưỡng hơn nào?\",\"rating\":9.0},\n  {\"id\":744782,\"suggestedTranslation\":\"Đừng để nó dính vào người Wolfgang.\",\"rating\":9.0},\n  {\"id\":744783,\"suggestedTranslation\":\"Đừng sợ, Wolfgang cứu ngươi đây!\",\"rating\":9.0},\n  {\"id\":744784,\"suggestedTranslation\":\"Có cái gì bên trong nhưng Wolfgang không thích làm bẩn tay.\",\"rating\":9.0},\n  {\"id\":744785,\"suggestedTranslation\":\"Cái này không ăn được.\",\"rating\":9.0},\n  {\"id\":744786,\"suggestedTranslation\":\"Wolfgang đang đói thì không kén chọn đâu.\",\"rating\":9.0},\n  {\"id\":744787,\"suggestedTranslation\":\"Chỗ tuyệt vời để cất đồ ăn vặt của Wolfgang.\",\"rating\":9.0},\n  {\"id\":744788,\"suggestedTranslation\":\"Việc vặt đối với Wolfgang.\",\"rating\":9.0},\n  {\"id\":744789,\"suggestedTranslation\":\"Trống rỗng.\",\"rating\":9.0},\n  {\"id\":744790,\"suggestedTranslation\":\"Viên đá tảng xinh xắn giờ đang lơ lửng kìa.\",\"rating\":9.0},\n  {\"id\":744791,\"suggestedTranslation\":\"Wolfgang thấy an toàn hơn rồi.\",\"rating\":9.0},\n  {\"id\":744792,\"suggestedTranslation\":\"Chết rồi. Tiếc thật.\",\"rating\":9.0},\n  {\"id\":744793,\"suggestedTranslation\":\"Không! Thế này là sai rồi!\",\"rating\":9.0},\n  {\"id\":744794,\"suggestedTranslation\":\"Bộ não của Wolfgang chưa bao giờ hùng mạnh thế này!\",\"rating\":9.0},\n  {\"id\":744795,\"suggestedTranslation\":\"Có một đứa ở bên trong kìa!\",\"rating\":9.0},\n  {\"id\":744796,\"suggestedTranslation\":\"Chà. Trống không.\",\"rating\":9.0},\n  {\"id\":744797,\"suggestedTranslation\":\"Miễn là chúng đánh nhau với cái bóng đáng sợ, Wolfgang vui rồi.\",\"rating\":9.0},\n  {\"id\":744798,\"suggestedTranslation\":\"Đâu phải lỗi tại Wolfgang!\",\"rating\":9.0},\n  {\"id\":744799,\"suggestedTranslation\":\"Aaaaaaaaaaah!\",\"rating\":9.0},\n  {\"id\":744800,\"suggestedTranslation\":\"Xinh xắn... xinh xắn đáng sợ.\",\"rating\":9.0},\n  {\"id\":744801,\"suggestedTranslation\":\"Xinh xắn... và rợn tóc gáy.\",\"rating\":9.0},\n  {\"id\":744802,\"suggestedTranslation\":\"Wolfgang không tin mấy lọ thuốc nhỏ do cô bé kỳ quái đó làm đâu.\",\"rating\":9.0},\n  {\"id\":744803,\"suggestedTranslation\":\"Wolfgang không tin mấy lọ thuốc nhỏ do cô bé kỳ quái đó làm đâu.\",\"rating\":9.0},\n  {\"id\":744804,\"suggestedTranslation\":\"Wolfgang không tin mấy lọ thuốc nhỏ do cô bé kỳ quái đó làm đâu.\",\"rating\":9.0},\n  {\"id\":744805,\"suggestedTranslation\":\"Wolfgang không tin mấy lọ thuốc nhỏ do cô bé kỳ quái đó làm đâu.\",\"rating\":9.0},\n  {\"id\":744806,\"suggestedTranslation\":\"Wolfgang không tin mấy lọ thuốc nhỏ do cô bé kỳ quái đó làm đâu.\",\"rating\":9.0},\n  {\"id\":744807,\"suggestedTranslation\":\"Wolfgang không tin mấy lọ thuốc nhỏ do cô bé kỳ quái đó làm đâu.\",\"rating\":9.0},\n  {\"id\":744808,\"suggestedTranslation\":\"Wolfgang không tin mấy lọ thuốc nhỏ do cô bé kỳ quái đó làm đâu.\",\"rating\":9.0},\n  {\"id\":744809,\"suggestedTranslation\":\"Wolfgang không tin mấy lọ thuốc nhỏ do cô bé kỳ quái đó làm đâu.\",\"rating\":9.0},\n  {\"id\":744810,\"suggestedTranslation\":\"Wolfgang không tin mấy lọ thuốc nhỏ do cô bé kỳ quái đó làm đâu.\",\"rating\":9.0},\n  {\"id\":744811,\"suggestedTranslation\":\"Là món quà nhỏ tuyệt vời!\",\"rating\":9.0},\n  {\"id\":744812,\"suggestedTranslation\":\"Wolfgang cần giúp thắt chiếc nơ nhỏ này.\",\"rating\":9.0},\n  {\"id\":744813,\"suggestedTranslation\":\"Wolfgang sẽ đấm nát nó để lấy cục kẹo.\",\"rating\":9.0},\n  {\"id\":744814,\"suggestedTranslation\":\"Hehe! Lại đây nào, chú nhóc!\",\"rating\":9.0},\n  {\"id\":744815,\"suggestedTranslation\":\"Wolfgang sẽ hạ gục nó. Rồi tới món tráng miệng!\",\"rating\":9.0},\n  {\"id\":744816,\"suggestedTranslation\":\"Wolfgang có thể nghiền nát lâu đài nhỏ này đấy.\",\"rating\":9.0},\n  {\"id\":744817,\"suggestedTranslation\":\"Người bạn mới đã dạy tôi cách làm đấy.\",\"rating\":9.0},\n  {\"id\":744818,\"suggestedTranslation\":\"Gai giờ bằng thủy tinh rồi.\",\"rating\":9.0},\n  {\"id\":744819,\"suggestedTranslation\":\"Sao ngươi cứ bám theo thế, con bọ kỳ cục?\",\"rating\":9.0},\n  {\"id\":744820,\"suggestedTranslation\":\"Đến lúc Wolfgang chuồn lẹ đây!\",\"rating\":9.0},\n  {\"id\":744821,\"suggestedTranslation\":\"Bông hoa vừa buồn vừa lấp lánh.\",\"rating\":9.0},\n  {\"id\":744822,\"suggestedTranslation\":\"Là bông hoa lấp lánh.\",\"rating\":9.0},\n  {\"id\":744823,\"suggestedTranslation\":\"Con bọ kỳ cục đi ra đống phân kỳ cục.\",\"rating\":9.0},\n  {\"id\":744824,\"suggestedTranslation\":\"Nhỏ xíu như cánh tiên vậy.\",\"rating\":9.0},\n  {\"id\":744825,\"suggestedTranslation\":\"Người bạn khéo tay đã làm món này ngon tuyệt cú mèo.\",\"rating\":9.0},\n  {\"id\":744826,\"suggestedTranslation\":\"Con cá lớn giờ đã biết điều mà không dám dây dưa với Wolfgang rồi nhé!\",\"rating\":9.0},\n  {\"id\":744827,\"suggestedTranslation\":\"Không cần sừng vẫn mạnh mẽ chán! Ngươi to lớn giống Wolfgang đấy!\",\"rating\":9.0},\n  {\"id\":744828,\"suggestedTranslation\":\"Phải, hãy đi theo Wolfgang hùng dũng đi!\",\"rating\":9.0},\n  {\"id\":744829,\"suggestedTranslation\":\"Con cá lớn tưởng nó có thể chọc thủng thuyền ván của Wolfgang à?!\",\"rating\":9.0},\n  {\"id\":744830,\"suggestedTranslation\":\"Sẽ làm thành cây giáo đâm tuyệt vời!\",\"rating\":9.0},\n  {\"id\":744831,\"suggestedTranslation\":\"Sữa cho cơ bắp đây!\",\"rating\":9.0},\n  {\"id\":744832,\"suggestedTranslation\":\"Làm Wolfgang trông rất oai phong.\",\"rating\":9.0},\n  {\"id\":744833,\"suggestedTranslation\":\"Cái rìu xịn chặt ngon hơn.\",\"rating\":9.0},\n  {\"id\":744834,\"suggestedTranslation\":\"Cái cuốc chim xịn đập mạnh hơn.\",\"rating\":9.0},\n  {\"id\":744835,\"suggestedTranslation\":\"Cái chĩa xịn đâm đất tốt đấy.\",\"rating\":9.0},\n  {\"id\":744836,\"suggestedTranslation\":\"Cái xẻng xịn đào hố giỏi ghê.\",\"rating\":9.0},\n  {\"id\":744837,\"suggestedTranslation\":\"Cái cuốc làm vườn xịn dùng để trồng hạt rất tốt!\",\"rating\":9.0},\n  {\"id\":744838,\"suggestedTranslation\":\"Tiền bạc chỉ dành cho mấy kẻ yếu đuối!\",\"rating\":9.0},\n  {\"id\":744839,\"suggestedTranslation\":\"Nhột quá nhột quá đi!\",\"rating\":9.0},\n  {\"id\":744840,\"suggestedTranslation\":\"Nó cần phân.\",\"rating\":9.0},\n  {\"id\":744841,\"suggestedTranslation\":\"Không ổn rồi!\",\"rating\":9.0},\n  {\"id\":744842,\"suggestedTranslation\":\"Yếu ớt quá. Ốm yếu!\",\"rating\":9.0},\n  {\"id\":744843,\"suggestedTranslation\":\"Trông có vẻ héo úa rồi.\",\"rating\":9.0},\n  {\"id\":744844,\"suggestedTranslation\":\"Là cỏ.\",\"rating\":9.0},\n  {\"id\":744845,\"suggestedTranslation\":\"Đám cỏ đã bị đánh bại!\",\"rating\":9.0},\n  {\"id\":744846,\"suggestedTranslation\":\"Cỏ đã bị cái nóng đánh bại rồi.\",\"rating\":9.0},\n  {\"id\":744847,\"suggestedTranslation\":\"Nếu nó không làm phiền Wolfgang, Wolfgang cũng mặc kệ nó.\",\"rating\":9.0},\n  {\"id\":744848,\"suggestedTranslation\":\"Trông còn tệ hơn lúc trước.\",\"rating\":9.0},\n  {\"id\":744849,\"suggestedTranslation\":\"Con thằn lằn trông ọp ẹp quá.\",\"rating\":9.0},\n  {\"id\":744850,\"suggestedTranslation\":\"Tôi không thích cái dù bé tí này đâu.\",\"rating\":9.0},\n  {\"id\":744851,\"suggestedTranslation\":\"Bình di cốt trống không.\",\"rating\":9.0},\n  {\"id\":744852,\"suggestedTranslation\":\"Có con ma đáng sợ bên trong.\",\"rating\":9.0},\n  {\"id\":744853,\"suggestedTranslation\":\"Xốt nước thịt ngon tuyệt thật đấy!\",\"rating\":9.0},\n  {\"id\":744854,\"suggestedTranslation\":\"Nhẹ ghê! Cảm giác như không trọng lượng luôn!\",\"rating\":9.0},\n  {\"id\":744855,\"suggestedTranslation\":\"Đẹp và không thể bị nghiền nát. Giống như tôi vậy!\",\"rating\":9.0},\n  {\"id\":744856,\"suggestedTranslation\":\"Cứ mở trân trân không thèm chớp mắt.\",\"rating\":9.0},\n  {\"id\":744857,\"suggestedTranslation\":\"Cây gậy này có viên ngọc lục ở trong.\",\"rating\":9.0},\n  {\"id\":744858,\"suggestedTranslation\":\"Dùng để làm salad. Ew.\",\"rating\":9.0},\n  {\"id\":744859,\"suggestedTranslation\":\"Không giống vậy đâu.\",\"rating\":9.0},\n  {\"id\":744860,\"suggestedTranslation\":\"Là nấm mốc.\",\"rating\":9.0},\n  {\"id\":744861,\"suggestedTranslation\":\"Nấm mốc đang trốn kìa!\",\"rating\":9.0},\n  {\"id\":744862,\"suggestedTranslation\":\"Bị hái mất rồi.\",\"rating\":9.0},\n  {\"id\":744863,\"suggestedTranslation\":\"Wolfgang rất muốn bơi, nhưng vướng quá nhiều thủy tinh.\",\"rating\":9.0},\n  {\"id\":744864,\"suggestedTranslation\":\"Đến cái ao nhỏ xíu cũng đầy thủy tinh.\",\"rating\":9.0},\n  {\"id\":744865,\"suggestedTranslation\":\"Wolfgang không tin thứ hỗn hợp xanh lè này đâu.\",\"rating\":9.0},\n  {\"id\":744866,\"suggestedTranslation\":\"Lại phân nữa.\",\"rating\":9.0},\n  {\"id\":744867,\"suggestedTranslation\":\"Ớt nổ tung!\",\"rating\":9.0},\n  {\"id\":744868,\"suggestedTranslation\":\"Wolfgang ăn cả đống luôn!\",\"rating\":9.0},\n  {\"id\":744869,\"suggestedTranslation\":\"Là món quà nhỏ ngon miệng!\",\"rating\":9.0},\n  {\"id\":744870,\"suggestedTranslation\":\"Mấy chú sô-cô-la nhỏ bé chẳng có cửa đấu với Wolfgang đâu!\",\"rating\":9.0},\n  {\"id\":744871,\"suggestedTranslation\":\"Mấy cục kẹo hình con bọ trông ghê quá!\",\"rating\":9.0},\n  {\"id\":744872,\"suggestedTranslation\":\"Kẹo cứng mạnh mẽ giống Wolfgang vậy!\",\"rating\":9.0},\n  {\"id\":744873,\"suggestedTranslation\":\"Cay quá mức chịu đựng của Wolfgang rồi!!\",\"rating\":9.0},\n  {\"id\":744874,\"suggestedTranslation\":\"Mấy hạt bắp nhỏ cứ dính vào bộ ria mép oai phong của Wolfgang!\",\"rating\":9.0},\n  {\"id\":744875,\"suggestedTranslation\":\"Nhạt thếch. Làm Wolfgang nhớ đến kẹo hồi ở nhà!\",\"rating\":9.0},\n  {\"id\":744876,\"suggestedTranslation\":\"Wolfgang thấy mình thật khỏe khi nghiền nát lũ nhện bé xíu giữa hàm răng!\",\"rating\":9.0},\n  {\"id\":744877,\"suggestedTranslation\":\"Wolfgang không chắc mình nỡ ăn không nữa.\",\"rating\":9.0},\n  {\"id\":744878,\"suggestedTranslation\":\"Chắc là sô-cô-la nhỉ?\",\"rating\":9.0},\n  {\"id\":744879,\"suggestedTranslation\":\"Mấy cục buồn tủi teo tóp nhỏ xíu.\",\"rating\":9.0},\n  {\"id\":744880,\"suggestedTranslation\":\"Là món quà nhỏ ngon miệng!\",\"rating\":9.0},\n  {\"id\":744881,\"suggestedTranslation\":\"Trông gớm ghiếc nhưng ăn tạm ổn.\",\"rating\":9.0},\n  {\"id\":744882,\"suggestedTranslation\":\"Wolfgang rất dũng cảm. Giờ lại càng dũng cảm hơn.\",\"rating\":9.0},\n  {\"id\":744883,\"suggestedTranslation\":\"Mạnh mẽ y như Wolfgang vậy!\",\"rating\":9.0},\n  {\"id\":744884,\"suggestedTranslation\":\"Tạm ổn, nhưng Wolfgang vạm vỡ cần một ly lớn chứ!\",\"rating\":9.0},\n  {\"id\":744885,\"suggestedTranslation\":\"Làm cho lửa phát nổ tung tóe!\",\"rating\":9.0},\n  {\"id\":744886,\"suggestedTranslation\":\"Nước lá nóng làm mọi thứ thay đổi!\",\"rating\":9.0},\n  {\"id\":744887,\"suggestedTranslation\":\"Wolfgang nên treo nó ở đâu đó mới được.\",\"rating\":9.0},\n  {\"id\":744888,\"suggestedTranslation\":\"Dơi thật á?! Không phải dơi thật đâu.\",\"rating\":9.0},\n  {\"id\":744889,\"suggestedTranslation\":\"Dùng để trang trí thôi.\",\"rating\":9.0},\n  {\"id\":744890,\"suggestedTranslation\":\"Wolfgang cần phải trang trí mới được.\",\"rating\":9.0},\n  {\"id\":744891,\"suggestedTranslation\":\"Wolfgang có thể treo ở xó nào đó.\",\"rating\":9.0},\n  {\"id\":744892,\"suggestedTranslation\":\"Chú chim giả bé con đang cần một cái cây kìa!\",\"rating\":9.0},\n  {\"id\":744893,\"suggestedTranslation\":\"Vẫn dùng tốt chán.\",\"rating\":9.0},\n  {\"id\":744894,\"suggestedTranslation\":\"Cần cái liềm!\",\"rating\":9.0},\n  {\"id\":744895,\"suggestedTranslation\":\"Wolfgang đã sẵn sàng tung cú đấm trời giáng rồi!\",\"rating\":9.0},\n  {\"id\":744896,\"suggestedTranslation\":\"Mềm xốp y như lông bò.\",\"rating\":9.0},\n  {\"id\":744897,\"suggestedTranslation\":\"Wolfgang không hiểu sao lại có người làm thế này nữa.\",\"rating\":9.0},\n  {\"id\":744898,\"suggestedTranslation\":\"Là chiếc gối rất xinh.\",\"rating\":9.0},\n  {\"id\":744899,\"suggestedTranslation\":\"Dùng để đập thì được, chứ để ngủ thì không.\",\"rating\":9.0},\n  {\"id\":744900,\"suggestedTranslation\":\"Wolfgang không sợ ăn đâu! ực...\",\"rating\":9.0},\n  {\"id\":744901,\"suggestedTranslation\":\"Là áo đi nghỉ mát.\",\"rating\":9.0},\n  {\"id\":744902,\"suggestedTranslation\":\"Giúp bạn bè chữa lành mấy vết thương nhẹ.\",\"rating\":9.0},\n  {\"id\":744903,\"suggestedTranslation\":\"Cảm giác hơi nhớp nháp nhưng dễ chịu trên da Wolfgang.\",\"rating\":9.0},\n  {\"id\":744904,\"suggestedTranslation\":\"Giúp da Wolfgang không bị bỏng rát!\",\"rating\":9.0},\n  {\"id\":744905,\"suggestedTranslation\":\"Wolfgang không thể chiến đấu bằng một nhành cây được.\",\"rating\":9.0},\n  {\"id\":744906,\"suggestedTranslation\":\"Đá tảng hơi lạnh một chút rồi.\",\"rating\":9.0},\n  {\"id\":74490