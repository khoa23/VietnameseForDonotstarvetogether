            "text": "[\n  {\"id\": 738637, \"suggestedTranslation\": \"Tao hồi sinh mày lại là để tẩn cho một trận đấy!\", \"rating\": 9.0},\n  {\"id\": 738638, \"suggestedTranslation\": \"Toàn là xương với bóng tối.\", \"rating\": 9.0},\n  {\"id\": 738639, \"suggestedTranslation\": \"Ghê quá, trông nó còn sống nổi đâu.\", \"rating\": 9.0},\n  {\"id\": 738640, \"suggestedTranslation\": \"Chúng ta thực sự đang tin tưởng một bộ xương khổng lồ từng cố giết mình á?!\", \"rating\": 9.0},\n  {\"id\": 738641, \"suggestedTranslation\": \"Hà! Mấy con khỉ ngốc đó để lại bản đồ kho báu kìa!\", \"rating\": 9.0},\n  {\"id\": 738642, \"suggestedTranslation\": \"Trông cũng thế cả thôi.\", \"rating\": 9.0},\n  {\"id\": 738643, \"suggestedTranslation\": \"Cái này là cái thừ quỷ gì thế?\", \"rating\": 9.0},\n  {\"id\": 738644, \"suggestedTranslation\": \"Bức tượng đẹp phết. Tiếc là có gì xảy ra với nó thì hay biết mấy.\", \"rating\": 9.0},\n  {\"id\": 738645, \"suggestedTranslation\": \"Bức tượng tội nghiệp bị dây leo dễ cháy bám đầy rồi kìa! Mình phải làm gì đây?\", \"rating\": 9.0},\n  {\"id\": 738646, \"suggestedTranslation\": \"Một tên mọt sách đá to đùng.\", \"rating\": 9.0},\n  {\"id\": 738647, \"suggestedTranslation\": \"Chắc là một bức tượng tàm tạm.\", \"rating\": 9.0},\n  {\"id\": 738648, \"suggestedTranslation\": \"Ái chà. Nếu là bả thì tôi cũng che cái đó lại.\", \"rating\": 9.0},\n  {\"id\": 738649, \"suggestedTranslation\": \"Cô ta còn chưa kịp trang điểm cho ngày hôm nay kìa.\", \"rating\": 9.0},\n  {\"id\": 738650, \"suggestedTranslation\": \"Có đài lửa thì hay hơn.\", \"rating\": 9.0},\n  {\"id\": 738651, \"suggestedTranslation\": \"Tạo ra tia lửa đi, nó vẫn sẽ cháy thôi.\", \"rating\": 9.0},\n  {\"id\": 738652, \"suggestedTranslation\": \"Xem tôi quay nó nhanh thế nào này!!\", \"rating\": 9.0},\n  {\"id\": 738653, \"suggestedTranslation\": \"Không có cái đó thì đừng mong ra khơi.\", \"rating\": 9.0},\n  {\"id\": 738654, \"suggestedTranslation\": \"Nó nhọn lắm đấy!\", \"rating\": 9.0},\n  {\"id\": 738655, \"suggestedTranslation\": \"Cái đó chắc chắn là không cháy được rồi.\", \"rating\": 9.0},\n  {\"id\": 738656, \"suggestedTranslation\": \"Ngồi vào đấy đi. Cái ghế đó không tự bốc cháy đâu.\", \"rating\": 9.0},\n  {\"id\": 738657, \"suggestedTranslation\": \"Tôi không chắc phải cảm thấy thế nào về đồ nội thất không cháy được nữa.\", \"rating\": 9.0},\n  {\"id\": 738658, \"suggestedTranslation\": \"Tôi không chắc phải cảm thấy thế nào về đồ nội thất không cháy được nữa.\", \"rating\": 9.0},\n  {\"id\": 738659, \"suggestedTranslation\": \"Việc duy nhất còn lại phải làm là nung chảy nó. Tôi sẽ nhóm lò đây!\", \"rating\": 9.0},\n  {\"id\": 738660, \"suggestedTranslation\": \"Nó giúp tôi có thời gian rảnh để đốt mọi thứ.\", \"rating\": 9.0},\n  {\"id\": 738661, \"suggestedTranslation\": \"Một chiếc mũ làm bằng rơm. Cứ nghĩ nó có thể làm bùi nhùi chứ.\", \"rating\": 9.0},\n  {\"id\": 738662, \"suggestedTranslation\": \"Nó vẫn chẳng phải là chim, nhưng được nhồi nhét y như thật!\", \"rating\": 9.0},\n  {\"id\": 738663, \"suggestedTranslation\": \"Ra khỏi con gà tây và vào thẳng bụng tôi nào!\", \"rating\": 9.0},\n  {\"id\": 738664, \"suggestedTranslation\": \"Nó đã được hái rồi.\", \"rating\": 9.0},\n  {\"id\": 738665, \"suggestedTranslation\": \"Ưm... Khô quá. Dễ cháy ghê.\", \"rating\": 9.0},\n  {\"id\": 738666, \"suggestedTranslation\": \"Đó là một loại thực vật nhỏ chưa bị đốt.\", \"rating\": 9.0},\n  {\"id\": 738667, \"suggestedTranslation\": \"Chúng ta giữ nó lại nhé.\", \"rating\": 9.0},\n  {\"id\": 738668, \"suggestedTranslation\": \"Hừm... Giờ tôi đốt nó được rồi chứ?\", \"rating\": 9.0},\n  {\"id\": 738669, \"suggestedTranslation\": \"Ái chà, thôi nào!\", \"rating\": 9.0},\n  {\"id\": 738670, \"suggestedTranslation\": \"Cá là tôi có thể nhồi nhét thêm đống đồ vào trong đó.\", \"rating\": 9.0},\n  {\"id\": 738671, \"suggestedTranslation\": \"Tôi không muốn ở đây khi cái thứ đó sập xuống đâu.\", \"rating\": 9.0},\n  {\"id\": 738672, \"suggestedTranslation\": \"Chắc tôi lại phải để ý mấy cục đá rơi xuống nữa rồi.\", \"rating\": 9.0},\n  {\"id\": 738673, \"suggestedTranslation\": \"Thật tuyệt khi không phải lo lắng về việc cục đá rơi trúng đầu.\", \"rating\": 9.0},\n  {\"id\": 738674, \"suggestedTranslation\": \"Tôi không muốn ở đây khi cái thứ đó sập xuống đâu.\", \"rating\": 9.0},\n  {\"id\": 738675, \"suggestedTranslation\": \"Ai đó nên sửa lại cái này đi chứ.\", \"rating\": 9.0},\n  {\"id\": 738676, \"suggestedTranslation\": \"Tuyệt. Tự hỏi nó có cháy được không nhỉ.\", \"rating\": 9.0},\n  {\"id\": 738677, \"suggestedTranslation\": \"Hừm. Trông đáng ngờ như một công việc vậy.\", \"rating\": 9.0},\n  {\"id\": 738678, \"suggestedTranslation\": \"Hừm. Trông đáng ngờ như một công việc vậy.\", \"rating\": 9.0},\n  {\"id\": 738679, \"suggestedTranslation\": \"Hừ. Đồ ăn cho người già!\", \"rating\": 9.0},\n  {\"id\": 738680, \"suggestedTranslation\": \"Không đẹp bằng áo gi lê bốc cháy, nhưng tạm dùng được.\", \"rating\": 9.0},\n  {\"id\": 738681, \"suggestedTranslation\": \"Không từ chối đâu.\", \"rating\": 9.0},\n  {\"id\": 738682, \"suggestedTranslation\": \"Có gì hay ho ở cái này chứ? Nó chỉ là nước ép lá cây thôi mà.\", \"rating\": 9.0},\n  {\"id\": 738683, \"suggestedTranslation\": \"Tạm ổn, nhưng giờ tôi thực sự muốn có một thanh kiếm lửa.\", \"rating\": 9.0},\n  {\"id\": 738684, \"suggestedTranslation\": \"Giờ thì tôi mới thực sự cảm nhận được không khí ngày lễ đấy!\", \"rating\": 9.0},\n  {\"id\": 738685, \"suggestedTranslation\": \"Chúng ta có khách đến chơi nhà à?\", \"rating\": 9.0},\n  {\"id\": 738686, \"suggestedTranslation\": \"Trông ngon đến mức tôi suýt không nỡ đốt nó luôn.\", \"rating\": 9.0},\n  {\"id\": 738687, \"suggestedTranslation\": \"Ối, nhầm món rồi. Đốt cái đống sai lầm này đi.\", \"rating\": 9.0},\n  {\"id\": 738688, \"suggestedTranslation\": \"Tôi thường thích đồ đạc của mình ở trạng thái hỗn loạn có tổ chức.\", \"rating\": 9.0},\n  {\"id\": 738689, \"suggestedTranslation\": \"Ai mà thèm đọc tạp chí câu cá chứ? Ờ, ngoại trừ tôi lúc này...\", \"rating\": 9.0},\n  {\"id\": 738690, \"suggestedTranslation\": \"Gớm ghiếc, trông nó đầy rẫy côn trùng.\", \"rating\": 9.0},\n  {\"id\": 738691, \"suggestedTranslation\": \"Đồ ngọt cháy rất tốt, nhưng tốt nhất không nên lãng phí thức ăn.\", \"rating\": 9.0},\n  {\"id\": 738692, \"suggestedTranslation\": \"Tôi không nghĩ nó muốn làm bạn đâu.\", \"rating\": 9.0},\n  {\"id\": 738693, \"suggestedTranslation\": \"Nó có thích lửa không nhỉ?\", \"rating\": 9.0},\n  {\"id\": 738694, \"suggestedTranslation\": \"Lửa làm chúng ngon hơn hẳn.\", \"rating\": 9.0},\n  {\"id\": 738695, \"suggestedTranslation\": \"Cần thêm lửa!\", \"rating\": 9.0},\n  {\"id\": 738696, \"suggestedTranslation\": \"Trỗi dậy đi, phượng hoàng của ta!\", \"rating\": 9.0},\n  {\"id\": 738697, \"suggestedTranslation\": \"Có chuyện quá nhiều lửa không vậy?\", \"rating\": 9.0},\n  {\"id\": 738698, \"suggestedTranslation\": \"Cái này mất bao lâu nữa đây?\", \"rating\": 9.0},\n  {\"id\": 738699, \"suggestedTranslation\": \"Tôi bắt đầu chán chờ đợi rồi đấy.\", \"rating\": 9.0},\n  {\"id\": 738700, \"suggestedTranslation\": \"Quả trứng đó dùng chút lửa thì tuyệt!\", \"rating\": 9.0},\n  {\"id\": 738701, \"suggestedTranslation\": \"Cái ổ trống không.\", \"rating\": 9.0},\n  {\"id\": 738702, \"suggestedTranslation\": \"Nó vẫn có cảm giác giòn giòn của chim chóc.\", \"rating\": 9.0},\n  {\"id\": 738703, \"suggestedTranslation\": \"Cảm giác như có một chút lửa trong miệng vậy!\", \"rating\": 9.0},\n  {\"id\": 738704, \"suggestedTranslation\": \"Tôi có cảm giác nó hiểu được.\", \"rating\": 9.0},\n  {\"id\": 738705, \"suggestedTranslation\": \"Nó ăn nhiều thật đấy.\", \"rating\": 9.0},\n  {\"id\": 738706, \"suggestedTranslation\": \"Cả ngày cậu chỉ biết ăn với ngủ thôi à.\", \"rating\": 9.0},\n  {\"id\": 738707, \"suggestedTranslation\": \"Đừng nhìn tôi! Tự đi kiếm đồ ăn đi.\", \"rating\": 9.0},\n  {\"id\": 738708, \"suggestedTranslation\": \"Nó cần thêm chút gì đó nữa.\", \"rating\": 9.0},\n  {\"id\": 738709, \"suggestedTranslation\": \"Tôi có thể cảm nhận được phép thuật!\", \"rating\": 9.0},\n  {\"id\": 738710, \"suggestedTranslation\": \"Tôi chỉ muốn nhìn thế giới này cháy rụi thôi.\", \"rating\": 9.0},\n  {\"id\": 738711, \"suggestedTranslation\": \"Tôi thích cách các ký hiệu phát sáng.\", \"rating\": 9.0},\n  {\"id\": 738712, \"suggestedTranslation\": \"Cần phải mở khóa bằng cách nào đó.\", \"rating\": 9.0},\n  {\"id\": 738713, \"suggestedTranslation\": \"Tôi đang tạo ra một thứ quái dị!\", \"rating\": 9.0},\n  {\"id\": 738714, \"suggestedTranslation\": \"Nó cho cảm giác ấm áp.\", \"rating\": 9.0},\n  {\"id\": 738715, \"suggestedTranslation\": \"Phần này dùng để làm gì thế?\", \"rating\": 9.0},\n  {\"id\": 738716, \"suggestedTranslation\": \"Có lẽ nó nên được nung chảy thành một hình thù đẹp mắt hơn.\", \"rating\": 9.0},\n  {\"id\": 738717, \"suggestedTranslation\": \"Cái này quá quý giá để đốt!\", \"rating\": 9.0},\n  {\"id\": 738718, \"suggestedTranslation\": \"Dùng nó thật là phấn khích.\", \"rating\": 9.0},\n  {\"id\": 738719, \"suggestedTranslation\": \"Chà, tôi vẫn còn mấy huy hiệu của mình.\", \"rating\": 9.0},\n  {\"id\": 738720, \"suggestedTranslation\": \"Tôi đã kiếm được tất cả huy hiệu trong Hướng đạo sinh nữ đấy.\", \"rating\": 9.0},\n  {\"id\": 738721, \"suggestedTranslation\": \"Trông chẳng đáng yêu tẹo nào.\", \"rating\": 9.0},\n  {\"id\": 738722, \"suggestedTranslation\": \"Vừa nhọn vừa nhớp nhúa.\", \"rating\": 9.0},\n  {\"id\": 738723, \"suggestedTranslation\": \"Ewwww.\", \"rating\": 9.0},\n  {\"id\": 738724, \"suggestedTranslation\": \"Tôi nghe thấy tiếng đào bới nhỏ xíu.\", \"rating\": 9.0},\n  {\"id\": 738725, \"suggestedTranslation\": \"Nó đang run lên kìa.\", \"rating\": 9.0},\n  {\"id\": 738726, \"suggestedTranslation\": \"Awwww, chúng muốn ôm kìa!\", \"rating\": 9.0},\n  {\"id\": 738727, \"suggestedTranslation\": \"Hôi quá! Lần sau châm một que diêm đi chứ!\", \"rating\": 9.0},\n  {\"id\": 738728, \"suggestedTranslation\": \"Tôi mong lần tới nó bắn pháo hoa thay vì cầu vồng.\", \"rating\": 9.0},\n  {\"id\": 738729, \"suggestedTranslation\": \"Ôi ghê quá, bên trong trông gớm ghiếc thật!\", \"rating\": 9.0},\n  {\"id\": 738730, \"suggestedTranslation\": \"Oooh... Aaah...\", \"rating\": 9.0},\n  {\"id\": 738731, \"suggestedTranslation\": \"Ngươi sẽ giáng nỗi kinh hoàng nào xuống thế giới của chúng ta đây?\", \"rating\": 9.0},\n  {\"id\": 738732, \"suggestedTranslation\": \"Có vẻ cuộc vui đã tàn.\", \"rating\": 9.0},\n  {\"id\": 738733, \"suggestedTranslation\": \"Oooh, có lẽ nó đang chuẩn bị phát nổ đấy!\", \"rating\": 9.0},\n  {\"id\": 738734, \"suggestedTranslation\": \"Làm lại lần nữa đi! Lần nữa đi!\", \"rating\": 9.0},\n  {\"id\": 738735, \"suggestedTranslation\": \"Đó sẽ là một nơi tuyệt vời để cất đồ trong lúc tôi đi đốt phá.\", \"rating\": 9.0},\n  {\"id\": 738736, \"suggestedTranslation\": \"Làm ơn bên trong có pháo hoa đi, xin đấy!\", \"rating\": 9.0},\n  {\"id\": 738737, \"suggestedTranslation\": \"Tôi không nghĩ nó cháy được đâu.\", \"rating\": 9.0},\n  {\"id\": 738738, \"suggestedTranslation\": \"Tôi nên thử cái này lên người Webber xem sao.\", \"rating\": 9.0},\n  {\"id\": 738739, \"suggestedTranslation\": \"Thulecite này đã vỡ vụn thành mảnh rồi.\", \"rating\": 9.0},\n  {\"id\": 738740, \"suggestedTranslation\": \"Nó có mùi giống tóc cháy!\", \"rating\": 9.0},\n  {\"id\": 738741, \"suggestedTranslation\": \"Tôi không cần cậu giúp đâu!\", \"rating\": 9.0},\n  {\"id\": 738742, \"suggestedTranslation\": \"Một con mèo trúc trông thật hào nhoáng và mệt mỏi. Chắc nó là thương gia đấy.\", \"rating\": 9.0},\n  {\"id\": 738743, \"suggestedTranslation\": \"Xì, có vẻ ai đó đã nhanh tay hơn mình rồi.\", \"rating\": 9.0},\n  {\"id\": 738744, \"suggestedTranslation\": \"Có một con Mèo Trúc Con quanh đây, tôi có thể cảm nhận được...\", \"rating\": 9.0},\n  {\"id\": 738745, \"suggestedTranslation\": \"Có vẻ nó chẳng tìm thấy gì cả.