          {
            "text": "[\n  {\"id\":744123,\"suggestedTranslation\":\"Đã sẵn sàng khai hỏa!\",\"rating\":9.0},\n  {\"id\":744124,\"suggestedTranslation\":\"Đại Bác trống không, nhưng trông vẫn rất đáng sợ!\",\"rating\":9.0},\n  {\"id\":744125,\"suggestedTranslation\":\"À. Wolfgang quên đạn đại bác rồi.\",\"rating\":9.0},\n  {\"id\":744126,\"suggestedTranslation\":\"Wolfgang sẽ làm một khẩu Đại Bác thật oai cho chiến thuyền.\",\"rating\":9.0},\n  {\"id\":744127,\"suggestedTranslation\":\"Liệu chiếc thuyền ván bằng cỏ bé xíu này có chở nổi Wolfgang không?\",\"rating\":9.0},\n  {\"id\":744128,\"suggestedTranslation\":\"Dùng để làm thuyền ván rất đẹp.\",\"rating\":9.0},\n  {\"id\":744129,\"suggestedTranslation\":\"Wolfgang sẽ bịt hố bằng đôi tay lực lưỡng!\",\"rating\":9.0},\n  {\"id\":744130,\"suggestedTranslation\":\"Không nhanh bằng cú chèo uy lực của Wolfgang, nhưng cũng tạm được.\",\"rating\":9.0},\n  {\"id\":744131,\"suggestedTranslation\":\"Anh chàng khoa học bảo cái này dùng cho thuyền ván, trông giống phòng tranh nghệ thuật hơn.\",\"rating\":9.0},\n  {\"id\":744132,\"suggestedTranslation\":\"Bị hỏng rồi, nam châm không dính vào cơ bụng sáu múi bằng thép của Wolfgang được. Hả! Đùa đấy.\",\"rating\":9.0},\n  {\"id\":744133,\"suggestedTranslation\":\"Wolfgang không biết nam châm lại có thể bật và tắt đấy.\",\"rating\":9.0},\n  {\"id\":744134,\"suggestedTranslation\":\"Được rồi, Wolfgang sẽ chế tạo thứ khoa học vui nhộn này cho thuyền ván.\",\"rating\":9.0},\n  {\"id\":744135,\"suggestedTranslation\":\"Là một cái cần gạt / đòn bẩy nhỏ xoay được.\",\"rating\":9.0},\n  {\"id\":744136,\"suggestedTranslation\":\"Sẽ làm cho thuyền ván quay ngoắt hơn, phải không?\",\"rating\":9.0},\n  {\"id\":744137,\"suggestedTranslation\":\"Xốp mềm giống như bò lông.\",\"rating\":9.0},\n  {\"id\":744138,\"suggestedTranslation\":\"Wolfgang không hiểu sao lại có người làm thế này.\",\"rating\":9.0},\n  {\"id\":744139,\"suggestedTranslation\":\"Là một chiếc gối rất đẹp.\",\"rating\":9.0},\n  {\"id\":744140,\"suggestedTranslation\":\"May mà Wolfgang có làn da rắn chắc.\",\"rating\":9.0},\n  {\"id\":744141,\"suggestedTranslation\":\"Bùm!\",\"rating\":9.0},\n  {\"id\":744142,\"suggestedTranslation\":\"Ha! Người bạn lá xanh nhỏ bé đã làm cho nó tốt hơn rồi!\",\"rating\":9.0},\n  {\"id\":744143,\"suggestedTranslation\":\"Wolfgang nghiền nát thành những khúc xương nhỏ hơn nữa!\",\"rating\":9.0},\n  {\"id\":744144,\"suggestedTranslation\":\"Wolfgang sẽ trở nên vô cùng lực lưỡng!\",\"rating\":9.0},\n  {\"id\":744145,\"suggestedTranslation\":\"Là món súp đầy thịt chắc khỏe.\",\"rating\":9.0},\n  {\"id\":744146,\"suggestedTranslation\":\"Wolfgang sẽ giúp cô nàng trí tuệ chế tạo cái khác!\",\"rating\":9.0},\n  {\"id\":744147,\"suggestedTranslation\":\"Làm cô nàng trí tuệ vui vẻ, Wolfgang sẽ bảo vệ nó!\",\"rating\":9.0},\n  {\"id\":744148,\"suggestedTranslation\":\"Đúng vậy, Wolfgang không biết nhiều về văn hóa vượn lắm.\",\"rating\":9.0},\n  {\"id\":744149,\"suggestedTranslation\":\"Sách dành cho đám chim chóc!\",\"rating\":9.0},\n  {\"id\":744150,\"suggestedTranslation\":\"Cuốn sách nhỏ làm Wolfgang sợ đấy!\",\"rating\":9.0},\n  {\"id\":744151,\"suggestedTranslation\":\"Wolfgang không hiểu mấy chữ cái nhỏ xíu đâu.\",\"rating\":9.0},\n  {\"id\":744152,\"suggestedTranslation\":\"Wolfgang hi vọng nó không được giải thích bằng những từ ngữ to tát hơn...\",\"rating\":9.0},\n  {\"id\":744153,\"suggestedTranslation\":\"Hình ảnh về câu cá khiến bụng Wolfgang sôi lên sùng sục.\",\"rating\":9.0},\n  {\"id\":744154,\"suggestedTranslation\":\"Trông có vẻ khó đọc quá.\",\"rating\":9.0},\n  {\"id\":744155,\"suggestedTranslation\":\"Wolfgang thà trồng cơ bắp còn hơn trồng hoa.\",\"rating\":9.0},\n  {\"id\":744156,\"suggestedTranslation\":\"Cuốn sách nhỏ giúp thực phẩm mọc lên cho Wolfgang.\",\"rating\":9.0},\n  {\"id\":744157,\"suggestedTranslation\":\"Liệu cuốn sách dày hơn có mọc ra những loại rau củ dày hơn không?\",\"rating\":9.0},\n  {\"id\":744158,\"suggestedTranslation\":\"Wolfgang thích ánh sáng từ sách.\",\"rating\":9.0},\n  {\"id\":744159,\"suggestedTranslation\":\"Wolfgang bắt đầu thấy có cảm tình với sách vở rồi đấy.\",\"rating\":9.0},\n  {\"id\":744160,\"suggestedTranslation\":\"Wolfgang chẳng cần sách cũng biết mặt trăng ở đâu.\",\"rating\":9.0},\n  {\"id\":744161,\"suggestedTranslation\":\"Wolfgang sẽ mang theo dù, đề phòng cho chắc.\",\"rating\":9.0},\n  {\"id\":744162,\"suggestedTranslation\":\"Hừm, sách nặng đây, chắc dùng để tập tạ được.\",\"rating\":9.0},\n  {\"id\":744163,\"suggestedTranslation\":\"Wolfgang thà trồng cơ bắp còn hơn trồng hoa.\",\"rating\":9.0},\n  {\"id\":744164,\"suggestedTranslation\":\"Mắt Wolfgang nặng trĩu như quả tạ tay vậy.\",\"rating\":9.0},\n  {\"id\":744165,\"suggestedTranslation\":\"Nhưng Wolfgang cần phải cảm nhận sự đốt cháy cơ bắp chứ!\",\"rating\":9.0},\n  {\"id\":744166,\"suggestedTranslation\":\"Wolfgang muốn có thật nhiều kẻ địch để chiến đấu!\",\"rating\":9.0},\n  {\"id\":744167,\"suggestedTranslation\":\"Ái chà!!\",\"rating\":9.0},\n  {\"id\":744168,\"suggestedTranslation\":\"Bùm! Một cú văng! Ha!\",\"rating\":9.0},\n  {\"id\":744169,\"suggestedTranslation\":\"Không phải cỡ của Wolfgang.\",\"rating\":9.0},\n  {\"id\":744170,\"suggestedTranslation\":\"Xin lỗi các bạn, Wolfgang quên mất sức mạnh của chính mình rồi.\",\"rating\":9.0},\n  {\"id\":744171,\"suggestedTranslation\":\"Wolfgang sẽ rèn lại công cụ bằng tay không! Chỉ cần nhiệt độ thôi!\",\"rating\":9.0},\n  {\"id\":744172,\"suggestedTranslation\":\"Dùng để chải mái tóc thật khỏe!\",\"rating\":9.0},\n  {\"id\":744173,\"suggestedTranslation\":\"Bắt côn trùng.\",\"rating\":9.0},\n  {\"id\":744174,\"suggestedTranslation\":\"Cái ao lớn đang mọc tóc kìa.\",\"rating\":9.0},\n  {\"id\":744175,\"suggestedTranslation\":\"Hết sạch rồi.\",\"rating\":9.0},\n  {\"id\":744176,\"suggestedTranslation\":\"Tôi nghĩ nó không phải là vũ khí tốt lắm đâu.\",\"rating\":9.0},\n  {\"id\":744177,\"suggestedTranslation\":\"Chắc là có bất ngờ nho nhỏ bên trong.\",\"rating\":9.0},\n  {\"id\":744178,\"suggestedTranslation\":\"Dùng để giấu đồ ngon.\",\"rating\":9.0},\n  {\"id\":744179,\"suggestedTranslation\":\"Chào thỏ nhé!\",\"rating\":9.0},\n  {\"id\":744180,\"suggestedTranslation\":\"Thỏ bé xíu mà làm ra món ăn to thế? Wolfgang thích toán học đấy.\",\"rating\":9.0},\n  {\"id\":744181,\"suggestedTranslation\":\"Giờ nó cháy tiêu rồi.\",\"rating\":9.0},\n  {\"id\":744182,\"suggestedTranslation\":\"Lén lút ghê!\",\"rating\":9.0},\n  {\"id\":744183,\"suggestedTranslation\":\"Béo ngậy như bơ, và có vị như côn trùng.\",\"rating\":9.0},\n  {\"id\":744184,\"suggestedTranslation\":\"Đúng là chú bướm xinh đẹp vẫy vùng!\",\"rating\":9.0},\n  {\"id\":744185,\"suggestedTranslation\":\"Thú cưng của tôi!\",\"rating\":9.0},\n  {\"id\":744186,\"suggestedTranslation\":\"Wolfgang không biết gì về bánh nướng côn trùng cả. Rất muốn nếm thử xem sao.\",\"rating\":9.0},\n  {\"id\":744187,\"suggestedTranslation\":\"Không có cánh thì đừng mong bay!\",\"rating\":9.0},\n  {\"id\":744188,\"suggestedTranslation\":\"Cứ đi tiếp đi.\",\"rating\":9.0},\n  {\"id\":744189,\"suggestedTranslation\":\"Thế lại tốt hơn cho chú kền kền.\",\"rating\":9.0},\n  {\"id\":744190,\"suggestedTranslation\":\"Wolfgang thấy hơi buồn một chút.\",\"rating\":9.0},\n  {\"id\":744191,\"suggestedTranslation\":\"Ồ, không.\",\"rating\":9.0},\n  {\"id\":744192,\"suggestedTranslation\":\"Wolfgang thích bắp cải cuộn ngập trong dưa cải muối!\",\"rating\":9.0},\n  {\"id\":744193,\"suggestedTranslation\":\"Wolfgang không thích thực vật sắc nhọn.\",\"rating\":9.0},\n  {\"id\":744194,\"suggestedTranslation\":\"Ha! Là thực vật bị cắt trụi.\",\"rating\":9.0},\n  {\"id\":744195,\"suggestedTranslation\":\"Không đáng đâu.\",\"rating\":9.0},\n  {\"id\":744196,\"suggestedTranslation\":\"Thịt thực vật gai góc.\",\"rating\":9.0},\n  {\"id\":744197,\"suggestedTranslation\":\"Bây giờ đã an toàn trong két sắt rồi.\",\"rating\":9.0},\n  {\"id\":744198,\"suggestedTranslation\":\"Chui vào bụng Wolfgang đi nào!\",\"rating\":9.0},\n  {\"id\":744199,\"suggestedTranslation\":\"Bóng đêm đang đến kìa!\",\"rating\":9.0},\n  {\"id\":744200,\"suggestedTranslation\":\"Tạm biệt thời kỳ tăm tối!\",\"rating\":9.0},\n  {\"id\":744201,\"suggestedTranslation\":\"Lửa cháy dữ dội quá!\",\"rating\":9.0},\n  {\"id\":744202,\"suggestedTranslation\":\"Ngọn lửa không đủ nóng.\",\"rating\":9.0},\n  {\"id\":744203,\"suggestedTranslation\":\"Ngọn lửa tuyệt vời!\",\"rating\":9.0},\n  {\"id\":744204,\"suggestedTranslation\":\"Ồ ôi. Nó tắt mất rồi.\",\"rating\":9.0},\n  {\"id\":744205,\"suggestedTranslation\":\"Là chú chim màu vàng nhỏ bé!\",\"rating\":9.0},\n  {\"id\":744206,\"suggestedTranslation\":\"Chú chim nhỏ lọt thỏm trong bàn tay to lớn của Wolfgang.\",\"rating\":9.0},\n  {\"id\":744207,\"suggestedTranslation\":\"Chim vẫn ổn chứ?\",\"rating\":9.0},\n  {\"id\":744208,\"suggestedTranslation\":\"Là chiếc túi nhỏ đựng quà vặt rùng rợn!\",\"rating\":9.0},\n  {\"id\":744209,\"suggestedTranslation\":\"Vừa để đi bộ LẠI vừa để đập người khác!\",\"rating\":9.0},\n  {\"id\":744210,\"suggestedTranslation\":\"Đừng lo, Wolfgang sẽ mang đi cho.\",\"rating\":9.0},\n  {\"id\":744211,\"suggestedTranslation\":\"Ái! Khẩu đại bác nhỏ làm Wolfgang giật mình!\",\"rating\":9.0},\n  {\"id\":744212,\"suggestedTranslation\":\"Đã đến lúc ăn mừng rồi!\",\"rating\":9.0},\n  {\"id\":744213,\"suggestedTranslation\":\"À... làm Wolfgang nhớ lại những ngày ở rạp xiếc.\",\"rating\":9.0},\n  {\"id\":744214,\"suggestedTranslation\":\"Đang bắt lấy ánh sáng à? Wolfgang hy vọng nó sẽ chia sẻ chút.\",\"rating\":9.0},\n  {\"id\":744215,\"suggestedTranslation\":\"Ha! Vừa nhỏ vừa dễ làm.\",\"rating\":9.0},\n  {\"id\":744216,\"suggestedTranslation\":\"Đồ chơi cưỡi trứng nhỏ.\",\"rating\":9.0},\n  {\"id\":744217,\"suggestedTranslation\":\"Ha! Vừa nhỏ vừa dễ làm.\",\"rating\":9.0},\n  {\"id\":744218,\"suggestedTranslation\":\"Ồ, là bức tượng nhỏ xíu!\",\"rating\":9.0},\n  {\"id\":744219,\"suggestedTranslation\":\"Cái này rất đặc biệt đấy.\",\"rating\":9.0},\n  {\"id\":744220,\"suggestedTranslation\":\"Wolfgang chưa thấy nhiều cái giống thế này đâu!\",\"rating\":9.0},\n  {\"id\":744221,\"suggestedTranslation\":\"Có gì trong chiếc hộp bí mật nhỏ xíu thế nhỉ?\",\"rating\":9.0},\n  {\"id\":744222,\"suggestedTranslation\":\"Có gì trong chiếc hộp bí mật nhỏ xíu thế nhỉ?\",\"rating\":9.0},\n  {\"id\":744223,\"suggestedTranslation\":\"Có gì trong chiếc hộp bí mật nhỏ xíu thế nhỉ?\",\"rating\":9.0},\n  {\"id\":744224,\"suggestedTranslation\":\"Tạo ra thứ ánh sáng nhỏ bé, xinh xắn.\",\"rating\":9.0},\n  {\"id\":744225,\"suggestedTranslation\":\"Ha! Vừa nhỏ vừa dễ làm.\",\"rating\":9.0},\n  {\"id\":744226,\"suggestedTranslation\":\"Wolfgang có thể bẻ gãy thân cây như tăm xỉa răng ấy chứ!\",\"rating\":9.0},\n  {\"id\":744227,\"suggestedTranslation\":\"Ha! Vừa nhỏ vừa dễ làm.\",\"rating\":9.0},\n  {\"id\":744228,\"suggestedTranslation\":\"Là thức uống sệt vị bắp lạnh ngắt.\",\"rating\":9.0},\n  {\"id\":744229,\"suggestedTranslation\":\"Haha! Sâu giun kìa, nhưng mà giả thôi!\",\"rating\":9.0},\n  {\"id\":744230,\"suggestedTranslation\":\"À... làm Wolfgang nhớ lại những ngày ở rạp xiếc.\",\"rating\":9.0},\n  {\"id\":744231,\"suggestedTranslation\":\"Cánh cửa chim non.\",\"rating\":9.0},\n  {\"id\":744232,\"suggestedTranslation\":\"Cần phải có thẻ trước đã.\",\"rating\":9.0},\n  {\"id\":744233,\"suggestedTranslation\":\"Ha ha! Wolfgang sẽ cho tất cả lũ chim nhỏ ăn!\",\"rating\":9.0},\n  {\"id\":744234,\"suggestedTranslation\":\"Xin lỗi nếu Wolfgang vung gậy quá mạnh nhé, quả bóng nhỏ.\",\"rating\":9.0},\n  {\"id\":744235,\"suggestedTranslation\":\"Là chiếc gậy còi cọc nhưng Wolfgang sẽ dùng được tuốt.\",\"rating\":9.0},\n  {\"id\":744236,\"suggestedTranslation\":\"Wolfgang tự làm đường đua luôn!\",\"rating\":9.0},\n  {\"id\":744237,\"suggestedTranslation\":\"Dành cho mấy đứa trẻ con!\",\"rating\":9.0},\n  {\"id\":744238,\"suggestedTranslation\":\"Cuối cùng cũng có chút thử thách cho Wolfgang!\",\"rating\":9.0},\n  {\"id\":744239,\"suggestedTranslation\":\"Dành cho người chơi gôn nghiệp dư bình thường, nhưng Wolfgang lực lưỡng hơn mức bình thường.\",\"rating\":9.0},\n  {\"id\":744240,\"suggestedTranslation\":\"Tránh đường cho Wolfgang mau!\",\"rating\":9.0},\n  {\"id\":744241,\"suggestedTranslation\":\"Này, đừng có thổi bay quả bóng của Wolfgang chứ!\",\"rating\":9.0},\n  {\"id\":744242,\"suggestedTranslation\":\"Liệu nó có đủ chắc để giữ quả bóng của Wolfgang lại không đây?\",\"rating\":9.0},\n  {\"id\":744243,\"suggestedTranslation\":\"Cái bức tường cứ lên xuống làm Wolfgang bực mình quá!\",\"rating\":9.0},\n  {\"id\":744244,\"suggestedTranslation\":\"Làm Wolfgang chóng mặt.\",\"rating\":9.0},\n  {\"id\":744245,\"suggestedTranslation\":\"Quả bóng nhỏ nảy tưng tưng!\",\"rating\":9.0},\n  {\"id\":744246,\"suggestedTranslation\":\"Nó sẽ đưa quả bóng nhỏ đi đâu đây?\",\"rating\":9.0},\n  {\"id\":744247,\"suggestedTranslation\":\"Vừa nãy ai nhắc đến ông kẹ ấy nhỉ?\",\"rating\":9.0},\n  {\"id\":744248,\"suggestedTranslation\":\"Wolfgang cắm cột cờ ở đâu cơ chứ?\",\"rating\":9.0},\n  {\"id\":744249,\"suggestedTranslation\":\"Không có trò chơi miễn phí cho Wolfgang à? Cần có thẻ!\",\"rating\":9.0},\n  {\"id\":744250,\"suggestedTranslation\":\"Wolfgang cần phải dựng xong sân trước đã.\",\"rating\":9.0},\n  {\"id\":744251,\"suggestedTranslation\":\"Đã trả thẻ! Wolfgang chơi đây!\",\"rating\":9.0},\n  {\"id\":744252,\"suggestedTranslation\":\"Wolfgang bắt đầu từ đâu nhỉ?\",\"rating\":9.0},\n  {\"id\":744253,\"suggestedTranslation\":\"Quay lại đây nào trứng ơi!\",\"rating\":9.0},\n  {\"id\":744254,\"suggestedTranslation\":\"À... làm Wolfgang nhớ lại những ngày ở rạp xiếc.\",\"rating\":9.0},\n  {\"id\":744255,\"suggestedTranslation\":\"Cần phải có thẻ trước đã.\",\"rating\":9.0},\n  {\"id\":744256,\"suggestedTranslation\":\"Haha! Chúng chạy như mấy con sinh vật nhỏ bé hoảng sợ ấy!\",\"rating\":9.0},\n  {\"id\":744257,\"suggestedTranslation\":\"Cánh cửa chim non.\",\"rating\":9.0},\n  {\"id\":744258,\"suggestedTranslation\":\"Là cái này đây! Không... là cái kia à?\",\"rating\":9.0},\n  {\"id\":744259,\"suggestedTranslation\":\"À... làm Wolfgang nhớ lại những ngày ở rạp xiếc.\",\"rating\":9.0},\n  {\"id\":744260,\"suggestedTranslation\":\"Cần phải có thẻ trước đã.\",\"rating\":9.0},\n  {\"id\":744261,\"suggestedTranslation\":\"Mấy chú chim làm ra trò chơi lắt léo phết.\",\"rating\":9.0},\n  {\"id\":744262,\"suggestedTranslation\":\"À... làm Wolfgang nhớ lại những ngày ở rạp xiếc.\",\"rating\":9.0},\n  {\"id\":744263,\"suggestedTranslation\":\"Cần phải có thẻ trước đã.\",\"rating\":9.0},\n  {\"id\":744264,\"suggestedTranslation\":\"Nhấc bổng máy lên rồi lắc cho quả bóng rơi đúng chỗ thì có tính là gian lận không nhỉ?\",\"rating\":9.0},\n  {\"id\":744265,\"suggestedTranslation\":\"Cần phải có thẻ trước đã.\",\"rating\":9.0},\n  {\"id\":744266,\"suggestedTranslation\":\"Đây là cái nút để đấm!\",\"rating\":9.0},\n  {\"id\":744267,\"suggestedTranslation\":\"À... làm Wolfgang nhớ lại những ngày ở rạp xiếc.\",\"rating\":9.0},\n  {\"id\":744268,\"suggestedTranslation\":\"Cần phải có thẻ trước đã.\",\"rating\":9.0},\n  {\"id\":744269,\"suggestedTranslation\":\"Wolfgang sẽ giúp cô chim mẹ lực lưỡng bảo vệ tổ!\",\"rating\":9.0},\n  {\"id\":744270,\"suggestedTranslation\":\"Cánh cửa chim non.\",\"rating\":9.0},\n  {\"id\":744271,\"suggestedTranslation\":\"Wolfgang không thích côn trùng đâu.\",\"rating\":9.0},\n  {\"id\":744272,\"suggestedTranslation\":\"À... làm Wolfgang nhớ lại những ngày ở rạp xiếc.\",\"rating\":9.0},\n  {\"id\":744273,\"suggestedTranslation\":\"Cần phải có thẻ trước đã.\",\"rating\":9.0},\n  {\"id\":744274,\"suggestedTranslation\":\"Haha! Wolfgang là cao thủ trò vòng quay may mắn!\",\"rating\":9.0},\n  {\"id\":744275,\"suggestedTranslation\":\"Làm Wolfgang nhớ về thời thơ ấu.\",\"rating\":9.0},\n  {\"id\":744276,\"suggestedTranslation\":\"Chào mừng đứa trẻ chim! Hãy tận hưởng lễ hội nhé!\",\"rating\":9.0},\n  {\"id\":744277,\"suggestedTranslation\":\"Là thẻ đổi thưởng cho trò chơi của chim.\",\"rating\":9.0},\n  {\"id\":744278,\"suggestedTranslation\":\"Ông ấy giống quản trò rạp xiếc, nhưng mà giống chim hơn.\",\"rating\":9.0},\n  {\"id\":744279,\"suggestedTranslation\":\"Hừm... nơi này trông trống trải đối với Wolfgang đấy...\",\"rating\":9.0},\n  {\"id\":744280,\"suggestedTranslation\":\"Wolfgang có thể làm cho nó đẹp hơn nữa cơ!\",\"rating\":9.0},\n  {\"id\":744281,\"suggestedTranslation\":\"Là cái cây đẹp nhất trong rừng!\",\"rating\":9.0},\n  {\"id\":744282,\"suggestedTranslation\":\"Sẽ làm một cái cây đẹp cho mấy chú chim.\",\"rating\":9.0},\n  {\"id\":744283,\"suggestedTranslation\":\"Hãy trao phần thưởng lớn nhất cho Wolfgang!\",\"rating\":9.0},\n  {\"id\":744284,\"suggestedTranslation\":\"Đừng lo mấy chú chim nhỏ, Wolfgang sẽ xây nó cho!\",\"rating\":9.0},\n  {\"id\":744285,\"suggestedTranslation\":\"Aha! Là vé đổi thưởng!\",\"rating\":9.0},\n  {\"id\":744286,\"suggestedTranslation\":\"Chồng vé gần to bằng cơ bắp của Wolfgang rồi đấy!\",\"rating\":9.0},\n  {\"id\":744287,\"suggestedTranslation\":\"Wolfgang sẽ rinh giải thưởng lớn nhất cho xem!\",\"rating\":9.0},\n  {\"id\":744288,\"suggestedTranslation\":\"Đồ ăn vặt cho chim.\",\"rating\":9.0},\n  {\"id\":744289,\"suggestedTranslation\":\"Khăn quàng cổ lá cây của chim.\",\"rating\":9.0},\n  {\"id\":744290,\"suggestedTranslation\":\"Luôn nghĩ choàng áo choàng trông Wolfgang sẽ ngầu lắm.\",\"rating\":9.0},\n  {\"id\":744291,\"suggestedTranslation\":\"Phải tốn rất nhiều lá mới che hết được cơ bắp cuồn cuộn của Wolfgang.\",\"rating\":9.0},\n  {\"id\":744292,\"suggestedTranslation\":\"Wolfgang đã từng bị mảnh thủy tinh cắt cho một vố đau điếng.\",\"rating\":9.0},\n  {\"id\":744293,\"suggestedTranslation\":\"Cái cưa nhỏ tội nghiệp.\",\"rating\":9.0},\n  {\"id\":744294,\"suggestedTranslation\":\"Ai lực lưỡng hơn? Con người hay máy móc? Sai bét. Là Wolfgang.\",\"rating\":9.0},\n  {\"id\":744295,\"suggestedTranslation\":\"Đã chết rồi.\",\"rating\":9.0},\n  {\"id\":744296,\"suggestedTranslation\":\"Củ cà rốt dài chân đang chạy trốn kìa!\",\"rating\":9.0},\n  {\"id\":744297,\"suggestedTranslation\":\"Bây giờ ngươi đã an toàn trong két sắt rồi, củ cà rốt dài chân ạ.\",\"rating\":9.0},\n  {\"id\":744298,\"suggestedTranslation\":\"Củ cà rốt dài chân đang ngủ.\",\"rating\":9.0},\n  {\"id\":744299,\"suggestedTranslation\":\"Có cái gì đó không ổn với tên đó...\",\"rating\":9.0},\n  {\"id\":744300,\"suggestedTranslation\":\"Là đồ ăn. Chắc vậy.\",\"rating\":9.0},\n  {\"id\":744301,\"suggestedTranslation\":\"Nấu lên rồi mà trông vẫn chẳng giống thịt tẹo nào.\",\"rating\":9.0},\n  {\"id\":744302,\"suggestedTranslation\":\"Ít ra thì nó cũng to. Wolfgang có thể dùng làm tạ tập.\",\"rating\":9.0},\n  {\"id\":744303,\"suggestedTranslation\":\"Đang trốn à?\",\"rating\":9.0},\n  {\"id\":744304,\"suggestedTranslation\":\"Hạt nhỏ quá đi mất.\",\"rating\":9.0},\n  {\"id\":744305,\"suggestedTranslation\":\"Không ổn rồi!\",\"rating\":9.0},\n  {\"id\":744306,\"suggestedTranslation\":\"Hết mấy hình vẽ nhỏ xíu rồi.\",\"rating\":9.0},\n  {\"id\":744307,\"suggestedTranslation\":\"Mấy người bạn làm ra mấy bức tranh nhỏ để giúp Wolfgang không bị lạc đường!\",\"rating\":9.0},\n  {\"id\":744308,\"suggestedTranslation\":\"Wolfgang không tin tưởng nó đâu.\",\"rating\":9.0},\n  {\"id\":744309,\"suggestedTranslation\":\"Wolfgang thấy thoải mái hơn khi gốc cây trống không rồi đây.\",\"rating\":9.0},\n  {\"id\":744310,\"suggestedTranslation\":\"Cái gốc cây khả nghi thật.\",\"rating\":9.0},\n  {\"id\":744311,\"suggestedTranslation\":\"Chiếc nón của sự thiếu tin cậy.\",\"rating\":9.0},\n  {\"id\":744312,\"suggestedTranslation\":\"Éc! Ồ, không phải thật à.\",\"rating\":9.0},\n  {\"id\":744313,\"suggestedTranslation\":\"Nhấc tảng đá lên thì có khó khăn gì đâu.\",\"rating\":9.0},\n  {\"id\":744314,\"suggestedTranslation\":\"Wolfgang phải dời những cục đá khác đi thôi.\",\"rating\":9.0},\n  {\"id\":744315,\"suggestedTranslation\":\"Ngon tuyệt!\",\"rating\":9.0},\n  {\"id\":744316,\"suggestedTranslation\":\"Giòn rụm.\",\"rating\":9.0},\n  {\"id\":744317,\"suggestedTranslation\":\"Ấm nóng và ngon miệng!\",\"rating\":9.0},\n  {\"id\":744318,\"suggestedTranslation\":\"Chào cái cây mọc ngược nhé.\",\"rating\":9.0},\n  {\"id\":744319,\"suggestedTranslation\":\"Ngay cả tôi cũng không khỏe đến thế đâu.\",\"rating\":9.0},\n  {\"id\":744320,\"suggestedTranslation\":\"Quá nhiều người nhồi nhét trong đó rồi.\",\"rating\":9.0},\n  {\"id\":744321,\"suggestedTranslation\":\"Ai lại muốn chui xuống cái hố hang đáng sợ đó cơ chứ!\",\"rating\":9.0},\n  {\"id\":744322,\"suggestedTranslation\":\"Thế giới có cả cái nút rốn kìa!\",\"rating\":9.0},\n  {\"id\":744323,\"suggestedTranslation\":\"Ngay cả tôi cũng không khỏe đến thế đâu.\",\"rating\":9.0},\n  {\"id\":744324,\"suggestedTranslation\":\"Làm ơn chừa chỗ đi! Wolfgang lực lưỡng đang sợ đây này!\",\"rating\":9.0},\n  {\"id\":744325,\"suggestedTranslation\":\"Làm ơn thả Wolfgang ra ngoài đi!\",\"rating\":9.0},\n  {\"id\":744326,\"suggestedTranslation\":\"Dưới này tối tăm và đáng sợ quá.\",\"rating\":9.0},\n  {\"id\":744327,\"suggestedTranslation\":\"Thực vật xinh quá!\",\"rating\":9.0},\n  {\"id\":744328,\"suggestedTranslation\":\"Thực vật chết rồi.\",\"rating\":9.0},\n  {\"id\":744329,\"suggestedTranslation\":\"Con bọ xì hơi đã ngỏm củ tỏi.\",\"rating\":9.0},\n  {\"id\":744330,\"suggestedTranslation\":\"Là mitey (nhỏ xíu), chứ không phải mighty (lực lưỡng)!\",\"rating\":9.0},\n  {\"id\":744331,\"suggestedTranslation\":\"Suỵt, con bọ xì hơi đang ngủ.\",\"rating\":9.0},\n  {\"id\":744332,\"suggestedTranslation\":\"Hơi gas độc hại quá!\",\"rating\":9.0},\n  {\"id\":744333,\"suggestedTranslation\":\"Giống như Wolfgang mỗi khi ăn quá nhiều đạm!\",\"rating\":9.0},\n  {\"id\":744334,\"suggestedTranslation\":\"Là cách mặt đất thở đấy.\",\"rating\":9.0},\n  {\"id\":744335,\"suggestedTranslation\":\"Wolfgang thích phòng xông hơi lắm.\",\"rating\":9.0},\n  {\"id\":744336,\"suggestedTranslation\":\"Wolfgang ghét đám mây tăm tối gớm ghiếc này.\",\"rating\":9.0},\n  {\"id\":744337,\"suggestedTranslation\":\"Wolfgang là tay leo núi cừ khôi.\",\"rating\":9.0},\n  {\"id\":744338,\"suggestedTranslation\":\"Vào bụng Wolfgang sẽ ngon hơn đấy!\",\"rating\":9.0},\n  {\"id\":744339,\"suggestedTranslation\":\"Cảm giác như đang cầm một khúc cây khô nhỏ xíu.\",\"rating\":9.0},\n  {\"id\":744342,\"suggestedTranslation\":\"Đang cần cái gì đó phải không?\",\"rating\":9.0},\n  {\"id\":744343,\"suggestedTranslation\":\"Wolfgang đang nghĩ đến chuyện một mũi tên trúng hai đích...\",\"rating\":9.0},\n  {\"id\":744344,\"suggestedTranslation\":\"Có phần nào dành cho lực sĩ không nhỉ?\",\"rating\":9.0},\n  {\"id\":744345,\"suggestedTranslation\":\"Wolfgang từng thấy khuôn mặt đó trong bóng tối...\",\"rating\":9.0},\n  {\"id\":744346,\"suggestedTranslation\":\"Giống như một sân khấu xiếc nhỏ.\",\"rating\":9.0},\n  {\"id\":744347,\"suggestedTranslation\":\"Đồ phế liệu bằng kim loại.\",\"rating\":9.0},\n  {\"id\":744348,\"suggestedTranslation\":\"Đồ phế liệu bằng kim loại.\",\"rating\":9.0},\n  {\"id\":744349,\"suggestedTranslation\":\"Đồ phế liệu bằng kim loại.\",\"rating\":9.0},\n  {\"id\":744350,\"suggestedTranslation\":\"To thật đấy. Lại còn nặng nữa. Wolfgang rất muốn nâng nó lên.\",\"rating\":9.0},\n  {\"id\":744351,\"suggestedTranslation\":\"Wolfgang sẽ không đấu trợn mắt với nó đâu.\",\"rating\":9.0},\n  {\"id\":744352,\"suggestedTranslation\":\"Bức tượng quái thú đáng sợ!\",\"rating\":9.0},\n  {\"id\":744353,\"suggestedTranslation\":\"Wolfgang khỏe hơn gấu. Kể cả gấu kỳ dị.\",\"rating\":9.0},\n  {\"id\":744354,\"suggestedTranslation\":\"Trông gần giống hệt bò lông thật.\",\"rating\":9.0},\n  {\"id\":744355,\"suggestedTranslation\":\"Bức tượng lực lưỡng vẫn đứng bất động một cách lực lưỡng.\",\"rating\":9.0},\n  {\"id\":744356,\"suggestedTranslation\":\"Gã người đá tảng nhỏ bé yếu ớt trông đẹp phết.\",\"rating\":9.0},\n  {\"id\":744357,\"suggestedTranslation\":\"Wolfgang không thích tượng biết cử động đâu!!\",\"rating\":9.0},\n  {\"id\":744358,\"suggestedTranslation\":\"Trông giống chú bướm nhỏ, nhưng to hơn!\",\"rating\":9.0},\n  {\"id\":744359,\"suggestedTranslation\":\"Wolfgang rất thích đua với mấy củ cà rốt dài chân.\",\"rating\":9.0},\n  {\"id\":744360,\"suggestedTranslation\":\"Ha! Tìm con này dễ ợt.\",\"rating\":9.0},\n  {\"id\":744361,\"suggestedTranslation\":\"Cún con dễ thương ghê.\",\"rating\":9.0},\n  {\"id\":744362,\"suggestedTranslation\":\"Trông cứ như quái vật đáng sợ ấy!\",\"rating\":9.0},\n  {\"id\":744363,\"suggestedTranslation\":\"Wolfgang bị say sóng cả mấy ngày liền...\",\"rating\":9.0},\n  {\"id\":744364,\"suggestedTranslation\":\"Wolfgang có cơ bắp to hơn cơ, thấy chưa?\",\"rating\":9.0},\n  {\"id\":744365,\"suggestedTranslation\":\"Được rồi, gã ta cũng khá lực lưỡng đấy, nhưng Wolfgang vẫn lực lưỡng hơn.\",\"rating\":9.0},\n  {\"id\":744366,\"suggestedTranslation\":\"Là bức tượng quái vật đáng sợ.\",\"rating\":9.0},\n  {\"id\":744367,\"suggestedTranslation\":\"Wolfgang không sợ tượng đâu, nhưng phải cẩn thận với cái phần nhọn hoắt kia.\",\"rating\":9.0},\n  {\"id\":744368,\"suggestedTranslation\":\"Con sâu đất chẳng có cửa đấu lại Wolfgang đâu.\",\"rating\":9.0},\n  {\"id\":744369,\"suggestedTranslation\":\"Là quái vật sát thủ bốc lửa, nhưng bằng đá.\",\"rating\":9.0},\n  {\"id\":744370,\"suggestedTranslation\":\"Không thích cách nó nhìn Wolfgang chút nào.\",\"rating\":9.0},\n  {\"id\":744371,\"suggestedTranslation\":\"Trông thiếu vẻ lực lưỡng trầm trọng.\",\"rating\":9.0},\n  {\"id\":744372,\"suggestedTranslation\":\"Wolfgang mừng vì nó chỉ là tượng.\",\"rating\":9.0},\n  {\"id\":744373,\"suggestedTranslation\":\"Sao đồ ăn bằng đá lại làm đau miệng thế nhỉ?\",\"rating\":9.0},\n  {\"id\":744374,\"suggestedTranslation\":\"Wolfgang có thể nâng số lượng gấp đôi đấy!\",\"rating\":9.0},\n  {\"id\":744375,\"suggestedTranslation\":\"Lại đến thời điểm này trong năm rồi sao?\",\"rating\":9.0},\n  {\"id\":744376,\"suggestedTranslation\":\"Ngựa chiến tốt đấy, Wolfgang nghĩ thế.\",\"rating\":9.0},\n  {\"id\":744377,\"suggestedTranslation\":\"Wolfgang không thích tượng biết cử động đâu!!\",\"rating\":9.0},\n  {\"id\":744378,\"suggestedTranslation\":\"Bằng đá thế kia thì chim bay kiểu gì nhỉ?\",\"rating\":9.0},\n  {\"id\":744379,\"suggestedTranslation\":\"Haha! Con thỏ ngốc tưởng nó có thể đánh bại Wolfgang á!\",\"rating\":9.0},\n  {\"id\":744380,\"suggestedTranslation\":\"Mãnh thú mạnh mẽ làm từ khối đá vững chắc!\",\"rating\":9.0},\n  {\"id\":744381,\"suggestedTranslation\":\"Trông hệt như miếng phô mai trên trời ấy!\",\"rating\":9.0},\n  {\"id\":744382,\"suggestedTranslation\":\"Con quái vật tồi tệ làm bằng đá.\",\"rating\":9.0},\n  {\"id\":744383,\"suggestedTranslation\":\"Cô nàng không mặt làm Wolfgang thấy khó chịu.\",\"rating\":9.0},\n  {\"id\":744384,\"suggestedTranslation\":\"Gã đàn ông nhỏ bé đang đội chiếc nón nhỏ xíu kìa!\",\"rating\":9.0},\n  {\"id\":744385,\"suggestedTranslation\":\"Dùng để tập tạ chắc ngon lành đây!\",\"rating\":9.0},\n  {\"id\":744386,\"suggestedTranslation\":\"Trông chẳng giống lâu đài gì đối với Wolfgang cả.\",\"rating\":9.0},\n  {\"id\":744387,\"suggestedTranslation\":\"Wolfgang không thích tượng biết cử động đâu!!\",\"rating\":9.0},\n  {\"id\":744388,\"suggestedTranslation\":\"Wolfgang và chú cá mập biết nói có thể thành bạn thân trong một kiếp sống khác đấy.\",\"rating\":9.0},\n  {\"id\":744389,\"suggestedTranslation\":\"Ha! Wolfgang lực lưỡng hơn cái tượng nhiều.\",\"rating\":9.0},\n  {\"id\":744390,\"suggestedTranslation\":\"Wolfgang đẹp trai hơn con cóc xấu xí này nhiều.\",\"rating\":9.0},\n  {\"id\":744391,\"suggestedTranslation\":\"Hự, vẫn thấy lạnh sống lưng khi nghĩ đến nó.\",\"rating\":9.0},\n  {\"id\":744392,\"suggestedTranslation\":\"Giờ thì nó chỉ còn chút sức mạnh thôi.\",\"rating\":9.0},\n  {\"id\":744393,\"suggestedTranslation\":\"Wolfgang không hiểu cái gì, thế nào... và trên hết là tại sao.\",\"rating\":9.0},\n  {\"id\":744394,\"suggestedTranslation\":\"Gã người máy trông đáng yêu phết.\",\"rating\":9.0},\n  {\"id\":744395,\"suggestedTranslation\":\"Cún con dễ thương đấy, nhưng chết rồi vẫn hơn.\",\"rating\":9.0},\n  {\"id\":744396,\"suggestedTranslation\":\"Wolfgang thà không nhắc đến trải nghiệm với con sâu khổng lồ thì hơn.\",\"rating\":9.0},\n  {\"id\":744397,\"suggestedTranslation\":\"Wolfgang đã đè bẹp cuộc đua của Chuồn Chuồn rồi!\",\"rating\":9.0},\n  {\"id\":744398,\"suggestedTranslation\":\"Chú ngựa chiến cứng cỏi.\",\"rating\":9.0},\n  {\"id\":744399,\"suggestedTranslation\":\"Con sâu đất chẳng có cửa đấu lại Wolfgang đâu.\",\"rating\":9.0},\n  {\"id\":744400,\"suggestedTranslation\":\"Cái hộp kỳ lạ có chân.\",\"rating\":9.0},\n  {\"id\":744401,\"suggestedTranslation\":\"Đó là xương mắt. Xương mắt nối với xương mặt.\",\"rating\":9.0},\n  {\"id\":744402,\"suggestedTranslation\":\"Nó đang ngủ rồi.\",\"rating\":9.0},\n  {\"id\":744403,\"suggestedTranslation\":\"Làm rương to lên à? Hừm, không biết cỗ máy nhỏ này có tác dụng gì với cơ bắp không nhỉ?\",\"rating\":9.0},\n  {\"id\":744404,\"suggestedTranslation\":\"Wolfgang biết cái hộp này quá màu mè để là thật mà!\",\"rating\":9.0},\n  {\"id\":744405,\"suggestedTranslation\":\"Ăn đi, cá ơi! Tốt cho ngươi lắm đấy!\",\"rating\":9.0},\n  {\"id\":744406,\"suggestedTranslation\":\"Gâu, gâu!\",\"rating\":9.0},\n  {\"id\":744407,\"suggestedTranslation\":\"Con chó nhỏ chẳng thèm sủa!\",\"rating\":9.0},\n  {\"id\":744408,\"suggestedTranslation\":\"Chú cún đất bự chảng!\",\"rating\":9.0},\n  {\"id\":744409,\"suggestedTranslation\":\"Là bức tượng đáng sợ.\",\"rating\":9.0},\n  {\"id\":744410,\"suggestedTranslation\":\"Bóng đêm đang đến kìa!\",\"rating\":9.0},\n  {\"id\":744411,\"suggestedTranslation\":\"Tạm biệt thời kỳ tăm tối!\",\"rating\":9.0},\n  {\"id\":744412,\"suggestedTranslation\":\"Lửa cháy dữ dội quá!\",\"rating\":9.0},\n  {\"id\":744413,\"suggestedTranslation\":\"Ngọn lửa không đủ lạnh.\",\"rating\":9.0},\n  {\"id\":744414,\"suggestedTranslation\":\"Ngọn lửa tuyệt vời!\",\"rating\":9.0},\n  {\"id\":744415,\"suggestedTranslation\":\"Ồ ôi. Nó tắt mất rồi.\",\"rating\":9.0},\n  {\"id\":744416,\"suggestedTranslation\":\"Bóng đêm đang đến kìa!\",\"rating\":9.0},\n  {\"id\":744417,\"suggestedTranslation\":\"Tạm biệt thời kỳ tăm tối!\",\"rating\":9.0},\n  {\"id\":744418,\"suggestedTranslation\":\"Lửa cháy dữ dội quá!\",\"rating\":9.0},\n  {\"id\":744419,\"suggestedTranslation\":\"Ngọn lửa không đủ lạnh.\",\"rating\":9.0},\n  {\"id\":744420,\"suggestedTranslation\":\"Ngọn lửa tuyệt vời!\",\"rating\":9.0},\n  {\"id\":744421,\"suggestedTranslation\":\"Ồ ôi. Nó tắt mất rồi.\",\"rating\":9.0},\n  {\"id\":744422,\"suggestedTranslation\":\"Cái rương tội nghiệp. Chắc ăn no quá đây mà.\",\"rating\":9.0},\n  {\"id\":744423,\"suggestedTranslation\":\"Hướng Đông.\",\"rating\":9.0},\n  {\"id\":744424,\"suggestedTranslation\":\"Là tất cả các hướng, nhưng chẳng hướng nào ra hướng nào.\",\"rating\":9.0}\n]",
