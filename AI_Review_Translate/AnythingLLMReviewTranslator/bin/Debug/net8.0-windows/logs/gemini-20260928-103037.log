            "text": "[\n  {\"id\":739873,\"suggestedTranslation\":\"Sắp xong rồi!\",\"rating\":9.0},\n  {\"id\":739874,\"suggestedTranslation\":\"Đợi đã, tôi kéo cậu ra ngay đây!\",\"rating\":9.0},\n  {\"id\":739875,\"suggestedTranslation\":\"Ha! Tóm được rồi!\",\"rating\":9.0},\n  {\"id\":739876,\"suggestedTranslation\":\"Sắp xong rồi!\",\"rating\":9.0},\n  {\"id\":739877,\"suggestedTranslation\":\"Đợi đã, tôi kéo cậu ra ngay đây!\",\"rating\":9.0},\n  {\"id\":739878,\"suggestedTranslation\":\"Ha! Tóm được rồi!\",\"rating\":9.0},\n  {\"id\":739879,\"suggestedTranslation\":\"Sắp xong rồi!\",\"rating\":9.0},\n  {\"id\":739880,\"suggestedTranslation\":\"Đợi đã, tôi kéo cậu ra ngay đây!\",\"rating\":9.0},\n  {\"id\":739881,\"suggestedTranslation\":\"Ha! Tóm được rồi!\",\"rating\":9.0},\n  {\"id\":739882,\"suggestedTranslation\":\"Làm lại từ đầu nào.\",\"rating\":9.0},\n  {\"id\":739883,\"suggestedTranslation\":\"Hừ! Tôi ghét lũ côn trùng!\",\"rating\":9.0},\n  {\"id\":739884,\"suggestedTranslation\":\"Trông cậu không khỏe lắm đâu, anh bạn lớn ạ.\",\"rating\":9.0},\n  {\"id\":739885,\"suggestedTranslation\":\"Lũ kền kền chết tiệt! Ứm, trông chúng hơi lạ đấy.\",\"rating\":9.0},\n  {\"id\":739886,\"suggestedTranslation\":\"Lúc này mà làm thế thì không ổn đâu!\",\"rating\":9.0},\n  {\"id\":739887,\"suggestedTranslation\":\"Nhưng tôi đang gặp nguy hiểm mà!\",\"rating\":9.0},\n  {\"id\":739888,\"suggestedTranslation\":\"Không Két Sắt được đâu.\",\"rating\":8.5},\n  {\"id\":739889,\"suggestedTranslation\":\"Giờ không ngủ được đâu, còn việc phải làm cơ mà!\",\"rating\":9.0},\n  {\"id\":739890,\"suggestedTranslation\":\"Đời nào tôi thèm lăn ra ngủ ở đây chứ.\",\"rating\":9.0},\n  {\"id\":739891,\"suggestedTranslation\":\"Tôi thà đi bắt Con Sâu còn hơn.\",\"rating\":8.5},\n  {\"id\":739892,\"suggestedTranslation\":\"Không ăn tối trước thì đừng hòng ngủ.\",\"rating\":9.0},\n  {\"id\":739893,\"suggestedTranslation\":\"Tôi không mở món quà nào ở đây được đâu.\",\"rating\":9.0},\n  {\"id\":739894,\"suggestedTranslation\":\"Tôi thà ngủ thật sự còn hơn là chợp mắt.\",\"rating\":9.0},\n  {\"id\":739895,\"suggestedTranslation\":\"Ngủ dưới này không phải là ý hay đâu.\",\"rating\":9.0},\n  {\"id\":739896,\"suggestedTranslation\":\"Cậu phải khắc bí ngô xong rồi mới châm lửa chứ.\",\"rating\":9.0},\n  {\"id\":739897,\"suggestedTranslation\":\"Này WX, bớt cái đèn lại được không?\",\"rating\":9.0},\n  {\"id\":739898,\"suggestedTranslation\":\"Thế này là KHÔNG ổn chút nào.\",\"rating\":9.0},\n  {\"id\":739899,\"suggestedTranslation\":\"Ơ. Có Lửa kìa.\",\"rating\":8.5},\n  {\"id\":739901,\"suggestedTranslation\":\"Chuyện đó dễ như ăn kẹo ấy mà.\",\"rating\":9.0},\n  {\"id\":739902,\"suggestedTranslation\":\"Cần cù bù thông minh!\",\"rating\":9.0},\n  {\"id\":739903,\"suggestedTranslation\":\"Chắc tôi phải Chải chuốt lại kỹ thuật của mình thôi.\",\"rating\":8.5},\n  {\"id\":739904,\"suggestedTranslation\":\"Tôi không phải Cái quạt của việc ngồi không đâu...\",\"rating\":8.5},\n  {\"id\":739905,\"suggestedTranslation\":\"Biết đâu tôi chế ra cái gì nhanh hơn được ấy chứ.\",\"rating\":9.0},\n  {\"id\":739906,\"suggestedTranslation\":\"Nào cá ơi, hãy mau ra đây Câu Cá nào!\",\"rating\":8.5},\n  {\"id\":739907,\"suggestedTranslation\":\"Tôi bắt đầu thấy bồn chồn rồi đấy.\",\"rating\":9.0},\n  {\"id\":739908,\"suggestedTranslation\":\"Quân ranh mãnh này!\",\"rating\":9.0},\n  {\"id\":739909,\"suggestedTranslation\":\"Tôi không phải kẻ lười biếng! Đến lúc cuộn dây lại rồi!\",\"rating\":9.0},\n  {\"id\":739910,\"suggestedTranslation\":\"Ồ, con hàng khủng đây rồi!\",\"rating\":9.0},\n  {\"id\":739911,\"suggestedTranslation\":\"Có gì đó sai sai thì phải.\",\"rating\":9.0},\n  {\"id\":739912,\"suggestedTranslation\":\"Có vẻ cái tổ chính là phần chịu lực chính...\",\"rating\":9.0},\n  {\"id\":739913,\"suggestedTranslation\":\"Cái thứ lỏng lẻo này đâu có sinh ra để đi vùng nước sâu!\",\"rating\":9.0},\n  {\"id\":739914,\"suggestedTranslation\":\"Ái chà! Tránh ra xem nào!\",\"rating\":9.0},\n  {\"id\":739915,\"suggestedTranslation\":\"Mấy cái cây này trông có vẻ mờ ám thế nhỉ?\",\"rating\":9.0},\n  {\"id\":739916,\"suggestedTranslation\":\"Phù! Mùi gì mà nặng thế không biết.\",\"rating\":9.0},\n  {\"id\":739917,\"suggestedTranslation\":\"Nghe như có kẻ chuẩn bị chơi khăm công việc của chúng ta đây...\",\"rating\":9.0},\n  {\"id\":739918,\"suggestedTranslation\":\"Để xem chuyện gì sẽ xảy ra nào!\",\"rating\":9.0},\n  {\"id\":739919,\"suggestedTranslation\":\"Đúng là kinh nghiệm làm vườn thực tế đấy!\",\"rating\":9.0},\n  {\"id\":739920,\"suggestedTranslation\":\"Trời ạ, chuyến đi vừa rồi xóc thật đấy...\",\"rating\":9.0},\n  {\"id\":739921,\"suggestedTranslation\":\"Lo mà chuồn lẹ đi!\",\"rating\":9.0},\n  {\"id\":739922,\"suggestedTranslation\":\"Động đất rồi!\",\"rating\":9.0},\n  {\"id\":739923,\"suggestedTranslation\":\"Không, chỗ này không đúng rồi.\",\"rating\":9.0},\n  {\"id\":739924,\"suggestedTranslation\":\"Tiếng sột soạt gì thế nhỉ?\",\"rating\":9.0},\n  {\"id\":739925,\"suggestedTranslation\":\"Con Thỏ đó có gì đó rất đặc biệt!\",\"rating\":8.5},\n  {\"id\":739926,\"suggestedTranslation\":\"Tóm được ngươi rồi, Thỏ nhé!\",\"rating\":8.5},\n  {\"id\":739927,\"suggestedTranslation\":\"Tôi nghe thấy tiếng sinh vật gì đang tới.\",\"rating\":9.0},\n  {\"id\":739928,\"suggestedTranslation\":\"Nó được bảo vệ rồi!\",\"rating\":9.0},\n  {\"id\":739929,\"suggestedTranslation\":\"Tôi có thể chế tạo NHIỀU thứ hơn nữa!\",\"rating\":9.0},\n  {\"id\":739930,\"suggestedTranslation\":\"Tôi quay lại ca trực rồi đây!\",\"rating\":9.0},\n  {\"id\":739931,\"suggestedTranslation\":\"Quay lại làm việc thôi!\",\"rating\":9.0},\n  {\"id\":739932,\"suggestedTranslation\":\"Dậy thôi nào bạn tôi ơi.\",\"rating\":9.0},\n  {\"id\":739933,\"suggestedTranslation\":\"Tóm được em nhé, em gái!\",\"rating\":9.0},\n  {\"id\":739934,\"suggestedTranslation\":\"Charlie đã ở đây.\",\"rating\":9.0},\n  {\"id\":739935,\"suggestedTranslation\":\"Tôi đang bắt được dấu vết ma thuật của nhỏ.\",\"rating\":9.0},\n  {\"id\":739936,\"suggestedTranslation\":\"Điện hạ Hoàng gia!\",\"rating\":9.0},\n  {\"id\":739937,\"suggestedTranslation\":\"Cậu mặc hợp đấy chứ!\",\"rating\":9.0},\n  {\"id\":739938,\"suggestedTranslation\":\"Tôi thích sự tự tin này!\",\"rating\":9.0},\n  {\"id\":739939,\"suggestedTranslation\":\"Một kẻ ngốc hoàng gia! Đùa thôi mà, cưng ơi.\",\"rating\":9.0},\n  {\"id\":739940,\"suggestedTranslation\":\"Cậu mặc hợp quá đấy mất!\",\"rating\":9.0},\n  {\"id\":739941,\"suggestedTranslation\":\"Tôi rất thích sự tự tin này!\",\"rating\":9.0},\n  {\"id\":739942,\"suggestedTranslation\":\"Hả? Lũ quái vật này ở đâu chui ra thế?\",\"rating\":9.0},\n  {\"id\":739943,\"suggestedTranslation\":\"Chắc tôi không đủ tiêu chuẩn rồi.\",\"rating\":9.0},\n  {\"id\":739944,\"suggestedTranslation\":\"Hừ. Chắc tôi xứng đáng đấy chứ.\",\"rating\":9.0},\n  {\"id\":739945,\"suggestedTranslation\":\"Tôi không thể nhét thêm trang nào vào sổ tay lưu niệm được nữa rồi.\",\"rating\":9.0},\n  {\"id\":739946,\"suggestedTranslation\":\"Chào cậu bé bám đuôi nhé!\",\"rating\":9.0},\n  {\"id\":739947,\"suggestedTranslation\":\"Ái! Đừng có lén lút mà ra đấu tay đôi với tôi xem nào!\",\"rating\":9.0},\n  {\"id\":739948,\"suggestedTranslation\":\"Tôi có linh cảm không lành rồi...\",\"rating\":9.0},\n  {\"id\":739949,\"suggestedTranslation\":\"À, đỡ hơn rồi đây.\",\"rating\":9.0},\n  {\"id\":739952,\"suggestedTranslation\":\"Này!\",\"rating\":9.0},\n  {\"id\":739953,\"suggestedTranslation\":\"Thôi ngay cái trò đó đi, được chứ?\",\"rating\":9.0},\n  {\"id\":739954,\"suggestedTranslation\":\"Xung quanh chẳng có tí tuyết nào cả.\",\"rating\":9.0},\n  {\"id\":739955,\"suggestedTranslation\":\"Nó không to lên được nữa đâu.\",\"rating\":9.0},\n  {\"id\":739956,\"suggestedTranslation\":\"Tôi ướt SỦNG rồi!\",\"rating\":9.0},\n  {\"id\":739957,\"suggestedTranslation\":\"Ối! Kinh quá!\",\"rating\":9.0},\n  {\"id\":739958,\"suggestedTranslation\":\"Chào mấy cây nhé! Làm việc chăm chỉ vào chứ?\",\"rating\":9.0},\n  {\"id\":739959,\"suggestedTranslation\":\"Giờ thì lớn nhanh lên đấy, nghe chưa? Tôi không muốn thấy mấy cậu lười biếng đâu!\",\"rating\":9.0},\n  {\"id\":739960,\"suggestedTranslation\":\"Tôi muốn thấy các cậu cố gắng hết sức! Mau lên nào!\",\"rating\":9.0},\n  {\"id\":739961,\"suggestedTranslation\":\"Tôi đến đây để tiếp thêm động lực cho các cậu đấy! Thấy có động lực hơn chưa nào?\",\"rating\":9.0},\n  {\"id\":739962,\"suggestedTranslation\":\"Tôi không hay đứng lê la tán gẫu đâu, nhưng nếu nó giúp các cậu lớn nhanh hơn...\",\"rating\":9.0},\n  {\"id\":739963,\"suggestedTranslation\":\"Ái chà! Đau điếng người!\",\"rating\":9.0},\n  {\"id\":739964,\"suggestedTranslation\":\"Hết nhiên liệu mất tiêu rồi.\",\"rating\":9.0},\n  {\"id\":739965,\"suggestedTranslation\":\"Thôi được rồi, chắc tôi phải tự xoay xở thôi.\",\"rating\":9.0},\n  {\"id\":739966,\"suggestedTranslation\":\"Tội nghiệp bé con. Nó chỉ đang làm nhiệm vụ của mình thôi mà.\",\"rating\":9.0},\n  {\"id\":739967,\"suggestedTranslation\":\"Tôi nghĩ nó muốn tôi đi theo nó đấy.\",\"rating\":9.0},\n  {\"id\":739968,\"suggestedTranslation\":\"Tôi nghĩ có ai đó đã tới chỗ chú mèo con trước chúng ta rồi.\",\"rating\":9.0},\n  {\"id\":739969,\"suggestedTranslation\":\"Có một chú mèo con ở gần đây!\",\"rating\":9.0},\n  {\"id\":739970,\"suggestedTranslation\":\"Hả. Chắc quanh đây chẳng có gì đâu.\",\"rating\":9.0},\n  {\"id\":739971,\"suggestedTranslation\":\"Có vẻ như chúng đang lần theo manh mối gì đó...\",\"rating\":9.0},\n  {\"id\":739972,\"suggestedTranslation\":\"Nó đang đợi tôi kìa, mau bắt kịp nó thôi.\",\"rating\":9.0},\n  {\"id\":739973,\"suggestedTranslation\":\"Con quỷ trơn trượt thật đấy.\",\"rating\":9.0},\n  {\"id\":739974,\"suggestedTranslation\":\"Còn lâu tôi mới để cậu thoát!\",\"rating\":9.0},\n  {\"id\":739975,\"suggestedTranslation\":\"Ý tôi là vậy đấy!\",\"rating\":9.0},\n  {\"id\":739976,\"suggestedTranslation\":\"Có lẽ đây không phải dụng cụ thích hợp cho việc này rồi...\",\"rating\":9.0},\n  {\"id\":739977,\"suggestedTranslation\":\"Tắt ngấm như ngọn đèn.\",\"rating\":9.0},\n  {\"id\":739978,\"suggestedTranslation\":\"Cảm ơn vì đã cho quá giang nhé!\",\"rating\":9.0},\n  {\"id\":739979,\"suggestedTranslation\":\"Hè hè, lỡ tay.\",\"rating\":9.0},\n  {\"id\":739980,\"suggestedTranslation\":\"Ái! Cái đó vẫn cần phải tinh chỉnh thêm!\",\"rating\":9.0},\n  {\"id\":739981,\"suggestedTranslation\":\"Chúng đang giúp à? Chắc tôi hoa mắt rồi.\",\"rating\":9.0},\n  {\"id\":739982,\"suggestedTranslation\":\"Hmm. Đầu này không có gì bất thường cả.\",\"rating\":9.0},\n  {\"id\":739983,\"suggestedTranslation\":\"Chết tiệt. Tôi cực ghét làm việc trong bộ đồ ướt sũng.\",\"rating\":9.0},\n  {\"id\":739984,\"suggestedTranslation\":\"Nó kiệt sức mất rồi.\",\"rating\":9.0},\n  {\"id\":739985,\"suggestedTranslation\":\"Tôi cần thứ gì đó có lực hơn cơ!\",\"rating\":9.0},\n  {\"id\":739986,\"suggestedTranslation\":\"Trọng lượng: {weight}\",\"rating\":9.0},\n  {\"id\":739987,\"suggestedTranslation\":\"Trọng lượng: {weight}\\nTôi vừa câu được một con cá khủng đấy!\",\"rating\":9.0},\n  {\"id\":739990,\"suggestedTranslation\":\"Tôi phải tìm chỗ trú ẩn mới được.\",\"rating\":9.0},\n  {\"id\":739991,\"suggestedTranslation\":\"Thế này thì khó chịu thật đấy.\",\"rating\":9.0},\n  {\"id\":739992,\"suggestedTranslation\":\"Khỉ thật! Trượt mất rồi!\",\"rating\":9.0},\n  {\"id\":739993,\"suggestedTranslation\":\"Hoàn toàn là con số không to đùng.\",\"rating\":9.0},\n  {\"id\":739994,\"suggestedTranslation\":\"Úi! Tôi đang lấp lánh như một Cây Lễ Hội Mùa Đông vậy!\",\"rating\":8.5},\n  {\"id\":739995,\"suggestedTranslation\":\"Này, ai vừa cắt nguồn điện đấy!\",\"rating\":9.0},\n  {\"id\":740003,\"suggestedTranslation\":\"Cái đó sẽ làm adrenaline sục sôi đây!\",\"rating\":9.0},\n  {\"id\":740004,\"suggestedTranslation\":\"Trời ạ. Đi đường vòng hóa ra lại về chỗ cũ.\",\"rating\":9.0},\n  {\"id\":740005,\"suggestedTranslation\":\"Vừa có chấn đ