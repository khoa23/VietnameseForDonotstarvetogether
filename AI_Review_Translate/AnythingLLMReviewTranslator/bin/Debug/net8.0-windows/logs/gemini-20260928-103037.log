            "text": "[\n  {\n    \"id\": 742586,\n    \"suggestedTranslation\": \"Đó là một con xe.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 742587,\n    \"suggestedTranslation\": \"Mọi người chỉ bảo tôi cực kỳ tận tình luôn. Ha!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 742588,\n    \"suggestedTranslation\": \"Đó là một con mã.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 742589,\n    \"suggestedTranslation\": \"Đó là một con mã.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 742590,\n    \"suggestedTranslation\": \"Đâu phải hàng thật.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 742591,\n    \"suggestedTranslation\": \"Một con sâu nhựa bò lổm ngổm.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 742592,\n    \"suggestedTranslation\": \"Tôi ước mình có thêm nhiều điều ước.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 742593,\n    \"suggestedTranslation\": \"Có kẻ nốc mất rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 742594,\n    \"suggestedTranslation\": \"Nhai nhai.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 742595,\n    \"suggestedTranslation\": \"Chẳng đáng để sửa.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 742596,\n    \"suggestedTranslation\": \"Mong là không có ai đang rình mò chúng ta.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 742597,\n    \"suggestedTranslation\": \"Thế này thì sai rồi - phải là sang trái chứ! Ha!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 742598,\n    \"suggestedTranslation\": \"Còn lâu chúng ta mới tóm được Quỷ Lùn. Ha! ...Ồ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 742599,\n    \"suggestedTranslation\": \"Chả biết làm gì với nó nữa. Đang cân nhắc mấy lựa chọn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 742600,\n    \"suggestedTranslation\": \"Không rõ cái này dùng để làm gì.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 742601,\n    \"suggestedTranslation\": \"Đồ chơi nhỏ xinh ghê ha?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 742602,\n    \"suggestedTranslation\": \"C