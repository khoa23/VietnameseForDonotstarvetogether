ating\":9.5},\n  {\"id\":738568,\"suggestedTranslation\":\"Sao cũng được.\",\"rating\":9.0},\n  {\"id\":738569,\"suggestedTranslation\":\"Tuyệt. Giờ thì sao nữa?\",\"rating\":9.0},\n  {\"id\":738570,\"suggestedTranslation\":\"Kaboom!\",\"rating\":9.0},\n  {\"id\":738571,\"suggestedTranslation\":\"Kinh tởm.\",\"rating\":9.0},\n  {\"id\":738572,\"suggestedTranslation\":\"Mong là nó hiệu quả bằng cái mùi thối của nó.\",\"rating\":9.0},\n  {\"id\":738573,\"suggestedTranslation\":\"Ừm, có chuyện đang xảy ra trong đó đấy.\",\"rating\":9.0},\n  {\"id\":738574,\"suggestedTranslation\":\"Trời ạ, lũ cây thực sự thích thứ này á?\",\"rating\":9.0},\n  {\"id\":738575,\"suggestedTranslation\":\"Tao không ưa bộ mặt của mày!\",\"rating\":9.0},\n  {\"id\":738576,\"suggestedTranslation\":\"Cái đó trông hợp để chọc chọc đấy!\",\"rating\":9.0},\n  {\"id\":738577,\"suggestedTranslation\":\"Tôi không muốn dùng cái đó đâu.\",\"rating\":9.0},\n  {\"id\":738578,\"suggestedTranslation\":\"Trông cồng kềnh quá.\",\"rating\":9.0},\n  {\"id\":738579,\"suggestedTranslation\":\"Tôi thích ngọn lửa hơn, nhưng tùy sở thích mỗi người thôi.\",\"rating\":9.0},\n  {\"id\":738580,\"suggestedTranslation\":\"Giật điện vui suýt soát việc đốt đồ đấy.\",\"rating\":9.0},\n  {\"id\":738581,\"suggestedTranslation\":\"Chắc Warly không phiền nếu tôi mượn cái này đâu nhỉ.\",\"rating\":9.0},\n  {\"id\":738582,\"suggestedTranslation\":\"Tôi thích cảm giác nó đốt cháy vòm họng mình.\",\"rating\":9.5},\n  {\"id\":738583,\"suggestedTranslation\":\"Bột hôi thối.\",\"rating\":9.0},\n  {\"id\":738584,\"suggestedTranslation\":\"Mọi người cứ bảo TÔI hay xéo xắt.\",\"rating\":9.0},\n  {\"id\":738585,\"suggestedTranslation\":\"Cứ như đang uống một cục kẹo vậy.\",\"rating\":9.5},\n  {\"id\":738586,\"suggestedTranslation\":\"Ha! Cho mày thấy tay tao nhé!\",\"rating\":9.0},\n  {\"id\":738587,\"suggestedTranslation\":\"Nó thật gớm ghiếc. Tôi nên kết liễu nó.\",\"rating\":9.0},\n  {\"id\":738588,\"suggestedTranslation\":\"Tôi xử đẹp nó được.\",\"rating\":9.0},\n  {\"id\":738589,\"suggestedTranslation\":\"Tạm biệt nhé!\",\"rating\":9.0},\n  {\"id\":738590,\"suggestedTranslation\":\"Có gì mà ghê gớm đâu?\",\"rating\":9.0},\n  {\"id\":738591,\"suggestedTranslation\":\"Ồ tuyệt thật.\",\"rating\":9.0},\n  {\"id\":738592,\"suggestedTranslation\":\"Thật là gớm ghiếc.\",\"rating\":9.0},\n  {\"id\":738593,\"suggestedTranslation\":\"Này Webber, đốt giấy vui hơn vẽ lên đó nhiều!\",\"rating\":9.5},\n  {\"id\":738594,\"suggestedTranslation\":\"Hàng tấn nhện con gớm ghiếc.\",\"rating\":9.0},\n  {\"id\":738595,\"suggestedTranslation\":\"Eeeeew, nó nhớp nhúa và hôi thối!\",\"rating\":9.0},\n  {\"id\":738596,\"suggestedTranslation\":\"Ai là mẹ của các ngươi hả!\",\"rating\":9.0},\n  {\"id\":738597,\"suggestedTranslation\":\"Nó đầy nhện kìa.\",\"rating\":9.0},\n  {\"id\":738598,\"suggestedTranslation\":\"Nó đầy nhện kìa.\",\"rating\":9.0},\n  {\"id\":738599,\"suggestedTranslation\":\"Dùng lửa mà tiêu diệt nó!\",\"rating\":9.5},\n  {\"id\":738600,\"suggestedTranslation\":\"A, ngọn lửa ngọt ngào.\",\"rating\":9.0},\n  {\"id\":738601,\"suggestedTranslation\":\"Tôi bảo cứ châm lửa thiêu ả đi. Cho chắc ăn.\",\"rating\":9.0},\n  {\"id\":738602,\"suggestedTranslation\":\"Đã bảo rồi mà lị.\",\"rating\":9.0},\n  {\"id\":738603,\"suggestedTranslation\":\"Chúng rơi từ trên xuống đấy.\",\"rating\":9.0},\n  {\"id\":738604,\"suggestedTranslation\":\"Ew, thối quá!\",\"rating\":9.0},\n  {\"id\":738605,\"suggestedTranslation\":\"Ewww nó nhầy nhụa toàn nhũn!\",\"rating\":9.0},\n  {\"id\":738606,\"suggestedTranslation\":\"Đúng là một tên khốn phiền phức!\",\"rating\":9.0},\n  {\"id\":738607,\"suggestedTranslation\":\"Chúng ta nên đốt nó đi. Cho chắc ăn ấy mà.\",\"rating\":9.0},\n  {\"id\":738608,\"suggestedTranslation\":\"Tôi CHẮC CHẮN phải đốt cái thứ đó rồi.\",\"rating\":9.0},\n  {\"id\":738609,\"suggestedTranslation\":\"Giờ là thời điểm hoàn hảo để đốt nó.\",\"rating\":9.0},\n  {\"id\":738610,\"suggestedTranslation\":\"Chà, có thể nó không hiệu quả, nhưng ít ra nó làm ra tiếng động!\",\"rating\":9.0},\n  {\"id\":738611,\"suggestedTranslation\":\"Lại đây mau!\",\"rating\":9.0},\n  {\"id\":738612,\"suggestedTranslation\":\"Đáng đời nó lắm.\",\"rating\":9.0},\n  {\"id\":738613,\"suggestedTranslation\":\"Hay là mình tiêu diệt nó... bằng LỬA nhỉ.\",\"rating\":9.5},\n  {\"id\":738614,\"suggestedTranslation\":\"Có lẽ tôi nên mặc kệ con đó thôi.\",\"rating\":9.0},\n  {\"id\":738615,\"suggestedTranslation\":\"Trèo lên bờ mau để tôi đốt ngươi nào!\",\"rating\":9.0},\n  {\"id\":738616,\"suggestedTranslation\":\"Không đời nào, tôi không thèm đưa cái thứ đó lại gần mặt mình đâu.\",\"rating\":9.0},\n  {\"id\":738617,\"suggestedTranslation\":\"Kinh tởm.\",\"rating\":9.0},\n  {\"id\":738618,\"suggestedTranslation\":\"Ít ra nó vẫn dễ bắt lửa.\",\"rating\":9.0},\n  {\"id\":738619,\"suggestedTranslation\":\"Cứ như ngọn lửa đang bay lơ lửng vậy!\",\"rating\":9.5},\n  {\"id\":738620,\"suggestedTranslation\":\"Cảm giác bén lửa phết.\",\"rating\":9.0},\n  {\"id\":738621,\"suggestedTranslation\":\"Được rồi, tôi hiểu ý rồi! Tôi sẽ tránh xa ra!\",\"rating\":9.0},\n  {\"id\":738622,\"suggestedTranslation\":\"Nó chẳng biết mình đang đi đâu cả.\",\"rating\":9.0},\n  {\"id\":738623,\"suggestedTranslation\":\"Cảm giác bén lửa phết.\",\"rating\":9.0},\n  {\"id\":738624,\"suggestedTranslation\":\"Giống như những tia lửa đầy màu sắc!\",\"rating\":9.0},\n  {\"id\":738625,\"suggestedTranslation\":\"Cảm giác bén lửa phết.\",\"rating\":9.0},\n  {\"id\":738626,\"suggestedTranslation\":\"Không gì sánh bằng một cây đuốc tốt cả.\",\"rating\":9.5},\n  {\"id\":738627,\"suggestedTranslation\":\"Hừ! Xì xì!\",\"rating\":9.0},\n  {\"id\":738628,\"suggestedTranslation\":\"Đẹp quá đi!\",\"rating\":9.0},\n  {\"id\":738629,\"suggestedTranslation\":\"Mấy thứ ma thuật này dễ ẹc!\",\"rating\":9.0},\n  {\"id\":738630,\"suggestedTranslation\":\"Lúc nào cũng cuồng phong! Xoáy thẳng về phía hủy diệt!\",\"rating\":9.0},\n  {\"id\":738631,\"sugges