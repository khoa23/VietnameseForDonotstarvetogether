            "text": "[\n  {\"id\":738336,\"suggestedTranslation\":\"Đẹp thật!\",\"rating\":9.0},\n  {\"id\":738337,\"suggestedTranslation\":\"Này! Cậu! Lên đây xem nào!\",\"rating\":9.0},\n  {\"id\":738338,\"suggestedTranslation\":\"Biết đâu nó sẽ mọc lại vào ngày nào đó.\",\"rating\":9.0},\n  {\"id\":738339,\"suggestedTranslation\":\"Cháy đi! Tuyệt vời!\",\"rating\":9.0},\n  {\"id\":738340,\"suggestedTranslation\":\"Một bụi cây sậy có thể bắt lửa.\",\"rating\":9.5},\n  {\"id\":738341,\"suggestedTranslation\":\"Chỉ là mấy gốc sậy thôi.\",\"rating\":9.0},\n  {\"id\":738342,\"suggestedTranslation\":\"Tuyệt. Giờ tôi phải làm gì với đống này đây?\",\"rating\":9.0},\n  {\"id\":738343,\"suggestedTranslation\":\"Áo ghi-lê đang là mốt đấy.\",\"rating\":9.0},\n  {\"id\":738344,\"suggestedTranslation\":\"Đồ đồng nát.\",\"rating\":9.0},\n  {\"id\":738345,\"suggestedTranslation\":\"Giờ thì chẳng học hỏi được gì từ cái đó nữa rồi.\",\"rating\":9.0},\n  {\"id\":738346,\"suggestedTranslation\":\"Đến tôi còn chưa biết hết... mọi thứ đâu.\",\"rating\":9.0},\n  {\"id\":738347,\"suggestedTranslation\":\"Giờ thì chẳng học hỏi được gì từ cái đó nữa rồi.\",\"rating\":9.0},\n  {\"id\":738348,\"suggestedTranslation\":\"Đến tôi còn chưa biết hết... mọi thứ đâu.\",\"rating\":9.0},\n  {\"id\":738349,\"suggestedTranslation\":\"Giờ thì nó tối thui và chẳng còn mấy sức mạnh.\",\"rating\":9.0},\n  {\"id\":738350,\"suggestedTranslation\":\"Một nguồn năng lượng hắc ám và mạnh mẽ tỏa ra từ nó.\",\"rating\":9.0},\n  {\"id\":738351,\"suggestedTranslation\":\"Nhân đôi gian khổ và... ồ. Nó cháy rồi kìa.\",\"rating\":9.0},\n  {\"id\":738352,\"suggestedTranslation\":\"Tôi có thể dùng cái mũ này như một cái vạc!\",\"rating\":9.0},\n  {\"id\":738353,\"suggestedTranslation\":\"Ồ vâng, tôi sắp có khối niềm vui với cái này rồi đây.\",\"rating\":9.0},\n  {\"id\":738354,\"suggestedTranslation\":\"Chính sách bảo hiểm của chúng ta đã bị hủy rồi.\",\"rating\":9.0},\n  {\"id\":738355,\"suggestedTranslation\":\"Đó là chính sách bảo hiểm của chúng ta đấy.\",\"rating\":9.0},\n  {\"id\":738356,\"suggestedTranslation\":\"Tôi sẽ chạm vào nó khi nào tôi thích và sẵn sàng.\",\"rating\":9.0},\n  {\"id\":738357,\"suggestedTranslation\":\"Tôi cứ tưởng nó phải đen hơn cơ.\",\"rating\":9.0},\n  {\"id\":738358,\"suggestedTranslation\":\"Phì. Sao cũng được, hội Tê Giác Lắm Lời.\",\"rating\":9.0},\n  {\"id\":738359,\"suggestedTranslation\":\"Món gì có lửa cũng ngon hơn hết.\",\"rating\":9.5},\n  {\"id\":738360,\"suggestedTranslation\":\"Một chú chim Đỏ. Màu của lửa, nhưng không phải phượng hoàng.\",\"rating\":9.5},\n  {\"id\":738361,\"suggestedTranslation\":\"Ấm áp phết trong túi tôi nè.\",\"rating\":9.0},\n  {\"id\":738362,\"suggestedTranslation\":\"Ngoài này trông lạnh thế nhỉ. Chắc nó thèm lửa lắm đây.\",\"rating\":9.5},\n  {\"id\":738363,\"suggestedTranslation\":\"Trông xù lông yêu thế.\",\"rating\":9.0},\n  {\"id\":738364,\"suggestedTranslation\":\"Ơ, đây thực sự là một mẫu may vá hả?\",\"rating\":9.0},\n  {\"id\":738365,\"suggestedTranslation\":\"Trông chúng sợ chết khiếp luôn.\",\"rating\":9.0},\n  {\"id\":738366,\"suggestedTranslation\":\"Nó kiểu như, một hòn đá tảng ấy.\",\"rating\":9.5},\n  {\"id\":738367,\"suggestedTranslation\":\"Thu thập mấy thứ này để làm gì nữa thế nhỉ?\",\"rating\":9.0},\n  {\"id\":738368,\"suggestedTranslation\":\"Chúng ta hình như chẳng có điểm gì chung cả.\",\"rating\":9.0},\n  {\"id\":738369,\"suggestedTranslation\":\"Nó sẽ không ra trái nữa đâu.\",\"rating\":9.0},\n  {\"id\":738370,\"suggestedTranslation\":\"Đã quá!\",\"rating\":9.0},\n  {\"id\":738371,\"suggestedTranslation\":\"Eo ôi, thối quá!!\",\"rating\":9.0},\n  {\"id\":738372,\"suggestedTranslation\":\"Tôi nghĩ nó sắp đổ bệnh rồi đấy.\",\"rating\":9.0},\n  {\"id\":738373,\"suggestedTranslation\":\"Đó là một loại bụi cây ăn quả nào đó.\",\"rating\":9.0},\n  {\"id\":738374,\"suggestedTranslation\":\"Ai đó đã hái hết quả rồi.\",\"rating\":9.0},\n  {\"id\":738375,\"suggestedTranslation\":\"Phì, ngoài này có nóng mấy đâu chứ.\",\"rating\":9.0},\n  {\"id\":738376,\"suggestedTranslation\":\"Tôi cá là nó sẽ rất ngon khi chín.\",\"rating\":9.0},\n  {\"id\":738377,\"suggestedTranslation\":\"Nó chín rồi kìa!\",\"rating\":9.0},\n  {\"id\":738378,\"suggestedTranslation\":\"Tôi thích ăn nó với một chút lửa.\",\"rating\":9.5},\n  {\"id\":738379,\"suggestedTranslation\":\"Ew, nó có một cánh tay nhỏ kìa.\",\"rating\":9.0},\n  {\"id\":738380,\"suggestedTranslation\":\"Tôi không nghĩ cái này có cách nào cháy được đâu.\",\"rating\":9.0},\n  {\"id\":738381,\"suggestedTranslation\":\"Vô tích sự y như nước từ trước đến nay.\",\"rating\":9.0},\n  {\"id\":738382,\"suggestedTranslation\":\"Vô tích sự y như nước từ trước đến nay.\",\"rating\":9.0},\n  {\"id\":738383,\"suggestedTranslation\":\"Có hơi ấm ở trong đó, chỉ chờ để thoát ra thôi!\",\"rating\":9.0},\n  {\"id\":738384,\"suggestedTranslation\":\"Dung nham đang nguội dần kìa.\",\"rating\":9.0},\n  {\"id\":738385,\"suggestedTranslation\":\"Một hồ lửa!\",\"rating\":9.5},\n  {\"id\":738386,\"suggestedTranslation\":\"Hừm, nó nguội mất rồi.\",\"rating\":9.0},\n  {\"id\":738387,\"suggestedTranslation\":\"Với tôi thì nó cũng chỉ là một hòn đá tảng khác thôi.\",\"rating\":9.5},\n  {\"id\":738388,\"suggestedTranslation\":\"Giờ thì làm sao tôi đốt nó được đây?\",\"rating\":9.0},\n  {\"id\":738389,\"suggestedTranslation\":\"Giờ thì làm sao tôi đốt nó được đây?\",\"rating\":9.0},\n  {\"id\":738390,\"suggestedTranslation\":\"Đúng là một lâu đài!\",\"rating\":9.0},\n  {\"id\":738391,\"suggestedTranslation\":\"Nó có một nụ cười khó ưa.\",\"rating\":9.0},\n  {\"id\":738392,\"suggestedTranslation\":\"Chúng ta nên trói cái gì lại đây??!\",\"rating\":9.0},\n  {\"id\":738393,\"suggestedTranslation\":\"Tôi thà đốt cầu đi còn hơn là xây nó.\",\"rating\":9.0},\n  {\"id\":738394,\"suggestedTranslation\":\"Trông chúng sặc sỡ hoa hòe hơn phong cách thường ngày của Winona nhiều.\",\"rating\":9.0},\n  {\"id\":738396,\"suggestedTranslation\":\"Eo ôi! Sao cơ chứ? Ồ sao lại thế cơ chứ?!\",\"rating\":9.0},\n  {\"id\":738397,\"suggestedTranslation\":\"Ngọt quá đi!\",\"rating\":9.0},\n  {\"id\":738398,\"suggestedTranslation\":\"Đồ đạc bị hỏng.\",\"rating\":9.0},\n  {\"id\":738399,\"suggestedTranslation\":\"Dường như có cái gì đó đang tuôn chảy bên trong nó.\",\"rating\":9.0},\n  {\"id\":738400,\"suggestedTranslation\":\"Cái này sẽ giữ đám rắc rối ở xa.\",\"rating\":9.0},\n  {\"id\":738401,\"suggestedTranslation\":\"Cái đó chắc là sửa lại được đấy.\",\"rating\":9.0},\n  {\"id\":738402,\"suggestedTranslation\":\"Một chiếc rương rất rất cũ.\",\"rating\":9.5},\n  {\"id\":738403,\"suggestedTranslation\":\"Tôi nghĩ nó đang phán xét tôi đấy.\",\"rating\":9.0},\n  {\"id\":738404,\"suggestedTranslation\":\"Tôi cá là bên dưới yên cưỡi thối lắm đây.\",\"rating\":9.5},\n  {\"id\":738405,\"suggestedTranslation\":\"Nó khó chịu quá mức.\",\"rating\":9.0},\n  {\"id\":738406,\"suggestedTranslation\":\"Có đáng không á? Tôi nghĩ là đáng đấy.\",\"rating\":9.0},\n  {\"id\":738407,\"suggestedTranslation\":\"Tôi có thể bắn một hoặc hai mũi tiêu lửa từ đó.\",\"rating\":9.5},\n  {\"id\":738408,\"suggestedTranslation\":\"Tôi sắp san bằng vài ngôi làng đây!\",\"rating\":9.0},\n  {\"id\":738409,\"suggestedTranslation\":\"Thử nghĩ xem tôi trông ngầu thế nào khi cưỡi cái đó xông vào trận chiến chứ!\",\"rating\":9.0},\n  {\"id\":738410,\"suggestedTranslation\":\"Này, món này ngon tuyệt!\",\"rating\":9.0},\n  {\"id\":738411,\"suggestedTranslation\":\"Nó sẽ giữ cho đồ đạc của tôi không bị thối, trong một thời gian ngắn.\",\"rating\":9.0},\n  {\"id\":738412,\"suggestedTranslation\":\"Đó là một cục muối to đầy nước dãi.\",\"rating\":9.5},\n  {\"id\":738413,\"suggestedTranslation\":\"Tôi mừng vì mình không phải là một con bò lai.\",\"rating\":9.5},\n  {\"id\":738414,\"suggestedTranslation\":\"Tự hỏi không biết nó có dễ bén lửa không nhỉ.\",\"rating\":9.0},\n  {\"id\":738415,\"suggestedTranslation\":\"Hừm. Lạ thật đấy...\",\"rating\":9.0},\n  {\"id\":738416,\"suggestedTranslation\":\"Được rồi, nghe tôi nói này... thế nếu tôi thử đốt nó thì sao nhỉ?\",\"rating\":9.0},\n  {\"id\":738417,\"suggestedTranslation\":\"Ai đó đã lấy hết muối rồi.\",\"rating\":9.5},\n  {\"id\":738418,\"suggestedTranslation\":\"Thôi được rồi, cậu cũng đáng yêu phết đấy.\",\"rating\":9.0},\n  {\"id\":738419,\"suggestedTranslation\":\"Đó là lông thật à?\",\"rating\":9.0},\n  {\"id\":738420,\"suggestedTranslation\":\"Cháaaay đi!\",\"rating\":9.0},\n  {\"id\":738421,\"suggestedTranslation\":\"Đốt nó đi!\",\"rating\":9.0},\n  {\"id\":738422,\"suggestedTranslation\":\"Tự hỏi mấy ký hiệu này có nghĩa gì nhỉ.\",\"rating\":9.0},\n  {\"id\":738423,\"suggestedTranslation\":\"Nó biến đi đâu mất rồi?\",\"rating\":9.0},\n  {\"id\":738424,\"suggestedTranslation\":\"Cháy! Đúng rồi!\",\"rating\":9.0},\n  {\"id\":738425,\"suggestedTranslation\":\"Đốt kẻ ốm đi!\",\"rating\":9.0},\n  {\"id\":738426,\"suggestedTranslation\":\"Kéch. Cậu thối quá đấy.\",\"rating\":9.0},\n  {\"id\":738427,\"suggestedTranslation\":\"Cũng đáng để hái cái đó đấy.\",\"rating\":9.0},\n  {\"id\":738428,\"suggestedTranslation\":\"Cái cây nhỏ rũ rượi đáng thương.\",\"rating\":9.0},\n  {\"id\":738429,\"suggestedTranslation\":\"Nó khô quá, cứ như là MUỐN bắt lửa vậy.\",\"rating\":9.5},\n  {\"id\":738430,\"suggestedTranslation\":\"Trông giống mấy thứ khoa học ngớ ngẩn dành cho mọt sách.\",\"rating\":9.0},\n  {\"id\":738431,\"suggestedTranslation\":\"Đó là một người rơm đang cháy.\",\"rating\":9.0},\n  {\"id\":738432,\"suggestedTranslation\":\"Chỉ là rơm cháy thôi.\",\"rating\":9.0},\n  {\"id\":738433,\"suggestedTranslation\":\"Ha! Nó tưởng nó là người thật đấy!\",\"rating\":9.0},\n  {\"id\":738434,\"suggestedTranslation\":\"Eoiiiiiiiiiii!\",\"rating\":9.0},\n  {\"id\":738435,\"suggestedTranslation\":\"Thêm một trang cho nguồn bùi nhùi khẩn cấp - ý tôi là sổ lưu niệm.\",\"rating\":9.0},\n  {\"id\":738436,\"suggestedTranslation\":\"Heh. Tôi thích nó!\",\"rating\":9.0},\n  {\"id\":738437,\"suggestedTranslation\":\"Bộ tôi chuẩn bị mở miệng nói mấy từ như \\\"khá là\\\" với \\\"chắc chắn\\\" hả?\",\"rating\":9.0},\n  {\"id\":738438,\"suggestedTranslation\":\"Tôi chuẩn bị tạc một cái mông bằng đá đây.\",\"rating\":9.0},\n  {\"id\":738439,\"suggestedTranslation\":\"Haha!\",\"rating\":9.0},\n  {\"id\":738440,\"suggestedTranslation\":\"Hừm... Tôi có thể làm những thứ KHÔNG cháy được không nhỉ?\",\"rating\":9.0},\n  {\"id\":738441,\"suggestedTranslation\":\"Tôi đoán cái đó cũng được đấy chứ.\",\"rating\":9.0},\n  {\"id\":738442,\"suggestedTranslation\":\"Không cháy được. Không quan tâm.\",\"rating\":9.0},\n  {\"id\":738443,\"suggestedTranslation\":\"Humpty Dumpty đã được lắp lại với nhau rồi.\",\"rating\":9.0},\n  {\"id\":738444,\"suggestedTranslation\":\"Ew! Nó đang nguây nguẩy kìa!\",\"rating\":9.0},\n  {\"id\":738445,\"suggestedTranslation\":\"Cái tay quay thậm chí còn chẳng quay nổi!\",\"rating\":9.0},\n  {\"id\":738446,\"suggestedTranslation\":\"Kinh quá. Tôi không nghĩ cái đó tháo ra được đâu.\",\"rating\":9.0},\n  {\"id\":738447,\"suggestedTranslation\":\"Tôi đoán đó là một bức tượng đá cẩm thạch.\",\"rating\":9.5},\n  {\"id\":738448,\"suggestedTranslation\":\"Hắn thậm chí còn chẳng thèm nói \\\"cảm ơn\\\".\",\"rating\":9.0},\n  {\"id\":738449,\"suggestedTranslation\":\"Ew! Nó đang nguây nguẩy kìa!\",\"rating\":9.0},\n  {\"id\":738450,\"suggestedTranslation\":\"Cái thứ đó trông tệ hại thật.\",\"rating\":9.0},\n  {\"id\":738451,\"suggestedTranslation\":\"Tuyệt, giờ chúng ta đã chọc giận một tên trùm tội phạm bằng đá cẩm thạch rồi!\",\"rating\":9.5},\n  {\"id\":738452,\"suggestedTranslation\":\"Trông giống một đống đổ nát với tôi.\",\"rating\":9.0},\n  {\"id\":738453,\"suggestedTranslation\":\"Tôi quen phá hoại hơn là sửa chữa chúng.\",\"rating\":9.0},\n  {\"id\":738454,\"suggestedTranslation\":\"Ew! Nó đang nguây nguẩy kìa!\",\"rating\":9.0},\n  {\"id\":738455,\"suggestedTranslation\":\"Đúng là một đống đồ nát rợn người!\",\"rating\":9.0},\n  {\"id\":738456,\"suggestedTranslation\":\"Ha, vỡ vụn ra rồi kìa. Lỗi cơ bản của lính mới.\",\"rating\":9.0},\n  {\"id\":738457,\"suggestedTranslation\":\"Heh heh. Ôi nhầm.\",\"rating\":9.0},\n  {\"id\":738458,\"suggestedTranslation\":\"Mấy thứ mọt sách dính nước.\",\"rating\":9.0},\n  {\"id\":738459,\"suggestedTranslation\":\"Ew, cái quái gì THẾ NÀY?\",\"rating\":9.0},\n  {\"id\":738460,\"suggestedTranslation\":\"Đó chỉ là một hòn đá biển to tẻ nhạt.\",\"rating\":9.5},\n  {\"id\":738461,\"suggestedTranslation\":\"Nó trống rỗng. Thì sao chứ?\",\"rating\":9.0},\n  {\"id\":738462,\"suggestedTranslation\":\"Tuyệt, nó phát sáng kìa. Nhưng nó có cháy không?\",\"rating\":9.0},\n  {\"id\":738463,\"suggestedTranslation\":\"Sẽ dễ dàng hơn nếu châm lửa đốt hết đám hạt giống.\",\"rating\":9.5},\n  {\"id\":738464,\"suggestedTranslation\":\"Làm ruộng chán ngắt.\",\"rating\":9.0},\n  {\"id\":738465,\"suggestedTranslation\":\"Giờ thì chẳng dùng để làm ruộng được nữa rồi.\",\"rating\":9.0},\n  {\"id\":738466,\"suggestedTranslation\":\"Phì. Nó cũng sẽ cháy như mấy thứ khác thôi.\",\"rating\":9.0},\n  {\"id\":738467,\"suggestedTranslation\":\"Nhưng sự hủy diệt vui hơn nhiều chứ!\",\"rating\":9.0},\n  {\"id\":738468,\"suggestedTranslation\":\"Cá nhân tôi thấy nó trông đẹp hơn đấy.\",\"rating\":9.0},\n  {\"id\":738469,\"suggestedTranslation\":\"Này, cầm giúp tôi đống đồ này cái được không?\",\"rating\":9.0},\n  {\"id\":738470,\"suggestedTranslation\":\"Ít ra cũng có thứ quanh đây giữ cho nó không rời ra.\",\"rating\":9.0},\n  {\"id\":738471,\"suggestedTranslation\":\"Ừm, đúng là nguyên liệu ác mộng tinh khiết.\",\"rating\":9.5},\n  {\"id\":738472,\"suggestedTranslation\":\"Ew, nó còn rợn tóc gáy hơn cả bản chính.\",\"rating\":9.0},\n  {\"id\":738473,\"suggestedTranslation\":\"Ồ, kinh quá! Ai mà thèm chạm vào cái đó cơ chứ?!\",\"rating\":9.0},\n  {\"id\":738474,\"suggestedTranslation\":\"Không. Đừng có bén mảng đến gần cái đó.\",\"rating\":9.0},\n  {\"id\":738475,\"suggestedTranslation\":\"Cái thứ này dài vô tận luôn!\",\"rating\":9.0},\n  {\"id\":738476,\"suggestedTranslation\":\"Ha! Vụng về quá!\",\"rating\":9.0},\n  {\"id\":738477,\"suggestedTranslation\":\"Ngươi đang nhìn cái gì hả?\",\"rating\":9.0},\n  {\"id\":738478,\"suggestedTranslation\":\"Cái gì có hai tay mà không có chân? Bất cứ thứ gì đó là.\",\"rating\":9.0},\n  {\"id\":738479,\"suggestedTranslation\":\"Biến đi chỗ khác gặm nhấm đi!\",\"rating\":9.0},\n  {\"id\":738480,\"suggestedTranslation\":\"Không hiểu sao tôi không tài nào tin nổi nụ cười đó.\",\"rating\":9.0},\n  {\"id\":738481,\"suggestedTranslation\":\"Cho nó làm mồi cho ngọn lửa đi!\",\"rating\":9.0},\n  {\"id\":738482,\"suggestedTranslation\":\"Ngươi không dọa được tôi đâu! Thôi được, hơi sợ chút đấy.\",\"rating\":9.0},\n  {\"id\":738483,\"suggestedTranslation\":\"Gớm ghiếc. Tôi thích đấy.\",\"rating\":9.0},\n  {\"id\":738484,\"suggestedTranslation\":\"Tự hỏi liệu nó có nhớ cách nó chết không nhỉ.\",\"rating\":9.0},\n  {\"id\":738485,\"suggestedTranslation\":\"Được rồi, làm cho nó dị đi nào!\",\"rating\":9.0},\n  {\"id\":738486,\"suggestedTranslation\":\"Tôi phải tự tay lắp ráp nó á?\",\"rating\":9.0},\n  {\"id\":738487,\"suggestedTranslation\":\"Ghê tởm quá! Tôi không quan tâm trong đó có gì đâu!\",\"rating\":9.0},\n  {\"id\":738488,\"suggestedTranslation\":\"Lẽ ra nên hỏa táng họ.\",\"rating\":9.0},\n  {\"id\":738489,\"suggestedTranslation\":\"Uhh... chú cá xinh đẹp?\",\"rating\":9.0},\n  {\"id\":738490,\"suggestedTranslation\":\"Lửa lúc nào cũng đánh bại băng đá cả.\",\"rating\":9.5},\n  {\"id\":738491,\"suggestedTranslation\":\"Mấy cái gai này là sao thế? Ai đó có thể bị mù mắt đấy.\",\"rating\":9.0},\n  {\"id\":738492,\"suggestedTranslation\":\"Chỉ là một đám vỏ sò thôi.\",\"rating\":9.0},\n  {\"id\":738493,\"suggestedTranslation\":\"Ít ra thì trên đó không dính ghèn mắt.\",\"rating\":9.0},\n  {\"id\":738494,\"suggestedTranslation\":\"Không hợp để chiến đấu cho lắm.\",\"rating\":9.0},\n  {\"id\":738495,\"suggestedTranslation\":\"Được rồi, đến lúc đi tìm vài thứ để đào lên thôi!\",\"rating\":9.0},\n  {\"id\":738496,\"suggestedTranslation\":\"Tôi thách ai dám thử đấy.\",\"rating\":9.0},\n  {\"id\":738497,\"suggestedTranslation\":\"Bánh ngọt thì cứ đưa đây.\",\"rating\":9.0},\n  {\"id\":738498,\"suggestedTranslation\":\"Ew! Đốt cái đó đi!\",\"rating\":9.0},\n  {\"id\":738499,\"suggestedTranslation\":\"Tôi luôn châm lửa đốt chúng.\",\"rating\":9.5},\n  {\"id\":738500,\"suggestedTranslation\":\"Họ dạy chúng tôi cách làm mấy cái này trong hội Hướng đạo sinh đấy.\",\"rating\":9.0},\n  {\"id\":738501,\"suggestedTranslation\":\"Mmmmmm. Mịn màng.\",\"rating\":9.0},\n  {\"id\":738502,\"suggestedTranslation\":\"Ew, nó đang phát ra tiếng kìa!\",\"rating\":9.0},\n  {\"id\":738503,\"suggestedTranslation\":\"Mấy thứ đó làm tôi phát hoảng.\",\"rating\":9.0},\n  {\"id\":738504,\"suggestedTranslation\":\"Không. Cảm ơn nhé.\",\"rating\":9.0},\n  {\"id\":738505,\"suggestedTranslation\":\"Làm giàn hỏa thiêu thì vui hơn rồi.\",\"rating\":9.0},\n  {\"id\":738506,\"suggestedTranslation\":\"Tôi đoán nó cũng hơi đẹp đấy...\",\"rating\":9.0},\n  {\"id\":738507,\"suggestedTranslation\":\"Ồn ào quá.\",\"rating\":9.0},\n  {\"id\":738508,\"suggestedTranslation\":\"Chúng làm tôi phát điên mất.\",\"rating\":9.0},\n  {\"id\":738509,\"suggestedTranslation\":\"Cậu làm sai rồi đấy, mấy bông hoa đó chưa đủ khô để cháy đâu!\",\"rating\":9.0},\n  {\"id\":738510,\"suggestedTranslation\":\"Tôi hi vọng ít ra anh cũng ra đi trong một hào quang rực rỡ.\",\"rating\":9.0},\n  {\"id\":738511,\"suggestedTranslation\":\"Nhìn vào nó thôi là tôi thấy nhức đầu rồi.\",\"rating\":9.0},\n  {\"id\":738512,\"suggestedTranslation\":\"Gớm ghiếc! Ai lại bỏ lại bộ xương cũ bốc mùi ở đây thế?\",\"rating\":9.5},\n  {\"id\":738513,\"suggestedTranslation\":\"Ngọn lửa cuộc đời của %s đã bị dập tắt bởi %s.\",\"rating\":9.5},\n  {\"id\":738514,\"suggestedTranslation\":\"Ngọn lửa cuộc đời của %s đã bị dập tắt bởi %s.\",\"rating\":9.5},\n  {\"id\":738515,\"suggestedTrans