            "text": "[\n  {\"id\":748992,\"suggestedTranslation\":\"Mấy con mắt đó đã chứng kiến nhiều thứ rồi đấy.\",\"rating\":9.0},\n  {\"id\":748993,\"suggestedTranslation\":\"Mấy tên này không biết từ bỏ là gì đâu.\",\"rating\":9.0},\n  {\"id\":748994,\"suggestedTranslation\":\"Không biết có vừa với bộ râu quý phái của tôi không đây.\",\"rating\":9.0},\n  {\"id\":748995,\"suggestedTranslation\":\"Kỳ diệu thay, giờ nó lại càng bốc mùi hơn.\",\"rating\":9.0},\n  {\"id\":748996,\"suggestedTranslation\":\"Ngửi như một chiếc tàu đánh cá nhà xưởng ấy.\",\"rating\":9.0},\n  {\"id\":748997,\"suggestedTranslation\":\"Đến một cái nhà chống cháy cũng không xây nổi.\",\"rating\":9.0},\n  {\"id\":748998,\"suggestedTranslation\":\"Chúng chẳng khéo léo gì cho cam.\",\"rating\":9.0},\n  {\"id\":748999,\"suggestedTranslation\":\"Thật là đáng tiếc.\",\"rating\":9.0},\n  {\"id\":749000,\"suggestedTranslation\":\"Làm ta nhớ đến ngôi nhà đầu tiên chúng ta xây, phải không Lucy?\",\"rating\":9.0},\n  {\"id\":749001,\"suggestedTranslation\":\"Hắn có một bộ râu khá ấn tượng đấy.\",\"rating\":9.0},\n  {\"id\":749002,\"suggestedTranslation\":\"Xin lỗi vì cái ngai vàng của ông nhé.\",\"rating\":9.0},\n  {\"id\":749003,\"suggestedTranslation\":\"Bản thân tôi đến từ Thịnh vượng chung mà.\",\"rating\":9.0},\n  {\"id\":749004,\"suggestedTranslation\":\"Mọi thứ cháy rụi hết cả rồi nhỉ?\",\"rating\":9.0},\n  {\"id\":749005,\"suggestedTranslation\":\"Trông cậu có vẻ đã kiểm soát được tình hình rồi đấy.\",\"rating\":9.0},\n  {\"id\":749006,\"suggestedTranslation\":\"Cảm giác như chúng đang chờ đợi thứ gì đó.\",\"rating\":9.0},\n  {\"id\":749007,\"suggestedTranslation\":\"Trông chúng có vẻ vui vẻ nhỉ?\",\"rating\":9.0},\n  {\"id\":749008,\"suggestedTranslation\":\"Chúng ta không được chào đón ở đây đâu, Luce.\",\"rating\":9.0},\n  {\"id\":749009,\"suggestedTranslation\":\"Chúng ta không được chào đón ở đây đâu, Luce.\",\"rating\":9.0},\n  {\"id\":749010,\"suggestedTranslation\":\"Cái quái gì đang xảy ra với mấy cậu vậy?\",\"rating\":9.0},\n  {\"id\":749011,\"suggestedTranslation\":\"Tên này thực sự là kẻ giỏi nhất mà các cậu có thôi sao?\",\"rating\":9.0},\n  {\"id\":749012,\"suggestedTranslation\":\"Con Người Cá nhỏ đó thực sự đã vắt kiệt sức cậu đấy nhỉ?\",\"rating\":9.0},\n  {\"id\":749013,\"suggestedTranslation\":\"Thôi nào, Luce. Hãy nhẹ nhàng thôi.\",\"rating\":9.0},\n  {\"id\":749014,\"suggestedTranslation\":\"Trông giống như nơi mấy kẻ có vảy cất giữ dụng cụ của chúng.\",\"rating\":9.0},\n  {\"id\":749015,\"suggestedTranslation\":\"Trông giống như nơi mấy kẻ có vảy cất giữ dụng cụ của chúng.\",\"rating\":9.0},\n  {\"id\":749016,\"suggestedTranslation\":\"Tốt hơn rồi, nhưng sao lúc nào cũng nhớp nháp thế này?\",\"rating\":9.0},\n  {\"id\":749017,\"suggestedTranslation\":\"Chắc chắn là tuyệt hơn một chiếc máy bay giấy rồi.\",\"rating\":9.0},\n  {\"id\":749018,\"suggestedTranslation\":\"Ước gì nó được lấp đầy bằng xi -rô phong...\",\"rating\":9.0},\n  {\"id\":749019,\"suggestedTranslation\":\"Ồ, tiếc thật đấy nhỉ?\",\"rating\":9.0},\n  {\"id\":749020,\"suggestedTranslation\":\"Thì ra đống ván ép xịn của tôi đã đi về đâu!!\",\"rating\":9.0},\n  {\"id\":749021,\"suggestedTranslation\":\"Ồ... ừm... tôi có nhất thiết phải chạm vào nó không?\",\"rating\":9.0},\n  {\"id\":749022,\"suggestedTranslation\":\"Sâu thẳm trong một mỏ than.\",\"rating\":9.0},\n  {\"id\":749023,\"suggestedTranslation\":\"Chiếu sáng đường đi nào, chiếc đèn lồng nhỏ!\",\"rating\":9.0},\n  {\"id\":749024,\"suggestedTranslation\":\"Tôi không được sử dụng với cái nóng ở nơi này!\",\"rating\":9.0},\n  {\"id\":749025,\"suggestedTranslation\":\"Chỉ cần châm lửa là được.\",\"rating\":9.0},\n  {\"id\":749026,\"suggestedTranslation\":\"Có thứ gì mà gỗ không làm được không nhỉ?\",\"rating\":9.0},\n  {\"id\":749027,\"suggestedTranslation\":\"Cái gì thế này... một loại bảng hiệu nào đó à?\",\"rating\":9.0},\n  {\"id\":749028,\"suggestedTranslation\":\"Gỗ tốt, chắc chắn.\",\"rating\":9.0},\n  {\"id\":749029,\"suggestedTranslation\":\"Lại một linh hồn tội nghiệp mang lờinh nguyền.\",\"rating\":9.0},\n  {\"id\":749030,\"suggestedTranslation\":\"Đó là một chiếc rương có sừng khá đẹp đấy chứ.\",\"rating\":9.0},\n  {\"id\":749031,\"suggestedTranslation\":\"Đó là một chiếc sừng đẹp đấy.\",\"rating\":9.0},\n  {\"id\":749032,\"suggestedTranslation\":\"Lạnh như băng đá / gai băng.\",\"rating\":9.0},\n  {\"id\":749033,\"suggestedTranslation\":\"Ấm áp dễ chịu phết. Nhưng không hẳn là thứ tôi muốn ôm ấp đâu.\",\"rating\":9.0},\n  {\"id\":749034,\"suggestedTranslation\":\"Ơ... biết sao không, tôi hết thấy đói rồi.\",\"rating\":9.0},\n  {\"id\":749035,\"suggestedTranslation\":\"Nó cảm nhận về cục đá giống như cách tôi cảm nhận về cây cối vậy.\",\"rating\":9.0},\n  {\"id\":749036,\"suggestedTranslation\":\"Muốn ăn cục đá nào không?\",\"rating\":9.0},\n  {\"id\":749037,\"suggestedTranslation\":\"Đào, đào, đào nào.\",\"rating\":9.0},\n  {\"id\":749038,\"suggestedTranslation\":\"Cứ lo chuyện của mình đi nhé, hiểu chứ?\",\"rating\":9.0},\n  {\"id\":749039,\"suggestedTranslation\":\"Trông cũng ấm cúng phết.\",\"rating\":9.0},\n  {\"id\":749040,\"suggestedTranslation\":\"Giờ đây đã có thêm tính năng chặt cây ban đêm!\",\"rating\":9.0},\n  {\"id\":749041,\"suggestedTranslation\":\"Tôi cá là bên trong toàn là một đống cục đá.\",\"rating\":9.0},\n  {\"id\":749042,\"suggestedTranslation\":\"Thôi nào. Cái này mới mẻ đấy.\",\"rating\":9.0},\n  {\"id\":749043,\"suggestedTranslation\":\"Quả là một lựa chọn vật liệu xây dựng tuyệt vời.\",\"rating\":9.0},\n  {\"id\":749044,\"suggestedTranslation\":\"Ơ... có lẽ sống trên cây không tuyệt vời như người ta tưởng đâu.\",\"rating\":9.0},\n  {\"id\":749045,\"suggestedTranslation\":\"Hừm. Không biết sống trên cây thì sẽ như thế nào nhỉ.\",\"rating\":9.0},\n  {\"id\":749046,\"suggestedTranslation\":\"Cái đó không bình thường chút nào.\",\"rating\":9.0},\n  {\"id\":749047,\"suggestedTranslation\":\"Mấy con khỉ đã để lại cái này ở đây à?\",\"rating\":9.0},\n  {\"id\":749048,\"suggestedTranslation\":\"Cây giả á? Thật chẳng ra sao cả.\",\"rating\":9.0},\n  {\"id\":749049,\"suggestedTranslation\":\"Trông cô ta không giống người ở mặt sau đồng loonie cho lắm.\",\"rating\":9.0},\n  {\"id\":749050,\"suggestedTranslation\":\"Chúng hơi giống cây đuôi mèo nhưng lại... không phải.\",\"rating\":9.0},\n  {\"id\":749051,\"suggestedTranslation\":\"Nếu một con khỉ làm được, thì tôi cũng làm được, phải không?\",\"rating\":9.0},\n  {\"id\":749052,\"suggestedTranslation\":\"Tôi thực sự hy vọng không có con bọ chét nào trong đó.\",\"rating\":9.0},\n  {\"id\":749053,\"suggestedTranslation\":\"Đây là thức ăn cho mèo mà!\",\"rating\":9.0},\n  {\"id\":749054,\"suggestedTranslation\":\"Tôi chưa đói đến mức phải ăn cái đó đâu.\",\"rating\":9.0},\n  {\"id\":749055,\"suggestedTranslation\":\"Tôi vẫn không muốn ăn nó đâu.\",\"rating\":9.0},\n  {\"id\":749056,\"suggestedTranslation\":\"Không còn gì khác để ăn nữa sao?\",\"rating\":9.0},\n  {\"id\":749057,\"suggestedTranslation\":\"Cái đó cần nhiều hơn một cuộn băng dính để sửa đấy.\",\"rating\":9.0},\n  {\"id\":749058,\"suggestedTranslation\":\"Tôi tốt nhất không nên táy máy vào thứ đó nếu có thể.\",\"rating\":9.0},\n  {\"id\":749059,\"suggestedTranslation\":\"Thế này chắc sẽ giúp chúng ta mát mẻ đây.\",\"rating\":9.0},\n  {\"id\":749060,\"suggestedTranslation\":\"Tôi cứ để nó ở đấy tạm thời vậy, thế cũng vui rồi.\",\"rating\":9.0},\n  {\"id\":749061,\"suggestedTranslation\":\"Trông có vẻ hơi lạ lẫm.\",\"rating\":9.0},\n  {\"id\":749062,\"suggestedTranslation\":\"Bụi tiên làm mũi tôi nhột quá.\",\"rating\":9.0},\n  {\"id\":749063,\"suggestedTranslation\":\"Tôi thực sự rất thích thiên nhiên.\",\"rating\":9.0},\n  {\"id\":749064,\"suggestedTranslation\":\"Những chiếc cánh bướm đẹp mắt.\",\"rating\":9.0},\n  {\"id\":749065,\"suggestedTranslation\":\"Chào mừng đến với thế giới.\",\"rating\":9.0},\n  {\"id\":749066,\"suggestedTranslation\":\"Chúng ta đã thoát khỏi tầm với của mặt trăng ở dưới này rồi.\",\"rating\":9.0},\n  {\"id\":749067,\"suggestedTranslation\":\"Tôi có thực sự cần phải bị nhắc nhở về mặt trăng vào ban ngày không nhỉ?\",\"rating\":9.0},\n  {\"id\":749068,\"suggestedTranslation\":\"Đợi đã, tôi không nghĩ đó là băng đá / gai băng đâu...\",\"rating\":9.0},\n  {\"id\":749069,\"suggestedTranslation\":\"Không phải là một đêm tốt lành gì để dính lời nguyền, nhưng mà có lúc nào là tốt đâu cơ chứ?\",\"rating\":9.0},\n  {\"id\":749070,\"suggestedTranslation\":\"Mặt trăng đã biến mất rồi. Phù.\",\"rating\":9.0},\n  {\"id\":749071,\"suggestedTranslation\":\"Mặt trăng đang khuyết dần. Đã đến lúc tận hưởng sự bình yên và tĩnh lặng.\",\"rating\":9.0},\n  {\"id\":749072,\"suggestedTranslation\":\"Mặt trăng lại đang tròn dần lên rồi.\",\"rating\":9.0},\n  {\"id\":749073,\"suggestedTranslation\":\"Lại sắp đến lúc rồi đấy, Lucy.\",\"rating\":9.0},\n  {\"id\":749074,\"suggestedTranslation\":\"Nó có màu xanh lá, giống như một chiếc lá đẹp vậy.\",\"rating\":9.0},\n  {\"id\":749075,\"suggestedTranslation\":\"Vẫn không tốt bằng Lucy được.\",\"rating\":9.0},\n  {\"id\":749076,\"suggestedTranslation\":\"Những mảnh này vẫn còn đang phát sáng đấy.\",\"rating\":9.0},\n  {\"id\":749077,\"suggestedTranslation\":\"Đó là một cục vật chất mặt trăng lớn.\",\"rating\":9.0},\n  {\"id\":749078,\"suggestedTranslation\":\"Trông cũng ấm cúng phết.\",\"rating\":9.0},\n  {\"id\":749079,\"suggestedTranslation\":\"Tôi nghĩ nó đang thiếu thứ gì đó.\",\"rating\":9.0},\n  {\"id\":749080,\"suggestedTranslation\":\"Trông có vẻ hơi điên rồ nhỉ.\",\"rating\":9.0},\n  {\"id\":749081,\"suggestedTranslation\":\"Nó là, ừm, một hòn đá mặt trăng.\",\"rating\":9.0},\n  {\"id\":749082,\"suggestedTranslation\":\"Chắc tôi nên đặt cái này xuống đâu đó thôi, nhỉ?\",\"rating\":9.0},\n  {\"id\":749083,\"suggestedTranslation\":\"Cái đó đang ở trong tình trạng khá thảm hại đấy nhỉ?\",\"rating\":9.0},\n  {\"id\":749084,\"suggestedTranslation\":\"Tốt nhất là đừng làm phiền nó.\",\"rating\":9.0},\n  {\"id\":749085,\"suggestedTranslation\":\"Suýt nữa thì tôi tưởng nhầm nó là băng đá / gai băng rồi.\",\"rating\":9.0},\n  {\"id\":749086,\"suggestedTranslation\":\"Nó đang phát sáng nhẹ kìa.\",\"rating\":9.0},\n  {\"id\":749087,\"suggestedTranslation\":\"Nếu nó hoạt động thì tôi sẽ không phàn nàn gì đâu.\",\"rating\":9.0},\n  {\"id\":749088,\"suggestedTranslation\":\"Tôi có thể cảm nhận được tĩnh điện trên bộ râu của mình rồi đây.\",\"rating\":9.0},\n  {\"id\":749089,\"suggestedTranslation\":\"Dù hắn ta đang làm gì thì trông cũng có vẻ khá phức tạp.\",\"rating\":9.0},\n  {\"id\":749090,\"suggestedTranslation\":\"Trông có vẻ trống rỗng.\",\"rating\":9.0},\n  {\"id\":749091,\"suggestedTranslation\":\"Trông giống như sét đóng chai vậy.\",\"rating\":9.0},\n  {\"id\":749092,\"suggestedTranslation\":\"Chúng ta nên đóng chai tia sét đó lại thôi!\",\"rating\":9.0},\n  {\"id\":749093,\"suggestedTranslation\":\"Nó muốn cho tôi xem thứ gì đó.\",\"rating\":9.0},\n  {\"id\":749094,\"suggestedTranslation\":\"Ồ tuyệt vời, giờ thì tôi thực sự nghe thấy tiếng ai đó lẩm bẩm rồi.\",\"rating\":9.0},\n  {\"id\":749095,\"suggestedTranslation\":\"Tất cả lại lành lặn như cũ rồi.\",\"rating\":9.0},\n  {\"id\":749096,\"suggestedTranslation\":\"Tôi không hiểu, tại sao có cảm giác như chúng ta vẫn chưa làm xong nhỉ?\",\"rating\":9.0},\n  {\"id\":749097,\"suggestedTranslation\":\"Tôi biết phải làm gì rồi, đưa cậu về nơi cậu thuộc về nào.\",\"rating\":9.0},\n  {\"id\":749098,\"suggestedTranslation\":\"Tôi nghĩ nó muốn một trong những khe nứt mặt trăng đó.\",\"rating\":9.0},\n  {\"id\":749099,\"suggestedTranslation\":\"Cậu muốn tôi đưa cậu về nhà phải không?\",\"rating\":9.0},\n  {\"id\":749100,\"suggestedTranslation\":\"Nó muốn tôi mang nó đi đâu đó.\",\"rating\":9.0},\n  {\"id\":749101,\"suggestedTranslation\":\"Nó làm tôi nổi cả da gà da cóc lên rồi đây.\",\"rating\":9.0},\n  {\"id\":749102,\"suggestedTranslation\":\"Có một tiếng thì thầm nhỏ phát ra từ bên trong.\",\"rating\":9.0},\n  {\"id\":749103,\"suggestedTranslation\":\"Có một tiếng thì thầm nhỏ phát ra từ bên trong.\",\"rating\":9.0},\n  {\"id\":749104,\"suggestedTranslation\":\"Có một tiếng thì thầm nhỏ phát ra từ bên trong.\",\"rating\":9.0},\n  {\"id\":749105,\"suggestedTranslation\":\"Nó muốn tôi mang nó đến một trong những vết nứt trên mặt đất kia.\",\"rating\":9.0},\n  {\"id\":749106,\"suggestedTranslation\":\"Làm thế quái nào mà cậu lại xuống được dưới lòng đất hay vậy?\",\"rating\":9.0},\n  {\"id\":749107,\"suggestedTranslation\":\"Không chắc là mình có nên ăn thứ đó không nữa.\",\"rating\":9.0},\n  {\"id\":749108,\"suggestedTranslation\":\"Mùi hương đủ để làm bạn tỉnh cả người đấy.\",\"rating\":9.0},\n  {\"id\":749109,\"suggestedTranslation\":\"Cũng nên giúp đỡ ông bạn già đó một tay chứ nhỉ?\",\"rating\":9.0},\n  {\"id\":749110,\"suggestedTranslation\":\"Vẫn còn phải xây dựng thêm một chút nữa.\",\"rating\":9.0},\n  {\"id\":749111,\"suggestedTranslation\":\"Hừm. Cậu nghĩ cái này dùng để làm gì thế, Luce?\",\"rating\":9.0},\n  {\"id\":749112,\"suggestedTranslation\":\"Trông có vẻ hấp dẫn một cách kỳ lạ nhỉ?\",\"rating\":9.0},\n  {\"id\":749113,\"suggestedTranslation\":\"Đó là một vết nứt trên mặt đất phải không?\",\"rating\":9.0},\n  {\"id\":749114,\"suggestedTranslation\":\"Đoán là đôi khi sự bướng bỉnh cũng được đền đáp nhỉ Lucy?\",\"rating\":9.0},\n  {\"id\":749115,\"suggestedTranslation\":\"Trời ạ, một ngọn lửa lớn thật đấy.\",\"rating\":9.0},\n  {\"id\":749116,\"suggestedTranslation\":\"Nó bị cháy rụi rồi phải không?\",\"rating\":9.0},\n  {\"id\":749117,\"suggestedTranslation\":\"Có lẽ tôi đã chặt nhiều hơn một nhát rồi.\",\"rating\":9.0},\n  {\"id\":749118,\"suggestedTranslation\":\"Cẩn tắc vô áy náy.\",\"rating\":9.0},\n  {\"id\":749119,\"suggestedTranslation\":\"Đó là một bông hoa cực kỳ xinh đẹp đấy.\",\"rating\":9.0},\n  {\"id\":749120,\"suggestedTranslation\":\"Thơm phết.\",\"rating\":9.0},\n  {\"id\":749121,\"suggestedTranslation\":\"Dù nó là gì đi nữa, thì chắc chắn nó mang đậm chất Canada.\",\"rating\":9.0},\n  {\"id\":749122,\"suggestedTranslation\":\"Chà, hóa ra nó đẻ trứng cơ đấy.\",\"rating\":9.0},\n  {\"id\":749123,\"suggestedTranslation\":\"Tên cuồng đốt phá đâu rồi? Thứ này cần phải được đốt cháy.\",\"rating\":9.0},\n  {\"id\":749124,\"suggestedTranslation\":\"Tôi chảy cả nước miếng chỉ bằng cách nhìn vào nó thôi đấy.\",\"rating\":9.0},\n  {\"id\":749125,\"suggestedTranslation\":\"Con đó chắc sẽ hút của tôi cả nửa lít máu mất!\",\"rating\":9.0},\n  {\"id\":749126,\"suggestedTranslation\":\"Giờ tôi phải làm gì với cái này đây?\",\"rating\":9.0},\n  {\"id\":749127,\"suggestedTranslation\":\"Đó là một cái túi đầy muỗi đang nổi giận.\",\"rating\":9.0},\n  {\"id\":749128,\"suggestedTranslation\":\"Tôi không nghĩ đó là sốt cà chua đâu.\",\"rating\":9.0},\n  {\"id\":749129,\"suggestedTranslation\":\"Tôi đoán là cũng có chút công lý trong đó đấy.\",\"rating\":9.0},\n  {\"id\":749130,\"suggestedTranslation\":\"Một con muỗi nhồi bông á? Trẻ con bây giờ thích cái này lắm phải không?\",\"rating\":9.0},\n  {\"id\":749131,\"suggestedTranslation\":\"Máu với cả ruột gan cơ đấy?\",\"rating\":9.0},\n  {\"id\":749132,\"suggestedTranslation\":\"Hươu Sừng Tấm con đầy lông tơ kìa!\",\"rating\":9.0},\n  {\"id\":749133,\"suggestedTranslation\":\"Đừng giận nhé!\",\"rating\":9.0},\n  {\"id\":749134,\"suggestedTranslation\":\"Chắc tôi nên mặc kệ cái đó thì hơn.\",\"rating\":9.0},\n  {\"id\":749135,\"suggestedTranslation\":\"Không gì chống lại cái lạnh tuyệt vời hơn thế này!\",\"rating\":9.0},\n  {\"id\":749136,\"suggestedTranslation\":\"Đó chính là thứ mà tôi đã rơi qua đấy nhỉ.\",\"rating\":9.0},\n  {\"id\":749137,\"suggestedTranslation\":\"Tự hỏi nó dẫn đến đâu nhỉ.\",\"rating\":9.0},\n  {\"id\":749138,\"suggestedTranslation\":\"Nó... nó thật đẹp.\",\"rating\":9.0},\n  {\"id\":749139,\"suggestedTranslation\":\"Đúng là một anh chàng ngộ nghĩnh nhỉ?\",\"rating\":9.0},\n  {\"id\":749140,\"suggestedTranslation\":\"Tôi không thích vẻ ngoài của cái đó chút nào.\",\"rating\":9.0},\n  {\"id\":749141,\"suggestedTranslation\":\"Cái đó sẽ giúp cậu hòa mình vào khu rừng đấy.\",\"rating\":9.0},\n  {\"id\":749142,\"suggestedTranslation\":\"Đừng hít phải nó đấy, Lucy!\",\"rating\":9.0},\n  {\"id\":749143,\"suggestedTranslation\":\"Nấm thì không có lý do gì để mọc to thế này cả.\",\"rating\":9.0},\n  {\"id\":749144,\"suggestedTranslation\":\"Nếu một khúc gỗ cháy trong rừng thì có làm tổn thương cảm xúc của tôi không? Có chứ. Chắc chắn rồi.\",\"rating\":9.0},\n  {\"id\":749145,\"suggestedTranslation\":\"Nó cần được giúp một tay để bắt đầu đấy.\",\"rating\":9.0},\n  {\"id\":749146,\"suggestedTranslation\":\"Nó đang phát triển rất tốt một mình kìa.\",\"rating\":9.0},\n  {\"id\":749147,\"suggestedTranslation\":\"Khúc gỗ mục đó cần phải được thay thế rồi.\",\"rating\":9.0},\n  {\"id\":749148,\"suggestedTranslation\":\"Ai mà chẳng có lúc khó khăn phải không?\",\"rating\":9.0},\n  {\"id\":749149,\"suggestedTranslation\":\"Thế là được rồi. Đôi khi ai cũng cần được giúp đỡ một chút mà.\",\"rating\":9.0},\n  {\"id\":749150,\"suggestedTranslation\":\"Không cần chúng ta lo nữa đâu.\",\"rating\":9.0},\n  {\"id\":749151,\"suggestedTranslation\":\"Ý tưởng thiên tài nào lại đi tắt đèn thế này không biết?\",\"rating\":9.0},\n  {\"id\":749152,\"suggestedTranslation\":\"Phong cách trang trí đúng gu tôi đây.\",\"rating\":9.0},\n  {\"id\":749153,\"suggestedTranslation\":\"Tận hưởng ánh sáng hoàn toàn tự nhiên đó đi, Lucy.\",\"rating\":9.0},\n  {\"id\":749154,\"suggestedTranslation\":\"Cái đó bị thui cháy đen thui luôn rồi.\",\"rating\":9.0},\n  {\"id\":749155,\"suggestedTranslation\":\"Lẽ ra nó phải có màu xanh lá như một khu rừng rậm rạp, đầy cây cối để chặt chứ.\",\"rating\":9.0},\n  {\"id\":749156,\"suggestedTranslation\":\"Nó tỏa sáng với mọi sắc màu của gió.\",\"rating\":9.0},\n  {\"id\":749157,\"suggestedTranslation\":\"Với tôi thế nào cũng được. Đi chặt cây thôi nào.\",\"rating\":9.0},\n  {\"id\":749158,\"suggestedTranslation\":\"Tôi thích màu của cây này đấy.\",\"rating\":9.0},\n  {\"id\":749159,\"suggestedTranslation\":\"Có lẽ tôi nên chặt nó đi nhỉ.\",\"rating\":9.0},\n  {\"id\":749160,\"suggestedTranslation\":\"Tôi nghĩ đã đến lúc cho nó lên thớt rồi đấy.\",\"rating\":9.0},\n  {\"id\":749161,\"suggestedTranslation\":\"Với tôi thế nào cũng được. Đi chặt cây thôi nào.\",\"rating\":9.0},\n  {\"id\":749162,\"suggestedTranslation\":\"Chà, giờ thì tôi không thể chặt nó được rồi...\",\"rating\":9.0},\n  {\"id\":749163,\"suggestedTranslation\":\"Nó được làm bằng gỗ đấy.\",\"rating\":9.0},\n  {\"id\":749164,\"suggestedTranslation\":\"Với tôi thế nào cũng được. Đi chặt cây thôi nào.\",\"rating\":9.0},\n  {\"id\":749165,\"suggestedTranslation\":\"Chặt nó đi trước khi nó lan rộng ra!\",\"rating\":9.0},\n  {\"id\":749166,\"suggestedTranslation\":\"Tôi không thể để nó đứng lù lù ở đó được.\",\"rating\":9.0},\n  {\"id\":749167,\"suggestedTranslation\":\"Với tôi thế nào cũng được. Đi chặt cây thôi nào.\",\"rating\":9.0},\n  {\"id\":749168,\"suggestedTranslation\":\"Cái này ít nhất cũng cần phải được tỉa bớt.\",\"rating\":9.0},\n  {\"id\":749169,\"suggestedTranslation\":\"Nhìn đôi găng tay kìa! Ai đó đưa cho tên to xác này một nhành cây xem nào!\",\"rating\":9.0},\n  {\"id\":749170,\"suggestedTranslation\":\"Tao ghét mày hơn bất cứ thứ gì trên đời.\",\"rating\":9.0},\n  {\"id\":749171,\"suggestedTranslation\":\"Chúng ta phải chuồn khỏi đây thôi, Luce.\",\"rating\":9.0},\n  {\"id\":749172,\"suggestedTranslation\":\"Ôi trời. Tệ thật đấy. Quá tệ luôn.\",\"rating\":9.0},\n  {\"id\":749173,\"suggestedTranslation\":\"Nó đang mọc ra mấy cây cột băng á? Chắc là đến từ Quebec rồi.\",\"rating\":9.0},\n  {\"id\":749174,\"suggestedTranslation\":\"Nó chết ngắc rồi.\",\"rating\":9.0},\n  {\"id\":749175,\"suggestedTranslation\":\"Cái đó trông không bình thường chút nào.\",\"rating\":9.0},\n  {\"id\":749176,\"suggestedTranslation\":\"Đừng đánh thức nó dậy nhé.\",\"rating\":9.0},\n  {\"id\":749177,\"suggestedTranslation\":\"Mày là một cún c