          {
            "text": "[\n  {\"id\":748689,\"suggestedTranslation\":\"Tôi nghĩ cái vỏ cứng ngắc đó đang mềm ra đấy, phải không Lucy?\",\"rating\":8.5},\n  {\"id\":748690,\"suggestedTranslation\":\"Một cái vỏ đầy vỏ, phải không?\",\"rating\":8.5},\n  {\"id\":748691,\"suggestedTranslation\":\"Tôi chỉ định giúp thôi mà...\",\"rating\":8.5},\n  {\"id\":748692,\"suggestedTranslation\":\"Thôi nào Lucy, đi tìm con cua đó thôi!\",\"rating\":8.5},\n  {\"id\":748693,\"suggestedTranslation\":\"Hừm. Trông oai phết.\",\"rating\":8.5},\n  {\"id\":748694,\"suggestedTranslation\":\"Ai đấy?\",\"rating\":8.5},\n  {\"id\":748695,\"suggestedTranslation\":\"Gỗ là tốt nhất khi cháy.\",\"rating\":8.5},\n  {\"id\":748696,\"suggestedTranslation\":\"Có việc gì mà gỗ không làm được không nhỉ?\",\"rating\":8.5},\n  {\"id\":748697,\"suggestedTranslation\":\"Hãy cho hàng xóm của chúng ta chút hướng dẫn nào.\",\"rating\":8.5},\n  {\"id\":748698,\"suggestedTranslation\":\"Ưm-m-m. Xi -rô ong.\",\"rating\":8.5},\n  {\"id\":748699,\"suggestedTranslation\":\"Mấy chú ong tội nghiệp chắc đã vắt kiệt ngòi của mình vì cái này rồi.\",\"rating\":8.5},\n  {\"id\":748700,\"suggestedTranslation\":\"Nhưng đây có phải ngày lễ đâu...\",\"rating\":8.5},\n  {\"id\":748701,\"suggestedTranslation\":\"Đó là một trong những món ăn yêu thích của tôi!\",\"rating\":8.5},\n  {\"id\":748702,\"suggestedTranslation\":\"Tôi không biết là có nên ngậm cái đó vào miệng không nữa.\",\"rating\":8.5},\n  {\"id\":748703,\"suggestedTranslation\":\"Thứ đó không tốt cho cậu đâu.\",\"rating\":8.5},\n  {\"id\":748704,\"suggestedTranslation\":\"Tất nhiên là cậu gặp may hơn rồi, Luce!\",\"rating\":8.5},\n  {\"id\":748705,\"suggestedTranslation\":\"Tuyệt thật sau một ngày dài chặt chém trong giá lạnh.\",\"rating\":8.5},\n  {\"id\":748706,\"suggestedTranslation\":\"Trông xinh phết.\",\"rating\":8.5},\n  {\"id\":748707,\"suggestedTranslation\":\"Đợi xem nó có đầy lại không nào.\",\"rating\":8.5},\n  {\"id\":748708,\"suggestedTranslation\":\"Cẩn thận đấy Lucy, không lại bị rỉ sét bây giờ.\",\"rating\":8.5},\n  {\"id\":748709,\"suggestedTranslation\":\"Tự hỏi không biết mình có phá thủng cái đó được không.\",\"rating\":8.5},\n  {\"id\":748710,\"suggestedTranslation\":\"Chúng mà kéo xe trượt tuyết thì hợp lắm đấy.\",\"rating\":8.5},\n  {\"id\":748711,\"suggestedTranslation\":\"Nó dính đầy nước dãi chó rồi, phải không?\",\"rating\":8.5},\n  {\"id\":748712,\"suggestedTranslation\":\"Thế này lại hay hơn.\",\"rating\":8.5},\n  {\"id\":748713,\"suggestedTranslation\":\"Tôi không thích cái vẻ ngoài đó tí nào.\",\"rating\":8.5},\n  {\"id\":748714,\"suggestedTranslation\":\"Chuyện quái gì đang xảy ra thế này?!\",\"rating\":8.5},\n  {\"id\":748715,\"suggestedTranslation\":\"Tôi khôn hồn không dây dưa với cái đó đâu.\",\"rating\":8.5},\n  {\"id\":748716,\"suggestedTranslation\":\"Hàng đẹp đấy.\",\"rating\":8.5},\n  {\"id\":748717,\"suggestedTranslation\":\"Phụt ra lắm răng còn hơn cả một cầu thủ Montreal Canadien.\",\"rating\":8.5},\n  {\"id\":748718,\"suggestedTranslation\":\"Tôi thường tự gọi động vật bằng giọng của mình cơ.\",\"rating\":8.5},\n  {\"id\":748719,\"suggestedTranslation\":\"Anh bạn nhỏ thân thiện nhỉ?\",\"rating\":8.5},\n  {\"id\":748720,\"suggestedTranslation\":\"Tôi chưa từng có cái nào thế này trước đây.\",\"rating\":8.5},\n  {\"id\":748721,\"suggestedTranslation\":\"Sớm muộn gì cũng phải xảy ra thôi.\",\"rating\":8.5},\n  {\"id\":748722,\"suggestedTranslation\":\"Một lời nhắc nhở nhỏ bé về quê nhà.\",\"rating\":8.5},\n  {\"id\":748723,\"suggestedTranslation\":\"Làm tôi nhớ đến quê nhà.\",\"rating\":8.5},\n  {\"id\":748724,\"suggestedTranslation\":\"Trông có vẻ hơi nhỏ giọt rồi đấy.\",\"rating\":8.5},\n  {\"id\":748725,\"suggestedTranslation\":\"Trông có vẻ hơi nhỏ giọt rồi đấy.\",\"rating\":8.5},\n  {\"id\":748726,\"suggestedTranslation\":\"Aaaaa. Làm tôi nhớ nhà quá.\",\"rating\":8.5},\n  {\"id\":748727,\"suggestedTranslation\":\"Chỉ sau khi tôi chặt đủ số cây đã!\",\"rating\":8.5},\n  {\"id\":748728,\"suggestedTranslation\":\"Tôi chặt được tuốt nếu bắt buộc phải làm.\",\"rating\":8.5},\n  {\"id\":748729,\"suggestedTranslation\":\"Chó săn vùng Bắc Cực à?\",\"rating\":8.5},\n  {\"id\":748730,\"suggestedTranslation\":\"Rất tốt cho những chuyến đi bộ đường dài.\",\"rating\":8.5},\n  {\"id\":748731,\"suggestedTranslation\":\"Nó làm tôi nhớ về quê nhà.\",\"rating\":8.5},\n  {\"id\":748732,\"suggestedTranslation\":\"Chắc phải đeo găng tay khi dùng cái này quá.\",\"rating\":8.5},\n  {\"id\":748733,\"suggestedTranslation\":\"Chúng ta sẽ gửi thẳng bọn chúng đến Yukon bằng cái này.\",\"rating\":8.5},\n  {\"id\":748734,\"suggestedTranslation\":\"Khi bạn sống ở miền Bắc, bạn sẽ quen với cái lạnh thôi.\",\"rating\":8.5},\n  {\"id\":748735,\"suggestedTranslation\":\"Nó biến đi đâu mất tiêu rồi?!\",\"rating\":8.5},\n  {\"id\":748736,\"suggestedTranslation\":\"Tôi không biết làm sao để di chuyển cái đó.\",\"rating\":8.5},\n  {\"id\":748739,\"suggestedTranslation\":\"Tự hỏi Winona thấy có điểm gì ở mấy cái kính đó cơ chứ.\",\"rating\":8.5},\n  {\"id\":748741,\"suggestedTranslation\":\"Bộ râu đang mọc lên khá đẹp đây.\",\"rating\":8.5},\n  {\"id\":748742,\"suggestedTranslation\":\"Tôi không thèm phết thứ đó lên bánh kếp của mình đâu.\",\"rating\":8.5},\n  {\"id\":748743,\"suggestedTranslation\":\"Đống gai nhọn hoắt gì thế này!\",\"rating\":8.5},\n  {\"id\":748744,\"suggestedTranslation\":\"Giờ thì đi tìm bơ đậu phộng thôi.\",\"rating\":8.5},\n  {\"id\":748745,\"suggestedTranslation\":\"Hầu như chẳng thấy vị đậu đâu cả!\",\"rating\":8.5},\n  {\"id\":748746,\"suggestedTranslation\":\"Lục lọi ở đó một chút chắc cũng chẳng sao đâu, nhỉ?\",\"rating\":8.5},\n  {\"id\":748747,\"suggestedTranslation\":\"Có cái gì ở trên đó kìa, Luce.\",\"rating\":8.5},\n  {\"id\":748748,\"suggestedTranslation\":\"Cái đó mà đổ xuống thì đúng là một đống hỗn độn to lớn đấy.\",\"rating\":8.5},\n  {\"id\":748749,\"suggestedTranslation\":\"Sự trả thù ngọt ngào.\",\"rating\":8.5},\n  {\"id\":748750,\"suggestedTranslation\":\"Cái que cắm vào làm tăng thêm hương vị đấy chứ.\",\"rating\":8.5},\n  {\"id\":748751,\"suggestedTranslation\":\"Nấu lên thì ăn ngon phết đấy.\",\"rating\":8.5},\n  {\"id\":748752,\"suggestedTranslation\":\"Ngay cả khi tháo ra tôi vẫn cảm nhận được kết cấu của nó.\",\"rating\":8.5},\n  {\"id\":748753,\"suggestedTranslation\":\"Món ăn ngon lành đây, nếu bạn hỏi tôi.\",\"rating\":8.5},\n  {\"id\":748754,\"suggestedTranslation\":\"Đó là một món ăn vặt nhẹ nhàng tuyệt vời.\",\"rating\":8.5},\n  {\"id\":748755,\"suggestedTranslation\":\"Con ong đó trông không thân thiện cho lắm.\",\"rating\":8.5},\n  {\"id\":748756,\"suggestedTranslation\":\"Cô nàng có vẻ không vừa lòng với hoàn cảnh hiện tại cho lắm.\",\"rating\":8.5},\n  {\"id\":748757,\"suggestedTranslation\":\"Hừ, chỗ này trông đẹp hơn khi không có nó đấy.\",\"rating\":8.5},\n  {\"id\":748758,\"suggestedTranslation\":\"Tôi hoàn toàn ủng hộ việc dạy lũ mèo con tấn công chim ngay khi thấy chúng.\",\"rating\":8.5},\n  {\"id\":748759,\"suggestedTranslation\":\"Tôi không biết về con này lắm đâu...\",\"rating\":8.5},\n  {\"id\":748760,\"suggestedTranslation\":\"Đúng là một sự tiếc nuối.\",\"rating\":8.5},\n  {\"id\":748761,\"suggestedTranslation\":\"Lũ mèo con sẽ chơi rất vui với cái đó đấy.\",\"rating\":8.5},\n  {\"id\":748762,\"suggestedTranslation\":\"Cá là lũ mèo con đó sẽ rất thích có một món đồ chơi để nghịch.\",\"rating\":8.5},\n  {\"id\":748763,\"suggestedTranslation\":\"Thật phí hoài đỗ gỗ tốt.\",\"rating\":8.5},\n  {\"id\":748764,\"suggestedTranslation\":\"Trông giống chuồng chim quá, không hợp gu của tôi lắm.\",\"rating\":8.5},\n  {\"id\":748765,\"suggestedTranslation\":\"Tôi chẳng thấy ai trốn trong đó cả.\",\"rating\":8.5},\n  {\"id\":748766,\"suggestedTranslation\":\"Có vẻ như tôi sắp hết giờ rồi.\",\"rating\":8.5},\n  {\"id\":748767,\"suggestedTranslation\":\"Làm việc với gỗ là sở trường của chúng ta mà, phải không Luce?\",\"rating\":8.5},\n  {\"id\":748768,\"suggestedTranslation\":\"Trông cậu có vẻ muốn được vuốt ve nhỉ?\",\"rating\":8.5},\n  {\"id\":748769,\"suggestedTranslation\":\"Chà, cưng đáng yêu quá cơ, phải không nào?\",\"rating\":8.5},\n  {\"id\":748770,\"suggestedTranslation\":\"Trông cậu có vẻ muốn được vuốt ve nhỉ?\",\"rating\":8.5},\n  {\"id\":748771,\"suggestedTranslation\":\"Trông cậu có vẻ muốn được vuốt ve nhỉ?\",\"rating\":8.5},\n  {\"id\":748772,\"suggestedTranslation\":\"Trông cậu có vẻ muốn được vuốt ve nhỉ?\",\"rating\":8.5},\n  {\"id\":748773,\"suggestedTranslation\":\"Chà, cưng đáng yêu quá cơ, phải không nào?\",\"rating\":8.5},\n  {\"id\":748774,\"suggestedTranslation\":\"Nghĩ ra cái tên nào hay ho chưa, Luce?\",\"rating\":8.5},\n  {\"id\":748775,\"suggestedTranslation\":\"Chà, cưng đáng yêu quá cơ, phải không nào?\",\"rating\":8.5},\n  {\"id\":748776,\"suggestedTranslation\":\"Trông cậu có vẻ muốn được vuốt ve nhỉ?\",\"rating\":8.5},\n  {\"id\":748777,\"suggestedTranslation\":\"Chà, cưng đáng yêu quá cơ, phải không nào?\",\"rating\":8.5},\n  {\"id\":748778,\"suggestedTranslation\":\"Thứ này không có mắt à?\",\"rating\":8.5},\n  {\"id\":748779,\"suggestedTranslation\":\"Chắc phải có ích cho việc gì chứ.\",\"rating\":8.5},\n  {\"id\":748780,\"suggestedTranslation\":\"Có cái gì ngon lắm ở trong đó phải không?\",\"rating\":8.5},\n  {\"id\":748781,\"suggestedTranslation\":\"Tôi chưa bao giờ thích ngựa.\",\"rating\":8.5},\n  {\"id\":748782,\"suggestedTranslation\":\"Trông có vẻ không được khỏe cho lắm.\",\"rating\":8.5},\n  {\"id\":748783,\"suggestedTranslation\":\"Lucy, chúng thích tôi kìa!\",\"rating\":8.5},\n  {\"id\":748784,\"suggestedTranslation\":\"Không phải ngựa của tôi.\",\"rating\":8.5},\n  {\"id\":748785,\"suggestedTranslation\":\"Sao nó lại khó chịu thế nhỉ?\",\"rating\":8.5},\n  {\"id\":748786,\"suggestedTranslation\":\"Có vẻ như có thứ khác đã xơi tái nó trước rồi.\",\"rating\":8.5},\n  {\"id\":748787,\"suggestedTranslation\":\"Trông có vẻ ngon nghẻ đấy.\",\"rating\":8.5},\n  {\"id\":748788,\"suggestedTranslation\":\"Vào mùa đông chúng còn ngon hơn nữa.\",\"rating\":8.5},\n  {\"id\":748789,\"suggestedTranslation\":\"Tôi mới là người bị nhồi nhét nếu ăn hết chỗ đó mất.\",\"rating\":8.5},\n  {\"id\":748790,\"suggestedTranslation\":\"Tránh ra đi, quân bất tài!\",\"rating\":8.5},\n  {\"id\":748791,\"suggestedTranslation\":\"Lấy túi của người khác thì có vẻ không đúng cho lắm.\",\"rating\":8.5},\n  {\"id\":748792,\"suggestedTranslation\":\"Chà, sáng sủa hẳn ra nhỉ?\",\"rating\":8.5},\n  {\"id\":748793,\"suggestedTranslation\":\"Tôi không bao giờ từ chối khoai tây cả.\",\"rating\":8.5},\n  {\"id\":748794,\"suggestedTranslation\":\"Chẳng ai dám bắt nạt cậu khi mặc cái đó đâu.\",\"rating\":8.5},\n  {\"id\":748795,\"suggestedTranslation\":\"Trông khá an toàn đấy, nhỉ?\",\"rating\":8.5},\n  {\"id\":748796,\"suggestedTranslation\":\"Chẳng giúp ích được mấy cho ai đâu.\",\"rating\":8.5},\n  {\"id\":748797,\"suggestedTranslation\":\"Chẳng làm được việc gì nhanh chóng cả.\",\"rating\":8.5},\n  {\"id\":748798,\"suggestedTranslation\":\"Mặc giáp gỗ vẫn hơn là không có gì.\",\"rating\":8.5},\n  {\"id\":748799,\"suggestedTranslation\":\"Trông bảnh phết nhỉ?\",\"rating\":8.5},\n  {\"id\":748800,\"suggestedTranslation\":\"Tốt cho việc nạp lại chút năng lượng.\",\"rating\":8.5},\n  {\"id\":748801,\"suggestedTranslation\":\"Tốt nhất là nên mặc giáp vào thôi.\",\"rating\":8.5},\n  {\"id\":748802,\"suggestedTranslation\":\"Hãy chặt Cờ Hiệu Chiến Đấu đó đi!\",\"rating\":8.5},\n  {\"id\":748803,\"suggestedTranslation\":\"Chào cậu bạn nhỏ nhé.\",\"rating\":8.5},\n  {\"id\":748804,\"suggestedTranslation\":\"Hắn có vẻ bối rối nhỉ?\",\"rating\":8.5},\n  {\"id\":748805,\"suggestedTranslation\":\"Nhìn cái mũ kìa!\",\"rating\":8.5},\n  {\"id\":748806,\"suggestedTranslation\":\"Đúng là một anh bạn nhỏ kỳ lạ.\",\"rating\":8.5},\n  {\"id\":748807,\"suggestedTranslation\":\"Tôi thấy cái đó chẳng có ích gì mấy.\",\"rating\":8.5},\n  {\"id\":748808,\"suggestedTranslation\":\"Tôi nghĩ sự nhanh nhẹn không phải sở trường của mình đâu.\",\"rating\":8.5},\n  {\"id\":748809,\"suggestedTranslation\":\"Tôi sẽ nhường thứ đó cho người khác.\",\"rating\":8.5},\n  {\"id\":748810,\"suggestedTranslation\":\"Bông hoa đó trông rất hợp với bộ râu của tôi đấy.\",\"rating\":8.5},\n  {\"id\":748811,\"suggestedTranslation\":\"Cái đó sẽ giúp bạn di chuyển nhanh nhẹn hơn đấy.\",\"rating\":8.5},\n  {\"id\":748812,\"suggestedTranslation\":\"Tôi dùng cái này được đấy.\",\"rating\":8.5},\n  {\"id\":748813,\"suggestedTranslation\":\"Cần thêm một mảnh nữa.\",\"rating\":8.5},\n  {\"id\":748814,\"suggestedTranslation\":\"Trông ổn phết.\",\"rating\":8.5},\n  {\"id\":748815,\"suggestedTranslation\":\"Đội cái đó vào chắc tôi vung rìu mạnh tay hơn chút đấy.\",\"rating\":8.5},\n  {\"id\":748816,\"suggestedTranslation\":\"Có cái gì đó khác lạ ở cậu rồi đấy, Lucy.\",\"rating\":8.5},\n  {\"id\":748817,\"suggestedTranslation\":\"Đừng tin tưởng nó quá nếu không muốn chuốc họa.\",\"rating\":8.5},\n  {\"id\":748818,\"suggestedTranslation\":\"Trở về trại thôi, Lucy.\",\"rating\":8.5},\n  {\"id\":748819,\"suggestedTranslation\":\"Chúng đang làm sống lại mấy cục đá kìa.\",\"rating\":8.5},\n  {\"id\":748820,\"suggestedTranslation\":\"Tốt hơn là nên để mắt tới cái đó.\",\"rating\":8.5},\n  {\"id\":748821,\"suggestedTranslation\":\"Tôi có thể gây ra khối sát thương với cái đó đấy.\",\"rating\":8.5},\n  {\"id\":748822,\"suggestedTranslation\":\"Tôi nên nhường cái đó cho người khác thì hơn.\",\"rating\":8.5},\n  {\"id\":748823,\"suggestedTranslation\":\"Chết dưới lưỡi rìu!\",\"rating\":8.5},\n  {\"id\":748824,\"suggestedTranslation\":\"Anh bạn nhỏ đã hạ nhiệt rồi kìa.\",\"rating\":8.5},\n  {\"id\":748825,\"suggestedTranslation\":\"Có một ngọn lửa đang bùng cháy trong đó.\",\"rating\":8.5},\n  {\"id\":748826,\"suggestedTranslation\":\"Cô nhóc này chắc cần một chiếc áo parka đấy.\",\"rating\":8.5},\n  {\"id\":748827,\"suggestedTranslation\":\"Ấm áp hơn cả một con hươu sừng tấm quấn băng keo!\",\"rating\":8.5},\n  {\"id\":748828,\"suggestedTranslation\":\"Nhìn con bé hạnh phúc chưa kìa!\",\"rating\":8.5},\n  {\"id\":748829,\"suggestedTranslation\":\"Đó là sinh vật nhỏ của tôi đấy.\",\"rating\":8.5},\n  {\"id\":748830,\"suggestedTranslation\":\"Cô nhóc tội nghiệp đang đói bụng rồi kìa.\",\"rating\":8.5},\n  {\"id\":748831,\"suggestedTranslation\":\"Gầy hơn cả chân diệc xanh.\",\"rating\":8.5},\n  {\"id\":748832,\"suggestedTranslation\":\"Không bén bằng Lucy đâu!\",\"rating\":8.5},\n  {\"id\":748833,\"suggestedTranslation\":\"Mấy cái cây của tôi an toàn rồi.\",\"rating\":8.5},\n  {\"id\":748834,\"suggestedTranslation\":\"Áaaaa! Tên sát thủ cây rừng!\",\"rating\":8.5},\n  {\"id\":748835,\"suggestedTranslation\":\"Tôi sẽ không đến gần cái đó đâu, phải không?\",\"rating\":8.5},\n  {\"id\":748836,\"suggestedTranslation\":\"Nói nhảm nhí.\",\"rating\":8.5},\n  {\"id\":748837,\"suggestedTranslation\":\"Không phải sở thích của tôi.\",\"rating\":8.5},\n  {\"id\":748838,\"suggestedTranslation\":\"Nó chẳng bao giờ có vị giống thịt thật cả...\",\"rating\":8.5},\n  {\"id\":748839,\"suggestedTranslation\":\"Tôi thèm vào mà chạm vào cái thứ dài mười thước đó.\",\"rating\":8.5},\n  {\"id\":748840,\"suggestedTranslation\":\"Tôi xin lỗi vì đống cây đó nhé!\",\"rating\":8.5},\n  {\"id\":748841,\"suggestedTranslation\":\"Muốn đánh bại một cái cây, bạn phải suy nghĩ như một cái cây...\",\"rating\":8.5},\n  {\"id\":748842,\"suggestedTranslation\":\"Tôi xin lỗi vì đống cây đó nhé!\",\"rating\":8.5},\n  {\"id\":748843,\"suggestedTranslation\":\"Trông hầu như chẳng ăn nổi.\",\"rating\":8.5},\n  {\"id\":748844,\"suggestedTranslation\":\"Cái này chắc sẽ chữa khỏi mấy trận sụt sịt đó.\",\"rating\":8.5},\n  {\"id\":748845,\"suggestedTranslation\":\"Trông có vẻ dai đấy.\",\"rating\":8.5},\n  {\"id\":748846,\"suggestedTranslation\":\"Anh bạn nhỏ chỉ đang lo việc của mình thôi mà.\",\"rating\":8.5},\n  {\"id\":748847,\"suggestedTranslation\":\"Tránh xa mấy cái cây ra!\",\"rating\":8.5},\n  {\"id\":748848,\"suggestedTranslation\":\"Cứ thắp sáng đường cho tôi thì chúng ta sẽ hợp tác rất ăn ý đấy, anh bạn!\",\"rating\":8.5},\n  {\"id\":748849,\"suggestedTranslation\":\"Dê ngoan, dê ngoan nào!\",\"rating\":8.5},\n  {\"id\":748850,\"suggestedTranslation\":\"Cặp sừng của cậu đẹp phết đấy.\",\"rating\":8.5},\n  {\"id\":748851,\"suggestedTranslation\":\"Chắc con dê đó không cần nó đâu.\",\"rating\":8.5},\n  {\"id\":748852,\"suggestedTranslation\":\"Đẹp chẳng kém gì cực quang cả.\",\"rating\":8.5},\n  {\"id\":748853,\"suggestedTranslation\":\"Thời tiết giờ không thể đánh úp tôi được nữa đâu.\",\"rating\":8.5},\n  {\"id\":748854,\"suggestedTranslation\":\"Sao chúng lại xuống tận phía nam thế này?\",\"rating\":8.5},\n  {\"id\":748855,\"suggestedTranslation\":\"Tôi muốn giữ cậu lại, và đặt tên cậu là \\\"Frank\\\".\",\"rating\":8.5},\n  {\"id\":748856,\"suggestedTranslation\":\"Tôi thấy mâu thuẫn quá, phải không?\",\"rating\":8.5},\n  {\"id\":748857,\"suggestedTranslation\":\"Ồ, có một khúc gỗ ở trong đó kìa.\",\"rating\":8.5},\n  {\"id\":748858,\"suggestedTranslation\":\"Chuẩn luôn. Sau này nó sẽ thành một cái cây đẹp tuyệt.\",\"rating\":8.5},\n  {\"id\":748859,\"suggestedTranslation\":\"Trông mượt mà và ngậy quá, nhưng tôi vẫn thích cá hồi hơn.\",\"rating\":8.5},\n  {\"id\":748860,\"suggestedTranslation\":\"Tôi thích cá hồi hơn.\",\"rating\":8.5},\n  {\"id\":748861,\"suggestedTranslation\":\"Ôi không! Đừng cho thêm khúc gỗ nào vào lửa nữa!\",\"rating\":8.5},\n  {\"id\":748862,\"suggestedTranslation\":\"Nó làm cho mọi thứ đều xứng đáng.\",\"rating\":8.5},\n  {\"id\":748863,\"suggestedTranslation\":\"Cậu đến nhầm khu vườn rồi đấy, anh bạn.\",\"rating\":8.5},\n  {\"id\":748864,\"suggestedTranslation\":\"Có cái gì đó không tự nhiên ở thứ đó... phải không Luce?\",\"rating\":8.5},\n  {\"id\":748865,\"suggestedTranslation\":\"Có cái gì đó không tự nhiên ở thứ đó... phải không Luce?\",\"rating\":8.5},\n  {\"id\":748866,\"suggestedTranslation\":\"Có cái gì đó không tự nhiên ở thứ đó... phải không Luce?\