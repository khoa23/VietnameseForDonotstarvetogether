            "text": "[\n  {\"id\": 748389, \"suggestedTranslation\": \"Nếu đây là trang trại cây, chắc tôi buồn lắm.\", \"rating\": 9.0},\n  {\"id\": 748390, \"suggestedTranslation\": \"Tôi thích cây cối lớn hơn.\", \"rating\": 9.0},\n  {\"id\": 748391, \"suggestedTranslation\": \"Chúng sẽ chẳng bao giờ lớn đến mức chặt được đâu.\", \"rating\": 9.0},\n  {\"id\": 748392, \"suggestedTranslation\": \"Tôi nghĩ nó cần chút phân.\", \"rating\": 9.0},\n  {\"id\": 748393, \"suggestedTranslation\": \"Tốt hơn là nên đi trồng cây thôi.\", \"rating\": 9.0},\n  {\"id\": 748394, \"suggestedTranslation\": \"Tên ngốc nào dám phóng lửa đốt khu vườn của tôi thế?\", \"rating\": 9.0},\n  {\"id\": 748395, \"suggestedTranslation\": \"Nó đã sẵn sàng để thu hoạch rồi.\", \"rating\": 9.0},\n  {\"id\": 748396, \"suggestedTranslation\": \"Đẹp tuyệt!\", \"rating\": 9.0},\n  {\"id\": 748397, \"suggestedTranslation\": \"Ấy chà, hóa ra nãy giờ tôi toàn chăm sóc cỏ dại.\", \"rating\": 9.0},\n  {\"id\": 748398, \"suggestedTranslation\": \"Một cây thực vật à?\", \"rating\": 9.0},\n  {\"id\": 748399, \"suggestedTranslation\": \"Này, tôi nghĩ nó lớn hơn một chút rồi đấy!\", \"rating\": 9.0},\n  {\"id\": 748400, \"suggestedTranslation\": \"Trông không ổn lắm đâu...\", \"rating\": 9.0},\n  {\"id\": 748401, \"suggestedTranslation\": \"Thứ duy nhất nó dùng được là làm phân trộn.\", \"rating\": 9.0},\n  {\"id\": 748402, \"suggestedTranslation\": \"Phải kiên nhẫn thôi.\", \"rating\": 9.0},\n  {\"id\": 748403, \"suggestedTranslation\": \"Trông có vẻ mọi thứ đang trong tầm kiểm soát.\", \"rating\": 9.0},\n  {\"id\": 748404, \"suggestedTranslation\": \"Chúng ta nên đặt khu vườn ở đâu đây, Luce?\", \"rating\": 9.0},\n  {\"id\": 748405, \"suggestedTranslation\": \"Tôi tốt hơn hết nên dọn cái đó đi.\", \"rating\": 9.0},\n  {\"id\": 748406, \"suggestedTranslation\": \"Một cái quạt truyền thống của Canada.\", \"rating\": 9.0},\n  {\"id\": 748407, \"suggestedTranslation\": \"Tôi không muốn dính dáng gì đến cái... thứ đó.\", \"rating\": 9.0},\n  {\"id\": 748408, \"suggestedTranslation\": \"Việc giết chim thậm chí còn không cần thiết. Hừm.\", \"rating\": 9.0},\n  {\"id\": 748409, \"suggestedTranslation\": \"Một chiếc lông vũ gớm ghiếc.\", \"rating\": 9.0},\n  {\"id\": 748410, \"suggestedTranslation\": \"Một chiếc lông vũ tởm lợm.\", \"rating\": 9.0},\n  {\"id\": 748411, \"suggestedTranslation\": \"Một chiếc lông vũ đáng kinh tởm.\", \"rating\": 9.0},\n  {\"id\": 748412, \"suggestedTranslation\": \"Một chiếc lông vũ ngớ ngẩn.\", \"rating\": 9.0},\n  {\"id\": 748413, \"suggestedTranslation\": \"Cô ấy bị kẹt rồi!\", \"rating\": 9.0},\n  {\"id\": 748414, \"suggestedTranslation\": \"Đó là một hàng rào trông rất được.\", \"rating\": 9.0},\n  {\"id\": 748415, \"suggestedTranslation\": \"Bây giờ nó chỉ là một cái cột thôi.\", \"rating\": 9.0},\n  {\"id\": 748416, \"suggestedTranslation\": \"Cái đó sẽ làm tóc bạn dựng đứng lên đấy!\", \"rating\": 9.0},\n  {\"id\": 748417, \"suggestedTranslation\": \"Tôi đoán mình có thể trồng thực vật này.\", \"rating\": 9.0},\n  {\"id\": 748418, \"suggestedTranslation\": \"Đồ mộc ở đó thật đẹp.\", \"rating\": 9.0},\n  {\"id\": 748419, \"suggestedTranslation\": \"Một dự án hay cho buổi chiều lười biếng.\", \"rating\": 9.0},\n  {\"id\": 748420, \"suggestedTranslation\": \"Một dự án hay cho buổi chiều lười biếng.\", \"rating\": 9.0},\n  {\"id\": 748421, \"suggestedTranslation\": \"Nó chẳng thấm vào đâu so với một hàng rào gỗ chắc chắn cả.\", \"rating\": 9.0},\n  {\"id\": 748422, \"suggestedTranslation\": \"Đôi khi bạn phải cho hàng rào biết ai mới là chủ, phải không?\", \"rating\": 9.0},\n  {\"id\": 748423, \"suggestedTranslation\": \"Phân bón thuộc về cái xô, chứ không phải trên mặt đất.\", \"rating\": 9.0},\n  {\"id\": 748424, \"suggestedTranslation\": \"Chúc mừng mùa câu cá!\", \"rating\": 9.0},\n  {\"id\": 748425, \"suggestedTranslation\": \"Trông khá vui tươi đấy!\", \"rating\": 9.0},\n  {\"id\": 748426, \"suggestedTranslation\": \"Đó là một loại quả kỳ công.\", \"rating\": 9.0},\n  {\"id\": 748427, \"suggestedTranslation\": \"Đó mới thực sự là món ăn an ủi.\", \"rating\": 9.0},\n  {\"id\": 748428, \"suggestedTranslation\": \"Không gì tuyệt hơn đồ ăn xiên trên que gỗ phải không?\", \"rating\": 9.0},\n  {\"id\": 748429, \"suggestedTranslation\": \"Món này không tệ lắm đâu, phải không?\", \"rating\": 9.0},\n  {\"id\": 748430, \"suggestedTranslation\": \"Tôi sẽ để việc đó cho người có máu ma thuật hơn.\", \"rating\": 9.0},\n  {\"id\": 748431, \"suggestedTranslation\": \"Đừng đốt pháo trong rừng nhé.\", \"rating\": 9.0},\n  {\"id\": 748432, \"suggestedTranslation\": \"Làm tôi nhớ đến công viên Algonquin.\", \"rating\": 9.0},\n  {\"id\": 748433, \"suggestedTranslation\": \"Tôi có cả một túi đầy ánh nắng mặt trời!\", \"rating\": 9.0},\n  {\"id\": 748434, \"suggestedTranslation\": \"Chú chó nóng bỏng!\", \"rating\": 9.0},\n  {\"id\": 748435, \"suggestedTranslation\": \"Nhắc nhở bản thân: \\\"không được chạm vào.\\\"\", \"rating\": 9.0},\n  {\"id\": 748436, \"suggestedTranslation\": \"Thơm dễ chịu.\", \"rating\": 9.0},\n  {\"id\": 748437, \"suggestedTranslation\": \"Tránh xa đám cây ra!\", \"rating\": 9.0},\n  {\"id\": 748438, \"suggestedTranslation\": \"Tôi nên đi chặt ít củi cho nó nhỉ?\", \"rating\": 9.0},\n  {\"id\": 748439, \"suggestedTranslation\": \"Nó dùng củi.\", \"rating\": 9.0},\n  {\"id\": 748440, \"suggestedTranslation\": \"Quá nhiều củi, quá nhanh!\", \"rating\": 9.0},\n  {\"id\": 748441, \"suggestedTranslation\": \"Phải có ít củi ở quanh đây chứ.\", \"rating\": 9.0},\n  {\"id\": 748442, \"suggestedTranslation\": \"Mmm. Ngửi mùi gỗ phết.\", \"rating\": 9.0},\n  {\"id\": 748443, \"suggestedTranslation\": \"Giá mà tôi có ít củi.\", \"rating\": 9.0},\n  {\"id\": 748444, \"suggestedTranslation\": \"Tôi không tin tưởng bất kỳ thứ ma thuật nào cả.\", \"rating\": 9.0},\n  {\"id\": 748445, \"suggestedTranslation\": \"Nó thèm củi.\", \"rating\": 9.0},\n  {\"id\": 748446, \"suggestedTranslation\": \"Đồ lười biếng.\", \"rating\": 9.0},\n  {\"id\": 748447, \"suggestedTranslation\": \"Cứu lấy những bóng cây!\", \"rating\": 9.0},\n  {\"id\": 748448, \"suggestedTranslation\": \"Trông giống cá tuyết.\", \"rating\": 9.0},\n  {\"id\": 748449, \"suggestedTranslation\": \"Tôi giăng một chiếc lưới lớn.\", \"rating\": 9.0},\n  {\"id\": 748450, \"suggestedTranslation\": \"Tôi nên dành chút thời gian ở hồ.\", \"rating\": 9.0},\n  {\"id\": 748451, \"suggestedTranslation\": \"Tôi thích cá hồi hơn.\", \"rating\": 9.0},\n  {\"id\": 748452, \"suggestedTranslation\": \"Ước gì mình có ít khoai tây chiên.\", \"rating\": 9.0},\n  {\"id\": 748453, \"suggestedTranslation\": \"Đỉnh hơn thịt khô chim.\", \"rating\": 9.0},\n  {\"id\": 748454, \"suggestedTranslation\": \"Mong là tôi không thu hút gấu.\", \"rating\": 9.0},\n  {\"id\": 748455, \"suggestedTranslation\": \"Trông được đấy chứ.\", \"rating\": 9.0},\n  {\"id\": 748456, \"suggestedTranslation\": \"Đỉnh hơn thịt khô chim.\", \"rating\": 9.0},\n  {\"id\": 748457, \"suggestedTranslation\": \"Bữa ăn thanh lịch trong hộp.\", \"rating\": 9.0},\n  {\"id\": 748458, \"suggestedTranslation\": \"Vị cứ như biển cả ấy nhỉ?\", \"rating\": 9.0},\n  {\"id\": 748459, \"suggestedTranslation\": \"Làm tôi nhớ đến những xưởng đánh bắt cá hồi cũ.\", \"rating\": 9.0},\n  {\"id\": 748460, \"suggestedTranslation\": \"Ăn kèm chút khoai tây chiên thì ngon.\", \"rating\": 9.0},\n  {\"id\": 748461, \"suggestedTranslation\": \"Cái này có thể làm đầu rìu.\", \"rating\": 9.0},\n  {\"id\": 748462, \"suggestedTranslation\": \"Kiểu gì thì lúc nào cũng phải hạ cánh.\", \"rating\": 9.0},\n  {\"id\": 748463, \"suggestedTranslation\": \"Ồ, đẹp thật đấy.\", \"rating\": 9.0},\n  {\"id\": 748464, \"suggestedTranslation\": \"Tôi nóng lòng muốn thắp sáng nó lên rồi.\", \"rating\": 9.0},\n  {\"id\": 748465, \"suggestedTranslation\": \"Vẫn còn chỗ cho cả hai chúng ta đấy, Luce.\", \"rating\": 9.0},\n  {\"id\": 748466, \"suggestedTranslation\": \"Đẹp phết.\", \"rating\": 9.0},\n  {\"id\": 748467, \"suggestedTranslation\": \"Chặt cái này chả đã tay gì cả.\", \"rating\": 9.0},\n  {\"id\": 748468, \"suggestedTranslation\": \"Tôi nghĩ hoa dại rất hợp với mái tóc đỏ của mình.\", \"rating\": 9.0},\n  {\"id\": 748469, \"suggestedTranslation\": \"Tốt cho sức khỏe, nhưng không chắc chắn lắm.\", \"rating\": 9.0},\n  {\"id\": 748470, \"suggestedTranslation\": \"Lấp lánh!\", \"rating\": 9.0},\n  {\"id\": 748471, \"suggestedTranslation\": \"Nó sắp tàn rồi.\", \"rating\": 9.0},\n  {\"id\": 748472, \"suggestedTranslation\": \"Có gì đó không ổn với bông hoa đó.\", \"rating\": 9.0},\n  {\"id\": 748473, \"suggestedTranslation\": \"Ai đó có ngón tay nâu rồi.\", \"rating\": 9.0},\n  {\"id\": 748474, \"suggestedTranslation\": \"Trông như món salad.\", \"rating\": 9.0},\n  {\"id\": 748475, \"suggestedTranslation\": \"Thơm dễ chịu.\", \"rating\": 9.0},\n  {\"id\": 748476, \"suggestedTranslation\": \"Cái này có làm tóc tôi giống vận động viên khúc côn cầu không?\", \"rating\": 9.0},\n  {\"id\": 748477, \"suggestedTranslation\": \"Đúng là buồn cười khi vài kẻ gọi đây là \\\"cỏ dại\\\". Tôi thấy nó đẹp mà!\", \"rating\": 9.0},\n  {\"id\": 748478, \"suggestedTranslation\": \"Thơm dễ chịu.\", \"rating\": 9.0},\n  {\"id\": 748479, \"suggestedTranslation\": \"Vest tuxedo kiểu Canada trông hơi khác một chút.\", \"rating\": 9.0},\n  {\"id\": 748480, \"suggestedTranslation\": \"Dễ vỡ.\", \"rating\": 9.0},\n  {\"id\": 748481, \"suggestedTranslation\": \"Quái vật đã được lắp ráp hoàn chỉnh một trăm phần trăm.\", \"rating\": 9.0},\n  {\"id\": 748482, \"suggestedTranslation\": \"Hừm... Chúng ta thử lại nhé, Lucy?\", \"rating\": 9.0},\n  {\"id\": 748483, \"suggestedTranslation\": \"Trông có vẻ vẫn còn việc phải làm.\", \"rating\": 9.0},\n  {\"id\": 748484, \"suggestedTranslation\": \"Tôi có thể rưới xi -rô phong lên đó chứ?\", \"rating\": 9.0},\n  {\"id\": 748485, \"suggestedTranslation\": \"Thấy chưa? Chúng ta đều có thể hòa hợp với nhau mà.\", \"rating\": 9.0},\n  {\"id\": 748486, \"suggestedTranslation\": \"Cựu ếch.\", \"rating\": 9.0},\n  {\"id\": 748487, \"suggestedTranslation\": \"Tôi không tin tưởng bất cứ thứ gì không quyết định được giữa không khí và nước.\", \"rating\": 9.0},\n  {\"id\": 748488, \"suggestedTranslation\": \"Nó mệt rồi.\", \"rating\": 9.0},\n  {\"id\": 748489, \"suggestedTranslation\": \"Tôi không phải kiểu người chê bai bữa ăn đâu.\", \"rating\": 9.0},\n  {\"id\": 748490, \"suggestedTranslation\": \"Bạn thực sự có thể nếm được mùi đầm lầy.\", \"rating\": 9.0},\n  {\"id\": 748491, \"suggestedTranslation\": \"Chúng vẫn đang nhảy kìa!\", \"rating\": 9.0},\n  {\"id\": 748492, \"suggestedTranslation\": \"Ít ra chúng cũng đã ngừng cử động.\", \"rating\": 9.0},\n  {\"id\": 748493, \"suggestedTranslation\": \"Quả vả che lấp đi vị đầm lầy.\", \"rating\": 9.0},\n  {\"id\": 748494, \"suggestedTranslation\": \"Không gì bằng việc thư giãn với một ly đồ uống lạnh, nhỉ?\", \"rating\": 9.0},\n  {\"id\": 748495, \"suggestedTranslation\": \"Chỉ là một sinh vật nhỏ ngọt ngào.\", \"rating\": 9.0},\n  {\"id\": 748496, \"suggestedTranslation\": \"Từ trước đến nay mày luôn sặc sỡ thế à?\", \"rating\": 9.0},\n  {\"id\": 748497, \"suggestedTranslation\": \"Tôi sẽ để nó nghỉ ngơi.\", \"rating\": 9.0},\n  {\"id\": 748498, \"suggestedTranslation\": \"Mấy cái cây đã làm gì mi chứ, hả?\", \"rating\": 9.0},\n  {\"id\": 748499, \"suggestedTranslation\": \"Mấy con ruồi trái cây đó có vẻ rất thích thứ này.\", \"rating\": 9.0},\n  {\"id\": 748500, \"suggestedTranslation\": \"Ngâm trong xi -rô!\", \"rating\": 9.0},\n  {\"id\": 748501, \"suggestedTranslation\": \"Trông có vẻ sắp gãy đến nơi rồi. Luce... em đang cười đấy à?\", \"rating\": 9.0},\n  {\"id\": 748502, \"suggestedTranslation\": \"Nó rất nóng, nhưng tôi hứa là không bằng một góc của em đâu, Lucy!\", \"rating\": 9.0},\n  {\"id\": 748503, \"suggestedTranslation\": \"Tắt ngấm rồi à?\", \"rating\": 9.0},\n  {\"id\": 748504, \"suggestedTranslation\": \"Xin lỗi nhé, Lucy! Ngoài trời lạnh cóng mà!\", \"rating\": 9.0},\n  {\"id\": 748505, \"suggestedTranslation\": \"Trông có vẻ sắp gãy đến nơi rồi.\", \"rating\": 9.0},\n  {\"id\": 748506, \"suggestedTranslation\": \"Trông nóng đấy, nhưng hoàn thành công việc nhanh chóng.\", \"rating\": 9.0},\n  {\"id\": 748507, \"suggestedTranslation\": \"Tắt ngấm rồi à?\", \"rating\": 9.0},\n  {\"id\": 748508, \"suggestedTranslation\": \"Cảm giác như mặc một chiếc quần dài ấm áp khi làm việc vậy.\", \"rating\": 9.0},\n  {\"id\": 748509, \"suggestedTranslation\": \"Trông có vẻ sắp gãy đến nơi rồi.\", \"rating\": 9.0},\n  {\"id\": 748510, \"suggestedTranslation\": \"Trông nóng đấy, nhưng hoàn thành công việc nhanh chóng.\", \"rating\": 9.0},\n  {\"id\": 748511, \"suggestedTranslation\": \"Tắt ngấm rồi à?\", \"rating\": 9.0},\n  {\"id\": 748512, \"suggestedTranslation\": \"Cảm giác như mặc một chiếc quần dài ấm áp khi làm việc vậy.\", \"rating\": 9.0},\n  {\"id\": 748513, \"suggestedTranslation\": \"Trông có vẻ sắp gãy đến nơi rồi.\", \"rating\": 9.0},\n  {\"id\": 748514, \"suggestedTranslation\": \"Trông nóng đấy, nhưng hoàn thành công việc nhanh chóng.\", \"rating\": 9.0},\n  {\"id\": 748515, \"suggestedTranslation\": \"Tắt ngấm rồi à?\", \"rating\": 9.0},\n  {\"id\": 748516, \"suggestedTranslation\": \"Cảm giác như mặc một chiếc quần dài ấm áp khi làm việc vậy.\", \"rating\": 9.0},\n  {\"id\": 748517, \"suggestedTranslation\": \"Trông có vẻ sắp gãy đến nơi rồi.\", \"rating\": 9.0},\n  {\"id\": 748518, \"suggestedTranslation\": \"Trông nóng đấy, nhưng hoàn thành công việc nhanh chóng.\", \"rating\": 9.0},\n  {\"id\": 748519, \"suggestedTranslation\": \"Tắt ngấm rồi à?\", \"rating\": 9.0},\n  {\"id\": 748520, \"suggestedTranslation\": \"Cảm giác như mặc một chiếc quần dài ấm áp khi làm việc vậy.\", \"rating\": 9.0},\n  {\"id\": 748521, \"suggestedTranslation\": \"Suỵt! Sinh Vật Lạ có lẽ vẫn còn quanh đây.\", \"rating\": 9.0},\n  {\"id\": 748522, \"suggestedTranslation\": \"Trời ạ, nơi này đầy rẫy những sinh vật bóng tối!\", \"rating\": 9.0},\n  {\"id\": 748523, \"suggestedTranslation\": \"Cái đó không ổn chút nào...\", \"rating\": 9.0},\n  {\"id\": 748524, \"suggestedTranslation\": \"Đáng tiếc thật đấy, bạn hiền.\", \"rating\": 9.0},\n  {\"id\": 748525, \"suggestedTranslation\": \"Hừm. Chắc tình hình của mình chưa đến nỗi tệ.\", \"rating\": 9.0},\n  {\"id\": 748526, \"suggestedTranslation\": \"Cây nhà lá vườn.\", \"rating\": 9.0},\n  {\"id\": 748527, \"suggestedTranslation\": \"Lucy đã giúp.\", \"rating\": 9.0},\n  {\"id\": 748528, \"suggestedTranslation\": \"Không gì bằng thật nhiều tỏi tươi nhỉ?\", \"rating\": 9.0},\n  {\"id\": 748529, \"suggestedTranslation\": \"Trông giống hạt giống cây trồng mới đối với tôi.\", \"rating\": 9.0},\n  {\"id\": 748530, \"suggestedTranslation\": \"Thực sự giải nhiệt cho người ta.\", \"rating\": 9.0},\n  {\"id\": 748531, \"suggestedTranslation\": \"Tôi chưa bao giờ hiểu nổi mấy thứ này.\", \"rating\": 9.0},\n  {\"id\": 748532, \"suggestedTranslation\": \"Nó giống như hắc ín kỳ lạ nào đó.\", \"rating\": 9.0},\n  {\"id\": 748533, \"suggestedTranslation\": \"Tôi không nghĩ chúng có thể thở trong đó.\", \"rating\": 9.0},\n  {\"id\": 748534, \"suggestedTranslation\": \"Hừm, có đáng để câu nó lên không nhỉ?\", \"rating\": 9.0},\n  {\"id\": 748535, \"suggestedTranslation\": \"Trông có vẻ mạnh đấy.\", \"rating\": 9.0},\n  {\"id\": 748536, \"suggestedTranslation\": \"Ai lại muốn ăn thứ đó lúc này chứ?\", \"rating\": 9.0},\n  {\"id\": 748537, \"suggestedTranslation\": \"Nó có nhiệm vụ giữ cho bữa trưa của chúng ta khỏi bị hỏng phải không?\", \"rating\": 9.0},\n  {\"id\": 748538, \"suggestedTranslation\": \"Tôi có ký ức không mấy tốt đẹp về đống nhầy nhụa đó.\", \"rating\": 9.0},\n  {\"id\": 748539, \"suggestedTranslation\": \"Nó sẽ cần một viên ngọc.\", \"rating\": 9.0},\n  {\"id\": 748540, \"suggestedTranslation\": \"Trông có vẻ đã sẵn sàng.\", \"rating\": 9.0},\n  {\"id\": 748541, \"suggestedTranslation\": \"Làm ngay bây giờ còn hơn hối hận về sau nhỉ?\", \"rating\": 9.0},\n  {\"id\": 748542, \"suggestedTranslation\": \"Nó chết chắc rồi.\", \"rating\": 9.0},\n  {\"id\": 748543, \"suggestedTranslation\": \"Ôi chao.\", \"rating\": 9.0},\n  {\"id\": 748544, \"suggestedTranslation\": \"Tất cả chúng ta đều kết nối với nhau phải không?\", \"rating\": 9.0},\n  {\"id\": 748545, \"suggestedTranslation\": \"Có một con trong đó phải không?\", \"rating\": 9.0},\n  {\"id\": 748546, \"suggestedTranslation\": \"Trông trống rỗng.\", \"rating\": 9.0},\n  {\"id\": 748547, \"suggestedTranslation\": \"Trông có vẻ như mấy thứ này đang mạnh lên.\", \"rating\": 9.0},\n  {\"id\": 748548, \"suggestedTranslation\": \"Chúng không vui với chúng ta đâu, Lucy.\", \"rating\": 9.0},\n  {\"id\": 748549, \"suggestedTranslation\": \"Hù! Ha ha!\", \"rating\": 9.0},\n  {\"id\": 748550, \"suggestedTranslation\": \"Con ma đó để lại một gói quà chia tay.\", \"rating\": 9.0},\n  {\"id\": 748551, \"suggestedTranslation\": \"Tôi không sợ đội nó đâu, Lucy. Chỉ là tôi không có hứng thôi.\", \"rating\": 9.0},\n  {\"id\": 748552, \"suggestedTranslation\": \"Trời ơi, mùi như cá hồi đỏ để cả tuần!\", \"rating\": 9.0},\n  {\"id\": 748553, \"suggestedTranslation\": \"Trời ơi, mùi như cá hồi đỏ để cả tuần!\", \"rating\": 9.0},\n  {\"id\": 748554, \"suggestedTranslation\": \"Trời ơi, mùi như cá hồi đỏ để cả tuần!\", \"rating\": 9.0},\n  {\"id\": 748555, \"suggestedTranslation\": \"Trời ơi, mùi như cá hồi đỏ để cả tuần!\", \"rating\": 9.0},\n  {\"id\": 748556, \"suggestedTranslation\": \"Trời ơi, mùi như cá hồi đỏ để cả tuần!\", \"rating\": 9.0},\n  {\"id\": 748557, \"suggestedTranslation\": \"Trời ơi, mùi như cá hồi đỏ để cả tuần!\", \"rating\": 9.0},\n  {\"id\": 748558, \"suggestedTranslation\": \"Trời ơi, mùi như cá hồi đỏ để cả tuần!\", \"rating\": 9.0},\n  {\"id\": 748559, \"suggestedTranslation\": \"Trời ơi, mùi như cá hồi đỏ để cả tuần!\", \"rating\": 9.0},\n  {\"id\": 748560, \"suggestedTranslation\": \"Trời ơi, mùi như cá hồi đỏ để cả tuần!\", \"rating\": 9.0},\n  {\"id\": 748561, \"suggestedTranslation\": \"Tặng quà vui không kém gì nhận quà đâu.\", \"rating\": 9.0},\n  {\"id\": 748562, \"suggestedTranslation\": \"Chúng ta nên làm gì đó tuyệt vời vào hôm nay chứ, Lucy?\", \"rating\": 9.0},\n  {\"id\": 748563, \"suggestedTranslation\": \"Tôi thích những ngôi nhà làm bằng gỗ hơn.\", \"rating\": 9.0},\n  {\"id\": 748564, \"suggestedTranslation\": \"Mày đi đâu đấy hả?\", \"rating\": 9.0},\n  {\"id\": 748565, \"suggestedTranslation\": \"Không giống bất kỳ con chó nào tôi từng thấy.\", \"rating\": 9.0},\n  {\"id\": 748566, \"suggestedTranslation\": \"Chà, nó không phải bằng gỗ.\", \"rating\": 9.0},\n  {\"id\": 748567, \"suggestedTranslation\": \"Cầm nó trên tay làm tôi thấy an toàn hẳn.\", \"rating\": 9.0},\n  {\"id\": 748568, \"suggestedTranslation\": \"Không biết nó có chặt được không nhỉ.\", \"rating\": 9.0},\n  {\"id\": 748569, \"suggestedTranslation\": \"Cứ vỗ cánh tiếp đi, chú em!\", \"rating\": 9.0},\n  {\"id\": 748570, \"suggestedTranslation\": \"Ngủ ngon nhé, bạn hiền.\", \"rating\": 9.0},\n  {\"id\": 748571, \"suggestedTranslation\": \"Đã chết mà vẫn nhầy nhụa.\", \"rating\": 9.0},\n  {\"id\": 748572, \"suggestedTranslation\": \"Đến bông hoa cũng nhầy nhụa nữa.\", \"rating\": 9.0},\n  {\"id\": 748573, \"suggestedTranslation\": \"Phải, chất nhầy của nó cũng nhầy nốt.\", \"rating\": 9.0},\n  {\"id\": 748574, \"suggestedTranslation\": \"Không có gì ngạc nhiên khi đôi cánh cũng nhầy nhụa.\", \"rating\": 9.0},\n  {\"id\": 748575, \"suggestedTranslation\": \"Trời ơi tôi rất muốn đánh chén món đó đấy.\", \"rating\": 9.0},\n  {\"id\": 748576, \"suggestedTranslation\": \"Hết cứng đầu nổi rồi phải không?\", \"rating\": 9.0},\n  {\"id\": 748577, \"suggestedTranslation\": \"Xin lỗi vì cái sừng nhé, bạn hiền.\", \"rating\": 9.0},\n  {\"id\": 748578, \"suggestedTranslation\": \"Tôi có cách đối phó với thiên nhiên đấy.\", \"rating\": 9.0},\n  {\"id\": 748579, \"suggestedTranslation\": \"Thứ đó trông có vẻ gây ra chút sát thương đấy.\", \"rating\": 9.0},\n  {\"id\": 748580, \"suggestedTranslation\": \"Chưa từng thấy con cá nào có sừng bao giờ.\", \"rating\": 9.0},\n  {\"id\": 748581, \"suggestedTranslation\": \"Tôi nghĩ dòng điện đã làm nó kết tủa rồi.\", \"rating\": 9.0},\n  {\"id\": 748582, \"suggestedTranslation\": \"Có vẻ khá vô dụng.\", \"rating\": 9.0},\n  {\"id\": 748583, \"suggestedTranslation\": \"Nó gần như tuyệt vời bằng Lucy vậy.\", \"rating\": 9.0},\n  {\"id\": 748584, \"suggestedTranslation\": \"Nó đẹp đấy, nhưng không chặt được cây.\", \"rating\": 9.0},\n  {\"id\": 748585, \"suggestedTranslation\": \"Chà. Tôi không thể biến nó lại như cũ được, nên...\", \"rating\": 9.0},\n  {\"id\": 748586, \"suggestedTranslation\": \"Đã đến lúc đào những cái hố vàng rồi.\", \"rating\": 9.0},\n  {\"id\": 748587, \"suggestedTranslation\": \"Giờ đã làm ra nó rồi thì tận dụng cho tốt thôi.\", \"rating\": 9.0},\n  {\"id\": 748588, \"suggestedTranslation\": \"Bạn không thể làm bàn cà phê từ vàng đâu.\\nỪm, có lẽ làm được. Nhưng không nên làm thế.\", \"rating\": 9.0},\n  {\"id\": 748589, \"suggestedTranslation\": \"Bộ lông mềm mịn như gối.\", \"rating\": 9.0},\n  {\"id\": 748590, \"suggestedTranslation\": \"Tôi cần phải ị lên nó.\", \"rating\": 9.0},\n  {\"id\": 748591, \"suggestedTranslation\": \"Mong là lửa không lan sang mấy cái cây.\", \"rating\": 9.0},\n  {\"id\": 748592, \"suggestedTranslation\": \"Nó nhiễm chút bệnh rồi.\", \"rating\": 9.0},\n  {\"id\": 748593, \"suggestedTranslation\": \"Trông có vẻ ủ rũ.\", \"rating\": 9.0},\n  {\"id\": 748594, \"suggestedTranslation\": \"Trông giống củi khô.\", \"rating\": 9.0},\n  {\"id\": 748595, \"suggestedTranslation\": \"Nó đã bị vặt trụi thùi lùi.\", \"rating\": 9.0},\n  {\"id\": 748596, \"suggestedTranslation\": \"Có lẽ nó sẽ phát triển tốt hơn nếu thời tiết mát mẻ hơn nhỉ?\", \"rating\": 9.0},\n  {\"id\": 748597, \"suggestedTranslation\": \"Không phân biệt được đó là động vật hay một bụi cây cực kỳ sống động nữa.\", \"rating\": 9.0},\n  {\"id\": 748598, \"suggestedTranslation\": \"Trông có vẻ không được khỏe cho lắm.\", \"rating\": 9.0},\n  {\"id\": 748599, \"suggestedTranslation\": \"Con thằn lằn gỗ đâu rồi nhỉ?\", \"rating\": 9.0},\n  {\"id\": 748600, \"suggestedTranslation\": \"Cái đó có thể giữ cho bộ râu của tôi tương đối khô ráo đấy nhỉ?\", \"rating\": 9.0},\n  {\"id\": 748601, \"suggestedTranslation\": \"Đúng thế, trống rỗng.\", \"rating\": 9.0},\n  {\"id\": 748602, \"suggestedTranslation\": \"Nó bị ám rồi!\", \"rating\": 9.0},\n  {\"id\": 748603, \"suggestedTranslation\": \"Nó thực sự làm nổi thuyền ván của tôi.\", \"rating\": 9.0},\n  {\"id\": 748604, \"suggestedTranslation\": \"Tôi có cảm giác hơi kỳ lạ ở quanh mấy thứ này.\", \"rating\": 9.0},\n  {\"id\": 748605, \"suggestedTranslation\": \"Sặc sỡ làm sao.\", \"rating\": 9.0},\n  {\"id\": 748606, \"suggestedTranslation\": \"Điều đó sẽ giúp mọi người nắm bắt được địa hình.\", \"rating\": 9.0},\n  {\"id\": 748607, \"suggestedTranslation\": \"Cái này sẽ giúp tôi tháo dỡ đồ đạc!\", \"rating\": 9.0},\n  {\"id\": 748608, \"suggestedTranslation\": \"Tôi từng ăn những thứ kỳ lạ hơn trong rừng.\", \"rating\": 9.0},\n  {\"id\": 748609, \"suggestedTranslation\": \"Tôi không tin tưởng nó đâu.\", \"rating\": 9.0},\n  {\"id\": 748610, \"suggestedTranslation\": \"Đó là một cây nấm lục.\", \"rating\": 9.0},\n  {\"id\": 748611, \"suggestedTranslation\": \"Chúng có lịch trình riêng của mình.\", \"rating\": 9.0},\n  {\"id\": 748612, \"suggestedTranslation\": \"Tôi sẽ phải kiên nhẫn vậy.\", \"rating\": 9.0},\n  {\"id\": 748613, \"suggestedTranslation\": \"Trông gần giống những tảng băng trôi.\", \"rating\": 9.0},\n  {\"id\": 748614, \"suggestedTranslation\": \"Trông gần giống những tảng băng trôi.\", \"rating\": 9.0},\n  {\"id\": 748615, \"suggestedTranslation\": \"Tôi không chắc mình có tin tưởng nó không.\", \"rating\": 9.0},\n  {\"id\": 748616, \"suggestedTranslation\": \"Nó đỡ hôi hơn loại kia.\", \"rating\": 9.0},\n  {\"id\": 748617, \"suggestedTranslation\": \"Chưa bao giờ thích thứ này.\", \"rating\": 9.0},\n  {\"id\": 748618, \"suggestedTranslation\": \"Cả cái que cũng ngon nữa.\", \"rating\": 9.0},\n  {\"id\": 748619, \"suggestedTranslation\": \"Để tôi nói cho bạn nghe nó có vị gì nhé, Lucy.\", \"rating\": 9.0},\n  {\"id\": 748620, \"suggestedTranslation\": \"Tan trong miệng, không tan trong tay bạn.\", \"rating\": 9.0},\n  {\"id\": 748621, \"suggestedTranslation\": \"Tôi không phải fan lớn của côn trùng lắm.\", \"rating\": 9.0},\n  {\"id\": 748622, \"suggestedTranslation\": \"Thứ này khá ngon đấy.\", \"rating\": 9.0},\n  {\"id\": 748623, \"suggestedTranslation\": \"Lucy không thích tôi ăn đồ cay.\", \"rating\": 9.0},\n  {\"id\": 748624, \"suggestedTranslation\": \"Đừng lo, tôi sẽ ăn hộ phần của cả hai chúng ta luôn, Lucy.\", \"rating\": 9.0},\n  {\"id\": 748625, \"suggestedTranslation\": \"Chỉ là một bắp ngô bình thường thôi.\", \"rating\": 9.0},\n  {\"id\": 748626, \"suggestedTranslation\": \"Trời ạ. Lắm cái chân cục kẹo thế.\", \"rating\": 9.0},\n  {\"id\": 748627, \"suggestedTranslation\": \"Mấy cái này không bị ói. Tôi thích thế.\", \"rating\": 9.0},\n  {\"id\": 748628, \"suggestedTranslation\": \"Không chắc đó có phải là đồ ăn không nhỉ?\", \"rating\": 9.0},\n  {\"id\": 748629, \"suggestedTranslation\": \"Hừ. Tôi không phiền mấy thứ này lắm.\", \"rating\": 9.0},\n  {\"id\": 748630, \"suggestedTranslation\": \"Để tôi nói cho bạn nghe nó có vị gì nhé, Lucy.\", \"rating\": 9.0},\n  {\"id\": 748631, \"suggestedTranslation\": \"Cũng không tệ lắm nhỉ?\", \"rating\": 9.0},\n  {\"id\": 748632, \"suggestedTranslation\": \"Một thức uống mạnh mẽ tuyệt vời.\", \"rating\": 9.0},\n  {\"id\": 748633, \"suggestedTranslation\": \"Nhiều phết nhỉ.\", \"rating\": 9.0},\n  {\"id\": 748634, \"suggestedTranslation\": \"Không tệ.\", \"rating\": 9.0},\n  {\"id\": 748635, \"suggestedTranslation\": \"Nó sẽ không bao giờ thay thế được một khúc gỗ ngon lành đâu.\", \"rating\": 9.0},\n  {\"id\": 748636, \"suggestedTranslation\": \"Không chắc mình có cần biến đổi gì thêm trong đời nữa không.\", \"rating\": 9.0},\n  {\"id\": 748637, \"suggestedTranslation\": \"Chỉ là đồ giả thôi mà.\", \"rating\": 9.0},\n  {\"id\": 748638, \"suggestedTranslation\": \"Đẹp đấy. Tôi nên treo nó ở đâu đó.\", \"rating\": 9.0},\n  {\"id\": 748639, \"suggestedTranslation\": \"Cái này treo lên cây nào đó thì trông được lắm.\", \"rating\": 9.0},\n  {\"id\": 748640, \"suggestedTranslation\": \"Em muốn trang trí không, Lucy?\", \"rating\": 9.0},\n  {\"id\": 748641, \"suggestedTranslation\": \"Cố chịu đựng nhé.\", \"rating\": 9.0},\n  {\"id\": 748642, \"suggestedTranslation\": \"Ái chà! Chắc tôi rất thích được treo một cái thật như thế.\", \"rating\": 9.0},\n  {\"id\": 748643, \"suggestedTranslation\": \"Thật phí phạm chỗ thịt giăm bông ngon lành.\", \"rating\": 9.0},\n  {\"id\": 748644, \"suggestedTranslation\": \"Ai cũng mắc sai lầm mà phải không?\", \"rating\": 9.0},\n  {\"id\": 748645, \"suggestedTranslation\": \"Tung ra một cú đánh trời giáng.\", \"rating\": 9.0},\n  {\"id\": 748646, \"suggestedTranslation\": \"Nó không được nhồi lông ngỗng phải không?\", \"rating\": 9.0},\n  {\"id\": 748647, \"suggestedTranslation\": \"Ít ra nó không được nhồi lông vũ.\", \"rating\": 9.0},\n  {\"id\": 748648, \"suggestedTranslation\": \"Mùi giống như ngủ ngoài trời vậy.\", \"rating\": 9.0},\n  {\"id\": 748649, \"suggestedTranslation\": \"Vẫn ngon hơn cái loại nhồi đầy lông vũ kinh tởm.\", \"rating\": 9.0},\n  {\"id\": 748650, \"suggestedTranslation\": \"Thách thức đấy à? Được thôi, tôi nhận lời.\", \"rating\": 9.0},\n  {\"id\": 748651, \"suggestedTranslation\": \"Tôi thực sự thích họa tiết sọc kẻ hơn.\", \"rating\": 9.0},\n  {\"id\": 748652, \"suggestedTranslation\": \"Sức khỏe ở dạng chất sệt.\", \"rating\": 9.0},\n  {\"id\": 748653, \"suggestedTranslation\": \"Ôi trời, thứ này có mùi nồng thực sự đấy.\", \"rating\": 9.0},\n  {\"id\": 748654, \"suggestedTranslation\": \"Nếu không chịu được sức nóng, hãy bôi ít kem côn trùng kỳ lạ vào, nhỉ?\", \"rating\": 9.0},\n  {\"id\": 748655, \"suggestedTranslation\": \"Người khác sẽ tận dụng nó tốt hơn.\", \"rating\": 9.0},\n  {\"id\": 748656, \"suggestedTranslation\": \"Nó nguội đi rồi à?\", \"rating\": 9.0},\n  {\"id\": 748657, \"suggestedTranslation\": \"Brrr! Nó đóng băng rồi.\", \"rating\": 9.0},\n  {\"id\": 748658, \"suggestedTranslation\": \"Quê tôi gọi đó là \\\"cục đá ban đêm\\\".\", \"rating\": 9.0},\n  {\"id\": 748659, \"suggestedTranslation\": \"Tôi có thể chặt cây suốt cả mùa đông với thứ đó trong túi đấy!\", \"rating\": 9.0},\n  {\"id\": 748660, \"suggestedTranslation\": \"Nó đang hơi... hâm hấp rồi đấy.\", \"rating\": 9.0},\n  {\"id\": 748661, \"suggestedTranslation\": \"Sẵn sàng tỉa tót chút chứ, Luce?\", \"rating\": 9.0},\n  {\"id\": 748662, \"suggestedTranslation\": \"Hoa hồng mọc nhanh khủng khiếp ở quanh vùng này.\", \"rating\": 9.0},\n  {\"id\": 748663, \"suggestedTranslation\": \"Không thân thiện lắm phải không?\", \"rating\": 9.0},\n  {\"id\": 748664, \"suggestedTranslation\": \"Cái này dùng ở miền Bắc thì tuyệt.\", \"rating\": 9.0},\n  {\"id\": 748665, \"suggestedTranslation\": \"Tôi chưa bao giờ phát cuồng trong đời. Phải không, Luce?\", \"rating\": 9.0},\n  {\"id\": 748666, \"suggestedTranslation\": \"Mong là tôi sẽ biết khi nào nên uống nó.\", \"rating\": 9.0},\n  {\"id\": 748667, \"suggestedTranslation\": \"Nó đến từ mặt trăng phải không?\", \"rating\": 9.0},\n  {\"id\": 748668, \"suggestedTranslation\": \"Có lẽ em nên uống chút này đi, Luce.\", \"rating\": 9.0},\n  {\"id\": 748669, \"suggestedTranslation\": \"Đúng thứ tôi cần.\", \"rating\": 9.0},\n  {\"id\": 748670, \"suggestedTranslation\": \"Hoàn hảo cho một ngày trời nóng.\", \"rating\": 9.0},\n  {\"id\": 748671, \"suggestedTranslation\": \"Thậm chí ngửi còn thấy khỏe khoắn.\", \"rating\": 9.0},\n  {\"id\": 748672, \"suggestedTranslation\": \"Bây giờ nó chỉ là rác thôi.\", \"rating\": 9.0},\n  {\"id\": 748673, \"suggestedTranslation\": \"Ước gì mình có mấy cái này quanh cabin.\", \"rating\": 9.0},\n  {\"id\": 748674, \"suggestedTranslation\": \"Em nghĩ sao, Luce?\", \"rating\": 9.0},\n  {\"id\": 748675, \"suggestedTranslation\": \"Tự hỏi nên chuyển con cua đó đi đâu đây.\", \"rating\": 9.0},\n  {\"id\": 748676, \"suggestedTranslation\": \"Lối tắt đến nhà Pearl.\", \"rating\": 9.0},\n  {\"id\": 748677, \"suggestedTranslation\": \"Pearl pha trà ngon phết.\", \"rating\": 9.0},\n  {\"id\": 748678, \"suggestedTranslation\": \"Rất đáng để chờ đợi.\", \"rating\": 9.0},\n  {\"id\": 748679, \"suggestedTranslation\": \"Ồ, Pearl. Tôi rất tiếc.\", \"rating\": 9.0},\n  {\"id\": 748680, \"suggestedTranslation\": \"Cô ấy không có ở nhà rồi, Lucy.\", \"rating\": 9.0},\n  {\"id\": 748681, \"suggestedTranslation\": \"Trông có vẻ thoải mái.\", \"rating\": 9.0},\n  {\"id\": 748682, \"suggestedTranslation\": \"Thế này thì chẳng ích gì với tôi cả.\", \"rating\": 9.0},\n  {\"id\": 748683, \"suggestedTranslation\": \"Cẩn thận đấy Lucy, không lại rỉ sét bây giờ.\", \"rating\": 9.0},\n  {\"id\": 748684, \"suggestedTranslation\": \"Nó vẫn đang được xây dựng.\", \"rating\": 9.0},\n  {\"id\": 748685, \"suggestedTranslation\": \"Bây giờ nó trông giống một ngôi nhà thực sự rồi.\", \"rating\": 9.0},\n  {\"id\": 748686, \"suggestedTranslation\": \"Nơi này đã qua thời hoàng kim rồi.\", \"rating\": 9.0},\n  {\"id\": 748687, \"suggestedTranslation\": \"Tôi thực sự nên đi giặt quần áo thôi.\", \"rating\": 9.0},\n  {\"id\": 748688, \"suggestedTranslation\": \"Cái đó sẽ làm cho căn cabin cũ kỹ trông tươi tắn hẳn lên.\", \"rating\": 9.0}\n]",
