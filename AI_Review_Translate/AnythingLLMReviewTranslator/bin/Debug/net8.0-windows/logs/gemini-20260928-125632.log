\": 0.0},\n  {\"id\": 746606, \"suggestedTranslation\": \"To đặc biệt để chứa nhiều dưa hơn ở bên trong.\", \"rating\": 0.0},\n  {\"id\": 746607, \"suggestedTranslation\": \"Biết đâu sẽ mọc thành món ăn vặt ngon miệng?\", \"rating\": 0.0},\n  {\"id\": 746608, \"suggestedTranslation\": \"Thực vật cao lớn làm Wolfgang thấy hồi hộp...\", \"rating\": 0.0},\n  {\"id\": 746609, \"suggestedTranslation\": \"Ha! Nhỏ và yếu ớt quá!\", \"rating\": 0.0},\n  {\"id\": 746610, \"suggestedTranslation\": \"Thực vật tồi tệ! Thực vật rất tồi tệ!\", \"rating\": 0.0},\n  {\"id\": 746611, \"suggestedTranslation\": \"Nó cần đá tảng để phát triển.\", \"rating\": 0.0},\n  {\"id\": 746612, \"suggestedTranslation\": \"Cái máy bơm té tát nước.\", \"rating\": 0.0},\n  {\"id\": 746613, \"suggestedTranslation\": \"Cây chắc phải tập tạ nặng lắm mới to thế này!\", \"rating\": 0.0},\n  {\"id\": 746614, \"suggestedTranslation\": \"Rễ cây to quá.\", \"rating\": 0.0},\n  {\"id\": 746615, \"suggestedTranslation\": \"%s sẽ là một đối thủ xứng tầm!\", \"rating\": 0.0},\n  {\"id\": 746616, \"suggestedTranslation\": \"Sao lại nhóm lửa thế, chị đại? Để đánh nhau với chúng à?\", \"rating\": 0.0},\n  {\"id\": 746617, \"suggestedTranslation\": \"Là %s rất khỏe mạnh! Chào nhé!\", \"rating\": 0.0},\n  {\"id\": 746618, \"suggestedTranslation\": \"Thế giới cần chị đại! Wolfgang sẽ đi lấy tim về!\", \"rating\": 0.0},\n  {\"id\": 746619, \"suggestedTranslation\": \"Chị đại %s là kẻ sát nhân!\", \"rating\": 0.0},\n  {\"id\": 746620, \"suggestedTranslation\": \"%s là một người phụ nữ khỏe mạnh, tốt bụng.\", \"rating\": 0.0},\n  {\"id\": 746621, \"suggestedTranslation\": \"Là chiếc mũ sắt vững chãi cho chiến binh dũng mãnh!\", \"rating\": 0.0},\n  {\"id\": 746622, \"suggestedTranslation\": \"À phải rồi, mũ của chị đại. Cô ấy không phiền nếu Wolfgang đội chứ?\", \"rating\": 0.0},\n  {\"id\": 746623, \"suggestedTranslation\": \"Wolfgang chỉ mang khiên để làm phụ kiện thôi.\", \"rating\": 0.0},\n  {\"id\": 746624, \"sugges