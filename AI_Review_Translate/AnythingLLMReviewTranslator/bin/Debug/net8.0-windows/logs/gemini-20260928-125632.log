dTranslation\":\"Blib blup! Blib blup! Blib blup!\",\"rating\":0.0},\n  {\"id\":745891,\"suggestedTranslation\":\"Wolfgang nam tính hơn nhiều.\",\"rating\":0.0},\n  {\"id\":745892,\"suggestedTranslation\":\"Wolfgang đang thèm thịt chim quá!\",\"rating\":0.0},\n  {\"id\":745893,\"suggestedTranslation\":\"Là chú chim màu đỏ xinh xắn.\",\"rating\":0.0},\n  {\"id\":745894,\"suggestedTranslation\":\"Là chú chim ngoan ngoãn trong túi áo.\",\"rating\":0.0},\n  {\"id\":745895,\"suggestedTranslation\":\"Là chú chim màu trắng xinh xắn.\",\"rating\":0.0},\n  {\"id\":745896,\"suggestedTranslation\":\"Là chú chim lông xù. Chú chim dễ thương.\",\"rating\":0.0},\n  {\"id\":745897,\"suggestedTranslation\":\"Sẽ làm cho con bò lông trở nên cứng cáp như sắt thép!\",\"rating\":0.0},\n  {\"id\":745898,\"suggestedTranslation\":\"Cái ghế đáng sợ làm bọn chúng khiếp vía!\",\"rating\":0.0},\n  {\"id\":745899,\"suggestedTranslation\":\"Mọi người nhìn đây! Wolfgang chuẩn bị gánh tạ chết đây!\",\"rating\":0.0},\n  {\"id\":745900,\"suggestedTranslation\":\"Là đá tảng. Có thế mà cũng không hiểu à?\",\"rating\":0.0},\n  {\"id\":745901,\"suggestedTranslation\":\"Hắn thật dũng mãnh! Giống như ta vậy!\",\"rating\":0.0},\n  {\"id\":745902,\"suggestedTranslation\":\"Nó không còn ra mấy quả nhỏ nữa.\",\"rating\":0.0},\n  {\"id\":745903,\"suggestedTranslation\":\"Đang cháy kìa!\",\"rating\":0.0},\n  {\"id\":745904,\"suggestedTranslation\":\"Bụi cây nhỏ bị bệnh rồi!\",\"rating\":0.0},\n  {\"id\":745905,\"suggestedTranslation\":\"Trông không ổn cho lắm.\",\"rating\":0.0},\n  {\"id\":745906,\"suggestedTranslation\":\"Không có thứ quả nào làm khó được bộ hàm cường tráng của Wolfgang đâu!\",\"rating\":0.0},\n  {\"id\":745907,\"suggestedTranslation\":\"Hôm nay không có quả nhỏ nào cả.\",\"rating\":0.0},\n  {\"id\":745908,\"suggestedTranslation\":\"Trời nóng quá đi.\",\"rating\":0.0},\n  {\"id\":745909,\"suggestedTranslation\":\"Sao quả nhỏ này lại làm đau miệng thế nhỉ?\",\"rating\":0.0},\n  {\"id\":745910,\"suggestedTranslation\":\"Đã mềm mại để ăn được rồi đấy.\",\"rating\":0.0},\n  {\"id\":745911,\"suggestedTranslation\":\"Nhũn nhéo và ấm áp. Ngon phết.\",\"rating\":0.0},\n  {\"id\":745912,\"suggestedTranslation\":\"Bụi cây nhỏ vừa bé vừa yếu ớt.\",\"rating\":0.0},\n  {\"id\":745913,\"suggestedTranslation\":\"Cục đá làm bằng nước.\",\"rating\":0.0},\n  {\"id\":745914,\"suggestedTranslation\":\"Ta không cầm được nước.\",\"rating\":0.0},\n  {\"id\":745915,\"suggestedTranslation\":\"Ta không cầm được nước.\",\"rating\":0.0},\n  {\"id\":745916,\"suggestedTranslation\":\"Một đống cục đá sần sùi!\",\"rating\":0.0},\n  {\"id\":745917,\"suggestedTranslation\":\"Trời đang lạnh dần rồi.\",\"rating\":0.0},\n  {\"id\":745918,\"suggestedTranslation\":\"Lửa lỏng đấy!\",\"rating\":0.0},\n  {\"id\":745919,\"suggestedTranslation\":\"Ha! Lại có thêm thứ để đấm phá rồi!\",\"rating\":0.0},\n  {\"id\":745920,\"suggestedTranslation\":\"Nhưng mà không phải phô mai à?\",\"rating\":0.0},\n  {\"id\":745921,\"suggestedTranslation\":\"Giờ thì ta sẽ đấm nó ra bã!\",\"rating\":0.0},\n  {\"id\":745922,\"suggestedTranslation\":\"Giờ thì ta sẽ đấm nó ra bã!\",\"rating\":0.0},\n  {\"id\":745923,\"suggestedTranslation\":\"Con này dám nhảy qua đầu quân hậu này!\",\"rating\":0.0},\n  {\"id\":745924,\"suggestedTranslation\":\"Chẳng thấm vào đâu so với lồng ngực vạm vỡ của ta!\",\"rating\":0.0},\n  {\"id\":745925,\"suggestedTranslation\":\"Chắc chắn! Giống như ta vậy!\",\"rating\":0.0},\n  {\"id\":745926,\"suggestedTranslation\":\"Hứa là nó sẽ giữ cho Wolfgang không bị ngã chết đấy nhé?\",\"rating\":0.0},\n  {\"id\":745927,\"suggestedTranslation\":\"Chỉ dành cho mấy quý cô thích sửa chữa thôi à? Tôn lên đôi mắt của Wolfgang phết chứ đùa.\",\"rating\":0.0}\n]",
