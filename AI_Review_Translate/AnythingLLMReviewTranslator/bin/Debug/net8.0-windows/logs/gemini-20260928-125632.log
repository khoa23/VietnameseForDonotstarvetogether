            "text": "[\n  {\"id\":747477,\"suggestedTranslation\":\"Cho tôi biết nếu mấy cái cây này đang làm phiền cậu nhé - tôi sẽ cho chúng ăn rìu đấy!\",\"rating\":9.0},\n  {\"id\":747478,\"suggestedTranslation\":\"Cậu hay lớn lên ở đây à? Ồ, thôi nào Lucy, câu đó buồn cười mà!\",\"rating\":9.0},\n  {\"id\":747479,\"suggestedTranslation\":\"Thật tuyệt khi được trò chuyện với chiến hữu thân thiết của tôi!\",\"rating\":9.0},\n  {\"id\":747480,\"suggestedTranslation\":\"Ái!\",\"rating\":9.0},\n  {\"id\":747481,\"suggestedTranslation\":\"Chắc là hết dụ dỗ được rồi.\",\"rating\":9.0},\n  {\"id\":747482,\"suggestedTranslation\":\"Hay là lúc khác chúng ta thử lại nhỉ?\",\"rating\":9.0},\n  {\"id\":747483,\"suggestedTranslation\":\"Đúng là đáng tiếc thật. Chắc giờ tôi phải tự thân vận động rồi.\",\"rating\":9.0},\n  {\"id\":747484,\"suggestedTranslation\":\"Có vẻ như nó đang cố thu hút sự chú ý của tôi.\",\"rating\":9.0},\n  {\"id\":747485,\"suggestedTranslation\":\"Chết tiệt. Chắc mất dấu rồi.\",\"rating\":9.0},\n  {\"id\":747486,\"suggestedTranslation\":\"Cậu thấy gì à, bạn hiền?\",\"rating\":9.0},\n  {\"id\":747487,\"suggestedTranslation\":\"Trông có vẻ chẳng có gì quanh đây cả.\",\"rating\":9.0},\n  {\"id\":747488,\"suggestedTranslation\":\"Đi tìm mấy chú mèo con thôi nào, nhỉ?\",\"rating\":9.0},\n  {\"id\":747489,\"suggestedTranslation\":\"Tôi nghĩ nó đang đợi tôi đấy.\",\"rating\":9.0},\n  {\"id\":747490,\"suggestedTranslation\":\"Tên nhiều mụn cóc đó chuồn mất tiêu rồi!\",\"rating\":9.0},\n  {\"id\":747491,\"suggestedTranslation\":\"Nó sắp cúp đuôi chạy trốn rồi kìa.\",\"rating\":9.0},\n  {\"id\":747492,\"suggestedTranslation\":\"Cứ như cơn ác mộng vậy!\",\"rating\":9.0},\n  {\"id\":747493,\"suggestedTranslation\":\"Chắc cái công cụ này không dùng được việc này rồi.\",\"rating\":9.0},\n  {\"id\":747494,\"suggestedTranslation\":\"Đèn của tôi hết sáng rồi!\",\"rating\":9.0},\n  {\"id\":747495,\"suggestedTranslation\":\"Tôi bị dính cát vào râu rồi.\",\"rating\":9.0},\n  {\"id\":747496,\"suggestedTranslation\":\"Úi!\",\"rating\":9.0},\n  {\"id\":747497,\"suggestedTranslation\":\"Ái! Hành động đó không lịch sự chút nào đâu.\",\"rating\":9.0},\n  {\"id\":747498,\"suggestedTranslation\":\"Cậu thấy chứ, Luce? Chúng đang giúp đỡ kìa!\",\"rating\":9.0},\n  {\"id\":747499,\"suggestedTranslation\":\"Bộ cô có ý tưởng nào hay hơn à, Lucy?\",\"rating\":9.0},\n  {\"id\":747500,\"suggestedTranslation\":\"Chà, thế thì tỉnh cả người. Brr.\",\"rating\":9.0},\n  {\"id\":747501,\"suggestedTranslation\":\"Cái đó trông không ổn lắm đâu.\",\"rating\":9.0},\n  {\"id\":747502,\"suggestedTranslation\":\"Chúng ta cần thứ gì đó mạnh hơn, phải không?\",\"rating\":9.0},\n  {\"id\":747503,\"suggestedTranslation\":\"Cân nặng: {weight}\",\"rating\":9.0},\n  {\"id\":747504,\"suggestedTranslation\":\"Cân nặng: {weight}\\nKhông tệ đúng không?\",\"rating\":9.0},\n  {\"id\":747507,\"suggestedTranslation\":\"Đồ sọc ca rô ấm lắm, kể cả khi bị ướt.\",\"rating\":9.0},\n  {\"id\":747508,\"suggestedTranslation\":\"Tôi đang dần ướt sũng rồi đấy, nhỉ?\",\"rating\":9.0},\n  {\"id\":747509,\"suggestedTranslation\":\"Chết tiệt, suýt thì bắt được.\",\"rating\":9.0},\n  {\"id\":747510,\"suggestedTranslation\":\"Ôi. Chắc tôi lệch tâm một chút rồi phải không?\",\"rating\":9.0},\n  {\"id\":747511,\"suggestedTranslation\":\"Tôi sáng rực lên như ngày mùng một tháng Bảy vậy!\",\"rating\":9.0},\n  {\"id\":747512,\"suggestedTranslation\":\"À thì, đằng nào tôi cũng chẳng khác gì một quả bom lửa di động cả.\",\"rating\":9.0},\n  {\"id\":747520,\"suggestedTranslation\":\"Trong đó gớm ghiếc thật đấy!\",\"rating\":9.0},\n  {\"id\":747521,\"suggestedTranslation\":\"Ôi trời. Tôi hy vọng cậu đã sẵn sàng rồi đấy, Lucy.\",\"rating\":9.0},\n  {\"id\":747522,\"suggestedTranslation\":\"Nghe có vẻ là một con hàng nặng ký đấy, Luce?\",\"rating\":9.0},\n  {\"id\":747523,\"suggestedTranslation\":\"Gì thế này?\",\"rating\":9.0},\n  {\"id\":747525,\"suggestedTranslation\":\"Này, tôi nghĩ mình vừa tìm ra một hoa văn mới rồi đấy, Luce!\",\"rating\":9.0},\n  {\"id\":747526,\"suggestedTranslation\":\"Tốt hơn là nên xích lại gần điểm xuất phát một chút, nhỉ?\",\"rating\":9.0},\n  {\"id\":747527,\"suggestedTranslation\":\"Hình như tôi đang quên mất điều gì đó thì phải.\",\"rating\":9.0},\n  {\"id\":747528,\"suggestedTranslation\":\"Tôi nên dọn sạch khu vực xuất phát để nhường chỗ cho các con thuyền khác. Phải lịch sự chứ.\",\"rating\":9.0},\n  {\"id\":747529,\"suggestedTranslation\":\"Mấy chú ngựa chắc đang bận lắm rồi đấy, Luce.\",\"rating\":9.0},\n  {\"id\":747530,\"suggestedTranslation\":\"Tôi đã làm gì nên tội cơ chứ?\",\"rating\":9.0},\n  {\"id\":747531,\"suggestedTranslation\":\"Mùa săn bắt đã mở!\",\"rating\":9.0},\n  {\"id\":747532,\"suggestedTranslation\":\"Mau lại đây nào!\",\"rating\":9.0},\n  {\"id\":747533,\"suggestedTranslation\":\"Rồi tôi sẽ biến ngươi thành thịt xông khói cho coi!\",\"rating\":9.0},\n  {\"id\":747534,\"suggestedTranslation\":\"Đến lúc tận số của ngươi rồi đấy!\",\"rating\":9.0},\n  {\"id\":747535,\"suggestedTranslation\":\"Vì miền Bắc!\",\"rating\":9.0},\n  {\"id\":747536,\"suggestedTranslation\":\"Chuẩn bị tinh thần để bị băm vằm đi!\",\"rating\":9.0},\n  {\"id\":747537,\"suggestedTranslation\":\"Tôi nghĩ thế là đủ rồi đấy.\",\"rating\":9.0},\n  {\"id\":747538,\"suggestedTranslation\":\"Tôi cứ tưởng mọi chuyện sẽ khá hơn cơ.\",\"rating\":9.0},\n  {\"id\":747539,\"suggestedTranslation\":\"Xin lỗi, xin lỗi mà!\",\"rating\":9.0},\n  {\"id\":747540,\"suggestedTranslation\":\"Xin lỗi nhé!\",\"rating\":9.0},\n  {\"id\":747541,\"suggestedTranslation\":\"Hẹn gặp lại vào giờ này ngày mai nhé?\",\"rating\":9.0},\n  {\"id\":747542,\"suggestedTranslation\":\"Cái đó không bình thường chút nào.\",\"rating\":9.0},\n  {\"id\":747543,\"suggestedTranslation\":\"Cái đó không bình thường chút nào.\",\"rating\":9.0},\n  {\"id\":747544,\"suggestedTranslation\":\"Cái đó không bình thường chút nào.\",\"rating\":9.0},\n  {\"id\":747545,\"suggestedTranslation\":\"Cái đó không bình thường chút nào.\",\"rating\":9.0},\n  {\"id\":747546,\"suggestedTranslation\":\"Cái đó không bình thường chút nào.\",\"rating\":9.0},\n  {\"id\":747547,\"suggestedTranslation\":\"Cái đó không bình thường chút nào.\",\"rating\":9.0},\n  {\"id\":747548,\"suggestedTranslation\":\"Đó là một bông hoa à? Chắc vậy.\",\"rating\":9.0},\n  {\"id\":747549,\"suggestedTranslation\":\"Có lẽ chúng ta nên chuồn thôi, nhỉ?\",\"rating\":9.0},\n  {\"id\":747550,\"suggestedTranslation\":\"Tôi không thoải mái với chuyện này chút nào.\",\"rating\":9.0},\n  {\"id\":747551,\"suggestedTranslation\":\"Bông hoa đó trông có vẻ hơi tàn tạ rồi.\",\"rating\":9.0},\n  {\"id\":747552,\"suggestedTranslation\":\"Một bông hoa ma quái... khá là kỳ lạ phải không Lucy?\",\"rating\":9.0},\n  {\"id\":747553,\"suggestedTranslation\":\"Chắc là tôi nên quen với mấy thứ kỳ quặc này từ lâu rồi mới phải.\",\"rating\":9.0},\n  {\"id\":747554,\"suggestedTranslation\":\"Chuẩn luôn. Đó là một bông hoa.\",\"rating\":9.0},\n  {\"id\":747555,\"suggestedTranslation\":\"Bông hoa đó đang hành xử rất lạ đời...\",\"rating\":9.0},\n  {\"id\":747556,\"suggestedTranslation\":\"Nó vừa nhúc nhích phải không nhỉ?\",\"rating\":9.0},\n  {\"id\":747557,\"suggestedTranslation\":\"Tôi biết ngay mà!\",\"rating\":9.0},\n  {\"id\":747558,\"suggestedTranslation\":\"Tôi cũng chẳng thích nó chút nào đâu, Luce.\",\"rating\":9.0},\n  {\"id\":747559,\"suggestedTranslation\":\"Tôi biết rồi, Lucy.\",\"rating\":9.0},\n  {\"id\":747560,\"suggestedTranslation\":\"Tôi thấy nó cứ ra vẻ khoe khoang thế nào ấy.\",\"rating\":9.0},\n  {\"id\":747561,\"suggestedTranslation\":\"Tôi nên trồng nó rồi đốn ngã nó mới được!\",\"rating\":9.0},\n  {\"id\":747562,\"suggestedTranslation\":\"Thật phí hoài một cái cây hoàn hảo.\",\"rating\":9.0},\n  {\"id\":747563,\"suggestedTranslation\":\"Cây cối chuẩn bị mọc lên kìa!\",\"rating\":9.0},\n  {\"id\":747564,\"suggestedTranslation\":\"Tự hỏi không biết đó có phải là lối thoát khỏi đây không.\",\"rating\":9.0},\n  {\"id\":747565,\"suggestedTranslation\":\"Đây là một món đồ đội đầu khá tiện lợi đấy, chỉ có điều giá mà nó bớt thì thầm đi thì tốt.\",\"rating\":9.0},\n  {\"id\":747566,\"suggestedTranslation\":\"Tôi chắc là nó vẫn dùng được việc gì đó.\",\"rating\":9.0},\n  {\"id\":747567,\"suggestedTranslation\":\"Chắc là hắn không mang nó đến sớm hơn được à?\",\"rating\":9.0},\n  {\"id\":747568,\"suggestedTranslation\":\"Có vẻ chúng ta hạ được chúng rồi!\",\"rating\":9.0},\n  {\"id\":747569,\"suggestedTranslation\":\"Này! Đi đứng cẩn thận cái chân vào chứ, hả?\",\"rating\":9.0},\n  {\"id\":747570,\"suggestedTranslation\":\"Lần này trông nó hung dữ hơn đấy, Luce nhỉ?\",\"rating\":9.0},\n  {\"id\":747571,\"suggestedTranslation\":\"Chắc chắn đó là thứ mà hắn đang tìm kiếm rồi.\",\"rating\":9.0},\n  {\"id\":747572,\"suggestedTranslation\":\"Và nằm im đấy nhé, chịu chưa?\",\"rating\":9.0},\n  {\"id\":747573,\"suggestedTranslation\":\"Tôi có cảm giác nó chẳng ưa gì chúng ta chút nào đâu, Luce ạ.\",\"rating\":9.0},\n  {\"id\":747574,\"suggestedTranslation\":\"Nó đang cố nhốt chúng ta lại kìa!\",\"rating\":9.0},\n  {\"id\":747575,\"suggestedTranslation\":\"Chà, quá tam ba bận mà, phải không?\",\"rating\":9.0},\n  {\"id\":747576,\"suggestedTranslation\":\"Thế là giải quyết xong xuôi nhé!\",\"rating\":9.0},\n  {\"id\":747577,\"suggestedTranslation\":\"Này! Cẩn thận đấy nhé, bạn hiền!\",\"rating\":9.0},\n  {\"id\":747578,\"suggestedTranslation\":\"Bây giờ chắc không phải lúc để tranh thủ làm một giấc đâu.\",\"rating\":9.0},\n  {\"id\":747579,\"suggestedTranslation\":\"Cái quái gì mà sáng rực như cực quang thế kia?!\",\"rating\":9.0},\n  {\"id\":747580,\"suggestedTranslation\":\"Lúc nào cũng phải có phương án dự phòng.\",\"rating\":9.0},\n  {\"id\":747581,\"suggestedTranslation\":\"Cái này nặng thật đấy.\",\"rating\":9.0},\n  {\"id\":747582,\"suggestedTranslation\":\"Bỏ ra chút công sức nữa là chúng ta sẽ có dây neo ngay.\",\"rating\":9.0},\n  {\"id\":747583,\"suggestedTranslation\":\"Có lẽ nướng lên sẽ làm nó mềm ra nhỉ?\",\"rating\":9.0},\n  {\"id\":747584,\"suggestedTranslation\":\"Không. Không thích cái vẻ ngoài đó tí nào.\",\"rating\":9.0},\n  {\"id\":747585,\"suggestedTranslation\":\"Còn gì khác để ăn nữa không nhỉ?\",\"rating\":9.0},\n  {\"id\":747586,\"suggestedTranslation\":\"Ồ, Lucy. Đây không phải loại cây của cậu đâu.\",\"rating\":9.0},\n  {\"id\":747587,\"suggestedTranslation\":\"Đây không phải là tác phẩm của một chiếc rìu đâu.\",\"rating\":9.0},\n  {\"id\":747588,\"suggestedTranslation\":\"Ban ngày mà trông cũng ma quái chẳng kém.\",\"rating\":9.0},\n  {\"id\":747589,\"suggestedTranslation\":\"Biến đi cho khuất mắt, cái cây ma quái ạ.\",\"rating\":9.0},\n  {\"id\":747590,\"suggestedTranslation\":\"Sớm thôi, Lucy. Sớm thôi.\",\"rating\":9.0},\n  {\"id\":747591,\"suggestedTranslation\":\"Có lẽ bây giờ không phải mùa cây lớn nhỉ?\",\"rating\":9.0},\n  {\"id\":747592,\"suggestedTranslation\":\"Tôi không nghĩ đây là chỗ dành cho nó đâu.\",\"rating\":9.0},\n  {\"id\":747593,\"suggestedTranslation\":\"Rồi cuối cùng cậu muốn được chặt ở chỗ nào cơ chứ?\",\"rating\":9.0},\n  {\"id\":747594,\"suggestedTranslation\":\"Tôi biết cậu cũng hy vọng nó là một cây gỗ đấy, Luce. Tôi cũng thế.\",\"rating\":9.0},\n  {\"id\":747595,\"suggestedTranslation\":\"Có những vết rìu trên mấy hòn đá bệ thờ này.\",\"rating\":9.0},\n  {\"id\":747596,\"suggestedTranslation\":\"Trông có vẻ hơi sờn cũ rồi.\",\"rating\":9.0},\n  {\"id\":747597,\"suggestedTranslation\":\"Tôi thậm chí còn chẳng thể hiểu nổi chuyện gì đã xảy ra ở đây nữa.\",\"rating\":9.0},\n  {\"id\":747598,\"suggestedTranslation\":\"Lại thêm một tên đần nữa.\",\"rating\":9.0},\n  {\"id\":747599,\"suggestedTranslation\":\"Một sinh vật rừng lớn đã đi qua đây!\",\"rating\":9.0},\n  {\"id\":747600,\"suggestedTranslation\":\"Mấy con đó trông cứ sai sai thế nào ấy.\",\"rating\":9.0},\n  {\"id\":747601,\"suggestedTranslation\":\"Ngoài này nuôi mấy con này to thật đấy, nhỉ?\",\"rating\":9.0},\n  {\"id\":747602,\"suggestedTranslation\":\"Con quái vật đó đang cực kỳ bực bội đấy.\",\"rating\":9.0},\n  {\"id\":747603,\"suggestedTranslation\":\"Trông nó có vẻ dễ chiều đấy.\",\"rating\":9.0},\n  {\"id\":747604,\"suggestedTranslation\":\"Dùng cái này rõ ràng đỡ khổ hơn dùng chĩa nhiều, nhỉ?\",\"rating\":9.0},\n  {\"id\":747605,\"suggestedTranslation\":\"Có thể đem cho mấy tên cát bụi nào đó.\",\"rating\":9.0},\n  {\"id\":747606,\"suggestedTranslation\":\"Tôi nghĩ chúng ta đang đột nhập rồi đấy.\",\"rating\":9.0},\n  {\"id\":747607,\"suggestedTranslation\":\"Cả cái nơi này la liệt mấy thứ này luôn!\",\"rating\":9.0},\n  {\"id\":747608,\"suggestedTranslation\":\"Cháy đen thui luôn rồi.\",\"rating\":9.0},\n  {\"id\":747609,\"suggestedTranslation\":\"Sẽ phải đợi thêm lúc nữa đấy, nhỉ?\",\"rating\":9.0},\n  {\"id\":747610,\"suggestedTranslation\":\"Ôi trời! Nó đến kìa!\",\"rating\":9.0},\n  {\"id\":747611,\"suggestedTranslation\":\"Đến giờ ăn tối rồi!\",\"rating\":9.0},\n  {\"id\":747612,\"suggestedTranslation\":\"Tôi đoán là cái này lâu lắm rồi không được dùng tới.\",\"rating\":9.0},\n  {\"id\":747613,\"suggestedTranslation\":\"Hả. Có cái quái gì đang lổn nhổn trong đó ấy.\",\"rating\":9.0},\n  {\"id\":747614,\"suggestedTranslation\":\"Chà, ngạc nhiên chưa kìa! Nó chỉ cần thêm chút năng lượng thôi.\",\"rating\":9.0},\n  {\"id\":747615,\"suggestedTranslation\":\"Đúng là một món đồ kỳ cục. Tiếc là nó chẳng hoạt động.\",\"rating\":9.0},\n  {\"id\":747616,\"suggestedTranslation\":\"Mấy bức tượng vác trăng tròn đúng là chịu phần thiệt thòi nhất nhỉ?\",\"rating\":9.0},\n  {\"id\":747617,\"suggestedTranslation\":\"Đúng là một chiếc sàn nhà sang trọng, phải không?\",\"rating\":9.0},\n  {\"id\":747618,\"suggestedTranslation\":\"Chắc cái cửa đó đóng vĩnh viễn luôn rồi.\",\"rating\":9.0},\n  {\"id\":747619,\"suggestedTranslation\":\"Này Lucy, biết đâu đó là đường ra khỏi đây thì sao!\",\"rating\":9.0},\n  {\"id\":747620,\"suggestedTranslation\":\"Không chắc nó dẫn đi đâu, nhưng cứ dò theo xem sao.\",\"rating\":9.0},\n  {\"id\":747621,\"suggestedTranslation\":\"Chẳng còn manh mối nào để dò theo nữa.\",\"rating\":9.0},\n  {\"id\":747622,\"suggestedTranslation\":\"Nó đang rung lên với thứ năng lượng gì đó.\",\"rating\":9.0},\n  {\"id\":747623,\"suggestedTranslation\":\"Đúng là một phen đau đầu suy nghĩ đây.\",\"rating\":9.0},\n  {\"id\":747624,\"suggestedTranslation\":\"Tiếng Pháp tôi còn chưa tài nào hiểu nổi, đừng hòng bắt tôi đọc cái đó.\",\"rating\":9.0},\n  {\"id\":747625,\"suggestedTranslation\":\"Đúng là một phen đau đầu suy nghĩ đây.\",\"rating\":9.0},\n  {\"id\":747626,\"suggestedTranslation\":\"Tiếng Pháp tôi còn chưa tài nào hiểu nổi, đừng hòng bắt tôi đọc cái đó.\",\"rating\":9.0},\n  {\"id\":747627,\"suggestedTranslation\":\"Đúng là một phen đau đầu suy nghĩ đây.\",\"rating\":9.0},\n  {\"id\":747628,\"suggestedTranslation\":\"Tôi không chắc mình thích cái vẻ ngoài của nó lắm đâu.\",\"rating\":9.0},\n  {\"id\":747629,\"suggestedTranslation\":\"Cái thứ này chẳng có chuyển động gì sất.\",\"rating\":9.0},\n  {\"id\":747630,\"suggestedTranslation\":\"Này Luce, chúng ta có nên lo lắng về cái đó không nhỉ?\",\"rating\":9.0},\n  {\"id\":747631,\"suggestedTranslation\":\"Có ai có viên ngọc nào thừa không?\",\"rating\":9.0},\n  {\"id\":747632,\"suggestedTranslation\":\"Có vẻ cái này đã được thiết lập sẵn rồi.\",\"rating\":9.0},\n  {\"id\":747633,\"suggestedTranslation\":\"Áo sọc ca rô là món giáp duy nhất tôi cần.\",\"rating\":9.0},\n  {\"id\":747634,\"suggestedTranslation\":\"Lucy bảo màu đen không hợp với tôi.\",\"rating\":9.0},\n  {\"id\":747635,\"suggestedTranslation\":\"Vẫn đỡ hơn là không có gì.\",\"rating\":9.0},\n  {\"id\":747636,\"suggestedTranslation\":\"Thật khó để vung rìu khi mặc món đồ này.\",\"rating\":9.0},\n  {\"id\":747637,\"suggestedTranslation\":\"Cái đó sẽ chặn được sát thương đấy.\",\"rating\":9.0},\n  {\"id\":747638,\"suggestedTranslation\":\"Dính chặt lấy xương sườn luôn đấy.\",\"rating\":9.0},\n  {\"id\":747639,\"suggestedTranslation\":\"Nhột quá. Tôi nghĩ nó vẫn còn sống đấy.\",\"rating\":9.0},\n  {\"id\":747640,\"suggestedTranslation\":\"Cẩn thận bao nhiêu cũng không thừa đâu.\",\"rating\":9.0},\n  {\"id\":747641,\"suggestedTranslation\":\"Nó có họa tiết sọc ca rô không nhỉ?\",\"rating\":9.0},\n  {\"id\":747642,\"suggestedTranslation\":\"Nó vừa vặn với tôi làm sao!\",\"rating\":9.0},\n  {\"id\":747643,\"suggestedTranslation\":\"Các biện pháp an toàn hoàn toàn tự nhiên.\",\"rating\":9.0},\n  {\"id\":747644,\"suggestedTranslation\":\"Chiếc áo cà rốt đẹp phết.\",\"rating\":9.0},\n  {\"id\":747645,\"suggestedTranslation\":\"Bộ giáp hữu cơ cứng cáp.\",\"rating\":9.0},\n  {\"id\":747646,\"suggestedTranslation\":\"Đúng là một tay nghề thủ công tinh xảo.\",\"rating\":9.0},\n  {\"id\":747647,\"suggestedTranslation\":\"Nhìn vào nó làm tôi thấy buồn nôn.\",\"rating\":9.0},\n  {\"id\":747648,\"suggestedTranslation\":\"Trang phục ra trò đấy chứ, nhờ?\",\"rating\":9.0},\n  {\"id\":747649,\"suggestedTranslation\":\"Vâng, nó sẽ vừa với tôi thôi, Lucy.\",\"rating\":9.0},\n  {\"id\":747650,\"suggestedTranslation\":\"Gỗ là thứ cháy tốt nhất.\",\"rating\":9.0},\n  {\"id\":747651,\"suggestedTranslation\":\"Hãy để những thớ gỗ dẫn đường cho chúng ta.\",\"rating\":9.0},\n  {\"id\":747652,\"suggestedTranslation\":\"Hãy chỉ đường cho mấy người hàng xóm của chúng ta nào.\",\"rating\":9.0},\n  {\"id\":747653,\"suggestedTranslation\":\"Gỗ là thứ cháy tốt nhất.\",\"rating\":9.0},\n  {\"id\":747654,\"suggestedTranslation\":\"Hãy để những thớ gỗ dẫn đường cho chúng ta.\",\"rating\":9.0},\n  {\"id\":747655,\"suggestedTranslation\":\"Hãy chỉ đường cho mấy người hàng xóm của chúng ta nào.\",\"rating\":9.0},\n  {\"id\":747656,\"suggestedTranslation\":\"Nó cháy rụi hết rồi.\",\"rating\":9.0},\n  {\"id\":747657,\"suggestedTranslation\":\"Cái này từng là một cục xương mắt.\",\"rating\":9.0},\n  {\"id\":747658,\"suggestedTranslation\":\"Cái này từng là một bông hoa nhầy nhụa.\",\"rating\":9.0},\n  {\"id\":747659,\"suggestedTranslation\":\"Chà, đúng là đáng tiếc thật.\",\"rating\":9.0},\n  {\"id\":747660,\"suggestedTranslation\":\"Lúc còn sống, nó cứng gần bằng cây cối vậy.\",\"rating\":9.0},\n  {\"id\":747661,\"suggestedTranslation\":\"Đây là món súp nấu từ những cái cây nhỏ bé đó.\",\"rating\":9.0},\n  {\"id\":747662,\"suggestedTranslation\":\"Nấu chín lên thì ăn dễ hơn chút.\",\"rating\":9.0},\n  {\"id\":747663,\"suggestedTranslation\":\"Trông nó gần giống như một cái cây thực thụ vậy.\",\"rating\":9.0},\n  {\"id\":747664,\"suggestedTranslation\":\"Tôi nên trồng thực vật này mới được.\",\"rating\":9.0},\n  {\"id\":747665,\"suggestedTranslation\":\"Nó đang hấp thụ năng lượng kìa, nhỉ?\",\"rating\":9.0},\n  {\"id\":747666,\"suggestedTranslation\":\"Không muốn quá đà đâu.\",\"rating\":9.0},\n  {\"id\":747667,\"suggestedTranslation\":\"Đó sẽ là tín hiệu để tôi chuồn.\",\"rating\":9.0},\n  {\"id\":747668,\"suggestedTranslation\":\"Cậu nghĩ nó dẫn đến đâu thế, Lucy?\",\"rating\":9.0},\n  {\"id\":747669,\"suggestedTranslation\":\"Thế là ổn rồi đấy.\",\"rating\":9.0},\n  {\"id\":747670,\"suggestedTranslation\":\"Lấy được từ gã nhiều xương to lớn kia đấy.\",\"rating\":9.0},\n  {\"id\":747671,\"suggestedTranslation\":\"Phải có cách nào đó để bật nó lên chứ.\",\"rating\":9.0},\n  {\"id\":747672,\"suggestedTranslation\":\"Đúng là một cơn ác mộng.\",\"rating\":9.0},\n  {\"id\":747673,\"suggestedTranslation\":\"Chắc nó có nói điều gì đó quan trọng. Thôi kệ đi.\",\"rating\":9.0},\n  {\"id\":747674,\"suggestedTranslation\":\"Đó là một bức vẽ cũ về những sinh vật kỳ lạ.\",\"rating\":9.0},\n  {\"id\":747675,\"suggestedTranslation\":\"Chẳng còn gì thú vị ở đây nữa.\",\"rating\":9.0},\n  {\"id\":747676,\"suggestedTranslation\":\"Bùn đen đang bao trùm mọi thứ trong bức vẽ này.\",\"rating\":9.0},\n  {\"id\":747677,\"suggestedTranslation\":\"Đừng nhìn cái này nhé, Lucy.\",\"rating\":9.0},\n  {\"id\":747678,\"suggestedTranslation\":\"Trông giống như một thành phố nhộn nhịp.\",\"rating\":9.0},\n  {\"id\":747679,\"suggestedTranslation\":\"Nó có định cầm thứ gì không vậy?\",\"rating\":9.0},\n  {\"id\":747680,\"suggestedTranslation\":\"Nó không đẹp bằng Lucy đâu.\",\"rating\":9.0},\n  {\"id\":747681,\"suggestedTranslation\":\"Khuôn mặt chỉ có mẹ nó mới thương nổi.\",\"rating\":9.0},\n  {\"id\":747682,\"suggestedTranslation\":\"Tôi cũng thích ngủ ngoài trời lắm.\",\"rating\":9.0},\n  {\"id\":747683,\"suggestedTranslation\":\"Đó là một cái ba lô trông khá được đấy.\",\"rating\":9.0},\n  {\"id\":747684,\"suggestedTranslation\":\"Hây dà. Chỉ là thịt ba rọi phía trước thôi mà.\",\"rating\":9.0},\n  {\"id\":747685,\"suggestedTranslation\":\"Tôi biết tôi đã hứa rồi mà, Luce. Chỉ một ván nữa thôi.\",\"rating\":9.0},\n  {\"id\":747686,\"suggestedTranslation\":\"Nó kêu éc éc. Y hệt như một sinh vật rừng thực thụ vậy.\",\"rating\":9.0},\n  {\"id\":747687,\"suggestedTranslation\":\"Ai cũng có cách tận hưởng thiên nhiên theo cách riêng của mình.\",\"rating\":9.0},\n  {\"id\":747688,\"suggestedTranslation\":\"Ối không, tôi không bỏ quên sinh nhật ai đấy chứ?\",\"rating\":9.0},\n  {\"id\":747689,\"suggestedTranslation\":\"Giờ chỉ là một quả bong bóng bình thường thôi phải không?\",\"rating\":9.0},\n  {\"id\":747690,\"suggestedTranslation\":\"Làm thế quái nào mà nó hoạt động hay thế nhỉ, Luce?\",\"rating\":9.0},\n  {\"id\":747691,\"suggestedTranslation\":\"Đó là bong bóng phải không?\",\"rating\":9.0},\n  {\"id\":747692,\"suggestedTranslation\":\"Vẫn đỡ hơn là chết đuối, tôi đoán thế...\",\"rating\":9.0},\n  {\"id\":747693,\"suggestedTranslation\":\"Nó thiếu mất phần thân cây rồi!\",\"rating\":9.0},\n  {\"id\":747694,\"suggestedTranslation\":\"Cảm giác cứ như đang đi nghỉ dưỡng vậy nhỉ?\",\"rating\":9.0},\n  {\"id\":747695,\"suggestedTranslation\":\"Tôi thích kẹo bơ cứng vị phong hơn...\",\"rating\":9.0},\n  {\"id\":747696,\"suggestedTranslation\":\"Ít ra thì tôi không phải trả tiền cho nó.\",\"rating\":9.0},\n  {\"id\":747697,\"suggestedTranslation\":\"Trông xinh xắn phết phải không?\",\"rating\":9.0},\n  {\"id\":747698,\"suggestedTranslation\":\"Không phải món hải sản ưu tiên của tôi.\",\"rating\":9.0},\n  {\"id\":747699,\"suggestedTranslation\":\"Tôi không kén ăn đâu.\",\"rating\":9.0},\n  {\"id\":747700,\"suggestedTranslation\":\"Tôi không phải là kiểu người từ chối con sâu ngon lành đâu.\",\"rating\":9.0},\n  {\"id\":747701,\"suggestedTranslation\":\"Tôi chưa từng thấy món đó trên thực đơn ở quê nhà bao giờ.\",\"rating\":9.0},\n  {\"id\":747702,\"suggestedTranslation\":\"Chúng ăn được phết đấy chứ!\",\"rating\":9.0},\n  {\"id\":747703,\"suggestedTranslation\":\"Xin lỗi nhé, tôi sẽ tự mình nuốt trọn đĩa này luôn.\",\"rating\":9.0},\n  {\"id\":747704,\"suggestedTranslation\":\"Cục đá tảng đó không đời nào dịch chuyển được đâu.\",\"rating\":9.0},\n  {\"id\":747705,\"suggestedTranslation\":\"Ai dạy con chuột đó bay vậy trời?\",\"rating\":9.0},\n  {\"id\":747706,\"suggestedTranslation\":\"Một con chuột có cánh á?\",\"rating\":9.0},\n  {\"id\":747707,\"suggestedTranslation\":\"Đầy ắp mấy sinh vật nhỏ bé trong đó!\",\"rating\":9.0},\n  {\"id\":747708,\"suggestedTranslation\":\"Thơm lắm, giống như hoa dại vậy.\",\"rating\":9.0},\n  {\"id\":747709,\"suggestedTranslation\":\"Ai mà biết phần còn lại đi đâu mất tiêu rồi.\",\"rating\":9.0},\n  {\"id\":747710,\"suggestedTranslation\":\"Giúp tay tôi rảnh rang để còn chặt chém.\",\"rating\":9.0},\n  {\"id\":747711,\"suggestedTranslation\":\"Không gì tệ hơn một cái mũi lạnh ngắt.\",\"rating\":9.0},\n  {\"id\":747712,\"suggestedTranslation\":\"Đúng là một thứ giữ giai điệu gọn gàng.\",\"rating\":9.0},\n  {\"id\":747713,\"suggestedTranslation\":\"Không nhận ra bài hát này. Có lẽ nó không phát hành ở Canada.\",\"rating\":9.0},\n  {\"id\":747714,\"suggestedTranslation\":\"Không nhận ra bài hát này. Có lẽ nó không phát hành ở Canada.\",\"rating\":9.0},\n  {\"id\":747715,\"suggestedTranslation\":\"Không nhận ra bài hát này. Có lẽ nó không phát hành ở Canada.\",\"rating\":9.0},\n  {\"id\":747716,\"suggestedTranslation\":\"Tôi không thể ngồi ngắm kịch khi đang có đống gỗ cần chặt được!\",\"rating\":9.0},\n  {\"id\":747717,\"suggestedTranslation\":\"Không nhận ra bài hát này. Có lẽ nó không phát hành ở Canada.\",\"rating\":9.0},\n  {\"id\":747718,\"suggestedTranslation\":\"Tôi không thể ngồi ngắm kịch khi đang có đống gỗ cần chặt được!\",\"rating\":9.0},\n  {\"id\":747719,\"suggestedTranslation\":\"Không nhận ra bài hát này. Có lẽ nó không phát hành ở Canada.\",\"rating\":9.0},\n  {\"id\":747720,\"suggestedTranslation\":\"Không nhận ra bài hát này. Có lẽ nó không phát hành ở Canada.\",\"rating\":9.0},\n  {\"id\":747721,\"suggestedTranslation\":\"Không nhận ra bài hát này. Có lẽ nó không phát hành ở Canada.\",\"rating\":9.0},\n  {\"id\":747722,\"suggestedTranslation\":\"Không nhận ra bài hát này. Có lẽ nó không phát hành ở Canada.\",\"rating\":9.0},\n  {\"id\":747723,\"suggestedTranslation\":\"Ghê tởm!\",\"rating\":9.0},\n  {\"id\":747724,\"suggestedTranslation\":\"Gớm ghiếc! Mà lại ngon nữa chứ! Thật khó hiểu mà!\",\"rating\":9.0},\n  {\"id\":747725,\"suggestedTranslation\":\"Tóc tôi không có màu đó. Ít ra là râu của tôi không phải màu đó.\",\"rating\":9.0},\n  {\"id\":747726,\"suggestedTranslation\":\"Đó là một con gấu bự chảng!\",\"rating\":9.0},\n  {\"id\":747727,\"suggestedTranslation\":\"Smokey kìa!\",\"rating\":9.0},\n  {\"id\":747728,\"suggestedTranslation\":\"Nó đúng là một tảng thịt xông khói bự.\",\"rating\":9.0},\n  {\"id\":747729,\"suggestedTranslation\":\"Chà, thế thì không ổn chút nào nhỉ?\",\"rating\":9.0},\n  {\"id\":747730,\"suggestedTranslation\":\"Giữ cho đồ đạc mát mẻ nhỉ?\",\"rating\":9.0},\n  {\"id\":747731,\"suggestedTranslation\":\"Đây mới đúng là đồ dùng mùa đông chính hiệu.\",\"rating\":9.0},\n  {\"id\":747732,\"suggestedTranslation\":\"Nó dày bằng đầu tôi luôn đấy!\",\"rating\":9.0},\n  {\"id\":747733,\"suggestedTranslation\":\"Quái thú của chúng ta thật may mắn vì nó là bạn chứ không phải bữa tối nhỉ?\",\"rating\":9.0},\n  {\"id\":747734,\"suggestedTranslation\":\"Tôi thích cắm trại lắm.\",\"rating\":9.0},\n  {\"id\":747735,\"suggestedTranslation\":\"Tôi từng ngủ trên những thứ tệ hơn thế này hồi ở trại đốn gỗ nhiều.\",\"rating\":9.0},\n  {\"id\":747736,\"suggestedTranslation\":\"Nó đang giúp những bông hoa lớn lên kìa.\",\"rating\":9.0},\n  {\"id\":747737,\"suggestedTranslation\":\"Giờ tôi nên làm gì với cô nàng đây?\",\"rating\":9.0},\n  {\"id\":747738,\"suggestedTranslation\":\"Không, đừng là lũ ong!\",\"rating\":9.0},\n  {\"id\":747739,\"suggestedTranslation\":\"Món thay thế cho xi -rô phong đây!\",\"rating\":9.0},\n  {\"id\":747740,\"suggestedTranslation\":\"Mấy con vo ve!\",\"rating\":9.0},\n  {\"id\":747741,\"suggestedTranslation\":\"Nhìn thôi là tôi đã thấy đói bụng rồi.\",\"rating\":9.0},\n  {\"id\":747742,\"suggestedTranslation\":\"Món thay thế cho xi -rô phong đây!\",\"rating\":9.0},\n  {\"id\":747743,\"suggestedTranslation\":\"Tôi có thể lấy nhiều hơn nếu đợi thêm chút nữa.\",\"rating\":9.0},\n  {\"id\":747744,\"suggestedTranslation\":\"Không, đừng là lũ ong!\",\"rating\":9.0},\n  {\"id\":747745,\"suggestedTranslation\":\"Món thay thế cho xi -rô phong đây!\",\"rating\":9.0},\n  {\"id\":747746,\"suggestedTranslation\":\"Thì ra đó là nơi lũ ong bay ra!\",\"rating\":9.0},\n  {\"id\":747747,\"suggestedTranslation\":\"Nhìn thôi là tôi đã thấy đói bụng rồi.\",\"rating\":9.0},\n  {\"id\":747748,\"suggestedTranslation\":\"Món thay thế cho xi -rô phong đây!\",\"rating\":9.0},\n  {\"id\":747749,\"suggestedTranslation\":\"Tôi có thể lấy nhiều hơn nếu đợi thêm chút nữa.\",\"rating\":9.0},\n  {\"id\":747750,\"suggestedTranslation\":\"Trông không giống còn sống lắm.\",\"rating\":9.0},\n  {\"id\":747751,\"suggestedTranslation\":\"Cảm giác giống như mất đi người bạn thân thứ hai vậy.\",\"rating\":9.0},\n  {\"id\":747752,\"suggestedTranslation\":\"Tôi thích thái độ của con này đấy.\",\"rating\":9.0},\n  {\"id\":747753,\"suggestedTranslation\":\"Tôi nghĩ nó quý tôi đấy.\",\"rating\":9.0},\n  {\"id\":747754,\"suggestedTranslation\":\"Nó ngửi cứ như một túp lều cỏ khô vậy.\",\"rating\":9.0},\n  {\"id\":747755,\"suggestedTranslation\":\"Nó là một con vật già nua hôi hám, nhưng tôi chẳng thể đòi hỏi một chiến hữu nào tốt hơn thế!\",\"rating\":9.0},\n  {\"id\":747756,\"suggestedTranslation\":\"Vui lên nào, phải không?\",\"rating\":9.0},\n  {\"id\":747757,\"suggestedTranslation\":\"Sao lại ủ rũ thế hả bạn hiền?\",\"rating\":9.0},\n  {\"id\":747758,\"suggestedTranslation\":\"Mày to gần bằng một con hươu Sừng Tấm rồi đấy!\",\"rating\":9.0},\n  {\"id\":747759,\"suggestedTranslation\":\"Xin lỗi nhé, muốn đi dạo một vòng không?\",\"rating\":9.0},\n  {\"id\":747760,\"suggestedTranslation\":\"Nó đang tranh thủ làm vài nháy giấc ngủ đây.\",\"rating\":9.0},\n  {\"id\":747761,\"suggestedTranslation\":\"Đến đây ăn đi nào!\",\"rating\":9.0},\n  {\"id\":747762,\"suggestedTranslation\":\"Giờ thì ta là vua của loài bò lai rồi!\",\"rating\":9.0},\n  {\"id\":747763,\"suggestedTranslation\":\"Hay là tôi cho con bò lai của mình chút đồ ăn ngon để nhấm nháp nhỉ?\",\"rating\":9.0},\n  {\"id\":747764,\"suggestedTranslation\":\"Cảm giác y hệt râu của tôi vậy.\",\"rating\":9.0},\n  {\"id\":747765,\"suggestedTranslation\":\"Chẳng làm được gì với cái đó nữa rồi.\",\"rating\":9.0},\n  {\"id\":747766,\"suggestedTranslation\":\"Cái này có vẻ hơi quá đà rồi đấy...\",\"rating\":9.0},\n  {\"id\":747767,\"suggestedTranslation\":\"Chà, xem tôi có thể làm gì nào.\",\"rating\":9.0},\n  {\"id\":747768,\"suggestedTranslation\":\"Tốt hơn là nên dựng nó lên thôi, nhỉ?\",\"rating\":9.0},\n  {\"id\":747769,\"suggestedTranslation\":\"Mấy con bò lai có vẻ rất thích âm thanh đó phát ra.\",\"rating\":9.0},\n  {\"id\":747770,\"suggestedTranslation\":\"Hy vọng là không ai bị dị ứng nhỉ?\",\"rating\":9.0},\n  {\"id\":747771,\"suggestedTranslation\":\"Cái đó sẽ giúp lũ ong không bay vào mắt cậu.\",\"rating\":9.0},\n  {\"id\":747772,\"suggestedTranslation\":\"Chúng đang cuộn mình thoải mái trong đó kìa.\",\"rating\":9.0},\n  {\"id\":747773,\"suggestedTranslation\":\"Tôi không biết lũ ong có thích cái này không nữa.\",\"rating\":9.0},\n  {\"id\":747774,\"suggestedTranslation\":\"Này! Chơi thế thì hiểm quá đấy!\",\"rating\":9.0},\n  {\"id\":747775,\"suggestedTranslation\":\"Lũ ong không việc gì phải to bự đến mức đó cả.\",\"rating\":9.0},\n  {\"id\":747776,\"suggestedTranslation\":\"Tôi không thèm ăn mật ong dính dưới đất đâu.\",\"rating\":9.0},\n  {\"id\":747777,\"suggestedTranslation\":\"Lũ ong đang lên âm mưu gì kìa.\",\"rating\":9.0},\n  {\"id\":747778,\"suggestedTranslation\":\"Tự nhiên đúng là kỳ diệu thật đấy, nhỉ?\",\"rating\":9.0},\n  {\"id\":747779,\"suggestedTranslation\":\"Úi chà, sáp gì mà sáp nhiều thế.\",\"rating\":9.0},\n  {\"id\":747780,\"suggestedTranslation\":\"Lucy bảo cô ấy thích mùi hương gỗ mộc mạc của tôi cơ.\",\"rating\":9.0},\n  {\"id\":747781,\"suggestedTranslation\":\"Phải chặt nát bộ giáp đó ra mới được.\",\"rating\":9.0},\n  {\"id\":747782,\"suggestedTranslation\":\"Tôi ngạc nhiên là nó lại phát ra âm thanh giòn giã đến thế.\",\"rating\":9.0},\n  {\"id\":747783,\"suggestedTranslation\":\"Chắc là tôi nên quen với mấy thứ kỳ quặc này từ lâu rồi mới phải.\",\"rating\":9.0},\n  {\"id\":747784,\"suggestedTranslation\":\"Hừm. Chuẩn luôn. Lại thêm một ngày bình thường.\",\"rating\":9.0},\n  {\"id\":747785,\"suggestedTranslation\":\"Tội nghiệp bé con.\",\"rating\":9.0},\n  {\"id\":747786,\"suggestedTranslation\":\"Dễ thương phải không Luce?\",\"rating\":9.0}\n]",
