            "text": "[\n  {\"id\":745628,\"suggestedTranslation\":\"Chỉ là cái đồng hồ nhỏ thôi.\",\"rating\":0.0},\n  {\"id\":745629,\"suggestedTranslation\":\"Đồng hồ nhỏ đang ngủ rồi.\",\"rating\":0.0},\n  {\"id\":745630,\"suggestedTranslation\":\"Đúng là một đống đồ đồng hồ vụn vặt.\",\"rating\":0.0},\n  {\"id\":745631,\"suggestedTranslation\":\"Chỉ là cái đồng hồ nhỏ thôi.\",\"rating\":0.0},\n  {\"id\":745632,\"suggestedTranslation\":\"Đồng hồ nhỏ đang ngủ rồi.\",\"rating\":0.0},\n  {\"id\":745633,\"suggestedTranslation\":\"Bên trong tối quá... hay là Wolfgang đi bộ cho rồi nhỉ?\",\"rating\":0.0},\n  {\"id\":745634,\"suggestedTranslation\":\"Bên trong tối quá... hay là Wolfgang đi bộ cho rồi nhỉ?\",\"rating\":0.0},\n  {\"id\":745635,\"suggestedTranslation\":\"Wolfgang rất vui vì đã ra khỏi cái đường hầm này.\",\"rating\":0.0},\n  {\"id\":745636,\"suggestedTranslation\":\"Chỉ là cái đồng hồ nhỏ thôi.\",\"rating\":0.0},\n  {\"id\":745637,\"suggestedTranslation\":\"Đồng hồ nhỏ đang ngủ rồi.\",\"rating\":0.0},\n  {\"id\":745638,\"suggestedTranslation\":\"Chỉ là cái đồng hồ nhỏ thôi.\",\"rating\":0.0},\n  {\"id\":745639,\"suggestedTranslation\":\"Đồng hồ nhỏ đang ngủ rồi.\",\"rating\":0.0},\n  {\"id\":745640,\"suggestedTranslation\":\"Chỉ là cái đồng hồ nhỏ thôi.\",\"rating\":0.0},\n  {\"id\":745641,\"suggestedTranslation\":\"Đồng hồ nhỏ đang ngủ rồi.\",\"rating\":0.0},\n  {\"id\":745642,\"suggestedTranslation\":\"Wolfgang rất muốn thử!\",\"rating\":0.0},\n  {\"id\":745643,\"suggestedTranslation\":\"Cái cân bé xíu vừa vặn trong lòng bàn tay Wolfgang!\",\"rating\":0.0},\n  {\"id\":745644,\"suggestedTranslation\":\"À, gợi lại những kỷ niệm đẹp.\",\"rating\":0.0},\n  {\"id\":745645,\"suggestedTranslation\":\"Đúng là người bạn chim trung thành!\",\"rating\":0.0},\n  {\"id\":745646,\"suggestedTranslation\":\"Những chiếc lông sặc sỡ khiến Wolfgang cảm thấy mình thật quan trọng.\",\"rating\":0.0},\n  {\"id\":745647,\"suggestedTranslation\":\"Trông giống như bộ não của gã mọt sách vậy.\",\"rating\":0.0},\n  {\"id\":745648,\"suggestedTranslation\":\"Ha ha ha! Não bị nấu chín rồi! Giờ thì không thông minh nổi nữa nhé.\",\"rating\":0.0},\n  {\"id\":745649,\"suggestedTranslation\":\"Vừa to vừa rất hợp để nâng tạ!\",\"rating\":0.0},\n  {\"id\":745650,\"suggestedTranslation\":\"Đây là hạt để trồng.\",\"rating\":0.0},\n  {\"id\":745651,\"suggestedTranslation\":\"Ướt sũng luôn.\",\"rating\":0.0},\n  {\"id\":745652,\"suggestedTranslation\":\"Lươn cần được nấu chín!\",\"rating\":0.0},\n  {\"id\":745653,\"suggestedTranslation\":\"Thơm mùi cá phết.\",\"rating\":0.0},\n  {\"id\":745654,\"suggestedTranslation\":\"Thực vật gì mà bé tí! Buồn cười thật đấy.\",\"rating\":0.0},\n  {\"id\":745655,\"suggestedTranslation\":\"Hôi quá!\",\"rating\":0.0},\n  {\"id\":745656,\"suggestedTranslation\":\"Wolfgang có thể nghiền nát thức ăn bằng thứ đó nếu muốn.\",\"rating\":0.0},\n  {\"id\":745657,\"suggestedTranslation\":\"Bữa ăn ngon cần có thời gian để ninh.\",\"rating\":0.0},\n  {\"id\":745658,\"suggestedTranslation\":\"Sẽ xong sớm thôi, các bạn của tôi!\",\"rating\":0.0},\n  {\"id\":745659,\"suggestedTranslation\":\"Được quây quần bên bữa ăn với những người bạn!\",\"rating\":0.0},\n  {\"id\":745660,\"suggestedTranslation\":\"Wolfgang sẽ đi tìm thứ gì đó để nấu!\",\"rating\":0.0},\n  {\"id\":745661,\"suggestedTranslation\":\"Wolfgang sẽ nấu một bữa ăn ngon cho các bạn, bữa ăn giống như ở nhà!\",\"rating\":0.0},\n  {\"id\":745662,\"suggestedTranslation\":\"Sẽ không bao giờ sợ khu rừng tối tăm nữa. Không phải là Wolfgang từng sợ đâu nhé.\",\"rating\":0.0},\n  {\"id\":745663,\"suggestedTranslation\":\"Là một đống nhỏ nhưng mang hương vị mạnh mẽ.\",\"rating\":0.0},\n  {\"id\":745664,\"suggestedTranslation\":\"Wolfgang sẽ quay cối xay bằng cơ bắp cuồn cuộn của mình!\",\"rating\":0.0},\n  {\"id\":745665,\"suggestedTranslation\":\"Đúng là một chiếc lều tốt và vững chắc!\",\"rating\":0.0},\n  {\"id\":745666,\"suggestedTranslation\":\"Wolfgang sẽ dựng lều. Làm cho thật chắc chắn vào!\",\"rating\":0.0},\n  {\"id\":745667,\"suggestedTranslation\":\"Món rau củ yêu thích của Wolfgang.\",\"rating\":0.0},\n  {\"id\":745668,\"suggestedTranslation\":\"Ha! Nâng tạ và khoai tây là ba trong số những thứ Wolfgang thích nhất!\",\"rating\":0.0},\n  {\"id\":745669,\"suggestedTranslation\":\"Wolfgang rất tự hào về người bạn nấu ăn bé nhỏ này.\",\"rating\":0.0},\n  {\"id\":745670,\"suggestedTranslation\":\"Wolfgang rất thích khoai tây.\",\"rating\":0.0},\n  {\"id\":745671,\"suggestedTranslation\":\"Vàng ươm luôn! Kết cấu như ánh mặt trời!\",\"rating\":0.0},\n  {\"id\":745672,\"suggestedTranslation\":\"Đúng là... là thứ đẹp nhất mà Wolfgang từng thấy...\",\"rating\":0.0},\n  {\"id\":745673,\"suggestedTranslation\":\"Đây là những hạt nhỏ xíu để vùi xuống đất.\",\"rating\":0.0},\n  {\"id\":745674,\"suggestedTranslation\":\"Wolfgang lo là cái biệt tài trồng cây này lại thành hoại tử mất.\",\"rating\":0.0},\n  {\"id\":745675,\"suggestedTranslation\":\"Được làm từ hư vô!\",\"rating\":0.0},\n  {\"id\":745676,\"suggestedTranslation\":\"Ha! Con khỉ ngốc nghếch quên tập chân rồi à.\",\"rating\":0.0},\n  {\"id\":745677,\"suggestedTranslation\":\"Cần nước.\",\"rating\":0.0},\n  {\"id\":745678,\"suggestedTranslation\":\"Wolfgang có thể mang rất nhiều nước trong đó.\",\"rating\":0.0},\n  {\"id\":745679,\"suggestedTranslation\":\"Không con khỉ nào dám ăn trộm đồ của Wolfgang hết!\",\"rating\":0.0},\n  {\"id\":745680,\"suggestedTranslation\":\"Chim có lông vũ thích nước.\",\"rating\":0.0},\n  {\"id\":745681,\"suggestedTranslation\":\"Mày bé thật đấy, người bạn lông vũ ạ.\",\"rating\":0.0},\n  {\"id\":745682,\"suggestedTranslation\":\"Wolfgang sẽ không làm phiền đâu.\",\"rating\":0.0},\n  {\"id\":745683,\"suggestedTranslation\":\"To bằng cái đầu của gã yếu đuối! Nhưng không phải đầu Wolfgang.\",\"rating\":0.0},\n  {\"id\":745684,\"suggestedTranslation\":\"Wolfgang là thợ khắc bí ngô giỏi nhất. Giỏi nhất đấy.\",\"rating\":0.0},\n  {\"id\":745685,\"suggestedTranslation\":\"Đúng là một chiếc bánh quy ngon.\",\"rating\":0.0},\n  {\"id\":745686,\"suggestedTranslation\":\"Wolfgang đeo mặt nạ bí ngô đáng sợ! Mấy đứa nhóc nghịch ngợm hãy cẩn thận đấy!\",\"rating\":0.0},\n  {\"id\":745687,\"suggestedTranslation\":\"Không có mặt á? Thế thì làm sao mà dọa được mấy đứa nhóc tì chứ?\",\"rating\":0.0},\n  {\"id\":745688,\"suggestedTranslation\":\"Cái bụng của Wolfgang sắp to hơn cả cơ bắp mất thôi...\",\"rating\":0.0},\n  {\"id\":745689,\"suggestedTranslation\":\"Đỉnh của chóp!\",\"rating\":0.0},\n  {\"id\":745690,\"suggestedTranslation\":\"Giờ thì nó là cái đầu thật luôn rồi! Wolfgang sợ quá!\",\"rating\":0.0},\n  {\"id\":745691,\"suggestedTranslation\":\"Thậm chí còn to hơn cả cái đầu của gã khoa học yếu ớt!\",\"rating\":0.0},\n  {\"id\":745692,\"suggestedTranslation\":\"Đây là hạt để trồng.\",\"rating\":0.0},\n  {\"id\":745693,\"suggestedTranslation\":\"Wolfgang sẽ cố gắng nương tay với tên đấm bốc tí hon này.\",\"rating\":0.0},\n  {\"id\":745694,\"suggestedTranslation\":\"Mấy cục đá nhỏ sáng quá đấy!\",\"rating\":0.0},\n  {\"id\":745695,\"suggestedTranslation\":\"Cái bùa hộ mệnh này... nó làm Wolfgang thấy sợ.\",\"rating\":0.0},\n  {\"id\":745696,\"suggestedTranslation\":\"Đá tảng đẹp hơn.\",\"rating\":0.0},\n  {\"id\":745697,\"suggestedTranslation\":\"Trông hơi rợn tóc gáy, nhưng nhờ thế chắc Wolfgang sẽ đỡ bị lạc hơn.\",\"rating\":0.0},\n  {\"id\":745698,\"suggestedTranslation\":\"Hãy thưởng thức bữa ăn thịnh soạn từ Wolfgang đi!\",\"rating\":0.0},\n  {\"id\":745699,\"suggestedTranslation\":\"Hòn đá nhỏ. Wolfgang sẽ nấu ăn cho ngươi.\",\"rating\":0.0},\n  {\"id\":745700,\"suggestedTranslation\":\"Là cái cột.\",\"rating\":0.0},\n  {\"id\":745701,\"suggestedTranslation\":\"Là thực vật.\",\"rating\":0.0},\n  {\"id\":745702,\"suggestedTranslation\":\"Là một quý bà to lớn.\",\"rating\":0.0},\n  {\"id\":745703,\"suggestedTranslation\":\"Bà quý bà đá đẹp ghê.\",\"rating\":0.0},\n  {\"id\":745704,\"suggestedTranslation\":\"Đúng là bức tượng ngốc nghếch. Wolfgang không sợ đâu.\",\"rating\":0.0},\n  {\"id\":745705,\"suggestedTranslation\":\"Già rồi.\",\"rating\":0.0},\n  {\"id\":745706,\"suggestedTranslation\":\"Hết sạch rồi.\",\"rating\":0.0},\n  {\"id\":745707,\"suggestedTranslation\":\"Dành cho việc ăn uống sang chảnh.\",\"rating\":0.0},\n  {\"id\":745708,\"suggestedTranslation\":\"Đây là những hạt nhỏ xíu để vùi xuống đất.\",\"rating\":0.0},\n  {\"id\":745709,\"suggestedTranslation\":\"Tiếc ghê, Wolfgang quên toi công thức món bắp cải hầm rồi.\",\"rating\":0.0},\n  {\"id\":745710,\"suggestedTranslation\":\"Dùng để làm mấy món ăn nhỏ.\",\"rating\":0.0},\n  {\"id\":745711,\"suggestedTranslation\":\"Bà dê và mấy gã người Câu Cá hẳn sẽ thích.\",\"rating\":0.0},\n  {\"id\":745712,\"suggestedTranslation\":\"Bà dê và mấy gã người Câu Cá hẳn sẽ thích.\",\"rating\":0.0},\n  {\"id\":745713,\"suggestedTranslation\":\"Bà dê và mấy gã người Câu Cá hẳn sẽ thích.\",\"rating\":0.0},\n  {\"id\":745714,\"suggestedTranslation\":\"Con quái vật bầu trời rất thích đồ ăn Wolfgang nấu!\",\"rating\":0.0},\n  {\"id\":745715,\"suggestedTranslation\":\"Là thịt của con cua nhỏ bé.\",\"rating\":0.0},\n  {\"id\":745716,\"suggestedTranslation\":\"Ngon tuyệt cú mèo.\",\"rating\":0.0},\n  {\"id\":745717,\"suggestedTranslation\":\"Dùng để bắt mấy con cua nhỏ.\",\"rating\":0.0},\n  {\"id\":745718,\"suggestedTranslation\":\"Là thực vật lá nhỏ.\",\"rating\":0.0},\n  {\"id\":745719,\"suggestedTranslation\":\"Dùng để làm bột nhào và rất nhiều món mì ngon.\",\"rating\":0.0},\n  {\"id\":745720,\"suggestedTranslation\":\"Giờ nó là đồ trang trí rồi.\",\"rating\":0.0},\n  {\"id\":745721,\"suggestedTranslation\":\"Wolfgang sẽ cho con quái vật bầu trời to lớn ăn!\",\"rating\":0.0},\n  {\"id\":745722,\"suggestedTranslation\":\"Rất hợp với quái vật bầu trời.\",\"rating\":0.0},\n  {\"id\":745723,\"suggestedTranslation\":\"Là món ăn nhỏ, nhưng rất hợp với quái vật bầu trời.\",\"rating\":0.0},\n  {\"id\":745724,\"suggestedTranslation\":\"Đây không phải thứ quái vật bầu trời muốn.\",\"rating\":0.0},\n  {\"id\":745725,\"suggestedTranslation\":\"Thật là một cảnh tượng đau lòng.\",\"rating\":0.0},\n  {\"id\":745726,\"suggestedTranslation\":\"Tạo hương vị rất ngon cho món hầm.\",\"rating\":0.0},\n  {\"id\":745727,\"suggestedTranslation\":\"Hương vị ngon lành rồi đây.\",\"rating\":0.0},\n  {\"id\":745728,\"suggestedTranslation\":\"Đây là những hạt nhỏ xíu để vùi xuống đất.\",\"rating\":0.0},\n  {\"id\":745729,\"suggestedTranslation\":\"Cậu nhóc lớn lên sẽ khỏe mạnh như Wolfgang nhé, chịu không?\",\"rating\":0.0},\n  {\"id\":745730,\"suggestedTranslation\":\"Biết đâu bà dê vắt ra từ mấy con bò nhiều lông thì sao?\",\"rating\":0.0},\n  {\"id\":745731,\"suggestedTranslation\":\"Là bà dê lông xù!\",\"rating\":0.0},\n  {\"id\":745732,\"suggestedTranslation\":\"Là đem nướng thức ăn.\",\"rating\":0.0},\n  {\"id\":745733,\"suggestedTranslation\":\"Wolfgang nên đặt cái này ở đâu đây?\",\"rating\":0.0},\n  {\"id\":745734,\"suggestedTranslation\":\"Là đem nướng thức ăn nhỏ.\",\"rating\":0.0},\n  {\"id\":745735,\"suggestedTranslation\":\"Wolfgang cần đặt cái này xuống đâu đó đã.\",\"rating\":0.0},\n  {\"id\":745736,\"suggestedTranslation\":\"Wolfgang phải làm việc đồng áng để có những loại rau củ ngon nhất.\",\"rating\":0.0},\n  {\"id\":745737,\"suggestedTranslation\":\"Wolfgang có chìa khóa kho báu đây.\",\"rating\":0.0},\n  {\"id\":745738,\"suggestedTranslation\":\"Haha! Wolfgang mở cổng rồi đây!\",\"rating\":0.0},\n  {\"id\":745739,\"suggestedTranslation\":\"Wolfgang rất thích cái đèn.\",\"rating\":0.0},\n  {\"id\":745740,\"suggestedTranslation\":\"Wolfgang rất thích cái đèn.\",\"rating\":0.0},\n  {\"id\":745741,\"suggestedTranslation\":\"Chúng ta phải nghiền ngũ cốc để làm bánh mì!\",\"rating\":0.0},\n  {\"id\":745742,\"suggestedTranslation\":\"Cái nhà đó là dành cho lũ người Câu Cá bốc mùi.\",\"rating\":0.0},\n  {\"id\":745743,\"suggestedTranslation\":\"Wolfgang nhấc nổi nó đấy.\",\"rating\":0.0},\n  {\"id\":745744,\"suggestedTranslation\":\"Wolfgang nhấc nổi nó đấy.\",\"rating\":0.0},\n  {\"id\":745745,\"suggestedTranslation\":\"Nấm cần được nấu chín!\",\"rating\":0.0},\n  {\"id\":745746,\"suggestedTranslation\":\"Wolfgang có thể dùng để nấu súp.\",\"rating\":0.0},\n  {\"id\":745747,\"suggestedTranslation\":\"Hết phần của Wolfgang rồi.\",\"rating\":0.0},\n  {\"id\":745748,\"suggestedTranslation\":\"Lúc không nấu ăn, Wolfgang ăn nó như ăn táo vậy.\",\"rating\":0.0},\n  {\"id\":745749,\"suggestedTranslation\":\"Giòn, nâu, ngọt.\",\"rating\":0.0},\n  {\"id\":745750,\"suggestedTranslation\":\"Đây là những hạt nhỏ xíu để vùi xuống đất.\",\"rating\":0.0},\n  {\"id\":745751,\"suggestedTranslation\":\"Các bạn ơi! Wolfgang sẽ nấu ăn cho mọi người!\",\"rating\":0.0},\n  {\"id\":745752,\"suggestedTranslation\":\"Mấy mảnh hộp lửa đây mà.\",\"rating\":0.0},\n  {\"id\":745753,\"suggestedTranslation\":\"Là thứ nhọn hoắt gai góc.\",\"rating\":0.0},\n  {\"id\":745754,\"suggestedTranslation\":\"Trông đáng sợ quá.\",\"rating\":0.0},\n  {\"id\":745755,\"suggestedTranslation\":\"Wolfgang không thích đâu.\",\"rating\":0.0},\n  {\"id\":745756,\"suggestedTranslation\":\"Chẳng có giọt nước nào cho mấy chú chim non cả.\",\"rating\":0.0},\n  {\"id\":745757,\"suggestedTranslation\":\"Có thứ gì hay ho trong công viên màu hồng này nhỉ?\",\"rating\":0.0},\n  {\"id\":745758,\"suggestedTranslation\":\"Cần có chìa khóa.\",\"rating\":0.0},\n  {\"id\":745759,\"suggestedTranslation\":\"Wolfgang nhấc nổi nó đấy.\",\"rating\":0.0},\n  {\"id\":745760,\"suggestedTranslation\":\"Là tro cốt của người chết.\",\"rating\":0.0},\n  {\"id\":745761,\"suggestedTranslation\":\"Chào cậu bạn kẹp càng bé xíu nhé!\",\"rating\":0.0},\n  {\"id\":745762,\"suggestedTranslation\":\"Chết rồi.\",\"rating\":0.0},\n  {\"id\":745763,\"suggestedTranslation\":\"Con chim ngốc nghếch chẳng có gì quan trọng với Wolfgang cả.\",\"rating\":0.0},\n  {\"id\":745764,\"suggestedTranslation\":\"Đi khò khò rồi.\",\"rating\":0.0},\n  {\"id\":745765,\"suggestedTranslation\":\"Dành cho việc ăn uống sang chảnh.\",\"rating\":0.0},\n  {\"id\":745766,\"suggestedTranslation\":\"Là đại dương thu nhỏ.\",\"rating\":0.0},\n  {\"id\":745767,\"suggestedTranslation\":\"Nó có dẫn về nhà đâu. Không có gì ngạc nhiên cả.\",\"rating\":0.0},\n  {\"id\":745768,\"suggestedTranslation\":\"Là chiếc chìa khóa nặng trĩu nhưng Wolfgang rất khỏe!\",\"rating\":0.0},\n  {\"id\":745769,\"suggestedTranslation\":\"Wolfgang đặt cái này lên lửa.\",\"rating\":0.0},\n  {\"id\":745770,\"suggestedTranslation\":\"Món rau củ yêu thích của Wolfgang.\",\"rating\":0.0},\n  {\"id\":745771,\"suggestedTranslation\":\"Vàng ươm luôn! Kết cấu như ánh mặt trời!\",\"rating\":0.0},\n  {\"id\":745772,\"suggestedTranslation\":\"Đây là những hạt nhỏ xíu để vùi xuống đất.\",\"rating\":0.0},\n  {\"id\":745773,\"suggestedTranslation\":\"Wolfgang treo mấy thứ lên lửa.\",\"rating\":0.0},\n  {\"id\":745774,\"suggestedTranslation\":\"Làm cho cái nồi treo lơ lửng trên lửa.\",\"rating\":0.0},\n  {\"id\":745775,\"suggestedTranslation\":\"Mấy bạn ơi, đừng nhìn! Nồi đang cần sôi.\",\"rating\":0.0},\n  {\"id\":745776,\"suggestedTranslation\":\"Wolfgang đổ cục đường nhão vào. Thế là cục đường nhão mới chảy ra.\",\"rating\":0.0},\n  {\"id\":745777,\"suggestedTranslation\":\"Đất biến rau củ thành đống bầy nhầy rồi.\",\"rating\":0.0},\n  {\"id\":745778,\"suggestedTranslation\":\"Hỏng bét rồi.\",\"rating\":0.0},\n  {\"id\":745779,\"suggestedTranslation\":\"Không dùng được nữa.\",\"rating\":0.0},\n  {\"id\":745780,\"suggestedTranslation\":\"Ai đó đã đập nát nó rồi.\",\"rating\":0.0},\n  {\"id\":745781,\"suggestedTranslation\":\"Wolfgang sẽ đấm bươu đầu bất cứ thứ gì gây ra chuyện này.\",\"rating\":0.0},\n  {\"id\":745782,\"suggestedTranslation\":\"Không phải Wolfgang làm đâu nhé. Nhưng Wolfgang làm được đấy.\",\"rating\":0.0},\n  {\"id\":745783,\"suggestedTranslation\":\"Wolfgang chịu không xem được giờ.\",\"rating\":0.0},\n  {\"id\":745784,\"suggestedTranslation\":\"Còn chạy không nhỉ? Không, hỏ