tion\":\"Nói cho Wolfgang biết bạn muốn đi đâu, anh ấy sẽ dẫn đi.\",\"rating\":9.0},\n  {\"id\":745348,\"suggestedTranslation\":\"Wolfgang sẽ cõng bạn thật oai phong!\",\"rating\":9.0},\n  {\"id\":745349,\"suggestedTranslation\":\"Wolfgang ở đây để giúp đỡ mà, đúng thế.\",\"rating\":9.0},\n  {\"id\":745350,\"suggestedTranslation\":\"Biết đâu quả cầu ánh sáng nhỏ cần thời gian để trở nên mạnh mẽ hơn?\",\"rating\":9.0},\n  {\"id\":745351,\"suggestedTranslation\":\"Có những thứ đặc biệt bị kẹt bên trong!\",\"rating\":9.0},\n  {\"id\":745352,\"suggestedTranslation\":\"Có những thứ đặc biệt bị kẹt bên trong!\",\"rating\":9.0},\n  {\"id\":745353,\"suggestedTranslation\":\"Có những thứ đặc biệt bị kẹt bên trong!\",\"rating\":9.0},\n  {\"id\":745354,\"suggestedTranslation\":\"Được chứ, Wolfgang sẽ cõng bạn.\",\"rating\":9.0},\n  {\"id\":745355,\"suggestedTranslation\":\"Cũng không nặng lắm đâu, Wolfgang sẽ cõng bao xa tùy thích!\",\"rating\":9.0},\n  {\"id\":745356,\"suggestedTranslation\":\"Wolfgang chán ăn nấm lắm rồi.\",\"rating\":9.0},\n  {\"id\":745357,\"suggestedTranslation\":\"Nó đã thay đổi rồi.\",\"rating\":9.0},\n  {\"id\":745358,\"suggestedTranslation\":\"Sàn nhà đẹp cho quả cầu ánh sáng đây.\",\"rating\":9.0},\n  {\"id\":745359,\"suggestedTranslation\":\"Wolfgang chỉ làm theo hướng dẫn thôi.\",\"rating\":9.0},\n  {\"id\":745360,\"suggestedTranslation\":\"Wolfgang hiểu rồi, là Đèn Chong Đêm khổng lồ!\",\"rating\":9.0},\n  {\"id\":745361,\"suggestedTranslation\":\"Wolfgang sợ, nhưng mà vui.\",\"rating\":9.0},\n  {\"id\":745362,\"suggestedTranslation\":\"Mặt đất nhỏ đang nứt toác ra kìa!\",\"rating\":9.0},\n  {\"id\":745363,\"suggestedTranslation\":\"Sao dưới đất lại đầy vỏ sò hôi thối thế này?\",\"rating\":9.0},\n  {\"id\":745364,\"suggestedTranslation\":\"Đang cháy kìa!\",\"rating\":9.0},\n  {\"id\":745365,\"suggestedTranslation\":\"Cháy rụi rồi.\",\"rating\":9.0},\n  {\"id\":745366,\"suggestedTranslation\":\"Giờ chỉ còn là cái gốc cây cụt lủn.\",\"rating\":9.0},\n  {\"id\":745367,\"suggestedTranslation\":\"Cái cây tròn vo kỳ lạ.\",\"rating\":9.0},\n  {\"id\":745368,\"suggestedTranslation\":\"Nó mọc ra từ cái cây kỳ lạ.\",\"rating\":9.0},\n  {\"id\":745369,\"suggestedTranslation\":\"Wolfgang rất biết thưởng thức hương thơm tinh tế.\",\"rating\":9.0},\n  {\"id\":745370,\"suggestedTranslation\":\"Sinh vật kỳ lạ thật đấy.\",\"rating\":9.0},\n  {\"id\":745371,\"suggestedTranslation\":\"Bữa sáng cho cả nhà!\",\"rating\":9.0},\n  {\"id\":745372,\"suggestgation\":\"Cái giường cho chim non to đùng!\",\"rating\":9.0},\n  {\"id\":745373,\"suggestedTranslation\":\"Do bạn của Wolfgang làm đấy. Măm măm.\",\"rating\":9.0},\n  {\"id\":745374,\"suggestedTranslation\":\"Làm ta nhớ đến ông chú!\",\"rating\":9.0},\n  {\"id\":745375,\"suggestedTranslation\":\"Hết hút máu của ngươi nhé!\",\"rating\":9.0},\n  {\"id\":745376,\"suggestedTranslation\":\"Cái túi vo ve phát nổ.\",\"rating\":9.0},\n  {\"id\":745377,\"suggestedTranslation\":\"Eo ôi, cái túi nhỏ thơm mùi súp củ cải tháng trước!\",\"rating\":9.0},\n  {\"id\":745378,\"suggestedTranslation\":\"Wolfgang đã ghét kim tiêm sẵn rồi... thế này lại càng tệ hơn.\",\"rating\":9.0},\n  {\"id\":745379,\"suggestedTranslation\":\"Côn trùng bạn bè ôm cái nào!\",\"rating\":9.0},\n  {\"id\":745380,\"suggestedTranslation\":\"Ông chú không có cái bụng thế này đâu.\",\"rating\":9.0},\n  {\"id\":745381,\"suggestedTranslation\":\"Mmmm. Chắc vẫn là bữa sáng thôi.\",\"rating\":9.0},\n  {\"id\":745382,\"suggestedTranslation\":\"Xin lỗi nhé, người chết ơi.\",\"rating\":9.0},\n  {\"id\":745383,\"suggestedTranslation\":\"Đáng sợ quá! Chắc là đầy xương là xương rồi!\",\"rating\":9.0},\n  {\"id\":745384,\"suggestedTranslation\":\"Thức uống ngon và ấm cúng.\",\"rating\":9.0},\n  {\"id\":745385,\"suggestedTranslation\":\"Sao cái cửa này không sụp xuống trước những cú đấm uy lực của Wolfgang chứ?!\",\"rating\":9.0},\n  {\"id\":745386,\"suggestedTranslation\":\"Cũng khỏe mạnh y như Wolfgang vậy.\",\"rating\":9.0},\n  {\"id\":745387,\"suggestedTranslation\":\"Chặt và đào! Ta làm việc đó cả ngày được.\",\"rating\":9.0},\n  {\"id\":745388,\"suggestedTranslation\":\"Gã người nấm nhỏ bé.\",\"rating\":9.0},\n  {\"id\":745389,\"suggestedTranslation\":\"Cục nấm phát nổ nguy hiểm quá!\",\"rating\":9.0},\n  {\"id\":745390,\"suggestedTranslation\":\"Là nấm... dùng để đội đầu!\",\"rating\":9.0},\n  {\"id\":745391,\"suggestedTranslation\":\"Cây nấm cao giờ cháy tiêu rồi!\",\"rating\":9.0},\n  {\"id\":745392,\"suggestedTranslation\":\"Cây nấm cao trông tệ thật đấy!\",\"rating\":9.0},\n  {\"id\":745393,\"suggestedTranslation\":\"Khúc gỗ trông chẳng uy phong chút nào!\",\"rating\":9.0},\n  {\"id\":745394,\"suggestedTranslation\":\"Chẳng có gì cả.\",\"rating\":9.0},\n  {\"id\":745395,\"suggestedTranslation\":\"Nhiều nấm nhỏ thế không biết!\",\"rating\":9.0},\n  {\"id\":745396,\"suggestedTranslation\":\"Khúc gỗ mục cần phải được thay thế rồi.\",\"rating\":9.0},\n  {\"id\":745397,\"suggestedTranslation\":\"Mấy cây nấm chưa đủ mạnh để chống lại tuyết đâu!\",\"rating\":9.0},\n  {\"id\":745398,\"suggestedTranslation\":\"Mấy cây nấm nhỏ bắt đầu mọc lên rồi kìa.\",\"rating\":9.0},\n  {\"id\":745399,\"suggestedTranslation\":\"Hết chỗ chứa nấm nữa rồi!\",\"rating\":9.0},\n  {\"id\":745400,\"suggestedTranslation\":\"Đèn nhỏ cháy sáng quá hóa hỏng à?\",\"rating\":9.0},\n  {\"id\":745401,\"suggestedTranslation\":\"Cây nấm to chắc tạo ra được chút ánh sáng nhỏ.\",\"rating\":9.0},\n  {\"id\":745402,\"suggestedTranslation\":\"Ánh sáng đẹp thật. Dịu nhẹ.\",\"rating\":9.0},\n  {\"id\":745403,\"suggestedTranslation\":\"Hết đèn nhỏ rồi.\",\"rating\":9.0},\n  {\"id\":745404,\"suggestedTranslation\":\"Làm sao Wolfgang bật đèn nấm lên được nhỉ?\",\"rating\":9.0},\n  {\"id\":745405,\"suggestedTranslation\":\"Cây nấm cao tạo ra ánh sáng đẹp quá chừng!\",\"rating\":9.0},\n  {\"id\":745406,\"suggestedTranslation\":\"Cây nấm có mùi không lành mạnh lắm.\",\"rating\":9.0},\n  {\"id\":745407,\"suggestedTranslation\":\"Nó đang vu