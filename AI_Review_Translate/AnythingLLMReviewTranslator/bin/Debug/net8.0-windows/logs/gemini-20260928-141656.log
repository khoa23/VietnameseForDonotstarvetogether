lation\": \"Tôi tìm thấy cái này dưới lòng đất.\", \"rating\": 9.0},\n  {\"id\": 750184, \"suggestedTranslation\": \"Cục đá. Chán chết.\", \"rating\": 9.0},\n  {\"id\": 750185, \"suggestedTranslation\": \"Nghệ thuật làm đá đẹp phết!\", \"rating\": 9.0},\n  {\"id\": 750186, \"suggestedTranslation\": \"Cục đá. Chán chết.\", \"rating\": 9.0},\n  {\"id\": 750187, \"suggestedTranslation\": \"Sàn nhà xứng tầm quốc vương!\", \"rating\": 9.0},\n  {\"id\": 750188, \"suggestedTranslation\": \"Ngày lễ Gà Tây lại đến rồi!\", \"rating\": 9.0},\n  {\"id\": 750189, \"suggestedTranslation\": \"Lấy từ khu vườn cộng đồng đấy.\", \"rating\": 9.0},\n  {\"id\": 750190, \"suggestedTranslation\": \"Nấu chín kỹ phết.\", \"rating\": 9.0},\n  {\"id\": 750191, \"suggestedTranslation\": \"Trông giống hạt cây trồng mới với tôi lắm.\", \"rating\": 9.0},\n  {\"id\": 750192, \"suggestedTranslation\": \"Phải ngăn con đó trốn đi chứ, nhỉ?\", \"rating\": 9.0},\n  {\"id\": 750193, \"suggestedTranslation\": \"Xin lỗi nhé!\", \"rating\": 9.0},\n  {\"id\": 750194, \"suggestedTranslation\": \"Tệ thật đấy!\", \"rating\": 9.0},\n  {\"id\": 750195, \"suggestedTranslation\": \"Lại thêm một cây nữa!\", \"rating\": 9.0},\n  {\"id\": 750196, \"suggestedTranslation\": \"Nó bị sâu bọ đục khoét chút rồi.\", \"rating\": 9.0},\n  {\"id\": 750197, \"suggestedTranslation\": \"Chặt thì cứ chặt thôi.\", \"rating\": 9.0},\n  {\"id\": 750198, \"suggestedTranslation\": \"Chăm sóc cẩn thận một chút là tha hồ mà chặt.\", \"rating\": 9.0},\n  {\"id\": 750199, \"suggestedTranslation\": \"Rồi sẽ có lúc nó trở thành mục tiêu chặt chém ngon lành.\", \"rating\": 9.0},\n  {\"id\": 750200, \"suggestedTranslation\": \"May lắm thì tôi mới chặt được hai nhát từ thứ đó.\", \"rating\": 9.0},\n  {\"id\": 750201, \"suggestedTranslation\": \"Tôi nên chế một cái rìu siêu nhỏ để chặt mấy thứ này.\", \"rating\": 9.0},\n  {\"id\": 750202, \"suggestedTranslation\": \"Lucy, hình như tôi bắt đầu nhìn gà hóa cuốc rồi!\", \"rating\": 9.0},\n  {\"id\": 750203, \"suggestedTranslation\": \"Lucy, hình như tôi bắt đầu nhìn gà hóa cuốc rồi!\", \"rating\": 9.0},\n  {\"id\": 750204, \"suggestedTranslation\": \"Thứ như thế này sẽ giữ cho bộ râu của tôi được khô ráo nhỉ?\", \"rating\": 9.0},\n  {\"id\": 750205, \"suggestedTranslation\": \"Nó sẽ làm cậu no nê đấy.\", \"rating\": 9.0},\n  {\"id\": 750206, \"suggestedTranslation\": \"Trông nó không giống một két sắt an toàn cho lắm.\", \"rating\": 9.0},\n  {\"id\": 750207, \"suggestedTranslation\": \"Tốt nhất nên cẩn thận khi ở quanh đây.\", \"rating\": 9.0},\n  {\"id\": 750208, \"suggestedTranslation\": \"Tôi đâu cần chỉ đường cơ chứ, phải không Luce? ...Cái vẻ mặt gì thế kia?\", \"rating\": 9.0},\n  {\"id\": 750209, \"suggestedTranslation\": \"Có vẻ như chúng ta đã đến nơi rồi nhỉ?\", \"rating\": 9.0},\n  {\"id\": 750210, \"suggestedTranslation\": \"Hừm. Hình như không dò ra được gì ở chỗ này.\", \"rating\": 9.0},\n  {\"id\": 750211, \"suggestedTranslation\": \"Mày đâu chỉ đến đây để làm phiền tao phải không?\", \"rating\": 9.0},\n  {\"id\": 750212, \"suggestedTranslation\": \"Và cứ ở yên đấy nhé!\", \"rating\": 9.0},\n  {\"id\": 750213, \"suggestedTranslation\": \"Tệ lắm thì chuyện gì có thể xảy ra được cơ chứ, nhỉ?\", \"rating\": 9.0},\n  {\"id\": 750214, \"suggestedTranslation\": \"Tôi không thích cảm giác bị nhốt tịt lại đâu.\", \"rating\": 9.0},\n  {\"id\": 750215, \"suggestedTranslation\": \"Làm tôi nhớ đến mấy cái phòng xông hơi khô.\", \"rating\": 9.0},\n  {\"id\": 750216, \"suggestedTranslation\": \"Thật khó tin là thứ này thực sự có thể đưa chúng ta về nhà...\", \"rating\": 9.0},\n  {\"id\": 750217, \"suggestedTranslation\": \"Hừm. Trông có vẻ như phải nhét thứ gì đó vào bên trong.\", \"rating\": 9.0},\n  {\"id\": 750218, \"suggestedTranslation\": \"Không thể cột dây thừng ở đây được à?\", \"rating\": 9.0},\n  {\"id\": 750219, \"suggestedTranslation\": \"Nó nằm ngay đấy để chờ lấy thôi.\", \"rating\": 9.0},\n  {\"id\": 750220, \"suggestedTranslation\": \"Nó mất tiêu rồi.\", \"rating\": 9.0},\n  {\"id\": 750221, \"suggestedTranslation\": \"Thả một sợi dây thừng xuống sẽ giúp việc quay lại đây dễ dàng hơn nhiều.\", \"rating\": 9.0},\n  {\"id\": 750222, \"suggestedTranslation\": \"Tự hỏi nó dùng để làm gì nhỉ.\", \"rating\": 9.0}\n]",
