            "text": "[\n  {\n    \"id\": 754826,\n    \"suggestedTranslation\": \"Ta không... đi tiếp được nữa!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754827,\n    \"suggestedTranslation\": \"Thật là... nặng nề... quá đi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754831,\n    \"suggestedTranslation\": \"Ta bị đày đến chiều không gian bóng đêm rồi!\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 754832,\n    \"suggestedTranslation\": \"Ta đã trở lại chiều không gian này!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754833,\n    \"suggestedTranslation\": \"Suýt chút nữa thì bỏ mạng bên trong rồi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754834,\n    \"suggestedTranslation\": \"Ta đoán đây không phải là một chuyến thăm thân thiện đâu nhỉ? Hyuyu...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754835,\n    \"suggestedTranslation\": \"Ánh sáng ban ngày giữ cho con mắt phải nép mình!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754836,\n    \"suggestedTranslation\": \"Hyuyu, lại đến tìm chút vui vẻ nữa sao?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754837,\n    \"suggestedTranslation\": \"Ta mất cái quạt rồi!\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 754838,\n    \"suggestedTranslation\": \"Ta đang khám phá bí mật về đám phân bón làm vườn này.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754839,\n    \"suggestedTranslation\": \"Đám tầm ma khó ưa thật!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754840,\n    \"suggestedTranslation\": \"Ái! Trong đám tầm ma đó không có tí bạc nào đâu nhỉ?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754841,\n    \"suggestedTranslation\": \"Xem ra ta đã vượt qua cái nóng rồi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754842,\n    \"suggestedTranslation\": \"Một người bạn đang mời ta chơi kìa!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754843,\n    \"suggestedTranslation\": \"Lông ướt ư? Để làm gì chứ?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754844,\n    \"suggestedTranslation\": \"Không kịp gieo vần r-\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754845,\n    \"suggestedTranslation\": \"Bơi một dặm xong là ta cần nghỉ ngơi một dặm!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754847,\n    \"suggestedTranslation\": \"Ta được tự do rồi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754849,\n    \"suggestedTranslation\": \"Bọn ma chơi... những trò chơi kỳ lạ...\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754851,\n    \"suggestedTranslation\": \"Sảng khoái thật!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754852,\n    \"suggestedTranslation\": \"Ôi rắc rối thật, thoát khỏi cơn mưa axit đúng là vào két sắt mà!\",\n    \"rating\": 8.0\n  },\n  {\n    \"id\": 754853,\n    \"suggestedTranslation\": \"Khả năng chống lửa của ta vừa hết hiệu lực rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754854,\n    \"suggestedTranslation\": \"Chuyện nhỏ ấy mà, thật đấy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754855,\n    \"suggestedTranslation\": \"Vẫn ở đây, ta e là thế!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754856,\n    \"suggestedTranslation\": \"Hôm nay đại não của ta đã phát triển thêm ba nấc rồi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754857,\n    \"suggestedTranslation\": \"Nóng, nóng, nóng quá!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754858,\n    \"suggestedTranslation\": \"Lũ quái thú đang hú gọi kìa!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754859,\n    \"suggestedTranslation\": \"Ôi không, ta lại đói rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754860,\n    \"suggestedTranslation\": \"Một lối mòn dành cho kẻ chân mềm.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754861,\n    \"suggestedTranslation\": \"Ta rất thích chơi trốn tìm!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754862,\n    \"suggestedTranslation\": \"Ván này ngươi thắng đấy!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 754863,\n    \"suggestedTranslation\": \"Bị phá bĩnh bởi sự nhão nhoét của cõi nà