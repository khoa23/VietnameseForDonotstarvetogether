            "text": "[\n  {\"id\": 749622, \"suggestedTranslation\": \"Tôi phải kiên nhẫn thôi.\", \"rating\": 9.0},\n  {\"id\": 749623, \"suggestedTranslation\": \"Lửa làm tôi thấy hồi hộp quá.\", \"rating\": 9.0},\n  {\"id\": 749624, \"suggestedTranslation\": \"Cây sậy.\", \"rating\": 9.0},\n  {\"id\": 749625, \"suggestedTranslation\": \"Chúng sẽ mọc lại thôi.\", \"rating\": 9.5},\n  {\"id\": 749626, \"suggestedTranslation\": \"Trông giống đường phong quá. Dù vậy chắc tôi không muốn ăn đâu.\", \"rating\": 9.0},\n  {\"id\": 749627, \"suggestedTranslation\": \"Tôi vẫn không tin vải kẻ sọc không phải là trang phục mọi thời tiết đấy.\", \"rating\": 9.0},\n  {\"id\": 749628, \"suggestedTranslation\": \"Tôi không tính sửa cái đó đâu.\", \"rating\": 9.0},\n  {\"id\": 749629, \"suggestedTranslation\": \"Sao nó lại cháy được thế cơ chứ?!\", \"rating\": 9.0},\n  {\"id\": 749630, \"suggestedTranslation\": \"Tôi không tin tưởng mấy cái thứ khoa học này đâu.\", \"rating\": 9.0},\n  {\"id\": 749631, \"suggestedTranslation\": \"Chà, nó tuân theo vài định luật vật lý cơ bản đấy.\", \"rating\": 9.0},\n  {\"id\": 749632, \"suggestedTranslation\": \"Mọi chuyện bắt đầu trở nên kỳ lạ rồi đấy.\", \"rating\": 9.0},\n  {\"id\": 749633, \"suggestedTranslation\": \"Không, chịu thua rồi.\", \"rating\": 9.0},\n  {\"id\": 749634, \"suggestedTranslation\": \"Được rồi, giờ thì tôi hơi hiểu rồi đấy.\", \"rating\": 9.0},\n  {\"id\": 749635, \"suggestedTranslation\": \"Đây là lý do tại sao tôi không dùng đồ giữ ấm mũ đấy.\", \"rating\": 9.0},\n  {\"id\": 749636, \"suggestedTranslation\": \"Tôi thích gọi nó là \\\"Cái Máy Làm Mũ\\\"!\", \"rating\": 9.0},\n  {\"id\": 749637, \"suggestedTranslation\": \"Đổi gió chút cũng hay nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749638, \"suggestedTranslation\": \"Thật là đáng tiếc.\", \"rating\": 9.0},\n  {\"id\": 749639, \"suggestedTranslation\": \"Tất cả mấy người bạn của tôi đều có thể cải thiện bằng gỗ.\", \"rating\": 9.0},\n  {\"id\": 749640, \"suggestedTranslation\": \"Tôi không biết mình có nên chạm vào đó không nữa.\", \"rating\": 9.0},\n  {\"id\": 749641, \"suggestedTranslation\": \"Tôi cần phải chia sẻ chuyện này với ai đó mới được!\", \"rating\": 9.0},\n  {\"id\": 749642, \"suggestedTranslation\": \"Chúng rất thích va ngực vào nhau kiểu đó đấy, phải không?\", \"rating\": 9.0},\n  {\"id\": 749643, \"suggestedTranslation\": \"Loại chim yêu thích của tôi là chim quay.\", \"rating\": 9.0},\n  {\"id\": 749644, \"suggestedTranslation\": \"Đúng là một tên nhóc hỗn xược.\", \"rating\": 9.0},\n  {\"id\": 749645, \"suggestedTranslation\": \"Đừng có mà thoải mái quá đấy, chú chim nhỏ.\", \"rating\": 9.0},\n  {\"id\": 749646, \"suggestedTranslation\": \"Bay về phương nam hay đi đâu đi chứ!\", \"rating\": 9.0},\n  {\"id\": 749647, \"suggestedTranslation\": \"Nó đang rút bớt hơi ấm của tôi kìa.\", \"rating\": 9.0},\n  {\"id\": 749648, \"suggestedTranslation\": \"Cái này, ơ... có tính nhân đạo không vậy?\", \"rating\": 9.0},\n  {\"id\": 749649, \"suggestedTranslation\": \"Chúng bị mắc kẹt rồi!\", \"rating\": 9.0},\n  {\"id\": 749650, \"suggestedTranslation\": \"Tôi có thể đập nát nó nếu cố gắng đủ sức.\", \"rating\": 9.0},\n  {\"id\": 749651, \"suggestedTranslation\": \"Dùng mấy cái này dựng một đống đá inukshuk nhỏ cũng tàm tạm.\", \"rating\": 9.0},\n  {\"id\": 749652, \"suggestedTranslation\": \"Đến giờ ăn tối tôm hùm rồi!\", \"rating\": 9.0},\n  {\"id\": 749653, \"suggestedTranslation\": \"Chẳng còn chút gì trong đó nữa rồi.\", \"rating\": 9.0},\n  {\"id\": 749654, \"suggestedTranslation\": \"Chà, thế thì không ổn chút nào.\", \"rating\": 9.0},\n  {\"id\": 749655, \"suggestedTranslation\": \"Cái đó có lẽ tiêu đời rồi.\", \"rating\": 9.0},\n  {\"id\": 749656, \"suggestedTranslation\": \"Nó đang bốc mùi hôi rồi kìa.\", \"rating\": 9.0},\n  {\"id\": 749657, \"suggestedTranslation\": \"Đó là quả à?\", \"rating\": 9.0},\n  {\"id\": 749658, \"suggestedTranslation\": \"Đó chỉ là một bụi cây bình thường.\", \"rating\": 9.0},\n  {\"id\": 749659, \"suggestedTranslation\": \"Ngoài này nóng ghê.\", \"rating\": 9.0},\n  {\"id\": 749660, \"suggestedTranslation\": \"Cứng quá khó ăn, nhưng ít ra ngửi thơm phết.\", \"rating\": 9.0},\n  {\"id\": 749661, \"suggestedTranslation\": \"Tôi nghĩ giờ mình có thể cắn một miếng vào nó rồi.\", \"rating\": 9.0},\n  {\"id\": 749662, \"suggestedTranslation\": \"Ước gì mình có ít bánh mì nướng.\", \"rating\": 9.0},\n  {\"id\": 749663, \"suggestedTranslation\": \"Chắc chúng ta ăn cái đó không kịp lúc rồi.\", \"rating\": 9.0},\n  {\"id\": 749664, \"suggestedTranslation\": \"Nhà ơi, ngọt ngào làm sao!\", \"rating\": 9.0},\n  {\"id\": 749665, \"suggestedTranslation\": \"Ở quê nhà tôi, chúng chẳng bao giờ tan chảy cả.\", \"rating\": 9.0},\n  {\"id\": 749666, \"suggestedTranslation\": \"Ở quê nhà tôi, chúng chẳng bao giờ tan chảy cả.\", \"rating\": 9.0},\n  {\"id\": 749667, \"suggestedTranslation\": \"Trông nó có vẻ hơi đóng vảy rồi.\", \"rating\": 9.0},\n  {\"id\": 749668, \"suggestedTranslation\": \"Cần thêm... gỗ à?\", \"rating\": 9.0},\n  {\"id\": 749669, \"suggestedTranslation\": \"Ngọn lửa mà chẳng cần đến củi ư? Thật là phi tự nhiên!\", \"rating\": 9.0},\n  {\"id\": 749670, \"suggestedTranslation\": \"Trông nó có vẻ sắp vỡ tung đến nơi rồi.\", \"rating\": 9.0},\n  {\"id\": 749671, \"suggestedTranslation\": \"Nó là, ừm, một viên đá Mặt Trăng.\", \"rating\": 9.0},\n  {\"id\": 749672, \"suggestedTranslation\": \"Thật là... vô nghĩa.\", \"rating\": 9.0},\n  {\"id\": 749673, \"suggestedTranslation\": \"Thật là... vô nghĩa.\", \"rating\": 9.0},\n  {\"id\": 749674, \"suggestedTranslation\": \"Hừm... con xe di chuyển theo đường thẳng phải không nhỉ? Tôi quên mất tiêu.\", \"rating\": 9.0},\n  {\"id\": 749675, \"suggestedTranslation\": \"Bánh răng đang rơiả lả tả kìa.\", \"rating\": 9.0},\n  {\"id\": 749676, \"suggestedTranslation\": \"Rất hợp để buộc thứ này vào thứ khác.\", \"rating\": 9.0},\n  {\"id\": 749677, \"suggestedTranslation\": \"Liệu nó có chịu được không, Lucy?\", \"rating\": 9.0},\n  {\"id\": 749678, \"suggestedTranslation\": \"Thành thật mà nói, chúng trông khá đáng yêu đấy.\", \"rating\": 9.0},\n  {\"id\": 749680, \"suggestedTranslation\": \"Bớt đi một con chim. Tốt.\", \"rating\": 9.0},\n  {\"id\": 749681, \"suggestedTranslation\": \"Tôi đủ oai phong lẫm liệt rồi.\", \"rating\": 9.0},\n  {\"id\": 749682, \"suggestedTranslation\": \"Đồ nội thất bị hỏng.\", \"rating\": 9.0},\n  {\"id\": 749683, \"suggestedTranslation\": \"Nó không phải mũ len toque, nhưng tạm dùng cũng được.\", \"rating\": 9.0},\n  {\"id\": 749684, \"suggestedTranslation\": \"Kim loại gắn trên gậy.\", \"rating\": 9.0},\n  {\"id\": 749685, \"suggestedTranslation\": \"Hỏng bét hết cả rồi.\", \"rating\": 9.0},\n  {\"id\": 749686, \"suggestedTranslation\": \"Nó làm râu cạo của tôi dựng đứng cả lên.\", \"rating\": 9.0},\n  {\"id\": 749687, \"suggestedTranslation\": \"Nó đang vắt óc suy nghĩ đấy.\", \"rating\": 9.0},\n  {\"id\": 749688, \"suggestedTranslation\": \"Đưa sinh vật này trở lại với tự nhiên như vốn có.\", \"rating\": 9.0},\n  {\"id\": 749689, \"suggestedTranslation\": \"Ừm, cái đó sẽ đưa chúng ta tới nơi.\", \"rating\": 9.0},\n  {\"id\": 749690, \"suggestedTranslation\": \"Làm tôi có cảm giác giống như một dạng thần rừng nào đó ấy, nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749691, \"suggestedTranslation\": \"Trông có vẻ giống chúa đảo quá nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749692, \"suggestedTranslation\": \"Làm tôi có cảm giác như một cảnh sát Kỵ binh Canada.\", \"rating\": 9.0},\n  {\"id\": 749693, \"suggestedTranslation\": \"Giống như đôi cánh của một con chim khổng lồ. Ờ hở.\", \"rating\": 9.0},\n  {\"id\": 749694, \"suggestedTranslation\": \"Lần sau Lucy sẽ giúp cậu băm rau củ đấy, đúng không bạn hiền?\", \"rating\": 9.0},\n  {\"id\": 749695, \"suggestedTranslation\": \"Nó giống như tủ lạnh, nhưng mà là muối!\", \"rating\": 9.0},\n  {\"id\": 749696, \"suggestedTranslation\": \"Nhìn vào đó thôi mà miệng tôi đã khô khốc cả lên rồi.\", \"rating\": 9.0},\n  {\"id\": 749697, \"suggestedTranslation\": \"Tôi đã liếm thử một hai lần. Cũng tạm được.\", \"rating\": 9.0},\n  {\"id\": 749698, \"suggestedTranslation\": \"Nó trắng lóa như những ngọn núi phía Bắc ấy!\", \"rating\": 9.0},\n  {\"id\": 749699, \"suggestedTranslation\": \"Tự nhiên thật lắm điều kỳ diệu nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749700, \"suggestedTranslation\": \"Nhìn kìa, nó đang mọc lại rồi!\", \"rating\": 9.0},\n  {\"id\": 749701, \"suggestedTranslation\": \"Chắc là hết rồi đấy.\", \"rating\": 9.0},\n  {\"id\": 749702, \"suggestedTranslation\": \"Chào bạn hiền!\", \"rating\": 9.0},\n  {\"id\": 749703, \"suggestedTranslation\": \"Ít ra nó không thu hút lũ chim.\", \"rating\": 9.0},\n  {\"id\": 749704, \"suggestedTranslation\": \"Tay nghề chế tác khá đấy chứ.\", \"rating\": 9.0},\n  {\"id\": 749705, \"suggestedTranslation\": \"Đúng là độc đáo thật đấy, phải không?\", \"rating\": 9.0},\n  {\"id\": 749706, \"suggestedTranslation\": \"Có cái gì đó không ổn với cục đá đó thì phải, nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749707, \"suggestedTranslation\": \"Thế thì hợp lý đấy.\", \"rating\": 9.0},\n  {\"id\": 749708, \"suggestedTranslation\": \"Ái chà! Nó còn chưa kịp có cơ hội lớn lên nữa!\", \"rating\": 9.0},\n  {\"id\": 749709, \"suggestedTranslation\": \"Nó bị nhiễm chút bệnh dịch rồi.\", \"rating\": 9.0},\n  {\"id\": 749710, \"suggestedTranslation\": \"Đúng là một khúc gỗ tồi tàn.\", \"rating\": 9.0},\n  {\"id\": 749711, \"suggestedTranslation\": \"Tôi muốn thấy nó lớn lên để còn đốn ngã nó chứ.\", \"rating\": 9.0},\n  {\"id\": 749712, \"suggestedTranslation\": \"Hái nhặt chẳng vui bằng chặt chém đâu.\", \"rating\": 9.0},\n  {\"id\": 749713, \"suggestedTranslation\": \"Với cái nóng thế này thì chẳng bao giờ lớn kịp để mà chặt đâu!\", \"rating\": 9.0},\n  {\"id\": 749714, \"suggestedTranslation\": \"Thu gọn tự nhiên thành một đống số liệu và sự kiện thế này hình như không đúng lắm.\", \"rating\": 9.0},\n  {\"id\": 749715, \"suggestedTranslation\": \"May là không phải tôi.\", \"rating\": 9.0},\n  {\"id\": 749716, \"suggestedTranslation\": \"Tuyệt, giờ thì đám gà gô lông lá đó sắp quậy tưng bừng rồi.\", \"rating\": 9.0},\n  {\"id\": 749717, \"suggestedTranslation\": \"Anh ta đang làm việc thiện cho thế giới đấy.\", \"rating\": 9.0},\n  {\"id\": 749718, \"suggestedTranslation\": \"Ối trời.\", \"rating\": 9.0},\n  {\"id\": 749719, \"suggestedTranslation\": \"Hửm. Không biết nó từ đâu ra nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749720, \"suggestedTranslation\": \"Miễn là bảo vệ được cái đầu trọc này là được, nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749721, \"suggestedTranslation\": \"Tôi nhìn thấy rõ cả bốn phương tám hướng luôn!\", \"rating\": 9.0},\n  {\"id\": 749722, \"suggestedTranslation\": \"Tôi hợp với việc đẽo gọt hơn.\", \"rating\": 9.0},\n  {\"id\": 749723, \"suggestedTranslation\": \"Quay lại việc đẽo gọt thôi.\", \"rating\": 9.0},\n  {\"id\": 749724, \"suggestedTranslation\": \"Nên đặt một khối đá xẻ lên trên đó.\", \"rating\": 9.0},\n  {\"id\": 749725, \"suggestedTranslation\": \"Hừm. Không tệ nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749726, \"suggestedTranslation\": \"Tôi không hiểu nghệ thuật lắm. Cậu nghĩ sao hả Lucy?\", \"rating\": 9.0},\n  {\"id\": 749727, \"suggestedTranslation\": \"Tên nào nghĩ ra ý tưởng sáng suốt đem sửa cái thứ này thế không biết?\", \"rating\": 9.0},\n  {\"id\": 749728, \"suggestedTranslation\": \"Đá mà cũng chuyển động được thế này á?\", \"rating\": 9.0},\n  {\"id\": 749729, \"suggestedTranslation\": \"Đáng sợ thật.\", \"rating\": 9.0},\n  {\"id\": 749730, \"suggestedTranslation\": \"Trông có vẻ không ổn lắm.\", \"rating\": 9.0},\n  {\"id\": 749731, \"suggestedTranslation\": \"Thấy một bức tượng kỳ quái rồi thì coi như thấy hết rồi.\", \"rating\": 9.0},\n  {\"id\": 749732, \"suggestedTranslation\": \"Chỉ cần một ít băng dính là được.\", \"rating\": 9.0},\n  {\"id\": 749733, \"suggestedTranslation\": \"Đá mà cũng chuyển động được thế này á?\", \"rating\": 9.0},\n  {\"id\": 749734, \"suggestedTranslation\": \"Eo ôi. Bỏ nó lại vào trong đi.\", \"rating\": 9.0},\n  {\"id\": 749735, \"suggestedTranslation\": \"Đúng là một gã nặng nề.\", \"rating\": 9.0},\n  {\"id\": 749736, \"suggestedTranslation\": \"Theo tôi thì đó chỉ là một khối đá lớn thôi.\", \"rating\": 9.0},\n  {\"id\": 749737, \"suggestedTranslation\": \"Cứ như thể tôi chưa có đủ lý do để ghét trăng tròn vậy.\", \"rating\": 9.0},\n  {\"id\": 749738, \"suggestedTranslation\": \"Đá mà cũng chuyển động được thế này á?\", \"rating\": 9.0},\n  {\"id\": 749739, \"suggestedTranslation\": \"Trông hơi giống mấy tên húc càn đó.\", \"rating\": 9.0},\n  {\"id\": 749740, \"suggestedTranslation\": \"Đó chỉ là một khối đá cẩm thạch lớn thôi.\", \"rating\": 9.0},\n  {\"id\": 749741, \"suggestedTranslation\": \"Trông có vẻ giòn hơn bình thường một chút.\", \"rating\": 9.0},\n  {\"id\": 749742, \"suggestedTranslation\": \"Sẵn sàng cho mọi tình huống trên biển là điều tốt.\", \"rating\": 9.0},\n  {\"id\": 749743, \"suggestedTranslation\": \"Quê tôi không có món này.\", \"rating\": 9.0},\n  {\"id\": 749744, \"suggestedTranslation\": \"Đó là núi đá biển.\", \"rating\": 9.0},\n  {\"id\": 749745, \"suggestedTranslation\": \"Ai đó mau đi dọn sạch cái bẫy này đi.\", \"rating\": 9.0},\n  {\"id\": 749746, \"suggestedTranslation\": \"Lạy Ngũ Đại Hồ, tôi nghĩ nó tóm được gì đó rồi!\", \"rating\": 9.0},\n  {\"id\": 749747, \"suggestedTranslation\": \"Một chiếc túi đựng hạt tiện lợi.\", \"rating\": 9.0},\n  {\"id\": 749748, \"suggestedTranslation\": \"Không phải cây.\", \"rating\": 9.0},\n  {\"id\": 749749, \"suggestedTranslation\": \"Chúng tôi gọi đây là \\\"món quà bất ngờ của thợ đốn gỗ\\\".\", \"rating\": 9.0},\n  {\"id\": 749750, \"suggestedTranslation\": \"Trông đó là một cái cây kỳ lạ.\", \"rating\": 9.0},\n  {\"id\": 749751, \"suggestedTranslation\": \"Tôi khâu vá cũng khá giỏi đấy.\", \"rating\": 9.0},\n  {\"id\": 749752, \"suggestedTranslation\": \"Tôi vừa mới bắt đầu quen với việc có nó ở quanh đây.\", \"rating\": 9.0},\n  {\"id\": 749753, \"suggestedTranslation\": \"Kiệm lời nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749754, \"suggestedTranslation\": \"Làm tôi có cảm giác như đang ở nhà vậy.\", \"rating\": 9.0},\n  {\"id\": 749755, \"suggestedTranslation\": \"Chà, có vẻ như anh ta cuối cùng cũng phát điên rồi.\", \"rating\": 9.0},\n  {\"id\": 749756, \"suggestedTranslation\": \"Mấy người bạn nhỏ của cậu, ừm... còn sống không đấy?\", \"rating\": 9.0},\n  {\"id\": 749757, \"suggestedTranslation\": \"Trời ạ. Đừng mang cái đó lại gần tôi.\", \"rating\": 9.0},\n  {\"id\": 749758, \"suggestedTranslation\": \"Nhìn kỹ chân bước đấy.\", \"rating\": 9.0},\n  {\"id\": 749759, \"suggestedTranslation\": \"Nó dày bằng cả một gốc cây sồi đấy!\", \"rating\": 9.0},\n  {\"id\": 749760, \"suggestedTranslation\": \"Nó bị lật ngửa nhưng vẫn chưa chịu gục đâu.\", \"rating\": 9.0},\n  {\"id\": 749761, \"suggestedTranslation\": \"Tôi không biết đầu nào xấu hơn nữa.\", \"rating\": 9.0},\n  {\"id\": 749762, \"suggestedTranslation\": \"Tốt nhất là ngươi nên giữ tay tránh xa cái rìu của ta ra!\", \"rating\": 9.0},\n  {\"id\": 749763, \"suggestedTranslation\": \"Tốt hơn là đừng đến quá gần gã to xác đó.\", \"rating\": 9.0},\n  {\"id\": 749764, \"suggestedTranslation\": \"Trời ạ, nụ cười đó làm tôi nổi cả da gà.\", \"rating\": 9.0},\n  {\"id\": 749765, \"suggestedTranslation\": \"Nó làm tôi thấy khó chịu.\", \"rating\": 9.0},\n  {\"id\": 749766, \"suggestedTranslation\": \"Ngươi không phải dạng chim chóc nào đó đang ẩn nấp dưới cái mũ trùm đấy chứ?\", \"rating\": 9.0},\n  {\"id\": 749767, \"suggestedTranslation\": \"Lucy, tôi có thể giải thích mà!\", \"rating\": 9.0},\n  {\"id\": 749768, \"suggestedTranslation\": \"Cái này sẽ gọi con bé quay lại ngay.\", \"rating\": 9.0},\n  {\"id\": 749769, \"suggestedTranslation\": \"Đây thực sự là một ý hay sao?\", \"rating\": 9.0},\n  {\"id\": 749770, \"suggestedTranslation\": \"Cứ ngồi lỳ ra đấy thì chẳng ích gì đâu.\", \"rating\": 9.0},\n  {\"id\": 749771, \"suggestedTranslation\": \"Đừng lo, Lucy. Tôi không để nó tóm lấy cậu đâu.\", \"rating\": 9.0},\n  {\"id\": 749772, \"suggestedTranslation\": \"Ừ, chúng chết rồi.\", \"rating\": 9.0},\n  {\"id\": 749773, \"suggestedTranslation\": \"Đúng là một gã to xác!\", \"rating\": 9.0},\n  {\"id\": 749774, \"suggestedTranslation\": \"Tôi thường thích câu cá trên băng, nhưng không phải khi lũ cá cắn ngược lại!\", \"rating\": 9.0},\n  {\"id\": 749775, \"suggestedTranslation\": \"Tôi không nghĩ nó dùng để muối dưa đâu.\", \"rating\": 9.0},\n  {\"id\": 749776, \"suggestedTranslation\": \"Tôi hầu như chẳng nỡ phá vỡ một đám gắn kết khăng khít thế này.\", \"rating\": 9.0},\n  {\"id\": 749777, \"suggestedTranslation\": \"Hừm, răng kim loại chắc sẽ tiện lắm để chặt củi đây...\", \"rating\": 9.0},\n  {\"id\": 749778, \"suggestedTranslation\": \"Đào hố. Trồng thực vật!\", \"rating\": 9.0},\n  {\"id\": 749779, \"suggestedTranslation\": \"Đào bới lên nào!\", \"rating\": 9.0},\n  {\"id\": 749780, \"suggestedTranslation\": \"Cái đó kinh tởm thật đấy.\", \"rating\": 9.0},\n  {\"id\": 749781, \"suggestedTranslation\": \"Nhão nhoét đủ mọi kiểu luôn nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749782, \"suggestedTranslation\": \"Gớm ghiếc thật.\", \"rating\": 9.0},\n  {\"id\": 749783, \"suggestedTranslation\": \"Chỉ còn là cái vỏ rỗng.\", \"rating\": 9.0},\n  {\"id\": 749784, \"suggestedTranslation\": \"Chợp mắt rất quan trọng trong một ngày dài đốn củi.\", \"rating\": 9.0},\n  {\"id\": 749785, \"suggestedTranslation\": \"Nhện làm tôi nổi cả da gà.\", \"rating\": 9.0},\n  {\"id\": 749786, \"suggestedTranslation\": \"Giai điệu đó thấp y như nhiệt độ ngoài quê nhà tôi vậy.\", \"rating\": 9.0},\n  {\"id\": 749787, \"suggestedTranslation\": \"Nó có chơi bài \\\"O Canada\\\" được không?\", \"rating\": 9.0},\n  {\"id\": 749788, \"suggestedTranslation\": \"Hãy kết thúc bộ sưu tập vỏ sò này bằng một nốt cao nào!\", \"rating\": 9.0},\n  {\"id\": 749789, \"suggestedTranslation\": \"Tốt hơn là nên tỏ lòng thành kính nhỉ, Lucy?\", \"rating\": 9.0},\n  {\"id\": 749790, \"suggestedTranslation\": \"Đẹp như hoàng hôn ở Canada vậy.\", \"rating\": 9.0},\n  {\"id\": 749791, \"suggestedTranslation\": \"Âm thanh buồn cười thật.\", \"rating\": 9.0},\n  {\"id\": 749792, \"suggestedTranslation\": \"Chúng làm tôi đau đầu quá.\", \"rating\": 9.0},\n  {\"id\": 749793, \"suggestedTranslation\": \"Nghĩ là cần thêm vài bông hoa đấy, nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749794, \"suggestedTranslation\": \"Chia buồn nhé, bạn hiền.\", \"rating\": 9.0},\n  {\"id\": 749795, \"suggestedTranslation\": \"Đúng là một vật bị nguyền rủa phải không?\", \"rating\": 9.0},\n  {\"id\": 749796, \"suggestedTranslation\": \"Chà, trông có vẻ chết hẳn rồi đấy.\", \"rating\": 9.0},\n  {\"id\": 749797, \"suggestedTranslation\": \"Tội nghiệp %s. Tôi nên cẩn thận với %s mới được, nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749798, \"suggestedTranslation\": \"Tội nghiệp %s. %s đã ra tay với cô ấy rồi, nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749799, \"suggestedTranslation\": \"Tội nghiệp %s. %s đã ra tay với anh ta rồi, nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749800, \"suggestedTranslation\": \"Tội nghiệp %s. %s đã ra tay với họ rồi, nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749801, \"suggestedTranslation\": \"Vài bản vẽ để tạc tượng đá cầu kỳ.\", \"rating\": 9.0},\n  {\"id\": 749802, \"suggestedTranslation\": \"Đáng sợ quá!\", \"rating\": 9.0},\n  {\"id\": 749803, \"suggestedTranslation\": \"Mấy người quanh đây đúng là cần chợp mắt một chút.\", \"rating\": 9.0},\n  {\"id\": 749804, \"suggestedTranslation\": \"Biết đâu cậu nhóc có thể làm giảm bớt số lượng chim chóc đi một chút.\", \"rating\": 9.0},\n  {\"id\": 749805, \"suggestedTranslation\": \"Mang lại nhiều giờ vui vẻ và sự tàn phá cho đứa nhỏ.\", \"rating\": 9.0},\n  {\"id\": 749806, \"suggestedTranslation\": \"Không tệ chút nào!\", \"rating\": 9.0},\n  {\"id\": 749807, \"suggestedTranslation\": \"Không tệ chút nào!\", \"rating\": 9.0},\n  {\"id\": 749808, \"suggestedTranslation\": \"Kh