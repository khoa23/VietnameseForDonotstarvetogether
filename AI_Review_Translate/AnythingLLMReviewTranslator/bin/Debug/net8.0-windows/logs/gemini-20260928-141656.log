ion\":\"Nơi giam cầm những chú chim nhỏ.\",\"rating\":9.0},\n  {\"id\":755356,\"suggestedTranslation\":\"Đừng lo, bữa trưa sắp đến nơi rồi.\",\"rating\":9.0},\n  {\"id\":755357,\"suggestedTranslation\":\"Chào người bạn có lông biết ca hát của ta.\",\"rating\":9.0},\n  {\"id\":755358,\"suggestedTranslation\":\"Ta không nghĩ cô ấy sắp hồi phục đâu.\",\"rating\":9.0},\n  {\"id\":755359,\"suggestedTranslation\":\"Ngươi sẽ không phải trải qua những đêm mất ngủ nữa đâu.\",\"rating\":9.0},\n  {\"id\":755360,\"suggestedTranslation\":\"Không ai có ít hạt giống để cho mượn sao?\",\"rating\":9.0},\n  {\"id\":755361,\"suggestedTranslation\":\"Hỏa táng để ngăn ngừa đột biến!\",\"rating\":9.0},\n  {\"id\":755362,\"suggestedTranslation\":\"Nó đã chết nhưng chưa xong việc đâu.\",\"rating\":9.0},\n  {\"id\":755363,\"suggestedTranslation\":\"Nó đang thay đổi và trở nên điên dại.\",\"rating\":9.0},\n  {\"id\":755364,\"suggestedTranslation\":\"Lũ chim sẽ thấy cái này buồn cười lắm đây!\",\"rating\":9.0},\n  {\"id\":755365,\"suggestedTranslation\":\"Trứng của một chú chim, nghe đồn là thế.\",\"rating\":9.0},\n  {\"id\":755366,\"suggestedTranslation\":\"Chắc là một món đồ của phàm nhân.\",\"rating\":9.0},\n  {\"id\":755367,\"suggestedTranslation\":\"Chà chà, trông ngươi tái mét thế!\",\"rating\":9.0},\n  {\"id\":755368,\"suggestedTranslation\":\"Hình thái mới này khác xa bình thường.\",\"rating\":9.0},\n  {\"id\":755369,\"suggestedTranslation\":\"Trông ngươi dữ tợn thật đấy, tên ác ma khó ưa!\",\"rating\":9.0},\n  {\"id\":755370,\"suggestedTranslation\":\"Hyuyu! Ái chà!\",\"rating\":9.0},\n  {\"id\":755371,\"suggestedTranslation\":\"Ái chà! Chơi tử tế với tiểu yêu nào!\",\"rating\":9.0},\n  {\"id\":755372,\"suggestedTranslation\":\"Nó đang truyền cảm hứng cho ta tự gây ra chút rắc rối đấy.\",\"rating\":9.0},\n  {\"id\":755373,\"suggestedTranslation\":\"Phụt!\",\"rating\":9.0},\n  {\"id\":755374,\"suggestedTranslation\":\"Một hơi thở thổi ra là cái chết rực lửa!\",\"rating\":9.0},\n  {\"i