            "text": "[\n  {\"id\":755445,\"suggestedTranslation\":\"Chà, nó sẽ không triệu hồi được một con tiểu yêu đâu!\",\"rating\":8.5},\n  {\"id\":755446,\"suggestedTranslation\":\"Chúng ta chẳng có xó xỉnh nào cần dùng đến sách từ quê tôi cả.\",\"rating\":8.5},\n  {\"id\":755447,\"suggestedTranslation\":\"Quyển này có vẻ đáng ngờ nhỉ.\",\"rating\":8.5},\n  {\"id\":755448,\"suggestedTranslation\":\"Ném văng cả đá tảng luôn.\",\"rating\":8.5},\n  {\"id\":755449,\"suggestedTranslation\":\"Bí quyết thầm kín về rau củ.\",\"rating\":8.5},\n  {\"id\":755450,\"suggestedTranslation\":\"Bí quyết thầm kín về rau củ.\",\"rating\":8.5},\n  {\"id\":755451,\"suggestedTranslation\":\"Liên quan đến vườn tược thì lúc nào cũng có thứ để học.\",\"rating\":8.5},\n  {\"id\":755452,\"suggestedTranslation\":\"Ta có nên ngồi đọc một lúc không nhỉ?\",\"rating\":8.5},\n  {\"id\":755453,\"suggestedTranslation\":\"Đối với một cuốn sách phát sáng thì nó khá là nặng đấy, hyuyu!\",\"rating\":8.5},\n  {\"id\":755454,\"suggestedTranslation\":\"Hyuyuyu đáng yêu chưa kìa! Mấy kẻ phàm trần cứ nghĩ mình có thể thao túng được mặt trăng cơ đấy!\",\"rating\":8.5},\n  {\"id\":755455,\"suggestedTranslation\":\"Phàm trần lúc nào cũng làm mất đi cái vui của mọi thứ.\",\"rating\":8.5},\n  {\"id\":755456,\"suggestedTranslation\":\"Biết bao nhiêu kiến thức, và chẳng có cái nào bị cấm đoán cả!\",\"rating\":8.5},\n  {\"id\":755457,\"suggestedTranslation\":\"Sao không đọc nó cho cây sậy nghe nhỉ? Hyuyuyu!\",\"rating\":8.5},\n  {\"id\":755458,\"suggestedTranslation\":\"Kiến thức là sức mạnh. Theo đúng nghĩa đen luôn.\",\"rating\":8.5},\n  {\"id\":755459,\"suggestedTranslation\":\"Hyuyuyu, người phàm trần có mấy ý tưởng buồn cười thật.\",\"rating\":8.5},\n  {\"id\":755460,\"suggestedTranslation\":\"Tiểu yêu không rảnh đời đi phát tán kiến thức quý giá một cách bất cẩn thế đâu.\",\"rating\":8.5},\n  {\"id\":755461,\"suggestedTranslation\":\"Ồ, chúng ta đọc được một mạng lưới rắc rối làm sao.\",\"rating\":8.5},\n  {\"id\":755462,\"suggestedTranslation\":\"Gieo nhân nào gặt quả nấy, người ta vẫn hay nói thế đấy!\",\"rating\":8.5},\n  {\"id\":755463,\"suggestedTranslation\":\"Hyuyu! Ai mà chắp vá cái này lại thế nhỉ?\",\"rating\":8.5},\n  {\"id\":755464,\"suggestedTranslation\":\"Đống đổ nát này có lẽ vẫn còn hữu dụng chán.\",\"rating\":8.5},\n  {\"id\":755465,\"suggestedTranslation\":\"Muốn nó như mới, hãy dùng chút hơi nóng!\",\"rating\":8.5},\n  {\"id\":755466,\"suggestedTranslation\":\"Giúp cho chùm lông ngực tiểu yêu luôn phồng mịn.\",\"rating\":8.5},\n  {\"id\":755467,\"suggestedTranslation\":\"Ta sẽ bắt gọn mấy con bọ đó cho coi.\",\"rating\":8.5},\n  {\"id\":755468,\"suggestedTranslation\":\"Và thế là nó mọc lên từ dưới đáy biển sâu.\",\"rating\":8.5},\n  {\"id\":755469,\"suggestedTranslation\":\"Mấy kẻ phàm trần hái nó với vẻ mặt hớn hở làm sao.\",\"rating\":8.5},\n  {\"id\":755470,\"suggestedTranslation\":\"Chúng ta đã vặt chiếc roi này từ mạn của con tàu.\",\"rating\":8.5},\n  {\"id\":755471,\"suggestedTranslation\":\"Liệu có bất ngờ thú vị nào đang chờ đợi bên trong không nhỉ?\",\"rating\":8.5},\n  {\"id\":755472,\"suggestedTranslation\":\"Trói buộc mọi vật phẩm bị nguyền rủa lại!\",\"rating\":8.5},\n  {\"id\":755473,\"suggestedTranslation\":\"Ngươi nhảy lò cò y như ta vậy!\",\"rating\":8.5},\n  {\"id\":755474,\"suggestedTranslation\":\"Mùi này thu hút được người phàm cơ à?\",\"rating\":8.5},\n  {\"id\":755475,\"suggestedTranslation\":\"Tạm biệt nhé, những chiếc gai nhỏ.\",\"rating\":8.5},\n  {\"id\":755476,\"suggestedTranslation\":\"Thấy ta đó, mà không thấy ta đâu! Hyuyu!\",\"rating\":8.5},\n  {\"id\":755477,\"suggestedTranslation\":\"Tinh chất của sự trơn tuột.\",\"rating\":8.5},\n  {\"id\":755478,\"suggestedTranslation\":\"Bay đi, bay đi, cục bơ dấu yêu của ta!\",\"rating\":8.5},\n  {\"id\":755479,\"suggestedTranslation\":\"Ta sẽ cố không hút mất linh hồn của ngươi đâu.\",\"rating\":8.5},\n  {\"id\":755480,\"suggestedTranslation\":\"Không có bánh muffin nào ở đây cả, bạn hiền ơi.\",\"rating\":8.5},\n  {\"id\":755481,\"suggestedTranslation\":\"Bay đi nào, linh hồn ngọt ngào.\",\"rating\":8.5},\n  {\"id\":755482,\"suggestedTranslation\":\"Nó đâu có muốn ăn đồ chết chóc. Chỉ là nó buộc phải thế thôi.\",\"rating\":8.5},\n  {\"id\":755483,\"suggestedTranslation\":\"Hỏa táng để kìm hãm sự đột biến!\",\"rating\":8.5},\n  {\"id\":755484,\"suggestedTranslation\":\"Nó đã chết nhưng chưa xong việc đâu.\",\"rating\":8.5},\n  {\"id\":755485,\"suggestedTranslation\":\"Nó đang biến đổi và trở nên điên dại.\",\"rating\":8.5},\n  {\"id\":755486,\"suggestedTranslation\":\"Trông chúng cứ như thật ấy!\",\"rating\":8.5},\n  {\"id\":755487,\"suggestedTranslation\":\"Gai góc và cáu kỉnh, đúng kiểu ta thích.\",\"rating\":8.5},\n  {\"id\":755488,\"suggestedTranslation\":\"Muốn hái xương rồng, bạn cần phải luyện tập chút công phu!\",\"rating\":8.5},\n  {\"id\":755489,\"suggestedTranslation\":\"Đẹp thật đấy! Ta hơi sợ khi chạm vào nó.\",\"rating\":8.5},\n  {\"id\":755490,\"suggestedTranslation\":\"Ta chẳng muốn ăn thứ gì đầy gai góc thế này đâu.\",\"rating\":8.5},\n  {\"id\":755491,\"suggestedTranslation\":\"Gai đã mất sạch rồi, nhưng ta vẫn chẳng muốn ăn nó đâu.\",\"rating\":8.5},\n  {\"id\":755492,\"suggestedTranslation\":\"Chúng ta đang đà tiến tới đấy! Hyuyu!\",\"rating\":8.5},\n  {\"id\":755493,\"suggestedTranslation\":\"Sắp tắt ngấm đến nơi rồi.\",\"rating\":8.5},\n  {\"id\":755494,\"suggestedTranslation\":\"Ngọn lửa này sẽ làm dịu cơn khát sự ấm áp trong ta.\",\"rating\":8.5},\n  {\"id\":755495,\"suggestedTranslation\":\"Mấy ngọn lửa này trông cay phết nhỉ.\",\"rating\":8.5},\n  {\"id\":755496,\"suggestedTranslation\":\"Nó cháy nhỏ quá, nhỏ quá đi mất!\",\"rating\":8.5},\n  {\"id\":755497,\"suggestedTranslation\":\"Khi ta lang thang, trại bỗng hóa nhà.\",\"rating\":8.5},\n  {\"id\":755498,\"suggestedTranslation\":\"Và thế là nó tắt ngúm.\",\"rating\":8.5},\n  {\"id\":755499,\"suggestedTranslation\":\"Cùng nhau chiếu cố lẫn nhau nhé, bạn và tôi.\",\"rating\":8.5},\n  {\"id\":755500,\"suggestedTranslation\":\"Cẩn thận cái chân của ta đấy nhé.\",\"rating\":8.5},\n  {\"id\":755501,\"suggestedTranslation\":\"Người phàm thường trông không giống thế này cho lắm.\",\"rating\":8.5},\n  {\"id\":755502,\"suggestedTranslation\":\"Đó chính là cái Túi Wortox!\",\"rating\":8.5},\n  {\"id\":755503,\"suggestedTranslation\":\"Là nó đang dắt ta đi, hay ta đang dắt nó đi thế nhỉ?\",\"rating\":8.5},\n  {\"id\":755504,\"suggestedTranslation\":\"Ồ, nó mang lại một cảm giác thật chìm đắm làm sao!\",\"rating\":8.5},\n  {\"id\":755505,\"suggestedTranslation\":\"Hyuyuyu, vui thật đấy!\",\"rating\":8.5},\n  {\"id\":755506,\"suggestedTranslation\":\"Ồ, bao nhiêu trò quậy phá ta có thể làm với cái này đây!\",\"rating\":8.5},\n  {\"id\":755507,\"suggestedTranslation\":\"Hãy bắt đầu mọi thứ bằng một tiếng nổ lớn nhé? Hyuyuyu!\",\"rating\":8.5},\n  {\"id\":755508,\"suggestedTranslation\":\"Đó có phải là ánh kim tuyến của vàng tiên không nhỉ?\",\"rating\":8.5},\n  {\"id\":755509,\"suggestedTranslation\":\"Sắp xong rồi đấy.\",\"rating\":8.5},\n  {\"id\":755510,\"suggestedTranslation\":\"Nó cứ tiếp tục mãi, mãi và mãi thôi!\",\"rating\":8.5},\n  {\"id\":755511,\"suggestedTranslation\":\"Sắp xong rồi đấy.\",\"rating\":8.5},\n  {\"id\":755512,\"suggestedTranslation\":\"Người phàm đúng là rất thích mấy món đồ vặt vãnh này nhỉ.\",\"rating\":8.5},\n  {\"id\":755513,\"suggestedTranslation\":\"Món đồ vặt vãnh hiếm có khó tìm nhất đây!\",\"rating\":8.5},\n  {\"id\":755,514,\"suggestedTranslation\":\"Hyuyu, quả là một món hời lớn!\",\"rating\":8.5},\n  {\"id\":755515,\"suggestedTranslation\":\"Hyuyu, thật là bí ẩn làm sao!\",\"rating\":8.5},\n  {\"id\":755516,\"suggestedTranslation\":\"Hyuyu, thật là bí ẩn làm sao!\",\"rating\":8.5},\n  {\"id\":755517,\"suggestedTranslation\":\"Hyuyu, thật là bí ẩn làm sao!\",\"rating\":8.5},\n  {\"id\":755518,\"suggestedTranslation\":\"Một ngọn đèn tiên tỏa sáng trong đêm.\",\"rating\":8.5},\n  {\"id\":755519,\"suggestedTranslation\":\"Sắp xong rồi đấy.\",\"rating\":8.5},\n  {\"id\":755520,\"suggestedTranslation\":\"Chúng ta có thể mang một chút Lễ Hội Quạ theo bất cứ đâu.\",\"rating\":8.5},\n  {\"id\":755521,\"suggestedTranslation\":\"Sắp xong rồi đấy.\",\"rating\":8.5},\n  {\"id\":755522,\"suggestedTranslation\":\"Chắc ta đi tìm một linh hồn tươi mát nào đó để thay thế thôi.\",\"rating\":8.5},\n  {\"id\":755523,\"suggestedTranslation\":\"Thử tưởng tượng việc thay thế mấy thứ này bằng giun thật sẽ là một trò đùa tai quái thế nào nhỉ...\",\"rating\":8.5},\n  {\"id\":755524,\"suggestedTranslation\":\"Chúng ta gần như đã sẵn sàng để bắt đầu cuộc vui rồi!\",\"rating\":8.5},\n  {\"id\":755525,\"suggestedTranslation\":\"Một cánh cửa bẫy nhỏ được lắp dưới sàn.\",\"rating\":8.5},\n  {\"id\":755526,\"suggestedTranslation\":\"Cho phép ta đề xuất một cuộc trao đổi: một món đồ lấp lánh để đổi lấy vé chơi trò chơi của bạn nhé.\",\"rating\":8.5},\n  {\"id\":755527,\"suggestedTranslation\":\"Bạn phải thật nhanh tay để cho đám gà con ăn đấy.\",\"rating\":8.5},\n  {\"id\":755528,\"suggestedTranslation\":\"Lăn và bay đi, thật xa khỏi tổ ấm!\",\"rating\":8.5},\n  {\"id\":755529,\"suggestedTranslation\":\"Gõ nhẹ một cú, đưa bóng đi đúng hướng... hoặc bay khỏi tầm mắt luôn!\",\"rating\":8.5},\n  {\"id\":755530,\"suggestedTranslation\":\"Nó sẽ mang phong cách của chính ta!\",\"rating\":8.5},\n  {\"id\":755531,\"suggestedTranslation\":\"Ôi dễ quá đi, dễ như ăn bánh!\",\"rating\":8.5},\n  {\"id\":755532,\"suggestedTranslation\":\"Cú đánh quái quỷ gì thế này?!\",\"rating\":8.5},\n  {\"id\":755533,\"suggestedTranslation\":\"Được phết đấy, không quá khó đâu!\",\"rating\":8.5},\n  {\"id\":755534,\"suggestedTranslation\":\"Nó cứ nhạo báng ta trong lúc ngáng đường ta!\",\"rating\":8.5},\n  {\"id\":755535,\"suggestedTranslation\":\"Bóng lăn đi theo hướng gió thổi.\",\"rating\":8.5},\n  {\"id\":755536,\"suggestedTranslation\":\"Một khung cảnh ngăn nắp cho một trò chơi có giới hạn!\",\"rating\":8.5},\n  {\"id\":755537,\"suggestedTranslation\":\"Cái cảnh thụt thò này làm ta mất tập trung quá đi mất!\",\"rating\":8.5},\n  {\"id\":755538,\"suggestedTranslation\":\"Tận dụng độ xoáy để giành chiến thắng trong tầm tay!\",\"rating\":8.5},\n  {\"id\":755539,\"suggestedTranslation\":\"Ta đang rất nóng lòng muốn tống quả bóng bay vút đi đây!\",\"rating\":8.5},\n  {\"id\":755540,\"suggestedTranslation\":\"Bóng đi đâu về đâu? Chẳng ai biết được đâu!\",\"rating\":8.5},\n  {\"id\":755541,\"suggestedTranslation\":\"Quả bóng nhỏ sẽ rơi tõm xuống thôi!\",\"rating\":8.5},\n  {\"id\":755542,\"suggestedTranslation\":\"Tùy thuộc vào việc nó dừng lại ở đâu thôi.\",\"rating\":8.5},\n  {\"id\":755543,\"suggestedTranslation\":\"Nó cần phải được đánh thức bằng một đồng xu!\",\"rating\":8.5},\n  {\"id\":755544,\"suggestedTranslation\":\"Không thể thi đấu cho đến khi đường bóng hoàn thành!\",\"rating\":8.5},\n  {\"id\":755545,\"suggestedTranslation\":\"Này! Trò chơi đang diễn ra rồi đấy!\",\"rating\":8.5},\n  {\"id\":755546,\"suggestedTranslation\":\"Ôi trời ơi, cái đế đặt bóng đi đâu mất tiêu rồi?\",\"rating\":8.5},\n  {\"id\":755547,\"suggestedTranslation\":\"Tiến vào giữa đi nào, làm ơn đấy.\",\"rating\":8.5},\n  {\"id\":755548,\"suggestedTranslation\":\"Chúng ta gần như đã sẵn sàng để bắt đầu cuộc vui rồi!\",\"rating\":8.5},\n  {\"id\":755549,\"suggestedTranslation\":\"Cho phép ta đề xuất một cuộc trao đổi: một món đồ lấp lánh để chơi trò chơi của bạn.\",\"rating\":8.5},\n  {\"id\":755550,\"suggestedTranslation\":\"Vui phết đấy, hoặc ít ra là ta đang lùa chúng thế. Hyuyuyu!\",\"rating\":8.5},\n  {\"id\":755551,\"suggestedTranslation\":\"Một cánh cửa bẫy nhỏ được lắp dưới sàn nhà.\",\"rating\":8.5},\n  {\"id\":755552,\"suggestedTranslation\":\"Cái này hay cái kia đây ta?\",\"rating\":8.5},\n  {\"id\":755553,\"suggestedTranslation\":\"Chúng ta gần như đã sẵn sàng để bắt đầu cuộc vui rồi!\",\"rating\":8.5},\n  {\"id\":755554,\"suggestedTranslation\":\"Cho phép ta đề xuất một cuộc trao đổi: một món đồ lấp lánh để chơi trò chơi của bạn.\",\"rating\":8.5},\n  {\"id\":755555,\"suggestedTranslation\":\"Trò này chắc chắn sẽ thử thách trí óc của ai đó đấy.\",\"rating\":8.5},\n  {\"id\":755556,\"suggestedTranslation\":\"Chúng ta gần như đã sẵn sàng để bắt đầu cuộc vui rồi!\",\"rating\":8.5},\n  {\"id\":755557,\"suggestedTranslation\":\"Cho phép ta đề xuất một cuộc trao đổi: một món đồ lấp lánh để chơi trò chơi của bạn.\",\"rating\":8.5},\n  {\"id\":755558,\"suggestedTranslation\":\"Quả bóng đi mất rồi, liệu nó sẽ rơi xuống đâu đây?\",\"rating\":8.5},\n  {\"id\":755559,\"suggestedTranslation\":\"Cho phép ta đề xuất một cuộc trao đổi: một món đồ lấp lánh để chơi trò chơi của bạn.\",\"rating\":8.5},\n  {\"id\":755560,\"suggestedTranslation\":\"Hyuyuyu! Nó làm được gì thế nhỉ?\",\"rating\":8.5},\n  {\"id\":755561,\"suggestedTranslation\":\"Chúng ta gần như đã sẵn sàng để bắt đầu cuộc vui rồi!\",\"rating\":8.5},\n  {\"id\":755562,\"suggestedTranslation\":\"Cho phép ta đề xuất một cuộc trao đổi: một món đồ lấp lánh để chơi trò chơi của bạn.\",\"rating\":8.5},\n  {\"id\":755563,\"suggestedTranslation\":\"Trong trò chơi vui nhộn này, mục tiêu của chúng ta là đập bẹp lũ bọ.\",\"rating\":8.5},\n  {\"id\":755564,\"suggestedTranslation\":\"Một cánh cửa bẫy nhỏ được lắp ngay trên sàn nhà.\",\"rating\":8.5},\n  {\"id\":755565,\"suggestedTranslation\":\"Ta sẽ không nghỉ ngơi cho đến khi tiễn biệt xong mấy con dịch hại đó!\",\"rating\":8.5},\n  {\"id\":755566,\"suggestedTranslation\":\"Chúng ta gần như đã sẵn sàng để bắt đầu cuộc vui rồi!\",\"rating\":8.5},\n  {\"id\":755567,\"suggestedTranslation\":\"Cho phép ta đề xuất một cuộc trao đổi: một món đồ lấp lánh để chơi trò chơi của bạn.\",\"rating\":8.5},\n  {\"id\":755568,\"suggestedTranslation\":\"Thắng dễ ợt à, cứ quay một vòng là biết ngay!\",\"rating\":8.5},\n  {\"id\":755569,\"suggestedTranslation\":\"Nó hợp với bộ lông của ta phết đấy chứ!\",\"rating\":8.5},\n  {\"id\":755570,\"suggestedTranslation\":\"Hyuyu, thật vui khi thấy những vị khách lịch sự này đi dạo quanh đây!\",\"rating\":8.5},\n  {\"id\":755571,\"suggestedTranslation\":\"Ai mà có thể cưỡng lại một món đồ lấp lánh thế này chứ?\",\"rating\":8.5},\n  {\"id\":755572,\"suggestedTranslation\":\"Hỡi linh hồn, ngươi đang lang thang về phương nào thế?\",\"rating\":8.5},\n  {\"id\":755573,\"suggestedTranslation\":\"Nơi này có vẻ cần được trang hoàng lại chút nhỉ, bạn thấy sao?\",\"rating\":8.5},\n  {\"id\":755574,\"suggestedTranslation\":\"Cũng ổn đấy, nhưng nơi này cần thêm nhiều sự lấp lánh và rực rỡ hơn nữa.\",\"rating\":8.5},\n  {\"id\":755575,\"suggestedTranslation\":\"Được trang hoàng một cách lộng lẫy xứng tầm cho những người bạn có lông vũ của chúng ta.\",\"rating\":8.5},\n  {\"id\":755576,\"suggestedTranslation\":\"Giờ nếu mình là một con quạ, mình sẽ nghĩ nó nên được đặt ở đâu nhỉ?\",\"rating\":8.5},\n  {\"id\":755577,\"suggestedTranslation\":\"Biết chọn cái nào đây, chọn cái nào bây giờ...\",\"rating\":8.5},\n  {\"id\":755578,\"suggestedTranslation\":\"Tự hỏi không biết nó sẽ có những món quà vặt gì nhỉ?\",\"rating\":8.5},\n  {\"id\":755579,\"suggestedTranslation\":\"Cho một vé nhé, hyuyu!\",\"rating\":8.5},\n  {\"id\":755580,\"suggestedTranslation\":\"Ta có thể mường tượng ra phần thưởng ngay trước mắt rồi.\",\"rating\":8.5},\n  {\"id\":755581,\"suggestedTranslation\":\"Một chồng vé thưởng xinh xắn.\",\"rating\":8.5},\n  {\"id\":755582,\"suggestedTranslation\":\"Ta cá là họ sẽ không giận đâu nếu ta đổ đống này xuống đất nhỉ.\",\"rating\":8.5},\n  {\"id\":755583,\"suggestedTranslation\":\"Ta khá có cảm tình với phong cách này đấy.\",\"rating\":8.5},\n  {\"id\":755584,\"suggestedTranslation\":\"Một chiếc áo choàng bằng lá quấn quanh vóc dáng tiểu yêu của ta.\",\"rating\":8.5},\n  {\"id\":755585,\"suggestedTranslation\":\"Ngắn gọn và ngọt ngào, hyuyu!\",\"rating\":8.5},\n  {\"id\":755586,\"suggestedTranslation\":\"Nhưng nó cắt được cái gì cơ chứ?\",\"rating\":8.5},\n  {\"id\":755587,\"suggestedTranslation\":\"Kẻ ngốc nào lại nghĩ việc dựng toàn bằng gỗ là hay ho cơ chứ?\",\"rating\":8.5},\n  {\"id\":755588,\"suggestedTranslation\":\"Nỗi khao khát được cảm thấy năng suất của người phàm, nếu tôi có thể nói giảm nói tránh đi một chút.\",\"rating\":8.5},\n  {\"id\":755589,\"suggestedTranslation\":\"Tạm biệt nhé, củ cà rốt đã về với đất mẹ.\",\"rating\":8.5},\n  {\"id\":755590,\"suggestedTranslation\":\"Tự hỏi không biết nó có linh hồn không nhỉ?\",\"rating\":8.5},\n  {\"id\":755591,\"suggestedTranslation\":\"Xin chào xin chào, linh hồn màu cam kỳ lạ.\",\"rating\":8.5},\n  {\"id\":755592,\"suggestedTranslation\":\"Ngủ ngon nhé, đừng để lũ người cắn đấy.\",\"rating\":8.5},\n  {\"id\":755593,\"suggestedTranslation\":\"Ta có cảm giác cô nàng này cũng rất thích chơi trò chơi đấy, hyuyu!\",\"rating\":8.5},\n  {\"id\":755594,\"suggestedTranslation\":\"Mấy kẻ không phải tiểu yêu rất thích ăn mấy thứ thế này.\",\"rating\":8.5},\n  {\"id\":755595,\"suggestedTranslation\":\"Ta nghĩ đám không phải tiểu yêu thích ăn nó khi được nấu chín hơn.\",\"rating\":8.5},\n  {\"id\":755596,\"suggestedTranslation\":\"Ta đoán đám phàm trần có lẽ sẽ thích thú với thứ như thế này.\",\"rating\":8.5},\n  {\"id\":755597,\"suggestedTranslation\":\"Có một thực vật ở bên dưới đấy.\",\"rating\":8.5},\n  {\"id\":755598,\"suggestedTranslation\":\"Trồng một hạt giống và ngươi sẽ có cái ăn!\",\"rating\":8.5},\n  {\"id\":755599,\"suggestedTranslation\":\"Ai đó vừa mới bày trò tinh quái gì rồi đây.\",\"rating\":8.5},\n  {\"id\":755600,\"suggestedTranslation\":\"Hết phim.\",\"rating\":8.5},\n  {\"id\":755601,\"suggestedTranslation\":\"Ta có thể vẽ bản đồ đến bất cứ đâu và chẳng tới đâu cả.\",\"rating\":8.5},\n  {\"id\":755602,\"suggestedTranslation\":\"Ta thích chơi với những kẻ phàm trần thông minh hơn.\",\"rating\":8.5},\n  {\"id\":755603,\"suggestedTranslation\":\"Yoohoo! Có ai ở nhà không?\",\"rating\":8.5},\n  {\"id\":755604,\"suggestedTranslation\":\"Một mái nhà cho những người bạn.\",\"rating\":8.5},\n  {\"id\":755605,\"suggestedTranslation\":\"Đây là một chiếc mũ che sừng sọc.\",\"rating\":8.5},\n  {\"id\":755606,\"suggestedTranslation\":\"Quấn cuộn chỉ lên nào, kéo, kéo nào!\",\"rating\":8.5},\n  {\"id\":755607,\"suggestedTranslation\":\"Ta có thể dịch chuyển nó nếu ta thích!\",\"rating\":8.5},\n  {\"id\":755608,\"suggestedTranslation\":\"Nhảy lò cò một bước là hố to rồi!\",\"rating\":8.5},\n  {\"id\":755609,\"suggestedTranslation\":\"Một trong những hương vị thức ăn ít làm phật ý phàm nhân nhất.\",\"rating\":8.5},\n  {\"id\":755610,\"suggestedTranslation\":\"Ta không nghĩ là còn ai muốn ăn nó nữa đâu.\",\"rating\":8.5},\n  {\"id\":755611,\"suggestedTranslation\":\"Nó đã được nấu chín rồi.\",\"rating\":8.5},\n  {\"id\":755612,\"suggestedTranslation\":\"Ta thấy gì đây? Một cái cây dưới lòng đất!\",\"rating\":8.5},\n  {\"id\":755613,\"suggestedTranslation\":\"Dọn đường mau, ta bảo thế!\",\"rating\":8.5},\n  {\"id\":755614,\"suggestedTranslation\":\"Một buổi tiệc tùng đang náo nhiệt ở phía dưới kìa!\",\"rating\":8.5},\n  {\"id\":755615,\"suggestedTranslation\":\"Không có chuyện thám hiểm hang động cho chú tiểu yêu này đâu!\",\"rating\":8.5},\n  {\"id\":755616,\"suggestedTranslation\":\"Ta đi đây, hyuyu!\",\"rating\":8.5},\n  {\"id\":755617,\"suggestedTranslation\":\"Để ta ngó vào trong xem nào!\",\"rating\":8.5},\n  {\"id\":755618,\"suggestedTranslation\":\"Một buổi tiệc tùng đang náo nhiệt ở phía trên kìa!\",\"rating\":8.5},\n  {\"id\":755619,\"suggestedTranslation\":\"Ta thích ở nơi tối tăm sâu thẳm này đấy.\",\"rating\":8.5},\n  {\"id\":755620,\"suggestedTranslation\":\"Ta đi đây, hyuyu!\",\"rating\":8.5},\n  {\"id\":755621,\"suggestedTranslation\":\"Nó thích bóng tối hơn.\",\"rating\":8.5},\n  {\"id\":755622,\"suggestedTranslation\":\"Trông có vẻ tèo rồi, ta vừa nói thế đấy.\",\"rating\":8.5},\n  {\"id\":755623,\"suggestedTranslation\":\"Nó đã xì hơi xong xuôi rồi!\",\"rating\":8.5},\n  {\"id\":755624,\"suggestedTranslation\":\"Đừng có coi thường con bọ nhỏ đó nhé!\",\"rating\":8.5},\n  {\"id\":755625,\"suggestedTranslation\":\"Không một tiếng động, nó đang ngủ say sưa.\",\"rating\":8.5},\n  {\"id\":755626,\"suggestedTranslation\":\"Hì hì! Làm phiền người ta bằng khí độc đúng là thô lỗ thật đấy!\",\"rating\":8.5},\n  {\"id\":755627,\"suggestedTranslation\":\"Ta nghĩ là nó hơi bốc mùi đấy.\",\"rating\":8.5},\n  {\"id\":755628,\"suggestedTranslation\":\"Thứ gì trồi lên, sẽ là một bất ngờ lớn đấy!\",\"rating\":8.5},\n  {\"id\":755629,\"suggestedTranslation\":\"Đừng sợ nhé đội bạn ơi! Chỉ là hơi nước nóng thôi mà.\",\"rating\":8.5},\n  {\"id\":755630,\"suggestedTranslation\":\"Hít làn khói đó vào, và đón nhận ngày tàn của ngươi đi!\",\"rating\":8.5},\n  {\"id\":755631,\"suggestedTranslation\":\"Dùng cho lúc cần leo trèo!\",\"rating\":8.5},\n  {\"id\":755632,\"suggestedTranslation\":\"Ta thà để lại món này cho loài người thưởng thức.\",\"rating\":8.5},\n  {\"id\":755633,\"suggestedTranslation\":\"Cái cây bị đốt cháy trước.\",\"rating\":8.5},\n  {\"id\":755636,\"suggestedTranslation\":\"Nó đang tìm kiếm một viên đá kinh hoàng.\",\"rating\":8.5},\n  {\"id\":755637,\"suggestedTranslation\":\"Hyuyu, đúng là một cặp đôi buồn cười!\",\"rating\":8.5},\n  {\"id\":755638,\"suggestedTranslation\":\"Hừm, hôm nay ta nên diễn vai gì đây?\",\"rating\":8.5},\n  {\"id\":755639,\"suggestedTranslation\":\"Cuối cùng Nữ hoàng bóng tối cũng xuất hiện!\",\"rating\":8.5},\n  {\"id\":755640,\"suggestedTranslation\":\"Thật là tuyệt vời, một chỗ ngồi hàng đầu!\",\"rating\":8.5},\n  {\"id\":755641,\"suggestedTranslation\":\"Trông nó vỡ nát thật đấy, chẳng đùa đâu!\",\"rating\":8.5},\n  {\"id\":755642,\"suggestedTranslation\":\"Trông nó vỡ nát thật đấy, chẳng đùa đâu!\",\"rating\":8.5},\n  {\"id\":755643,\"suggestedTranslation\":\"Trông nó vỡ nát thật đấy, chẳng đùa đâu!\",\"rating\":8.5},\n  {\"id\":755644,\"suggestedTranslation\":\"Sao mà nặng nề, ảm đạm thế không biết.\",\"rating\":8.5},\n  {\"id\":755645,\"suggestedTranslation\":\"Một kẻ chống lại Sư Tử Kiến, trước kia từng có lông. Hyuyu!\",\"rating\":8.5},\n  {\"id\":755646,\"suggestedTranslation\":\"Ta sẽ cầu nguyện cho chú gấu đã ngã xuống này.\",\"rating\":8.5},\n  {\"id\":755647,\"suggestedTranslation\":\"Trông nó có nét rất giống đấy.\",\"rating\":8.5},\n  {\"id\":755648,\"suggestedTranslation\":\"Con bò lai này còn cứng đầu hơn hầu hết mọi kẻ khác đấy!\",\"rating\":8.5},\n  {\"id\":755649,\"suggestedTranslation\":\"Sự uy nghiêm bất động. Côn trùng tĩnh lặng.\",\"rating\":8.5},\n  {\"id\":755650,\"suggestedTranslation\":\"Quân Tượng làm bằng đá mài nhẵn.\",\"rating\":8.5},\n  {\"id\":755651,\"suggestedTranslation\":\"Đúng vậy, đúng vậy, đến chơi nào!\",\"rating\":8.5},\n  {\"id\":755652,\"suggestedTranslation\":\"Nó chẳng bay được, mà cũng chẳng chích được ai.\",\"rating\":8.5},\n  {\"id\":755653,\"suggestedTranslation\":\"Giờ thì đôi chân không còn lanh lẹ nữa rồi phải không, hyuyu!\",\"rating\":8.5},\n  {\"id\":755654,\"suggestedTranslation\":\"Chú nhóc này với ta không hợp rơ nhau cho lắm, hyuyu.\",\"rating\":8.5},\n  {\"id\":755655,\"suggestedTranslation\":\"Một chú chó săn đất sét làm từ bản phác thảo chúng ta tìm thấy!\",\"rating\":8.5},\n  {\"id\":755656,\"suggestedTranslation\":\"Trông đáng sợ làm sao, khi bị đóng băng trong hình hài đá.\",\"rating\":8.5},\n  {\"id\":755657,\"suggestedTranslation\":\"Lão ta giỏi chìm tàu hơn là làm vua biển.\",\"rating\":8.5},\n  {\"id\":755658,\"suggestedTranslation\":\"Bức tượng bán thân của một tên heo rừng thô lỗ!\",\"rating\":8.5},\n  {\"id\":755659,\"suggestedTranslation\":\"Con lợn rừng lội qua đống phế liệu ngổn ngang.\",\"rating\":8.5},\n  {\"id\":755660,\"suggestedTranslation\":\"Đó là một ngày vui chơi hết mình!\",\"rating\":8.5},\n  {\"id\":755661,\"suggestedTranslation\":\"Cô ta được mở mang tầm mắt theo đúng nghĩa đen.\",\"rating\":8.5},\n  {\"id\":755662,\"suggestedTranslation\":\"Đừng có sai lầm khi đối đầu với nỗi kinh hoàng quằn quại này nhé.\",\"rating\":8.5},\n  {\"id\":755663,\"suggestedTranslation\":\"Tạm biệt nhé, chuồn chuồn thân yêu.\",\"rating\":8.5},\n  {\"id\":755664,\"suggestedTranslation\":\"Nó đi đời nhà ma rồi, dù bạn có nhìn theo góc độ nào đi nữa, hyuyu!\",\"rating\":8.5},\n  {\"id\":755665,\"suggestedTranslation\":\"Ngươi có máu hiếu thắng quá mức đấy, ngài ạ.\",\"rating\":8.5},\n  {\"id\":755666,\"suggestedTranslation\":\"Trong toàn bộ vẻ huy hoàng đậm chất nguyệt thạch của nó!\",\"rating\":8.5},\n  {\"id\":755667,\"suggestedTranslation\":\"Quả là một công dụng buồn cười cho chiếc sừng!\",\"rating\":8.5},\n  {\"id\":755668,\"suggestedTranslation\":\"Chúng sẽ vươn tới tận bầu trời cao xanh!\",\"rating\":8.5},\n  {\"id\":755669,\"suggestedTranslation\":\"Một con hươu đực bất động.\",\"rating\":8.5},\n  {\"id\":755670,\"suggestedTranslation\":\"Làm một ván nào, bạn và tôi!\",\"rating\":8.5},\n  {\"id\":755671,\"suggestedTranslation\":\"Đúng vậy, đúng vậy, đến chơi nào!\",\"rating\":8.5},\n  {\"id\":755672,\"suggestedTranslation\":\"Ôi trời ơi, đó là một chú chim vô cùng hung hăng!\",\"rating\":8.5},\n  {\"id\":755673,\"suggestedTranslation\":\"Nhìn nó mà lòng ta tràn ngập niềm vui nhảy nhót, hyuyu!\",\"rating\":8.5},\n  {\"id\":755674,\"suggestedTranslation\":\"Cứ như thể Minotaur vừa chạm trán Medusa vậy.\",\"rating\":8.5},\n  {\"id\":755675,\"suggestedTranslation\":\"Mấy kẻ phàm trần cứ tưởng nó làm bằng phô mai cơ đấy! Hyuyu!\",\"rating\":8.5},\n  {\"id\":755676,\"suggestedTranslation\":\"Chúng ta đã lập được một hiệp ước ngỗng đá hòa bình.\",\"rating\":8.5},\n  {\"id\":755677,\"suggestedTranslation\":\"Chúng ta đã lập được một hiệp ước hươu sừng tấm đá hòa bình.\",\"rating\":8.5},\n  {\"id\":755678,\"suggestedTranslation\":\"Thật là kỳ quặc và tao nhã làm sao.\",\"rating\":8.5},\n  {\"id\":755679,\"suggestedTranslation\":\"Ngươi có muốn chơi một ván không?\",\"rating\":8.5},\n  {\"id\":755680,\"suggestedTranslation\":\"Bong bóng phập phồng, chẳng có rắc rối gì đâu.\",\"rating\":8.5},\n  {\"id\":755681,\"suggestedTranslation\":\"Chúng ta tự đục tạc cái này từ đá tảng đấy.\",\"rating\":8.5},\n  {\"id\":755682,\"suggestedTranslation\":\"Đúng vậy, đúng vậy, đến chơi nào!\",\"rating\":8.5},\n  {\"id\":755683,\"suggestedTranslation\":\"Chúng ta đã né được cái hàm của tên Cá Mập Hàm Băng hung hãn đó.\",\"rating\":8.5},\n  {\"id\":755684,\"suggestedTranslation\":\"Hết tiếng xương lách cách rồi nhé.\",\"rating\":8.5},\n  {\"id\":755685,\"suggestedTranslation\":\"Một tác phẩm nghệ thuật tuyệt vời, đặc biệt là mấy cái nốt sần.\",\"rating\":8.5},\n  {\"id\":755686,\"suggestedTranslation\":\"Đúng là một bức tượng bắt mắt làm sao, hyuyu!\",\"rating\":8.5},\n  {\"id\":755687,\"suggestedTranslation\":\"Từng cao lớn, giờ bé xíu.\",\"rating\":8.5},\n  {\"id\":755688,\"suggestedTranslation\":\"Lỗi lầm gì đã gây ra nỗi kinh hoàng thế này?\",\"rating\":8.5},\n  {\"id\":755689,\"suggestedTranslation\":\"Con robot đó rắc rối phết đấy.\",\"rating\":8.5},\n  {\"id\":755690,\"suggestedTranslation\":\"Chúng ta nhất thiết phải tưởng niệm con chó đột biến này sao?\",\"rating\":8.5},\n  {\"id\":755691,\"suggestedTranslation\":\"Bộ hàm của nó suýt đớp được ta, nhưng ta đã biến mất rồi! Hyuyu!\",\"rating\":8.5},\n  {\"id\":755692,\"suggestedTranslation\":\"Từ nóng bỏng hóa lạnh ngắt như đá.\",\"rating\":8.5},\n  {\"id\":755693,\"suggestedTranslation\":\"Hiệp sĩ nhỏ này đã chiến đấu rất gan lì đấy.\",\"rating\":8.5},\n  {\"id\":755694,\"suggestedTranslation\":\"Đừng có sai lầm khi đối đầu với nỗi kinh hoàng quằn quại này nhé.\",\"rating\":8.5},\n  {\"id\":755695,\"suggestedTranslation\":\"Xin chào! Tiếc quá, ta không cưng nựng ngươi được đâu.\",\"rating\":8.5},\n  {\"id\":755696,\"suggestedTranslation\":\"Chà chà, ngươi thấy gì thế hả?\",\"rating\":8.5},\n  {\"id\":755697,\"suggestedTranslation\":\"Chẳng có linh hồn nào liên kết với nó cả.\",\"rating\":8.5},\n  {\"id\":755698,\"suggestedTranslation\":\"Thế thì hơi lách luật một tí rồi đấy nhé, hyuyu!\",\"rating\":8.5},\n  {\"id\":755699,\"suggestedTranslation\":\"Tại sao tụi mình lại đi mở nó ra cơ chứ?!\",\"rating\":8.5},\n  {\"id\":755700,\"suggestedTranslation\":\"Hay là chúng ta thử làm thân với lũ cá xem sao nhỉ? Hyuyu!\",\"rating\":8.5},\n  {\"id\":755701,\"suggestedTranslation\":\"Ẳng ẳng sủa vang, ta cần cứu viện!\",\"rating\":8.5},\n  {\"id\":755702,\"suggestedTranslation\":\"Bị hóa đá từ đầu đến chân!\",\"rating\":8.5},\n  {\"id\":755703,\"suggestedTranslation\":\"Gầm gừ sủa vang, răng bén như cá mập!\",\"rating\":8.5},\n  {\"id\":755704,\"suggestedTranslation\":\"Bị hóa đá từ đầu đến chân!\",\"rating\":8.5},\n  {\"id\":755705,\"suggestedTranslation\":\"Sắp tắt ngấm đến nơi rồi.\",\"rating\":8.5},\n  {\"id\":755706,\"suggestedTranslation\":\"Brrr cháy brrr sáng.\",\"rating\":8.5},\n  {\"id\":755707,\"suggestedTranslation\":\"Lạnh buốt! Lạnh buốt quá.\",\"rating\":8.5},\n  {\"id\":755708,\"suggestedTranslation\":\"Nó cháy nhỏ quá, nhỏ quá đi mất!\",\"rating\":8.5},\n  {\"id\":755709,\"suggestedTranslation\":\"Ngọn lửa giá lạnh. Lạ phết nhỉ.\",\"rating\":8.5},\n  {\"id\":755710,\"suggestedTranslation\":\"Và thế là nó tắt ngúm.\",\"rating\":8.5},\n  {\"id\":755711,\"suggestedTranslation\":\"Sắp tắt ngấm đến nơi rồi.\",\"rating\":8.5},\n  {\"id\":755712,\"suggestedTranslation\":\"Brrr cháy brrr sáng.\",\"rating\":8.5},\n  {\"id\":755713,\"suggestedTranslation\":\"Lạnh buốt! Lạnh buốt quá.\",\"rating\":8.5},\n  {\"id\":755714,\"suggestedTranslation\":\"Nó cháy nhỏ quá, nhỏ quá đi mất!\",\"rating\":8.5},\n  {\"id\":755715,\"suggestedTranslation\":\"Ngọn lửa giá lạnh. Lạ phết nhỉ.\",\"rating\":8.5},\n  {\"id\":755716,\"suggestedTranslation\":\"Và thế là nó tắt ngúm.\",\"rating\":8.5},\n  {\"id\":755717,\"suggestedTranslation\":\"Không gian vô tận, biến mất không một dấu vết?\",\"rating\":8.5},\n  {\"id\":755718,\"suggestedTranslation\":\"Hướng Đông!\",\"rating\":8.5},\n  {\"id\":755719,\"suggestedTranslation\":\"Dùng cho lúc trên là dưới còn dưới là trên.\",\"rating\":8.5},\n  {\"id\":755720,\"suggestedTranslation\":\"Hướng Bắc!\",\"rating\":8.5},\n  {\"id\":755721,\"suggestedTranslation\":\"Hướng Đông Bắc!\",\"rating\":8.5},\n  {\"id\":755722,\"suggestedTranslation\":\"Hướng Tây Bắc!\",\"rating\":8.5},\n  {\"id\":755723,\"suggestedTranslation\":\"Hướng Nam!\",\"rating\":8.5},\n  {\"id\":755724,\"suggestedTranslation\":\"Hướng Đông Nam!\",\"rating\":8.5},\n  {\"id\":755725,\"suggestedTranslation\":\"Hướng Tây Nam!\",\"rating\":8.5},\n  {\"id\":755726,\"suggestedTranslation\":\"Hướng Tây!\",\"rating\":8.5},\n  {\"id\":755727,\"suggestedTranslation\":\"Ồ, ta có thể chơi mấy trò chơi khăm thú vị với cái này đấy.\",\"rating\":8.5},\n  {\"id\":755728,\"suggestedTranslation\":\"Thật là tuyệt vời, ra lò vừa vặn hoàn hảo!\",\"rating\":8.5},\n  {\"id\":755729,\"suggestedTranslation\":\"Ngốc nghếch thật đấy!\",\"rating\":8.5},\n  {\"id\":755730,\"suggestedTranslation\":\"Cố gắng tốt đấy, nhưng mà khô quá rồi.\",\"rating\":8.5},\n  {\"id\":755731,\"suggestedTranslation\":\"Cũng không hẳn là một tràng cười sảng khoái cho lắm.\",\"rating\":8.5},\n  {\"id\":755732,\"suggestedTranslation\":\"Ta đã cố rồi đấy, nhưng mà ẩm quá cơ.\",\"rating\":8.5},\n  {\"id\":755733,\"suggestedTranslation\":\"Là phân bón đấy. Để cho thực vật khỏiéo rũ.\",\"rating\":8.5},\n  {\"id\":755734,\"suggestedTranslation\":\"Nhưng mà tự improvising (tự làm) thì vui hơn chứ!\",\"rating\":8.5},\n  {\"id\":755735,\"suggestedTranslation\":\"Ồ, tiếp theo ta nên nấu món gì đây? Hyuyu!\",\"rating\":8.5},\n  {\"id\":755736,\"suggestedTranslation\":\"Nó được yên nghỉ rồi.\",\"rating\":8.5},\n  {\"id\":755737,\"suggestedTranslation\":\"Ta không thích có đồ ăn trong bụng mình cho lắm.\",\"rating\":8.5},\n  {\"id\":755738,\"suggestedTranslation\":\"Ta vẫn thà không ăn nó thì hơn.\",\"rating\":8.5},\n  {\"id\":755739,\"suggestedTranslation\":\"Ít ra thì giờ ngửi đỡ tệ hơn rồi.\",\"rating\":8.5},\n  {\"id\":755740,\"suggestedTranslation\":\"Chà, ngươi đúng là một anh chàng thú vị đấy chứ!\",\"rating\":8.5},\n  {\"id\":755741,\"suggestedTranslation\":\"Với bộ giáp gai góc này, ta chẳng sợ gì nữa hết!\",\"rating\":8.5},\n  {\"id\":755742,\"suggestedTranslation\":\"Sinh Vật Lạ đã ngã xuống, giờ ta lấy bộ vỏ của nó!\",\"rating\":8.5},\n  {\"id\":755743,\"suggestedTranslation\":\"Bí ẩn thật đấy, tấm thẻ trống trơn!\",\"rating\":8.5},\n  {\"id\":755744,\"suggestedTranslation\":\"Ta chẳng hiểu làm cách nào để nấu đồ ăn của người phàm cả.\",\"rating\":8.5},\n  {\"id\":755745,\"suggestedTranslation\":\"Sẽ mất kha khá thời gian đấy.\",\"rating\":8.5},\n  {\"id\":755746,\"suggestedTranslation\":\"Ta đang run lên vì mong đợi đây này!\",\"rating\":8.5}\n]",
