            "text": "[\n  {\"id\":754494,\"suggestedTranslation\":\"Hừm, đặt Hopper ở đâu nhỉ?\",\"rating\":9.0},\n  {\"id\":754495,\"suggestedTranslation\":\"Hopper đang giữ đèn\",\"rating\":9.0},\n  {\"id\":754496,\"suggestedTranslation\":\"Ngủ ngon nhé, Hopper\",\"rating\":9.0},\n  {\"id\":754497,\"suggestedTranslation\":\"Hừm, đặt Hopper ở đâu nhỉ?\",\"rating\":9.0},\n  {\"id\":754498,\"suggestedTranslation\":\"Muốn chơi không?\",\"rating\":9.0},\n  {\"id\":754499,\"suggestedTranslation\":\"Haha! Vui ghê!\",\"rating\":9.0},\n  {\"id\":754500,\"suggestedTranslation\":\"Đặt đấu trường Hopper ở đâu đây?\",\"rating\":9.0},\n  {\"id\":754501,\"suggestedTranslation\":\"Hopper?\",\"rating\":9.0},\n  {\"id\":754502,\"suggestedTranslation\":\"Mmmmm...\",\"rating\":9.0},\n  {\"id\":754503,\"suggestedTranslation\":\"Đang tìm à?\",\"rating\":9.0},\n  {\"id\":754504,\"suggestedTranslation\":\"Mềm nhũn\",\"rating\":9.0},\n  {\"id\":754505,\"suggestedTranslation\":\"Ồ\",\"rating\":9.0},\n  {\"id\":754506,\"suggestedTranslation\":\"Hopper đói à?\",\"rating\":9.0},\n  {\"id\":754507,\"suggestedTranslation\":\"Hopper vui vẻ\",\"rating\":9.0},\n  {\"id\":754508,\"suggestedTranslation\":\"Để đập á? Ồ không...\",\"rating\":9.0},\n  {\"id\":754509,\"suggestedTranslation\":\"Tội nghiệp người bạn cao kều\",\"rating\":9.0},\n  {\"id\":754510,\"suggestedTranslation\":\"Người bạn cao kều xinh xắn\",\"rating\":9.0},\n  {\"id\":754511,\"suggestedTranslation\":\"Làm người bạn cao kều nào!\",\"rating\":9.0},\n  {\"id\":754512,\"suggestedTranslation\":\"Lửa xấu xa, xấu xa\",\"rating\":9.0},\n  {\"id\":754513,\"suggestedTranslation\":\"Cậu nhóc uốn éo ăn gì nhỉ?\",\"rating\":9.0},\n  {\"id\":754514,\"suggestedTranslation\":\"Cậu nhóc uốn éo đã no\",\"rating\":9.0},\n  {\"id\":754515,\"suggestedTranslation\":\"Thứ uốn éo lấp lánh gì thế?\",\"rating\":9.0},\n  {\"id\":754516,\"suggestedTranslation\":\"Lửa ác quá\",\"rating\":9.0},\n  {\"id\":754517,\"suggestedTranslation\":\"Muốn chơi không?\",\"rating\":9.0},\n  {\"id\":754518,\"suggestedTranslation\":\"Mèo con thích hộp\",\"rating\":9.0},\n  {\"id\":754519,\"suggestedTranslation\":\"Bạn à?\",\"rating\":9.0},\n  {\"id\":754520,\"suggestedTranslation\":\"Vui vẻ\",\"rating\":9.0},\n  {\"id\":754521,\"suggestedTranslation\":\"Có gì đó sai sai\",\"rating\":9.0},\n  {\"id\":754522,\"suggestedTranslation\":\"Nhớ gia đình\",\"rating\":9.0},\n  {\"id\":754523,\"suggestedTranslation\":\"Muốn trò chuyện\",\"rating\":9.0},\n  {\"id\":754524,\"suggestedTranslation\":\"Xung quanh phiền phức quá\",\"rating\":9.0},\n  {\"id\":754525,\"suggestedTranslation\":\"Khát nước\",\"rating\":9.0},\n  {\"id\":754526,\"suggestedTranslation\":\"Cần đồ ăn!\",\"rating\":9.0},\n  {\"id\":754527,\"suggestedTranslation\":\"Cần không gian\",\"rating\":9.0},\n  {\"id\":754528,\"suggestedTranslation\":\"Không thích thời tiết lúc này\",\"rating\":9.0},\n  {\"id\":754529,\"suggestedTranslation\":\"Không không không, không vui chút nào!\",\"rating\":9.0},\n  {\"id\":754530,\"suggestedTranslation\":\"Ồ không...\",\"rating\":9.0},\n  {\"id\":754531,\"suggestedTranslation\":\"Ánh sáng ở đâu nhỉ?\",\"rating\":9.0},\n  {\"id\":754532,\"suggestedTranslation\":\"Cảm thấy không khỏe\",\"rating\":9.0},\n  {\"id\":754533,\"suggestedTranslation\":\"Bạn bè?\",\"rating\":9.0},\n  {\"id\":754534,\"suggestedTranslation\":\"Không thắng rồi. Ôi\",\"rating\":9.0},\n  {\"id\":754535,\"suggestedTranslation\":\"Cháy rồi. Ôi\",\"rating\":9.0},\n  {\"id\":754536,\"suggestedTranslation\":\"Úi. Món này không tốt cho bụng cho lắm\",\"rating\":9.0},\n  {\"id\":754537,\"suggestedTranslation\":\"Yay! Làm được rồi!\",\"rating\":9.0},\n  {\"id\":754539,\"suggestedTranslation\":\"Giờ người bạn có lông vũ của chúng ta ở đâu rồi nhỉ?\",\"rating\":9.0},\n  {\"id\":754540,\"suggestedTranslation\":\"Không có ai ở nhà, mình ta lẻ loi một mình!\",\"rating\":9.0},\n  {\"id\":754541,\"suggestedTranslation\":\"Bạn lông vũ hở? Ta nghĩ ta biết hắn với một cái tên khác đấy.\",\"rating\":9.0},\n  {\"id\":754542,\"suggestedTranslation\":\"Chúng ta sẽ cần thêm bạn nếu muốn chơi đấy, hyuyu!\",\"rating\":9.0},\n  {\"id\":754543,\"suggestedTranslation\":\"Trò chơi bị hủy rồi, chẳng còn chỗ nào để trốn nữa!\",\"rating\":9.0},\n  {\"id\":754544,\"suggestedTranslation\":\"Nếu chơi nữa thì thành ra tra tấn mất thôi.\",\"rating\":9.0},\n  {\"id\":754545,\"suggestedTranslation\":\"Ta đang bị khóa ở ngoài, hay ở trong vậy nhỉ?\",\"rating\":9.0},\n  {\"id\":754546,\"suggestedTranslation\":\"Ôi tiếc thật, ta cứ nghĩ nó sẽ hợp với ngươi cơ.\",\"rating\":9.0},\n  {\"id\":754547,\"suggestedTranslation\":\"Họ đến rồi đi, liệu tất cả chỉ là một giấc mơ?\",\"rating\":9.0},\n  {\"id\":754549,\"suggestedTranslation\":\"Ta là một sinh vật sống, không phải robot.\",\"rating\":9.0},\n  {\"id\":754550,\"suggestedTranslation\":\"Ta chẳng thể giúp gì đâu, kể cả với tảo bẹ.\",\"rating\":9.0},\n  {\"id\":754551,\"suggestedTranslation\":\"Willow! Ngươi đang làm gì trong lúc chú gấu bông gây ra đống hỗn độn này thế?\",\"rating\":9.0},\n  {\"id\":754552,\"suggestedTranslation\":\"Phải nhanh chóng kiếm lấy một chiếc gối thôi.\",\"rating\":9.0},\n  {\"id\":754554,\"suggestedTranslation\":\"Ta không nghĩ mình uống nổi thứ đó đâu!\",\"rating\":9.0},\n  {\"id\":754557,\"suggestedTranslation\":\"Ta đã thử, nhưng họ đang bận mất rồi.\",\"rating\":9.0},\n  {\"id\":754558,\"suggestedTranslation\":\"Cơ thể ta chắc chắn sẽ chết mất.\",\"rating\":9.0},\n  {\"id\":754559,\"suggestedTranslation\":\"Có kẻ khác nẫng mất phần vui rồi!\",\"rating\":9.0},\n  {\"id\":754560,\"suggestedTranslation\":\"Ta không thể ném nó qua chiếc gương thần được!\",\"rating\":9.0},\n  {\"id\":754562,\"suggestedTranslation\":\"Khoan đã, bạn tôi ơi!\",\"rating\":9.0},\n  {\"id\":754563,\"suggestedTranslation\":\"Ta đã lập khế ước với một con quái vật rồi.\",\"rating\":9.0},\n  {\"id\":754564,\"suggestedTranslation\":\"Hoặc là ta phải xuống, hoặc thế giới phải lên thôi.\",\"rating\":9.0},\n  {\"id\":754565,\"suggestedTranslation\":\"Ồ, nhưng một con là đủ rồi, hyuyu!\",\"rating\":9.0},\n  {\"id\":754566,\"suggestedTranslation\":\"Ố hô, chậm chân mất rồi!\",\"rating\":9.0},\n  {\"id\":754567,\"suggestedTranslation\":\"Lửa! Lông của ta!\",\"rating\":9.0},\n  {\"id\":754568,\"suggestedTranslation\":\"Một linh hồn khác đang chạm trổ nó rồi.\",\"rating\":9.0},\n  {\"id\":754576,\"suggestedTranslation\":\"Dù sao thì ta cũng không mặn mà lắm với quần áo.\",\"rating\":9.0},\n  {\"id\":754577,\"suggestedTranslation\":\"Ta thích hình dạng hiện tại của mình hơn.\",\"rating\":9.0},\n  {\"id\":754578,\"suggestedTranslation\":\"Một linh hồn khác đang dùng nó lúc này.\",\"rating\":9.0},\n  {\"id\":754579,\"suggestedTranslation\":\"Ta không thể bắt đầu nếu không có con bò lai được cột vào.\",\"rating\":9.0},\n  {\"id\":754580,\"suggestedTranslation\":\"Ta có thể trang hoàng cho nó... khi nó mọc đủ lông.\",\"rating\":9.0},\n  {\"id\":754581,\"suggestedTranslation\":\"Sao lại ủ rũ thế? Chúng ta đang tràn đầy năng lượng mà!\",\"rating\":9.0},\n  {\"id\":754582,\"suggestedTranslation\":\"Ái! Hết điện rồi!\",\"rating\":9.0},\n  {\"id\":754583,\"suggestedTranslation\":\"Con cá con này không thắng được đâu, không đời nào!\",\"rating\":9.0},\n  {\"id\":754584,\"suggestedTranslation\":\"Ta phải trồng ra vài nông sản bự hơn mới được, hyuyuyu!\",\"rating\":9.0},\n  {\"id\":754585,\"suggestedTranslation\":\"Ta không thể tạo ra thứ gì từ hư vô được.\",\"rating\":9.0},\n  {\"id\":754586,\"suggestedTranslation\":\"Một linh hồn khác đang dùng nó lúc này.\",\"rating\":9.0},\n  {\"id\":754587,\"suggestedTranslation\":\"Ta đã làm sai một bước rồi.\",\"rating\":9.0},\n  {\"id\":754588,\"suggestedTranslation\":\"Ồ, ta chịu thua đấy.\",\"rating\":9.0},\n  {\"id\":754589,\"suggestedTranslation\":\"Ta sẽ quay lại khi mặt đất ổn định hơn.\",\"rating\":9.0},\n  {\"id\":754590,\"suggestedTranslation\":\"Ta thích nhấm nháp linh hồn mà không ai dùng hơn.\",\"rating\":9.0},\n  {\"id\":754591,\"suggestedTranslation\":\"Người phàm cần thức ăn vật chất hơn ta.\",\"rating\":9.0},\n  {\"id\":754592,\"suggestedTranslation\":\"Chắc ta có thể nhảy qua đó.\",\"rating\":9.0},\n  {\"id\":754593,\"suggestedTranslation\":\"Khỉ thật! Cái mũ đó kìa!\",\"rating\":9.0},\n  {\"id\":754594,\"suggestedTranslation\":\"Một linh hồn khác đang xây nó kìa!\",\"rating\":9.0},\n  {\"id\":754595,\"suggestedTranslation\":\"Ta vừa thấy nó tan chảy.\",\"rating\":9.0},\n  {\"id\":754596,\"suggestedTranslation\":\"Hừm, cao quá rồi.\",\"rating\":9.0},\n  {\"id\":754597,\"suggestedTranslation\":\"Ôi trời, khô khốc quá! Để lát nữa ta thử lại vậy.\",\"rating\":9.0},\n  {\"id\":754598,\"suggestgTranslation\":\"E là cái nồi đang quá nóng đấy!\",\"rating\":9.0},\n  {\"id\":754599,\"suggestedTranslation\":\"Một linh hồn khác đang dùng nó lúc này.\",\"rating\":9.0},\n  {\"id\":754600,\"suggestedTranslation\":\"Đầu tiên phải lấy hết đồ đạc bên trong ra đã.\",\"rating\":9.0},\n  {\"id\":754601,\"suggestedTranslation\":\"Trượt rồi! Thật là đáng thất vọng!\",\"rating\":9.0},\n  {\"id\":754602,\"suggestedTranslation\":\"Ta chẳng có chút trí tưởng tượng nào cả.\",\"rating\":9.0},\n  {\"id\":754603,\"suggestedTranslation\":\"Tốt hơn là ta nên trốn ra cái ao nước ngọt nào đó.\",\"rating\":9.0},\n  {\"id\":754604,\"suggestedTranslation\":\"Dừng lại, hủy bỏ! Dây câu của ta ngắn quá!\",\"rating\":9.0},\n  {\"id\":754605,\"suggestedTranslation\":\"Chịu hết nổi rồi! Lại về tay trắng!\",\"rating\":9.0},\n  {\"id\":754606,\"suggestedTranslation\":\"Linh hồn này đã bị hút cạn rồi! Hyuyu!\",\"rating\":9.0},\n  {\"id\":754607,\"suggestedTranslation\":\"Ta sẽ thử lại vào một thời điểm khác.\",\"rating\":9.0},\n  {\"id\":754608,\"suggestedTranslation\":\"Linh hồn của nó bị ngăn cản không thể quay lại đây.\",\"rating\":9.0},\n  {\"id\":754609,\"suggestedTranslation\":\"Cứ để họ vui vẻ đi, rồi ta sẽ cho người phàm biết thế nào là lễ độ.\",\"rating\":9.0},\n  {\"id\":754610,\"suggestedTranslation\":\"Không thể thi đấu cho đến khi đường đua hoàn thành!\",\"rating\":9.0},\n  {\"id\":754611,\"suggestedTranslation\":\"Ôi trời, nó không muốn thứ đó đâu.\",\"rating\":9.0},\n  {\"id\":754612,\"suggestedTranslation\":\"Linh hồn của họ hiện không ở bên trong.\",\"rating\":9.0},\n  {\"id\":754613,\"suggestedTranslation\":\"Chúng ta không thể học những gì mình đã biết rồi!\",\"rating\":9.0},\n  {\"id\":754614,\"suggestedTranslation\":\"Đã có sẵn một món ăn ở đó rồi, trông ngon phết!\",\"rating\":9.0},\n  {\"id\":754615,\"suggestedTranslation\":\"Không, không, không.\",\"rating\":9.0},\n  {\"id\":754616,\"suggestedTranslation\":\"Chẳng có cơ thể nào cho nó quay về cả.\",\"rating\":9.0},\n  {\"id\":754617,\"suggestedTranslation\":\"Cái bụng của nó đang thèm thuồng linh hồn của một khúc gỗ.\",\"rating\":9.0},\n  {\"id\":754618,\"suggestedTranslation\":\"Chỉ còn chỗ cho... một cây nấm thôi!\",\"rating\":9.0},\n  {\"id\":754619,\"suggestedTranslation\":\"Nó không muốn đâm chồi nảy lộc ở đây đâu.\",\"rating\":9.0},\n  {\"id\":754620,\"suggestedTranslation\":\"Có muốn nhét vào cũng không vừa đâu!\",\"rating\":9.0},\n  {\"id\":754621,\"suggestedTranslation\":\"Ánh trăng ơi, mong là ngươi sẽ đến sớm!\",\"rating\":9.0},\n  {\"id\":754622,\"suggestedTranslation\":\"Ta nói được nhiều thứ tiếng, nhưng không phải tiếng đó.\",\"rating\":9.0},\n  {\"id\":754623,\"suggestedTranslation\":\"Tốt nhất là chúng ta không nên làm vậy.\",\"rating\":9.0},\n  {\"id\":754624,\"suggestedTranslation\":\"Có muốn nhét vào cũng không vừa đâu!\",\"rating\":9.0},\n  {\"id\":754625,\"suggestedTranslation\":\"Ta không nghĩ vậy đâu, không không không!\",\"rating\":9.0},\n  {\"id\":754626,\"suggestedTranslation\":\"Hoàn toàn sai rồi, đúng thế đấy!\",\"rating\":9.0},\n  {\"id\":754627,\"suggestedTranslation\":\"Linh hồn chúng ta đang gặp nguy hiểm chết người đấy!\",\"rating\":9.0},\n  {\"id\":754628,\"suggestedTranslation\":\"Sự hỗn loạn tuyệt đẹp này làm ta vướng víu quá.\",\"rating\":9.0},\n  {\"id\":754629,\"suggestedTranslation\":\"Trời tối mất rồi!\",\"rating\":9.0},\n  {\"id\":754630,\"suggestedTranslation\":\"Lịch trình của nữ hoàng chắc phải bận rộn điên đầu ấy chứ, hyuyu!\",\"rating\":9.0},\n  {\"id\":754631,\"suggestedTranslation\":\"Tâm trí họ hiện đang ở một cõi khác mất rồi.\",\"rating\":9.0},\n  {\"id\":754632,\"suggestedTranslation\":\"Nó đầy mất rồi.\",\"rating\":9.0},\n  {\"id\":754633,\"suggestedTranslation\":\"Túi của ta chật quá nên không đội vừa cái mũ đó đâu.\",\"rating\":9.0},\n  {\"id\":754634,\"suggestedTranslation\":\"Đợi một phút xem nào, trong đó có gì đâu!\",\"rating\":9.0},\n  {\"id\":754635,\"suggestedTranslation\":\"Đúng là một khối lăng kính khó tính!\",\"rating\":9.0},\n  {\"id\":754636,\"suggestedTranslation\":\"Màu của nó sai bét nhè, sai hoàn toàn luôn.\",\"rating\":9.0},\n  {\"id\":754637,\"suggestedTranslation\":\"Trông ngớ ngẩn thật đấy, hyuyu!\",\"rating\":9.0},\n  {\"id\":754638,\"suggestedTranslation\":\"Đầu tiên ta phải thu hút sự chú ý của họ đã.\",\"rating\":9.0},\n  {\"id\":754639,\"suggestedTranslation\":\"Linh hồn của họ hiện không ở bên trong.\",\"rating\":9.0},\n  {\"id\":754640,\"suggestedTranslation\":\"Túi của họ đang căng phồng kìa!\",\"rating\":9.0},\n  {\"id\":754641,\"suggestedTranslation\":\"Tâm trí họ hiện đang ở một cõi khác mất rồi.\",\"rating\":9.0},\n  {\"id\":754642,\"suggestedTranslation\":\"Đầu tiên ta phải thu hút sự chú ý của họ đã.\",\"rating\":9.0},\n  {\"id\":754643,\"suggestedTranslation\":\"Linh hồn của họ hiện không ở bên trong.\",\"rating\":9.0},\n  {\"id\":754644,\"suggestedTranslation\":\"Túi của họ đang căng phồng kìa!\",\"rating\":9.0},\n  {\"id\":754645,\"suggestedTranslation\":\"Tâm trí họ hiện đang ở một cõi khác mất rồi.\",\"rating\":9.0},\n  {\"id\":754646,\"suggestedTranslation\":\"Chúng ta không thể học những gì mình đã biết rồi!\",\"rating\":9.0},\n  {\"id\":754647,\"suggestedTranslation\":\"Con bọ thiếc này không thích trò chuyện đâu.\",\"rating\":9.0},\n  {\"id\":754648,\"suggestedTranslation\":\"E là đúng vậy đấy, cách này không tác d