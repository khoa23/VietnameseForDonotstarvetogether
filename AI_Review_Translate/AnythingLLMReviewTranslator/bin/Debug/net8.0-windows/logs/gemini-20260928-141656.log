            "text": "[\n  {\"id\": 749923, \"suggestedTranslation\": \"Chẳng có lý do gì để thứ đó tồn tại cả.\", \"rating\": 9.0},\n  {\"id\": 749924, \"suggestedTranslation\": \"Thế là hắn đã đổi ý rồi nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749925, \"suggestedTranslation\": \"Ý cậu sao hả Luce? Ta có nên xem nó dẫn đến đâu không?\", \"rating\": 9.0},\n  {\"id\": 749926, \"suggestedTranslation\": \"Bên trong có vài thứ hay ho phết đấy, phải không?\", \"rating\": 9.0},\n  {\"id\": 749927, \"suggestedTranslation\": \"Đó là một bức tượng tò mò thật đấy, nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749928, \"suggestedTranslation\": \"Cậu mất đầu rồi à, nhể?\", \"rating\": 9.0},\n  {\"id\": 749929, \"suggestedTranslation\": \"Trở về với thiên nhiên nào, nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749930, \"suggestedTranslation\": \"Lát nữa tôi sẽ trêu lão ta vì vụ này, phết đấy chứ?\", \"rating\": 9.0},\n  {\"id\": 749931, \"suggestedTranslation\": \"Trông có vẻ khá sang trọng.\", \"rating\": 9.0},\n  {\"id\": 749932, \"suggestedTranslation\": \"Cô ta cao thật đấy, nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749933, \"suggestedTranslation\": \"Tôi không chắc mình hiểu nổi nó.\", \"rating\": 9.0},\n  {\"id\": 749934, \"suggestedTranslation\": \"Làm chậu trồng cây từ cái này thì đẹp phết.\", \"rating\": 9.0},\n  {\"id\": 749935, \"suggestedTranslation\": \"Cái đó sẽ làm chiếc rìu của cậu sáng bóng trở lại đấy.\", \"rating\": 9.0},\n  {\"id\": 749936, \"suggestedTranslation\": \"Tôi thích biết mình đang đi đâu.\", \"rating\": 9.0},\n  {\"id\": 749937, \"suggestedTranslation\": \"Chúng ta nên dựng phần đế thuyền ván trước đã.\", \"rating\": 9.0},\n  {\"id\": 749938, \"suggestedTranslation\": \"Ái! Nhọn quá.\", \"rating\": 9.0},\n  {\"id\": 749939, \"suggestedTranslation\": \"Trông có vẻ hơi cứng so với mông tôi.\", \"rating\": 9.0},\n  {\"id\": 749940, \"suggestedTranslation\": \"Họ đang tranh thủ nghỉ ngơi thư giãn đấy à?\", \"rating\": 9.0},\n  {\"id\": 749941, \"suggestedTranslation\": \"Đây là loại gỗ gì thế này?!\", \"rating\": 9.0},\n  {\"id\": 749942, \"suggestedTranslation\": \"Đây là loại gỗ gì thế này?!\", \"rating\": 9.0},\n  {\"id\": 749943, \"suggestedTranslation\": \"Lucy! Có phải cậu làm thế không?\", \"rating\": 9.0},\n  {\"id\": 749944, \"suggestedTranslation\": \"Ta chặt, còn nó thì thu gom.\", \"rating\": 9.0},\n  {\"id\": 749945, \"suggestedTranslation\": \"Nó sẽ che nắng cho đầu cậu đấy.\", \"rating\": 9.0},\n  {\"id\": 749946, \"suggestedTranslation\": \"Tôi nấu ăn khá lên rồi đấy.\", \"rating\": 9.0},\n  {\"id\": 749947, \"suggestedTranslation\": \"Tôi ăn căng cứng cả bụng rồi đây!\", \"rating\": 9.0},\n  {\"id\": 749948, \"suggestedTranslation\": \"Có rất nhiều nước bên trong một thực vật bé xíu như thế đấy.\", \"rating\": 9.0},\n  {\"id\": 749949, \"suggestedTranslation\": \"Thơm phết.\", \"rating\": 9.0},\n  {\"id\": 749950, \"suggestedTranslation\": \"Đó là một thực vật phải không?\", \"rating\": 9.0},\n  {\"id\": 749951, \"suggestedTranslation\": \"Không phải cây gỗ, nhưng cũng tạm được.\", \"rating\": 9.0},\n  {\"id\": 749952, \"suggestedTranslation\": \"Tôi nghĩ mình thích rương gỗ tuyết tùng hơn.\", \"rating\": 9.0},\n  {\"id\": 749953, \"suggestedTranslation\": \"Khỉ thật, cái ổ khóa này cứng đầu thế không biết!\", \"rating\": 9.0},\n  {\"id\": 749954, \"suggestedTranslation\": \"Lucy cứ bảo là tôi nên ngăn nắp hơn.\", \"rating\": 9.0},\n  {\"id\": 749955, \"suggestedTranslation\": \"Nó bắt đầu trông hơi lỏng lẻo rồi đấy.\", \"rating\": 9.0},\n  {\"id\": 749956, \"suggestedTranslation\": \"Xui ghê, tôi đến quá muộn để hét \\\"đổ ơ ơ ớn\\\" rồi!\", \"rating\": 9.0},\n  {\"id\": 749957, \"suggestedTranslation\": \"Cao và cứng cáp như một cây cẩm lai.\", \"rating\": 9.0},\n  {\"id\": 749958, \"suggestedTranslation\": \"Nó bắt đầu trông hơi lỏng lẻo rồi đấy.\", \"rating\": 9.0},\n  {\"id\": 749959, \"suggestedTranslation\": \"Chà, câu chuyện chỉ có vậy thôi.\", \"rating\": 9.0},\n  {\"id\": 749960, \"suggestedTranslation\": \"Nó sẽ chịu được vài nhát chém đấy, nhỉ Luce?\", \"rating\": 9.0},\n  {\"id\": 749961, \"suggestedTranslation\": \"Vẫn cần thêm chút công sức nữa nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749962, \"suggestedTranslation\": \"Vẫn cần thêm chút công sức nữa nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749963, \"suggestedTranslation\": \"Món đó ăn ngon phết.\", \"rating\": 9.0},\n  {\"id\": 749964, \"suggestedTranslation\": \"Không phải họa tiết sọc vuông, nhưng tạm dùng được.\", \"rating\": 9.0},\n  {\"id\": 749965, \"suggestedTranslation\": \"Tôi không ngại đâu!\", \"rating\": 9.0},\n  {\"id\": 749966, \"suggestedTranslation\": \"Gần như làm tôi quên mất mình đang ở đâu.\", \"rating\": 9.0},\n  {\"id\": 749967, \"suggestedTranslation\": \"Tôi vẫn thích rìu của mình hơn.\", \"rating\": 9.0},\n  {\"id\": 749968, \"suggestedTranslation\": \"Chắc đó là một cách dọn dẹp bát đĩa nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749969, \"suggestedTranslation\": \"Chúng ta có khách đến à?\", \"rating\": 9.0},\n  {\"id\": 749970, \"suggestedTranslation\": \"Chuẩn luôn. Đồ ăn trông ngon mắt phết.\", \"rating\": 9.0},\n  {\"id\": 749971, \"suggestedTranslation\": \"Úi. Không phải đồ ăn đúng ý rồi.\", \"rating\": 9.0},\n  {\"id\": 749972, \"suggestedTranslation\": \"Nó không giống cái hộp đánh bắt mà tôi từng có ở nhà cho lắm.\", \"rating\": 9.0},\n  {\"id\": 749973, \"suggestedTranslation\": \"Này, có vài ý tưởng tuyệt vời cho dụng cụ đánh bắt mới ở đây này!\", \"rating\": 9.0},\n  {\"id\": 749974, \"suggestedTranslation\": \"Cũng lâu rồi tôi chưa đi câu cá đấy.\", \"rating\": 9.0},\n  {\"id\": 749975, \"suggestedTranslation\": \"Ngọt ngào ngon tuyệt.\", \"rating\": 9.0},\n  {\"id\": 749976, \"suggestedTranslation\": \"Tôi cũng chẳng tin tưởng mấy con chim không biết bay.\", \"rating\": 9.0},\n  {\"id\": 749977, \"suggestedTranslation\": \"Có gì trong này thế nhỉ?\", \"rating\": 9.0},\n  {\"id\": 749978, \"suggestedTranslation\": \"Nó có vị như công lý vậy.\", \"rating\": 9.0},\n  {\"id\": 749979, \"s