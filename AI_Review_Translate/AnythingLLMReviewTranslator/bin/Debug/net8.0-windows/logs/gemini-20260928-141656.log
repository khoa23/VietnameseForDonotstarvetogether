            "text": "[\n  {\"id\":755747,\"suggestedTranslation\":\"Trông món ngon của tôi đã sẵn sàng để thưởng thức rồi kìa!\",\"rating\":9.0},\n  {\"id\":755748,\"suggestedTranslation\":\"Linh hồn cũng có thể sủi tăm sao?\",\"rating\":9.0},\n  {\"id\":755749,\"suggestedTranslation\":\"Bao nhiêu rắc rối chỉ vì mấy cái bóng nước này.\",\"rating\":9.0},\n  {\"id\":755750,\"suggestedTranslation\":\"Dùng của cậu vẫn hơn của tôi.\",\"rating\":9.0},\n  {\"id\":755751,\"suggestedTranslation\":\"Tôi thích không phải tiêu thụ thức ăn hơn.\",\"rating\":9.0},\n  {\"id\":755752,\"suggestedTranslation\":\"Tôi cứ tưởng nó phải nổ tung cơ.\",\"rating\":9.0},\n  {\"id\":755753,\"suggestedTranslation\":\"Nghe tôi nói đây nào, hyuyu!\",\"rating\":9.0},\n  {\"id\":755754,\"suggestedTranslation\":\"Trồng một hạt giống, bạn sẽ có cái để ăn!\",\"rating\":9.0},\n  {\"id\":755755,\"suggestedTranslation\":\"Hyuyuyu, ôi đây là một trò chơi vui nhộn!\",\"rating\":9.0},\n  {\"id\":755756,\"suggestedTranslation\":\"Hyuyuyu, ôi đây là một trò chơi vui nhộn!\",\"rating\":9.0},\n  {\"id\":755757,\"suggestedTranslation\":\"Hyuyuyu, ôi đây là một trò chơi vui nhộn!\",\"rating\":9.0},\n  {\"id\":755758,\"suggestedTranslation\":\"Hyuyuyu, ôi đây là một trò chơi vui nhộn!\",\"rating\":9.0},\n  {\"id\":755759,\"suggestedTranslation\":\"Hyuyuyu, ôi đây là một trò chơi vui nhộn!\",\"rating\":9.0},\n  {\"id\":755760,\"suggestedTranslation\":\"Một nàng công chúa phải ăn mặc thật lộng lẫy để thành công!\",\"rating\":9.0},\n  {\"id\":755761,\"suggestedTranslation\":\"Hyuyuyu, ôi đây là một trò chơi vui nhộn!\",\"rating\":9.0},\n  {\"id\":755762,\"suggestedTranslation\":\"Hyuyuyu, ôi đây là một trò chơi vui nhộn!\",\"rating\":9.0},\n  {\"id\":755763,\"suggestedTranslation\":\"Nó khao khát có thứ gì đó để đốt cháy làm sao.\",\"rating\":9.0},\n  {\"id\":755764,\"suggestedTranslation\":\"Hãy nán lại bên ánh sáng của chú cừu nhỏ này nào.\",\"rating\":9.0},\n  {\"id\":755765,\"suggestedTranslation\":\"Nó khao khát có thứ gì đó để đốt cháy làm sao.\",\"rating\":9.0},\n  {\"id\":755766,\"suggestedTranslation\":\"Chú cừu đã được thắp sáng, sao không ở lại một lát?\",\"rating\":9.0},\n  {\"id\":755767,\"suggestedTranslation\":\"Nó khao khát có thứ gì đó để đốt cháy làm sao.\",\"rating\":9.0},\n  {\"id\":755768,\"suggestedTranslation\":\"Chú cừu bằng vàng, thật là một cảnh tượng đáng chiêm ngưỡng.\",\"rating\":9.0},\n  {\"id\":755769,\"suggestedTranslation\":\"Hyuyu, thật là cám dỗ làm sao!\",\"rating\":9.0},\n  {\"id\":755770,\"suggestedTranslation\":\"Anh thấy thời gian ở trên mặt đất thế nào rồi?\",\"rating\":9.0},\n  {\"id\":755771,\"suggestedTranslation\":\"Lại một linh hồn bị nguyền rủa nữa.\",\"rating\":9.5},\n  {\"id\":755772,\"suggestedTranslation\":\"Lâu đài này đang thiếu những viên bảo thạch vương miện của nó.\",\"rating\":9.0},\n  {\"id\":755773,\"suggestedTranslation\":\"Thôi đừng nổi điên lên chứ, hyuyu!\",\"rating\":9.0},\n  {\"id\":755774,\"suggestedTranslation\":\"Đó mới là cái vuốt đáng sợ chứ, hyuyuyu!\",\"rating\":9.0},\n  {\"id\":755775,\"suggestedTranslation\":\"Chẳng có gì hay ho ở một bức tường gai băng cả.\",\"rating\":9.5},\n  {\"id\":755776,\"suggestedTranslation\":\"Tránh xa ra, đồ ăn đáy giếng!\",\"rating\":9.0},\n  {\"id\":755777,\"suggestedTranslation\":\"Tôi thật sự bị choáng đến mức rớt cả mai rồi!\",\"rating\":9.0},\n  {\"id\":755778,\"suggestedTranslation\":\"Ooo, tôi rất muốn có một bạn đồng hành để chơi khăm đấy.\",\"rating\":9.0},\n  {\"id\":755779,\"suggestedTranslation\":\"Xưa kia ngươi ở trong khúc gỗ mục, giờ thì ngươi ở đây mãi mãi rồi!\",\"rating\":9.0},\n  {\"id\":755780,\"suggestedTranslation\":\"Nhìn cậu kìa, chú rồng con phun lửa nhỏ bé!\",\"rating\":9.0},\n  {\"id\":755781,\"suggestedTranslation\":\"Nhảy đi hơi xa nhà rồi đấy, hỡi kẻ phàm trần?\",\"rating\":9.0},\n  {\"id\":755782,\"suggestedTranslation\":\"Tôi rất vui vì chúng ta có thể làm hòa, người bạn có mắt ạ!\",\"rating\":9.0},\n  {\"id\":755783,\"suggestedTranslation\":\"Cậu đúng là một bé lùn đáng yêu làm sao.\",\"rating\":9.0},\n  {\"id\":755784,\"suggestedTranslation\":\"Trò chơi khăm tiếp theo của chúng ta nên là gì đây, mèo con?\",\"rating\":9.0},\n  {\"id\":755785,\"suggestedTranslation\":\"Cứ biết là tôi đang vuốt ve bạn trong tâm trí mình nhé.\",\"rating\":9.0},\n  {\"id\":755786,\"suggestedTranslation\":\"Trên đôi cánh rực sáng bay tới là một cục bông đáng yêu!\",\"rating\":9.0},\n  {\"id\":755787,\"suggestedTranslation\":\"Cậu đáng yêu đến mức tôi chỉ muốn nuốt chửng cậu luôn thôi.\",\"rating\":9.0},\n  {\"id\":755788,\"suggestedTranslation\":\"Xin lỗi vì tôi không thể vuốt ve cậu được, người bạn nhỏ.\",\"rating\":9.0},\n  {\"id\":755789,\"suggestedTranslation\":\"Tên lừa đảo thông minh.\",\"rating\":9.0},\n  {\"id\":755790,\"suggestedTranslation\":\"Cẩn thận đấy, đừng chạm vào tay tôi.\",\"rating\":9.0},\n  {\"id\":755791,\"suggestedTranslation\":\"Đời là thế đấy, vụn bánh quy ơi, hyuyu!\",\"rating\":9.5},\n  {\"id\":755792,\"suggestedTranslation\":\"Ôi trời ơi là trời, tôi có muốn rời đi cũng chẳng được!\",\"rating\":9.0},\n  {\"id\":755793,\"suggestedTranslation\":\"Ồ, tôi có thể đan lát được khối thứ đấy!\",\"rating\":9.0},\n  {\"id\":755794,\"suggestedTranslation\":\"Nó kém hơn hẳn những thứ còn lại.\",\"rating\":9.0},\n  {\"id\":755795,\"suggestedTranslation\":\"Tôi thật sự không muốn ăn cái đó đâu.\",\"rating\":9.0},\n  {\"id\":755796,\"suggestedTranslation\":\"Chỉ một cú giật dứt khoát là xong.\",\"rating\":9.0},\n  {\"id\":755797,\"suggestedTranslation\":\"Người ta vẫn thường nói, từng viên gạch một.\",\"rating\":9.0},\n  {\"id\":755798,\"suggestedTranslation\":\"Tôi cảm nhận được câu trả lời là kẻ thù.\",\"rating\":9.0},\n  {\"id\":755799,\"suggestedTranslation\":\"Bạn hay thù đây?\",\"rating\":9.0},\n  {\"id\":755800,\"suggestedTranslation\":\"Đúng là xui xẻo khi lại thấy hắn ta kẹt... một lần nữa.\",\"rating\":9.0},\n  {\"id\":755801,\"suggestedTranslation\":\"Được giải thoát thật rồi.\",\"rating\":9.0},\n  {\"id\":755802,\"suggestedTranslation\":\"Không phải tôi muốn làm quá, nhưng anh có thói quen hành xử rất kỳ lạ đấy.\",\"rating\":9.0},\n  {\"id\":755803,\"suggestedTranslation\":\"Tại sao lại giấu hòn đá này ở bên trong cơ chứ?\",\"rating\":9.0},\n  {\"id\":755804,\"suggestedTranslation\":\"Một số phận thật tồi tệ, khi bị giam cầm trong trạng thái này.\",\"rating\":9.0},\n  {\"id\":755805,\"suggestedTranslation\":\"Tôi còn ít muốn cái này hơn cả thức ăn bình thường nữa.\",\"rating\":9.0},\n  {\"id\":755806,\"suggestedTranslation\":\"Những chiếc xương từ dưới biển sâu, trông giống là thế!\",\"rating\":9.5},\n  {\"id\":755807,\"suggestedTranslation\":\"Tung tăng tà tà, một cái cây đang cháy!\",\"rating\":9.0},\n  {\"id\":755808,\"suggestedTranslation\":\"Chà, thế thì vui phết.\",\"rating\":9.0},\n  {\"id\":755809,\"suggestedTranslation\":\"Một trò chơi khăm cây cối vui nhộn.\",\"rating\":9.0},\n  {\"id\":755810,\"suggestedTranslation\":\"Cây cối kỳ lạ với lớp vỏ như giấy.\",\"rating\":9.0},\n  {\"id\":755811,\"suggestedTranslation\":\"Nó không còn bị ràng buộc với mặt đất nữa rồi!\",\"rating\":9.0},\n  {\"id\":755812,\"suggestedTranslation\":\"Đợi đã, ai xáo trộn bộ bài này thế?\",\"rating\":9.0},\n  {\"id\":755813,\"suggestedTranslation\":\"Thật là vô dụng một cách tuyệt vời!\",\"rating\":9.0},\n  {\"id\":755814,\"suggestedTranslation\":\"Chẳng có gì được đặt trong chiếc bình cả.\",\"rating\":9.0},\n  {\"id\":755815,\"suggestedTranslation\":\"Ánh sáng sáng đến mức tôi có thể nhìn thấy vào ban đêm!\",\"rating\":9.0},\n  {\"id\":755816,\"suggestedTranslation\":\"Không gian trong bình được lấp đầy bởi những bông hoa.\",\"rating\":9.0},\n  {\"id\":755817,\"suggestedTranslation\":\"Tôi sẽ cố không bĩu môi khi ánh sáng đó sớm tắt đi.\",\"rating\":9.0},\n  {\"id\":755818,\"suggestedTranslation\":\"Bông hoa nhỏ trên bàn... trông bạn có vẻ không vững vàng cho lắm.\",\"rating\":9.5},\n  {\"id\":755819,\"suggestedTranslation\":\"Ánh sáng của chiếc đèn nhỏ này thật là thú vị.\",\"rating\":9.0},\n  {\"id\":755820,\"suggestedTranslation\":\"Một tác phẩm nghệ thuật phiên bản giới hạn!\",\"rating\":9.0},\n  {\"id\":755821,\"suggestedTranslation\":\"Thật là tiếc, chỉ là một khung trống mà thôi.\",\"rating\":9.5},\n  {\"id\":755822,\"suggestedTranslation\":\"Một bức chân dung hoàn hảo.\",\"rating\":9.0},\n  {\"id\":755823,\"suggestedTranslation\":\"Chà, chiếc sừng của bạn đáng yêu làm sao!\",\"rating\":9.0},\n  {\"id\":755824,\"suggestedTranslation\":\"Chào nhé, người thân yêu!\",\"rating\":9.0},\n  {\"id\":755825,\"suggestedTranslation\":\"To lớn thế, thô lỗ thế, lại còn hống hách thế!\",\"rating\":9.0},\n  {\"id\":755826,\"suggestedTranslation\":\"Tôi vẫn luôn khao khát mùi hương cháy khét.\",\"rating\":9.0},\n  {\"id\":755827,\"suggestedTranslation\":\"Lão Một Mắt đã lăn đùng ra chết rồi!\",\"rating\":9.0},\n  {\"id\":755828,\"suggestedTranslation\":\"Được hoàn tiền á? Tôi thực sự bất ngờ đấy.\",\"rating\":9.0},\n  {\"id\":755829,\"suggestedTranslation\":\"Con mắt nhìn thấy gì thì sẽ đóng băng cái đó! Hyuyu!\",\"rating\":9.0},\n  {\"id\":755830,\"suggestedTranslation\":\"Nó làm ngơ mất rồi!\",\"rating\":9.0},\n  {\"id\":755831,\"suggestedTranslation\":\"Tôi sẽ dán mắt vào phần thưởng của mình, hyuyu!\",\"rating\":9.0},\n  {\"id\":755832,\"suggestedTranslation\":\"Xin lỗi nhé, ngài thân mến.\",\"rating\":9.0},\n  {\"id\":755833,\"suggestedTranslation\":\"Tôi thích của tôi hơn.\",\"rating\":9.0},\n  {\"id\":755834,\"suggestedTranslation\":\"Trông hợp với bạn phết đấy!\",\"rating\":9.0},\n  {\"id\":755835,\"suggestedTranslation\":\"Nó đã biến đi mất một lúc rồi.\",\"rating\":9.0},\n  {\"id\":755836,\"suggestedTranslation\":\"Tôi rất ghét việc có cát dính vào lớp lông mặt của mình.\",\"rating\":9.0},\n  {\"id\":755837,\"suggestedTranslation\":\"Đừng khóc! Nó sẽ khô ngay thôi!\",\"rating\":9.0},\n  {\"id\":755838,\"suggestedTranslation\":\"Một nhà vô địch thực thụ chống lại độ ẩm!\",\"rating\":9.0},\n  {\"id\":755839,\"suggestedTranslation\":\"Đó là một kẻ chuyên tạo trò chơi khăm.\",\"rating\":9.0},\n  {\"id\":755840,\"suggestedTranslation\":\"Ôi chao ôi!\",\"rating\":9.0},\n  {\"id\":755841,\"suggestedTranslation\":\"Tôi có thể cào móng vuốt của mình vào đó.\",\"rating\":9.0},\n  {\"id\":755842,\"suggestedTranslation\":\"Manh mối đã lạnh ngắt, tôi cảm thấy như bị lừa phỉnh.\",\"rating\":9.0},\n  {\"id\":755843,\"suggestedTranslation\":\"Nó sẽ dẫn đường cho tôi đến nơi tôi muốn đến.\",\"rating\":9.0},\n  {\"id\":755844,\"suggestedTranslation\":\"Nóng bỏng tay! Chúng ta đang ở gần chỗ đó rồi!\",\"rating\":9.0},\n  {\"id\":755845,\"suggestedTranslation\":\"Nào nào nào! Chúng ta đang trên đường tới rồi!\",\"rating\":9.0},\n  {\"id\":755846,\"suggestedTranslation\":\"Tôi phải khoe chút, chúng ta sắp đến gần rồi!\",\"rating\":9.0},\n  {\"id\":755847,\"suggestedTranslation\":\"Thật là tò mò quá đi mất!\",\"rating\":9.0},\n  {\"id\":755848,\"suggestedTranslation\":\"Hãy nhảy cẫng lên và rời khỏi đây nào!\",\"rating\":9.0},\n  {\"id\":755849,\"suggestedTranslation\":\"Ooo, lông tôi đang dựng cả lên vì mong đợi đây này!\",\"rating\":9.0},\n  {\"id\":755850,\"suggestedTranslation\":\"Và giờ thì một trò chơi hồi hộp bắt đầu!\",\"rating\":9.0},\n  {\"id\":755851,\"suggestedTranslation\":\"Trông có vẻ tôi có một đống việc phải làm đây.\",\"rating\":9.0},\n  {\"id\":755852,\"suggestedTranslation\":\"Tôi sẽ sửa nó trong khâu hậu kỳ, hyuyu!\",\"rating\":9.5},\n  {\"id\":755853,\"suggestedTranslation\":\"Ôi thật là một niềm vui búp bê! Hyuyu!\",\"rating\":9.0},\n  {\"id\":755854,\"suggestedTranslation\":\"Nên đặt chiếc thuyền ván này nổi ở đâu nhỉ?\",\"rating\":9.5},\n  {\"id\":755855,\"suggestedTranslation\":\"Một chiếc thuyền ván được trang bị đầy đủ, sẵn sàng ra khơi!\",\"rating\":9.5},\n  {\"id\":755856,\"suggestedTranslation\":\"Hãy chơi trò yêu tinh ở giữa đi nào!\",\"rating\":9.0},\n  {\"id\":755857,\"suggestedTranslation\":\"Warly tốn khối thời gian cho mấy thứ này.\",\"rating\":9.0},\n  {\"id\":755858,\"suggestedTranslation\":\"Hãy sợ ta đi! Ta là một con yêu tinh đáng sợ đấy!\",\"rating\":9.0},\n  {\"id\":755859,\"suggestedTranslation\":\"Chiếc rương gây ấn tượng.\",\"rating\":9.5},\n  {\"id\":755860,\"suggestedTranslation\":\"Kho chứa được mở rộng, hyuyu!\",\"rating\":9.0},\n  {\"id\":755861,\"suggestedTranslation\":\"Một chiếc lồng để kiềm chế cơn thịnh nộ của loài rồng.\",\"rating\":9.0},\n  {\"id\":755862,\"suggestedTranslation\":\"Nó đã mất đi vẻ quyến rũ dưới nhát búa.\",\"rating\":9.5},\n  {\"id\":755863,\"suggestedTranslation\":\"Nó cháy sáng rực rỡ cả ngày lẫn đêm.\",\"rating\":9.0},\n  {\"id\":755864,\"suggestedTranslation\":\"Tôi cho rằng nó cháy với mức độ vừa phải.\",\"rating\":9.0},\n  {\"id\":755865,\"suggestedTranslation\":\"Hái tươi từ rồng ra đấy. Hyuyu!\",\"rating\":9.0},\n  {\"id\":755866,\"suggestedTranslation\":\"Nó đã được nấu chín bằng lửa rồng.\",\"rating\":9.0},\n  {\"id\":755867,\"suggestedTranslation\":\"Một quả khổng lồ, lại còn được tặng kèm đồ của rồng nữa chứ!\",\"rating\":9.0},\n  {\"id\":755868,\"suggestedTranslation\":\"Trồng một hạt giống, bạn sẽ có cái để ăn!\",\"rating\":9.0},\n  {\"id\":755869,\"suggestedTranslation\":\"Tôi và cái sừng của tôi phải là kẻ dẫn đầu!\",\"rating\":9.0},\n  {\"id\":755870,\"suggestedTranslation\":\"Chứa đầy thịt rồng chính hiệu.\",\"rating\":9.0},\n  {\"id\":755871,\"suggestedTranslation\":\"Đặt cái đuôi của tôi ở tận cùng cái đuôi!\",\"rating\":9.0},\n  {\"id\":755872,\"suggestedTranslation\":\"Tôi thích lông hơn là vẩy.\",\"rating\":9.5},\n  {\"id\":755873,\"suggestedTranslation\":\"Một hòn đá đen nhánh như màn đêm.\",\"rating\":9.0},\n  {\"id\":755874,\"suggestedTranslation\":\"Một pháo đài đá cho bộ não của tôi.\",\"rating\":9.0},\n  {\"id\":755875,\"suggestedTranslation\":\"Ai mà biết nó mọc lên từ đâu cơ chứ?\",\"rating\":9.0},\n  {\"id\":755876,\"suggestedTranslation\":\"Chẳng có gì ngoài một khúc gỗ.\",\"rating\":9.5},\n  {\"id\":755877,\"suggestedTranslation\":\"Cháy, cháy, cháy rụi cả rồi.\",\"rating\":9.0},\n  {\"id\":755878,\"suggestedTranslation\":\"Biết bao củi lửa, nay đã thành tro tàn.\",\"rating\":9.0},\n  {\"id\":755879,\"suggestedTranslation\":\"Nó không còn nữa rồi.\",\"rating\":9.0},\n  {\"id\":755880,\"suggestedTranslation\":\"Một cái cây già chết khô, dạt vào bờ và bị bạc màu.\",\"rating\":9.0},\n  {\"id\":755881,\"suggestedTranslation\":\"Tùng tùng cheng!\",\"rating\":9.0},\n  {\"id\":755882,\"suggestedTranslation\":\"Nó đã được nấu chín rồi.\",\"rating\":9.0},\n  {\"id\":755883,\"suggestedTranslation\":\"Hyuyu, bụi cây nhỏ ơi, cậu đang vẫy tay chào tôi đấy à?\",\"rating\":9.0},\n  {\"id\":755884,\"suggestedTranslation\":\"Một bụi cây ở ngoài đất thì giống như cá cạn nước vậy.\",\"rating\":9.5},\n  {\"id\":755885,\"suggestedTranslation\":\"Một bụi cây ở ngoài đất thì giống như cá cạn nước vậy.\",\"rating\":9.5},\n  {\"id\":755886,\"suggestedTranslation\":\"Đặt nó lại xuống đất đi, trước khi nó bị tổn thương!\",\"rating\":9.0},\n  {\"id\":755887,\"suggestedTranslation\":\"Đặt nó lại xuống đất đi, trước khi nó bị tổn thương!\",\"rating\":9.0},\n  {\"id\":755888,\"suggestedTranslation\":\"Thật buồn cười, một loài thực vật bắt chước khỉ!\",\"rating\":9.5},\n  {\"id\":755889,\"suggestedTranslation\":\"Đặt nó lại xuống đất đi, trước khi nó bị tổn thương!\",\"rating\":9.0},\n  {\"id\":755890,\"suggestedTranslation\":\"Trồng thứ này xuống chắc sẽ là một trò hề ác độc đây.\",\"rating\":9.0},\n  {\"id\":755891,\"suggestedTranslation\":\"Nó chẳng ngốc nghếch chút nào, cũng chẳng phải cái chuông. Phàm trần thật kỳ lạ.\",\"rating\":9.0},\n  {\"id\":755892,\"suggestedTranslation\":\"Nó sẽ đánh ngất các cậu ngay lập tức đấy, hyuyuyu!\",\"rating\":9.0},\n  {\"id\":755893,\"suggestedTranslation\":\"Hắn đã biến những viên ngọc quý đó thành tạ tập thể hình rồi, hyuyu!\",\"rating\":9.0},\n  {\"id\":755894,\"suggestedTranslation\":\"Nó chẳng ngốc nghếch chút nào, cũng chẳng phải cái chuông. Phàm trần thật kỳ lạ.\",\"rating\":9.0},\n  {\"id\":755895,\"suggestedTranslati