  {\n    \"id\": 749338,\n    \"suggestedTranslation\": \"Xin lỗi! Tôi không có nhìn trộm đâu, thề đấy!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 749339,\n    \"suggestedTranslation\": \"Hắn không phải là vua của TÔI.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 749340,\n    \"suggestedTranslation\": \"Hết làm heo được rồi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 749341,\n    \"suggestedTranslation\": \"Chúng ta là một đội! Hây da!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 749342,\n    \"suggestedTranslation\": \"Thịt heo biết đi kìa!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 749343,\n    \"suggestedTranslation\": \"Tên đó trông có vẻ không đùa đâu.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 749344,\n    \"suggestedTranslation\": \"Chuyện này xảy ra với cả những người giỏi nhất mà.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 749345,\n    \"suggestedTranslation\": \"Bị cháy rồi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 749346,\n    \"suggestedTranslation\": \"Tôi nghĩ nó cần thịt đấy, Lucy.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 749347,\n    \"suggestedTranslation\": \"Cậu nhìn kìa.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 749348,\n    \"suggestedTranslation\": \"Thịt xông khói có đuôi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 749349,\n    \"suggestedTranslation\": \"Trông có vẻ là một loại lều nào đó.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 749350,\n    \"suggestedTranslation\": \"Làm sao chúng làm được thế mà không có ngón tay cái nhỉ?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 749351,\n    \"suggestedTranslation\": \"Một ân huệ tôi có thể đòi lại vào lúc khác.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 749352,\n    \"suggestedTranslation\": \"Trông giống mấy thứ mà đám heo đó hay làm.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 749353,\n    \"suggestedTranslation\": \"Tôi nên trồng nó rồi chặt đi mới được!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 749354,\n    \"suggest