            "text": "[\n  {\"id\":755145,\"suggestedTranslation\":\"Món ăn ngoằn ngoèo, nhung nhúc, tanh mùi cá.\",\"rating\":9.0},\n  {\"id\":755146,\"suggestedTranslation\":\"Ngươi chỉ cần nói cho ta biết điều ngươi muốn.\",\"rating\":9.0},\n  {\"id\":755147,\"suggestedTranslation\":\"Thứ lỗi nhé, quái thú thân yêu! Ta chỉ là một con sâu thôi mà!\",\"rating\":9.0},\n  {\"id\":755148,\"suggestedTranslation\":\"Ngươi không vui sao, bạn tôi ơi?\",\"rating\":9.0},\n  {\"id\":755149,\"suggestedTranslation\":\"Chắc tôi đang nói xạo nếu bảo mình không nôn nóng thử đâu, hyuyu!\",\"rating\":9.0},\n  {\"id\":755150,\"suggestedTranslation\":\"Chắc phải chuẩn bị cái xô thôi!\",\"rating\":9.0},\n  {\"id\":755151,\"suggestedTranslation\":\"Thông điệp rõ mười mươi, nó không muốn ta ở đây.\",\"rating\":9.0},\n  {\"id\":755152,\"suggestedTranslation\":\"Một cái vỏ trống rỗng, không linh hồn.\",\"rating\":9.0},\n  {\"id\":755153,\"suggestedTranslation\":\"Ta không hiểu cách nấu đồ ăn của phàm nhân cho lắm.\",\"rating\":9.0},\n  {\"id\":755154,\"suggestedTranslation\":\"Sẽ tốn kha khá thời gian đấy.\",\"rating\":9.0},\n  {\"id\":755155,\"suggestedTranslation\":\"Ta đang run lên vì háo hức đây!\",\"rating\":9.0},\n  {\"id\":755156,\"suggestedTranslation\":\"Có vẻ món ngon của ta đã sẵn sàng để thưởng thức!\",\"rating\":9.0},\n  {\"id\":755157,\"suggestedTranslation\":\"Ta nghĩ thứ đang nấu đã nguội ngắt rồi.\",\"rating\":9.0},\n  {\"id\":755158,\"suggestedTranslation\":\"Ồ hố! Quả là một câu đố hóc búa!\",\"rating\":9.0},\n  {\"id\":755159,\"suggestedTranslation\":\"Ngươi có bí mật nào cho ta không?\",\"rating\":9.0},\n  {\"id\":755160,\"suggestedTranslation\":\"Thật đáng tiếc, mấy cái máy này làm gì có linh hồn nào để thu thập chứ.\",\"rating\":9.0},\n  {\"id\":755161,\"suggestedTranslation\":\"Chà, trông nặng đấy chứ.\",\"rating\":9.0},\n  {\"id\":755162,\"suggestedTranslation\":\"Cái sàn này được xây dựng chắc chắn phết, hyuyu!\",\"rating\":9.0},\n  {\"id\":755163,\"suggestedTranslation\":\"Chà chà, hẳn là có kẻ không muốn cánh cửa này được mở ra.\",\"rating\":9.0},\n  {\"id\":755164,\"suggestedTranslation\":\"Ta sẽ không nói cho phàm nhân biết nó ở đây đâu, chỉ thêm tốn công hy vọng thôi.\",\"rating\":9.0},\n  {\"id\":755165,\"suggestedTranslation\":\"Có thứ gì đó đang được cất giấu mà nó vẫn đang tìm kiếm.\",\"rating\":9.0},\n  {\"id\":755166,\"suggestedTranslation\":\"Chúng ta đã xong việc, chẳng còn nơi nào để dẫn lối.\",\"rating\":9.0},\n  {\"id\":755167,\"suggestedTranslation\":\"Đúng là một cỗ máy kỳ lạ!\",\"rating\":9.0},\n  {\"id\":755168,\"suggestedTranslation\":\"Ồ, cái gì thế này? Đọc giải trí chút chơi nào?\",\"rating\":9.0},\n  {\"id\":755169,\"suggestedTranslation\":\"Có vẻ như thuở trước họ từng mê mẩn vầng trăng dễ thay đổi của chúng ta lắm.\",\"rating\":9.0},\n  {\"id\":755170,\"suggestedTranslation\":\"Giờ thì cái này chẳng có mấy ý nghĩa. Trừ khi...\",\"rating\":9.0},\n  {\"id\":755171,\"suggestedTranslation\":\"Ôi chao! Chà chà chà!\",\"rating\":9.0},\n  {\"id\":755172,\"suggestedTranslation\":\"Hyuyu, ta không nên làm mất sự bất ngờ đâu!\",\"rating\":9.0},\n  {\"id\":755173,\"suggestedTranslation\":\"Ước gì vui thế nhỉ! Một cái bẫy!\",\"rating\":9.0},\n  {\"id\":755174,\"suggestedTranslation\":\"Giờ thì ngươi là cái gì, và ngươi đã làm những gì?\",\"rating\":9.0},\n  {\"id\":755175,\"suggestedTranslation\":\"Một vị tiên đồng loại đến để chỉ đường cho ta ư? Ta nghĩ là không đâu, hyuyu!\",\"rating\":9.0},\n  {\"id\":755176,\"suggestedTranslation\":\"Nó đang thèm thứ gì đó lấp lánh kìa.\",\"rating\":9.0},\n  {\"id\":755177,\"suggestedTranslation\":\"Nó đang ôm chặt lấy kho báu đó kìa.\",\"rating\":9.0},\n  {\"id\":755178,\"suggestedTranslation\":\"Ooo, từ lâu ta đã muốn có vảy rồi đấy.\",\"rating\":9.0},\n  {\"id\":755179,\"suggestedTranslation\":\"Mọi đòn đánh đều sẽ bị chặn lại bởi bộ giáp đá tảng này.\",\"rating\":9.0},\n  {\"id\":755180,\"suggestedTranslation\":\"Bảo vệ bản thân chỉ bằng một cái phẩy tay và một điều ước!\",\"rating\":9.0},\n  {\"id\":755181,\"suggestedTranslation\":\"Lạnh như đá!\",\"rating\":9.0},\n  {\"id\":755182,\"suggestedTranslation\":\"Món thulite này đúng là tuyệt cú mèo!\",\"rating\":9.0},\n  {\"id\":755183,\"suggestedTranslation\":\"Kiểu thời trang này đang cực hot... lồng ngực đặt ở bên ngoài đấy!\",\"rating\":9.0},\n  {\"id\":755184,\"suggestedTranslation\":\"Nếu điều đó có nghĩa là ta ít phải ăn lại, thì tính ta vào nhé!\",\"rating\":9.0},\n  {\"id\":755185,\"suggestedTranslation\":\"Mấy mảnh Sên Rùa nhỏ, đúng vậy.\",\"rating\":9.0},\n  {\"id\":755186,\"suggestedTranslation\":\"Đừng có liếc nhìn đồ đạc của ta.\",\"rating\":9.0},\n  {\"id\":755187,\"suggestedTranslation\":\"Trộm vía gỗ, người ta hay bảo thế đấy!\",\"rating\":9.0},\n  {\"id\":755188,\"suggestedTranslation\":\"Ai muốn ôm một con tiểu yêu không nào? Hyuyu!\",\"rating\":9.0},\n  {\"id\":755189,\"suggestedTranslation\":\"Cà rốt? Mặc lên người!\",\"rating\":9.0},\n  {\"id\":755190,\"suggestedTranslation\":\"Vừa khỏe vừa nhẹ, dùng trong giao tranh khá ổn đấy.\",\"rating\":9.0},\n  {\"id\":755191,\"suggestedTranslation\":\"Lớp bảo vệ bằng thực vật gai góc, hoàn hảo!\",\"rating\":9.0},\n  {\"id\":755192,\"suggestedTranslation\":\"Giúp bảo vệ thể xác! Còn tâm trí thì là chuyện khác.\",\"rating\":9.0},\n  {\"id\":755193,\"suggestedTranslation\":\"Nó đã phá vỡ xiềng xích của mặt phẳng trước đó.\",\"rating\":9.0},\n  {\"id\":755194,\"suggestedTranslation\":\"Dự báo trước hiểm họa? Lại thêm giáp ngựa kìa!\",\"rating\":9.0},\n  {\"id\":755195,\"suggestedTranslation\":\"Đúng là một trò đùa ngớ ngẩn.\",\"rating\":9.0},\n  {\"id\":755196,\"suggestedTranslation\":\"Đi hướng nào thực ra cũng chẳng quan trọng lắm!\",\"rating\":9.0},\n  {\"id\":755197,\"suggestedTranslation\":\"E rằng ở đây chẳng có gì để ngắm cả.\",\"rating\":9.0},\n  {\"id\":755198,\"suggestedTranslation\":\"Đúng là một trò đùa ngớ ngẩn.\",\"rating\":9.0},\n  {\"id\":755199,\"suggestedTranslation\":\"Đi hướng nào thực ra cũng chẳng quan trọng lắm!\",\"rating\":9.0},\n  {\"id\":755200,\"suggestedTranslation\":\"E rằng ở đây chẳng có gì để ngắm cả.\",\"rating\":9.0},\n  {\"id\":755201,\"suggestedTranslation\":\"Tro tàn, tro tàn, toàn tro tàn.\",\"rating\":9.0},\n  {\"id\":755202,\"suggestedTranslation\":\"Cú nhảy không gian đã phá hủy cái xương này rồi!\",\"rating\":9.0},\n  {\"id\":755203,\"suggestedTranslation\":\"Cú nhảy không gian đã phá hủy bông hoa này rồi!\",\"rating\":9.0},\n  {\"id\":755204,\"suggestedTranslation\":\"Nó không thể tồn tại trên mặt phẳng này được.\",\"rating\":9.0},\n  {\"id\":755205,\"suggestedTranslation\":\"Chắc là một ngọn giáo đấy. Hyuyu!\",\"rating\":9.0},\n  {\"id\":755206,\"suggestedTranslation\":\"Ngay cả với đồ ăn của con người, món này cũng kỳ quặc thật.\",\"rating\":9.0},\n  {\"id\":755207,\"suggestedTranslation\":\"Thôi, ta xin miễn.\",\"rating\":9.0},\n  {\"id\":755208,\"suggestedTranslation\":\"Ta không dùng đâu, cảm ơn nhé.\",\"rating\":9.0},\n  {\"id\":755209,\"suggestedTranslation\":\"Những hạt giống nhỏ kỳ lạ thật đấy.\",\"rating\":9.0},\n  {\"id\":755210,\"suggestedTranslation\":\"Ồ, chúng ta sắp có khối niềm vui đây!\",\"rating\":9.0},\n  {\"id\":755211,\"suggestedTranslation\":\"Hết giờ chơi rồi.\",\"rating\":9.0},\n  {\"id\":755212,\"suggestedTranslation\":\"Hyuyu, mọi thứ bắt đầu lạ lẫm rồi đấy!\",\"rating\":9.0},\n  {\"id\":755213,\"suggestedTranslation\":\"Thứ mà ta đã nhảy qua đấy!\",\"rating\":9.0},\n  {\"id\":755214,\"suggestedTranslation\":\"Đó là cách ngươi triệu hồi tiểu yêu đấy. Hyuyu!\",\"rating\":9.0},\n  {\"id\":755215,\"suggestedTranslation\":\"Một tiểu yêu có thể làm mấy trò nghịch ngợm với thứ này đấy.\",\"rating\":9.0},\n  {\"id\":755216,\"suggestedTranslation\":\"Ta không chắc phải chơi đùa với nó thế nào đây.\",\"rating\":9.0},\n  {\"id\":755217,\"suggestedTranslation\":\"Ooo, nó bật lên rồi kìa!\",\"rating\":9.0},\n  {\"id\":755218,\"suggestedTranslation\":\"Ooo, có chút ma thuật nghịch ngợm nào đang hoạt động ở đây này!\",\"rating\":9.0},\n  {\"id\":755219,\"suggestedTranslation\":\"Một đám phàm nhân. Trông họ chán chường làm sao.\",\"rating\":9.0},\n  {\"id\":755220,\"suggestedTranslation\":\"Có ít tàn dư ma thuật trên đá. Chẳng còn gì khác.\",\"rating\":9.0},\n  {\"id\":755221,\"suggestedTranslation\":\"Ooo, chuẩn bị hay ho rồi đây!\",\"rating\":9.0},\n  {\"id\":755222,\"suggestedTranslation\":\"Thật là hài hước! Lũ phàm nhân đang lột xác kìa!\",\"rating\":9.0},\n  {\"id\":755223,\"suggestedTranslation\":\"Chắc họ không nên dùng nhiều ma thuật đến thế đâu.\",\"rating\":9.0},\n  {\"id\":755224,\"suggestedTranslation\":\"Hyuyu, ngươi thua một ván cược à?\",\"rating\":9.0},\n  {\"id\":755225,\"suggestedTranslation\":\"Để quật và để chặt.\",\"rating\":9.0},\n  {\"id\":755226,\"suggestedTranslation\":\"Nó phải ở bên mẹ nó chứ.\",\"rating\":9.0},\n  {\"id\":755227,\"suggestedTranslation\":\"Ngủ ngon nhé linh hồn bé nhỏ.\",\"rating\":9.0},\n  {\"id\":755228,\"suggestedTranslation\":\"Hãy nhìn gánh nặng trên lưng ta đây!\",\"rating\":9.0},\n  {\"id\":755229,\"suggestedTranslation\":\"Món khoái khẩu của phàm nhân.\",\"rating\":9.0},\n  {\"id\":755230,\"suggestedTranslation\":\"Này chú hề, làm vài ván poker đi!\",\"rating\":9.0},\n  {\"id\":755231,\"suggestedTranslation\":\"Ta cứ có cảm giác mình sắp bay đi mất. Hyuyu!\",\"rating\":9.0},\n  {\"id\":755232,\"suggestedTranslation\":\"Đeo cái này chắc ta bị chóng mặt mất thôi, hyuyuyu!\",\"rating\":9.0},\n  {\"id\":755233,\"suggestedTranslation\":\"Một buổi tiệc! Ta có được mời không nhỉ?\",\"rating\":9.0},\n  {\"id\":755234,\"suggestedTranslation\":\"Phép thuật của nó đã cạn kiệt.\",\"rating\":9.0},\n  {\"id\":755235,\"suggestedTranslation\":\"Với gói quà này, ta sẽ nhanh nhẹn hơn!\",\"rating\":9.0},\n  {\"id\":755236,\"suggestedTranslation\":\"Dùng để lưu trữ hơi thở cho những bùa chú sau này.\",\"rating\":9.0},\n  {\"id\":755237,\"suggestedTranslation\":\"Một chiếc áo vest bong bóng rực rỡ để mặc trước ngực.\",\"rating\":9.0},\n  {\"id\":755238,\"suggestedTranslation\":\"Hyuyu, bụi cây nhỏ ơi, ngươi đang vẫy tay chào ta à?\",\"rating\":9.0},\n  {\"id\":755239,\"suggestedTranslation\":\"Phàm nhân có thể ăn chuối ở bất kỳ hình dạng nào.\",\"rating\":9.0},\n  {\"id\":755240,\"suggestedTranslation\":\"Hyuyu, phàm nhân sẽ còn nghĩ ra cái gì tiếp theo đây?\",\"rating\":9.0},\n  {\"id\":755241,\"suggestedTranslation\":\"Miếng băng quấn vết thương.\",\"rating\":9.0},\n  {\"id\":755242,\"suggestedTranslation\":\"Ai nhỉ? Ai bị thương à?\",\"rating\":9.0},\n  {\"id\":755243,\"suggestedTranslation\":\"Một chùm hà biển mặn mòi.\",\"rating\":9.0},\n  {\"id\":755244,\"suggestedTranslation\":\"Trừ khi chiếc túi này chứa đầy linh hồn, còn không thì ta xin nhường.\",\"rating\":9.0},\n  {\"id\":755245,\"suggestedTranslation\":\"Hyuyu, ngậm miệng khi đang ăn đi chứ!\",\"rating\":9.0},\n  {\"id\":755246,\"suggestedTranslation\":\"Có lẽ một trong số các phàm nhân sẽ thích nó đấy.\",\"rating\":9.0},\n  {\"id\":755247,\"suggestedTranslation\":\"Thôi, ta xin miễn.\",\"rating\":9.0},\n  {\"id\":755248,\"suggestedTranslation\":\"Mấy sợi mì tanh mùi cá.\",\"rating\":9.0},\n  {\"id\":755249,\"suggestedTranslation\":\"Hòn đá bự chảng, chắc chắn luôn.\",\"rating\":9.0},\n  {\"id\":755250,\"suggestedTranslation\":\"Bản thân ta cũng điên rồ chẳng kém! Hyuyu!\",\"rating\":9.0},\n  {\"id\":755251,\"suggestedTranslation\":\"Điên rồ hơn nữa!\",\"rating\":9.0},\n  {\"id\":755252,\"suggestedTranslation\":\"Nơi đám dơi đang ẩn nấp chờ thời.\",\"rating\":9.0},\n  {\"id\":755253,\"suggestedTranslation\":\"Thơm ngọt ngào, bom dùng để tắm đây.\",\"rating\":9.0},\n  {\"id\":755254,\"suggestedTranslation\":\"Ôi trời, trông như ai đó vừa thổi phồng nó lên vậy.\",\"rating\":9.0},\n  {\"id\":755255,\"suggestedTranslation\":\"Lũ phàm nhân sắp nấu món gì tiếp đây không biết.\",\"rating\":9.0},\n  {\"id\":755256,\"suggestedTranslation\":\"Mùi khó chịu quá! Ta nghĩ nó hỏng mất rồi!\",\"rating\":9.0},\n  {\"id\":755257,\"suggestedTranslation\":\"Người ta bảo ta cũng