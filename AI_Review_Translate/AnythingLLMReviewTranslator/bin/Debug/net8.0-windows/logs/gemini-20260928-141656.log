  \"id\": 755091,\n    \"suggestedTranslation\": \"Linh hồn đáng thương.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 755092,\n    \"suggestedTranslation\": \"Linh hồn đáng thương.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 755093,\n    \"suggestedTranslation\": \"Ta nghĩ nó cũng ăn cả linh hồn đấy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755094,\n    \"suggestedTranslation\": \"Ố kìa, ngươi cũng đói bụng nữa hả.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755095,\n    \"suggestedTranslation\": \"Đáng tiếc là nó không thuộc quyền sở hữu của ta.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755096,\n    \"suggestedTranslation\": \"Không cần phải trốn ta đâu... dù trông ngươi có vẻ ngon miệng thật đấy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755097,\n    \"suggestedTranslation\": \"Dưới đó thế nào rồi?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755098,\n    \"suggestedTranslation\": \"Chà, trông ngươi có vẻ đầy sức sống đấy! Hyuyu!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755099,\n    \"suggestedTranslation\": \"Trông thật đáng buồn. Chứa đầy những tiếc nuối.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755100,\n    \"suggestedTranslation\": \"Tỉnh dậy rồi chứ hả?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755101,\n    \"suggestedTranslation\": \"Có vẻ như cuộc vui sắp bắt đầu rồi đây.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755102,\n    \"suggestedTranslation\": \"Ít ra nó còn biết chờ đến lượt, nhưng quy luật nào để nhận ra đây?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755103,\n    \"suggestedTranslation\": \"Dạo này thế nào rồi, hỡi bức tượng?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755104,\n    \"suggestedTranslation\": \"Một chiếc cần gạt thật khéo léo!\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 755105,\n    \"suggestedTranslation\": \"Ta làm được thật này!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755106,\n    \"suggestedTranslation\": \"Nó thật điên rồ, y như ta vậy!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755107,\n    \"suggestedTranslation\": \"Bất đắc dĩ lắm thì ta mới ăn nó.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755108,\n    \"suggestedTranslation\": \"Ngươi biết cách lớn lên đấy!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755109,\n    \"suggestedTranslation\": \"Ta muốn chơi một ván với ngươi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755110,\n    \"suggestedTranslation\": \"Nó thì thầm với ta những bí mật vô cùng hấp dẫn, hyuyu!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755111,\n    \"suggestedTranslation\": \"Chắc cũng không khó để tìm cách dùng mảnh vỡ này đâu.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755112,\n    \"suggestedTranslation\": \"Ô hố! Xem ra hắn vẫn còn vài chiêu thủ sẵn trong tay áo đấy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755113,\n    \"suggestedTranslation\": \"Gửi lời hỏi thăm của ta tới chủ nhân của ngươi nhé!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755114,\n    \"suggestedTranslation\": \"Chúng ta khởi đầu có hơi trắc trở nhỉ? Hyuyu!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755115,\n    \"suggestedTranslation\": \"Cái gì đang mọc lên thế? Sao lại phát sáng vậy?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755116,\n    \"suggestedTranslation\": \"Chúng ta đã đánh bại nó, và tóm được nó rồi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755117,\n    \"suggestedTranslation\": \"Mong là giờ nó đã lăn đùng ra chết.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755118,\n    \"suggestedTranslation\": \"Hoohoo! Có vẻ vẫn còn nhiều điều thú vị phía trước!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755119,\n    \"suggestedTranslation\": \"Tiểu yêu này không dễ bị giam cầm thế đâu.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755120,\n    \"suggestedTranslation\": \"Đã đến lúc chấm dứt cuộc chiến này rồi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755121,\n    \"suggestedTranslation\": \"Cùng xem thứ gì được để lại nào?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755122,\n    \"suggestedTranslation\": \"Năng lượng thì có, nhưng chẳng có linh hồn nào để ăn vặt cả. Thật đáng tiếc.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 755123,\n    \"suggestedTranslation\": \"Hoohoo, tiểu yêu này thừa biết thủ đoạn khi nhìn thấy chúng.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755124,\n    \"suggestedTranslation\": \"Ngươi đúng là một thảm họa quái dị!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755125,\n    \"suggestedTranslation\": \"Một viên ngọc lấp lánh tràn đầy sức sống.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755126,\n    \"suggestedTranslation\": \"Thả nó xuống để dừng lại.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755127,\n    \"suggestedTranslation\": \"Nhiều thứ hay ho trên tàu phết mà ta có thể chế tạo đấy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755128,\n    \"suggestedTranslation\": \"Đừng có ăn tươi, nung lên thì hơn!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755129,\n    \"suggestedTranslation\": \"Chỉ một miếng là giúp ta nhìn rõ trong đêm.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755130,\n    \"suggestedTranslation\": \"Ta nhớ cảm giác ngọ nguậy đó ghê, làm ta cứ khúc khích mãi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755131,\n    \"suggestedTranslation\": \"Lò luyện hình cây đang cháy hừng hực kìa.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755132,\n    \"suggestedTranslation\": \"Từng là một cái cây, giờ thành đống đổ nát.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755133,\n    \"suggestedTranslation\": \"Cây cối mà mọc lông thì có gì đáng sợ đâu chứ?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755134,\n    \"suggestedTranslation\": \"Cuộc đời xanh tươi của nó đã bị cắt đứt ngắn ngủi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755135,\n    \"suggestedTranslation\": \"Không sướt mướt đâu, ta thấy vui vì nó hạnh phúc.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755136,\n    \"suggestedTranslation\": \"Giờ sao nữa? Ồ, không phải lúc này.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755137,\n    \"suggestedTranslation\": \"Không phải vị trí ưa thích của loài thực vật khó tính này sao?\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 755138,\n    \"suggestedTranslation\": \"Cây cối gì mà khó chiều thật đấy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755139,\n    \"suggestedTranslation\": \"Ta thấy một hạt giống để gieo trồng rồi, hyuyu!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755140,\n    \"suggestedTranslation\": \"Một nơi tuyệt vời để làm dăm ba phép thuật nghịch ngợm.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755141,\n    \"suggestedTranslation\": \"Ôi trời ơi trời, thế này thì không ổn rồi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755142,\n    \"suggestedTranslation\": \"Ôi chao, chúng đã chết như thế nào vậy kìa!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755143,\n    \"suggestedTranslation\": \"Hyuyu, trông ma quái làm sao!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 755144,\n    \"suggestedTranslation\": \"Đó không phải dấu chân của ta!\",\n    \"rating\": 9.0\n  }\n]",
