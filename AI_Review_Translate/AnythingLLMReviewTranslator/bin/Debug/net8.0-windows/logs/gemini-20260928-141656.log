n  {\"id\":755277,\"suggestedTranslation\":\"Hôm nay ngươi đừng hòng ăn được ta!\",\"rating\":9.0},\n  {\"id\":755278,\"suggestedTranslation\":\"May mắn nhỉ? Chắc nó được làm từ vàng tiên tộc rồi.\",\"rating\":9.0},\n  {\"id\":755279,\"suggestedTranslation\":\"Lông chồng lên lông!\",\"rating\":9.0},\n  {\"id\":755280,\"suggestedTranslation\":\"Để gối đầu chiếc đầu nhỏ xinh của ta xuống nào.\",\"rating\":9.0},\n  {\"id\":755281,\"suggestedTranslation\":\"Vo ve vo ve, chú ong nhỏ!\",\"rating\":9.0},\n  {\"id\":755282,\"suggestedTranslation\":\"Cẩn thận nhé, phàm nhân nhỏ bé.\",\"rating\":9.0},\n  {\"id\":755283,\"suggestedTranslation\":\"Biết đâu bên trong đã được tẩm đường rồi thì sao!\",\"rating\":9.0},\n  {\"id\":755284,\"suggestedTranslation\":\"Nhiều mật ong quá! Lũ phàm nhân sẽ sung sướng phát cuồng cho xem!\",\"rating\":9.0},\n  {\"id\":755285,\"suggestedTranslation\":\"Một hộp đầy ong chắc sẽ là một trò chơi khăm tuyệt vời đấy.\",\"rating\":9.0},\n  {\"id\":755286,\"suggestedTranslation\":\"Chẳng có gì bên trong ngoài ong cả, ôi tuyệt!\",\"rating\":9.0},\n  {\"id\":755287,\"suggestedTranslation\":\"Nhiều mật ong quá! Lũ phàm nhân sẽ sung sướng phát cuồng cho xem!\",\"rating\":9.0},\n  {\"id\":755288,\"suggestedTranslation\":\"Chúng ta có thể cạo ra một ít mật ong đấy.\",\"rating\":9.0},\n  {\"id\":755289,\"suggestedTranslation\":\"Biết đâu bên trong đã được tẩm đường rồi thì sao!\",\"rating\":9.0},\n  {\"id\":755290,\"suggestedTranslation\":\"Nhiều mật ong quá! Kẻ phàm nhân cáu kỉnh kia chắc sẽ nhe răng cười mất!\",\"rating\":9.0},\n  {\"id\":755291,\"suggestedTranslation\":\"Cả tổ ong đang náo nhiệt hẳn lên!\",\"rating\":9.0},\n  {\"id\":755292,\"suggestedTranslation\":\"Chẳng có gì bên trong ngoài ong cả, ôi tuyệt!\",\"rating\":9.0},\n  {\"id\":755293,\"suggestedTranslation\":\"Nhiều mật ong quá! Kẻ phàm nhân cáu kỉnh kia chắc sẽ nhe răng cười mất!\",\"rating\":9.0},\n  {\"id\":755294,\"suggestedTranslation\":\"Chúng ta có thể cạo ra một ít mật ong đấy.\",\"rating\":9.0},\n  {\"id\":755295,\"suggestedTranslation\":\"Phương tiện di chuyển của ai đó đãmẹo đời rồi.\",\"rating\":9.0},\n  {\"id\":755296,\"suggestedTranslation\":\"Nói ta nghe đây không phải sự thật đi, người anh em bò lai ơi!\",\"rating\":9.0},\n  {\"id\":755297,\"suggestedTranslation\":\"Ta tin là chúng ta đã kết bạn rồi đấy!\",\"rating\":9.0},\n  {\"id\":755298,\"suggestedTranslation\":\"Hyuyu! Chúng ta đang chơi trò đuổi bắt à?\",\"rating\":9.0},\n  {\"id\":755299,\"suggestedTranslation\":\"Xin chào, xin chào, chú bò lai thân mến!\",\"rating\":9.0},\n  {\"id\":755300,\"suggestedTranslation\":\"Chúng ta là những tâm hồn đồng điệu, ngươi thấy thế không?\",\"rating\":9.0},\n  {\"id\":755301,\"suggestedTranslation\":\"Hyuyuyu! Vui phết nhờ!\",\"rating\":9.0},\n  {\"id\":755302,\"suggestedTranslation\":\"Ngươi không thấy bực bội đến phát điên lên à?\",\"rating\":9.0},\n  {\"id\":755303,\"suggestedTranslation\":\"Linh hồn của nó cũng mũm mĩm luôn, hyuyu!\",\"rating\":9.0},\n  {\"id\":755304,\"suggestedTranslation\":\"Ngươi không muốn cõng ta đi à?\",\"rating\":9.0},\n  {\"id\":755305,\"suggestedTranslation\":\"Suỵt.\",\"rating\":9.0},\n  {\"id\":755306,\"suggestedTranslation\":\"Món này rất béo bở đấy, hyuyu!\",\"rating\":9.0},\n  {\"id\":755307,\"suggestedTranslation\":\"Cặp sừng thay thế.\",\"rating\":9.0},\n  {\"id\":755308,\"suggestedTranslation\":\"Một chú bò đáng yêu xứng đáng được thưởng quà.\",\"rating\":9.0},\n  {\"id\":755309,\"suggestedTranslation\":\"Bò lai cũ.\",\"rating\":9.0},\n  {\"id\":755310,\"suggestedTranslation\":\"Hyuyuyu ngớ ngẩn làm sao!\",\"rating\":9.0},\n  {\"id\":755311,\"suggestedTranslation\":\"Ta sẽ chải chuốt bộ lông bò lai với phong cách đặc trưng của mình.\",\"rating\":9.0},\n  {\"id\":755312,\"suggestedTranslation\":\"Muốn làm đẹp chút không nào? Hyuyu!\",\"rating\":9.0},\n  {\"id\":755313,\"suggestedTranslation\":\"Cùng chuẩn bị làm điệu cho bộ lông bò lai nào!\",\"rating\":9.0},\n  {\"id\":755314,\"suggestedTranslation\":\"Đúng là một phép thuật kỳ lạ!\",\"rating\":9.0},\n  {\"id\":755315,\"suggestedTranslation\":\"Nhẹ nhàng với ta thôi nhé!\",\"rating\":9.0},\n  {\"id\":755316,\"suggestedTranslation\":\"Nhỡ cặp sừng của ta bị đốt thì sao?\",\"rating\":9.0},\n  {\"id\":755317,\"suggestedTranslation\":\"Chỉ một cú đá mạnh là thành trò đùa hay ngay.\",\"rating\":9.0},\n  {\"id\":755318,\"suggestedTranslation\":\"Đây sẽ là một trò chơi khăm buồn cười đây.\",\"rating\":9.0},\n  {\"id\":755319,\"suggestedTranslation\":\"Đó hoàn toàn không phải trò đùa buồn cười đâu nhé!\",\"rating\":9.0},\n  {\"id\":755320,\"suggestedTranslation\":\"Twiheehe! Ngươi là một con ong bự đấy!\",\"rating\":9.0},\n  {\"id\":755321,\"suggestedTranslation\":\"Móng guốc của ta sẽ bị dính chặt vào đó mất.\",\"rating\":9.0},\n  {\"id\":755322,\"suggestedTranslation\":\"Ooo, một điều bí ẩn mới!\",\"rating\":9.0},\n  {\"id\":755323,\"suggestedTranslation\":\"Sự bí ẩn ngày càng lớn!\",\"rating\":9.0},\n  {\"id\":755324,\"suggestedTranslation\":\"Không phải của ta!\",\"rating\":9.0},\n  {\"id\":755325,\"suggestedTranslation\":\"Một hương thơm đáng sợ để đóng băng thực vật!\",\"rating\":9.0},\n  {\"id\":755326,\"suggestedTranslation\":\"Ôi chao, ngươi là một anh chàng to lớn đấy!\",\"rating\":9.0},\n  {\"id\":755327,\"suggestedTranslation\":\"Ta tin là nó sẽ mang lại niềm vui đấy.\",\"rating\":9.0},\n  {\"id\":755328,\"suggestedTranslation\":\"Ngài ơi, ngài có biết là mình không có linh hồn không vậy?\",\"rating\":9.0},\n  {\"id\":755329,\"suggestedTranslation\":\"Nó đã lớn lên để giành chiến thắng trong mọi trận chiến!\",\"rating\":9.0},\n  {\"id\":755330,\"suggestedTranslation\":\"Cậu ta từng là một chàng trai tốt.\",\"rating\":9.0},\n  {\"id\":755331,\"suggestedTranslation\":\"Thật đáng tiếc.\",\"rating\":9.0},\n  {\"id\":755332,\"suggestedTranslation\":\"Một nắm món ngon của phàm nhân.\",\"rating\":9.0},\n  {\"id\":755333,\"suggestedTranslation\":\"Nghe nói làm thế này sẽ để được lâu hơn.\",\"rating\":9.0},\n  {\"id\":7