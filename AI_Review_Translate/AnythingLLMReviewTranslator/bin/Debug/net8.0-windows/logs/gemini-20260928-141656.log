            "text": "[\n  {\n    \"id\": 750529,\n    \"suggestedTranslation\": \"Tốt nhất là hắn đừng có bảo mình tập chống đẩy...\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750530,\n    \"suggestedTranslation\": \"Ai đó phải dạy cho con khỉ đó cách cư xử mới được.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750531,\n    \"suggestedTranslation\": \"Con khỉ đó đang đùa với lửa đấy!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 750532,\n    \"suggestedTranslation\": \"Này Lucy, con khỉ đó trông quen quen phải không?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750533,\n    \"suggestedTranslation\": \"Ngày tồi tệ hả, nhóc?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750534,\n    \"suggestedTranslation\": \"Con tinh tinh đó tiêu đời rồi!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750535,\n    \"suggestedTranslation\": \"Có một trái tim nhân hậu ẩn dưới lớp lông kia, tao biết mà.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750536,\n    \"suggestedTranslation\": \"Đẹp tuyệt! Lucy lại tự phá kỷ lục của mình rồi!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750537,\n    \"suggestedTranslation\": \"%s không phải là một người Canada thực thụ...\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750538,\n    \"suggestedTranslation\": \"Quen quá rồi, bạn tôi ơi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750539,\n    \"suggestedTranslation\": \"Cậu sẽ đau đầu nhức óc sau vụ này đấy, bạn hiền.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750540,\n    \"suggestedTranslation\": \"Mấy đám lửa đó giờ phản tác dụng rồi phải không, hả?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750541,\n    \"suggestedTranslation\": \"%s! Thật bất ngờ khi gặp một người Canada ở đây.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750542,\n    \"suggestedTranslation\": \"Người Canada phải đoàn kết với nhau chứ, %s. Đi tìm trái tim thôi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750543,\n    \"suggestedTranslation\": \"Quả là loài mãnh thú hung dữ nhất Canada.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750544,\n    \"suggestedTranslation\": \"Phù... Ý tôi là, đi tìm trái tim cho cậu thôi nào, hả?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750545,\n    \"suggestedTranslation\": \"Trời ạ, trông tôi thế này thật á?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750546,\n    \"suggestedTranslation\": \"Bình tĩnh nào bạn hiền, chúng ta sẽ giúp cậu ổn thỏa.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750547,\n    \"suggestedTranslation\": \"Này, lại đây nào %s! Tôi phải RIU bạn một câu hỏi đấy!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750548,\n    \"suggestedTranslation\": \"%s là một người yêu nước Canada chính hiệu đấy.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750549,\n    \"suggestedTranslation\": \"Thật là đáng buồn...\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750550,\n    \"suggestedTranslation\": \"Nhìn tay nghề mộc đỉnh cao kìa!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750551,\n    \"suggestedTranslation\": \"Họ đang nghỉ xả hơi đấy à?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750552,\n    \"suggestedTranslation\": \"Tiếc ghê nhỉ?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750553,\n    \"suggestedTranslation\": \"Vân gỗ đẹp đấy chứ?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750554,\n    \"suggestedTranslation\": \"Này, cậu đang che khuất phần gỗ tuyệt đẹp đó kìa!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750555,\n    \"suggestedTranslation\": \"Hãy cảnh giác với mặt đất đang di chuyển.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750556,\n    \"suggestedTranslation\": \"Nhìn thực vật là tôi biết ngay. Đây là hàng giả mạo!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 750557,\n    \"suggestedTranslation\": \"SÂUÂÂU!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750558,\n    \"suggestedTranslation\": \"Trông giống cái mông thế nhỉ!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750559,\n    \"suggestedTranslation\": \"Tôi không chắc là mình muốn nhìn vào đó đâu, hả?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750560,\n    \"suggestedTranslation\": \"Ngửi có vẻ hơi lạ nhỉ?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750561,\n    \"suggestedTranslation\": \"Thứ này sẽ hữu ích đấy.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750562,\n    \"suggestedTranslation\": \"Nhăn nheo hơn cả phần bụng dưới của con hải ly.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750563,\n    \"suggestedTranslation\": \"Chỉ là một loài thực vật bình thường thôi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 750564,\n    \"suggestedTranslation\": \"Sao cậu không để việc chiến đấu cho các chuyên gia?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750565,\n    \"suggestedTranslation\": \"Tôi cứ tưởng cậu là người phải ngăn chặn cháy rừng chứ.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750566,\n    \"suggestedTranslation\": \"%s, chào cậu bạn nhỏ nhé!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750567,\n    \"suggestedTranslation\": \"Thôi nào, đi trồng lại cậu vào đất nhé.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750568,\n    \"suggestedTranslation\": \"Tôi sẽ đeo viên ngọc đó như một chiếc trâm cài áo, nghe chưa!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750569,\n    \"suggestedTranslation\": \"Cậu là một cây nhỏ tốt bụng đấy, %s.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 750570,\n    \"suggestedTranslation\": \"Nó chết rồi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750571,\n    \"suggestedTranslation\": \"Con cà rốt này là một con chuột!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 750572,\n    \"suggestedTranslation\": \"Tóm được cậu rồi nhé.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750573,\n    \"suggestedTranslation\": \"Ồ. Nó đang ngủ kìa.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750574,\n    \"suggestedTranslation\": \"Chỉ là một sinh vật nhỏ bé đáng yêu.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750575,\n    \"suggestedTranslation\": \"Từ trước đến nay cậu vẫn sặc sỡ thế à?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750576,\n    \"suggestedTranslation\": \"Tôi sẽ để nó nghỉ ngơi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750577,\n    \"suggestedTranslation\": \"Cứ tiếp tục soi đường cho tôi thì chúng ta sẽ hợp tác rất tốt đấy, bạn hiền!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750578,\n    \"suggestedTranslation\": \"Chúng ta hạ gục nó được đấy, Lucy!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750579,\n    \"suggestedTranslation\": \"Tin tôi đi, cậu không có cửa đâu, %s.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750580,\n    \"suggestedTranslation\": \"Tốt nhất là cậu đừng có đốt bất kỳ cái cây quý giá nào của tôi!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750581,\n    \"suggestedTranslation\": \"%s, bạn hiền, chào nhé!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750582,\n    \"suggestedTranslation\": \"Kẻ hút linh hồn đó giờ trông như một cục nhựa cây thực thụ vậy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 750583,\n    \"suggestedTranslation\": \"Tôi sẽ treo mấy cái sừng đó lên tường nhà gỗ của mình!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750584,\n    \"suggestedTranslation\": \"Cậu thật là tốt bụng đấy, %s.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750585,\n    \"suggestedTranslation\": \"Trông có vẻ khá tiện dụng.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750586,\n    \"suggestedTranslation\": \"Thứ đó có thể hữu ích khi cần thiết đấy.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750587,\n    \"suggestedTranslation\": \"Mỗi người một sở thích.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750588,\n    \"suggestedTranslation\": \"Úi! Từ từ đã nào, bạn hiền!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750589,\n    \"suggestedTranslation\": \"Này! Cậu nghĩ mình đang làm cái gì thế hả?\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750590,\n    \"suggestedTranslation\": \"%s! Chào mầm non nhỏ bé nhé!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750591,\n    \"suggestedTranslation\": \"Chúng ta sẽ giúp cậu khỏe khoắn trở lại ngay thôi.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750592,\n    \"suggestedTranslation\": \"Đủ lắm rồi đấy, tôi sẽ cho cậu nếm mùi rìu của tôi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 750593,\n    \"suggestedTranslation\": \"Hơi cộc cằn một chút, nhưng cậu được đấy %s!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750594,\n    \"suggestedTranslation\": \"Nó làm tôi thấy lo lắng.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750595,\n    \"suggestedTranslation\": \"Tôi không tin tưởng nó đâu.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750596,\n    \"suggestedTranslation\": \"%s đang tự chuốc họa vào thân rồi đấy...\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750597,\n    \"suggestedTranslation\": \"Cậu sắp làm cháy lớp vỏ của mình rồi đấy, %s.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750598,\n    \"suggestedTranslation\": \"Đó là người bạn bằng kim loại của tôi, %s!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750599,\n    \"suggestedTranslation\": \"Ồ, hóa ra %s cũng có linh hồn đấy chứ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 750600,\n    \"suggestedTranslation\": \"Đã đến lúc tắt nguồn rồi đấy, %s!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750601,\n    \"suggestedTranslation\": \"%s, cậu cũng được phết đấy.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750602,\n    \"suggestedTranslation\": \"Mấy món đồ điện tử tinh xảo.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750603,\n    \"suggestedTranslation\": \"Mấy món đồ điện tử tinh xảo.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750604,\n    \"suggestedTranslation\": \"Mấy món đồ điện tử tinh xảo.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750605,\n    \"suggestedTranslation\": \"Mấy món đồ điện tử tinh xảo.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 750606,\n    \"suggestedTranslation\": \"Mấy món đồ điện tử tinh xảo.\",\n    \"rating\": 8.5\n  },\n  {\n    \"