            "text": "[\n  {\"id\":750223,\"suggestedTranslation\":\"Nó dọn dẹp sạch sẽ ghê nhỉ.\",\"rating\":9.0},\n  {\"id\":750224,\"suggestedTranslation\":\"Một gã thợ sửa đá to xác.\",\"rating\":9.0},\n  {\"id\":750225,\"suggestedTranslation\":\"Cần phải gia cố thêm đấy, Luce.\",\"rating\":9.0},\n  {\"id\":750226,\"suggestedTranslation\":\"Chúng ta nên đặt nó ở đâu đây, Luce?\",\"rating\":9.0},\n  {\"id\":750227,\"suggestedTranslation\":\"Tớ mừng là nó thân thiện đấy.\",\"rating\":9.0},\n  {\"id\":750228,\"suggestedTranslation\":\"Không đâu, Luce. Tớ không nghĩ cậu làm được đâu.\",\"rating\":9.0},\n  {\"id\":750229,\"suggestedTranslation\":\"Nó cần chút năng lượng nào đó, Luce.\",\"rating\":9.0},\n  {\"id\":750230,\"suggestedTranslation\":\"Chắc là linh kiện cho gã thợ sửa đá đó rồi.\",\"rating\":9.0},\n  {\"id\":750231,\"suggestedTranslation\":\"Tớ chắc chắn đó không phải máy cưa bàn đâu.\",\"rating\":9.0},\n  {\"id\":750232,\"suggestedTranslation\":\"Chắc là tớ đang đọc ngược chúng rồi.\",\"rating\":9.0},\n  {\"id\":750233,\"suggestedTranslation\":\"Trời ạ, hắn thối rữa đến tận xương tủy rồi.\",\"rating\":9.0},\n  {\"id\":750234,\"suggestedTranslation\":\"Ai đó... hoặc thứ gì đó đã giở trò với lũ chúng.\",\"rating\":9.0},\n  {\"id\":750235,\"suggestedTranslation\":\"Tuyệt thật. Lũ mối khổng lồ có vũ trang.\",\"rating\":9.0},\n  {\"id\":750236,\"suggestedTranslation\":\"Trông có vẻ hỏng nặng rồi.\",\"rating\":9.0},\n  {\"id\":750237,\"suggestedTranslation\":\"Cái này có vẻ hơi kỳ cục đấy, Luce.\",\"rating\":9.0},\n  {\"id\":750238,\"suggestedTranslation\":\"Tớ không nghĩ nó được bật lên đâu.\",\"rating\":9.0},\n  {\"id\":750239,\"suggestedTranslation\":\"Nó hỏng rồi.\",\"rating\":9.0},\n  {\"id\":750240,\"suggestedTranslation\":\"Đó là một ngọn đèn dầu lớn.\",\"rating\":9.0},\n  {\"id\":750241,\"suggestedTranslation\":\"Rau á? Chúng ta hết thịt xông khói và khoai tây rồi à?\",\"rating\":9.0},\n  {\"id\":750242,\"suggestedTranslation\":\"Thứ duy nhất nó dùng được là làm phân trộn.\",\"rating\":9.0},\n  {\"id\":750243,\"suggestedTranslation\":\"Hự! Cay quá!\",\"rating\":9.0},\n  {\"id\":750244,\"suggestedTranslation\":\"Khá là sang chảnh nhỉ?\",\"rating\":9.0},\n  {\"id\":750245,\"suggestedTranslation\":\"Không phải vải nỉ, nhưng tớ xài tạm được.\",\"rating\":9.0},\n  {\"id\":750246,\"suggestedTranslation\":\"Một chiếc mũ trùm tối màu, đầy những bí mật.\",\"rating\":9.0},\n  {\"id\":750247,\"suggestedTranslation\":\"Ném nó vào thứ gì đó xem nào.\",\"rating\":9.0},\n  {\"id\":750248,\"suggestedTranslation\":\"Chỗ đó chắc đủ để vá víu lại rồi nhỉ?\",\"rating\":9.0},\n  {\"id\":750249,\"suggestedTranslation\":\"Luce bảo cô ấy không thích hắn ta.\",\"rating\":9.0},\n  {\"id\":750250,\"suggestedTranslation\":\"Miễn là nó dùng được, tớ không phàn nàn về vẻ ngoài của nó đâu.\",\"rating\":9.0},\n  {\"id\":750251,\"suggestedTranslation\":\"Tớ không nhớ lần cuối mình ăn tráng miệng là khi nào nữa.\",\"rating\":9.0},\n  {\"id\":750252,\"suggestedTranslation\":\"Tớ thích bánh kếp hơn.\",\"rating\":9.0},\n  {\"id\":750253,\"suggestedTranslation\":\"Ồ, Luce. Tớ không nghĩ nó chặt được cây đâu.\",\"rating\":9.0},\n  {\"id\":750254,\"suggestedTranslation\":\"Trông có vẻ ra dáng hơn rồi đấy.\",\"rating\":9.0},\n  {\"id\":750255,\"suggestedTranslation\":\"Làm sao mà ngần ấy thứ lại nhét vừa vào đây nhỉ?\",\"rating\":9.0},\n  {\"id\":750256,\"suggestedTranslation\":\"Đây là những bộ phận dùng để sát hại à?\",\"rating\":9.0},\n  {\"id\":750257,\"suggestedTranslation\":\"Không, cậu không chặt đôi nó được đâu, Lucy. Nó quá cứng ngay cả với cậu đấy.\",\"rating\":9.0},\n  {\"id\":750258,\"suggestedTranslation\":\"Này, thôi ngay cái trò định giết tụi này đi!\",\"rating\":9.0},\n  {\"id\":750259,\"suggestedTranslation\":\"Cậu có tò mò như tớ không, Luce?\",\"rating\":9.0},\n  {\"id\":750260,\"suggestedTranslation\":\"Không, tụi mình không thể làm cabin từ những bức tường này được đâu, Lucy.\",\"rating\":9.0},\n  {\"id\":750261,\"suggestedTranslation\":\"Hay là chúng ta tháo linh kiện từ con này luôn đi.\",\"rating\":9.0},\n  {\"id\":750262,\"suggestedTranslation\":\"Chúng ở khắp nơi quanh ta kìa, Lucy!\",\"rating\":9.0},\n  {\"id\":750263,\"suggestedTranslation\":\"Không, cậu không đập nát nó được đâu, Lucy.\",\"rating\":9.0},\n  {\"id\":750264,\"suggestedTranslation\":\"Mấy thứ đó sẽ có ích đấy.\",\"rating\":9.0},\n  {\"id\":750265,\"suggestedTranslation\":\"Chúng ta có thể sửa nó hoặc cứ lấy phụ tùng thay thế.\",\"rating\":9.0},\n  {\"id\":750266,\"suggestedTranslation\":\"Hãy canh chừng nó nhé, Luce.\",\"rating\":9.0},\n  {\"id\":750267,\"suggestedTranslation\":\"Chúng lại lết quay lại kìa!\",\"rating\":9.0},\n  {\"id\":750268,\"suggestedTranslation\":\"Không, cậu không đập nát nó được đâu, Lucy.\",\"rating\":9.0},\n  {\"id\":750269,\"suggestedTranslation\":\"Một thợ máy cơ khí à? Tiếp theo họ sẽ nghĩ ra cái gì đây.\",\"rating\":9.0},\n  {\"id\":750270,\"suggestedTranslation\":\"Trông giống như một cái mũ vành kiểu thợ máy công nghệ nào đó.\",\"rating\":9.0},\n  {\"id\":750271,\"suggestedTranslation\":\"Vài mẩu kim loại kỳ lạ.\",\"rating\":9.0},\n  {\"id\":750272,\"suggestedTranslation\":\"Chuyện gì đã xảy ra với những cột rào gỗ kiểu cũ tốt lành thế nhỉ?\",\"rating\":9.0},\n  {\"id\":750273,\"suggestedTranslation\":\"Tớ thích sàn gỗ hơn.\",\"rating\":9.0},\n  {\"id\":750274,\"suggestedTranslation\":\"Cần gạt / đòn bẩy đấy, Lucy. Tớ bảo đây là một chiếc Cần Gạt / đòn bẩy tuyệt vời mà. Trùi ui.\",\"rating\":9.0},\n  {\"id\":750275,\"suggestedTranslation\":\"Đó là một cái bàn làm việc xịn sò đấy.\",\"rating\":9.0},\n  {\"id\":750276,\"suggestedTranslation\":\"Ừ, Luce. Găng tay này thật như cậu với tớ vậy.\",\"rating\":9.0},\n  {\"id\":750277,\"suggestedTranslation\":\"Đó thực sự là một chiếc bảng kẹp giấy bằng da thịt đấy.\",\"rating\":9.0},\n  {\"id\":750278,\"suggestedTranslation\":\"Này! Ai đó đã xả rác vào cảnh quan thiên nhiên kìa!\",\"rating\":9.0},\n  {\"id\":750279,\"suggestedTranslation\":\"Tớ chẳng hiểu đầu đuôi ra sao cả, nhưng có vẻ quan trọng đấy.\",\"rating\":9.0},\n  {\"id\":750280,\"suggestedTranslation\":\"Trông có vẻ cậu đang làm việc gì quan trọng đấy. Hay để tớ một tay nhé?\",\"rating\":9.0},\n  {\"id\":750281,\"suggestedTranslation\":\"Nghe có vẻ ông ấy đang cần sự giúp đỡ của chúng ta đấy nhỉ?\",\"rating\":9.0},\n  {\"id\":750282,\"suggestedTranslation\":\"Ông lão đó đang chạy đi đâu thế nhỉ?\",\"rating\":9.0},\n  {\"id\":750283,\"suggestedTranslation\":\"Tớ nên mang trả nó cho ông lão đó thì hơn.\",\"rating\":9.0},\n  {\"id\":750284,\"suggestedTranslation\":\"Không rõ nó là gì lắm, nhưng cứ mang cho ông lão đó phòng hờ vậy.\",\"rating\":9.0},\n  {\"id\":750285,\"suggestedTranslation\":\"Này Luce, cái đó trông có giống cái-thứ-mà-ông-ấy-nói không?\",\"rating\":9.0},\n  {\"id\":750286,\"suggestedTranslation\":\"Mang đi xem đây có phải thứ ông lão đó đang tìm không cũng chẳng mất gì.\",\"rating\":9.0},\n  {\"id\":750287,\"suggestedTranslation\":\"Đó có lẽ đúng là thứ tớ đang tìm!\",\"rating\":9.0},\n  {\"id\":750288,\"suggestedTranslation\":\"Mong là chúng ta không phải bỏ tàu.\",\"rating\":9.0},\n  {\"id\":750289,\"suggestedTranslation\":\"Mong là chúng ta không phải bỏ tàu.\",\"rating\":9.0},\n  {\"id\":750290,\"suggestedTranslation\":\"Mong là chúng ta không phải bỏ tàu.\",\"rating\":9.0},\n  {\"id\":750291,\"suggestedTranslation\":\"Cậu có trang trí thế nào thì tớ vẫn không muốn dùng nó đâu.\",\"rating\":9.0},\n  {\"id\":750292,\"suggestedTranslation\":\"Một con chim á? Vui tính thật đấy, Luce.\",\"rating\":9.0},\n  {\"id\":750293,\"suggestedTranslation\":\"Không thoải mái cho lắm nhỉ?\",\"rating\":9.0},\n  {\"id\":750294,\"suggestedTranslation\":\"Tớ thà xây tường bằng gỗ xẻ còn hơn.\",\"rating\":9.0},\n  {\"id\":750295,\"suggestedTranslation\":\"Ờ thì, chuyện đó leo thang nhanh phết.\",\"rating\":9.0},\n  {\"id\":750296,\"suggestedTranslation\":\"Cậu hắt xì một cái là sập ngay.\",\"rating\":9.0},\n  {\"id\":750297,\"suggestedTranslation\":\"Tớ hắt xì một cái là văng tung tóe ngay.\",\"rating\":9.0},\n  {\"id\":750298,\"suggestedTranslation\":\"Trông đẹp và chắc chắn phết.\",\"rating\":9.0},\n  {\"id\":750299,\"suggestedTranslation\":\"Để thế thì chẳng có tích sự gì mấy.\",\"rating\":9.0},\n  {\"id\":750300,\"suggestedTranslation\":\"Đang lởm chởm nhưng vẫn vững chãi nhỉ?\",\"rating\":9.0},\n  {\"id\":750301,\"suggestedTranslation\":\"Đang lởm chởm nhưng vẫn vững chãi nhỉ?\",\"rating\":9.0},\n  {\"id\":750302,\"suggestedTranslation\":\"Hè hè, lại hóa đá nữa rồi à?\",\"rating\":9.0},\n  {\"id\":750303,\"suggestedTranslation\":\"Tường mà cũng có mùi à?\",\"rating\":9.0},\n  {\"id\":750304,\"suggestedTranslation\":\"Tường mà cũng có mùi à?\",\"rating\":9.0},\n  {\"id\":750305,\"suggestedTranslation\":\"An toàn và chắc chắn nhỉ?\",\"rating\":9.0},\n  {\"id\":750306,\"suggestedTranslation\":\"An toàn và chắc chắn nhỉ?\",\"rating\":9.0},\n  {\"id\":750307,\"suggestedTranslation\":\"An toàn và chắc chắn nhỉ?\",\"rating\":9.0},\n  {\"id\":750308,\"suggestedTranslation\":\"Tớ nhớ cậu của ngày xưa quá.\",\"rating\":9.0},\n  {\"id\":750309,\"suggestedTranslation\":\"Tớ thích diện mạo này đấy!\",\"rating\":9.0},\n  {\"id\":750310,\"suggestedTranslation\":\"Tớ thích diện mạo này đấy!\",\"rating\":9.0},\n  {\"id\":750311,\"suggestedTranslation\":\"Ôi không. Lại là hải mã à!\",\"rating\":9.0},\n  {\"id\":750312,\"suggestedTranslation\":\"Ông tôi từng đội một chiếc mũ như thế đấy.\",\"rating\":9.0},\n  {\"id\":750313,\"suggestedTranslation\":\"Đến mùa đông thì chỗ này không an toàn đâu.\",\"rating\":9.0},\n  {\"id\":750314,\"suggestedTranslation\":\"Lũ hải mã đang ở gần đây phải không?\",\"rating\":9.0},\n  {\"id\":750315,\"suggestedTranslation\":\"Nó bị sâu răng à?\",\"rating\":9.0},\n  {\"id\":750316,\"suggestedTranslation\":\"Hành động đó không lịch sự cho lắm nhỉ?\",\"rating\":9.0},\n  {\"id\":750317,\"suggestedTranslation\":\"Tớ tưởng cậu bảo biết cách nhóm lửa trại cơ mà?\",\"rating\":9.0},\n  {\"id\":750318,\"suggestedTranslation\":\"Này, %s! Thật vui khi gặp được người đồng hương nhé!\",\"rating\":9.0},\n  {\"id\":750319,\"suggestedTranslation\":\"Thôi nào nhóc con, để tớ kiếm cho cậu một trái tim nhé.\",\"rating\":9.0},\n  {\"id\":750320,\"suggestedTranslation\":\"\\\"Xin lỗi\\\" lần này là không ăn thua đâu đấy!\",\"rating\":9.0},\n  {\"id\":750321,\"suggestedTranslation\":\"Cảm ơn vì đã yểm trợ tớ nhé, %s!\",\"rating\":9.0},\n  {\"id\":750322,\"suggestedTranslation\":\"Nhìn kìa, nó có hình một chiếc lá phong nhỏ trên đó đấy!\",\"rating\":9.0},\n  {\"id\":750323,\"suggestedTranslation\":\"Ái chà! Cô ta có cú móc phải mạnh bất ngờ đấy.\",\"rating\":9.0},\n  {\"id\":750324,\"suggestedTranslation\":\"Này, chú ý chỗ lửa cậu đang đốt đấy nhé!\",\"rating\":9.0},\n  {\"id\":750325,\"suggestedTranslation\":\"Đã đến lúc cậu ghé thăm rồi đấy, %s!\",\"rating\":9.0},\n  {\"id\":750326,\"suggestedTranslation\":\"Tớ đang tìm trái tim đây! Chờ tớ một phút nhé, được chứ?\",\"rating\":9.0},\n  {\"id\":750327,\"suggestedTranslation\":\"Lucy và tớ nghĩ đã đến lúc chúng ta phải chặn đứng cậu lại rồi đấy, %s.\",\"rating\":9.0},\n  {\"id\":750328,\"suggestedTranslation\":\"Tớ rất vui vì cậu có mặt ở đây, %s.\",\"rating\":9.0},\n  {\"id\":750329,\"suggestedTranslation\":\"Trông có vẻ không tự nhiên cho lắm.\",\"rating\":9.0},\n  {\"id\":750330,\"suggestedTranslation\":\"Đừng lo, Luce. Tớ không bao giờ đem đổi cậu đâu.\",\"rating\":9.0},\n  {\"id\":750331,\"suggestedTranslation\":\"Gỗ là thứ bén lửa tốt nhất mà.\",\"rating\":9.0},\n  {\"id\":750332,\"suggestedTranslation\":\"Giờ thì hết hữu ích rồi phải không?\",\"rating\":9.0},\n  {\"id\":750333,\"suggestedTranslation\":\"Thật khó để giữ cho gọn gàng và ngăn nắp trong rừng đấy.\",\"rating\":9.0},\n  {\"id\":750334,\"suggestedTranslation\":\"Con vật đó có thể tự mình kéo cả một chiếc xe trượt tuyết đấy.\",\"rating\":9.0},\n  {\"id\":750335,\"suggestedTranslation\":\"Cháy đen thui như một đống puck khúc côn cầu luôn.\",\"rating\":9.0},\n  {\"id\":750336,\"suggestedTranslation\":\"Ai đó đã cho con cún này về chầu trời rồi.\",\"rating\":9.0},\n  {\"id\":750337,\"suggestedTranslation\":\"Không phải lúc nào cũng thấy cảnh này đâu, phải không Luce?\",\"rating\":9.0},\n  {\"id\":750338,\"suggestedTranslation\":\"Tưởng gây sự được với tớ à?\",\"rating\":9.0},\n  {\"id\":750339,\"suggestedTranslation\":\"Cháy trụi rồi.\",\"rating\":9.0},\n  {\"id\":750340,\"suggestedTranslation\":\"Phải sưởi ấm cái chuồng chó này lên thôi nhỉ?\",\"rating\":9.0},\n  {\"id\":750341,\"suggestedTranslation\":\"Ấm áp và dễ chịu phết.\",\"rating\":9.0},\n  {\"id\":750342,\"suggestedTranslation\":\"Cẩn thận cái tay vung vẩy của cậu đấy, %s.\",\"rating\":9.0},\n  {\"id\":750343,\"suggestedTranslation\":\"Cẩn thận đống lửa đó nha, %s.\",\"rating\":9.0},\n  {\"id\":750344,\"suggestedTranslation\":\"%s, bạn hiền! Dạo này sao rồi?\",\"rating\":9.0},\n  {\"id\":750345,\"suggestedTranslation\":\"Ờ thì, đời vốn là thế mà.\",\"rating\":9.0},\n  {\"id\":750346,\"suggestedTranslation\":\"Tớ sẽ nướng sống cậu luôn!\",\"rating\":9.0},\n  {\"id\":750347,\"suggestedTranslation\":\"%s đúng là một người đàn ông đáng tin cậy.\",\"rating\":9.0},\n  {\"id\":750348,\"suggestedTranslation\":\"Trông đáng sợ phết nhỉ Lucy?\",\"rating\":9.0},\n  {\"id\":750349,\"suggestedTranslation\":\"Sao lũ ong đó lại tức giận thế nhỉ?\",\"rating\":9.0},\n  {\"id\":750350,\"suggestedTranslation\":\"Ném mấy thứ này chơi chắc cũng vui đấy.\",\"rating\":9.0},\n  {\"id\":750351,\"suggestedTranslation\":\"Hết nước rồi.\",\"rating\":9.0},\n  {\"id\":750352,\"suggestedTranslation\":\"Chắc phải đến lượt mình đi tưới vườn thôi.\",\"rating\":9.0},\n  {\"id\":750353,\"suggestedTranslation\":\"Làm sao mà vừa là nước vừa là dưa được nhỉ?\",\"rating\":9.0},\n  {\"id\":750354,\"suggestedTranslation\":\"Cũng đáng khen cho sự sáng tạo đấy.\",\"rating\":9.0},\n  {\"id\":750355,\"suggestedTranslation\":\"Vừa là Gỗ VỪA là Thức ăn á?!\",\"rating\":9.0},\n  {\"id\":750356,\"suggestedTranslation\":\"Tớ không chắc lắm về trái cây nướng...\",\"rating\":9.0},\n  {\"id\":750357,\"suggestedTranslation\":\"Đấy mới gọi là quả to chứ!\",\"rating\":9.0},\n  {\"id\":750358,\"suggestedTranslation\":\"Hay là tớ đem chúng đi trồng nhỉ?\",\"rating\":9.0},\n  {\"id\":750359,\"suggestedTranslation\":\"Bông hoa đó cao bằng cây thông luôn!\",\"rating\":9.0},\n  {\"id\":750360,\"suggestedTranslation\":\"Chỉ là một cây con thôi.\",\"rating\":9.0},\n  {\"id\":750361,\"suggestedTranslation\":\"Cậu đang tự chuốc lấy búa rìu đấy nhở!\",\"rating\":9.0},\n  {\"id\":750362,\"suggestedTranslation\":\"Đặt ở đâu để gây ít thiệt hại nhất đây...\",\"rating\":9.0},\n  {\"id\":750363,\"suggestedTranslation\":\"Thật tiếc khi gỗ lại dễ bắt lửa đến thế.\",\"rating\":9.0},\n  {\"id\":750364,\"suggestedTranslation\":\"Nhìn đống cây kìa...\",\"rating\":9.0},\n  {\"id\":750365,\"suggestedTranslation\":\"Vài mẩu cây vương vãi.\",\"rating\":9.0},\n  {\"id\":750366,\"suggestedTranslation\":\"%s lúc nào cũng nghĩ đến chuyện đi cướp bóc...\",\"rating\":9.0},\n  {\"id\":750367,\"suggestedTranslation\":\"Dạo này hay có vụ cháy thế này là sao hả bạn hiền?\",\"rating\":9.0},\n  {\"id\":750368,\"suggestedTranslation\":\"%s! Chào bạn hiền!\",\"rating\":9.0},\n  {\"id\":750369,\"suggestedTranslation\":\"Có trái tim này cậu sẽ lại sung sức như xưa ngay thôi.\",\"rating\":9.0},\n  {\"id\":750370,\"suggestedTranslation\":\"Giáo của cậu đấu với rìu của tớ, xem cậu giỏi đến đâu nào!\",\"rating\":9.0},\n  {\"id\":750371,\"suggestedTranslation\":\"Tớ rất vui vì cậu đứng về phe chúng ta, %s.\",\"rating\":9.0},\n  {\"id\":750372,\"suggestedTranslation\":\"Trông bảnh tỏn phết nhỉ.\",\"rating\":9.0},\n  {\"id\":750373,\"suggestedTranslation\":\"Trừ đôi cánh và cái sừng ra thì nó y hệt một chiếc mũ len.\",\"rating\":9.0},\n  {\"id\":750374,\"suggestedTranslation\":\"Cái đó chịu đòn tốt đấy, phải không Luce?\",\"rating\":9.0},\n  {\"id\":750375,\"suggestedTranslation\":\"Nó sẽ không héo úa, nhưng cũng chẳng lớn lên được đâu.\