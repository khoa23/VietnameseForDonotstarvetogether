anslation\":\"Nếu hỏi ta thì nó cần thêm chút ánh sáng đấy.\",\"rating\":0.0},\n  {\"id\":756087,\"suggestedTranslation\":\"Phép thuật luôn luôn đáp ứng!\",\"rating\":0.0},\n  {\"id\":756088,\"suggestedTranslation\":\"Ngọn lửa thanh tẩy, để điều tồi tệ nhất không xảy ra.\",\"rating\":0.0},\n  {\"id\":756089,\"suggestedTranslation\":\"Ta không nhầm đâu, sinh mệnh của nó đã chấm dứt rồi.\",\"rating\":0.0},\n  {\"id\":756090,\"suggestedTranslation\":\"Nó đang xoay chuyển và quay trở lại.\",\"rating\":0.0},\n  {\"id\":756091,\"suggestedTranslation\":\"Chào buổi tối, mấy đứa trẻ!\",\"rating\":0.0},\n  {\"id\":756092,\"suggestedTranslation\":\"Nó che giấu những thứ bên trong!\",\"rating\":0.0},\n  {\"id\":756093,\"suggestedTranslation\":\"Chẳng có gì đáng chú ý cả.\",\"rating\":0.0},\n  {\"id\":756094,\"suggestedTranslation\":\"Chúng lớn nhanh thật đấy!\",\"rating\":0.0},\n  {\"id\":756095,\"suggestedTranslation\":\"Biết ngay mà, gieo nhân nào gặt quả nấy!\",\"rating\":0.0},\n  {\"id\":756096,\"suggestedTranslation\":\"Một linh hồn chưa có chủ!\",\"rating\":0.0},\n  {\"id\":756097,\"suggestedTranslation\":\"Đúng là một bông hoa ma quái cuốn hút làm sao.\",\"rating\":0.0},\n  {\"id\":756098,\"suggestedTranslation\":\"Những bông hoa ma quái mang lại sức mạnh kỳ lạ.\",\"rating\":0.0},\n  {\"id\":756099,\"suggestedTranslation\":\"Hyuyu! Lại có kẻ đang giở trò khéo léo kìa!\",\"rating\":0.0},\n  {\"id\":756100,\"suggestedTranslation\":\"Hyuyu! Lại có kẻ đang giở trò khéo léo kìa!\",\"rating\":0.0},\n  {\"id\":756101,\"suggestedTranslation\":\"Hyuyu! Lại có kẻ đang giở trò khéo léo kìa!\",\"rating\":0.0},\n  {\"id\":756102,\"suggestedTranslation\":\"Hyuyu! Lại có kẻ đang giở trò khéo léo kìa!\",\"rating\":0.0},\n  {\"id\":756103,\"suggestedTranslation\":\"Hyuyu! Lại có kẻ đang giở trò khéo léo kìa!\",\"rating\":0.0},\n  {\"id\":756104,\"suggestedTranslation\":\"Hyuyu! Lại có kẻ đang giở trò khéo léo kìa!\",\"rating\":0.0},\n  {\"id\":756105,\"suggestedTranslation\":\"Hyuyu! Lại có kẻ đang giở trò khéo léo kìa!\",\"rating\":0.0},\n  {\"id\":756106,\"suggestedTranslation\":\"Hyuyu! Lại có kẻ đang giở trò khéo léo kìa!\",\"rating\":0.0},\n  {\"id\":756107,\"suggestedTranslation\":\"Hyuyu! Lại có kẻ đang giở trò khéo léo kìa!\",\"rating\":0.0},\n  {\"id\":756108,\"suggestedTranslation\":\"Quà kìa! Vui quá đi!\",\"rating\":0.0},\n  {\"id\":756109,\"suggestedTranslation\":\"Thế là xong gói quà!\",\"rating\":0.0},\n  {\"id\":756110,\"suggestedTranslation\":\"Đúng là một ngôi nhà bánh quy dễ thương làm sao.\",\"rating\":0.0},\n  {\"id\":756111,\"suggestedTranslation\":\"Ra đây nào chú heo con!\",\"rating\":0.0},\n  {\"id\":756112,\"suggestedTranslation\":\"Cái bánh quy đó muốn cắm ngập răng vào người ta kìa!\",\"rating\":0.0},\n  {\"id\":756113,\"suggestedTranslation\":\"Một ngọn tháp xinh xắn làm bằng thủy tinh.\",\"rating\":0.0},\n  {\"id\":756114,\"suggestedTranslation\":\"Ồ, chắc chắn ta sẽ có khối niềm vui với cái này. Hyuyu!\",\"rating\":0.0},\n  {\"id\":756115,\"suggestedTranslation\":\"Sắc bén và nhọn hoắt như chiếc răng của ta!\",\"rating\":0.0},\n  {\"id\":756116,\"suggestedTranslation\":\"Những suy nghĩ gì đang ẩn giấu trong cái đầu tò mò đó nhỉ?\",\"rating\":0.0},\n  {\"id\":756117,\"suggestedTranslation\":\"Phải chi ta là một con quỷ ngủ.\",\"rating\":0.0},\n  {\"id\":756118,\"suggestedTranslation\":\"Ôi không, ôi trời ơi!\",\"rating\":0.0},\n  {\"id\":756119,\"suggestedTranslation\":\"Một bông hoa thu hút bạn bè.\",\"rating\":0.0},\n  {\"id\":756120,\"suggestedTranslation\":\"Thứ này buồn cười thật đấy!\",\"rating\":0.0},\n  {\"id\":756121,\"suggestedTranslation\":\"Mới mẻ làm sao!\",\"rating\":0.0},\n  {\"id\":756122,\"suggestedTranslation\":\"Có vẻ tốn quá nhiều công sức cho một thứ để ăn nhỉ.\",\"rating\":0.0},\n  {\"id\":756123,\"suggestedTranslation\":\"Ta chẳng thấy có điểm gì thú vị ở ngươi cả, hyuyu!\",\"rating\":0.0},\n  {\"id\":756124,\"suggestedTranslation\":\"E là ta không có chiếc sừng dự phòng nào đâu.\",\"rating\":0.0},\n  {\"id\":756125,\"suggestedTranslation\":\"Đi nào, ngoài biển có khối trò nghịch ngợm đang chờ đấy!\",\"rating\":0.0},\n  {\"id\":756126,\"suggestedTranslation\":\"Nào nào, cần gì phải làm móp chiếc xuồng của ta chứ.\",\"rating\":0.0},\n  {\"id\":756127,\"suggestedTranslation\":\"Nó nêu lên một quan điểm rất thuyết phục đấy chứ, hyuyu!\",\"rating\":0.0},\n  {\"id\":756128,\"suggestedTranslation\":\"Làm ơn, xin miễn cho.\",\"rating\":0.0},\n  {\"id\":756129,\"suggestedTranslation\":\"Ta phải giữ thể diện chứ.\",\"rating\":0.0},\n  {\"id\":756130,\"suggestedTranslation\":\"Giờ chiếc đàn vĩ cầm vàng của ta đâu rồi nhỉ?\",\"rating\":0.0},\n  {\"id\":756131,\"suggestedTranslation\":\"Lũ phàm nhân bảo rằng phải tiêu vàng thì mới kiếm lại được vàng.\",\"rating\":0.0},\n  {\"id\":756132,\"suggestedTranslation\":\"Đồ nghề hội nhóm sang chảnh đấy. Hyuyu!\",\"rating\":0.0},\n  {\"id\":756133,\"suggestedTranslation\":\"Xa hoa một cách vô tích sự! Hyuyu!\",\"rating\":0.0},\n  {\"id\":756134,\"suggestedTranslation\":\"Thật là phung phí một cách lộng lẫy! Hyuyu!\",\"rating\":0.0},\n  {\"id\":756135,\"suggestedTranslation\":\"Tiền bạc thật vô hồn.\",\"rating\":0.0},\n  {\"id\":756136,\"suggestedTranslation\":\"Chiếc lông này có thể giúp ai đó dũng cảm vượt qua thời tiết nóng nực.\",\"rating\":0.0},\n  {\"id\":756137,\"suggestedTranslation\":\"Đất nhiễm mặn, chẳng có gì mọc lại được đâu.\",\"rating\":0.0},\n  {\"id\":756138,\"suggestedTranslation\":\"Úi chà chà.\",\"rating\":0.0},\n  {\"id\":756139,\"suggestedTranslation\":\"Giờ thì nó thối kinh khủng luôn!\",\"rating\":0.0},\n  {\"id\":756140,\"suggestedTranslation\":\"Nó bắt đầu bốc mùi rồi đấy.\",\"rating\":0.0},\n  {\"id\":756141,\"suggestedTranslation\":\"Cỏ mọc từ vùng đất phì nhiêu nhất.\",\"rating\":0.0},\n  {\"id\":756142,\"suggestedTranslation\":\"Mất sạch, mất sạch rồi.\",\"rating\":0.0},\n  {\"id\":756143,\"suggestedTranslation\":\"Cảm thấy chán nản hả?\",\"rating\":0.0},\n  {\"id\":756144,\"suggestedTranslation\":\"Hẹn gặp lại sau nhé, cá sấu.\",\"rating\":0.0},\n  {\"id\":756145,\"suggestedTranslation\":\"Ta có thể thấy căn bệnh đang len lỏi vào linh hồn ngươi rồi đấy.\",\"rating\":0.0},\n  {\"id\":756146,\"suggestedTranslation\":\"Xin chào bạn hiền! Không cần phải rụng đuôi đâu nhé.\",\"rating\":0.0},\n  {\"id\":756147,\"suggestedTranslation\":\"Một công cụ để che mưa.\",\"rating\":0.0},\n  {\"id\":756148,\"suggestedTranslation\":\"Cái bình di cốt đang khao khát kìa, hyuyu!\",\"rating\":0.0},\n  {\"id\":756149,\"suggestedTranslation\":\"Chỉ là một bóng ma thôi, có gì mà phải sợ.\",\"rating\":0.0},\n  {\"id\":756150,\"suggestedTranslation\":\"Nó nằm trên một chiếc thuyền ván chẳng thể nổi được.\",\"rating\":0.0},\n  {\"id\":756151,\"suggestedTranslation\":\"Để ta có tay nghề hơn khi xây dựng lại.\",\"rating\":0.0},\n  {\"id\":756152,\"suggestedTranslation\":\"Sắc xanh dịu dàng nhặt nhạnh từ những thung lũng tươi tốt.\",\"rating\":0.0},\n  {\"id\":756153,\"suggestedTranslation\":\"Con mắt xanh này đang khao khát được ngắm nhìn!\",\"rating\":0.0},\n  {\"id\":756154,\"suggestedTranslation\":\"Đừng coi nó như đồ chơi. Mục đích của nó là hủy diệt.\",\"rating\":0.0},\n  {\"id\":756155,\"suggestedTranslation\":\"Mấy loại nấm này giở đủ mọi trò mánh khóe.\",\"rating\":0.0},\n  {\"id\":756156,\"suggestedTranslation\":\"Cái đó đã thay đổi phần nào rồi.\",\"rating\":0.0},\n  {\"id\":756157,\"suggestedTranslation\":\"Tìm thấy ngươi rồi!\",\"rating\":0.0},\n  {\"id\":756158,\"suggestedTranslation\":\"Nó đang chơi trốn tìm kìa!\",\"rating\":0.0},\n  {\"id\":756159,\"suggestedTranslation\":\"Mất sạch, mất sạch rồi.\",\"rating\":0.0},\n  {\"id\":756160,\"suggestedTranslation\":\"Có lẽ đây là nhà của một nàng tiên nước.\",\"rating\":0.0},\n  {\"id\":756161,\"suggestedTranslation\":\"Có lẽ đây là nhà của một nàng tiên nước tí xíu.\",\"rating\":0.0},\n  {\"id\":756162,\"suggestedTranslation\":\"Ta không thích ăn uống gì cho lắm, trừ khi bắt buộc.\",\"rating\":0.0},\n  {\"id\":756163,\"suggestedTranslation\":\"Nó thải ra từ một con dơi, và chỉ thế thôi.\",\"rating\":0.0},\n  {\"id\":756164,\"suggestedTranslation\":\"Ta sẽ viết nên số mệnh của ngươi bằng một tiếng NỔ lớn!\",\"rating\":0.0},\n  {\"id\":756165,\"suggestedTranslation\":\"Thứ để ta cắm phập nanh vào!\",\"rating\":0.0},\n  {\"id\":756166,\"suggestedTranslation\":\"Việc gì cũng có lần đầu tiên, người ta bảo vậy đấy.\",\"rating\":0.0},\n  {\"id\":756167,\"suggestedTranslation\":\"Hừm, nó chảy tè le đầy móng vuốt của ta rồi.\",\"rating\":0.0},\n  {\"id\":756168,\"suggestedTranslation\":\"Ghê tởm một cách thú vị!\",\"rating\":0.0},\n  {\"id\":756169,\"suggestedTranslation\":\"Ta sẽ thử gặm một miếng nhỏ, ta sẽ thử, ta sẽ thử.\",\"rating\":0.0},\n  {\"id\":756170,\"suggestedTranslation\":\"Úi hô hô, cay thế nhờ!\",\"rating\":0.0},\n  {\"id\":756171,\"suggestedTranslation\":\"Ta đoán mình có thể ăn một món quà ngon lành đấy.\",\"rating\":0.0},\n  {\"id\":756172,\"suggestedTranslation\":\"Chỉ là ngô của loài người thôi mà.\",\"rating\":0.0},\n  {\"id\":756173,\"suggestedTranslation\":\"Ta có thể bị thuyết phục để nếm thử một chút.\",\"rating\":0.0},\n  {\"id\":756174,\"suggestedTranslation\":\"Fweehee! Mấy chú mèo con kìa!\",\"rating\":0.0},\n  {\"id\":756175,\"suggestedTranslation\":\"Trò chơi khăm này thật là thông minh xuất chúng!\",\"rating\":0.0},\n  {\"id\":756176,\"suggestedTranslation\":\"Hừm... Ta không nghĩ mình sẽ thích món đó đâu.\",\"rating\":0.0},\n  {\"id\":756177,\"suggestedTranslation\":\"Hyuyu, một linh hồn kẹo ngọt!\",\"rating\":0.0},\n  {\"id\":756178,\"suggestedTranslation\":\"Hyuyu, nó trượt tuột tuột xuống tận dưới luôn!\",\"rating\":0.0},\n  {\"id\":756179,\"suggestedTranslation\":\"Thuốc bổ chống nhát gan!\",\"rating\":0.0},\n  {\"id\":756180,\"suggestedTranslation\":\"Hyuyu! Thứ này sẽ mọc lông đầy rương của ngươi cho xem!\",\"rating\":0.0},\n  {\"id\":756181,\"suggestedTranslation\":\"Hiền lành và rụt rè làm sao!\",\"rating\":0.0},\n  {\"id\":756182,\"suggestedTranslation\":\"Nước lửa!\",\"rating\":0.0},\n  {\"id\":756183,\"suggestedTranslation\":\"Một loại thuốc hoán đổi vị trí!\",\"rating\":0.0},\n  {\"id\":756184,\"suggestedTranslation\":\"Nó làm ta thấy thèm ăn đấy, quả thật vậy!\",\"rating\":0.0},\n  {\"id\":756185,\"suggestedTranslation\":\"Hoàn toàn điên rồ!\",\"rating\":0.0},\n  {\"id\":756186,\"suggestedTranslation\":\"Một con vật bò lúc nhúc rợn người cho cái cây.\",\"rating\":0.0},\n  {\"id\":756187,\"suggestedTranslation\":\"Một chiếc xúc tu xoắn tít mù!\",\"rating\":0.0},\n  {\"id\":756188,\"suggestedTranslation\":\"Được làm để treoòng tòng teng trên cây.\",\"rating\":0.0},\n  {\"id\":756189,\"suggestedTranslation\":\"Ta tin chắc là nó ngỏm củ tỏi rồi đấy!\",\"rating\":0.0},\n  {\"id\":756190,\"suggestedTranslation\":\"Ta sẽ hạ gục nó bằng một cú ĐẬP-thịt cực mạnh!\",\"rating\":0.0},\n  {\"id\":756191,\"suggestedTranslation\":\"Để đóng đinh cho những lý lẽ của ta.\",\"rating\":0.0},\n  {\"id\":756192,\"suggestedTranslation\":\"Hãy hoan hô chiếc búa!\",\"rating\":0.0},\n  {\"id\":756193,\"suggestedTranslation\":\"Chiếc gối bò lai êm ái nhất mà ta từng thấy.\",\"rating\":0.0},\n  {\"id\":756194,\"suggestedTranslation\":\"Ta chẳng bao giờ muốn ngủ như một con câu cá cả.\",\"rating\":0.0},\n  {\"id\":756195,\"suggestedTranslation\":\"Cho một cú tát thơm phức mùi hoa!\",\"rating\":0.0},\n  {\"id\":756196,\"suggestedTranslation\":\"Một thứ khó chịu, nhưng sẽ rất lợi hại trên võ đài đấy!\",\"rating\":0.0},\n  {\"id\":756197,\"suggestedTranslation\":\"Hyuyu! Ta thấy chúng đúng là mấy kẻ chơi khăm kỳ cựu.\",\"rating\":0.0},\n  {\"id\":756198,\"suggestedTranslation\":\"Ôi không, cái đó không hẳn là phong cách của ta đâu.\",\"rating\":0.0},\n  {\"id\":756199,\"suggestedTranslation\":\"Để xóa bỏ nỗi đau của thế giới mệt mỏi này!\",\"rating\":0.0},\n  {\"id\":756200,\"suggestedTranslation\":\"Nó sẽ chữa lành, niêm phong, thậm chí là đông đặc lại! Hãy mua ngay Thuốc Nhầy Nhụa hôm nay! Hời to đấy!\",\"rating\":0.0},\n  {\"id\":756201,\"s