            "text": "[\n  {\"id\":755915,\"suggestedTranslation\":\"Nào nào, chúng ta cùng dọn bàn nào.\",\"rating\":0.0},\n  {\"id\":755916,\"suggestedTranslation\":\"Ánh sáng rực rỡ khiến ta vẫn thấy đường vào ban đêm!\",\"rating\":0.0},\n  {\"id\":755917,\"suggestedTranslation\":\"Ta chưa bao giờ học phép lịch sự trên bàn ăn cả.\",\"rating\":0.0},\n  {\"id\":755918,\"suggestedTranslation\":\"Ta sẽ cố không bĩu môi khi ngọn đèn đó sớm tắt ngoóm.\",\"rating\":0.0},\n  {\"id\":755919,\"suggestedTranslation\":\"Bông hoa nhỏ trên bàn... trông ngươi có vẻ không vững vàng lắm nhỉ.\",\"rating\":0.0},\n  {\"id\":755920,\"suggestedTranslation\":\"Lô-lô-líp, một cái cây đang cháy!\",\"rating\":0.0},\n  {\"id\":755921,\"suggestedTranslation\":\"Chà, thế thì vui phết.\",\"rating\":0.0},\n  {\"id\":755922,\"suggestedTranslation\":\"Một trò đùa cây cối buồn cười thật.\",\"rating\":0.0},\n  {\"id\":755923,\"suggestedTranslation\":\"Một cái cây cường tráng với những chiếc lá xanh sẫm.\",\"rating\":0.0},\n  {\"id\":755924,\"suggestedTranslation\":\"Lô-lô-líp, một cái cây đang cháy!\",\"rating\":0.0},\n  {\"id\":755925,\"suggestedTranslation\":\"Chà, thế thì vui phết.\",\"rating\":0.0},\n  {\"id\":755926,\"suggestedTranslation\":\"Một trò đùa cây cối buồn cười thật.\",\"rating\":0.0},\n  {\"id\":755927,\"suggestedTranslation\":\"Một cái cây ủ rũ đầy những cục bướu sần sùi.\",\"rating\":0.0},\n  {\"id\":755928,\"suggestedTranslation\":\"Tầm nhìn của kẻ độc nhãn bị kéo mỏng manh.\",\"rating\":0.0},\n  {\"id\":755929,\"suggestedTranslation\":\"Chà, đúng là một khung cảnh mát mắt mà. Hyuyuyu!\",\"rating\":0.0},\n  {\"id\":755930,\"suggestedTranslation\":\"Dù hắn có nói gì thì ta làm, đó cũng là dối trá!\",\"rating\":0.0},\n  {\"id\":755931,\"suggestedTranslation\":\"Ta cảm thấy sợ hãi đến phát khiếp luôn rồi đây!\",\"rating\":0.0},\n  {\"id\":755932,\"suggestedTranslation\":\"Ối giời ơi, ngươi không chịu mở mắt ra à?\",\"rating\":0.0},\n  {\"id\":755933,\"suggestedTranslation\":\"Ôi chao ôi, một con mắt đáng yêu làm sao.\",\"rating\":0.0},\n  {\"id\":755934,\"suggestedTranslation\":\"Ôi giời ơi, nhìn con mắt kìa!\",\"rating\":0.0},\n  {\"id\":755935,\"suggestedTranslation\":\"Chỉ cần dựng nó lên là đủ hạ gục kẻ thù bằng cái nhìn tử thần rồi.\",\"rating\":0.0},\n  {\"id\":755936,\"suggestedTranslation\":\"Quả là một trò đùa ngớ ngẩn.\",\"rating\":0.0},\n  {\"id\":755937,\"suggestedTranslation\":\"Kẻ tạo ra thức ăn của phàm nhân.\",\"rating\":0.0},\n  {\"id\":755938,\"suggestedTranslation\":\"Lũ phàm nhân đang làm thức ăn phàm nhân kìa.\",\"rating\":0.0},\n  {\"id\":755939,\"suggestedTranslation\":\"Thứ thức ăn bán thành phẩm đang đói bụng rồi kìa.\",\"rating\":0.0},\n  {\"id\":755940,\"suggestedTranslation\":\"Ta đã chán ngấy việc cày xới và bận rộn rồi.\",\"rating\":0.0},\n  {\"id\":755941,\"suggestedTranslation\":\"Hyuyuyu, úi chà!\",\"rating\":0.0},\n  {\"id\":755942,\"suggestedTranslation\":\"Ôi thật là đẹp mắt, hoa mầu đã chín rồi!\",\"rating\":0.0},\n  {\"id\":755943,\"suggestedTranslation\":\"Phải chi ta thèm ăn thức ăn của phàm nhân!\",\"rating\":0.0},\n  {\"id\":755944,\"suggestedTranslation\":\"Đúng là một đám cỏ dại! Hyuyuyu!\",\"rating\":0.0},\n  {\"id\":755945,\"suggestedTranslation\":\"Một loại thực vật!\",\"rating\":0.0},\n  {\"id\":755946,\"suggestedTranslation\":\"Lớn nhanh và cao lớn, bằng không thì thôi.\",\"rating\":0.0},\n  {\"id\":755947,\"suggestedTranslation\":\"Đến lũ phàm nhân còn chẳng thèm ăn cái này nữa là.\",\"rating\":0.0},\n  {\"id\":755948,\"suggestedTranslation\":\"Cái này thối rữa cả rồi!\",\"rating\":0.0},\n  {\"id\":755949,\"suggestedTranslation\":\"Ra đây nhập bọn với chúng ta nào, bé con!\",\"rating\":0.0},\n  {\"id\":755950,\"suggestedTranslation\":\"Cày một mảnh đất cho những loại thực vật kén chọn.\",\"rating\":0.0},\n  {\"id\":755951,\"suggestedTranslation\":\"Làm việc suốt mà không chơi đùa sẽ biến một tiểu yêu thành kẻ bất hạnh.\",\"rating\":0.0},\n  {\"id\":755952,\"suggestedTranslation\":\"E rằng ta phải đày ải nó khỏi khu vườn này thôi.\",\"rating\":0.0},\n  {\"id\":755953,\"suggestedTranslation\":\"Nó tạo ra một cơn gió lớn. Có gì mà phải ầm ĩ nhỉ?\",\"rating\":0.0},\n  {\"id\":755954,\"suggestedTranslation\":\"Lông vũ và sừng trông rất hợp nhau.\",\"rating\":0.0},\n  {\"id\":755955,\"suggestedTranslation\":\"Dùng chiếc lông này, ta sẽ dùng, ta sẽ dùng.\",\"rating\":0.0},\n  {\"id\":755956,\"suggestedTranslation\":\"Một vật kỷ niệm để nhớ về tiếng hót ngọt ngào của nó.\",\"rating\":0.0},\n  {\"id\":755957,\"suggestedTranslation\":\"Một vật lưu niệm về người bạn lông đen tuyền của ta.\",\"rating\":0.0},\n  {\"id\":755958,\"suggestedTranslation\":\"Để tự nhắc nhở bản thân về cái khuôn mặt có chiếc mỏ ngọt ngào ấy.\",\"rating\":0.0},\n  {\"id\":755959,\"suggestedTranslation\":\"Một món quà lưu niệm về người bạn màu xanh dịu dàng.\",\"rating\":0.0},\n  {\"id\":755960,\"suggestedTranslation\":\"Xin kính chào và chúc sức khỏe, thưa quý bà.\",\"rating\":0.0},\n  {\"id\":755961,\"suggestedTranslation\":\"Để chặn ngươi ở ngoài, hay giữ ta ở trong?\",\"rating\":0.0},\n  {\"id\":755962,\"suggestedTranslation\":\"Tưởng là không được liên kết chứ.\",\"rating\":0.0},\n  {\"id\":755963,\"suggestedTranslation\":\"Nghĩ là nó được liên kết rồi đấy.\",\"rating\":0.0},\n  {\"id\":755964,\"suggestedTranslation\":\"Vẫn chưa được dựng lên.\",\"rating\":0.0},\n  {\"id\":755965,\"suggestedTranslation\":\"Dành cho những chuyến viếng thăm tạm thời.\",\"rating\":0.0},\n  {\"id\":755966,\"suggestedTranslation\":\"Nó chẳng có tác dụng gì khi nằm trên mặt đất cả.\",\"rating\":0.0},\n  {\"id\":755967,\"suggestedTranslation\":\"Nó chẳng có tác dụng gì khi nằm trên mặt đất cả.\",\"rating\":0.0},\n  {\"id\":755968,\"suggestedTranslation\":\"Một hàng rào kim loại để chúng ta phòng thủ.\",\"rating\":0.0},\n  {\"id\":755969,\"suggestedTranslation\":\"Một thanh kiếm chống lại hàng rào... tất cả chúng ta đều mất trí rồi!\",\"rating\":0.0},\n  {\"id\":755970,\"suggestedTranslation\":\"Hyuyu! Đúng là một đống phân!\",\"rating\":0.0},\n  {\"id\":755971,\"suggestedTranslation\":\"Chẳng có gì ám muội ở đây cả, hyuyu!\",\"rating\":0.0},\n  {\"id\":755972,\"suggestedTranslation\":\"Bạn tôi có thể nô đùa trong bộ cánh lễ hội này!\",\"rating\":0.0},\n  {\"id\":755973,\"suggestedTranslation\":\"Người ta nói trái cây treo thấp là ngọt ngào nhất!\",\"rating\":0.0},\n  {\"id\":755974,\"suggestedTranslation\":\"Thôi, ta xin nhường.\",\"rating\":0.0},\n  {\"id\":755975,\"suggestedTranslation\":\"Đồ ăn xiên que thì chẳng giải quyết được gì đâu.\",\"rating\":0.0},\n  {\"id\":755976,\"suggestedTranslation\":\"Lũ phàm nhân có vẻ thích ăn kiểu này hơn.\",\"rating\":0.0},\n  {\"id\":755977,\"suggestedTranslation\":\"Ô hô hô, thật là hỗn loạn đến thú vị!\",\"rating\":0.0},\n  {\"id\":755978,\"suggestedTranslation\":\"Lách tách, lách tách!\",\"rating\":0.0},\n  {\"id\":755979,\"suggestedTranslation\":\"Chút ánh sáng tự nhiên để ban cho ta thị lực.\",\"rating\":0.0},\n  {\"id\":755980,\"suggestedTranslation\":\"Những linh hồn nhỏ bé bồn chồn và rung rinh.\",\"rating\":0.0},\n  {\"id\":755981,\"suggestedTranslation\":\"Hyuyu, thật là rực lửa!\",\"rating\":0.0},\n  {\"id\":755982,\"suggestedTranslation\":\"Ô hô! Quả là cháy bỏng!\",\"rating\":0.0},\n  {\"id\":755983,\"suggestedTranslation\":\"Ta đã ngắm khi nó khô ngắm.\",\"rating\":0.0},\n  {\"id\":755984,\"suggestedTranslation\":\"Hyuyuyu, trò đùa cây bút bốc cháy kinh điển!\",\"rating\":0.0},\n  {\"id\":755985,\"suggestedTranslation\":\"Sắp tàn lụi rồi.\",\"rating\":0.0},\n  {\"id\":755986,\"suggestedTranslation\":\"Ngọn lửa này sẽ làm dịu cơn khát sự ấm áp của ta.\",\"rating\":0.0},\n  {\"id\":755987,\"suggestedTranslation\":\"Mấy ngọn lửa đó thật là cay nồng.\",\"rating\":0.0},\n  {\"id\":755988,\"suggestedTranslation\":\"Nó cháy nhỏ lắm, nhỏ lắm!\",\"rating\":0.0},\n  {\"id\":755989,\"suggestedTranslation\":\"Khi ta lang thang, cắm trại cho ta cảm giác như ở nhà.\",\"rating\":0.0},\n  {\"id\":755990,\"suggestedTranslation\":\"Và 