          {
            "text": "[\n  {\"id\":756347,\"suggestedTranslation\":\"Tốt hơn! Nhanh hơn!\",\"rating\":9.0},\n  {\"id\":756348,\"suggestedTranslation\":\"Tiểu yêu cường hóa!\",\"rating\":9.0},\n  {\"id\":756349,\"suggestedTranslation\":\"Phá cái cột đó đi!\",\"rating\":9.0},\n  {\"id\":756350,\"suggestedTranslation\":\"Dạo này thế nào, ngài hảo hán?\",\"rating\":9.0},\n  {\"id\":756351,\"suggestedTranslation\":\"Ta chẳng có nhiệm vụ gì sất, đến đây chỉ để khè khẹt cho vui thôi!\",\"rating\":9.0},\n  {\"id\":756352,\"suggestedTranslation\":\"Hyuyu, ôi ma thuật kìa!\",\"rating\":9.0},\n  {\"id\":756353,\"suggestedTranslation\":\"Hyuyu, ngươi là thứ gì thế!\",\"rating\":9.0},\n  {\"id\":756354,\"suggestedTranslation\":\"Ooo, ta thấy mình thật bảnh!\",\"rating\":9.0},\n  {\"id\":756355,\"suggestedTranslation\":\"Nó làm sừng ta nhột quá!\",\"rating\":9.0},\n  {\"id\":756356,\"suggestedTranslation\":\"Bùm! Xoẹt bùm! Tiêu đời!!\",\"rating\":9.0},\n  {\"id\":756357,\"suggestedTranslation\":\"Ta không muốn chết đâu, hyuyu!\",\"rating\":9.0},\n  {\"id\":756358,\"suggestedTranslation\":\"Một đóa hoa để làm chút điều tốt!\",\"rating\":9.0},\n  {\"id\":756359,\"suggestedTranslation\":\"Thanh đại kiếm để chém bay đám đông này!\",\"rating\":9.0},\n  {\"id\":756360,\"suggestedTranslation\":\"Đó là một câu đố một mảnh.\",\"rating\":9.0},\n  {\"id\":756361,\"suggestedTranslation\":\"Và ta đi đây!\",\"rating\":9.0},\n  {\"id\":756362,\"suggestedTranslation\":\"Cho ta thêm chút sát thương!\",\"rating\":9.0},\n  {\"id\":756363,\"suggestedTranslation\":\"Rìu chất tới nóc!\",\"rating\":9.0},\n  {\"id\":756364,\"suggestedTranslation\":\"Một cái phễu chạy bằng lửa.\",\"rating\":9.0},\n  {\"id\":756365,\"suggestedTranslation\":\"Nhảy cóc và tung tăng! Hyuyu!\",\"rating\":9.0},\n  {\"id\":756366,\"suggestedTranslation\":\"Nhiều năng lượng hơn, nhanh hơn!\",\"rating\":9.0},\n  {\"id\":756367,\"suggestedTranslation\":\"Nhảy nhót tầm gần!\",\"rating\":9.0},\n  {\"id\":756368,\"suggestedTranslation\":\"Cho ta thêm khối sát thương!\",\"rating\":9.0},\n  {\"id\":756369,\"suggestedTranslation\":\"Tiểu yêu này ở đây để giúp đỡ!\",\"rating\":9.0},\n  {\"id\":756370,\"suggestedTranslation\":\"Ta nhớ lại hồi mình ở độ tuổi đó.\",\"rating\":9.0},\n  {\"id\":756371,\"suggestedTranslation\":\"Một người bạn đang ngủ say bên trong.\",\"rating\":9.0},\n  {\"id\":756372,\"suggestedTranslation\":\"Có một thú cưng dễ thương nào ở trong không nhỉ?\",\"rating\":9.0},\n  {\"id\":756373,\"suggestedTranslation\":\"Trời ạ, ngươi lạnh quá rồi đấy!\",\"rating\":9.0},\n  {\"id\":756374,\"suggestedTranslation\":\"Ngọt ngào và ấm cúng như một con hàu.\",\"rating\":9.0},\n  {\"id\":756375,\"suggestedTranslation\":\"Đúng là một con giun hạnh phúc làm sao.\",\"rating\":9.0},\n  {\"id\":756376,\"suggestedTranslation\":\"Ngươi được ban cho sự trẻ trung vĩnh cửu! Đúng vậy đấy!\",\"rating\":9.0},\n  {\"id\":756377,\"suggestedTranslation\":\"Ngươi có ăn linh hồn không?\",\"rating\":9.0},\n  {\"id\":756378,\"suggestedTranslation\":\"Ôi trời, nó đang chết đói kìa!\",\"rating\":9.0},\n  {\"id\":756379,\"suggestedTranslation\":\"Mẹ ta vẫn còn giữ cái của ta ở đâu đó.\",\"rating\":9.0},\n  {\"id\":756380,\"suggestedTranslation\":\"Nó không thể làm tổn thương móng guốc của ta lúc này nữa!\",\"rating\":9.0},\n  {\"id\":756381,\"suggestedTranslation\":\"Nếu không bị cắn thì ta sẽ bị thiêu rụi trong bãi nước bọt này mất!\",\"rating\":9.0},\n  {\"id\":756382,\"suggestedTranslation\":\"Ta sẽ không nhúng ngón chân xuống đâu.\",\"rating\":9.0},\n  {\"id\":756383,\"suggestedTranslation\":\"Dung nham nguội.\",\"rating\":9.0},\n  {\"id\":756384,\"suggestedTranslation\":\"Đến cả người phàm cũng chẳng màng tới nó.\",\"rating\":9.0},\n  {\"id\":756385,\"suggestedTranslation\":\"Người phàm có vẻ khá cáu kỉnh khi bạn đụng đến thức ăn của họ.\",\"rating\":9.0},\n  {\"id\":756386,\"suggestedTranslation\":\"Ta sẽ trung thành với linh hồn, cảm ơn nhé.\",\"rating\":9.0},\n  {\"id\":756387,\"suggestedTranslation\":\"Không cần phải đánh nhau đâu, người bạn cây vĩ đại của ta!\",\"rating\":9.0},\n  {\"id\":756388,\"suggestedTranslation\":\"Một tác phẩm chạm khắc đẹp, nhưng tư thế hơi cứng nhắc, hyuyu!\",\"rating\":9.0},\n  {\"id\":756389,\"suggestedTranslation\":\"Không cần phải đánh nhau đâu, người bạn cây vĩ đại của ta!\",\"rating\":9.0},\n  {\"id\":756390,\"suggestedTranslation\":\"Thực phẩm cứu đói dưới lòng đất.\",\"rating\":9.0},\n  {\"id\":756391,\"suggestedTranslation\":\"Sau khi suy nghĩ lại, ta không muốn tiêm chích gì đâu.\",\"rating\":9.0},\n  {\"id\":756392,\"suggestedTranslation\":\"Tuyệt vời, ta dám cá là thế.\",\"rating\":9.0},\n  {\"id\":756393,\"suggestedTranslation\":\"Ít ra chúng còn sáng sủa hơn lũ khỉ.\",\"rating\":9.0},\n  {\"id\":756394,\"suggestedTranslation\":\"Một công cụ để châm lửa, nếu ngươi muốn.\",\"rating\":9.0},\n  {\"id\":756395,\"suggestedTranslation\":\"Nở hoa và phát sáng!\",\"rating\":9.0},\n  {\"id\":756396,\"suggestedTranslation\":\"Con đó vừa bị sét đánh trúng gần đây.\",\"rating\":9.0},\n  {\"id\":756397,\"suggestedTranslation\":\"Sừng của ngươi cũng thường thôi.\",\"rating\":9.0},\n  {\"id\":756398,\"suggestedTranslation\":\"Cũng tạm ổn.\",\"rating\":9.0},\n  {\"id\":756399,\"suggestedTranslation\":\"Nó đang tràn ngập năng lượng nguyên tố.\",\"rating\":9.0},\n  {\"id\":756400,\"suggestedTranslation\":\"Cho tâm hồn được thảnh thơi.\",\"rating\":9.0},\n  {\"id\":756401,\"suggestedTranslation\":\"Ta có thể chơi hai mươi trò khăm với ngươi đấy!\",\"rating\":9.0},\n  {\"id\":756402,\"suggestedTranslation\":\"Đừng nhìn ta bằng đôi mắt buồn bã đó!\",\"rating\":9.0},\n  {\"id\":756403,\"suggestedTranslation\":\"Một cái cây khó hiểu cũng như phiền toái.\",\"rating\":9.0},\n  {\"id\":756404,\"suggestedTranslation\":\"Rễ ơi rễ à!\",\"rating\":9.0},\n  {\"id\":756405,\"suggestedTranslation\":\"Hyuyu, đáng yêu làm sao!\",\"rating\":9.0},\n  {\"id\":756406,\"suggestedTranslation\":\"Con người có vẻ thích biến mọi thứ thành súp.\",\"rating\":9.0},\n  {\"id\":756407,\"suggestedTranslation\":\"E rằng ta không có góc nhìn về hải sản như phần lớn mọi người.\",\"rating\":9.0},\n  {\"id\":756408,\"suggestedTranslation\":\"Ôi chao, nó sẽ cháy rụi mất thôi!\",\"rating\":9.0},\n  {\"id\":756409,\"suggestedTranslation\":\"Một phần của thứ từng là cái cây.\",\"rating\":9.0},\n  {\"id\":756410,\"suggestedTranslation\":\"Hyuyu! Ta cứ nghĩ giới quý tộc phải lịch sự hơn chứ!\",\"rating\":9.0},\n  {\"id\":756411,\"suggestedTranslation\":\"Ngươi không phải người thuộc cõi này phải không?\",\"rating\":9.0},\n  {\"id\":756412,\"suggestedTranslation\":\"Ngươi không phải người thuộc cõi này phải không?\",\"rating\":9.0},\n  {\"id\":756413,\"suggestedTranslation\":\"Ngươi không phải người thuộc cõi này phải không?\",\"rating\":9.0},\n  {\"id\":756414,\"suggestedTranslation\":\"Ngươi không phải người thuộc cõi này phải không?\",\"rating\":9.0},\n  {\"id\":756415,\"suggestedTranslation\":\"Ngươi không phải người thuộc cõi này phải không?\",\"rating\":9.0},\n  {\"id\":756416,\"suggestedTranslation\":\"Ngươi không phải người thuộc cõi này phải không?\",\"rating\":9.0},\n  {\"id\":756417,\"suggestedTranslation\":\"Ngươi không phải người thuộc cõi này phải không?\",\"rating\":9.0},\n  {\"id\":756418,\"suggestedTranslation\":\"Ngươi không phải người thuộc cõi này phải không?\",\"rating\":9.0},\n  {\"id\":756419,\"suggestedTranslation\":\"Ngươi không phải người thuộc cõi này phải không?\",\"rating\":9.0},\n  {\"id\":756420,\"suggestedTranslation\":\"Ngươi không phải người thuộc cõi này phải không?\",\"rating\":9.0},\n  {\"id\":756421,\"suggestedTranslation\":\"Ôi ta cảm thấy may mắn làm sao, may mắn làm sao.\",\"rating\":9.0},\n  {\"id\":756422,\"suggestedTranslation\":\"Rìu nào chẳng là rìu, sự thật là thế đấy.\",\"rating\":9.0},\n  {\"id\":756423,\"suggestedTranslation\":\"Một cái cây con bé xíu!\",\"rating\":9.0},\n  {\"id\":756424,\"suggestedTranslation\":\"Đã bao giờ thấy cảnh Đèn Chong Đêm biết nhảy chưa?\",\"rating\":9.0},\n  {\"id\":756425,\"suggestedTranslation\":\"Nó giúp ta nhìn nhận mọi thứ theo chiều hướng tích cực, hyuyu!\",\"rating\":9.0},\n  {\"id\":756426,\"suggestedTranslation\":\"Trống rỗng.\",\"rating\":9.0},\n  {\"id\":756427,\"suggestedTranslation\":\"Vá một mũi ở đây và ở kia để sửa chữa nhanh chóng.\",\"rating\":9.0},\n  {\"id\":756428,\"suggestedTranslation\":\"Lấp lánh và lóng lánh.\",\"rating\":9.0},\n  {\"id\":756429,\"suggestedTranslation\":\"Mọi thứ đang rách toạc ra từng đường tơi tả!\",\"rating\":9.0},\n  {\"id\":756430,\"suggestedTranslation\":\"Đi một quãng đường dài mới đến đây nhỉ?\",\"rating\":9.0},\n  {\"id\":756431,\"suggestedTranslation\":\"Đám cỏ dại đang quất roi kìa.\",\"rating\":9.0},\n  {\"id\":756432,\"suggestedTranslation\":\"Lò rèn đó không có chút sắt nào phải không?\",\"rating\":9.0},\n  {\"id\":756433,\"suggestedTranslation\":\"Chúng ta tiếp tục tiến lên chứ?\",\"rating\":9.0},\n  {\"id\":756434,\"suggestedTranslation\":\"Chà chà, có phải ta vừa thấy hàm răng kia không?\",\"rating\":9.0},\n  {\"id\":756435,\"suggestedTranslation\":\"Ngươi đã ngã xuống, và bỏ lại vương miện của mình!\",\"rating\":9.0},\n  {\"id\":756436,\"suggestedTranslation\":\"Như nhện giăng tơ bắt ruồi.\",\"rating\":9.0},\n  {\"id\":756437,\"suggestedTranslation\":\"Có một sự thèm khát sâu thẳm trong ánh mắt đó.\",\"rating\":9.0},\n  {\"id\":756438,\"suggestedTranslation\":\"Nó có mùi thật đấy.\",\"rating\":9.0},\n  {\"id\":756439,\"suggestedTranslation\":\"Nơi để tôi nấu nướng món thuốc phép của mình.\",\"rating\":9.0},\n  {\"id\":756440,\"suggestedTranslation\":\"Một mẹo khôn ngoan để chuyển đồ nhanh chóng.\",\"rating\":9.0},\n  {\"id\":756441,\"suggestedTranslation\":\"Bắn hạ nó thì xui xẻo lắm, nhưng ta biết gì nào? Hyuyu!\",\"rating\":9.0},\n  {\"id\":756442,\"suggestedTranslation\":\"Nó không còn quác lên được nữa.\",\"rating\":9.0},\n  {\"id\":756443,\"suggestedTranslation\":\"Một chiếc lông dành cho ta, từ chú chim của biển khơi.\",\"rating\":9.0},\n  {\"id\":756444,\"suggestedTranslation\":\"Tấm vải này nhột ghê, hyuyu.\",\"rating\":9.0},\n  {\"id\":756445,\"suggestedTranslation\":\"Xin chào và kính chào ngài.\",\"rating\":9.0},\n  {\"id\":756446,\"suggestedTranslation\":\"Nó hết nước cốt chơi khăm rồi.\",\"rating\":9.0},\n  {\"id\":756447,\"suggestedTranslation\":\"Chẳng mấy chốc ta sẽ nhấm nháp một chén súp buồn ngủ.\",\"rating\":9.0},\n  {\"id\":756448,\"suggestedTranslation\":\"Dừng lại đi không là ta cướp giọng của ngươi đấy.\",\"rating\":9.0},\n  {\"id\":756449,\"suggestedTranslation\":\"Ôi trời ơi.\",\"rating\":9.0},\n  {\"id\":756450,\"suggestedTranslation\":\"Đó là một loài thực vật chơi khăm.\",\"rating\":9.0},\n  {\"id\":756451,\"suggestedTranslation\":\"Cái đuôi của mấy con thỏ bự chảng đó.\",\"rating\":9.0},\n  {\"id\":756452,\"suggestedTranslation\":\"Đi đường nào cũng chẳng thành vấn đề đâu.\",\"rating\":9.0},\n  {\"id\":756453,\"suggestedTranslation\":\"Tấm phiến đá nhỏ, chẳng mấy chốc sẽ thành tượng thôi.\",\"rating\":9.0},\n  {\"id\":756454,\"suggestedTranslation\":\"Hạt đậu lớn, làm bằng đá cẩm thạch.\",\"rating\":9.0},\n  {\"id\":756455,\"suggestedTranslation\":\"Nó lớn lên thế nào nhỉ? Ta thực sự không biết!\",\"rating\":9.0},\n  {\"id\":756456,\"suggestedTranslation\":\"Một cột trụ bằng đá cẩm thạch, vừa cao vừa lạnh lẽo.\",\"rating\":9.0},\n  {\"id\":756457,\"suggestedTranslation\":\"Một bụi cây rậm rạp!\",\"rating\":9.0},\n  {\"id\":756458,\"suggestedTranslation\":\"Và đây chúng ta thấy... một cây cẩm thạch!\",\"rating\":9.0},\n  {\"id\":756459,\"suggestedTranslation\":\"Suỵt, khẽ chứ! Ta thấy phía trước có một bụi cây đang cháy!\",\"rating\":9.0},\n  {\"id\":756460,\"suggestedTranslation\":\"Tro lại về với tro.\",\"rating\":9.0},\n  {\"id\":756461,\"suggestedTranslation\":\"Ái chà! Gai góc quá.\",\"rating\":9.0},\n  {\"id\":756462,\"suggestedTranslation\":\"Đi mất rồi, đi sạch rồi.\",\"rating\":9.0},\n  {\"id\":756463,\"suggestedTranslation\":\"Tránh ra, ta đang ngắm cảnh ở đây.\",\"rating\":9.0},\n  {\"id\":75646