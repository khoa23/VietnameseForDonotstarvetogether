            "text": "[\n  {\"id\":756947,\"suggestedTranslation\":\"Cho chúng chút đất, trước khi héo quắt.\",\"rating\":0.0},\n  {\"id\":756948,\"suggestedTranslation\":\"Ta có thể ngắm bóng mình cả ngày!\",\"rating\":0.0},\n  {\"id\":756949,\"suggestedTranslation\":\"Đúng là một linh hồn trơn tuột.\",\"rating\":0.0},\n  {\"id\":756950,\"suggestedTranslation\":\"Ngươi khá là thơm ngát đấy.\",\"rating\":0.0},\n  {\"id\":756951,\"suggestedTranslation\":\"Mầm xanh uốn lượn nhỏ bé.\",\"rating\":0.0},\n  {\"id\":756952,\"suggestedTranslation\":\"Tiêu hóa vật lý thật là khó chịu.\",\"rating\":0.0},\n  {\"id\":756953,\"suggestedTranslation\":\"Băm chặt thế này mà chẳng có linh hồn nào.\",\"rating\":0.0},\n  {\"id\":756954,\"suggestedTranslation\":\"Ta đoán mình đã phí thời gian theo những cách tệ hơn.\",\"rating\":0.0},\n  {\"id\":756955,\"suggestedTranslation\":\"Bữa ăn làm vội, nhưng hương vị không tồi.\",\"rating\":0.0},\n  {\"id\":756956,\"suggestedTranslation\":\"Bữa ăn của phàm nhân không phải gu của ta.\",\"rating\":0.0},\n  {\"id\":756957,\"suggestedTranslation\":\"Toàn bộ thức ăn đã bị cuốn đi mất rồi.\",\"rating\":0.0},\n  {\"id\":756958,\"suggestedTranslation\":\"Nó làm ra món linh hồn ẩm thực à?\",\"rating\":0.0},\n  {\"id\":756959,\"suggestedTranslation\":\"Chất dễ cháy di động!\",\"rating\":0.0},\n  {\"id\":756960,\"suggestedTranslation\":\"Phàm nhân mới kỳ lạ làm sao.\",\"rating\":0.0},\n  {\"id\":756961,\"suggestedTranslation\":\"Xay, xay, xay tiếp đi nào.\",\"rating\":0.0},\n  {\"id\":756962,\"suggestedTranslation\":\"Biết bao trò quậy phá để làm! Ta có nên đẩy nó xuống hồ? Hay ném vào một con rắn?\",\"rating\":0.0},\n  {\"id\":756963,\"suggestedTranslation\":\"Vòng quanh, vòng quanh, cái lều dựng lên rồi lại hạ xuống!\",\"rating\":0.0},\n  {\"id\":756964,\"suggestedTranslation\":\"Phàm nhân thích thứ này dưới mọi hình dạng.\",\"rating\":0.0},\n  {\"id\":756965,\"suggestedTranslation\":\"Hyuyuyu, chẳng phải sẽ rất vui nếu trốn vào trong rồi hù hắn một cú sao?\",\"rating\":0.0},\n  {\"id\":756966,\"suggestedTranslation\":\"Ta chắc nó ngon đấy, nhưng không dành cho ta.\",\"rating\":0.0},\n  {\"id\":756967,\"suggestedTranslation\":\"Ta nghĩ mình còn nhớ khi mình từng ăn thức ăn. Có lẽ vậy.\",\"rating\":0.0},\n  {\"id\":756968,\"suggestedTranslation\":\"Một món ăn phàm nhân được nướng chín.\",\"rating\":0.0},\n  {\"id\":756969,\"suggestedTranslation\":\"Ồ, lũ phàm nhân sẽ phấn khích lắm đây!\",\"rating\":0.0},\n  {\"id\":756970,\"suggestedTranslation\":\"Những hạt nhỏ kỳ lạ, quả thế, quả thế.\",\"rating\":0.0},\n  {\"id\":756971,\"suggestedTranslation\":\"Một loài thực vật, bị giam cầm đến muôn đời.\",\"rating\":0.0},\n  {\"id\":756972,\"suggestedTranslation\":\"Hyuyu! Chiếc bánh này có võ đấy!\",\"rating\":0.0},\n  {\"id\":756973,\"suggestedTranslation\":\"Cẩn thận đừng đi quá đà đấy, tên tiểu tặc.\",\"rating\":0.0},\n  {\"id\":756974,\"suggestedTranslation\":\"Nước đã bị đổ, phải được châm đầy lại thôi!\",\"rating\":0.0},\n  {\"id\":756975,\"suggestedTranslation\":\"Cái này làm ta nhớ tới một con chim nào đó mà chúng ta từng gây gổ.\",\"rating\":0.0},\n  {\"id\":756976,\"suggestedTranslation\":\"Khỉ thấy, khỉ làm.\",\"rating\":0.0},\n  {\"id\":756977,\"suggestedTranslation\":\"Ta chẳng nói gì đâu, hải âu cổ rụt à.\",\"rating\":0.0},\n  {\"id\":756978,\"suggestedTranslation\":\"Bình tĩnh nào, linh hồn nhỏ bé.\",\"rating\":0.0},\n  {\"id\":756979,\"suggestedTranslation\":\"Hyuyu, đang tranh thủ chợp mắt phải không nào?\",\"rating\":0.0},\n  {\"id\":756980,\"suggestedTranslation\":\"Vừa đẹp đẽ lại vừa ma quái!\",\"rating\":0.0},\n  {\"id\":756981,\"suggestedTranslation\":\"Đến lượt ta khắc đèn lồng rồi!\",\"rating\":0.0},\n  {\"id\":756982,\"suggestedTranslation\":\"Thức ăn thực sự hơi nặng bụng đối với ta.\",\"rating\":0.0},\n  {\"id\":756983,\"suggestedTranslation\":\"Việc khắc đã xong, giờ là lúc vui vẻ bắt đầu!\",\"rating\":0.0},\n  {\"id\":756984,\"suggestedTranslation\":\"Nó chưa sẵn sàng cho cái đầu thông minh của ta đâu.\",\"rating\":0.0},\n  {\"id\":756985,\"suggestedTranslation\":\"Đừng ngại ngùng, hãy thử miếng bánh đi!\",\"rating\":0.0},\n  {\"id\":756986,\"suggestedTranslation\":\"Dễ chịu hơn một chút cho cái bụng tinh quái của ta.\",\"rating\":0.0},\n  {\"id\":756987,\"suggestedTranslation\":\"Thật ma quái làm sao! Hyuyu!\",\"rating\":0.0},\n  {\"id\":756988,\"suggestedTranslation\":\"Quả bí ngô thật là mũm mĩm.\",\"rating\":0.0},\n  {\"id\":756989,\"suggestedTranslation\":\"Cho chúng chút đất, trước khi héo quắt.\",\"rating\":0.0},\n  {\"id\":756990,\"suggestedTranslation\":\"Nó chẳng phàn nàn gì cả, bởi vì nó có thấy đau đâu!\",\"rating\":0.0},\n  {\"id\":756991,\"suggestedTranslation\":\"Hyuyu, nó làm bộ não tinh quái của ta thấy nhột!\",\"rating\":0.0},\n  {\"id\":756992,\"suggestedTranslation\":\"Ta nghĩ mình xứng đáng có được những viên ngọc này.\",\"rating\":0.0},\n  {\"id\":756993,\"suggestedTranslation\":\"Viên thạch anh tím tối tăm được giật ra từ giữa chốn u minh.\",\"rating\":0.0},\n  {\"id\":756994,\"suggestedTranslation\":\"Mắt chữ O miệng chữ A!\",\"rating\":0.0},\n  {\"id\":756995,\"suggestedTranslation\":\"Nó đầy hết mức có thể rồi!\",\"rating\":0.0},\n  {\"id\":756996,\"suggestedTranslation\":\"Một nơi để đặt cái đĩa lên!\",\"rating\":0.0},\n  {\"id\":756997,\"suggestedTranslation\":\"Chẳng có gì thú vị với ta cả, ta thấy thế.\",\"rating\":0.0},\n  {\"id\":756998,\"suggestedTranslation\":\"Dây thường xuân leo, vươn mình lớn mạnh.\",\"rating\":0.0},\n  {\"id\":756999,\"suggestedTranslation\":\"Cái vỏ của ta không phải là bề tôi của ả.\",\"rating\":0.0},\n  {\"id\":757000,\"suggestedTranslation\":\"Một bức tượng hoành tráng! Hyuyu!\",\"rating\":0.0},\n  {\"id\":757001,\"suggestedTranslation\":\"Không họ hàng gì cả.\",\"rating\":0.0},\n  {\"id\":757002,\"suggestedTranslation\":\"Ta lấy phần thịt (beef), còn ngươi giữ phần loi (lo)!\",\"rating\":0.0},\n  {\"id\":757003,\"suggestedTranslation\":\"Phàm nhân thích dâu rừng, ta nghĩ vậy.\",\"rating\":0.0},\n  {\"id\":757004,\"suggestedTranslation\":\"Lũ phàm nhân thích khi thức ăn trông đẹp mắt.\",\"rating\":0.0},\n  {\"id\":757005,\"suggestedTranslation\":\"Những hạt nhỏ kỳ lạ, quả thế, quả thế.\",\"rating\":0.0},\n  {\"id\":757006,\"suggestedTranslation\":\"Ta tự hỏi làm sao mà con wyrm lại có khẩu vị với đồ ăn của phàm nhân nhỉ.\",\"rating\":0.0},\n  {\"id\":757007,\"suggestedTranslation\":\"Món ăn này nhỏ xíu luôn!\",\"rating\":0.0},\n  {\"id\":757008,\"suggestedTranslation\":\"Những đồng xu lặt vặt.\",\"rating\":0.0},\n  {\"id\":757009,\"suggestedTranslation\":\"The Gnaw đã khạc nó ra từ cổ họng.\",\"rating\":0.0},\n  {\"id\":757010,\"suggestedTranslation\":\"The Gnaw đã lên tiếng. Chúng ta đã kiếm được tín vật của nó.\",\"rating\":0.0},\n  {\"id\":757011,\"suggestedTranslation\":\"Đó là một tín vật bước nhảy lớn.\",\"rating\":0.0},\n  {\"id\":757012,\"suggestedTranslation\":\"Loài người thích nó lắm, đúng thế, đúng thế!\",\"rating\":0.0},\n  {\"id\":757013,\"suggestedTranslation\":\"Ta nghe nói chúng thích món này khi được nấu thế này hơn!\",\"rating\":0.0},\n  {\"id\":757014,\"suggestedTranslation\":\"Chúng sẽ thấy mình thật ngốc nghếch khi ta bắt được cho xem!\",\"rating\":0.0},\n  {\"id\":757015,\"suggestedTranslation\":\"Ta tự hỏi nó có vị ra sao nhỉ.\",\"rating\":0.0},\n  {\"id\":757016,\"suggestedTranslation\":\"Bột thức ăn của phàm nhân!\",\"rating\":0.0},\n  {\"id\":757017,\"suggestedTranslation\":\"Loài người có khẩu vị thật lạ đời.\",\"rating\":0.0},\n  {\"id\":757018,\"suggestedTranslation\":\"Hãy thử vận may với vật tế thần này nào!\",\"rating\":0.0},\n  {\"id\":757019,\"suggestedTranslation\":\"Bữa ăn này thật tuyệt vời, đúng như dự định!\",\"rating\":0.0},\n  {\"id\":757020,\"suggestedTranslation\":\"Dọn món nhỏ còn hơn là không có gì.\",\"rating\":0.0},\n  {\"id\":757021,\"suggestedTranslation\":\"Bữa ăn này trông sai sai, nhưng chúng ta không còn nhiều thời gian đâu.\",\"rating\":0.0},\n  {\"id\":757022,\"suggestedTranslation\":\"Ôi chao ôi.\",\"rating\":0.0},\n  {\"id\":757023,\"suggestedTranslation\":\"Hííí trốn!\",\"rating\":0.0},\n  {\"id\":757024,\"suggestedTranslation\":\"Híííí trốn!\",\"rating\":0.0},\n  {\"id\":757025,\"suggestedTranslation\":\"Những hạt nhỏ kỳ lạ, quả thế, quả thế.\",\"rating\":0.0},\n  {\"id\":757026,\"suggestedTranslation\":\"Và ngươi có thể là ai nhỉ?\",\"rating\":0.0},\n  {\"id\":757027,\"suggestedTranslation\":\"Hyuyu! Tươi ngon từ nguồn luôn.\",\"rating\":0.0},\n  {\"id\":757028,\"suggestedTranslation\":\"Ta định hỏi vị thần dê hircine, nhưng ta nghĩ đây là cung Ma Kết.\",\"rating\":0.0},\n  {\"id\":757029,\"suggestedTranslation\":\"Phàm nhân có rất nhiều dụng cụ nấu nướng khác nhau.\",\"rating\":0.0},\n  {\"id\":757030,\"suggestedTranslation\":\"Chúng ta cần xây cái đó, đúng vậy đấy.\",\"rating\":0.0},\n  {\"id\":757031,\"suggestedTranslation\":\"Phàm nhân nấu nướng đồ đạc trên đó.\",\"rating\":0.0},\n  {\"id\":757032,\"suggestedTranslation\":\"Chúng ta cần xây cái đó, đúng vậy đấy.\",\"rating\":0.0},\n  {\"id\":757033,\"suggestedTranslation\":\"Để xới đất lên, từng hàng từng hàng một.\",\"rating\":0.0},\n  {\"id\":757034,\"suggestedTranslation\":\"Ta muốn soi mói vào những nguồn dự trữ bị giấu kín.\",\"rating\":0.0},\n  {\"id\":757035,\"suggestedTranslation\":\"Không cánh cổng nào ngăn được một tên tiểu yêu lén lút!\",\"rating\":0.0},\n  {\"id\":757036,\"suggestedTranslation\":\"Nếu trời đang mưa là ta có thể hát rồi!\",\"rating\":0.0},\n  {\"id\":757037,\"suggestedTranslation\":\"Nếu trời đang mưa là ta có thể hát rồi!\",\"rating\":0.0},\n  {\"id\":757038,\"suggestedTranslation\":\"Ta khá thích công việc vặt của phàm nhân này đấy.\",\"rating\":0.0},\n  {\"id\":757039,\"suggestedTranslation\":\"Trông có vẻ hơi xập xệ nhỉ.\",\"rating\":0.0},\n  {\"id\":757040,\"suggestedTranslation\":\"Có gì vui ở bên trong không ta?\",\"rating\":0.0},\n  {\"id\":757041,\"suggestedTranslation\":\"Phiền gì không nếu ta hé mắt nhìn trộm một chút nhỉ?\",\"rating\":0.0},\n  {\"id\":757042,\"suggestedTranslation\":\"Còn nhiều nấm mỡ lắm ở chỗ đó đấy, hyuyu!\",\"rating\":0.0},\n  {\"id\":757043,\"suggestedTranslation\":\"Một đô thị nấm!\",\"rating\":0.0},\n  {\"id\":757044,\"suggestedTranslation\":\"Nó đã bị hái sạch trơn rồi.\",\"rating\":0.0},\n  {\"id\":757045,\"suggestedTranslation\":\"Ngươi sẽ chẳng thấy giọt nước mắt nào từ mắt ta đâu. Ta không biết khóc!\",\"rating\":0.0},\n  {\"id\":757046,\"suggestedTranslation\":\"Đã nấu chín, nhưng chưa thành món ăn hoàn chỉnh.\",\"rating\":0.0},\n  {\"id\":757047,\"suggestedTranslation\":\"Những hạt nhỏ kỳ lạ, quả thế, quả thế.\",\"rating\":0.0},\n  {\"id\":757048,\"suggestedTranslation\":\"Đó là thứ mà phàm nhân dùng để nấu ăn.\",\"rating\":0.0},\n  {\"id\":757049,\"suggestedTranslation\":\"Chúng ta cần xây cái đó, đúng vậy đấy.\",\"rating\":0.0},\n  {\"id\":757050,\"suggestedTranslation\":\"Một bức tường, một bức tường, cao ơi là cao.\",\"rating\":0.0},\n  {\"id\":757051,\"suggestedTranslation\":\"Ta có thể vẽ thêm bộ ria mép nhỏ lên đó khi không ai để ý.\",\"rating\":0.0},\n  {\"id\":757052,\"suggestedTranslation\":\"Cái này thì có sẵn râu từ trước rồi.\",\"rating\":0.0},\n  {\"id\":757053,\"suggestedTranslation\":\"Thật thất vọng làm sao, nó đã khô cạn nước mất rồi.\",\"rating\":0.0},\n  {\"id\":757054,\"suggestedTranslation\":\"Lối này để đến công viên!\",\"rating\":0.0},\n  {\"id\":757055,\"suggestedTranslation\":\"Cho ta ra ngoài với! Hyuyu, đùa thôi.\",\"rating\":0.0},\n  {\"id\":757056,\"suggestedTranslation\":\"Chẳng có gì vui để tìm ở đây cả.\",\"rating\":0.0},\n  {\"id\":757057,\"suggestedTranslation\":\"Chắc là chẳng có gì vui ở bên trong đâu.\",\"rating\":0.0},\n  {\"id\":757058,\"suggestedTranslation\":\"Đúng là một sinh vật ngộ nghĩnh!\",\"rating\":0.0},\n  {\"id\":757059,\"suggestedTranslation\":\"Ôi trời ơi, ôi phước ơn.\",\"rating\":0.0},\n  {\"id\":757060,\"suggestedTranslation\":\"Ta nghe nói chúng làm bánh nướng rất ngon đấy.\",\"rating\":0.0},\n  {\"id\":757061,\"suggestedTranslation\":\"Hãy