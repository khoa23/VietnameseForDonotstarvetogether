          {
            "text": "[\n  {\"id\":757248,\"suggestedTranslation\":\"Ta thấy ngươi yêu muối lắm đấy chứ!\",\"rating\":9.0},\n  {\"id\":757249,\"suggestedTranslation\":\"Mũ mà không có lông thì thật buồn cười.\",\"rating\":9.0},\n  {\"id\":757250,\"suggestedTranslation\":\"Ôi trời ơi, đất hỡi!\",\"rating\":9.0},\n  {\"id\":757251,\"suggestedTranslation\":\"Hyuyu, ngươi không bắt được ta đâu!\",\"rating\":9.0},\n  {\"id\":757252,\"suggestedTranslation\":\"Hừm! Ta thích đi đâu thì đi!\",\"rating\":9.0},\n  {\"id\":757253,\"suggestedTranslation\":\"Hyuyu! Ta cũng điên như ngươi vậy!\",\"rating\":9.0},\n  {\"id\":757254,\"suggestedTranslation\":\"Tiếc ghê, ta lại quên mang kẹo dẻo mất rồi!\",\"rating\":9.0},\n  {\"id\":757255,\"suggestedTranslation\":\"Giờ thì nó thối thật đấy chứ!\",\"rating\":9.0},\n  {\"id\":757256,\"suggestedTranslation\":\"Nó bắt đầu bốc mùi rồi kìa.\",\"rating\":9.0},\n  {\"id\":757257,\"suggestedTranslation\":\"Cứ tưởng mình là cây to lắm đấy.\",\"rating\":9.0},\n  {\"id\":757258,\"suggestedTranslation\":\"Hết rồi, sạch trơn rồi.\",\"rating\":9.0},\n  {\"id\":757259,\"suggestedTranslation\":\"Đang buồn chán hả?\",\"rating\":9.0},\n  {\"id\":757260,\"suggestedTranslation\":\"Hyuyuyu, ta cá là bạn ta giấu nhiều chiêu trò trong mấy cái tay áo thiếc đó lắm!\",\"rating\":9.0},\n  {\"id\":757261,\"suggestedTranslation\":\"Trò đùa này hơi quá đáng đấy.\",\"rating\":9.0},\n  {\"id\":757262,\"suggestedTranslation\":\"Ngươi đâu đáng phải chịu cảnh này.\",\"rating\":9.0},\n  {\"id\":757263,\"suggestedTranslation\":\"Chào buổi sáng nhé, ngài!\",\"rating\":9.0},\n  {\"id\":757264,\"suggestedTranslation\":\"Ai đó vừa gặp tai nạn thì phải.\",\"rating\":9.0},\n  {\"id\":757265,\"suggestedTranslation\":\"Cái này từ đâu ra nhỉ? Không biết gì mới là một nửa sự thú vị chứ!\",\"rating\":9.0},\n  {\"id\":757266,\"suggestedTranslation\":\"Một mảnh sắt vụn, được chế thành chiếc mũ!\",\"rating\":9.0},\n  {\"id\":757267,\"suggestedTranslation\":\"Chao ôi, ánh mắt xa xăm làm sao!\",\"rating\":9.0},\n  {\"id\":757268,\"suggestedTranslation\":\"Cạn ý tưởng rồi. Hyuyu!\",\"rating\":9.0},\n  {\"id\":757269,\"suggestedTranslation\":\"Đúng là một trò đùa ngớ ngẩn.\",\"rating\":9.0},\n  {\"id\":757270,\"suggestedTranslation\":\"Ta không thể tạo ra thứ gì từ hư vô được.\",\"rating\":9.0},\n  {\"id\":757271,\"suggestedTranslation\":\"Chính tay ta làm đấy.\",\"rating\":9.0},\n  {\"id\":757272,\"suggestedTranslation\":\"Có thứ gì đó vui lắm đang ẩn giấu bên trong!\",\"rating\":9.0},\n  {\"id\":757273,\"suggestedTranslation\":\"Ta phải công nhận là cách đó rất hiệu quả!\",\"rating\":9.0},\n  {\"id\":757274,\"suggestedTranslation\":\"Nào, chơi thôi!\",\"rating\":9.0},\n  {\"id\":757275,\"suggestedTranslation\":\"Đến lúc sửa sang lại con quân tượng này rồi.\",\"rating\":9.0},\n  {\"id\":757276,\"suggestedTranslation\":\"Nào thì hây dừ, đi thôi!\",\"rating\":9.0},\n  {\"id\":757277,\"suggestedTranslation\":\"Có thứ gì đó vui lắm đang ẩn giấu bên trong!\",\"rating\":9.0},\n  {\"id\":757278,\"suggestedTranslation\":\"Ta phải công nhận là cách đó rất hiệu quả!\",\"rating\":9.0},\n  {\"id\":757279,\"suggestedTranslation\":\"Nào, chơi thôi!\",\"rating\":9.0},\n  {\"id\":757280,\"suggestedTranslation\":\"Đúng là một con mã chất lượng!\",\"rating\":9.0},\n  {\"id\":757281,\"suggestedTranslation\":\"Nào thì hây dừ, đi thôi!\",\"rating\":9.0},\n  {\"id\":757282,\"suggestedTranslation\":\"Có thứ gì đó vui lắm đang ẩn giấu bên trong!\",\"rating\":9.0},\n  {\"id\":757283,\"suggestedTranslation\":\"Ta phải công nhận là cách đó rất hiệu quả!\",\"rating\":9.0},\n  {\"id\":757284,\"suggestedTranslation\":\"Nào, chơi thôi!\",\"rating\":9.0},\n  {\"id\":757285,\"suggestedTranslation\":\"Nhìn kìa! Một con xe!\",\"rating\":9.0},\n  {\"id\":757286,\"suggestedTranslation\":\"Nào thì hây dừ, đi thôi!\",\"rating\":9.0},\n  {\"id\":757287,\"suggestedTranslation\":\"Ngọn lửa đã khiến nó tèo rồi!\",\"rating\":9.0},\n  {\"id\":757288,\"suggestedTranslation\":\"Dành cho một bộ óc bao la như biển cả!\",\"rating\":9.0},\n  {\"id\":757289,\"suggestedTranslation\":\"Món súp hải sản vui nhộn!\",\"rating\":9.0},\n  {\"id\":757290,\"suggestedTranslation\":\"Đâm vào hòn đá đó thì chắc là sốc lắm đây.\",\"rating\":9.0},\n  {\"id\":757291,\"suggestedTranslation\":\"Không có quả cầu nào cả, đại khái là thế.\",\"rating\":9.0},\n  {\"id\":757292,\"suggestedTranslation\":\"Nó đã hấp thụ quả cầu rồi!\",\"rating\":9.0},\n  {\"id\":757293,\"suggestedTranslation\":\"Cho sở thích làm vườn của ta, một nơi để cất hạt!\",\"rating\":9.0},\n  {\"id\":757294,\"suggestedTranslation\":\"Cho chúng ít đất đi, trước khi chúng hỏng mất.\",\"rating\":9.0},\n  {\"id\":757295,\"suggestedTranslation\":\"Mấy hạt này đã được nấu chín rồi.\",\"rating\":9.0},\n  {\"id\":757296,\"suggestedTranslation\":\"Hyuyu! Thật là một cách thám thính tinh quái!\",\"rating\":9.0},\n  {\"id\":757297,\"suggestedTranslation\":\"Kim chỉ vá may, vá lại là xong ngay!\",\"rating\":9.0},\n  {\"id\":757298,\"suggestedTranslation\":\"Trông xám xịt thế này có hợp mốt không nhỉ?\",\"rating\":9.0},\n  {\"id\":757299,\"suggestedTranslation\":\"Chắc là không thích trò chuyện rồi nhỉ?\",\"rating\":9.0},\n  {\"id\":757300,\"suggestedTranslation\":\"Ngươi chắc đây không phải phép thuật chứ?\",\"rating\":9.0},\n  {\"id\":757301,\"suggestedTranslation\":\"Nhảy đi người bóng tối, nhảy nào! Hyuyu!\",\"rating\":9.0},\n  {\"id\":757302,\"suggestedTranslation\":\"Thế hắn trả ngươi bao nhiêu vậy?\",\"rating\":9.0},\n  {\"id\":757303,\"suggestedTranslation\":\"Ôi, thú vị thật đấy! Nó vẫn đang đập kìa.\",\"rating\":9.0},\n  {\"id\":757304,\"suggestedTranslation\":\"Hyuyu, cẩn thận chân đấy!\",\"rating\":9.0},\n  {\"id\":757305,\"suggestgTranslation\":\"Khó mà làm sứt mẻ cái khúc đó được!\",\"rating\":9.0},\n  {\"id\":757306,\"suggestedTranslation\":\"Một vụ tai nạn tàu hỏa đúng nghĩa!\",\"rating\":9.0},\n  {\"id\":757307,\"suggestedTranslation\":\"Hai cái đầu á? Thế còn mông thì sao?\",\"rating\":9.0},\n  {\"id\":757308,\"suggestedTranslation\":\"Cái này lộn xộn hết cả lên rồi, hyuyu!\",\"rating\":9.0},\n  {\"id\":757309,\"suggestedTranslation\":\"Ngươi chắc chắn không muốn ăn một con tiểu yêu ngọt ngào như ta đâu!\",\"rating\":9.0},\n  {\"id\":757310,\"suggestedTranslation\":\"Ta thà được ngắm nụ cười đó từ cách xa cả dặm.\",\"rating\":9.0},\n  {\"id\":757311,\"suggestedTranslation\":\"Cái thứ đó trông cứ bám dính lấy thế nào ấy.\",\"rating\":9.0},\n  {\"id\":757312,\"suggestedTranslation\":\"Một nỗi sợ, cất cánh bay cao!\",\"rating\":9.0},\n  {\"id\":757313,\"suggestedTranslation\":\"Kẻ thù sẽ phải chùn bước, khi chúng thấy bộ vuốt này.\",\"rating\":9.0},\n  {\"id\":757314,\"suggestedTranslation\":\"Một chiếc chuông để gọi bò về!\",\"rating\":9.0},\n  {\"id\":757315,\"suggestedTranslation\":\"Mấy cái tay rảnh rỗi đó nên được bắt làm việc đi chứ, hyuyu!\",\"rating\":9.0},\n  {\"id\":757316,\"suggestedTranslation\":\"Làm việc suốt mà không chơi đùa sẽ biến một con tiểu yêu thành cáu kỉnh đấy.\",\"rating\":9.0},\n  {\"id\":757317,\"suggestedTranslation\":\"Và ngay cả ở đó, nó vẫn là một cái bẫy!\",\"rating\":9.0},\n  {\"id\":757318,\"suggestedTranslation\":\"Tội nghiệp linh hồn ấy.\",\"rating\":9.0},\n  {\"id\":757319,\"suggestedTranslation\":\"Đừng ăn ta nhé, lông của ta sẽ dính vào răng ngươi đấy!\",\"rating\":9.0},\n  {\"id\":757320,\"suggestedTranslation\":\"Đúng là một vị khách ngầu lòi, hyuyu!\",\"rating\":9.0},\n  {\"id\":757321,\"suggestedTranslation\":\"Khoan đã! Chúng ta có đủ muối chưa nhỉ?\",\"rating\":9.0},\n  {\"id\":757322,\"suggestedTranslation\":\"Tự hỏi có món đồ ngon nào ở bên trong không nhỉ?\",\"rating\":9.0},\n  {\"id\":757323,\"suggestedTranslation\":\"Ta vừa cướp nụ cười trên mặt hắn rồi đây, hyuyu!\",\"rating\":9.0},\n  {\"id\":757324,\"suggestedTranslation\":\"Ta có thể đào một cái hố thuộc về chính mình!\",\"rating\":9.0},\n  {\"id\":757325,\"suggestedTranslation\":\"Đào một cái hố đến nơi khỉ ho cò gáy nào đó!\",\"rating\":9.0},\n  {\"id\":757326,\"suggestedTranslation\":\"Chắc chắn như chất nhầy rỉ ra, cái này sẽ đưa ngươi vào giấc ngủ.\",\"rating\":9.0},\n  {\"id\":757327,\"suggestedTranslation\":\"E là bụng ta không còn chỗ trống nữa rồi.\",\"rating\":9.0},\n  {\"id\":757328,\"suggestedTranslation\":\"Vừa lấm chấm lại vừa bốc mùi!\",\"rating\":9.0},\n  {\"id\":757329,\"suggestedTranslation\":\"Cháy rụi, cháy trụi xuống tận mặt đất.\",\"rating\":9.0},\n  {\"id\":757330,\"suggestedTranslation\":\"Ta có thể chợp mắt một lát được đấy.\",\"rating\":9.0},\n  {\"id\":757331,\"suggestedTranslation\":\"Một món quà từ họ hàng nhà nhện.\",\"rating\":9.0},\n  {\"id\":757332,\"suggestedTranslation\":\"Một giọng nam trung đầy vỏ hàu!\",\"rating\":9.0},\n  {\"id\":757333,\"suggestedTranslation\":\"Những vỏ sò ca hát thật ngọt ngào!\",\"rating\":9.0},\n  {\"id\":757334,\"suggestedTranslation\":\"Giọng cao đến mức làm tai ta ngứa ngáy...\",\"rating\":9.0},\n  {\"id\":757335,\"suggestedTranslation\":\"Một sự tưởng niệm cảm động dành cho cặp song sinh quý giá.\",\"rating\":9.0},\n  {\"id\":757336,\"suggestedTranslation\":\"Có lẽ ta nên giữ khoảng cách thì hơn...\",\"rating\":9.0},\n  {\"id\":757337,\"suggestedTranslation\":\"Chẳng có ai xung quanh để phát ra âm thanh đó cả.\",\"rating\":9.0},\n  {\"id\":757338,\"suggestedTranslation\":\"Sự phù phiếm của loài hoa đánh đổi bằng tinh thần của ta! Hyuyu!\",\"rating\":9.0},\n  {\"id\":757339,\"suggestedTranslation\":\"Thêm chút hoa cho bóng ma của chúng ta nào!\",\"rating\":9.0},\n  {\"id\":757340,\"suggestedTranslation\":\"Linh hồn đã rời đi từ lâu rồi.\",\"rating\":9.0},\n  {\"id\":757341,\"suggestedTranslation\":\"Ú à, nó làm củ tiểu não của ta thấy nhột quá!\",\"rating\":9.0},\n  {\"id\":757342,\"suggestedTranslation\":\"Rất muốn ở lại trò chuyện nhưng trông ngươi chẳng có chút mỡ nào để mà nhai cả.\",\"rating\":9.0},\n  {\"id\":757343,\"suggestedTranslation\":\"Linh hồn của %s đã bay về trời từ lâu nhờ có %s.\",\"rating\":9.0},\n  {\"id\":757344,\"suggestedTranslation\":\"Linh hồ