            "text": "[\n  {\"id\":756647,\"suggestedTranslation\":\"Ồ, việc này sắp vui rồi đây! Hyuyuyu!\",\"rating\":9.0},\n  {\"id\":756648,\"suggestedTranslation\":\"Có một điều bất ngờ ở bên trong!\",\"rating\":9.0},\n  {\"id\":756649,\"suggestedTranslation\":\"Có một điều bất ngờ ở bên trong!\",\"rating\":9.0},\n  {\"id\":756650,\"suggestedTranslation\":\"Có một điều bất ngờ ở bên trong!\",\"rating\":9.0},\n  {\"id\":756651,\"suggestedTranslation\":\"Cậu có giọng nói buồn cười làm sao. Cứ vang vọng cả trong đầu tớ!\",\"rating\":9.0},\n  {\"id\":756652,\"suggestedTranslation\":\"Đi lạc, tìm thấy, giờ về nhà thôi!\",\"rating\":9.0},\n  {\"id\":756653,\"suggestedTranslation\":\"Sao không kết thúc một ngày bằng một giấc chợp mắt nhỏ nhỉ? Hyuyuyu!\",\"rating\":9.0},\n  {\"id\":756654,\"suggestedTranslation\":\"Ôi kẻ láu cá, cậu đã thay đổi rồi đấy!\",\"rating\":9.0},\n  {\"id\":756655,\"suggestedTranslation\":\"Tớ sẽ giúp một tay, nhưng nếu không vui thì tớ chuồn!\",\"rating\":9.0},\n  {\"id\":756656,\"suggestedTranslation\":\"Thật là nhiều âm mưu kỳ bí!\",\"rating\":9.0},\n  {\"id\":756657,\"suggestedTranslation\":\"Hyuyuyu, tớ không nghĩ tụi nó sẽ thích thế đâu...\",\"rating\":9.0},\n  {\"id\":756658,\"suggestedTranslation\":\"Phép thuật này khiến đại não tớ thật mềm mại và bồng bềnh!\",\"rating\":9.0},\n  {\"id\":756659,\"suggestedTranslation\":\"Một cái hố sâu thẳm không có điểm dừng!\",\"rating\":9.0},\n  {\"id\":756660,\"suggestedTranslation\":\"Hyuyu! Các nhóc không ra ngoài được sao?\",\"rating\":9.0},\n  {\"id\":756661,\"suggestedTranslation\":\"Cháy, cháy, cháy rụi rồi.\",\"rating\":9.0},\n  {\"id\":756662,\"suggestedTranslation\":\"Lắm củi mồi quá, giờ thành tro tàn.\",\"rating\":9.0},\n  {\"id\":756663,\"suggestedTranslation\":\"Nó không còn nữa rồi.\",\"rating\":9.0},\n  {\"id\":756664,\"suggestedTranslation\":\"Cây lấp lánh ánh trăng.\",\"rating\":9.0},\n  {\"id\":756665,\"suggestedTranslation\":\"Nhìn nó kìa, tỏa sáng dưới ánh trăng!\",\"rating\":9.0},\n  {\"id\":756666,\"suggestedTranslation\":\"Tớ liếc thấy nó đã khô quắt.\",\"rating\":9.0},\n  {\"id\":756667,\"suggestedTranslation\":\"Ngươi là loại quái vật nào thế?\",\"rating\":9.0},\n  {\"id\":756668,\"suggestedTranslation\":\"Trứng của sinh vật vô cùng đáng sợ đó.\",\"rating\":9.0},\n  {\"id\":756669,\"suggestedTranslation\":\"Đó là nơi để làm tổ và nghỉ ngơi.\",\"rating\":9.0},\n  {\"id\":756670,\"suggestedTranslation\":\"Tớ không thích đồ ăn của loài người cho lắm.\",\"rating\":9.0},\n  {\"id\":756671,\"suggestedTranslation\":\"Xin đừng cắn tớ nhé.\",\"rating\":9.0},\n  {\"id\":756672,\"suggestedTranslation\":\"Tớ không có máu cho cậu đâu, đồ ngọt ngào ạ.\",\"rating\":9.0},\n  {\"id\":756673,\"suggestedTranslation\":\"Một cái túi hút máu bùng nổ!\",\"rating\":9.0},\n  {\"id\":756674,\"suggestedTranslation\":\"Tớ nghĩ là nó thối đấy.\",\"rating\":9.0},\n  {\"id\":756675,\"suggestedTranslation\":\"Không cần phải uốn éo, nó được làm cho Người Cá mà.\",\"rating\":9.0},\n  {\"id\":756676,\"suggestedTranslation\":\"Một sinh vật bò sát đáng yêu!\",\"rating\":9.0},\n  {\"id\":756677,\"suggestedTranslation\":\"Nó đầy máu của phàm nhân.\",\"rating\":9.0},\n  {\"id\":756678,\"suggestedTranslation\":\"Cơn lốc của tuổi trẻ.\",\"rating\":9.0},\n  {\"id\":756679,\"suggestedTranslation\":\"Kẻ đã khuất chẳng còn dùng đến nó nữa, thấy chưa.\",\"rating\":9.0},\n  {\"id\":756680,\"suggestedTranslation\":\"Tớ không cảm nhận thấy linh hồn nào bên trong cả.\",\"rating\":9.0},\n  {\"id\":756681,\"suggestedTranslation\":\"Có lẽ tớ sẽ nghiền ngẫm nó, hyuyu!\",\"rating\":9.0},\n  {\"id\":756682,\"suggestedTranslation\":\"Tớ có thể đến và đi tùy thích.\",\"rating\":9.0},\n  {\"id\":756683,\"suggestedTranslation\":\"Uuu, chúng ta có thể chơi những trò chơi thú vị gì trong đó nhỉ!\",\"rating\":9.0},\n  {\"id\":756684,\"suggestedTranslation\":\"Nó không quyết định được nên làm món gì, thế là thành cả hai.\",\"rating\":9.0},\n  {\"id\":756685,\"suggestedTranslation\":\"Tớ đã nhầm tên mập mạp đó với một cây nấm mỡ! Hyuyu!\",\"rating\":9.0},\n  {\"id\":756686,\"suggestedTranslation\":\"Tớ sẽ đứng thật xa!\",\"rating\":9.0},\n  {\"id\":756687,\"suggestedTranslation\":\"Tớ sẽ dính bào tử nấm trên sừng cả mấy ngày liền.\",\"rating\":9.0},\n  {\"id\":756688,\"suggestedTranslation\":\"Thật đáng tiếc.\",\"rating\":9.0},\n  {\"id\":756689,\"suggestedTranslation\":\"Chà chà! Chúng ta có gì ở đây nào?\",\"rating\":9.0},\n  {\"id\":756690,\"suggestedTranslation\":\"Không còn nấm nào ở đây nữa rồi!\",\"rating\":9.0},\n  {\"id\":756691,\"suggestedTranslation\":\"Chỉ là một khúc gỗ nếu cậu hỏi tớ!\",\"rating\":9.0},\n  {\"id\":756692,\"suggestedTranslation\":\"Ồ tốt quá! Phàm nhân thường hay nổi cáu khi đói bụng.\",\"rating\":9.0},\n  {\"id\":756693,\"suggestedTranslation\":\"Tớ không nghĩ phàm nhân sẽ ăn thứ đó đâu.\",\"rating\":9.0},\n  {\"id\":756694,\"suggestedTranslation\":\"Khúc gỗ nhỏ tí xíu đóng băng.\",\"rating\":9.0},\n  {\"id\":756695,\"suggestedTranslation\":\"Tớ không muốn chúng, nhưng phàm nhân có thể thích đấy.\",\"rating\":9.0},\n  {\"id\":756696,\"suggestedTranslation\":\"Phàm nhân sẽ rất rất hài lòng cho xem.\",\"rating\":9.0},\n  {\"id\":756697,\"suggestedTranslation\":\"Giờ thì chúng ta được định sẵn phải chìm vào bóng tối.\",\"rating\":9.0},\n  {\"id\":756698,\"suggestedTranslation\":\"Nó cần thêm một chút tia lửa.\",\"rating\":9.0},\n  {\"id\":756699,\"suggestedTranslation\":\"Một chiếc đèn đốm để xua đuổi bóng tối.\",\"rating\":9.0},\n  {\"id\":756700,\"suggestedTranslation\":\"Ánh sáng đã vụt tắt từ lâu.\",\"rating\":9.0},\n  {\"id\":756701,\"suggestedTranslation\":\"Khi nó tắt đi tớ cảm thấy vô cùng sợ hãi.\",\"rating\":9.0},\n  {\"id\":756702,\"suggestedTranslation\":\"Tớ khá thích khi nó chuyển sang màu đỏ!\",\"rating\":9.0},\n  {\"id\":756703,\"suggestedTranslation\":\"Tớ nghĩ là nó thối đấy.\",\"rating\":9.0},\n  {\"id\":756704,\"suggestedTranslation\":\"Thật là kỳ lạ một cách bất thường!\",\"rating\":9.0},\n  {\"id\":756705,\"suggestedTranslation\":\"Một cây nấm khổng lồ! Hay tớ đã tuốc nhầm thuốc thu nhỏ nhỉ?\",\"rating\":9.0},\n  {\"id\":756706,\"suggestedTranslation\":\"Ai đó đã chơi khăm nó một vố.\",\"rating\":9.0},\n  {\"id\":756707,\"suggestedTranslation\":\"Tớ nghĩ là nó thối đấy.\",\"rating\":9.0},\n  {\"id\":756708,\"suggestedTranslation\":\"Hyuyu! Thật thảm hại làm sao!\",\"rating\":9.0},\n  {\"id\":756709,\"suggestedTranslation\":\"Một cây nấm khổng lồ! Hay tớ đã tuốc nhầm thuốc thu nhỏ nhỉ?\",\"rating\":9.0},\n  {\"id\":756710,\"suggestedTranslation\":\"Tớ nghĩ là nó thối đấy.\",\"rating\":9.0},\n  {\"id\":756711,\"suggestedTranslation\":\"Kinh tởm một cách thú vị!\",\"rating\":9.0},\n  {\"id\":756712,\"suggestedTranslation\":\"Một cây nấm khổng lồ! Hay tớ đã tuốc nhầm thuốc thu nhỏ nhỉ?\",\"rating\":9.0},\n  {\"id\":756713,\"suggestedTranslation\":\"Tớ nghĩ là nó thối đấy.\",\"rating\":9.0},\n  {\"id\":756714,\"suggestedTranslation\":\"Nó đang ngại nên mới đeo mạng che mặt kìa.\",\"rating\":9.0},\n  {\"id\":756715,\"suggestedTranslation\":\"Tớ thích con gấu trọc hơn... chút xíu.\",\"rating\":9.0},\n  {\"id\":756716,\"suggestedTranslation\":\"Con chim đó thật ngớ ngẩn.\",\"rating\":9.0},\n  {\"id\":756717,\"suggestedTranslation\":\"Nó ăn thịt, vòng lặp cứ thế lặp lại!\",\"rating\":9.0},\n  {\"id\":756718,\"suggestedTranslation\":\"Một con diều hâu ư? Thật ngớ ngẩn!\",\"rating\":9.0},\n  {\"id\":756719,\"suggestedTranslation\":\"Chà, trông cậu bảnh đấy! Mới cắt tóc à?\",\"rating\":9.0},\n  {\"id\":756720,\"suggestedTranslation\":\"Con quái vật vô hồn.\",\"rating\":9.0},\n  {\"id\":756721,\"suggestedTranslation\":\"Sẽ thế nào nếu thực ra tớ đang bị lộn mặt trái ra ngoài, còn nó mới là mặt phải?\",\"rating\":9.0},\n  {\"id\":756722,\"suggestedTranslation\":\"Tâm trí nó đã bay đi đâu mất rồi, hyuyu.\",\"rating\":9.0},\n  {\"id\":756723,\"suggestedTranslation\":\"Chú cún này đã được đại tu nhan sắc rồi đây!\",\"rating\":9.0},\n  {\"id\":756724,\"suggestedTranslation\":\"Chết không thể nào chết hơn được nữa!\",\"rating\":9.0},\n  {\"id\":756725,\"suggestedTranslation\":\"Hyuyu! Gì mà cái mặt trông kinh thế!\",\"rating\":9.0},\n  {\"id\":756726,\"suggestedTranslation\":\"Tâm trí nó đã bay đi đâu mất rồi, hyuyu.\",\"rating\":9.0},\n  {\"id\":756727,\"suggestedTranslation\":\"Một món ăn ngon lành cho mấy tên khủng bố nhí đó!\",\"rating\":9.0},\n  {\"id\":756728,\"suggestedTranslation\":\"Một món ăn ngon lành cho mấy tên khủng bố nhí đó!\",\"rating\":9.0},\n  {\"id\":756729,\"suggestedTranslation\":\"Một món ăn ngon lành cho mấy tên khủng bố nhí đó!\",\"rating\":9.0},\n  {\"id\":756730,\"suggestedTranslation\":\"Một món ăn ngon lành cho mấy tên khủng bố nhí đó!\",\"rating\":9.0},\n  {\"id\":756731,\"suggestedTranslation\":\"Một món ăn ngon lành cho mấy tên khủng bố nhí đó!\",\"rating\":9.0},\n  {\"id\":756732,\"suggestedTranslation\":\"Một món ăn ngon lành cho mấy tên khủng bố nhí đó!\",\"rating\":9.0},\n  {\"id\":756733,\"suggestedTranslation\":\"Một món ăn ngon lành cho mấy tên khủng bố nhí đó!\",\"rating\":9.0},\n  {\"id\":756734,\"suggestedTranslation\":\"Chắc là gieo nhân nào gặt quả nấy thôi, hyuyu!\",\"rating\":9.0},\n  {\"id\":756735,\"suggestedTranslation\":\"Hãy giữ cho những giấc mơ của cậu luôn ấm áp và thoải mái trong cái đầu ngái ngủ nhé.\",\"rating\":9.0},\n  {\"id\":756736,\"suggestedTranslation\":\"Trời đất thánh thần ơi, vật trang trí tuyệt vời gì thế này!\",\"rating\":9.0},\n  {\"id\":756737,\"suggestedTranslation\":\"Hyuyu! Nó nhão nhợt.\",\"rating\":9.0},\n  {\"id\":756738,\"suggestedTranslation\":\"Tớ nghĩ tốt nhất chúng ta nên đi thôi!\",\"rating\":9.0},\n  {\"id\":756739,\"suggestedTranslation\":\"Cẩn thận, cẩn thận đấy, nó cứ thì thầm với tớ thế.\",\"rating\":9.0},\n  {\"id\":756740,\"suggestedTranslation\":\"Hyuyu, con người đúng là kỳ lạ thật.\",\"rating\":9.0},\n  {\"id\":756741,\"suggestedTranslation\":\"Hôm nay không có trò chơi nào để chơi cả.\",\"rating\":9.0},\n  {\"id\":756742,\"suggestedTranslation\":\"Thời gian vui chơi sắp kết thúc rồi.\",\"rating\":9.0},\n  {\"id\":756743,\"suggestedTranslation\":\"Một chiếc huy chương vui nhộn cho một tên lưu manh vui tính hơn!\",\"rating\":9.0},\n  {\"id\":756744,\"suggestedTranslation\":\"Hyuyu! Vui quá đi!\",\"rating\":9.0},\n  {\"id\":756745,\"suggestedTranslation\":\"Ồ, sự hỗn loạn đang tan biến dần kìa.\",\"rating\":9.0},\n  {\"id\":756746,\"suggestedTranslation\":\"Tớ đang thấy hào hứng quá đi mất!\",\"rating\":9.0},\n  {\"id\":756747,\"suggestedTranslation\":\"Uuu, nó đang tăng nhiệt rồi kìa!\",\"rating\":9.0},\n  {\"id\":756748,\"suggestedTranslation\":\"Thắp sáng cho mọi trận chiến.\",\"rating\":9.0},\n  {\"id\":756749,\"suggestedTranslation\":\"Để chém và đâm!\",\"rating\":9.0},\n  {\"id\":756750,\"suggestedTranslation\":\"Tớ hoàn toàn không có manh mối gì về cách dùng thứ này.\",\"rating\":9.0},\n  {\"id\":756751,\"suggestedTranslation\":\"Qua một thời gian nó tạo thành một đống.\",\"rating\":9.0},\n  {\"id\":756752,\"suggestedTranslation\":\"Không trượt phát nào khi tớ nhảy chân sáo!\",\"rating\":9.0},\n  {\"id\":756753,\"suggestedTranslation\":\"Lần trước tớ trượt băng, suýt thì chầu diêm vương. Hyuyu!\",\"rating\":9.0},\n  {\"id\":756754,\"suggestedTranslation\":\"Vương miện của người làm vườn đội lên chiếc trán lông lá của tớ.\",\"rating\":9.0},\n  {\"id\":756755,\"suggestedTranslation\":\"Tớ sẽ dùng cái này hất nước lên lũ bạn cho xem!\",\"rating\":9.0},\n  {\"id\":756756,\"suggestedTranslation\":\"Đúng là mái chèo rồi, khỏi bàn cãi!\",\"rating\":9.0},\n  {\"id\":756757,\"suggestedTranslation\":\"Nên đánh nhau hay chèo thuyền đây?\",\"rating\":9.0},\n  {\"id\":756758,\"suggestedTranslation\":\"Hôm nay không bơi lội gì hết!\",\"rating\":9.0},\n  {\"id\":756759,\"suggestedTranslation\":\"Bơi lội làm tớ có mùi yêu tinh ướt át.\",\"rating\":9.0},\n  {\"id\":756760,\"suggestedTranslation\":\"Tớ sẽ nặn nó thành một cái bánh bùn ngon tuyệt! Hyuyu.\",\"rating\":9.0},\n  {\"id\":756761,\"suggestedTranslation\":\"Tớ đang có một kho