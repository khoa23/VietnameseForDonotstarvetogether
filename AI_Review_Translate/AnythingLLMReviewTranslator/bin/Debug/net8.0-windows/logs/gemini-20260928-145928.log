"id\": 757815, \"suggestedTranslation\": \"Một thợ máy tự động bằng cơ khí? Quá đỉnh!\", \"rating\": 9.0},\n  {\"id\": 757816, \"suggestedTranslation\": \"Cái này chắc sẽ giúp ta xả bớt chút bực bội, hyuyu!\", \"rating\": 9.0},\n  {\"id\": 757817, \"suggestedTranslation\": \"Ta đành phải bằng lòng với đống phế liệu kim loại này vậy.\", \"rating\": 9.0},\n  {\"id\": 757818, \"suggestedTranslation\": \"Bớt lải nhải đi! Không ai qua được đâu! Hyuyu!\", \"rating\": 9.0},\n  {\"id\": 757819, \"suggestedTranslation\": \"Tuyệt cú mèo! Lại thêm sàn nhà!\", \"rating\": 9.0},\n  {\"id\": 757820, \"suggestedTranslation\": \"Kéo cái này có lịch sự không ta?\", \"rating\": 9.0},\n  {\"id\": 757821, \"suggestedTranslation\": \"Chúng ta có gì ở đây thế này? Ý đồ của hắn chẳng bao giờ rõ ràng cả!\", \"rating\": 9.0},\n  {\"id\": 757822, \"suggestedTranslation\": \"Chiếc găng tay đang ở cõi thực á? Chắc ta phát điên mất thôi!\", \"rating\": 9.0},\n  {\"id\": 757823, \"suggestedTranslation\": \"Bảng kẹp giấy là thật đấy, ta hét lên vì sung sướng luôn! Hyuyu!\", \"rating\": 9.0},\n  {\"id\": 757824, \"suggestedTranslation\": \"Cả đống này đã bị bỏ mặc cho mục rữa rồi.\", \"rating\": 9.0},\n  {\"id\": 757825, \"suggestedTranslation\": \"Chữ viết của một kẻ có tầm nhìn, hay lời sằng sọc của một kẻ điên? Ai mà biết được!\", \"rating\": 9.0},\n  {\"id\": 757826, \"suggestedTranslation\": \"Hyuyuyu! Lão ta không được bình thường cho lắm!\", \"rating\": 9.0},\n  {\"id\": 757827, \"suggestedTranslation\": \"Ta có nên giúp lão hoàn thành danh sách việc cần làm không nhỉ?\", \"rating\": 9.0},\n  {\"id\": 757828, \"suggestedTranslation\": \"Biết đâu lão đang muộn một cuộc hẹn quan trọng thì sao.\", \"rating\": 9.0},\n  {\"id\": 757829, \"suggestedTranslation\": \"Hú hu! Ngươi không phải người ở cõi này đúng không?\", \"rating\": 9.0},\n  {\"id\": 757830, \"suggestedTranslation\": \"Ngươi thuộc về tay của lão già đó đấy.\", \"rating\": 9.0},\n  {\"id\": 757831, \"suggestedTranslation\": \"Đây có thể là thứ ta đang tìm, hoặc không!\", \"rating\": 9.0},\n  {\"id\": 757832, \"suggestedTranslation\": \"Ooo vui ghê! Ta chẳng chắc đây có phải món đúng không nữa!\", \"rating\": 9.0},\n  {\"id\": 757833, \"suggestedTranslation\": \"Đúng là một trò vui, đi tìm công cụ từ cõi khác!\", \"rating\": 9.0},\n  {\"id\": 757834, \"suggestedTranslation\": \"Đó chỉ là phương án cuối cùng thôi, đồ hay lo bò trắng răng!\", \"rating\": 9.0},\n  {\"id\": 757835, \"suggestedTranslation\": \"Đó chỉ là phương án cuối cùng thôi, đồ hay lo bò trắng răng!\", \"rating\": 9.0},\n  {\"id\": 757836, \"suggestedTranslation\": \"Đó chỉ là phương án cuối cùng thôi, đồ hay lo bò trắng răng!\", \"rating\": 9.0},\n  {\"id\": 757837, \"suggestedTranslation\": \"Phương án cuối cùng, được trang hoàng để làm cảnh.\", \"rating\": 9.0},\n  {\"id\": 757838, \"suggestedTranslation\": \"Gậy chống để đi lại cho nhanh.\", \"rating\": 9.0},\n  {\"id\": 757839, \"suggestedTranslation\": \"Để nhốt ngươi ngoài, hay giam ta trong?\", \"rating\": 9.0},\n  {\"id\": 757840, \"suggestedTranslation\": \"Vứt dưới đất thế kia thì có tích sự gì.\", \"rating\": 9.0},\n  {\"id\": 757841, \"suggestedTranslation\": \"Quả là một trò đùa ngớ ngẩn.\", \"rating\": 9.0},\n  {\"id\": 757842, \"suggestedTranslation\": \"Để nhốt ngươi ngoài, hay giam ta trong?\", \"rating\": 9.0},\n  {\"id\": 757843, \"suggestedTranslation\": \"Vứt dưới đất thế kia thì có tích sự gì.\", \"rating\": 9.0},\n  {\"id\": 757844, \"suggestedTranslation\": \"Để nhốt ngươi ngoài, hay giam ta trong?\", \"rating\": 9.0},\n  {\"id\": 757845, \"suggestedTranslation\": \"Vứt dưới đất thế kia thì có tích sự gì.\", \"rating\": 9.0},\n  {\"id\": 757846, \"suggestedTranslation\": \"Để nhốt ngươi ngoài, hay giam ta trong?\", \"rating\": 9.0},\n  {\"id\": 757847, \"suggestedTranslation\": \"Để nhốt ngươi ngoài, hay giam ta trong?\", \"rating\": 9.0}\n]",
