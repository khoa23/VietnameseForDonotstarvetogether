            "text": "[\n  {\"id\": 757848, \"suggestedTranslation\": \"Nằm dưới đất thì chẳng ích gì đâu.\", \"rating\": 9.0},\n  {\"id\": 757849, \"suggestedTranslation\": \"Ai mà ngờ được cơ chứ? Một bức tường toàn đồ phế liệu.\", \"rating\": 9.0},\n  {\"id\": 757850, \"suggestedTranslation\": \"Ai mà ngờ được cơ chứ? Một bức tường toàn đồ phế liệu.\", \"rating\": 9.0},\n  {\"id\": 757851, \"suggestedTranslation\": \"Để cản ngươi ở ngoài, hay nhốt ta ở trong?\", \"rating\": 9.0},\n  {\"id\": 757852, \"suggestedTranslation\": \"Để cản ngươi ở ngoài, hay nhốt ta ở trong?\", \"rating\": 9.0},\n  {\"id\": 757853, \"suggestedTranslation\": \"Nằm dưới đất thì chẳng ích gì đâu.\", \"rating\": 9.0},\n  {\"id\": 757854, \"suggestedTranslation\": \"Quả là một trò đùa ngớ ngẩn.\", \"rating\": 9.0},\n  {\"id\": 757855, \"suggestedTranslation\": \"Để cản ngươi ở ngoài, hay nhốt ta ở trong?\", \"rating\": 9.0},\n  {\"id\": 757856, \"suggestedTranslation\": \"Nằm dưới đất thì chẳng ích gì đâu.\", \"rating\": 9.0},\n  {\"id\": 757857, \"suggestedTranslation\": \"Sừng của hắn mọc ngược hướng mất rồi.\", \"rating\": 9.0},\n  {\"id\": 757858, \"suggestedTranslation\": \"Trông mình mặc áo kẻ sọc có đẹp không nhỉ?\", \"rating\": 9.0},\n  {\"id\": 757859, \"suggestedTranslation\": \"Lũ hải cẩu có vẻ không mặn mà lắm. Chẳng thấy bóng dáng ai ở đây cả!\", \"rating\": 9.0},\n  {\"id\": 757860, \"suggestedTranslation\": \"Chúng sẽ chẳng lang thang, đi quá xa nhà đâu.\", \"rating\": 9.0},\n  {\"id\": 757861, \"suggestedTranslation\": \"Một chiếc sừng mọc lệch trên gương mặt già cỗi.\", \"rating\": 9.0},\n  {\"id\": 757862, \"suggestedTranslation\": \"Đang gây chút rắc rối hả, %s?\", \"rating\": 9.0},\n  {\"id\": 757863, \"suggestedTranslation\": \"Luật là để phá vỡ mà, hyuyuyu!\", \"rating\": 9.0},\n  {\"id\": 757864, \"suggestedTranslation\": \"Dạo này có giúp ai qua đường không thế, %s?\", \"rating\": 9.0},\n  {\"id\": 757865, \"suggestedTranslation\": \"Ta xin cắn một miếng thôi... hyuyu ta đùa đấy!\", \"rating\": 9.0},\n  {\"id\": 757866, \"suggestedTranslation\": \"Ái chà! Ta khá thích thế giới này, chẳng muốn rời đi chút nào!\", \"rating\": 9.0},\n  {\"id\": 757867, \"suggestedTranslation\": \"Hyuyu! Thật là một linh hồn hay giúp đỡ!\", \"rating\": 9.0},\n  {\"id\": 757868, \"suggestedTranslation\": \"Quỷ lùn và quân phục hiếm khi hợp nhau lắm.\", \"rating\": 9.0},\n  {\"id\": 757869, \"suggestedTranslation\": \"Hyuyuyu, ta không nghĩ cô ta thích trò đùa vừa rồi của ta đâu.\", \"rating\": 9.0},\n  {\"id\": 757870, \"suggestedTranslation\": \"Ố hô, phiền cho ta tham gia với?\", \"rating\": 9.0},\n  {\"id\": 757871, \"suggestedTranslation\": \"Dạo gần đây ngươi có ghé qua thời gian nào thú vị không thế, %s?\", \"rating\": 9.0},\n  {\"id\": 757872, \"suggestedTranslation\": \"Trông ngươi có vẻ ngon lành hơn thường lệ đấy, %s!\", \"rating\": 9.0},\n  {\"id\": 757873, \"suggestedTranslation\": \"Ngươi sẽ không nỡ giết một tên quỷ lùn đang thời xuân sắc chứ?\", \"rating\": 9.0},\n  {\"id\": 757874, \"suggestedTranslation\": \"Hyuyu, may là %s có vẻ không rành về sức mạnh linh hồn lắm.\", \"rating\": 9.0},\n  {\"id\": 757875, \"suggestedTranslation\": \"Ồ, con bò lai kỳ lạ ghê!\", \"rating\": 9.0},\n  {\"id\": 757876, \"suggestedTranslation\": \"Bộ cải trang của tay này kìa! Hyuyu!\", \"rating\": 9.0},\n  {\"id\": 757877, \"suggestedTranslation\": \"Có kẻ đang chơi trò đùa tai quái đấy.\", \"rating\": 9.0},\n  {\"id\": 757878, \"suggestedTranslation\": \"Chiều không gian thời trang đã bị phong ấn rồi.\", \"rating\": 9.0},\n  {\"id\": 757879, \"suggestedTranslation\": \"Cánh cổng dẫn đến chiều không gian thời trang.\", \"rating\": 9.0},\n  {\"id\": 757880, \"suggestedTranslation\": \"Ta sẽ không làm bữa tiệc cho con quái vật đó đâu!\", \"rating\": 9.0},\n  {\"id\": 757881, \"suggestedTranslation\": \"Cục xúc xích nóng hổi này thiếu mất chiếc bánh mì rồi.\", \"rating\": 9.0},\n  {\"id\": 757882, \"suggestedTranslation\": \"Con chó hoang cứ quẩn quanh mãi trong lối mòn, hyuyu!\", \"rating\": 9.0},\n  {\"id\": 757883, \"suggestedTranslation\": \"Cái chết không giữ chân được sao? Chắc là một chiêu trò mới đây.\", \"rating\": 9.0},\n  {\"id\": 757884, \"suggestedTranslation\": \"Ngươi không muốn ăn thịt ta đâu, quỷ lùn ăn vào khó tiêu lắm đấy!\", \"rating\": 9.0},\n  {\"id\": 757885, \"suggestedTranslation\": \"Thế là hết.\", \"rating\": 9.0},\n  {\"id\": 757886, \"suggestedTranslation\": \"Gầm gừ và cằn nhằn, nó đang muốn ăn thịt kìa!\", \"rating\": 9.0},\n  {\"id\": 757887, \"suggestedTranslation\": \"Hãy cùng ăn mừng nào!\", \"rating\": 9.0},\n  {\"id\": 757888, \"suggestedTranslation\": \"Ta nghĩ %s đang gây ra vài rắc rối đấy. Vui thật chứ!\", \"rating\": 9.0},\n  {\"id\": 757889, \"suggestedTranslation\": \"Ồ, hôm nay chúng ta chơi trò chơi khăm à, %s?\", \"rating\": 9.0},\n  {\"id\": 757890, \"suggestedTranslation\": \"%s đúng là thích đồ ăn thật. Ta chẳng tài nào hiểu nổi loài người.\", \"rating\": 9.0},\n  {\"id\": 757891, \"suggestedTranslation\": \"Đầu bếp nay lại thành món ăn rồi, hyuyu!\", \"rating\": 9.0},\n  {\"id\": 757892, \"suggestedTranslation\": \"Đừng đánh ta mà-hí-hí!\", \"rating\": 9.0},\n  {\"id\": 757893, \"suggestedTranslation\": \"Đoán là %s không có hứng thú với linh hồn nhỉ.\", \"rating\": 9.0},\n  {\"id\": 757894, \"suggestedTranslation\": \"Xứng tầm với một kẻ đáng sợ.\", \"rating\": 9.0},\n  {\"id\": 757895, \"suggestedTranslation\": \"Ta có muốn châm ngòi chút rắc rối không nhỉ?\", \"rating\": 9.0},\n  {\"id\": 757896, \"suggestedTranslation\": \"Ngươi sẽ chẳng bao giờ thấy ta đến đâu!\", \"rating\": 9.0},\n  {\"id\": 757897, \"suggestedTranslation\": \"Hết nước đổ ra rồi, phải múc đầy lại thôi!\", \"rating\": 9.0},\n  {\"id\": 757898, \"suggestedTranslation\": \"Một chiếc bình tưới nước, kế hoạch tuyệt làm sao!\", \"rating\": 9.0},\n  {\"id\": 757899, \"suggestedTranslation\": \"Ta không muốn ăn nó.\", \"rating\": 9.0},\n  {\"id\": 757900, \"suggestedTranslation\": \"Những chiếc sừng dính bết đang chờ kìa.\", \"rating\": 9.0},\n  {\"id\": 757901, \"suggestedTranslation\": \"Trông có vẻ tiêu hóa được.\", \"rating\": 9.0},\n  {\"id\": 757902, \"suggestedTranslation\": \"Ôi trời ơi, không không không!\", \"rating\": 9.0},\n  {\"id\": 757903, \"suggestedTranslation\": \"Giá mà nó có một linh hồn!\", \"rating\": 9.0},\n  {\"id\": 757904, \"suggestedTranslation\": \"Trồng một hạt giống, ngươi sẽ có thứ để ăn!\", \"rating\": 9.0},\n  {\"id\": 757905, \"suggestedTranslation\": \"Ta cứ có cảm giác như mình lạc vào Xứ sở thần tiên vậy, hyuyu!\", \"rating\": 9.0},\n  {\"id\": 757906, \"suggestedTranslation\": \"Ta đoán là nó chưa đạt kích thước tối đa đâu.\", \"rating\": 9.0},\n  {\"id\": 757907, \"suggestedTranslation\": \"Cái thực vật đó ích kỷ thật, chẳng thèm chia sẻ động vật có vỏ gì cả!\", \"rating\": 9.0},\n  {\"id\": 757908, \"suggestedTranslation\": \"Một mầm cây bụ bẫm đáng yêu.\", \"rating\": 9.0},\n  {\"id\": 757909, \"suggestedTranslation\": \"Cái này sẽ dập tắt nhanh mấy trò đùa bằng lửa...\", \"rating\": 9.0},\n  {\"id\": 757910, \"suggestedTranslation\": \"Hình như chúng ta vừa tìm được một két sắt an toàn, hyuyu!\", \"rating\": 9.0},\n  {\"id\": 757911, \"suggestedTranslation\": \"Hyuyuyu! Ngươi đừng mơ gạt được ta bằng mấy cái rễ ranh rinh đó!\", \"rating\": 9.0},\n  {\"id\": 757912, \"suggestedTranslation\": \"Đừng đánh ta!\", \"rating\": 9.0},\n  {\"id\": 757913, \"suggestedTranslation\": \"%s đang có những giây phút cực kỳ vui vẻ!\", \"rating\": 9.0},\n  {\"id\": 757914, \"suggestedTranslation\": \"%s này, câu chuyện thần thoại nào của cô có nhắc đến quỷ lùn không?\", \"rating\": 9.0},\n  {\"id\": 757915, \"suggestedTranslation\": \"Ngươi có định ăn cái đó không đấy?\", \"rating\": 9.0},\n  {\"id\": 757916, \"suggestedTranslation\": \"Ái chà! Đừng giết ta!\", \"rating\": 9.0},\n  {\"id\": 757917, \"suggestedTranslation\": \"Hô hô! %s vừa chìa tay giúp đỡ một linh hồn kìa!\", \"rating\": 9.0},\n  {\"id\": 757918, \"suggestedTranslation\": \"Hy vọng nó vừa với cặp sừng của ta.\", \"rating\": 9.0},\n  {\"id\": 757919, \"suggestedTranslation\": \"Trời sinh một sừng thì đành chịu một sừng vậy.\", \"rating\": 9.0},\n  {\"id\": 757920, \"suggestedTranslation\": \"Cô ấy sẽ dùng chiếc khiên này trên chiến trường.\", \"rating\": 9.0},\n  {\"id\": 757921, \"suggestedTranslation\": \"Nó được giữ tươi ngon nhờ nỗi sợ.\", \"rating\": 9.0},\n  {\"id\": 757922, \"suggestedTranslation\": \"Cuộn giấy gói sáp nhỏ nhắn.\", \"rating\": 9.0},\n  {\"id\": 757923, \"suggestedTranslation\": \"Đừng nhắm vào sừng chứ!\", \"rating\": 9.0},\n  {\"id\": 757924, \"suggestedTranslation\": \"%s, hóa ra ngươi cũng có khiếu hài hước đấy chứ!\", \"rating\": 9.0},\n  {\"id\": 757925, \"suggestedTranslation\": \"Tên đó cũng có chút phép thuật đấy.\", \"rating\": 9.0},\n  {\"id\": 757926, \"suggestedTranslation\": \"Trông linh hồn ngon miệng làm sao!\", \"rating\": 9.0},\n  {\"id\": 757927, \"suggestedTranslation\": \"Ái chà! Đừng đày ải ta khỏi thế giới này!\", \"rating\": 9.0},\n  {\"id\": 757928, \"suggestedTranslation\": \"Cảm ơn, cảm ơn %s nhé!\", \"rating\": 9.0},\n  {\"id\": 757929, \"suggestedTranslation\": \"Ta không nghĩ hắn biết cách dùng nó đâu.\", \"rating\": 9.0},\n  {\"id\": 757930, \"suggestedTranslation\": \"Xin đừng kéo đuôi ta!\", \"rating\": 9.0},\n  {\"id\": 757931, \"suggestedTranslation\": \"%s đang chơi rất vui vẻ!\", \"rating\": 9.0},\n  {\"id\": 757932, \"suggestedTranslation\": \"Xin chào chú nhện tí hon nhé!\", \"rating\": 9.0},\n  {\"id\": 757933, \"suggestedTranslation\": \"Ồ đừng lo, ta không ăn ngươi đâu.\", \"rating\": 9.0},\n  {\"id\": 757934, \"suggestedTranslation\": \"Ngươi không nỡ sát hại một tên quỷ lùn vô tội chứ?\", \"rating\": 9.0},\n  {\"id\": 757935, \"suggestedTranslation\": \"Hô hô, tên quái vật nhỏ đó mềm lòng trước các linh hồn ghê.\", \"rating\": 9.0},\n  {\"id\": 757936, \"suggestedTranslation\": \"Hừm. Có tận hai linh hồn bị kẹt bên trong.\", \"rating\": 9.0},\n  {\"id\": 757937, \"suggestedTranslation\": \"Những chú nhện tí hon ơi là tí hon!!\", \"rating\": 9.0},\n  {\"id\": 757938, \"suggestedTranslation\": \"Trông nó có vẻ hơi cuộn xoắn lại.\", \"rating\": 9.0},\n  {\"id\": 757939, \"suggestedTranslation\": \"Ta không thích trò chơi mà ngươi đang chơi đâu.\", \"rating\": 9.0},\n  {\"id\": 757940, \"suggestedTranslation\": \"Hyuyu, trông ngươi hài hước ghê, %s!\", \"rating\": 9.0},\n  {\"id\": 757941, \"suggestedTranslation\": \"Móng vuốt của ta làm ngươi sợ à? Hyuyu!\", \"rating\": 9.0},\n  {\"id\": 757942, \"suggestedTranslation\": \"Đừng lo, ta không định ăn ngươi đâu.\", \"rating\": 9.0},\n  {\"id\": 757943, \"suggestedTranslation\": \"Ta chỉ đùa thôi mà! Xin đừng đánh ta!\", \"rating\": 9.0},\n  {\"id\": 757944, \"suggestedTranslation\": \"Cảm ơn vì đã không ăn linh hồn đó nhé, %s!\", \"rating\": 9.0},\n  {\"id\": 757945, \"suggestedTranslation\": \"Một chiếc bình phòng hờ!\", \"rating\": 9.0},\n  {\"id\": 757946, \"suggestedTranslation\": \"Ta rất thích món bảo vật bị nguyền rủa đấy!\", \"rating\": 9.0},\n  {\"id\": 757947, \"suggestedTranslation\": \"Thả con ngỗng ra nào!\", \"rating\": 9.0},\n  {\"id\": 757948, \"suggestedTranslation\": \"Hươu sừng tấm á? Hươu đây chứ đâu!\", \"rating\": 9.0},\n  {\"id\": 757949, \"suggestedTranslation\": \"Mấy cú đấm đó không có trong kịch bản!\", \"rating\": 9.0},\n  {\"id\": 757950, \"suggestedTranslation\": \"Ố hố hố, ngươi vừa dở trò gì thế?\", \"rating\": 9.0},\n  {\"id\": 757951, \"suggestedTranslation\": \"%s, chúng ta luyện tập tiết mục thôi!\", \"rating\": 9.0},\n  {\"id\": 757952, \"suggestedTranslation\": \"%s, dạo này ngươi ngon miệng hơn phải không?\", \"rating\": 9.0},\n  {\"id\": 757953, \"suggestedTranslation\": \"Đừng đánh ta, %s!\", \"rating\": 9.0},\n  {\"id\": 757954, \"suggestedTranslation\": \"Cảm ơn, cảm ơn nhé, người bạn hài hước!\", \"rating\": 9.0},\n  {\"id\": 757955, \"suggestedTranslation\": \"Hyuyu! Gớm ghiếc làm sao.\", \"rating\": 9.0},\n  {\"id\": 757956, \"suggestedTr