},\n  {\"id\": 758172, \"suggestedTranslation\": \"Bất công quá! Linh kiện thừa kìa!\", \"rating\": 0.0},\n  {\"id\": 758173, \"suggestedTranslation\": \"Tốc hành WX!\", \"rating\": 0.0},\n  {\"id\": 758174, \"suggestedTranslation\": \"Nó bay đến những vùng không rõ rồi!\", \"rating\": 0.0},\n  {\"id\": 758175, \"suggestedTranslation\": \"Nó bắn ra sét á? Đáng sợ ghê!\", \"rating\": 0.0},\n  {\"id\": 758176, \"suggestedTranslation\": \"Nó sẽ không đáp lại người không phải người máy đâu.\", \"rating\": 0.0},\n  {\"id\": 758177, \"suggestedTranslation\": \"Không ngon miệng nếu chưa làm ẩm nó.\", \"rating\": 0.0},\n  {\"id\": 758178, \"suggestedTranslation\": \"Đã làm ẩm, nhưng vẫn không ngon miệng.\", \"rating\": 0.0},\n  {\"id\": 758179, \"suggestedTranslation\": \"Chúng định làm nhà cho một con ma...\", \"rating\": 0.0},\n  {\"id\": 758180, \"suggestedTranslation\": \"Từng là chiếc rương vô tận, bị bỏ lại bởi gã mặt sắt!\", \"rating\": 0.0},\n  {\"id\": 758182, \"suggestedTranslation\": \"Dùng lúc nguy cấp được đấy, hyuyu!\", \"rating\": 0.0},\n  {\"id\": 758183, \"suggestedTranslation\": \"Đây có phải điều ngươi muốn? Rằng cơ thể mình bị ám?\", \"rating\": 0.0},\n  {\"id\": 758184, \"suggestedTranslation\": \"Chà chà, lon sắt bay lượn kìa!\", \"rating\": 0.0},\n  {\"id\": 758185, \"suggestedTranslation\": \"Chà chà, lon sắt bay lượn kìa!\", \"rating\": 0.0},\n  {\"id\": 758186, \"suggestedTranslation\": \"Chà chà, lon sắt bay lượn kìa!\", \"rating\": 0.0},\n  {\"id\": 758187, \"suggestedTranslation\": \"Mối khủng bố lon bé nhỏ đã kiệt sức rồi!\", \"rating\": 0.0},\n  {\"id\": 758188, \"suggestedTranslation\": \"Nó đã làm việc vất vả, giờ bạn ta phải thu chiến lợi phẩm thôi.\", \"rating\": 0.0},\n  {\"id\": 758189, \"suggestedTranslation\": \"Nó đang canh chừng kẻ xấu đấy! Hyuyu!\", \"rating\": 0.0},\n  {\"id\": 758190, \"suggestedTranslation\": \"Kẻ thu gom chăm chỉ nhất khu vực này!\", \"rating\": 0.0},\n  {\"id\": 758191, \"suggestedTranslation\": \"Trời ạ, sao thứ đó lại ở đây nhỉ?\", \"rating\": 0.0},\n  {\"id\": 758192, \"suggestedTranslation\": \"Ta sẽ cho bộ não của mình nghỉ ngơi một chút.\", \"rating\": 0.0},\n  {\"id\": 758193, \"suggestedTranslation\": \"Từ dòng nham thạch rực sáng sắc vàng này.\", \"rating\": 0.0},\n  {\"id\": 758194, \"suggestedTranslation\": \"Để để lại dấu ấn một khi ta khởi hành.\", \"rating\": 0.0},\n  {\"id\": 758195, \"suggestedTranslation\": \"Nó gọi mặt trời ra khỏi bầu trời!\", \"rating\": 0.0},\n  {\"id\": 758196, \"suggestedTranslation\": \"Ối trời, chuyện đó có cố ý xảy ra không thế?\", \"rating\": 0.0},\n  {\"id\": 758197, \"suggestedTranslation\": \"Con bò lai này trông hơi trống trải.\", \"rating\": 0.0},\n  {\"id\": 758198, \"suggestedTranslation\": \"Nào ta cùng ăn mừng!\", \"rating\": 0.0},\n  {\"id\": 758199, \"suggestedTranslation\": \"Tận hưởng cuộc sống nhung lụa à? Hyuyuyu!\", \"rating\": 0.0},\n  {\"id\": 758200, \"suggestedTranslation\": \"Vị trọng tài của chúng ta có lẽ có vài điều muốn nói đấy.\", \"rating\": 0.0},\n  {\"id\": 758201, \"suggestedTranslation\": \"Tận hưởng cuộc sống nhung lụa à? Hyuyuyu!\", \"rating\": 0.0},\n  {\"id\": 758202, \"suggestedTranslation\": \"Vị trọng tài của chúng ta có lẽ có vài điều muốn nói đấy.\", \"rating\": 0.0},\n  {\"id\": 758203, \"suggestedTranslation\": \"Tận hưởng cuộc sống nhung lụa à? Hyuyuyu!\", \"rating\": 0.0},\n  {\"id\": 758204, \"suggestedTranslation\": \"Vị trọng tài của chúng ta có lẽ có vài điều muốn nói đấy.\", \"rating\": 0.0},\n  {\"id\": 758205, \"suggestedTranslation\": \"Tận hưởng cuộc sống nhung lụa à? Hyuyuyu!\", \"rating\": 0.0},\n  {\"id\": 758206, \"suggestedTranslation\": \"Vị trọng tài của chúng ta có lẽ có vài điều muốn nói đấy.\", \"rating\": 0.0},\n  {\"id\": 758207, \"suggestedTranslation\": \"Tận hưởng cuộc sống nhung lụa à? Hyuyuyu!\", \"rating\": 0.0},\n  {\"id\": 758208, \"suggestedTranslation\": \"Vị trọng tài của chúng ta có lẽ có vài điều muốn nói đấy.\", \"rating\": 0.0},\n  {\"id\": 758209, \