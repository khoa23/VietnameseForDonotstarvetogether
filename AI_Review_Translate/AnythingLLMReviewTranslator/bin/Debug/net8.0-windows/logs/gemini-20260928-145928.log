ion\":\"Ta có thể thấy sự hấp dẫn của một chiếc bánh lái.\",\"rating\":9.0},\n  {\"id\":757484,\"suggestedTranslation\":\"Cẩn thận cái hướng ngươi chĩa cái thứ đó vào đấy.\",\"rating\":9.0},\n  {\"id\":757485,\"suggestedTranslation\":\"Ta sẽ ngồi xuống đây và nghỉ ngơi đôi chân này.\",\"rating\":9.0},\n  {\"id\":757486,\"suggestedTranslation\":\"Tránh cái mông ra chỗ khác, ta muốn ngồi đây!\",\"rating\":9.0},\n  {\"id\":757487,\"suggestedTranslation\":\"Giờ thì, cục diện sẽ đảo ngược chứ?\",\"rating\":9.0},\n  {\"id\":757488,\"suggestedTranslation\":\"Vật trang trí ở giữa đã được đặt lên rồi.\",\"rating\":9.0},\n  {\"id\":757489,\"suggestedTranslation\":\"Hoặc là nó khởi động lại, hoặc chúng ta tháo ra lấy linh kiện!\",\"rating\":9.0},\n  {\"id\":757490,\"suggestedTranslation\":\"Lão Kramps chắc sẽ thích cái này lắm đây.\",\"rating\":9.0},\n  {\"id\":757491,\"suggestedTranslation\":\"Đội cái này lên sừng chắc là khó chịu lắm đây.\",\"rating\":9.0},\n  {\"id\":757492,\"suggestedTranslation\":\"Đây là lần đầu tiên ta gặp một kết cấu lạ lùng thế này đấy.\",\"rating\":9.0},\n  {\"id\":757493,\"suggestedTranslation\":\"Sao lại nhồi nhét sự sợ hãi trong khi ngươi có thể nhồi đầy bánh mì chứ?\",\"rating\":9.0},\n  {\"id\":757494,\"suggestedTranslation\":\"Những chiếc lá thực vật mà chúng ta đã hái.\",\"rating\":9.0},\n  {\"id\":757495,\"suggestedTranslation\":\"Ta nhìn thấy nó đã khô quắt lại rồi.\",\"rating\":9.0},\n  {\"id\":757496,\"suggestedTranslation\":\"Một loài thực vật kiên cường, sinh ra từ sa mạc.\",\"rating\":9.0},\n  {\"id\":757497,\"suggestedTranslation\":\"Một loài thực vật, bị giam cầm vĩnh viễn.\",\"rating\":9.0},\n  {\"id\":757498,\"suggestedTranslation\":\"E rằng nó chỉ còn là cái vỏ rỗng so với trước kia thôi.\",\"rating\":9.0},\n  {\"id\":757499,\"suggestedTranslation\":\"Chúng ta cần chìa khóa cho gói quà từ biển cả này!\",\"rating\":9.0},\n  {\"id\":757500,\"suggestedTranslation\":\"Nhiều thứ để giải quyết phết đấy, hyuyu!\",\"rating\":9.0},\n  {\"id\":757501,\"suggestedTranslation\":\"Hỡi ôi xót xa thay, hòn đá đã xuất hiện một vết nứt!\",\"rating\":9.0},\n  {\"id\":757502,\"suggestedTranslation\":\"Bao nhiêu công sức cuối cùng chỉ đổi lấy một đống đổ nát.\",\"rating\":9.0},\n  {\"id\":757503,\"suggestedTranslation\":\"Cảm ơn sự hỗ trợ của ngươi nhé, hyuyu!\",\"rating\":9.0},\n  {\"id\":757504,\"suggestedTranslation\":\"Hỡi ôi xót xa thay, hòn đá đã xuất hiện một vết nứt!\",\"rating\":9.0},\n  {\"id\":757505,\"suggestedTranslation\":\"Trụ Hắc Ám trông có vẻ tèo rồi đấy, hyuyu!\",\"rating\":9.0},\n  {\"id\":757506,\"suggestedTranslation\":\"Đúng là một kỳ quan! Tiếc là không phải đá cẩm thạch.\",\"rating\":9.0},\n  {\"id\":757507,\"suggestedTranslation\":\"Một đống cột đang thi công dở dang.\",\"rating\":9.0},\n  {\"id\":757508,\"suggestedTranslation\":\"Một đống cột đang thi công dở dang.\",\"rating\":9.0},\n  {\"id\":757509,\"suggestedTranslation\":\"Chao ôi, một cặp đôi kỳ quặc làm sao!\",\"rating\":9.0},\n  {\"id\":757510,\"suggestedTranslation\":\"Ta không ngại thử những phong cách mới đâu.\",\"rating\":9.0},\n  {\"id\":757511,\"suggestedTranslation\":\"Có nên nói cho chúng biết đây là trò đùa không nhỉ? Hyuyu!\",\"rating\":9.0},\n  {\"id\":757512,\"suggestedTranslation\":\"Nhấp một ngụm nhỏ là đủ chuyện ngay.\",\"rating\":9.0},\n  {\"id\":757513,\"suggestedTranslation\":\"Vung qua vung lại vài đường là tiễn kẻ thù lên đường.\",\"rating\":9.0},\n  {\"id\":757514,\"suggestedTranslation\":\"Nhân đôi số trò đùa nào!\",\"rating\":9.0},\n  {\"id\":757515,\"suggestedTranslation\":\"Một nơi đặc biệt để tống đầy thức ăn vào mồm!\",\"rating\":9.0},\n  {\"id\":757516,\"suggestedTranslation\":\"Sân khấu đã sẵn sàng!\",\"rating\":9.0},\n  {\"id\":757517,\"suggestedTranslation\":\"Tốt nhất là đừng phá vỡ ảo tưởng đó.\",\"rating\":9.0},\n  {\"id\":757518,\"suggestedTranslation\":\"Huuhoo! Không biết nó chứa đựng những bí ẩn câu cá nào đây?\",\"rating\":9.0},\n  {\"id\":757519,\"suggestedTranslation\":\"Vài kế hoạch tinh