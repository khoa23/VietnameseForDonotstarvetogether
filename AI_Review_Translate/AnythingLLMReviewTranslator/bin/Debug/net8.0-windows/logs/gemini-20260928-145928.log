 {\"id\": 757779, \"suggestedTranslation\": \"Đức Vua đã chìm vào bóng tối!\", \"rating\": 9.0},\n  {\"id\": 757780, \"suggestedTranslation\": \"Tuyệt chủng hàng loạt thì chẳng từ một ai!\", \"rating\": 9.0},\n  {\"id\": 757781, \"suggestedTranslation\": \"Trời ạ. Bọn chúng hình như có cả giáo mác, ta sợ quá đi!\", \"rating\": 9.0},\n  {\"id\": 757782, \"suggestedTranslation\": \"Đừng nản lòng, chúng ta sửa được mà!\", \"rating\": 9.0},\n  {\"id\": 757783, \"suggestedTranslation\": \"Chán chết, ta cũng làm được thế.\", \"rating\": 9.0},\n  {\"id\": 757784, \"suggestedTranslation\": \"Hết điện á? Vào giờ này cơ à?\", \"rating\": 9.0},\n  {\"id\": 757785, \"suggestedTranslation\": \"Đúng là trò hề! Công tắc hỏng mất tiêu rồi!\", \"rating\": 9.0},\n  {\"id\": 757786, \"suggestedTranslation\": \"Ánh sáng đó được đấy!\", \"rating\": 9.0},\n  {\"id\": 757787, \"suggestedTranslation\": \"Một món ăn của phàm nhân. Hay phải gọi là một cái chảo của phàm nhân nhỉ.\", \"rating\": 9.0},\n  {\"id\": 757788, \"suggestedTranslation\": \"Cái này thì thối rữa hoàn toàn rồi!\", \"rating\": 9.0},\n  {\"id\": 757789, \"suggestedTranslation\": \"Ta không quyết định được đây là để nhấm nháp hay để húp súp nữa.\", \"rating\": 9.0},\n  {\"id\": 757790, \"suggestedTranslation\": \"Cầu kỳ phết nhỉ!\", \"rating\": 9.0},\n  {\"id\": 757791, \"suggestedTranslation\": \"Những mảnh hiện thực rách nát. Lại còn đúng màu của ta nữa chứ!\", \"rating\": 9.0},\n  {\"id\": 757792, \"suggestedTranslation\": \"Một chiếc mũ trùm bóng đêm, chặn đứng mọi ánh sáng.\", \"rating\": 9.0},\n  {\"id\": 757793, \"suggestedTranslation\": \"Mang cái chết từ đằng xa tới!\", \"rating\": 9.0},\n  {\"id\": 757794, \"suggestedTranslation\": \"Khâu chỗ này một mũi, vá chỗ kia một đường để sửa nhanh.\", \"rating\": 9.0},\n  {\"id\": 757795, \"suggestedTranslation\": \"Hỡi ôi, nó chẳng gặt hái được linh hồn nào, toàn cỏ là cỏ.\", \"rating\": 9.0},\n  {\"id\": 757796, \"suggestedTranslation\": \"Cơn mưa đau thương chủ yếu trút