            "text": "[\n  {\"id\": 757548, \"suggestedTranslation\": \"Nhảy nhót chẳng lo âu.\", \"rating\": 9.0},\n  {\"id\": 757549, \"suggestedTranslation\": \"Trụi lủi, cháy rụi tới mặt đất rồi.\", \"rating\": 9.0},\n  {\"id\": 757550, \"suggestedTranslation\": \"Ta chợp mắt một lát được đấy, nghĩ vậy.\", \"rating\": 9.0},\n  {\"id\": 757551, \"suggestedTranslation\": \"Cứ thử bắt ta xem nào!\", \"rating\": 9.0},\n  {\"id\": 757552, \"suggestedTranslation\": \"Ô kìa, trông nguy hiểm phết!\", \"rating\": 9.0},\n  {\"id\": 757553, \"suggestedTranslation\": \"Hú hu, hư hỏng quá nha!\", \"rating\": 9.0},\n  {\"id\": 757554, \"suggestedTranslation\": \"Lại còn trơn trượt nữa chứ!\", \"rating\": 9.0},\n  {\"id\": 757555, \"suggestedTranslation\": \"Trơn trượt!\", \"rating\": 9.0},\n  {\"id\": 757556, \"suggestedTranslation\": \"Nó chẳng cần phải chứng minh điều gì sất.\", \"rating\": 9.0},\n  {\"id\": 757557, \"suggestedTranslation\": \"Hyuyu.\", \"rating\": 9.0},\n  {\"id\": 757558, \"suggestedTranslation\": \"Sức mạnh mất rồi, nhưng chắc chẳng lâu đâu.\", \"rating\": 9.0},\n  {\"id\": 757559, \"suggestedTranslation\": \"Trời ạ, có lẽ trò đùa này đi hơi xa rồi...\", \"rating\": 9.0},\n  {\"id\": 757560, \"suggestedTranslation\": \"Hyuyu... ối dào...\", \"rating\": 9.0},\n  {\"id\": 757561, \"suggestedTranslation\": \"Cứ coi như quà lưu niệm đi, hyuyu!\", \"rating\": 9.0},\n  {\"id\": 757562, \"suggestedTranslation\": \"Xem ra ở đây chẳng ai thích trò đùa cả.\", \"rating\": 9.0},\n  {\"id\": 757563, \"suggestedTranslation\": \"Ta chẳng biết điềm này lành hay dữ nữa.\", \"rating\": 9.0},\n  {\"id\": 757564, \"suggestedTranslation\": \"Hyuyu, có kẻ đang chơi khăm đây.\", \"rating\": 9.0},\n  {\"id\": 757565, \"suggestedTranslation\": \"Bình thường một cách phi thường!\", \"rating\": 9.0},\n  {\"id\": 757566, \"suggestedTranslation\": \"Ồ, đừng bận tâm đến nó làm gì!\", \"rating\": 9.0},\n  {\"id\": 757567, \"suggestedTranslation\": \"Ta sẽ dùng ngôi đền gần nhất để tạo ra một bản thiết kế.\", \"rating\": 9.0},\n  {\"id\": 757568, \"suggestedTranslation\": \"Muốn bay đi á? Hôm nay thì đừng hòng!\", \"rating\": 9.0},\n  {\"id\": 757569, \"suggestedTranslation\": \"Vừa vững chãi lại vừa lấp lánh.\", \"rating\": 9.0},\n  {\"id\": 757570, \"suggestedTranslation\": \"Ooo! Ngửi giống như mùi lửa và diêm sinh!\", \"rating\": 9.0},\n  {\"id\": 757571, \"suggestedTranslation\": \"Cô độc một mình, chẳng có kẻ phàm nào để chơi cùng.\", \"rating\": 9.0},\n  {\"id\": 757572, \"suggestedTranslation\": \"Ta gạt mọi lo âu sang một bên, chúng sẽ dẫn đường cho ta!\", \"rating\": 9.0},\n  {\"id\": 757573, \"suggestedTranslation\": \"Ù ì u ù, chúng biến đi đâu mất rồi?\", \"rating\": 9.0},\n  {\"id\": 757574, \"suggestedTranslation\": \"Chúng cũng cảm nhận được kẻ phá rối đang ở quanh đây, hyuyu!\", \"rating\": 9.0},\n  {\"id\": 757575, \"suggestedTranslation\": \"Chẳng tìm thấy ai cả, ôi chao là ôi chao.\", \"rating\": 9.0},\n  {\"id\": 757576, \"suggestedTranslation\": \"Nó tìm thấy hết lũ tiểu yêu thích chơi khăm rồi!\", \"rating\": 9.0},\n  {\"id\": 757577, \"suggestedTranslation\": \"Chúng ở tít đằng xa, còn ta vẫn đứng đây.\", \"rating\": 9.0},\n  {\"id\": 757578, \"suggestedTranslation\": \"Ồ chao ôi, chúng có thể trốn ở đâu nhỉ, hyuyu.\", \"rating\": 9.0},\n  {\"id\": 757579, \"suggestedTranslation\": \"Chúng không tìm kẻ mà ta đang tìm.\", \"rating\": 9.0},\n  {\"id\": 757580, \"suggestedTranslation\": \"Nhổ cái gì cơ, cỏ á?\", \"rating\": 9.0},\n  {\"id\": 757581, \"suggestedTranslation\": \"Một liều thuốc xoa dịu những cơn đau nhức.\", \"rating\": 9.0},\n  {\"id\": 757582, \"suggestedTranslation\": \"Ta thấy nó đã khô rang.\", \"rating\": 9.0},\n  {\"id\": 757583, \"suggestedTranslation\": \"Ooo, trông ngươi VUI PHẾT đấy!\", \"rating\": 9.0},\n  {\"id\": 757584, \"suggestedTranslation\": \"Giờ thì chúng ta THỰC SỰ rất vui rồi đấy!\", \"rating\": 9.0},\n  {\"id\": 757585, \"suggestedTranslation\": \"Chỉ là một cái hố thôi.\", \"rating\": 9.0},\n  {\"id\": 757586, \"suggestedTranslation\": \"Chẳng có việc gì làm ngoài việc chẻ nó thành đôi.\", \"rating\": 9.0},\n  {\"id\": 757587, \"suggestedTranslation\": \"Chúng ta vừa triệu hồi thứ gì vui lắm à?\", \"rating\": 9.0},\n  {\"id\": 757588, \"suggestedTranslation\": \"Ta nên ném cái này vào ai nhỉ?\", \"rating\": 9.0},\n  {\"id\": 757589, \"suggestedTranslation\": \"Mềm nhũn, mềm nhũn.\", \"rating\": 9.0},\n  {\"id\": 757590, \"suggestedTranslation\": \"Hyuyu, ta phải tìm thứ gì đó thật to để ném nó vào mới được!\", \"rating\": 9.0},\n  {\"id\": 757591, \"suggestedTranslation\": \"Những hạt nhỏ thật kỳ lạ, quả thực là vậy.\", \"rating\": 9.0},\n  {\"id\": 757592, \"suggestedTranslation\": \"Một tiểu yêu phong cách là ta đây!\", \"rating\": 9.0},\n  {\"id\": 757593, \"suggestedTranslation\": \"Hyuyuyu, hắn lại giở trò cũ ra rồi kìa!\", \"rating\": 9.0},\n  {\"id\": 757594, \"suggestedTranslation\": \"Ta sẽ không đi lạc nếu thứ này soi đường.\", \"rating\": 9.0},\n  {\"id\": 757595, \"suggestedTranslation\": \"Một chiếc bánh nướng, không ngọt, nhưng đầy thịt.\", \"rating\": 9.0},\n  {\"id\": 757596, \"suggestedTranslation\": \"Đồ của ta sắp tới nơi rồi.\", \"rating\": 9.0},\n  {\"id\": 757597, \"suggestedTranslation\": \"Máy vận chuyển linh hồn.\", \"rating\": 9.0},\n  {\"id\": 757598, \"suggestedTranslation\": \"Tạm biệt các bạn nhé, ta phải đi đây.\", \"rating\": 9.0},\n  {\"id\": 757599, \"suggestedTranslation\": \"Một hòn đá tảng ẩn chứa chút niềm vui.\", \"rating\": 9.0},\n  {\"id\": 757600, \"suggestedTranslation\": \"Trông có vẻ dai. Ta ghét phải nhai lắm.\", \"rating\": 9.0},\n  {\"id\": 757601, \"suggestedTranslation\": \"Ngươi nỡ đánh đập một chú tiểu yêu bé nhỏ thế à?!\", \"rating\": 9.0},\n  {\"id\": 757602, \"suggestedTranslation\": \"Ta chẳng biết thứ này dùng để làm gì.\", \"rating\": 9.0},\n  {\"id\": 757603, \"suggestedTranslation\": \"Ta là một tiểu yêu cực kỳ kiên nhẫn.\", \"rating\": 9.0},\n  {\"id\": 757604, \"suggestedTranslation\": \"Nhọn hoắt, sắc lẹm, xanh rờn và đầy gai góc!\", \"rating\": 9.0},\n  {\"id\": 757605, \"suggestedTranslation\": \"Lạnh như đá!\", \"rating\": 9.0},\n  {\"id\": 757606, \"suggestedTranslation\": \"Ồ, đây sẽ là một trò chơi khăm cực vui đây!\", \"rating\": 9.0},\n  {\"id\": 757607, \"suggestedTranslation\": \"Cách chữa nhanh cho đôi chân lạnh ngắt, hyuyuyu!\", \"rating\": 9.0},\n  {\"id\": 757608, \"suggestedTranslation\": \"Cục đá ấm áp này sẽ gây ra khối chuyện đấy.\", \"rating\": 9.0},\n  {\"id\": 757609, \"suggestedTranslation\": \"Bộ hàm ngoạm lấy! Quả là một cái bẫy.\", \"rating\": 9.0},\n  {\"id\": 757610, \"suggestedTranslation\": \"Đi đứng cẩn thận đấy, kẻo lại bỏ mạng như chơi!\", \"rating\": 9.0},\n  {\"id\": 757611, \"suggestedTranslation\": \"Mong là cái này không quá tàn nhẫn.\", \"rating\": 9.0},\n  {\"id\": 757612, \"suggestedTranslation\": \"Thật là bất lịch sự khi bỏ quên thứ này giữa đường.\", \"rating\": 9.0},\n  {\"id\": 757613, \"suggestedTranslation\": \"Ôi không, kho báu của chúng ta!\", \"rating\": 9.0},\n  {\"id\": 757614, \"suggestedTranslation\": \"Nơi cất chứa mấy thứ linh tinh.\", \"rating\": 9.0},\n  {\"id\": 757615, \"suggestedTranslation\": \"Vẫn còn thừa chỗ để nhét đồ vào trong kìa.\", \"rating\": 9.0},\n  {\"id\": 757616, \"suggestedTranslation\": \"Chúng ta có gì ở đây thế này?\", \"rating\": 9.0},\n  {\"id\": 757617, \"suggestedTranslation\": \"Này! Đừng có chắn đường chứ!\", \"rating\": 9.0},\n  {\"id\": 757618, \"suggestedTranslation\": \"Nó sẽ bám chặt vào cành của ngươi đấy.\", \"rating\": 9.0},\n  {\"id\": 757619, \"suggestedTranslation\": \"Châm lửa đốt thân cây rồi bùm một phát!\", \"rating\": 9.0},\n  {\"id\": 757620, \"suggestedTranslation\": \"Nó là của ta để khai thác!\", \"rating\": 9.0},\n  {\"id\": 757621, \"suggestedTranslation\": \"Hòn đá tảng á? Ta thấy rồi đấy, nhưng làm sao để giải thoát nó đây?\", \"rating\": 9.0},\n  {\"id\": 757622, \"suggestedTranslation\": \"Có chuyện gì thế, cây nhỏ?\", \"rating\": 9.0},\n  {\"id\": 757623, \"suggestedTranslation\": \"Đúng là một hạt giống!\", \"rating\": 9.0},\n  {\"id\": 757624, \"suggestedTranslation\": \"Cầm chiếc chĩa này lên sao mà quen thuộc đến kỳ lạ.\", \"rating\": 9.0},\n  {\"id\": 757625, \"suggestedTranslation\": \"Cuối cùng thì có kẻ đã làm rơi chúng.\", \"rating\": 9.0},\n  {\"id\": 757626, \"suggestedTranslation\": \"Con người mới buồn cười làm sao.\", \"rating\": 9.0},\n  {\"id\": 757627, \"suggestedTranslation\": \"Ngươi có câu đố nào cho ta không?\", \"rating\": 9.0},\n  {\"id\": 757628, \"suggestedTranslation\": \"Ta hơi thích nó đấy, thích thật sự luôn.\", \"rating\": 9.0},\n  {\"id\": 757629, \"suggestedTranslation\": \"Ta chẳng thấy linh hồn nào ở bên trong cả, không không.\", \"rating\": 9.0},\n  {\"id\": 757630, \"suggestedTranslation\": \"Trà lúc nào chẳng tràn ra qua mấy khe hở!\", \"rating\": 9.0},\n  {\"id\": 757631, \"suggestedTranslation\": \"Một mảnh nhỏ rớt ra từ bàn cờ.\", \"rating\": 9.0},\n  {\"id\": 757632, \"suggestedTranslation\": \"Một mảnh nhỏ rớt ra từ bàn cờ.\", \"rating\": 9.0},\n  {\"id\": 757633, \"suggestedTranslation\": \"Ta chẳng có thời gian cho việc đó đâu!\", \"rating\": 9.0},\n  {\"id\": 757634, \"suggestedTranslation\": \"Chắc chắn bên trong đang có mấy tiểu yêu nghịch ngợm chờ đợi. Bất ngờ chưa!\", \"rating\": 9.0},\n  {\"id\": 757635, \"suggestedTranslation\": \"Ta cũng thấy mất thăng bằng luôn!\", \"rating\": 9.0},\n  {\"id\": 757636, \"suggestedTranslation\": \"Ta làm được gì với cái kèn Kazoo giả này nhỉ?\", \"rating\": 9.0},\n  {\"id\": 757637, \"suggestedTranslation\": \"Kém thỏa mãn hơn mấy cái vuốt sắc nhọn nhiều!\", \"rating\": 9.0},\n  {\"id\": 757638, \"suggestedTranslation\": \"Ta hoàn toàn không biết nó dùng để làm gì.\", \"rating\": 9.0},\n  {\"id\": 757639, \"suggestedTranslation\": \"Cháy xém và tơi tả, y hệt như bộ não của ta!\", \"rating\": 9.0},\n  {\"id\": 757640, \"suggestedTranslation\": \"Không phải tự khoe đâu, nhưng ta rất giỏi thu thập linh hồn đấy!\", \"rating\": 9.0},\n  {\"id\": 757641, \"suggestedTranslation\": \"Biết đâu có vị thần mèo nào đang đợi bên trong nhỉ?\", \"rating\": 9.0},\n  {\"id\": 757642, \"suggestedTranslation\": \"Một hương thơm tuyệt vời theo gió thoảng qua!\", \"rating\": 9.0},\n  {\"id\": 757643, \"suggestedTranslation\": \"Ta không nghĩ là mình hiểu được trò đùa này.\", \"rating\": 9.0},\n  {\"id\": 757644, \"suggestedTranslation\": \"Ta có mặc quần áo bao giờ đâu.\", \"rating\": 9.0},\n  {\"id\": 757645, \"suggestedTranslation\": \"Một mảnh nhỏ rớt ra từ bàn cờ.\", \"rating\": 9.0},\n  {\"id\": 757646, \"suggestedTranslation\": \"Một mảnh nhỏ rớt ra từ bàn cờ.\", \"rating\": 9.0},\n  {\"id\": 757647, \"suggestedTranslation\": \"Cứng đờ như lưỡi ta vậy!\", \"rating\": 9.0},\n  {\"id\": 757648, \"suggestedTranslation\": \"Một mảnh nhỏ rớt ra từ bàn cờ.\", \"rating\": 9.0},\n  {\"id\": 757649, \"suggestedTranslation\": \"Một mảnh nhỏ rớt ra từ bàn cờ.\", \"rating\": 9.0},\n  {\"id\": 757650, \"suggestedTranslation\": \"Nếu nhìn vào bên trong thì ta sẽ thấy gì nhỉ?\", \"rating\": 9.0},\n  {\"id\": 757651, \"suggestedTranslation\": \"Chán chết! Nó có vừa móng vuốt của ta đâu.\", \"rating\": 9.0},\n  {\"id\": 757652, \"suggestedTranslation\": \"Ta thích móng vuốt của mình hơn nhiều.\", \"rating\": 9.0},\n  {\"id\": 757653, \"suggestedTranslation\": \"Đồ uống đã cạn, nên giờ nó thành đồ bỏ đi!\", \"rating\": 9.0},\n  {\"id\": 757654, \"suggestedTranslation\": \"Của ta ấn tượng hơn nhiều.\", \"rating\": 9.0},\n  {\"id\": 757655, \"suggestedTranslation\": \"Hì hì, ngươi làm sao giết được ta!\", \"rating\": 9.0},\n  {\"id\": 757656, \"suggestedTranslation\": \"Kích thước của thế giới tùy thuộc vào góc nhìn thôi.\", \"rating\": 9.0},\n  {\"id\": 757657, \"suggestedTranslation\": \"Ta thường có đeo găng tay bao giờ đâu.\", \"rating\": 9.0},\n  {\"id\": 757658, \"suggestedTranslation\": \"Ta chẳng thấy linh hồn nào ở bên trong cả, không không.\", \"rating\": 9.0},\n  {\"id\": 757659, \"suggestedTranslation\": \"Mảnh vỡ ốc sên và vẩy chó con.\", \"rating\": 9.0},\n  {\"id\": 757660, \"suggestedTranslation\": \"Khỏi phải bàn, chất nhầy trào hết ra ngoài rồi.\", \"rating\": 9.0},\n  {\"id\": 757661, \"suggestedTranslation\": \"May quá con rắn này chỉ là đồ giả.\", \"rating\": 9.0},\n  {\"id\": 757662, \"suggestedTranslation\": \"Ôi vui quá, chao ôi! Đồ chơi có bánh xe kìa!\", \"rating\": 9.0},\n  {\"id\": 757663, \"suggestedTranslation\": \"Có mấy khe hở để lũ sâu bọ chui vào kìa.\", \"rating\": 9.0},\n  {\"id\": 757664, \"suggestedTranslation\": \"Dù ngươi có nghĩ ta điên khùng, ta thề là mình nghe thấy một giai điệu nhỏ.\", \"rating\": 9.0},\n  {\"id\": 757665, \"suggestedTranslation\": \"Bên chiều không gian của ta không có mấy thứ này.\", \"rating\": 9.0},\n  {\"id\": 757666, \"suggestedTranslation\": \"Vút bayyy!\", \"rating\": 9.0},\n  {\"id\": 757667, \"suggestedTranslation\": \"Rối bời như tâm trí ta vậy!\", \"rating\": 9.0},\n  {\"id\": 757668, \"suggestedTranslation\": \"Ồ, con người hay chơi mấy trò buồn cười thật!\", \"rating\": 9.0},\n  {\"id\": 757669, \"suggestedTranslation\": \"Ta chịu chẳng biết nó là cái quái gì, nhưng trông hay phết!\", \"rating\": 9.0},\n  {\"id\": 757670, \"suggestedTranslation\": \"Không \\\"nếu\\\", không \\\"và\\\", chẳng có \\\"nhưng\\\" nào cả.\", \"rating\": 9.0},\n  {\"id\": 757671, \"suggestedTranslation\": \"Lắm mối tối nằm không, lửa cháy và bể cá sủi tăm!\", \"rating\": 9.0},\n  {\"id\": 757672, \"suggestedTranslation\": \"Vui thật đấy!\", \"rating\": 9.0},\n  {\"id\": 757673, \"suggestedTranslation\": \"Đối với một con cá thì thật là lý tưởng khi làm giải thưởng chứ không phải bữa ăn!\", \"rating\": 9.0},\n  {\"id\": 757674, \"suggestedTranslation\": \"Cân nặng: {weight}\\nBắt bởi: {owner}\", \"rating\": 9.0},\n  {\"id\": 757675, \"suggestedTranslation\": \"Cân nặng: {weight}\\nBắt bởi: {owner}\\nNhìn kích thước của chiến tích câu cá này mà xem!\", \"rating\": 9.0},\n  {\"id\": 757676, \"suggestedTranslation\": \"Cân