,\"rating\":0.0},\n  {\"id\":757138,\"suggestedTranslation\":\"Một thứ vũ khí cùn từ một lão cáo già tai dài.\",\"rating\":0.0},\n  {\"id\":757139,\"suggestedTranslation\":\"Hãy né những cú đá của hắn ra, hắn đang nổi giận đấy!\",\"rating\":0.0},\n  {\"id\":757140,\"suggestedTranslation\":\"Con thỏ kia! Bắt lấy nó!\",\"rating\":0.0},\n  {\"id\":757141,\"suggestedTranslation\":\"Con thỏ rừng này có vẻ điệu nghệ phết.\",\"rating\":0.0},\n  {\"id\":757142,\"suggestedTranslation\":\"Những vũng nước ngoài kia đang chờ ta đấy!\",\"rating\":0.0},\n  {\"id\":757143,\"suggestedTranslation\":\"Bõm bẹm và tóe nước!\",\"rating\":0.0},\n  {\"id\":757144,\"suggestedTranslation\":\"Quả là một trò đùa ngớ ngẩn.\",\"rating\":0.0},\n  {\"id\":757145,\"suggestedTranslation\":\"Trời sẽ mưa chứ? Hay trời sẽ nắng?\",\"rating\":0.0},\n  {\"id\":757146,\"suggestedTranslation\":\"Thức ăn vật lý không hợp với bụng dạ ta lắm.\",\"rating\":0.0},\n  {\"id\":757147,\"suggestedTranslation\":\"Ta không có cạo râu đâu.\",\"rating\":0.0},\n  {\"id\":757148,\"suggestedTranslation\":\"Lại một bài nữa nào!\",\"rating\":0.0},\n  {\"id\":757149,\"suggestedTranslation\":\"Một ván game luôn tốt cho linh hồn!\",\"rating\":0.0},\n  {\"id\":757150,\"suggestedTranslation\":\"Đúng là một giai điệu nhỏ tinh nghịch.\",\"rating\":0.0},\n  {\"id\":757151,\"suggestedTranslation\":\"Ôi trời, chúng ta có gì ở đây thế này?\",\"rating\":0.0},\n  {\"id\":757152,\"suggestedTranslation\":\"Thật sảng khoái vào lúc ánh bình minh!\",\"rating\":0.0},\n  {\"id\":757153,\"suggestedTranslation\":\"Ta nghĩ mình từng nghe bài này trong một giấc mơ.\",\"rating\":0.0},\n  {\"id\":757154,\"suggestedTranslation\":\"Thế thôi á?\",\"rating\":0.0},\n  {\"id\":757155,\"suggestedTranslation\":\"Ôi trời, chúng ta có gì ở đây thế này?\",\"rating\":0.0},\n  {\"id\":757156,\"suggestedTranslation\":\"Thế thôi á?\",\"rating\":0.0},\n  {\"id\":757157,\"suggestedTranslation\":\"Vừa ly kỳ lại vừa rợn tóc gáy!\",\"rating\":0.0},\n  {\"id\":757158,\"suggestedTranslation\":\"Đúng là một giai điệu nhỏ tinh nghịch.\",\"rating\":0.0},\n  {\"id\":757159,\"suggestedTranslation\":\"Ôi trời, chúng ta có gì ở đây thế này?\",\"rating\":0.0},\n  {\"id\":757160,\"suggestedTranslation\":\"Sắc đỏ thẫm nhất, rỉ ra từ máu của người đá.\",\"rating\":0.0},\n  {\"id\":757161,\"suggestedTranslation\":\"Quả là một cảnh tượng đẹp mắt để ngắm nhìn!\",\"rating\":0.0},\n  {\"id\":757162,\"suggestedTranslation\":\"Đỏ, đỏ quá. Giống như bộ lông mà ta rụng vậy.\",\"rating\":0.0},\n  {\"id\":757163,\"suggestedTranslation\":\"Phép thuật may mắn hầu như đang tỏa ra từ nó kìa.\",\"rating\":0.0},\n  {\"id\":757164,\"suggestedTranslation\":\"Ồ, thôi cảm ơn nhé.\",\"rating\":0.0},\n  {\"id\":757165,\"suggestedTranslation\":\"Đầu ta cứ nhức lên chỉ vì nhìn vào nó thôi!\",\"rating\":0.0},\n  {\"id\":757166,\"suggestedTranslation\":\"Hyuyu! Đừng có hồng mà hòng đầu độc được ta!\",\"rating\":0.0},\n  {\"id\":757167,\"suggestedTranslation\":\"Nó đang chơi trốn tìm kìa!\",\"rating\":0.0},\n  {\"id\":757168,\"suggestedTranslation\":\"Mất tích, mất sạch rồi.\",\"rating\":0.0},\n  {\"id\":757169,\"suggestedTranslation\":\"Ôi chao nhầm lẫn chút thôi.\",\"rating\":0.0},\n  {\"id\":757170,\"suggestedTranslation\":\"Đúng là may cho ta! Có cây sậy để bứt này!\",\"rating\":0.0},\n  {\"id\":757171,\"suggestedTranslation\":\"Mất tích, mất sạch rồi.\",\"rating\":0.0},\n  {\"id\":757172,\"suggestedTranslation\":\"Chỉ cần chút lòng tin, niềm tin và đủ loại bụi phép thuật.\",\"rating\":0.0},\n  {\"id\":757173,\"suggestedTranslation\":\"Nó rực rỡ y như tính cách của ta vậy.\",\"rating\":0.0},\n  {\"id\":757174,\"suggestedTranslation\":\"Chỉ toàn là mấy thứ chẳng có tí vui thú gì!\",\"rating\":0.0},\n  {\"id\":757175,\"suggestedTranslation\":\"Chà, thế thì vui phết.\",\"rating\":0.0},\n  {\"id\":757176,\"suggestedTranslation\":\"Phàm nhân hay chơi mấy trò ngớ ngẩn thật đấy.\",\"rating\":0.0},\n  {\"id\":757177,\"suggestedTranslation\":\"Chà, thế thì vui phết.\",\"rating\":0.0},\n  {\"id\":757178,\"suggestedTranslation\":\"Ồ, thật là giải trí làm sao!\",\"rating\":0.0},\n  {\"id\":757179,\"suggestedTranslation\":\"Đó cũng là một cách để vô hiệu hóa ma thuật đấy.\",\"rating\":0.0},\n  {\"id\":757180,\"suggestedTranslation\":\"Có rất nhiều trò vui ma thuật ở đây đấy.\",\"rating\":0.0},\n  {\"id\":757181,\"suggestedTranslation\":\"Đó cũng là một cách để vô hiệu hóa ma thuật đấy.\",\"rating\":0.0},\n  {\"id\":757182,\"suggestedTranslation\":\"Nó chạy bằng năng lượng trò hề ngớ ngẩn.\",\"rating\":0.0},\n  {\"id\":757183,\"suggestedTranslation\":\"Oooh, những trò quậy phá ta có thể làm với cái này đây!\",\"rating\":0.0},\n  {\"id\":757184,\"suggestedTranslation\":\"Trục xuất tiểu yêu theo hình thức hoãn sự thỏa mãn.\",\"rating\":0.0},\n  {\"id\":757185,\"suggestedTranslation\":\"Ta không thể nào chết được! Hyuyu!\",\"rating\":0.0},\n  {\"id\":757186,\"suggestedTranslation\":\"Hãy đưa ta trở về từ cõi u minh chết chóc!\",\"rating\":0.0},\n  {\"id\":757187,\"suggestedTranslation\":\"Để bạn bè của ta có thể sống mà kể lại câu chuyện!\",\"rating\":0.0},\n  {\"id\":757188,\"suggestedTranslation\":\"Có phải ta đang nhìn thấy hai hình ảnh không nhỉ?\",\"rating\":0.0},\n  {\"id\":757189,\"suggestedTranslation\":\"Trông nó y hệt như một con gà tây vậy.\",\"rating\":0.0},\n  {\"id\":757190,\"suggestedTranslation\":\"Quả là một sắc đỏ thú vị.\",\"rating\":0.0},\n  {\"id\":757191,\"suggestedTranslation\":\"Cẩn thận ngón tay của ta đấy.\",\"rating\":0.0},\n  {\"id\":757192,\"suggestedTranslation\":\"Đó là một con chim, hoặc ít ra ta nghe thế.\",\"rating\":0.0},\n  {\"id\":757193,\"suggestedTranslation\":\"Cẩn thận ngón tay của ta đấy.\",\"rating\":0.0},\n  {\"id\":757194,\"suggestedTranslation\":\"Bộ trang phục này có lẽ phải ủi rất nhiều đấy, hyuyu!\",\"rating\":0.0},\n  {\"id\":757195,\"suggestedTranslation\":\"Xin chào và kính chào nhé, người bạn hiền ngọt ngào.\",\"rating\":0.0},\n  {\"id\":757196,\"suggestedTranslation\":\"Thật là sốc! Hóa ra đó là một cục đá tảng!\",\"rating\":0.0},\n  {\"id\":757197,\"suggestedTranslation\":\"Biết đâu chúng là những tảng đá lớn còn ta thì bỗng to lên thật nhiều.\",\"rating\":0.0},\n  {\"id\":757198,\"suggestedTranslation\":\"Liệu một tảng đá tảng có thể sở hữu một linh hồn không nhỉ?\",\"rating\":0.0},\n  {\"id\":757199,\"suggestedTranslation\":\"Nó sẽ không quay trở lại cõi này nữa đâu.\",\"rating\":0.0},\n  {\"id\":757200,\"suggestedTranslation\":\"Đang cháy, đang cháy, đang cháy rụi.\",\"rating\":0.0},\n  {\"id\":757201,\"suggestedTranslation\":\"Giờ thì nó bốc mùi thơm phức luôn!\",\"rating\":0.0},\n  {\"id\":757202,\"suggestedTranslation\":\"Nó bắt đầu bốc mùi rồi đấy.\",\"rating\":0.0},\n  {\"id\":757203,\"suggestedTranslation\":\"Nó chật ních những cục đá nhỏ!\",\"rating\":0.0},\n  {\"id\":757204,\"suggestedTranslation\":\"Mất tích, mất sạch rồi.\",\"rating\":0.0},\n  {\"id\":757205,\"suggestedTranslation\":\"Đang cảm thấy buồn chán phải không?\",\"rating\":0.0},\n  {\"id\":757206,\"suggestedTranslation\":\"Ta không có ý chối đây đẩy đâu, nhưng trông nó giống một tảng đá tảng thật đấy.\",\"rating\":0.0},\n  {\"id\":757207,\"suggestedTranslation\":\"Lũ bạn phàm nhân của ta hẳn sẽ thấy nó ngon lành vào lúc này đây.\",\"rating\":0.0},\n  {\"id\":757208,\"suggestedTranslation\":\"Một bữa ăn xứng tầm cho phàm nhân.\",\"rating\":0.0},\n  {\"id\":757209,\"suggestedTranslation\":\"Làm sao mà nó lớn lên được chứ, chẳng ai biết cả.\",\"rating\":0.0},\n  {\"id\":757210,\"suggestedTranslation\":\"Ai mà biết nước lại có thể làm thế chứ!\",\"rating\":0.0},\n  {\"id\":757211,\"suggestedTranslation\":\"Ú à, một vũng nước nhỏ.\",\"rating\":0.0},\n  {\"id\":757212,\"suggestedTranslation\":\"Ú à, một vũng nước nhỏ.\",\"rating\":0.0},\n  {\"id\":757213,\"suggestedTranslation\":\"Một kẻ hay nói đùa như ta thừa sức phá vỡ nó!\",\"rating\":0.0},\n  {\"id\":757214,\"suggestedTranslation\":\"Hồ nước đã bắt đầu nguội đi rồi!\",\"rating\":0.0},\n  {\"id\":757215,\"suggestedTranslation\":\"Ấm áp làm sao!\",\"rating\":0.0},\n  {\"id\":757216,\"suggestedTranslation\":\"Một kẻ hay nói đùa như ta thừa sức phá vỡ nó!\",\"rating\":0.0},\n  {\"id\":757217,\"suggestedTranslation\":\"Bầu trời đã sụp xuống rồi.\",\"rating\":0.0},\n  {\"id\":757218,\"suggestedTranslation\":\"Fweeheehee! Một cái cây lạnh ngắt như đá!\",\"rating\":0.0},\n  {\"id\":757219,\"suggestedTranslation\":\"Fweeheehee! Một cái cây lạnh ngắt như đá!\",\"rating\":0.0},\n  {\"id\":757220,\"suggestedTranslation\":\"Một con xe đáng sợ! Ta phen này hú hồn rồi!\",\"rating\":0.0},\n  {\"id\":757221,\"suggestedTranslation\":\"Ái chà! Chơi đẹp với tiểu yêu nào!\",\"rating\":0.0},\n  {\"id\":757222,\"suggestedTranslation\":\"Mong là nó không dùng để trói mấy đứa tiểu yêu.\",\"rating\":0.0},\n  {\"id\":757223,\"suggestedTranslation\":\"Mong là sợi dây thừng này chịu được.\",\"rating\":0.0},\n  {\"id\":757224,\"suggestedTranslation\":\"Chúng ta có gì ở đây thế nhỉ? Một nhà tiên tri ma thuật hắc ám à?\",\"rating\":0.0},\n  {\"id\":757226,\"suggestedTranslation\":\"Một mùi hôi thối cực mạnh. Thật vui làm sao!\",\"rating\":0.0},\n  {\"id\":757227,\"suggestedTranslation\":\"Thôi, xin miễn cho ta đi.\",\"rating\":0.0},\n  {\"id\":757228,\"suggestedTranslation\":\"Mấy cục đá vô tích sự, có vẻ là thế.\",\"rating\":0.0},\n  {\"id\":757229,\"suggestedTranslation\":\"Trang sức để làm nổi bật chiếc sừng tuyệt vời của ta!\",\"rating\":0.0},\n  {\"id\":757230,\"suggestedTranslation\":\"Một khúc gỗ gai góc đầy sát khí!\",\"rating\":0.0},\n  {\"id\":757231,\"suggestedTranslation\":\"Vỡ nát tung tóe rồi!\",\"rating\":0.0},\n  {\"id\":757232,\"suggestedTranslation\":\"Ooohoohoo, chắc là nó bị nguyền rủa rồi đây!\",\"rating\":0.0},\n  {\"id\":757233,\"suggestedTranslation\":\"Mở ra xem nào, nhanh lên!\",\"rating\":0.0},\n  {\"id\":757234,\"suggestedTranslation\":\"Nó rời ra rồi kìa, hyuyu!\",\"rating\":0.0},\n  {\"id\":757235,\"suggestedTranslation\":\"Hyuyu, cõng ta đi nào!\",\"rating\":0.0},\n  {\"id\":757236,\"suggestedTranslation\":\"Cùng bay nào! Hyuyu!\",\"rating\":0.0},\n  {\"id\":757237,\"suggestedTranslation\":\"Chúng ta cùng làm một chuyến chu du sang vùng tối nhé?\",\"rating\":0.0},\n  {\"id\":757238,\"suggestedTranslation\":\"Ta là một tên tiểu yêu chiến tranh!\",\"rating\":0.0},\n  {\"id\":757239,\"suggestedTranslation\":\"Đó sẽ là chiếc yên cưỡi để cưỡi gia súc ra trận đấy, hyuyu!\",\"rating\":0.0},\n  {\"id\":757240,\"suggestedTranslation\":\"Một món cay cay cho phàm nhân thưởng thức.\",\"rating\":0.0},\n  {\"id\":757241,\"suggestedTranslation\":\"Ngươi không cần phải lo lắng về việc bảo vệ thức ăn khỏi ta đâu.\",\"rating\":0.0},\n  {\"id\":757242,\"suggestedTranslation\":\"Người ta hay bảo ta nói năng chẳng đầu chẳng đuôi gì cả.\",\"rating\":0.0},\n  {\"id\":757243,\"suggestedTranslation\":\"Ta thấy muối biển!\",\"rating\":0.0},\n  {\"id\":757244,\"suggestedTranslation\":\"Hííí trốn!\",\"rating\":0.0},\n  {\"id\":757245,\"suggestedTranslation\":\"Thú vị đấy.\",\"rating\":0.0},\n  {\"id\":757246,\"suggestedTranslation\":\"Ôi ngày vui tươi. Lại thêm muối nữa chứ.\",\"rating\":0.0},\n  {\"id\":757247,\"suggestedTranslation\":\"Heehee, hoho, nó phải biến đi thôi.\",\"rating\":0.0}\n]",
