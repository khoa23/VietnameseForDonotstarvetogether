            "text": "[\n  {\"id\": 759403, \"suggestedTranslation\": \"Florp! Bất lịch sự!\", \"rating\": 9.0},\n  {\"id\": 759404, \"suggestedTranslation\": \"Lỗ đá tảng hôi hám.\", \"rating\": 9.0},\n  {\"id\": 759405, \"suggestedTranslation\": \"Nóng quá, florp.\", \"rating\": 9.0},\n  {\"id\": 759406, \"suggestedTranslation\": \"Flort! Đám mây tệ hại!\", \"rating\": 9.0},\n  {\"id\": 759407, \"suggestedTranslation\": \"Leo trèo dễ ẹc.\", \"rating\": 9.0},\n  {\"id\": 759408, \"suggestedTranslation\": \"Ghê quá. Không thèm.\", \"rating\": 9.0},\n  {\"id\": 759409, \"suggestedTranslation\": \"Làm dơ hết cả móng tay.\", \"rating\": 9.0},\n  {\"id\": 759412, \"suggestedTranslation\": \"Mày muốn gì hả, florp?\", \"rating\": 9.0},\n  {\"id\": 759413, \"suggestedTranslation\": \"Này! Đừng có giễu cợt kẻ không vảy, việc đó của tao!\", \"rating\": 9.0},\n  {\"id\": 759414, \"suggestedTranslation\": \"Diễn lại các câu chuyện tưởng tượng á? Muốn thử ghê!!\", \"rating\": 9.0},\n  {\"id\": 759415, \"suggestedTranslation\": \"Bà kị sĩ ban đêm đáng sợ kìa!!\", \"rating\": 9.0},\n  {\"id\": 759416, \"suggestedTranslation\": \"Hừm, trông có vẻ quan trọng đấy, florp.\", \"rating\": 9.0},\n  {\"id\": 759417, \"suggestedTranslation\": \"Nó vỡ tung bét rồi.\", \"rating\": 9.0},\n  {\"id\": 759418, \"suggestedTranslation\": \"Tao không làm nhé!!\", \"rating\": 9.0},\n  {\"id\": 759419, \"suggestedTranslation\": \"Nó hỏng bét hết rồi.\", \"rating\": 9.0},\n  {\"id\": 759420, \"suggestedTranslation\": \"Sao lại làm dây neo cho đất liền thế hả, florpt?\", \"rating\": 9.0},\n  {\"id\": 759421, \"suggestedTranslation\": \"Sao cổ ta đứng im thế nhỉ?\", \"rating\": 9.0},\n  {\"id\": 759422, \"suggestedTranslation\": \"Grrrr!\", \"rating\": 9.0},\n  {\"id\": 759423, \"suggestedTranslation\": \"Nhớ con gấu bông hư đốn đó ghê.\", \"rating\": 9.0},\n  {\"id\": 759424, \"suggestedTranslation\": \"Chỉ là đá tảng thôi, đồ thật vẫn thích hơn.\", \"rating\": 9.0},\n  {\"id\": 759425, \"suggestedTranslation\": \"Đáng đời chưa, mụ mận đạm!\", \"rating\": 9.0},\n  {\"id\": 759426, \"suggestedTranslation\": \"Nhọn hoắt.\", \"rating\": 9.0},\n  {\"id\": 759427, \"suggestedTranslation\": \"Nó đang nhúc nhích kìa!\", \"rating\": 9.0},\n  {\"id\": 759428, \"suggestedTranslation\": \"Xấu hoắc.\", \"rating\": 9.0},\n  {\"id\": 759429, \"suggestedTranslation\": \"Con chuột rau củ trông có vẻ vui nhỉ.\", \"rating\": 9.0},\n  {\"id\": 759430, \"suggestedTranslation\": \"Bức tượng khá đẹp phết, lại có cả con bướm chết!\", \"rating\": 9.0},\n  {\"id\": 759431, \"suggestedTranslation\": \"Cún hư.\", \"rating\": 9.0},\n  {\"id\": 759432, \"suggestedTranslation\": \"Grrrr!\", \"rating\": 9.0},\n  {\"id\": 759433, \"suggestedTranslation\": \"Glurgh, hắn làm mụ cua buồn kìa!\", \"rating\": 9.0},\n  {\"id\": 759434, \"suggestedTranslation\": \"Grrr... sao lại có bức tượng Heo gớm ghiếc này ở đây chứ?!\", \"rating\": 9.0},\n  {\"id\": 759435, \"suggestedTranslation\": \"Lại thêm một bức tượng Heo gớm ghiếc nữa! GRRRRR!\", \"rating\": 9.0},\n  {\"id\": 759436, \"suggestedTranslation\": \"Sẽ không làm phiền chúng ta nữa đâu.\", \"rating\": 9.0},\n  {\"id\": 759437, \"suggestedTranslation\": \"Tạm biệt hươu nhé. Hết bị chọc mắt rồi.\", \"rating\": 9.0},\n  {\"id\": 759438, \"suggestedTranslation\": \"Con giun nhỏ cưng quá đi!\", \"rating\": 9.0},\n  {\"id\": 759439, \"suggestedTranslation\": \"Mắt lồi cả ra kìa.\", \"rating\": 9.0},\n  {\"id\": 759440, \"suggestedTranslation\": \"Ôi không... bị khô queo rồi, glorp...\", \"rating\": 9.0},\n  {\"id\": 759441, \"suggestedTranslation\": \"Sao ai cũng cư xử kỳ cục với cái này thế nhỉ.\", \"rating\": 9.0},\n  {\"id\": 759442, \"suggestedTranslation\": \"Glorp! Ồ, không phải đồ thật.\", \"rating\": 9.0},\n  {\"id\": 759443, \"suggestedTranslation\": \"Chứa đầy món ngon luôn, florp!\", \"rating\": 9.0},\n  {\"id\": 759444, \"suggestedTranslation\": \"Aww, chúng đang ngủ trưa kìa.\", \"rating\": 9.0},\n  {\"id\": 759445, \"suggestedTranslation\": \"Không đuổi theo tao được nữa đâu!\", \"rating\": 9.0},\n  {\"id\": 759446, \"suggestedTranslation\": \"Trông giống Người Sắt thế.\", \"rating\": 9.0},\n  {\"id\": 759447, \"suggestedTranslation\": \"Nó đang nhúc nhích kìa!\", \"rating\": 9.0},\n  {\"id\": 759448, \"suggestedTranslation\": \"Bức tượng trông sang chảnh thật.\", \"rating\": 9.0},\n  {\"id\": 759449, \"suggestedTranslation\": \"Glurgh. Thỏ Người có tượng trước cả Người Mãng Cầu?!\", \"rating\": 9.0},\n  {\"id\": 759450, \"suggestedTranslation\": \"Cọ vẩy lên đây đã ngứa phết.\", \"rating\": 9.0},\n  {\"id\": 759451, \"suggestedTranslation\": \"Trông y hệt đồ thật luôn!\", \"rating\": 9.0},\n  {\"id\": 759452, \"suggestedTranslation\": \"Ha ha! Cái mặt kìa!\", \"rating\": 9.0},\n  {\"id\": 759453, \"suggestedTranslation\": \"Bà cô đáng sợ.\", \"rating\": 9.0},\n  {\"id\": 759454, \"suggestedTranslation\": \"Đứa bé nhất trong họ nhà nó...\", \"rating\": 9.0},\n  {\"id\": 759455, \"suggestedTranslation\": \"Mấy kẻ không vẩy kỳ cục thật đấy, florp.\", \"rating\": 9.0},\n  {\"id\": 759456, \"suggestedTranslation\": \"Lâu đài này bé quá.\", \"rating\": 9.0},\n  {\"id\": 759457, \"suggestedTranslation\": \"Nó đang nhúc nhích kìa!\", \"rating\": 9.0},\n  {\"id\": 759458, \"suggestedTranslation\": \"Haha! Con cá hư bị đóng băng rồi.\", \"rating\": 9.0},\n  {\"id\": 759459, \"suggestedTranslation\": \"Giờ thì đỡ đáng sợ rồi đấy.\", \"rating\": 9.0},\n  {\"id\": 759460, \"suggestedTranslation\": \"Hết tiếng kêu ọp ẹp nữa rồi.\", \"rating\": 9.0},\n  {\"id\": 759461, \"suggestedTranslation\": \"Ha ha, giờ chúng chỉ là cục đá thôi!\", \"rating\": 9.0},\n  {\"id\": 759462, \"suggestedTranslation\": \"Cặp sừng bé con cưng ghê! Florp!\", \"rating\": 9.0},\n  {\"id\": 759463, \"suggestedTranslation\": \"Đồ vật mặt trăng làm Người Sắt bự trở nên xấu xa.\", \"rating\": 9.0},\n  {\"id\": 759464, \"suggestedTranslation\": \"Người Sắt nhỏ nhưng to.\", \"rating\": 9.0},\n  {\"id\": 759465, \"suggestedTranslation\": \"Tội nghiệp cún con. Cũng không tệ lắm.\", \"rating\": 9.0},\n  {\"id\": 759466, \"suggestedTranslation\": \"Con giun tham ăn nhất.\", \"rating\": 9.0},\n  {\"id\": 759467, \"suggestedTranslation\": \"Sao vẫn chưa bắt đầu nhỉ? Lại muốn đua nữa rồi!\", \"rating\": 9.0},\n  {\"id\": 759468, \"suggestedTranslation\": \"Mùa xuân giờ ở đâu rồi hả Người Sắt mùa xuân?\", \"rating\": 9.0},\n  {\"id\": 759469, \"suggestedTranslation\": \"Con giun nhỏ xinh xắn.\", \"rating\": 9.0},\n  {\"id\": 759470, \"suggestedTranslation\": \"Cậu vừa kỳ cục vừa xù lông, nhưng tớ thích cậu.\", \"rating\": 9.0},\n  {\"id\": 759471, \"suggestedTranslation\": \"Hay ghê!\", \"rating\": 9.0},\n  {\"id\": 759472, \"suggestedTranslation\": \"Dậy đi, florpt!\", \"rating\": 9.0},\n  {\"id\": 759473, \"suggestedTranslation\": \"Làm hộp to hơn á? Glurgh. Đồ đạc vứt dưới đất vui hơn nhiều.\", \"rating\": 9.0},\n  {\"id\": 759474, \"suggestedTranslation\": \"Hộp có miệng! Glorp!\", \"rating\": 9.0},\n  {\"id\": 759475, \"suggestedTranslation\": \"Ăn đi nào mấy con cá!\", \"rating\": 9.0},\n  {\"id\": 759476, \"suggestedTranslation\": \"Glurp! Hay cắn lắm đấy!\", \"rating\": 9.0},\n  {\"id\": 759477, \"suggestedTranslation\": \"Ai tạo ra mày thế, florp?\", \"rating\": 9.0},\n  {\"id\": 759478, \"suggestedTranslation\": \"Răng sắc quá!\", \"rating\": 9.0},\n  {\"id\": 759479, \"suggestedTranslation\": \"Có cảm giác kỳ cục ghê, florp.\", \"rating\": 9.0},\n  {\"id\": 759480, \"suggestedTranslation\": \"Nó sắp tắt rồi.\", \"rating\": 9.0},\n  {\"id\": 759481, \"suggestedTranslation\": \"Đã đến giờ kể chuyện quanh lửa rồi, florp!\", \"rating\": 9.0},\n  {\"id\": 759482, \"suggestedTranslation\": \"Lửa lớn quá!\", \"rating\": 9.0},\n  {\"id\": 759483, \"suggestedTranslation\": \"Lửa đang nhỏ dần.\", \"rating\": 9.0},\n  {\"id\": 759484, \"suggestedTranslation\": \"Lửa gì mà mát lạnh thế?\", \"rating\": 9.0},\n  {\"id\": 759485, \"suggestedTranslation\": \"Tạm biệt nhé.\", \"rating\": 9.0},\n  {\"id\": 759486, \"