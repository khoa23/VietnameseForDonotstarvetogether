            "text": "[\n  {\"id\":759103,\"suggestedTranslation\":\"Phát ra âm thanh hay lắm.\",\"rating\":9.0},\n  {\"id\":759104,\"suggestedTranslation\":\"Muốn chơi cùng nó!\",\"rating\":9.0},\n  {\"id\":759105,\"suggestedTranslation\":\"Đồ chơi vui, flurp!\",\"rating\":9.0},\n  {\"id\":759106,\"suggestedTranslation\":\"Ái chà...\",\"rating\":9.0},\n  {\"id\":759107,\"suggestedTranslation\":\"Không chơi nữa à?\",\"rating\":9.0},\n  {\"id\":759108,\"suggestedTranslation\":\"Món ăn vặt bụi cây ngon miệng!\",\"rating\":9.0},\n  {\"id\":759109,\"suggestedTranslation\":\"Sao lại cố đốt đồ ăn vặt thế, glort?\",\"rating\":9.0},\n  {\"id\":759110,\"suggestedTranslation\":\"Uooooh, to và ngon quá!\",\"rating\":9.0},\n  {\"id\":759111,\"suggestedTranslation\":\"Muốn ăn hết sạch!\",\"rating\":9.0},\n  {\"id\":759112,\"suggestedTranslation\":\"Bón phân vào đó đi, flurp.\",\"rating\":9.0},\n  {\"id\":759113,\"suggestedTranslation\":\"Tạm biệt nhé.\",\"rating\":9.0},\n  {\"id\":759114,\"suggestedTranslation\":\"Bệnh rồi thì không làm đồ ăn vặt được đâu, florp.\",\"rating\":9.0},\n  {\"id\":759115,\"suggestedTranslation\":\"Trông không ổn lắm.\",\"rating\":9.0},\n  {\"id\":759116,\"suggestedTranslation\":\"Đồ ăn vặt!\",\"rating\":9.0},\n  {\"id\":759117,\"suggestedTranslation\":\"Phải đợi thêm đồ ăn vặt thôi.\",\"rating\":9.0},\n  {\"id\":759118,\"suggestedTranslation\":\"Khô quá.\",\"rating\":9.0},\n  {\"id\":759119,\"suggestedTranslation\":\"Cần phân bón.\",\"rating\":9.0},\n  {\"id\":759120,\"suggestedTranslation\":\"Nóng! Nóng quá!!\",\"rating\":9.0},\n  {\"id\":759121,\"suggestedTranslation\":\"Trông tệ quá, florp.\",\"rating\":9.0},\n  {\"id\":759122,\"suggestedTranslation\":\"Trông không ổn lắm.\",\"rating\":9.0},\n  {\"id\":759123,\"suggestedTranslation\":\"Phải ăn chúng thật nhanh thôi!\",\"rating\":9.0},\n  {\"id\":759124,\"suggestedTranslation\":\"Tạo ra đồ ăn vặt đi! Làm đồ ăn vặt đi!\",\"rating\":9.0},\n  {\"id\":759125,\"suggestedTranslation\":\"Nó cũng chẳng thích sức nóng đâu.\",\"rating\":9.0},\n  {\"id\":759126,\"suggestedTranslation\":\"Món dâu rừng ngon tuyệt!\",\"rating\":9.5},\n  {\"id\":759127,\"suggestedTranslation\":\"Thích món này!\",\"rating\":9.0},\n  {\"id\":759128,\"suggestedTranslation\":\"Có bàn chân to ghê!\",\"rating\":9.0},\n  {\"id\":759129,\"suggestedTranslation\":\"Ha ha! Trông buồn cười ghê!\",\"rating\":9.0},\n  {\"id\":759130,\"suggestedTranslation\":\"Ối, nó chết mất rồi.\",\"rating\":9.0},\n  {\"id\":759131,\"suggestedTranslation\":\"Cho con chim vào trong!\",\"rating\":9.0},\n  {\"id\":759132,\"suggestedTranslation\":\"Chim cần ăn vặt.\",\"rating\":9.0},\n  {\"id\":759133,\"suggestedTranslation\":\"Giờ thì chim ở đây luôn nhé!\",\"rating\":9.0},\n  {\"id\":759134,\"suggestedTranslation\":\"...\",\"rating\":10.0},\n  {\"id\":759135,\"suggestedTranslation\":\"Ngủ ngon nhé, chim nhỏ.\",\"rating\":9.0},\n  {\"id\":759136,\"suggestedTranslation\":\"Trông nó đói quá...\",\"rating\":9.0},\n  {\"id\":759137,\"suggestedTranslation\":\"Florp! Đốt cháy con chim rồi!\",\"rating\":9.0},\n  {\"id\":759138,\"suggestedTranslation\":\"Chim chết rồi. Glurgh.\",\"rating\":9.0},\n  {\"id\":759139,\"suggestedTranslation\":\"Chim chết đang tỉnh lại kìa! Florp!\",\"rating\":9.0},\n  {\"id\":759140,\"suggestedTranslation\":\"Bắtấy những chú chim nhỏ nào!\",\"rating\":9.0},\n  {\"id\":759141,\"suggestedTranslation\":\"Có chim non ở trong à?\",\"rating\":9.0},\n  {\"id\":759142,\"suggestedTranslation\":\"Không muốn ăn nó đâu!\",\"rating\":9.0},\n  {\"id\":759143,\"suggestedTranslation\":\"Ha ha! Ngươi bị sao thế hả?\",\"rating\":9.0},\n  {\"id\":759144,\"suggestedTranslation\":\"Nhổ nước bọt trả ngươi nè, florp!\",\"rating\":9.0},\n  {\"id\":759145,\"suggestedTranslation\":\"Người Sắt Phóng Điện!!\",\"rating\":9.0},\n  {\"id\":759146,\"suggestedTranslation\":\"GLOP!\",\"rating\":10.0},\n  {\"id\":759147,\"suggestedTranslation\":\"Có gì đó không ổn với nó rồi, glort!\",\"rating\":9.0},\n  {\"id\":759148,\"suggestedTranslation\":\"Cờ hải tặc kìa!\",\"rating\":9.0},\n  {\"id\":759149,\"suggestedTranslation\":\"Muốn thử cái đó quá!\",\"rating\":9.0},\n  {\"id\":759150,\"suggestedTranslation\":\"Đáng lẽ không nên chơi... mà thôi kệ, thử luôn.\",\"rating\":9.0},\n  {\"id\":759151,\"suggestedTranslation\":\"Trông nguy hiểm ghê!\",\"rating\":9.0},\n  {\"id\":759152,\"suggestedTranslation\":\"Ph-tooey!\",\"rating\":10.0},\n  {\"id\":759153,\"suggestedTranslation\":\"Đến giờ đi ngủ rồi, florp!\",\"rating\":9.0},\n  {\"id\":759154,\"suggestedTranslation\":\"Tè tè điện giật!\",\"rating\":9.0},\n  {\"id\":759155,\"suggestedTranslation\":\"Lạnh buốt!\",\"rating\":9.0},\n  {\"id\":759156,\"suggestedTranslation\":\"Hòn đá tảng đẹp quá.\",\"rating\":9.5},\n  {\"id\":759157,\"suggestedTranslation\":\"Ngươi đang nhìn đi đâu đấy, flurt?\",\"rating\":9.0},\n  {\"id\":759158,\"suggestedTranslation\":\"Có hình vẽ trên đó kìa!\",\"rating\":9.0},\n  {\"id\":759159,\"suggestedTranslation\":\"Trông rắc rối thật đấy, florp.\",\"rating\":9.0},\n  {\"id\":759160,\"suggestedTranslation\":\"Tốt cho bụng nhưng hại cho đầu.\",\"rating\":9.0},\n  {\"id\":759161,\"suggestedTranslation\":\"Nó có mùi lạ lắm...\",\"rating\":9.0},\n  {\"id\":759162,\"suggestedTranslation\":\"Thức ăn!\",\"rating\":9.0},\n  {\"id\":759163,\"suggestedTranslation\":\"Trời tối là nó trồi lên ngay thôi, florp.\",\"rating\":9.0},\n  {\"id\":759164,\"suggestedTranslation\":\"Lại mọc to lên nào!\",\"rating\":9.0},\n  {\"id\":759165,\"suggestedTranslation\":\"Mấy khúc gỗ để xây dựng nè, florp.\",\"rating\":9.0},\n  {\"id\":759166,\"suggestedTranslation\":\"Ngươi là họ hàng của Người Heo à??\",\"rating\":9.0},\n  {\"id\":759167,\"suggestedTranslation\":\"G-glorp... Người Heo b-bự kìa...\",\"rating\":9.0},\n  {\"id\":759168,\"suggestedTranslation\":\"Tạm biệt chiếc thuyền ván.\",\"rating\":9.5},\n  {\"id\":759169,\"suggestedTranslation\":\"Tạm biệt chiếc thuyền ván.\",\"rating\":9.5},\n  {\"id\":759170,\"suggestedTranslation\":\"Tạm biệt chiếc thuyền ván.\",\"rating\":9.5},\n  {\"id\":759171,\"suggestedTranslation\":\"Vá lại làm gì chứ? Cho nước lọt vào à, florpt!\",\"rating\":9.0},\n  {\"id\":759172,\"suggestedTranslation\":\"Chắc sửa tạm thuyền ván, rồi để dành làm món ăn vặt sau nhỉ?\",\"rating\":9.5},\n  {\"id\":759173,\"suggestedTranslation\":\"Nó chỉ đường kìa!\",\"rating\":9.0},\n  {\"id\":759174,\"suggestedTranslation\":\"Sẽ đặt nó ở chỗ tuyệt nhất. Đố biết ở đâu đấy.\",\"rating\":9.0},\n  {\"id\":759175,\"suggestedTranslation\":\"Ngươi thua chắc rồi! Nyeeeehhh!!\",\"rating\":9.0},\n  {\"id\":759176,\"suggestedTranslation\":\"Glorp! Đừng đâm vào thuyền ván nhé!\",\"rating\":9.5},\n  {\"id\":759177,\"suggestedTranslation\":\"Glorp! Đừng đâm vào thuyền ván nhé!\",\"rating\":9.5},\n  {\"id\":759178,\"suggestedTranslation\":\"Đừng lo, không ném trước mũi thuyền ván của ngươi đâu! (Hee-hee...)\",\"rating\":9.5},\n  {\"id\":759179,\"suggestedTranslation\":\"Đừng lo, không ném trước mũi thuyền ván của ngươi đâu! (Hee-hee...)\",\"rating\":9.5},\n  {\"id\":759180,\"suggestedTranslation\":\"Tớ sẽ thắng cho mà xem, cứ đợi đấy, florp!\",\"rating\":9.0},\n  {\"id\":759181,\"suggestedTranslation\":\"Đây là vạch xuất phát.\",\"rating\":9.0},\n  {\"id\":759182,\"suggestedTranslation\":\"Nhanh lên nào, muốn bắt đầu cuộc đua quá đi!!\",\"rating\":9.0},\n  {\"id\":759183,\"suggestedTranslation\":\"Cái hố cất đồ giấu kín.\",\"rating\":9.5},\n  {\"id\":759184,\"suggestedTranslation\":\"Sao lại đi làm cái thuyền ván đã cũ sẵn thế này, florp?\",\"rating\":9.5},\n  {\"id\":759185,\"suggestedTranslation\":\"Trang trí đẹp quá!\",\"rating\":9.0},\n  {\"id\":759186,\"suggestedTranslation\":\"Sẽ trang trí cho thuyền ván nào, florp.\",\"rating\":9.5},\n  {\"id\":759187,\"suggestedTranslation\":\"Trang trí đẹp quá!\",\"rating\":9.0},\n  {\"id\":759188,\"suggestedTranslation\":\"Sẽ trang trí cho thuyền ván nào, florp.\",\"rating\":9.5},\n  {\"id\":759189,\"suggestedTranslation\":\"Trang trí đẹp quá!\",\"rating\":9.0},\n  {\"id\":759190,\"suggestedTranslation\":\"Sẽ trang trí cho thuyền ván nào, florp.\",\"rating\":9.5},\n  {\"id\":759191,\"suggestedTranslation\":\"Grrr! Thuyền ván sẽ cắn ngươi đấy!\",\"rating\":9.5},\n  {\"id\":759192,\"suggestedTranslation\":\"Sẽ trang trí cho thuyền ván nào, florp.\",\"rating\":9.5},\n  {\"id\":759193,\"suggestedTranslation\":\"Muốn chơi quá, muốn chơi quá!\",\"rating\":9.0},\n  {\"id\":759194,\"suggestedTranslation\":\"Nó chưa sẵn sàng!\",\"rating\":9.0},\n  {\"id\":759195,\"suggestedTranslation\":\"Glurgh... quên mang theo cục đá đại bác rồi...\",\"rating\":9.5},\n  {\"id\":759196,\"suggestedTranslation\":\"Đồ dùng để chế tạo phụ tùng thuyền ván.\",\"rating\":9.5},\n  {\"id\":759197,\"suggestedTranslation\":\"Thuyền ván cỏ làm dễ hơn nhiều, flort.\",\"rating\":9.5},\n  {\"id\":759198,\"suggestedTranslation\":\"Để đi lại trên cái ao lớn!\",\"rating\":9.5},\n  {\"id\":759199,\"suggestedTranslation\":\"Tớ không thấy đây là vấn đề lớn đâu, florp.\",\"rating\":9.0},\n  {\"id\":759200,\"suggestedTranslation\":\"Đúng là phép thuật!!\",\"rating\":9.0},\n  {\"id\":759201,\"suggestedTranslation\":\"Ốà Quý-cô-Sách có chỉ mấy thứ này trong sách nè! Móng ngựa bự chảng đúng không?\",\"rating\":9.0},\n  {\"id\":759202,\"suggestedTranslation\":\"Nó đang làm gì thế nhỉ?\",\"rating\":9.0},\n  {\"id\":759203,\"suggestedTranslation\":\"Không hiểu nổi mấy cái máy kỳ quặc không vảy này chút nào, florp.\",\"rating\":9.0},\n  {\"id\":759204,\"suggestedTranslation\":\"Đồ của thuyền ván à? Trông lạ ghê nhỉ.\",\"rating\":9.5},\n  {\"id\":759205,\"suggestedTranslation\":\"Muốn làm thuyền ván quay nhanh hơn nữa! Nhanh nữa lên!!\",\"rating\":9.5},\n  {\"id\":759206,\"suggestedTranslation\":\"Đồ của thuyền ván đây mà.\",\"rating\":9.5},\n  {\"id\":759207,\"suggestedTranslation\":\"Blegh, đầy lông là lông!\",\"rating\":9.0},\n  {\"id\":759208,\"suggestedTranslation\":\"Ahh, nhớ nhớ nhão nhão mà thích phết!\",\"rating\":9.0},\n  {\"id\":759209,\"suggestedTranslation\":\"Cái gối hôi rình xấu xí!\",\"rating\":9.0},\n  {\"id\":759210,\"suggestedTranslation\":\"Glurgh! Ngứa quá đi mất!!\",\"rating\":9.0},\n  {\"id\":759211,\"suggestedTranslation\":\"Hee-hee-hee... bùng nổ!!\",\"rating\":9.0},\n  {\"id\":759212,\"suggestedTranslation\":\"Lá Cây làm nó khác đi đấy. Bằng cách nào nhỉ?\",\"rating\":9.0},\n  {\"id\":759213,\"suggestedTranslation\":\"Mảnh vỡ của thứ gì đó đã chết.\",\"rating\":9.0},\n  {\"id\":759214,\"suggestedTranslation\":\"Không muốn ăn đâu, florp.\",\"rating\":9.0},\n  {\"id\":759215,\"suggestedTranslation\":\"Glurgh.\",\"rating\":10.0},\n  {\"id\":759216,\"suggestedTranslation\":\"T-tớ không làm đâu nhé, hứa luôn!! Đừng buồn mà Quý-cô-Sách ơi...\",\"rating\":9.0},\n  {\"id\":759217,\"suggestedTranslation\":\"Glurgh. Sao lại cất sách cao thế cơ chứ?!\",\"rating\":9.0},\n  {\"id\":759218,\"suggestedTranslation\":\"Quý-cô-Sách! Muốn đọc về mật ong quá! ...Làm ơn đi mà.\",\"rating\":9.5},\n  {\"id\":759219,\"suggestedTranslation\":\"Đọc cuốn này đi, Quý-cô-Sách!\",\"rating\":9.0},\n  {\"id\":759220,\"suggestedTranslation\":\"Quý-cô-Sách đâu rồi? Muốn biết chuyện gì xảy ra tiếp theo cơ!\",\"rating\":9.0},\n  {\"id\":759221,\"suggestedTranslation\":\"Cái này viết gì thế, florp?\",\"rating\":9.0},\n  {\"id\":759222,\"suggestedTranslation\":\"Cuốn này nói về cái gì thế nhỉ?\",\"rating\":9.0},\n  {\"id\":759223,\"suggestedTranslation\":\"Kể tớ nghe câu chuyện về câu cá đi!\",\"rating\":9.0},\n  {\"id\":759224,\"suggestedTranslation\":\"Cái này viết gì thế, florp?\",\"rating\":9.0},\n  {\"id\":759225,\"suggestedTranslation\":\"A... ap... plet...? (Thở dài)\",\"rating\":9.0},\n  {\"id\":759226,\"suggestedTranslation\":\"Cái cầu thì liên quan gì đến cây cối chứ, florp?\",\"rating\":9.0},\n  {\"id\":759227,\"suggestedTranslation\":\"Kết thúc mở rộng? Trông giống được cho thêm vào thì có.\",\"rating\":9.0},\n  {\"id\":759228,\"suggestedTranslation\":\"Hả? Cái đó nói gì thế?\",\"rating\":9.0},\n  {\"id\":759229,\"suggestedTranslation\":\"Oooh, cái này trông xịn phết.\",\"rating\":9.0},\n  {\"id\":759230,\"suggestedTranslation\":\"Oooh, chuyện trăng sao kìa!\",\"rating\":9.0},\n  {\"id\":759231,\"suggestedTranslation\":\"Nghi lễ là cái gì nhỉ?\",\"rating\":9.0},\n  {\"id\":759232,\"suggestedTranslation\":\"Glurp... cuốn đó trông toàn chữ là chữ...\",\"rating\":9.0},\n  {\"id\":759233,\"suggestedTranslation\":\"A... ap... plet...? (Thở dài)\",\"rating\":9.0},\n  {\"id\":759234,\"suggestedTranslation\":\"Muốn nghe truyện trước khi ngủ!\",\"rating\":9.0},\n  {\"id\":759235,\"suggestedTranslation\":\"Nhi...ệt... độ à?\",\"rating\":9.0},\n  {\"id\":759236,\"suggestedTranslation\":\"Làm tớ nhớ đến nhà ghê, florp.\",\"rating\":9.0},\n  {\"id\":759237,\"suggestedTranslation\":\"Nó viết về Người Nhện à? Sao không có sách về Người Cá cơ chứ?!\",\"rating\":9.0},\n  {\"id\":759238,\"suggestedTranslation\":\"Cây gậy quay về!\",\"rating\":9.0},\n  {\"id\":759239,\"suggestedTranslation\":\"Oooh, xương xẩu kìa!\",\"rating\":9.5},\n  {\"id\":759240,\"suggestedTranslation\":\"Tớ không làm hỏng đâu nhé!! Là người khác đấy!\",\"rating\":9.0},\n  {\"id\":759241,\"suggestedTranslation\":\"Sửa dễ ẹc. Chỉ cần làm nóng lên là được, florp!\",\"rating\":9.0},\n  {\"id\":759242,\"suggestedTranslation\":\"Lông lá kì cục ghê, flurp.\",\"rating\":9.0},\n  {\"id\":759243,\"suggestedTranslation\":\"Muốn đi bắt côn trùng quá!\",\"rating\":9.0},\n  {\"id\":759244,\"suggestedTranslation\":\"Đồ ăn vặt dưới nước!\",\"rating\":9.0},\n  {\"id\":759245,\"suggestedTranslation\":\"Lát nữa sẽ quay lại, florp.\",\"rating\":9.0},\n  {\"id\":759246,\"suggestedTranslation\":\"Trồng thêm thực vật dưới nước nào!\",\"rating\":9.5},\n  {\"id\":759247,\"suggestedTranslation\":\"Cất đi để dành lát ăn.\",\"rating\":9.0},\n  {\"id\":759248,\"suggestedTranslation\":\"Gói lại đống đồ này nào, flurpt!\",\"rating\":9.0},\n  {\"id\":759249,\"suggestedTranslation\":\"Không thích Thỏ Người chút nào!\",\"rating\":9.5},\n  {\"id\":759250,\"suggestedTranslation\":\"Glorp... Bồn 