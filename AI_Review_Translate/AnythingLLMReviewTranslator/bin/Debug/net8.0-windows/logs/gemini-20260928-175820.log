            "text": "[\n  {\"id\": 759705, \"suggestedTranslation\": \"Glurp...\", \"rating\": 0.0},\n  {\"id\": 759706, \"suggestedTranslation\": \"Grrrr, không sợ mắt nhai tí hon đâu!\", \"rating\": 9.0},\n  {\"id\": 759707, \"suggestedTranslation\": \"Sắp mở ra rồi kìa!\", \"rating\": 9.0},\n  {\"id\": 759708, \"suggestedTranslation\": \"Nó đang để mắt đấy.\", \"rating\": 9.0},\n  {\"id\": 759709, \"suggestedTranslation\": \"Glurp, không đánh trúng mình đâu... phải không?\", \"rating\": 9.0},\n  {\"id\": 759710, \"suggestedTranslation\": \"Không chắc đây là ý hay...\", \"rating\": 9.0},\n  {\"id\": 759711, \"suggestedTranslation\": \"Cháy trụi quá rồi, mọc sao được.\", \"rating\": 9.0},\n  {\"id\": 759712, \"suggestedTranslation\": \"Tự trồng được rau củ luôn á?!\", \"rating\": 9.0},\n  {\"id\": 759713, \"suggestedTranslation\": \"Đồ ăn vặt đang lớn kìa!\", \"rating\": 9.0},\n  {\"id\": 759714, \"suggestedTranslation\": \"Cho phân vào đây đi, florp!\", \"rating\": 9.0},\n  {\"id\": 759715, \"suggestedTranslation\": \"Đào hố cho cây con nào.\", \"rating\": 9.0},\n  {\"id\": 759716, \"suggestedTranslation\": \"Glurp! Lửa!\", \"rating\": 9.0},\n  {\"id\": 759717, \"suggestedTranslation\": \"Của mình!\", \"rating\": 9.0},\n  {\"id\": 759718, \"suggestedTranslation\": \"Đồ ăn to chà bá! Của mình hết!\", \"rating\": 9.0},\n  {\"id\": 759719, \"suggestedTranslation\": \"Cỏ dại kìa!\", \"rating\": 9.0},\n  {\"id\": 759720, \"suggestedTranslation\": \"Chỉ là thực vật thôi mà.\", \"rating\": 9.0},\n  {\"id\": 759721, \"suggestedTranslation\": \"Lâu thế nhỉ. Đói bụng rồi đây!\", \"rating\": 9.0},\n  {\"id\": 759722, \"suggestedTranslation\": \"Ái chà, định ăn cái đó mà...\", \"rating\": 9.0},\n  {\"id\": 759723, \"suggestedTranslation\": \"Blegh! Hỏng bét rồi!\", \"rating\": 9.0},\n  {\"id\": 759724, \"suggestedTranslation\": \"Lớn nhanh lên nào!\", \"rating\": 9.0},\n  {\"id\": 759725, \"suggestedTranslation\": \"Nó đang đánh nhau với đất kìa!\", \"rating\": 9.0},\n  {\"id\": 759726, \"suggestedTranslation\": \"Bọn không vảy dùng nó để làm \\\"vườn-hộ-vệ\\\".\", \"rating\": 9.0},\n  {\"id\": 759727, \"suggestedTranslation\": \"Chỗ này không dành cho ngươi đâu! Cút!\", \"rating\": 9.0},\n  {\"id\": 759728, \"suggestedTranslation\": \"Cái này rớt ra từ con chim nào thế?!\", \"rating\": 9.0},\n  {\"id\": 759729, \"suggestedTranslation\": \"Nhìn giống chim, nghĩ như chim.\", \"rating\": 9.0},\n  {\"id\": 759730, \"suggestedTranslation\": \"Dùng để viết lách sang chảnh đấy, florp.\", \"rating\": 9.0},\n  {\"id\": 759731, \"suggestedTranslation\": \"Lông chim hoàng yến vàng.\", \"rating\": 9.0},\n  {\"id\": 759732, \"suggestedTranslation\": \"Lông chim quạ đen.\", \"rating\": 9.0},\n  {\"id\": 759733, \"suggestedTranslation\": \"Lông chim hồng đỏ.\", \"rating\": 9.0},\n  {\"id\": 759734, \"suggestedTranslation\": \"Lông chim tuyết.\", \"rating\": 9.0},\n  {\"id\": 759735, \"suggestedTranslation\": \"Bị kẹt hả?\", \"rating\": 9.0},\n  {\"id\": 759736, \"suggestedTranslation\": \"Chặn bọn Lợn ghẻ lại, florp.\", \"rating\": 9.0},\n  {\"id\": 759737, \"suggestedTranslation\": \"Tia điện đâu rồi? Tạo tia điện đi.\", \"rating\": 9.0},\n  {\"id\": 759738, \"suggestedTranslation\": \"Mình chạm vào xem sao.\", \"rating\": 9.0},\n  {\"id\": 759739, \"suggestedTranslation\": \"Đặt ở đâu để giật điện nhỉ?\", \"rating\": 9.0},\n  {\"id\": 759740, \"suggestedTranslation\": \"Oooh khôn phết, làm cửa trên hàng rào kìa.\", \"rating\": 9.0},\n  {\"id\": 759741, \"suggestedTranslation\": \"Để xây cửa hàng rào!\", \"rating\": 9.0},\n  {\"id\": 759742, \"suggestedTranslation\": \"Để xây hàng rào!\", \"rating\": 9.0},\n  {\"id\": 759743, \"suggestedTranslation\": \"Làm từ đống mảnh vụn kim loại.\", \"rating\": 9.0},\n  {\"id\": 759744, \"suggestedTranslation\": \"Cái gậy nhọn xoay tít!\", \"rating\": 9.0},\n  {\"id\": 759745, \"suggestedTranslation\": \"Hả? Toàn phân là phân thôi mà.\", \"rating\": 9.0},\n  {\"id\": 759746, \"suggestedTranslation\": \"Ai đang c