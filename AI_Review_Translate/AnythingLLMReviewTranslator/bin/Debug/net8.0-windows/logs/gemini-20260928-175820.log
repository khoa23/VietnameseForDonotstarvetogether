on\":\"Đáng sợ quá làm sao mà chợp mắt được!\",\"rating\":0.0},\n  {\"id\":758711,\"suggestedTranslation\":\"Chưa phải lúc ngủ đâu, florp!\",\"rating\":0.0},\n  {\"id\":758712,\"suggestedTranslation\":\"Trời sáng trưng thế này ngủ sao được!\",\"rating\":0.0},\n  {\"id\":758713,\"suggestedTranslation\":\"Chưa buồn ngủ, florp.\",\"rating\":0.0},\n  {\"id\":758714,\"suggestedTranslation\":\"Bụng kêu réo ầm ĩ rồi!\",\"rating\":0.0},\n  {\"id\":758715,\"suggestedTranslation\":\"Cần ăn đã, rồi mới đến giờ ngủ.\",\"rating\":0.0},\n  {\"id\":758716,\"suggestedTranslation\":\"Phải xuống trước đã.\",\"rating\":0.0},\n  {\"id\":758717,\"suggestedTranslation\":\"Không muốn ngủ trưa, muốn đi ngủ tối!\",\"rating\":0.0},\n  {\"id\":758718,\"suggestedTranslation\":\"Glurp... trong này đáng sợ quá...\",\"rating\":0.0},\n  {\"id\":758719,\"suggestedTranslation\":\"Haha! Đang cháy kìa.\",\"rating\":0.0},\n  {\"id\":758720,\"suggestedTranslation\":\"Glurgh... NGƯỜI SẮT SÁNG QUÁ.\",\"rating\":0.0},\n  {\"id\":758721,\"suggestedTranslation\":\"Không đời nào ngủ ở đó đâu, glort.\",\"rating\":0.0},\n  {\"id\":758722,\"suggestedTranslation\":\"Đâu có.\",\"rating\":0.0},\n  {\"id\":758724,\"suggestedTranslation\":\"Dễ ợt, florp!\",\"rating\":0.0},\n  {\"id\":758725,\"suggestedTranslation\":\"Glurgh... khó thế nhở.\",\"rating\":0.0},\n  {\"id\":758726,\"suggestedTranslation\":\"Không! Quay lại đây, cá ơi!\",\"rating\":0.0},\n  {\"id\":758727,\"suggestedTranslation\":\"Cá! Lại đây câu cá nào!\",\"rating\":0.0},\n  {\"id\":758728,\"suggestedTranslation\":\"Doo-dee-doo-dee-dum...\",\"rating\":0.0},\n  {\"id\":758729,\"suggestedTranslation\":\"Mấy con cá đi đâu hết rồi?\",\"rating\":0.0},\n  {\"id\":758730,\"suggestedTranslation\":\"Glurph. Lâu thế không biết.\",\"rating\":0.0},\n  {\"id\":758731,\"suggestedTranslation\":\"Glurph! Này!\",\"rating\":0.0},\n  {\"id\":758732,\"suggestedTranslation\":\"Dây chùng quá, cá sắp sổng mất rồi!\",\"rating\":0.0},\n  {\"id\":758733,\"suggestedTranslation\":\"Có ai đang đến à?\",\"rating\":0.0},\n  {\"id\":758734,\"suggestedTranslation\":\"Hee-hee, cậu phá hỏng kịch rồi!\",\"rating\":0.0},\n  {\"id\":758735,\"suggestedTranslation\":\"Không công bằng! Đâu có biết là không được phá nhà chuột cá!\",\"rating\":0.0},\n  {\"id\":758736,\"suggestedTranslation\":\"Glorp! Về vùng nước nông mau, về vùng nước nông mau!\",\"rating\":0.0},\n  {\"id\":758737,\"suggestedTranslation\":\"Ái! ÁI! Đau thế!\",\"rating\":0.0},\n  {\"id\":758738,\"suggestedTranslation\":\"Glurp... cây cối trông đáng sợ dần rồi...\",\"rating\":0.0},\n  {\"id\":758739,\"suggestedTranslation\":\"Gluurgh... hôi thế.\",\"rating\":0.0},\n  {\"id\":758740,\"suggestedTranslation\":\"Nghe như có ai đang chơi vui ở đằng kia kìa! Muốn xem quá!\",\"rating\":0.0},\n  {\"id\":758741,\"suggestedTranslation\":\"Nó sẽ thành cái gì đây?\",\"rating\":0.0},\n  {\"id\":758742,\"suggestedTranslation\":\"Oooh, học được một loại thực vật mới!\",\"rating\":0.0},\n  {\"id\":758743,\"suggestedTranslation\":\"Oooh... đầu cứ quay mòng mòng...\",\"rating\":0.0},\n  {\"id\":758744,\"suggestedTranslation\":\"Glurp... thế này là dở rồi.\",\"rating\":0.0},\n  {\"id\":758745,\"suggestedTranslation\":\"Đất đang rung chuyển kìa!\",\"rating\":0.0},\n  {\"id\":758746,\"suggestedTranslation\":\"Glorp. Không phải ở đây.\",\"rating\":0.0},\n  {\"id\":758747,\"suggestedTranslation\":\"Glorp, ai mà đào bới cáu kỉnh thế nhỉ?\",\"rating\":0.0},\n  {\"id\":758748,\"suggestedTranslation\":\"Oooh con thỏ ngộ nghĩnh!\",\"rating\":0.0},\n  {\"id\":758749,\"suggestedTranslation\":\"Flort!\",\"rating\":0.0},\n  {\"id\":758750,\"suggestedTranslation\":\"Cái gì tới vậy? Nghe... hay phết nhở?\",\"rating\":0.0},\n  {\"id\":758751,\"suggestedTranslation\":\"Aww... chẳng có chút mật ong nào bên trong...\",\"rating\":0.0},\n  {\"id\":758752,\"suggestedTranslation\":\"Quyển này có hình mấy chú chim nhỏ này!\",\"rating\":0.0},\n  {\"id\":758753,\"suggestedTranslation\":\"Flurrgh, muốn biết kết cục thế nào quá!\",\"rating\":0.0},\n  {\"id\":758754,\"suggestedTranslation\":\"Glurp, lửa đáng sợ lắm!\",\"rating\":0.0},\n  {\"id\":758755,\"suggestedTranslation\":\"Quyển sách tuyệt nhất! Có cả đàn cá trong này!\",\"rating\":0.0},\n  {\"id\":758756,\"suggestedTranslation\":\"Nhiều từ khó thế...\",\"rating\":0.0},\n  {\"id\":758757,\"suggestedTranslation\":\"Nhiều từ khó thế...\",\"rating\":0.0},\n  {\"id\":758758,\"suggestedTranslation\":\"M-mình sẽ kiếm quyển nào dễ hơn...\",\"rating\":0.0},\n  {\"id\":758759,\"suggestedTranslation\":\"Heeyyy, mấy từ này khác quá!\",\"rating\":0.0},\n  {\"id\":758760,\"suggestedTranslation\":\"Có hơn một loại từ để học á?! Glurgh...\",\"rating\":0.0},\n  {\"id\":758761,\"suggestedTranslation\":\"Hả. Mặt trăng chán ngắt thực ra ấy chứ.\",\"rating\":0.0},\n  {\"id\":758762,\"suggestedTranslation\":\"Có thể bảo mưa phải làm gì á? Muốn thử quá!!\",\"rating\":0.0},\n  {\"id\":758763,\"suggestedTranslation\":\"Đọc khó kinh khủng, nhưng cầm nó lên thấy mình thông minh hẳn, florp!\",\"rating\":0.0},\n  {\"id\":758764,\"suggestedTranslation\":\"Cả câu chuyện nói về cây cối á? Cây cối thì tớ rành!\",\"rating\":0.0},\n  {\"id\":758765,\"suggestedTranslation\":\"Wuh... wunce? Ngày xửa! N-ngày... xửa... ạ...\",\"rating\":0.0},\n  {\"id\":758766,\"suggestedTranslation\":\"S-sự... đo lường năng lượng... của chuột chũi...\",\"rating\":0.0},\n  {\"id\":758767,\"suggestedTranslation\":\"Quyển này hay đấy!\",\"rating\":0.0},\n  {\"id\":758768,\"suggestedTranslation\":\"Này nhóc Webby! Tớ đang học hết bí mật của Người Nhện rồi đây!\",\"rating\":0.0},\n  {\"id\":758769,\"suggestedTranslation\":\"Sao không đánh trúng chứ!\",\"rating\":0.0},\n  {\"id\":758770,\"suggestedTranslation\":\"Đầu chứa đầy chữ nghĩa thông minh rồi, flurp!\",\"rating\":0.0},\n  {\"id\":758771,\"suggestedTranslation\":\"G-glurp... khiếp vía.\",\"rating\":0.0},\n  {\"id\":758772,\"suggestedTranslation\":\"Khỏe lại hết rồi, flurp!\",\"rating\":0.0},\n  {\"id\":758773,\"suggestedTranslation\":\"Giờ chúng mình là bạn rồi... phải không florp?\",\"rating\":0.0},\n  {\"id\":758774,\"suggestedTranslation\":\"Nhân vật to tát quan trọng!\",\"rating\":0.0},\n  {\"id\":758775,\"suggestedTranslation\":\"Đầu đội vương miện!\",\"rating\":0.0},\n  {\"id\":758776,\"suggestedTranslation\":\"Có câu chuyện cổ tích nào kể về cậu không, florp?\",\"rating\":0.0},\n  {\"id\":758777,\"suggestedTranslation\":\"Nhân vật \\\"quan trọng\\\" to tát!\",\"rating\":0.0},\n  {\"id\":758778,\"suggestedTranslation\":\"Cái đầu tấu hài!\",\"rating\":0.0},\n  {\"id\":758779,\"suggestedTranslation\":\"Chẳng có câu chuyện cổ tích nào kể về cậu đâu, florp!\",\"rating\":0.0},\n  {\"id\":758780,\"suggestedTranslation\":\"K-không thích mấy con quái vật này chút nào, florp!\",\"rating\":0.0},\n  {\"id\":758781,\"suggestedTranslation\":\"Grrr... cái hộp xấu tính.\",\"rating\":0.0},\n  {\"id\":758782,\"suggestedTranslation\":\"Yay!\",\"rating\":0.0},\n  {\"id\":758783,\"suggestedTranslation\":\"Hết chỗ trống trong sách phế liệu rồi.\",\"rating\":0.0},\n  {\"id\":758784,\"suggestedTranslation\":\"Glorp! Sao cậu cứ bám theo tớ thế?\",\"rating\":0.0},\n  {\"id\":758785,\"suggestedTranslation\":\"Glurph! Cái mõm cắn ngầm lộ ra kìa!\",\"rating\":0.0},\n  {\"id\":758786,\"suggestedTranslation\":\"K-không sợ ánh sáng kỳ dị đâu, florp!\",\"rating\":0.0},\n  {\"id\":758787,\"suggestedTranslation\":\"Cảm ơn cái cây nhé, florp!\",\"rating\":0.0},\n  {\"id\":758790,\"suggestedTranslation\":\"GLORP!\",\"rating\":0.0},\n  {\"id\":758791,\"suggestedTranslation\":\"Thực vật hư đốn!\",\"rating\":0.0},\n  {\"id\":758792,\"suggestedTranslation\":\"Không có tuyết. Glurph.\",\"rating\":0.0}\n]",
