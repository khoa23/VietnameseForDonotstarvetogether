            "text": "[\n  {\"id\":760308,\"suggestedTranslation\":\"Nó hôi quá.\",\"rating\":9.0},\n  {\"id\":760309,\"suggestedTranslation\":\"Tạo ra mấy tia lửa giận dữ trên trời kìa.\",\"rating\":9.0},\n  {\"id\":760310,\"suggestedTranslation\":\"Chào nhé, flort!\",\"rating\":9.0},\n  {\"id\":760311,\"suggestedTranslation\":\"Chỉ dành cho Người Cá to lớn thôi, glorp...\",\"rating\":9.0},\n  {\"id\":760312,\"suggestedTranslation\":\"Chỉ dành cho Người Cá to lớn thôi, glorp...\",\"rating\":9.0},\n  {\"id\":760313,\"suggestedTranslation\":\"Cố lên nào, hỡi Người Cá của ta.\",\"rating\":9.0},\n  {\"id\":760314,\"suggestedTranslation\":\"Đứa nào làm thế này?!\",\"rating\":9.0},\n  {\"id\":760315,\"suggestedTranslation\":\"Biến mất còn hơn là thành thế này. Glurgh.\",\"rating\":9.0},\n  {\"id\":760316,\"suggestedTranslation\":\"Sau này tớ cũng sẽ lớn to và khỏe mạnh như thế!\",\"rating\":9.0},\n  {\"id\":760317,\"suggestedTranslation\":\"Floooorp... cậu là Người Cá mạnh nhất, xinh đẹp nhất.\",\"rating\":9.0},\n  {\"id\":760318,\"suggestedTranslation\":\"Chào lại nào, lính canh Người Cá!\",\"rating\":9.0},\n  {\"id\":760319,\"suggestedTranslation\":\"Làm cho kẻ không vảy trông giống Người Cá thân thiện!\",\"rating\":9.0},\n  {\"id\":760320,\"suggestedTranslation\":\"Glurp...\",\"rating\":9.0},\n  {\"id\":760321,\"suggestedTranslation\":\"Ai lại làm chuyện đó cơ chứ...\",\"rating\":9.0},\n  {\"id\":760322,\"suggestedTranslation\":\"Khônggggggggg!!\",\"rating\":9.0},\n  {\"id\":760323,\"suggestedTranslation\":\"Đâu có đầm lầy thì đó là nhà, florp.\",\"rating\":9.0},\n  {\"id\":760324,\"suggestedTranslation\":\"SAO LẠI THẾ KHÔNG BIẾT!?\",\"rating\":9.0},\n  {\"id\":760325,\"suggestedTranslation\":\"Tự tay tớ làm đấy nhé!\",\"rating\":9.0},\n  {\"id\":760326,\"suggestedTranslation\":\"Yeah! Cậu trông y hệt các vị Vua trong truyện cổ tích!\",\"rating\":9.0},\n  {\"id\":760327,\"suggestedTranslation\":\"ĐỨA NÀO LÀM THẾ NÀY?!\",\"rating\":9.0},\n  {\"id\":760328,\"suggestedTranslation\":\"Chỗ ngồi tốt cho Vua Người Cá!\",\"rating\":9.0},\n  {\"id\":760329,\"suggestedTranslation\":\"KHÔNGGGGG!!\",\"rating\":9.0},\n  {\"id\":760330,\"suggestedTranslation\":\"Có rất nhiều vị Vua trong truyện cổ tích... trông có vẻ dễ làm!\",\"rating\":9.0},\n  {\"id\":760331,\"suggestedTranslation\":\"Lính canh hoàng gia cần Vua để bảo vệ...\",\"rating\":9.0},\n  {\"id\":760332,\"suggestedTranslation\":\"Cần lính canh hoàng gia để bảo vệ Vua mới!\",\"rating\":9.0},\n  {\"id\":760333,\"suggestedTranslation\":\"Đang làm nón chiến đấu cho Người Cá.\",\"rating\":9.0},\n  {\"id\":760334,\"suggestedTranslation\":\"Nón chiến đấu Người Cá xịn nhất ở đây!\",\"rating\":9.0},\n  {\"id\":760335,\"suggestedTranslation\":\"Người Cá có gai!\",\"rating\":9.0},\n  {\"id\":760336,\"suggestedTranslation\":\"Cần phải vỗ béo nếu cậu muốn làm một vị Vua thực thụ!\",\"rating\":9.0},\n  {\"id\":760337,\"suggestedTranslation\":\"Người Cá quay lại rồi!\",\"rating\":9.0},\n  {\"id\":760338,\"suggestedTranslation\":\"Làm ra cho những Người Cá chăm chỉ!\",\"rating\":9.0},\n  {\"id\":760339,\"suggestedTranslation\":\"Có công cụ của Người Cá ở bên trong.\",\"rating\":9.0},\n  {\"id\":760340,\"suggestedTranslation\":\"Công cụ của Người Cá này xịn hơn.\",\"rating\":9.0},\n  {\"id\":760341,\"suggestedTranslation\":\"Dành riêng cho những Người Cá làm việc chăm chỉ nhất!\",\"rating\":9.0},\n  {\"id\":760342,\"suggestedTranslation\":\"Chị Wicker!! Đọc xem nó viết gì đi!\",\"rating\":9.0},\n  {\"id\":760343,\"suggestedTranslation\":\"Chẳng có gì trong này cả!\",\"rating\":9.0},\n  {\"id\":760344,\"suggestedTranslation\":\"Glurp! Tớ không làm thế đâu nhé!!\",\"rating\":9.0},\n  {\"id\":760345,\"suggestedTranslation\":\"Tớ cũng làm được nè! Người Cá siêu khỏe luôn, flurt!\",\"rating\":9.0},\n  {\"id\":760346,\"suggestedTranslation\":\"Mềm mịn!\",\"rating\":9.0},\n  {\"id\":760347,\"suggestedTranslation\":\"Cái đèn đội đầu ngộ nghĩnh.\",\"rating\":9.0},\n  {\"id\":760348,\"suggestedTranslation\":\"Cái phao nước xinh xắn.\",\"rating\":9.0},\n  {\"id\":760349,\"suggestedTranslation\":\"Hee-hee-hee!\",\"rating\":9.0},\n  {\"id\":760350,\"suggestedTranslation\":\"Lé lói!\",\"rating\":9.0},\n  {\"id\":760351,\"suggestedTranslation\":\"Ồ, tranh vẽ kìa!\",\"rating\":9.0},\n  {\"id\":760352,\"suggestedTranslation\":\"Glorph? Chẳng có gì trên đó cả.\",\"rating\":9.0},\n  {\"id\":760353,\"suggestedTranslation\":\"Đặt nó ở đâu nhỉ?\",\"rating\":9.0},\n  {\"id\":760354,\"suggestedTranslation\":\"Glurp... trông nó có vẻ cáu kỉnh.\",\"rating\":9.0},\n  {\"id\":760355,\"suggestedTranslation\":\"Kho báu ư?\",\"rating\":9.0},\n  {\"id\":760356,\"suggestedTranslation\":\"Của tớ rồi nhé, flort!\",\"rating\":9.0},\n  {\"id\":760357,\"suggestedTranslation\":\"Ruột con bọ lạnh ngắt.\",\"rating\":9.0},\n  {\"id\":760358,\"suggestedTranslation\":\"Blegh!! Ruột bọ ghê tởm quá!\",\"rating\":9.0},\n  {\"id\":760359,\"suggestedTranslation\":\"Glurgh. Thôi dẹp đi.\",\"rating\":9.0},\n  {\"id\":760360,\"suggestedTranslation\":\"Nhiều chuyện ghê!\",\"rating\":9.0},\n  {\"id\":760361,\"suggestedTranslation\":\"Đừng có ngoáy nữa xem nào, flort!\",\"rating\":9.0},\n  {\"id\":760362,\"suggestedTranslation\":\"Cậu đang đi đâu thế?\",\"rating\":9.0},\n  {\"id\":760363,\"suggestedTranslation\":\"Đừng tin cái mũi heo to đùng của nó.\",\"rating\":9.0},\n  {\"id\":760364,\"suggestedTranslation\":\"Biết đâu có kho báu bên trong!\",\"rating\":9.0},\n  {\"id\":760365,\"suggestedTranslation\":\"Có mùi khá thơm đấy chứ, florp.\",\"rating\":9.0},\n  {\"id\":760366,\"suggestedTranslation\":\"Nhà của chuột chũi.\",\"rating\":9.0},\n  {\"id\":760367,\"suggestedTranslation\":\"Hee-hee, chú khỉ ngộ nghĩnh.\",\"rating\":9.0},\n  {\"id\":760368,\"suggestedTranslation\":\"Trông có vẻ thân thiện đấy, florp.\",\"rating\":9.0},\n  {\"id\":760369,\"suggestedTranslation\":\"Tớ không làm thế nhé! Tìm thấy nó thế này mà!\",\"rating\":9.0},\n  {\"id\":760370,\"suggestedTranslation\":\"Nhà của Người Cá vẫn xịn hơn, florp.\",\"rating\":9.0},\n  {\"id\":760371,\"suggestedTranslation\":\"Bầu trời bị thủng á!?\",\"rating\":9.0},\n  {\"id\":760372,\"suggestedTranslation\":\"Trông giống mấy mảnh máy móc của kẻ không vảy.\",\"rating\":9.0},\n  {\"id\":760373,\"suggestedTranslation\":\"Ê... đây không phải cây thật!\",\"rating\":9.0},\n  {\"id\":760374,\"suggestedTranslation\":\"Ai cho phép cô làm Nữ hoàng đấy, flort?!\",\"rating\":9.0},\n  {\"id\":760375,\"suggestedTranslation\":\"Cái loài thực vật kỳ cục này từ đâu ra vậy?\",\"rating\":9.0},\n  {\"id\":760376,\"suggestedTranslation\":\"Ta là thuyền trưởng đây!\",\"rating\":9.0},\n  {\"id\":760377,\"suggestedTranslation\":\"Đó là chu... chuối... chuốina... cái khăn trùm đầu!\",\"rating\":9.0},\n  {\"id\":760378,\"suggestedTranslation\":\"Cái gì... trong này thế?\",\"rating\":9.0},\n  {\"id\":760379,\"suggestedTranslation\":\"Glurgh, thôi dẹp đi.\",\"rating\":9.0},\n  {\"id\":760380,\"suggestedTranslation\":\"Bây giờ thì nó càng nặng mùi hơn nữa, florp!\",\"rating\":9.0},\n  {\"id\":760381,\"suggestedTranslation\":\"Tên sang chảnh cũng chẳng làm nó ngon hơn đâu, flort.\",\"rating\":9.0},\n  {\"id\":760382,\"suggestedTranslation\":\"Ai đó làm hỏng mất rồi, flrot!\",\"rating\":9.0},\n  {\"id\":760383,\"suggestedTranslation\":\"Nó đang muốn gì à?\",\"rating\":9.0},\n  {\"id\":760384,\"suggestedTranslation\":\"Cái gậy sáng lóe!\",\"rating\":9.0},\n  {\"id\":760385,\"suggestedTranslation\":\"Có chuyện gì xảy ra không thế, florp?\",\"rating\":9.0},\n  {\"id\":760386,\"suggestedTranslation\":\"Trông có vẻ không ổn lắm.\",\"rating\":9.0},\n  {\"id\":760387,\"suggestedTranslation\":\"Trông đỡ xấu xí hơn bướm bình thường một chút.\",\"rating\":9.0},\n  {\"id\":760388,\"suggestedTranslation\":\"Mềm mại...\",\"rating\":9.0},\n  {\"id\":760389,\"suggestedTranslation\":\"Hơi bụi bặm một chút.\",\"rating\":9.0},\n  {\"id\":760390,\"suggestedTranslation\":\"Cây mọc ra từ bọ á? Hôm nay tớ học được khối thứ đấy!\",\"rating\":9.0},\n  {\"id\":760391,\"suggestedTranslation\":\"Chỗ này không ổn chút nào.\",\"rating\":9.0},\n  {\"id\":760392,\"suggestedTranslation\":\"Cái ao mặt trăng đặc biệt.\",\"rating\":9.0},\n  {\"id\":760393,\"suggestedTranslation\":\"Glurph... có cái gì đang theo dõi thì phải.\",\"rating\":9.0},\n  {\"id\":760394,\"suggestedTranslation\":\"Mặt trăng to tròn nảy tưng tưng kìa, florp!\",\"rating\":9.0},\n  {\"id\":760395,\"suggestedTranslation\":\"Đêm nay mặt trăng không đi bơi à?\",\"rating\":9.0},\n  {\"id\":760396,\"suggestedTranslation\":\"Đêm nay trông mặt trăng nhỏ hơn hẳn.\",\"rating\":9.0},\n  {\"id\":760397,\"suggestedTranslation\":\"Lớn nhanh lên nào, mặt trăng ơi!\",\"rating\":9.0},\n  {\"id\":760398,\"suggestedTranslation\":\"Glurp! Sắc quá!\",\"rating\":9.0},\n  {\"id\":760399,\"suggestedTranslation\":\"Chặt bén cực kỳ luôn, florp!\",\"rating\":9.0},\n  {\"id\":760400,\"suggestedTranslation\":\"Mấy thứ sắc nhọn phát sáng.\",\"rating\":9.0},\n  {\"id\":760401,\"suggestedTranslation\":\"Màu đẹp phết, florp.\",\"rating\":9.0},\n  {\"id\":760402,\"suggestedTranslation\":\"Hình như tớ vừa thấy cái gì đó động đậy trong đó.\",\"rating\":9.0},\n  {\"id\":760403,\"suggestedTranslation\":\"Đá tảng cần được trang trí cho xinh xắn!\",\"rating\":9.0},\n  {\"id\":760404,\"suggestedTranslation\":\"Nó đang nhìn tớ kìa.\",\"rating\":9.0},\n  {\"id\":760405,\"suggestedTranslation\":\"Cục đá tảng kỳ lạ.\",\"rating\":9.0},\n  {\"id\":760406,\"suggestedTranslation\":\"Lơ lửng kìa!\",\"rating\":9.0},\n  {\"id\":760407,\"suggestedTranslation\":\"Mặt trăng làm ra mấy thứ này á?\",\"rating\":9.0},\n  {\"id\":760408,\"suggestedTranslation\":\"Người Nhện còn khó ưa hơn nữa!!\",\"rating\":9.0},\n  {\"id\":760409,\"suggestedTranslation\":\"Rất là sắc bén.\",\"rating\":9.0},\n  {\"id\":760410,\"suggestedTranslation\":\"Oooooooh xinh quá!\",\"rating\":9.0},\n  {\"id\":760411,\"suggestedTranslation\":\"Grrr, không lấy củ khoai tây ra được!\",\"rating\":9.0},\n  {\"id\":760412,\"suggestedTranslation\":\"Glorp! Nó giật đi