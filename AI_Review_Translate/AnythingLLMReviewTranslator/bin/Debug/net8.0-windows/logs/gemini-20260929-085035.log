            "text": "[\n  {\"id\": 760608, \"suggestedTranslation\": \"Chuột cá!\", \"rating\": 9.0},\n  {\"id\": 760609, \"suggestedTranslation\": \"Glọrp! Không có đồ của chuột cá đâu!\", \"rating\": 9.0},\n  {\"id\": 760610, \"suggestedTranslation\": \"Chơi trò ăn cắp với chuột cá nhé, flôrt!\", \"rating\": 9.0},\n  {\"id\": 760611, \"suggestedTranslation\": \"Ối trời... nhiều nước thế.\", \"rating\": 9.0},\n  {\"id\": 760612, \"suggestedTranslation\": \"Cái cây kỳ quặc thật.\", \"rating\": 9.0},\n  {\"id\": 760613, \"suggestedTranslation\": \"Chưa sẵn sàng đâu, vẫn đang lớn mà.\", \"rating\": 9.0},\n  {\"id\": 760614, \"suggestedTranslation\": \"Đấy không phải vẩy, tao biết vẩy trông thế nào mà!!\", \"rating\": 9.0},\n  {\"id\": 760615, \"suggestedTranslation\": \"Á chà, mới chỉ là một bé con thôi.\", \"rating\": 9.0},\n  {\"id\": 760616, \"suggestedTranslation\": \"Trong hộp có gì thế?\", \"rating\": 9.0},\n  {\"id\": 760617, \"suggestedTranslation\": \"Bánh mì ngon ngon!\", \"rating\": 9.0},\n  {\"id\": 760618, \"suggestedTranslation\": \"Phát ra âm thanh buồn ngủ, flôrp.\", \"rating\": 9.0},\n  {\"id\": 760619, \"suggestedTranslation\": \"Viết thêm nhiều truyện vào nhé, chị Wicker!\", \"rating\": 9.0},\n  {\"id\": 760620, \"suggestedTranslation\": \"Ông đầu bếp lịch thiệp gọi nó là me... mer-ingy... mer-angy...\", \"rating\": 9.0},\n  {\"id\": 760621, \"suggestedTranslation\": \"Glurp, con bọ tệ hại!\", \"rating\": 9.0},\n  {\"id\": 760622, \"suggestedTranslation\": \"Mấy con chim thông minh, thà bơi còn hơn bay.\", \"rating\": 9.0},\n  {\"id\": 760623, \"suggestedTranslation\": \"Florp! Nướng chín con chim đi!\", \"rating\": 9.0},\n  {\"id\": 760624, \"suggestedTranslation\": \"Chim chết à. Glurgh.\", \"rating\": 9.0},\n  {\"id\": 760625, \"suggestedTranslation\": \"Chim chết đang tỉnh lại kìa! Florp!\", \"rating\": 9.0},\n  {\"id\": 760626, \"suggestedTranslation\": \"Glaaagh! Miệng bốc lửa rồi!\", \"rating\": 9.0},\n  {\"id\": 760627, \"suggestedTranslation\": \"\\\"Bụp\\\" ở đâu hả flôrt? Toàn vị cay thôi!\", \"rating\": 9.0},\n  {\"id\": 760628, \"suggestedTranslation\": \"Sao lại làm ớt cay hơn nữa thế?\", \"rating\": 9.0},\n  {\"id\": 760629, \"suggestedTranslation\": \"Cái đó chắc cay xé họng luôn, florp.\", \"rating\": 9.0},\n  {\"id\": 760630, \"suggestedTranslation\": \"Làm thêm mấy món ăn vặt ngon lành nào!\", \"rating\": 9.0},\n  {\"id\": 760631, \"suggestedTranslation\": \"Grrr, cút đi con chim nhồi sọ!\", \"rating\": 9.0},\n  {\"id\": 760632, \"suggestedTranslation\": \"Gậy lông vũ!\", \"rating\": 9.0},\n  {\"id\": 760633, \"suggestedTranslation\": \"Cháy trụi rồi còn đâu, flûrt.\", \"rating\": 9.0},\n  {\"id\": 760634, \"suggestedTranslation\": \"Có cái gì đặt ở đây à?\", \"rating\": 9.0},\n  {\"id\": 760635, \"suggestedTranslation\": \"Hả? Mày muốn gì hả con chim tham ăn?\", \"rating\": 9.0},\n  {\"id\": 760636, \"suggestedTranslation\": \"Glurgh, giấu thịt bên trong á??\", \"rating\": 9.0},\n  {\"id\": 760637, \"suggestedTranslation\": \"Hì hì, ăn đòn đi mấy bông hoa!\", \"rating\": 9.0},\n  {\"id\": 760638, \"suggestedTranslation\": \"Mấy mảnh khô khốc chẳng ngon chút nào.\", \"rating\": 9.0},\n  {\"id\": 760639, \"suggestedTranslation\": \"Glurgh, chẳng muốn mang theo mấy thứ này tẹo nào.\", \"rating\": 9.0},\n  {\"id\": 760640, \"suggestedTranslation\": \"Mấy mảnh khô khốc chẳng ngon chút nào.\", \"rating\": 9.0},\n  {\"id\": 760641, \"suggestedTranslation\": \"Đá tảng hình cái cây á?\", \"rating\": 9.0},\n  {\"id\": 760642, \"suggestedTranslation\": \"Còn ăn thứ tệ hơn rồi, florp.\", \"rating\": 9.0},\n  {\"id\": 760643, \"suggestedTranslation\": \"Có tiếng nhạc phát ra từ nó kìa, florp!\", \"rating\": 9.0},\n  {\"id\": 760644, \"suggestedTranslation\": \"Đồ đập đá tảng.\", \"rating\": 9.0},\n  {\"id\": 760645, \"suggestedTranslation\": \"Nó phá đồ đỉnh cực luôn.\", \"rating\": 9.0},\n  {\"id\": 760646, \"suggestedTranslation\": \"Ai đang chơi khăm đấy, toàn rau củ tạo hình câu cá mà!\", \"rating\"