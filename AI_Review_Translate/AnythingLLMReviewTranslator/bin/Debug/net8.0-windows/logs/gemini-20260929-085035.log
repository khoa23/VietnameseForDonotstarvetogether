          {
            "text": "[\n  {\"id\": 760908, \"suggestedTranslation\": \"Xin chào, thỏ!\", \"rating\": 9.0},\n  {\"id\": 760909, \"suggestedTranslation\": \"Tớ thích nó lắm.\", \"rating\": 9.0},\n  {\"id\": 760910, \"suggestedTranslation\": \"Nhà thỏ.\", \"rating\": 9.0},\n  {\"id\": 760911, \"suggestedTranslation\": \"Có ai ở nhà không, florp?\", \"rating\": 9.0},\n  {\"id\": 760912, \"suggestedTranslation\": \"Ái chà, muốn ăn cái đó cơ!\", \"rating\": 9.0},\n  {\"id\": 760913, \"suggestedTranslation\": \"Hít hà... có ai ở bên trong...\", \"rating\": 9.0},\n  {\"id\": 760914, \"suggestedTranslation\": \"Tớ thổi sừng thỏ nè.\", \"rating\": 9.0},\n  {\"id\": 760915, \"suggestedTranslation\": \"Cảm ơn thỏ nhé!\", \"rating\": 9.0},\n  {\"id\": 760916, \"suggestedTranslation\": \"Flort, Thỏ Người! Tớ tưởng chúng mình là bạn!\", \"rating\": 9.0},\n  {\"id\": 760917, \"suggestedTranslation\": \"Sừng thỏ già cáu kỉnh!\", \"rating\": 9.0},\n  {\"id\": 760918, \"suggestedTranslation\": \"Con thỏ già cáu kỉnh thích đá đấm. Glurgh.\", \"rating\": 9.0},\n  {\"id\": 760919, \"suggestedTranslation\": \"Tớ bắt được cậu bây giờ!\", \"rating\": 9.0},\n  {\"id\": 760920, \"suggestedTranslation\": \"Chào con thỏ có râu thân thiện!\", \"rating\": 9.0},\n  {\"id\": 760921, \"suggestedTranslation\": \"Sao kẻ không vảy lại sợ mưa thế?\", \"rating\": 9.0},\n  {\"id\": 760922, \"suggestedTranslation\": \"Mưa có gì mà đáng sợ!\", \"rating\": 9.0},\n  {\"id\": 760923, \"suggestedTranslation\": \"Thôi vậy, florp.\", \"rating\": 9.0},\n  {\"id\": 760924, \"suggestedTranslation\": \"Mong là trời sắp mưa!\", \"rating\": 9.0},\n  {\"id\": 760925, \"suggestedTranslation\": \"Cái này ngon nhất!!\", \"rating\": 9.0},\n  {\"id\": 760926, \"suggestedTranslation\": \"Thứ dùng để cắt hả?\", \"rating\": 9.0},\n  {\"id\": 760927, \"suggestedTranslation\": \"Lại nữa.\", \"rating\": 9.0},\n  {\"id\": 760928, \"suggestedTranslation\": \"Lại nữa!\", \"rating\": 9.0},\n  {\"id\": 760929, \"suggestedTranslation\": \"Chán ngắt. Bài tiếp theo.\", \"rating\": 9.0},\n  {\"id\": 760930, \"suggestedTranslation\": \"Tiếp theo.\", \"rating\": 9.0},\n  {\"id\": 760931, \"suggestedTranslation\": \"Còn gì nữa không?\", \"rating\": 9.0},\n  {\"id\": 760932, \"suggestedTranslation\": \"Dài quá.\", \"rating\": 9.0},\n  {\"id\": 760933, \"suggestedTranslation\": \"Tiếp theo.\", \"rating\": 9.0},\n  {\"id\": 760934, \"suggestedTranslation\": \"Không thích. Tiếp theo.\", \"rating\": 9.0},\n  {\"id\": 760935, \"suggestedTranslation\": \"Tiếp theo.\", \"rating\": 9.0},\n  {\"id\": 760936, \"suggestedTranslation\": \"Thích cái này.\", \"rating\": 9.0},\n  {\"id\": 760937, \"suggestedTranslation\": \"Chán ngắt. Bài tiếp theo.\", \"rating\": 9.0},\n  {\"id\": 760938, \"suggestedTranslation\": \"Không thích. Tiếp theo.\", \"rating\": 9.0},\n  {\"id\": 760939, \"suggestedTranslation\": \"Nó đẹp và ấm áp.\", \"rating\": 9.0},\n  {\"id\": 760940, \"suggestedTranslation\": \"Hừm, trông cũng hay phết.\", \"rating\": 9.0},\n  {\"id\": 760941, \"suggestedTranslation\": \"Có cái gì đó trong mắt nó kìa, florp.\", \"rating\": 9.0},\n  {\"id\": 760942, \"suggestedTranslation\": \"Có cái gì đang kêu lanh canh bên trong.\", \"rating\": 9.0},\n  {\"id\": 760943, \"suggestedTranslation\": \"Mấy thứ này không tốt cho cậu đâu, florp.\", \"rating\": 9.0},\n  {\"id\": 760944, \"suggestedTranslation\": \"Khá hơn một chút...\", \"rating\": 9.0},\n  {\"id\": 760945, \"suggestedTranslation\": \"Chào nấm!\", \"rating\": 9.0},\n  {\"id\": 760946, \"suggestedTranslation\": \"Đi ra đây!\", \"rating\": 9.0},\n  {\"id\": 760947, \"suggestedTranslation\": \"Không còn cái nào.\", \"rating\": 9.0},\n  {\"id\": 760948, \"suggestedTranslation\": \"Glurgh!! Đầm lầy đang cháy!\", \"rating\": 9.0},\n  {\"id\": 760949, \"suggestedTranslation\": \"Có rất nhiều thứ này trong đầm lầy!\", \"rating\": 9.0},\n  {\"id\": 760950, \"suggestedTranslation\": \"Phải tìm thêm thôi, flurp.\", \"rating\": 9.0},\n  {\"id\": 760951, \"suggestedTranslation\": \"Đã làm ra khối bụi rồi, florpt.\", \"rating\": 9.0},\n  {\"id\": 760952, \"suggestedTranslation\": \"Hừm... màu cam.\", \"rating\": 9.0},\n  {\"id\": 760953, \"suggestedTranslation\": \"Đồ cổ.\", \"rating\": 9.0},\n  {\"id\": 760954, \"suggestedTranslation\": \"Thôi được rồi.\", \"rating\": 9.0},\n  {\"id\": 760955, \"suggestedTranslation\": \"Ông chú tóc buồn cười bảo \\\"Khoa học\\\" xuất phát từ đây á?\", \"rating\": 9.0},\n  {\"id\": 760956, \"suggestedTranslation\": \"Chà, nó tiêu đời rồi.\", \"rating\": 9.0},\n  {\"id\": 760957, \"suggestedTranslation\": \"An-ki-mi... en...jun...\", \"rating\": 9.0},\n  {\"id\": 760958, \"suggestedTranslation\": \"Mừng là nó biến mất rồi.\", \"rating\": 9.0},\n  {\"id\": 760959, \"suggestedTranslation\": \"Glurp... không nên nghịch cái đó.\", \"rating\": 9.0},\n  {\"id\": 760960, \"suggestedTranslation\": \"Cái máy mũ kỳ dị bị cháy rồi.\", \"rating\": 9.0},\n  {\"id\": 760961, \"suggestedTranslation\": \"Chắc cậu tự bịa ra cái đó thôi, florp.\", \"rating\": 9.0},\n  {\"id\": 760962, \"suggestedTranslation\": \"Biến mọi thứ thành... những thứ khác!\", \"rating\": 9.0},\n  {\"id\": 760963, \"suggestedTranslation\": \"Glurgh... nó thối thật đấy.\", \"rating\": 9.0},\n  {\"id\": 760964, \"suggestedTranslation\": \"Ông chú tóc buồn cười... ổn chứ?\", \"rating\": 9.0},\n  {\"id\": 760965, \"suggestedTranslation\": \"Đây là phép thuật mạnh mẽ!\", \"rating\": 9.0},\n  {\"id\": 760966, \"suggestedTranslation\": \"Glurp! Nó vẫn đang cử động!\", \"rating\": 9.0},\n  {\"id\": 760967, \"suggestedTranslation\": \"Chúng không cứng rắn lắm đâu, flort!\", \"rating\": 9.0},\n  {\"id\": 760968, \"suggestedTranslation\": \"Trông giống gà tây dở tệ, nhưng ngửi lại giống rau củ?\", \"rating\": 9.0},\n  {\"id\": 760969, \"suggestedTranslation\": \"Chim đỏ.\", \"rating\": 9.0},\n  {\"id\": 760970, \"suggestedTranslation\": \"Chim nhỏ của tớ!\", \"rating\": 9.0},\n  {\"id\": 760971, \"suggestedTranslation\": \"Chim tuyết.\", \"rating\": 9.0},\n  {\"id\": 760972, \"suggestedTranslation\": \"Nó thích được vuốt ve.\", \"rating\": 9.0},\n  {\"id\": 760973, \"suggestedTranslation\": \"Làm cho cục bông to trông giống Người Sắt hả?\", \"rating\": 9.0},\n  {\"id\": 760974, \"suggestedTranslation\": \"Cậu bị kẹt à?\", \"rating\": 9.0},\n  {\"id\": 760975, \"suggestedTranslation\": \"Chỉ là một hòn đá tảng thôi, florpt.\", \"rating\": 9.0},\n  {\"id\": 760976, \"suggestedTranslation\": \"Đám cục đá, florp.\", \"rating\": 9.0},\n  {\"id\": 760977, \"suggestedTranslation\": \"Chào!\", \"rating\": 9.0},\n  {\"id\": 760978, \"suggestedTranslation\": \"Không có quả nào ở đây cả, flort.\", \"rating\": 9.0},\n  {\"id\": 760979, \"suggestedTranslation\": \"Lửa! Lửa!\", \"rating\": 9.0},\n  {\"id\": 760980, \"suggestedTranslation\": \"Trông nó ốm yếu quá, flurt.\", \"rating\": 9.0},\n  {\"id\": 760981, \"suggestedTranslation\": \"Có gì đó không ổn với nó...\", \"rating\": 9.0},\n  {\"id\": 760982, \"suggestedTranslation\": \"Hả? Mấy quả đó trông giống cục đá thế, flort.\", \"rating\": 9.0},\n  {\"id\": 760983, \"suggestedTranslation\": \"Mọc lại đi nào!\", \"rating\": 9.0},\n  {\"id\": 760984, \"suggestedTranslation\": \"Trông nó có vẻ khát nước.\", \"rating\": 9.0},\n  {\"id\": 760985, \"suggestedTranslation\": \"Ái! Cứng quá!\", \"rating\": 9.0},\n  {\"id\": 760986, \"suggestedTranslation\": \"Nó chín rồi!\", \"rating\": 9.0},\n  {\"id\": 760987, \"suggestedTranslation\": \"Làm cho nó ngon hơn rồi!\", \"rating\": 9.0},\n  {\"id\": 760988, \"suggestedTranslation\": \"Còn quá nhỏ để ra quả.\", \"rating\": 9.0},\n  {\"id\": 760989, \"suggestedTranslation\": \"Brrr, lạnh vẩy quá!\", \"rating\": 9.0},\n  {\"id\": 760990, \"suggestedTranslation\": \"Vũng nước bùn băng.\", \"rating\": 9.0},\n  {\"id\": 760991, \"suggestedTranslation\": \"Vũng nước bùn băng.\", \"rating\": 9.0},\n  {\"id\": 760992, \"suggestedTranslation\": \"Không thích nó lắm, florp.\", \"rating\": 9.0},\n  {\"id\": 760993, \"suggestedTranslation\": \"Nó đang hóa đá rồi.\", \"rating\": 9.0},\n  {\"id\": 760994, \"suggestedTranslation\": \"Phát sáng kìa!\", \"rating\": 9.0},\n  {\"id\": 760995, \"suggestedTranslation\": \"Hừm.\", \"rating\": 9.0},\n  {\"id\": 760996, \"suggestedTranslation\": \"Đá mặt trăng!\", \"rating\": 9.0},\n  {\"id\": 760997, \"suggestedTranslation\": \"Đá tảng hình cái cây hả?\", \"rating\": 9.0},\n  {\"id\": 760998, \"suggestedTranslation\": \"Đá tảng hình cái cây hả?\", \"rating\": 9.0},\n  {\"id\": 760999, \"suggestedTranslation\": \"Trông có vẻ dữ tợn...\", \"rating\": 9.0},\n  {\"id\": 761000, \"suggestedTranslation\": \"Glorp! Có chuyện gì với nó vậy?!\", \"rating\": 9.0},\n  {\"id\": 761001, \"suggestedTranslation\": \"Dùng để buộc, florpt.\", \"rating\": 9.0},\n  {\"id\": 761002, \"suggestedTranslation\": \"Đừng sợ! Tớ sẽ xây một cây cầu RẤT an toàn.\", \"rating\": 9.0},\n  {\"id\": 761003, \"suggestedTranslation\": \"Đó là mắt thực vật của chị Wunewna!\", \"rating\": 9.0},\n  {\"id\": 761005, \"suggestedTranslation\": \"Có mùi thối rất ra gì.\", \"rating\": 9.0},\n  {\"id\": 761006, \"suggestedTranslation\": \"Mmmmmmmm!\", \"rating\": 9.0},\n  {\"id\": 761007, \"suggestedTranslation\": \"Cục đá và những thứ khác.\", \"rating\": 9.0},\n  {\"id\": 761008, \"suggestedTranslation\": \"Nữ hoàng Wurt!!\", \"rating\": 9.0},\n  {\"id\": 761009, \"suggestedTranslation\": \"Dụng cụ đập phá!\", \"rating\": 9.0},\n  {\"id\": 761010, \"suggestedTranslation\": \"Cục đá và những thứ khác.\", \"rating\": 9.0},\n  {\"id\": 761011, \"suggestedTranslation\": \"Tự hỏi có gì bên trong nhỉ?\", \"rating\": 9.0},\n  {\"id\": 761012, \"suggestedTranslation\": \"Này!\", \"rating\": 9.0},\n  {\"id\": 761013, \"suggestedTranslation\": \"Tháo yên cưỡi khỏi cục bông to.\", \"rating\": 9.0},\n  {\"id\": 761014, \"suggestedTranslation\": \"Hì hì, có mấy cái sừng nhỏ trên đó kìa!\", \"rating\": 9.0},\n  {\"id\": 761015, \"suggestedTranslation\": \"Bướm hóa ra cũng hữu ích đấy chứ, flort!\", \"rating\": 9.0},\n  {\"id\": 761016, \"suggestedTranslation\": \"Ghế cưỡi của bạn hiền xinh đẹp.\", \"rating\": 9.0},\n  {\"id\": 761017, \"suggestedTranslation\": \"Sẽ chiến đấu vì vinh quang của Người Cá!\", \"rating\": 9.0},\n  {\"id\": 761018, \"suggestedTranslation\": \"Tới lượt tớ cưỡi cục bông to đây!\", \"rating\": 9.0},\n  {\"id\": 761019, \"suggestedTranslation\": \"Rau củ nhuyễn cay!\", \"rating\": 9.0},\n  {\"id\": 761020, \"suggestedTranslation\": \"Nơi hoàn hảo để giấu đồ ăn ngon.\", \"rating\": 9.0},\n  {\"id\": 761021, \"suggestedTranslation\": \"Ý cậu là sao, \\\"chỉ dành cho bò lai\\\"?\", \"rating\": 9.0},\n  {\"id\": 761022, \"suggestedTranslation\": \"Măm măm, mặn quá!\", \"rating\": 9.0},\n  {\"id\": 761023, \"suggestedTranslation\": \"Hòn đá tảng kỳ lạ.\", \"rating\": 9.0},\n  {\"id\": 761024, \"suggestedTranslation\": \"Mấy cục đá kỳ lạ, florp.\", \"rating\": 9.0},\n  {\"id\": 761025, \"suggestedTranslation\": \"Nó đang lớn kìa!\", \"rating\": 9.0},\n  {\"id\": 761026, \"suggestedTranslation\": \"Không còn gì để lấy nữa.\", \"rating\": 9.0},\n  {\"id\": 761027, \"suggestedTranslation\": \"Lấy muối đi, cún biển ơi!\", \"rating\": 9.0},\n  {\"id\": 761028, \"suggestedTranslation\": \"Bộ lông mềm mịn như cún biển!\", \"rating\": 9.0},\n  {\"id\": 761029, \"suggestedTranslation\": \"Gloorph!\", \"rating\": 9.0},\n  {\"id\": 761030, \"suggestedTranslation\": \"Áaa! Nhọn quá!\", \"rating\": 9.0},\n  {\"id\": 761031, \"suggestedTranslation\": \"Tránh ra nào, florp!\", \"rating\": 9.0},\n  {\"id\": 761032, \"suggestedTranslation\": \"Chắc là tưởng tượng ra thôi...\", \"rating\": 9.0},\n  {\"id\": 761033, \"suggestedTranslation\": \"Lửa!\", \"rating\": 9.0},\n  {\"id\": 761034, \"suggestedTranslation\": \"Hừm... trông tệ quá.\", \"rating\": 9.0},\n  {\"id\": 761035, \"suggestedTranslation\": \"Có cái gì đó không ổn với nó, florp.\", \"rating\": 9.0},\n  {\"id\": 761036, \"suggestedTranslation\": \"Cái cây nhỏ!\", \"rating\": 9.0},\n  {\"id\": 761037, \"suggestedTranslation\": \"Lấy được rồi!\", \"rating\": 9.0},\n  {\"id\": 761038, \"suggestedTranslation\": \"Khô quá rồi, florp.\", \"rating\": 9.0},\n  {\"id\": 761039, \"suggestedTranslation\": \"Glurgh... chị Wicker đọc được không nhỉ?\", \"rating\": 9.0},\n  {\"id\": 761040, \"suggestedTranslation\": \"Khônggggg! Cứu bác ấy với!!\", \"rating\": 9.0},\n  {\"id\": 761041, \"suggestedTranslation\": \"Glort...\", \"rating\": 9.0},\n  {\"id\": 761042, \"suggestedTranslation\": \"Thích bác ấy lắm!\", \"rating\": 9.0},\n  {\"id\": 761043, \"suggestedTranslation\": \"Đứng gần lửa trại quá đấy, florp.\", \"rating\": 9.0},\n  {\"id\": 761044, \"suggestedTranslation\": \"Tìm được trang cho cuốn sách nham nhở rồi!\", \"rating\": 9.0},\n  {\"id\": 761045, \"suggestedTranslation\": \"Blegh, vẫn còn mùi của tên Người Lợn đáng ghét!\", \"rating\": 9.0},\n  {\"id\": 761046, \"suggestedTranslation\": \"Nhìn thấy mọi thứ luôn!\", \"rating\": 9.0},\n  {\"id\": 761047, \"suggestedTranslation\": \"Sắp làm ra món gì ngon rồi đây, flort!\", \"rating\": 9.0},\n  {\"id\": 761048, \"suggestedTranslation\": \"Giờ không dùng được.\", \"rating\": 9.0},\n  {\"id\": 761049, \"suggestedTranslation\": \"Tạo ra mọi thứ từ cục đá!\", \"rating\": 9.0},\n  {\"id\": 761050, \"suggestedTranslation\": \"Nhìn kìa! Tự tay làm đấy!\", \"rating\": 9.0},\n  {\"id\": 761051, \"suggestedTranslation\": \"Có gì đó kỳ lạ về nó.\", \"rating\": 9.0},\n  {\"id\": 761052, \"suggestedTranslation\": \"Xong hết rồi!\", \"rating\": 9.0},\n  {\"id\": 761053, \"suggestedTranslation\": \"Hả?\", \"rating\": 9.0},\n  {\"id\": 761054, \"suggestedTranslation\": \"Nó bị mất đầu rồi, flurp!\", \"rating\": 9.0},\n  {\"id\": 761055, \"suggestedTranslation\": \"Trông có vẻ lạc đường, flort.\", \"rating\": 9.0},\n  {\"id\": 761056, \"suggestedTranslation\": \"Cái đó có ý nghĩa gì nhỉ?\", \"rating\": 9.0},\n  {\"id\": 761057, \"suggestedTranslation\": \"Đã lắp lại với nhau!\", \"rating\": 9.0},\n  {\"id\": 761058, \"suggestedTranslation\": \"Có chuyện gì đang xảy ra...\", \"rating\": 9.0},\n  {\"id\": 761059, \"suggestedTranslation\": \"Nó hỏng rồi!\", \"rating\": 9.0},\n  {\"id\": 761060, \"suggestedTranslation\": \"Trông giống đầu Người Sắt.\", \"rating\": 9.0},\n  {\"id\": 761061, \"suggestedTranslation\": \"Đó là một cục đá tảng kỳ lạ...\", \"rating\": 9.0},\n  {\"id\": 761062, \"suggestedTranslation\": \"Trông khá hơn một chút rồi, flurt.\", \"rating\": 9.0},\n  {\"id\": 761063, \"suggestedTranslation\": \"Có chuyện gì đang xảy ra...\", \"rating\": 9.0},\n  {\"id\": 761064, \"suggestedTranslation\": \"Thiếu mất thứ gì đó...\", \"rating\": 9.0},\n  {\"id\": 761065, \"suggestedTranslation\": \"Hừm, nghĩ cái này thuộc về chỗ nào đó.\", \"rating\": 9.0},\n  {\"id\": 761066, \"suggestedTranslation\": \"Chuyện đó hình như xảy ra suốt...\", \"rating\": 9.0},\n  {\"id\": 761067, \"suggestedTranslation\": \"Chế tạo đồ dùng dưới nước nào, florp!\", \"rating\": 9.0},\n  {\"id\": 761068, \"suggestedTranslation\": \"Con cá trông có vẻ buồn bã trong đó quá...\", \"rating\": 9.0},\n  {\"id\": 761069, \"suggestedTranslation\": \"Úi chà, hòn đá tảng to quá!\", \"rating\": 9.0},\n  {\"id\": 761070, \"suggestedTranslation\": \"Glorp! Trống không!\", \"rating\": 9.0},\n  {\"id\": 761071, \"suggestedTranslation\": \"Ôi, thích quả cầu phát sáng này ghê.\", \"rating\": 9.0},\n  {\"id\": 761072, \"suggestedTranslation\": \"Nhét hạt vào bên trong.\", \"rating\": 9.0},\n  {\"id\": 761073, \"suggestedTranslation\": \"Gieo xuống đất nào, florp!\", \"rating\": 9.0},\n  {\"id\": 761074, \"suggestedTranslation\": \"Món ăn vặt tí hon!\", \"rating\": 9.0},\n  {\"id\": 761075, \"suggestedTranslation\": \"Sao nó lại lơ lửng được thế nhỉ?\", \"rating\": 9.0},\n  {\"id\": 761076, \"suggestedTranslation\": \"Glurgh... kim khâu khó cầm bằng vuốt quá...\", \"rating\": 9.0},\n  {\"id\": 761077, \"suggestedTranslation\": \"Tốt. Đừng có trợn mắt nữa, florp.\", \"rating\": 9.0},\n  {\"id\": 761078, \"suggestedTranslation\": \"Thôi trợn mắt đi, flort!\", \"rating\": 9.0},\n  {\"id\": 761079, \"suggestedTranslation\": \"Chị Wunewna giỏi vá víu thật.\", \"rating\": 9.0},\n  {\"id\": 761080, \"suggestedTranslation\": \"Grừ! Nó đang làm gì thế? Sao nó lại cử động kiểu đó chứ?!\", \"rating\": 9.0},\n  {\"id\": 761081, \"suggestedTranslation\": \"Hắn dùng phép thuật hắc ám kìa!!\", \"rating\": 9.0},\n  {\"id\": 761082, \"suggestedTranslation\": \"Cảm thấy... buồn quá...\", \"rating\": 9.0},\n  {\"id\": 761083, \"suggestedTranslation\": \"Glorp! Mặt đất nứt rồi!\", \"rating\": 9.0},\n  {\"id\": 761084, \"suggestedTranslation\": \"To lớn, mạnh mẽ và xinh xắn!\", \"rating\": 9.0},\n  {\"id\": 761085, \"suggestedTranslation\": \"Haha! Florpt!\", \"rating\": 9.0},\n  {\"id\": 761086, \"suggestedTranslation\": \"Cậu đang đi đâu thế?\", \"rating\": 9.0},\n  {\"id\": 761087, \"suggestedTranslation\": \"C-cút đi!!\", \"rating\": 9.0},\n  {\"id\": 761088, \"suggestedTranslation\": \"Này! Không được ăn!!\", \"rating\": 9.0},\n  {\"id\": 761089, \"suggestedTranslation\": \"Glorp! Lắm răng thế!\", \"rating\": 9.0},\n  {\"id\": 761090, \"suggestedTranslation\": \"Aww. Chỉ muốn ôm cái thôi. Florp!\", \"rating\": 9.0},\n  {\"id\": 761091, \"suggestedTranslation\": \"T-tớ không sợ cậu đâu, florp!\", \"rating\": 9.0},\n  {\"id\": 761092, \"suggestedTranslation\": \"Đến giờ chặt chém rồi!\", \"rating\": 9.0},\n  {\"id\": 761093, \"suggestedTranslation\": \"Đánh thức người bạn đang ngủ nào.\", \"rating\": 9.0},\n  {\"id\": 761094, \"suggestedTranslation\": \"Chế đồ cho tớ mau! Ngay lập tức!\", \"rating\": 9.0},\n  {\"id\": 761095, \"suggestedTranslation\": \"Nó chưa sẵn sàng.\", \"rating\": 9.0},\n  {\"id\": 761096, \"suggestedTranslation\": \"Cảm ơn nhé, trái tim buồn bã.\", \"rating\": 9.0},\n  {\"id\": 761097, \"suggestedTranslation\": \"Ai thế nhỉ?\", \"rating\": 9.0},\n  {\"id\": 761098, \"suggestedTranslation\": \"Glurp... trông chúng không thiện cảm cho lắm.\", \"rating\": 9.0},\n  {\"id\": 761099, \"suggestedTranslation\": \"Grừ, con cá 