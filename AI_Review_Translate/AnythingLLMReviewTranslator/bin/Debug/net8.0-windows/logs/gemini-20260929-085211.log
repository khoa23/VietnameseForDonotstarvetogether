          {
            "text": "[\n  {\"id\":761245,\"suggestedTranslation\":\"Đá tảng lớn trong hang.\",\"rating\":9.0},\n  {\"id\":761246,\"suggestedTranslation\":\"Glurph! Có phép thuật bóng tối xấu xa!\",\"rating\":9.0},\n  {\"id\":761247,\"suggestedTranslation\":\"Glurp, n-nó là thật!\",\"rating\":9.0},\n  {\"id\":761248,\"suggestedTranslation\":\"Mấy con bò lổm ngổm!\",\"rating\":9.0},\n  {\"id\":761249,\"suggestedTranslation\":\"K-không sợ ổng nữa đâu!\",\"rating\":9.0},\n  {\"id\":761250,\"suggestedTranslation\":\"Nó chỉ chỗ trốn đồ à? Sẽ lấy trước, florp!\",\"rating\":9.0},\n  {\"id\":761251,\"suggestedTranslation\":\"Ốp... không phải tui làm!\",\"rating\":9.0},\n  {\"id\":761252,\"suggestedTranslation\":\"Đá tảng trông như con bọ kỳ lạ.\",\"rating\":9.0},\n  {\"id\":761253,\"suggestedTranslation\":\"Ai đó làm gãy nó rồi, florp.\",\"rating\":9.0},\n  {\"id\":761254,\"suggestedTranslation\":\"Trông nó bị hỏng rồi. Không phải tui làm!\",\"rating\":9.0},\n  {\"id\":761255,\"suggestedTranslation\":\"Trông hơi giống gã không vảy mỏng manh.\",\"rating\":9.0},\n  {\"id\":761256,\"suggestedTranslation\":\"Viên đá tảng này hình thù buồn cười quá.\",\"rating\":9.0},\n  {\"id\":761257,\"suggestedTranslation\":\"Mất đầu rồi kìa!\",\"rating\":9.0},\n  {\"id\":761258,\"suggestedTranslation\":\"Cảm thấy buồn, florp.\",\"rating\":9.0},\n  {\"id\":761259,\"suggestedTranslation\":\"Trông sang chảnh và chán ngắt, florp.\",\"rating\":9.0},\n  {\"id\":761260,\"suggestedTranslation\":\"Ngứa ngáy quá!\",\"rating\":9.0},\n  {\"id\":761261,\"suggestedTranslation\":\"Wurt là thuyền trưởng!!\",\"rating\":9.0},\n  {\"id\":761262,\"suggestedTranslation\":\"Cái này gắn lên thuyền ván à?\",\"rating\":9.0},\n  {\"id\":761263,\"suggestedTranslation\":\"Cái mông vo ve.\",\"rating\":9.0},\n  {\"id\":761264,\"suggestedTranslation\":\"Uiii, chỗ ngồi xịn xò quá!\",\"rating\":9.0},\n  {\"id\":761265,\"suggestedTranslation\":\"Muốn đổi lượt! Tránh ra mau!\",\"rating\":9.0},\n  {\"id\":761266,\"suggestedTranslation\":\"Bàn chưa dọn xong!\",\"rating\":9.0},\n  {\"id\":761267,\"suggestedTranslation\":\"Chị Wicker! Bàn dọn xong hết rồi nè!\",\"rating\":9.0},\n  {\"id\":761268,\"suggestedTranslation\":\"Không phải tui làm gãy bé Người Sắt đâu. Nhặt được thấy thế sẵn rồi.\",\"rating\":9.0},\n  {\"id\":761269,\"suggestedTranslation\":\"Dọn sạch đống bừa đi nào, bé Người Sắt!\",\"rating\":9.0},\n  {\"id\":761270,\"suggestedTranslation\":\"Ngứa ngáy quá...\",\"rating\":9.0},\n  {\"id\":761271,\"suggestedTranslation\":\"Hả-! Rau củ mà bên trong lại chứa cả rau củ á!?\",\"rating\":9.0},\n  {\"id\":761272,\"suggestedTranslation\":\"Mấy cục bánh mì ngon nghẻ.\",\"rating\":9.0},\n  {\"id\":761273,\"suggestedTranslation\":\"Húp, làm gãy mất tiêu rồi.\",\"rating\":9.0},\n  {\"id\":761274,\"suggestedTranslation\":\"Mấy khúc khô khốc chẳng ngon gì cả.\",\"rating\":9.0},\n  {\"id\":761275,\"suggestedTranslation\":\"Sao mà sống được ở cái chỗ thế này hả?\",\"rating\":9.0},\n  {\"id\":761276,\"suggestedTranslation\":\"Giờ có nhà rồi đấy.\",\"rating\":9.0},\n  {\"id\":761277,\"suggestedTranslation\":\"Vỏ ốc dùng để giấu đồ là chuẩn bài luôn, florpt!\",\"rating\":9.0},\n  {\"id\":761278,\"suggestedTranslation\":\"Hừ hừ, mở ra coi nào!\",\"rating\":9.0},\n  {\"id\":761279,\"suggestedTranslation\":\"Nguy hiểm lắm, toàn mồi Câu Cá gắn lưỡi câu không đấy!\",\"rating\":9.0},\n  {\"id\":761280,\"suggestedTranslation\":\"Này, dừng lại ngay! Không được phép phá đâu nhé, florp!\",\"rating\":9.0},\n  {\"id\":761281,\"suggestedTranslation\":\"Không phải tui làm!\",\"rating\":9.0},\n  {\"id\":761282,\"suggestedTranslation\":\"Được làm bằng chính hai cái vuốt này đấy!\",\"rating\":9.0},\n  {\"id\":761283,\"suggestedTranslation\":\"Này, dừng lại ngay! Không được phép phá đâu nhé, florp!\",\"rating\":9.0},\n  {\"id\":761284,\"suggestedTranslation\":\"Glorp! Thấy nó y vậy luôn.\",\"rating\":9.0},\n  {\"id\":761285,\"suggestedTranslation\":\"Cái cột xinh xắn quá đi, florp!\",\"rating\":9.0},\n  {\"id\":761286,\"suggestedTranslation\":\"Cần cục đá! CẦN THÊM CỤC ĐÁ!!\",\"rating\":9.0},\n  {\"id\":761287,\"suggestedTranslation\":\"Cần cục đá! CẦN THÊM CỤC ĐÁ!!\",\"rating\":9.0},\n  {\"id\":761288,\"suggestedTranslation\":\"Blegh! Không thèm ăn đâu!\",\"rating\":9.0},\n  {\"id\":761289,\"suggestedTranslation\":\"Mấy kẻ không vảy mặc lắm quần áo thế cơ chứ.\",\"rating\":9.0},\n  {\"id\":761290,\"suggestedTranslation\":\"Củ khoai tây này còn ngon hơn khoai tây thường nữa!\",\"rating\":9.0},\n  {\"id\":761291,\"suggestedTranslation\":\"Mmm... ngon phết.\",\"rating\":9.0},\n  {\"id\":761292,\"suggestedTranslation\":\"Của tui!! Tui muốn cây kiếm phát sáng!\",\"rating\":9.0},\n  {\"id\":761293,\"suggestedTranslation\":\"Ối, tiệc tàn rồi à?\",\"rating\":9.0},\n  {\"id\":761294,\"suggestedTranslation\":\"Cái bàn sang chảnh phết.\",\"rating\":9.0},\n  {\"id\":761295,\"suggestedTranslation\":\"Ăn được rồi! Ăn được rồi!\",\"rating\":9.0},\n  {\"id\":761296,\"suggestedTranslation\":\"Cái đó không để ở đây!\",\"rating\":9.0},\n  {\"id\":761297,\"suggestedTranslation\":\"Cái này dùng để làm gì thế nhỉ?\",\"rating\":9.0},\n  {\"id\":761298,\"suggestedTranslation\":\"Uiii, hình vẽ kìa!\",\"rating\":9.0},\n  {\"id\":761299,\"suggestedTranslation\":\"Đâu có ai đối xử với Câu Cá kiểu đó đâu, florp!\",\"rating\":9.0},\n  {\"id\":761300,\"suggestedTranslation\":\"MĂM MĂM MĂM! DAI QUÁ ĐI MẤT!\",\"rating\":9.0},\n  {\"id\":761301,\"suggestedTranslation\":\"Con chim dài ngoè.\",\"rating\":9.0},\n  {\"id\":761302,\"suggestedTranslation\":\"Nghe thấy tiếng gì ở bên trong nè!\",\"rating\":9.0},\n  {\"id\":761303,\"suggestedTranslation\":\"Glurgh...\",\"rating\":9.0},\n  {\"id\":761304,\"suggestedTranslation\":\"Bạn lạnh à?\",\"rating\":9.0},\n  {\"id\":761305,\"suggestedTranslation\":\"Nó chuẩn bị nở rồi kìa!\",\"rating\":9.0},\n  {\"id\":761306,\"suggestedTranslation\":\"Hừm... thấy nóng nóng...\",\"rating\":9.0},\n  {\"id\":761307,\"suggestedTranslation\":\"Sao lâu thế không biết nữa!!\",\"rating\":9.0},\n  {\"id\":761308,\"suggestedTranslation\":\"Sắp chui ra rồi đấy!\",\"rating\":9.0},\n  {\"id\":761309,\"suggestedTranslation\":\"Trứng của con chim dài chân nè!\",\"rating\":9.0},\n  {\"id\":761310,\"suggestedTranslation\":\"Đây là chỗ con chim dài chân ngủ nè.\",\"rating\":9.0},\n  {\"id\":761311,\"suggestedTranslation\":\"Không chịu đâu.\",\"rating\":9.0},\n  {\"id\":761312,\"suggestedTranslation\":\"Mmm, bên trong có nhân rau củ nóng hổi.\",\"rating\":9.0},\n  {\"id\":761313,\"suggestedTranslation\":\"Lớn lên rồi thấy mi chả còn vui như trước nữa.\",\"rating\":9.0},\n  {\"id\":761314,\"suggestedTranslation\":\"Đang đòi ăn vặt kìa.\",\"rating\":9.0},\n  {\"id\":761315,\"suggestedTranslation\":\"Thích ngủ gật lắm cơ, flort.\",\"rating\":9.0},\n  {\"id\":761316,\"suggestedTranslation\":\"Đói vào là cáu kỉnh ngay.\",\"rating\":9.0},\n  {\"id\":761317,\"suggestedTranslation\":\"Thiếu thiếu cái gì ấy nhỉ...\",\"rating\":9.0},\n  {\"id\":761318,\"suggestedTranslation\":\"Sẵn sàng!\",\"rating\":9.0},\n  {\"id\":761319,\"suggestedTranslation\":\"Glorp, lúc nào cũng quay lại được đúng không nhỉ?\",\"rating\":9.0},\n  {\"id\":761320,\"suggestedTranslation\":\"Cái này dẫn đến... thế giới khác à?\",\"rating\":9.0},\n  {\"id\":761321,\"suggestedTranslation\":\"Thiếu cái gì đó phải không florpt?\",\"rating\":9.0},\n  {\"id\":761322,\"suggestedTranslation\":\"Chưa xong hả?\",\"rating\":9.0},\n  {\"id\":761323,\"suggestedTranslation\":\"Cái hộp buồn cười ghê.\",\"rating\":9.0},\n  {\"id\":761324,\"suggestedTranslation\":\"Cái khỉ gì đây?\",\"rating\":9.0},\n  {\"id\":761325,\"suggestedTranslation\":\"Cục sắt to đùng.\",\"rating\":9.0},\n  {\"id\":761326,\"suggestedTranslation\":\"Hừm, đội vương miện thì hơi to quá, florp.\",\"rating\":9.0},\n  {\"id\":761327,\"suggestedTranslation\":\"Làm nhức hết cả đầu, florp...\",\"rating\":9.0},\n  {\"id\":761328,\"suggestedTranslation\":\"Nó cháy trụi rồi.\",\"rating\":9.0},\n  {\"id\":761329,\"suggestedTranslation\":\"Chỗ để ngủ.\",\"rating\":9.0},\n  {\"id\":761330,\"suggestedTranslation\":\"Mấy kẻ không vảy toàn đi vào mấy chỗ đó thôi, florp.\",\"rating\":9.0},\n  {\"id\":761331,\"suggestedTranslation\":\"Ha ha, nhiều gai ghê!\",\"rating\":9.0},\n  {\"id\":761332,\"suggestedTranslation\":\"Lột da nó luôn rồi!\",\"rating\":9.0},\n  {\"id\":761333,\"suggestedTranslation\":\"Tìm thấy nhà của nó rồi nè!\",\"rating\":9.0},\n  {\"id\":761334,\"suggestedTranslation\":\"Cù bụng nó đi!\",\"rating\":9.0},\n  {\"id\":761335,\"suggestedTranslation\":\"Mấy đứa này bé tí hà.\",\"rating\":9.0},\n  {\"id\":761336,\"suggestedTranslation\":\"Trong đó có gì thế nhỉ?\",\"rating\":9.0},\n  {\"id\":761337,\"suggestedTranslation\":\"Cái cây nhỏ xíu đi đâu mất tiêu rồi, florp?\",\"rating\":9.0},\n  {\"id\":761338,\"suggestedTranslation\":\"Trông bên trong có vẻ hơi hài hước.\",\"rating\":9.0},\n  {\"id\":761339,\"suggestedTranslation\":\"CHUYỆN GÌ ĐANG XẢY RA THẾ VẬY?!\",\"rating\":9.0},\n  {\"id\":761340,\"suggestedTranslation\":\"Nó cứ... phát sáng...\",\"rating\":9.0},\n  {\"id\":761341,\"suggestedTranslation\":\"Nó không hoạt động.\",\"rating\":9.0},\n  {\"id\":761342,\"suggestedTranslation\":\"Uiii! Cũng muốn bay lơ lửng như thế nữa!\",\"rating\":9.0},\n  {\"id\":761343,\"suggestedTranslation\":\"Không phải tui làm đâu!!\",\"rating\":9.0},\n  {\"id\":761344,\"suggestedTranslation\":\"Nó ngửi lạ lắm, không phải đồ ở đây đâu.\",\"rating\":9.0},\n  {\"id\":761345,\"suggestedTranslation\":\"Biết đâu trong này có kho báu siêu lấp lánh thì sao?\",\"rating\":9.0},\n  {\"id\":761346,\"suggestedTranslation\":\"Trông dị quá đi, florp...\",\"rating\":9.0},\n  {\"id\":761347,\"suggestedTranslation\":\"Ra đây mau, mấy con bọ! Florp!\",\"rating\":9.0},\n  {\"id\":761348,\"suggestedTranslation\":\"Mấy mảnh vụn cỏn con.\",\"rating\":9.0},\n  {\"id\":761349,\"suggestedTranslation\":\"Mùi kỳ cục ghê, flort.\",\"rating\":9.0},\n  {\"id\":761350,\"suggestedTranslation\":\"Hay tụi mình chơi sau nhé, được không?\",\"rating\":9.0},\n  {\"id\":761351,\"suggestedTranslation\":\"Đó là một cục mèo mềm xèo to đùng! Xin chào!\",\"rating\":9.0},\n  {\"id\":761352,\"suggestedTranslation\":\"Cái mũi của nó hóa ra cũng chẳng thính cho lắm.\",\"rating\":9.0},\n  {\"id\":761353,\"suggestedTranslation\":\"Chắc là nó ngửi thấy gì ở gần đây rồi.\",\"rating\":9.0},\n  {\"id\":761354,\"suggestedTranslation\":\"Chắc quanh đây chẳng có mùi gì đâu.\",\"rating\":9.0},\n  {\"id\":761355,\"suggestedTranslation\":\"Nó làm tốt lắm đấy chứ, florp.\",\"rating\":9.0},\n  {\"id\":761356,\"suggestedTranslation\":\"Nào mèo mềm xèo, muốn thử qua chỗ khác không!\",\"rating\":9.0},\n  {\"id\":761357,\"suggestedTranslation\":\"Nó đang tìm kiếm gì kìa!\",\"rating\":9.0},\n  {\"id\":761358,\"suggestedTranslation\":\"Khoan đã... đây không phải con mèo mềm xèo đúng ý rồi.\",\"rating\":9.0},\n  {\"id\":761359,\"suggestedTranslation\":\"Cỏ dại với mấy cây khác thì khác nhau chỗ nào nhỉ?\",\"rating\":9.0},\n  {\"id\":761360,\"suggestedTranslation\":\"Thấy chưa? Cỏ dại còn hữu ích hơn cả hoa hoét ấy chứ.\",\"rating\":9.0},\n  {\"id\":761361,\"suggestedTranslation\":\"Mấy khúc khô khốc chẳng ngon gì cả.\",\"rating\":9.0},\n  {\"id\":761362,\"suggestedTranslation\":\"Mặt mũi xinh xắn mà tính nết thì tệ hại.\",\"rating\":9.0},\n  {\"id\":761363,\"suggestedTranslation\":\"Chắc tụi mình làm ổng nổi khùng rồi đấy, flort!\",\"rating\":9.0},\n  {\"id\":761364,\"suggestedTranslation\":\"Alooo? CÓ AI Ở NHÀ KHÔNG?\",\"rating\":9.0},\n  {\"id\":761365,\"suggestedTranslation\":\"Cái mũ của bạn đẹp thế, flort.\",\"rating\":9.0},\n  {\"id\":761366,\"suggestedTranslation\":\"Hẹn gặp lại trong đó nhé!\",\"rating\":9.0},\n  {\"id\":761367,\"suggestedTranslation\":\"Cà chua to mọng nước!\",\"rating\":9.0},\n  {\"id\":761368,\"suggestedTranslation\":\"Mềm oặt.\",\"rating\":9.0},\n  {\"id\":761369,\"suggestedTranslation\":\"Món ăn vặt mềm xèo to đùng.\",\"rating\":9.0},\n  {\"id\":761370,\"suggestedTranslation\":\"Trồng thêm mấy món ăn vặt ngon lành nào!\",\"rating\":9.0},\n  {\"id\":761371,\"suggestedTranslation\":\"Uiii, xịn phết!\",\"rating\":9.0},\n  {\"id\":761372,\"suggestedTranslation\":\"Glurgh, cái mũ đẹp đẽ mà dính đầy nhầy nhụa rồi.\",\"rating\":9.0},\n  {\"id\":761373,\"suggestedTranslation\":\"Cây Lửa.\",\"rating\":9.0},\n  {\"id\":761374,\"suggestedTranslation\":\"Mmm, bánh nhân rau củ nóng hổi kìa!\",\"rating\":9.0},\n  {\"id\":761375,\"suggestedTranslation\":\"Sẵn sàng rồi, flort!\",\"rating\":9.0},\n  {\"id\":761376,\"suggestedTranslation\":\"Đưa tui đến chỗ mấy bạn đi!\",\"rating\":9.0},\n  {\"id\":761377,\"suggestedTranslation\":\"Nhảy tới chỗ bạn bè thôi!\",\"rating\":9.0},\n  {\"id\":761378,\"suggestedTranslation\":\"Hòn đá dịch chuyển!\",\"rating\":9.0},\n  {\"id\":761379,\"suggestedTranslation\":\"Rôm rốp, rôm rốp, rôm rốp!\",\"rating\":9.0},\n  {\"id\":761380,\"suggestedTranslation\":\"Trông ổng... có vẻ không cứng rắn cho lắm... glurp.\",\"rating\":9.0},\n  {\"id\":761381,\"suggestedTranslation\":\"Nó đang kêu vo ve kìa! Có bong bóng ong kẹt ở trong à?\",\"rating\":9.0},\n  {\"id\":761382,\"suggestedTranslation\":\"Lém lỉnh thật đấy!\",\"rating\":9.0},\n  {\"id\":761383,\"suggestedTranslation\":\"Bẫy thực vật!\",\"rating\":9.0},\n  {\"id\":761384,\"suggestedTranslation\":\"Glurgh. Bẫy hỏng mất tiêu rồi!\",\"rating\":9.0},\n  {\"id\":761385,\"suggestedTranslation\":\"Hì hì hì...\",\"rating\":9.0},\n  {\"id\":761386,\"suggestedTranslation\":\"Lại đây nào! Chỗ giẫm chân tuyệt vời đấy! Hì hì...\",\"rating\":9.0},\n  {\"id\":761387,\"suggestedTranslation\":\"Cục đá vẫn còn đủ nóng để làm bỏng đấy.\",\"rating\":9.0},\n  {\"id\":761388,\"suggestedTranslation\":\"Glorp! Định ăn thịt tui hả!\",\"rating\":9.0},\n  {\"id\":761389,\"suggestedTranslation\":\"Muốn chọc vào nó quá!\",\"rating\":9.0},\n  {\"id\":761390,\"suggestedTranslation\":\"Trông đáng sợ ghê, florp.\",\"rating\":9.0},\n  {\"id\":761391,\"suggestedTranslation\":\"Glorph! Gai nhọn đáng sợ quá!\",\"rating\":9.0},\n  {\"id\":761392,\"suggestedTranslation\":\"Khônggggg!\",\"rating\":9.0},\n  {\"id\":761393,\"suggestedTranslation\":\"Uiii, hộp đựng đồ kìa!\",\"rating\":9.0},\n  {\"id\":761394,\"suggestedTranslation\":\"Hộp đựng đồ to bự chảng!\",\"rating\":9.0},\n  {\"id\":761395,\"suggestedTranslation\":\"Kho báu!\",\"rating\":9.0},\n  {\"id\":761396,\"suggestedTranslation\":\"Không qua đó được đâu vì... ừm... vì.....\",\"rating\":9.0},\n  {\"id\":761397,\"suggestedTranslation\":\"Glurph. Bôi đầy mặt mà chẳng thấy lớn thêm tí nào cả!\",\"rating\":9.0},\n  {\"id\":761398,\"suggestedTranslation\":\"Chuẩn bị florp đây!\",\"rating\":9.0},\n  {\"id\":761399,\"suggestedTranslation\":\"Haha! Florpt!\",\"rating\":9.0},\n  {\"id\":761400,\"suggestedTranslation\":\"Để tui làm nó florp nào.\",\"rating\":9.0},\n  {\"id\":761401,\"suggestedTranslation\":\"Lớn lên, lớn lên nữa nào!\",\"rating\":9.0},\n  {\"id\":761402,\"suggestedTranslation\":\"Một bé cưng ngọt ngào, florpt!\",\"rating\":9.0},\n  {\"id\":761403,\"suggestedTranslation\":\"Chọc chọc này!\",\"rating\":9.0},\n  {\"id\":761404,\"suggestedTranslation\":\"Mấy hòn đá nhỏ xinh xắn!\",\"rating\":9.0},\n  {\"id\":761405,\"suggestedTranslation\":\"Hì hì, mấy cái răng cưa ngắn ngủn đáng yêu chưa kìa.\",\"rating\":9.0},\n  {\"id\":761406,\"suggestedTranslation\":\"Nó bảo mọi chuyện rồi sẽ ổn cả thôi!\",\"rating\":9.0},\n  {\"id\":761407,\"suggestedTranslation\":\"Hì hì, nó ngỏm rồi.\",\"rating\":9.0},\n  {\"id\":761408,\"suggestedTranslation\":\"Bà cô tí hon kỳ cục.\",\"rating\":9.0},\n  {\"id\":761409,\"suggestedTranslation\":\"Dùng để uống hoặc tắm táp đấy, flort.\",\"rating\":9.0},\n  {\"id\":761410,\"suggestedTranslation\":\"Trông giống như... bé Người Sắt thu nhỏ...?\",\"rating\":9.0},\n  {\"id\":761411,\"suggestedTranslation\":\"Trông giống như... bé Người Sắt thu nhỏ...?\",\"rating\":9.0},\n  {\"id\":761412,\"suggestedTranslation\":\"Đồ hốt thức ăn.\",\"rating\":9.0},\n  {\"id\":761413,\"suggestedTranslation\":\"Có cái gì đang kêu lách cách ở trong kìa.\