            "text": "[\n  {\"id\": 766605, \"suggestedTranslation\": \"Cưng ơi, làm ơn dựng cho ta vài chiếc cọc bến tàu được không?\", \"rating\": 9.0},\n  {\"id\": 766606, \"suggestedTranslation\": \"Ta rất thích những chiếc cọc bến tàu cưng đã dựng đấy. Thêm vài cái nữa thì tuyệt quá!\", \"rating\": 9.0},\n  {\"id\": 766607, \"suggestedTranslation\": \"Ta chỉ muốn thêm vài chiếc cọc bến tàu nữa thôi, cưng ơi!\", \"rating\": 9.0},\n  {\"id\": 766608, \"suggestedTranslation\": \"Chẳng có chỗ nào để ngồi cả, cưng ơi! Làm ơn giúp ta dựng vài cái ghế với.\", \"rating\": 9.0},\n  {\"id\": 766609, \"suggestedTranslation\": \"Ta rất thích có vài cái ghế trong nhà mình, cưng ơi.\", \"rating\": 9.0},\n  {\"id\": 766610, \"suggestedTranslation\": \"Mấy cái ghế cưng dựng đáng yêu lắm, cưng ơi. Thêm vài cái nữa thì tuyệt.\", \"rating\": 9.0},\n  {\"id\": 766611, \"suggestedTranslation\": \"Cưng có thể dựng thêm vài cái ghế nữa cho ta được không, cưng ơi?\", \"rating\": 9.0},\n  {\"id\": 766612, \"suggestedTranslation\": \"Cưng ơi, chẳng còn chỗ nào cho ta câu cá nữa cả!\", \"rating\": 9.0},\n  {\"id\": 766613, \"suggestedTranslation\": \"Ta chẳng có chỗ nào để câu cá! Làm ơn giúp ta đi, cưng của ta ơi!\", \"rating\": 9.0},\n  {\"id\": 766614, \"suggestedTranslation\": \"Vẫn còn nhiều chỗ cho ta câu cá trừ một vài điểm, cưng ơi.\", \"rating\": 9.0},\n  {\"id\": 766615, \"suggestedTranslation\": \"Cưng ơi, vẫn còn vài điểm câu cá ưa thích mà ta không thể với tới.\", \"rating\": 9.0},\n  {\"id\": 766616, \"suggestedTranslation\": \"Khá hơn rồi đấy, nhưng ta vẫn cần thêm điểm câu cá!\", \"rating\": 9.0},\n  {\"id\": 766617, \"suggestedTranslation\": \"Ta không thể đến được một nửa số điểm câu cá yêu thích của mình, cưng ơi.\", \"rating\": 9.0},\n  {\"id\": 766618, \"suggestedTranslation\": \"Ta rất nhớ thực vật của mình, cưng ơi. Cưng làm ơn trồng vài cây giùm ta được không?\", \"rating\": 9.0},\n  {\"id\": 766619, \"suggestedTranslation\": \"Vài khóm thực vật sẽ làm nhà ta đẹp hơn nhiều đấy. Cưng trồng giùm ta vài cây nhé, cưng ơi?\", \"rating\": 9.0},\n  {\"id\": 766620, \"suggestedTranslation\": \"Ta thích đám thực vật cưng vừa trồng lắm, cưng ơi. Thêm vài cây nữa thì tuyệt vời.\", \"rating\": 9.0},\n  {\"id\": 766621, \"suggestedTranslation\": \"Chỉ cần thêm vài khóm thực vật nữa thôi là hoàn hảo luôn đấy, cưng ơi.\", \"rating\": 9.0},\n  {\"id\": 766622, \"suggestedTranslation\": \"Cưng ơi, nhà ta bị bao quanh bởi rác rồi! Giúp ta dọn sạch nó đi?\", \"rating\": 9.0},\n  {\"id\": 766623, \"suggestedTranslation\": \"Rác ở khắp mọi nơi! Ta cần cưng giúp dọn dẹp nó đấy, cưng ơi!\", \"rating\": 9.0},\n  {\"id\": 766624, \"suggestedTranslation\": \"Nhà ta gần như sạch bóng rác rồi! Chỉ còn vài mảnh nữa thôi.\", \"rating\": 9.0},\n  {\"id\": 766625, \"suggestedTranslation\": \"Sắp xong rồi đây! Cưng giúp ta dọn thêm chút rác nữa nhé, cưng ơi?\", \"rating\": 9.0},\n  {\"id\": 766626, \"suggestedTranslation\": \"Chỗ của ta vẫn còn lộn xộn một ít rác. Cưng làm ơn giúp ta dọn dẹp nhé?\", \"rating\": 9.0},\n  {\"id\": 766627, \"suggestedTranslation\": \"Cưng ơi, ta sẽ rất biết ơn nếu có cưng giúp dọn bớt rác quanh đây.\", \"rating\": 9.0},\n  {\"id\": 766628, \"suggestedTranslation\": \"Vẫn còn hơi tối đấy, cưng ơi!\", \"rating\": 9.0},\n  {\"id\": 766629, \"suggestedTranslation\": \"Thêm chút ánh sáng thì đáng yêu biết mấy, cưng của ta ơi.\", \"rating\": 9.0},\n  {\"id\": 766630, \"suggestedTranslation\": \"Mấy cây đèn đẹp lắm! Chỉ cần thêm một hoặc hai cái nữa là ổn.\", \"rating\": 9.0},\n  {\"id\": 766631, \"suggestedTranslation\": \"Cưng ơi, cho thêm chút ánh sáng nữa đi!\", \"rating\": 9.0},\n  {\"id\": 766632, \"suggestedTranslation\": \"Cưng ơi, làm ơn dựng cho ta vài cái giàn phơi lớn hơn được không?\", \"rating\": 9.0},\n  {\"id\": 766633, \"suggestedTranslation\": \"Ta rất muốn có thêm vài cái giàn phơi, cưng của ta ơi.\", \"rating\": 9.0},\n  {\"id\": 766634, \"suggestedTranslation\": \"Tuyệt vời! Hay là thêm một hoặc hai cái giàn phơi lớn nữa nhé, cưng ơi?\", \"rating\": 9.0},\n  {\"id\": 766635, \"suggestedTranslation\": \"Sắp xong rồi, cưng ơi! Chỉ thêm một hoặc hai cái giàn phơi lớn nữa thôi!\", \"rating\": 9.0},\n  {\"id\": 766636, \"suggestedTranslation\": \"Ồ, ta thích chuông gió này quá. Hay là thêm vài cái nữa nhỉ?\", \"rating\": 9.0},\n  {\"id\": 766637, \"suggestedTranslation\": \"Cưng ơi, mấy cái chuông gió này đáng yêu quá! Cho thêm nữa đi!\", \"rating\": 9.0},\n  {\"id\": 766638, \"suggestedTranslation\": \"Chỉ cần thêm một hoặc hai cái chuông gió nữa là được!\", \"rating\": 9.0},\n  {\"id\": 766639, \"suggestedTranslation\": \"Chúng ta sắp đủ chuông gió rồi đấy, cưng ơi!\", \"rating\": 9.0},\n  {\"id\": 766640, \"suggestedTranslation\": \"Chúng ta sẽ cần nhiều thực vật hơn thế này đấy, cưng ơi.\", \"rating\": 9.0},\n  {\"id\": 766641, \"suggestedTranslation\": \"Thêm thực vật nữa thì đáng yêu lắm, cưng ơi!\", \"rating\": 9.0},\n  {\"id\": 766642, \"suggestedTranslation\": \"Ta thích tất cả đám thực vật này! Hay là thêm một hoặc hai cây nữa đi?\", \"rating\": 9.0},\n  {\"id\": 766643, \"suggestedTranslation\": \"Gần như hoàn hảo rồi, cưng ơi! Chỉ thêm vài khóm thực vật nữa thôi!\", \"rating\": 9.0},\n  {\"id\": 766644, \"suggestedTranslation\": \"Cưng ơi, làm ơn dựng cho ta vài cái chậu cho đám thực vật được không?\", \"rating\": 9.0},\n  {\"id\": 766645, \"suggestedTranslation\": \"Ta rất muốn có mấy cái chậu cho đám thực vật của mình, cưng ơi!\", \"rating\": 9.0},\n  {\"id\": 766646, \"suggestedTranslation\": \"Mấy cái chậu này tuyệt thật, nhưng ta rất muốn có thêm vài cái nữa.\", \"rating\": 9.0},\n  {\"id\": 766647, \"suggestedTranslation\": \"Chỉ cần thêm vài cái chậu cho đám thực vật là đủ rồi, cưng của ta ơi.\", \"rating\": 9.0},\n  {\"id\": 766648, \"suggestedTranslation\": \"Ôi cưng ơi, có rất nhiều chỗ ở đây mà đám sinh vật nhỏ bò ra đấy!\", \"rating\": 9.0},\n  {\"id\": 766649, \"suggestedTranslation\": \"Đám sinh vật nhỏ chui ra từ mọi hướng ở đây! Làm ơn quét sạch chúng đi giùm ta, cưng ơi!\", \"rating\": 9.0},\n  {\"id\": 766650, \"suggestedTranslation\": \"Chỉ còn vài nơi trú ẩn của đám sinh vật nhỏ sót lại thôi!\", \"rating\": 9.0},\n  {\"id\": 766651, \"suggestedTranslation\": \"Cưng ơi, cưng có thể giúp ta tống khứ thêm vài tên hàng xóm khó chịu này được không?\", \"rating\": 9.0},\n  {\"id\": 766652, \"suggestedTranslation\": \"Vẫn còn kha khá chỗ để đám sinh vật nhỏ ẩn nấp!\", \"rating\": 9.0},\n  {\"id\": 766653, \"suggestedTranslation\": \"Ta vẫn còn khá nhiều tên hàng xóm không mấy thân thiện. Giúp ta với, cưng ơi!\", \"rating\": 9.0},\n  {\"id\": 766654, \"suggestedTranslation\": \"Cưng ơi, ta nhớ bãi biển quá. Nơi này chẳng giống tí nào cả.\", \"rating\": 9.0},\n  {\"id\": 766655, \"suggestedTranslation\": \"Ta cảm thấy mình không thuộc về nơi này. Ước gì nó giống bãi biển hơn.\", \"rating\": 9.0},\n  {\"id\": 766656, \"suggestedTranslation\": \"Nó bắt đầu có cảm giác giống bãi biển rồi, nhưng chắc cần thêm chút nữa đấy, cưng ơi.\", \"rating\": 9.0},\n  {\"id\": 766657, \"suggestedTranslation\": \"Ôi cưng ơi, chỉ cần thêm một chút nữa thôi là giống bãi biển của ta rồi.\", \"rating\": 9.0},\n  {\"id\": 766658, \"suggestedTranslation\": \"Ta rất muốn có thêm nhiều con cá lớn để trưng bày!\", \"rating\": 9.0},\n  {\"id\": 766659, \"suggestedTranslation\": \"Thêm vài con cá lớn nữa thì tuyệt vời, cưng ơi!\", \"rating\": 9.0},\n  {\"id\": 766660, \"suggestedTranslation\": \"Nơi này làm ta đau đầu khủng khiếp!\", \"rating\": 9.0},\n  {\"id\": 766661, \"suggestedTranslation\": \"Mấy con ma kỳ quặc đó cứ lảng vảng quanh đây!\", \"rating\": 9.0},\n  {\"id\": 766662, \"suggestedTranslation\": \"Làm ơn giúp ta tìm chỗ ở mới đi, cưng ơi.\", \"rating\": 9.0},\n  {\"id\": 766663, \"suggestedTranslation\": \"Ôi, cưng ơi. Ta thực sự không thích ở đây đâu. Giúp ta chuyển đi với, làm ơn!\", \"rating\": 9.0},\n  {\"id\": 766664, \"suggestedTranslation\": \"Cảm ơn vì tất cả mấy cái thùng ong nhé, cưng ơi!\", \"rating\": 9.0},\n  {\"id\": 766665, \"suggestedTranslation\": \"Mấy chú ong của ta rất thích ngôi nhà mới của chúng! Cảm ơn cưng nhé!\", \"rating\": 9.0},\n  {\"id\": 766666, \"suggestedTranslation\": \"Toàn thùng ong là thùng ong! Giờ thì ta có thừa mật ong để uống trà rồi!\", \"rating\": 9.0},\n  {\"id\": 766667, \"suggestedTranslation\": \"Ta không thích có công ty lắm đâu, cưng ơi... ngoại trừ cưng và giờ là bé cưng ngọt ngào này.\", \"rating\": 9.0},\n  {\"id\": 766668, \"suggestedTranslation\": \"Cảm ơn vì đã mang cho ta người bạn nhỏ hoàn hảo này nhé, cưng ơi.\", \"rating\": 9.0},\n  {\"id\": 766669, \"suggestedTranslation\": \"Cảm ơn vì mấy chiếc bàn tuyệt vời nhé, cưng ơi.\", \"rating\": 9.0},\n  {\"id\": 766670, \"suggestedTranslation\": \"Ta thực sự mê mẩn mấy chiếc bàn xinh đẹp mà cưng làm cho ta đấy, cưng ơi.\", \"rating\": 9.0},\n  {\"id\": 766671, \"suggestedTranslation\": \"Mấy cái cọc bến tàu tuyệt thật đấy, cưng ơi!\", \"rating\": 9.0},\n  {\"id\": 766672, \"suggestedTranslation\": \"Ta yêu mấy cái cọc bến tàu của mình lắm, cưng của ta ơi!\", \"rating\": 9.0},\n  {\"id\": 766673, \"suggestedTranslation\": \"Giờ thì ta có thể ngồi xuống một trong mấy cái ghế này, duỗi chân và thưởng thức tách trà rồi!\", \"rating\": 9.0},\n  {\"id\": 766674, \"suggestedTranslation\": \"Giờ thì ta đã có ghế cho những lúc cưng đến thăm rồi!\", \"rating\": 9.0},\n  {\"id\": 766675, \"suggestedTranslation\": \"Ôi cưng ơi, ta thích tất cả đám thực vật mà cưng đã trồng cho ta!\", \"rating\": 9.0},\n  {\"id\": 766676, \"suggestedTranslation\": \"Khu vườn của ta ngập tràn thực vật xinh đẹp nhờ có cưng đấy, cưng ơi!\", \"rating\": 9.0},\n  {\"id\": 766677, \"suggestedTranslation\": \"Mấy khóm thực vật này làm ta hạnh phúc quá! Cảm ơn cưng, cưng của ta ơi.\", \"rating\": 9.0},\n  {\"id\": 766678, \"suggestedTranslation\": \"Giờ thì ta có thể ngâm mình và cho cái vỏ sò già cỗi được nghỉ ngơi rồi.\", \"rating\": 9.0},\n  {\"id\": 766679, \"suggestedTranslation\": \"Đúng là một hồ nước nóng tuyệt vời, cưng ơi! Ghé qua ngâm mình bất cứ lúc nào nhé.\", \"rating\": 9.0},\n  {\"id\": 766680, \"suggestedTranslation\": \"Cảm ơn vì hồ nước nóng tuyệt vời này nhé, cưng ơi.\", \"rating\": 9.0},\n  {\"id\": 766681, \"suggestedTranslation\": \"Nhà ta giờ sáng sủa và đẹp đẽ quá!\", \"rating\": 9.0},\n  {\"id\": 766682, \"suggestedTranslation\": \"Tất cả mấy ngọn đèn này thực sự làm không gian sống động hẳn lên!\", \"rating\": 9.0},\n  {\"id\": 766683, \"suggestedTranslation\": \"Mấy ngọn đèn tỏa ra ánh sáng thật ấm áp và ấm cúng. Thật hoàn hảo.\", \"rating\": 9.0},\n  {\"id\": 766684, \"suggestedTranslation\": \"Ta thích mấy cái giàn phơi mới của mình lắm!\", \"rating\": 9.0},\n  {\"id\": 766685, \"suggestedTranslation\": \"Cảm ơn cưng nhé! Giờ thì ta có vô số chỗ để phơi đồ rồi!\", \"rating\": 9.0},\n  {\"id\": 766686, \"suggestedTranslation\": \"Ta sẽ không bao giờ sợ hết chỗ phơi đồ nữa!\", \"rating\": 9.0},\n  {\"id\": 766687, \"suggestedTranslation\": \"Tuyệt vời! Ta thích cách chúng đung đưa trong gió.\", \"rating\": 9.0},\n  {\"id\": 766688, \"suggestedTranslation\": \"Chúng xuất sắc lắm, cưng ơi.\", \"rating\": 9.0},\n  {\"id\": 766689, \"suggestedTranslation\": \"Đáng yêu tuyệt đối luôn, cưng của ta ơi.\", \"rating\": 9.0},\n  {\"id\": 766690, \"suggestedTranslation\": \"Mọi thứ trông tươi tốt ghê!\", \"rating\": 9.0},\n  {\"id\": 766691, \"suggestedTranslation\": \"Cưng ơi, cưng đúng là có tay làm vườn đấy!\", \"rating\": 9.0},\n  {\"id\": 766692, \"suggestedTranslation\": \"Mọi thực vật ta cần đều nằm trong tầm với của chiếc càng! Chu đáo quá cơ, cưng ơi.\", \"rating\": 9.0},\n  {\"id\": 766693, \"suggestedTranslation\": \"Mấy chậu cây này đáng yêu lắm, cưng ơi.\", \"rating\": 9.0},\n  {\"id\": 766694, \"suggestedTranslation\": \"Ta thực sự thích mấy chậu cây này đấy. Cảm ơn cưng, cưng ơi.\", \"rating\": 9.0},\n  {\"id\": 766695, \"suggestedTranslation\": \"Ôi, cưng ơi! Ta nóng lòng muốn cưng nếm thử tất cả các loại trà của ta rồi!\", \"rating\": 9.0},\n  {\"id\": 766696, \"suggestedTranslation\": \"Cuối cùng thì Quán Trà Ngọc Trai cũng có thể mở cửa kinh doanh rồi!\", \"rating\": 9.0},\n  {\"id\": 766697, \"suggestedTranslation\": \"Cảm ơn đã giúp ta dựng quán trà nhé, cưng ơi.\", \"rating\": 9.0},\n  {\"id\": 766698, \"suggestedTranslation\": \"Đúng là bãi biển của riêng ta! Ta thích lắm, cưng ơi!\", \"rating\": 9.0},\n  {\"id\": 766699, \"suggestedTranslation\": \"Cảm ơn cưng nhé. Cưng đã mang cả bãi biển đến cho ta rồi!\", \"rating\": 9.0},\n  {\"id\": 766700, \"suggestedTranslation\": \"Hoàn hảo luôn, cưng ơi! Ngôi nhà trên bãi biển của ta!\", \"rating\": 9.0},\n  {\"id\": 766701, \"suggestedTranslation\": \"Đúng là một cái cây tuyệt vời mà cưng đã trồng cho ta, cưng ơi!\", \"rating\": 9.0},\n  {\"id\": 766702, \"suggestedTranslation\": \"Ta yêu cái cây của mình lắm, cưng ơi! Nó bảo vệ ta khỏi cái nắng gay gắt và cơn mưa lạnh giá!\", \"rating\": 9.0},\n  {\"id\": 766703, \"suggestedTranslation\": \"Cảm ơn vì đã trồng cái cây xinh đẹp này cho ta nhé, cưng ơi.\", \"rating\": 9.0},\n  {\"id\": 766704, \"suggestedTranslation\": \"Cưng của ta ơi! Ta thích những gì cưng làm với chỗ của ta quá!\", \"rating\": 9.0},\n  {\"id\": 766705, \"suggestedTranslation\": \"Cảm ơn cưng nhé! Giờ thì nơi này thực sự giống như nhà rồi!\", \"rating\": 9.0},\n  {\"id\": 766706, \"suggestedTranslation\": \"Ôi trời, cưng có mắt thẩm mỹ trang trí ghê nơi!\", \"rating\": 9.0},\n  {\"id\": 766707, \"suggestedTranslation\": \"Cưng ơi, cưng làm được rồi kìa! Chỗ của ta trông tuyệt vời quá!\", \"rating\": 9.0},\n  {\"id\": 766708, \"suggestedTranslation\": \"Ta thích lắm, cưng của ta ơi! Cảm ơn sự giúp đỡ của cưng nhé!\", \"rating\": 9.0},\n  {\"id\": 766709, \"suggestedTranslation\": \"Ôi cưng ơi, nơi này đã trở thành một tổ ấm thực thụ rồi! Cảm ơn cưng.\", \"rating\": 9.0},\n  {\"id\": 766710, \"suggestedTranslation\": \"Cưng đã làm một công việc trang trí nhà cửa vô cùng tuyệt vời đấy, cưng ơi!\", \"rating\": 9.0},\n  {\"id\": 766711, \"suggestedTranslation\": \"Đúng là một sự giúp đỡ lớn! Cảm ơn cưng.\", \"rating\": 9.0},\n  {\"id\": 766712, \"suggestedTranslation\": \"Chắc là cưng muốn thứ gì đó vì đã giúp ta chứ gì?\", \"rating\": 9.0},\n  {\"id\": 766713, \"suggestedTranslation\": \"Được rồi.\", \"rating\": 9.0},\n  {\"id\": 766714, \"suggestedTranslation\": \"Chắc có cưng quanh đây cũng không tệ lắm đâu.\", \"rating\": 9.0},\n  {\"id\": 766715, \"suggestedTranslation\": \"Đồ rận chủ!\", \"rating\": 9.0},\n  {\"id\": 766716, \"suggestedTranslation\": \"Lại đi bắt nạt một bà lão hiền lành, ngây thơ như ta cơ đấy!\", \"rating\": 9.0},\n  {\"id\": 766717, \"suggestedTranslation\": \"Thế này mới gọi là một con cá đúng chuẩn chứ!\", \"rating\": 9.0},\n  {\"id\": 766718, \"suggestedTranslation\": \"Nếu cưng tìm thấy người thương của ta trong những chuyến hành trình...\", \"rating\": 9.0},\n  {\"id\": 766719, \"suggestedTranslation\": \"Cưng có thể... đưa cho anh ấy viên ngọc trai đó được không?\", \"rating\": 9.0},\n  {\"id\": 766720, \"suggestedTranslation\": \"Anh ấy sẽ nhận ra nó thôi.\", \"rating\": 9.0},\n  {\"id\": 766721, \"suggestedTranslation\": \"Tấm bản đồ này chẳng có ích gì với ta cả.\", \"rating\": 9.0},\n  {\"id\": 766722, \"suggestedTranslation\": \"Nó chẳng đưa ta đến nơi đặc biệt nào hết.\", \"rating\": 9.0},\n  {\"id\": 766723, \"suggestedTranslation\": \"Hòn đảo trên bản đồ này trông có vẻ đẹp đấy...\", \"rating\": 9.0},\n  {\"id\": 766724, \"suggestedTranslation\": \"Ít ra thì nó cũng cách xa gã thu gom rác đó.\", \"rating\": 9.0},\n  {\"id\": 766725, \"suggestedTranslation\": \"Ta sẽ đi nhưng mà...\", \"rating\": 9.0},\n  {\"id\": 766726, \"suggestedTranslation\": \"Không. Ta sẽ đi.\", \"rating\": 9.0},\n  {\"id\": 766727, \"suggestedTranslation\": \"Ta chán ngấy việc phải đợi hắn ta rồi.\", \"rating\": 9.0},\n  {\"id\": 766728, \"suggestedTranslation\": \"Ồ...\", \"rating\": 9.0},\n  {\"id\": 766729, \"suggestedTranslation\": \"...Ta nghĩ là mình đã hiểu rồi.\", \"rating\": 9.0},\n  {\"id\": 766730, \"suggestedTranslation\": \"Cảm ơn vì đã mang thứ này về cho ta.\", \"rating\": 9.0},\n  {\"id\": 766731, \"suggestedTranslation\": \"Ta rất vui vì cưng đã cứ tiếp tục quay lại.\", \"rating\": 9.0},\n  {\"id\": 766732, \"suggestedTranslation\": \"Bạn của ta.\", \"rating\": 9.0},\n  {\"id\": 766733, \"suggestedTranslation\": \"Như một chút lòng thành để bày tỏ sự biết ơn, ta muốn chia sẻ sáng chế đặc biệt của mình với cưng.\", \"rating\": 9.0},\n  {\"id\": 766734, \"suggestedTranslation\": \"Đã đến lúc cho cái vỏ sò già này nghỉ ngơi rồi.\", \"rating\": 9.0},\n  {\"id\": 766735, \"suggestedTranslation\": \"Biến đi!\", \"rating\": 9.0},\n  {\"id\": 766736, \"suggestedTranslation\": \"Xéo đi!\", \"rating\": 9.0},\n  {\"id\": 766737, \"suggestedTranslation\": \"Để ta yên!\", \"rating\": 9.0},\n  {\"id\": 766738, \"suggestedTranslation\": \"Cấm bén mảng!\", \"rating\": 9.0},\n  {\"id\": 766739, \"suggestedTranslation\": \"Biến khỏi bãi biển của ta ngay!\", \"rating\": 9.0},\n  {\"id\": 766740, \"suggestedTranslation\": \"Hừm.\", \"rating\": 9.0},\n  {\"id\": 766741, \"suggestedTranslation\": \"Đi tìm kẻ khác mà làm phiền đi!\", \"rating\": 9.0},\n  {\"id\": 766742, \"suggestedTranslation\": \"Dạo này cưng thế nào rồi, cưng ơi?\", \"rating\": 9.0},\n  {\"id\": 766743, \"suggestedTranslation\": \"Tránh ra nào, vị khách yêu quý của ta đây mà!\", \"rating\": 9.0},\n  {\"id\": 766744, \"suggestedTranslation\": \"Cưng có ăn uống đầy đủ không đấy?\", \"rating\": 9.0},\n  {\"id\": 766745, \"suggestedTranslation\": \"Cưng đang làm gì ở đây thế?\", \"rating\": 9.0},\n  {\"id\": 766746, \"suggestedTranslation\": \"Cưng muốn gì?\", \"rating\": 9.0},\n  {\"id\": 766747, \"suggestedTranslation\": \"Cưng quay lại rồi à?\", \"rating\": 9.0},\n  {\"id\": 766748, \"suggestedTranslation\": \"Cưng không còn việc gì hay ho hơn để làm à?\", \"rating\": 9.0},\n  {\"id\": 766749, \"suggestedTranslation\": \"Đứa nhắt ranh phiền phức...\", \"rating\": 9.0},\n  {\"id\": 766750, \"suggestedTranslation\": \"Cưng đúng là dai như đỉa\", \"rating\": 9.0},\n  {\"id\": 766751, \"suggestedTranslation\": \"Ta phải công nhận điều đó.\", \"rating\": 9.0},\n  {\"id\": 766752, \"suggestedTranslation\": \"Hừm. Miễn là cưng đừng có làm phiền ta là được.\", \"rating\": 9.0},\n  {\"id\": 766753, \"suggestedTranslation\": \"Chắc là không thể cưỡng lại sức hút lấp lánh của ta đúng không, hửm?\", \"rating\": 9.0},\n  {\"id\": 766754, \"suggestedTranslation\": \"Ơ kìa, hóa ra là... hừm...\", \"rating\": 9.0},\n  {\"id\": 766755, \"suggestedTranslation\": \"Tên cưng là gì ấy nhỉ?\", \"rating\": 9.0},\n  {\"id\": 766756, \"suggestedTranslation\": \"Tại sao cưng lại giúp ta?\", \"rating\": 9.0},\n  {\"id\": 766757, \"suggestedTranslation\": \"Thật khó khăn khi phải một mình chăm sóc chốn cũ này.\", \"rating\": 9.0},\n  {\"id\": 766758, \"suggestedTranslation\": \"Ta nghĩ mình đã quên mất việc có khách đến chơi nhà tuyệt vời thế nào rồi.\", \"rating\": 9.0},\n  {\"id\": 766759, \"suggestedTranslation\": \"Ta đã đối xử quá tệ với cưng phải không?\", \"rating\": 9.0},\n  {\"id\": 766760, \"suggestedTranslation\": \"Chào cưng gặp lại nhé!\", \"rating\": 9.0},\n  {\"id\": 766761, \"suggestedTranslation\": \"Ơ hay, hóa ra là %s đây mà!\", \"rating\": 9.0},\n  {\"id\": 766762, \"suggestedTranslation\": \"Thật vui khi được gặp lại cưng, cưng ơi!\", \"rating\": 9.0},\n  {\"id\": 766763, \"suggestedTranslation\": \"Thế giới này đầy rẫy hiểm nguy...\", \"rating\": 9.0},\n  {\"id\": 766764, \"suggestedTranslation\": \"Cưng đi đứng cẩn thận đấy, nghe chưa?\", \"rating\": 9.0},\n  {\"id\": 766765, \"suggestedTranslation\": \"Cưng đã làm một việc vô cùng tuyệt vời!\", \"rating\": 9.0},\n  {\"id\": 766766, \"suggestedTranslation\": \"Này, đây là chút lòng thành tối thiểu của ta.\", \"rating\": 9.0},\n  {\"id\": 766767, \"suggestedTranslation\": \"Ta không biết cưng đang giở trò gì\", \"rating\": 9.0},\n  {\"id\": 766768, \"suggestedTranslation\": \"nhưng đừng có tưởng là giờ ta mang ơn cưng đấy nhé!\", \"rating\": 9.0},\n  {\"id\": 766769, \"suggestedTranslation\": \"Cưng bận rộn ghê nhỉ! Chắc là ta phải đền đáp cưng thôi.\", \"rating\": 9.0},\n  {\"id\": 766770, \"suggestedTranslation\": \"Ôi chao, ta cực kỳ thích mấy món thịt khô ngon lành đấy!\", \"rating\": 9.0},\n  {\"id\": 766771, \"suggestedTranslation\": \"Hừm... trông có vẻ dai nhách.\", \"rating\": 9.0},\n  {\"id\": 766772, \"suggestedTranslation\": \"Hừm... trông không đến nỗi nào.\", \"rating\": 9.0},\n  {\"id\": 766773, \"suggestedTranslation\": \"Cưng đã làm quá nhiều thứ cho ta rồi.\", \"rating\": 9.0},\n  {\"id\": 766774, \"suggestedTranslation\": \"Làm ơn, cứ gọi ta là Ngọc Trai.\", \"rating\": 9.0},\n  {\"id\": 766775, \"suggestedTranslation\": \"Cưng đã biết tất cả những gì ta có thể dạy cưng rồi đấy, cưng ơi.\", \"rating\": 9.0},\n  {\"id\": 766776, \"suggestedTranslation\": \"Ta đưa bản thiết kế cho cưng lâu rồi mà, bớt làm phiền ta lại đi!\", \"rating\": 9.0},\n  {\"id\": 766777, \"suggestedTranslation\": \"Không phải ta đã đưa bản thiết kế cho cưng rồi sao?\", \"rating\": 9.0},\n  {\"id\": 766778, \"suggestedTranslation\": \"Tính lợi dụng một bà lão hiền lành hả?\", \"rating\": 9.0},\n  {\"id\": 766779, \"suggestedTranslation\": \"Cưng đã có cơ hội đọc qua bản thiết kế đó chưa, cưng ơi?\", \"rating\": 9.0},\n  {\"id\": 766780, \"suggestedTranslation\": \"Để ta yên đi, ta tặng bản thiết kế của mình cho người ta mất rồi!\", \"rating\": 9.0},\n  {\"id\": 766781, \"suggestedTranslation\": \"Vẫn chưa rảnh để đọc bản thiết kế đó à, hửm?\", \"rating\": 9.0},\n  {\"id\": 766782, \"suggestedTranslation\": \"Đó chẳng phải là bản thiết kế của ta đằng kia sao?\", \"rating\": 9.0},\n  {\"id\": 766783, \"suggestedTranslation\": \"Hừm. Lại đi vứt bản thiết kế của ta nằm lăn lóc thế kia...\", \"rating\": 9.0},\n  {\"id\": 766784, \"suggestedTranslation\": \"Đám nhắt ranh vô ơn!\", \"rating\": 9.0},\n  {\"id\": 766785, \"suggestedTranslation\": \"Biết trước bị vứt lăn lóc dưới đất thế này,\", \"rating\": 9.0},\n  {\"id\": 766786, \"suggestedTranslation\": \"thì ta đã chẳng thèm nhường bản thiết kế đó làm gì!\", \"rating\": 9.0},\n  {\"id\": 766787, \"suggestedTranslation\": \"Hú hu! Mấy miếng thịt khô này đang thành phẩm trông ngon ghê!\", \"rating\": 9.0},\n  {\"id\": 766788, \"suggestedTranslation\": \"Cưng không muốn dùng nó nữa à? Nó hỏng rồi hả?\", \"rating\": 9.0},\n  {\"id\": 766789, \"suggestedTranslation\": \"Ta không bao giờ từ chối thịt miễn phí cả!\", \"rating\": 9.0},\n  {\"id\": 766790, \"suggestedTranslation\": \"Nào, để ta chỉ cho cưng vài mẹo nhỏ nhé.\", \"rating\": 9.0},\n  {\"id\": 766791, \"suggestedTranslation\": \"Đây. Học cách dựng một chiếc ghế đàng hoàng đi.\", \"rating\": 9.0},\n  {\"id\": 766792, \"suggestedTranslation\": \"Tuyên dương tinh thần cố gắng của cưng đấy, nhưng lần sau làm cho chuẩn vào.\", \"rating\": 9.0},\n  {\"id\": 766793, \"suggestedTranslation\": \"Đẹp lắm, cưng ơi! Nơi hoàn hảo để cho cái vỏ sò nhức mỏi của ta nghỉ ngơi.\", \"rating\": 9.0},\n  {\"id\": 766794, \"suggestedTranslation\": \"Hừm. Thôi thì, ít ra trông nó có vẻ không đến nỗi sập.\", \"rating\": 9.0},\n  {\"id\": 766795, \"suggestedTranslation\": \"Ta cứ tưởng cưng chẳng biết làm mộc, huống hồ gì là làm tàm tạm!\", \"rating\": 9.0},\n  {\"id\": 766796, \"suggestedTranslation\": \"Ồ. Thôi thì... Ta biết là cưng đã rất cố gắng làm nó đấy, cưng ơi!\", \"rating\": 9.0},\n  {\"id\": 766797, \"suggestedTranslation\": \"Cưng tưởng ta sẽ ngồi lên cái món ọp ẹp đó chắc?\", \"rating\": 9.0},\n  {\"id\": 766798, \"suggestedTranslation\": \"Đó là một cái ghế, hay một tác phẩm nghệ thuật thất bại thế?\", \"rating\": 9.0},\n  {\"id\": 766799, \"suggestedTranslation\": \"Cưng đúng là một thợ làm vườn cừ khôi đấy, cưng ơi!\", \"rating\": 9.0},\n  {\"id\": 766800, \"suggestedTranslation\": \"Thôi được. Ít ra cưng cũng đang làm việc gì đó có ích.\", \"rating\": 9.0},\n  {\"id\": 766801, \"suggestedTranslation\": \"Hay là trồng thêm cây nữa ở đằng kia nhỉ?\", \"rating\": 9.0},\n  {\"id\": 766802, \"suggestedTranslation\": \"Đẹp quá chừng!\", \"rating\": 9.0},\n  {\"id\": 766803, \"suggestedTranslation\": \"Hả? Cưng đang làm gì thế?\", \"rating\": 9.0},\n  {\"id\": 766804, \"suggestedTranslation\": \"Hừm... trông đẹp phết.\", \"rating\": 9.0},\n  {\"id\": 766805, \"suggestedTranslation\": \"Cưng thực sự đã cho con thực vật ghê tởm đó một bài học đấy!\", \"rating\": 9.0},\n  {\"id\": 766806, \"suggestedTranslation\": \"Tuyệt vời. Con dịch hại cũ của ta đã bị xử lý bởi con dịch hại mới.\", \"rating\": 9.0},\n  {\"id\": 766807, \"suggestedTranslation\": \"Thôi, mừng là chuyện đó đã được giải quyết.\", \"rating\": 9.0},\n  {\"id\": 766808, \"suggestedTranslation\": \"Trời đất, cưng bị sao thế kia?\", \"rating\": 9.0},\n  {\"id\": 766809, \"suggestedTranslation\": \"Cưng phải cẩn thận hơn chứ!\", \"rating\": 9.0},\n  {\"id\": 766810, \"suggestedTranslation\": \"Hừm... trông cưng gầy gò quá.\", \"rating\": 9.0},\n  {\"id\": 766811, \"suggestedTranslation\": \"Cưng có ăn uống đầy đủ không đấy?\", \"rating\": 9.0},\n  {\"id\": 766812, \"suggestedTranslation\": \"Trông cưng có vẻ đang bận tâm chuyện gì đó.\", \"rating\": 9.0},\n  {\"id\": 766813, \"suggestedTranslation\": \"Mọi chuyện ổn cả chứ, cưng ơi?\", \"rating\": 9.0},\n  {\"id\": 766814, \"suggestedTranslation\": \"Mừng là thấy cưng vẫn khỏe mạnh, cưng ơi.\", \"rating\": 9.0},\n  {\"id\": 766815, \"suggestedTranslation\": \"Ta chẳng để ý mấy con ma kỳ quặc đó cho đến khi dọn đến đây.\", \"rating\": 9.0},\n  {\"id\": 766816, \"suggestedTranslation\": \"Chúng thật kinh tởm, làm da gà da cóc ta nổi hết cả lên...\", \"rating\": 9.0},\n  {\"id\": 766817, \"suggestedTranslation\": \"Một trong hai đứa phải biến, và người đó chắc chắn không phải là ta!\", \"rating\": 9.0},\n  {\"id\": 766818, \"suggestedTranslation\": \"Mất toi cả buổi để ta bịt kín mấy cái khe nứt chết tiệt đó...\", \"rating\": 9.0},\n  {\"id\": 766819, \"suggestedTranslation\": \"Đừng có mà táy máy vào mấy thứ đó!\", \"rating\": 9.0},\n  {\"id\": 766820, \"suggestedTranslation\": \"Không hẳn là vật trang trí sân vườn đẹp nhất, nhưng ít ra chúng giúp đầu óc tỉnh táo.\", \"rating\": 9.0},\n  {\"id\": 766821, \"suggestedTranslation\": \"Ta chẳng thấy cái khỉ khô gì cả!\", \"rating\": 9.0},\n  {\"id\": 766822, \"suggestedTranslation\": \"Ái chà! Ta KHÔNG MUỐN bị thui thành than đâu!\", \"rating\": 9.0},\n  {\"id\": 766823, \"suggestedTranslation\": \"Các người chưa bắt được ta đâu, lũ ma quỷ kia!\", \"rating\": 9.0},\n  {\"id\": 766824, \"suggestedTranslation\": \"Cưng ơi, ta biết cưng trồng cây đó đấy.\\nKhông cần phải gây ấn tượng với ta đâu.\", \"rating\": 9.0},\n  {\"id\": 766825, \"suggestedTranslation\": \"Cố gắng hay đấy.\\nTự dọn đống rác của mình thì không có thưởng đâu nhé.\", \"rating\": 9.0},\n  {\"id\": 766826, \"suggestedTranslation\": \"Cưng thèm phần thưởng đến thế cơ à?\", \"rating\": 9.0},\n  {\"id\": 766827, \"suggestedTranslation\": \"Cưng cứ giữ lấy đi, ta không thấy lạnh đâu.\", \"rating\": 9.0},\n  {\"id\": 766828, \"suggestedTranslation\": \"Ta thích chiếc áo khoác mình đang mặc lắm, cảm ơn rất nhiều.\", \"rating\": 9.0},\n  {\"id\": 766829, \"suggestedTranslation\": \"Ta không cần thêm băng đá nữa đâu.\", \"rating\": 9.0},\n  {\"id\": 766830, \"suggestedTranslation\": \"Đừng có ngốc thế, ngoài này rét cóng ra rồi đây này!\", \"rating\": 9.0},\n  {\"id\": 766831, \"suggestedTranslation\": \"Ta không cần thứ đó đâu, nhà ta ở đây mà!\", \"rating\": 9.0},\n  {\"id\": 766832, \"suggestedTranslation\": \"Ta không muốn món đó lúc này...\", \"rating\": 9.0},\n  {\"id\": 766833, \"suggestedTranslation\": \"nó làm ta buồn quá...\", \"rating\": 9.0},\n  {\"id\": 766834, \"suggestedTranslation\": \"Cưng nghĩ {weight} là ấn tượng lắm à?\\nCái gì thế kia, cá tuế à?\", \"rating\": 9.0},\n  {\"id\": 766835, \"suggestedTranslation\": \"Chao ôi, {weight} cơ đấy...\\nTa chưa bao giờ bắt được con cá nào nhỏ thế này.\", \"rating\": 9.0},\n  {\"id\": 766836, \"suggestedTranslation\": \"Chỉ có {weight} thôi á?\\nCưng nên thả nó về thì hơn.\", \"rating\": 9.0},\n  {\"id\": 766837, \"suggestedTranslation\": \"Trời có mưa quái đâu...\", \"rating\": 9.0},\n  {\"id\": 766838, \"suggestedTranslation\": \"Cái dù của ta dùng tốt chán, cảm ơn nhé.\", \"rating\": 9.0},\n  {\"id\": 766839, \"suggestedTranslation\": \"Ta mà mặc món đó trong cái nóng này chắc chín người luôn quá!\", \"rating\": 9.0},\n  {\"id\": 766840, \"suggestedTranslation\": \"Mong là nó không quá phiền phức...\", \"rating\": 9.0},\n  {\"id\": 766841, \"suggestedTranslation\": \"Để ta đoán xem, cưng muốn quà đáp lễ chứ gì? Thôi được rồi...\", \"rating\": 9.0},\n  {\"id\": 766842, \"suggestedTranslation\": \"Cảm ơn... nhưng đừng có tưởng thế này là chúng ta thành bạn thân nhé!\", \"rating\": 9.0},\n  {\"id\": 766843, \"suggestedTranslation\": \"Trời đất ơi, trông đẹp như mới luôn!\", \"rating\": 9.0},\n  {\"id\": 766844, \"suggestedTranslation\": \"Ồ tốt quá, cưng chưa phá banh nhà ta ra bã.\", \"rating\": 9.0},\n  {\"id\": 766845, \"suggestedTranslation\": \"Ta vẫn luôn định dọn dẹp lại chỗ này một thời gian rồi...\", \"rating\": 9.0},\n  {\"id\": 766846, \"suggestedTranslation\": \"Ôi cưng ơi, ta thích những gì cưng làm với chỗ này quá!\", \"rating\": 9.0},\n  {\"id\": 766847, \"suggestedTranslation\": \"...Ta cho là đó là một sự cải thiện đấy.\", \"rating\": 9.0},\n  {\"id\": 766848, \"suggestedTranslation\": \"Cưng... làm chuyện này cho ta á...?\", \"rating\": 9.0},\n  {\"id\": 766849, \"suggestedTranslation\": \"Ôi, tuyệt vời quá!\", \"rating\": 9.0},\n  {\"id\": 766850, \"suggestedTranslation\": \"Ta thấy mình như Nữ hoàng trong cung điện vậy\", \"rating\": 9.0},\n  {\"id\": 766851, \"suggestedTranslation\": \"Hú hu!\", \"rating\": 9.0},\n  {\"id\": 766852, \"suggestedTranslation\": \"Ồ. Trông có vẻ khá hơn một chút rồi đấy.\", \"rating\": 9.0},\n  {\"id\": 766853, \"suggestedTranslation\": \"Ta suýt không nhận ra nơi này luôn!\", \"rating\": 9.0},\n  {\"id\": 766854, \"suggestedTranslation\": \"Ồ đừng có mà lo lắng, đó là chuyện tốt mà.\", \"rating\": 9.0},\n  {\"id\": 766855, \"suggestedTranslation\": \"Cảm ơn cưng nhé! Này, sao cưng không lấy một món trong số này đi.\", \"rating\": 9.0},\n  {\"id\": 766856, \"suggestedTranslation\": \"Hừm. Cưng có thể câu nó nhanh hơn nếu dùng thứ này đấy.\", \"rating\": 9.0},\n  {\"id\": 766857, \"suggestedTranslation\": \"Ồ... cảm ơn nhé. Này, cầm lấy món này vì công sức của cưng đi.\", \"rating\": 9.0},\n  {\"id\": 766858, \"suggestedTranslation\": \"Cảm ơn cưng nhé! Này, sao cưng không lấy một món trong số này đi.\", \"rating\": 9.0},\n  {\"id\": 766859, \"suggestedTranslation\": \"Hừm. Cưng có thể câu nó nhanh hơn nếu dùng thứ này đấy.\", \"rating\": 9.0},\n  {\"id\": 766860, \"suggestedTranslation\": \"Ồ... cảm ơn nhé. Này, cầm lấy món này vì công sức của cưng đi.\", \"rating\": 9.0},\n  {\"id\": 766861, \"suggestedTranslation\": \"Cảm ơn cưng nhé! Này, sao cưng không lấy một món trong số này đi.\", \"rating\": 9.0},\n  {\"id\": 766862, \"suggestedTranslation\": \"Hừm. Cưng có thể câu nó nhanh hơn nếu dùng thứ này đấy.\", \"rating\": 9.0},\n  {\"id\": 766863, \"suggestedTranslation\": \"Ồ... cảm ơn nhé. Này, cầm lấy món này vì công sức của cưng đi.\", \"rating\": 9.0},\n  {\"id\": 766864, \"suggestedTranslation\": \"Cảm ơn cưng nhé! Này, sao cưng không lấy một món trong số này đi.\", \"rating\": 9.0},\n  {\"id\": 766865, \"suggestedTranslation\": \"Hừm. Cưng có thể câu nó nhanh hơn nếu dùng thứ này đấy.\", \"rating\": 9.0},\n  {\"id\": 766866, \"suggestedTranslation\": \"Ồ... cảm ơn nhé. Này, cầm lấy món này vì công sức của cưng đi.\", \"rating\": 9.0},\n  {\"id\": 766867, \"suggestedTranslation\": \"Cảm ơn cưng nhé...\", \"rating\": 9.0},\n  {\"id\": 766868, \"suggestedTranslation\": \"Cưng có thấy con cua nào khác trong chuyến hành trình không?\", \"rating\": 9.0},\n  {\"id\": 766869, \"suggestedTranslation\": \"...\", \"rating\": 9.0},\n  {\"id\": 766870, \"suggestedTranslation\": \"...Cảm ơn nhé