            "text": "[\n  {\"id\": 766905, \"suggestedTranslation\": \"Tôi có vài chiếc mồi để trao đổi đấy...\", \"rating\": 9.0},\n  {\"id\": 766906, \"suggestedTranslation\": \"nếu cậu đủ khả năng mua chúng.\", \"rating\": 9.0},\n  {\"id\": 766907, \"suggestedTranslation\": \"Thôi được rồi, cậu làm tôi mềm lòng rồi đấy.\", \"rating\": 9.0},\n  {\"id\": 766908, \"suggestedTranslation\": \" Tôi sẽ cho cậu xem mấy con mồi XỊN của tôi.\", \"rating\": 9.0},\n  {\"id\": 766909, \"suggestedTranslation\": \"Tôi có vài món đồ mới để trao đổi,\", \"rating\": 9.0},\n  {\"id\": 766910, \"suggestedTranslation\": \"nhưng chúng không rẻ đâu nhé!\", \"rating\": 9.0},\n  {\"id\": 766911, \"suggestedTranslation\": \"Cái vỏ già này chắc đang mềm ra rồi...\", \"rating\": 9.0},\n  {\"id\": 766912, \"suggestedTranslation\": \"Tôi vừa đặt vài thứ đặc biệt vào cửa hàng đấy.\", \"rating\": 9.0},\n  {\"id\": 766913, \"suggestedTranslation\": \"Cứ hú tôi nếu cậu cần gì khác nhé!\", \"rating\": 9.0},\n  {\"id\": 766914, \"suggestedTranslation\": \"Tuyệt. Giờ thì để tôi yên.\", \"rating\": 9.0},\n  {\"id\": 766915, \"suggestedTranslation\": \"Hợp tác vui vẻ.\", \"rating\": 9.0},\n  {\"id\": 766916, \"suggestedTranslation\": \"Ồ! Lại có thêm món để thử à?\", \"rating\": 9.0},\n  {\"id\": 766917, \"suggestedTranslation\": \"Gì nữa đây?\", \"rating\": 9.0},\n  {\"id\": 766918, \"suggestedTranslation\": \"Mấy cái này chắc phải tốt hơn mấy món trước.\", \"rating\": 9.0},\n  {\"id\": 766919, \"suggestedTranslation\": \"Lửa bén quán của tôi rồi!\", \"rating\": 9.0},\n  {\"id\": 766920, \"suggestedTranslation\": \"Ôi thảm họa rồi!\", \"rating\": 9.0},\n  {\"id\": 766921, \"suggestedTranslation\": \"Tại sao cơ chứ?!\", \"rating\": 9.0},\n  {\"id\": 766922, \"suggestedTranslation\": \"Cưng đang làm gì thế, cưng ơi?\", \"rating\": 9.0},\n  {\"id\": 766923, \"suggestedTranslation\": \"Cưng đang giúp ta chuyển quán à?\", \"rating\": 9.0},\n  {\"id\": 766924, \"suggestedTranslation\": \"Cẩn thận chứ, cưng!\", \"rating\": 9.0},\n  {\"id\": 766925, \"suggestedTranslation\": \"Không gì qua được trà của ta đâu.\", \"rating\": 9.0},\n  {\"id\": 766926, \"suggestedTranslation\": \"Trông cưng có vẻ khát nước đấy, cưng ơi!\", \"rating\": 9.0},\n  {\"id\": 766927, \"suggestedTranslation\": \"Chào mừng đến với Quán Trà Ngọc Trai của Ngọc trai.\", \"rating\": 9.5},\n  {\"id\": 766928, \"suggestedTranslation\": \"Chào cưng. Cưng muốn dùng gì nào?\", \"rating\": 9.0},\n  {\"id\": 766929, \"suggestedTranslation\": \"Loại trà yêu thích của cưng là gì?\", \"rating\": 9.0},\n  {\"id\": 766930, \"suggestedTranslation\": \"Cưng có muốn uống chút trà của ta không?\", \"rating\": 9.0},\n  {\"id\": 766931, \"suggestedTranslation\": \"Ôi trời ơi! Cưng đã làm gì thế này?\", \"rating\": 9.0},\n  {\"id\": 766932, \"suggestedTranslation\": \"Sao cưng lại làm thế hả cưng?\", \"rating\": 9.0},\n  {\"id\": 766933, \"suggestedTranslation\": \"Ôi không! Cưng đốt quán của ta rồi!\", \"rating\": 9.0},\n  {\"id\": 766934, \"suggestedTranslation\": \"Chúc một ngày tốt lành nhé!\", \"rating\": 9.0},\n  {\"id\": 766935, \"suggestedTranslation\": \"Của cưng đây.\", \"rating\": 9.0},\n  {\"id\": 766936, \"suggestedTranslation\": \"Thưởng thức nhé, cưng!\", \"rating\": 9.0},\n  {\"id\": 766937, \"suggestedTranslation\": \"Ta hy vọng cưng thích nó!\", \"rating\": 9.0},\n  {\"id\": 766938, \"suggestedTranslation\": \"Trà được pha đặc biệt dành riêng cho cưng đấy!\", \"rating\": 9.0},\n  {\"id\": 766939, \"suggestedTranslation\": \"Biết đâu đây sẽ là chiếc chạm đến được ông ấy...\", \"rating\": 9.0},\n  {\"id\": 766940, \"suggestedTranslation\": \"Cậu dám nẫng hết mấy cái chai của tôi à!\", \"rating\": 9.0},\n  {\"id\": 766941, \"suggestedTranslation\": \"Giờ tôi phải gửi đi gấp đôi số đó mới được!\", \"rating\": 9.0},\n  {\"id\": 766942, \"suggestedTranslation\": \"Tôi đoán mình cũng mừng vì chúng đến được tay ai đó.\", \"rating\": 9.0},\n  {\"id\": 766943, \"suggestedTranslation\": \"Mong là cưng sẽ tìm thấy thứ này trong chuyến hành trình và ghé lại thăm ta nhé, cưng!\", \"rating\": 9.0},\n  {\"id\": 766944, \"suggestedTranslation\": \"Tôi rất cần sự giúp đỡ để sửa sang lại ngôi nhà đấy...\", \"rating\": 9.0},\n  {\"id\": 766945, \"suggestedTranslation\": \"Kiểm tra\", \"rating\": 9.0},\n  {\"id\": 766946, \"suggestedTranslation\": \"Mèo Trúc Con\", \"rating\": 9.5},\n  {\"id\": 766947, \"suggestedTranslation\": \"Chỉ định\", \"rating\": 9.0},\n  {\"id\": 766948, \"suggestedTranslation\": \"Hủy\", \"rating\": 9.0},\n  {\"id\": 766949, \"suggestedTranslation\": \"Đặt tên cho Mèo Trúc Con này\", \"rating\": 9.5},\n  {\"id\": 766950, \"suggestedTranslation\": \"Ngẫu nhiên\", \"rating\": 9.0},\n  {\"id\": 766951, \"suggestedTranslation\": \"Bóng\", \"rating\": 9.5},\n  {\"id\": 766952, \"suggestedTranslation\": \"Buddy\", \"rating\": 8.0},\n  {\"id\": 766953, \"suggestedTranslation\": \"Lola\", \"rating\": 8.0},\n  {\"id\": 766954, \"suggestedTranslation\": \"Masu\", \"rating\": 8.0},\n  {\"id\": 766955, \"suggestedTranslation\": \"Lottie\", \"rating\": 8.0},\n  {\"id\": 766956, \"suggestedTranslation\": \"Tobyn\", \"rating\": 8.0},\n  {\"id\": 766957, \"suggestedTranslation\": \"Brin\", \"rating\": 8.0},\n  {\"id\": 766958, \"suggestedTranslation\": \"Skoki\", \"rating\": 8.0},\n  {\"id\": 766959, \"suggestedTranslation\": \"Benben\", \"rating\": 8.0},\n  {\"id\": 766960, \"suggestedTranslation\": \"Meeko\", \"rating\": 8.0},\n  {\"id\": 766961, \"suggestedTranslation\": \"Smokey\", \"rating\": 8.0},\n  {\"id\": 766962, \"suggestedTranslation\": \"Tuesday\", \"rating\": 8.0},\n  {\"id\": 766963, \"suggestedTranslation\": \"Ginger\", \"rating\": 8.0},\n  {\"id\": 766964, \"suggestedTranslation\": \"Polka Mazurka\", \"rating\": 8.0},\n  {\"id\": 766965, \"suggestedTranslation\": \"Lahmu\", \"rating\": 8.0},\n  {\"id\": 766966, \"suggestedTranslation\": \"Basco\", \"rating\": 8.0},\n  {\"id\": 766967, \"suggestedTranslation\": \"Lilly\", \"rating\": 8.0},\n  {\"id\": 76696