n  {\"id\": 767021, \"suggestedTranslation\": \"Nutmeg\", \"rating\": 8.0},\n  {\"id\": 767022, \"suggestedTranslation\": \"Xiao Long Meow\", \"rating\": 8.0},\n  {\"id\": 767023, \"suggestedTranslation\": \"Reuben\", \"rating\": 8.0},\n  {\"id\": 767024, \"suggestedTranslation\": \"Daisy\", \"rating\": 8.0},\n  {\"id\": 767025, \"suggestedTranslation\": \"Basil\", \"rating\": 8.0},\n  {\"id\": 767026, \"suggestedTranslation\": \"Sammy\", \"rating\": 8.0},\n  {\"id\": 767027, \"suggestedTranslation\": \"Thomasina\", \"rating\": 8.0},\n  {\"id\": 767028, \"suggestedTranslation\": \"Lola\", \"rating\": 8.0},\n  {\"id\": 767029, \"suggestedTranslation\": \"Kẹo Bơ Cứng\", \"rating\": 9.5},\n  {\"id\": 767030, \"suggestedTranslation\": \"Bibo\", \"rating\": 8.0},\n  {\"id\": 767031, \"suggestedTranslation\": \"Tuppy\", \"rating\": 8.0},\n  {\"id\": 767032, \"suggestedTranslation\": \"Kuma\", \"rating\": 8.0},\n  {\"id\": 767033, \"suggestedTranslation\": \"Cherry\", \"rating\": 8.0},\n  {\"id\": 767034, \"suggestedTranslation\": \"Siumai\", \"rating\": 8.0},\n  {\"id\": 767035, \"suggestedTranslation\": \"Kira\", \"rating\": 8.0},\n  {\"id\": 767036, \"suggestedTranslation\": \"Finch\", \"rating\": 8.0},\n  {\"id\": 767037, \"suggestedTranslation\": \"Mango\", \"rating\": 8.0},\n  {\"id\": 767038, \"suggestedTranslation\": \"Ares\", \"rating\": 8.0},\n  {\"id\": 767039, \"suggestedTranslation\": \"Teddy\", \"rating\": 8.0},\n  {\"id\": 767040, \"suggestedTranslation\": \"Armello\", \"rating\": 8.0},\n  {\"id\": 767041, \"suggestedTranslation\": \"Dineide\", \"rating\": 8.0},\n  {\"id\": 767042, \"suggestedTranslation\": \"\\\\nChọn một người sống sót ngẫu nhiên\", \"rating\": 9.0},\n  {\"id\": 767043, \"suggestedTranslation\": \"*ĐANG CẬP NHẬT\\\\n\\\\n\\\\n\\\\nChuyên môn:\\\\nĐANG CẬP NHẬT\", \"rating\": 9.0},\n  {\"id\": 767044, \"suggestedTranslation\": \"*ĐANG CẬP NHẬT\\\\n\\\\n\\\\n\\\\nChuyên môn:\\\\nĐANG CẬP NHẬT\", \"rating\": 9.0},\n  {\"id\": 767045, \"suggestedTranslation\": \"*ĐANG CẬP NHẬT\\\\n\\\\n\\\\n\\\\nChuyên môn:\\\\nĐANG CẬP NHẬT\", \"rating\": 9.0},\n  {\"id\": 767046, \"suggestedTranslation\": \"*Tiếng gào chiến đấu tăng 25% sát thương đòn đánh tiếp theo của đồng minh lân cận\\\\n*Ít thu hút kẻ địch hơn khi tấn công\\\\n\\nChuyên môn:\\nCận chiến, Tiêu\", \"rating\": 9.5},\n  {\"id\": 767047, \"suggestedTranslation\": \"*Triệu hồi Kẻ Song Sát Bóng tối sau khi tập trung tấn công vào một mục tiêu duy nhất\\n\\n\\nChuyên môn:\\nSách, Trượng\", \"rating\": 9.5},\n  {\"id\": 767048, \"suggestedTranslation\": \"*Được đồng hành bởi những chú nhện bé xíu\\\\n\\n\\n\\nChuyên môn:\\nTiêu\", \"rating\": 9.0},\n  {\"id\": 767049, \"suggestedTranslation\": \"*Được bảo vệ bởi người chị song sinh Abigail\\\\n\\n\\n\\nChuyên môn:\\nTiêu, Trượng\", \"rating\": 9.0},\n  {\"id\": 767050, \"suggestedTranslation\": \"*Được hồi sinh nhanh gấp đôi\\\\n*Ít thu hút kẻ địch hơn khi tấn công\\\\n*Khó bị mất sự chú ý của kẻ địch một khi đã lôi kéo\\\\n\\nChuyên môn:\\nCận chiến, Tiêu, Trượng\", \"rating\": 9.5},\n  {\"id\": 767051, \"suggestedTranslation\": \"*Nhận được bùa lợi sau khi gây đủ sát thương, cường hóa phép thuật tiếp theo\\\\n\\n\\nChuyên môn:\\nSách, Trượng\", \"rating\": 9.0},\n  {\"id\": 767052, \"suggestedTranslation\": \"*Được bảo vệ bởi gấu Bernie\\\\n*Sát thương tấn công từ lửa và chất nổ tăng 10%\\n\\nChuyên môn:\\nTiêu, Trượng\", \"rating\": 9.5},\n  {\"id\": 767053, \"suggestedTranslation\": \"*Hồi sinh đồng minh nhanh gấp đôi\\\\n*Hồi máu nhiều gấp ba lần khi hồi sinh đồng minh\\\\n\\nChuyên môn:\\nCận chiến, Tiêu, Trượng\", \"rating\": 9.5},\n  {\"id\": 767054, \"suggestedTranslation\": \"*Thời gian hồi chiêu của tất cả kỹ năng nhanh hơn 10%\\\\n\\n\\n\\nChuyên môn:\\nCận chiến, Tiêu, Trượng\", \"rating\": 9.5},\n  {\"id\": 767055, \"suggestedTranslation\": \"*Trở nên Hùng Dũng khi máu thấp, tăng sức mạnh tấn công, phòng thủ và tốc độ di chuyển trong 10 giây\\\\n\\nChuyên môn:\\nCận chiến\", \"rating\": 9.5},\n  {\"id\": 767056, \"suggestedTranslation\": \"ĐANG CẬP NHẬT\\\\n\\\\n\\\\n\\\\nChuyên môn:\\\\nĐANG CẬP NHẬT\", \"rating\": 9.0},\n  {\"id\": 767057, \"suggestedTranslation\": \"*Lucy quay lại với Woodie khi bị ném đi\\\\n*Tăng tốc độ tấn công khi cầm Lucy\\\\n\\nChuyên môn:\\nCận chiến\", \"rating\": 9.0},\n  {\"id\": 767058, \"suggestedTranslation\": \"*Lucy quay lại với Woodie khi bị ném đi\\\\n*Tăng tốc độ tấn công khi cầm Lucy\\\\n\\nChuyên môn:\\nCận chiến\", \"rating\": 9.0},\n  {\"id\": 767059, \"suggestedTranslation\": \"*Lucy quay lại với Woodie khi bị ném đi\\\\n*Tăng tốc độ tấn công khi cầm Lucy\\\\n\\nChuyên môn:\\nCận chiến\", \"rating\": 9.0},\n  {\"id\": 767060, \"suggestedTranslation\": \"*ĐANG CẬP NHẬT\\\\n\\\\n\\\\n\\\\nChuyên môn:\\\\nĐANG CẬP NHẬT\", \"rating\": 9.0},\n  {\"id\": 767061, \"suggestedTranslation\": \"*ĐANG CẬP NHẬT\\\\n\\\\n\\\\n\\\\nChuyên môn:\\\\nĐANG CẬP NHẬT\", \"rating\": 9.0},\n  {\"id\": 767062, \"suggestedTranslation\": \"*ĐANG CẬP NHẬT\\\\n\\\\n\\\\n\\\\nChuyên môn:\\\\nĐANG CẬP NHẬT\", \"rating\": 9.0},\n  {\"id\": 767063, \"suggestedTranslation\": \"*Gây điện giật kẻ địch khi bị tấn công\\\\n*Sát thương tấn công hệ điện tăng 50%\\n\\nChuyên môn:\\nCận chiến\", \"rating\": 9.0},\n  {\"id\": 767064, \"suggestedTranslation\": \"Nóng quá đi!\", \"rating\": 9.0},\n  {\"id\": 767065, \"suggestedTranslation\": \"Ném tôi đi!\", \"rating\": 9.0},\n  {\"id\": 767066, \"suggestedTranslation\": \"Tôi nghĩ chúng ta đang thắng đấy!\", \"rating\": 9.0},\n  {\"id\": 767067, \"suggestedTranslation\": \"Chúng không có cửa đâu!\", \"rating\": 9.0},\n  {\"id\": 767068, \"suggestedTranslation\": \"Trời ạ, trong này nóng thật.\", \"rating\": 9.0},\n  {\"id\": 767069, \"suggestedTranslation\": \"Đánh đi! Đánh đi!\", \"rating\": 9.0},\n  {\"id\": 767070, \"suggestedTranslation\": \"Xử chúng nó!\", \"rating\": 9.0},\n  {\"id\": 767071, \"suggestedTranslation\": \"Bổ cho chúng một nhát đi!\", \"rating\": 9.0},\n  {\"id\": 767072, \"suggestedTranslation\": \"Khán giả hô lớn thật đấy!\", \"rating\": 9.0},\n  {\"id\": 767073, \"suggestedTranslation\": \"Úi!\", \"rating\": 9.0},\n  {\"id\": 767074, \"suggestedTranslation\": \"Trượt mất rồi!\", \"rating\": 9.0},\n  {\"id\": 767075, \"suggestedTranslation\": \"Chết tiệt!\", \"rating\": 9.0},\n  {\"id\": 767076, \"suggestedTranslation\": \"Này!\", \"rating\": 9.0},\n  {\"id\": 767077, \"suggestedTranslation\": \"Quay lại đây mau!\", \"rating\": 9.0},\n  {\"id\": 767078, \"suggestedTranslation\": \"Tôi không thích thế này cho lắm.\", \"rating\": 9.0},\n  {\"id\": 767079, \"suggestedTranslation\": \"Cậu cầm tôi không đúng cách rồi!\", \"rating\": 9.0},\n  {\"id\": 767080, \"suggestedTranslation\": \"Tay cậu đẫm mồ hôi kìa.\", \"rating\": 9.0},\n  {\"id\": 767081, \"suggestedTranslation\": \"Ném tôi đi cho rồi đi!\", \"rating\": 9.0},\n  {\"id\": 767082, \"suggestedTranslation\": \"Đây không phải là chuyện thường ngày đâu đấy.\", \"rating\": 9.0},\n  {\"id\": 767083, \"suggestedTranslation\": \"Đừng nghĩ ngợi nhiều quá nhé.\", \"rating\": 9.0},\n  {\"id\": 767084, \"suggestedTranslation\": \"Tóm được cậu nhé!\", \"rating\": 9.0},\n  {\"id\": 767085, \"suggestedTranslation\": \"Nhận lấy này!\", \"rating\": 9.0},\n  {\"id\": 767086, \"suggestedTranslation\": \"Ăn đòn này!\", \"rating\": 9.0},\n  {\"id\": 767087, \"suggestedTranslation\": \"Trúng hồng tâm!\", \"rating\": 9.0},\n  {\"id\": 767088, \"suggestedTranslation\": \"Ha!\", \"rating\": 9.0},\n  {\"id\": 767089, \"suggestedTranslation\": \"Bốp!\", \"rating\": 9.0},\n  {\"id\": 767090, \"suggestedTranslation\": \"Cậu ổn chứ?\", \"rating\": 9.0},\n  {\"id\": 767091, \"suggestedTranslation\": \"Ổn không đấy, anh bạn lớn?\", \"rating\": 9.0},\n  {\"id\": 767092, \"suggestedTranslation\": \"Có chuyện gì thế?\", \"rating\": 9.0},\n  {\"id\": 767093, \"suggestedTranslation\": \"Cậu có chắc là mình ổn không đấy?\", \"rating\": 9.0},\n  {\"id\": 767094, \"suggestedTranslation\": \"Trông hôm nay cậu có vẻ gắt gỏng hơn thường lệ đấy.\", \"rating\": 9.0},\n  {\"id\": 767095, \"suggestedTranslation\": \"Trông cậu có vẻ lơ đễnh quá.\", \"rating\": 9.0},\n  {\"id\": 767096, \"suggestedTranslation\": \"Sao cậu lại làm cái mặt đó thế?\", \"rating\": 9.0},\n  {\"id\": 767097, \"suggestedTranslation\": \"Cố gắng hít thở sâu vào nhé, được chứ?\", \"rating\": 9.0},\n  {\"id\": 767098, \"suggestedTranslation\": \"Cậu đang quá sức rồi đấy!\", \"rating\": 9.0},\n  {\"id\": 767099, \"suggestedTranslation\": \"Cậu không chịu kiềm chế bản thân gì cả!\", \"rating\": 9.0},\n  {\"id\": 767100, \"suggestedTranslation\": \"Cậu sắp biến hình rồi kìa!\", \"rating\": 9.0},\n  {\"id\": 767101, \"suggestedTranslation\": \"Bình tĩnh lại nào!\", \"rating\": 9.0},\n  {\"id\": 767102, \"suggestedTranslation\": \"Cậu phải chậm lại thôi!\", \"rating\": 9.0},\n  {\"id\": 767103, \"suggestedTranslation\": \"Chậm lại đi, tôi lo cho cậu lắm đấy!\", \"rating\": 9.0},\n  {\"id\": 767104, \"suggestedTranslation\": \"Cẩn thận! Cậu chuẩn bị biến dạng rồi kìa!\", \"rating\": 9.0},\n  {\"id\": 767105, \"suggestedTranslation\": \"Alo? Cậu có nghe thấy tôi nói không?\", \"rating\": 9.0},\n  {\"id\": 767106, \"suggestedTranslation\": \"Đã đến lúc làm một bữa snack gỗ ngon lành chưa nhỉ?\", \"rating\": 9.0},\n  {\"id\": 767107, \"suggestedTranslation\": \"Woodie! Nhớ ăn cành cây đi đấy!\", \"rating\": 9.5},\n  {\"id\": 767108, \"suggestedTranslation\": \"Có khi cậu nên ăn một khúc gỗ đi.\", \"rating\": 9.5},\n  {\"id\": 767109, \"suggestedTranslation\": \"Măm măm, vỏ cây... nghe hấp dẫn lúc này phết chứ lị? Hử?\", \"rating\": 9.0},\n  {\"id\": 767110, \"suggestedTranslation\": \"Cậu lại bỏ bữa gỗ của mình nữa à?\", \"rating\": 9.0},\n  {\"id\": 767111, \"suggestedTranslation\": \"Này, này, ăn một mẩu dăm gỗ đi.\", \"rating\": 9.0},\n  {\"id\": 767112, \"suggestedTranslation\": \"Cậu biết điều gì sẽ xảy ra nếu không ăn đủ gỗ rồi đấy!\", \"rating\": 9.0},\n  {\"id\": 767113, \"suggestedTranslation\": \"Suýt thì nguy to!\", \"rating\": 9.0},\n  {\"id\": 767114, \"suggestedTranslation\": \"Tôi nghĩ chúng ta sẽ ổn thôi.\", \"rating\": 9.0},\n  {\"id\": 767115, \"suggestedTranslation\": \"Giờ trông cậu khá hơn nhiều rồi đấy.\", \"rating\": 9.0},\n  {\"id\": 767116, \"suggestedTranslation\": \"Nó đã qua rồi. Tạm thời là thế.\", \"rating\": 9.0},\n  {\"id\": 767117, \"suggestedTranslation\": \"Tôi thật ngốc khi đã nghi ngờ cậu.\", \"rating\": 9.0},\n  {\"id\": 767118, \"suggestedTranslation\": \"Chà, tôi cứ sợ là cậu toi đời rồi chứ!\", \"rating\": 9.0},\n  {\"id\": 767119, \"suggestedTranslation\": \"Tôi nghĩ màu sắc đang quay trở lại má cậu rồi đấy.\", \"rating\": 9.0},\n  {\"id\": 767120, \"suggestedTranslation\": \"Nó đã chui về hang rồi. Phù!\", \"rating\": 9.0},\n  {\"id\": 767121, \"suggestedTranslation\": \"Chỉ những gì tốt nhất cho cậu thôi, anh bạn!\", \"rating\": 9.0},\n  {\"id\": 767122, \"suggestedTranslation\": \"Heh, cái này sẽ đặc biệt lắm đây!\", \"rating\": 9.0},\n  {\"id\": 767123, \"suggestedTranslation\": \"Phải bảo vệ cái đầu xinh xắn của cậu chứ!\", \"rating\": 9.0},\n  {\"id\": 767124, \"suggestedTranslation\": \"Xem tôi trổ tài đây!\", \"rating\": 9.0},\n  {\"id\": 767125, \"suggestedTranslation\": \"Đừng để bị dằm đâm đấy nhé!\", \"rating\": 9.0},\n  {\"id\": 767126, \"suggestedTranslation\": \"Cậu muốn ván ép à? Tôi cho cậu thấy ván ép luôn nè! Hee-YAH!\", \"rating\": 9.5},\n  {\"id\": 767127, \"suggestedTranslation\": \"Đi chặt vài cái cây nào!\", \"rating\": 9.0},\n  {\"id\": 767128, \"suggestedTranslation\": \"Chặt, chặt, chặt. Heh.\", \"rating\": 9.0},\n  {\"id\": 767129, \"suggestedTranslation\": \"Chặt, c-c-chặt!\", \"rating\": 9.0},\n  {\"id\": 767130, \"suggestedTranslation\": \"Thế, cây bằng đá... chuyện đó là sao thế nhỉ?\", \"rating\": 9.0},\n  {\"id\": 767131, \"suggestedTranslation\": \"Tìm một lùm cây nhỏ rồi quẩy tới bến đi nào!\", \"rating\": 9.0},\n  {\"id\": 767132, \"suggestedTranslation\": \"Ngày đẹp trời để đi dạo đấy!\", \"rating\": 9.0},\n  {\"id\": 767133, \"suggestedTranslation\": \"Chúng ta là một đội tuyệt vời!\", \"rating\": 9.0},\n  {\"id\": 767134, \"suggestedTranslation\": \"Chắc phải có mấy cái cây quanh đây đâu đó chứ.\", \"rating\": 9.0},\n  {\"id\": 767135, \"suggestedTranslation\": \"Thời tiết này quá hoàn hảo để chặt cây.\", \"rating\": 9.0},\n  {\"id\": 767136, \"suggestedTranslation\": \"Một ngày tuyệt vời để chặt cây.\", \"rating\": 9.0},\n  {\"id\": 767137, \"suggestedTranslation\": \"Cậu có tài chặt chém đấy, anh bạn.\", \"rating\": 9.0},\n  {\"id\": 767138, \"suggestedTranslation\": \"Này! Chặt cây đi chứ!\", \"rating\": 9.0},\n  {\"id\": 767139, \"suggestedTranslation\": \"Làm việc suốt mà không chơi bời khiến tôi chỉ muốn đi chặt vài cái cây.\", \"rating\": 9.0},\n  {\"id\": 767140, \"suggestedTranslation\": \"Trong này tối thui!\", \"rating\": 9.0},\n  {\"id\": 767141, \"suggestedTranslation\": \"Tôi chẳng thấy gì sất!\", \"rating\": 9.0},\n  {\"id\": 767142, \"suggestedTranslation\": \"Thật sự đây là chỗ tồi tệ nhất.\", \"rating\": 9.0},\n  {\"id\": 767143, \"suggestedTranslation\": \"Tôi ghét ở trong này.\", \"rating\": 9.0},\n  {\"id\": 767144, \"suggestedTranslation\": \"Tôi đã làm gì nên tội với cậu cơ chứ?\", \"rating\": 9.0},\n  {\"id\": 767145, \"suggestedTranslation\": \"Tôi sợ lắm!\", \"rating\": 9.0},\n  {\"id\": 767146, \"suggestedTranslation\": \"Cứu với! Thả tôi ra!\", \"rating\": 9.0},\n  {\"id\": 767147, \"suggestedTranslation\": \"Chẳng có gì để chặt trong này cả!\", \"rating\": 9.0},\n  {\"id\": 767148, \"suggestedTranslation\": \"Chán chết đi được.\", \"rating\": 9.0},\n  {\"id\": 767149, \"suggestedTranslation\": \"Thảaaaa tôiiii rauuu!\", \"rating\": 9.0},\n  {\"id\": 767150, \"suggestedTranslation\": \"Tôi bị chứng sợ không gian hẹp!\", \"rating\": 9.0},\n  {\"id\": 767151, \"suggestedTranslation\": \"Tôi sợ những nơi chật chội!\", \"rating\": 9.0},\n  {\"id\": 767152, \"suggestedTranslation\": \"Tôi không thở được! Khoan đã.\", \"rating\": 9.0},\n  {\"id\": 76715