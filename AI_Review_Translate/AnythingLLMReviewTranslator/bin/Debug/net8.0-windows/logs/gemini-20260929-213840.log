ation\": \"Tạm biệt cháy nắng và chào mừng bỏng lạnh.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771201,\n    \"suggestedTranslation\": \"Ngăn cát bay vào mắt bạn.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771202,\n    \"suggestedTranslation\": \"Việc tiếp tục làm khô là rất quan trọng!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771203,\n    \"suggestedTranslation\": \"Nó hấp thụ độ ẩm để bạn không phải làm điều đó!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771204,\n    \"suggestedTranslation\": \"Chắc phải có cách nào đó để ra khỏi đây...\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771205,\n    \"suggestedTranslation\": \"Hãy chuẩn bị tinh thần cho việc kiểm định cầu tàu.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771206,\n    \"suggestedTranslation\": \"Không gì nói lên hai từ \\\"kiên cố\\\" hơn việc cắm thêm vài cái cọc như một ý kiến phát sinh.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771207,\n    \"suggestedTranslation\": \"Đạt đến tầm vóc rồng đại dương.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771208,\n    \"suggestedTranslation\": \"Được trang bị đầy đủ các phụ kiện đậm chất loài rồng.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771209,\n    \"suggestedTranslation\": \"Phần giữa của trang phục quái thú.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771210,\n    \"suggestedTranslation\": \"Một chiếc hộp đựng chắc chắn và chống cháy.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771211,\n    \"suggestedTranslation\": \"Tự xây cho mình một ống khói bay.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771212,\n    \"suggestedTranslation\": \"Phần đầu của trang phục quái thú.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771213,\n    \"suggestedTranslation\": \"Phần đuôi của trang phục quái thú.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771214,\n    \"suggestedTranslation\": \"Một chiếc mũ bảo hiểm vững chắc làm từ loại đá đen nhất.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771215,\n    \"suggestedTranslation\": \"Gậy gộc và đá tảng rèn luyện cơ bắp săn chắc.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771216,\n    \"suggestedTranslation\": \"Đóng băng những kẻ muốn phá đám buổi tập luyện.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771217,\n    \"suggestedTranslation\": \"Mài giũa mọi khía cạnh trong buổi tập của bạn.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771218,\n    \"suggestedTranslation\": \"Tiêu chuẩn vàng của môn cử tạ.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771219,\n    \"suggestedTranslation\": \"Tận hưởng màn khởi động tuyệt đỉnh.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771220,\n    \"suggestedTranslation\": \"Con đường ngắn nhất để có một thể hình vạm vỡ.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771221,\n    \"suggestedTranslation\": \"Cảm nhận sức nóng!\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771222,\n    \"suggestedTranslation\": \"Một chút hơi ấm lông lá nhỏ.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771223,\n    \"suggestedTranslation\": \"Để mang theo tất cả đồ ăn vặt của Abigail.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771224,\n    \"suggestedTranslation\": \"Một chiếc bàn trang trí.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771225,\n    \"suggestedTranslation\": \"Một con mắt hướng lên trời giúp bạn luôn khô ráo.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771226,\n    \"suggestedTranslation\": \"Giữ lũ quái vật tránh xa. Bằng cách tiêu diệt chúng.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771227,\n    \"suggestedTranslation\": \"Xới đất để gieo hạt cây trồng.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771228,\n    \"suggestedTranslation\": \"Cày một mảnh đất cho cây trồng của bạn.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771229,\n    \"suggestedTranslation\": \"Giúp hạt lớn nhanh hơn một chút.\",\n    \"rating\": 8.5\n  },\n  {\n    \"id\": 771230,\n    \"suggestedTranslation\": \"Mềm mại sang trọng, kích thước sang trọng.\",\n    \"rating\": 8.5\n