          {
            "text": "[\n  {\"id\": 767205, \"suggestedTranslation\": \"Ái, đau đấy.\", \"rating\": 0.0},\n  {\"id\": 767206, \"suggestedTranslation\": \"Ta đã làm gì ngươi chứ!?\", \"rating\": 0.0},\n  {\"id\": 767207, \"suggestedTranslation\": \"Ngươi là hồn ma chất chơi nhất đấy!\", \"rating\": 0.0},\n  {\"id\": 767208, \"suggestedTranslation\": \"Đừng có trút giận lên ta chỉ vì ngươi đã chết!\", \"rating\": 0.0},\n  {\"id\": 767209, \"suggestedTranslation\": \"Mà ngươi có thể chạm được thì ta đã băm ngươi rồi!\", \"rating\": 0.0},\n  {\"id\": 767210, \"suggestedTranslation\": \"Hô hô hô hô! Haha, đùa thôi.\", \"rating\": 0.0},\n  {\"id\": 767211, \"suggestedTranslation\": \"Ghê rợn!\", \"rating\": 0.0},\n  {\"id\": 767212, \"suggestedTranslation\": \"Brrr! Ngươi lạnh ngắt!\", \"rating\": 0.0},\n  {\"id\": 767213, \"suggestedTranslation\": \"Ngươi làm dính chất nhầy ma quái lên cán của ta rồi!!\", \"rating\": 0.0},\n  {\"id\": 767214, \"suggestedTranslation\": \"Thôi ngay đi!\", \"rating\": 0.0},\n  {\"id\": 767215, \"suggestedTranslation\": \"Bất lịch sự!\", \"rating\": 0.0},\n  {\"id\": 767216, \"suggestedTranslation\": \"Hô hô hô hô lại ngươi luôn.\", \"rating\": 0.0},\n  {\"id\": 767217, \"suggestedTranslation\": \"Ta là một cây rìu bị ám!\", \"rating\": 0.0},\n  {\"id\": 767218, \"suggestedTranslation\": \"Đi mà bắt nạt kẻ nào cùng kích cỡ ấy!\", \"rating\": 0.0},\n  {\"id\": 767219, \"suggestedTranslation\": \"Này!\", \"rating\": 0.0},\n  {\"id\": 767220, \"suggestedTranslation\": \"Trời ạ! Ta đã đắc tội gì với ngươi ở kiếp trước à?\", \"rating\": 0.0},\n  {\"id\": 767221, \"suggestedTranslation\": \"Ta trắng bệch ra rồi đây.\", \"rating\": 0.0},\n  {\"id\": 767222, \"suggestedTranslation\": \"Hôm nay trông ngươi \\\"ma\\\"-nh lực ghê.\", \"rating\": 0.0},\n  {\"id\": 767223, \"suggestedTranslation\": \"Giờ thì ta là một cây rìu BỊ ÁM rồi.\", \"rating\": 0.0},\n  {\"id\": 767224, \"suggestedTranslation\": \"Ta không sợ ngươi đâu, con ma kia!\", \"rating\": 0.0},\n  {\"id\": 767225, \"suggestedTranslation\": \"Ma nào cơ?\", \"rating\": 0.0},\n  {\"id\": 767226, \"suggestedTranslation\": \"Ta thấy nhiều cái đáng sợ hơn thế này rồi.\", \"rating\": 0.0},\n  {\"id\": 767227, \"suggestedTranslation\": \"Ngươi nghĩ ta sợ ngươi chắc?\", \"rating\": 0.0},\n  {\"id\": 767228, \"suggestedTranslation\": \"Cứ làm những gì ngươi muốn đi, con ma ạ.\", \"rating\": 0.0},\n  {\"id\": 767229, \"suggestedTranslation\": \"Đi làm phiền kẻ KHÁC đi! Haha.\", \"rating\": 0.0},\n  {\"id\": 767230, \"suggestedTranslation\": \"Ta nhớ ngươi lắm đấy!\", \"rating\": 0.0},\n  {\"id\": 767231, \"suggestedTranslation\": \"Ngươi có nhớ ta không?\", \"rating\": 0.0},\n  {\"id\": 767232, \"suggestedTranslation\": \"Lại được ở bên nhau rồi!\", \"rating\": 0.0},\n  {\"id\": 767233, \"suggestedTranslation\": \"Ahhh, ta đã về đúng nơi thuộc về mình.\", \"rating\": 0.0},\n  {\"id\": 767234, \"suggestedTranslation\": \"Thật tuyệt vời khi được đoàn tụ!\", \"rating\": 0.0},\n  {\"id\": 767235, \"suggestedTranslation\": \"Ta cứ sợ rằng ngươi sẽ không bao giờ quay lại.\", \"rating\": 0.0},\n  {\"id\": 767236, \"suggestedTranslation\": \"Ngươi đã quay lại vì ta!\", \"rating\": 0.0},\n  {\"id\": 767237, \"suggestedTranslation\": \"Ồ, tạ ơn trời đất.\", \"rating\": 0.0},\n  {\"id\": 767238, \"suggestedTranslation\": \"Ồ, thật là khủng khiếp!\", \"rating\": 0.0},\n  {\"id\": 767239, \"suggestedTranslation\": \"Đừng bao giờ làm thế nữa nhé! Trái tim bé nhỏ của ta không chịu nổi đâu.\", \"rating\": 0.0},\n  {\"id\": 767240, \"suggestedTranslation\": \"Từ giờ chúng ta sẽ không bao giờ rời xa.\", \"rating\": 0.0},\n  {\"id\": 767241, \"suggestedTranslation\": \"Đồ bắt cá hai tay!\", \"rating\": 0.0},\n  {\"id\": 767242, \"suggestedTranslation\": \"Cô ta là kẻ mạo danh!\", \"rating\": 0.0},\n  {\"id\": 767243, \"suggestedTranslation\": \"Cứ như thể ngươi chẳng hề quen biết ta vậy!\", \"rating\": 0.0},\n  {\"id\": 767244, \"suggestedTranslation\": \"Vứt cô ta đi! Làm ta phát hoảng lên được.\", \"rating\": 0.0},\n  {\"id\": 767245, \"suggestedTranslation\": \"Ta đang bị khủng hoảng danh tính ở đây này.\", \"rating\": 0.0},\n  {\"id\": 767246, \"suggestedTranslation\": \"Ồ, ngươi đang tự chuốc RÌU vào thân đấy!\", \"rating\": 0.0},\n  {\"id\": 767247, \"suggestedTranslation\": \"Ngươi không thể có tận hai cây Lucy được!\", \"rating\": 0.0},\n  {\"id\": 767248, \"suggestedTranslation\": \"Ngươi không được lấy cô ta! Cổ là của ta!\", \"rating\": 0.0},\n  {\"id\": 767249, \"suggestedTranslation\": \"Nhưng TA mới là cây Lucy duy nhất của ngươi!\", \"rating\": 0.0},\n  {\"id\": 767250, \"suggestedTranslation\": \"Chỉ có thể có một mà thôi!\", \"rating\": 0.0},\n  {\"id\": 767251, \"suggestedTranslation\": \"Sao ngươi dám đối xử với ta thế này!\", \"rating\": 0.0},\n  {\"id\": 767252, \"suggestedTranslation\": \"Ngươi đang định thay thế ta sao?!\", \"rating\": 0.0},\n  {\"id\": 767253, \"suggestedTranslation\": \"Đấy không phải là ta!\", \"rating\": 0.0},\n  {\"id\": 767254, \"suggestedTranslation\": \"Đồ phản bội!\", \"rating\": 0.0},\n  {\"id\": 767255, \"suggestedTranslation\": \"Ooo ta sẽ nhớ chuyện này!\", \"rating\": 0.0},\n  {\"id\": 767256, \"suggestedTranslation\": \"Này! Ngươi không phân biệt nổi chúng ta à?\", \"rating\": 0.0},\n  {\"id\": 767257, \"suggestedTranslation\": \"Ta không quen ngươi.\", \"rating\": 0.0},\n  {\"id\": 767258, \"suggestedTranslation\": \"Bỏ cái móng vuốt của ngươi ra khỏi người ta ngay!\", \"rating\": 0.0},\n  {\"id\": 767259, \"suggestedTranslation\": \"Thả ta xuống ngay lập tức!\", \"rating\": 0.0},\n  {\"id\": 767260, \"suggestedTranslation\": \"Sao ngươi dám cầm ta lên chứ?!\", \"rating\": 0.0},\n  {\"id\": 767261, \"suggestedTranslation\": \"Eo ôi, tay ngươi dính mỡ kìa!\", \"rating\": 0.0},\n  {\"id\": 767262, \"suggestedTranslation\": \"Thả ta ra!\", \"rating\": 0.0},\n  {\"id\": 767263, \"suggestedTranslation\": \"Cứu với! Ta đang bị bắt cóc.\", \"rating\": 0.0},\n  {\"id\": 767264, \"suggestedTranslation\": \"Người lạ nguy hiểm!\", \"rating\": 0.0},\n  {\"id\": 767265, \"suggestedTranslation\": \"Đặt ta xuống!\", \"rating\": 0.0},\n  {\"id\": 767266, \"suggestedTranslation\": \"Này! Hàng tươi sống đây!\", \"rating\": 0.0},\n  {\"id\": 767267, \"suggestedTranslation\": \"Gớm ghiếc.\", \"rating\": 0.0},\n  {\"id\": 767268, \"suggestedTranslation\": \"Xin lỗi đi nhé!\", \"rating\": 0.0},\n  {\"id\": 767269, \"suggestedTranslation\": \"Ưm mầm, XIN LỖI hả??\", \"rating\": 0.0},\n  {\"id\": 767270, \"suggestedTranslation\": \"Để tôi yên đi, đồ thô lỗ!\", \"rating\": 0.0},\n  {\"id\": 767271, \"suggestedTranslation\": \"Đặt ta xuống! Ngươi hôi quá!\", \"rating\": 0.0},\n  {\"id\": 767272, \"suggestedTranslation\": \"Ta có bảo ngươi được cầm ta lên đâu?\", \"rating\": 0.0},\n  {\"id\": 767273, \"suggestedTranslation\": \"Ôi không!\", \"rating\": 0.0},\n  {\"id\": 767274, \"suggestedTranslation\": \"Ngươi phải chống lại nó!\", \"rating\": 0.0},\n  {\"id\": 767275, \"suggestedTranslation\": \"Không! Hãy chống lại nó!\", \"rating\": 0.0},\n  {\"id\": 767276, \"suggestedTranslation\": \"Ngươi phải kiềm chế lại!\", \"rating\": 0.0},\n  {\"id\": 767277, \"suggestedTranslation\": \"Nó lại tái diễn rồi!\", \"rating\": 0.0},\n  {\"id\": 767278, \"suggestedTranslation\": \"Lời nguyền kìa!\", \"rating\": 0.0},\n  {\"id\": 767279, \"suggestedTranslation\": \"Đừng thế nữa mà!\", \"rating\": 0.0},\n  {\"id\": 767280, \"suggestedTranslation\": \"Ngươi không bắt buộc phải làm thế này!\", \"rating\": 0.0},\n  {\"id\": 767281, \"suggestedTranslation\": \"Ta đã cảnh báo ngươi rồi mà!\", \"rating\": 0.0},\n  {\"id\": 767282, \"suggestedTranslation\": \"Ngươi đã về rồi!\", \"rating\": 0.0},\n  {\"id\": 767283, \"suggestedTranslation\": \"Trông ngươi khá hơn nhiều rồi đấy.\", \"rating\": 0.0},\n  {\"id\": 767284, \"suggestedTranslation\": \"Phù! Hú hồn!\", \"rating\": 0.0},\n  {\"id\": 767285, \"suggestedTranslation\": \"Mừng là mọi chuyện đã qua...\", \"rating\": 0.0},\n  {\"id\": 767286, \"suggestedTranslation\": \"Đừng làm thế nữa nhé.\", \"rating\": 0.0},\n  {\"id\": 767287, \"suggestedTranslation\": \"Nhớ luyện tập hít thở đi đấy!\", \"rating\": 0.0},\n  {\"id\": 767288, \"suggestedTranslation\": \"Mọi chuyện sẽ ổn thôi. Cố tập trung vào!\", \"rating\": 0.0},\n  {\"id\": 767289, \"suggestedTranslation\": \"Ngươi ổn chứ?\", \"rating\": 0.0},\n  {\"id\": 767290, \"suggestedTranslation\": \"Vừa rồi căng thẳng lắm nhỉ?\", \"rating\": 0.0},\n  {\"id\": 767291, \"suggestedTranslation\": \"Đừng để chuyện đó xảy ra nữa đấy!\", \"rating\": 0.0},\n  {\"id\": 767292, \"suggestedTranslation\": \"Ngươi làm ta sợ chết khiếp!\", \"rating\": 0.0},\n  {\"id\": 767293, \"suggestedTranslation\": \"Ta nghĩ cô bé rợn tóc gáy kia đang giận ngươi đấy.\", \"rating\": 0.0},\n  {\"id\": 767294, \"suggestedTranslation\": \"Ta rất mừng vì ngươi vẫn bình an!\", \"rating\": 0.0},\n  {\"id\": 767295, \"suggestedTranslation\": \"Phù! Vẫn còn nguyên vẹn chứ?\", \"rating\": 0.0},\n  {\"id\": 767296, \"suggestedTranslation\": \"Có ngươi ở bên thật tốt, bạn già.\", \"rating\": 0.0},\n  {\"id\": 767297, \"suggestedTranslation\": \" ở trong hang động\", \"rating\": 0.0},\n  {\"id\": 767298, \"suggestedTranslation\": \"Được {author} vẽ bản đồ{location} vào ngày {day}.\", \"rating\": 0.0},\n  {\"id\": 767299, \"suggestedTranslation\": \"một nhà thám hiểm\", \"rating\": 0.0},\n  {\"id\": 767300, \"suggestedTranslation\": \"???\", \"rating\": 0.0},\n  {\"id\": 767301, \"suggestedTranslation\": \"Ồ, ngươi tìm thấy cổng dịch chuyển của ta rồi à?\", \"rating\": 0.0},\n  {\"id\": 767302, \"suggestedTranslation\": \"Hừm. Thử thách hơn một chút đi, chịu không?\", \"rating\": 0.0},\n  {\"id\": 767303, \"suggestedTranslation\": \"Cứ ngỡ là ngươi đã rút ra bài học từ nãy giờ rồi chứ.\", \"rating\": 0.0},\n  {\"id\": 767304, \"suggestedTranslation\": \"Chà nhìn kìa, ngươi vẫn sống sót cơ à.\", \"rating\": 0.0},\n  {\"id\": 767305, \"suggestedTranslation\": \"Một tên đã đi, còn bốn tên nữa!\", \"rating\": 0.0},\n  {\"id\": 767306, \"suggestedTranslation\": \"Gì chứ? Ngươi vẫn ở đây á?\", \"rating\": 0.0},\n  {\"id\": 767307, \"suggestedTranslation\": \"Ấn tượng đấy. Nhưng tốt hơn hết là nên dừng lại khi còn đang thắng đi.\", \"rating\": 0.0},\n  {\"id\": 767308, \"suggestedTranslation\": \"Này, bạn hiền.\", \"rating\": 0.0},\n  {\"id\": 767309, \"suggestedTranslation\": \"Quay đầu ngay bây giờ đi, không thì ta phải dùng biện pháp mạnh đấy.\", \"rating\": 0.0},\n  {\"id\": 767310, \"suggestedTranslation\": \"Ngươi đang thử thách vận may của mình quá đà rồi đấy.\", \"rating\": 0.0},\n  {\"id\": 767311, \"suggestedTranslation\": \"Đồ con kiến hỗn xược, thảm hại và nhỏ bé!\", \"rating\": 0.0},\n  {\"id\": 767312, \"suggestedTranslation\": \"Ngươi sẽ phải hối hận vì dám tiến xa hơn nữa...\", \"rating\": 0.0},\n  {\"id\": 767313, \"suggestedTranslation\": \"Đừng có chọc giận Đại Maxwell vĩ đại!\", \"rating\": 0.0},\n  {\"id\": 767314, \"suggestedTranslation\": \"Làm thế thì còn gì là thú vị nữa?\", \"rating\": 0.0},\n  {\"id\": 767315, \"suggestedTranslation\": \"Ngươi nghĩ ai đã cho phép ngươi chế tạo ra thứ đó?\", \"rating\": 0.0},\n  {\"id\": 767316, \"suggestedTranslation\": \"Đây có phải là những gì ngươi mong đợi không?\", \"rating\": 0.0},\n  {\"id\": 767317, \"suggestedTranslation\": \"Chỉ có bụi. Và hư vô. Và Bọn Họ.\", \"rating\": 0.0},\n  {\"id\": 767318, \"suggestedTranslation\": \"Ta đã học hỏi được rất nhiều kể từ đó. Ta đã xây dựng được rất nhiều thứ.\", \"rating\": 0.0},\n  {\"id\": 767319, \"suggestedTranslation\": \"Nhưng ngay cả một vị Vua cũng bị ràng buộc trên bàn cờ.\", \"rating\": 0.0},\n  {\"id\": 767320, \"suggestedTranslation\": \"Ngươi không thể thay đổi luật lệ của trò chơi.\", \"rating\": 0.0},\n  {\"id\": 767321, \"suggestedTranslation\": \"Ta không biết bọn chúng muốn gì. Bọn họ... bọn họ chỉ quan sát thôi.\", \"rating\": 0.0},\n  {\"id\": 767322, \"suggestedTranslation\": \"Trừ khi ngươi đến quá gần. Khi đó...\", \"rating\": 0.0},\n  {\"id\": 767323, \"suggestedTranslation\": \"À thì, có lý do cả mà sao ta lúc nào cũng bảnh bao thế này.\", \"rating\": 0.0},\n  {\"id\": 767324, \"suggestedTranslation\": \"Ngoài kia đang là năm nào vậy? Thời gian trôi qua ở đây khác lắm.\", \"rating\": 0.0},\n  {\"id\": 767325, \"suggestedTranslation\": \"Nào, ở lại một lát đi. Bầu bạn với chúng ta đi.\", \"rating\": 0.0},\n  {\"id\": 767326, \"suggestedTranslation\": \"Hoặc cắm chìa khóa vào hộp đi. Quyết định là ở ngươi.\", \"rating\": 0.0},\n  {\"id\": 767327, \"suggestedTranslation\": \"Thứ lỗi cho ta vì đã không đứng dậy chào.\", \"rating\": 0.0},\n  {\"id\": 767328, \"suggestedTranslation\": \"Dù thế nào đi nữa, ngươi cũng chỉ đang trì hoãn điều tất yếu thôi.\", \"rating\": 0.0},\n  {\"id\": 767329, \"suggestedTranslation\": \"Thực tại đôi khi là thế đấy.\", \"rating\": 0.0},\n  {\"id\": 767330, \"suggestedTranslation\": \"Ta nghĩ ta nói thế là đủ rồi.\", \"rating\": 0.0},\n  {\"id\": 767331, \"suggestedTranslation\": \"...\", \"rating\": 0.0},\n  {\"id\": 767332, \"suggestedTranslation\": \"Ngươi là một món đồ chơi thú vị đấy, nhưng ta chán trò này rồi.\", \"rating\": 0.0},\n  {\"id\": 767333, \"suggestedTranslation\": \"Hoặc có lẽ Bọn Họ đã chán ta rồi.\", \"rating\": 0.0},\n  {\"id\": 767334, \"suggestedTranslation\": \"Heh. Phải mất khối thời gian đấy.\", \"rating\": 0.0},\n  {\"id\": 767335, \"suggestedTranslation\": \"Bọn họ sẽ cho ngươi thấy những thứ khủng khiếp và tuyệt đẹp.\", \"rating\": 0.0},\n  {\"id\": 767336, \"suggestedTranslation\": \"Nó sẽ thay đổi ngươi, giống như đã làm với ta.\", \"rating\": 0.0},\n  {\"id\": 767337, \"suggestedTranslation\": \"Tốt nhất là đừng chống lại nó.\", \"rating\": 0.0},\n  {\"id\": 767338, \"suggestedTranslation\": \"Chẳng có mấy thứ ở đây khi ta xuất hiện cả.\", \"rating\": 0.0},\n  {\"id\": 767339, \"suggestedTranslation\": \"Chà, đến đây là hết rồi.\", \"rating\": 0.0},\n  {\"id\": 767340, \"suggestedTranslation\": \"Ngươi nghĩ ta chưa thử cách đó sao?\", \"rating\": 0.0},\n  {\"id\": 767341, \"suggestedTranslation\": \"Đây là ngõ cụt rồi. Chúng ta không thể trốn thoát đâu.\", \"rating\": 0.0},\n  {\"id\": 767342, \"suggestedTranslation\": \"Ngươi đã tìm thấy ta. Giờ thì, ngươi định làm gì nào?\", \"rating\": 0.0},\n  {\"id\": 767343, \"suggestedTranslation\": \"Tất cả những gì ta muốn đổi lại là một sự đình chiến.\", \"rating\": 0.0},\n  {\"id\": 767344, \"suggestedTranslation\": \"Này, bạn hiền.\", \"rating\": 0.0},\n  {\"id\": 767345, \"suggestedTranslation\": \"Ta sẽ cho ngươi thức ăn, vàng, người lợn, bất cứ thứ gì ngươi cần.\", \"rating\": 0.0},\n  {\"id\": 767346, \"suggestedTranslation\": \"Hãy thỏa thuận đi. Ngươi có thể ở lại đây. Thậm chí là định cư luôn.\", \"rating\": 0.0},\n  {\"id\": 767347, \"suggestedTranslation\": \"Chiếc ngai vàng sẽ không cho phép điều đó đâu. Ta đã thử rồi.\", \"rating\": 0.0},\n  {\"id\": 767348, \"suggestedTranslation\": \"Đây là kết cục sao?\", \"rating\": 0.0},\n  {\"id\": 767349, \"suggestedTranslation\": \"A, ta thật ngốc nghếch. Ta đã dám nuôi hy vọng.\", \"rating\": 0.0},\n  {\"id\": 767350, \"suggestedTranslation\": \"Cảm ơn ngươi. Ta đã phải nghe bài hát đó suốt cả cõi vĩnh hằng rồi.\", \"rating\": 0.0},\n  {\"id\": 767351, \"suggestedTranslation\": \"Chắc ta đáng bị như vậy.\", \"rating\": 0.0},\n  {\"id\": 767352, \"suggestedTranslation\": \"Được thôi. Chỉ cần nhớ rằng đây là do ngươi tự chọn đấy.\", \"rating\": 0.0},\n  {\"id\": 767353, \"suggestedTranslation\": \"Chỉ là...\", \"rating\": 0.0},\n  {\"id\": 767354, \"suggestedTranslation\": \"Ta đã quen với việc chiến thắng rồi.\", \"rating\": 0.0},\n  {\"id\": 767355, \"suggestedTranslation\": \"Chúng ta không khác nhau là mấy đâu, ngươi và ta.\", \"rating\": 0.0},\n  {\"id\": 767356, \"suggestedTranslation\": \"Ồ, ngươi tưởng mình là người đầu tiên à?\", \"rating\": 0.0},\n  {\"id\": 767357, \"suggestedTranslation\": \"HA!\", \"rating\": 0.0},\n  {\"id\": 767358, \"suggestedTranslation\": \"Đó là lý do ta đưa ngươi đến đây.\", \"rating\": 0.0},\n  {\"id\": 767359, \"suggestedTranslation\": \"Đó là lý do ta đưa tất cả bọn họ đến đây.\", \"rating\": 0.0},\n  {\"id\": 767360, \"suggestedTranslation\": \"Này bạn hiền, trông ngươi không ổn lắm đâu.\", \"rating\": 0.0},\n  {\"id\": 767361, \"suggestedTranslation\": \"Tốt hơn hết là ngươi nên tìm cái gì đó để ăn trước khi trời tối đấy!\", \"rating\": 0.0},\n  {\"id\": 767362, \"suggestedTranslation\": \"Ý nghĩ trong đầu ta không còn nhạy bén như trước nữa.\", \"rating\": 0.0},\n  {\"id\": 767363, \"suggestedTranslation\": \"Mumsy là ai nhỉ? À đúng rồi. Quý cô tốt bụng.\", \"rating\": 0.0},\n  {\"id\": 767364, \"suggestedTranslation\": \"Dạo này cứ thèm Câu Cá kỳ lạ làm sao. Hmf.\", \"rating\": 0.0},\n  {\"id\": 767365, \"suggestedTranslation\": \"Pip căng thẳng quá mức. Lúc nào cũng lo lắng cho ta.\", \"rating\": 0.0},\n  {\"id\": 767366, \"suggestedTranslation\": \"Này, giao dịch với cụ Sammy đi nào!\", \"rating\": 0.0},\n  {\"id\": 767367, \"suggestedTranslation\": \"HẠT ĐÂY! HẠT GIỐNG ĐÂY!\", \"rating\": 0.0},\n  {\"id\": 767368, \"suggestedTranslation\": \"Ta đang làm gì ấy nhỉ? ...À đúng rồi, HẠT ĐÂY!\", \"rating\": 0.0},\n  {\"id\": 767369, \"suggestedTranslation\": \"Được rồi, được rồi, lẹ lên nào.\", \"rating\": 0.0},\n  {\"id\": 767370, \"suggestedTranslation\": \"Hân hạnh.\", \"rating\": 0.0},\n  {\"id\": 767371, \"suggestedTranslation\": \"Lúc nào cũng vội vã, hội người các ngươi.\", \"rating\": 0.0},\n  {\"id\": 767372, \"suggestedTranslation\": \"Bệnh dịch cũng không tệ lắm đâu, biết sao không.\", \"rating\": 0.0},\n  {\"id\": 767373, \"suggestedTranslation\": \"Quay lại nhé, nghe chưa?\", \"rating\": 0.0},\n  {\"id\": 767374, \"suggestedTranslation\": \"Ngươi là ai nhỉ?\", \"rating\": 0.0},\n  {\"id\": 767375, \"suggestedTranslation\": \"Cảm ơn nhé, người lạ.\", \"rating\": 0.0},\n  {\"id\": 767376, \"suggestedTranslation\": \"Buổi chiều tốt lành! Có muốn giao dịch không?\", \"rating\": 0.0},\n  {\"id\": 767377, \"suggestedTranslation\": \"Ít ra thì căn bệnh đó vẫn không cướp mất bộ râu của ta. Ho ho!\", \"rating\": 0.0},\n  {\"id\": 767378, \"suggestedTranslation\": \"Trí tuệ của Sammy đang suy giảm đấy, nhưng đừng nói là do ta hé lộ nhé.\", \"rating\": 0.0},\n  {\"id\": 767379, \"suggestedTranslation\": \"Nhiều người bệnh của chúng ta đã biến mất xuống biển. Lạ thật đấy.\", \"rating\": 0.0},\n  {\"id\": 767380, \"suggestedTranslation\": \"Tiếc là ngươi không được ngắm thị trấn vào thời hoàng kim của nó.\", \"rating\": 0.0},\n  {\"id\": 767381, \"suggestedTranslation\": \"Ta chỉ có những mặt hàng tốt nhất để bán thôi.\", \"rating\": 0.0},\n  {\"id\": 767382, \"suggestedTranslation\": \"Đây là một nơi tồi tệ để một đứa trẻ lớn lên.\", \"rating\": 0.0},\n  {\"id\": 767383, \"suggestedTranslation\": \"Đang vội à?\", \"rating\": 0.0},\n  {\"id\": 767384, \"suggestedTranslation\": \"Đừng nấn ná nữa, bạn tôi ơi.\", \"rating\": 0.0},\n  {\"id\": 767385, \"suggestedTranslation\": \"Ta sẽ không làm mất thêm thời gian của ngươi nữa.\", \"rating\": 0.0},\n  {\"id\": 767386, \"suggestedTranslation\": \"Ta ngả mũ kính chào ngươi.\", \"rating\": 0.0},\n  {\"id\": 767387, \"suggestedTranslation\": \"Thật là vinh hạnh.\", \"rating\": 0.0},\n  {\"id\": 767388, \"suggestedTranslation\": \"Mong Gnaw mỉm cười với ngươi.\", \"rating\": 0.0},\n  {\"id\": 767389, \"suggestedTranslation\": \"Flargle\", \"rating\": 0.0},\n  {\"id\": 767390, \"suggestedTranslation\": \"Glogh\", \"rating\": 0.0},\n  {\"id\": 767391, \"suggestedTranslation\": \"Glop\", \"rating\": 0.0},\n  {\"id\": 767392, \"suggestedTranslation\": \"Glot\", \"rating\": 0.0},\n  {\"id\": 767393, \"suggestedTranslation\": \"Glugh\", \"rating\": 0.0},\n  {\"id\": 767394, \"suggestedTranslation\": \"Glup\", \"rating\": 0.0},\n  {\"id\": 767395, \"suggestedTranslation\": \"Glurp\", \"rating\": 0.0},\n  {\"id\": 767396, \"suggestedTranslation\": \"Glurt\", \"rating\": 0.0},\n  {\"id\": 767397, \"suggestedTranslation\": \"Glurble\", \"rating\": 0