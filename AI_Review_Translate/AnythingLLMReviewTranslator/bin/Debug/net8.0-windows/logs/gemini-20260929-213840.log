            "text": "[\n  {\"id\":767505,\"suggestedTranslation\":\"Blut gloppy Glurtsu!\",\"rating\":0.0},\n  {\"id\":767506,\"suggestedTranslation\":\"Đào, đào nữa, đào đi!\",\"rating\":8.5},\n  {\"id\":767507,\"suggestedTranslation\":\"Grop, groppy, grop!\",\"rating\":0.0},\n  {\"id\":767508,\"suggestedTranslation\":\"Làm việc chăm chỉ vào, florp!\",\"rating\":8.0},\n  {\"id\":767509,\"suggestedTranslation\":\"Glort blut, florp!\",\"rating\":0.0},\n  {\"id\":767510,\"suggestedTranslation\":\"Cứu tôi với, florp!\",\"rating\":8.0},\n  {\"id\":767511,\"suggestedTranslation\":\"Flopt, florp!\",\"rating\":0.0},\n  {\"id\":767512,\"suggestedTranslation\":\"Đau quá!\",\"rating\":8.5},\n  {\"id\":767513,\"suggestedTranslation\":\"Glorg!\",\"rating\":0.0},\n  {\"id\":767514,\"suggestedTranslation\":\"Cảm thấy không khỏe lắm...\",\"rating\":8.5},\n  {\"id\":767515,\"suggestedTranslation\":\"Glorggu blurg...\",\"rating\":0.0},\n  {\"id\":767516,\"suggestedTranslation\":\"Đau quá nha, đau quá nha!\",\"rating\":8.5},\n  {\"id\":767517,\"suggestedTranslation\":\"Glurk, glurk!\",\"rating\":0.0},\n  {\"id\":767518,\"suggestedTranslation\":\"Có thứ gì đó đang tới!\",\"rating\":8.5},\n  {\"id\":767519,\"suggestedTranslation\":\"Gloppy flort!\",\"rating\":0.0},\n  {\"id\":767520,\"suggestedTranslation\":\"Á da!! Thức xấu! Thức xấu!\",\"rating\":8.0},\n  {\"id\":767521,\"suggestedTranslation\":\"Gloooorph!! Glurph glot! Glurph glot!\",\"rating\":0.0},\n  {\"id\":767522,\"suggestedTranslation\":\"Nó đến để tiêu diệt chúng ta!\",\"rating\":8.5},\n  {\"id\":767523,\"suggestedTranslation\":\"Flort wult Glurtsu!\",\"rating\":0.0},\n  {\"id\":767524,\"suggestedTranslation\":\"Tập hợp bảo vệ Nhà Vua!\",\"rating\":8.5},\n  {\"id\":767525,\"suggestedTranslation\":\"Glurtsen blut flort!\",\"rating\":0.0},\n  {\"id\":767526,\"suggestedTranslation\":\"Nhanh lên! Bảo vệ vương quốc!\",\"rating\":8.5},\n  {\"id\":767527,\"suggestedTranslation\":\"Flurph flrot! Gloppy Glurtsam!\",\"rating\":0.0},\n