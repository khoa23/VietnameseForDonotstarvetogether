            "text": "[\n  {\n    \"id\": 773712,\n    \"suggestedTranslation\": \"Sử dụng độ ẩm để bảo vệ hiệu quả hơn. Đồng thời khiến bạn dần bị ướt khi bước qua các lớp cỏ đầm lầy bị biến chất hoặc đột biến.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773713,\n    \"suggestedTranslation\": \"Da Trơn II\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773714,\n    \"suggestedTranslation\": \"Học cách chế tạo Đĩa Tảo Biển Cộng Đồng Cao Cấp, chứa nhiều tảo hơn để giúp người cá lớn nhanh hơn và gọi người cá ra hành động.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773715,\n    \"suggestedTranslation\": \"Bộ Nuôi Dưỡng Cộng Đồng II\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773716,\n    \"suggestedTranslation\": \"Học cách chế tạo Đĩa Tảo Biển Cộng Đồng để thúc đẩy người cá lớn nhanh hơn và gọi người cá ra hành động.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773717,\n    \"suggestedTranslation\": \"Bộ Nuôi Dưỡng Cộng Đồng I\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773718,\n    \"suggestedTranslation\": \"Học cách chế tạo Xưởng dụng cụ Nhân ngư xịn, nó cung cấp Dụng cụ nhẹ và xịn.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773719,\n    \"suggestedTranslation\": \"Người Cá Chăm Chỉ II\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773720,\n    \"suggestedTranslation\": \"Học cách chế tạo Xưởng dụng cụ Nhân ngư để trang bị Công cụ kém chất lượng cho những người thợ người cá của bạn.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773721,\n    \"suggestedTranslation\": \"Người Cá Chăm Chỉ I\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773722,\n    \"suggestedTranslation\": \"Học cách chế tạo Nhà Trang Bị Cao Cấp, nó cung cấp Mũ Chiến Binh Đầm Lầy.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773723,\n    \"suggestedTranslation\": \"Đầu Cứng II\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773724,\n    \"suggestedTranslation\": \"Học cách chế tạo Nhà Trang Bị để trang bị Mũ Đấu Sĩ Đầm Lầy cho Vệ Binh Người Cá Trung Thành của bạn.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773725,\n    \"suggestedTranslation\": \"Đầu Cứng I\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773726,\n    \"suggestedTranslation\": \"Ban cho những người cá trung thành của bạn Gói Quà tuyệt vời mang sự đột biến Mặt Trăng bằng cách cho chúng ăn Mảnh Mặt Trăng.\\nTăng cường sức mạnh cho người cá đột biến của bạn bằng sức mạnh Siêu Phàm sử dụng Quang Thạch Tinh Khiết.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773727,\n    \"suggestedTranslation\": \"Nhân Ngư Đột Biến Mặt Trăng\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773728,\n    \"suggestedTranslation\": \"Biến mọi mảnh đất thành Đầm Lầy ngọt ngào.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773729,\n    \"suggestedTranslation\": \"Biến Đổi Địa Hình\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773730,\n    \"suggestedTranslation\": \"Tặng nó Gói Quà là chiếc vương miện được đeo bởi các vị vua từ lâu đời, và người cá của bạn sẽ chiến đấu thông minh hơn để kéo dài sự sống.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773731,\n    \"suggestedTranslation\": \"Nhiệm Vụ Vương Miện Của Nhà Vua\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773732,\n    \"suggestedTranslation\": \"Thêm giáp đá vào đôi vai điêu khắc của Nhà Vua để tăng thêm sự vững chãi cho những người lính người cá của bạn.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773733,\n    \"suggestedTranslation\": \"Nhiệm Vụ Giáp Vai Của Nhà Vua\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773734,\n    \"suggestedTranslation\": \"Hiến tặng vũ khí này vốn dùng tốt nhất ở trên biển, và người cá của bạn sẽ tấn công khéo léo như thể ba người.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773735,\n    \"suggestedTranslation\": \"Nhiệm Vụ Đinh Ba Của Nhà Vua\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773736,\n    \"suggestedTranslation\": \"Vệ Binh Người Cá sẽ rút lui khỏi trận chiến khi cạn Máu, và chờ được hồi máu.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773737,\n    \"suggestedTranslation\": \"Chiến Binh Đầm Lầy Khôn Ngoan\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773738,\n    \"suggestedTranslation\": \"Tăng giới hạn đói của Vua Người Cá.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773739,\n    \"suggestedTranslation\": \"Vị Vua No Nê I\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773740,\n    \"suggestedTranslation\": \"Tăng giới hạn đói của Vua Người Cá nhiều hơn nữa.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773741,\n    \"suggestedTranslation\": \"Vị Vua No Nê II\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773742,\n    \"suggestedTranslation\": \"Làm chậm quá trình tiêu hóa của Vua Người Cá, giúp ngài lâu đói hơn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773743,\n    \"suggestedTranslation\": \"Vị Vua No Nê III\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773744,\n    \"suggestedTranslation\": \"Học cách chế tạo một người bạn dễ thương khiến Muỗi trở nên trung lập với bạn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773745,\n    \"suggestedTranslation\": \"Muỗi Vô Hình\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773746,\n    \"suggestedTranslation\": \"Học cách chế tạo các vật phẩm liên quan đến Muỗi: Bom Muỗi, Phân Bón và Đạn Máu.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773747,\n    \"suggestedTranslation\": \"Thuật Ngứa I\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773748,\n    \"suggestedTranslation\": \"Làm chủ việc sử dụng các vật phẩm liên quan đến Muỗi.\\n\\nVới sự giúp đỡ của Bé Ngứa, hãy bắt muỗi ngay từ trên không.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773749,\n    \"suggestedTranslation\": \"Thuật Ngứa II\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773750,\n    \"suggestedTranslation\": \"Những người sống sót ở gần Wurt sẽ di chuyển qua Đầm Lầy mượt mà như cô ấy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773751,\n    \"suggestedTranslation\": \"Người Dẫn Đường Đầm Lầy\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773752,\n    \"suggestedTranslation\": \"Những người cá đi theo bạn có thể chết, nhưng cái bóng của chúng vẫn sống tiếp.\\nTruyền sức mạnh Siêu Phàm vào cái bóng của những người cá đã ngã xuống bằng cách dùng Kinh Dị Thuần Túy.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773753,\n    \"suggestedTranslation\": \"Người Cá Hồi Sinh Bóng Tối\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773754,\n    \"suggestedTranslation\": \"Không vùng đất nào được an toàn khỏi sự biến chất đen tối và tuyệt đẹp của Đầm Lầy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773755,\n    \"suggestedTranslation\": \"Biến Đổi Đất Đai\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773756,\n    \"suggestedTranslation\": \"Sử dụng công nghệ \\\"mượn\\\" từ Người Sáng Lập Bí Ẩn, cho phép Thực Thể Ánh Sáng chiếm hữu Thân Máy Dự Phòng của bạn và trở thành thuộc hạ người máy bóng đêm.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773757,\n    \"suggestedTranslation\": \"Tàu Mặt Trăng\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773758,\n    \"suggestedTranslation\": \"Cho phép lắp đặt các linh kiện bóng tối được chọn vào mạch điện của bạn, mang lại cho Thân Máy các khả năng khác nhau ở cả trạng thái có người ở và không có người ở.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773759,\n    \"suggestedTranslation\": \"Hầu Tận Bóng Tối\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773760,\n    \"suggestedTranslation\": \"Mạch Xử Lý nhận được một hiệu ứng mới ngoài hiệu ứng ban đầu. Mạch Tăng Trưởng Dạ Dày được tăng cường.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773761,\n    \"suggestedTranslation\": \"Tinh Chỉnh Mạch Alpha I\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773762,\n    \"suggestedTranslation\": \"Mạch Bền Bỉ, Mạch Xử Lý và Mạch Phục Hồi nhận được hiệu ứng mới bên cạnh hiệu ứng ban đầu. Mạch Tăng Trưởng Dạ Dày được tăng cường.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773763,\n    \"suggestedTranslation\": \"Tinh Chỉnh Mạch Alpha II\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773764,\n    \"suggestedTranslation\": \"Mạch Giữ Nhiệt, Mạch Tản Nhiệt, Mạch Cảm Quang, Mạch Thanh Âm và Mạch tăng cường phạm vi nhận được hiệu ứng mới bên cạnh hiệu ứng ban đầu.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773765,\n    \"suggestedTranslation\": \"Tinh Chỉnh Mạch Beta I\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773766,\n    \"suggestedTranslation\": \"Mạch Tăng Tốc, Mạch Điện Từ và Mạch Chiếu Sáng nhận được hiệu ứng mới bên cạnh hiệu ứng ban đầu.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773767,\n    \"suggestedTranslation\": \"Tinh Chỉnh Mạch Beta II\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773768,\n    \"suggestedTranslation\": \"Tốc độ hồi phục điện tích thụ động nhanh hơn nhiều và mất ít hơn một điện tích khi rút mạch điện đã sạc có từ hai khe trở lên.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773769,\n    \"suggestedTranslation\": \"Năng Lượng Tràn Trề\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773770,\n    \"suggestedTranslation\": \"Có khả năng rút bất kỳ mạch điện nào trong thanh, và các mạch điện sẽ mất một nửa lượng độ bền thông thường khi bị rút ra.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773771,\n    \"suggestedTranslation\": \"Quyền Được Chỉnh Sửa\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773772,\n    \"suggestedTranslation\": \"Thân Máy Dự Phòng giữ cho Mạch Beta của chúng hoạt động ngay cả khi đã tắt nguồn.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773773,\n    \"suggestedTranslation\": \"Chế Độ Chờ Ấm\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773774,\n    \"suggestedTranslation\": \"Thêm một khe cắm vào tất cả các thanh mạch điện của bạn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773775,\n    \"suggestedTranslation\": \"Thừa Một Ô\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773776,\n    \"suggestedTranslation\": \"Học cách chế tạo Bộ lưu trữ di động để gửi vật phẩm đến bất kỳ vị trí nào trên bản đồ.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773777,\n    \"suggestedTranslation\": \"Vận Chuyển I\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773778,\n    \"suggestedTranslation\": \"Học cách chế tạo Bộ lưu trữ di động lớn hơn.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773779,\n    \"suggestedTranslation\": \"Vận Chuyển II\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773780,\n    \"suggestedTranslation\": \"Học cách chế tạo một Thân Máy Dự Phòng đáng tin cậy.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773781,\n    \"suggestedTranslation\": \"Chế Độ Chờ Lạnh I\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773782,\n    \"suggestedTranslation\": \"Chế tạo tối đa hai Thân Máy Dự Phòng.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773783,\n    \"suggestedTranslation\": \"Chế Độ Chờ Lạnh II\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773784,\n    \"suggestedTranslation\": \"Chế tạo tối đa ba Thân Máy Dự Phòng.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773785,\n    \"suggestedTranslation\": \"Chế Độ Chờ Lạnh III\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773786,\n    \"suggestedTranslation\": \"Mở rộng bán kính quét của Máy Quét Sinh Học, đồng thời gia tăng tầm hoạt động của Máy Dò Bản Đồ, Máy Giật Điện, Máy Thu Thập Tự Động và Drone Khai Thác Điểm Yếu.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773787,\n    \"suggestedTranslation\": \"Bộ Tăng Sóng\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773788,\n    \"suggestedTranslation\": \"Mạch Kỳ Thủ, Mạch tái tiêu hóa và Mạch Gầm Hú nhận được hiệu ứng mới bên cạnh hiệu ứng ban đầu.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773789,\n    \"suggestedTranslation\": \"Tinh Chỉnh Mạch Gamma I\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773790,\n    \"suggestedTranslation\": \"Mạch Phòng Thủ và Mạch Xoay Vòng nhận được hiệu ứng mới bên cạnh hiệu ứng ban đầu.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773791,\n    \"suggestedTranslation\": \"Tinh Chỉnh Mạch Gamma II\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773792,\n    \"suggestedTranslation\": \"Ám vào một Thân Máy Dự Phòng sẽ chuyển ý thức của bạn vào đó, tiêu thụ toàn bộ các đơn vị điện tích của thân máy.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773793,\n    \"suggestedTranslation\": \"Máy Có Người Ở I\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773794,\n    \"suggestedTranslation\": \"Nếu bạn chết khi đầy điện tích và chưa đạt số lượng Thân Máy Dự Phòng tối đa, một cái sẽ được để lại.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773795,\n    \"suggestedTranslation\": \"Máy Có Người Ở II\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773796,\n    \"suggestedTranslation\": \"Hồi sinh bằng Thân Máy Dự Phòng sẽ khôi phục hoàn toàn Máu của bạn.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773797,\n    \"suggestedTranslation\": \"Máy Có Người Ở III\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773798,\n    \"suggestedTranslation\": \"Tìm và đánh bại Vô Địch Thiên Thể.\\nKhông có ái lực với bóng tối.\\nCó khả năng chế tạo Thân Máy Dự Phòng.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773799,\n    \"suggestedTranslation\": \"Chuyển Đổi Từ Xa\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773800,\n    \"suggestedTranslation\": \"Chuyển Ý Thức Từ Xa sang bất kỳ Thân Máy Dự Phòng nào trên bản đồ.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773801,\n    \"suggestedTranslation\": \"Học cách chế tạo Máy Dò Bản Đồ để thám hiểm và vẽ bản đồ các khu vực Không rõ.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773802,\n    \"suggestedTranslation\": \"Khảo Sát Thực Địa\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 773803,\n    \"suggestedTranslation\": \"Tìm và đánh bại Thợ Dệt Nhiên Liệu Cổ Đại.\\nKhông có ái lực với mặt trăng.\\nCó khả năng chế tạo Thân Máy Dự Phòng.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773804,\n    \"suggestedTranslation\": \"Học cách chế tạo Máy Giật Điện để phóng điện vào kẻ thù từ xa.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 773805,\n    \"suggestedTranslation\": \"Đam Mê Viễn Mật Cơ Khí I\"