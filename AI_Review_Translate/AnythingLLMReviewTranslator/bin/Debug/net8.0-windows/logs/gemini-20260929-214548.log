ậm tốc độ thuyền và thường dừng hẳn lại. Nước càng sâu, dây neo chạm đáy càng lâu, và kéo lên cũng càng lâu.\", \"rating\": 9.5},\n  {\"id\": 772004, \"suggestedTranslation\": \"Ngay cả trái tim bằng đá cũng có thể bị nứt bởi chút hơi ấm... hoặc có lẽ là rất nhiều.\", \"rating\": 9.0},\n  {\"id\": 772005, \"suggestedTranslation\": \"Một hạt giống ngoại lai có điều kiện sinh trưởng rất khắt khe. Mọi thứ đều có thời điểm và địa điểm riêng...\", \"rating\": 9.0},\n  {\"id\": 772006, \"suggestedTranslation\": \"Dấu chân của một loài động vật đi ngang qua đâu đó.\", \"rating\": 9.0},\n  {\"id\": 772007, \"suggestedTranslation\": \"Người đội sẽ đào lớp cỏ nền họ đang đứng và đặt cỏ nền khi nạp đầy các vật phẩm cỏ nền.\", \"rating\": 9.0},\n  {\"id\": 772008, \"suggestedTranslation\": \"Những người sống sót sẽ bị giảm tốc độ khi đi qua đây.\\n\\nChắc hẳn có thứ gì đó đang làm mặt đất yếu đi.\", \"rating\": 9.0},\n  {\"id\": 772009, \"suggestedTranslation\": \"Một thiết bị cổ đại phóng ra những di vật kỳ lạ.\", \"rating\": 9.0},\n  {\"id\": 772010, \"suggestedTranslation\": \"Một thiết bị bí ẩn khắc các mũi tên lên mặt đất.\", \"rating\": 9.0},\n  {\"id\": 772011, \"suggestedTranslation\": \"Một vật thể cũ có chữ viết có thể kiểm tra được.\", \"rating\": 9.0},\n  {\"id\": 772012, \"suggestedTranslation\": \"Khi được cấp điện và người sống sót đi ngang qua, thiết bị này sẽ phóng ra một quả cầu năng lượng bắt đầu lang thang khắp Mê cung Lưu trữ.\", \"rating\": 9.0},\n  {\"id\": 772013, \"suggestedTranslation\": \"Cần bao nhiêu người sống sót để thay một bóng đèn?\", \"rating\": 9.0},\n  {\"id\": 772014, \"suggestedTranslation\": \"Mỗi 5 giây, một đòn tấn công gởi tới sẽ bị phớt lờ hoàn toàn.\", \"rating\": 9.0},\n  {\"id\": 772015, \"suggestedTranslation\": \"Bộ vỏ đầy gai này gây sát thương khi bị tấn công.\", \"rating\": 9.0},\n  {\"id\": 772016, \"suggestedTranslation\": \"Được bọc trong vẩy của Chuồn Chuồn, nó giúp bạn miễn nhiễm với lửa.\", \"rating\": 9.5},\n  {\"id\": 772017, \"suggestedTranslation\": \"Bộ giáp này sẽ từ từ tự sửa chữa.\", \"rating\": 9.0},\n  {\"id\": 772018, \"suggestedTranslation\": \"Phản lại sát thương cho kẻ địch và thậm chí nhiều hơn đối với những kẻ mang hệ Bóng Tối.\", \"rating\": 9.5},\n  {\"id\": 772019, \"suggestedTranslation\": \"Bộ giáp này bền nhưng nặng, và làm chậm người mặc.\", \"rating\": 9.0},\n  {\"id\": 772020, \"suggestedTranslation\": \"Bộ giáp này chặn sát thương, nhưng có thói quen xấu là khiến người mặc phát điên.\", \"rating\": 9.0},\n  {\"id\": 772021, \"suggestedTranslation\": \"Phục hồi tinh thần theo thời gian và làm giảm 40% tốc độ cạn kiệt độ đói.\", \"rating\": 9.5},\n  {\"id\": 772022, \"suggestedTranslation\": \"Người ta có thể rúc vào chiếc mai cứng này để sống sót qua mọi cuộc tấn công.\", \"rating\": 9.0},\n  {\"id\": 772023, \"suggestedTranslation\": \"\\\"Chà, Một Hệ Thống Thông Minh Khá Xinh Đẹp.\\\" Sử dụng một tổ hợp phức tạp gồm bánh răng và mạch điện để tính toán.\\n\\nMột khi mục tiêu đã được chọn, miễn là ở trong tầm ngắm, W.A.R.B.I.S. bắt đầu tính toán hiệu suất tối ưu để chiến đấu với mục tiêu.\\n\\nBộ giáp cải thiện tốc độ của người mặc khi phân tích mục tiêu, kết thúc bằng việc tăng 30% tốc độ.\\n\\nKhi kết hợp với mũ W.A.R.B.I.S., cả hai sẽ đồng bộ trong vài khoảnh khắc để chia sẻ thông tin mục tiêu.\", \"rating\": 9.5},\n  {\"id\": 772024, \"suggestedTranslation\": \"Thỏ Nam bị thu hút bởi mùi hương quyến rũ của nó, đủ mạnh để che đậy mùi xạ hương của thịt.\", \"rating\": 9.0},\n  {\"id\": 772025, \"suggestedTranslation\": \"Một vòng đá bị vỡ có ổ cắm trống ở phần đế.\", \"rating\": 9.0},\n  {\"id\": 772026, \"suggestedTranslation\": \"Một vật thể đang sụp đổ có chữ viết có thể kiểm tra được.\", \"rating\": 9.0},\n  {\"id\": 772027, \"suggestedTranslation\": \"Một nhân vật tên là Jimbo muốn bạn chơi đánh bài cùng.\\n\\nĐể bắt đầu, bạn nên chọn một trong ba Joker. Mỗi lá có cách riêng để giúp bạn có lợi thế trong trò chơi.\\n\\nThứ hai, chơi Poker. Bạn có thể chọn lá bài để loại bỏ và thay thế bằng lá mới. Bạn có thể làm vậy hai lần.\\n\\nSau đó bài của bạn sẽ được đánh giá. Bạn sẽ nhận được phỉnh dựa trên giá trị các lá bài. Bạn sẽ nhận hệ số nhân dựa trên chất lượng bộ bài. Phỉnh nhân với Hệ số nhân là điểm số của bạn. Đạt càng nhiều điểm càng tốt. Jimbo có thể thưởng cho bạn vì thời gian tham gia.\", \"rating\": 9.0},\n  {\"id\": 772028, \"suggestedTranslation\": \"Bảo vệ khỏi bị sét đánh.\", \"rating\": 9.5},\n  {\"id\": 772029, \"suggestedTranslation\": \"Người mặc sẽ không chịu bất kỳ sát thương chết đuối nào khi dạt vào bờ.\", \"rating\": 9.5},\n  {\"id\": 772030, \"suggestedTranslation\": \"Hồi 30 Máu.\", \"rating\": 9.5},\n  {\"id\": 772031, \"suggestedTranslation\": \"Hồi 24 máu.\\n\\nNếu Walter sử dụng và đã học kỹ năng Quân Y, nó sẽ hồi thêm 12 máu và hồi phục 10 tinh thần.\", \"rating\": 9.5},\n  {\"id\": 772032, \"suggestedTranslation\": \"Mỗi đòn tấn công rút hút 6.8 Máu từ mục tiêu sống.\\n\\nNếu người dùng không đầy máu, nó cũng hút 3.4 Tinh Thần.\", \"rating\": 9.5},\n  {\"id\": 772033, \"suggestedTranslation\": \"Làm cho hồ nước nóng trở nên ấm áp, bốc hơi và trong vắt khi thả vào.\", \"rating\": 9.5},\n  {\"id\": 772034, \"suggestedTranslation\": \"Phục hồi 3.9 Độ Đói cứ sau 5 giây.\", \"rating\": 9.0},\n  {\"id\": 772035, \"suggestedTranslation\": \"Một thùng chứa có thể mang theo với 8 ô chứa Bài Ca Chiến Trận và Ngòi Gai Chiến Trận.\", \"rating\": 9.0},\n  {\"id\": 772036, \"suggestedTranslation\": \"Giảm 25% độ mòn vũ khí của bạn khi lắng nghe.\\n\\nĐây là một Bài Ca Chiến Trận. Wigfrid phải tiếp tục hát để duy trì hiệu quả.\", \"rating\": 9.0},\n  {\"id\": 772037, \"suggestedTranslation\": \"Wigfrid và đồng minh gần đó sẽ không nhận sát thương lửa.\\n\\nĐây là một Bài Ca Chiến Trận. Wigfrid phải tiếp tục hát để duy trì hiệu quả.\", \"rating\": 9.5},\n  {\"id\": 772038, \"suggestedTranslation\": \"Wigfrid và đồng minh gần đó sẽ hồi máu khi chiến đấu. Wigfrid cũng sẽ hồi thêm một chút.\\n\\nĐây là một Bài Ca Chiến Trận. Wigfrid phải tiếp tục hát để duy trì hiệu quả.\", \"rating\": 9.0},\n  {\"id\": 772039, \"suggestedTranslation\": \"Gây hoảng loạn cho kẻ địch gần đó.\\n\\nĐây là Ngòi Gai Chiến Trận vì nó hoàn tất ngay lập tức.\", \"rating\": 9.5},\n  {\"id\": 772040, \"suggestedTranslation\": \"Hồi sinh tối đa 2 người chơi đồng minh gần đó.\\n\\nĐây là Ngòi Gai Chiến Trận vì nó hoàn tất ngay lập tức.\", \"rating\": 9.5},\n  {\"id\": 772041, \"suggestedTranslation\": \"Thu hút sự chú ý của kẻ địch gần đó.\\n\\nĐây là Ngòi Gai Chiến Trận vì nó hoàn tất ngay lập tức.\", \"rating\": 9.5},\n  {\"id\": 772042, \"suggestedTranslation\": \"Wigfrid và đồng minh gần đó nhận ít hơn 10% sát thương từ kẻ địch hệ Mặt Trăng và gây thêm 5% sát thương lên kẻ địch hệ Bóng Tối.\\n\\nĐây là Bài Ca Chiến Trận. Wigfrid phải tiếp tục hát để duy trì hiệu quả.\", \"rating\": 9.5},\n  {\"id\": 772043, \"suggestedTranslation\": \"Những sinh vật đáng sợ có vẻ bớt đáng sợ đi một nửa khi bạn lắng nghe bài hát tuyệt vời này.\\n\\nĐây là Bài Ca Chiến Trận. Wigfrid phải tiếp tục hát để duy trì hiệu quả.\", \"rating\": 9.0},\n  {\"id\": 772044, \"suggestedTranslation\": \"Wigfrid và đồng minh gần đó sẽ hồi phục tinh thần khi chiến đấu.\\n\\nĐây là Bài Ca Chiến Trận. Wigfrid phải tiếp tục hát để duy trì hiệu quả.\", \"rating\": 9.5},\n  {\"id\": 772045, \"suggestedTranslation\": \"Wigfrid và đồng minh gần đó nhận ít hơn 10% sát thương từ kẻ địch hệ Bóng Tối và gây thêm 5% sát thương lên kẻ địch hệ Mặt Trăng.\\n\\nĐây là Bài Ca Chiến Trận. Wigfrid phải tiếp tục hát để duy trì hiệu quả.\", \"rating\": 9.5},\n  {\"id\": 772046, \"suggestedTranslation\": \"Một thùng chứa có thể mang theo với 6 ô có thể chứa thức ăn đã nấu.\\n\\nThức ăn lưu trữ trong đó sẽ được bảo quản trong thời gian dài.\", \"rating\": 9.0},\n  {\"id\": 772047, \"suggestedTranslation\": \"Tốc độ đói giảm 25% khi mặc.\", \"rating\": 9.0},\n  {\"id\": 772048, \"suggestedTranslation\": \"Nếu có từ 6 bông hoa trở lên xung quanh thùng ong, ong sẽ sản xuất mật ong bên trong thùng ong.\", \"rating\": 9.5},\n  {\"id\": 772049, \"suggestedTranslation\": \"Cẩn thận với mùa giao phối hung hăng.\\n\\nCho ăn và chăm sóc một trong những con thú này, và biết đâu bạn có thể lắp yên cưỡi cho chúng.\", \"rating\": 9.5},\n  {\"id\": 772050, \"suggestedTranslation\": \"Đồ ăn nhẹ cho Bò Lai.\", \"rating\": 9.5},\n  {\"id\": 772051, \"suggestedTranslation\": \"Người sống sót có thể buộc một con bò lai thân thiết vào bàn chải lông này, sau đó thêm hoặc đổi trang phục cho Bò Lai.\", \"rating\": 9.5},\n  {\"id\": 772052, \"suggestedTranslation\": \"Khiến người mặc trở nên thân thiện với Bò Lai đang động dục.\", \"rating\": 9.5},\n  {\"id\": 772053, \"suggestedTranslation\": \"Đồ ăn nhẹ cho Bò Lai.\", \"rating\": 9.5},\n  {\"id\": 772054, \"suggestedTranslation\": \"Đặt tên và tạo liên kết với một con Bò Lai tại một thời điểm. Bò Lai đã liên kết sẽ đi theo người giữ, thậm chí vào hang động và khi ngoại tuyến.\", \"rating\": 9.5},\n  {\"id\": 772055, \"suggestedTranslation\": \"Khả năng bảo vệ của chiếc mũ này thực sự chỉ phát huy tác dụng với Ong và các sinh vật giống ong.\", \"rating\": 9.5},\n  {\"id\": 772056, \"suggestedTranslation\": \"Tổ ong khổng lồ và cực kỳ dễ chọc phá này chứa đầy mật ong ngọt ngào và những bất ngờ khác.\", \"rating\": 9.5},\n  {\"id\": 772057, \"suggestedTranslation\": \"Đóng băng giai đoạn của một loài thực vật. Điều này sẽ khiến nó không sản sinh gì, nhưng cũng không thu hút ký sinh trùng.\", \"rating\": 9.5},\n  {\"id\": 772058, \"suggestedTranslation\": \"Một người bạn mạnh mẽ khi tâm trí Willow tiệm cận sự điên loạn.\", \"rating\": 9.0},\n  {\"id\": 772059, \"suggestedTranslation\": \"Có thể nhốt một chú chim vào lồng này.\\n\\nHãy nhớ cho chim ăn.\\n\\nNếu chim được cho ăn trái cây hoặc rau củ, nó sẽ thả ra hạt của những loại cây đó.\\n\\nNếu chim được cho ăn thịt, nó có thể đẻ trứng.\", \"rating\": 9.5},\n  {\"id\": 772060, \"suggestedTranslation\": \"Tăng tinh thần đồng thời làm mát người mặc.\", \"rating\": 9.5},\n  {\"id\": 772061, \"suggestedTranslation\": \"Nó dạy bạn cách chế tạo một thứ cụ thể.\", \"rating\": 9.0},\n  {\"id\": 772062, \"suggestedTranslation\": \"Bắn ra các đạn đạo đóng băng.\", \"rating\": 9.5},\n  {\"id\": 772063, \"suggestedTranslation\": \"Có thể nạp đạn đại bác.\\n\\nKhi đã nạp đạn, nó có thể nhắm để bắn. Hướng bắn có thể thay đổi bằng cách đứng cạnh nó từ các hướng khác nhau trước khi ngắm.\", \"rating\": 9.5},\n  {\"id\": 772064, \"suggestedTranslation\": \"Cấu trúc này trước tiên phải được ghép đôi với Đèn Dẫn Đường Tự Lái.\\n\\nSau khi ghép đôi, nó sẽ kéo chính nó về phía đèn.\\n\\nNếu ở trên thuyền, nó sẽ làm tăng tốc độ của thuyền theo hướng của nó.\", \"rating\": 9.5},\n  {\"id\": 772065, \"suggestedTranslation\": \"Vá các chỗ rò rỉ trên thuyền.\", \"rating\": 9.0},\n  {\"id\": 772066, \"suggestedTranslation\": \"Giải pháp tạm thời cho các chỗ rò rỉ. Bị thủng thuyền à? Dùng miếng tảo... rồi miếng nữa... rồi lại miếng nữa...\", \"rating\": 9.5},\n  {\"id\": 772067, \"suggestedTranslation\": \"Một chiếc thuyền gia cố tích hợp sẵn thùng chứa 16 ô. Giờ người ta không còn làm thuyền tốt như thế nữa.\", \"rating\": 9.5},\n  {\"id\": 772068, \"suggestedTranslation\": \"Một lớp đệm giống đá không nhận sát thương khi va vào đất liền. Đỡ lấy này, đất liền!\", \"rating\": 9.5},\n  {\"id\": 772069, \"suggestedTranslation\": \"Hấp thụ sát thương va chạm của chiếc thuyền mà nó được lắp lên. Có thể sửa chữa bằng Tảo.\", \"rating\": 9.5},\n  {\"id\": 772070, \"suggestedTranslation\": \"Hấp thụ sát thương va chạm của chiếc thuyền mà nó được lắp lên. Có thể sửa chữa bằng Vỏ Sò Vỡ.\", \"rating\": 9.5},\n  {\"id\": 772071, \"suggestedTranslation\": \"Một thùng chứa 20 ô cho Sách và giấy.\\n\\nSách bên trong hồi 1 độ bền cứ sau 30 giây, gấp đôi nếu Wickerbottom ở gần.\\n\\nNgoài ra, thư viện hoạt động như một Máy Giả Kim, cung cấp cho những người sống sót gần đó những món đồ mới để chế tạo.\", \"rating\": 9.5},\n  {\"id\": 772072, \"suggestedTranslation\": \"Triệu hồi 2 Ong Chiến Binh đi theo. Tối đa 16 con cùng lúc.\", \"rating\": 9.5},\n  {\"id\": 772073, \"suggestedTranslation\": \"Triệu hồi tối đa 20 con chim đáp xuống gần đó.\", \"rating\": 9.0},\n  {\"id\": 772074, \"suggestedTranslation\": \"Giáng xuống hơn một chục tia sét không kiểm soát.\", \"rating\": 9.5},\n  {\"id\": 772075, \"suggestedTranslation\": \"Dập tắt mọi ngọn lửa đang cháy và âm ỉ gần đó, đồng thời tạo ra hoặc nạp năng lượng cho Bút Lửa thấm đẫm năng lượng đó.\", \"rating\": 9.5},\n  {\"id\": 772076, \"suggestedTranslation\": \"Triệu hồi một đàn cá đại dương ở gần đó.\", \"rating\": 9.5},\n  {\"id\": 772077, \"suggestedTranslation\": \"Làm lớn nhanh chóng tới 10 cây trồng trong vườn hoặc bụi cây ra quả ở gần.\", \"rating\": 9.0},\n  {\"id\": 772078, \"suggestedTranslation\": \"Làm lớn nhanh chóng tới 15 cây trồng trong vườn hoặc bụi cây ra quả ở gần.\", \"rating\": 9.0},\n  {\"id\": 772079, \"suggestedTranslation\": \"Triệu hồi nửa ngày ánh sáng chiếu xuống. Sẽ gây ra động đất trong hang động.\", \"rating\": 9.0},\n  {\"id\": 772080, \"suggestedTranslation\": \"Triệu hồi 2 ngày ánh sáng chiếu xuống. Sẽ gây ra động đất trong hang động.\", \"rating\": 9.0},\n  {\"id\": 772081, \"suggestedTranslation\": \"Đặt giai đoạn mặt trăng hiện tại thành trăng tròn.\", \"rating\": 9.5},\n  {\"id\": 772082, \"suggestedTranslation\": \"Nếu trời đang mưa, mưa sẽ tạnh. Nếu trời không mưa, mưa sẽ bắt đầu và làm ẩm đất nông trại gần đó.\", \"rating\": 9.0},\n  {\"id\": 772083, \"suggestedTranslation\": \"Cung cấp cho những người sống sót gần đó một lượt chế tạo đặc biệt. Mỗi lượt cho phép họ chế tạo vật phẩm tiếp theo có cấp độ công nghệ cao hơn bình thường một bậc.\", \"rating\": 9.0},\n  {\"id\": 772084, \"suggestedTranslation\": \"Trồng cỏ, cây con và cây cối gần đó, nhưng cỏ sẽ cần được bón phân lại sớm hơn.\", \"rating\": 9.5},\n  {\"id\": 772085, \"suggestedTranslation\": \"Làm cho các sinh vật gần đó chìm vào giấc ngủ.\", \"rating\": 9.0},\n  {\"id\": 772086, \"suggestedTranslation\": \"Làm khô những người sống sót gần đó cũng như điều chỉnh nhiệt độ của họ ở mức dễ chịu 35 độ.\", \"rating\": 9.0},\n  {\"id\": 772087, \"suggestedTranslation\": \"Triệu hồi một vài Xúc Tu không mấy thân thiện ở gần đó.\", \"rating\": 9.0},\n  {\"id\": 772088, \"suggestedTranslation\": \"Tạo ra một lượng Mạng Nhện trên mặt đất làm chậm các sinh vật di chuyển trên đó.\\n\\nNó sẽ biến mất sau 2 phút.\", \"rating\": 9.5},\n  {\"id\": 772089, \"suggestedTranslation\": \"Bạn phải bắt lấy nó sau khi ném đi.\", \"rating\": 9.0},\n  {\"id\": 772090, \"suggestedTranslation\": \"Có thể ném xuống biển để tạo ra một cặp Cổng Xoáy kết nối với nhau. Thuyền đi gần chúng sẽ được đưa đến lối vào kia.\", \"rating\": 9.0},\n  {\"id\": 772091, \"suggestedTranslation\": \"Có thể dùng trên Bò Lai để thu thập Lông bò.\\n\\nTăng 40% độ vâng lời của Bò Lai và tăng 1.6% độ thuần hóa của Bò Lai mỗi ngày một lần.\", \"rating\": 9.5},\n  {\"id\": 772092, \"suggestedTranslation\": \"Bắt những sinh vật bay nhỏ và cho chúng hoặc chiến lợi phẩm của chúng vào kho đồ của bạn.\", \"rating\": 9.0},\n  {\"id\": 772093, \"suggestedTranslation\": \"Có thể mở gói để lấy các vật phẩm bên trong.\", \"rating\": 9.0},\n  {\"id\": 772094, \"suggestedTranslation\": \"Có thể đóng gói tối đa 4 chồng vật phẩm thành một vật phẩm có thể mở ra sau.\", \"rating\": 9.0},\n  {\"id\": 772095, \"suggestedTranslation\": \"Người mặc có the Ẩn nấp dưới bụi cây và sẽ không bị sinh vật tấn công miễn là chúng không nhìn thấy người sống sót ẩn nấp.\", \"rating\": 9.0},\n  {\"id\": 772096, \"suggestedTranslation\": \"Khi có nhiên liệu, nó tạo ra ánh sáng và sức nóng.\\n\\nNó cũng có thể nấu chín thức ăn.\\n\\nSẽ biến mất khi hết nhiên liệu.\", \"rating\": 9.0},\n  {\"id\": 772097, \"suggestedTranslation\": \"Nhạy cảm với hơi độc, chúng thường chết khi phát hiện thấy chất độc quái dị ở gần.\", \"rating\": 9.0},\n  {\"id\": 772098, \"suggestedTranslation\": \"Một thùng chứa 14 ô dùng để đựng Kẹo, Đồ lưu niệm và Đồ trang trí.\", \"rating\": 9.0},\n  {\"id\": 772099, \"suggestedTranslation\": \"Tăng 25% tốc độ di chuyển khi cầm.\", \"rating\": 9.0},\n  {\"id\": 772100, \"suggestedTranslation\": \"Cho phép Bàn Cưa được trang bị nó để chế tạo những thứ mới.\", \"rating\": 9.5},\n  {\"id\": 772101, \"suggestedTranslation\": \"Đứng gần thiết bị này sẽ cung cấp cho người sống sót những món đồ nội thất mới có thể chế tạo.\", \"rating\": 9.0},\n  {\"id\": 772102, \"suggestedTranslation\": \"Cho phép người sống sót chế tạo Bản Đồ Cuộn để trao đổi thông tin bản đồ.\\n\\nSử dụng Bản Thiết Kế, Bản Vẽ, Mẫu Trang Phục, Trang Sổ Lưu Bút, Quảng Cáo hoặc Thẻ Công Thức lên đây sẽ biến chúng thành Giấy trắng.\", \"rating\": 9.5},\n  {\"id\": 772103, \"suggestedTranslation\": \"Ổ của Mèo Trúc và là nơi chúng cất giữ những món đồ đã mang đi.\\n\\nNhững món đồ đó có thể được nhặt ở đây, nhưng Mèo Trúc sẽ không thích điều đó đâu.\", \"rating\": 9.5},\n  {\"id\": 772104, \"suggestedTranslation\": \"Vòng đời của Miệng Phun Địa Nhiệt bắt đầu từ Mối Địa Nhiệt.\", \"rating\": 9.5},\n  {\"id\": 772105, \"suggestedTranslation\": \"Những lỗ thông hơi này có thể phun ra nhiều thứ hơn là chỉ sức nóng đơn thuần.\", \"rating\": 9.0},\n  {\"id\": 772106, \"suggestedTranslation\": \"Một gói quà được ban tặng bởi Nữ Hoàng Vùng Hằng Cố, để làm phong phú thêm những cuộc đời ngắn ngủi, vô nghĩa đáng thương của các ngươi. Cô ấy thậm chí còn tử tế chuẩn bị sẵn trang phục và kịch bản!\", \"rating\": 9.5},\n  {\"id\": 772107, \"suggestedTranslation\": \"Có thể cất giữ đồ đạc trong Chester giống như rương.\", \"rating\": 9.5},\n  {\"id\": 772108, \"suggestedTranslation\": \"Một con quái vật nhẫn tâm. Nó khao khát hương vị của chiến lợi phẩm và thịt.\", \"rating\": 9.0},\n  {\"id\": 772109, \"suggestedTranslation\": \"Thu hút một đàn cá khi ném xuống đại dương.\", \"rating\": 9.5},\n  {\"id\": 772110, \"suggestedTranslation\": \"Hoạt động giống như lửa trại, nhưng làm lạnh mọi thứ thay vì sưởi ấm.\", \"rating\": 9.5},\n  {\"id\": 772111, \"suggestedTranslation\": \"Hoạt động giống như lò lửa, nhưng làm lạnh mọi thứ thay vì sưởi ấm.\", \"rating\": 9.5},\n  {\"id\": 772112, \"suggestedTranslation\": \"Sẽ tiết lộ vị trí của người dùng trên bản đồ cho những người sống sót khác cũng đang cầm La Bàn.\", \"rating\": 9.5},\n  {\"id\": 772113, \"suggestedTranslation\": \"Sẽ cộng thêm 24 Dưỡng Chất khi dùng cho Đất Nông Trại.\", \"rating\": 9.0},\n  {\"id\": 772114, \"suggestedTranslation\": \"Có thể nhận tới 6 vật phẩm \\\"ướt\\\" và \\\"khô\\\". Khi có ít nhất 2 vật phẩm, nó bắt đầu ủ phân.\\n\\nCàng nhiều vật phẩm thì tốc độ sản xuất phân trộn càng nhanh.\\n\\nNó hoạt động nhanh hơn nếu có sự cân bằng giữa vật phẩm \\\"ướt\\\" và \\\"khô\\\".\", \"rating\": 9.0},\n  {\"id\": 772115, \"suggestedTranslation\": \"Wormwood sẽ hồi 8 máu cộng 1 máu/giây trong 32 phút. Wormwood cũng sẽ nở hoa trong 4 phút.\\nĐiều này cũng hoạt động như phân bón tốt cho làm vườn.\", \"rating\": 9.5},\n  {\"id\": 772116, \"suggestedTranslation\": \"Ghi chép về tất cả các món ăn đã nấu và/hoặc đã ăn, cũng như các nguyên liệu dùng để nấu chúng.\", \"rating\": 9.5},\n  {\"id\": 772117, \"suggestedTranslation\": \"Tinh chất của sự thấu hiểu... Nhiên liệu của sức mạnh... ...Đang sủi bọt.\", \"rating\": 9.0},\n  {\"id\": 772118, \"suggestedTranslation\": \"Mảnh trang phục được sử dụng trong các vở kịch sân khấu.\", \"rating\": 9.5},\n  {\"id\": 772119, \"suggestedTranslation\": \"Đứng gần thiết bị này sẽ cung cấp cho người sống sót những thứ mới mà họ có thể chế tạo.\", \"rating\": 9.0},\n  {\"id\": 772120, \"suggestedTranslation\": \"Chứa một ổ cắm hình viên ngọc.\", \"rating\": 9.0},\n  {\"id\": 772121, \"suggestedTranslation\": \"Người sống sót có thể chế tạo một thú cưng từ đây để đi theo họ.\", \"rating\": 9.0},\n  {\"id\": 772122, \"suggestedTranslation\": \"Một thùng chứa 4 ô sẽ nhận nguyên liệu làm thức ăn.\\n\\nĐặt 4 vật phẩm vào thùng sẽ cho phép nấu chúng tạo ra một loại thức ăn nào đó tùy thuộc vào các vật phẩm được cho vào ban đầu.\", \"rating\": 9.0},\n  {\"id\": 772123, \"suggestedTranslation\": \"Dường như cần một số phép thuật đặc biệt để loại bỏ những thứ kỳ quặc này.\", \"rating\": 9.0},\n  {\"id\": 772124, \"suggestedTranslation\": \"Đánh văng vật phẩm ra khỏi kho đồ của mục tiêu.\", \"rating\": 9.0},\n  {\"id\": 772125, \"suggestedTranslation\": \"Có thể đào mỏ để lộ phần lõi tối hơn làm từ vật liệu cứng hơn.\", \"rating\": 9.0},\n  {\"id\": 772126, \"suggestedTranslation\": \"Chơi một ván bài, tùy bạn thích. Đánh vào nó để xào bài, nhưng hãy cẩn thận!\", \"rating\": 9.0},\n  {\"id\": 772127, \"suggestedTranslation\": \"Làm cho môi trường xung quanh mát mẻ, nếu cầm Mắt Deerclops.\\n\\nCháy rừng sẽ không xảy ra gần đó, đồng thời ngăn chặn thực vật héo úa. Nó ảnh hưởng đến tốc độ khô ráo của mọi thứ, bao gồm độ ẩm của đất, và tốc độ chúng hỏng.\\n\\nTạo ra các Sông Băng Nhỏ xung quanh theo thời gian.\", \"rating\": 9.5},\n  {\"id\": 772128, \"suggestedTranslation\": \"Làm lóa mắt Hang Nhện để làm dịu nhện gần đó. Hang bị làm lóa mắt không lớn lên.\", \"rating\": 9.5},\n  {\"id\": 772129, \"suggestedTranslation\": \"Cải thiện tầm nhìn trong bão.\", \"rating\": 9.0},\n  {\"id\": 772130, \"suggestedTranslation\": \"Một thùng chứa chống cháy với 12 ô.\", \"rating\": 9.0},\n  {\"id\": 772131, \"suggestedTranslation\": \"Cung cấp một lượng ánh sáng nhỏ và lượng nhiệt lớn giống như lửa trại. Nó cũng có thể được dùng để phá hủy vật phẩm.\", \"rating\": 9.5},\n  {\"id\": 772132, \"suggestedTranslation\": \"Chiếc mũ giáp này từ từ tự sửa chữa.\", \"rating\": 9.0},\n  {\"id\": 772133, \"suggestedTranslation\": \"Khi được trang bị, Wolfgang có thể Nâng tạ để tăng Sức Mạnh.\", \"rating\": 9.0},\n  {\"id\": 772134, \"suggestedTranslation\": \"Khi được trang bị, Wolfgang có thể Nâng tạ để tăng Sức Mạnh.\\n\\nKhi ném, nó làm tăng độ lạnh của các sinh vật gần nơi nó rơi xuống.\", \"rating\": 9.0},\n  {\"id\": 772135, \"suggestedTranslation\": \"Khi được trang bị, Wolfgang có thể Nâng tạ để tăng Sức Mạnh.\\n\\nNhận nhiệt khi ở gần thứ nóng, và làm mát khi ở gần thứ lạnh.\\n\\nNó sẽ sưởi ấm hoặc làm mát người cầm tùy theo nhiệt độ của nó.\", \"rating\": 9.0},\n  {\"id\": 772136, \"suggestedTranslation\": \"Khi được trang bị, Wolfgang có thể Nâng tạ để tăng Sức Mạnh.\\n\\nKhi ném, nó tạo ra lửa tại nơi nó rơi xuống.\", \"rating\": 9.5},\n  {\"id\": 772137, \"suggestedTranslation\": \"Đó không phải là thức ăn phù hợp cho con người.\", \"rating\": 9.0},\n  {\"id\": 772138, \"suggestedTranslation\": \"Nếu nó bám đầy Thulecite thì có thể dùng cuốc để đập ra.\", \"rating\": 9.0},\n  {\"id\": 772139, \"suggestedTranslation\": \"Một thùng chứa có thể mang theo với 9 ô có thể chứa các Đồ Uống Kỳ Diệu.\", \"rating\": 9.0},\n  {\"id\": 772140, \"suggestedTranslation\": \"Hoạt động giống như lửa trại trong suốt thời gian tồn tại, tạo ra ánh sáng và sức nóng và sẽ làm bốc cháy mọi thứ gần đó. Nó cũng có thể được dùng để nấu ăn.\", \"rating\": 9.5},\n  {\"id\": 772141, \"suggestedTranslation\": \"Triệu hồi Chester khi được nhặt lên. Chester sẽ đi theo người giữ. Khi Chester còn sống, con mắt sẽ mở.\", \"rating\": 9.0},\n  {\"id\": 772142, \"suggestedTranslation\": \"Cho con mắt đang đói này ăn để hồi phục nó.\", \"rating\": 9.0},\n  {\"id\": 772143, \"suggestedTranslation\": \"Một tháp bắn đòn tầm xa vào các sinh vật thù địch và hồi 12 Máu mỗi giây.\", \"rating\": 9.5},\n  {\"id\": 772144, \"suggestedTranslation\": \"Đào một ô đất thành đất nông trại có thể cuốc để gieo hạt thành thực vật.\", \"rating\": 9.5},\n  {\"id\": 772145, \"suggestedTranslation\": \"Mỗi lần sử dụng sẽ dập tắt lửa, làm khô và làm mát những người sống sót 50 độ xuống thấp tới 2.5 độ trong một khu vực.\", \"rating\": 9.0},\n  {\"id\": 772146, \"suggestedTranslation\": \"Gần như nhân đôi số lượng chim sẽ đáp xuống gần người mặc.\", \"rating\": 9.0},\n  {\"id\": 772147, \"suggestedTranslation\": \"Vẽ vật phẩm gần nhất lên Bảng Mini.\", \"rating\": 9.5},\n  {\"id\": 772148, \"suggestedTranslation\": \"Xoay các công trình có thể xoay như hàng rào, bảng hiệu và ghế.\", \"rating\": 9.0},\n  {\"id\": 772149, \"suggestedTranslation\": \"\\\"Trải Nghiệm Học Tập Điện Galvanic Cảm Ứng Xuyên Da\\\" Sử dụng công nghệ điện từ trường để phóng điện vào các thực thể dẫn điện.\\n\\nSau khi bật, nút T.I.N.G.L.E. sẽ tìm một nút lân cận khác để liên kết, thiết lập một điện trường giữa hai bên.\\n\\nKhông gây tổn hại thể xác (tổn hại tinh thần thì còn bàn cãi). Hầu hết các đối tượng sẽ bỏ chạy sau cú sốc ngắn.\\n\\nNgười thử nghiệm nên sử dụng đồ bảo hộ cách điện để tránh trải nghiệm học tập đặc biệt này!\", \"rating\": 9.5},\n  {\"id\": 772150, \"suggestedTranslation\": \"\\\"Trải Nghiệm Học Tập Điện Galvanic Cảm Ứng Xuyên Da\\\" Sử dụng công nghệ điện từ trường để phóng điện vào các thực thể dẫn điện.\\n\\nSau khi bật, nút T.I.N.G.L.E. sẽ tìm một nút lân cận khác để liên kết, thiết lập một điện trường giữa hai bên.\\n\\nKhông gây tổn hại thể xác (tổn hại tinh thần thì còn bàn cãi). Hầu hết các đối tượng sẽ bỏ chạy sau cú sốc ngắn.\\n\\nNgười thử nghiệm nên sử dụng đồ bảo hộ cách điện để tránh trải nghiệm học tập đặc biệt này!\", \"rating\": 9.5},\n  {\"id\": 772151, \"suggestedTranslation\": \"Khi có nhiên liệu, nó tạo ra ánh sáng và sức nóng.\\n\\nNó cũng có thể nấu chín thức ăn.\\n\\nKhông bị mất đi khi tiêu thụ hết nhiên liệu.\", \"rating\": 9.0},\n  {\"id\": 772152, \"suggestedTranslation\": \"Có thể bật và tắt. Khi có nhiên liệu và bật, nếu lửa xuất hiện trong phạm vi, nó sẽ ném quả cầu tuyết vào đó để dập tắt.\", \"rating\": 9.5},\n  {\"id\": 772153, \"suggestedTranslation\": \"Khi đặt trên thuyền hoặc bến tàu, đây là thùng chứa 20 ô giữ sinh vật biển. Cá trong thùng sẽ chậm hỏng hơn.\", \"rating\": 9.5},\n  {\"id\": 772154, \"suggestedTranslation\": \"Câu cá trong ao.\", \"rating\": 9.5},\n  {\"id\": 772155, \"suggestedTranslation\": \"Được dùng với Cần Câu Biển.\", \"rating\": 9.5},\n  {\"id\": 772156, \"suggestedTranslation\": \"Bộ xương hóa thạch của một con quái vật kỳ lạ.\\n\\nKhảo cổ học rất khó và việc lắp ráp lại những bộ xương cũ cũng vậy. Không phải tất cả sản phẩm hoàn thành đều được lắp ráp chính xác.\", \"rating\": 9.5},\n  {\"id\": 772157, \"suggestedTranslation\": \"Nhận nhiệt khi ở gần thứ nóng, và làm mát khi ở gần thứ lạnh.\\n\\nNó sẽ sưởi ấm người cầm tùy theo nhiệt độ của nó.\\n\\nKhi nóng, nó chặt hiệu quả hơn một chút, và gây thêm sát thương lên các mục tiêu đang rét.\\n\\nĐộ bền bị tiêu hao khi vỡ do làm nguội hoàn toàn, nó có thể được sửa chữa trở lại trạng thái hoạt động bằng cách làm nóng lại.\", \"rating\": 9.5},\n  {\"id\": 772158, \"suggestedTranslation\": \"Nhận nhiệt khi ở gần thứ nóng, và làm mát khi ở gần thứ lạnh.\\n\\nNó sẽ sưởi ấm người cầm tùy theo nhiệt độ của nó.\\n\\nKhi nóng, nó đập hiệu quả hơn một chút, và gây thêm sát thương lên các mục tiêu đang rét.\\n\\nĐộ bền bị tiêu hao khi vỡ do làm nguội hoàn toàn, nó có thể được sửa chữa trở lại trạng thái hoạt động bằng cách làm nóng lại.\", \"rating\": 9.5},\n  {\"id\": 772159, \"suggestedTranslation\": \"Nhận nhiệt khi ở gần thứ nóng, và làm mát khi ở gần thứ lạnh.\\n\\nNó sẽ sưởi ấm người cầm tùy theo nhiệt độ của nó.\\n\\nKhi nóng, nó đào mỏ hiệu quả hơn một chút, và gây thêm sát thương lên các mục tiêu đang rét.\\n\\nĐộ bền bị tiêu hao khi vỡ do làm nguội hoàn toàn, nó có thể được sửa chữa trở lại trạng thái hoạt động bằng cách làm nóng lại.\", \"rating\": 9.5},\n  {\"id\": 772160, \"suggestedTranslation\": \"Nhận nhiệt khi ở gần thứ nóng, và làm mát khi ở gần thứ lạnh.\\n\\nNó sẽ sưởi ấm người cầm tùy theo nhiệt độ của nó.\\n\\nKhi nóng, nó gây thêm sát thương lên các mục tiêu đang rét.\\n\\nĐộ bền bị tiêu hao khi vỡ do làm nguội hoàn toàn, nó có thể được sửa chữa trở lại trạng thái hoạt động bằng cách làm nóng lại.\", \"rating\": 9.5},\n  {\"id\": 772161, \"suggestedTranslation\": \"Nhận nhiệt khi ở gần thứ nóng, và làm mát khi ở gần thứ lạnh.\\n\\nNó sẽ sưởi ấm người cầm tùy theo nhiệt độ của nó.\\n\\nKhi nóng, nó gây thêm sát thương lên các mục tiêu đang rét.\\n\\nĐộ bền bị tiêu hao khi vỡ do làm nguội hoàn toàn, nó có thể được sửa chữa trở lại trạng thái hoạt động bằng cách làm nóng lại.\", \"rating\": 9.5},\n  {\"id\": 772162, \"suggestedTranslation\": \"Ngủ trong đó hồi 1 Tinh Thần và 1 máu mỗi giây, tốn 1 Độ Đói mỗi giây. Nó cũng sưởi ấm người dùng theo thời gian.\", \"rating\": 9.5},\n  {\"id\": 772163, \"suggestedTranslation\": \"Dịch Nhầy hoàn toàn ngăn chặn việc thực phẩm đặt trong đó bị hỏng.\", \"rating\": 9.5},\n  {\"id\": 772164, \"suggestedTranslation\": \"Wendy dùng để chế tạo Đồ Uống Kỳ Diệu Ma Quái.\", \"rating\": 9.0},\n  {\"id\": 772165, \"suggestedTranslation\": \"Khi trang bị, cho phép Wendy tự uống Đồ Uống Kỳ Diệu.\", \"rating\": 9.0},\n  {\"id\": 772166, \"suggestedTranslation\": \"Abigail sẽ gây sát thương ban đêm vào ban ngày và lúc chạng vạng. Kéo dài 1 ngày.\\n\\nKhi được uống bởi người không phải ma mặc Vòng Hoa Vong Linh:\\n\\nNgười uống có thể nhìn trong bóng tối như thể họ là ma.\", \"rating\": 9.5},\n  {\"id\": 772167, \"suggestedTranslation\": \"Tăng khả năng hồi máu của Abigail từ 1 lên 20 máu mỗi giây. Kéo dài 30 giây.\\n\\nKhi được uống bởi người không phải ma mặc Vòng Hoa Vong Linh:\\n\\nHồi 5 máu mỗi giây trong 20 giây.\", \"rating\": 9.5},\n  {\"id\": 772168, \"suggestedTranslation\": \"Abigail gây thêm 10 sát thương siêu không gian khi tấn công và tăng lên 100 khi Abigail ở dạng Sinh Vật Vô Định.\", \"rating\": 9.5},\n  {\"id\": 772169, \"suggestedTranslation\": \"Tăng khả năng hồi máu của Abigail từ 1 lên 3 máu mỗi giây. Kéo dài 1 ngày.\\n\\nKhi được uống bởi người không phải ma mặc Vòng Hoa Vong Linh:\\n\\nHồi 1 máu mỗi giây trong 20 giây.\", \"rating\": 9.5},\n  {\"id\": 772170, \"suggestedTranslation\": \"Gấp đôi thời gian khiên của Abigail từ 0.5 giây lên 1 giây.\\n\\nSinh vật tấn công cũng nhận 20 sát thương.\\n\\nKéo dài 1 ngày.\\n\\nKhi được uống bởi người không phải ma mặc Vòng Hoa Vong Linh:\\n\\nCung cấp cho người uống một chiếc khiên hấp thụ nhiều sát thương từ một đòn đánh rồi hồi chiêu trong 10 giây. Nó cũng gây 20 sát thương cho tất cả kẻ địch gần đó.\", \"rating\": 9.5},\n  {\"id\": 772171, \"suggestedTranslation\": \"Đưa cấp độ của Abigail về 3.\\n\\nKhi được uống bởi người không phải ma mặc Vòng Hoa Vong Linh:\\n\\nHồi một chút tinh thần cho người uống, làm đầy một lượng nhỏ độ đói và xóa bỏ hình phạt máu khi hồi sinh.\", \"rating\": 9.5},\n  {\"id\": 772172, \"suggestedTranslation\": \"Tăng cường lời nguyền Abigail giáng lên mục tiêu, để giờ đây chúng nhận thêm 10 Sát Thương Siêu Không Gian khi bị tấn công.\", \"rating\": 9.0},\n  {\"id\": 772173, \"suggestedTranslation\": \"Gấp đôi thời gian khiên của Abigail từ 0.5 giây lên 1 giây. Kéo dài 1 ngày.\\n\\nKhi được uống bởi người không phải ma mặc Vòng Hoa Vong Linh:\\n\\nCung cấp cho người uống một chiếc khiên hấp thụ nhiều sát thương từ một đòn đánh rồi hồi chiêu trong 10 giây.\", \"rating\": 9.5},\n  {\"id\": 772174, \"suggestedTranslation\": \"Abigail được tăng 75% tốc độ trong 1 ngày.\\n\\nKhi được uống bởi người không phải ma mặc Vòng Hoa Vong Linh:\\n\\nCác vật phẩm nặng sẽ không làm người uống chậm đi quá nhiều.\", \"rating\": 9.5},\n  {\"id\": 772175, \"suggestedTranslation\": \"Nơi chúng xuất hiện, Hoa Độc Hại thường mọc ở gần.\", \"rating\": 9.0},\n  {\"id\": 772176, \"suggestedTranslation\": \"Nó được dùng để di chuyển Bia Mộ.\", \"rating\": 9.0},\n  {\"id\": 772177, \"suggestedTranslation\": \"Giảm một nửa chi phí chế tạo vật phẩm và tăng tinh thần khi mặc.\", \"rating\": 9.5},\n  {\"id\": 772178, \"suggestedTranslation\": \"Biến các vật phẩm và công trình đã chế tạo thành nguyên liệu ban đầu dựa trên độ bền còn lại.\\n\\nNguyên liệu ngọc không được hoàn lại.\", \"rating\": 9.0},\n  {\"id\": 772179, \"suggestedTranslation\": \"Nước ngấm từ hố thiên thạch mặt trăng sẽ tạo thành các tinh thể Pha Lê Trăng nếu nước trong và ánh sáng thích hợp.\", \"rating\": 9.5},\n  {\"id\": 772180, \"suggestedTranslation\": \"Sẽ phát nổ gây 200 sát thương khi châm lửa.\", \"rating\": 9.0},\n  {\"id\": 772181, \"suggestedTranslation\": \"Tạo ra các tia sáng đẹp mắt khi cho vào lửa.\", \"rating\": 9.5},\n  {\"id\": 772182, \"suggestedTranslation\": \"Đột biến một số sinh vật và thực vật thành dạng đột biến mặt trăng của chúng.\", \"rating\": 9.0},\n  {\"id\": 772183, \"suggestedTranslation\": \"Có thể treo lên Cây Hoàn Toàn Bình Thường để làm đồ trang trí.\", \"rating\": 9.0},\n  {\"id\": 772184, \"suggestedTranslation\": \"Hồi 20 Máu.\", \"rating\": 9.5},\n  {\"id\": 772185, \"suggestedTranslation\": \"Hồi 20 Máu và giúp người sống sót miễn nhiễm với Mưa Axit trong nửa ngày. Trấn an Snurtles và Slurtles trong suốt thời gian tác dụng.\", \"rating\": 9.5},\n  {\"id\": 772186, \"suggestedTranslation\": \"Cung cấp một chút bảo vệ chống quá nhiệt và miễn nhiễm lửa trong thời gian 4 phút.\", \"rating\": 9.5},\n  {\"id\": 772187, \"suggestedTranslation\": \"Nhận nhiệt khi ở gần thứ nóng, và làm mát khi ở gần thứ lạnh.\\n\\nNó sẽ sưởi ấm hoặc làm mát người cầm tùy theo nhiệt độ của nó.\", \"rating\": 9.0},\n  {\"id\": 772188, \"suggestedTranslation\": \"Loài giáp xác cáu kỉnh này không dễ hòa hợp cho lắm, nhưng với chút thời gian và sự quan tâm, bạn có thể sẽ phát hiện ra bên dưới lớp vỏ cứng đó cô ấy còn nhiều điều thú vị hơn.\", \"rating\": 9.0},\n  {\"id\": 772189, \"suggestedTranslation\": \"Sưởi ấm bản thân với hỗn hợp được pha chế đầy yêu thương từ Ngọc Trai.\", \"rating\": 9.5},\n  {\"id\": 772190, \"suggestedTranslation\": \"Bảo vệ tâm trí bạn khỏi những kẻ thù đáng sợ với hỗn hợp được pha chế đầy yêu thương từ Ngọc Trai.\", \"rating\": 9.5},\n  {\"id\": 772191, \"suggestedTranslation\": \"Xoa dịu tâm trí bạn hơn bất cứ thứ gì, với hỗn hợp được pha chế đặc biệt từ Ngọc Trai.\", \"rating\": 9.5},\n  {\"id\": 772192, \"suggestedTranslation\": \"Xua đuổi bóng tối ban đêm với hỗn hợp được pha chế đầy yêu thương từ Ngọc Trai.\", \"rating\": 9.5},\n  {\"id\": 772193, \"suggestedTranslation\": \"Xoa dịu tâm trí bạn với hỗn hợp được pha chế đầy yêu thương từ Ngọc Trai.\", \"rating\": 9.5},\n  {\"id\": 772194, \"suggestedTranslation\": \"Làm chua tâm trí bạn với hỗn hợp được pha chế từ Ngọc Trai.\", \"rating\": 9.5},\n  {\"id\": 772195, \"suggestedTranslation\": \"Làm mát bản thân với hỗn hợp được pha chế đầy yêu thương từ Ngọc Trai.\", \"rating\": 9.5},\n  {\"id\": 772196, \"suggestedTranslation\": \"Chữa lành vết thương của bạn với hỗn hợp được pha chế đầy yêu thương từ Ngọc Trai.\", \"rating\": 9.5},\n  {\"id\": 772197, \"suggestedTranslation\": \"Treo đèn lấp lánh ánh ngọc trai. Cũng kết nối với Quán Trà và Điện Ngọc Trai!\", \"rating\": 9.5},\n  {\"id\": 772198, \"suggestedTranslation\": \"Giúp Ngọc Trai tìm nhà mới! Tìm được địa điểm hoàn hảo có thể hơi khó, nhưng hãy nhớ - cô ấy rất thích ở gần đại dương.\", \"rating\": 9.5},\n  {\"id\": 772199, \"suggestedTranslation\": \"Quán trà của riêng Ngọc Trai để phục vụ bạn những loại trà hấp dẫn.\", \"rating\": 9.5},\n  {\"id\": 772200, \"suggestedTranslation\": \"Ngôi nhà của một Cua Ẩn Sĩ trông có vẻ cần được sửa sang lại.\", \"rating\": 9.5},\n  {\"id\": 772201, \"suggestedTranslation\": \"Biến những thứ đáng sợ xung quanh bạn trở nên thư giãn.\", \"rating\": 9.0},\n  {\"id\": 772202, \"suggestedTranslation\": \"Sử dụng trên Đất Vườn để tạo các luống đất nơi người sống sót có thể gieo hạt.\", \"rating\": 9.5},\n  {\"id\": 772203, \"suggestedTranslation\": \"Khi đặt xuống, nó cho phép người sống sót viết một thông điệp có thể được đọc bởi chính họ hoặc những người sống sót khác sau đó.\", \"rating\": 9.0},\n  {\"id\": 772204, \"suggestedTranslation\": \"Khiến tối đa 5 con Bò Lai gần đó đi theo người thổi trong ngày.\", \"rating\": 9.5},\n  {\"id\": 772205, \"suggestedTranslation\": \"Hồ nước nóng giống như bồn tắm đối với một số người.\", \"rating\": 9.0},\n  {\"id\": 772206, \"suggestedTranslation\": \"Có thể cất giữ đồ đạc trong Hutch giống như rương.\", \"rating\": 9.5},\n  {\"id\": 772207, \"suggestedTranslation\": \"Triệu hồi Hutch khi được nhặt lên. Hutch sẽ đi theo người giữ. Khi Hutch còn sống, Sao Trời sẽ còn sống.\", \"rating\": 9.5},\n  {\"id\": 772208, \"suggestedTranslation\": \"Một thùng chứa có 9 ô có thể chứa thực phẩm.\\n\\nCác vật phẩm bên trong sẽ hết hạn chậm hơn một nửa.\", \"rating\": 9.0},\n  {\"id\": 772209, \"suggestedTranslation\": \"Độ ẩm của người mặc sẽ tăng nhanh lên đến 50%. Làm giảm 10% tốc độ của người mặc.\", \"rating\": 9.0},\n  {\"id\": 772210, \"suggestedTranslation\": \"Một thùng chứa 8 ô làm giảm một nửa tốc độ hỏng của thực phẩm bên trong.\", \"rating\": 9.0},\n  {\"id\": 772211, \"suggestedTranslation\": \"Một sinh vật nhí nhố đáng ghét chỉ muốn được bạn ôm ấp. Hãy giẫm nát nó thật nhanh, trước khi nó giở trò quỷ quái.\", \"rating\": 9.0}\n]",
            "thoughtSignature": "EmAKXgFpFH0T7sWoleZZcY3YZQqBMiCJz9Y/b/n2LgpBYWbkKVNLgUcfdaIFILVvbLhxjaNYZ/LjR/ckIhp3qPYUnuRkdIIr705xk6/Sl+E/JQCVowKpJ1MamZaDRfUjHdo="
