\": 772848,\n    \"suggestedTranslation\": \"Cho nó \\\"lên thớt\\\" đi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772849,\n    \"suggestedTranslation\": \"Cho chúng nó nhừ đòn đi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772850,\n    \"suggestedTranslation\": \"Dạy cho chúng nó bài học đi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772851,\n    \"suggestedTranslation\": \"Cóng người chưa!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772852,\n    \"suggestedTranslation\": \"Nhai tái mặt nó đi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772853,\n    \"suggestedTranslation\": \"Xử đẹp nó đi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772854,\n    \"suggestedTranslation\": \"Đóng băng bọn nó!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772855,\n    \"suggestedTranslation\": \"Chúng nó không phải bạn bè gì của tụi ta đâu!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772856,\n    \"suggestedTranslation\": \"Đây là lãnh địa của bọn ta!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772857,\n    \"suggestedTranslation\": \"Dân chơi gộc đấy à?\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772858,\n    \"suggestedTranslation\": \"Mày chuẩn bị đi ngủ với cá đi là vừa!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772859,\n    \"suggestedTranslation\": \"Tao không bỏ qua chuyện này đâu!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772860,\n    \"suggestedTranslation\": \"Băng đá để đãi mày đây! Heh heh.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772861,\n    \"suggestedTranslation\": \"Mày không bao giờ bắt được tao đâu, cưng.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772862,\n    \"suggestedTranslation\": \"Mày không có cửa thắng đâu.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772863,\n    \"suggestedTranslation\": \"Đến giờ cắn câu rồi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 772864,\n    \"suggestedTranslation\": \"Mày thật là một tay chơi cừ khôi đấy, bạn hiền.\",\n    \"rating\": 9.0\n  },\n  {\n    \"i