estedTranslation\": \"Những chiếc sừng gợi lên cảm giác của một bộ ria mép được uốn xoăn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 774000,\n    \"suggestedTranslation\": \"Một cơn gió mùa đông lạnh giá đã đóng băng cứng ngắc những chiếc sừng này.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 774001,\n    \"suggestedTranslation\": \"Trang trí sừng bò lai của bạn với viền vàng uy nghi.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 774002,\n    \"suggestedTranslation\": \"Với những chiếc sừng hoa lá này, chú bò lai của bạn sẽ vô cùng nổi bật!\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 774003,\n    \"suggestedTranslation\": \"Sừng có độ bền công nghiệp dành cho chú bò lai chăm chỉ.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 774004,\n    \"suggestedTranslation\": \"Cặp sừng bò lai của bạn lấp lánh trong đêm sẽ lấp đầy trái tim kẻ thù bằng sự kinh hoàng.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 774005,\n    \"suggestedTranslation\": \"Được đánh bóng tỉ mỉ để trắng sáng như bộ sứ xương đẹp nhất của bạn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 774006,\n    \"suggestedTranslation\": \"Điểm trừ duy nhất của những chiếc sừng chiến tranh hùng mạnh này là bạn không thể thổi chúng.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 774007,\n    \"suggestedTranslation\": \"Lớp vỏ kỳ lạ này mang lại cho đuôi bò lai của bạn vẻ ngoài giống thằn lằn hơn.\",\n    \"rating\": 9.5\n  },\n  {\n    \"id\": 774008,\n    \"suggestedTranslation\": \"Chiếc đuôi này được thắt ruy băng hồng đáng yêu.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 774009,\n    \"suggestedTranslation\": \"Một chiếc đuôi tua rua phồng.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 774010,\n    \"suggestedTranslation\": \"Ngay cả những chiếc đuôi cũng trở nên sang trọng hơn với cà vạt.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 774011,\n    \"suggestedTranslation\": \"Một chiếc đuôi mùa đông bông xù.\",\n    \"rating\": 9.5\n  }\n]",
