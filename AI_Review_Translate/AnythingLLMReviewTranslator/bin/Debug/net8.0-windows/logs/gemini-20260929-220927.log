on\": \"Mấy ngón chân kỳ giông hồng hào.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775622,\n    \"suggestedTranslation\": \"Cá mập giờ đã có chân. Thế thì... ổn thôi.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775623,\n    \"suggestedTranslation\": \"Đừng ngại lấm bùn nhé!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775624,\n    \"suggestedTranslation\": \"Một đôi móng guốc nhỏ sắc nhọn để dậm chân phẫn nộ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775625,\n    \"suggestedTranslation\": \"Không gì tuyệt bằng việc chạy chân trần qua sa mạc.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775626,\n    \"suggestedTranslation\": \"Một đôi giày khiêu vũ cho mấy đầu ngón chân nhón nhén của bạn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775627,\n    \"suggestedTranslation\": \"Tấm giáp lưng này được đúc trong ngọn lửa của Lò Rèn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775628,\n    \"suggestedTranslation\": \"Được chế tạo để chống lại cả cái lạnh buốt giá nhất.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775629,\n    \"suggestedTranslation\": \"Được thiết kế để dễ dàng băng qua phong cảnh mặt trăng.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775630,\n    \"suggestedTranslation\": \"Xoay vòng theo phong cách áp đảo.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775631,\n    \"suggestedTranslation\": \"Bạn không thể ngăn cản bước tiến của sự tiến bộ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775632,\n    \"suggestedTranslation\": \"Phần dưới của bộ đồ lặn này chỉ để làm cảnh thôi. Nó không còn chống được nước nữa.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775633,\n    \"suggestedTranslation\": \"Đôi chân mùa đông bằng gỗ cho một cỗ máy tự động lễ hội.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775634,\n    \"suggestedTranslation\": \"Có thứ gì đó rất dễ chịu khi ngắm nhìn ngọn lửa.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775635,\n    \"suggestedTranslation\": \"Ngọn lửa từ chiếc bật lửa này cháy trên mọi 