            "text": "[\n  {\"id\": 774942, \"suggestedTranslation\": \"Lớp sơn này sẽ không bao giờ phai khỏi những chiếc giày này.\", \"rating\": 8.5},\n  {\"id\": 774943, \"suggestedTranslation\": \"Giày đen thì không để lộ vết bồ hóng.\", \"rating\": 8.5},\n  {\"id\": 774944, \"suggestedTranslation\": \"Đừng phán xét một kịch câm cho đến khi bạn đi thử một dặm trong đôi giày hề vụng về của anh ta.\", \"rating\": 8.5},\n  {\"id\": 774945, \"suggestedTranslation\": \"Đến tham gia bữa tiệc ngày lễ với những chiếc chuông rủng rỉnh.\", \"rating\": 8.5},\n  {\"id\": 774946, \"suggestedTranslation\": \"Xăng-đan có phần trên bằng da để ngăn việc vô tình làm đổ dung dịch của nhà luyện kim.\", \"rating\": 8.5},\n  {\"id\": 774947, \"suggestedTranslation\": \"Gót giày màu trắng, mỗi chiếc được trang trí bằng một tinh thể băng sắc nhọn.\", \"rating\": 8.5},\n  {\"id\": 774948, \"suggestedTranslation\": \"Những đôi giày này sẽ đưa việc theo đuổi tri thức của bạn lên những tầm cao mới.\", \"rating\": 8.5},\n  {\"id\": 774949, \"suggestedTranslation\": \"Giày nhún dung nham viền vàng.\", \"rating\": 8.5},\n  {\"id\": 774950, \"suggestedTranslation\": \"Bước đi vừa duyên dáng vừa uy quyền trong đôi bốt gót cao táo bạo này.\", \"rating\": 8.5},\n  {\"id\": 774951, \"suggestedTranslation\": \"Những chiếc ủng gỗ này được đẽo từ thân của một cái cây đã đổ.\", \"rating\": 8.5},\n  {\"id\": 774952, \"suggestedTranslation\": \"Phần gót cao là một trở ngại hữu ích chống lại những câu văn dài lê thê.\", \"rating\": 8.5},\n  {\"id\": 774953, \"suggestedTranslation\": \"Bước qua những vùng nước vô pháp luật với những đôi bốt đã được cố định sẵn.\", \"rating\": 8.5},\n  {\"id\": 774954, \"suggestedTranslation\": \"Giày gót cao hợp mốt dành cho phụ nữ thượng lưu.\", \"rating\": 8.5},\n  {\"id\": 774955, \"suggestedTranslation\": \"Giày cao gót thoải mái để chạy việc vặt theo mùa.\", \"rating\": 8.5},\n  {\"id\": 774956, \"suggestedTranslation\": \"Nối gót theo bước chân của những Người Cổ Đại.\", \"rating\": 8.5},\n  {\"id\": 774957, \"suggestedTranslation\": \"Một cách mộc mạc để tóm lấy.\", \"rating\": 8.5},\n  {\"id\": 774958, \"suggestedTranslation\": \"Quai dày khiến đôi xăng-đan viền lông này trở nên chắc chắn và thoải mái.\", \"rating\": 8.5},\n  {\"id\": 774959, \"suggestedTranslation\": \"Đôi giày mỏng manh của một con búp bê sứ cổ.\", \"rating\": 8.5},\n  {\"id\": 774960, \"suggestedTranslation\": \"Một đôi giày cao gót thời trang được điểm xuyết bởi một chùm lông thỏ.\", \"rating\": 8.5},\n  {\"id\": 774961, \"suggestedTranslation\": \"Những đôi bốt quyến rũ này sẽ lu mờ tất cả những đôi khác.\", \"rating\": 8.5},\n  {\"id\": 774962, \"suggestedTranslation\": \"Với những đôi giày này, bạn sẽ đốt cháy sàn nhảy.\", \"rating\": 8.5},\n  {\"id\": 774963, \"suggestedTranslation\": \"Nhanh chân lên nào, vụ thu hoạch không tự tụ họp lại đâu!\", \"rating\": 8.5},\n  {\"id\": 774964, \"suggestedTranslation\": \"Đôi giày mềm và êm đến mức không ai nghe thấy bạn đang lén cuỗm thuốc súng đi đâu.\", \"rating\": 8.5},\n  {\"id\": 774965, \"suggestedTranslation\": \"Một đôi bốt đơn giản, đáng tin cậy không rườm rà... có lẽ hơi rườm rà một chút.\", \"rating\": 8.5},\n  {\"id\": 774966, \"suggestedTranslation\": \"Cái lạnh của đường đá cuội luồn thẳng qua chúng.\", \"rating\": 8.5},\n  {\"id\": 774967, \"suggestedTranslation\": \"Đủ chắc chắn và ấm áp để chống lại cái lạnh của mùa đông.\", \"rating\": 8.5},\n  {\"id\": 774968, \"suggestedTranslation\": \"Giày được mang bởi những ai rất tự hào về vẻ ngoài của mình.\", \"rating\": 8.5},\n  {\"id\": 774969, \"suggestedTranslation\": \"Bạn sinh ra để chiến đấu. Bạn cảm nhận được điều đó ở ngay phần đế giày.\", \"rating\": 8.5},\n  {\"id\": 774970, \"suggestedTranslation\": \"Giày mũi nhọn dành cho một anh chàng lạnh lùng.\", \"rating\": 8.5},\n  {\"id\": 774971, \"suggestedTranslation\": \"Các khóa bằng kim loại là vật dẫn điện cực kỳ tốt. Điều này đã được phát hiện ra theo cách đau đớn nhất.\", \"rating\": 8.5},\n  {\"id\": 774972, \"suggestedTranslation\": \"Dành cho những bước chân lang thang và một tâm trí bồn chồn.\", \"rating\": 8.5},\n  {\"id\": 774973, \"suggestedTranslation\": \"Những đôi giày đã giẫm lên biết bao dung dịch bị đổ.\", \"rating\": 8.5},\n  {\"id\": 774974, \"suggestedTranslation\": \"Giày dép phù hợp cho những bước chân lễ hội.\", \"rating\": 8.5},\n  {\"id\": 774975, \"suggestedTranslation\": \"Được làm cho những đôi chân nhún nhảy theo nhịp điệu!\", \"rating\": 8.5},\n  {\"id\": 774976, \"suggestedTranslation\": \"Ủng bảo hộ chắc chắn do Công ty Phát thanh Voxola cung cấp.\", \"rating\": 8.5},\n  {\"id\": 774977, \"suggestedTranslation\": \"Mấy con ốc vít thực ra chẳng có tác dụng gì cả.\", \"rating\": 8.5},\n  {\"id\": 774978, \"suggestedTranslation\": \"Không gì đánh bại được một đôi bốt mũi đồng.\", \"rating\": 8.5},\n  {\"id\": 774979, \"suggestedTranslation\": \"Có lẽ hãy lau sạch những đôi bốt này trước khi bước lên sàn nhà sạch sẽ.\", \"rating\": 8.5},\n  {\"id\": 774980, \"suggestedTranslation\": \"Ngay cả những kẻ cuồng chiến cũng thích có đôi chân ấm áp.\", \"rating\": 8.5},\n  {\"id\": 774981, \"suggestedTranslation\": \"Một đôi bốt mùa đông truyền thống đẹp đẽ.\", \"rating\": 8.5},\n  {\"id\": 774982, \"suggestedTranslation\": \"Những đôi giày leo núi kỳ quặc này sẽ mang lại sức sống cho bước chân của bất kỳ ai!\", \"rating\": 8.5},\n  {\"id\": 774983, \"suggestedTranslation\": \"Khóa thắt lưng kiểu lãng tử cũng giống như khóa bình thường, nhưng mang phong cách bất kham hơn.\", \"rating\": 8.5},\n  {\"id\": 774984, \"suggestedTranslation\": \"Đánh bay cái lạnh của Đại Tiệc Mùa Đông đó đi.\", \"rating\": 8.5},\n  {\"id\": 774985, \"suggestedTranslation\": \"Một đôi bốt hợp lý để giữ thăng bằng cho bạn trên võ đài.\", \"rating\": 8.5},\n  {\"id\": 774986, \"suggestedTranslation\": \"Chúng hoàn toàn tự nhiên!\", \"rating\": 8.5},\n  {\"id\": 774987, \"suggestedTranslation\": \"Woodie nhớ cảm giác có một đôi giày trượt tốt.\", \"rating\": 8.5},\n  {\"id\": 774988, \"suggestedTranslation\": \"Giày dép đáng tin cậy để chinh phục các sườn dốc băng giá.\", \"rating\": 8.5},\n  {\"id\": 774989, \"suggestedTranslation\": \"Chúng thoảng mùi táo.\", \"rating\": 8.5},\n  {\"id\": 774990, \"suggestedTranslation\": \"Đôi bốt màu 'đen phi chiếu sáng' này sẽ bảo vệ bạn khỏi bị sứt ngón chân, chứ chẳng làm gì nhiều hơn thế.\", \"rating\": 8.5},\n  {\"id\": 774991, \"suggestedTranslation\": \"Đôi bốt màu 'nâu sô-cô-la thiếu thốn' này sẽ bảo vệ bạn khỏi bị sứt ngón chân, chứ chẳng làm gì nhiều hơn thế.\", \"rating\": 8.5},\n  {\"id\": 774992, \"suggestedTranslation\": \"Đôi bốt màu 'nâu xu gỗ' này sẽ bảo vệ bạn khỏi bị sứt ngón chân, chứ chẳng làm gì nhiều hơn thế.\", \"rating\": 8.5},\n  {\"id\": 774993, \"suggestedTranslation\": \"Đôi bốt màu 'vàng đất giày bùn' này sẽ bảo vệ bạn khỏi bị sứt ngón chân, chứ chẳng làm gì nhiều hơn thế.\", \"rating\": 8.5},\n  {\"id\": 774994, \"suggestedTranslation\": \"Cứ bước đi tùy thích trên vùng đất linh thiêng.\", \"rating\": 8.5},\n  {\"id\": 774995, \"suggestedTranslation\": \"Những đôi bốt này sinh ra là để nghiền nát, và đó chính là những gì chúng sẽ làm.\", \"rating\": 8.5},\n  {\"id\": 774996, \"suggestedTranslation\": \"Những bàn chân dậm đạp này nghiền nát băng đá (và những kẻ bất đồng chính kiến) một cách dễ dàng.\", \"rating\": 8.5},\n  {\"id\": 774997, \"suggestedTranslation\": \"Được hiệu chuẩn để dậm mạnh, ngay cả trong điều kiện trọng lực thấp.\", \"rating\": 8.5},\n  {\"id\": 774998, \"suggestedTranslation\": \"Dành cho việc nhảy nhót trên vũng dung nham sắt.\", \"rating\": 8.5},\n  {\"id\": 774999, \"suggestedTranslation\": \"Được rèn từ vàng để dẫm đạp lên các sinh vật hữu cơ với phong cách lấp lánh.\", \"rating\": 8.5},\n  {\"id\": 775000, \"suggestedTranslation\": \"Từ chối ma thuật công nghệ cao và trở về với cội nguồn công nghệ của bạn.\", \"rating\": 8.5},\n  {\"id\": 775001, \"suggestedTranslation\": \"Chúng sẽ đưa bạn đi đâu tiếp theo?\", \"rating\": 8.5},\n  {\"id\": 775002, \"suggestedTranslation\": \"Các thiết bị nền tảng cổ xưa.\", \"rating\": 8.5},\n  {\"id\": 775003, \"suggestedTranslation\": \"Tung ra những cú đá bay chính xác vào đầu đối thủ của bạn.\", \"rating\": 8.5},\n  {\"id\": 775004, \"suggestedTranslation\": \"Cho đôi chân bằng kim loại đau nhức của bạn nghỉ ngơi vào mùa đông này và đổi sang đi guốc gỗ xem sao.\", \"rating\": 8.5},\n  {\"id\": 775005, \"suggestedTranslation\": \"Một thiết kế vượt thời gian, được chế tạo để trường tồn.\", \"rating\": 8.5},\n  {\"id\": 775006, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775007, \"suggestedTranslation\": \"Hàng rào này làm bằng ống kim loại mang phong cách \\\"công nghiệp\\\" sang trọng.\", \"rating\": 8.5},\n  {\"id\": 775008, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775009, \"suggestedTranslation\": \"Một hàng rào kỳ lạ điểm xuyết những bông hoa.\", \"rating\": 8.5},\n  {\"id\": 775010, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775011, \"suggestedTranslation\": \"Cổng cổ xưa này là lối đi từ bên này sang bên kia của hàng rào.\", \"rating\": 8.5},\n  {\"id\": 775012, \"suggestedTranslation\": \"Bánh gừng là một vật liệu xây dựng đáng ngạc nhiên.\", \"rating\": 8.5},\n  {\"id\": 775013, \"suggestedTranslation\": \"Cho người khác vào nhà là một việc bị đánh giá quá cao.\", \"rating\": 8.5},\n  {\"id\": 775014, \"suggestedTranslation\": \"Lớp sơn gỗ tự nhiên mang lại cảm giác ấm cúng, đậm chất đồng quê.\", \"rating\": 8.5},\n  {\"id\": 775015, \"suggestedTranslation\": \"Lớp sơn gỗ tự nhiên mang lại cảm giác ấm cúng, đậm chất đồng quê.\", \"rating\": 8.5},\n  {\"id\": 775016, \"suggestedTranslation\": \"Nó gần với thiên đường nhất có thể.\", \"rating\": 8.5},\n  {\"id\": 775017, \"suggestedTranslation\": \"Trông rất đẹp và những chiếc gai sẽ ngăn chặn bọn tiểu yêu.\", \"rating\": 8.5},\n  {\"id\": 775018, \"suggestedTranslation\": \"Không ai được qua đây.\", \"rating\": 8.5},\n  {\"id\": 775019, \"suggestedTranslation\": \"Dành cho những ai thích sự an toàn hơn là một lời chào nồng nhiệt.\", \"rating\": 8.5},\n  {\"id\": 775020, \"suggestedTranslation\": \"Dành cho những ai thích sự an toàn hơn là một lời chào nồng nhiệt.\", \"rating\": 8.5},\n  {\"id\": 775021, \"suggestedTranslation\": \"Dành cho những ai thích sự an toàn hơn là một lời chào nồng nhiệt.\", \"rating\": 8.5},\n  {\"id\": 775022, \"suggestedTranslation\": \"Trông ngon đến mức muốn ăn ngay!\", \"rating\": 8.5},\n  {\"id\": 775023, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775024, \"suggestedTranslation\": \"Một cách trang trí để nói \\\"miễn vào\\\".\", \"rating\": 8.5},\n  {\"id\": 775025, \"suggestedTranslation\": \"Một cách trang trí để nói \\\"miễn vào\\\".\", \"rating\": 8.5},\n  {\"id\": 775026, \"suggestedTranslation\": \"Sao không đóng cọc và định cư ở đây nhỉ?\", \"rating\": 8.5},\n  {\"id\": 775027, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775028, \"suggestedTranslation\": \"Sao không đóng cọc và định cư ở đây nhỉ?\", \"rating\": 8.5},\n  {\"id\": 775029, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775030, \"suggestedTranslation\": \"Sao không đóng cọc và định cư ở đây nhỉ?\", \"rating\": 8.5},\n  {\"id\": 775031, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775032, \"suggestedTranslation\": \"Gai hoa hồng chính là kẽm gai của tự nhiên.\", \"rating\": 8.5},\n  {\"id\": 775033, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775034, \"suggestedTranslation\": \"Những lớp vỏ sò làm cho nó trở nên vô cùng sang chảnh.\", \"rating\": 8.5},\n  {\"id\": 775035, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775036, \"suggestedTranslation\": \"Đúng là thứ để ngăn chặn bọn nhóc tì phiền phức khỏi trang viên của bạn.\", \"rating\": 8.5},\n  {\"id\": 775037, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775038, \"suggestedTranslation\": \"Đúng là thứ để ngăn chặn bọn nhóc tì phiền phức khỏi trang viên của bạn.\", \"rating\": 8.5},\n  {\"id\": 775039, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775040, \"suggestedTranslation\": \"Đúng là thứ để ngăn chặn bọn nhóc tì phiền phức khỏi trang viên của bạn.\", \"rating\": 8.5},\n  {\"id\": 775041, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775042, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775043, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775044, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775045, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775046, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775047, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775048, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775049, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775050, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775051, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775052, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775053, \"suggestedTranslation\": \"Lò lửa này được làm bằng đá giống như răng nanh. Nó sẽ nói gì nếu biết nói nhỉ?\", \"rating\": 8.5},\n  {\"id\": 775054, \"suggestedTranslation\": \"Lò lửa này được làm bằng đá giống như răng nanh. Nó sẽ nói gì nếu biết nói nhỉ?\", \"rating\": 8.5},\n  {\"id\": 775055, \"suggestedTranslation\": \"Lò lửa này được trang trí bởi vài chiếc cánh đá đáng yêu.\", \"rating\": 8.5},\n  {\"id\": 775056, \"suggestedTranslation\": \"Hố không đáy là tuyệt nhất. Nhưng hố không đáy đầy lửa còn tuyệt hơn thế nữa.\", \"rating\": 8.5},\n  {\"id\": 775057, \"suggestedTranslation\": \"Hố không đáy là tuyệt nhất. Nhưng hố không đáy đầy lửa còn tuyệt hơn thế nữa.\", \"rating\": 8.5},\n  {\"id\": 775058, \"suggestedTranslation\": \"Một cái lò nung bằng đá xinh xắn để chứa những ngọn lửa ấm cúng nhất của bạn.\", \"rating\": 8.5},\n  {\"id\": 775059, \"suggestedTranslation\": \"Một cái lò nung bằng đá xinh xắn để chứa những ngọn lửa ấm cúng nhất của bạn.\", \"rating\": 8.5},\n  {\"id\": 775060, \"suggestedTranslation\": \"Có người thích ấm áp, có người thích nóng bỏng hơn.\", \"rating\": 8.5},\n  {\"id\": 775061, \"suggestedTranslation\": \"Một lò lửa được mô phỏng theo một tượng đài khổng lồ cổ đại. May mắn thay, phiên bản này có kích thước phù hợp hơn với con người (và các thực thể kích thước tương đương con người).\", \"rating\": 8.5},\n  {\"id\": 775062, \"suggestedTranslation\": \"Trái tim của mọi hộ gia đình.\", \"rating\": 8.5},\n  {\"id\": 775063, \"suggestedTranslation\": \"trượng lửa ong\", \"rating\": 8.5},\n  {\"id\": 775064, \"suggestedTranslation\": \"Lấy độc trị độc, lấy lửa dập lửa.\", \"rating\": 8.5},\n  {\"id\": 775065, \"suggestedTranslation\": \"trượng lửa gungnir\", \"rating\": 8.5},\n  {\"id\": 775066, \"suggestedTranslation\": \"Đừng ném bóng vợt vào tôi!\", \"rating\": 8.5},\n  {\"id\": 775067, \"suggestedTranslation\": \"trượng lửa thương\", \"rating\": 8.5},\n  {\"id\": 775068, \"suggestedTranslation\": \"Cây trượng lửa này gợi nhớ một cách kỳ lạ đến Trượng Hỏa Ngục được tìm thấy trong The Forge.\", \"rating\": 8.5},\n  {\"id\": 775069, \"suggestedTranslation\": \"trượng lửa phương bắc\", \"rating\": 8.5},\n  {\"id\": 775070, \"suggestedTranslation\": \"trượng lửa hoa hồng\", \"rating\": 8.5},\n  {\"id\": 775071, \"suggestedTranslation\": \"không có\", \"rating\": 8.5},\n  {\"id\": 775072, \"suggestedTranslation\": \"Hãy chiêm ngưỡng và kinh ngạc trước cỗ máy tung hứng quả cầu tuyết tự động đáng kinh ngạc!\", \"rating\": 8.5},\n  {\"id\": 775073, \"suggestedTranslation\": \"Lửa không bao giờ có cơ hội.\", \"rating\": 8.5},\n  {\"id\": 775074, \"suggestedTranslation\": \"Chỉ dành cho những chú cá cao cấp nhất.\", \"rating\": 8.5},\n  {\"id\": 775075, \"suggestedTranslation\": \"Nơi trú ẩn hoàn hảo cho hàng hóa đáng ngờ.\", \"rating\": 8.5},\n  {\"id\": 775076, \"suggestedTranslation\": \"Ước gì ai đó có thể diễn tả được cần câu này tuyệt vời đến thế nào.\", \"rating\": 8.5},\n  {\"id\": 775077, \"suggestedTranslation\": \"Quăng dây ra khỏi giàn hoa nhưng hãy cẩn thận kẻo bị thắt nút.\", \"rating\": 8.5},\n  {\"id\": 775078, \"suggestedTranslation\": \"Thách đấu với lũ cá một trận.\", \"rating\": 8.5},\n  {\"id\": 775079, \"suggestedTranslation\": \"Mang lễ hội ra vùng nước mở - nổi bồng bềnh một cách thoải mái.\", \"rating\": 8.5},\n  {\"id\": 775080, \"suggestedTranslation\": \"Chiếc mũ lông chim này chạm vào vô cùng sang trọng!\", \"rating\": 8.5},\n  {\"id\": 775081, \"suggestedTranslation\": \"Vòng hoa Mầm Sống đáng yêu này đã mất đi phép thuật, nhưng chúng trông vẫn thật tuyệt diệu.\", \"rating\": 8.5},\n  {\"id\": 775082, \"suggestedTranslation\": \"Một vòng nguyệt quế ô-rê vui tươi để đội trên đầu bạn. Thật mang đậm chất mùa đông làm sao!\", \"rating\": 8.5},\n  {\"id\": 775083, \"suggestedTranslation\": \"Hòa mình vào không khí mùa lễ hội bằng cách quấn quanh đầu bạn những dải ruy băng đáng yêu!\", \"rating\": 8.5},\n  {\"id\": 775084, \"suggestedTranslation\": \"Vòng nguyệt quế nên thuộc về bạn, chứ không phải ngược lại.\", \"rating\": 8.5},\n  {\"id\": 775085, \"suggestedTranslation\": \"Xông pha đầu trận tuyến.\", \"rating\": 8.5},\n  {\"id\": 775086, \"suggestedTranslation\": \"Ai lại không cảm thấy sợ hãi trước chiếc mũ chiến đáng sợ này cơ chứ?\", \"rating\": 8.5},\n  {\"id\": 775087, \"suggestedTranslation\": \"Hãy nhìn cặp sừng cuộn tròn đáng sợ của nó kìa!\", \"rating\": 8.5},\n  {\"id\": 775088, \"suggestedTranslation\": \"Tôi sắp ghi điểm hat-trick rồi đây!\", \"rating\": 8.5},\n  {\"id\": 775089, \"suggestedTranslation\": \"Bảo vệ bản thân khỏi các đòn tấn công vào đầu.\", \"rating\": 8.5},\n  {\"id\": 775090, \"suggestedTranslation\": \"Khuất phục nh