            "text": "[\n  {\n    \"id\": 775242,\n    \"suggestedTranslation\": \"Mặc dù có khả năng kháng hóa chất, những chiếc găng tay này chắc chắn sẽ gây ra phản ứng.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775243,\n    \"suggestedTranslation\": \"Đừng lo, chuyện này không đau chút nào đâu!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775244,\n    \"suggestedTranslation\": \"Những chiếc găng tay này đang nóng lòng muốn cầm nắm một số món tráng miệng lễ hội.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775245,\n    \"suggestedTranslation\": \"Hãy với tới những vì sao khi màn đêm tối nhất!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775246,\n    \"suggestedTranslation\": \"Găng tay làm việc Voxola tiêu chuẩn, để bạn không để lại dấu vân tay trên hàng hóa.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775247,\n    \"suggestedTranslation\": \"Bất kỳ đôi găng tay nào cũng có thể được cải thiện bằng cách mạ đồng thau.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775248,\n    \"suggestedTranslation\": \"Kim cương sẽ không giữ ấm cho bạn đâu.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775249,\n    \"suggestedTranslation\": \"Những chiếc găng tay hàn được hàn hoàn hảo.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775250,\n    \"suggestedTranslation\": \"Những chiếc găng tay làm vườn từng dày dặn này nay đã cũ và rách rưới. Chúng sẽ không còn bảo vệ được nhiều nữa.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775251,\n    \"suggestedTranslation\": \"Một đôi thủy thủ boong tàu chăm chỉ làm việc.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775252,\n    \"suggestedTranslation\": \"Đóa hoa tươi thắm dành cho đôi tay chăm chỉ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775253,\n    \"suggestedTranslation\": \"Găng tay dày dùng để chuyển kim loại đã nung chảy.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775254,\n    \"suggestedTranslation\": \"Đôi găng tay tuyệt vời dành cho một quý cô tuyệt vời.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775255,\n    \"suggestedTranslation\": \"Găng tay dài với vòng hoa bằng lông thú nổi bật.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775256,\n    \"suggestedTranslation\": \"Những nắm đấm dũng mãnh của ngươi không cần áo giáp, chỉ cần trang trí chút đỉnh.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775257,\n    \"suggestedTranslation\": \"Những chiếc găng tay này không giữ được cái lạnh bên ngoài, mặc dù chúng mang lại cảm giác ấm cúng.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775258,\n    \"suggestedTranslation\": \"Truyền sức mạnh của mặt trăng vào đôi tay của ngươi!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775259,\n    \"suggestedTranslation\": \"Đồ trang trí rực lửa cho cổ tay của bạn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775260,\n    \"suggestedTranslation\": \"Ngay cả đôi tay dũng mãnh của một lực sĩ cũng muốn cảm thấy an toàn và được bảo vệ.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775261,\n    \"suggestedTranslation\": \"Móc trái! Móc phải! Đấm thẳng, đấm thẳng!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775262,\n    \"suggestedTranslation\": \"Nếu ngươi dám gây sự với sói, tốt hơn hết là hãy chú ý đến bộ vuốt của nó!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775263,\n    \"suggestedTranslation\": \"Găng tay cụt ngón để tung ra những cú đánh trời giáng.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775264,\n    \"suggestedTranslation\": \"Những chiếc vòng tay dày dặn này là một phụ kiện vượt thời gian.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775265,\n    \"suggestedTranslation\": \"Những chiếc găng tay da này có các lỗ nhỏ được khoét để lộ ra các khớp ngón tay.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775266,\n    \"suggestedTranslation\": \"Chúng là đồ tự làm thủ công đấy!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775267,\n    \"suggestedTranslation\": \"Những chiếc găng tay này được sinh ra để vứt xuống sàn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775268,\n    \"suggestedTranslation\": \"Tốt hơn là ngươi nên giữ ấm đôi tay đó nếu muốn leo lên đỉnh núi với đầy đủ các ngón tay.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775269,\n    \"suggestedTranslation\": \"Những chiếc găng tay này sẽ khiến bạn tung ra một loạt những cú đấm cuồng nộ và lông bay phấp phới.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775270,\n    \"suggestedTranslation\": \"Găng tay có đinh tán giúp cầm nắm chiếc rìu một cách vô địch.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775271,\n    \"suggestedTranslation\": \"Lớp vải mỏng manh gần như che khuất đi đôi bàn tay thô ráp, chai sạn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775272,\n    \"suggestedTranslation\": \"Những chiếc vòng cổ tay này đã được đan một cách tinh tế bởi đôi bàn tay khéo léo.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775273,\n    \"suggestedTranslation\": \"Một bàn tay thợ mộc đóng tàu, và một bàn tay thợ trái tương xứng.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775274,\n    \"suggestedTranslation\": \"Hãy giữ cho đôi tay của bạn rảnh rang để thuộc da thú!\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775275,\n    \"suggestedTranslation\": \"Có những truyền thuyết về một bóng người cô độc lang thang trong khu rừng ngập tràn tuyết, chăm sóc những cái cây bằng đôi bàn tay nặng trĩu, chai sạn.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775276,\n    \"suggestedTranslation\": \"Những chiếc găng tay màu 'nâu sô-cô-la không đủ' trông có vẻ bảo vệ được đấy, nhưng thực ra thì không.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775277,\n    \"suggestedTranslation\": \"Những chiếc găng tay màu 'xám bạc' trông có vẻ bảo vệ được đấy, nhưng thực ra thì không.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775278,\n    \"suggestedTranslation\": \"Những chiếc găng tay màu 'đỏ Higgsbury' trông có vẻ bảo vệ được đấy, nhưng thực ra thì không.\",\n    \"rating\": 9.0\n  },\n  {\n    \"id\": 775279,\n    \"suggestedTranslation\": \"Những chiếc găng tay màu 'nâu