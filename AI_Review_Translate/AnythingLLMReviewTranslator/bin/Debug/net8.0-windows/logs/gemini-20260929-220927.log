edTranslation\": \"Woodie không ngại sử dụng rìu trong nhà bếp đâu.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 777671,\n    \"suggestedTranslation\": \"Woodie bôi mỡ gấu lên tóc mỗi khi đi ra ngoài.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 777672,\n    \"suggestedTranslation\": \"Woodie bôi mỡ gấu lên tóc mỗi khi đi ra ngoài.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 777673,\n    \"suggestedTranslation\": \"Woodie là một kẻ hoang dã trên đấu trường.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 777674,\n    \"suggestedTranslation\": \"Tuyên bố miễn trừ trách nhiệm: Không bảo vệ khỏi các mối nguy hiểm độc hại hay nhân cách độc hại.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 777675,\n    \"suggestedTranslation\": \"Trang phục Đêm Hallows của Woodie đẹp đến mức đáng chết.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 777676,\n    \"suggestedTranslation\": \"Woodie không bao giờ bỏ lỡ cơ hội bước lên băng đá.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 777677,\n    \"suggestedTranslation\": \"Woodie cảm thấy hoàn toàn thoải mái khi được bao quanh bởi những ngọn núi tuyết.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 777678,\n    \"suggestedTranslation\": \"Chỉ là vấn đề thời gian trước khi Woodie thêm người sói vào danh sách.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 777679,\n    \"suggestedTranslation\": \"Sự tự tin trong chiến đấu của Woodie bắt nguồn từ kinh nghiệm.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 777680,\n    \"suggestedTranslation\": \"Một quý ông thanh lịch, hay là sói đội lốt cừu?\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 777681,\n    \"suggestedTranslation\": \"Tất cả những gì Woodie cần là ánh nắng, cơn mưa và những hạt cây yêu thích của mình.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 777682,\n    \"suggestedTranslation\": \"Trang phục thợ đốn gỗ đã được thời gian kiểm chứng.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 777683,\n    \"suggestedTranslation\": \"Mọi chuyện sẽ xuôi chèo mát mái