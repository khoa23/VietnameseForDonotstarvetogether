        "parts": [
          {
            "text": "[\n  {\"id\":788244,\"suggestedTranslation\":\"Xin hãy kiên nhẫn, việc này đòi hỏi sự tập trung cao độ của tôi.\",\"rating\":0.0},\n  {\"id\":788245,\"suggestedTranslation\":\"Nhanh lên, tôi cần Bộ Đệm Lưới của mình!\",\"rating\":0.0},\n  {\"id\":788246,\"suggestedTranslation\":\"Ai đó tìm hộ tôi cái Thiết Bị Phá Vỡ Tiện Ích đi!\",\"rating\":0.0},\n  {\"id\":788247,\"suggestedTranslation\":\"Có ai thấy cái Cây Khắc Vòng Đệm của tôi đâu không?\",\"rating\":0.0},\n  {\"id\":788248,\"suggestedTranslation\":\"Có ai đưa tôi cái Thiết Bị Cọ Rửa Khái Niệm được không?\",\"rating\":0.0},\n  {\"id\":788249,\"suggestedTranslation\":\"Tôi chắc chắn là mình đã đặt Bộ Nhận Diện Hiệu Chỉnh ở đâu đây quanh đây...\",\"rating\":0.0},\n  {\"id\":788250,\"suggestedTranslation\":\"Cái này là... phải, cái này sẽ đưa các thí nghiệm của tôi lên một tầm cao mới!\",\"rating\":0.0},\n  {\"id\":788251,\"suggestedTranslation\":\"Nhanh lên, đưa nó đây nào.\",\"rating\":0.0},\n  {\"id\":788252,\"suggestedTranslation\":\"Tuyệt vời, đúng nó rồi!\",\"rating\":0.0},\n  {\"id\":788253,\"suggestedTranslation\":\"Cuối cùng thì! Giờ thì hoàn thành nốt việc này nào!\",\"rating\":0.0},\n  {\"id\":788254,\"suggestedTranslation\":\"Sự vội vã của bạn rất tốt nhưng tôi đang bận!\",\"rating\":0.0},\n  {\"id\":788255,\"suggestedTranslation\":\"Tôi đang quá bận để lo cho bạn lúc này.\",\"rating\":0.0},\n  {\"id\":788256,\"suggestedTranslation\":\"Bạn sẽ cần chế tạo một Thiết Bị Đóng Gói Linh Thể để bắt một thực thể năng lượng.\",\"rating\":0.0},\n  {\"id\":788257,\"suggestedTranslation\":\"Tuyệt vời! Tôi cần một nguồn năng lượng phù hợp cho phát minh của mình!\",\"rating\":0.0},\n  {\"id\":788258,\"suggestedTranslation\":\"Tốt lắm. Hãy dùng Thiết Bị Đóng Gói Linh Thể để bắt một thực thể cung cấp năng lượng cho phát minh của tôi!\",\"rating\":0.0},\n  {\"id\":788259,\"suggestedTranslation\":\"Cuối cùng thì! Giao thực thể đó ra ngay lập tức!\",\"rating\":0.0},\n  {\"id\":788260,\"suggestedTranslation\":\"Đây chính là thứ tôi đang chờ đợi! Đưa nó cho tôi ngay!\",\"rating\":0.0},\n  {\"id\":788261,\"suggestedTranslation\":\"Được rồi! Dùng cái này và bắt lấy thực thể đó trước khi nó trốn mất!\",\"rating\":0.0},\n  {\"id\":788262,\"suggestedTranslation\":\"Đó chính là thực thể tôi muốn! Dùng cái này để bắt nó. Nhanh lên!\",\"rating\":0.0},\n  {\"id\":788263,\"suggestedTranslation\":\"Nó kìa! Lấy cái này và bắt thực thể đó ngay lập tức!\",\"rating\":0.0},\n  {\"id\":788264,\"suggestedTranslation\":\"Làm tốt lắm! Giờ hãy kéo Bộ chọn Fucroronal để bắt đầu thí nghiệm tối thượng!\",\"rating\":0.0},\n  {\"id\":788265,\"suggestedTranslation\":\"Hãy thổi sự sống vào phát minh của tôi nào! Kích hoạt Bộ chọn Fucroronal! Đúng rồi, đúng rồi - cái thứ hình cây gậy ấy.\",\"rating\":0.0},\n  {\"id\":788266,\"suggestedTranslation\":\"Đúng rồi đấy! Kéo cái Fuc-... cái cần gạt ấy.\",\"rating\":0.0},\n  {\"id\":788267,\"suggestedTranslation\":\"Quá hoàn hảo! Mọi thứ đang diễn ra theo đúng kế hoạch.\",\"rating\":0.0},\n  {\"id\":788268,\"suggestedTranslation\":\"Eureka! Tôi làm được rồi!\",\"rating\":0.0},\n  {\"id\":788269,\"suggestedTranslation\":\"Mấy sinh vật như con cua đó luôn tìm kiếm một ngôi nhà lớn hơn. Hãy cho nó một cái... coi như là vậy đi.\",\"rating\":0.0},\n  {\"id\":788270,\"suggestedTranslation\":\"Có lẽ nếu con cua có một hòn đảo \\\"đáng kể\\\" hơn để chuyển đến, nó sẽ để tôi yên.\",\"rating\":0.0},\n  {\"id\":788271,\"suggestedTranslation\":\"Đưa tôi một tấm bản đồ có một hòn đảo và chúng ta sẽ xem liệu có thể làm cho nó hấp dẫn hơn không.\",\"rating\":0.0},\n  {\"id\":788272,\"suggestedTranslation\":\"Hãy chiêm ngưỡng phát minh lỗi lạc nhất của tôi - W.A.R.B.O.T.!\",\"rating\":0.0},\n  {\"id\":788273,\"suggestedTranslation\":\"Thực thể đã chiếm quyền kiểm soát của W.A.R.B.O.T..\",\"rating\":0.0},\n  {\"id\":788274,\"suggestedTranslation\":\"Có vẻ như tôi đã đánh giá thấp sức mạnh của nó, thật đáng tiếc.\",\"rating\":0.0},\n  {\"id\":788275,\"suggestedTranslation\":\"À thì. Xử lý nó đi, được chứ?\",\"rating\":0.0},\n  {\"id\":788276,\"suggestedTranslation\":\"...Gaaah!\",\"rating\":0.0},\n  {\"id\":788277,\"suggestedTranslation\":\"Chuyện gì đang xảy ra với tôi thế này?\",\"rating\":0.0},\n  {\"id\":788278,\"suggestedTranslation\":\"Không thể nào!\",\"rating\":0.0},\n  {\"id\":788279,\"suggestedTranslation\":\"Tôi không hiêu...\",\"rating\":0.0},\n  {\"id\":788280,\"suggestedTranslation\":\"Rất tốt! Thực thể đang trong trạng thái suy yếu.\",\"rating\":0.0},\n  {\"id\":788281,\"suggestedTranslation\":\"Bây giờ bạn chỉ cần...\",\"rating\":0.0},\n  {\"id\":788282,\"suggestedTranslation\":\"Thật là lãng phí W.A.R.B.O.T. của tôi,\",\"rating\":0.0},\n  {\"id\":788283,\"suggestedTranslation\":\"nhưng thực thể đã chuyển sang một dạng lai mới đầy kỳ diệu.\",\"rating\":0.0},\n  {\"id\":788284,\"suggestedTranslation\":\"Tôi nghi ngờ việc phơi bày không được kiểm soát sẽ làm tăng tốc độ entropy.\",\"rating\":0.0},\n  {\"id\":788285,\"suggestedTranslation\":\"Nó không được lý tưởng cho lắm.\",\"rating\":0.0},\n  {\"id\":788286,\"suggestedTranslation\":\"Khuất phục thực thể ngay lập tức.\",\"rating\":0.0},\n  {\"id\":788287,\"suggestedTranslation\":\"Chúng ta cần mở rộng đấu trường thí nghiệm của tôi.\",\"rating\":0.0},\n  {\"id\":788288,\"suggestedTranslation\":\"Bề mặt của hòn đảo này phải được mở rộng bằng lớp nền đặc biệt của tôi.\",\"rating\":0.0},\n  {\"id\":788289,\"suggestedTranslation\":\"Sử dụng Nền Đất Ngoại Suy của tôi và ngoại suy lớp nền này!\",\"rating\":0.0},\n  {\"id\":788290,\"suggestedTranslation\":\"Lựa chọn tuyệt vời! Còn thứ gì lọt vào mắt xanh của bạn nữa không?\",\"rating\":0.0},\n  {\"id\":788291,\"suggestedTranslation\":\"Giao dịch tốt đấy! Bạn còn cần gì nữa không?\",\"rating\":0.0},\n  {\"id\":788292,\"suggestedTranslation\":\"Buôn bán ngon nghẻ! Tiếp tục phát huy nào!\",\"rating\":0.0},\n  {\"id\":788293,\"suggestedTranslation\":\"Hẹn gặp lại sau nhé.\",\"rating\":0.0},\n  {\"id\":788294,\"suggestedTranslation\":\"Rất vui được hợp tác với bạn.\",\"rating\":0.0},\n  {\"id\":788295,\"suggestedTranslation\":\"Cảm ơn vì phiên giao dịch nhé! Hẹn gặp lại sau.\",\"rating\":0.0},\n  {\"id\":788296,\"suggestedTranslation\":\"Không thể làm hài lòng tất cả mọi người được!\",\"rating\":0.0},\n  {\"id\":788297,\"suggestedTranslation\":\"Có lẽ là lần sau vậy.\",\"rating\":0.0},\n  {\"id\":788298,\"suggestedTranslation\":\"Không có gì làm bạn hứng thú à? Lát nữa quay lại xem tôi có gì nhé.\",\"rating\":0.0},\n  {\"id\":788299,\"suggestedTranslation\":\"Bạn vét sạch hàng của tôi rồi! Cho tôi chút thời gian để nhập thêm hàng đi.\",\"rating\":0.0},\n  {\"id\":788300,\"suggestedTranslation\":\"Tôi chỉ có từng đó thôi! Phải đi kiếm thêm ít hàng hóa nữa đây.\",\"rating\":0.0},\n  {\"id\":788301,\"suggestedTranslation\":\"Chà, thế là hết chuyện! Tôi sẽ đi tìm thêm các mặt hàng để cung cấp đây.\",\"rating\":0.0},\n  {\"id\":788302,\"suggestedTranslation\":\"Cảm ơn vì đã ghé qua đây, nhưng tôi chẳng còn gì cả. Lát nữa quay lại thử xem nhé.\",\"rating\":0.0},\n  {\"id\":788303,\"suggestedTranslation\":\"Này bạn hiền, tôi hết sạch hàng rồi. Lần sau quay lại nhé.\",\"rating\":0.0},\n  {\"id\":788304,\"suggestedTranslation\":\"Rất vui được gặp bạn, nhưng tôi chẳng còn gì để trao đổi cả. Vòng lại sau nhé.\",\"rating\":0.0},\n  {\"id\":788305,\"suggestedTranslation\":\"Bạn tôi ơi, tôi có vô số hàng hóa dành cho bạn đây!\",\"rating\":0.0},\n  {\"id\":788306,\"suggestedTranslation\":\"Bạn hiền, cần gì nào?\",\"rating\":0.0},\n  {\"id\":788307,\"suggestedTranslation\":\"Nào, chúng ta giao dịch thôi!\",\"rating\":0.0},\n  {\"id\":788308,\"suggestedTranslation\":\"W.A.R.B.I.S. ĐÃ CÓ MỤC TIÊU MỚI!\",\"rating\":0.0},\n  {\"id\":788309,\"suggestedTranslation\":\"W.A.R.B.I.S. ĐANG NÂNG CẤP!\",\"rating\":0.0},\n  {\"id\":788310,\"suggestedTranslation\":\"W.A.R.B.I.S. ĐANG TĂNG CƯỜNG!!\",\"rating\":0.0},\n  {\"id\":788311,\"suggestedTranslation\":\"W.A.R.B.I.S. ĐẠT HIỆU SUẤT TỐI ĐA!!!\",\"rating\":0.0},\n  {\"id\":788312,\"suggestedTranslation\":\"W.A.R.B.I.S. ĐANG PHÂN TÍCH...\",\"rating\":0.0},\n  {\"id\":788313,\"suggestedTranslation\":\"W.A.R.B.I.S. ĐÃ MẤT DẤU VẾT.\",\"rating\":0.0},\n  {\"id\":788314,\"suggestedTranslation\":\"W.A.R.B.I.S. ĐÃ ĐỒNG BỘ.\",\"rating\":0.0},\n  {\"id\":788315,\"suggestedTranslation\":\"W.A.R.B.I.S. ĐANG ĐỒNG BỘ...\",\"rating\":0.0},\n  {\"id\":788316,\"suggestedTranslation\":\"Sợ Cứng Người\",\"rating\":0.0},\n  {\"id\":788317,\"suggestedTranslation\":\"\\\"Giấc ngủ ngàn thu.\\\"\",\"rating\":0.0},\n  {\"id\":788318,\"suggestedTranslation\":\"\\\"Thế giới này không giữ chân được tôi.\\\"\",\"rating\":0.0},\n  {\"id\":788319,\"suggestedTranslation\":\"\\\"Dù sao thì tôi cũng chẳng thích ở đây.\\\"\",\"rating\":0.0},\n  {\"id\":788320,\"suggestedTranslation\":\"\\\"Tôi có những nơi tốt hơn để đến.\\\"\",\"rating\":0.0},\n  {\"id\":788321,\"suggestedTranslation\":\"Sũng nước\",\"rating\":0.0},\n  {\"id\":788322,\"suggestedTranslation\":\"Ẩm ướt\",\"rating\":0.0},\n  {\"id\":788323,\"suggestedTranslation\":\"Bão hòa\",\"rating\":0.0},\n  {\"id\":788324,\"suggestedTranslation\":\"Nhão nhoét\",\"rating\":0.0},\n  {\"id\":788325,\"suggestedTranslation\":\"Ngập nước\",\"rating\":0.0},\n  {\"id\":788326,\"suggestedTranslation\":\"Ướt\",\"rating\":0.0},\n  {\"id\":788327,\"suggestedTranslation\":\"Nhão nhoét\",\"rating\":0.0},\n  {\"id\":788328,\"suggestedTranslation\":\"Sập\",\"rating\":0.0},\n  {\"id\":788329,\"suggestedTranslation\":\"Trơn trượt\",\"rating\":0.0},\n  {\"id\":788330,\"suggestedTranslation\":\"Rất\",\"rating\":0.0},\n  {\"id\":788331,\"suggestedTranslation\":\"Ẩm ướt\",\"rating\":0.0},\n  {\"id\":788332,\"suggestedTranslation\":\"Héo úa\",\"rating\":0.0},\n  {\"id\":788333,\"suggestedTranslation\":\"Giao hàng\",\"rating\":0.0},\n  {\"id\":788334,\"suggestedTranslation\":\"Tìm kiếm (bật/tắt)\",\"rating\":0.0},\n  {\"id\":788335,\"suggestedTranslation\":\"Thu hồi (bật/tắt)\",\"rating\":0.0},\n  {\"id\":788336,\"suggestedTranslation\":\"Đánh dấu vị trí\",\"rating\":0.0},\n  {\"id\":788337,\"suggestedTranslation\":\"Lướt bóng tối (bật/tắt)\",\"rating\":0.0},\n  {\"id\":788338,\"suggestedTranslation\":\"Biến hình\",\"rating\":0.0},\n  {\"id\":788339,\"suggestedTranslation\":\"Ở lại (bật/tắt)\",\"rating\":0.0},\n  {\"id\":788340,\"suggestedTranslation\":\"Chạy nước rút (bật/tắt)\",\"rating\":0.0},\n  {\"id\":788341,\"suggestedTranslation\":\"Sừng trợ giúp (bật/tắt)\",\"rating\":0.0},\n  {\"id\":788342,\"suggestedTranslation\":\"Bạn đã nhận phần của mình rồi. Đừng có tham lam đòi gấp đôi.\",\"rating\":0.0},\n  {\"id\":788343,\"suggestedTranslation\":\"Vật phẩm tuyệt vời bạn đang có kìa.\",\"rating\":0.0},\n  {\"id\":788344,\"suggestedTranslation\":\"Để xem bạn có gì nào.\",\"rating\":0.0},\n  {\"id\":788345,\"suggestedTranslation\":\"Mọi thứ đang vượt khỏi tầm kiểm soát rồi, mau thu thập giải thưởng của bạn đi!\",\"rating\":0.0},\n  {\"id\":788346,\"suggestedTranslation\":\"Chúc mừng chú nhóc! Bạn thắng rồi!\",\"rating\":0.0},\n  {\"id\":788347,\"suggestedTranslation\":\"Chúc mừng!\",\"rating\":0.0},\n  {\"id\":788348,\"suggestedTranslation\":\"Cúi đầu chào nào!\",\"rating\":0.0},\n  {\"id\":788349,\"suggestedTranslation\":\"Mọi người đều được mang một thứ gì đó về nhà.\",\"rating\":0.0},\n  {\"id\":788350,\"suggestedTranslation\":\"Được rồi, bắt đầu buổi biểu diễn thôi...\",\"rating\":0.0},\n  {\"id\":788351,\"suggestedTranslation\":\"Rất tuyệt, tôi nghĩ chúng ta xong việc rồi.\",\"rating\":0.0},\n  {\"id\":788352,\"suggestedTranslation\":\"Con này thì dữ tợn quá mức rồi.\",\"rating\":0.0},\n  {\"id\":788353,\"suggestedTranslation\":\"Độ hung dữ của con bò lai này vượt quá gu thẩm mỹ của tôi hôm nay rồi.\",\"rating\":0.0},\n  {\"id\":788354,\"suggestedTranslation\":\"Con bò lai hôm nay cần phải hung dữ hơn chú gấu bông này nhiều.\",\"rating\":0.0},\n  {\"id\":788355,\"suggestedTranslation\":\"Hôm nay tôi đang tìm kiếm thứ gì đó dữ dằn hơn nhiều.\",\"rating\":0.0},\n  {\"id\":788356,\"suggestedTranslation\":\"Con bò lai này dữ hơn một chút so với mức tôi muốn.\",\"rating\":0.0},\n  {\"id\":788357,\"suggestedTranslation\":\"Hơi dữ dằn một chút thì cũng tốt, nhưng không phải hôm nay.\",\"rating\":0.0},\n  {\"id\":788358,\"suggestedTranslation\":\"Có lẽ con bò lai này nên hung dữ hơn một chút.\",\"rating\":0.0},\n  {\"id\":788359,\"suggestedTranslation\":\"Con bò lai này không dữ dằn bằng tôi muốn, nhưng cũng gần được rồi.\",\"rating\":0.0},\n  {\"id\":788360,\"suggestedTranslation\":\"Tôi thích tính hung dữ của con này.\",\"rating\":0.0},\n  {\"id\":788361,\"suggestedTranslation\":\"Con bò lai này mang lại cho tôi đúng lượng cảm giác sợ hãi vừa đủ.\",\"rating\":0.0},\n  {\"id\":788362,\"suggestedTranslation\":\"Cuối cùng thì, tôi đang có tâm trạng muốn sợ hãi một chút. Hãy cho tôi thấy con bò lai đáng sợ nhất của bạn nào!\",\"rating\":0.0},\n  {\"id\":788363,\"suggestedTranslation\":\"Cuối cùng thì, người chiến thắng hôm nay phải là một chú gấu bông. Trái tim tôi không chịu nổi sự sợ hãi đâu.\",\"rating\":0.0},\n  {\"id\":788364,\"suggestedTranslation\":\"Cuối cùng thì, người chiến thắng hôm nay sẽ chỉ dữ dằn hơn sự thân thiện một chút thôi.\",\"rating\":0.0},\n  {\"id\":788365,\"suggestedTranslation\":\"Cuối cùng thì, tôi muốn thấy một con bò lai thân thiện hơn là đáng sợ một chút.\",\"rating\":0.0},\n  {\"id\":788366,\"suggestedTranslation\":\"Cuối cùng thì, tôi không thể quyết định được. Hãy cho tôi thấy sự cân bằng hoàn hảo giữa đáng sợ và thân thiện đi.\",\"rating\":0.0},\n  {\"id\":788367,\"suggestedTranslation\":\"Cuối cùng thì, tôi đang tìm kiếm thứ gì đó khá hung dữ.\",\"rating\":0.0},\n  {\"id\":788368,\"suggestedTranslation\":\"Cuối cùng thì, tôi muốn thứ gì đó trông khá đáng sợ.\",\"rating\":0.0},\n  {\"id\":788369,\"suggestedTranslation\":\"Cuối cùng thì, tôi chỉ tìm kiếm một chút xíu tính hung dữ thôi.\",\"rating\":0.0},\n  {\"id\":788370,\"suggestedTranslation\":\"Cuối cùng thì, hôm nay tôi muốn thấy một chút hung dữ, nhưng chỉ một chút thôi.\",\"rating\":0.0},\n  {\"id\":788371,\"suggestedTranslation\":\"Mẫu vật này dữ dằn hơn mức tôi muốn.\",\"rating\":0.0},\n  {\"id\":788372,\"suggestedTranslation\":\"Tôi tôn trọng sự đáng sợ của con bò lai này, nhưng nó vượt quá mức tôi thích rồi.\",\"rating\":0.0},\n  {\"id\":788373,\"suggestedTranslation\":\"Tôi muốn con bò lai của mình phải đáng sợ hơn thế này khá nhiều.\",\"rating\":0.0},\n  {\"id\":788374,\"suggestedTranslation\":\"Con này chưa đủ dữ dằn, còn kém một đoạn khá xa.\",\"rating\":0.0},\n  {\"id\":788375,\"suggestedTranslation\":\"Con này mang không khí lễ hội quá mức rồi.\",\"rating\":0.0},\n  {\"id\":788376,\"suggestedTranslation\":\"Không khí lễ hội của con bò lai này vượt quá gu thẩm mỹ của tôi hôm nay rồi.\",\"rating\":0.0},\n  {\"id\":788377,\"suggestedTranslation\":\"Con bò lai hôm nay cần phải mang không khí lễ hội hơn gã khó tính này nhiều.\",\"rating\":0.0},\n  {\"id\":788378,\"suggestedTranslation\":\"Hôm nay tôi đang tìm kiếm thứ gì đó mang không khí lễ hội hơn nhiều.\",\"rating\":0.0},\n  {\"id\":788379,\"suggestedTranslation\":\"Con bò lai này mang không khí lễ hội hơn một chút so với mức tôi muốn.\",\"rating\":0.0},\n  {\"id\":788380,\"suggestedTranslation\":\"Mang không khí lễ hội hơi quá một chút thì tốt, nhưng không phải hôm nay.\",\"rating\":0.0},\n  {\"id\":788381,\"suggestedTranslation\":\"Có lẽ con bò lai này nên mang không khí lễ hội hơn một chút.\",\"rating\":0.0},\n  {\"id\":788382,\"suggestedTranslation\":\"Con bò lai này không mang không khí lễ hội như tôi muốn, nhưng cũng gần được rồi.\",\"rating\":0.0},\n  {\"id\":788383,\"suggestedTranslation\":\"Tôi thích không khí lễ hội của con này.\",\"rating\":0.0},\n  {\"id\":788384,\"suggestedTranslation\":\"Con bò lai này mang không khí lễ hội vừa đủ.\",\"rating\":0.0},\n  {\"id\":788385,\"suggestedTranslation\":\"Ngoài ra, người chiến thắng nên là loài quái vật mang không khí lễ hội nhất.\",\"rating\":0.0},\n  {\"id\":788386,\"suggestedTranslation\":\"Ngoài ra, tôi không muốn nhìn thấy chút không khí lễ hội nào ở nhà vô địch hôm nay cả.\",\"rating\":0.0},\n  {\"id\":788387,\"suggestedTranslation\":\"Ngoài ra, hôm nay tôi không có tâm trạng vui chơi lễ hội gì cả. Tốt nhất là đừng để tôi thấy dù chỉ một chút!\",\"rating\":0.0},\n  {\"id\":788388,\"suggestedTranslation\":\"Ngoài ra, nên có rất nhiều không khí lễ hội, kèm theo một chút nét u buồn.\",\"rating\":0.0},\n  {\"id\":788389,\"suggestedTranslation\":\"Ngoài ra, người chiến thắng hôm nay sẽ mang nét u buồn nhiều hơn là không khí lễ hội.\",\"rating\":0.0},\n  {\"id\":788390,\"suggestedTranslation\":\"Ngoài ra, tôi đang tìm kiếm sự kết hợp tinh tế giữa không khí lễ hội và nét u buồn.\",\"rating\":0.0},\n  {\"id\":788391,\"suggestedTranslation\":\"Ngoài ra, nhà vô địch hôm nay sẽ là sự cân bằng hoàn hảo giữa nét u buồn và không khí lễ hội.\",\"rating\":0.0},\n  {\"id\":788392,\"suggestedTranslation\":\"Ngoài ra, hôm nay tôi đang tìm kiếm rất nhiều không khí lễ hội.\",\"rating\":0.0},\n  {\"id\":788393,\"suggestedTranslation\":\"Ngoài ra, tôi chỉ muốn thấy chút ít không khí lễ hội thôi.\",\"rating\":0.0},\n  {\"id\":788394,\"suggestedTranslation\":\"Anh bạn này mang không khí lễ hội hơn mức tôi muốn.\",\"rating\":0.0},\n  {\"id\":788395,\"suggestedTranslation\":\"Tôi tôn trọng không khí lễ hội của con bò lai này, nhưng nó vượt quá mức tôi thích rồi.\",\"rating\":0.0},\n  {\"id\":788396,\"suggestedTranslation\":\"Tôi muốn con bò lai của mình mang không khí lễ hội hơn thế này khá nhiều.\",\"rating\":0.0},\n  {\"id\":788397,\"suggestedTranslation\":\"Con này chưa đủ không khí lễ hội, còn kém một đoạn khá xa.\",\"rating\":0.0},\n  {\"id\":788398,\"suggestedTranslation\":\"Được rồi, tạm thời cuộc thi kết thúc nhé mọi người!\",\"rating\":0.0},\n  {\"id\":788399,\"suggestedTranslation\":\"Cuối cùng, lựa chọn cho vị trí quán quân của tôi là...\",\"rating\":0.0},\n  {\"id\":788400,\"suggestedTranslation\":\"Con này trang trọng quá mức rồi.\",\"rating\":0.0},\n  {\"id\":788401,\"suggestedTranslation\":\"Độ trang trọng của con bò lai này vượt quá gu thẩm mỹ của tôi hôm nay rồi.\",\"rating\":0.0},\n  {\"id\":788402,\"suggestedTranslation\":\"Con bò lai hôm nay cần phải trang trọng hơn tên rách rưới này nhiều.\",\"rating\":0.0},\n  {\"id\":788403,\"suggestedTranslation\":\"Hôm nay tôi đang tìm kiếm thứ gì đó trang trọng hơn nhiều.\",\"rating\":0.0},\n  {\"id\":788404,\"suggestedTranslation\":\"Con bò lai này trang trọng hơn một chút so với mức tôi muốn.\",\"rating\":0.0},\n  {\"id\":788405,\"suggestedTranslation\":\"Trang trọng hơn một chút thì tốt, nhưng không phải hôm nay.\",\"rating\":0.0},\n  {\"id\":788406,\"suggestedTranslation\":\"Có lẽ con bò lai này nên trang trọng hơn một chút.\",\"rating\":0.0},\n  {\"id\":788407,\"suggestedTranslation\":\"Con bò lai này không trang trọng bằng tôi muốn, nhưng cũng gần được rồi.\",\"rating\":0.0},\n  {\"id\":788408,\"suggestedTranslation\":\"Tôi thích tính trang trọng của con này.\",\"rating\":0.0},\n  {\"id\":788409,\"suggestedTranslation\":\"Con bò lai này trang trọng vừa đủ.\",\"rating\":0.0},\n  {\"id\":788410,\"suggestedTranslation\":\"Mọi thứ về người chiến thắng hôm nay phải hét lên sự \\\"trang trọng\\\".\",\"rating\":0.0},\n  {\"id\":788411,\"suggestedTranslation\":\"Gu của tôi hôm nay là hoàn toàn không có sự trang trọng nào cả.\",\"rating\":0.0},\n  {\"id\":788412,\"suggestedTranslation\":\"Con bò lai hôm nay nên có một chút nét trang trọng.\",\"rating\":0.0},\n  {\"id\":788413,\"suggestedTranslation\":\"Lựa chọn của tôi cho hôm nay sẽ phá cách nhiều hơn là trang trọng.\",\"rating\":0.0},\n  {\"id\":788414,\"suggestedTranslation\":\"Tôi muốn thấy sự kết hợp hoàn hảo giữa phá cách và trang trọng.\",\"rating\":0.0},\n  {\"id\":788415,\"suggestedTranslation\":\"Tôi muốn thấy mức độ trang trọng cao nhất ngày hôm nay, kèm theo một chút hỗn loạn.\",\"rating\":0.0},\n  {\"id\":788416,\"suggestedTranslation\":\"Tôi muốn thấy thứ gì đó chủ yếu là phá cách, với một chút sự trang trọng.\",\"rating\":0.0},\n  {\"id\":788417,\"suggestedTranslation\":\"Mẫu vật này trang trọng hơn mức tôi muốn.\",\"rating\":0.0},\n  {\"id\":788418,\"suggestedTranslation\":\"Tôi tôn trọng sự trang trọng của con bò lai này, nhưng nó vượt quá mức tôi thích rồi.\",\"rating\":0.0},\n  {\"id\":788419,\"suggestedTranslation\":\"Tôi muốn con bò lai của mình trang trọng hơn thế này khá nhiều.\",\"rating\":0.0},\n  {\"id\":788420,\"suggestedTranslation\":\"Con này chưa đủ trang trọng, còn kém một đoạn khá xa.\",\"rating\":0.0},\n  {\"id\":788421,\"suggestedTranslation\":\"Và ở vị trí thứ hai...\",\"rating\":0.0},\n  {\"id\":788422,\"suggestedTranslation\":\"Cha chả, để tôi ngó qua bầy thú này xem nào.\",\"rating\":0.0},\n  {\"id\":788423,\"suggestedTranslation\":\"Con bò lai hoàn hảo của tôi thay đổi theo từng ngày...\",\"rating\":0.0},\n  {\"id\":788424,\"suggestedTranslation\":\"Được rồi, lựa chọn cho vị trí thứ ba của tôi là...\",\"rating\":0.0},\n  {\"id\":788425,\"suggestedTranslation\":\"Cuối cùng, đây là con búp bê đáng sợ nhất!\",\"rating\":0.0},\n  {\"id\":788426,\"suggestedTranslation\":\"Cuối cùng, con này trông giống gấu bông. Trái tim tôi thấy nhẹ nhõm rồi.\",\"rating\":0.0},\n  {\"id\":788427,\"suggestedTranslation\":\"Cuối cùng, nó chỉ đáng sợ hơn sự thân thiện một chút thôi.\",\"rating\":0.0},\n  {\"id\":788428,\"suggestedTranslation\":\"Cuối cùng, cái này thân thiện hơn là đáng sợ một chút.\",\"rating\":0.0},\n  {\"id\":788429,\"suggestedTranslation\":\"Cuối cùng, nó có sự cân bằng tốt giữa đáng sợ và thân thiện.\",\"rating\":0.0},\n  {\"id\":788430,\"suggestedTranslation\":\"Cuối cùng, nó khá hung dữ.\",\"rating\":0.0},\n  {\"id\":788431,\"suggestedTranslation\":\"Cuối cùng, con này trông khá đáng sợ.\",\"rating\":0.0},\n  {\"id\":788432,\"suggestedTranslation\":\"Cuối cùng, nó có một chút xíu tính hung dữ.\",\"rating\":0.0},\n  {\"id\":788433,\"suggestedTranslation\":\"Cuối cùng, tôi có thể thấy một chút hung dữ, nhưng chỉ một chút thôi.\",\"rating\":0.0},\n  {\"id\":788434,\"suggestedTranslation\":\"Ngoài ra, đây là con búp bê mang không khí lễ hội nhất.\",\"rating\":0.0},\n  {\"id\":788435,\"suggestedTranslation\":\"Ngoài ra, tôi không thấy dù chỉ một chút không khí lễ hội nào ở đây.\",\"rating\":0.0},\n  {\"id\":788436,\"suggestedTranslation\":\"Ngoài ra, nó mang rất nhiều không khí lễ hội, kèm theo một chút nét u buồn.\",\"rating\":0.0},\n  {\"id\":788437,\"suggestedTranslation\":\"Ngoài ra, cái này u buồn nhiều hơn là mang không khí lễ hội.\",\"rating\":0.0},\n  {\"id\":788438,\"suggestedTranslation\":\"Ngoài ra, đây là sự kết hợp tinh tế giữa không khí lễ hội và nét u buồn.\",\"rating\":0.0},\n  {\"id\":788439,\"suggestedTranslation\":\"Ngoài ra, nó là sự cân bằng hoàn hảo giữa u buồn và không khí lễ hội.\",\"rating\":0.0},\n  {\"id\":788440,\"suggestedTranslation\":\"Ngoài ra, nó mang rất nhiều không khí lễ hội.\",\"rating\":0.0},\n  {\"id\":788441,\"suggestedTranslation\":\"Ngoài ra, nó chỉ có chút xíu không khí lễ hội thôi.\",\"rating\":0.0},\n  {\"id\":788442,\"suggestedTranslation\":\"Mọi thứ về cái này đều hét lên sự \\\"trang trọng\\\".\",\"rating\":0.0},\n  {\"id\":788443,\"suggestedTranslation\":\"Nó hoàn toàn thiếu vắng sự trang trọng.\",\"rating\":0.0},\n  {\"id\":788444,\"suggestedTranslation\":\"Cái này có một chút nét trang trọng.\",\"rating\":0.0},\n  {\"id\":788445,\"suggestedTranslation\":\"Cái này phá cách nhiều hơn là trang trọng.\",\"rating\":0.0},\n  {\"id\":788446,\"suggestedTranslation\":\"Nó là sự pha trộn hoàn hảo giữa phá cách và trang trọng.\",\"rating\":0.0},\n  {\"id\":788447,\"suggestedTranslation\":\"Đây là mức độ trang trọng cao nhất, kèm theo một chút hỗn loạn.\",\"rating\":0.0},\n  {\"id\":788448,\"suggestedTranslation\":\"Cái này chủ yếu là phá cách, với một chút sự trang trọng.\",\"rating\":0.0},\n  {\"id\":788449,\"suggestedTranslation\":\"Hãy triệu tập vài cư dân địa phương để mọi thứ trở nên thú vị hơn nào.\",\"rating\":0.0},\n  {\"id\":788450,\"suggestedTranslation\":\"Chúc mừng nhé! Đừng tiêu hết số tiền đó vào một chỗ đấy.\",\"rating\":0.0},\n  {\"id\":788451,\"suggestedTranslation\":\"Của bạn đây, làm tốt lắm.\",\"rating\":0.0},\n  {\"id\":788452,\"suggestedTranslation\":\"Nào, bạn nghĩ ai trong số những mỹ nhân này sẽ là người chiến thắng ngày hôm nay!?\",\"rating\":0.0},\n  {\"id\":788453,\"suggestedTranslation\":\"Cứ từ từ, chọn cho khôn ngoan vào đấy.\",\"rating\":0.0},\n  {\"id\":788454,\"suggestedTranslation\":\"Được rồi, mau nhanh chân lên nào...\",\"rating\":0.0},\n  {\"id\":788455,\"suggestedTranslation\":\"Hết giờ rồi!\",\"rating\":0.0},\n  {\"id\":788456,\"suggestedTranslation\":\"Được rồi, lựa chọn của tôi cho cuộc thi hôm nay là...\",\"rating\":0.0},\n  {\"id\":788457,\"suggestedTranslation\":\"Chào nhé!\",\"rating\":0.0},\n  {\"id\":788458,\"suggestedTranslation\":\"Này!\",\"rating\":0.0},\n  {\"id\":788459,\"suggestedTranslation\":\"Chào bạn!\",\"rating\":0.0},\n  {\"id\":788460,\"suggestedTranslation\":\"Xin chào!\",\"rating\":0.0},\n  {\"id\":788461,\"suggestedTranslation\":\"Mau tới nhận giải thưởng đi, tôi không đợi cả ngày đâu.\",\"rating\":0.0},\n  {\"id\":788462,\"suggestedTranslation\":\"Tiếc quá, lần này bạn không thắng được gì cả.\",\"rating\":0.0},\n  {\"id\":788463,\"suggestedTranslation\":\"Đúng là một đám đông có vẻ ngoài pha trộn thú vị.\",\"rating\":0.0},\n  {\"id\":788464,\"suggestedTranslation\":\"Hôm nay không ai đoán đúng cả! Vẫn còn ngày mai cơ mà.\",\"rating\":0.0},\n  {\"id\":788465,\"suggestedTranslation\":\"Mọi người hãy tận hưởng một vài mảnh vải thời trang miễn phí nhé!\",\"rating\":0.0},\n  {\"id\":788466,\"suggestedTranslation\":\"Chỉ có một người chiến thắng duy nhất! Đừng tiêu hết tiền vào một chỗ đấy!\",\"rating\":0.0},\n  {\"id\":788467,\"suggestedTranslation\":\"Phần thưởng của các bạn đây, những người chiến thắng!\",\"rating\":0.0},\n  {\"id\":788468,\"suggestedTranslation\":\"Xin lỗi, ở đây không đủ Két Sắt!\",\"rating\":0.0},\n  {\"id\":788469,\"suggestedTranslation\":\"Xin lỗi, muộn quá rồi để bắt đầu ngày hôm nay.\",\"rating\":0.0},\n  {\"id\":788470,\"suggestedTranslation\":\"Tôi không thấy có đủ Sân Khấu nào được dựng lên cả.\",\"rating\":0.0},\n  {\"id\":788471,\"suggestedTranslation\":\"Tôi chẳng thấy thí sinh nào để chấm điểm cả, còn bạn thì sao?\",\"rating\":0.0},\n  {\"id\":788472,\"suggestedTranslation\":\"Xin lỗi, không thể đợi thêm được nữa. Tạm biệt nhé.\",\"rating\":0.0},\n  {\"id\":788473,\"suggestedTranslation\":\"Hòa mình vào bầu không khí ngày hội bãi biển nào!\",\"rating\":0.0},\n  {\"id\":788474,\"suggestedTranslation\":\"Hòa mình vào bầu không khí ngày hội bãi biển nào!\",\"rating\":0.0},\n  {\"id\":788475,\"suggestedTranslation\":\"Hòa mình vào bầu không khí ngày hội bãi biển nào!\",\"rating\":0.0},\n  {\"id\":788476,\"suggestedTranslation\":\"Tận hưởng niềm vui bên bờ biển là nghĩa vụ thiêng liêng của bạn!\",\"rating\":0.0},\n  {\"id\":788477,\"suggestedTranslation\":\"Tận hưởng niềm vui bên bờ biển là nghĩa vụ thiêng liêng của bạn!\",\"rating\":0.0},\n  {\"id\":788478,\"suggestedTranslation\":\"Tận hưởng niềm vui bên bờ biển là nghĩa vụ thiêng liêng của bạn!\",\"rating\":0.0},\n  {\"id\":788479,\"suggestedTranslation\":\"Tôi e rằng bạn sẽ chẳng bao giờ tìm được bộ váy nào tuyệt hơn cho những cuộc vui lễ hội và những trò đùa giỡn phù phiếm đâu.\",\"rating\":0.0},\n  {\"id\":788480,\"suggestedTranslation\":\"Tôi e rằng bạn sẽ chẳng bao giờ tìm được bộ váy nào tuyệt hơn cho những cuộc vui lễ hội và những trò đùa giỡn phù phiếm đâu.\",\"rating\":0.0},\n  {\"id\":788481,\"suggestedTranslation\":\"Tôi e rằng bạn sẽ chẳng bao giờ tìm được bộ váy nào tuyệt hơn cho những cuộc vui lễ hội và những trò đùa giỡn phù phiếm đâu.\",\"rating\":0.0},\n  {\"id\":788482,\"suggestedTranslation\":\"Rương này chứa rất nhiều trang phục đi biển.\",\"rating\":0.0},\n  {\"id\":788483,\"suggestedTranslation\":\"Khả năng bảo vệ khá là bình thường.\",\"rating\":0.0},\n  {\"id\":788484,\"suggestedTranslation\":\"Từ khi nào mà Gấu Lửng lại bắt đầu dùng dụng cụ ăn uống thế?\",\"rat