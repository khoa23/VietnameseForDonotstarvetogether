782896, \"suggestedTranslation\": \"Có gì đó không ổn!\", \"rating\": 9.0},\n  {\"id\": 782897, \"suggestedTranslation\": \"Kiểm tra trang phục của các bạn đi!\", \"rating\": 9.0},\n  {\"id\": 782898, \"suggestedTranslation\": \"Chúng ta sẽ quay lại.\", \"rating\": 9.0},\n  {\"id\": 782899, \"suggestedTranslation\": \"Khi nào các bạn làm đúng!\", \"rating\": 9.0},\n  {\"id\": 782900, \"suggestedTranslation\": \"\\\"Độc thoại của Thợ Rèn\\\"\", \"rating\": 9.0},\n  {\"id\": 782901, \"suggestedTranslation\": \"Tiếp tục rèn giũa.\", \"rating\": 9.0},\n  {\"id\": 782902, \"suggestedTranslation\": \"Ồ búp bê nhỏ ơi, búp bê nhỏ ơi!\", \"rating\": 9.0},\n  {\"id\": 782903, \"suggestedTranslation\": \"Ngươi đã đi đâu mất rồi?\", \"rating\": 9.0},\n  {\"id\": 782904, \"suggestedTranslation\": \"Ngoài đó không an toàn cho ngươi đâu\", \"rating\": 9.0},\n  {\"id\": 782905, \"suggestedTranslation\": \"giữa thế giới rộng lớn ngoài kia!\", \"rating\": 9.0},\n  {\"id\": 782906, \"suggestedTranslation\": \"Nếu nó chưa hỏng...\", \"rating\": 9.0},\n  {\"id\": 782907, \"suggestedTranslation\": \"Cô ấy vẫn sẽ cố sửa nó.\", \"rating\": 9.0},\n  {\"id\": 782908, \"suggestedTranslation\": \"Xin hãy chào đón Elytra!\", \"rating\": 9.0},\n  {\"id\": 782909, \"suggestedTranslation\": \"Tâu Nữ hoàng Metheus của thần,\", \"rating\": 9.0},\n  {\"id\": 782910, \"suggestedTranslation\": \"trái tim thần tan nát khi biết mình đã phụ lòng Người.\", \"rating\": 9.0},\n  {\"id\": 782911, \"suggestedTranslation\": \"Xin hãy giáng lời nguyền lên thần,\", \"rating\": 9.0},\n  {\"id\": 782912, \"suggestedTranslation\": \"để thần phải gánh chịu nỗi đau buồn đến muôn đời.\", \"rating\": 9.0},\n  {\"id\": 782913, \"suggestedTranslation\": \"Cô ta còn bao nhiêu nỗi buồn để mà gánh chịu nữa đây?\", \"rating\": 9.0},\n  {\"id\": 782914, \"suggestedTranslation\": \"Để xem nào... cũng lâu rồi nhỉ, vậy thêm một vạn kiếp nữa chăng?\", \"rating\": 9.0},\n  {\"id\": 782915, \"suggestedTranslation\": \"HA HA HA HA HA!\", \"rating\": 10.0},\n  {\"id\": 782916, \"suggestedTranslation\": \"Ngươi có nghe bọn họ nói gì về màn trình diễn của ả không?\", \"rating\": 9.0},\n  {\"id\": 782917, \"suggestedTranslation\": \"Có chứ! Ả làm tốt lắm!\", \"rating\": 9.0},\n  {\"id\": 782918, \"suggestedTranslation\": \"HA HA HA HA HA!\", \"rating\": 10.0},\n  {\"id\": 782919, \"suggestedTranslation\": \"Nếu những lời này lọt vào tai ngươi, hỡi nhà thám hiểm liều lĩnh,\", \"rating\": 9.0},\n  {\"id\": 782920, \"suggestedTranslation\": \"thì tất cả công sức của chúng ta đều đã đổ sông đổ biển.\", \"rating\": 9.0},\n  {\"id\": 782921, \"suggestedTranslation\": \"Xin hãy rủ lòng thương cho những kẻ đã bị nuốt chửng,\", \"rating\": 9.0},\n  {\"id\": 782922, \"suggestedTranslation\": \"và những kẻ sắp bị Kẻ Khác bắt đi.\", \"rating\": 9.0},\n  {\"id\": 782923, \"suggestedTranslation\": \"...\", \"rating\": 10.0},\n  {\"id\": 782924, \"suggestedTranslation\": \"\\\"Độc thoại của Kẻ Ngốc\\\"\", \"rating\": 9.0},\n  {\"id\": 782925, \"suggestedTranslation\": \"Bọn chúng nghĩ mình đang lừa ai chứ?\", \"rating\": 9.0},\n  {\"id\": 782926, \"suggestedTranslation\": \"Đã có lúc tôi hành động theo đúng những gì mình nghĩ,\", \"rating\": 9.0},\n  {\"id\": 782927, \"suggestedTranslation\": \"tôi tuân theo mọi quy tắc.\", \"rating\": 9.0},\n  {\"id\": 782928, \"suggestedTranslation\": \"Nhưng chẳng mấy chốc tôi nhận ra cuộc đời là một trò chơi,\", \"rating\": 9.0},\n  {\"id\": 782929, \"suggestedTranslation\": \"và tôi đã đóng vai kẻ ngốc!\", \"rating\": 9.0},\n  {\"id\": 782930, \"suggestedTranslation\": \"Đầu tôi đau quá.\", \"rating\": 9.0},\n  {\"id\": 782931, \"suggestedTranslation\": \"Lắng nghe một kẻ ngốc thì sẽ vậy thôi.\", \"rating\": 9.0},\n  {\"id\": 782932, \"suggestedTranslation\": \"Bọn bay có thấy mấy chiến hữu của ta không?\", \"rating\": 9.0},\n  {\"id\": 782933, \"suggestedTranslation\": \"Chúng ta đi ba người.\", \"rating\": 9.0},\n  {\"id\": 782934, \"suggestedTranslation\": \"Giờ thì chỉ c