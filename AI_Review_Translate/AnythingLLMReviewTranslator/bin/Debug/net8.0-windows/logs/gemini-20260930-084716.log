ion\": \"\\\"Và thêm một chút nước hoa hồng ngọt ngào.\\\"\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 781885,\n    \"suggestedTranslation\": \"\\\"Tôi vừa nấu xong một món vô cùng kinh dị, dành riêng cho bạn đấy!\\\"\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 781886,\n    \"suggestedTranslation\": \"\\\"Mọi thứ có thể mất hết trừ vị giác của tôi!\\\"\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 781887,\n    \"suggestedTranslation\": \"\\\"Thực ra tôi chỉ làm việc ở khu bếp tàu thôi.\\\"\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 781888,\n    \"suggestedTranslation\": \"\\\"Tự hỏi không biết Maman có nhớ mấy món bánh ngày lễ của mình không.\\\"\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 781889,\n    \"suggestedTranslation\": \"\\\"Hãy nhớ về những ngày tháng cổ xưa nào!\\\"\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 781890,\n    \"suggestedTranslation\": \"\\\"Ta đang khát khao cơ hội được ra mắt trên các đấu trường!\\\"\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 781891,\n    \"suggestedTranslation\": \"\\\"THỊT ĐÂY.\\\"\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 781892,\n    \"suggestedTranslation\": \"\\\"Ta có thể chấp cả lũ chúng mày chỉ với một con mắt sau chiếc mặt nạ này!\\\"\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 781893,\n    \"suggestedTranslation\": \"\\\"Ta có thể chấp cả lũ chúng mày chỉ với một con mắt sau chiếc mặt nạ này!\\\"\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 781894,\n    \"suggestedTranslation\": \"\\\"Ta có thể chấp cả lũ chúng mày chỉ với một con mắt sau chiếc mặt nạ này!\\\"\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 781895,\n    \"suggestedTranslation\": \"\\\"Chúng ta sẽ ăn mừng cứ như đang ở Valhalla vậy!\\\"\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 781896,\n    \"suggestedTranslation\": \"\\\"Chúng ta sẽ ăn mừng cứ như đang ở Valhalla vậy!\\\"\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 781897,\n    \"suggestedTranslation\": \"\\\"Kỹ năng chiến đấu của ta là vô đối.\\\