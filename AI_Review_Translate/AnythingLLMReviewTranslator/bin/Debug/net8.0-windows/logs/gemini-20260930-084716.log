            "text": "[\n  {\"id\": 783477, \"suggestedTranslation\": \"3\", \"rating\": 10.0},\n  {\"id\": 783478, \"suggestedTranslation\": \"Tôi đã từng kể cho bạn nghe câu chuyện về Người Hải Ly chưa?\", \"rating\": 9.0},\n  {\"id\": 783479, \"suggestedTranslation\": \"3\", \"rating\": 10.0},\n  {\"id\": 783480, \"suggestedTranslation\": \"Hắn mất hết tất cả, và ẩn mình trong một căn nhà gỗ nhỏ,\", \"rating\": 9.0},\n  {\"id\": 783481, \"suggestedTranslation\": \"2.5\", \"rating\": 10.0},\n  {\"id\": 783482, \"suggestedTranslation\": \"sâu trong tận cùng của rừng rậm.\", \"rating\": 9.0},\n  {\"id\": 783483, \"suggestedTranslation\": \"2.5\", \"rating\": 10.0},\n  {\"id\": 783484, \"suggestedTranslation\": \"Nhưng thế vẫn chưa đủ để thỏa mãn lời nguyền.\", \"rating\": 9.0},\n  {\"id\": 783485, \"suggestedTranslation\": \"2.5\", \"rating\": 10.0},\n  {\"id\": 783486, \"suggestedTranslation\": \"Người ta nói hắn vẫn ở đó, lang thang trong chốn hoang dã,\", \"rating\": 9.0},\n  {\"id\": 783487, \"suggestedTranslation\": \"2.5\", \"rating\": 10.0},\n  {\"id\": 783488, \"suggestedTranslation\": \"ngghiến nghiến bộ răng dài đáng sợ!\", \"rating\": 9.0},\n  {\"id\": 783489, \"suggestedTranslation\": \"1.5\", \"rating\": 10.0},\n  {\"id\": 783490, \"suggestedTranslation\": \"...\", \"rating\": 10.0},\n  {\"id\": 783491, \"suggestedTranslation\": \"2.5\", \"rating\": 10.0},\n  {\"id\": 783492, \"suggestedTranslation\": \"Chà, đó là câu chuyện tôi nghe được thôi.\", \"rating\": 9.0},\n  {\"id\": 783493, \"suggestedTranslation\": \"3\", \"rating\": 10.0},\n  {\"id\": 783494, \"suggestedTranslation\": \"Anh Woodie chưa bao giờ nói với tôi liệu nó có thực hay không...\", \"rating\": 9.0},\n  {\"id\": 783495, \"suggestedTranslation\": \"2.5\", \"rating\": 10.0},\n  {\"id\": 783496, \"suggestedTranslation\": \"Tôi đã tự mình đi tìm hắn đấy, bạn biết đấy.\", \"rating\": 9.0},\n  {\"id\": 783497, \"suggestedTranslation\": \"3\", \"rating\": 10.0},\n  {\"id\": 783498, \"suggestedTranslation\": \"Họ nói hắn từng là chủ của một công ty gỗ lớn,\", \"rating\": 9.0},\n  {\"id\": 783499, \"suggestedTranslation\": \"2.5\", \"rating\": 10.0},\n  {\"id\": 783500, \"suggestedTranslation\": \"kẻ đã ra lệnh chặt phá toàn bộ một khu rừng\", \"rating\": 9.0},\n  {\"id\": 783501, \"suggestedTranslation\": \"2.5\", \"rating\": 10.0},\n  {\"id\": 783502, \"suggestedTranslation\": \"bất chấp mong muốn của những người sinh sống ở đó.\", \"rating\": 9.0},\n  {\"id\": 783503, \"suggestedTranslation\": \"2.5\", \"rating\": 10.0},\n  {\"id\": 783504, \"suggestedTranslation\": \"Vì điều này, họ nói hắn đã bị nguyền rủa...\", \"rating\": 9.0},\n  {\"id\": 783505, \"suggestedTranslation\": \"2.5\", \"rating\": 10.0},\n  {\"id\": 783506, \"suggestedTranslation\": \"Nếu hắn hoặc công ty của hắn chặt quá một cái cây,\", \"rating\": 9.0},\n  {\"id\": 783507, \"suggestedTranslation\": \"2.5\", \"rating\": 10.0},\n  {\"id\": 783508, \"suggestedTranslation\": \"hắn sẽ biến thành một con quái vật to lớn, lông lá,\", \"rating\": 9.0},\n  {\"id\": 783509, \"suggestedTranslation\": \"2.5\", \"rating\": 10.0},\n  {\"id\": 783510, \"suggestedTranslation\": \"với hàm răng cửa sắc như rìu.\", \"rating\": 9.0},\n  {\"id\": 783511, \"suggestedTranslation\": \"Titus\", \"rating\": 10.0},\n  {\"id\": 783512, \"suggestedTranslation\": \"Pertinax\", \"rating\": 10.0},\n  {\"id\": 783513, \"suggestedTranslation\": \"Didius\", \"rating\": 10.0},\n  {\"id\": 783514, \"suggestedTranslation\": \"Septmius\", \"rating\": 10.0},\n  {\"id\": 783515, \"suggestedTranslation\": \"Caracalla\", \"rating\": 10.0},\n  {\"id\": 783516, \"suggestedTranslation\": \"Geta\", \"rating\": 10.0},\n  {\"id\": 783517, \"suggestedTranslation\": \"Macrinus\", \"rating\": 10.0},\n  {\"id\": 783518, \"suggestedTranslation\": \"Elagabalus\", \"rating\": 10.0},\n  {\"id\": 783519, \"suggestedTranslation\": \"Severus\", \"rating\": 10.0},\n  {\"id\": 783520, \"suggestedTranslation\": \"Maximinus\", \"rating\": 10.0},\n 