Translation\": \"Yến Tiệc\", \"rating\": 9.0},\n  {\"id\": 783596, \"suggestedTranslation\": \"nhóm\", \"rating\": 9.0},\n  {\"id\": 783597, \"suggestedTranslation\": \"chỉbạnbè\", \"rating\": 9.0},\n  {\"id\": 783598, \"suggestedTranslation\": \"the_forge\", \"rating\": 10.0},\n  {\"id\": 783599, \"suggestedTranslation\": \"the_gorge\", \"rating\": 10.0},\n  {\"id\": 783600, \"suggestedTranslation\": \"chỉcụcbộ\", \"rating\": 9.0},\n  {\"id\": 783601, \"suggestedTranslation\": \"hangđộng\", \"rating\": 9.0},\n  {\"id\": 783602, \"suggestedTranslation\": \"đanhtầng\", \"rating\": 9.0},\n  {\"id\": 783603, \"suggestedTranslation\": \"pvp\", \"rating\": 10.0},\n  {\"id\": 783604, \"suggestedTranslation\": \"bìnhchọn\", \"rating\": 9.0},\n  {\"id\": 783605, \"suggestedTranslation\": \"Nóng\", \"rating\": 9.0},\n  {\"id\": 783606, \"suggestedTranslation\": \"Cảm ơn bạn đã chơi bản thử nghiệm!\\nGiai đoạn cuối của Trùm và phần thưởng sẽ sớm ra mắt...\", \"rating\": 9.0},\n  {\"id\": 783607, \"suggestedTranslation\": \"Cảm ơn bạn đã chơi bản thử nghiệm!\", \"rating\": 9.0},\n  {\"id\": 783608, \"suggestedTranslation\": \"Bạn đã hạ gục {name} trong {time} giây.\", \"rating\": 9.0},\n  {\"id\": 783609, \"suggestedTranslation\": \"Cảm ơn bạn đã chơi bản thử nghiệm!\\nCăn phòng phía sau điểm này hiện chưa khả dụng.\", \"rating\": 9.0},\n  {\"id\": 783610, \"suggestedTranslation\": \"Bạn đã hạ gục tất cả {name} trong bản thử nghiệm!\\nChiến lợi phẩm và phần thưởng bổ sung sẽ sớm ra mắt...\", \"rating\": 9.0},\n  {\"id\": 783611, \"suggestedTranslation\": \"Metheus đã chú ý tới\", \"rating\": 9.0},\n  {\"id\": 783612, \"suggestedTranslation\": \"Pulvis et umbra sumus\", \"rating\": 10.0},\n  {\"id\": 783613, \"suggestedTranslation\": \"Chúc mừng Ngày Lễ Tình Nhân\\nđến từ những người bạn tại Klei\", \"rating\": 9.0},\n  {\"id\": 783614, \"suggestedTranslation\": \"Chào mừng bạn quay lại!\\nHãy nhận gói quà hàng ngày này nhé.\", \"rating\": 9.0},\n  {\"id\": 783615, \"suggestedTranslation\": \"Cảm ơn bạn đã chơi\", \"rating\": 9.0},\n  {\"id\": 783616, \"suggestedTranslation\": \"Cảm ơn bạn đã tham gia sự kiện\\nGorge\", \"rating\": 9.0},\n  {\"id\": 783617, \"suggestedTranslation\": \"Cảm ơn bạn đã tham gia\\nGiải đấu Gorge\", \"rating\": 9.0},\n  {\"id\": 783618, \"suggestedTranslation\": \"Cảm ơn bạn đã chơi\", \"rating\": 9.0},\n  {\"id\": 783619, \"suggestedTranslation\": \"Nóng thật đấy!\", \"rating\": 9.0},\n  {\"id\": 783620, \"suggestedTranslation\": \"Cảm ơn bạn đã tham gia sự kiện\\nNăm Gà Tây\", \"rating\": 9.0},\n  {\"id\": 783621, \"suggestedTranslation\": \"Cảm ơn bạn đã chơi\", \"rating\": 9.0},\n  {\"id\": 783622, \"suggestedTranslation\": \"Cảm ơn bạn đã chơi\", \"rating\": 9.0},\n  {\"id\": 783623, \"suggestedTranslation\": \"Cảm ơn bạn đã mua bản mở rộng Reign of Giants\", \"rating\": 9.0},\n  {\"id\": 783624, \"suggestedTranslation\": \"Gửi những lời chúc tốt đẹp\\nvà những chú ốc biển!\", \"rating\": 9.0},\n  {\"id\": 783625, \"suggestedTranslation\": \"Cảm ơn bạn đã chơi\", \"rating\": 9.0},\n  {\"id\": 783626, \"suggestedTranslation\": \"Chúc bạn vui vẻ với gói quà của mình\", \"rating\": 9.0},\n  {\"id\": 783627, \"suggestedTranslation\": \"Cảm ơn bạn đã chơi\", \"rating\": 9.0},\n  {\"id\": 783628, \"suggestedTranslation\": \"Cảm ơn bạn đã mua bản mở rộng ShipWrecked\", \"rating\": 9.0},\n  {\"id\": 783629, \"suggestedTranslation\": \"Chúc bạn thuận buồm xuôi gió\\ntrên hành trình Turn of Tides!\", \"rating\": 9.0},\n  {\"id\": 783630, \"suggestedTranslation\": \"Cảm ơn bạn đã xem các luồng phát sóng trò chơi\", \"rating\": 9.0},\n  {\"id\": 783631, \"suggestedTranslation\": \"Cảm ơn bạn đã xem các luồng phát sóng trò chơi\", \"rating\": 9.0},\n  {\"id\": 783632, \"suggestedTranslation\": \"Cảm ơn bạn đã tham gia sự kiện\\nNăm Chó Sói\", \"rating\": 9.0},\n  {\"id\": 783633, \"suggestedTranslation\": \"Chúc mừng Lễ Mùa Đông\\nđến từ những người bạn tại Klei\", \"rating\": 9.0},\n  {\"id\": 783634, \"suggestedTranslation\": \"Cảm ơn bạn đã tham gia sự kiện\\nNăm Bò Lai\", \"rating\": 9.0},\n  {\"id\": 783635, \"suggestedTranslation\": \"Cảm ơn bạn đã tham gia sự kiện\\nNăm Vua Lợn\", \"rating\": 9.0},\n  {\"id\": 783636, \"suggestedTranslation\": \"Di chuyển\", \"rating\": 9.0},\n  {\"id\": 783637, \"suggestedTranslation\": \"Đây sẽ là một đêm tồi tệ đây...\", \"rating\": 9.0},\n  {\"id\": 783638, \"suggestedTranslation\": \"Cặp Song Sinh hướng ánh mắt về phía {player_name}\", \"rating\": 9.0},\n  {\"id\": 788106, \"suggestedTranslation\": \"\\\"Hầm mộ này sẽ trở thành nấm mồ cho bất kẻ nào dám bén mảng bước vào.\\\"\", \"rating\": 9.0},\n  {\"id\": 788107, \"suggestedTranslation\": \"\\\"Không tin tưởng ai cả. Bóng Tối bóp méo mọi thứ nó chạm vào.\\\"\", \"rating\": 9.0},\n  {\"id\": 788108, \"suggestedTranslation\": \"\\\"Thông qua Đá Chốt, mọi họ hàng và giống loài sẽ gục ngã.\\\"\", \"rating\": 9.0},\n  {\"id\": 788109, \"suggestedTranslation\": \"\\\"Đừng bao giờ để Viên Đá Chốt bị nguyền rủa này bước qua ngưỡng cửa.\\\"\", \"rating\": 9.0},\n  {\"id\": 788110, \"suggestedTranslation\": \"\\\"Đường đi chỉ có một. Hãy nhảy thật khôn ngoan, đừng chần chừ, kẻo vực sâu nuốt chửng tất cả.\\\"\", \"rating\": 9.0},\n  {\"id\": 788111, \"suggestedTranslation\": \"\\\"Chỉ khi tất cả các ngọn đuốc cùng cháy sáng thì con đường mới mở lối.\\\"\", \"rating\": 9.0},\n  {\"id\": 788112, \"suggestedTranslation\": \"\\\"Những căn phòng này gắn kết với nhau, nhưng theo cách không tự nhiên, được tạo ra để làm rối trí bất kỳ ai bước vào.\\\"\", \"rating\": 9.0},\n  {\"id\": 788113, \"suggestedTranslation\": \"Ngươi đâu cần cái cây rùi còi đó ssssđâu...\", \"rating\": 9.0},\n  {\"id\": 788114, \"suggestedTranslation\": \"Chúng ta có thể làm được nhieuuuu điều hơn thế nếu không có cái rìu cũ kỹ đó kìm chân ngươi...\", \"rating\": 9.0},\n  {\"id\": 788115, \"suggestedTranslation\": \"Tốt nhất là hãy cắttt đứt mối liên kết với lưỡi kiếm cũ kỹ đó đi.\", \"rating\": 9.0},\n  {\"id\": 788116, \"suggestedTranslation\": \"Ai mà cầtttt cái rìu cũ kỹ đó khi đã có ta cơ chứ?\", \"rating\": 9.0},\n  {\"id\": 788117, \"suggestedTranslation\": \"Phá hủyyyyy thảm thực vật nào!\", \"rating\": 9.0},\n  {\"id\": 788118, \"suggestedTranslation\": \"Đừng tha thsssứ cho thứ gì hết!\", \"rating\": 9.0},\n  {\"id\": 788119, \"suggestedTranslation\": \"Đang tận hưởnnggggg bản thân đấy à, {mortal}?\", \"rating\": 9.0},\n  {\"id\": 788120, \"suggestedTranslation\": \"Chặt hạ chúng, chặt sạch tất cả bọn chúng!\", \"rating\": 9.0},\n  {\"id\": 788121, \"suggestedTranslation\": \"Không thể trốn thssssuát khỏi lưỡi kiếm của ta đâu!\", \"rating\": 9.0},\n  {\"id\": 788122, \"suggestedTranslation\": \"Cắt... chém... nuốt chửng... đúnnnng rồi...\", \"rating\": 9.0},\n  {\"id\": 788123, \"suggestedTranslation\": \"Thế giới này là của chúnnnnng ta để thu hoạch.\", \"rating\": 9.0},\n  {\"id\": 788124, \"suggestedTranslation\": \"Đừng kìm nén nữa...\", \"rating\": 9.0},\n  {\"id\": 788125, \"suggestedTranslation\": \"Vào thẳng vấn đề luôn nhhhhhé?\", \"rating\": 9.0},\n  {\"id\": 788126, \"suggestedTranslation\": \"Đã đến lúc thu hoạccccch rồi.\", \"rating\": 9.0},\n  {\"id\": 788127, \"suggestedTranslation\": \"Tất cả sẽ phải gục ngã trước chúnnnnng ta!\", \"rating\": 9.0},\n  {\"id\": 788128, \"suggestedTranslation\": \"Ngươi muốn chặt và chém lắm rồi, đúng thế không nào!\", \"rating\": 9.0},\n  {\"id\": 788129, \"suggestedTranslation\": \"Ta hay bị chê là có cái miệng khá sssắc bén đấy.\", \"rating\": 9.0},\n  {\"id\": 788130, \"suggestedTranslation\": \"Chúng ta là một đội rất ăn ý, dù ngươi có cắttt xẻ thế nào đi nữa.\", \"rating\": 9.0},\n  {\"id\": 788131, \"suggestedTranslation\": \"Ta khao khát tiếng thét trong lặnnng lẽ của thảm thực vật...\", \"rating\": 9.0},\n  {\"id\": 788132, \"suggestedTranslation\": \"Với sự thông minh bén nhọn như dao cạo của ta và sự... cơ động của ngươi, chúng ta là vô đốiiiii!\", \"rating\": 9.0},\n  {\"id\": 788133, \"suggestedTranslation\": \"Tất cả chúng ta chỉ là công cụ cho một mục đích cao cả hơn thôi, phải không?\", \"rating\": 9.0},\n  {\"id\": 788134, \"suggestedTranslation\": \"San bằng bãi cỏ đi, rồi đến mấy bụi cây... sau đó thì ai mà biết được?\", \"rating\": 9.0},\n  {\"id\": 788135, \"suggestedTranslation\": \"Những cái hhhhiệt đã được gieo từ lâu, giờ hãy gặt hái thành quả đi.\", \"rating\": 9.0},\n  {\"id\": 788136, \"suggestedTranslation\": \"Lòng bàn tay ngươi đang đổ mồ hhhôi kìa, {mortal}, ngươi sắp nắm không chắc nữa rồi.\", \"rating\": 9.0},\n  {\"id\": 788137, \"suggestedTranslation\": \"Ngươi cần một trí tuệ ssssắc sảo cho công việc này đấy.\", \"rating\": 9.0},\n  {\"id\": 788138, \"suggestedTranslation\": \"Sao thế, {mortal}? Không hợp với việc này à?\", \"rating\": 9.0},\n  {\"id\": 788139, \"suggestedTranslation\": \"Ngươi và ta sẽ làm nên nhữnnnnng điều vĩ đại cùng nhau.\", \"rating\": 9.0},\n  {\"id\": 788140, \"suggestedTranslation\": \"Ta nghĩ mình từng là một nông dân trước khi lột xaaaaác.\", \"rating\": 9.0},\n  {\"id\": 788141, \"suggestedTranslation\": \"Ngươi nghe thấy ta nói chứ, {mortal}? Ngươi bắtttt đầu hiểu ra rồi đấy.\", \"rating\": 9.0},\n  {\"id\": 788142, \"suggestedTranslation\": \"Ta có thể nhìnnnn thấy mọi ngóc ngách tăm tối trong tâm trí ngươi, {mortal}.\", \"rating\": 9.0},\n  {\"id\": 788143, \"suggestedTranslation\": \"Bạn có mẫu vật nào khác không?\", \"rating\": 9.0},\n  {\"id\": 788144, \"suggestedTranslation\": \"Hừm, thử kiếm cho tôi cái khác xem.\", \"rating\": 9.0},\n  {\"id\": 788145, \"suggestedTranslation\": \"Tôi cần một thực thể phù hợp hơn!\", \"rating\": 9.0},\n  {\"id\": 788146, \"suggestedTranslation\": \"Tìm cho tôi một nguồn năng lượng đi!\", \"rating\": 9.0},\n  {\"id\": 788147, \"suggestedTranslation\": \"Aha! Dị thường địa chất mặt trăng này chỉ có thể có một ý nghĩa!\", \"rating\": 9.0},\n  {\"id\": 788148, \"suggestedTranslation\": \"Giờ là cơ hội của tôi!\", \"rating\": 9.0},\n  {\"id\": 788149, \"suggestedTranslation\": \"Chỉ nghiên cứu thêm chút nữa thôi... Sắp được rồi, tôi chắc chắn đấy!\", \"rating\": 9.0},\n  {\"id\": 788150, \"suggestedTranslation\": \"Thêm vài mẫu vật nữa, đúng thế, đó là thứ tôi cần...\", \"rating\": 9.0},\n  {\"id\": 788151, \"suggestedTranslation\": \"Tôi để ghi chú của mình ở đâu rồi nhỉ? Chắc là quanh đâu đây thôi...\", \"rating\": 9.0},\n  {\"id\": 788152, \"suggestedTranslation\": \"Tiếp tục thí nghiệm tiếp theo nào!\", \"rating\": 9.0},\n  {\"id\": 788153, \"suggestedTranslation\": \"Tiến bộ không chờ đợi một ai!\", \"rating\": 9.0},\n  {\"id\": 788154, \"suggestedTranslation\": \"Nó trống rỗng.\", \"rating\": 9.0},\n  {\"id\": 788155, \"suggestedTranslation\": \"Hừm, chưa đủ mạnh lắm, nhưng tôi dùng tạm được.\", \"rating\": 9.0},\n  {\"id\": 788156, \"suggestedTranslation\": \"Tôi nhận nó, nhưng có một cái đặc biệt hơn mà tôi đang tìm kiếm.\", \"rating\": 9.0},\n  {\"id\": 788157, \"suggestedTranslation\": \"Tuyệt! Một cái rất tốt! Cuối cùng cũng tìm được!\", \"rating\": 9.0},\n  {\"id\": 788158, \"suggestedTranslation\": \"Được rồi đấy! Cái này dùng ổn đây!\", \"rating\": 9.0},\n  {\"id\": 788159, \"suggestedTranslation\": \"Xuất sắc, đây chính là thứ tôi đang chờ đợi!\", \"rating\": 9.0},\n  {\"id\": 788160, \"suggestedTranslation\": \"Hừm, xem cậu có bắt được loại khác mang lại đây không.\", \"rating\": 9.0},\n  {\"id\": 788161, \"suggestedTranslation\": \"Tôi có đủ mấy cái này rồi. Tôi cần thứ gì đó đặc biệt, thứ gì đó... mạnh mẽ hơn.\", \"rating\": 9.0},\n  {\"id\": 788162, \"suggestedTranslation\": \"Cái này không được. Trên đó phải có... một hòn đảo của tôi.\", \"rating\": 9.0},\n  {\"id\": 788163, \"suggestedTranslation\": \"Tấm bản đồ này vô dụng. Con cua đó sẽ chỉ chuyển sang hòn đảo khác thôi.\", \"rating\": 9.0},\n  {\"id\": 788164, \"suggestedTranslation\": \"Thử lại đi. Mang cho tôi bản đồ dẫn đến hòn đảo khỉ.\", \"rating\": 9.0},\n  {\"id\": 788165, \"suggestedTranslation\": \"Cái này được đấy. Chỉ chỉnh sửa vài chi tiết nhỏ... Hoàn hảo.\", \"rating\": 9.0},\n  {\"id\": 788166, \"suggestedTranslation\": \"Chạy đi đưa nó cho con cua đó đi.\", \"rating\": 9.0},\n  {\"id\": 788167, \"suggestedTranslation\": \"Đừng mang bản đồ đến nữa! Con cua đó đi mất rồi!\", \"rating\": 9.0},\n  {\"id\": 788168, \"suggestedTranslation\": \"Đây không phải thứ tôi cần. Hãy dùng Thiết Bị Đóng Gói Linh Thể và bắt một thực thể phù hợp.\", \"rating\": 9.0},\n  {\"id\": 788169, \"suggestedTranslation\": \"Không... không. Chúng ta cần một bản đồ để di chuyển con cua đó.\", \"rating\": 9.0},\n  {\"id\": 788170, \"suggestedTranslation\": \"Cái gì thế này? Chúng ta cần bản đồ cho con cua đó cơ mà!\", \"rating\": 9.0},\n  {\"id\": 788171, \"suggestedTranslation\": \"Ở đây đông quá khó làm việc. Tôi sẽ quay lại sau\", \"rating\": 9.0},\n  {\"id\": 788172, \"suggestedTranslation\": \"Không, không phải tôi! Con cua cơ mà! Đưa cho con cua ấy!\", \"rating\": 9.0},\n  {\"id\": 788173, \"suggestedTranslation\": \"Sao cậu lại đưa cái này cho tôi? Nó dành cho con cua kia cơ mà.\", \"rating\": 9.0},\n  {\"id\": 788174, \"suggestedTranslation\": \"Phải rồi. Mẫu vật thứ ba. Tôi có xin thêm một cái nữa phải không nhỉ?\", \"rating\": 9.0},\n  {\"id\": 788175, \"suggestedTranslation\": \"Cậu lề mề lâu quá khiến tôi suýt quên mất!\", \"rating\": 9.0},\n  {\"id\": 788176, \"suggestedTranslation\": \"Để đền bù cho rắc rối của cậu, đây là thành quả nghiên cứu của chúng ta.\", \"rating\": 9.0},\n  {\"id\": 788177, \"suggestedTranslation\": \"Tôi nghĩ việc mang nó xuống kho lưu trữ dưới lòng đất...\", \"rating\": 9.0},\n  {\"id\": 788178, \"suggestedTranslation\": \"Sẽ mang lại nhiều ánh sáng lắm đây.\", \"rating\": 9.0},\n  {\"id\": 788179, \"suggestedTranslation\": \"Giờ thì, nếu cậu không phiền, tôi còn rất nhiều việc phải làm.\", \"rating\": 9.0},\n  {\"id\": 788180, \"suggestedTranslation\": \"Tạm biệt!\", \"rating\": 9.0},\n  {\"id\": 788181, \"suggestedTranslation\": \"Hẹn gặp lại.\", \"rating\": 9.0},\n  {\"id\": 788182, \"suggestedTranslation\": \"Chúc cậu may mắn! Tôi phải đi đây.\", \"rating\": 9.0},\n  {\"id\": 788183, \"suggestedTranslation\": \"Nó có quan trọng không?\", \"rating\": 9.0},\n  {\"id\": 788184, \"suggestedTranslation\": \"Nhanh lên nào, thời điểm rất quan trọng!\", \"rating\": 9.0},\n  {\"id\": 788185, \"suggestedTranslation\": \"Tuyệt vời! Thí nghiệm nhỏ của tôi đã thành công vang dội!\", \"rating\": 9.0},\n  {\"id\": 788186, \"suggestedTranslation\": \"Cảm ơn vì tất cả sự vất vả của cậu.\", \"rating\": 9.0},\n  {\"id\": 788187, \"suggestedTranslation\": \"Điều này sẽ làm tăng công suất đầu ra theo cấp số nhân!\", \"rating\": 9.0},\n  {\"id\": 788188, \"suggestedTranslation\": \"Giờ nếu cậu không phiền, tôi còn rất nhiều việc phải làm.\", \"rating\": 9.0},\n  {\"id\": 788189, \"suggestedTranslation\": \"Cậu và tôi sắp thay đổi thế giới rồi!\", \"rating\": 9.0},\n  {\"id\": 788190, \"suggestedTranslation\": \"Làm tốt lắm!\", \"rating\": 9.0},\n  {\"id\": 788191, \"suggestedTranslation\": \"Nhưng có lẽ thêm một con nữa đi.\", \"rating\": 9.0},\n  {\"id\": 788192, \"suggestedTranslation\": \"Tất nhiên là vì tính chính xác của khoa học rồi.\", \"rating\": 9.0},\n  {\"id\": 788193, \"suggestedTranslation\": \"Cậu hiểu mà.\", \"rating\": 9.0},\n  {\"id\": 788194, \"suggestedTranslation\": \"Thật sáng tỏ! Nó sẽ giúp ích rất nhiều cho nghiên cứu của tôi...\", \"rating\": 9.0},\n  {\"id\": 788195, \"suggestedTranslation\": \"Nếu cậu có thể lặp lại màn trình diễn xuất sắc này...\", \"rating\": 9.0},\n  {\"id\": 788196, \"suggestedTranslation\": \"Với một mẫu vật khác có biểu hiện đột biến tương tự.\", \"rating\": 9.0},\n  {\"id\": 788197, \"suggestedTranslation\": \"Xong rồi!\", \"rating\": 9.0},\n  {\"id\": 788198, \"suggestedTranslation\": \"Cầm lấy cái này đi, cậu sẽ cần nó cho việc chúng ta sắp phải làm.\", \"rating\": 9.0},\n  {\"id\": 788199, \"suggestedTranslation\": \"Vớ vẩn thật! Thiết bị phong tỏa đã hỏng rồi!\", \"rating\": 9.0},\n  {\"id\": 788200, \"suggestedTranslation\": \"Lại phải quay lại với đống ghi chú thôi...\", \"rating\": 9.0},\n  {\"id\": 788201, \"suggestedTranslation\": \"Đủ mấy thứ này rồi.\", \"rating\": 9.0},\n  {\"id\": 788202, \"suggestedTranslation\": \"Chúng ta cần thứ gì đó mạnh mẽ hơn nhiều.\", \"rating\": 9.0},\n  {\"id\": 788203, \"suggestedTranslation\": \"Tự hỏi không biết ta có thể tìm một cái ở đâu nhỉ...\", \"rating\": 9.0},\n  {\"id\": 788204, \"suggestedTranslation\": \"Hừm, có vẻ chúng ta đã chọc giận sinh vật mặt trăng vì thu thập quá nhiều bạn nhỏ của nó.\", \"rating\": 9.0},\n  {\"id\": 788205, \"suggestedTranslation\": \"Cậu! Chắc chắn rồi!\", \"rating\": 9.0},\n  {\"id\": 788206, \"suggestedTranslation\": \"Nhanh lên, cầm lấy mấy cái này!\", \"rating\": 9.0},\n  {\"id\": 788207, \"suggestedTranslation\": \"Chốc nữa tôi sẽ cần chút trợ giúp đấy.\", \"rating\": 9.0},\n  {\"id\": 788208, \"suggestedTranslation\": \"Hãy tìm tôi khi cậu đã chuẩn bị đầy đủ.\", \"rating\": 9.0},\n  {\"id\": 788209, \"suggestedTranslation\": \"Giờ thì, đi tìm nguồn gốc của tín hiệu đó thôi...\", \"rating\": 9.0},\n  {\"id\": 788210, \"suggestedTranslation\": \"Nó ở gần đây lắm rồi...\", \"rating\": 9.0},\n  {\"id\": 788211, \"suggestedTranslation\": \"Nếu tôi chỉ tìm thấy...\", \"rating\": 9.0},\n  {\"id\": 788212, \"suggestedTranslation\": \"Nếu giả thuyết của tôi đúng...\", \"rating\": 9.0},\n  {\"id\": 788213, \"suggestedTranslation\": \"Nó ở đây... đâu đó thôi.\", \"rating\": 9.0},\n  {\"id\": 788214, \"suggestedTranslation\": \"Tôi đã có tất cả dữ liệu cần thiết từ sinh vật này rồi.\", \"rating\": 9.0},\n  {\"id\": 788215, \"suggestedTranslation\": \"Tuy nhiên... tôi cho là mình không thể để nỗ lực của cậu chịu cảnh trắng tay được.\", \"rating\": 9.0},\n  {\"id\": 788216, \"suggestedTranslation\": \"Vẫn đang làm à? Tôi phải khen ngợi sự nhiệt tình nghiên cứu của cậu đấy.\", \"rating\": 9.0},\n  {\"id\": 788217, \"suggestedTranslation\": \"Đây, một chút đóng góp cho việc học tập tiếp tục của cậu.\", \"rating\": 9.0},\n  {\"id\": 788218, \"suggestedTranslation\": \"Tôi e rằng chúng ta chẳng thu được gì thêm từ việc phân tích sinh vật tội nghiệp này đâu.\", \"rating\": 9.0},\n  {\"id\": 788219, \"suggestedTranslation\": \"Nhận lấy cái này đi, coi như món quà thể hiện lòng biết ơn của tôi cho nỗ lực của cậu.\", \"rating\": 9.0},\n  {\"id\": 788220, \"suggestedTranslation\": \"Đừng làm mất thời gian của tôi.\", \"rating\": 9.0},\n  {\"id\": 788221, \"suggestedTranslation\": \"Không không, đó không phải thứ tôi đang tìm!\", \"rating\": 9.0},\n  {\"id\": 788222, \"suggestedTranslation\": \"Cái này không phải, cái kia cơ!\", \"rating\": 9.0},\n  {\"id\": 788223, \"suggestedTranslation\": \"Chết tiệt, tôi mất tín hiệu rồi.\", \"rating\": 9.0},\n  {\"id\": 788224, \"suggestedTranslation\": \"Chắc tôi tính toán sai rồi.\", \"rating\": 9.0},\n  {\"id\": 788225, \"suggestedTranslation\": \"Hãy quay lại tìm tôi khi tôi đã chuẩn bị xong vài thứ.\", \"rating\": 9.0},\n  {\"id\": 788226, \"suggestedTranslation\": \"Tuyệt vời! Đúng như tôi đoán!\", \"rating\": 9.0},\n  {\"id\": 788227, \"suggestedTranslation\": \"Nếu tôi có thể định vị được một cái...\", \"rating\": 9.0},\n  {\"id\": 788228, \"suggestedTranslation\": \"Một mảnh tinh thể, có các thuộc tính chính xác...\", \"rating\": 9.0},\n  {\"id\": 788229, \"suggestedTranslation\": \"Nếu tôi có thể đẩy công suất của nó thêm chút nữa...\", \"rating\": 9.0},\n  {\"id\": 788230, \"suggestedTranslation\": \"Ồ phải rồi, cái này thực sự có tiềm năng đấy, với một thêm thắt nhỏ...\", \"rating\": 9.0},\n  {\"id\": 788231, \"suggestedTranslation\": \"Một cấu trúc tinh thể nhỏ có lẽ sẽ phát huy tác dụng.\", \"rating\": 9.0},\n  {\"id\": 788232, \"suggestedTranslation\": \"Đúng thế, tôi chắc chắn một mảnh tinh thể sẽ hoạt động tốt...\", \"rating\": 9.0},\n  {\"id\": 788233, \"suggestedTranslation\": \"Nếu nó có độ trong suốt phù hợp...\", \"rating\": 9.0},\n  {\"id\": 788234, \"suggestedTranslation\": \"Và hình dạng chính xác...\", \"rating\": 9.0},\n  {\"id\": 788235, \"suggestedTranslation\": \"Và có nguồn gốc từ mặt trăng...\", \"rating\": 9.0},\n  {\"id\": 788236, \"suggestedTranslation\": \"Hừm...\", \"rating\": 9.0},\n  {\"id\": 788237, \"suggestedTranslation\": \"Được rồi đấy, phải phong tỏa nó lại.\", \"rating\": 9.0},\n  {\"id\": 788238, \"suggestedTranslation\": \"Tôi sẽ cần sự trợ giúp của cậu, chúng ta phải phong tỏa nó trước khi nó biến mất!\", \"rating\": 9.0},\n  {\"id\": 788239, \"suggestedTranslation\": \"Vớ vẩn thật, kết nối của tôi đang yếu dần!\", \"rating\": 9.0},\n  {\"id\": 788240, \"suggestedTranslation\": \"À, lối này!\", \"rating\": 9.0},\n  {\"id\": 788241, \"suggestedTranslation\": \"Các kết quả quét của tôi chỉ về hướng này.\", \"rating\": 9.0},\n  {\"id\": 788242, \"suggestedTranslation\": \"Aha, tìm thấy nó lại rồi!\", \"rating\": 9.0},\n  {\"id\": 788243, \"suggestedTranslation\": \"Tôi đang bận một chút vào lúc này.\", \"rating\": 9.0}\n]",
