\": 9.0},\n  {\"id\": 783069, \"suggestedTranslation\": \"Đó là tác phẩm tuyệt vời nhất mà ngươi từng thực hiện,\", \"rating\": 9.0},\n  {\"id\": 783070, \"suggestedTranslation\": \"đã biến tầm nhìn của ta thành hiện thực.\", \"rating\": 9.0},\n  {\"id\": 783071, \"suggestedTranslation\": \"Và chưa từng có tầm nhìn nào vĩ đại hơn\", \"rating\": 9.0},\n  {\"id\": 783072, \"suggestedTranslation\": \"của ngươi bên trong những căn phòng này, Visionist thân mến.\", \"rating\": 9.0},\n  {\"id\": 783073, \"suggestedTranslation\": \"Những vị khách tiếp theo của chúng ta không cần giới thiệu đâu!\", \"rating\": 9.0},\n  {\"id\": 783074, \"suggestedTranslation\": \"Ý hay đấy.\", \"rating\": 9.0},\n  {\"id\": 783075, \"suggestedTranslation\": \"Thế sao chúng ta lại ở đây?\", \"rating\": 9.0},\n  {\"id\": 783076, \"suggestedTranslation\": \"Bọn bay có thắc mắc.\", \"rating\": 9.0},\n  {\"id\": 783077, \"suggestedTranslation\": \"Bọn bay đang tò mò!\", \"rating\": 9.0},\n  {\"id\": 783078, \"suggestedTranslation\": \"Sợ hãi!\", \"rating\": 9.0},\n  {\"id\": 783079, \"suggestedTranslation\": \"Chẳng có gì phải sợ cả...\", \"rating\": 9.0},\n  {\"id\": 783080, \"suggestedTranslation\": \"Ít nhất là khỏi bóng tối.\", \"rating\": 9.0},\n  {\"id\": 783081, \"suggestedTranslation\": \"Bọn bay nên sợ cái gì chứ?\", \"rating\": 9.0},\n  {\"id\": 783082, \"suggestedTranslation\": \"Bóng tối!\", \"rating\": 9.0},\n  {\"id\": 783083, \"suggestedTranslation\": \"Không.\", \"rating\": 9.0},\n  {\"id\": 783084, \"suggestedTranslation\": \"Xin chào, các bạn!\", \"rating\": 9.0},\n  {\"id\": 783085, \"suggestedTranslation\": \"Chính là ánh sáng ma quái chết tiệt của lumin chứ sao!\", \"rating\": 9.0},\n  {\"id\": 783086, \"suggestedTranslation\": \"Chí lí!\", \"rating\": 9.0},\n  {\"id\": 783087, \"suggestedTranslation\": \"Từ quả Cầu Thiên Thể chết tiệt đó!\", \"rating\": 9.0},\n  {\"id\": 783088, \"suggestedTranslation\": \"Ứ! Cầu á!\", \"rating\": 9.0},\n  {\"id\": 783089, \"suggestedTranslation\": \"Phải. \\\"Ứ,\\\" thật đấy!\", \"rating\": 9.0},\n  {\"id\": 783090, \"suggestedTranslation\": \"Chúng ta cũng đến từ cõi riêng của mình.\", \"rating\": 9.0},\n  {\"id\": 783091, \"suggestedTranslation\": \"Bị đe dọa bởi những vị thần khủng khiếp.\", \"rating\": 9.0},\n  {\"id\": 783092, \"suggestedTranslation\": \"Đó là cho đến khi tấm màn êm dịu được phủ lên chúng ta.\", \"rating\": 9.0},\n  {\"id\": 783093, \"suggestedTranslation\": \"Và giờ đây, ba chúng ta đã được tự do!\", \"rating\": 9.0},\n  {\"id\": 783094, \"suggestedTranslation\": \"Tự dooooo!\", \"rating\": 9.0},\n  {\"id\": 783095, \"suggestedTranslation\": \"Ba chúng ta là sứ giả của đấng ban phát u tối.\", \"rating\": 9.0},\n  {\"id\": 783096, \"suggestedTranslation\": \"Bọn bay cũng có thể được giải thoát!\", \"rating\": 9.0},\n  {\"id\": 783097, \"suggestedTranslation\": \"Hu huuu!\", \"rating\": 9.0},\n  {\"id\": 783098, \"suggestedTranslation\": \"Hãy gia nhập với chúng ta dưới tấm màn bảo vệ\", \"rating\": 9.0},\n  {\"id\": 783099, \"suggestedTranslation\": \"bọn bay sẽ không bao giờ phải sợ bóng tối nữa!\", \"rating\": 9.0},\n  {\"id\": 783100, \"suggestedTranslation\": \"Không bao giờ nhóm lửa nữa!\", \"rating\": 9.0},\n  {\"id\": 783101, \"suggestedTranslation\": \"Hay chặt gỗ!\", \"rating\": 9.0},\n  {\"id\": 783102, \"suggestedTranslation\": \"Hay ngủ!\", \"rating\": 9.0},\n  {\"id\": 783103, \"suggestedTranslation\": \"Hay ăn!\", \"rating\": 9.0},\n  {\"id\": 783104, \"suggestedTranslation\": \"Hay chớp mắt!\", \"rating\": 9.0},\n  {\"id\": 783105, \"suggestedTranslation\": \"Bọn bay vẫn có thể chớp mắt.\", \"rating\": 9.0},\n  {\"id\": 783106, \"suggestedTranslation\": \"Ôi... u tối!\", \"rating\": 9.0},\n  {\"id\": 783107, \"suggestedTranslation\": \"Vẫn chớp mắt!\", \"rating\": 9.0},\n  {\"id\": 783108, \"suggestedTranslation\": \"Bọn bay sẽ hòa làm một với màn đêm vĩnh hằng!\", \"rating\": 9.0},\n  {\"id\": 783109, \"suggestedTranslation\": \"Mãi mãi trong vòng tay mờ ảo, ngọt ngào!\", \"rating\": 9.0},\n  {\"id\": 783110, \"suggestedTranslation\": \"Mãi mãi...\", \"rating\": 9.0},\n  {\"id\": 783111, \"suggestedTranslation\": \"trong...\", \"rating\": 9.0},\n  {\"id\": 783112, \"suggestedTranslation\": \"Bóng đêm.\", \"rating\": 9.0},\n  {\"id\": 783113, \"suggestedTranslation\": \"Tối!\", \"rating\": 9.0},\n  {\"id\": 783114, \"suggestedTranslation\": \"Tối lém, đúng vậy!\", \"rating\": 9.0},\n  {\"id\": 783115, \"suggestedTranslation\": \"Chết chóc!\", \"rating\": 9.0},\n  {\"id\": 783116, \"suggestedTranslation\": \"Không chết chóc đâu.\", \"rating\": 9.0},\n  {\"id\": 783117, \"suggestedTranslation\": \"Nhân từ!\", \"rating\": 9.0},\n  {\"id\": 783118, \"suggestedTranslation\": \"Vô cùng nhân từ!\", \"rating\": 9.0},\n  {\"id\": 783119, \"suggestedTranslation\": \"Tại sao nhà viết kịch lại làm tối đèn ở màn đầu tiên chứ?\", \"rating\": 9.0},\n  {\"id\": 783120, \"suggestedTranslation\": \"Điềm báo trước!\", \"rating\": 9.0},\n  {\"id\": 783121, \"suggestedTranslation\": \"\\\"Ca Khúc Về Phong Cảnh\\\"\", \"rating\": 9.0},\n  {\"id\": 783122, \"suggestedTranslation\": \"Ồ, vở này hay đây.\", \"rating\": 9.0},\n  {\"id\": 783123, \"suggestedTranslation\": \"Cái cây đứng một mình.\", \"rating\": 9.0},\n  {\"id\": 783124, \"suggestedTranslation\": \"Trong sự im lặng kiên định.\", \"rating\": 9.0},\n  {\"id\": 783125, \"suggestedTranslation\": \"Chẳng làm cái quái gì cả.\", \"rating\": 9.0},\n  {\"id\": 783126, \"suggestedTranslation\": \"Đó là màn tôi thích nhất từ trước đến giờ.\", \"rating\": 9.0},\n  {\"id\": 783127, \"suggestedTranslation\": \"Bravo! Bravissima!\", \"rating\": 9.0},\n  {\"id\": 783128, \"suggestedTranslation\": \"Và giờ đây, Visionist...\", \"rating\": 9.0},\n  {\"id\": 783129, \"suggestedTranslation\": \"Giám Sát Viên của chúng ta rất kiên định với lý tưởng,\", \"rating\": 9.0},\n  {\"id\": 783130, \"suggestedTranslation\": \"và tôi hoàn toàn đặt niềm tin vào cô ấy\", \"rating\": 9.0},\n  {\"id\": 783131, \"suggestedTranslation\": \"để dẫn dắt chúng ta qua nỗ lực bền bỉ này.\", \"rating\": 9.0},\n  {\"id\": 783132, \"suggestedTranslation\": \"Kẻ Khác sẽ không thể chiến thắng.\", \"rating\": 9.0},\n  {\"id\": 783133, \"suggestedTranslation\": \"Ồ, nhưng hắn sẽ thắng đấy!\", \"rating\": 9.0},\n  {\"id\": 783134, \"suggestedTranslation\": \"Đoán là hắn không thấy trước điều đó rồi.\", \"rating\": 9.0},\n  {\"id\": 783135, \"suggestedTranslation\": \"HA HA HA HA HA!\", \"rating\": 10.0},\n  {\"id\": 783136, \"suggestedTranslation\": \"Visionist? Lão có thấy là chúng ta đang chán không?\", \"rating\": 9.0},\n  {\"id\": 783137, \"suggestedTranslation\": \"HA HA HA HA HA!\", \"rating\": 10.0},\n  {\"id\": 783138, \"suggestedTranslation\": \"Một nhiệm vụ vô cùng khó khăn được đặt ra trước mắt chúng ta,\", \"rating\": 9.0},\n  {\"id\": 783139, \"suggestedTranslation\": \"tuy nhiên ta sẽ thiết kế một cấu trúc phức tạp, rối rắm,\", \"rating\": 9.0},\n  {\"id\": 783140, \"suggestedTranslation\": \"không thể giải nổi bậc nhất mà cõi này từng biết đến.\", \"rating\": 9.0},\n  {\"id\": 783141, \"suggestedTranslation\": \"Vì vinh quang của Nhà Vua và Nữ Hoàng,\", \"rating\": 9.0},\n  {\"id\": 783142, \"suggestedTranslation\": \"vì Vương Quốc của chúng ta,\", \"rating\": 9.0},\n  {\"id\": 783143, \"suggestedTranslation\": \"và vì sự sinh tồn của giống loài chúng ta.\", \"rating\": 9.0},\n  {\"id\": 783144, \"suggestedTranslation\": \"Tôi đang dạy Woby nhiều trò lắm đấy, xem này!\", \"rating\": 9.0},\n  {\"id\": 783145, \"suggestedTranslation\": \"Được rồi Woby... ở yên đấy!\", \"rating\": 9.0},\n  {\"id\": 783146, \"suggestedTranslation\": \"Cô bé ngoan!\", \"rating\": 9.0},\n  {\"id\": 783147, \"suggestedTranslation\": \"Chúng tôi ờ... chúng tôi vẫn đang luyện tập mấy trò còn lại.\", \"rating\": 9.0},\n  {\"id\": 783148, \"suggestedTranslation\": \"Nhưng thế này vẫn khá ấn tượng phải không?\", \"rating\": 9.0},\n  {\"id\": 783149, \"suggestedTranslation\": \"\\\"Cụ già William ơi, ngài đã già,\\\" chàng thanh niên lên tiếng\", \"rating\": 9.0},\n  {\"id\": 783150, \"suggestedTranslation\": \"\\\"Và mái tóc ngài đã bạc trắng phơ;\", \"rating\": 9.0},\n  {\"id\": 783151, \"suggestedTranslation\": \"Thế mà ngài cứ cắm đầu chồng cây chuối mãi—\", \"rating\": 9.0},\n  {\"id\": 783152, \"suggestedTranslation\": \"Ở tuổi của ngài, liệu làm vậy có đúng không?\\\"\", \"rating\": 9.0},\n  {\"id\": 783153, \"suggestedTranslation\": \"\\\"Hồi còn trẻ,\\\" cụ William đáp lời con trai,\", \"rating\": 9.0},\n  {\"id\": 783154, \"suggestedTranslation\": \"\\\"Ta sợ nó sẽ làm tổn thương não bộ; nhưng bây giờ,\", \"rating\": 9.0},\n  {\"id\": 783155, \"suggestedTranslation\": \"khi ta hoàn toàn chắc chắn mình chẳng có cái nào,\", \"rating\": 9.0},\n  {\"id\": 783156, \"suggestedTranslation\": \"Thì ta cứ thế làm lại hết lần này đến lần khác.\\\"\", \"rating\": 9.0},\n  {\"id\": 783157, \"suggestedTranslation\": \"Adieu, patrie!\", \"rating\": 9.0},\n  {\"id\": 783158, \"suggestedTranslation\": \"L'onde est en furie.\", \"rating\": 9.0},\n  {\"id\": 783159, \"suggestedTranslation\": \"Adieu, patrie,\", \"rating\": 9.0},\n  {\"id\": 783160, \"suggestedTranslation\": \"Azur!\", \"rating\": 9.0},\n  {\"id\": 783161, \"suggestedTranslation\": \"Adieu, maison, treille au fruit mûr,\", \"rating\": 9.0},\n  {\"id\": 783162, \"suggestedTranslation\": \"Adieu, les fleurs d'or du vieux mur!\", \"rating\": 9.0},\n  {\"id\": 783163, \"suggestedTranslation\": \"Cảm ơn rất nhiều, các bạn quá khen rồi.\", \"rating\": 9.0},\n  {\"id\": 783164, \"suggestedTranslation\": \"Và bây giờ, ta sẽ lôi những cái bóng hiện thân ra từ cuốn sách huyền bí này!\", \"rating\": 9.0},\n  {\"id\": 783165, \"suggestedTranslation\": \"Buổi diễn trước hay hơn... ừm, trước đây hay hơn.\", \"rating\": 9.0},\n  {\"id\": 783166, \"suggestedTranslation\": \"Hèm! Tụi mình sắp đọc một bài thơ đây!\", \"rating\": 9.0},\n  {\"id\": 783167, \"suggestedTranslation\": \"Cô bé Muffet ngồi trên ghế đẩu,\", \"rating\": 9.0},\n  {\"id\": 783168, \"suggestedTranslation\": \"vừa ăn sữa đông vừa ăn váng sữa.\", \"rating\": 9.0},\n  {\"id\": 783169, \"suggestedTranslation\": \"Bỗng một con Nhện bò đến ngồi cạnh cô bé\", \"rating\": 9.0},\n  {\"id\": 783170, \"suggestedTranslation\": \"Và làm cô bé Muffet sợ chạy mất dép!\", \"rating\": 9.0},\n  {\"id\": 783171, \"suggestedTranslation\": \"\\\"Bạn có muốn bước vào phòng khách của tôi không?\\\"\", \"rating\": 9.0},\n  {\"id\": 783172, \"suggestedTranslation\": \"một con nhện cất lời với chú ruồi;\", \"rating\": 9.0},\n  {\"id\": 783173, \"suggestedTranslation\": \"Đó là phòng khách xinh xắn nhất mà bạn từng thấy đấy.\", \"rating\": 9.0},\n  {\"id\": 783174, \"suggestedTranslation\": \"Đường vào phòng khách của tôi là đi lên một chiếc cầu thang xoắn ốc,\", \"rating\": 9.0},\n  {\"id\": 783175, \"suggestedTranslation\": \"Và tôi có rất nhiều thứ xinh xắn để khoe khi bạn đến đó.\", \"rating\": 9.0},\n  {\"id\": 783176, \"suggestedTranslation\": \"\\\"Ồ không, không!\\\" chú ruồi nhỏ cất lời\", \"rating\": 9.0}\n]",
