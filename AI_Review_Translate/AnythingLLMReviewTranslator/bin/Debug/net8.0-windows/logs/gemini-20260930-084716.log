      "content": {
        "parts": [
          {
            "text": "[\n  {\"id\": 781977, \"suggestedTranslation\": \"\\\"Tôi không lấy làm vui vẻ gì với chuyện này.\\\"\", \"rating\": 9.0},\n  {\"id\": 781978, \"suggestedTranslation\": \"\\\"Abigail và tôi chia sẻ mọi thứ cùng nhau.\\\"\", \"rating\": 9.0},\n  {\"id\": 781979, \"suggestedTranslation\": \"\\\"Hừm... mff! Mmmf!\\\"\", \"rating\": 9.0},\n  {\"id\": 781980, \"suggestedTranslation\": \"\\\"Rồi tất cả chúng ta cũng sẽ trở nên lạnh lùng theo thời gian.\\\"\", \"rating\": 9.0},\n  {\"id\": 781981, \"suggestedTranslation\": \"\\\"Cậu ở đâu vậy Abigail? Tớ cứ nghĩ mình sẽ tìm thấy cậu giữa những vì sao...\\\"\", \"rating\": 9.0},\n  {\"id\": 781982, \"suggestedTranslation\": \"\\\"Thật quyến rũ làm sao...\\\"\", \"rating\": 9.0},\n  {\"id\": 781983, \"suggestedTranslation\": \"\\\"Thật quyến rũ làm sao...\\\"\", \"rating\": 9.0},\n  {\"id\": 781984, \"suggestedTranslation\": \"\\\"Thật quyến rũ làm sao...\\\"\", \"rating\": 9.0},\n  {\"id\": 781985, \"suggestedTranslation\": \"\\\"Khói núi lửa của tôi sẽ bao trùm thế giới trong bóng đêm.\\\"\", \"rating\": 9.0},\n  {\"id\": 781986, \"suggestedTranslation\": \"\\\"Đêm nay hãy còn dài, nhưng chắc là không lâu nữa đâu.\\\"\", \"rating\": 9.0},\n  {\"id\": 781987, \"suggestedTranslation\": \"\\\"Cậu có tin vào các nàng tiên không? Nếu có, hãy vỗ tay nào.\\\"\", \"rating\": 9.0},\n  {\"id\": 781988, \"suggestedTranslation\": \"\\\"Cậu đã bao giờ cảm thấy lạc lõng như một con tàu không nơi neo đậu chưa?\\\"\", \"rating\": 9.0},\n  {\"id\": 781989, \"suggestedTranslation\": \"\\\"Một bông hồng ngọt ngào nhưng ốm yếu, bị hái khi đang độ xuân thì. Tại sao chứ?\\\"\", \"rating\": 9.0},\n  {\"id\": 781990, \"suggestedTranslation\": \"\\\"Một bông hồng ngọt ngào nhưng ốm yếu, bị hái khi đang độ xuân thì. Tại sao chứ?\\\"\", \"rating\": 9.0},\n  {\"id\": 781991, \"suggestedTranslation\": \"\\\"Bóng tối đen như mực, như màn đêm, hay như những cơn ác mộng.\\\"\", \"rating\": 9.0},\n  {\"id\": 781992, \"suggestedTranslation\": \"\\\"Bóng tối đen như mực, như màn đêm, hay như những cơn ác mộng.\\\"\", \"rating\": 9.0},\n  {\"id\": 781993, \"suggestedTranslation\": \"\\\"Tôi tiếp tục cố gắng vì lợi ích của Abigail.\\\"\", \"rating\": 9.0},\n  {\"id\": 781994, \"suggestedTranslation\": \"\\\"Tôi tiếp tục cố gắng vì lợi ích của Abigail.\\\"\", \"rating\": 9.0},\n  {\"id\": 781995, \"suggestedTranslation\": \"\\\"Tôi đang trong nỗi đau buồn sâu sắc nhất...\\\"\", \"rating\": 9.0},\n  {\"id\": 781996, \"suggestedTranslation\": \"\\\"Ta sẽ cố khơi dậy chút không khí lễ hội... nếu buộc phải làm vậy.\\\"\", \"rating\": 9.0},\n  {\"id\": 781997, \"suggestedTranslation\": \"\\\"Chiến đấu cốt ở kỹ thuật thôi, em yêu.\\\"\", \"rating\": 9.0},\n  {\"id\": 781998, \"suggestedTranslation\": \"\\\"Cứ làm theo đúng công thức là được, em yêu.\\\"\", \"rating\": 9.0},\n  {\"id\": 781999, \"suggestedTranslation\": \"\\\"Thỉnh thoảng ta cũng có lúc xõa hết mình đấy.\\\"\", \"rating\": 9.0},\n  {\"id\": 782000, \"suggestedTranslation\": \"\\\"Thỉnh thoảng ta cũng có lúc xõa hết mình đấy.\\\"\", \"rating\": 9.0},\n  {\"id\": 782001, \"suggestedTranslation\": \"\\\"Ôi trời ơi, xem ra anh đã bị tiêu diệt rồi nhỉ.\\\"\", \"rating\": 9.0},\n  {\"id\": 782002, \"suggestedTranslation\": \"\\\"Hừm... mff! Mmmf!\\\"\", \"rating\": 9.0},\n  {\"id\": 782003, \"suggestedTranslation\": \"\\\"Cháu có muốn một chiếc kẹo ngọt không, cưng?\\\"\", \"rating\": 9.0},\n  {\"id\": 782004, \"suggestedTranslation\": \"\\\"Tất cả những gì cần có chỉ là một tia sáng thiên tài.\\\"\", \"rating\": 9.0},\n  {\"id\": 782005, \"suggestedTranslation\": \"\\\"Tất cả những gì cần có chỉ là một tia sáng thiên tài.\\\"\", \"rating\": 9.0},\n  {\"id\": 782006, \"suggestedTranslation\": \"\\\"Tất cả những gì cần có chỉ là một tia sáng thiên tài.\\\"\", \"rating\": 9.0},\n  {\"id\": 782007, \"suggestedTranslation\": \"\\\"Kiến thức về mặt trăng này thực sự rất... mở mang tầm mắt.\\\"\", \"rating\": 9.0},\n  {\"id\": 782008, \"suggestedTranslation\": \"\\\"Hãy chú ý những cục đá mác-ma phun trào của ta nhé, cưng.\\\"\", \"rating\": 9.0},\n  {\"id\": 782009, \"suggestedTranslation\": \"\\\"Ta rất thích một buổi tiệc sang trọng, miễn là nó kết thúc vào một khung giờ hợp lý.\\\"\", \"rating\": 9.0},\n  {\"id\": 782010, \"suggestedTranslation\": \"\\\"Thành thật mà nói, hiểu biết thực tế về thực vật học dược liệu chẳng phải tà thuật gì đâu!\\\"\", \"rating\": 9.0},\n  {\"id\": 782011, \"suggestedTranslation\": \"\\\"Ồ, sự buông thả liều lĩnh của tuổi trẻ. Nghĩ lại thì ta từng có thời viết truyện viễn tưởng...\\\"\", \"rating\": 9.0},\n  {\"id\": 782012, \"suggestedTranslation\": \"\\\"Hãy để việc theo đuổi tri thức vươn xa tới mọi chân trời.\\\"\", \"rating\": 9.0},\n  {\"id\": 782013, \"suggestedTranslation\": \"\\\"Ồ, nhìn thế giới qua chiếc Kính Màu Hồng.\\\"\", \"rating\": 9.0},\n  {\"id\": 782014, \"suggestedTranslation\": \"\\\"Ồ, nhìn thế giới qua chiếc Kính Màu Hồng.\\\"\", \"rating\": 9.0},\n  {\"id\": 782015, \"suggestedTranslation\": \"\\\"Tri thức là sức mạnh!\\\"\", \"rating\": 9.0},\n  {\"id\": 782016, \"suggestedTranslation\": \"\\\"Tri thức là sức mạnh!\\\"\", \"rating\": 9.0},\n  {\"id\": 782017, \"suggestedTranslation\": \"\\\"Phép thuật chẳng qua chỉ là khoa học chưa được phân loại mà thôi.\\\"\", \"rating\": 9.0},\n  {\"id\": 782018, \"suggestedTranslation\": \"\\\"Tôi hy vọng mình không làm vỡ kính.\\\"\", \"rating\": 9.0},\n  {\"id\": 782019, \"suggestedTranslation\": \"\\\"Tôi hy vọng mình không làm vỡ kính.\\\"\", \"rating\": 9.0},\n  {\"id\": 782020, \"suggestedTranslation\": \"\\\"Cần có phép tắc chứ, em yêu.\\\"\", \"rating\": 9.0},\n  {\"id\": 782021, \"suggestedTranslation\": \"\\\"Như thường lệ, trách nhiệm tổ chức lễ hội theo mùa lại thuộc về tôi.\\\"\", \"rating\": 9.0},\n  {\"id\": 782022, \"suggestedTranslation\": \"\\\"Đôi khi những lối mòn cũ cần phải sụp đổ và cháy rụi để nhường chỗ cho cái mới.\\\"\", \"rating\": 9.0},\n  {\"id\": 782023, \"suggestedTranslation\": \"\\\"Tôi tự lo được cho mình.\\\"\", \"rating\": 9.0},\n  {\"id\": 782024, \"suggestedTranslation\": \"\\\"Đồ ăn của tôi lúc nào cũng được nướng cháy hoàn hảo!\\\"\", \"rating\": 9.0},\n  {\"id\": 782025, \"suggestedTranslation\": \"\\\"Tôi không làm thế đâu. Thật đấy.\\\"\", \"rating\": 9.0},\n  {\"id\": 782026, \"suggestedTranslation\": \"\\\"Chà, tôi đang bốc cháy đây! (Không, thật đấy!)\\\"\", \"rating\": 9.0},\n  {\"id\": 782027, \"suggestedTranslation\": \"\\\"Chà, tôi đang bốc cháy đây! (Không, thật đấy!)\\\"\", \"rating\": 9.0},\n  {\"id\": 782028, \"suggestedTranslation\": \"\\\"Chà, tôi đang bốc cháy đây! (Không, thật đấy!)\\\"\", \"rating\": 9.0},\n  {\"id\": 782029, \"suggestedTranslation\": \"\\\"Anh ấy đã chết trước khi kịp nhìn thấy những ngọn lửa đẹp đẽ này.\\\"\", \"rating\": 9.0},\n  {\"id\": 782030, \"suggestedTranslation\": \"\\\"Anh ấy đã chết trước khi kịp nhìn thấy những ngọn lửa đẹp đẽ này.\\\"\", \"rating\": 9.0},\n  {\"id\": 782031, \"suggestedTranslation\": \"\\\"Chơi với lửa thì có ngày bỏng tay.\\\"\", \"rating\": 9.0},\n  {\"id\": 782032, \"suggestedTranslation\": \"\\\"Tại sao cậu lại bỏ rơi tôi?\\\"\", \"rating\": 9.0},\n  {\"id\": 782033, \"suggestedTranslation\": \"\\\"Hừm... mff! Mmmf!\\\"\", \"rating\": 9.0},\n  {\"id\": 782034, \"suggestedTranslation\": \"\\\"Sao đó không phải là một ngọn lửa ấm áp nhỉ?\\\"\", \"rating\": 9.0},\n  {\"id\": 782035, \"suggestedTranslation\": \"\\\"Tôi có hứng nhảy múa quanh đống lửa dưới ánh trăng.\\\"\", \"rating\": 9.0},\n  {\"id\": 782036, \"suggestedTranslation\": \"\\\"Toàn là lửa, lúc nào cũng là lửa!!\\\"\", \"rating\": 9.0},\n  {\"id\": 782037, \"suggestedTranslation\": \"\\\"Những ngọn lửa đã dạy tôi cách khiêu vũ.\\\"\", \"rating\": 9.0},\n  {\"id\": 782038, \"suggestedTranslation\": \"\\\"Những đồng cỏ khô vàng óng, chín muộn để đốt... Ý tôi là để thu hoạch.\\\"\", \"rating\": 9.0},\n  {\"id\": 782039, \"suggestedTranslation\": \"\\\"Nào cơ chứ, cho tôi bắn đại bác đi!\\\"\", \"rating\": 9.0},\n  {\"id\": 782040, \"suggestedTranslation\": \"\\\"Một bông hồng để tượng trưng cho ngọn lửa đam mê.\\\"\", \"rating\": 9.0},\n  {\"id\": 782041, \"suggestedTranslation\": \"\\\"Một bông hồng để tượng trưng cho ngọn lửa đam mê.\\\"\", \"rating\": 9.0},\n  {\"id\": 782042, \"suggestedTranslation\": \"\\\"Bóng tối chẳng qua chỉ là những ngọn lửa bị lật ngược.\\\"\", \"rating\": 9.0},\n  {\"id\": 782043, \"suggestedTranslation\": \"\\\"Bóng tối chẳng qua chỉ là những ngọn lửa bị lật ngược.\\\"\", \"rating\": 9.0},\n  {\"id\": 782044, \"suggestedTranslation\": \"\\\"Ngôi làng đó đã bị đốt trụi trước khi tôi đặt chân tới.\\\"\", \"rating\": 9.0},\n  {\"id\": 782045, \"suggestedTranslation\": \"\\\"Sinh tồn chỉ đòi hỏi sức mạnh ý chí. (Và lửa.)\\\"\", \"rating\": 9.0},\n  {\"id\": 782046, \"suggestedTranslation\": \"\\\"Sinh tồn chỉ đòi hỏi sức mạnh ý chí. (Và lửa.)\\\"\", \"rating\": 9.0},\n  {\"id\": 782047, \"suggestedTranslation\": \"\\\"Thưa ngài, có muốn châm một que diêm không?\\\"\", \"rating\": 9.0},\n  {\"id\": 782048, \"suggestedTranslation\": \"\\\"Đây là thời điểm hoàn hảo trong năm để ngồi trước một đống lửa bập bùng.\\\"\", \"rating\": 9.0},\n  {\"id\": 782049, \"suggestedTranslation\": \"\\\"Này anh bạn! Có muốn cạo râu không?\\\"\", \"rating\": 9.0},\n  {\"id\": 782050, \"suggestedTranslation\": \"\\\"Đây có thể sẽ là thí nghiệm nguy hiểm nhất từ trước đến nay của tôi.\\\"\", \"rating\": 9.0},\n  {\"id\": 782051, \"suggestedTranslation\": \"\\\"Ồ vâng, tôi đang ấp ủ vài thứ đây.\\\"\", \"rating\": 9.0},\n  {\"id\": 782052, \"suggestedTranslation\": \"\\\"Tôi ghét những buổi tiệc tùng.\\\"\", \"rating\": 9.0},\n  {\"id\": 782053, \"suggestedTranslation\": \"\\\"Tôi ghét những buổi tiệc tùng.\\\"\", \"rating\": 9.0},\n  {\"id\": 782054, \"suggestedTranslation\": \"\\\"Tôi có cả trí tuệ VÀ cơ bắp.\\\"\", \"rating\": 9.0},\n  {\"id\": 782055, \"suggestedTranslation\": \"\\\"Hừm... mff! Mmmf!\\\"\", \"rating\": 9.0},\n  {\"id\": 782056, \"suggestedTranslation\": \"\\\"Brrrrr!\\\"\", \"rating\": 9.0},\n  {\"id\": 782057, \"suggestedTranslation\": \"\\\"Vũ trụ chứa đầy những khả năng khoa học vô hạn!\\\"\", \"rating\": 9.0},\n  {\"id\": 782058, \"suggestedTranslation\": \"\\\"Tránh ra nào. Tôi sắp làm KHOA HỌC đây!\\\"\", \"rating\": 9.0},\n  {\"id\": 782059, \"suggestedTranslation\": \"\\\"Tôi đã khai thác được sức mạnh từ tâm trái đất!\\\"\", \"rating\": 9.0},\n  {\"id\": 782060, \"suggestedTranslation\": \"\\\"Tôi đang cảm nhận được sự ăn ý đấy!\\\"\", \"rating\": 9.0},\n  {\"id\": 782061, \"suggestedTranslation\": \"\\\"Thực vật học thực địa không phải chuyên môn của tôi... nhưng tôi đang dần thích nó.\\\"\", \"rating\": 9.0},\n  {\"id\": 782062, \"suggestedTranslation\": \"\\\"Tôi chắc chắn mình có lý do khoa học cho việc này.\\\"\", \"rating\": 9.0},\n  {\"id\": 782063, \"suggestedTranslation\": \"\\\"Tôi chắc chắn mình có lý do khoa học cho việc này.\\\"\", \"rating\": 9.0},\n  {\"id\": 782064, \"suggestedTranslation\": \"\\\"Tôi chắc chắn mình có lý do khoa học cho việc này.\\\"\", \"rating\": 9.0},\n  {\"id\": 782065, \"suggestedTranslation\": \"\\\"Tôi đã khám phá ra rất nhiều thứ trên biển... chẳng hạn như việc tôi rất dễ bị say sóng.\\\"\", \"rating\": 9.0},\n  {\"id\": 782066, \"suggestedTranslation\": \"\\\"Có lẽ tôi sẽ giải nghệ để chuyển sang nghề lai tạo hoa hồng.\\\"\", \"rating\": 9.0},\n  {\"id\": 782067, \"suggestedTranslation\": \"\\\"Có lẽ tôi sẽ giải nghệ để chuyển sang nghề lai tạo hoa hồng.\\\"\", \"rating\": 9.0},\n  {\"id\": 782068, \"suggestedTranslation\": \"\\\"Mwahahaha!\\\"\", \"rating\": 9.0},\n  {\"id\": 782069, \"suggestedTranslation\": \"\\\"Mwahahaha!\\\"\", \"rating\": 9.0},\n  {\"id\": 782070, \"suggestedTranslation\": \"\\\"Không! Ta mới là THIÊN TÀI của ngôi làng!\\\"\", \"rating\": 9.0},\n  {\"id\": 782071, \"suggestedTranslation\": \"\\\"Ở đây chắc chắn có một giải pháp khoa học. Tôi biết mà.\\\"\", \"rating\": 9.0},\n  {\"id\": 782072, \"suggestedTranslation\": \"\\\"Ở đây chắc chắn có một giải pháp khoa học. Tôi biết mà.\\\"\", \"rating\": 9.0},\n  {\"id\": 782073, \"suggestedTranslation\": \"\\\"Gốc rễ của mọi căn bệnh nằm ở sự mất cân bằng dịch cơ thể.\\\"\", \"rating\": 9.0},\n  {\"id\": 782074, \"suggestedTranslation\": \"\\\"Sau vài lần thử nghiệm, tôi đã tìm ra tỷ lệ hoàn hảo giữa trang nghiêm và vui tươi.\\\"\", \"rating\": 9.0},\n  {\"id\": 782075, \"suggestedTranslation\": \"\\\"Có lúc để làm việc, có lúc để nhảy Charleston!\\\"\", \"rating\": 9.0},\n  {\"id\": 782076, \"suggestedTranslation\": \"\\\"Tôi không phải tuýp người thích theo mốt, nhưng cái này có vẻ hơi lỗi thời rồi phải không?\\\"\", \"rating\": 9.0},\n  {\"id\": 782077, \"suggestedTranslation\": \"\\\"Tôi có thể chịu đựng được mọi thứ.\\\"\", \"rating\": 9.0},\n  {\"id\": 782078, \"suggestedTranslation\": \"\\\"Hãy để chị Winnie làm cho cưng món gì đó đặc biệt nhé.\\\"\", \"rating\": 9.0},\n  {\"id\": 782079, \"suggestedTranslation\": \"\\\"Đã đến lúc xắn tay áo lên rồi.\\\"\", \"rating\": 9.0},\n  {\"id\": 782080, \"suggestedTranslation\": \"\\\"Linh hồn của bữa tiệc đã có mặt rồi đây!\\\"\", \"rating\": 9.0},\n  {\"id\": 782081, \"suggestedTranslation\": \"\\\"Linh hồn của bữa tiệc đã có mặt rồi đây!\\\"\", \"rating\": 9.0},\n  {\"id\": 782082, \"suggestedTranslation\": \"\\\"Ha ha! Ta dọa ngươi sợ à?\\\"\", \"rating\": 9.0},\n  {\"id\": 782083, \"suggestedTranslation\": \"\\\"Hình như cô nghĩ mình có cơ hội đấy nhỉ. Để tôi sửa lại điều đó cho.\\\"\", \"rating\": 9.0},\n  {\"id\": 782084, \"suggestedTranslation\": \"\\\"Hì hì, bộ đồ này ngứa ngáy thật đấy.\\\"\", \"rating\": 9.0},\n  {\"id\": 782085, \"suggestedTranslation\": \"\\\"Hì hì, bộ đồ này ngứa ngáy thật đấy.\\\"\", \"rating\": 9.0},\n  {\"id\": 782086, \"suggestedTranslation\": \"\\\"Hì hì, bộ đồ này ngứa ngáy thật đấy.\\\"\", \"rating\": 9.0},\n  {\"id\": 782087, \"suggestedTranslation\": \"\\\"Hừm... mff! Mmmf!\\\"\", \"rating\": 9.0},\n  {\"id\": 782088, \"suggestedTranslation\": \"\\\"Sẽ không có