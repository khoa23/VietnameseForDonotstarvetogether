,\n  {\n    \"id\": 772406,\n    \"suggestedTranslation\": \"Nó có tỷ lệ tạo ra một Dây Leo Ánh Sáng Khiêm Tốn khi va chạm, gây sát thương xuyên giáp lên mục tiêu của bạn.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 772409,\n    \"suggestedTranslation\": \"Nó đánh dấu Quang Thạch Tinh Khiết lên các sinh vật trúng phải, kéo dài trong 30 giây. Dấu ấn này có thể được kích hoạt bởi các đòn tấn công xuyên giáp để gây thêm 5 sát thương xuyên giáp mỗi đòn đánh.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 772495,\n    \"suggestedTranslation\": \"Sát thương từ các vũ khí Sát Thương Xuyên Giáp Bóng Tối sẽ tăng lên theo các đòn đánh liên tiếp nếu bạn tiếp tục tấn công.\\nBị dính đòn sẽ làm đứt chuỗi sát thương này.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 773207,\n    \"suggestedTranslation\": \"Nón Chỉ Huy giờ đây có khả năng chống lại sát thương xuyên giáp.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 773225,\n    \"suggestedTranslation\": \"Nâng cấp Giáo Cổ bằng Bình Nén Tĩnh Điện để gây thêm +20 Sát Thương Xuyên Giáp.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 773235,\n    \"suggestedTranslation\": \"Nhận được một ân huệ thần thánh cung cấp cho bạn +5 Phòng Thủ Xuyên Giáp.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 773264,\n    \"suggestedTranslation\": \"Abigail hòa hợp với năng lượng mặt trăng và nhận được một chút Phòng Thủ Xuyên Giáp.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 773266,\n    \"suggestedTranslation\": \"Wendy có thể chế tạo một Siêu Linh Dược thấm đượm năng lượng mặt trăng giúp Abigail tăng mạnh Sát Thương Xuyên Giáp trong thời gian tác dụng.\\nSiêu Linh Dược hoạt động song song với các Linh Dược thông thường.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 773282,\n    \"suggestedTranslation\": \"Abigail hòa hợp với bóng tối và nhận được một chút Phòng Thủ Xuyên Giáp.\",\n    \"rating\": 1.0\n  },\n  {\n    \"id\": 773310,\n    \"suggestedTranslation\": \"Khẩn cầu mặt trăng tăng cường đòn tấn công và phòng thủ xuyên giáp 