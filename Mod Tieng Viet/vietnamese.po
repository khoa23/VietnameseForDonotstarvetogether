msgstr "Bất cứ ai gây rối với bạn sẽ bị sốc."

#. STRINGS.RECIPE_DESC.WX78_BACKUPBODY
msgctxt "STRINGS.RECIPE_DESC.WX78_BACKUPBODY"
msgid "It never hurts to have spare hardware. Although data transfer is always a pain."
msgstr "Sẽ không bao giờ đau lòng khi có phần cứng dự phòng. Mặc dù việc truyền dữ liệu luôn là một vấn đề khó khăn."

#. STRINGS.RECIPE_DESC.WX78_BACKUPBODY_INVENTORY
msgctxt "STRINGS.RECIPE_DESC.WX78_BACKUPBODY_INVENTORY"
