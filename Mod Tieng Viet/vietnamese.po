msgstr "Err, đó có phải là dấu chân của tôi không? Bắn!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_START_FORK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_START_FORK"
