msgstr "Bị thiêu rụi thành tro bụi rồi."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUMCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUMCHEST.GENERIC"
