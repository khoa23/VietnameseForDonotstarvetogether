msgstr "Phải dọn dẹp trước đã."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.PIGKINGGAME_TOOLATE
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.PIGKINGGAME_TOOLATE"
msgid "Nah. I'll wait until morning."
msgstr "Thôi. Để sáng mai hãy tính."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.QUEENBUSY
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.QUEENBUSY"
msgid "I'll wait, she's got work to do."
msgstr "Tôi sẽ đợi, cô ấy còn việc phải làm."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.SLEEPING"
msgid "They're off the clock."
msgstr "Họ hết giờ làm việc rồi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.SLOTFULL
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.SLOTFULL"
msgid "No sense wasting materials."
msgstr "Phí phạm nguyên liệu chẳng để làm gì."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.SPIDERNOHAT
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.SPIDERNOHAT"
msgid "There just ain't enough space for that."
msgstr "Chẳng có đủ chỗ cho cái đó đâu."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.TERRARIUM_COOLDOWN
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.TERRARIUM_COOLDOWN"
msgid "Guess we gotta wait for the tree to grow back before we can give it anything."
msgstr "Chắc chúng ta phải đợi cái cây mọc lại rồi mới đưa nó gì được."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.TERRARIUM_REFUSE
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.TERRARIUM_REFUSE"
msgid "Maybe I should try powering it up with somethin' else?"
msgstr "Hay là tôi nên thử cấp nguồn cho nó bằng thứ khác nhỉ?"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.WRONGGEM
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.WRONGGEM"
msgid "Nn-nn. That doesn't go there."
msgstr "Không-không. Thứ đó không để ở đó."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.WRONGSHADOWFORM
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.WRONGSHADOWFORM"
msgid "I gotta disassemble it and try again."
msgstr "Tôi phải tháo nó ra rồi làm lại thôi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVEALLTOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVEALLTOPLAYER.BUSY"
msgid "They're busy working."
msgstr "Họ đang bận làm việc."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVEALLTOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVEALLTOPLAYER.DEAD"
msgid "Seems they're dead."
msgstr "Có vẻ họ chết rồi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVEALLTOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVEALLTOPLAYER.FULL"
msgid "They've got their hands full."
msgstr "Họ đang bận rộn không còn tay chân nào."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING"
msgid "They're off the clock."
msgstr "Họ hết giờ làm việc rồi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVETOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVETOPLAYER.BUSY"
msgid "They're busy working."
msgstr "Họ đang bận làm việc."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVETOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVETOPLAYER.DEAD"
msgid "Seems they're dead."
msgstr "Có vẻ họ chết rồi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVETOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVETOPLAYER.FULL"
msgid "I'll hold on to it for now. They're all loaded up."
msgstr "Tôi cứ giữ hộ đã nhé. Họ đầy đồ rồi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVETOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVETOPLAYER.SLEEPING"
msgid "They're off the clock."
msgstr "Họ hết giờ làm việc rồi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE_TACKLESKETCH.DUPLICATE
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE_TACKLESKETCH.DUPLICATE"
msgid "I've already tackled this one."
msgstr "Tôi xử lý cái này xong rồi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.HARVEST.DOER_ISNT_MODULE_OWNER
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.HARVEST.DOER_ISNT_MODULE_OWNER"
msgid "I just thought the lil guy could use a polish."
msgstr "Tôi chỉ nghĩ anh bạn nhỏ này cần được đánh bóng chút thôi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.HEAL.NOT_MERM
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.HEAL.NOT_MERM"
msgid "Sorry, guess it's specially-made for merms."
msgstr "Xin lỗi, hình như nó được làm riêng cho người cá."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.HERD_FOLLOWERS.WEBBERONLY
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.HERD_FOLLOWERS.WEBBERONLY"
msgid "Looks like I'm not the boss here."
msgstr "Xem ra tôi không phải sếp ở đây rồi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.HITCHUP.BEEF_HITCHED
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.HITCHUP.BEEF_HITCHED"
msgid "All hitched up."
msgstr "Đã cột xong hết rồi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.HITCHUP.INMOOD
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.HITCHUP.INMOOD"
msgid "It's too ornery to hitch up."
msgstr "Nó đang khó chiều lắm, chưa cột được đâu."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.HITCHUP.NEEDBEEF
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.HITCHUP.NEEDBEEF"
msgid "I'd better rustle up a beefalo."
msgstr "Tôi tranh thủ đi lùa một con Bò Lai thôi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.HITCHUP.NEEDBEEF_CLOSER
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.HITCHUP.NEEDBEEF_CLOSER"
msgid "I gotta coax my beefalo to come closer."
msgstr "Tôi phải dụ con Bò Lai của mình lại gần hơn."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.LOOKAT.ROSEGLASSES_COOLDOWN
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.LOOKAT.ROSEGLASSES_COOLDOWN"
msgid "Let's take a breather."
msgstr "Nghỉ xả hơi chút nào."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.LOOKAT.ROSEGLASSES_DISMISS
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.LOOKAT.ROSEGLASSES_DISMISS"
msgid "Drat, I lost the trail!"
msgstr "Tiêu rồi, mất dấu rồi!"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.LOOKAT.ROSEGLASSES_INVALID
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.LOOKAT.ROSEGLASSES_INVALID"
msgid "No signs of Charlie."
msgstr "Chẳng có dấu hiệu nào của Charlie cả."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.LOOKAT.ROSEGLASSES_STUMPED
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.LOOKAT.ROSEGLASSES_STUMPED"
msgid "Hmm... I can't tell if Charlie's been here."
msgstr "Hừm... Tôi không biết Charlie có từng ở đây không nữa."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.LOWER_SAIL_FAIL.1
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.LOWER_SAIL_FAIL.1"
msgid "Pretty sure that ain't how that's supposed to go."
msgstr "Chắc chắn là không nên làm thế này rồi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.LOWER_SAIL_FAIL.2
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.LOWER_SAIL_FAIL.2"
msgid "One more time, nice an' easy..."
msgstr "Làm lại phát nữa, thật nhẹ nhàng nào..."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.LOWER_SAIL_FAIL.3
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.LOWER_SAIL_FAIL.3"
msgid "C'mon now, work with me here!"
msgstr "Nào, hợp tác với tôi chút chứ!"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.MARK.ALREADY_MARKED
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.MARK.ALREADY_MARKED"
msgid "This one looks like a winner!"
msgstr "Cái này trông có vẻ là kẻ thắng cuộc!"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.MARK.NOT_PARTICIPANT
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.MARK.NOT_PARTICIPANT"
msgid "Guess I'll wait for the next round."
msgstr "Chắc tôi đợi vòng sau vậy."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.MOUNT.INUSE
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.MOUNT.INUSE"
msgid "Only one to a beef, hey?"
msgstr "Một con bò chỉ chở một người thôi à?"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.MOUNT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.MOUNT.SLEEPING"
msgid "Up and at 'em, big guy!"
