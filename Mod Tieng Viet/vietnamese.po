msgstr "Wolfgang có thể nhét cả phòng tập vào trong luôn ấy chứ!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TREASURECHEST_TRAP
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TREASURECHEST_TRAP"
