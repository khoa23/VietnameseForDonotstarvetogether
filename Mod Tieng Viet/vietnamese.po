msgstr "Tôi không nên lục lọi tủ của người khác."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.RUMMAGE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.RUMMAGE.NOTAROBOT"
