msgstr "Nó ngọt quá!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_ORNAMENT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_ORNAMENT"
msgid "Careful Woby, they're really delicate."
msgstr "Cẩn thận Woby, chúng rất dễ vỡ."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_ORNAMENTBOSS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_ORNAMENTBOSS"
msgid "This one should go someplace special."
msgstr "Cái này nên đặt ở một nơi đặc biệt."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_ORNAMENTFORGE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_ORNAMENTFORGE"
msgid "These ones are my favourite."
msgstr "Những cái này là những cái tôi thích nhất."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_ORNAMENTGORGE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_ORNAMENTGORGE"
msgid "Looks like... a goat person?"
msgstr "Trông giống... một người dê?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_ORNAMENTLIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_ORNAMENTLIGHT"
msgid "I wonder what powers it? Oh well!"
msgstr "Tôi tự hỏi nó có sức mạnh gì? Ồ, thôi đi!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_ORNAMENTPEARL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_ORNAMENTPEARL"
msgid "Aww, can you believe she made this, Woby?"
msgstr "Aww, bạn có tin được cô ấy đã làm được điều này không, Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_TREE.BURNING"
msgid "Quick, put it out! Put it out!"
msgstr "Nhanh, dập nó! Dập nó!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_TREE.BURNT"
msgid "Maybe... we can make another one?"
msgstr "Có lẽ... chúng ta có thể làm một cái khác?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_TREE.CANDECORATE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_TREE.CANDECORATE"
msgid "I'm glad I've got you to spend the holiday with, Woby."
msgstr "Tôi rất vui vì có bạn để cùng kỳ nghỉ, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_TREE.YOUNG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_TREE.YOUNG"
msgid "It'll be fully grown soon."
msgstr "Nó sẽ lớn hoàn toàn sớm."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_TREESTAND.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_TREESTAND.BURNT"
msgid "Maybe... we can make another one?"
msgstr "Có lẽ... chúng ta có thể làm một cái khác?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_TREESTAND.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WINTER_TREESTAND.GENERIC"
msgid "All set up and ready for a tree."
msgstr "Mọi thứ đã sẵn sàng cho một cây."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOBSTER_DEN"
msgid "That's where the Wobsters make camp."
msgstr "Đó là nơi mà các Tôm hùm dựng trại của chúng."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOBSTER_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOBSTER_MOONGLASS"
msgid "There's something different about their shell."
msgstr "Có điều gì đó khác biệt về vỏ của chúng."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOBSTER_SHELLER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOBSTER_SHELLER"
msgid "Shellfish are basically bugs of the sea."
msgstr "Con sò có vỏ chúng cơ bản là côn trùng của biển."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOBSTER_SHELLER_DEAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOBSTER_SHELLER_DEAD"
msgid "Well, at least they'll make a good dinner."
msgstr "Thôi, ít nhất chúng sẽ tạo ra một bữa tối ngon."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOBSTER_SHELLER_DEAD_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOBSTER_SHELLER_DEAD_COOKED"
msgid "Mmm, smells good!"
msgstr "Mmm, mùi thơm quá!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOBYBIG.1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOBYBIG.1"
msgid "Good girl, Woby!"
msgstr "Tốt lắm em, Woby!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOBYBIG.2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOBYBIG.2"
msgid "How could anyone be scared of that face?"
msgstr "Làm thế nào mà mọi người đều sợ cái khuôn mặt đó vậy?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOBYSMALL.1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOBYSMALL.1"
msgid "Good girl, Woby!"
msgstr "Tốt lắm em, Woby!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOBYSMALL.2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOBYSMALL.2"
msgid "What's the matter, girl? Did someone fall down a well?"
msgstr "Có chuyện gì vậy, cô gái? Có ai đó rơi xuống một cái giếng?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOBY_TREAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOBY_TREAT"
msgid "Woby's favourite!"
msgstr "Woby yêu thích!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOLFGANG.ATTACKER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOLFGANG.ATTACKER"
msgid "Y-you stay away!"
msgstr "M-mày tránh xa tau ra!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOLFGANG.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOLFGANG.FIRESTARTER"
msgid "Mr. %s, wait! The fire pit is over THERE!"
msgstr "Ông %s, đợi chút! Lò lửa đây, phải không?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOLFGANG.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOLFGANG.GENERIC"
msgid "Hey Mr. %s!"
msgstr "Chào ông %s!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOLFGANG.GHOST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOLFGANG.GHOST"
msgid "Maybe this will help get over your fear of ghosts! Or not..."
msgstr "Có lẽ điều này sẽ giúp bạn vượt qua nỗi sợ hãi về ma! Hoặc không..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOLFGANG.MURDERER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOLFGANG.MURDERER"
msgid "There's a murderer in our midst, Woby!"
msgstr "Có một kẻ giết người trong số chúng ta, Woby!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOLFGANG.REVIVER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOLFGANG.REVIVER"
msgid "Mr. %s is just a big softy!"
msgstr "Ông %s chỉ là một người dễ tính thôi!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOLFGANG_WHISTLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOLFGANG_WHISTLE"
msgid "We're ready, coach! Right, Woby?"
msgstr "Chúng tôi đã sẵn sàng, huấn luyện viên! Đúng không, Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WONKEY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WONKEY.ATTACKER"
msgid "I don't think that monkey's friendly."
msgstr "Tôi nghĩ con khỉ đó không thân thiện."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WONKEY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WONKEY.FIRESTARTER"
msgid "Who gave the monkey a torch?"
msgstr "Ai cho con khỉ một cái đuốc vậy?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WONKEY.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WONKEY.GENERIC"
msgid "Huh. That monkey seems weirdly familiar..."
msgstr "Hừm. Con khỉ đó dường như quen quen..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WONKEY.GHOST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WONKEY.GHOST"
msgid "Somehow a monkey ghost just isn't as spooky."
msgstr "Dường như một hồn ma con khỉ không có gì đáng sợ lắm."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WONKEY.MURDERER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WONKEY.MURDERER"
msgid "Killer monkey!!"
msgstr "Con khỉ sát thủ!!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WONKEY.REVIVER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WONKEY.REVIVER"
msgid "This is why you should always be kind to animals."
msgstr "Đây là lý do tại sao bạn luôn phải tử tế với động vật."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODCARVEDHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODCARVEDHAT"
msgid "Mr. Woodie said he and Ms. Lucy would teach me how to whittle!"
msgstr "Ông Woodie nói ông và bà Lucy sẽ dạy tôi cách chạm gỗ!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.ATTACKER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.ATTACKER"
msgid "I don't like the way he's gripping that axe..."
msgstr "Tôi không thích cách ông ta nắm chặt cái rìu..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.BEAVER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.BEAVER"
msgid "The Werebeaver! It's real!"
msgstr "Ma hải ly kìa! Nó là thật!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.BEAVERGHOST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.BEAVERGHOST"
msgid "I can see your Canadian spirit! Er... I'll go get a heart."
msgstr "Tôi có thể nhìn thấy tinh thần Canada của bạn! Ồ... tôi sẽ lấy một trái tim."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.FIRESTARTER"
msgid "I thought for sure YOU'D know how to build a campfire!"
msgstr "Tôi nghĩ chắc chắn RỪNG SẼ biết cách xây một lửa trại!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.GENERIC"
msgid "Hey Mr. %s! How's Ms. Lucy?"
msgstr "Chào Ông %s! Bà Lucy thế nào rồi?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.GHOST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.GHOST"
msgid "Don't worry, you'll have a heart in a jiffy!"
msgstr "Đừng lo, bạn sẽ có một trái tim ngay lập tức!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.GOOSE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.GOOSE"
msgid "Mr. %s...? Is that you?"
msgstr "Ông %s...? Đó có phải là ông không?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.GOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.GOOSEGHOST"
msgid "A Pinetree Pioneer is a friend to all woodland creatures! I'll get a heart!"
msgstr "Một Pinetree Pioneer là bạn của tất cả các sinh vật rừng! Tôi sẽ lấy một trái tim!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.MOOSE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.MOOSE"
msgid "There's a Weremoose too?!"
msgstr "Một con ma Ngỗng nữa sao?!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.MOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.MOOSEGHOST"
msgid "Don't worry Mr. %s, Canadians stick together! I'll find you a heart!"
msgstr "Đừng lo Ông %s, người Canada luôn ủng hộ nhau! Tôi sẽ tìm cho bạn một trái tim!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.MURDERER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.MURDERER"
msgid "Really Mr. %s? An axe murderer? At least use some imagination."
msgstr "Thật sao Ông %s? Một kẻ giết người bằng rìu? Ít nhất hãy sử dụng một chút trí tưởng tượng."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.REVIVER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOODIE.REVIVER"
msgid "Us outdoorsy types have each other's backs! Right Mr. %s?"
msgstr "Các anh chị em yêu thích hoạt động ngoài trời luôn ủng hộ nhau! Phải không, ông %s?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOOD_CHAIR.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOOD_CHAIR.BURNT"
msgid "That's why we should never play with matches."
msgstr "Đó là lý do tại sao chúng ta không nên chơi với diêm."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOOD_CHAIR.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOOD_CHAIR.GENERIC"
msgid "Sorry Woby, that's not for you."
msgstr "Xin lỗi Woby, đó không phải dành cho em."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOOD_CHAIR.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOOD_CHAIR.OCCUPIED"
msgid "Sorry Woby, that's not for you."
msgstr "Xin lỗi Woby, đó không phải dành cho em."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOOD_TABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOOD_TABLE.BURNT"
msgid "Someone forgot their fire saftey!"
msgstr "Có ai đó đã quên về an toàn cháy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOOD_TABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOOD_TABLE.GENERIC"
msgid "Woby, no paws on the table!"
msgstr "Woby, đừng để chân trên bàn!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WOOD_TABLE.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WOOD_TABLE.HAS_ITEM"
msgid "Woby, no paws on the table!"
msgstr "Woby, đừng để chân trên bàn!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORM.DIRT"
msgid "Just a pile of dirt."
msgstr "Chỉ là một đống đất."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORM.PLANT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORM.PLANT"
msgid "What's wrong Woby? It's just a plant!"
msgstr "Sao rồi Woby? Chỉ là một cây thôi mà!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORM.WORM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORM.WORM"
msgid "Woah! That worm's enormous!"
msgstr "Ồ! Con giun này khổng lồ quá!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMHOLE.GENERIC"
msgid "It kind of looks like a mouth."
msgstr "Nó trông giống một cái miệng."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMHOLE.OPEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMHOLE.OPEN"
msgid "It IS a mouth!! Come on Woby, let's get a closer look."
msgstr "Nó LÀ một cái miệng!! Đi thôi Woby, chúng ta hãy xem gần hơn."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMHOLE_LIMITED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMHOLE_LIMITED"
msgid "Is it sick?"
msgstr "Nó có bị ốm không?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMLIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMLIGHT"
msgid "We definitely don't have these back home."
msgstr "Chắc chắn là ở nhà chúng tôi không có cái này."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMLIGHT_LESSER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMLIGHT_LESSER"
msgid "More like a glow raisin..."
msgstr "Giống như một quả nho sáng..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMLIGHT_PLANT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMLIGHT_PLANT"
msgid "What's wrong Woby? It's just a plant!"
msgstr "Sao rồi Woby? Chỉ là một cây thôi mà!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD.ATTACKER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD.ATTACKER"
msgid "Wait %s! Me... friend! See?"
msgstr "Chờ đợi %s! Tôi... bạn! Xem nào?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD.FIRESTARTER"
msgid "%s! You're going to start a forest fire that way!"
msgstr "%s! Bạn sẽ gây ra một đám cháy rừng như vậy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD.GENERIC"
msgid "Hi %s!"
msgstr "Chào %s!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD.GHOST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD.GHOST"
msgid "Do you need a heart? You know, uh... ba-bum?"
msgstr "Bạn cần một trái tim không? Bạn biết đấy, uh... ba-bum?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD.MURDERER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD.MURDERER"
msgid "A killer plant! This would make a great Midnight Broadcast episode..."
msgstr "Một cây cỏ giết người! Điều này sẽ làm một tập phim Midnight Broadcast tuyệt vời..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD.REVIVER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD.REVIVER"
msgid "You good plant friend! Much thanks!"
msgstr "Bạn là một người bạn cây tốt! Cảm ơn nhiều!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD"
msgid "Poor little thing."
msgstr "Thứ bé tội nghiệp."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC"
msgid "Vegetables are much more interesting here than back home."
msgstr "Rau củ ở đây thú vị hơn nhiều so với nhà tôi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.HELD"
msgid "Please don't nibble a hole in my pocket."
msgstr "Xin đừng nhấm một lỗ trong túi của tôi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.SLEEPING"
msgid "What do carrots dream about?"
msgstr "Những gì cà rốt mơ về?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC"
msgid "It's a little lizard thing!"
msgstr "Nó là một con thú rắn nhỏ!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.RIPE"
msgid "I could've sworn it was green a second ago."
msgstr "Tôi nghĩ rằng cách đây một giây nó vẫn còn màu xanh."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.SLEEPING"
msgid "They're even cuter when they're sleeping."
msgstr "Họ còn dễ thương hơn khi họ đang ngủ."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD_MUTANTPROXY_LIGHTFLIER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORMWOOD_MUTANTPROXY_LIGHTFLIER"
msgid "I think I have a new favourite kind of bug!"
msgstr "Tôi nghĩ rằng tôi đã có một loại côn trùng yêu thích mới!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORM_BOSS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORM_BOSS"
msgid "A monster worm!"
msgstr "Một con sâu quái vật!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORTOX.ATTACKER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORTOX.ATTACKER"
msgid "Is this one of your pranks?"
msgstr "Đây có phải là một trong những trò đùa của bạn không?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORTOX.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORTOX.FIRESTARTER"
msgid "Well... I guess he IS an imp..."
msgstr "Như vậy... Tôi đoán anh ấy THẬT là một tên quỷ..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORTOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORTOX.GENERIC"
msgid "Hi %s!"
msgstr "Chào %s!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORTOX.GHOST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORTOX.GHOST"
msgid "Does this pose an interesting dilemma for you %s?"
msgstr "Việc này có tạo ra một tình huống khó khăn đối với bạn không %s?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORTOX.MURDERER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORTOX.MURDERER"
msgid "Y-your prank went too far %s!"
msgstr "Trò đùa của bạn... đã đi quá xa %s!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORTOX.REVIVER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORTOX.REVIVER"
msgid "Hey, thanks for not eating my soul %s! Not that I was worried..."
msgstr "Ồ, cảm ơn vì đã không ăn linh hồn của tôi %s! Không phải là tôi lo lắng..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORTOX_NABBAG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORTOX_NABBAG"
msgid "That looks fun to use."
msgstr "Điều đó có vẻ thú vị để sử dụng."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORTOX_REVIVER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORTOX_REVIVER"
msgid "Safety first still, right Woby?"
msgstr "An toàn vẫn là trên hết phải không Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WORTOX_SOULJAR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WORTOX_SOULJAR"
msgid "For a soul collection!"
msgstr "Đối với một bộ sưu tập linh hồn!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WURT.ATTACKER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WURT.ATTACKER"
msgid "She's just doing what comes naturally, I guess."
msgstr "Cô ấy chỉ làm theo bản năng thôi, tôi đoán vậy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WURT.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WURT.FIRESTARTER"
msgid "No, first you clear the area, then arrange the logs like this, then-"
msgstr "Không, trước tiên bạn phải dọn dẹp khu vực, sau đó sắp xếp các đốt gỗ như thế này, sau đó-"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WURT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WURT.GENERIC"
msgid "Hi %s!"
msgstr "Chào %s!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WURT.GHOST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WURT.GHOST"
msgid "Oh boy, what trouble did you get into this time, %s?"
msgstr "Ồ, nguy cơ gì đã xảy ra với bạn lần này, %s?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WURT.MURDERER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WURT.MURDERER"
msgid "Hey %s, no killing people! Killing bad!"
msgstr "Này %s, không được giết người! Giết là xấu!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WURT.REVIVER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WURT.REVIVER"
msgid "Thanks! Uh... florp?"
msgstr "Cảm ơn! Uh... florp?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WURT_SWAMPITEM_LUNAR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WURT_SWAMPITEM_LUNAR"
msgid "It must be some kind of swamp witchcraft!"
msgstr "Chắc là ma thuật đầm lầy gì đó!"

