msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_POST"
msgid "A stake to display my prized steak, non?"
msgstr "Một cái cọc để trưng bày miếng bít tết hảo hạng của tôi, non?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_POST_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_POST_ITEM"
