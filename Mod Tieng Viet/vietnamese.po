msgstr "Sẵn sàng, sẵn sàng, bắt đầu!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CAVEIN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CAVEIN"
