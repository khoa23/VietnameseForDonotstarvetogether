msgstr "Tôi thà không ăn không chúng thế này đâu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "I got no idea what they'd grow into."
msgstr "Tôi chịu chẳng biết chúng sẽ mọc thành cái gì."

