#. STRINGS.SKIN_DESCRIPTIONS.rabbithouse_carrat
msgctxt "STRINGS.SKIN_DESCRIPTIONS.rabbithouse_carrat"
msgid "A cozy abode fashioned after the adorable carrat."
msgstr "Một ngôi nhà ấm cúng được mô phỏng theo chú Cà Ruột đáng yêu."

#. STRINGS.SKIN_DESCRIPTIONS.rabbithouse_hallowed
msgctxt "STRINGS.SKIN_DESCRIPTIONS.rabbithouse_hallowed"
msgid "A resting place for the bunnified."
msgstr "Một nơi nghỉ ngơi cho những kẻ hóa thỏ."

#. STRINGS.SKIN_DESCRIPTIONS.rabbithouse_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.rabbithouse_yule"
msgid "This house turns a classic Winter's Feast tradition on its head!"
msgstr "Ngôi nhà này thổi một luồng gió mới vào truyền thống Đại Tiệc Mùa Đông kinh điển!"

#. STRINGS.SKIN_DESCRIPTIONS.raincoat_poncho
msgctxt "STRINGS.SKIN_DESCRIPTIONS.raincoat_poncho"
msgid "Stay dry while sleuthing."
msgstr "Giữ cho cơ thể khô ráo trong lúc thám thỏm điều tra."

#. STRINGS.SKIN_DESCRIPTIONS.raincoat_western
msgctxt "STRINGS.SKIN_DESCRIPTIONS.raincoat_western"
msgid "Stay one step ahead of the rain."
msgstr "Luôn đi trước cơn mưa một bước."

#. STRINGS.SKIN_DESCRIPTIONS.rainhat_bonnet
msgctxt "STRINGS.SKIN_DESCRIPTIONS.rainhat_bonnet"
msgid "A dear little bonnet to keep your head dry."
msgstr "Một chiếc mũ trùm đầu nhỏ nhắn đáng yêu để giữ khô ráo cho đầu bạn."

#. STRINGS.SKIN_DESCRIPTIONS.rainhat_cowboy
