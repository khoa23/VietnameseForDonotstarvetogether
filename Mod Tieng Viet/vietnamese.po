msgstr "Chết tiệt! Lần sau mình phải nhanh chân hơn mới được!"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CARVEPUMPKIN.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CARVEPUMPKIN.BURNING"
msgid "I'm burnin' up!"
msgstr "Tớ đang cháy tung người lên rồi đây!"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CARVEPUMPKIN.INUSE
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CARVEPUMPKIN.INUSE"
msgid "I'll hafta find another one."
msgstr "Tớ đành phải tìm quả khác vậy."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CASTAOE.CANT_SPELL_MOUNTED
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CASTAOE.CANT_SPELL_MOUNTED"
msgid "only_used_by_willow"
msgstr "chỉ_được_sử_dụng_bởi_willow"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CASTAOE.NOT_ENOUGH_EMBERS
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CASTAOE.NOT_ENOUGH_EMBERS"
msgid "only_used_by_willow"
msgstr "chỉ_được_sử_dụng_bởi_willow"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CASTAOE.NO_BATTERY
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CASTAOE.NO_BATTERY"
msgid "Darn clicker's outta juice."
msgstr "Chết tiệt, cái đồ bấm nút hết pin mất tiêu rồi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CASTAOE.NO_CATAPULTS
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CASTAOE.NO_CATAPULTS"
msgid "Looks like I'm outta range."
msgstr "Có vẻ như tớ đang ở ngoài tầm với rồi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CASTAOE.NO_TARGETS
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CASTAOE.NO_TARGETS"
msgid "only_used_by_willow"
msgstr "chỉ_được_sử_dụng_bởi_willow"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CASTAOE.SPELL_ON_COOLDOWN
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CASTAOE.SPELL_ON_COOLDOWN"
msgid "only_used_by_willow"
msgstr "chỉ_được_sử_dụng_bởi_willow"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CASTSPELL.TERRAFORM_TOO_SOON
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CASTSPELL.TERRAFORM_TOO_SOON"
msgid "only_used_by_wurt"
msgstr "chỉ_được_sử_dụng_bởi_wurt"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CHANGEIN.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CHANGEIN.BURNING"
msgid "Fire in textiles!"
msgstr "Có hỏa hoạn ở khu dệt may rồi!"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CHANGEIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CHANGEIN.GENERIC"
msgid "All a gal needs is a good pair of overalls."
msgstr "Một cô nàng thì chỉ cần một chiếc quần yếm tốt là đủ."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CHANGEIN.INUSE
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CHANGEIN.INUSE"
msgid "Should I put together another one?"
msgstr "Mình có nên làm thêm cái nữa không ta?"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CHANGEIN.NOOCCUPANT
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CHANGEIN.NOOCCUPANT"
msgid "It might work better if I had a beefalo hitched up."
msgstr "Mọi chuyện có lẽ sẽ suôn sẻ hơn nếu tớ gắn kết được một con Bò Lai."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CHANGEIN.NOTENOUGHHAIR
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CHANGEIN.NOTENOUGHHAIR"
msgid "I need more hair to work with."
msgstr "Tớ cần thêm tóc để làm việc đấy."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL"
msgid "We are topped up!"
msgstr "Năng lượng đã đầy bình!"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE"
msgid "Out of juice."
msgstr "Hết pin rồi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.COMPARE_WEIGHABLE.FISH_TOO_SMALL
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.COMPARE_WEIGHABLE.FISH_TOO_SMALL"
msgid "This one's too shrimpy!"
msgstr "Con này quá bé con tôm!"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.COMPARE_WEIGHABLE.OVERSIZEDVEGGIES_TOO_SMALL
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.COMPARE_WEIGHABLE.OVERSIZEDVEGGIES_TOO_SMALL"
msgid "Nah, this one's not quite up to snuff."
msgstr "Không, củ này trông chưa đạt yêu cầu lắm."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CONSTRUCT.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CONSTRUCT.EMPTY"
msgid "I gotta have something to build with."
msgstr "Tớ phải có cái gì đó để xây dựng chứ."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CONSTRUCT.INUSE
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CONSTRUCT.INUSE"
msgid "Aw someone else is building it already."
msgstr "Ôi có người khác đang xây mất rồi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CONSTRUCT.MISMATCH
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CONSTRUCT.MISMATCH"
msgid "Oops! Wrong plans."
msgstr "Úi! Sai bản vẽ mất tiêu rồi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CONSTRUCT.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CONSTRUCT.NOTALLOWED"
msgid "Square peg in a round hole."
msgstr "Cọc vuông nhét vào hố tròn."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CONSTRUCT.NOTREADY
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CONSTRUCT.NOTREADY"
msgid "Maybe once it's settled down around here!"
msgstr "Chắc là đợi khi nào ở đây yên ắng trở lại đã!"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.COOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.COOK.GENERIC"
msgid "I'm not really in a cooking mood."
msgstr "Tớ hiện không có hứng nấu nướng cho lắm."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.COOK.INUSE
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.COOK.INUSE"
msgid "How's the grub coming?"
msgstr "Món con Sâu tới đâu rồi?"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.COOK.TOOFAR
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.COOK.TOOFAR"
msgid "I gotta get closer. Or grow longer arms."
msgstr "Tớ phải đến gần hơn. Hoặc là mọc thêm tay dài ra."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.DECORATESNOWMAN.HASHAT
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.DECORATESNOWMAN.HASHAT"
msgid "I ain't gonna stack it on the hat."
msgstr "Tớ không định chất đống nó lên trên cái mũ đâu."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.DECORATESNOWMAN.INUSE
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.DECORATESNOWMAN.INUSE"
msgid "It's gettin' built already."
msgstr "Đang được xây dựng rồi kìa."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.DECORATESNOWMAN.MELTING
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.DECORATESNOWMAN.MELTING"
msgid "Ain't nothin' gonna stick to a melting snowman."
msgstr "Chẳng có cái gì dính được vào một con người tuyết đang tan chảy đâu."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.DECORATESNOWMAN.STACKEDTOOHIGH
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.DECORATESNOWMAN.STACKEDTOOHIGH"
msgid "That's a tall drink of ice water."
msgstr "Đúng là một ly nước đá mát lạnh sảng khoái."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.DEPLOY.HERMITCRAB_RELOCATE
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.DEPLOY.HERMITCRAB_RELOCATE"
msgid "Empty. I'll try again later."
msgstr "Trống. Để lát tôi thử lại."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.DISMANTLE.COOKING
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.DISMANTLE.COOKING"
msgid "I'm all for striking while the iron's hot, but..."
msgstr "Tôi rất thích chớp thời cơ khi còn nóng, nhưng mà..."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.DISMANTLE.INUSE
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.DISMANTLE.INUSE"
msgid "No rush."
msgstr "Không vội."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.DISMANTLE.NOTEMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.DISMANTLE.NOTEMPTY"
msgid "Better clear it out first."
msgstr "Lo dọn sạch nó trước đã thì hơn."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.DIVEGRAB.MISSED
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.DIVEGRAB.MISSED"
msgid "Dang, missed!"
msgstr "Đáng tiếc, hụt mất!"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.DRAW.NOIMAGE
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.DRAW.NOIMAGE"
msgid "I'm not much of an artist."
msgstr "Tôi không phải nghệ sĩ gì cho cam."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.FILL_OCEAN.UNSUITABLE_FOR_PLANTS
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.FILL_OCEAN.UNSUITABLE_FOR_PLANTS"
msgid "I've got a hunch that'll be bad for the plants."
msgstr "Tôi có linh cảm việc đó không tốt cho đám cây cối đâu."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.FISH_OCEAN.TOODEEP
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.FISH_OCEAN.TOODEEP"
msgid "I'll need a tougher rod to reel in one of those whoppers!"
msgstr "Tôi sẽ cần một chiếc cần khỏe hơn để câu con cá khủng đó!"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GENERIC.ITEMMIMIC
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GENERIC.ITEMMIMIC"
msgid "I knew it felt funny."
msgstr "Tôi biết có gì đó không ổn rồi mà."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.ABIGAILHEART
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.ABIGAILHEART"
msgid "No one should ever lose a sister."
msgstr "Không ai nên phải mất đi một người chị em cả."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.BUSY
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.BUSY"
msgid "They're busy working."
msgstr "Họ đang bận làm việc."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.CANTSHADOWREVIVE
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.CANTSHADOWREVIVE"
msgid "Don't think that'll work."
msgstr "Không nghĩ là cách đó sẽ hiệu quả đâu."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.CARNIVALGAME_ALREADY_PLAYING
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.CARNIVALGAME_ALREADY_PLAYING"
msgid "I can wait until they're done."
msgstr "Tôi có thể đợi đến khi họ xong việc."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.CARNIVALGAME_GOLFGAME_NOTREADY
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.CARNIVALGAME_GOLFGAME_NOTREADY"
msgid "The course ain't set up yet!"
msgstr "Sân chơi vẫn chưa được dựng lên mà!"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.CARNIVALGAME_INVALID_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.CARNIVALGAME_INVALID_ITEM"
msgid "Guess it doesn't want that."
msgstr "Chắc là nó không nhận món đó đâu."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.DEAD"
msgid "They appear to be dead. Very dead."
msgstr "Trông họ có vẻ đã chết. Chết hẳn luôn rồi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.DUPLICATE
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.DUPLICATE"
msgid "We already got these schematics."
msgstr "Chúng ta có bản vẽ này rồi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.FOODFULL
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.FOODFULL"
msgid "Ah, a wonderful bird, the peli-can."
msgstr "À, một loài chim tuyệt vời, chim bồ nông."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.GENERIC"
msgid "That ain't right."
msgstr "Cái đó không đúng rồi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.GHOSTHEART
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.GHOSTHEART"
msgid "Some things even I can't fix."
msgstr "Có những thứ ngay cả tôi cũng không sửa nổi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG"
msgid "It needs something else."
msgstr "Nó cần thứ khác cơ."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM"
msgid "It doesn't need this."
msgstr "Nó đâu cần thứ này."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.MUSHROOMFARM_NOMOONALLOWED
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.MUSHROOMFARM_NOMOONALLOWED"
msgid "No amount of elbow grease is gonna make these things grow."
msgstr "Bao nhiêu công sức cũng chẳng làm đám này mọc lên được đâu."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.NOGENERATORSKILL
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.NOGENERATORSKILL"
msgid "I'm sure it can be done, with the right know-how."
msgstr "Tôi chắc là làm được thôi, miễn là có đúng kỹ thuật."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.NOMOON
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.NOMOON"
msgid "Gonna have to make this under the influence of the moon."
msgstr "Chắc phải làm cái này dưới ánh trăng thôi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.NOTAMONKEY
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.NOTAMONKEY"
msgid "I can't make sense of all yer hollerin'!"
msgstr "Tôi chẳng hiểu mấy tiếng la hét của các người đâu!"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.NOTDISH
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.NOTDISH"
msgid "I don't wanna go angering no demons."
msgstr "Tôi không muốn dây dưa chọc giận ác ma nào đâu."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.NOTGEM
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.NOTGEM"
msgid "What sort of worker do you take me for?"
msgstr "Cậu coi tôi là thợ kiểu gì thế?"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.NOTSCULPTABLE
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.NOTSCULPTABLE"
msgid "That ain't for sculpting."
msgstr "Cái đó không dùng để điêu khắc được."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.NOTSTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.NOTSTAFF"
msgid "It doesn't fit together like that."
msgstr "Nó không khớp với nhau theo cách đó đâu."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER"
msgid "Nah. It ain't safe for that now."
msgstr "Không. Bây giờ để Két Sắt thì không an toàn đâu."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.PIGKINGGAME_MESSY
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVE.PIGKINGGAME_MESSY"
