msgstr "Ngươi không nghiền nát được Wolfgang đâu!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TREE_ROCK.CHOPPED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TREE_ROCK.CHOPPED"
