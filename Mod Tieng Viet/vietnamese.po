msgstr "Quái vật! Kẻ giết người! ĐỐT CHÁY!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WORTOX.REVIVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WORTOX.REVIVER"
msgid "I guess %s isn't all mischief."
msgstr "Tôi đoán %s không phải hoàn toàn là trò nghịch ngợm."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WORTOX_NABBAG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WORTOX_NABBAG"
msgid "My stuff better not be in there."
msgstr "Tốt nhất là đồ của tôi không nên ở trong đó."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WORTOX_REVIVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WORTOX_REVIVER"
msgid "I guess it makes dying less inconvenient."
msgstr "Tôi đoán nó làm cho việc chết bớt bất tiện hơn."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WORTOX_SOULJAR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WORTOX_SOULJAR"
