msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_BEEFALO_DOLL_ROBOT.YOTB"
msgid "This might be of interest to the judge."
msgstr "Cái này có lẽ sẽ lọt vào mắt xanh của vị quan tòa đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_BEEFALO_DOLL_VICTORIAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_BEEFALO_DOLL_VICTORIAN.GENERIC"
msgid "I've no need for such things."
msgstr "Ta chẳng cần mấy thứ này."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_BEEFALO_DOLL_VICTORIAN.YOTB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_BEEFALO_DOLL_VICTORIAN.YOTB"
msgid "This might be of interest to the judge."
msgstr "Cái này có lẽ sẽ lọt vào mắt xanh của vị quan tòa đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_BEEFALO_DOLL_WAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_BEEFALO_DOLL_WAR.GENERIC"
msgid "I've no need for such things."
msgstr "Ta chẳng cần mấy thứ này."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_BEEFALO_DOLL_WAR.YOTB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_BEEFALO_DOLL_WAR.YOTB"
msgid "This might be of interest to the judge."
msgstr "Cái này có lẽ sẽ lọt vào mắt xanh của vị quan tòa đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_PATTERN_FRAGMENT_1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_PATTERN_FRAGMENT_1"
msgid "I'll have to combine them before they'll reveal their secrets."
msgstr "Ta phải kết hợp chúng lại trước khi chúng chịu hé lộ bí mật."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_PATTERN_FRAGMENT_2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_PATTERN_FRAGMENT_2"
msgid "I'll have to combine them before they'll reveal their secrets."
msgstr "Ta phải kết hợp chúng lại trước khi chúng chịu hé lộ bí mật."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_PATTERN_FRAGMENT_3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_PATTERN_FRAGMENT_3"
msgid "I'll have to combine them before they'll reveal their secrets."
msgstr "Ta phải kết hợp chúng lại trước khi chúng chịu hé lộ bí mật."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_POST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_POST"
msgid "Enjoy your time in the spotlight while you can."
msgstr "Hãy tận hưởng ánh hào quang khi còn có thể đi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_POST_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_POST_ITEM"
msgid "This seems like a dreadful amount of effort."
msgstr "Trông có vẻ tốn khối công sức đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_SEWINGMACHINE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_SEWINGMACHINE"
msgid "I'm more of an appreciator of fine clothes than a maker of them."
msgstr "Ta hợp với việc thưởng thức trang phục đẹp hơn là ngồi may vá."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_SEWINGMACHINE_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_SEWINGMACHINE_ITEM"
msgid "Why must these things come unassembled?"
msgstr "Sao mấy thứ này cứ phải tháo rời ra thế nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_STAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_STAGE"
msgid "Hmph. What makes him think he's qualified to pass judgement?"
msgstr "Hừ. Gã lấy tự tin ở đâu mà nghĩ mình đủ tư cách phán xét chứ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_STAGE_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_STAGE_ITEM"
msgid "Oh good, something more to build."
msgstr "Ôi tốt quá, lại có thêm việc để lắp ráp rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRATSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRATSHRINE.BURNT"
msgid "It's of no use to me like this."
msgstr "Thế này thì chẳng dùng được tích sự gì nữa rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRATSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRATSHRINE.EMPTY"
msgid "It requires an offering."
msgstr "Nó cần có vật tế lễ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRATSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRATSHRINE.GENERIC"
msgid "It's ready."
msgstr "Nó sẵn sàng rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT"
msgid "Useless."
msgstr "Vô tích sự."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC"
msgid "An underling must be able to follow directions."
msgstr "Cấp dưới thì phải biết tuân theo chỉ dẫn chứ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT"
msgid "The training seems to be progressing well."
msgstr "Việc huấn luyện có vẻ đang tiến triển tốt."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM"
msgid "My Carrat requires some direction."
msgstr "Con Cà Ruột của ta cần phải được định hướng thêm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT"
msgid "Useless."
msgstr "Vô tích sự."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC"
msgid "You never know what might pop up on the race track."
msgstr "Bạn không bao giờ biết được điều gì sẽ xuất hiện trên đường đua đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT"
msgid "Hm. I'm getting a sudden craving for popcorn..."
msgstr "Hừ. Tự dưng ta thấy thèm bắp ngô rang quá..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM"
msgid "It would be prudent to place this somewhere."
msgstr "Tốt nhất là nên đặt cái này ở đâu đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT"
msgid "Useless."
msgstr "Vô tích sự."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC"
msgid "Athletics were never my strong suit."
msgstr "Thể thao chưa bao giờ là sở trường của ta cả."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT"
msgid "It's rather amusing to watch it scurry."
msgstr "Xem nó chạy lon ton cũng khá thú vị đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM"
msgid "I should construct this, posthaste."
msgstr "Ta nên dựng cái này lên ngay lập tức."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT"
msgid "Useless."
msgstr "Vô tích sự."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC"
msgid "An exercise machine... the most dastardly of inventions."
msgstr "Máy tập thể dục... phát minh tàn độc nhất quả đất."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT"
msgid "You will thank me for making you stronger."
msgstr "Ngươi sẽ phải cảm ơn ta vì đã làm cho ngươi khỏe hơn đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM"
msgid "I tire of lugging this around."
msgstr "Ta chán ngấy cảnh phải lôi kéo cái thứ này đi quanh đây rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT"
msgid "These posts will serve as adequate route markers."
msgstr "Những cây cột này sẽ làm mốc chỉ đường khá tốt đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM"
msgid "The dumb little creatures would be lost without them."
msgstr "Mấy sinh vật ngốc nghếch này mà không có chúng thì thể nào cũng lạc đường."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT"
msgid "I've no use for it anymore."
msgstr "Ta chẳng còn dùng đến nó nữa rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC"
msgid "Such frivolity."
msgstr "Thật là phù phiếm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON"
msgid "I'd almost forgotten the sweet taste of victory."
msgstr "Gần như ta đã quên mất hương vị ngọt ngào của chiến thắng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON"
msgid "{winner}'s racer was... superior to mine..."
msgstr "Tay đua của {winner}... vượt trội hơn hẳn của ta..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM"
msgid "End of the line, pal."
msgstr "Hết đường rồi nhé, bạn hiền."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_START
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_START"
msgid "I suppose this is what I must do for entertainment now."
msgstr "Ta đoán đây là những gì mình phải làm để giải trí vào lúc này."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM"
msgid "Might as well start things off with a bang. Or a gong."
msgstr "Hay là bắt đầu với một tiếng nổ nhỉ. Hoặc là tiếng cồng cũng được."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_SCALE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_SCALE.BURNT"
msgid "It's worthless now."
msgstr "Bây giờ nó vô giá trị rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT"
msgid "A disappointing performance."
msgstr "Một màn thể hiện thật thất vọng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD"
msgid "Excellent. You've done well."
msgstr "Tuyệt vời. Ngươi làm tốt lắm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC"
msgid "I will only accept the finest Carrat."
msgstr "Ta chỉ nhận loại Cà Ruột xuất sắc nhất thôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_SCALE_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_SCALE_ITEM"
msgid "It seems some assembly is required."
msgstr "Có vẻ như cần phải lắp ráp một chút."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_SEEDPACKET"
msgid "I will reap what I sow."
msgstr "Gieo nhân nào gặt quả nấy thôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_SEEDPACKET_RARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_SEEDPACKET_RARE"
msgid "This should yield a higher quality crop."
msgstr "Cái này chắc sẽ cho ra cây trồng chất lượng cao hơn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTD_ANCHOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTD_ANCHOR"
msgid "Such exquisite craftsmanship. Into the water it goes."
msgstr "Đồ thủ công tinh xảo thật. Cho xuống nước luôn nào."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTD_ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTD_ANCHOR_ITEM"
msgid "Can't someone else assemble it?"
msgstr "Không có ai khác lắp ráp hộ à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTD_DRAGONSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTD_DRAGONSHRINE.BURNT"
msgid "Move along. Show's over."
msgstr "Đi chỗ khác chơi đi. Hết diễn rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY"
msgid "Charcoal? How imaginative."
msgstr "Than? Thật là giàu trí tưởng tượng làm sao."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC"
msgid "Great."
msgstr "Tuyệt vời."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTD_OAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTD_OAR"
msgid "Must I?"
msgstr "Ta bắt buộc phải làm thế á?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTD_STEERINGWHEEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTD_STEERINGWHEEL"
msgid "That's the place for the person in charge. Me."
msgstr "Đó là chỗ dành cho người lãnh đạo. Chính là ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTD_STEERINGWHEEL_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTD_STEERINGWHEEL_ITEM"
msgid "Hard labor? Isn't that Winona's forte?"
msgstr "Lao động chân tay á? Chẳng phải đó là sở trường của Winona sao?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTH_CHAIR_ROCKING_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTH_CHAIR_ROCKING_ITEM"
msgid "Amusing, perhaps. Still the thought of sitting..."
msgstr "Chắc cũng thú vị đấy. Chỉ là nghĩ đến chuyện ngồi thôi mà..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTH_KNIGHTHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTH_KNIGHTHAT"
msgid "Decent helmet, even with the horseface."
msgstr "Mũ giáp được đấy, dù có cái mặt ngựa trông hơi ngớ ngẩn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTH_KNIGHTSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTH_KNIGHTSHRINE.BURNT"
msgid "I was never that into horses."
msgstr "Ta vốn chẳng mê ngựa miếc gì cho cam."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTH_KNIGHTSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTH_KNIGHTSHRINE.EMPTY"
msgid "Nothing is free in this world."
msgstr "Trên đời này chẳng có gì là miễn phí cả."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTH_KNIGHTSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTH_KNIGHTSHRINE.GENERIC"
msgid "Well?"
msgstr "Sao nào?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTH_KNIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTH_KNIGHTSTICK"
msgid "But I still have to use my own legs?"
msgstr "Nhưng mà ta vẫn phải dùng đôi chân của mình á?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTH_LANCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTH_LANCE"
msgid "I suppose that's the stabbing end."
msgstr "Ta đoán cái đó là để đâm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTP_FOOD1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTP_FOOD1"
msgid "Ah. I do enjoy a nice meal."
msgstr "À. Ta rất thích một bữa ăn ngon."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTP_FOOD2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTP_FOOD2"
msgid "Ugh. More fit for a creature than for me."
msgstr "Ugh. Món này hợp cho loài thú hơn là cho ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTP_FOOD3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTP_FOOD3"
msgid "Nothing fancy, but it will do."
msgstr "Chẳng có gì đặc biệt, nhưng tạm ổn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_DECOR_1.GENERAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_DECOR_1.GENERAL"
msgid "Such unrefined decor."
msgstr "Đồ trang trí thô kệch làm sao."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_DECOR_1.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_DECOR_1.OUT"
msgid "Now it's not even useful."
msgstr "Giờ thì đến ích lợi cũng chẳng còn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_DECOR_1_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_DECOR_1_ITEM"
msgid "Someone should set that up."
msgstr "Ai đó nên dựng cái đó lên đi chứ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_DECOR_2.GENERAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_DECOR_2.GENERAL"
msgid "Such unrefined decor."
msgstr "Đồ trang trí thô kệch làm sao."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_DECOR_2.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_DECOR_2.OUT"
msgid "Now it's not even useful."
msgstr "Giờ thì đến ích lợi cũng chẳng còn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_DECOR_2_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_DECOR_2_ITEM"
msgid "Someone should set that up."
msgstr "Ai đó nên dựng cái đó lên đi chứ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_FIGHTRING_BELL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_FIGHTRING_BELL.GENERIC"
msgid "Absolutely not."
msgstr "Tuyệt đối không."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_FIGHTRING_BELL.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_FIGHTRING_BELL.PLAYING"
msgid "I do enjoy watching people make fools of themselves."
msgstr "Ta thực sự thích thú khi nhìn thiên hạ tự làm trò hề cho mình đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_FIGHTRING_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_FIGHTRING_KIT"
msgid "Surely that's a job for someone else?"
msgstr "Chắc chắn đó là việc của người khác rồi phải không?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_FOOD1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_FOOD1"
msgid "Cake shaped like a rabbit, how novel."
msgstr "Bánh ngọt hình con thỏ, thật mới lạ làm sao."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_FOOD2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_FOOD2"
msgid "What a mysterious flavor."
msgstr "Thật là một hương vị huyền bí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_FOOD3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_FOOD3"
msgid "A small piece of fruit, imprisoned in gelatin."
msgstr "Một miếng trái cây nhỏ bị giam cầm trong thạch."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_FOOD4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_FOOD4"
msgid "Far too sticky for my liking."
msgstr "Quá dính dấp so với sở thích của ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_RABBITSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_RABBITSHRINE.BURNT"
msgid "A pity."
msgstr "Thật đáng tiếc."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_RABBITSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_RABBITSHRINE.EMPTY"
msgid "It requires an offering."
msgstr "Nó cần phải có vật tế lễ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_RABBITSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_RABBITSHRINE.GENERIC"
msgid "What do you have in store for me?"
msgstr "Ngươi chuẩn bị mang lại điều gì cho ta đây?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_TOKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTR_TOKEN"
msgid "Care for a gentleman's duel?"
msgstr "Có hứng thú với một trận đấu tay đôi quý tộc không?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTS_LANTERN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTS_LANTERN_POST.BURNT"
msgid "What a waste."
msgstr "Thật là lãng phí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTS_LANTERN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTS_LANTERN_POST.GENERIC"
msgid "Nice post."
msgstr "Cột đẹp đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTS_LANTERN_POST_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTS_LANTERN_POST_ITEM"
msgid "I have to do everything!"
msgstr "Việc gì ta cũng phải nhúng tay vào hết!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTS_SNAKESHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTS_SNAKESHRINE.BURNT"
msgid "My money is on Little Miss Pyro."
msgstr "Ta đặt cược vào Tiểu thư Pháo hoa đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTS_SNAKESHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTS_SNAKESHRINE.EMPTY"
msgid "Greedy little worm, aren't you?"
msgstr "Con sâu tham lam, ngươi chưa thấy đủ à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTS_SNAKESHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTS_SNAKESHRINE.GENERIC"
msgid " Happy now? What do I get?"
msgstr "Vừa lòng chưa? Giờ ta được cái gì nào?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTS_WORM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTS_WORM"
msgid "What are you doing up here?"
msgstr "Ngươi làm gì mà bò lên tận đây thế này?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOT_CATCOONSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOT_CATCOONSHRINE.BURNT"
msgid "Seems not everyone appreciates the little thieves."
msgstr "Có vẻ không phải ai cũng ưa nổi mấy tên trộm vặt này."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOT_CATCOONSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOT_CATCOONSHRINE.EMPTY"
msgid "It seems we're supposed to offer it something."
msgstr "Có vẻ chúng ta phải cúng tế cho nó thứ gì đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOT_CATCOONSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOT_CATCOONSHRINE.GENERIC"
msgid "I suppose even a thief has its admirers."
msgstr "Ta đoán ngay cả một tên trộm thì cũng có kẻ hâm mộ của riêng nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE_GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE_GENERIC"
msgid "You tell me."
msgstr "Cứ nói cho ta nghe xem nào."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE_PLANTHAPPY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE_PLANTHAPPY"
msgid "It seems reasonably healthy."
msgstr "Trông có vẻ khỏe mạnh hợp lý đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE_PLANTSTRESSED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE_PLANTSTRESSED"
msgid "Everyone's got problems, pal."
msgstr "Ai mà chẳng có rắc rối của riêng mình, bạn hiền."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE_PLANTSTRESSORFAMILY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE_PLANTSTRESSORFAMILY"
msgid "It needs to be surrounded by others of its ilk."
msgstr "Nó cần phải được vây quanh bởi những loài cây cùng loại."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE_PLANTSTRESSORHAPPINESS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE_PLANTSTRESSORHAPPINESS"
msgid "I'd better have a word with that underperforming plant..."
msgstr "Ta phải có đôi lời với cái cây kém cỏi này mới được..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE_PLANTSTRESSORKILLJOYS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE_PLANTSTRESSORKILLJOYS"
msgid "Maybe if the garden wasn't filled with weeds..."
msgstr "Ước gì khu vườn này không mọc đầy cỏ dại..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE_PLANTSTRESSORMOISTURE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE_PLANTSTRESSORMOISTURE"
msgid "It needs water again? Ugh, the toiling never ends."
msgstr "Lại cần nước nữa à? Chà, việc đồng áng đúng là không bao giờ kết thúc."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE_PLANTSTRESSORNUTRIENTS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE_PLANTSTRESSORNUTRIENTS"
msgid "Richer soil might be needed."
msgstr "Có lẽ cần đất màu mỡ hơn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE_PLANTSTRESSOROVERCROWDING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE_PLANTSTRESSOROVERCROWDING"
msgid "The garden might be overcrowded. Perhaps I should thin it out a bit."
msgstr "Khu vườn có lẽ bị quá tải rồi. Chắc ta nên tỉa bớt đi một chút."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE_PLANTSTRESSORSEASON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE_PLANTSTRESSORSEASON"
msgid "The weather is too harsh for it."
msgstr "Thời tiết quá khắc nghiệt đối với nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE_PLANTVERYSTRESSED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE_PLANTVERYSTRESSED"
msgid "Just what do you have to be upset about?"
msgstr "Ngươi thì có cái quái gì mà phải khó chịu cơ chứ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE_SMOLDERING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE_SMOLDERING"
msgid "Won't be long before it lights on fire."
msgstr "Chẳng mấy chốc nữa là nó bén lửa cho xem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE_TOODARK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE_TOODARK"
msgid "I can't see in the dark!"
msgstr "Ta không thể nhìn thấy gì trong bóng tối!"

#. STRINGS.CHARACTERS.WAXWELL.EAT_FOOD.TALLBIRDEGG_CRACKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.EAT_FOOD.TALLBIRDEGG_CRACKED"
msgid "That tasted about as good as you'd expect."
msgstr "Mùi vị của nó đúng như những gì ngươi có thể tưởng tượng đấy."

#. STRINGS.CHARACTERS.WAXWELL.EAT_FOOD.WINTERSFEASTFUEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.EAT_FOOD.WINTERSFEASTFUEL"
msgid "It tastes bitter."
msgstr "Nó có vị đắng."

#. STRINGS.CHARACTERS.WAXWELL.QUAGMIRE_ANNOUNCE_LOSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.QUAGMIRE_ANNOUNCE_LOSE"
msgid "This may be the end."
msgstr "Đây có lẽ là tận cùng rồi."

#. STRINGS.CHARACTERS.WAXWELL.QUAGMIRE_ANNOUNCE_MEALBURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.QUAGMIRE_ANNOUNCE_MEALBURNT"
msgid "Curses! Too slow."
msgstr "Khỉ thật! Chậm chân mất rồi."

#. STRINGS.CHARACTERS.WAXWELL.QUAGMIRE_ANNOUNCE_NOTRECIPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.QUAGMIRE_ANNOUNCE_NOTRECIPE"
msgid "This combination of food was ill-advised."
msgstr "Sự kết hợp thực phẩm này là một sai lầm."

#. STRINGS.CHARACTERS.WAXWELL.QUAGMIRE_ANNOUNCE_WIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.QUAGMIRE_ANNOUNCE_WIN"
msgid "The Gateway is ready!"
msgstr "Cánh Cổng đã sẵn sàng!"

#. STRINGS.CHARACTERS.WAXWELL.WENDY_SKILLTREE_EASTEREGG
msgctxt "STRINGS.CHARACTERS.WAXWELL.WENDY_SKILLTREE_EASTEREGG"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.CARNIVAL_HOST_HERE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.CARNIVAL_HOST_HERE"
msgid "We're pretty sure we saw him over here."
msgstr "Chúng tớ chắc chắn là thấy hắn ở quanh đây mà."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.EMPTY_CATCOONDEN
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.EMPTY_CATCOONDEN"
msgid "No one's home..."
msgstr "Không có ai ở nhà cả..."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.HOSTBUSY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.HOSTBUSY"
msgid "He looks pretty busy, we can come back later."
msgstr "Trông chú ấy bận lắm, tụi mình quay lại sau vậy."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDERS
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDERS"
msgid "It'll be more fun with more kitcoons."
msgstr "Sẽ vui hơn nếu có nhiều mèo kitcoon hơn đấy."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDING_SPOTS
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDING_SPOTS"
msgid "It's okay, but maybe we can find a place with more hiding spots."
msgstr "Cũng được đấy, nhưng tụi mình kiếm chỗ nào có nhiều chỗ trốn hơn đi."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_ONE_GAME_PER_DAY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_ONE_GAME_PER_DAY"
msgid "That was fun! Can we play again tomorrow?"
msgstr "Vui thật đấy! Mai mình chơi tiếp được không?"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.LOCKED_GATE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.LOCKED_GATE"
msgid "Aww. We want in there."
msgstr "Á chà. Tụi mình muốn vào trong đó cơ."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.MANNEQUIN_EQUIPSWAPFAILED
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.MANNEQUIN_EQUIPSWAPFAILED"
msgid "Actually, maybe we'll just keep it instead."
msgstr "Thôi thực ra tụi mình cứ giữ lại luôn đi."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.NOCARNIVAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.NOCARNIVAL"
msgid "Aww, did all the birds leave?"
msgstr "Ối, mấy con chim bay đi hết rồi á?"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.NOKELP
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.NOKELP"
msgid "only_used_by_wurt"
msgstr "chỉ_được_sử_dụng_bởi_wurt"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.NOTAROBOT"
msgid "We can't. The robot will get mad."
msgstr "Tụi mình không làm thế được đâu. Con robot sẽ nổi giận mất."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.NOTMERM
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.NOTMERM"
msgid "They don't listen to us!"
msgstr "Họ có thèm nghe tụi mình đâu!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.NOTMYBERNIE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.NOTMYBERNIE"
msgid "Bernie still wants to play!"
msgstr "Bernie vẫn muốn chơi tiếp cơ!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.PILLOWFIGHT_NO_HANDPILLOW
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.PILLOWFIGHT_NO_HANDPILLOW"
msgid "We need a pillow first!"
msgstr "Tụi mình cần có cái gối trước đã!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.APPLYELIXIR.NO_ELIXIRABLE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.APPLYELIXIR.NO_ELIXIRABLE"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.APPLYELIXIR.TOO_SUPER
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.APPLYELIXIR.TOO_SUPER"
msgid "That's too much for us."
msgstr "Cái đó quá sức với tụi mình rồi."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.APPLYMODULE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.APPLYMODULE.COOLDOWN"
msgid "only_used_by_wx78"
msgstr "chỉ_được_sử_dụng_bởi_wx78"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.APPLYMODULE.NOTENOUGHSLOTS
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.APPLYMODULE.NOTENOUGHSLOTS"
msgid "only_used_by_wx78"
msgstr "chỉ_được_sử_dụng_bởi_wx78"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.APPRAISE.NOTNOW
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.APPRAISE.NOTNOW"
msgid "Aw, looks like he's busy."
msgstr "Ồ, có vẻ chú ấy đang bận."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ATTUNE.NOHEALTH
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ATTUNE.NOHEALTH"
msgid "We don't feel so good right now. Maybe later?"
msgstr "Bọn mình thấy không khỏe cho lắm. Hay để lúc khác nhé?"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BATHBOMB.ALREADY_BOMBED
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BATHBOMB.ALREADY_BOMBED"
msgid "Aw, we wanted to do it!"
msgstr "Ơ, tụi mình cũng muốn làm cơ mà!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BATHBOMB.GLASSED
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BATHBOMB.GLASSED"
msgid "There's too much glass in the way."
msgstr "Có nhiều thủy tinh vướng đường quá."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BEDAZZLE.ALREADY_BEDAZZLED
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BEDAZZLE.ALREADY_BEDAZZLED"
msgid "We think we already decorated it pretty good."
msgstr "Tụi mình nghĩ là trang trí thế này là đẹp lắm rồi."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BEDAZZLE.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BEDAZZLE.BURNING"
msgid "Aaah! Spiderfriends, your house!!"
msgstr "Á á! Các bạn nhện ơi, nhà mấy bạn cháy kìa!!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BEDAZZLE.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BEDAZZLE.BURNT"
msgid "There isn't really much left to decorate..."
msgstr "Chẳng còn mấy thứ để mà trang trí nữa..."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BEDAZZLE.FROZEN
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BEDAZZLE.FROZEN"
msgid "Hmm it might be hard to get our decorations to stick to ice..."
msgstr "Hừm, gắn đồ trang trí lên băng đá có vẻ hơi khó đấy..."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BEGIN_QUEST.ONEGHOST
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BEGIN_QUEST.ONEGHOST"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BUILD.BUSY_STATION
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BUILD.BUSY_STATION"
msgid "We have to wait our turn."
msgstr "Tụi mình phải xếp hàng chờ đến lượt chứ."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BUILD.HASPET
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BUILD.HASPET"
msgid "I like the pet we've got."
msgstr "Tớ thích con thú cưng mà tụi mình đang có."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BUILD.MOUNTED
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BUILD.MOUNTED"
msgid "All our arms can't quite reach from up here."
msgstr "Từ trên này với xuống tay tụi mình với không tới."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BUILD.TICOON
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BUILD.TICOON"
msgid "We're good with just one guide."
msgstr "Tụi mình chỉ cần một hướng dẫn viên là đủ rồi."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CARNIVALGAME_FEED.TOO_LATE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CARNIVALGAME_FEED.TOO_LATE"
msgid "Aw, we weren't fast enough."
msgstr "Ôi, tụi mình chạy không kịp rồi."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CARVEPUMPKIN.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CARVEPUMPKIN.BURNING"
msgid "Ouch! Fire!"
msgstr "Ái! Lửa!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CARVEPUMPKIN.INUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CARVEPUMPKIN.INUSE"
msgid "Aww, we have to wait our turn."
msgstr "Hừm, tụi mình phải chờ đến lượt thôi."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CASTAOE.CANT_SPELL_MOUNTED
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CASTAOE.CANT_SPELL_MOUNTED"
msgid "only_used_by_willow"
msgstr "chỉ_được_sử_dụng_bởi_willow"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CASTAOE.NOT_ENOUGH_EMBERS
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CASTAOE.NOT_ENOUGH_EMBERS"
