#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD"
msgid "Ew, it's dead."
msgstr "Ối, chết rồi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC"
