msgstr "Một màu nâu hoàn hảo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GARLIC_SEEDS"
