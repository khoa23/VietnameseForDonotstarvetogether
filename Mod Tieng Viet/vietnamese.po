msgstr "Con chó quái vật tốt bụng. Đừng giết Wolfgang."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATED_PENGUIN.DEAD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATED_PENGUIN.DEAD"
msgid "Is dead, but still scary."
msgstr "Đã chết nhưng vẫn đáng sợ."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATED_PENGUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATED_PENGUIN.GENERIC"
