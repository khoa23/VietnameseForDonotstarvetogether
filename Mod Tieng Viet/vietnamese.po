msgstr "Trông giòn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ONION_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ONION_COOKED"
msgid "A successful chemical reaction."
msgstr "Một phản ứng hóa học thành công."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ONION_SEEDS"
msgid "A handful of odd seeds."
msgstr "Một số ít hạt kỳ lạ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_OVEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_OVEN"
