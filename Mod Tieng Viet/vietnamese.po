msgstr "Nó rất tốt cho việc sửa lỗi nhện."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_HIDER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_HIDER"
msgid "Friends!"
msgstr "Bạn bè!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_MOON.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_MOON.DEAD"
msgid "Sorry!"
msgstr "Lấy làm tiếc!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_MOON.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_MOON.GENERIC"
msgid "These friends look... weird."
msgstr "Những người bạn này trông... kỳ lạ."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_MOON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_MOON.SLEEPING"
