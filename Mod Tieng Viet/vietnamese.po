msgid "It's all out of fruit."
msgstr "Hết hoa quả rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING"
