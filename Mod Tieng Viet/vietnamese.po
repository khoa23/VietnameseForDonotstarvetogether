msgstr "Sẽ không có gì vượt qua được điều đó!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORHEAVY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORHEAVY"
msgid "That armor looks pretty safe."
msgstr "Bộ giáp đó trông khá an toàn."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORLIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORLIGHT"
msgid "This armor isn't very good."
msgstr "Bộ giáp này không tốt lắm."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED"
msgid "It barely does anything."
msgstr "Nó hầu như không làm gì cả."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORMEDIUM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORMEDIUM"
