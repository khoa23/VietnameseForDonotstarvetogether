msgstr "Ôi, ta chịu thôi."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.STORE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.STORE.NOTAROBOT"
msgid "I'm a non-automaton."
msgstr "Ta là một sinh vật sống, không phải robot."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.STORE.NOTMASTERCHEF
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.STORE.NOTMASTERCHEF"
msgid "Warly won't let me peek inside. He's no fun."
msgstr "Warly không cho ta nhìn trộm bên trong đâu. Hắn chán ngắt."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.STORE.NOTSOULJARHANDLER
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.STORE.NOTSOULJARHANDLER"
