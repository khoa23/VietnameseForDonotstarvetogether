msgstr "Heh, giỏi lắm cô bé!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WURT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WURT.GENERIC"
msgid "Hi %s!"
