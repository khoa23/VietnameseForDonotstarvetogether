msgstr "Raagh!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TREECLUMP
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TREECLUMP"
msgid "Do not block Wolfgang's way!"
msgstr "Đừng có chắn đường Wolfgang!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TREEGROWTHSOLUTION
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TREEGROWTHSOLUTION"
