msgctxt "STRINGS.UI.PAUSEMENU.AFK"
msgid "Go AFK"
msgstr "Đi AFK"

#. STRINGS.UI.PAUSEMENU.AUTOPAUSED_DST_TITLE
msgctxt "STRINGS.UI.PAUSEMENU.AUTOPAUSED_DST_TITLE"
msgid "Auto-Paused!"
msgstr "Tự động tạm dừng!"

#. STRINGS.UI.PAUSEMENU.AUTOPAUSE_TEXT
msgctxt "STRINGS.UI.PAUSEMENU.AUTOPAUSE_TEXT"
msgid "The game is auto-paused."
msgstr "Trò chơi được tự động tạm dừng."

#. STRINGS.UI.PAUSEMENU.CLIENTQUITBODY
msgctxt "STRINGS.UI.PAUSEMENU.CLIENTQUITBODY"
msgid "Are you sure you want to leave the server?"
msgstr "Bạn có chắc là muốn thoát server không?"

#. STRINGS.UI.PAUSEMENU.CLIENTQUITTITLE
msgctxt "STRINGS.UI.PAUSEMENU.CLIENTQUITTITLE"
msgid "Leave Server"
msgstr "Thoát server"

#. STRINGS.UI.PAUSEMENU.CLOSE
msgctxt "STRINGS.UI.PAUSEMENU.CLOSE"
msgid "Close"
msgstr "Đóng"

#. STRINGS.UI.PAUSEMENU.CONTINUE
msgctxt "STRINGS.UI.PAUSEMENU.CONTINUE"
msgid "Continue"
msgstr "Tiếp tục"

#. STRINGS.UI.PAUSEMENU.CONTROLS
msgctxt "STRINGS.UI.PAUSEMENU.CONTROLS"
msgid "Controls"
msgstr "Nút điều khiển"

#. STRINGS.UI.PAUSEMENU.DISCONNECT
msgctxt "STRINGS.UI.PAUSEMENU.DISCONNECT"
msgid "Disconnect"
msgstr "Ngắt kết nối"

#. STRINGS.UI.PAUSEMENU.DST_SUBTITLE
msgctxt "STRINGS.UI.PAUSEMENU.DST_SUBTITLE"
msgid "(Seriously! It's not.)"
msgstr "(Nghiêm túc! Không phải.)"

#. STRINGS.UI.PAUSEMENU.DST_TITLE
msgctxt "STRINGS.UI.PAUSEMENU.DST_TITLE"
msgid "Not Paused."
msgstr "Không dừng."

#. STRINGS.UI.PAUSEMENU.HOSTPAUSED_TEXT
msgctxt "STRINGS.UI.PAUSEMENU.HOSTPAUSED_TEXT"
msgid "The server host has paused the game."
msgstr "Máy chủ đã tạm dừng trò chơi."

#. STRINGS.UI.PAUSEMENU.HOSTQUITBODY
msgctxt "STRINGS.UI.PAUSEMENU.HOSTQUITBODY"
msgid "Are you sure you want to shut down the server? If you do, all current players will be disconnected."
msgstr "Bạn có chắc là bạn muốn tắt máy chủ? Nếu bạn làm như vậy, tất cả người chơi hiện tại sẽ bị ngắt kết nối."

#. STRINGS.UI.PAUSEMENU.HOSTQUITTITLE
msgctxt "STRINGS.UI.PAUSEMENU.HOSTQUITTITLE"
msgid "Shut Down Server"
msgstr "Tắt server"

#. STRINGS.UI.PAUSEMENU.ISSUE
msgctxt "STRINGS.UI.PAUSEMENU.ISSUE"
msgid "Report an Issue"
msgstr "Báo cáo lỗi"

#. STRINGS.UI.PAUSEMENU.NO
msgctxt "STRINGS.UI.PAUSEMENU.NO"
msgid "Maybe not..."
msgstr "Chắc là không..."

#. STRINGS.UI.PAUSEMENU.OPTIONS
msgctxt "STRINGS.UI.PAUSEMENU.OPTIONS"
msgid "Settings"
msgstr "Cài đặt"

#. STRINGS.UI.PAUSEMENU.PAUSED_DST_SUBTITLE
