msgid "It's doing \"time stuff\", that's the technical term."
msgstr "Đó là làm \"công cụ thời gian\", đó là thuật ngữ kỹ thuật."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POCKETWATCH_WEAPON.DEPLETED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POCKETWATCH_WEAPON.DEPLETED"
msgid "only_used_by_wanda"
msgstr "chỉ_được_sử_dụng_bởi_wanda"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POCKETWATCH_WEAPON.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POCKETWATCH_WEAPON.GENERIC"
msgid "That looks like a bad time just waiting to happen."
msgstr "Có vẻ như đó là một thời điểm tồi tệ đang chờ đợi để xảy ra."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POCKET_SCALE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POCKET_SCALE"
msgid "A scaled-down weighing device."
msgstr "Một thiết bị cân thu nhỏ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POLISHCOOKIE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POLISHCOOKIE"
msgid "I'll polish off this whole plate!"
msgstr "Tôi sẽ đánh bóng toàn bộ cái đĩa này!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POLLY_ROGERS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POLLY_ROGERS"
msgid "That's the little bird."
msgstr "Đó là con chim nhỏ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POLLY_ROGERSHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POLLY_ROGERSHAT"
msgid "A little bird told me it will come in handy."
msgstr "Một con chim nhỏ nói với tôi rằng nó sẽ có ích."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POMEGRANATE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POMEGRANATE"
msgid "It looks like the inside of an alien's brain."
msgstr "Dường như bên trong não của một người ngoài hành tinh."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POMEGRANATE_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POMEGRANATE_COOKED"
msgid "Haute Cuisine!"
msgstr "Haute Cuisine!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POMEGRANATE_OVERSIZED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POMEGRANATE_OVERSIZED"
msgid "That might be the biggest pomegranate I've ever seen."
msgstr "Đó có thể là quả lựu lớn nhất tôi từng thấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POMEGRANATE_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POMEGRANATE_SEEDS"
msgid "It's a seed."
msgstr "Đó là một hạt giống."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POND"
msgid "I can't see the bottom!"
msgstr "Tôi không thể nhìn thấy phía dưới!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PONDEEL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PONDEEL"
msgid "This will make a delicious meal."
msgstr "Điều này sẽ làm cho một bữa ăn ngon."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PONDFISH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PONDFISH"
msgid "Now I shall eat for a day."
msgstr "Bây giờ tôi sẽ ăn trong một ngày."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POND_ALGAE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POND_ALGAE"
msgid "Some algae by a pond."
msgstr "Một số tảo bởi một ao."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POOP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POOP"
msgid "I should fill my pockets!"
msgstr "Tôi nên điền vào túi của tôi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLEBLENDER_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLEBLENDER_ITEM"
msgid "It mixes all the food."
msgstr "Nó trộn tất cả thức ăn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG"
msgid "That meal is going to take a while."
msgstr "Bữa ăn đó sẽ mất một thời gian."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT"
msgid "It'll be ready in no-time!"
msgstr "Nó sẽ sẵn sàng ngay lập tức!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE"
msgid "Now we're done cookin'!"
msgstr "Bây giờ chúng ta đã nấu xong rồi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY"
msgid "I bet there's nothing in there."
msgstr "Tôi cá là không có gì ở đó cả."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC"
msgid "Now we're cookin'!"
msgstr "Bây giờ chúng ta đang nấu ăn!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLEFIREPIT_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLEFIREPIT_ITEM"
msgid "Finally, fire on the go! Patent pending."
msgstr "Cuối cùng, khai hỏa trên đường đi! Đang chờ cấp bằng sáng chế."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLESPICER_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLESPICER_ITEM.DONE"
msgid "Should make things a little tastier."
msgstr "Chắc sẽ làm mọi thứ ngon hơn một chút."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLESPICER_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLESPICER_ITEM.GENERIC"
msgid "This will spice things up."
msgstr "Điều này sẽ thêm gia vị cho mọi thứ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLETENT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLETENT"
msgid "I feel like I haven't had a proper night's sleep in ages!"
msgstr "Tôi cảm thấy như mình đã không có được một giấc ngủ ngon trong nhiều năm rồi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLETENT_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLETENT_ITEM"
msgid "This requires some a-tent-tion."
msgstr "Điều này đòi hỏi một chút sự chú ý."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATO
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATO"
msgid "The apples of the earth."
msgstr "Những quả táo của trái đất."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATOSACK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATOSACK"
msgid "It's either filled with potato-shaped rocks or rock-shaped potatoes."
msgstr "Nó chứa đầy những tảng đá hình củ khoai tây hoặc những củ khoai tây hình đá."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATOSOUFFLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATOSOUFFLE"
msgid "I forgot what good food tasted like."
msgstr "Tôi quên mất thức ăn ngon có vị như thế nào."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATOTORNADO
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATOTORNADO"
msgid "Potato, scientifically infused with the power of a tornado!"
msgstr "Khoai tây, được khoa học hòa trộn với sức mạnh của một cơn lốc xoáy!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATO_COOKED"
msgid "A successful temperature experiment."
msgstr "Một thí nghiệm thành công về nhiệt độ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATO_OVERSIZED"
msgid "That's a tater lot."
msgstr "Đó là một củ khoai tây to vật vã."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATO_SEEDS"
msgid "A handful of odd seeds."
msgstr "Một số ít hạt kỳ lạ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTTEDFERN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTTEDFERN"
msgid "A fern in a pot."
msgstr "Một cây dương xỉ trong một nồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POWCAKE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POWCAKE"
msgid "Science help us."
msgstr "Khoa học giúp chúng ta."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POWDER_MONKEY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POWDER_MONKEY"
msgid "Don't you dare monkey around with my boat!"
msgstr "Đừng có mà dám đùa giỡn với thuyền của tôi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PREMIUMWATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PREMIUMWATERINGCAN.EMPTY"
msgid "It won't do me much good without water."
msgstr "Sẽ chẳng có ích gì nếu không có nước."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PREMIUMWATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PREMIUMWATERINGCAN.GENERIC"
msgid "It's been improved with science... and bird parts!"
msgstr "Nó đã được cải tiến nhờ khoa học... và các bộ phận của chim!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PRIME_MATE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PRIME_MATE"
msgid "A nice hat is always a clear indicator of who's in charge."
msgstr "Một chiếc mũ đẹp luôn là dấu hiệu rõ ràng để biết ai là người chủ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUFFIN.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUFFIN.GENERIC"
msgid "I've never seen a live puffin before!"
msgstr "Tôi chưa bao giờ nhìn thấy một con cá nóc sống trước đây!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUFFIN.HELD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUFFIN.HELD"
msgid "Catching one ain't puffin to brag about."
msgstr "Bắt được một con không phải là chuyện để khoe khoang."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUFFIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUFFIN.SLEEPING"
msgid "Peacefully huffin' and puffin'."
msgstr "Tĩnh tâm rồi thở mạnh và thở nhanh."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKIN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKIN"
msgid "It's as big as my head!"
msgstr "Nó to như đầu của tôi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKINCARVER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKINCARVER"
msgid "Who's up for a gourd time?"
msgstr "Ai muốn có một khoảng thời gian bí ngô vui vẻ không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKINCOOKIE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKINCOOKIE"
msgid "That's a pretty gourd cookie!"
msgstr "Đó là một chiếc bánh quy bầu xinh xắn!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKINHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKINHAT.GENERIC"
msgid "That's a hollow expression."
msgstr "Đó là một biểu hiện trống rỗng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKINHAT.UNCARVED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKINHAT.UNCARVED"
msgid "It's no gourd to wear without a face."
msgstr "Không có bầu để mặc mà không có khuôn mặt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKINPIE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKINPIE"
msgid "I should probably just eat the whole thing... for science."
msgstr "Có lẽ tôi nên ăn hết... vì khoa học."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKIN_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKIN_COOKED"
msgid "How did it not turn into a pie?"
msgstr "Làm thế nào mà nó không biến thành một chiếc bánh?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKIN_LANTERN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKIN_LANTERN"
msgid "Spooky!"
msgstr "Spooky!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKIN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKIN_OVERSIZED"
msgid "A rather pumped up pumpkin."
msgstr "Một quả bí ngô khá căng mọng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKIN_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKIN_SEEDS"
msgid "It's a seed."
msgstr "Đó là một hạt giống."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUNCHINGBAG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUNCHINGBAG"
msgid "It comes with a finely calibrated ouch-o-meter."
msgstr "Nó đi kèm với một ouch-o-mét được hiệu chỉnh tinh vi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUREBRILLIANCE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUREBRILLIANCE"
msgid "It's blinding me with science!"
msgstr "Nó làm tôi mù quáng vì khoa học!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PURPLEAMULET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PURPLEAMULET"
msgid "It's whispering to me."
msgstr "Nó thì thầm với tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PURPLEGEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PURPLEGEM"
msgid "It contains the mysteries of the universe."
msgstr "Nó chứa những bí ẩn của vũ trụ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PURPLEMOONEYE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PURPLEMOONEYE"
msgid "Makes a good marker, but I wish it'd stop looking at me."
msgstr "Nó làm cho một điểm đánh dấu tốt, nhưng tôi ước nó ngừng nhìn tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ALTAR.FULL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ALTAR.FULL"
