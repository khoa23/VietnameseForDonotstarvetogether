msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_18"
msgid "It hath the stench of death upon it."
msgstr "Nó có mùi hôi thối của cái chết trên đó."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_19
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_19"
msgid "It hath the stench of death upon it."
msgstr "Nó có mùi hôi thối của cái chết trên đó."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_2"
msgid "It hath the stench of death upon it."
msgstr "Nó có mùi hôi thối của cái chết trên đó."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_42
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_42"
msgid "It hath the stench of death upon it."
msgstr "Nó có mùi hôi thối của cái chết trên đó."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_43
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_43"
msgid "It hath the stench of death upon it."
msgstr "Nó có mùi hôi thối của cái chết trên đó."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_7
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_7"
msgid "It hath the stench of death upon it."
msgstr "Nó có mùi hôi thối của cái chết trên đó."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUCKY_GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUCKY_GOLDNUGGET"
msgid "The unicorn smiles upon me this day!"
msgstr "Kỳ lân mỉm cười với tôi ngày hôm nay!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUCY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUCY"
msgid "It's nice, but it's no spear."
msgstr "Nó đẹp đấy, nhưng nó không có ngọn giáo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUMPY_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUMPY_SAPLING"
msgid "It brings shame to the might of Yggdrasil."
msgstr "Nó mang lại sự xấu hổ cho sức mạnh của Yggdrasil."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARFROG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARFROG"
msgid "This frog hath seen too much."
msgstr "Con ếch này đã nhìn thấy quá nhiều."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARPLANTHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARPLANTHAT"
msgid "A formidable helm, burning with an unearthly flame!"
msgstr "Một chiếc mũ bảo hiểm ghê gớm, bùng cháy với ngọn lửa kinh hoàng!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARPLANT_HUSK"
msgid "It hath a formidible hide, for a non-meat."
msgstr "Nó có một bộ da khủng khiếp, không phải thịt."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARPLANT_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARPLANT_KIT"
msgid "Even the sturdiest armor will sometimes need repairs."
msgstr "Ngay cả bộ giáp chắc chắn nhất đôi khi cũng cần được sửa chữa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARRIFT_CRYSTAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARRIFT_CRYSTAL"
msgid "How strange... and beautiful."
msgstr "Thật lạ lùng... và đẹp đẽ làm sao."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARRIFT_PORTAL"
msgid "An opening, yet I cannot pass through."
msgstr "Một lối mở nhưng tôi không thể đi qua được."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARTHRALL_PLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARTHRALL_PLANT"
msgid "Vicious plant, I shall honor thee with a swift death!"
msgstr "Cây độc ác, ta sẽ vinh danh ngươi bằng một cái chết chóng vánh!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARTHRALL_PLANT_VINE_END
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARTHRALL_PLANT_VINE_END"
msgid "Ha! You shall have to do better than that!"
msgstr "Hà! Bạn sẽ phải làm tốt hơn thế!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNAR_FORGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNAR_FORGE"
msgid "I shall forge weapons to rival the gods themselves!"
msgstr "Tôi sẽ rèn vũ khí để cạnh tranh với chính các vị thần!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNAR_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNAR_FORGE_KIT"
msgid "The forge must be built, forthwith!"
msgstr "Lò rèn phải được xây dựng ngay lập tức!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNAR_GRAZER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNAR_GRAZER"
msgid "I will not fall prey to your tricks, spirit!"
msgstr "Tôi sẽ không trở thành nạn nhân của thủ đoạn của bạn, tinh thần!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNAR_SEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNAR_SEED"
msgid "Sprung from the shining coronal of a mighty deity."
msgstr "Xuất phát từ vương miện tỏa sáng của một vị thần hùng mạnh."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUREPLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUREPLANT"
msgid "Finally! A useful vegetable."
msgstr "Cuối cùng! Một thực vật hữu ích."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUREPLANTBULB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUREPLANTBULB"
msgid "Perhaps I will be a meat farmer after all!"
msgstr "Có lẽ tôi sẽ là một người nông dân thịt sau khi tất cả!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUTEFISK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUTEFISK"
msgid "A true Viking delicacy!"
msgstr "Một món ngon thực sự của người Viking!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MADSCIENCE_LAB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MADSCIENCE_LAB"
msgid "Be there method to this madness?"
msgstr "Có phương pháp nào cho sự điên rồ này không?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAGICIAN_CHEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAGICIAN_CHEST"
msgid "'Tis a wicked looking thing."
msgstr "Trông thật tà ác."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS"
msgid "I will slay the four-winged beast!"
msgstr "Tôi sẽ giết con thú bốn cánh!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS_BEAK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS_BEAK"
msgid "A trophy from my victory!"
msgstr "Một chiếc cúp từ chiến thắng của tôi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS_FEATHER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS_FEATHER"
msgid "The plume of a fallen foe."
msgstr "Lông của kẻ thù đã ngã xuống."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS_FEATHERED_WEAVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS_FEATHERED_WEAVE"
msgid "A bolt of thine finest bird-cloth!"
msgstr "Một sợi vải chim đẹp nhất của bạn!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALE_PUPPET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALE_PUPPET"
msgid "He looks unhappy upon his throne."
msgstr "Anh ấy trông không vui khi ngai vàng của mình."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE"
msgid "The corpse of the rutabaga still retains its magic."
msgstr "Xác chết của Cải củ Thụy Điển vẫn giữ lại phép thuật của mình."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKESOUP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKESOUP"
msgid "A stew of magic!"
msgstr "Một hầm ma thuật!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_ACTIVE"
msgid "She just wants to go on a rutabaga saga."
msgstr "Cô chỉ muốn đi trên một saga Cải củ Thụy Điển."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_COOKED"
msgid "Grilled rutabaga."
msgstr "Cải củ Thụy Điển nướng."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_PLANTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_PLANTED"
msgid "A rutabaga!"
msgstr "Một Cải củ Thụy Điển!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANRABBIT_TAIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANRABBIT_TAIL"
msgid "The fuzzy trophy of a successful battle."
msgstr "Chiếc cúp mờ nhạt của một trận chiến thành công."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAPSCROLL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAPSCROLL"
msgid "Mayhaps the ink is invisible!"
msgstr "Có lẽ mực là vô hình!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLE"
msgid "The warrior stone!"
msgstr "Những chiến binh đá!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLEBEAN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLEBEAN"
msgid "Fee fi fo fum!"
msgstr "Lệ phí quá tệ!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLEBEAN_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLEBEAN_SAPLING"
msgid "How dost thou grow?"
msgstr "Bạn lớn lên như thế nào?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLEPILLAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLEPILLAR"
msgid "Fit for a palace!"
msgstr "Phù hợp cho một cung điện!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLESHRUB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLESHRUB"
msgid "Tis a shrub of stone!"
msgstr "Đây là một cây bụi đá!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLETREE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLETREE"
msgid "Even the winds cannot knock this tree down."
msgstr "Ngay cả những cơn gió cũng không thể đánh đổ cái cây này."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_BUSH.BURNING"
msgid "Hot log!"
msgstr "Gỗ nóng!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_BUSH.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_BUSH.BURNT"
msgid "Burnt down to nothing."
msgstr "Bị đốt cháy thành hư không."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_BUSH.GENERIC"
msgid "A shrub on guard."
msgstr "Một cây bụi trên gác."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_BUSH.PICKED"
msgid "What a nuisance."
msgstr "Thật là phiền toái."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_PLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_PLANT"
msgid "Pond foliage."
msgstr "Pond lá."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.BURNING"
msgid "It's ablaze!"
msgstr "Nó bốc cháy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.BURNT"
msgid "Burnt."
msgstr "Cháy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.CHOPPED"
msgid "Another must be planted to maintain the balance of this realm."
msgstr "Một cây khác phải được trồng để duy trì sự cân bằng của cõi này."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.GENERIC"
msgid "A warrior tree."
msgstr "Một cây chiến binh."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASHEDPOTATOES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASHEDPOTATOES"
msgid "I'll not be fooled by your new mash-ed form, vegetable!"
msgstr "Tôi sẽ không bị lừa bởi dạng nghiền mới của bạn đâu, rau củ!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASK_ANCIENT_ARCHITECTHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASK_ANCIENT_ARCHITECTHAT"
msgid "A countenance of clever thought."
msgstr "Một vẻ mặt có suy nghĩ thông minh."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASK_ANCIENT_HANDMAIDHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASK_ANCIENT_HANDMAIDHAT"
msgid "This mask did belong to one of valorous spirit!"
msgstr "Chiếc mặt nạ này thực sự thuộc về một tinh thần dũng cảm!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASK_ANCIENT_MASONHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASK_ANCIENT_MASONHAT"
msgid "The bearer of this mask hath endured the ceaseless barrage of toil!"
msgstr "Người mang chiếc mặt nạ này đã phải chịu đựng vô số công việc vất vả!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASK_BLACKSMITHHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASK_BLACKSMITHHAT"
msgid "'Tis cowardly to hide one's face behind a mask!"
msgstr "Thật hèn nhát khi che giấu khuôn mặt sau chiếc mặt nạ!"

