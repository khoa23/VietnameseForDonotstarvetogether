msgstr "Đến lúc bôi thêm Thuốc Kháng Axit rồi."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE"
