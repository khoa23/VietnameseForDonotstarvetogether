msgstr "Đốt sạch đi, %s! Đốt trụi đi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WOODIE.GENERIC"
