msgstr "Đã khóa chặt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PARK_OBELISK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PARK_OBELISK"
msgid "A monumental monument."
msgstr "Một tượng đài hoành tráng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PARK_URN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PARK_URN"
