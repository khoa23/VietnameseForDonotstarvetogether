msgstr "Tự hỏi nó sẽ lớn lên thành cái gì nhỉ."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_PLANT_RESEARCHED.1
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_PLANT_RESEARCHED.1"
