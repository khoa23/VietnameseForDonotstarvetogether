msgstr "Xem ra cho các bit Spikey."

#. STRINGS.SKIN_DESCRIPTIONS.hammer_hammush
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hammer_hammush"
msgid "Make mush with mush."
msgstr "Làm cho bột nhão."

#. STRINGS.SKIN_DESCRIPTIONS.hammer_invisible
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hammer_invisible"
msgid "Convey an incredibly convincing impression of a hammer."
msgstr "Truyền đạt một ấn tượng vô cùng thuyết phục về một cái búa."

#. STRINGS.SKIN_DESCRIPTIONS.hammer_rw_startingforest
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hammer_rw_startingforest"
msgid "Pound them to a pulp!"
msgstr "Đập chúng thành bột giấy!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_beltedgloves_brown_beaver
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_beltedgloves_brown_beaver"
msgid "'Werebeaver brown' colored gloves with a buckle on the back to help you hold it together."
msgstr "Găng tay màu nâu của hải ly có khóa ở mặt sau để giúp bạn giữ chặt găng tay."

#. STRINGS.SKIN_DESCRIPTIONS.hand_beltedgloves_navy_ocean
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_beltedgloves_navy_ocean"
msgid "'Unsuitably blue' colored gloves with a buckle on the back to help you hold it together."
msgstr "Găng tay có màu “xanh không phù hợp” có khóa ở phía sau để giúp bạn giữ chặt găng tay."

#. STRINGS.SKIN_DESCRIPTIONS.hand_beltedgloves_orange_sienna
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_beltedgloves_orange_sienna"
msgid "'Leaves in autumn orange' colored gloves with a buckle on the back to help you hold it together."
msgstr "Găng tay màu 'Lá mùa thu' có khóa sau lưng giúp bạn giữ chặt găng tay."

#. STRINGS.SKIN_DESCRIPTIONS.hand_beltedgloves_red_firehound
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_beltedgloves_red_firehound"
msgid "'Firehound red' colored gloves with a buckle on the back to help you hold it together."
msgstr "Găng tay màu 'Firehound red' có khóa ở mặt sau để giúp bạn giữ chặt găng tay."

#. STRINGS.SKIN_DESCRIPTIONS.hand_beltedgloves_teal_jungle
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_beltedgloves_teal_jungle"
msgid "'Jungle green' colored gloves with a buckle on the back to help you hold it together."
msgstr "Găng tay màu 'rừng xanh' có khóa ở mặt sau để giúp bạn giữ chặt găng tay."

#. STRINGS.SKIN_DESCRIPTIONS.hand_drivergloves_brown_sepia
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_drivergloves_brown_sepia"
msgid "These 'werebeaver brown' colored gloves are worn by good looking people who look cool."
msgstr "Những chiếc găng tay màu 'Wasbeaver Brown' này được đeo bởi những người đẹp trai trông mát mẻ."

#. STRINGS.SKIN_DESCRIPTIONS.hand_drivergloves_grey_dark
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_drivergloves_grey_dark"
msgid "These 'stormcloud gray' colored gloves are worn by good looking people who look cool."
msgstr "Những chiếc găng tay màu 'Stormcloud Grey' này được đeo bởi những người đẹp trai trông mát mẻ."

#. STRINGS.SKIN_DESCRIPTIONS.hand_drivergloves_tan_grass
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_drivergloves_tan_grass"
msgid "These 'dry grass tan' colored gloves are worn by good looking people who look cool."
msgstr "Những chiếc găng tay màu 'cỏ khô' này được đeo bởi những người đẹp trai trông mát mẻ."

#. STRINGS.SKIN_DESCRIPTIONS.hand_drivergloves_white_ivory
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_drivergloves_white_ivory"
msgid "These 'houndbone white' colored gloves are worn by good looking people who look cool."
msgstr "Những chiếc găng tay màu 'White White' này được đeo bởi những người đẹp trai trông mát mẻ."

#. STRINGS.SKIN_DESCRIPTIONS.hand_longgloves_black_scribble
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_longgloves_black_scribble"
msgid "'Scribble black' colored gloves suitable for all types of persons, robots, and monsters."
msgstr "Găng tay màu 'Scribble black' phù hợp với mọi loại người, robot và quái vật."

#. STRINGS.SKIN_DESCRIPTIONS.hand_longgloves_blue_cerulean
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_longgloves_blue_cerulean"
msgid "'Cobaltous oxide blue' colored gloves suitable for all types of persons, robots, and monsters."
msgstr "Găng tay màu 'xanh coban oxit' phù hợp với mọi loại người, robot và quái vật."

#. STRINGS.SKIN_DESCRIPTIONS.hand_longgloves_green_hunters
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_longgloves_green_hunters"
msgid "'Forest guardian green' colored gloves suitable for all types of persons, robots, and monsters."
msgstr "Găng tay màu 'Người bảo vệ rừng xanh' phù hợp với mọi loại người, robot và quái vật."

#. STRINGS.SKIN_DESCRIPTIONS.hand_longgloves_grey_battleship
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_longgloves_grey_battleship"
msgid "'Cumulus gray' colored gloves suitable for all types of persons, robots, and monsters."
msgstr "Găng tay màu 'Xám tích lũy' phù hợp với mọi loại người, robot và quái vật."

#. STRINGS.SKIN_DESCRIPTIONS.hand_longgloves_red_ruby
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_longgloves_red_ruby"
msgid "'Red gem red' colored gloves suitable for all types of persons, robots, and monsters."
msgstr "Găng tay màu 'đỏ ngọc đỏ' phù hợp với mọi loại người, robot và quái vật."

#. STRINGS.SKIN_DESCRIPTIONS.hand_longgloves_white_pure
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_longgloves_white_pure"
msgid "'Pure white' colored gloves suitable for all types of persons, robots, and monsters."
msgstr "Găng tay màu 'trắng tinh khiết' phù hợp với mọi loại người, robot và quái vật."

#. STRINGS.SKIN_DESCRIPTIONS.hand_longgloves_yellow_straw
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_longgloves_yellow_straw"
msgid "'Sulfuric yellow' colored gloves suitable for all types of persons, robots, and monsters."
msgstr "Găng tay màu 'vàng lưu huỳnh' phù hợp với mọi loại người, robot và quái vật."

#. STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_black_scribble
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_black_scribble"
msgid "These are gloves. They cover your hands. This pair is 'scribble black' colored."
msgstr "Đây là găng tay. Họ che tay bạn. Cặp này có màu 'Scribble Black'."

#. STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_blue_cornflower
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_blue_cornflower"
msgid "These are gloves. They cover your hands. This pair is 'rubber glove blue' colored."
msgstr "Đây là găng tay. Họ che tay bạn. Cặp này có màu 'Găng tay cao su màu xanh'."

#. STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_grey_dark
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_grey_dark"
msgid "These are gloves. They cover your hands. This pair is 'stormcloud gray' colored."
msgstr "Đây là găng tay. Họ che tay bạn. Cặp này có màu 'Stormcloud Grey'."

#. STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_navy_midnight
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_navy_midnight"
msgid "These are gloves. They cover your hands. This pair is 'begs the question blue' colored."
msgstr "Đây là găng tay. Họ che tay bạn. Cặp này là 'cầu xin câu hỏi màu xanh' màu."

#. STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_purple_violet
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_purple_violet"
msgid "These are gloves. They cover your hands. This pair is 'plethora of purple' colored."
msgstr "Đây là găng tay. Họ che tay bạn. Cặp này có màu 'rất nhiều màu tím'."

#. STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_red_higgsbury
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_red_higgsbury"
msgid "These are gloves. They cover your hands. This pair is 'Higgsbury red' colored."
msgstr "Đây là găng tay. Họ che tay bạn. Cặp này có màu 'Higgsbury Red'."

#. STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_white_smoke
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_white_smoke"
msgid "These are gloves. They cover your hands. This pair is 'smoke white' colored."
msgstr "Đây là găng tay. Họ che tay bạn. Cặp này có màu 'Khói trắng'."

#. STRINGS.SKIN_DESCRIPTIONS.hand_walter_ancient
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_walter_ancient"
msgid "A Pinetree Pioneer isn't afraid of getting their hands dirty, especially in these gloves."
msgstr "Người tiên phong của Pinetree không sợ bị bẩn tay, đặc biệt là khi đeo những chiếc găng tay này."

#. STRINGS.SKIN_DESCRIPTIONS.hand_walter_ice
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_walter_ice"
msgid "A pair of cozy mittens to keep your fingers warm while you're out exploring."
msgstr "Một cặp găng tay ấm cúng để giữ ấm ngón tay của bạn trong khi bạn đang khám phá."

#. STRINGS.SKIN_DESCRIPTIONS.hand_walter_nature
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_walter_nature"
msgid "These adventurous gloves are ready to take the reins!"
msgstr "Những chiếc găng tay phiêu lưu này đã sẵn sàng để nắm quyền!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_wanda_formal
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wanda_formal"
msgid "It isn't a fancy occasion if you're not wearing gloves."
msgstr "Đó không phải là một dịp lạ mắt nếu bạn không đeo găng tay."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wanda_ice
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wanda_ice"
msgid "These arctic mittens will save you from frostbitten fingers."
msgstr "Những găng tay Bắc cực này sẽ giúp bạn cứu bạn khỏi những ngón tay băng giá."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wanda_lunar
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wanda_lunar"
msgid "With these bracelets, a prophecy isn't the only statement you'll be making."
msgstr "Với những chiếc vòng này, một lời tiên tri không phải là tuyên bố duy nhất bạn sẽ đưa ra."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wanda_rose
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wanda_rose"
msgid "Garden glam for your green thumbs."
msgstr "Vườn glam dành cho các ngón tay xanh."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wanda_shadow
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wanda_shadow"
msgid "Hands touched by shadows can only spread darkness."
msgstr "Bàn tay chạm vào bóng tối chỉ có thể lan rộng bóng tối."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wanda_steampunk
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wanda_steampunk"
msgid "The material is surprisingly thin, allowing the hands better flexibility and precision."
msgstr "Các vật liệu mỏng một cách đáng ngạc nhiên, cho phép bàn tay linh hoạt và chính xác tốt hơn."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wanda_western
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wanda_western"
msgid "For when you need to get a grip."
msgstr "Dành cho khi bạn cần nắm bắt."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wanda_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wanda_yule"
msgid "Gloves for deftly maneuvering carving tools and paintbrushes."
msgstr "Găng tay cho các công cụ khắc và cọ vẽ khéo léo."

#. STRINGS.SKIN_DESCRIPTIONS.hand_warly_candyman
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_warly_candyman"
msgid "For hand-making each tasty treat with care."
msgstr "Cho làm bằng tay, mỗi món ngon với sự chăm sóc."

#. STRINGS.SKIN_DESCRIPTIONS.hand_warly_lunar
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_warly_lunar"
msgid "Lunar fashion isn't just a phase!"
msgstr "Thời trang mặt trăng không chỉ là một giai đoạn!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_warly_masquerade
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_warly_masquerade"
msgid "A nice pair of gloves gives any outfit a certain \"je ne sais quoi\"."
msgstr "Một đôi găng tay đẹp sẽ mang lại cho bất kỳ bộ trang phục nào một \"je ne sais quoi\' nhất định."

#. STRINGS.SKIN_DESCRIPTIONS.hand_warly_rose
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_warly_rose"
msgid "Gloved hands tend the finest roses."
msgstr "Bàn tay đeo găng có xu hướng hoa hồng tốt nhất."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_gladiator"
msgid "These fists are ready for glorious battle."
msgstr "Những nắm đấm này đã sẵn sàng cho trận chiến vinh quang."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_ice
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_ice"
msgid "It's not the cold, these hands were blue to begin with."
msgstr "Nó không phải là cái lạnh, những bàn tay này có màu xanh để bắt đầu."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_lunar
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_lunar"
msgid "Feel the power of the moon in your grasp."
msgstr "Cảm nhận sức mạnh của mặt trăng trong tầm tay của bạn."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_magma"
msgid "Battle gloves to withstand the flames that will consume this world."
msgstr "Găng tay chiến đấu để chịu được ngọn lửa sẽ tiêu thụ thế giới này."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_nature
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_nature"
msgid "These wrist coverings belong to someone who is at home in the woods."
msgstr "Những chiếc xe đeo cổ tay này thuộc về một người đang ở nhà trong rừng."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_pirate
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_pirate"
msgid "Wrist ruffles add dramatic flair to a pirate's ensemble."
msgstr "Ruffles cổ tay thêm sự tinh tế đầy kịch tính vào một bộ đồng phục của cướp biển."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_scarecrow
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_scarecrow"
msgid "Straw isn't quite as good as a fist for battle... unless your enemy has hay fever."
msgstr "Rơm không hoàn toàn tốt bằng một nắm đấm cho trận chiến ... trừ khi kẻ thù của bạn bị sốt cỏ khô."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_victorian"
msgid "A pair of thin cloth gloves, likely worn by an actress."
msgstr "Một đôi găng tay vải mỏng, có khả năng được mặc bởi một nữ diễn viên."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_wrestler
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_wrestler"
msgid "Hand wraps and padded gloves mean hands are protected for better punches."
msgstr "Gói tay và găng tay đệm có nghĩa là bàn tay được bảo vệ cho những cú đấm tốt hơn."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_yule"
msgid "Blend in to the blue-white tundra with ease."
msgstr "Trộn vào lãnh nguyên màu trắng xanh một cách dễ dàng."

#. STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_formal
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_formal"
msgid "White gloved hands are sometimes a symbol of deception. They're also a symbol of fashion!"
msgstr "Bàn tay găng tay trắng đôi khi là một biểu tượng của sự lừa dối. Chúng cũng là một biểu tượng của thời trang!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_formalp
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_formalp"
msgid "White gloved hands are sometimes a symbol of deception. They're also a symbol of fashion!"
msgstr "Bàn tay găng tay trắng đôi khi là một biểu tượng của sự lừa dối. Chúng cũng là một biểu tượng của thời trang!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_gladiator"
msgid "The handwraps of an alchemist, skilled at battle."
msgstr "Các tay cầm của một nhà giả kim, có kỹ năng trong trận chiến."

#. STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_ice
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_ice"
msgid "Keep those greedy mitts warm."
msgstr "Giữ cho những găng tay tham lam đó ấm áp."

#. STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_lunar
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_lunar"
msgid "Will you reach for the light or the darkness?"
msgstr "Bạn sẽ với lấy ánh sáng hay bóng tối?"

#. STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_magma"
msgid "Gloves worthy of wrathful combat."
msgstr "Găng tay xứng đáng chiến đấu phẫn nộ."

#. STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_nature
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_nature"
msgid "There's a perpetual dew dotting the leaves on the back of these gloves."
msgstr "Có một sương vĩnh viễn rải rác những chiếc lá ở mặt sau của những chiếc găng tay này."

#. STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_vampire
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_vampire"
msgid "A vampiric gentleman never leaves the coffin without his gloves."
msgstr "Một quý ông ma cà rồng không bao giờ rời quan tài mà không có găng tay."

#. STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_victorian"
msgid "A pair of white gloves for a high class snob."
msgstr "Một đôi găng tay trắng cho một kẻ hợm hĩnh cao cấp."

#. STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_western
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_western"
msgid "Protect your hands from the dust, and the odd dust-up."
msgstr "Bảo vệ bàn tay của bạn khỏi bụi và bụi bẩn."

#. STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_wizard
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_wizard"
msgid "These hands have cast more than their fair share of curses."
msgstr "Những bàn tay này đã sử dụng nhiều hơn những chia sẻ công bằng của họ về những lời nguyền."

#. STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_yule"
msgid "Why leave the house when your riches are at home?"
msgstr "Tại sao phải rời khỏi nhà khi sự giàu có của bạn ở nhà?"

#. STRINGS.SKIN_DESCRIPTIONS.hand_webber_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_webber_gladiator"
msgid "Perhaps after battle you could take up decorative hedge trimming."
msgstr "Có lẽ sau trận chiến, bạn có thể trang trí cắt tỉa hàng rào trang trí."

#. STRINGS.SKIN_DESCRIPTIONS.hand_webber_lunar
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_webber_lunar"
msgid "For some reason, nobody wants to hold your hand."
msgstr "Vì một số lý do, không ai muốn nắm tay bạn."

#. STRINGS.SKIN_DESCRIPTIONS.hand_webber_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_webber_magma"
msgid "Like little candle flames for your claws."
msgstr "Giống như ngọn lửa nến nhỏ cho móng vuốt của bạn."

#. STRINGS.SKIN_DESCRIPTIONS.hand_webber_nature
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_webber_nature"
msgid "These spider claws are sharpened and ready for the hunt!"
msgstr "Những móng vuốt nhện này được mài giũa và sẵn sàng cho cuộc săn lùng!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_webber_pirate
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_webber_pirate"
msgid "These helpful hooks make hanging from the rigging a breeze."
msgstr "Những chiếc móc hữu ích này giúp việc treo lên giàn buồm trở nên dễ dàng."

#. STRINGS.SKIN_DESCRIPTIONS.hand_webber_punk
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_webber_punk"
msgid "The spikes on these cuffs look scary, but they're actually quite soft."
msgstr "Các gai trên các còng này trông đáng sợ, nhưng chúng thực sự khá mềm mại."

#. STRINGS.SKIN_DESCRIPTIONS.hand_webber_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_webber_victorian"
msgid "A pair of cuffs to wear when studiously practicing the three Rs."
msgstr "Một cặp còng để mặc khi học tập ba R."

#. STRINGS.SKIN_DESCRIPTIONS.hand_webber_wrestler
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_webber_wrestler"
msgid "These claw-some mitts are padded so no one will really get hurt."
msgstr "Những găng tay vuốt này được đệm để không ai thực sự bị tổn thương."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wendy_ancient
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wendy_ancient"
msgid "May the spirits look favorably upon the offering from your hands."
msgstr "Cầu mong các linh hồn sẽ hài lòng với lễ vật từ tay bạn."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wendy_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wendy_gladiator"
msgid "These handwraps are imbued with a quiet ferocity."
msgstr "Những tay cầm này được thấm nhuần với sự hung dữ yên tĩnh."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wendy_handmedown
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wendy_handmedown"
msgid "These carefully woven daisy bracelets remind you of brighter days."
msgstr "Những chiếc vòng hoa cúc được dệt cẩn thận nhắc nhở bạn về những ngày tươi sáng hơn."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wendy_ice
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wendy_ice"
msgid "A thin pair of winter gloves."
msgstr "Một đôi găng tay mùa đông mỏng."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wendy_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wendy_magma"
msgid "Flaming winged accessories to accompany your rebirth."
msgstr "Các phụ kiện có cánh để đi cùng với sự tái sinh của bạn."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wendy_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wendy_victorian"
msgid "Soft gloves to hold your heartbreak."
msgstr "Găng tay mềm mại để giữ đau lòng."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wendy_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wendy_yule"
msgid "Warm your hands, and maybe even your heart."
msgstr "Làm ấm bàn tay của bạn, và thậm chí có thể là trái tim của bạn."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wes_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wes_gladiator"
msgid "A light gauntlet design for an expert duelist."
msgstr "Một thiết kế găng tay nhẹ cho một chuyên gia đấu tay đôi."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wes_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wes_magma"
msgid "Fancy fingers for fiery fighting."
msgstr "Những ngón tay lạ mắt cho chiến đấu bốc lửa."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wes_nature
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wes_nature"
msgid "Gloves to paint cheery, small trees in."
msgstr "Găng tay để sơn vui vẻ, cây nhỏ trong."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wes_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wes_victorian"
msgid "These were white gloves when you first started in the sweep business."
msgstr "Đây là những găng tay trắng khi bạn lần đầu tiên bắt đầu kinh doanh quét."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wes_western
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wes_western"
msgid "For the brave little fool who takes life by the horns--without making a sound."
msgstr "Dành cho một kẻ ngu ngốc dũng cảm đang lấy sừng để giết chết - mà không gây ra một tiếng động nào."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wes_wrestler
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wes_wrestler"
msgid "Your challengers can't handle how gorgeous these gloves are."
msgstr "Những người thách thức của bạn không thể xử lý những chiếc găng tay này tuyệt đẹp như thế nào."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wes_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wes_yule"
msgid "Jolliness at your finger tips!"
msgstr "Jolly ở đầu ngón tay của bạn!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_gladiator"
msgid "A thin strip of cloth to protect your caster's hands."
msgstr "Một dải vải mỏng để bảo vệ bàn tay của bạn."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_ice
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_ice"
msgid "Sleek arm covers that radiate cool, clear refinement."
msgstr "Cánh tay bóng mượt bao gồm tỏa ra mát mẻ, tinh tế rõ ràng."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_lunar
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_lunar"
msgid "Raise your hand if you've found your experience with the moon enlightening."
msgstr "Tăng tay nếu bạn đã tìm thấy trải nghiệm của mình với sự khai sáng mặt trăng."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_magma"
msgid "Armored gloves for handling hot magma samples."
msgstr "Găng tay bọc thép để xử lý các mẫu magma nóng."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_nature
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_nature"
msgid "These hands know which wild plants to harvest, and which to leave be."
msgstr "Những bàn tay này biết những cây hoang dã nào để thu hoạch, và để lại."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_ornate
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_ornate"
msgid "Long gloves are the most fashionable way to cover ink-stained hands."
msgstr "Găng tay dài là cách thời trang nhất để che bàn tay nhuộm màu."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_pirate
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_pirate"
msgid "Save the best pieces of loot for yourself."
msgstr "Hãy lưu giữ những chiến lợi phẩm tốt nhất cho chính mình."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_spiderwitch
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_spiderwitch"
msgid "You'll go batty for these sleeves!"
msgstr "Bạn sẽ đi batty cho những tay áo này!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_victorian"
msgid "You'll be the envy of all at the luncheon in this refined number."
msgstr "Bạn sẽ là sự ghen tị của tất cả trong bữa tiệc trưa trong số tinh chế này."

#. STRINGS.SKIN_DESCRIPTIONS.hand_willow_ancient
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_willow_ancient"
msgid "These bracelets may be old, but they've never lost their lustre."
msgstr "Những vòng đeo tay này có thể đã cũ, nhưng chúng chưa bao giờ mất đi sự rực rỡ của mình."

#. STRINGS.SKIN_DESCRIPTIONS.hand_willow_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_willow_gladiator"
msgid "A fine leather set of bracers to wear into battle."
msgstr "Một bộ da tốt để mặc vào trận chiến."

#. STRINGS.SKIN_DESCRIPTIONS.hand_willow_haunteddoll
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_willow_haunteddoll"
msgid "This doll was found in the attic of someone's late grandmother, as all haunted dolls must legally be."
msgstr "Con búp bê này đã được tìm thấy trên gác mái của người bà quá cố của ai đó, vì tất cả những con búp bê ma ám phải hợp pháp."

#. STRINGS.SKIN_DESCRIPTIONS.hand_willow_ice
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_willow_ice"
msgid "Two small tufts of rabbit fur to adorn the wrists."
msgstr "Hai búi nhỏ của thỏ lông để tô điểm cho cổ tay."

#. STRINGS.SKIN_DESCRIPTIONS.hand_willow_lunar
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_willow_lunar"
msgid "Otherworldly accessories, for someone who goes against the grain."
msgstr "Những phụ kiện của thế giới khác, dành cho những người đi ngược lại xu hướng."

#. STRINGS.SKIN_DESCRIPTIONS.hand_willow_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_willow_magma"
msgid "Impress a deity with these sacrificial bangles."
msgstr "Ấn tượng một vị thần với những vòng đeo hy sinh này."

#. STRINGS.SKIN_DESCRIPTIONS.hand_willow_nature
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_willow_nature"
msgid "These muted brown bracelets are very down-to-earth."
msgstr "Những chiếc vòng tay màu nâu bị tắt tiếng này rất xuống đất."

#. STRINGS.SKIN_DESCRIPTIONS.hand_willow_pirate
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_willow_pirate"
msgid "A bracelet of \"borrowed\" gems."
msgstr "Một vòng tay của đá quý \"mượn\"."

#. STRINGS.SKIN_DESCRIPTIONS.hand_willow_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_willow_victorian"
msgid "These matchstick seller gloves do little to keep out the cold."
msgstr "Những găng tay người bán que diêm này làm rất ít để tránh cái lạnh."

#. STRINGS.SKIN_DESCRIPTIONS.hand_willow_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_willow_yule"
msgid "Warm hands, warm heart."
msgstr "Bàn tay ấm áp, trái tim ấm áp."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wilson_barber
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wilson_barber"
msgid "These hands won't be complete without a barber's blade."
msgstr "Những bàn tay này sẽ không hoàn thành nếu không có lưỡi cắt của thợ cắt tóc."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wilson_formal
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wilson_formal"
msgid "These gloves will hide the chemical stains on your hands when you dress up for formal occasions."
msgstr "Những găng tay này sẽ giấu các vết bẩn hóa học trên tay khi bạn ăn mặc cho những dịp chính thức."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wilson_formalp
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wilson_formalp"
msgid "These gloves will hide the chemical stains on your hands when you dress up for formal occasions."
msgstr "Những găng tay này sẽ giấu các vết bẩn hóa học trên tay khi bạn ăn mặc cho những dịp chính thức."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wilson_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wilson_gladiator"
msgid "These bracers will help you look the part in the arena."
msgstr "Những chiếc áo choàng này sẽ giúp bạn tìm kiếm phần trong đấu trường."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wilson_ice
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wilson_ice"
msgid "The gloves of a fellow with an icy touch."
msgstr "Găng tay của một người bạn với một liên lạc băng giá."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wilson_lunar
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wilson_lunar"
msgid "Infinite starscapes of knowledge are within your grasp!"
msgstr "Starscapes Kiến thức vô hạn nằm trong tầm tay của bạn!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_wilson_madscientist
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wilson_madscientist"
msgid "Laboratory gloves imbued with mercury, to encourage madness. (Don't try this at home.)"
msgstr "Găng tay phòng thí nghiệm thấm nhuần thủy ngân, để khuyến khích sự điên rồ. (Đừng thử cái này ở nhà.)"

#. STRINGS.SKIN_DESCRIPTIONS.hand_wilson_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wilson_magma"
msgid "Rock hard gloves, sure to intimidate."
msgstr "Găng tay cứng, chắc chắn để đe dọa."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wilson_masquerade
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wilson_masquerade"
msgid "Despite being chemical-resistant, these gloves are sure to get a reaction."
msgstr "Mặc dù có khả năng kháng hóa chất nhưng những chiếc găng tay này chắc chắn sẽ gây ra phản ứng."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wilson_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wilson_victorian"
msgid "Don't worry, this won't hurt a bit!"
msgstr "Đừng lo lắng, điều này sẽ không đau một chút!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_wilson_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wilson_yule"
msgid "These gloves can't wait to get a hold of some festive desserts."
msgstr "Những găng tay này không thể chờ đợi để có được một số món tráng miệng lễ hội."

#. STRINGS.SKIN_DESCRIPTIONS.hand_winona_20s
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_winona_20s"
msgid "Reach for the stars when the night is at its darkest!"
msgstr "Vươn tới những vì sao khi màn đêm đen tối nhất!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_winona_factory
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_winona_factory"
msgid "Standard issue Voxola workgloves, so you don't get fingerprints on the merchandise."
msgstr "Vấn đề tiêu chuẩn Voxola Workgloves, vì vậy bạn không nhận được dấu vân tay trên hàng hóa."

#. STRINGS.SKIN_DESCRIPTIONS.hand_winona_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_winona_gladiator"
msgid "Any pair of gloves can be improved by brass plating."
msgstr "Bất kỳ cặp găng tay nào cũng có thể được cải thiện bằng cách mạ đồng."

#. STRINGS.SKIN_DESCRIPTIONS.hand_winona_ice
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_winona_ice"
msgid "Diamonds won't keep you warm."
msgstr "Kim cương sẽ không giữ ấm cho bạn."

#. STRINGS.SKIN_DESCRIPTIONS.hand_winona_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_winona_magma"
msgid "Perfectly welded welding gloves."
msgstr "Găng tay hàn hoàn hảo."

#. STRINGS.SKIN_DESCRIPTIONS.hand_winona_nature
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_winona_nature"
msgid "These once-thick gardening gloves are old and worn. They won't provide much protection anymore."
msgstr "Những chiếc găng tay làm vườn một thời này đã cũ và mòn. Họ sẽ không cung cấp nhiều sự bảo vệ nữa."

#. STRINGS.SKIN_DESCRIPTIONS.hand_winona_pirate
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_winona_pirate"
msgid "A pair of hard working deck hands."
msgstr "Một cặp bàn tay làm việc chăm chỉ."

#. STRINGS.SKIN_DESCRIPTIONS.hand_winona_spring
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_winona_spring"
msgid "Fresh floral flourish for hardworking hands."
msgstr "Hoa tươi nở rộ cho đôi bàn tay chăm chỉ."

#. STRINGS.SKIN_DESCRIPTIONS.hand_winona_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_winona_victorian"
msgid "Thick gloves for transferring smelted metals."
msgstr "Găng tay dày để chuyển kim loại nấu chảy."

#. STRINGS.SKIN_DESCRIPTIONS.hand_winona_wrestler
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_winona_wrestler"
msgid "Awesome gloves for an awesome lady."
msgstr "Găng tay tuyệt vời cho một người phụ nữ tuyệt vời."

#. STRINGS.SKIN_DESCRIPTIONS.hand_winona_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_winona_yule"
msgid "Long gloves with a wreath of showy fur."
msgstr "Găng tay dài với một vòng hoa của bộ lông sặc sỡ."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_gladiator"
msgid "Your mighty fists need no armor, only slight embellishment."
msgstr "Nắm nắm tay hùng mạnh của bạn không cần áo giáp, chỉ tô điểm nhẹ."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_ice
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_ice"
msgid "These gloves fail to keep the cold out, although they inspire a feeling of coziness."
msgstr "Những chiếc găng tay này không giữ được cái lạnh, mặc dù chúng truyền cảm hứng cho cảm giác thoải mái."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_lunar
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_lunar"
msgid "Imbue your fists with the moon's might!"
msgstr "Thấm nhuần nắm đấm của bạn với sức mạnh của mặt trăng!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_magma"
msgid "Flaming adornments for your wrists."
msgstr "Ngăn lửa trang trí cho cổ tay của bạn."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_strongman
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_strongman"
msgid "Even the mighty hands of a strongman like to feel safe and protected."
msgstr "Ngay cả những bàn tay hùng mạnh của một người mạnh mẽ cũng thích cảm thấy an toàn và được bảo vệ."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_victorian"
msgid "Left hook! Right hook! Jab, jab!"
msgstr "Móc trái! Móc phải! Jab, jab!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_wolfman
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_wolfman"
msgid "If you mess with the wolf, you'd better watch for the claws!"
msgstr "Nếu bạn gây rối với con sói, tốt hơn bạn nên xem móng vuốt!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_wrestler
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_wrestler"
msgid "Fingerless gloves for delivering the smack down."
msgstr "Găng tay không có ngón tay để cung cấp các cú đánh xuống."

#. STRINGS.SKIN_DESCRIPTIONS.hand_woodie_ancient
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_woodie_ancient"
msgid "These chunky bangles are a timeless accessory."
msgstr "Những chiếc vòng tròn đó là một phụ kiện vượt thời gian."

#. STRINGS.SKIN_DESCRIPTIONS.hand_woodie_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_woodie_gladiator"
msgid "These leather gloves have small holes cut in them for the knuckles to show through."
msgstr "Những găng tay da này có những lỗ nhỏ được cắt trong chúng để các đốt ngón tay thể hiện qua."

#. STRINGS.SKIN_DESCRIPTIONS.hand_woodie_hippie
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_woodie_hippie"
msgid "They're handmade!"
msgstr "Họ được làm thủ công!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_woodie_hockey
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_woodie_hockey"
msgid "These gloves were made to be thrown down."
msgstr "Những găng tay này đã được làm để bị ném xuống."

#. STRINGS.SKIN_DESCRIPTIONS.hand_woodie_ice
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_woodie_ice"
msgid "You'd better keep those hands warm if you want to reach the summit with all your fingers."
msgstr "Bạn nên giữ ấm tay đó nếu bạn muốn lên đến đỉnh bằng tất cả các ngón tay."

#. STRINGS.SKIN_DESCRIPTIONS.hand_woodie_lunar
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_woodie_lunar"
msgid "These gloves will have you throwing a flurry of furious fists and flying fur."
msgstr "Những chiếc găng tay này sẽ khiến bạn tung ra hàng loạt nắm đấm giận dữ và lông bay tứ tung."

#. STRINGS.SKIN_DESCRIPTIONS.hand_woodie_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_woodie_magma"
msgid "Studded gloves for peerless gripping of an axe."
msgstr "Găng tay nạm để kẹp ngang hàng của một cái rìu."

#. STRINGS.SKIN_DESCRIPTIONS.hand_woodie_masquerade
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_woodie_masquerade"
msgid "The delicate fabric nearly masks the rough, calloused hands."
msgstr "Vải tinh tế gần như che giấu đôi bàn tay thô ráp, nhẫn tâm."

#. STRINGS.SKIN_DESCRIPTIONS.hand_woodie_nature
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_woodie_nature"
msgid "These wrist bands have been delicately woven by deft hands."
msgstr "Những dải cổ tay này đã được dệt một cách tinh tế bởi bàn tay khéo léo."

#. STRINGS.SKIN_DESCRIPTIONS.hand_woodie_pirate
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_woodie_pirate"
msgid "A shipwright hand, and a shipleft hand to match."
msgstr "Một bàn tay Shipwright, và một bàn tay Shipleft để phù hợp."

#. STRINGS.SKIN_DESCRIPTIONS.hand_woodie_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_woodie_victorian"
msgid "Keep your hands free for tanning pelts!"
msgstr "Giữ cho bàn tay của bạn miễn phí cho làn da rám nắng!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_woodie_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_woodie_yule"
msgid "There are legends of a lone figure who wanders the snow-laden woods, tending to the trees with heavy, callused hands."
msgstr "Có những huyền thoại về một nhân vật đơn độc lang thang trong những khu rừng đầy tuyết, có xu hướng với những cái cây bằng đôi tay nặng nề, nặng nề."

#. STRINGS.SKIN_DESCRIPTIONS.hand_workgloves_brown_chocolate
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_workgloves_brown_chocolate"
msgid "These 'insufficient chocolate brown' colored gloves look like they should be protective, but they really aren't."
msgstr "Những chiếc găng tay màu nâu sô cô la 'không đủ này trông giống như chúng nên được bảo vệ, nhưng chúng thực sự không."

#. STRINGS.SKIN_DESCRIPTIONS.hand_workgloves_grey_gainsboro
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_workgloves_grey_gainsboro"
msgid "These 'silver gray' colored gloves look like they should be protective, but they really aren't."
msgstr "Những chiếc găng tay màu 'màu xám bạc' này trông giống như chúng nên được bảo vệ, nhưng chúng thực sự không."

#. STRINGS.SKIN_DESCRIPTIONS.hand_workgloves_red_higgsbury
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_workgloves_red_higgsbury"
msgid "These 'Higgsbury red' colored gloves look like they should be protective, but they really aren't."
msgstr "Những chiếc găng tay màu 'Higgsbury Red' này trông giống như chúng nên được bảo vệ, nhưng chúng thực sự không."

#. STRINGS.SKIN_DESCRIPTIONS.hand_workgloves_tan_grass
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_workgloves_tan_grass"
msgid "These 'dry grass tan' colored gloves look like they should be protective, but they really aren't."
msgstr "Những chiếc găng tay màu 'cỏ khô' này trông giống như chúng nên được bảo vệ, nhưng chúng thực sự không."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_ancient
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_ancient"
msgid "These strange fungal arms are embracing their new surroundings."
msgstr "Những cánh tay nấm kỳ lạ này đang ôm lấy môi trường xung quanh mới của họ."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_cactus
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_cactus"
msgid "Hands for prickling and tickling."
msgstr "Bàn tay để châm chích và cù lét."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_formal
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_formal"
msgid "Shoulder leaves and wooden sleeves in a classic yet stylish pairing."
msgstr "Lá vai và tay áo bằng gỗ trong một cặp đôi cổ điển nhưng sành điệu."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_ice
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_ice"
msgid "The cold winter air has these poor vines shaking like a leaf!"
msgstr "không khí mùa đông lạnh lẽo có những cây nho nghèo này run rẩy như một chiếc lá!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_lunar
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_lunar"
msgid "These delicate blossoms add a soft touch."
msgstr "Những bông hoa tinh tế thêm một liên lạc mềm mại."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_mushroom
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_mushroom"
msgid "These fungal hands really grow on you."
msgstr "Những bàn tay nấm này thực sự phát triển trên bạn."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_nature
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_nature"
msgid "They wave gently in the warm spring breeze."
msgstr "Họ vẫy nhẹ trong làn gió mùa xuân ấm áp."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_pumpkin
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_pumpkin"
msgid "They're reaching out for some Hallowed Nights candy."
msgstr "Họ đang tiếp cận với một số kẹo đêm thần thánh."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_rose
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_rose"
msgid "Limbs as elegant as the rose from which they grow."
msgstr "Các chi thanh lịch như hoa hồng mà chúng phát triển."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_shadow
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_shadow"
msgid "Just one touch from these poisonous leaves could spell your doom."
msgstr "Chỉ cần một lần chạm từ những chiếc lá độc này có thể đánh vần sự diệt vong của bạn."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_survivor
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_survivor"
msgid "There's something eerily soothing about the crunch of Wormwood's leaves as he embraces you."
msgstr "Có điều gì đó êm dịu một cách kỳ lạ trong tiếng kêu lạo xạo của lá Wormwood khi anh ôm lấy bạn."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_victorian"
msgid "Carved with a delicate touch for a natural looking effect."
msgstr "Chạm khắc với một liên lạc tinh tế cho một hiệu ứng nhìn tự nhiên."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_yule"
msgid "These hands have a particularly festive touch."
msgstr "Những bàn tay này có một liên lạc đặc biệt lễ hội."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wortox_minotaur
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wortox_minotaur"
msgid "A pair of monstrous minotaur claws sporting golden bracers."
msgstr "Một cặp móng vuốt minotaur quái dị thể thao Golden Bracers."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wortox_nature
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wortox_nature"
msgid "Would you walk hand in hand with the forest folk?"
msgstr "Bạn có đi đôi tay với dân gian rừng không?"

#. STRINGS.SKIN_DESCRIPTIONS.hand_wortox_original
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wortox_original"
msgid "The fuzzy paws of a sweet forest fawn."
msgstr "Những bàn chân mờ nhạt của một khu rừng ngọt ngào."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wortox_pirate
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wortox_pirate"
msgid "Glittery gold beads, procured through questionable means."
msgstr "Hạt vàng lấp lánh, mua qua các phương tiện nghi vấn."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wortox_shadow
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wortox_shadow"
msgid "These claws have had a hand in many dark deeds."
msgstr "Những móng vuốt này đã có một bàn tay trong nhiều hành động đen tối."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wortox_survivor
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wortox_survivor"
msgid "Sharp goblin claws honed for wilderness survival."
msgstr "Móng vuốt Goblin sắc bén được mài giũa cho sự sống sót hoang dã."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wortox_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wortox_victorian"
msgid "Hands of not-so-lifeless stone."
msgstr "Bàn tay bằng đá không quá đáng."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wurt_ancient
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wurt_ancient"
msgid "At some point in their evolution, Merms must have traded their fins for claws."
msgstr "Ở một giai đoạn nào đó trong quá trình tiến hóa của họ, người Merms phải đã trao đổi vây cá để có móng vuốt."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wurt_cave
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wurt_cave"
msgid "These claws were made for poking around in the dark."
msgstr "Những móng vuốt này được tạo ra để chọc vào trong bóng tối."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wurt_formal
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wurt_formal"
msgid "Elegant and re-finned."
msgstr "Thanh lịch và được hoàn thiện lại."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wurt_lunar
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wurt_lunar"
msgid "The finest fins in all the swamp!"
msgstr "Những chiếc vây đẹp nhất trong đầm lầy!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_wurt_nature
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wurt_nature"
msgid "These sharp little claws blend right into the algae... until it's too late."
msgstr "Những móng vuốt nhỏ sắc bén này hòa quyện vào tảo ... cho đến khi quá muộn."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wurt_pirate
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wurt_pirate"
msgid "These claws were made for pinching precious gems."
msgstr "Những móng vuốt này đã được tạo ra để chèn ép đá quý quý giá."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wurt_rose
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wurt_rose"
msgid "Pink and pointy pointers."
msgstr "Con trỏ hồng và nhọn."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wurt_shadow
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wurt_shadow"
msgid "Those fins look ominous..."
msgstr "Những chiếc vây đó trông đáng ngại ..."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wurt_squid
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wurt_squid"
msgid "Hands are for suckers."
msgstr "Bàn tay là cho những kẻ hút."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wurt_survivor
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wurt_survivor"
msgid "They pack a slimy punch!"
msgstr "Họ gói một cú đấm nhầy nhụa!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_wurt_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wurt_victorian"
msgid "Wurt was never one to be treated with kid-gloves."
msgstr "Wurt không bao giờ là một người được đối xử bằng những đứa trẻ."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wurt_western
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wurt_western"
msgid "The sun brings out her natural color."
msgstr "Mặt trời làm nổi bật màu sắc tự nhiên của cô ấy."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wx78_ancient
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wx78_ancient"
msgid "A curse upon all you touch!"
msgstr "Một lời nguyền giáng xuống tất cả những gì bạn chạm vào!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_wx78_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wx78_gladiator"
msgid "Make them regret falling into your metallic clutches."
msgstr "Làm cho họ hối tiếc rơi vào ly hợp kim loại của bạn."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wx78_ice
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wx78_ice"
msgid "Ice cold robotic claws."
msgstr "Băng căm lạnh vuốt."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wx78_lunar
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wx78_lunar"
msgid "Silvery gloves for the moon's right-hand 'bot."
msgstr "Găng tay bạc cho bot bên phải của mặt trăng."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wx78_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wx78_magma"
msgid "Com-bust some heads in style sporting these Furnace Gloves."
msgstr "Com-bust Một số đầu trong phong cách thể thao này găng tay lò này."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wx78_nature
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wx78_nature"
msgid "Get in touch with nature with these clinging vine hand replacements."
msgstr "Hãy liên lạc với thiên nhiên với những thay thế bàn tay bám này."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wx78_pirate
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wx78_pirate"
msgid "These are the hands in an all-hands-on-deck situation."
msgstr "Đây là những ván bài trong tình huống tất cả đều tay trên boong."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wx78_retro
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wx78_retro"
msgid "All superfluous fingers have been eradicated for maximum efficiency."
msgstr "Tất cả các ngón tay thừa đã được xóa để hiệu quả tối đa."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wx78_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wx78_victorian"
msgid "These diving suit gloves are old and worn. They probably aren't waterproof anymore."
msgstr "Những chiếc găng tay lặn này đã cũ và mòn. Có lẽ họ không còn chống thấm nữa."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wx78_wip
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wx78_wip"
msgid "Just wires and bolts."
msgstr "Chỉ cần dây và bu lông."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wx78_wrestler
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wx78_wrestler"
msgid "These gears were made for grappling."
msgstr "Những bánh răng này đã được làm cho vật lộn."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wx78_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wx78_yule"
msgid "Wooden hands don't get quite as cold as metal ones."
msgstr "Bàn tay bằng gỗ không bị lạnh bằng kim loại."

#. STRINGS.SKIN_DESCRIPTIONS.hat_antlion_swamp
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hat_antlion_swamp"
msgid "Any turf from sod to swamp is swapped with a simple step."
msgstr "Bất kỳ sân cỏ nào từ cỏ đến đầm lầy đều được hoán đổi bằng một bước đơn giản."

#. STRINGS.SKIN_DESCRIPTIONS.hat_catcoon_costume
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hat_catcoon_costume"
msgid "Is that really a cap with a catcoon's face? You've gotta be kitten me!"
msgstr "Đó có thực sự là một chiếc mũ với khuôn mặt của một catcoon? Bạn phải là mèo con của tôi!"

#. STRINGS.SKIN_DESCRIPTIONS.hat_catcoon_costumep
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hat_catcoon_costumep"
msgid "Is that really a cap with a catcoon's face? You've gotta be kitten me!"
msgstr "Đó có thực sự là một chiếc mũ với khuôn mặt của một catcoon? Bạn phải là mèo con của tôi!"

#. STRINGS.SKIN_DESCRIPTIONS.hat_chester_costume
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hat_chester_costume"
msgid "They say that imitation is the sincerest form of flattery."
msgstr "Họ nói rằng bắt chước là hình thức tâng bốc chân thành nhất."

#. STRINGS.SKIN_DESCRIPTIONS.hat_chester_costumep
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hat_chester_costumep"
msgid "They say that imitation is the sincerest form of flattery."
msgstr "Họ nói rằng bắt chước là hình thức tâng bốc chân thành nhất."

#. STRINGS.SKIN_DESCRIPTIONS.hat_dog_helm
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hat_dog_helm"
msgid "BEWARE OF DOG."
msgstr "Coi chừng chó."

#. STRINGS.SKIN_DESCRIPTIONS.hat_dreadstone_horn
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hat_dreadstone_horn"
msgid "This helmet on your head will fill them with dread."
msgstr "Chiếc mũ bảo hiểm này trên đầu bạn sẽ làm họ khiếp sợ."

#. STRINGS.SKIN_DESCRIPTIONS.hat_glommer_costume
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hat_glommer_costume"
msgid "The goopiness inside the rim makes it glom to your head that much better!"
msgstr "Sự goopiness bên trong vành làm cho nó trở nên tốt hơn cho bạn tốt hơn nhiều!"

#. STRINGS.SKIN_DESCRIPTIONS.hat_glommer_costumep
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hat_glommer_costumep"
msgid "The goopiness inside the rim makes it glom to your head that much better!"
msgstr "Sự goopiness bên trong vành làm cho nó trở nên tốt hơn cho bạn tốt hơn nhiều!"

#. STRINGS.SKIN_DESCRIPTIONS.hat_hutch_costume
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hat_hutch_costume"
msgid "It's a Hutch hatch, for your head!"
msgstr "Đó là một hutch nở, cho đầu của bạn!"

#. STRINGS.SKIN_DESCRIPTIONS.hat_hutch_costumep
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hat_hutch_costumep"
msgid "It's a Hutch hatch, for your head!"
msgstr "Đó là một hutch nở, cho đầu của bạn!"

#. STRINGS.SKIN_DESCRIPTIONS.hat_ice_pengulls
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hat_ice_pengulls"
msgid "The most dignified way to cool down."
msgstr "Cách trang nghiêm nhất để hạ nhiệt."

#. STRINGS.SKIN_DESCRIPTIONS.hat_ice_shark
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hat_ice_shark"
msgid "You'll be so cool with this chiselled jaw."
msgstr "Bạn sẽ thật ngầu với chiếc hàm đục khoét này."

#. STRINGS.SKIN_DESCRIPTIONS.hat_puppy_cap
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hat_puppy_cap"
msgid "Not made of real puppies."
msgstr "không làm bằng chó con thực sự."

#. STRINGS.SKIN_DESCRIPTIONS.hat_woodcarved_swamp
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hat_woodcarved_swamp"
msgid "Somehow, it works. You'll be stumped."
msgstr "Bằng cách nào đó, nó hoạt động. Bạn sẽ bối rối."

#. STRINGS.SKIN_DESCRIPTIONS.heatrock_fantasy
msgctxt "STRINGS.SKIN_DESCRIPTIONS.heatrock_fantasy"
msgid "A warm glow radiates from deep within the crystal."
msgstr "Một ánh sáng ấm áp tỏa ra từ sâu bên trong tinh thể."

#. STRINGS.SKIN_DESCRIPTIONS.heatrock_fire
msgctxt "STRINGS.SKIN_DESCRIPTIONS.heatrock_fire"
msgid "A vibrant flame extracted in crystallized form from a passionate soul."
msgstr "Một ngọn lửa sôi động được chiết xuất ở dạng kết tinh từ một tâm hồn đam mê."

#. STRINGS.SKIN_DESCRIPTIONS.heatrock_planet
msgctxt "STRINGS.SKIN_DESCRIPTIONS.heatrock_planet"
msgid "A flame burns deep within."
msgstr "Ngọn lửa cháy sâu bên trong."

#. STRINGS.SKIN_DESCRIPTIONS.hermit_chair_rocking_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hermit_chair_rocking_yule"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.hermitcrab_coral
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hermitcrab_coral"
msgid "She's definitely going to pinch your cheeks."
msgstr "Cô ấy chắc chắn sẽ nhéo má bạn."

#. STRINGS.SKIN_DESCRIPTIONS.hermitcrab_hairy
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hermitcrab_hairy"
msgid "Beneath that abrasive exterior lies a warm and caring heart."
msgstr "Bên dưới vẻ ngoài thô ráp đó là một trái tim ấm áp và quan tâm."

#. STRINGS.SKIN_DESCRIPTIONS.hermitcrab_lightpost_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hermitcrab_lightpost_yule"
