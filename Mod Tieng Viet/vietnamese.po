msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.2.line"
msgid "Nobody knows what it really looks like..."
msgstr "Chẳng ai biết hình dạng thật của nó trông thế nào..."

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.3.duration
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.3.duration"
msgid "3.5"
msgstr "3.5"

