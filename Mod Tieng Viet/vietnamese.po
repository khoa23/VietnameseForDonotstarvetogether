#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY"
msgid "When's lunch?"
msgstr "Ăn trưa khi nào?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_FASTBUILD.1
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_FASTBUILD.1"
msgid "This's hungry work."
msgstr "Công việc làm cho tôi đói."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_FASTBUILD.2
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_FASTBUILD.2"
msgid "I'm working up an appetite."
msgstr "Tôi đang rất thèm ăn."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_FASTBUILD.3
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_FASTBUILD.3"
