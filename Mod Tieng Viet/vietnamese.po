msgstr "Nó đang làm tôi phát ốm."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERCORPSE.GENERIC"
