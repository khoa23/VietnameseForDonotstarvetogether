msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL.LEVEL3.2"
msgid "Fascinating. Can you speak, specter?"
msgstr "Lôi cuốn. Bạn có thể nói được không, bóng ma?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "Ah... I'm not familiar with this strain of flower."
msgstr "À... tôi không quen với loài hoa này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "Does it expect something of me?"
msgstr "Nó có mong đợi điều gì đó ở tôi không?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "I feel I should set it down now."
msgstr "Tôi cảm thấy mình nên đặt nó xuống ngay bây giờ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "It's emitting a strange energy."
msgstr "Nó đang phát ra một năng lượng kỳ lạ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "That flower has perked up quite a bit."
msgstr "Bông hoa đó đã tươi lên khá nhiều."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "Its magic has reached maximum potency."
msgstr "Phép thuật của nó đã đạt đến hiệu lực tối đa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "Odd..."
msgstr "Số lẻ..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "It's emitting a strange energy."
msgstr "Nó đang phát ra một năng lượng kỳ lạ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "The flower's energy is growing powerful."
msgstr "Năng lượng của bông hoa ngày càng mạnh mẽ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED"
msgid "It follows a particular movement pattern."
msgstr "Nó tuân theo một mô hình chuyển động cụ thể."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABYSSPILLAR_MINION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABYSSPILLAR_MINION.GENERIC"
msgid "A statue of a large insectoid form."
msgstr "Một bức tượng có hình dạng côn trùng lớn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABYSSPILLAR_TRIAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABYSSPILLAR_TRIAL"
msgid "A mechanical lever designed to actuate a mechanism."
msgstr "Một đòn bẩy cơ khí được thiết kế để kích hoạt một cơ cấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "I feel a compulsive urge to activate it, again and again."
msgstr "Tôi cảm thấy thôi thúc phải kích hoạt nó, hết lần này đến lần khác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACORN"
msgid "Deciduous seeds encased in a Pericarp."
msgstr "Hạt rụng lá được bọc trong Pericarp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACORN_COOKED"
msgid "The poison has been successfully cooked out of them."
msgstr "Chất độc đã được nấu thành công từ chúng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACORN_SAPLING"
msgid "Deciduous seeds approaching maturity."
msgstr "Hạt rụng lá sắp trưởng thành."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ADVENTURE_PORTAL"
msgid "That violates some pretty fundamental physical laws."
msgstr "Vi phạm một số định luật vật lý khá cơ bản."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIANHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIANHAT"
msgid "The multitudes of knowledge it contains... if only I could write it all down..."
msgstr "Vô số kiến thức mà nó chứa đựng... giá như tôi có thể viết ra tất cả..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIANHATSHARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIANHATSHARD"
msgid "These shards hold a significant amount of energy on their own."
msgstr "Bản thân những mảnh này chứa một lượng năng lượng đáng kể."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_CONTAINED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_CONTAINED"
msgid "I wonder what he means to do with all that energy."
msgstr "Tôi tự hỏi anh ấy định làm gì với tất cả năng lượng đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD"
msgid "Strange, I was expecting a bit more than that."
msgstr "Lạ lùng thay, tôi đã mong đợi nhiều hơn thế một chút."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC"
msgid "Our activities seem to have triggered a defense mechanism of sorts."
msgstr "Các hoạt động của chúng tôi dường như đã kích hoạt một loại cơ chế phòng thủ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT"
msgid "It has returned bursting with lunar energy."
msgstr "Nó đã trở lại bùng nổ với năng lượng mặt trăng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT"
msgid "This one is most definitely unique."
msgstr "Điều này chắc chắn là độc nhất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD"
msgid "I doubt it will stay inert for long."
msgstr "Tôi nghi ngờ nó sẽ trơ lâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC"
msgid "Interesting, it seems to utilize aspects of the altars for combat."
msgstr "Thật thú vị, nó dường như tận dụng các khía cạnh của bàn thờ để chiến đấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE"
msgid "I should endeavor to not become trapped by its barriers."
msgstr "Tôi nên cố gắng để không bị mắc kẹt bởi những rào cản của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE3"
msgid "If my assumptions are correct, this should be its final form."
msgstr "Nếu giả định của tôi là đúng thì đây sẽ là hình thức cuối cùng của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD"
msgid "With the energy removed, I doubt it will be able to re-form."
msgstr "Khi năng lượng bị loại bỏ, tôi nghi ngờ khả năng nó có thể tái tạo lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB"
msgid "Interesting, it seems to have retained the energy that powered it."
msgstr "Thật thú vị, nó dường như vẫn giữ được năng lượng cung cấp cho nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP"
msgid "They appear to have a sleep inducing effect. Best to stay away."
msgstr "Chúng dường như có tác dụng gây buồn ngủ. Tốt nhất nên tránh xa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT"
msgid "A curious amalgamation of machine parts and sentient lunar energy."
msgstr "Một sự kết hợp kỳ lạ giữa các bộ phận máy móc và năng lượng mặt trăng có tri giác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.AMULET"
msgid "A relic from another time."
msgstr "Một di tích từ thời điểm khác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCHOR"
msgid "An anchor for our vessel."
msgstr "Một cái neo cho tàu của chúng tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCHOR_ITEM"
msgid "It will allow us to create an anchor for our ships."
msgstr "Nó sẽ cho phép chúng ta tạo ra một chiếc neo cho tàu của mình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTFRUIT_GEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "I suspect burning away the tough outer skin might reveal something at its core."
msgstr "Tôi nghi ngờ việc đốt cháy lớp da cứng bên ngoài có thể tiết lộ điều gì đó ở cốt lõi của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "If consumed, it seems to improve one's vision in the darkness."
msgstr "Nếu tiêu thụ, nó dường như cải thiện tầm nhìn của một người trong bóng tối."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "A bit easier to digest, but lacking in any vision-improving effects."
msgstr "Dễ tiêu hóa hơn một chút nhưng không có bất kỳ tác dụng cải thiện thị lực nào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
msgid "How interesting, it seems to produce its own heat from within."
msgstr "Thật thú vị, có vẻ như nó sản sinh nhiệt từ bên trong."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_GEM.STUMP"
msgid "A shame, really."
msgstr "Thật đáng tiếc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
msgid "Could the sense of unease I feel be a part of its defense mechanism?"
msgstr "Liệu cảm giác bất an mà tôi cảm thấy có phải là một phần trong cơ chế bảo vệ của nó không?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
msgid "As I thought, the sense of unease has passed."
msgstr "Đúng như tôi nghĩ, cảm giác bất an đã qua đi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
msgid "It appears to be growing nicely."
msgstr "Nó có vẻ đang phát triển tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON"
msgid "Perhaps this is not the right time of year for it to thrive."
msgstr "Có lẽ đây không phải là thời điểm thích hợp trong năm để nó phát triển."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE"
msgid "This may not be a suitable environment for it."
msgstr "Có thể môi trường này không phù hợp với nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_SAPLING_ITEM"
msgid "I will endeavor to find a suitable environment for it."
msgstr "Tôi sẽ cố gắng tìm môi trường phù hợp cho nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_SEED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_SEED"
msgid "It's difficult to identify the species at this stage of development."
msgstr "Rất khó để xác định loài ở giai đoạn phát triển này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_ALTAR"
msgid "A monument to some long dead god."
msgstr "Một đài tưởng niệm cho một số thần chết từ lâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "Parts of this are missing."
msgstr "Các bộ phận của này là mất tích."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_HUSK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_HUSK"
msgid "It's obvious which of these ancients was the perpetrator."
msgstr "Rõ ràng ai trong số những người xưa này là thủ phạm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_STATUE"
msgid "This seems mystically aligned to the world."
msgstr "Điều này dường như nhiệm mầu phù hợp với thế giới."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANIMAL_TRACK"
msgid "A sign of animal activity. Leads away."
msgstr "Một dấu hiệu của hoạt động động vật. Dẫn đi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTCHOVIES"
msgid "Ah, I see! A brand new oceanic species!"
msgstr "Ah tôi thấy! Một loài đại dương hoàn toàn mới!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLION.GENERIC"
msgid "Ah. You must be behind all the seismic activity."
msgstr "Ah. Chắc hẳn bạn đứng đằng sau mọi hoạt động địa chấn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLION.UNHAPPY"
msgid "Panthera auropunctata is looking irritable."
msgstr "Panthera auropunctata trông có vẻ cáu kỉnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLION.VERYHAPPY"
msgid "It has been mollified with tributes."
msgstr "Nó đã được xoa dịu bằng những lời tri ân."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLIONHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLIONHAT"
msgid "It's quite convenient for landscaping."
msgstr "Nó khá thuận tiện cho việc tạo cảnh quan."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLIONTRINKET"
msgid "It appears to be a child's plaything."
msgstr "Có vẻ như đó là đồ chơi của trẻ con."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "An impressive piece of ancient engineering."
msgstr "Một mảnh ấn tượng của kỹ thuật cổ xưa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "These parts appear to be inoperative."
msgstr "Những bộ phận này dường như không hoạt động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "Now it's truly derelict."
msgstr "Bây giờ nó thật sự vô chủ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "It's got a bit to go before it's ready."
msgstr "Nó có một chút để đi trước khi nó đã sẵn sàng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "Almost done!"
msgstr "Sắp xong!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "Supper time!"
msgstr "Hiện Supper!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "I suspect it must have had a purpose specific to these chambers."
msgstr "Tôi nghi ngờ nó hẳn phải có mục đích cụ thể cho những căn phòng này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "It seems to require an outside power source to activate."
msgstr "Có vẻ như nó cần nguồn điện bên ngoài để kích hoạt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "Somehow, the ancients devised a way to store knowledge in liquid form."
msgstr "Bằng cách nào đó, người xưa đã nghĩ ra cách lưu trữ kiến thức ở dạng lỏng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "It appears to lack an energy source."
msgstr "Nó dường như thiếu một nguồn năng lượng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "These chambers appear to pre-date the rest of the ruins."
msgstr "Những căn phòng này dường như có niên đại trước phần còn lại của tàn tích."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "There must be a manual somewhere."
msgstr "Chắc chắn phải có sách hướng dẫn ở đâu đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "A shame, it appears to no longer be operational."
msgstr "Thật đáng tiếc, nó dường như không còn hoạt động nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "The design is reminiscent of the Gateways we've traversed through before."
msgstr "Thiết kế gợi nhớ đến những Cổng mà chúng ta đã đi qua trước đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "The path to discovery awaits."
msgstr "Con đường khám phá đang chờ đợi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "It appears there are no more artifacts to find."
msgstr "Có vẻ như không còn hiện vật nào để tìm nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "How exciting! This technology most likely hasn't been used in hundreds of years!"
msgstr "Thật thú vị! Công nghệ này rất có thể đã không được sử dụng trong hàng trăm năm!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "Fascinating! These glyphs seem to be the base that their language evolved from."
msgstr "Lôi cuốn! Những hình tượng này dường như là nền tảng mà ngôn ngữ của họ phát triển từ đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2"
msgid "The introduction of shadow fuel must have had a tremendous impact on their culture."
msgstr "Sự ra đời của nhiên liệu bóng tối hẳn đã có tác động to lớn đến văn hóa của họ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3"
msgid "These glyphs must pre-date their discovery of the shadow fuel."
msgstr "Những hình khắc này phải có trước thời điểm họ phát hiện ra nhiên liệu bóng tối."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
msgid "This glyph in particular keeps repeating... if only I could decipher its meaning."
msgstr "Đặc biệt, hình tượng này cứ lặp đi lặp lại... giá như tôi có thể giải mã được ý nghĩa của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
msgid "This will need further study."
msgstr "Điều này sẽ cần nghiên cứu thêm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
msgid "It appears to be a remarkably advanced security system."
msgstr "Nó dường như là một hệ thống an ninh tiên tiến đáng chú ý."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
msgid "I wonder what its intended purpose was."
msgstr "Tôi tự hỏi mục đích dự định của nó là gì."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_SECURITY_PULSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_SECURITY_PULSE"
msgid "It seems unwise to follow it."
msgstr "Có vẻ như không khôn ngoan khi làm theo nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_SWITCH.GEMS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_SWITCH.GEMS"
msgid "It appears to require a specific gem to activate."
msgstr "Có vẻ như nó yêu cầu một loại đá quý cụ thể để kích hoạt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_SWITCH.VALID
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_SWITCH.VALID"
msgid "The pedestals seem to draw power from these gems."
msgstr "Những chiếc bệ dường như lấy năng lượng từ những viên đá quý này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORDRAGONFLY"
msgid "Pyrotechnic armor!"
msgstr "Áo giáp pháo hoa!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORDREADSTONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORDREADSTONE"
msgid "Extremely durable, and surprisingly lightweight."
msgstr "Cực kỳ bền và nhẹ đáng ngạc nhiên."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORGRASS"
msgid "Surprisingly effective with enough layers."
msgstr "Đáng ngạc nhiên là hiệu quả với đủ các lớp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORMARBLE"
msgid "An interesting choice of materials."
msgstr "Một sự lựa chọn thú vị của vật liệu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORRUINS"
msgid "A hardy Thulecite armor."
msgstr "Một bộ giáp Thulecite cứng cáp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORSKELETON"
msgid "Now it's an exoskeleton. Ho ho!"
msgstr "Bây giờ nó là một bộ xương ngoài. Hô hô!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORSLURPER"
msgid "A disgusting and magical garment."
msgstr "Một kinh tởm và kỳ diệu may mặc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORSNURTLESHELL"
msgid "It is quite capacious."
msgstr "Nó là khá rộng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORWAGPUNK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORWAGPUNK"
msgid "I do wish it wasn't quite so noisy."
msgstr "Tôi ước nó không quá ồn ào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORWOOD"
msgid "Crude plate mail cobbled together from log sections."
msgstr "Thô email tấm gom góp từ phần đăng nhập."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_BRAMBLE"
msgid "I believe our friend knit it himself."
msgstr "Tôi tin rằng bạn của chúng ta đã tự đan nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_CARROTLURE"
msgid "This will be a big hit with the bunnymen."
msgstr "Điều này sẽ rất hợp với người thỏ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_LUNARPLANT"
msgid "Surprisingly effective plant-based armor."
msgstr "Áo giáp làm từ thực vật có hiệu quả đáng kinh ngạc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_LUNARPLANT_HUSK"
msgid "Plant-based, plant-made, and plant-worn."
msgstr "Dựa trên thực vật, làm từ thực vật và mòn từ thực vật."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_SANITY"
msgid "A protective shroud that transfers attacks to another dimension."
msgstr "Một tấm vải liệm bảo vệ chuyển các cuộc tấn công sang một chiều không gian khác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_VOIDCLOTH"
msgid "Armor against metaphysical damage."
msgstr "Áo giáp chống lại sát thương siêu hình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_YOTH_KNIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_YOTH_KNIGHT"
msgid "The rose decorating this armor is the maker's insignia."
msgstr "Hoa hồng trang trí bộ giáp này là phù hiệu của người chế tạo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "Not much of an aid now."
msgstr "Không nhiều của một viện trợ bây giờ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "A navigational aid. \"Thataway\"."
msgstr "Một trợ giúp điều hướng. \"Điều đó đi\"."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "A chance to give direction."
msgstr "Một để đem đến hướng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "Not much of an aid now."
msgstr "Không nhiều của một viện trợ bây giờ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "A navigational aid. \"Thataway\"."
msgstr "Một trợ giúp điều hướng. \"Điều đó đi\"."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "A chance to give direction."
msgstr "Một để đem đến hướng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.GENERIC"
msgid "Some non-aqueous residue remains after the fire."
msgstr "Một số cặn không chứa nước còn sót lại sau đám cháy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "The eyebone seems to have been burned entirely."
msgstr "Các eyebone dường như đã bị đốt cháy hoàn toàn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "The flower appears to have been completely burned up."
msgstr "Các hoa dường như đã hoàn toàn bị đốt cháy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "This used to be something, but now it's just a pile of ash."
msgstr "Đây từng là một thứ gì đó, nhưng bây giờ nó chỉ là một đống tro tàn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASPARAGUS"
msgid "A great source of dietary fiber."
msgstr "Một nguồn chất xơ tuyệt vời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASPARAGUSSOUP"
msgid "Smelly, but quite nutritious."
msgstr "Mùi nhưng khá bổ dưỡng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASPARAGUS_COOKED"
msgid "It releases sulfur compounds when it's digested."
msgstr "Nó giải phóng các hợp chất lưu huỳnh khi được tiêu hóa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASPARAGUS_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASPARAGUS_OVERSIZED"
msgid "It's quite the source of fiber!"
msgstr "Đó thực sự là nguồn chất xơ!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASPARAGUS_SEEDS"
msgid "It can't begin growing until it's been planted, dear."
msgstr "Nó không thể bắt đầu phát triển cho đến khi nó được trồng, em yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "It is storing power."
msgstr "Nó đang lưu trữ năng lượng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "We must be patient."
msgstr "Chúng ta phải kiên nhẫn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "We'd best not be around when it goes off."
msgstr "Tốt nhất chúng ta không nên ở đây khi nó nổ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.OFF"
msgid "Now where might that lead?"
msgstr "Bây giờ điều đó có thể dẫn đến đâu?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.ON"
msgid "That's taken care of."
msgstr "Việc đó đã được xử lý."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_KEY"
msgid "The key to that old gateway."
msgstr "Chìa khóa của cánh cổng cũ đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "I suspect it is powered by that horrible fuel."
msgstr "Tôi nghi ngờ nó được cung cấp năng lượng bởi thứ nhiên liệu khủng khiếp đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "Indeed. It gained power from the key."
msgstr "Thực vậy. Nó có được sức mạnh từ chìa khóa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "It would take much too long to decipher."
msgstr "Sẽ mất rất nhiều thời gian để giải mã."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "An ancient mural of a non-mammalian civilization."
msgstr "Một bức tranh tường cổ về nền văn minh phi động vật có vú."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "This mural panel is too eroded to decipher."
msgstr "Bức tranh tường này đã bị xói mòn quá mức để giải mã."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "A dark shadow, or perhaps a substance, overtakes the civilization."
msgstr "Một bóng tối, hoặc có lẽ là một vật chất, đang xâm chiếm nền văn minh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "The citizens molt from their exoskeletons in this panel."
msgstr "Các công dân lột xác từ bộ xương ngoài của họ trong bảng này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "The city appears exponentially more prosperous."
msgstr "Thành phố dường như thịnh vượng hơn theo cấp số nhân."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_STATUE"
msgid "It refuses to comply with this world's laws."
msgstr "Nó từ chối tuân thủ luật pháp của thế giới này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.AXE"
msgid "A dual inclined plane attached to a lever."
msgstr "Một mặt phẳng nghiêng kép gắn liền với một đòn bẩy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "Look at his widdle face! (Ahem!)"
msgstr "Hãy nhìn vào khuôn mặt lém lỉnh của anh ấy! (Ừm!)"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "He's even more darling in sleep."
msgstr "Anh ấy thậm chí còn đáng yêu hơn khi ngủ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BACKPACK"
msgid "That could carry so many books."
msgstr "Cái đó có thể mang theo rất nhiều sách."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BACONEGGS"
msgid "Blue eggs and bacon!"
msgstr "Trứng xanh và thịt xông khói!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALATRO_MACHINE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALATRO_MACHINE"
msgid "One must know when the time for games has passed. Now is not that time."
msgstr "Người ta phải biết khi nào thời gian dành cho trò chơi đã trôi qua. Bây giờ không phải lúc đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOON"
msgid "Could serve as a suitable diversion."
msgstr "Có thể phục vụ như một sự chuyển hướng thích hợp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONHAT"
msgid "I believe it's meant to evoke the image of a Lagomorph."
msgstr "Tôi tin rằng nó nhằm mục đích gợi lên hình ảnh của một con Lagomorph."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONPARTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONPARTY"
msgid "A reasonable amount of cheer every so often would do us good."
msgstr "Một lượng cổ vũ vừa phải thường xuyên sẽ có ích cho chúng ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONSPEED.DEFLATED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONSPEED.DEFLATED"
msgid "Probably not enough air left to analyze its composition..."
msgstr "Có lẽ không còn đủ không khí để phân tích thành phần của nó..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONSPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONSPEED.GENERIC"
msgid "The chemical composition of the young man's breath must be fascinating."
msgstr "Thành phần hóa học trong hơi thở của chàng trai chắc hẳn rất hấp dẫn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONS_EMPTY"
msgid "These seem frivolous."
msgstr "Những điều này có vẻ phù phiếm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONVEST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONVEST"
msgid "I applaud your attempt at practicality, dear."
msgstr "Tôi hoan nghênh nỗ lực thực tế của bạn, bạn thân mến."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BANANABUSH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BANANABUSH"
msgid "The fruit is remarkably similar to the subterranean strain."
msgstr "Quả này rất giống với chủng dưới lòng đất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BANANAJUICE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BANANAJUICE"
msgid "Ah, I was in need of some refreshment."
msgstr "À, tôi đang cần chút gì đó sảng khoái."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BANANAPOP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BANANAPOP"
msgid "Well, isn't that refreshing?"
msgstr "Chà, thế không phải là sảng khoái sao?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BANDAGE"
msgid "Medicinal dressings."
msgstr "Băng thuốc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BANDAGE_BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BANDAGE_BUTTERFLYWINGS"
msgid "A delicate dressing made of butterfly wings."
msgstr "Một chiếc váy tinh tế làm từ cánh bướm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLE"
msgid "People in ancient times believed geese grew from barnacles. Can you imagine?"
msgstr "Người xưa tin rằng ngỗng sinh ra từ hà. Bạn có thể tưởng tượng được không?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLEPITA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLEPITA"
msgid "A rather interesting combination."
msgstr "Một sự kết hợp khá thú vị."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLESTUFFEDFISHHEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLESTUFFEDFISHHEAD"
msgid "I don't think I can stomach it."
msgstr "Tôi không nghĩ tôi có thể nuốt nổi nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLESUSHI
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLESUSHI"
msgid "I think I'm developing a taste for it."
msgstr "Tôi nghĩ tôi đang phát triển sở thích về nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLE_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLE_COOKED"
msgid "As I suspected, it tastes nothing like goose."
msgstr "Đúng như tôi nghi ngờ, nó có vị không giống thịt ngỗng chút nào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLINGUINE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLINGUINE"
msgid "Oh my, it's very rich."
msgstr "Ôi trời, nó rất phong phú."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BASALT"
msgid "Material of great density!"
msgstr "Chất liệu của mật độ tuyệt vời!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BAT"
msgid "A flying mammal."
msgstr "Một động vật có vú biết bay."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATBAT"
msgid "Interesting. This weapon appears to be alive."
msgstr "Hấp dẫn. Vũ khí này xuất hiện để được sống."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATCAVE"
msgid "This nook is actually a dwelling."
msgstr "Góc này thực chất là nơi ở."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATHBOMB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATHBOMB"
msgid "Ah, I do love a warm bath with a book."
msgstr "À, tôi rất thích tắm nước ấm với một cuốn sách."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATNOSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATNOSE"
msgid "Evolution truly is remarkable."
msgstr "Sự tiến hóa thực sự đáng chú ý."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATNOSEHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATNOSEHAT"
msgid "How... innovative."
msgstr "Thật là... đổi mới."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATNOSE_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATNOSE_COOKED"
msgid "It's moderately better."
msgstr "Nó khá hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_CONTAINER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_CONTAINER"
msgid "A specialized container for sheet music."
msgstr "Hộp đựng chuyên dụng cho bản nhạc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_DURABILITY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_DURABILITY"
msgid "Musical notation, if I'm not mistaken."
msgstr "Ký hiệu âm nhạc, nếu tôi không nhầm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_FIRERESISTANCE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_FIRERESISTANCE"
msgid "Musical notation, if I'm not mistaken."
msgstr "Ký hiệu âm nhạc, nếu tôi không nhầm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_HEALTHGAIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_HEALTHGAIN"
msgid "Musical notation, if I'm not mistaken."
msgstr "Ký hiệu âm nhạc, nếu tôi không nhầm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_INSTANT_PANIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_INSTANT_PANIC"
msgid "Ah, how I love the classics!"
msgstr "Ôi, tôi yêu những tác phẩm kinh điển biết bao!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_INSTANT_REVIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_INSTANT_REVIVE"
msgid "Musical notation, if I'm not mistaken."
msgstr "Ký hiệu âm nhạc, nếu tôi không nhầm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_INSTANT_TAUNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_INSTANT_TAUNT"
msgid "Oh my, those are some rather colorful turns of phrase."
msgstr "Ôi trời, đó là một số cụm từ khá đầy màu sắc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_LUNARALIGNED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_LUNARALIGNED"
msgid "Musical notation, if I'm not mistaken."
msgstr "Ký hiệu âm nhạc, nếu tôi không nhầm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_SANITYAURA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_SANITYAURA"
msgid "Musical notation, if I'm not mistaken."
msgstr "Ký hiệu âm nhạc, nếu tôi không nhầm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_SANITYGAIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_SANITYGAIN"
msgid "Musical notation, if I'm not mistaken."
msgstr "Ký hiệu âm nhạc, nếu tôi không nhầm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_SHADOWALIGNED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_SHADOWALIGNED"
msgid "Musical notation, if I'm not mistaken."
msgstr "Ký hiệu âm nhạc, nếu tôi không nhầm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATWING"
msgid "Technically edible."
msgstr "Về mặt kỹ thuật ăn được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATWING_COOKED"
msgid "Technically edible."
msgstr "Về mặt kỹ thuật ăn được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARDHAIR"
msgid "This is human facial hair."
msgstr "Đây là tóc trên khuôn mặt của con người."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGER"
msgid "It's the Caniformia suborder... Beyond that, I cannot say."
msgstr "Nó thuộc phân bộ phân bộ dạng chó ... Ngoài ra, tôi không thể nói."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGERCORPSE.BURNING"
msgid "I'm relieved to see it go."
msgstr "Tôi cảm thấy nhẹ nhõm khi thấy nó đi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGERCORPSE.GENERIC"
msgid "It could lead to trouble if it's not promptly disposed of."
msgstr "Nó có thể dẫn đến rắc rối nếu không được xử lý kịp thời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGERCORPSE.REVIVING"
msgid "Oh dear. It seems I'm too late."
msgstr "Ôi trời ơi. Có vẻ như tôi đã quá muộn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGERFUR_SACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGERFUR_SACK"
msgid "A portable chilling unit. Well and good, but cold food makes my teeth ache."
msgstr "Một thiết bị làm lạnh di động. Tốt thôi, nhưng đồ ăn nguội khiến răng tôi đau nhức."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGERVEST"
msgid "Whatever it was, its pelt makes for a fine garment."
msgstr "Dù nó là gì đi nữa, bộ da của nó vẫn tạo nên một bộ quần áo đẹp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGER_FUR"
msgid "My, my! That is thick."
msgstr "Tôi của tôi! Đó là dày."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEAST_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEAST_BLUEPRINT"
msgid "I'm not one to rely on luck, but a bit won't hurt in a competition."
msgstr "Tôi không phải là người dựa vào may mắn, nhưng một chút cũng không hại gì khi thi đấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEDROLL_FURRY"
msgid "I'm not sleeping on the ground."
msgstr "Tôi không ngủ trên mặt đất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEDROLL_STRAW"
msgid "I'm not sleeping on the ground."
msgstr "Tôi không ngủ trên mặt đất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEE.GENERIC"
msgid "Apis mellifera. Quite large!"
msgstr "Apis mellifera. Khá lớn!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEE.HELD"
msgid "It is not pleased."
msgstr "Nó không phải là hài lòng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.BURNT"
msgid "Poor bees!"
msgstr "Tội nghiệp những con ong!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.FULLHONEY"
msgid "Honey can be harvested from it."
msgstr "Mật ong có thể được thu hoạch từ nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.GENERIC"
msgid "A crude apiary."
msgstr "Một nhà nuôi ong thô."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.NOHONEY"
msgid "It's devoid of honey."
msgstr "Đó là không có mật ong."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.READY"
msgid "Honey can be harvested from it."
msgstr "Mật ong có thể được thu hoạch từ nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "It's not ready for harvesting."
msgstr "Đó là chưa sẵn sàng cho thu hoạch."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.BURNT"
msgid "Poor bees!"
msgstr "Tội nghiệp những con ong!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.FULLHONEY"
msgid "Honey can be harvested from it."
msgstr "Mật ong có thể được thu hoạch từ nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.GENERIC"
msgid "It appears to be a crudely fashioned apiary."
msgstr "Nó có vẻ là một nhà nuôi ong được thiết kế thô sơ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "It's devoid of honey."
msgstr "Đó là không có mật ong."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "Honey can be harvested from it."
msgstr "Mật ong có thể được thu hoạch từ nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "It's not ready for harvesting."
msgstr "Đó là chưa sẵn sàng cho thu hoạch."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.DEAD"
msgid "It's not breathing."
msgstr "Nó không còn thở nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.DEAD_MYPARTNER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.DEAD_MYPARTNER"
msgid "There may yet be a way to revive it..."
msgstr "Có thể vẫn còn cách để hồi sinh nó…"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "While tame, it has become dependent on its human master."
msgstr "Trong khi được thuần hóa, nó đã trở nên phụ thuộc vào chủ nhân con người."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.FOLLOWER"
msgid "It appears to be following me."
msgstr "Nó xuất hiện để được đi theo tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.GENERIC"
msgid "It looks almost like a Bos Taurus."
msgstr "Nó trông gần giống như một Bos Taurus."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.MYPARTNER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.MYPARTNER"
msgid "It has become rather attached to me."
msgstr "Nó đã trở nên khá gắn bó với tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.NAKED"
msgid "It looks cold."
msgstr "Có vẻ lạnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.ORNERY"
msgid "The creature has developed a nasty disposition."
msgstr "Sinh vật này đã phát triển một tính cách khó chịu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.PUDGY"
msgid "Abundant nourishment has led to an amicable personality."
msgstr "Dinh dưỡng dồi dào đã dẫn đến một tính cách thân thiện."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.RIDER"
msgid "This one seems lean and athletic."
msgstr "Cái này có vẻ gầy và thể thao."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.SLEEPING"
msgid "It's sleeping."
msgstr "Nó đang ngủ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALOFEED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALOFEED"
msgid "Beefalo seem to be quite adept at digesting sticks."
msgstr "Bò Lai có vẻ khá thành thạo trong việc tiêu hóa que củi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALOHAT"
msgid "This hat is hideous."
msgstr "Chiếc mũ này thật gớm ghiếc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALOTREAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALOTREAT"
msgid "We all could use a little treat from time to time."
msgstr "Thỉnh thoảng tất cả chúng ta đều có thể sử dụng một chút chiêu đãi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALOWOOL"
msgid "Long follicles harvested from the beefalo."
msgstr "Các nang dài được thu hoạch từ thịt bò."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO_GROOMER.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO_GROOMER.BURNT"
msgid "What an unfortunate turn of events."
msgstr "Thật là một sự việc đáng tiếc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO_GROOMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO_GROOMER.GENERIC"
msgid "These creatures require regular grooming."
msgstr "Những sinh vật này đòi hỏi phải chải chuốt thường xuyên."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO_GROOMER.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO_GROOMER.OCCUPIED"
msgid "Let's get you looking a bit more presentable, shall we?"
msgstr "Chúng ta hãy giúp bạn trông chỉnh tề hơn một chút nhé?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO_GROOMER_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO_GROOMER_ITEM"
msgid "I'd best get it set up."
msgstr "Tốt nhất tôi nên thiết lập nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEF_BELL"
msgid "Something about its tone triggers an affectionate response in beefalo."
msgstr "Có điều gì đó trong giọng điệu của nó gây ra phản ứng trìu mến trong thịt bò."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEGUARD"
msgid "Very angry Apis mellifera workers!"
msgstr "Công nhân Apis mellifera rất tức giận!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEHAT"
msgid "Appropriate protective equipment is a must!"
msgstr "Thiết bị bảo vệ phù hợp là phải!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEHIVE"
msgid "The natural home of the bee."
msgstr "Các nhà tự nhiên của con ong."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEMINE"
msgid "A dangerous mine filled with Antophila."
msgstr "Một mỏ nguy hiểm đầy Antophila."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEMINE_MAXWELL"
msgid "A dangerous mine filled with Culicidae."
msgstr "Một mỏ nguy hiểm đầy Culicidae."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEQUEEN"
msgid "The workers ferociously protect her."
msgstr "Các công nhân quyết liệt bảo vệ cô."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "Thick Apis mellifera honeycomb."
msgstr "Tổ ong Apis mellifera dày."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "The Apis mellifera are constructing a new hive."
msgstr "Apis mellifera đang xây dựng một tổ ong mới."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "An Apis mellifera nest of unusual size."
msgstr "Một tổ Apis mellifera có kích thước khác thường."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEESWAX"
msgid "Naturally antibacterial. Could slow food decay if we use it properly."
msgstr "Kháng khuẩn tự nhiên. Có thể làm chậm quá trình phân hủy thực phẩm nếu chúng ta sử dụng đúng cách."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEESWAX_SPRAY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEESWAX_SPRAY"
msgid "It has an unpleasantly astringent odor."
msgstr "Nó có mùi làm se khó chịu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEETLETAUR"
msgid "That lock must be heavy on its snout."
msgstr "Cái khóa đó chắc mõm nó nặng lắm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BELL"
msgid "Quiet! This is a library!"
msgstr "Yên tĩnh! Đây là một thư viện!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERNIE_ACTIVE"
msgid "That teddy bear seems to be animated somehow."
msgstr "Đó gấu bông dường như được hoạt hình bằng cách nào đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERNIE_BIG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERNIE_BIG"
msgid "As whimsical as it is befuddling."
msgstr "Vừa kì quái vừa đáng kinh ngạc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "That bear is in need of repair."
msgstr "Con gấu đó đang cần được sửa chữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "It's a teddy bear."
msgstr "Đó là một con gấu bông."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRIES"
msgid "Some Ardisia crenata berries, I think."
msgstr "Một số loại quả mọng crenata Ardisia, tôi nghĩ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRIES_COOKED"
msgid "Roasted Ardisia crenata, just in case."
msgstr "Rang Ardisia crenata, chỉ trong trường hợp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRIES_JUICY"
msgid "A variant of Ardisia crenata berries. Good hydration."
msgstr "Một biến thể của quả Ardisia crenata. Dưỡng ẩm tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "Spoilage is a constant threat."
msgstr "Sự hư hỏng là một mối đe dọa thường xuyên."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.BARREN"
msgid "It will require an intervention."
msgstr "Nó sẽ yêu cầu một sự can thiệp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.BURNING"
msgid "Combustion!"
msgstr "Thiêu Đốt!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.DISEASED"
msgid "It's afflicted with an agrarian disease beyond my curing."
msgstr "Nó mắc phải một căn bệnh nông nghiệp mà tôi không thể chữa khỏi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.DISEASING"
msgid "Hm... The leaves are curling at the edges."
msgstr "Ừm... Những chiếc lá đang cuộn tròn ở mép."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.GENERIC"
msgid "It's an Ardisia crenata bush."
msgstr "Đây là một bụi cây Ardisia crenata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.PICKED"
msgid "The berries are growing back, slowly."
msgstr "Các quả đang phát triển trở lại, từ từ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.WITHERED"
msgid "Ardisia crenata don't do well in extreme heat."
msgstr "Ardisia crenata không làm tốt trong nhiệt độ cực đoan."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "It needs some agricultural attention."
msgstr "Nó cần một số sự chú ý về mặt nông nghiệp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "Combustion!"
msgstr "Thiêu Đốt!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "It's afflicted with an agrarian disease beyond my curing."
msgstr "Nó mắc phải một căn bệnh nông nghiệp mà tôi không thể chữa khỏi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "Hm... The leaves are curling at the edges."
msgstr "Ừm... Những chiếc lá đang cuộn tròn ở mép."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "That bush looks ready for harvest."
msgstr "Bụi cây đó có vẻ đã sẵn sàng cho thu hoạch."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "It will have to wait."
msgstr "Nó sẽ phải chờ đợi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "The Ardisia crenata variant has shriveled in the heat."
msgstr "Biến thể Ardisia crenata đã teo lại vì nắng nóng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYSAUCE"
msgid "How festive!"
msgstr "Thật là lễ hội!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIBINGKA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIBINGKA"
msgid "Traditionally, bibingka is baked in a specialized clay oven."
msgstr "Theo truyền thống, bibingka được nướng trong lò đất sét chuyên dụng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIGFOOT"
msgid "Prehistoric!"
msgstr "Tiền sử!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRCHNUTDRAKE"
msgid "Run awaaay!"
msgstr "Chạy awaaay!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.DEAD"
msgid "I do believe he has starved."
msgstr "Tôi tin rằng ông đã bị bỏ đói."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.GENERIC"
msgid "This will safely contain one avian specimen."
msgstr "Điều này sẽ an toàn có chứa một mẫu gia cầm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "He's getting hungry."
msgstr "Ông thấy đói."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "He is contained."
msgstr "Ông được chứa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.SKELETON"
msgid "I guess I could study the bones."
msgstr "Tôi đoán tôi có thể nghiên cứu các xương."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "Shhhhh!"
msgstr "Shhhhh!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.STARVING"
msgid "He's looking a bit malnourished."
msgstr "Anh ta đang nhìn một chút suy dinh dưỡng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCORPSE.BURNING"
msgid "This is, in fact, saving it."
msgstr "Trên thực tế, đây là cách cứu nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCORPSE.GENERIC"
msgid "If only this were the end for the little bird."
msgstr "Giá như đây là kết thúc dành cho chú chim nhỏ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCORPSE.REVIVING"
msgid "The little bird is on a different path now... terrible one."
msgstr "Con chim nhỏ bây giờ đang đi trên một con đường khác... thật khủng khiếp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDTRAP"
msgid "A simple clap-trap for birds."
msgstr "Một tiếng vỗ tay cái bẫy đơn giản cho các loài chim."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRD_EGG"
msgid "It is unfertilized."
msgstr "Đó là chưa được thụ tinh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRD_EGG_COOKED"
msgid "Just needs some toast."
msgstr "Chỉ cần một ít bánh mì nướng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRD_MUTANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRD_MUTANT"
msgid "Oh dear, that creature looks unwell."
msgstr "Ôi trời, sinh vật đó trông không khỏe."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRD_MUTANT_SPITTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRD_MUTANT_SPITTER"
msgid "The poor thing appears to have been altered by unnatural means."
msgstr "Điều đáng thương dường như đã bị thay đổi bằng những cách không tự nhiên."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BISHOP"
msgid "A clockwork clergyman."
msgstr "Một đồng hồ mục sư."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Augh!"
msgstr "Augh!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BISHOP_NIGHTMARE"
msgid "Such exhilaratingly complex technology."
msgstr "Như công nghệ exhilaratingly phức tạp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLACKFLAG"
msgid "Historically, pirates also sailed under red or white flags."
msgstr "Trong lịch sử, cướp biển cũng đi thuyền dưới cờ đỏ hoặc trắng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_FIRE"
msgid "Improvised inflammatory device."
msgstr "Improvised thiết bị viêm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_LAVA"
msgid "I haven't the lung capacity for such a thing."
msgstr "Tôi không có đủ phổi để làm việc đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_LAVA2"
msgid "I'll leave that to the younger folks."
msgstr "Tôi sẽ để việc đó cho những người trẻ tuổi hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_PIPE"
msgid "Improvised missile device."
msgstr "Thiết bị tên lửa cải tiến."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_SLEEP"
msgid "Improvised tranquilizer device."
msgstr "Improvised thiết bị an thần."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_YELLOW"
msgid "Improvised electric device."
msgstr "Thiết bị điện cải tiến."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUEAMULET"
msgid "The gem appears to be sucking energy out anything it touches."
msgstr "Viên ngọc dường như đang hút năng lượng ra khỏi bất cứ thứ gì nó chạm vào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUEGEM"
msgid "It is cold."
msgstr "Trời lạnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUEMOONEYE"
msgid "An excellent marker for group coordination."
msgstr "Một điểm đánh dấu tuyệt vời cho sự phối hợp nhóm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUEPRINT.COMMON"
msgid "A detailed technical drawing."
msgstr "Một bản vẽ kỹ thuật chi tiết."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUEPRINT.RARE"
msgid "Such a rare and detailed drawing!"
msgstr "Thật là một bản vẽ hiếm và chi tiết!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUE_CAP"
msgid "This seems to have medicinal properties."
msgstr "Điều này dường như có đặc tính chữa bệnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUE_CAP_COOKED"
msgid "Chemistry has altered it."
msgstr "Hóa học đã thay đổi nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "It is a fungus."
msgstr "Nó là một loại nấm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "It is dormant this time of day."
msgstr "Nó là không hoạt động thời gian này trong ngày."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "It requires hydration before it can fruit again."
msgstr "Nó cần hydrat hóa trước khi có thể sinh trái trở lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOARDS"
msgid "Roughly hewn wood boards."
msgstr "Khoảng đẽo bảng gỗ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOARON"
msgid "They appear to be used as fodder."
msgstr "Chúng dường như được sử dụng làm thức ăn gia súc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOARRIOR"
msgid "We best not underestimate that one."
msgstr "Tốt nhất chúng ta không nên đánh giá thấp điều đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATFRAGMENT03"
msgid "What a pity."
msgstr "Thật đáng tiếc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATFRAGMENT04"
msgid "What a pity."
msgstr "Thật đáng tiếc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATFRAGMENT05"
msgid "What a pity."
msgstr "Thật đáng tiếc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATPATCH"
msgid "For repairing hull damages."
msgstr "Để sửa chữa các hư hỏng của thân tàu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATPATCH_KELP"
msgid "A temporary solution, but better than nothing."
msgstr "Một giải pháp tạm thời, nhưng vẫn tốt hơn không có gì."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "This should help us stay on course."
msgstr "Điều này sẽ giúp chúng ta đi đúng hướng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "Its placement must be strategic."
msgstr "Vị trí của nó phải chiến lược."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "A shadowy opponent to keep things interesting."
msgstr "Một đối thủ mờ ám để giữ cho mọi thứ thú vị."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_SEASTACK"
msgid "Best to avoid that!"
msgstr "Tốt nhất nên tránh thứ đó!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Best to avoid that!"
msgstr "Tốt nhất nên tránh thứ đó!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "I wouldn't dream of using any underhanded tactics to win. I'll exercise caution."
msgstr "Tôi sẽ không thích gian lận để thắng. Tôi trân trọng điều đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "I wouldn't dream of using any underhanded tactics to win. I'll exercise caution."
msgstr "Tôi sẽ không thích gian lận để thắng. Tôi trân trọng điều đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "It seems content to watch the proceedings."
msgstr "Có vẻ như nội dung để xem quá trình tố tụng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_START"
msgid "I do love a good old fashioned boat race."
msgstr "Tôi rất thích một cuộc đua thuyền kiểu cũ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "We must determine the best spot to start and finish the race."
msgstr "Chúng ta phải xác định điểm tốt nhất để bắt đầu và kết thúc của cuộc đua này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "This vessel is outfitted with a convenient storage receptacle."
msgstr "Tàu này được trang bị một thùng chứa lưu trữ thuận tiện."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "The style is reminiscent of the ships from days of old."
msgstr "Phong cách gợi nhớ đến những con tàu ngày xưa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_CRABKING"
msgid "A thick barrier of geocrustacean exoskeleton."
msgstr "Một lớp vỏ dày của loài giáp xác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_CRABKING_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_CRABKING_KIT"
msgid "It would be wise to equip the boat with a protective barrier."
msgstr "Sẽ là khôn ngoan nếu trang bị cho thuyền một hàng rào bảo vệ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_KELP"
msgid "A thick barrier of Nereocystis luetkeana."
msgstr "Một hàng rào dày của Nereocystis luetkeana."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "It would be wise to equip the boat with a protective barrier."
msgstr "Sẽ là khôn ngoan nếu trang bị cho thuyền một hàng rào bảo vệ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "A thick barrier of mollusks."
msgstr "Một hàng rào dày của động vật thân mềm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "It would be wise to equip the boat with a protective barrier."
msgstr "Sẽ là khôn ngoan nếu trang bị cho thuyền một hàng rào bảo vệ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "The effect is admittedly quite striking."
msgstr "Hiệu quả phải thừa nhận là khá ấn tượng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "It would be wise to equip the boat with a protective barrier."
msgstr "Sẽ là khôn ngoan nếu trang bị cho thuyền một hàng rào bảo vệ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "It is not a plaything."
msgstr "Nó không phải là một thứ đồ chơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "A highly effective weapon in nautical combat, when properly loaded."
msgstr "Một loại vũ khí có hiệu quả cao trong chiến đấu trên biển khi được nạp đạn đúng cách."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "There's still the small matter of ammunition, dear..."
msgstr "Vẫn còn vấn đề nhỏ về đạn dược, em yêu..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_CANNON_KIT"
msgid "A necessary precaution, unfortunately."
msgstr "Thật không may, một biện pháp phòng ngừa cần thiết."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_GRASS_ITEM"
msgid "Its durability is questionable, but it will do for now."
msgstr "Độ bền của nó còn là vấn đề đáng nghi ngờ, nhưng hiện tại nó sẽ có tác dụng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_ITEM"
msgid "It will allow us to go on the water."
msgstr "Nó sẽ cho phép chúng ta đi trên mặt nước."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_LEAK"
msgid "Our ship is taking on water."
msgstr "Tàu của chúng tôi đang tiếp nước."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "The strong magnetic force will pull my ship toward its target."
msgstr "Lực từ mạnh sẽ kéo con tàu của tôi về phía mục tiêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "Its design is rather eccentric, but the theory is sound."
msgstr "Thiết kế của nó khá lập dị, nhưng lý thuyết thì đúng đắn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "The magnetic beacon has been activated."
msgstr "Đèn hiệu từ tính đã được kích hoạt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "It will attract large electromagnets, but only once activated."
msgstr "Nó sẽ hút những nam châm điện lớn nhưng chỉ được kích hoạt một lần."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_MAGNET_KIT"
msgid "I will have to speak with him about the run-on sentences in his directions later."
msgstr "Tôi sẽ phải nói chuyện với anh ấy về những câu chạy theo hướng dẫn của anh ấy sau."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_ROTATOR"
msgid "It allows me to rotate the deck, while maintaining our heading."
msgstr "Nó cho phép tôi xoay bộ bài trong khi vẫn duy trì hướng đi của mình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "It should improve the boat's maneuverability."
msgstr "Nó sẽ cải thiện khả năng cơ động của thuyền."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "The woolen fibers of a beefalo's coat make for excellent padding."
msgstr "Các sợi len của áo khoác bò làm nên lớp đệm tuyệt vời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BODYPILLOW_KELP"
msgid "What a fascinating use of kelp."
msgstr "Thật là một công dụng hấp dẫn của tảo bẹ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BODYPILLOW_PETALS"
msgid "It gives off a delicate floral aroma."
msgstr "Nó tỏa ra một mùi hương hoa tinh tế."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "This seems ill-suited for a restful night's sleep."
msgstr "Điều này có vẻ không phù hợp cho một giấc ngủ ngon."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOMB_LUNARPLANT"
msgid "Unstable energy, barely held together by a hardy plant epidermis."
msgstr "Năng lượng không ổn định, hầu như không được giữ lại bởi lớp biểu bì thực vật cứng cáp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "Our verdant friend seems to have worked his magic on this."
msgstr "Người bạn xanh tươi của chúng ta dường như đã làm nên điều kỳ diệu ở đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BONESHARD"
msgid "Remnants of a life well lived."
msgstr "Chứng tích của một cuộc sống tốt sống."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BONESOUP"
msgid "Extremely savory. I wouldn't mind seconds."
msgstr "Cực kỳ mặn. Tôi sẽ không phiền vài giây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BONESTEW"
msgid "Not quite how mum used to make, but it smells superb!"
msgstr "Không giống như cách mẹ thường làm nhưng nó có mùi rất tuyệt!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOKSTATION.BURNT"
msgid "Few things are as saddening as the sight of destroyed books."
msgstr "Ít có điều gì đáng buồn bằng việc nhìn thấy những cuốn sách bị phá hủy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOKSTATION.GENERIC"
msgid "Eager minds should always have access to a library."
msgstr "Những tâm trí háo hức phải luôn có quyền truy cập vào thư viện."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_BEES"
msgid "I've grown rather fond of beekeeping."
msgstr "Tôi ngày càng yêu thích nghề nuôi ong."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_BIRDS"
msgid "The expurgated version, but it has my favorite: Megascops kennicottii."
msgstr "Phiên bản đã được loại bỏ, nhưng nó có phiên bản yêu thích của tôi: Megascops kennicottii."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_BRIMSTONE"
msgid "What could possibly go wrong?"
msgstr "Điều gì có thể đi sai?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_ELEMENTAL"
msgid "A powerful tome of summoning."
msgstr "Một cuốn sách triệu hồi mạnh mẽ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_FIRE"
msgid "Even misfortune offers opportunities to learn. Past mistakes shall not be repeated."
msgstr "Ngay cả sự bất hạnh cũng mang lại cơ hội học hỏi. Những sai lầm trong quá khứ sẽ không được lặp lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_FISH"
msgid "It starts with a rather compelling hook."
msgstr "Nó bắt đầu bằng một đoạn hook khá hấp dẫn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_FOSSIL"
msgid "A tome of accelerated petrification."
msgstr "Một cuốn sách về quá trình hóa đá tăng tốc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_GARDENING"
msgid "Dead plants tied together to help me aid living plants."
msgstr "Những cây chết được buộc lại với nhau để giúp tôi hỗ trợ những cây sống."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_HORTICULTURE"
msgid "Only my best tricks for bringing a garden to fruition."
msgstr "Chỉ có những thủ thuật hay nhất của tôi để mang lại thành quả cho khu vườn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "Mankind has cultivated crops for centuries, and there's still more to learn."
msgstr "Nhân loại đã trồng trọt trong nhiều thế kỷ và vẫn còn nhiều điều cần học hỏi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_LIGHT"
msgid "I like to do a bit of light reading in the evening."
msgstr "Tôi thích đọc sách nhẹ nhàng một chút vào buổi tối."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "I've given it a glowing review."
msgstr "Tôi đã đưa ra một đánh giá sáng giá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_MOON"
msgid "Investigating the ancient archives proved to be quite educational."
msgstr "Việc điều tra Tàng Thư Cổ Đại tỏ ra khá mang tính giáo dục."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_RAIN"
msgid "A succinct guide, without any extraneous fluff."
msgstr "Hướng dẫn ngắn gọn, không rườm rà."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "It took some effort to distill everything down into a single volume."
msgstr "Phải mất một chút nỗ lực để chắt lọc mọi thứ thành một tập duy nhất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_SILVICULTURE"
msgid "Dead plants tied together to help me aid living plants."
msgstr "Những cây chết được buộc lại với nhau để giúp tôi hỗ trợ những cây sống."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_SLEEP"
msgid "Warm milk in book form."
msgstr "Sữa ấm ở dạng sách."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_TEMPERATURE"
msgid "You must be mindful of your thermal equilibrium."
msgstr "Bạn phải chú ý đến trạng thái cân bằng nhiệt của mình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_TENTACLES"
msgid "Hard to put this one down. It's gripping, frankly."
msgstr "Khó để đặt một xuống này. Nó hấp dẫn, thẳng thắn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_WEB"
msgid "Arachnids are crucial parts of a healthy ecosystem, after all."
msgstr "Rốt cuộc, loài nhện là một phần quan trọng của một hệ sinh thái lành mạnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOMERANG"
msgid "It is a flat aerofoil."
msgstr "Nó là một aerofoil phẳng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOTLEG"
msgid "As far as teleportation methods go, it's quite unrefined."
msgstr "Về phương pháp dịch chuyển tức thời, nó khá thô sơ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BROKEN_FORGEDITEM"
msgid "With the right materials, it could be repaired."
msgstr "Với vật liệu phù hợp, nó có thể được sửa chữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BROKEN_FUMAROLETOOLITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BROKEN_FUMAROLETOOLITEM"
msgid "A sufficient amount of heat should be enough to reconstitute it."
msgstr "Một lượng nhiệt vừa đủ là đủ để hoàn nguyên nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BRUSH"
msgid "Microscopic barbs allow for optimal hair retrieval."
msgstr "Các ngạnh siêu nhỏ cho phép thu hồi tóc tối ưu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUGNET"
msgid "The tool of entomologists."
msgstr "Công cụ của các nhà côn trùng học."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "Nereocystis luetkeana."
msgstr "Nereocystis luetkeana."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "Nereocystis luetkeana needs time to regrow."
msgstr "Nereocystis luetkeana cần thời gian để tái sinh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BULLKELP_ROOT"
msgid "I suppose this is why it's referred to as \"bullwhip\" kelp."
msgstr "Tôi cho rằng đây là lý do tại sao nó được gọi là tảo bẹ \"bullwhip\"."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUNDLE"
msgid "At least someone's bundled up out here."
msgstr "Ít nhất có ai đó đang tập trung ở đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUNDLEWRAP"
msgid "Antibacterial wrapping for food preservation."
msgstr "Bao bì kháng khuẩn bảo quản thực phẩm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUNNYMAN"
msgid "A sentient lagomorph."
msgstr "Một bộ thỏ sinh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUNNYSTEW"
msgid "Caloric, but nutritious. It smells wonderful, as well."
msgstr "Nhiều calo, nhưng bổ dưỡng. Nó cũng có mùi thơm tuyệt vời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BURNT_MARSH_BUSH"
msgid "Reduced to ash."
msgstr "Giảm thành tro."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUSHHAT"
msgid "Camouflage."
msgstr "Ngụy trang."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUTTER"
msgid "Lepidopterous lipids?"
msgstr "Lipid thuộc loài Lepidoptous?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUTTERFLY.GENERIC"
msgid "A colorful lepidopteran."
msgstr "Một loài lepidopteran đầy màu sắc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUTTERFLY.HELD"
msgid "It is captured."
msgstr "Nó được chụp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUTTERFLYMUFFIN"
msgid "Who knew butterflies made such nice baked goods?"
msgstr "Ai biết bướm làm ra những món nướng ngon như vậy?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUTTERFLYWINGS"
msgid "Wings from a captured butterfly."
msgstr "Wings từ một con bướm bắt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUZZARD"
msgid "Cathartes, of course."
msgstr "Cathartes, tất nhiên."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUZZARDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUZZARDCORPSE.BURNING"
msgid "This is, in fact, saving it."
msgstr "Trên thực tế, đây là cách cứu nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUZZARDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUZZARDCORPSE.GENERIC"
msgid "If only this were the end for the buzzard."
msgstr "Giá như đây là kết thúc cho con chim ó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUZZARDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUZZARDCORPSE.REVIVING"
msgid "The buzzard is on a different path now... terrible one."
msgstr "Con chim ó bây giờ đang đi trên một con đường khác... một con đường khủng khiếp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CABBAGEROLLS"
msgid "Variations of this dish can be found across Europe and Asia."
msgstr "Các biến thể của món ăn này có thể được tìm thấy trên khắp Châu Âu và Châu Á."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CACTUS.GENERIC"
msgid "A young barrel cactus."
msgstr "Một thùng cây xương rồng nhỏ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CACTUS.PICKED"
msgid "Desperate times, desperate measures."
msgstr "Lúc tuyệt vọng, biện pháp tuyệt vọng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CACTUS_FLOWER"
msgid "Reminds me of Burroughs. A favorite at the library."
msgstr "Làm tôi nhớ đến Burroughs. Một yêu thích tại thư viện."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CACTUS_MEAT"
msgid "I'm not sure it's been prepared properly."
msgstr "Tôi không chắc chắn nó được chuẩn bị đúng cách."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "Delightfully devoid of spines."
msgstr "Phim vui không có gai."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CALIFORNIAROLL"
msgid "Delicious makizushi."
msgstr "Makizushi ngon."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.EMBERS"
msgid "The fire has almost self-extinguished."
msgstr "Ngọn lửa đã gần như tự dập tắt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.GENERIC"
msgid "A camp fire."
msgstr "Một ngọn lửa trại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.HIGH"
msgid "That fire is burning at an alarming rate."
msgstr "Ngọn lửa đó đang cháy với tốc độ đáng báo động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.LOW"
msgid "The fire could use some more fuel."
msgstr "Ngọn lửa có thể sử dụng một số nhiên liệu hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.NORMAL"
msgid "A perfectly average fire."
msgstr "Một ngọn lửa hoàn toàn bình thường."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.OUT"
msgid "It can be re-lit."
msgstr "Nó có thể được thắp sáng lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANARY.GENERIC"
msgid "Serinus canaria. A historically useful sentinel species."
msgstr "Serinus canaria. Một loài lính gác có ích trong lịch sử."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANARY.HELD"
msgid "Serinus canaria. We ought never enter a cave without one."
msgstr "Serinus canaria. Chúng ta không bao giờ nên vào hang động mà không có nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANARY_POISONED"
msgid "Oh, dear."
msgstr "Trời ơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANDYBAG"
msgid "A festive bag for seasonal treats."
msgstr "Một túi lễ hội dành cho các món ăn theo mùa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANE"
msgid "I'm no rabologist."
msgstr "Tôi không có rabologist."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANNONBALL_ROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANNONBALL_ROCK_ITEM"
msgid "A suitable projectile for a cannon."
msgstr "Một loại đạn thích hợp cho một khẩu pháo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALCANNON.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALCANNON.COOLDOWN"
msgid "Oh, these sorts of things always make such a mess..."
msgstr "Ôi, những thứ này luôn gây ra một mớ hỗn độn..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALCANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALCANNON.GENERIC"
msgid "Thankfully idle, for now."
msgstr "Rất may hiện tại đang nhàn rỗi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALCANNON_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALCANNON_KIT"
msgid "Let's just put it somewhere far away from the encampment."
msgstr "Hãy đặt nó ở một nơi nào đó xa khu cắm trại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_BANNER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_BANNER"
msgid "It doesn't actually \"catch\" the light of course, but merely reflects it."
msgstr "Tất nhiên, nó không thực sự \"bắt\" ánh sáng mà chỉ phản chiếu ánh sáng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_BANNER_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_BANNER_KIT"
msgid "I should be able to assemble it easily enough."
msgstr "Tôi có thể lắp ráp nó đủ dễ dàng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_EGGRIDE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_EGGRIDE"
msgid "Those corvids are quite capable craftspeople."
msgstr "Những xác chết đó là những thợ thủ công khá có năng lực."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT"
msgid "I should be able to assemble it easily enough."
msgstr "Tôi có thể lắp ráp nó đủ dễ dàng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC"
msgid "It would look lovely in a little curio cabinet, don't you think?"
msgstr "Nó trông thật đáng yêu trong một chiếc tủ đồ cổ nhỏ, bạn có nghĩ vậy không?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE.RARE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE.RARE"
msgid "I believe this is among the rarest of the whole collection."
msgstr "Tôi tin rằng đây là một trong những thứ hiếm nhất trong toàn bộ bộ sưu tập."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON"
msgid "It appears to be of a slightly upgraded rarity."
msgstr "Nó dường như có độ hiếm được nâng cấp nhẹ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE_KIT"
msgid "How intriguing! I wonder what's inside?"
msgstr "Thật hấp dẫn! Tôi tự hỏi bên trong có gì?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2"
msgid "How intriguing! I wonder what's inside?"
msgstr "Thật hấp dẫn! Tôi tự hỏi bên trong có gì?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON3"
msgid "How intriguing! I wonder what's inside?"
msgstr "Thật hấp dẫn! Tôi tự hỏi bên trong có gì?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_LAMP"
msgid "It has a most curious light source."
msgstr "Nó có một nguồn ánh sáng kỳ lạ nhất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_LAMP_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_LAMP_KIT"
msgid "I should be able to assemble it easily enough."
msgstr "Tôi có thể lắp ráp nó đủ dễ dàng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_PLANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_PLANT"
msgid "It's so soothing to care for a small tree."
msgstr "Thật dễ chịu khi được chăm sóc một cái cây nhỏ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_PLANT_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_PLANT_KIT"
msgid "I wouldn't mind a bit of gardening."
msgstr "Tôi sẽ không bận tâm một chút về việc làm vườn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALFOOD_CORNTEA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALFOOD_CORNTEA"
msgid "An acquired taste, but nevertheless quite refreshing."
msgstr "Một hương vị quen thuộc nhưng vẫn khá mới mẻ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD"
msgid "Colorful paper representations of Annelida."
msgstr "Hình vẽ bằng giấy đầy màu sắc của Annelida."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT"
msgid "It appears simple enough to construct."
msgstr "Nó có vẻ đủ đơn giản để xây dựng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST"
msgid "Part of the mechanism for the game, I'd imagine."
msgstr "Tôi tưởng tượng đó là một phần cơ chế của trò chơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC"
msgid "I believe it requires a form of currency to start."
msgstr "Tôi tin rằng nó đòi hỏi một hình thức tiền tệ để bắt đầu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING"
msgid "The game appears to require quick reflexes."
msgstr "Trò chơi dường như đòi hỏi phản xạ nhanh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFBALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFBALL"
msgid "A near-perfect sphere, optimized for predictable rolling dynamics."
msgstr "Một quả cầu gần như hoàn hảo, được tối ưu hóa cho động lực lăn có thể dự đoán được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFCLUB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFCLUB"
msgid "Essentially an instrument optimized for low-velocity kinetic transfer."
msgstr "Về cơ bản là một công cụ được tối ưu hóa để truyền động học tốc độ thấp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_DIY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_DIY"
msgid "One may use this to create a custom, and hopefully delightful, mini-golf course."
msgstr "Người ta có thể sử dụng điều này để tạo ra một sân gôn mini tùy chỉnh và hy vọng là thú vị."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_EASY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_EASY"
msgid "An introductory course, no doubt."
msgstr "Một khóa học giới thiệu, không còn nghi ngờ gì nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_HARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_HARD"
msgid "For those up for a challenge."
msgstr "Dành cho những người sẵn sàng thử thách."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_MEDIUM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_MEDIUM"
msgid "A course of middling difficulty."
msgstr "Một khóa học có độ khó trung bình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_CUTOUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_CUTOUT"
msgid "It is both aesthetic marker and deliberate impediment to linear play."
msgstr "Nó vừa là điểm đánh dấu thẩm mỹ vừa là sự cản trở có chủ ý đối với lối chơi tuyến tính."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_FAN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_FAN"
msgid "The ball path must be adjusted to account for the wind."
msgstr "Đường đi của bóng phải được điều chỉnh để phù hợp với gió."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_FENCE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_FENCE"
msgid "It designates the play area."
msgstr "Nó chỉ định khu vui chơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_MOVINGWALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_MOVINGWALL"
msgid "A wall that rises and falls at set intervals."
msgstr "Một bức tường tăng và giảm theo những khoảng thời gian nhất định."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_SPINNER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_SPINNER"
msgid "Its behavior is simple to describe, but intentionally difficult to accommodate."
msgstr "Hành vi của nó rất đơn giản để mô tả, nhưng khó có thể điều chỉnh được một cách cố ý."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_SPRING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_SPRING"
msgid "A controlled propulsion platform using stored mechanical energy."
msgstr "Một nền tảng đẩy được điều khiển sử dụng năng lượng cơ học được lưu trữ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_WORMHOLE"
msgid "It connects to another on the course, enabling instantaneous transfer between them."
msgstr "Nó kết nối với một cái khác trên sân, cho phép chuyển giao tức thời giữa chúng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_HOLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_HOLE"
msgid "The objective of the game is to deposit the ball into that hole with as few strokes as possible."
msgstr "Mục tiêu của trò chơi là đưa bóng vào lỗ đó với càng ít cú đánh càng tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_HOLE_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_HOLE_KIT"
msgid "The flaghole should be positioned sufficiently far from the start to provide an appropriate challenge."
msgstr "Lỗ cờ phải được đặt đủ xa so với điểm xuất phát để tạo ra thử thách thích hợp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_TEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_TEE.GENERIC"
msgid "A token must be deposited before the machine will dispense a ball."
msgstr "Xu phải được gửi trước khi máy phân phát bóng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_TEE.INACTIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_TEE.INACTIVE"
msgid "The mini-golf course requires at least a flaghole to be playable."
msgstr "Sân gôn mini cần ít nhất một lỗ cờ để có thể chơi được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_TEE.PLAYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_TEE.PLAYING"
msgid "A token has been inserted. The match is already in play."
msgstr "Một mã thông báo đã được chèn vào. Trận đấu đã diễn ra."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_TEE_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_TEE_KIT"
msgid "Where the ball dropper is placed determines where we begin play."
msgstr "Nơi đặt ống nhỏ giọt bóng sẽ quyết định nơi chúng ta bắt đầu chơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_HERDING_CHICK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_HERDING_CHICK"
msgid "Go on now, scoot!"
msgstr "Đi tiếp đi, xe tay ga!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_HERDING_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_HERDING_KIT"
msgid "It appears simple enough to construct."
msgstr "Nó có vẻ đủ đơn giản để xây dựng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC"
msgid "I believe it requires a form of currency to start."
msgstr "Tôi tin rằng nó đòi hỏi một hình thức tiền tệ để bắt đầu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING"
msgid "This looks like a good bit of exercise."
msgstr "Đây có vẻ như là một Việc Vặt tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC"
msgid "Part of the mechanism for the game, I'd imagine."
msgstr "Tôi tưởng tượng đó là một phần cơ chế của trò chơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING"
msgid "I believe it was this one here."
msgstr "Tôi tin rằng nó là cái này ở đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_MEMORY_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_MEMORY_KIT"
msgid "It appears simple enough to construct."
msgstr "Nó có vẻ đủ đơn giản để xây dựng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC"
msgid "I believe it requires a form of currency to start."
msgstr "Tôi tin rằng nó đòi hỏi một hình thức tiền tệ để bắt đầu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING"
msgid "Ah! A simple test of one's aptitude for memorization."
msgstr "Ah! Một bài kiểm tra đơn giản về khả năng ghi nhớ của một người."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT"
msgid "It appears simple enough to construct."
msgstr "Nó có vẻ đủ đơn giản để xây dựng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC"
msgid "I believe it requires a form of currency to start."
msgstr "Tôi tin rằng nó đòi hỏi một hình thức tiền tệ để bắt đầu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING"
msgid "A game of odds and probability."
msgstr "Một trò chơi có tỷ lệ cược và xác suất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC"
msgid "I believe it requires a form of currency to start."
msgstr "Tôi tin rằng nó đòi hỏi một hình thức tiền tệ để bắt đầu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING"
msgid "This appears to trigger the firing mechanism."
msgstr "Điều này xuất hiện để kích hoạt cơ chế bắn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_KIT"
msgid "It appears simple enough to construct."
msgstr "Nó có vẻ đủ đơn giản để xây dựng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC"
msgid "I believe it requires a form of currency to start."
msgstr "Tôi tin rằng nó đòi hỏi một hình thức tiền tệ để bắt đầu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING"
msgid "One's timing must be precise to win."
msgstr "Thời gian của một người phải chính xác để giành chiến thắng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC"
msgid "Part of the mechanism for the game, I'd imagine."
msgstr "Tôi tưởng tượng đó là một phần cơ chế của trò chơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING"
msgid "It appears the object is to hit the insects while sparing the birds."
msgstr "Có vẻ như mục tiêu là đánh côn trùng trong khi tha cho lũ chim."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT"
msgid "It appears simple enough to construct."
msgstr "Nó có vẻ đủ đơn giản để xây dựng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC"
msgid "I believe it requires a form of currency to start."
msgstr "Tôi tin rằng nó đòi hỏi một hình thức tiền tệ để bắt đầu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING"
msgid "Curious. It seems that it's designed to be impossible to lose."
msgstr "Tò mò. Có vẻ như nó được thiết kế để không thể bị mất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_BALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_BALL"
msgid "I don't want to see anyone playing with this near any breakables."
msgstr "Tôi không muốn thấy bất cứ ai chơi với thứ này gần bất kỳ đồ dễ vỡ nào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_CROWKID
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_CROWKID"
msgid "Corvids are remarkably intelligent, I'd imagine this species is even more so."
msgstr "Corvids rất thông minh, tôi nghĩ loài này thậm chí còn hơn thế nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_GAMETOKEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_GAMETOKEN"
msgid "A form of avian currency, perhaps?"
msgstr "Có lẽ là một dạng tiền tệ của loài chim?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_HOST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_HOST"
msgid "He's a rather curious character."
msgstr "Anh ấy là một nhân vật khá tò mò."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PLAZA.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
msgid "It seems customary to place decorations around it."
msgstr "Có vẻ như người ta thường đặt đồ trang trí xung quanh nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
msgid "Oh yes, that's coming along quite nicely!"
msgstr "Ồ vâng, điều đó đang diễn ra khá tốt đẹp!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3"
msgid "That appears to be an acceptable level of decoration."
msgstr "Đó dường như là một mức độ trang trí chấp nhận được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PLAZA_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PLAZA_KIT"
msgid "What an intriguing specimen... I can't quite pinpoint the subspecies."
msgstr "Thật là một mẫu vật hấp dẫn... Tôi không thể xác định chính xác các phân loài."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC"
msgid "There is a surprisingly varied selection to choose from."
msgstr "Có một lựa chọn đa dạng đáng ngạc nhiên để lựa chọn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT"
msgid "It appears simple enough to construct."
msgstr "Nó có vẻ đủ đơn giản để xây dựng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC"
msgid "I should be able to exchange these for a prize of some sort."
msgstr "Tôi có thể đổi những thứ này lấy một phần thưởng nào đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK"
msgid "I seem to be quite good at these games!"
msgstr "Tôi có vẻ khá giỏi trong những trò chơi này!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
msgid "I assume the more tickets I collect, the greater the prize will be."
msgstr "Tôi cho rằng tôi càng thu thập được nhiều vé thì giải thưởng sẽ càng lớn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_SEEDPACKET"
msgid "A bit of extra fiber added to one's diet never hurts."
msgstr "Một chút chất xơ bổ sung vào chế độ ăn uống của một người không bao giờ có hại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_VEST_A
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_VEST_A"
msgid "The corvids seem to have developed a method of fabricating clothing from leaves."
msgstr "Các loài quạ dường như đã phát triển một phương pháp chế tạo quần áo từ lá cây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_VEST_B
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_VEST_B"
msgid "How fascinating that these corvids have evolved to the point of wearing clothing."
msgstr "Thật thú vị làm sao khi những con quạ này đã tiến hóa đến mức có thể mặc quần áo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_VEST_C
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_VEST_C"
msgid "It smells deligthfully of summer leaves."
msgstr "Nó có mùi thơm thú vị của lá mùa hè."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARPENTRY_BLADE_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARPENTRY_BLADE_MOONGLASS"
msgid "A moon glass saw blade. Sharp enough to cut stone."
msgstr "Một lưỡi cưa bằng kính mặt trăng. Đủ sắc để cắt đá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARPENTRY_STATION.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARPENTRY_STATION.BURNT"
msgid "I suppose my reading chair will have to wait."
msgstr "Tôi cho rằng chiếc ghế đọc sách của tôi sẽ phải đợi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARPENTRY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARPENTRY_STATION.GENERIC"
msgid "I could use a new reading chair."
msgstr "Tôi có thể sử dụng một chiếc ghế đọc sách mới."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARRAT.DEAD"
msgid "Perhaps that was unnecessary."
msgstr "Có lẽ điều đó là không cần thiết."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARRAT.GENERIC"
msgid "My, another plant and animal hybrid. How odd."
msgstr "Ôi, một loài thực vật và động vật lai khác. Thật kỳ lạ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARRAT.HELD"
msgid "The plant and animal matter has fused in total harmony."
msgstr "Thực vật và động vật đã hợp nhất hoàn toàn hài hòa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARRAT.SLEEPING"
msgid "It's in a deep sleep."
msgstr "Nó đang trong giấc ngủ sâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARRAT_GHOSTRACER"
msgid "Fascinating! A new genus, perhaps?"
msgstr "Lôi cuốn! Có lẽ là một chi mới?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARROT"
msgid "Daucus carota. Edible, and delicious."
msgstr "Daucus carota. Ăn được và ngon."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARROT_COOKED"
msgid "Daucus carota, roasted to perfection."
msgstr "Daucus carota, rang để hoàn thiện."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARROT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARROT_OVERSIZED"
msgid "The result of proper research, planning and care."
msgstr "Kết quả của việc nghiên cứu, lập kế hoạch và chăm sóc thích hợp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARROT_PLANTED"
msgid "Daucus carota is a root vegetable."
msgstr "Daucus carota là một loại rau củ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARROT_SEEDS"
msgid "It can't begin growing until it's been planted, dear."
msgstr "Nó không thể bắt đầu phát triển cho đến khi nó được trồng, em yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "Can we have nothing decent?"
msgstr "Chúng ta có thể không có gì đàng hoàng sao?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "The destruction of knowledge is such a difficult thing to stomach."
msgstr "Sự phá hủy kiến thức là một điều khó nuốt trôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "Ah! A proper desk! Just look at the finish on that wood!"
msgstr "Ah! Một chiếc bàn thích hợp! Chỉ cần nhìn vào sự hoàn thiện trên gỗ đó!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CATCOON"
msgid "A sort of a wildcat. Handsome fellow."
msgstr "Một loại mèo hoang. Bạn bè đẹp trai."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CATCOONDEN.EMPTY"
msgid "Looks used up."
msgstr "Trông sử dụng hết."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CATCOONDEN.GENERIC"
msgid "An excellent hollow for a den."
msgstr "Một rỗng tuyệt vời cho một phòng làm việc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CATCOONHAT"
msgid "Not quite like Crockett's, but it'll do."
msgstr "Không hoàn toàn như Crockett, nhưng nó sẽ làm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CATTOY_MOUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CATTOY_MOUSE"
msgid "A simple mechanism behind an entertaining toy for felines."
msgstr "Cơ chế đơn giản đằng sau một món đồ chơi giải trí dành cho mèo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "It looks as though it can be moved."
msgstr "Có vẻ như nó có thể được di chuyển."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "We must clear the surrounding boulders first."
msgstr "Chúng ta phải dọn sạch những tảng đá xung quanh trước."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_BANANA"
msgid "All of them are genetically identical."
msgstr "Tất cả đều là di truyền giống hệt nhau."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_BANANA_BURNT"
msgid "I do not believe this one can be restored."
msgstr "Tôi không tin cái này có thể được khôi phục."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Somewhat better."
msgstr "Hơi tốt hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_BANANA_TREE"
msgid "The seeds must have fallen down a sinkhole."
msgstr "Các hạt đã rơi xuống một hố."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_ENTRANCE"
msgid "The placement of that rock looks intentional."
msgstr "Việc đặt hòn đá trông có chủ ý."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "Much too crowded for my liking."
msgstr "Quá đông đúc theo ý thích của tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "Perhaps when I am better prepared."
msgstr "Có lẽ khi tôi đã chuẩn bị tốt hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "The subterranean world awaits."
msgstr "Thế giới ngầm đang chờ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "The passage has been obstructed."
msgstr "Lối đi đã bị tắc nghẽn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_EXIT.FULL"
msgid "With all those people? It's bound to be cacophony."
msgstr "Với tất cả những người đó? Nó chắc chắn là tạp âm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "Perhaps later."
msgstr "Có lẽ sau này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_EXIT.OPEN"
msgid "Maybe I should go back up for some fresh air."
msgstr "Có lẽ tôi nên trở lên đối với một số không khí trong lành."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_FERN"
msgid "A lovely ornamental plant."
msgstr "Một cây cảnh đáng yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_FERN_WITHERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_FERN_WITHERED"
msgid "It is quite dead."
msgstr "Nó chết hẳn rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_MITE.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_MITE.DEAD"
msgid "This one is deceased."
msgstr "Người này đã chết."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_MITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_MITE.GENERIC"
msgid "This mineral hybrid creature possesses the ability to store gas under considerable pressure."
msgstr "Sinh vật lai khoáng chất này sở hữu khả năng lưu trữ khí dưới áp suất đáng kể."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_MITE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_MITE.SLEEPING"
msgid "It is dormant at the moment."
msgstr "Nó đang không hoạt động vào lúc này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_MITE.VENTING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_MITE.VENTING"
msgid "It is venting gas as a form of attack."
msgstr "Đó là trút khí như một hình thức tấn công."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_ROCK.GAS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_ROCK.GAS"
msgid "Those fumes are harmful to inhale and will cause spoilage to perishables."
msgstr "Những khói đó có hại khi hít phải và sẽ gây hư hỏng cho những đồ dễ hỏng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_ROCK.GENERIC"
msgid "Fumarole from which a number of gasses may emerge. Best steer clear."
msgstr "Miệng Phun Địa Nhiệt từ đó một số khí có thể thoát ra. Tốt nhất hãy tránh xa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_ROCK.HOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_ROCK.HOT"
msgid "Merely geothermal steam venting from a fumarole. One needn't be alarmed."
msgstr "Chỉ là hơi nước địa nhiệt thoát ra từ lỗ phun khí. Người ta không cần phải lo lắng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_ROCK.MIASMA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_ROCK.MIASMA"
msgid "Prudence dictates minimizing exposure to that most insidious vapor."
msgstr "Sự thận trọng ra lệnh giảm thiểu việc tiếp xúc với hơi độc nguy hiểm nhất đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CEILING_ROPE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CEILING_ROPE"
msgid "A tried and true means of escape."
msgstr "Một phương tiện trốn thoát đã được thử nghiệm và thực sự."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CEVICHE"
msgid "Could use a little more sauce."
msgstr "Có thể dùng thêm chút nước sốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARCOAL"
msgid "It's mostly carbon and ash."
msgstr "Đó chủ yếu là carbon và tro."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIERESIDUE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIERESIDUE"
msgid "only_used_by_winona"
msgstr "chỉ_dùng_bởi_winona"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIEROSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIEROSE"
msgid "only_used_by_winona"
msgstr "chỉ_dùng_bởi_winona"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIE_HAND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIE_HAND"
msgid "It requires materials."
msgstr "Nó đòi hỏi vật liệu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIE_HECKLER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIE_HECKLER"
msgid "I wouldn't classify their criticism as constructive."
msgstr "Tôi sẽ không phân loại những lời chỉ trích của họ là mang tính xây dựng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIE_LECTURN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIE_LECTURN"
msgid "It lists the characters in the next act."
msgstr "Nó liệt kê các nhân vật trong màn tiếp theo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIE_NPC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIE_NPC"
msgid "I'd like to give that young lady a stern talking to!"
msgstr "Tôi muốn nghiêm khắc nói chuyện với cô gái trẻ đó!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIE_STAGE_POST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIE_STAGE_POST"
msgid "The builder must have been inspired by the Greek dramas of antiquity."
msgstr "Người xây dựng chắc hẳn đã lấy cảm hứng từ những bộ phim truyền hình Hy Lạp thời cổ đại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSJUNK1"
msgid "The magician's unfinished projects?"
msgstr "Dự án còn dang dở của ảo thuật gia?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSJUNK2"
msgid "The magician's unfinished projects?"
msgstr "Dự án còn dang dở của ảo thuật gia?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSJUNK3"
msgid "The magician's unfinished projects?"
msgstr "Dự án còn dang dở của ảo thuật gia?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "Artists tend to reference what they're familiar with."
msgstr "Các nghệ sĩ có xu hướng tham khảo những gì họ quen thuộc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_ANTLION"
msgid "A stately statuary of the Panthera auropunctata."
msgstr "Một bức tượng trang nghiêm của Panthera auropunctata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BEARGER"
msgid "Quite expressive!"
msgstr "Khá biểu cảm!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BEARGER_MUTATED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BEARGER_MUTATED"
msgid "The artist truly captured its ferocity!"
msgstr "Người nghệ sĩ đã thực sự nắm bắt được sự hung dữ của nó!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BEEFALO"
msgid "It captures my beefalo's likeness quite well."
msgstr "Nó thể hiện khá rõ nét giống con bò của tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "A queenly tribute to the Apis mellifera."
msgstr "Lời tri ân của nữ hoàng dành cho Apis mellifera."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "A decorative stone carving of a bishop chess piece."
msgstr "Một tác phẩm điêu khắc đá trang trí về quân cờ giám mục."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "It seems magic is afoot."
msgstr "Có vẻ như phép thuật đang diễn ra."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "Carved in the lunar moth's likeness."
msgstr "Được khắc theo hình dáng của bướm đêm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_CARRAT"
msgid "A delightfully rendered likeness of the Daucus carota rattus."
msgstr "Một hình vẽ giống Daucus carota rattus một cách thú vị."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_CATCOON"
msgid "The resemblance to the Felis lybica is incredible."
msgstr "Sự giống nhau của loài Felis lybica thật đáng kinh ngạc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "A replica of Canis lupis."
msgstr "Một bản sao của Canis lupis."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "The sculptor clearly studied the creature closely."
msgstr "Nhà điêu khắc rõ ràng đã nghiên cứu kỹ sinh vật này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_CRABKING"
msgid "A rendering of a treasure-obsessed crustacean."
msgstr "Hình vẽ một loài giáp xác bị ám ảnh bởi kho báu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "An accurate stone model of that ill-behaved creature."
msgstr "Một mô hình đá chính xác của sinh vật xấu tính đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DAYWALKER2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DAYWALKER2"
msgid "Resourceful, admittedly. Yet, in essence, a brute."
msgstr "Phải thừa nhận là tháo vát. Tuy nhiên, về bản chất, là một kẻ vũ phu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "An anatomical study of those strange beasts."
msgstr "Một nghiên cứu giải phẫu của những con thú kỳ lạ đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "Such a strange and grotesque affliction..."
msgstr "Thật là một nỗi đau kỳ lạ và kỳ cục..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DEPTHWORM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DEPTHWORM"
msgid "One of the hungriest large invertebrates."
msgstr "Một trong những động vật không xương sống lớn đói nhất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "Artist's interpretation of mythical Diptera."
msgstr "Sự giải thích của nghệ sĩ về Diptera huyền thoại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "A trophy that doubles as a useful anatomical model."
msgstr "Một chiếc cúp có tác dụng như một mô hình giải phẫu hữu ích."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_FORMAL"
msgid "The king is, by all measures, a liability to everyone on the board."
msgstr "Xét về mọi mặt, nhà vua là người có trách nhiệm đối với mọi người trong hội đồng quản trị."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "I must commend the artist for their attention to detail."
msgstr "Tôi phải khen ngợi nghệ sĩ vì sự chú ý của họ đến từng chi tiết."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "It is a commonly held belief that art imitates life."
msgstr "Người ta thường tin rằng nghệ thuật bắt chước cuộc sống."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_KITCOON"
msgid "I should warn the children not to play too close to it."
msgstr "Tôi nên cảnh báo bọn trẻ không nên chơi quá gần nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_KLAUS"
msgid "A wonderfully seasonal simulacrum."
msgstr "Một simulacrum theo mùa tuyệt vời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "A knight, in service to the king. Or perhaps the queen."
msgstr "Một hiệp sĩ, phục vụ nhà vua. Hoặc có lẽ là nữ hoàng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "It seems magic is afoot."
msgstr "Có vẻ như phép thuật đang diễn ra."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "I'll have to add an appendix to \"Birds of the World\"."
msgstr "Tôi sẽ phải thêm một phụ lục vào \"Những loài chim trên thế giới\"."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "Those lagomorphs are quite the rascals."
msgstr "Những kẻ lang thang đó khá là những kẻ bất lương."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "A rather convincing likeness."
msgstr "Một sự giống nhau khá thuyết phục."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MOON"
msgid "The missing chunk is a recent development."
msgstr "Đoạn còn thiếu là một sự phát triển gần đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "Bust of Alces canadensis."
msgstr "Bức tượng bán thân của Alces canadensis."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MUSE"
msgid "In chess, the queen is by far the most strategically formidable."
msgstr "Trong cờ vua, quân hậu là quân mạnh nhất về mặt chiến lược."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_PAWN"
msgid "Pawns that journey to the seat of power can be quite dangerous."
msgstr "Những con tốt trên đường đến ghế quyền lực có thể khá nguy hiểm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_PIPE"
msgid "I hope this does not have a bad influence on the children."
msgstr "Tôi hy vọng điều này không ảnh hưởng xấu đến trẻ em."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "Represents the protective walls of the king's castle."
msgstr "Tượng trưng cho bức tường bảo vệ lâu đài của nhà vua."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "It seems magic is afoot."
msgstr "Có vẻ như phép thuật đang diễn ra."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_SHARKBOI
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_SHARKBOI"
msgid "The mouthiest of its species."
msgstr "Loài có miệng nhiều nhất trong giống loài của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_STALKER"
msgid "The artist faithfully replicated its skeletal structure."
msgstr "Người nghệ sĩ đã tái tạo một cách trung thực cấu trúc xương của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "The artist captured the parasitic relationship beautifully."
msgstr "Người nghệ sĩ đã nắm bắt được mối quan hệ ký sinh rất đẹp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "A stone rendition of a pair of mechanical marvels."
msgstr "Một sự tái hiện bằng đá của một cặp tuyệt tác cơ khí."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD"
msgid "It proved a marvel of ancient architecture."
msgstr "Nó chứng tỏ sự kỳ diệu của kiến ​​trúc cổ xưa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR"
msgid "This dreadful amalgamation was unprecedented."
msgstr "Sự hợp nhất khủng khiếp này là chưa từng có."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT"
msgid "A miniature of the homicidal automaton. Hm."
msgstr "Một hình thu nhỏ của cỗ máy giết người tự động. Ừm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "There is much I still don't understand about this beast."
msgstr "Có nhiều điều tôi vẫn chưa hiểu về con quái vật này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_WORMBOSS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_WORMBOSS"
msgid "This ancestor of the predatory annelid was far worse."
msgstr "Tổ tiên của loài giun đốt săn mồi này còn tệ hơn nhiều."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_YOTD"
msgid "A curious combination; the fire-breathing Diptera and seafaring."
msgstr "Một sự kết hợp thời trang, Hơi thở của Diptera và đi biển."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_YOTH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_YOTH"
msgid "This mechanical knight demonstrates loyalty to whomever dons the garb of its charge."
msgstr "Hiệp sĩ máy móc này thể hiện lòng trung thành với bất cứ ai khoác lên mình bộ trang phục của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_YOTS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_YOTS"
msgid "One of the hungriest large invertebrates."
msgstr "Một trong những động vật không xương sống lớn đói nhất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESTER"
msgid "A motile storage chest."
msgstr "Một ngực lưu trữ di động hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "Oculus Mysterium."
msgstr "Bí ẩn Oculus."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "The oculus is inactive."
msgstr "Các oculus không hoạt động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "Increases the capacity of a storage container by a, frankly, absurd degree."
msgstr "Nói thẳng ra là tăng sức chứa của một thùng chứa lên một mức độ vô lý."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHEST_MIMIC_REVEALED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHEST_MIMIC_REVEALED"
msgid "This creature mimics an artifact."
msgstr "Sinh vật này bắt chước một món đồ cổ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHUM"
msgid "I find it best not to dwell on what it's made of."
msgstr "Tôi thấy tốt nhất là không nên tập trung vào những gì nó được làm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CLAYHOUND.GENERIC"
msgid "The earthenware has been magically animated."
msgstr "Đồ đất nung đã được tạo hình một cách kỳ diệu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CLAYHOUND.STATUE"
msgid "Terra cotta earthenware."
msgstr "Đồ đất nung bằng đất nung."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CLAYWARG.GENERIC"
msgid "Ah, how charmingly fearsome."
msgstr "Ah, thật quyến rũ và đáng sợ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CLAYWARG.STATUE"
msgid "An intricately crafted terra cotta statue."
msgstr "Một bức tượng đất nung được chế tác tinh xảo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.EMBERS"
msgid "The fire has almost self-extinguished."
msgstr "Ngọn lửa đã gần như tự dập tắt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.GENERIC"
msgid "A rather strange, magical fire pit."
msgstr "Một hố lửa khá kỳ lạ và huyền ảo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.HIGH"
msgid "That fire is burning at an alarming rate."
msgstr "Ngọn lửa đó đang cháy với tốc độ đáng báo động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.LOW"
msgid "The fire could use some more fuel."
msgstr "Ngọn lửa có thể sử dụng một số nhiên liệu hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.NORMAL"
msgid "A perfectly unusual fire."
msgstr "Một ngọn lửa hoàn toàn không bình thường."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.OUT"
msgid "It can be re-lit."
msgstr "Nó có thể được thắp sáng lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "The fire has almost self-extinguished."
msgstr "Ngọn lửa đã gần như tự dập tắt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "A fire pit. It's chilly."
msgstr "Một hố lửa. Nó lạnh lẽo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.HIGH"
msgid "That fire is burning at an alarming rate."
msgstr "Ngọn lửa đó đang cháy với tốc độ đáng báo động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.LOW"
msgid "The fire could use some more fuel, whatever fuel it takes."
msgstr "Ngọn lửa có thể sử dụng thêm nhiên liệu, bất kể nhiên liệu nào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "A fire. Of some kind."
msgstr "Một đám cháy. Của một số loại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.OUT"
msgid "It can be re-lit."
msgstr "Nó có thể được thắp sáng lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLLAPSEDCHEST"
msgid "It would be prudent to rebuild the chest, rather than leave all this lying about."
msgstr "Sẽ là khôn ngoan nếu xây dựng lại chiếc rương thay vì để lại tất cả những thứ này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.E"
msgid "East."
msgstr "Đông."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.GENERIC"
msgid "The coordinates remain unknown."
msgstr "Các tọa độ vẫn chưa được biết."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.N"
msgid "North."
msgstr "Bắc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.NE"
msgid "Northeast."
msgstr "Đông Bắc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.NW"
msgid "Northwest."
msgstr "Tây bắc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.S"
msgid "South."
msgstr "Nam."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.SE"
msgid "Southeast."
msgstr "Đông Nam."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.SW"
msgid "Southwest."
msgstr "Tây nam."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.W"
msgid "West."
msgstr "Tây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOST"
msgid "The secret to any garden's success is nutrient-rich soil."
msgstr "Bí quyết thành công của bất kỳ khu vườn nào là đất giàu dinh dưỡng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "A well balanced mix."
msgstr "Một sự pha trộn cân bằng tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "Well... I suppose plants need carbon too."
msgstr "À... tôi cho rằng thực vật cũng cần carbon."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "It requires a bit more moisture."
msgstr "Nó đòi hỏi độ ẩm nhiều hơn một chút."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "Composting is an essential component to gardening."
msgstr "Phân trộn là một thành phần thiết yếu để làm vườn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTINGBIN.WET"
msgid "The moisture level of this mixture is too high."
msgstr "Độ ẩm của hỗn hợp này quá cao."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTWRAP"
msgid "Oh dear. Those are some large droppings."
msgstr "Ôi trời ơi. Đó là một số phân lớn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CONSTRUCTION_PLANS"
msgid "Oh, I do like the look of this."
msgstr "Ồ, tôi thích vẻ ngoài này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKBOOK"
msgid "A collection of culinary observations."
msgstr "Một bộ sưu tập các quan sát ẩm thực."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKEDMANDRAKE"
msgid "Mandragora officinarum, cooked in the name of discovery."
msgstr "Mandragora officinarum, nấu chín trong tên của khám phá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKEDMEAT"
msgid "It is slightly more appetizing when cooked."
msgstr "Nó là hơi ngon miệng hơn khi nấu chín."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKEDMONSTERMEAT"
msgid "It's still a little bit poisonous."
msgstr "Nó vẫn là một chút độc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKEDSMALLMEAT"
msgid "It is slightly more appetizing when cooked."
msgstr "Nó là hơi ngon miệng hơn khi nấu chín."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKIECUTTER"
msgid "Its eyes seem fixed to my raft."
msgstr "Đôi mắt của nó dường như dán chặt vào chiếc bè của tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKIECUTTERHAT"
msgid "Hm, it has a very disagreeable odor."
msgstr "Ừm, nó có mùi rất khó chịu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKIECUTTERSHELL"
msgid "A thick casing of calcium carbonate."
msgstr "Một lớp vỏ dày bằng canxi cacbonat."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "Oh dear, I can't seem to make any sense of it."
msgstr "Ôi trời, tôi dường như không thể hiểu được điều đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKPOT.BURNT"
msgid "Now it's truly derelict."
msgstr "Bây giờ nó thật sự vô chủ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "It's got a bit to go before it's ready."
msgstr "Nó có một chút để đi trước khi nó đã sẵn sàng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "Almost done!"
msgstr "Sắp xong!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKPOT.DONE"
msgid "Supper time!"
msgstr "Hiện Supper!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKPOT.EMPTY"
msgid "It looks derelict when it's not cooking something."
msgstr "Có vẻ vô chủ khi nó không được ăn một cái gì đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOLANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOLANT"
msgid "The fluids exhibit anomalous properties, no doubt catalyzed by the mutations."
msgstr "Chất lỏng thể hiện những đặc tính dị thường, chắc chắn được xúc tác bởi các đột biến."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COONTAIL"
msgid "A flexible torso appendage."
msgstr "Một thân phụ linh hoạt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CORN"
msgid "Zea mays, a great staple food."
msgstr "Zea mays, một lương thực lớn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CORN_COOKED"
msgid "Popped corn!"
msgstr "Ngô nổ!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CORN_OVERSIZED"
msgid "Quite an impressive harvest."
msgstr "Một vụ thu hoạch khá ấn tượng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CORN_SEEDS"
msgid "It can't begin growing until it's been planted, dear."
msgstr "Nó không thể bắt đầu phát triển cho đến khi nó được trồng, em yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "It appears to be a theatrical costume."
msgstr "Nó có vẻ là một bộ trang phục sân khấu."

