msgstr "Bên trong dính nhớp."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORWAGPUNK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORWAGPUNK"
msgid "Wolfgang not need robot armor for protection, only like it for color."
msgstr "Wolfgang không cần giáp robot để bảo vệ đâu, chỉ thích màu sắc của nó thôi."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORWOOD"
msgid "Is almost strong as belly!"
msgstr "Gần như cứng cáp được như bụng của ta vậy!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_BRAMBLE"
msgid "Mighty Wolfgang does not need armor!"
msgstr "Wolfgang hùng mạnh không cần giáp giếc gì hết!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_CARROTLURE"
msgid "Looks healthy."
msgstr "Trông có vẻ khỏe mạnh."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_LUNARPLANT"
