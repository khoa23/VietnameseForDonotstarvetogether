#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.APPLYELIXIR.NO_ELIXIRABLE
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.APPLYELIXIR.NO_ELIXIRABLE"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.APPLYELIXIR.TOO_SUPER
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.APPLYELIXIR.TOO_SUPER"
