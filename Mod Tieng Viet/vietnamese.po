msgid "I suppose there's time to make one little trinket, or two."
msgstr "Tôi cho rằng có thời gian để làm một hoặc hai món đồ trang sức nhỏ."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE_GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE_GENERIC"
