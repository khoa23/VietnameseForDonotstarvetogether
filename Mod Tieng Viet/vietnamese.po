msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "Pssh. This heat's nothing."
msgstr "Pssh. Cái nóng này thì thấm vào đâu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYSAUCE"
msgid "Pass it over here!"
msgstr "Đưa nó qua đây nào!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIBINGKA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIBINGKA"
msgid "I'll give it a try!"
msgstr "Tôi sẽ thử xem sao!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIGFOOT"
msgid "At least it doesn't have steel-toed workboots!"
msgstr "Ít ra thì nó không đi giày bảo hộ mũi thép!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRCHNUTDRAKE"
msgid "Shoo! Get outta here!"
msgstr "Suỵt! Cút ra chỗ khác đi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.DEAD"
msgid "I think it was my turn to feed her."
msgstr "Hình như đến lượt tôi cho nó ăn thì phải."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.GENERIC"
msgid "That's some proper metalwork."
msgstr "Đó mới đúng là tác phẩm kim loại chất lượng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "Hey! Is it my turn to feed the bird?"
msgstr "Này! Đến lượt tôi cho chim ăn chưa đấy?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "She was just a patsy."
msgstr "Nó chỉ là một con tốt thí thôi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.SKELETON"
msgid "Let's uh... just sweep that under the rug."
msgstr "Thôi thì... cứ giấu nhẹm nó đi vậy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "Why are you tired? Your life is so cushy."
msgstr "Sao cậu lại mệt mỏi chứ? Cuộc sống của cậu sướng như tiên còn gì."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.STARVING"
msgid "This poor bird's a bag of bones."
msgstr "Con chim tội nghiệp này chỉ còn lại da bọc xương."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCORPSE.BURNING"
msgid "That'll do the trick."
msgstr "Thế là xong việc."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCORPSE.GENERIC"
msgid "It ain't the end."
msgstr "Chưa phải là tận thế đâu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCORPSE.REVIVING"
msgid "Great. We missed our chance."
msgstr "Tuyệt thật. Chúng ta lỡ mất cơ hội rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDTRAP"
msgid "Birds of a feather get trapped together."
msgstr "Lắm lông thì dính bẫy chung với nhau thôi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_EGG"
msgid "Breakfast."
msgstr "Bữa sáng đây."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_EGG_COOKED"
msgid "I always get bits of shell in there by accident."
msgstr "Tôi lúc nào cũng vô tình để lẫn mảnh vỏ trứng vào trong."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_MUTANT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_MUTANT"
msgid "That bird gives me the creeps."
msgstr "Con chim đó làm tôi nổi cả da gà."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_MUTANT_SPITTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_MUTANT_SPITTER"
msgid "There's something... off about it."
msgstr "Có cái gì đó... sai sai ở nó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP"
msgid "How industrial."
msgstr "Công nghiệp hóa ghê thật."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Yeow!"
msgstr "Ái chà!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP_NIGHTMARE"
msgid "You look awful!"
msgstr "Trông mi tơi tả quá đấy!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLACKFLAG"
msgid "Not the cheeriest, is it?"
msgstr "Trông chẳng vui vẻ gì cho lắm nhỉ?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_FIRE"
msgid "Simple, but effective."
msgstr "Đơn giản, nhưng hiệu quả."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_LAVA"
msgid "Efficient, and painful!"
msgstr "Hiệu quả, và đau đớn đấy!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_LAVA2"
msgid "That's right up my alley!"
msgstr "Cái này là đúng sở trường của tôi rồi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_PIPE"
msgid "Ptoo!"
msgstr "Phụt!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_SLEEP"
msgid "Inflicts the very worst thing... laziness."
msgstr "Gây ra điều tồi tệ nhất... sự lười biếng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_YELLOW"
msgid "I'm gonna shoot this at the bot's butt."
msgstr "Tôi sẽ bắn cái này vào mông con robot."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEAMULET"
msgid "Now I don't have to take breaks to cool off."
msgstr "Giờ thì tôi khỏi cần nghỉ giải lao để hạ nhiệt nữa rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEGEM"
msgid "It's a gem. A gem that's blue."
msgstr "Đó là một viên ngọc. Một viên ngọc có màu xanh."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEMOONEYE"
msgid "It saw me standing alone."
msgstr "Nó nhìn tôi đứng lủi thủi một mình."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEPRINT.COMMON"
msgid "Blueprint paper just smells right."
msgstr "Giấy bản thiết kế ngửi đúng mùi của nó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEPRINT.RARE"
msgid "Progress on paper!"
msgstr "Sự tiến bộ trên giấy!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_CAP"
msgid "Yep. Blue mushroom."
msgstr "Chuẩn luôn. Cây nấm Lam."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_CAP_COOKED"
msgid "Well, I don't THINK it's poison."
msgstr "Ừm, tôi KHÔNG nghĩ nó có độc đâu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "It's some sorta blue mushroom."
msgstr "Đó là một loại cây nấm Lam nào đó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "Lazy mushroom."
msgstr "Cây nấm lười biếng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Got'er done."
msgstr "Xong việc."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARDS"
msgid "Oh, the possibilities."
msgstr "Ồ, bao nhiêu khả năng mở ra."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARON"
msgid "Who's ready fer some bacon?!"
msgstr "Đứa nào sẵn sàng làm vài miếng thịt xông khói chưa hả?!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARRIOR"
msgid "Let's cut him down to size!"
msgstr "Cho hắn biết tay nào!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT03"
msgid "Busted right up, hey?"
msgstr "Vỡ nát bét ra rồi còn gì?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT04"
msgid "Busted right up, hey?"
msgstr "Vỡ nát bét ra rồi còn gì?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT05"
msgid "Busted right up, hey?"
msgstr "Vỡ nát bét ra rồi còn gì?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATPATCH"
msgid "Never know when you might need one."
msgstr "Không biết trước được khi nào bạn sẽ cần đến nó đâu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATPATCH_KELP"
msgid "Just a quick fix until I can do some proper repairs."
msgstr "Chỉ là vá tạm để đó cho đến khi tôi có thể sửa chữa đàng hoàng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "Checkpoint ahead!"
msgstr "Điểm Kiếm Soát phía trước!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "Better roll up my sleeves and get to buildin'."
msgstr "Tốt hơn là nên xắn tay áo lên và bắt tay vào xây dựng thôi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "Tryin' to throw a monkeywrench in my race, sis?"
msgstr "Định chơi khăm cuộc đua của tôi à, cưng?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK"
msgid "Buoy ahead!"
msgstr "Phao tiêu phía trước!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Buoy ahead!"
msgstr "Phao tiêu phía trước!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "Better watch where I throw it, wouldn't wanna bust up someone's boat."
msgstr "Nhìn cho kỹ hướng ném vào, không lại làm hỏng thuyền ván của ai đó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "Better watch where I throw it, wouldn't wanna bust up someone's boat."
msgstr "Nhìn cho kỹ hướng ném vào, không lại làm hỏng thuyền ván của ai đó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "Must be the new supervisor."
msgstr "Chắc là giám sát viên mới rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_START"
msgid "No sense stallin', let's go!"
msgstr "Chần chừ gì nữa, đi thôi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "Better get started!"
msgstr "Bắt đầu thôi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "Plenty of space for storage."
msgstr "Rất nhiều không gian để chứa đồ."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "They sure don't build 'em like they used to."
msgstr "Họ đúng là không còn chế tạo đồ đạc được như xưa nữa rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_CRABKING"
msgid "It sometimes pays to have a tough exterior."
msgstr "Đôi khi có một lớp vỏ ngoài cứng cáp cũng có lợi đấy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_CRABKING_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_CRABKING_KIT"
msgid "Extra protection's always good, 'specially on water."
msgstr "Bảo vệ thêm lúc nào cũng tốt, nhất là trên mặt nước."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_KELP"
msgid "Slimy, but it'll do for securin' the boat some more."
msgstr "Hơi nhờn rít, nhưng dùng để gia cố thêm cho thuyền ván thì tạm ổn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "Extra protection's always good, 'specially on water."
msgstr "Bảo vệ thêm lúc nào cũng tốt, nhất là trên mặt nước."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "Turns out seashells are good for givin' shellter from the sea. Ha!"
msgstr "Hóa ra vỏ sò lại rất hữu ích trong việc che chắn khỏi biển cả. Hà!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "Extra protection's always good, 'specially on water."
msgstr "Bảo vệ thêm lúc nào cũng tốt, nhất là trên mặt nước."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "Wouldn't wanna end up on the business end of those fangs."
msgstr "Mình không muốn dây dưa vào đầu nhọn của mấy cái nanh vuốt đó đâu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "Extra protection's always good, 'specially on water."
msgstr "Bảo vệ thêm lúc nào cũng tốt, nhất là trên mặt nước."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "All you sea critters better think twice about messing with my boat!"
msgstr "Lũ sinh vật biển các người tốt hơn là nên suy nghĩ kỹ trước khi gây sự với thuyền ván của tôi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "It won't do much good if it's not loaded."
msgstr "Nó sẽ chẳng có ích gì mấy nếu không được nạp đạn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "I won't be able to do much without some cannonballs."
msgstr "Tôi sẽ chẳng làm được gì nhiều nếu thiếu đạn đại bác đâu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_CANNON_KIT"
msgid "I'll get 'er firin' ready in no time."
msgstr "Tôi sẽ làm cho nó sẵn sàng khai hỏa ngay thôi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_GRASS_ITEM"
msgid "Don't expect to build somethin' that's gonna last with cheap materials."
msgstr "Đừng mong xây dựng được cái gì bền vững bằng nguyên liệu rẻ tiền."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ITEM"
msgid "Time to roll up my sleeves!"
msgstr "Đã đến lúc xắn tay áo lên rồi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_LEAK"
msgid "That needs a fixin'!"
msgstr "Cái đó cần phải sửa gấp!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "Leaves my hands free for other work!"
msgstr "Giải phóng đôi tay để làm việc khác!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "Hands-free sailing, pretty nifty."
msgstr "Chèo thuyền rảnh tay, khá là tiện lợi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "I'm not sayin' I'm surprised it works, but..."
msgstr "Tôi không nói là mình ngạc nhiên khi nó hoạt động đâu, nhưng mà..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "It'll be handy if it works."
msgstr "Nó sẽ rất hữu dụng nếu hoạt động được."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_MAGNET_KIT"
msgid "I think I get the gist, just gotta put it together."
msgstr "Tôi nghĩ mình hiểu cốt lõi rồi, chỉ việc lắp ráp lại thôi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ROTATOR"
msgid "Controllin' the boat rotation is mighty useful."
msgstr "Việc điều khiển hướng xoay của thuyền ván cực kỳ hữu ích đấy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "Time to put this doo-hickey to the test."
msgstr "Đã đến lúc đưa món đồ này vào thử nghiệm rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "It's cushy enough for me."
msgstr "Nó đủ êm ái đối với tôi rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BODYPILLOW_KELP"
msgid "It wouldn't be my first choice of pillow stuffing."
msgstr "Nó sẽ không phải là lựa chọn bánh nhồi gối đầu tiên của tôi đâu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BODYPILLOW_PETALS"
msgid "Way too flimsy, there's no support at all!"
msgstr "Quá là ọp ẹp, chẳng có điểm tựa nào cả!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "Aww, it kinda makes me nostalgic for the old steel mill."
msgstr "Chà, nó làm tôi nhớ về nhà máy thép cũ một cách hoài niệm."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOMB_LUNARPLANT"
msgid "Anyone call for a demolition crew?"
msgstr "Có ai gọi đội phá dỡ không vậy?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "I think that little green fella did some tinkering."
msgstr "Tôi nghĩ gã tí hon màu xanh đó đã mày mò gì rồi đây."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BONESHARD"
msgid "Whew. These got crunched real good."
msgstr "Phù. Mấy cái này bị nghiền nát kỹ thật."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BONESOUP"
msgid "Knocked it out of the park again, bucko."
msgstr "Lại ghi điểm tuyệt đối nữa rồi, anh bạn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BONESTEW"
msgid "Hearty."
msgstr "Bổ dưỡng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOKSTATION.BURNT"
msgid "Shoot. Grams is gonna have a fit."
msgstr "Chết tiệt. Bà mà thấy chắc sẽ nổi điên lên mất."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOKSTATION.GENERIC"
msgid "I've gotta say, that's some pretty solid construction."
msgstr "Phải công nhận là nó được cấu trúc khá vững chắc."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_BEES"
msgid "I can't read when there's work to do!"
msgstr "Tôi không có thời gian đọc sách khi còn việc phải làm!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_BIRDS"
msgid "I was never much of a book learner."
msgstr "Tôi chưa bao giờ là kiểu người mọt sách."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_BRIMSTONE"
msgid "I prefer hands-on learning."
msgstr "Tôi thích học qua thực hành hơn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_ELEMENTAL"
msgid "I ain't too well read."
msgstr "Tôi không đọc nhiều sách lắm đâu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_FIRE"
msgid "Not really my kinda thing."
msgstr "Không hẳn là gu của tôi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_FISH"
msgid "I learn by doing, not reading."
msgstr "Tôi học bằng cách làm, chứ không phải đọc sách."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_FOSSIL"
msgid "I ain't much of a bookworm."
msgstr "Tôi chẳng phải mọt sách gì cho cam."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_GARDENING"
msgid "I prefer to learn from experience."
msgstr "Tôi thích học từ kinh nghiệm thực tế hơn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_HORTICULTURE"
msgid "I prefer to learn from experience."
msgstr "Tôi thích học từ kinh nghiệm thực tế hơn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "I don't need a book tellin' me how to stick seeds in the ground."
msgstr "Tôi không cần một cuốn sách dạy mình cách nhét hạt xuống đất đâu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_LIGHT"
msgid "I gotta admit, pretty handy to have a book with a built-in reading lamp."
msgstr "Phải thừa nhận là có một cuốn sách tích hợp sẵn đèn đọc sách khá là tiện."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "It's all Greek to me."
msgstr "Tôi chẳng hiểu gì sất."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_MOON"
msgid "At this point, I wish I knew less about the moon."
msgstr "Đến lúc này, tôi ước gì mình biết ít hơn về mặt trăng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_RAIN"
msgid "I'm too busy to sit around and read."
msgstr "Tôi quá bận để ngồi một chỗ và đọc sách."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "You'll only really learn by gettin' your hands dirty."
msgstr "Cậu chỉ thực sự học được khi tự tay nhúng chàm thôi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_SILVICULTURE"
msgid "I'd rather have building material than reading material."
msgstr "Tôi thà có vật liệu xây dựng còn hơn là tài liệu đọc."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_SLEEP"
msgid "I already know how to sleep, thanks."
msgstr "Tôi biết cách ngủ rồi, cảm ơn nhé."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_TEMPERATURE"
msgid "Sorry grams, I'm not much of a reader."
msgstr "Xin lỗi bà, cháu không có hứng đọc sách lắm."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_TENTACLES"
msgid "I'm not really a \"book smarts\" kind of gal."
msgstr "Tôi không phải kiểu con gái \"giỏi sách vở\" cho lắm."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_WEB"
msgid "This ain't one of them self-help books, is it?"
msgstr "Đây không phải là một trong mấy cuốn sách tự lực hướng dẫn bản thân chứ?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOMERANG"
msgid "It's great at comebacks. Ha!"
msgstr "Nó cực giỏi trong việc quay trở lại. Hà!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOTLEG"
msgid "Guess I'd better shake a leg. Ha!"
msgstr "Chắc tôi phải chuồn lẹ thôi. Hà!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BROKEN_FORGEDITEM"
msgid "I bet I could get it back in working order."
msgstr "Tôi cá là mình có thể khôi phục nó về trạng thái hoạt động được."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BROKEN_FUMAROLETOOLITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BROKEN_FUMAROLETOOLITEM"
msgid "Some heat will fix that right up."
msgstr "Chút nhiệt lượng sẽ khắc phục được ngay thôi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BRUSH"
msgid "Repetitive tasks are soothing."
msgstr "Những công việc lặp đi lặp lại thật thư giãn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUGNET"
msgid "Wish we had mosquito netting."
msgstr "Ước gì chúng ta có màn chống muỗi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "We can pick it if we can get close enough."
msgstr "Chúng ta có thể hái nó nếu lại gần đủ mức."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "The sea's fulla food, hey?"
msgstr "Biển đầy ắp thức ăn phải không nào?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BULLKELP_ROOT"
msgid "Preferred tool of the foreman."
msgstr "Công cụ ưa thích của đốc công."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUNDLE"
msgid "That oughta keep everything nice and fresh."
msgstr "Cái đó hẳn sẽ giữ cho mọi thứ thật tươi ngon."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUNDLEWRAP"
msgid "We could wrap stuff up for later."
msgstr "Chúng ta có thể gói đồ lại dùng sau."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUNNYMAN"
msgid "You really oughta get some sun."
msgstr "Cậu thực sự nên ra ngoài phơi nắng đi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUNNYSTEW"
msgid "I'm so hungry I could eat a... bunny?"
msgstr "Tôi đói đến mức có thể ăn cả một... con thỏ?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BURNT_MARSH_BUSH"
msgid "Right to a crisp."
msgstr "Cháy khét lẹt luôn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUSHHAT"
msgid "Just, y'know. Strap a bush on your head."
msgstr "Chỉ là, bạn biết đấy. Buộc một bụi cây lên đầu thôi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTER"
msgid "This makes everything better."
msgstr "Thứ này làm cho mọi thứ trở nên tuyệt vời hơn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLY.GENERIC"
msgid "It has no work or responsibilities. Poor thing."
msgstr "Nó chẳng có việc làm hay trách nhiệm gì cả. Tội nghiệp thật."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLY.HELD"
msgid "How you doin' in there?"
msgstr "Trong đó thế nào rồi hả cưng?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLYMUFFIN"
msgid "Never liked having butterflies in my stomach."
msgstr "Chưa bao giờ thích có bướm trong bụng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLYWINGS"
msgid "There's no flight in their future."
msgstr "Tương lai của chúng sẽ chẳng thể bay lượn gì nữa đâu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUZZARD"
msgid "It lives off the hard work of others."
msgstr "Nó sống dựa vào sự chăm chỉ của kẻ khác."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUZZARDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUZZARDCORPSE.BURNING"
msgid "That'll do the trick."
msgstr "Thế là xong việc."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUZZARDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUZZARDCORPSE.GENERIC"
msgid "It ain't the end."
msgstr "Chưa phải là tận thế đâu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUZZARDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUZZARDCORPSE.REVIVING"
msgid "Great. We missed our chance."
msgstr "Tuyệt thật. Chúng ta lỡ mất cơ hội rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CABBAGEROLLS"
msgid "That'll put meat on your bones!"
msgstr "Món đó sẽ bồi bổ xương thịt cho bạn đấy!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CACTUS.GENERIC"
msgid "Prickly."
msgstr "Gai góc quá."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CACTUS.PICKED"
msgid "Guess we know who won that one."
msgstr "Chắc chúng ta biết ai là kẻ thắng cuộc rồi đấy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CACTUS_FLOWER"
msgid "Much less prickly."
msgstr "Bớt gai góc hơn nhiều."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CACTUS_MEAT"
msgid "It's got a sharp taste. Ha!"
msgstr "Nó có vị khá cay gắt đấy. Hà!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "That seems a lot safer."
msgstr "Trông có vẻ an toàn hơn nhiều rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CALIFORNIAROLL"
msgid "Looks a bit fancy, but I'll give it a try!"
msgstr "Trông có vẻ sang chảnh phết, nhưng tôi sẽ thử!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.EMBERS"
msgid "On its last legs."
msgstr "Sắp tàn lụi đến nơi rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.GENERIC"
msgid "It'll last me the night, hopefully."
msgstr "Hy vọng nó sẽ cháy đủ qua đêm nay."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.HIGH"
msgid "A good healthy blaze."
msgstr "Một ngọn lửa bùng cháy khỏe khoắn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.LOW"
msgid "Gonna go out soon."
msgstr "Sắp tắt đến nơi rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.NORMAL"
msgid "About as cozy as it gets out here."
msgstr "Ấm cúng nhất có thể khi ở ngoài này rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.OUT"
msgid "My sister was afraid of the dark."
msgstr "Em gái tôi sợ bóng tối."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CANARY.GENERIC"
msgid "That brings back memories."
msgstr "Điều đó gợi lại bao kỷ niệm."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CANARY.HELD"
msgid "I should take it with me if I go spelunking."
msgstr "Tôi nên mang nó theo nếu đi thám hiểm hang động."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CANARY_POISONED"
msgid "Everybody out of the mineshaft!!"
msgstr "Tất cả mau ra khỏi mỏ ngay!!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CANDYBAG"
msgid "It's a goodybag."
msgstr "Đó là một túi quà đấy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CANE"
msgid "It's no Tin Lizzie."
msgstr "Nó chẳng phải Tin Lizzie đâu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CANNONBALL_ROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CANNONBALL_ROCK_ITEM"
msgid "Better load this in the cannon."
msgstr "Tốt hơn là nên nạp cái này vào đại bác."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALCANNON.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALCANNON.COOLDOWN"
msgid "Now that'll cheer you right up!"
msgstr "Giờ thì điều đó sẽ làm bạn phấn chấn ngay thôi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALCANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALCANNON.GENERIC"
msgid "Looks like it's on break."
msgstr "Trông như nó đang nghỉ giải lao vậy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALCANNON_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALCANNON_KIT"
msgid "Well, this thing's not gonna build itself."
msgstr "Chà, thứ này sẽ không tự xây dựng lên đâu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_BANNER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_BANNER"
msgid "It really fancies the place up, doesn't it?"
msgstr "Nó làm nơi này trông sang hẳn lên nhỉ?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_BANNER_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_BANNER_KIT"
msgid "Shouldn't take long to build."
msgstr "Chắc xây nhanh thôi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_EGGRIDE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_EGGRIDE"
msgid "Not sure what I should do with this now that I built it..."
msgstr "Không biết nên làm gì với cái này nữa sau khi dựng nó lên đây..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT"
msgid "Let's get crackin'! Ha!"
msgstr "Bắt tay vào làm thôi nào! Hà!"

