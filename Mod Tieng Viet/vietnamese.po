msgstr "Là sàn nhà hay trần nhà, tùy vào góc nhìn của ngươi thôi."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_CHECKERFLOOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_CHECKERFLOOR"
msgid "Floor or ceiling, depending on your perspective."
msgstr "Là sàn nhà hay trần nhà, tùy vào góc nhìn của ngươi thôi."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_COTL_BRICK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_COTL_BRICK"
msgid "These bricks should do the trick."
msgstr "Mấy viên gạch này dùng được phết."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_COTL_GOLD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_COTL_GOLD"
msgid "All that gold, and this is what we have to show floor it."
msgstr "Đống vàng đó, và đây là những gì chúng ta có để lót sàn."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_DECIDUOUS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_DECIDUOUS"
msgid "Floor or ceiling, depending on your perspective."
msgstr "Là sàn nhà hay trần nhà, tùy vào góc nhìn của ngươi thôi."

