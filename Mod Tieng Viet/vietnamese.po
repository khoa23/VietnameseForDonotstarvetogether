#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTMODKIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTMODKIT"
msgid "The young scout doth come into his own."
msgstr "Các trinh sát trẻ đã trở thành chính mình."

