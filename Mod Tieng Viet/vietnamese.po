msgstr "Ờ, Willow? Có thể bạn muốn kiểm soát con gấu của mình phải không?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.PILLOWFIGHT_NO_HANDPILLOW
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.PILLOWFIGHT_NO_HANDPILLOW"
