msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_decorated
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_decorated"
msgid "Nothing says fun like a fringe."
msgstr "Không gì nói lên sự vui vẻ bằng tua rua."

#. STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_decorated2
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_decorated2"
msgid "All wrapped up and finished off with a delightful bow!"
msgstr "Được gói gọn gàng và thắt nơ xinh xắn!"

#. STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_decorated2_item
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_decorated2_item"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_decorated3
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_decorated3"
msgid "Comes complete with a cute little cap."
msgstr "Đi kèm với một chiếc mũ nhỏ dễ thương."

#. STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_decorated3_item
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_decorated3_item"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_decorated_item
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_decorated_item"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_kitchen
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_kitchen"
msgid "A post decorated with delicately-carved floral patterns."
msgstr "Một cột được trang trí bằng các họa tiết hoa chạm trổ tinh xảo."

#. STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_kitchen2
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_kitchen2"
msgid "Stout, sturdy, and well-made."
msgstr "Đạm đà, chắc chắn và được làm rất tốt."

#. STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_kitchen2_item
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_kitchen2_item"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_kitchen3
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_kitchen3"
msgid "This post has been carved with utmost care."
msgstr "Cột này được chạm trổ với sự chăm chút tối đa."

#. STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_kitchen3_item
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_kitchen3_item"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_kitchen_item
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dock_woodposts_kitchen_item"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.dragonflychest_fantasy
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dragonflychest_fantasy"
msgid "The only thing that will placate this fearsome chest is a belly full of treasure."
msgstr "Thứ duy nhất có thể làm dịu chiếc rương đáng sợ này là một cái bụng đầy kho báu."

#. STRINGS.SKIN_DESCRIPTIONS.dragonflychest_kraken
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dragonflychest_kraken"
msgid "This chest is guarded by the visage of a terrifying sea creature."
msgstr "Chiếc rương này được canh giữ bởi gương mặt của một sinh vật biển đáng sợ."

#. STRINGS.SKIN_DESCRIPTIONS.dragonflychest_upgraded_fantasy
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dragonflychest_upgraded_fantasy"
msgid "The only thing that will placate this fearsome chest is a belly full of treasure."
msgstr "Thứ duy nhất có thể làm dịu chiếc rương đáng sợ này là một cái bụng đầy kho báu."

#. STRINGS.SKIN_DESCRIPTIONS.dragonflychest_upgraded_kraken
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dragonflychest_upgraded_kraken"
msgid "This chest is guarded by the visage of a terrifying sea creature."
msgstr "Chiếc rương này được canh giữ bởi gương mặt của một sinh vật biển đáng sợ."

#. STRINGS.SKIN_DESCRIPTIONS.dragonflyfurnace_adventure
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dragonflyfurnace_adventure"
msgid "Despite the heat it provides, you can't help but feel a chill run down your spine."
msgstr "Dù nó tỏa ra hơi ấm, bạn vẫn không khỏi cảm thấy lạnh sống lưng."

#. STRINGS.SKIN_DESCRIPTIONS.dragonflyfurnace_antique
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dragonflyfurnace_antique"
msgid "A gilded antique furnace that evokes the image of a fallen foe."
msgstr "Một lò sưởi cổ mạ vàng gợi lên hình ảnh của một kẻ thù đã gục ngã."

#. STRINGS.SKIN_DESCRIPTIONS.dragonflyfurnace_crystal
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dragonflyfurnace_crystal"
msgid "Fine jewels won't keep you warm, but this fine jeweled furnace will!"
msgstr "Đá quý đẹp sẽ không giữ ấm cho bạn được đâu, nhưng lò sưởi nạm ngọc đẹp này thì có đấy!"

#. STRINGS.SKIN_DESCRIPTIONS.dragonling_bat
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dragonling_bat"
