msgstr "Chúng tôi mệt mỏi vì phải chiến đấu!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK"
