msgstr "Mọi thứ đang trở nên mơ hồ!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DETACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DETACH_BUFF_ATTACK"
