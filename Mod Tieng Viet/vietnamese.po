msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.fence_rose
msgctxt "STRINGS.SKIN_DESCRIPTIONS.fence_rose"
msgid "Rose thorns are nature's barbed wire."
msgstr "Gai hoa hồng là dây thép gai của thiên nhiên."

#. STRINGS.SKIN_DESCRIPTIONS.fence_rose_item
msgctxt "STRINGS.SKIN_DESCRIPTIONS.fence_rose_item"
msgid "n/a"
msgstr "không có"

#. STRINGS.SKIN_DESCRIPTIONS.fence_shell
msgctxt "STRINGS.SKIN_DESCRIPTIONS.fence_shell"
msgid "The shells make it extra fency."
msgstr "Vỏ làm cho nó thêm hàng rào."

#. STRINGS.SKIN_DESCRIPTIONS.fence_shell_item
msgctxt "STRINGS.SKIN_DESCRIPTIONS.fence_shell_item"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.fence_victorianblack
msgctxt "STRINGS.SKIN_DESCRIPTIONS.fence_victorianblack"
msgid "Just the thing to bar pesky urchins from your manor."
msgstr "Chỉ là thứ để thanh nhím pesky từ trang viên của bạn."

#. STRINGS.SKIN_DESCRIPTIONS.fence_victorianblack_item
