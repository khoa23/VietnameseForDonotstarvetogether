msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTEROMETER.GENERIC"
msgid "Cold go up! Red go down!"
msgstr "Cái lạnh tăng lên! Vạch đỏ tụt xuống!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTERSFEASTFUEL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTERSFEASTFUEL"
