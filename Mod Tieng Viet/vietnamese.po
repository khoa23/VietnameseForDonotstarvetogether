msgstr "Cái gậy nhức đầu màu mè."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TENT.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TENT.BURNT"
