#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY"
msgid "Something put a damper on that chimney."
msgstr "Có cái gì đó làmụt tắt cái ống khói đó rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2"
msgid "Something put a damper on that chimney."
msgstr "Có cái gì đó làmụt tắt cái ống khói đó rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK"
msgid "Someone beat the clock. Literally."
msgstr "Ai đó đã đánh bại thời gian. Theo đúng nghĩa đen."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER"
msgid "That clock's been punched."
msgstr "Cái đồng hồ đó vừa bị đấm tơi bời."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1"
msgid "No one's here."
msgstr "Không có ai ở đây cả."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2"
msgid "Something destroyed this town."
msgstr "Thứ gì đó đã phá hủy thị trấn này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3"
msgid "I wonder who they angered."
msgstr "Tự hỏi bọn chúng đã chọc giận ai nhỉ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR"
msgid "No longer a-door-able."
msgstr "Không còn đáng yêu... ý nhầm, đáng mở nữa rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_RUBBLE_ROOF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_RUBBLE_ROOF"
msgid "Someone hit the roof."
msgstr "Ai đó đã đập phá mái nhà."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SAFE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SAFE.GENERIC"
msgid "It's a safe. For keeping things safe."
msgstr "Đó là một cái két sắt. Dùng để cất giữ đồ đạc an toàn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SAFE.LOCKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SAFE.LOCKED"
msgid "It won't open without the key."
msgstr "Nó sẽ không mở được nếu không có chìa khóa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SALMON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SALMON"
msgid "Mm, fresh fish."
msgstr "Ừm, câu cá tươi ngon."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SALMON_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SALMON_COOKED"
msgid "Ready for the dinner table."
msgstr "Sẵn sàng lên bàn ăn rồi đây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SALT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SALT"
msgid "It's full of salt."
msgstr "Nó đầy muối."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SALTROCK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SALTROCK"
msgid "Salt. The tastiest mineral."
msgstr "Muối. Khoáng chất ngon nhất."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC"
msgid "Science takes time."
msgstr "Khoa học cần có thời gian."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SALT_RACK.READY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SALT_RACK.READY"
msgid "Salt has gathered on the rope."
msgstr "Muối đã đọng lại trên dây thừng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
msgid "For harvesting salt from the pond."
msgstr "Dùng để thu hoạch muối từ cái ao."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SAP"
msgid "It tastes sweet."
msgstr "Nó có vị ngọt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SAPBUCKET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SAPBUCKET"
msgid "We can use it to gather sap from the trees."
msgstr "Chúng ta có thể dùng nó để lấy nhựa cây từ các thân cây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SAPLING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SAPLING"
msgid "I can't get anything else out of that."
msgstr "Tôi không thể lấy thêm gì từ thứ đó nữa rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SAP_SPOILED"
msgid "Might as well toss it on the fire."
msgstr "Cứ ném nó vào lửa quách cho rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SEEDPACKET"
msgid "Sow what?"
msgstr "Gieo gì gặt nấy nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL"
msgid "Laboratory tools for surgical butchery."
msgstr "Dụng cụ phòng thí nghiệm dùng để mổ xẻ phẫu thuật."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND"
msgid "Flavorful."
msgstr "Đậm đà hương vị."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC"
msgid "It reminds me of those tentacle monsters."
msgstr "Nó làm tôi nhớ đến những con quái vật xúc tu đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED"
msgid "I can't get anymore out of that shrub."
msgstr "Tôi không thể lấy thêm gì từ bụi cây đó nữa rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG"
msgid "I could grind it up to make a spice."
msgstr "Tôi có thể nghiền nát nó để làm gia vị."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC"
msgid "It's full of delicious, delicious sap."
msgstr "Nó chứa đầy nhựa cây ngon tuyệt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP"
msgid "Where'd the tree go? I'm stumped."
msgstr "Cái cây đâu mất tiêu rồi? Tôi bí tịt rồi đây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS"
msgid "That's how you get ants."
msgstr "Đó là cách để thu hút lũ kiến đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY"
msgid "Here sappy, sappy, sap."
msgstr "Nhựa cây ơi, mau chảy ra nào."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY"
msgid "Sweet golden sap."
msgstr "Nhựa cây vàng óng ngọt ngào."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED"
msgid "It looks ill."
msgstr "Trông nó có vẻ ốm yếu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SWAMPIG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SWAMPIG"
msgid "It's a super hairy pig."
msgstr "Đó là một con lợn siêu nhiều lông."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
msgid "I guess you're in charge around here?"
msgstr "Chắc cậu là người quản ở đây hả?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
msgid "It's sleeping, for now."
msgstr "Nó đang ngủ, tạm thời là vậy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE"
msgid "It's seen better days."
msgstr "Nó đã qua thời huy hoàng rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
msgid "Some pig's house was ruined."
msgstr "Nhà của con lợn nào đó đã bị tàn phá."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SYRUP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SYRUP"
msgid "Adds sweetness to the mixture."
msgstr "Thêm vị ngọt cho hỗn hợp."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_TOMATO
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_TOMATO"
msgid "It's red because it's full of science."
msgstr "Nó màu đỏ vì chứa đầy khoa học."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
msgid "Cooking's easy if you understand chemistry."
msgstr "Nấu ăn thật dễ dàng nếu bạn hiểu về hóa học."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_TOMATO_SEEDS"
msgid "A handful of odd seeds."
msgstr "Một nắm hạt kỳ lạ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_TRADER_MERM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_TRADER_MERM"
msgid "Maybe they'd be willing to trade."
msgstr "Biết đâu chúng lại muốn trao đổi thì sao."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_TRADER_MERM2"
msgid "Maybe they'd be willing to trade."
msgstr "Biết đâu chúng lại muốn trao đổi thì sao."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_TURNIP"
msgid "It's a raw turnip."
msgstr "Đó là một củ củ cải tím sống."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
msgid "Cooking is science in practice."
msgstr "Nấu ăn là khoa học trong thực tiễn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "A handful of odd seeds."
msgstr "Một nắm hạt kỳ lạ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_WHEAT"
msgid "It looks a bit grainy."
msgstr "Trông có vẻ hơi nhiều hạt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_WHEAT_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_WHEAT_SEEDS"
msgid "A handful of odd seeds."
msgstr "Một nắm hạt kỳ lạ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBIT.GENERIC"
msgid "He's looking for carrots."
msgstr "Nó đang tìm cà rốt kìa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBIT.HELD"
msgid "Do you like science?"
msgstr "Mày có thích khoa học không hả?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITHAT"
msgid "It'll put hare on your head."
msgstr "Nó sẽ mọc lông trên đầu bạn đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITHOLE.GENERIC"
msgid "That must lead to the Kingdom of the Bunnymen."
msgstr "Chỗ đó chắc dẫn đến Vương quốc Người Thỏ rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITHOLE.SPRING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITHOLE.SPRING"
msgid "The Kingdom of the Bunnymen is closed for the season."
msgstr "Vương quốc Người Thỏ đã đóng cửa theo mùa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITHOUSE.BURNT"
msgid "That's not a real roasted carrot."
msgstr "Đó không phải là cà rốt nướng thực sự đâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITHOUSE.GENERIC"
msgid "That's not a real carrot."
msgstr "Đó không phải là củ cà rốt thật."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITKINGHORN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITKINGHORN"
msgid "The rabbits dig music."
msgstr "Mấy con thỏ rất thích âm nhạc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITKINGHORN_CHEST
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITKINGHORN_CHEST"
msgid "I'll use it now and den."
msgstr "Tôi sẽ dùng nó thỉnh thoảng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITKINGMINION_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITKINGMINION_BUNNYMAN"
msgid "They're hoppin' mad!"
msgstr "Chúng đang giận sôi máu lên kìa!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITKINGSPEAR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITKINGSPEAR"
msgid "This will give a good thumpin'."
msgstr "Cái này sẽ tạo ra một cú đập trời giáng đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITKING_AGGRESSIVE"
msgid "It has a hare-trigger temper!"
msgstr "Nó có tính khí dễ nổi giận như loài thỏ!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITKING_LUCKY"
msgid "I should capture it for science!"
msgstr "Tôi nên bắt nó vì mục đích khoa học!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RABBITKING_PASSIVE"
msgid "All hail the bun-evolent one!"
msgstr "Hoan hô vị vua thỏ nhân từ!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RAINCOAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RAINCOAT"
msgid "Keeps the rain where it ought to be. Outside your body."
msgstr "Giữ nước ở nơi nó nên ở. Bên ngoài cơ thể bạn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RAINHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RAINHAT"
msgid "Messy hair... the terrible price of dryness."
msgstr "Tóc tai bù xù... cái giá đắt phải trả để giữ khô ráo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RAINOMETER.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RAINOMETER.BURNT"
msgid "The measuring parts went up in a cloud of smoke."
msgstr "Các bộ phận đo đạc đã bay biến thành một đám mây khói."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RAINOMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RAINOMETER.GENERIC"
msgid "It measures cloudiness."
msgstr "Nó đo độ che phủ của mây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RATATOUILLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RATATOUILLE"
msgid "An excellent source of fiber."
msgstr "Một nguồn chất xơ tuyệt vời."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RAZOR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RAZOR"
msgid "A sharpened rock tied to a stick. For hygiene!"
msgstr "Một hòn đá tảng được mài sắc buộc vào một cái que. Vì vệ sinh!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD"
msgid "Drat, I just got that song out of my head!"
msgstr "Khỉ thật, tôi vừa mới quên được giai điệu đó khỏi đầu xong!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD_BALATRO
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD_BALATRO"
msgid "Irresistible! It's like it touches my mind!"
msgstr "Không thể cưỡng lại được! Cứ như nó chạm đến tâm trí tôi vậy!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD_CREEPYFOREST
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD_CREEPYFOREST"
msgid "A whole song on one record? Technology has come so far."
msgstr "Cả một bài hát trong một chiếc đĩa hát á? Công nghệ đã tiến xa thật đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD_DANGER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD_DANGER"
msgid "Not my favorite."
msgstr "Không phải bài tủ của tôi lắm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD_DAWN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD_DAWN"
msgid "Needs more trumpet."
msgstr "Cần thêm tiếng kèn trumpet."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD_DRSTYLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD_DRSTYLE"
msgid "A whole song on one record? Technology has come so far."
msgstr "Cả một bài hát trong một chiếc đĩa hát á? Công nghệ đã tiến xa thật đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD_DUSK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD_DUSK"
msgid "Needs more trumpet."
msgstr "Cần thêm tiếng kèn trumpet."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD_EFS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD_EFS"
msgid "One of their more experimental tracks."
msgstr "Một trong những bản nhạc mang tính thử nghiệm của họ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD_END
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD_END"
msgid "A whole song on one record? Technology has come so far."
msgstr "Cả một bài hát trong một chiếc đĩa hát á? Công nghệ đã tiến xa thật đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD_HALLOWEDNIGHTS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD_HALLOWEDNIGHTS"
msgid "Spooktacular!"
msgstr "Đậm chất ma quái tuyệt đỉnh!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD_MAIN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD_MAIN"
msgid "Needs more trumpet."
msgstr "Cần thêm tiếng kèn trumpet."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD_WORKTOBEDONE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RECORD_WORKTOBEDONE"
msgid "One of their more experimental tracks."
msgstr "Một trong những bản nhạc mang tính thử nghiệm của họ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.REDGEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.REDGEM"
msgid "It sparkles with inner warmth."
msgstr "Nó tỏa sáng với sự ấm áp từ bên trong."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.REDLANTERN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.REDLANTERN"
msgid "This lantern feels more special than the others."
msgstr "Chiếc đèn lồng này có vẻ đặc biệt hơn mấy cái khác."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.REDMOONEYE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.REDMOONEYE"
msgid "It can see and be seen for miles!"
msgstr "Nó có thể nhìn và bị nhìn thấy từ cách xa hàng dặm!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.REDPOUCH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.REDPOUCH"
msgid "Is there something inside?"
msgstr "Có thứ gì bên trong không nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RED_CAP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RED_CAP"
msgid "It smells funny."
msgstr "Nó có mùi ngộ ngộ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RED_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RED_CAP_COOKED"
msgid "It's different now..."
msgstr "Bây giờ nó khác rồi..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RED_MUSHROOM.GENERIC"
msgid "It's a mushroom."
msgstr "Đó là một cây nấm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RED_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RED_MUSHROOM.INGROUND"
msgid "It's sleeping."
msgstr "Nó đang ngủ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RED_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RED_MUSHROOM.PICKED"
msgid "I wonder if it will come back?"
msgstr "Tự hỏi không biết nó có mọc lại không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.REEDS.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.REEDS.BURNING"
msgid "That's really burning!"
msgstr "Cháy dữ dội thật đấy!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.REEDS.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.REEDS.GENERIC"
msgid "It's a clump of reeds."
msgstr "Đó là một bụi cây sậy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.REEDS.PICKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.REEDS.PICKED"
msgid "All the useful reeds have already been picked."
msgstr "Tất cả những cây sậy hữu ích đã bị hái sạch rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.REFINED_DUST
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.REFINED_DUST"
msgid "Ah-CHOO!"
msgstr "Hắt-XÌ!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.REFLECTIVEVEST
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.REFLECTIVEVEST"
msgid "Keep off, evil sun!"
msgstr "Tránh xa ra, mặt trời độc ác!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RELIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RELIC"
msgid "Ancient household goods."
msgstr "Đồ gia dụng cổ xưa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESEARCHLAB.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESEARCHLAB.BURNT"
msgid "It won't be doing much science now."
msgstr "Bây giờ thì nó chẳng làm được mấy việc khoa học nữa đâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESEARCHLAB.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESEARCHLAB.GENERIC"
msgid "It breaks down objects into their scientific components."
msgstr "Nó phân tách các vật thể thành các thành phần khoa học của chúng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESEARCHLAB2.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESEARCHLAB2.BURNT"
msgid "The extra science didn't keep it alive."
msgstr "Mấy món khoa học phụ thêm cũng không cứu nổi nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESEARCHLAB2.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESEARCHLAB2.GENERIC"
msgid "It's even more science-y than the last one!"
msgstr "Nó còn mang tính khoa học hơn cả cái trước nữa!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESEARCHLAB3.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESEARCHLAB3.BURNT"
msgid "Whatever it was, it's burnt now."
msgstr "Dù nó là gì đi nữa, giờ thì cháy trụi rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESEARCHLAB3.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESEARCHLAB3.GENERIC"
msgid "What have I created?"
msgstr "Tôi đã tạo ra cái quái gì thế này?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESEARCHLAB4.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESEARCHLAB4.BURNT"
msgid "Fire doesn't really solve naming issues..."
msgstr "Lửa thực sự không giải quyết được vấn đề đặt tên đâu..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESEARCHLAB4.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESEARCHLAB4.GENERIC"
msgid "Who would name something that?"
msgstr "Ai lại đặt tên cho một thứ như thế cơ chứ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESKIN_TOOL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESKIN_TOOL"
msgid "I like the dust! It feels scholarly!"
msgstr "Tôi thích lớp bụi này! Nghe rất ra dáng học giả!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESURRECTIONSTATUE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESURRECTIONSTATUE.BURNT"
msgid "Not much use anymore."
msgstr "Không còn hữu dụng lắm nữa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESURRECTIONSTATUE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESURRECTIONSTATUE.GENERIC"
msgid "What a handsome devil!"
msgstr "Đúng là một gã khôi ngô!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESURRECTIONSTONE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RESURRECTIONSTONE"
msgid "It's always a good idea to touch base."
msgstr "Ghé thăm nơi này luôn là một ý kiến hay."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.REVIVER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.REVIVER"
msgid "The beating of this hideous heart will bring a ghost back to life!"
msgstr "Tiếng đập của trái tim gớm ghiếc này sẽ hồi sinh một hồn ma trở lại!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RHINODRILL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RHINODRILL"
msgid "He's got a nose for this kind of work."
msgstr "Hắn có chiếc mũi rất thính với loại công việc này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROASTTURKEY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROASTTURKEY"
msgid "I see a big juicy drumstick with my name on it."
msgstr "Tôi thấy một chiếc đùi gà mọng nước to bự đang gọi tên mình kìa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROBIN.GENERIC"
msgid "Does that mean winter is gone?"
msgstr "Điều đó có nghĩa là mùa đông đã qua rồi sao?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROBIN.HELD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROBIN.HELD"
msgid "He likes my pocket."
msgstr "Nó thích túi áo của tôi kìa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROBIN_WINTER.GENERIC"
msgid "Life in the frozen wastes."
msgstr "Sự sống trong vùng đất hoang giá lạnh."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROBIN_WINTER.HELD"
msgid "It's so soft."
msgstr "Nó mềm quá đi mất."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROBOT_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROBOT_BLUEPRINT"
msgid "This requires a suspicious amount of welding for a sewing project."
msgstr "Cái này đòi hỏi lượng mối hàn đáng ngờ cho một dự án may vá."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROBOT_PUPPET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROBOT_PUPPET"
msgid "They're trapped!"
msgstr "Bọn chúng bị kẹt rồi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK"
msgid "It wouldn't fit in my pocket."
msgstr "Nó không nhét vừa túi tôi đâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCKS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCKS"
msgid "We could make stuff with these."
msgstr "Chúng ta có thể chế tạo đồ đạc từ những thứ này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCKY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCKY"
msgid "It has terrifying claws."
msgstr "Nó có những chiếc vuốt thật đáng sợ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN"
msgid "Its fruit growing days are over."
msgstr "Thời kỳ ra quả của nó đã chấm dứt rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING"
msgid "It's burning!"
msgstr "Nó đang cháy kìa!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED"
msgid "It looks pretty sick."
msgstr "Trông nó khá là ốm yếu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING"
msgid "Err, something's not right."
msgstr "Hừm, có gì đó không ổn lắm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC"
msgid "It's a bush... from the moon!"
msgstr "Đó là một bụi cây... đến từ mặt trăng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED"
msgid "It'll take awhile to grow more fruit."
msgstr "Sẽ mất một thời gian để nó mọc thêm quả."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED"
msgid "It's pretty hot out."
msgstr "Ngoài này nóng phết đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_FRUIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_FRUIT"
msgid "I'd shatter my teeth on that."
msgstr "Tôi mà cắn vào đó chắc mẻ răng mất."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE"
msgid "Uncooked stone fruit is the pits."
msgstr "Trái cây đá chưa nấu thì dở tệ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED"
msgid "It's actually soft enough to eat now."
msgstr "Thực ra bây giờ nó đã đủ mềm để ăn rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT"
msgid "It's growing."
msgstr "Nó đang lớn lên kìa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_ICE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_ICE.GENERIC"
msgid "Ice to meet you."
msgstr "Rất vui được gặp bạn (Băng đá / Gai Băng)."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_ICE.MELTED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_ICE.MELTED"
msgid "Won't be useful until it freezes again."
msgstr "Sẽ chẳng có ích gì cho đến khi nó đóng băng trở lại."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_ICE_MELTED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_ICE_MELTED"
msgid "Won't be useful until it freezes again."
msgstr "Sẽ chẳng có ích gì cho đến khi nó đóng băng trở lại."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_LIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_LIGHT.GENERIC"
msgid "A crusted over lava pit."
msgstr "Một hố nham thạch đã đóng vảy bên trên."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_LIGHT.LOW
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_LIGHT.LOW"
msgid "The lava's crusting over."
msgstr "Lớp vỏ dung nham đang đóng cục lại kìa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_LIGHT.NORMAL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_LIGHT.NORMAL"
msgid "Nice and comfy."
msgstr "Thật ấm cúng và thoải mái."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_LIGHT.OUT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_LIGHT.OUT"
msgid "Looks fragile."
msgstr "Trông có vẻ dễ vỡ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_MOON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_MOON"
msgid "That rock came from the moon."
msgstr "Hòn đá tảng đó đến từ mặt trăng đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_PETRIFIED_TREE"
msgid "It looks scared stiff."
msgstr "Trông nó cứng đờ vì sợ hãi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_PETRIFIED_TREE_OLD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_PETRIFIED_TREE_OLD"
msgid "It looks scared stiff."
msgstr "Trông nó cứng đờ vì sợ hãi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROOK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROOK"
msgid "Storm the castle!"
msgstr "Tấn công lâu đài nào!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROOK_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROOK_NIGHTMARE"
msgid "Terrifying!"
msgstr "Thật đáng sợ!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROPE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROPE"
msgid "Some short lengths of rope."
msgstr "Vài đoạn dây thừng ngắn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROPE_BRIDGE_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROPE_BRIDGE_KIT"
msgid "This will keep us in suspense!"
msgstr "Cái này sẽ khiến chúng ta đứng ngồi không yên đây!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROSEGLASSESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROSEGLASSESHAT.GENERIC"
msgid "They don't seem like Winona's usual style."
msgstr "Chúng có vẻ không giống phong cách thường ngày của Winona lắm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROTTENEGG.CAN_PROCESS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROTTENEGG.CAN_PROCESS"
msgid "only_used_by_wx78"
msgstr "chỉ_được_sử_dụng_bởi_wx78"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROTTENEGG.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROTTENEGG.GENERIC"
msgid "Ew! It stinks!"
msgstr "Eo ôi! Thối quá!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROYAL_JELLY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROYAL_JELLY"
msgid "It infuses the eater with the power of science!"
msgstr "Nó truyền sức mạnh khoa học cho người ăn!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RUBBLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RUBBLE"
msgid "Just bits and pieces of rock."
msgstr "Chỉ là dăm ba mảnh đá tảng vụn thôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RUINSHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RUINSHAT"
msgid "How's my hair?"
msgstr "Tóc tai tôi thế nào rồi?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RUINS_BAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RUINS_BAT"
msgid "It has quite a heft to it."
msgstr "Nó khá là đầm tay đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.RUINS_RUBBLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.RUINS_RUBBLE"
msgid "This can be fixed."
msgstr "Cái này sửa lại được đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SACRED_CHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SACRED_CHEST.GENERIC"
msgid "I hear whispers. It wants something."
msgstr "Tôi nghe thấy tiếng thì thầm. Nó muốn thứ gì đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SACRED_CHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SACRED_CHEST.LOCKED"
msgid "It's passing its judgment."
msgstr "Nó đang phán xét kìa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SADDLEHORN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SADDLEHORN"
msgid "This could take a saddle off."
msgstr "Cái này có thể tháo yên cưỡi ra đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SADDLE_BASIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SADDLE_BASIC"
msgid "That'll allow the mounting of some smelly animal."
msgstr "Cái đó sẽ cho phép cưỡi lên con thú hôi thối nào đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SADDLE_RACE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SADDLE_RACE"
msgid "This saddle really flies!"
msgstr "Chiếc yên cưỡi này bay cực nhanh luôn!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SADDLE_SHADOW
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SADDLE_SHADOW"
msgid "It reminds me of something. Ugh."
msgstr "Nó làm tôi nhớ đến cái gì đó. Phí công thật."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SADDLE_WAR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SADDLE_WAR"
msgid "The only problem is the saddle sores."
msgstr "Vấn đề duy nhất là những vết loét do yên cưỡi gây ra."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SADDLE_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SADDLE_WATHGRITHR"
msgid "Wigfrid made that? Looks like she winged it."
msgstr "Wigfrid làm cái đó á? Trông có vẻ cô ấy làm bừa thì có."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SALSA
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SALSA"
msgid "So... hot...!"
msgstr "Cay... quá...!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SALTBOX
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SALTBOX"
msgid "Just the cure for spoiling food!"
msgstr "Đúng là khắc tinh của đồ ăn thiu!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SALTLICK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SALTLICK"
msgid "How many licks does it take to get to the center?"
msgstr "Phải liếm bao nhiêu lần mới đến được lõi nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SALTLICK_IMPROVED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SALTLICK_IMPROVED"
msgid "Just looking at it makes me thirsty."
msgstr "Chỉ nhìn thôi cũng thấy khát khô cả cổ rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SALTROCK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SALTROCK"
msgid "Science compels me to lick it."
msgstr "Khoa học bắt buộc tôi phải liếm nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SALTSTACK.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SALTSTACK.GENERIC"
msgid "Are those natural formations?"
msgstr "Đó là những kiến tạo tự nhiên à?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SALTSTACK.GROWING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SALTSTACK.GROWING"
msgid "I guess it just grows like that."
msgstr "Chắc nó cứ mọc thế thôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SALTSTACK.MINED_OUT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SALTSTACK.MINED_OUT"
msgid "It's mined... it's all mined!"
msgstr "Đã khai thác... sạch sẽ không còn gì!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SALTY_DOG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SALTY_DOG"
msgid "Who's a proud little seal pup?"
msgstr "Ai mà là bé cún hải cẩu kiêu hãnh thế này nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SALTY_DOGHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SALTY_DOGHAT"
msgid "It only comes with a friend-ship."
msgstr "Nó chỉ đi kèm với một tình bạn tàu bè thôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SANDBLOCK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SANDBLOCK"
msgid "It's so gritty!"
msgstr "Nhiều cát sạn quá đi mất!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SANDSPIKE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SANDSPIKE"
msgid "I could've been skewered!"
msgstr "Suýt chút nữa là tôi bị xiên rồi đấy!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SANITYROCK.ACTIVE"
msgid "That's a CRAZY looking rock!"
msgstr "Đó là một hòn đá tảng trông ĐIÊN RỒ quá!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SANITYROCK.INACTIVE"
msgid "Where did the rest of it go?"
msgstr "Phần còn lại đâu mất tiêu rồi?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SAPLING.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SAPLING.BURNING"
msgid "That's burning fast!"
msgstr "Cháy nhanh thật đấy!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SAPLING.DISEASED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SAPLING.DISEASED"
msgid "It looks pretty sick."
msgstr "Trông nó khá là ốm yếu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SAPLING.DISEASING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SAPLING.DISEASING"
msgid "Err, something's not right."
msgstr "Hừm, có gì đó không ổn lắm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SAPLING.GENERIC"
msgid "Baby trees are so cute!"
msgstr "Mấy cây con trông cưng ghê!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SAPLING.PICKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SAPLING.PICKED"
msgid "That'll teach him."
msgstr "Cho mày chừa nhé."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SAPLING.WITHERED"
msgid "It might be okay if it cooled down."
msgstr "Chắc sẽ ổn thôi nếu trời nguội bớt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCANDATA
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCANDATA"
msgid "Smells like fresh research."
msgstr "Ngửi có mùi nghiên cứu mới tinh."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCARECROW.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCARECROW.BURNING"
msgid "Someone made that strawman eat crow."
msgstr "Ai đó đã khiến gã bù nhìn rơm này phải ngậm đắng nuốt cay."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCARECROW.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCARECROW.BURNT"
msgid "Someone MURDERed that scarecrow!"
msgstr "Ai đó đã SÁT HẠI con bù nhìn đó rồi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCARECROW.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCARECROW.GENERIC"
msgid "All dressed up and no where to crow."
msgstr "Ăn mặc lồng lộn mà chẳng có chỗ nào để gáy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCORCHED_SKELETON"
msgid "Spooky."
msgstr "Ma quái thật đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCRAPBOOK_PAGE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCRAPBOOK_PAGE"
msgid "Someone else out there likes to scrapbook."
msgstr "Lại có người thích làm sổ lưu niệm giống mình kìa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCRAPHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCRAPHAT"
msgid "The tip of that hat is almost as sharp as... my mind!"
msgstr "Đỉnh cái mũ này nhọn gần bằng... bộ óc của tôi đấy!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCRAP_MONOCLEHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCRAP_MONOCLEHAT"
msgid "Does it make me look more distinguished?"
msgstr "Nó có làm mình trông lịch lãm hơn không nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTINGTABLE.BLOCK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTINGTABLE.BLOCK"
msgid "Ready for sculpting."
msgstr "Sẵn sàng để điêu khắc rồi đây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "Burnt right down."
msgstr "Cháy rụi hoàn toàn rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTINGTABLE.EMPTY"
msgid "We can make stone sculptures with this."
msgstr "Chúng ta có thể làm tượng đá bằng cái này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTINGTABLE.SCULPTURE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTINGTABLE.SCULPTURE"
msgid "A masterpiece!"
msgstr "Một kiệt tác!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED"
msgid "It looks old, but it feels new."
msgstr "Trông thì cũ, nhưng cảm giác lại mới."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED"
msgid "Now what?"
msgstr "Giờ thì sao nữa?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
msgid "Something's moving inside."
msgstr "Có cái gì đó đang chuyển động bên trong."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED"
msgid "There's a big piece missing."
msgstr "Thiếu một mảnh lớn rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_BISHOPHEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_BISHOPHEAD"
msgid "Is that a head?"
msgstr "Đó là một cái đầu à?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED"
msgid "It's an odd marble statue."
msgstr "Đó là một bức tượng đá cẩm thạch kỳ lạ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED"
msgid "At least it's back in one piece now."
msgstr "Ít ra thì giờ nó cũng lành lặn trở lại rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_KNIGHTBODY.READY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_KNIGHTBODY.READY"
msgid "Something's moving inside."
msgstr "Có cái gì đó đang chuyển động bên trong."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED"
msgid "I guess he cracked under the pressure."
msgstr "Chắc hắn ta đã chịu áp lực đến mức phát điên rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_KNIGHTHEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_KNIGHTHEAD"
msgid "Where's the rest of it?"
msgstr "Phần còn lại đâu mất rồi?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_ROOKBODY.COVERED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_ROOKBODY.COVERED"
msgid "It's some sort of marble statue."
msgstr "Đó là một loại tượng đá cẩm thạch nào đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED"
msgid "All patched up."
msgstr "Đã vá víu xong xuôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_ROOKBODY.READY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_ROOKBODY.READY"
msgid "Something's moving inside."
msgstr "Có cái gì đó đang chuyển động bên trong."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED"
msgid "It's not in the best shape."
msgstr "Trông không được đẹp mã cho lắm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_ROOKNOSE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_ROOKNOSE"
msgid "Where did this come from?"
msgstr "Cái này ở đâu ra thế nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEAFARING_PROTOTYPER.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEAFARING_PROTOTYPER.BURNT"
msgid "The science has been lost to sea."
msgstr "Kiến thức khoa học đã bị nhấn chìm ngoài biển sâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC"
msgid "I think tanks are in order."
msgstr "Tôi nghĩ là cần phải chuẩn bị bồn chứa rồi đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEAFOODGUMBO
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEAFOODGUMBO"
msgid "It's a jumbo seafood gumbo."
msgstr "Đó là một món súp mướp tây hải sản cỡ lớn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEASTACK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEASTACK"
msgid "It's a rock."
msgstr "Đó là một hòn đá tảng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SECURITY_PULSE_CAGE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SECURITY_PULSE_CAGE"
msgid "Interesting. It's empty."
msgstr "Thú vị thật. Trống trơn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SECURITY_PULSE_CAGE_FULL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SECURITY_PULSE_CAGE_FULL"
msgid "Aren't you the cutest little ball of pure energy?"
msgstr "Mày có phải là khối năng lượng thuần túy đáng yêu nhất không cơ chứ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEEDPOUCH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEEDPOUCH"
msgid "I was getting tired of carrying loose seeds in my pockets."
msgstr "Tôi phát mệt vì phải nhét mấy hạt giống rời rạc vào túi quần rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEEDS"
msgid "Each one is a tiny mystery."
msgstr "Mỗi hạt đều là một ẩn số nhỏ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEEDS_COOKED"
msgid "That cooked the life right out of 'em!"
msgstr "Cách đó nấu bay cả sự sống trong tụi nó rồi còn gì!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SENTRYWARD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SENTRYWARD"
msgid "That's an entirely scientific mapping tool."
msgstr "Đó hoàn toàn là một công cụ lập bản đồ mang tính khoa học."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEWING_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEWING_KIT"
msgid "Darn it! Darn it all to heck!"
msgstr "Chết tiệt! Chết tiệt cái quái này!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEWING_MANNEQUIN.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEWING_MANNEQUIN.BURNT"
msgid "All burnt up and nowhere to go."
msgstr "Cháy rụi hết rồi và chẳng biết đi về đâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEWING_MANNEQUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEWING_MANNEQUIN.GENERIC"
msgid "All dressed up and nowhere to go."
msgstr "Ăn mặc lồng lộn mà chẳng biết đi về đâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEWING_TAPE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SEWING_TAPE"
msgid "Good for mending."
msgstr "Rất tốt để vá víu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWDANCER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWDANCER"
msgid "Some things you can never unsee..."
msgstr "Có những thứ bạn ước gì mình chưa từng thấy..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWDIGGER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWDIGGER"
msgid "Oh good. Now there's more of him."
msgstr "Ồ hay quá. Giờ lại có thêm một bản sao của hắn ta nữa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWHEART
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWHEART"
msgid "The power of science must have reanimated it..."
msgstr "Sức mạnh của khoa học chắc đã hồi sinh nó..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWRIFT_PORTAL"
msgid "That drop looks like it goes on forever."
msgstr "Cái vực thẳm đó trông như kéo dài mãi mãi ấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY"
msgid "Dreadful!"
msgstr "Kinh hoàng thật!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED"
msgid "Bottoms up!"
msgstr "Trồng cây chuối à!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD"
msgid "Heads or heads?"
msgstr "Mặt hay là đầu đây?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWTHRALL_HANDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWTHRALL_HANDS"
msgid "Hands off!"
msgstr "Bỏ tay ra mau!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWTHRALL_HORNS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWTHRALL_HORNS"
msgid "It looks hungry for a fight."
msgstr "Trông nó rất khát khao một trận chiến."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWTHRALL_MOUTH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWTHRALL_MOUTH"
msgid "It's a mouthy one."
msgstr "Lắm điều phết đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWTHRALL_PARASITE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWTHRALL_PARASITE"
msgid "It makes my brain itch."
msgstr "Nó làm đầu óc tôi ngứa ngáy khó chịu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWTHRALL_WINGS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOWTHRALL_WINGS"
msgid "The wings seem to be just for show."
msgstr "Đôi cánh có vẻ chỉ để làm cảnh thôi thì phải."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOW_BATTLEAXE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOW_BATTLEAXE"
msgid "Yikes! I'd rather bury this hatchet."
msgstr "Ái chà! Thôi tôi thà làm hòa còn hơn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOW_BEEF_BELL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOW_BEEF_BELL"
msgid "It's a dead ringer for my old beefalo bell."
msgstr "Nó y hệt như cái chuông bò lai cũ của tôi vậy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOW_FORGE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOW_FORGE"
msgid "What dark designs will it bring to life?"
msgstr "Nó sẽ mang lại những thiết kế hắc ám nào cho cuộc sống đây?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOW_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOW_FORGE_KIT"
msgid "It would be unscientific of me not to at least do some experiments."
msgstr "Sẽ thật phi khoa học nếu tôi không thử tiến hành vài thí nghiệm đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOW_HEART_VEIN"
msgid "A vein attempt to be useful."
msgstr "Một nỗ lực vô vọng nhưng đầy tính cố gắng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHALLOW_GRAVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHALLOW_GRAVE"
msgid "Better you than me."
msgstr "Cầu cho cậu chứ không phải tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHARK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHARK"
msgid "We may need a bigger boat..."
msgstr "Chúng ta có lẽ cần một chiếc thuyền ván to hơn đấy..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHARKBOI
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHARKBOI"
msgid "Shiver me timbers!"
msgstr "Ối giời ôi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHELLWEAVER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHELLWEAVER"
msgid "I salt to make something useful."
msgstr "Tôi bỏ muối vào để tạo ra thứ gì đó hữu ích."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHELL_CLUSTER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHELL_CLUSTER"
msgid "I bet there's some nice shells in there."
msgstr "Cược là trong đó có mấy cái vỏ sò đẹp phết đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHIELDOFTERROR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHIELDOFTERROR"
msgid "The best defense is a good mawfence."
msgstr "Phòng thủ tốt nhất là một hàm răng vĩ đại."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHOVEL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHOVEL"
msgid "There's a lot going on underground."
msgstr "Dưới lòng đất có rất nhiều thứ đang diễn ra đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHOVEL_LUNARPLANT
