msgstr "Nó cần các thành phần để làm cho khoa học hoạt động."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_OVEN_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_OVEN_ITEM"
msgid "For scientifically burning things."
msgstr "Đối với những thứ đốt cháy một cách khoa học."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PARKSPIKE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PARKSPIKE"
msgid "The scientific term is: \"Sharp pointy thing\"."
msgstr "Thuật ngữ khoa học là: “Vật sắc nhọn”."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PARK_ANGEL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PARK_ANGEL"
msgid "Take that, creature!"
msgstr "Hãy nhận lấy, sinh vật kia!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PARK_ANGEL2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PARK_ANGEL2"
msgid "So lifelike."
msgstr "Vì vậy, sống động như thật."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN"
