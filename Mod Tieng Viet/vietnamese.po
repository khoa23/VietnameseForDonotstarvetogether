#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM"
