msgstr "Tôi muốn nướng nó!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.HELD"
