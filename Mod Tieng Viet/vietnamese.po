msgstr "Lửa làm mọi thứ tốt hơn. Ừm!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKPOT.EMPTY"
