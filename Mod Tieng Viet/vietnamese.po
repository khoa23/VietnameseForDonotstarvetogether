msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_MACHINEPARTS_2"
msgid "only_used_by_winona"
msgstr "chỉ_dùng_bởi_winona"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_RECIPESCANNER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_RECIPESCANNER"
