msgstr "Tôi không thể nào hiểu nổi cái đó..."

#. STRINGS.CHARACTERS.WANDA.ACTIONFAIL.TEACH.KNOWN
msgctxt "STRINGS.CHARACTERS.WANDA.ACTIONFAIL.TEACH.KNOWN"
