msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.SLINGSHOTAMMO_SLOW"
msgid "Tampering with the timestream, are we? Good lad."
msgstr "Lại đang can thiệp vào dòng thời gian hả? Cậu bé ngoan."

