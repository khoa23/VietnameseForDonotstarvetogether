msgstr "Nếu ông ta hoặc công ty của ông ta đốn thêm một cái cây nữa,"

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.WEREBEAVER_STORY.lines.8.duration
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.WEREBEAVER_STORY.lines.8.duration"
