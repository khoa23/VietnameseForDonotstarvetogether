#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "Will keep boat safe."
msgstr "Sẽ giữ cho thuyền ván an toàn."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "Is ready for firing!"
msgstr "Đã sẵn sàng khai hỏa!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "Cannon is empty, but still very scary looking!"
msgstr "Đại Bác trống không, nhưng trông vẫn rất đáng sợ!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "Ah. Wolfgang forgot cannonballs."
msgstr "À. Wolfgang quên đạn đại bác rồi."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BOAT_CANNON_KIT"
