msgstr "Ôi, xong rồi à?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY"
