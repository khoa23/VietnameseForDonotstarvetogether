msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NATURE_BLUEPRINT"
msgid "Flowers would be good against cow smell."
msgstr "Hoa sẽ khử mùi bò rất tốt."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTCAPHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTCAPHAT"
msgid "Is cozy sleeping hat."
msgstr "Là chiếc mũ ngủ ấm cúng."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTLIGHT"
msgid "Is strange glow."
msgstr "Là lạ phát sáng."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMAREFUEL"
msgid "Scary stuff."
msgstr "Thứ đáng sợ."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMAREGROWTH
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMAREGROWTH"
