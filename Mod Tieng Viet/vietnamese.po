msgstr "Không có ai ở đây cả."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2"
msgid "Something destroyed this town."
msgstr "Thứ gì đó đã phá hủy thị trấn này."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3"
msgid "I wonder who they angered."
msgstr "Tự hỏi bọn họ đã chọc giận ai cơ chứ."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR"
msgid "No longer a-door-able."
msgstr "Không còn đáng yêu... à nhầm, đáng làm cửa nữa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_RUBBLE_ROOF
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_RUBBLE_ROOF"
msgid "Someone hit the roof."
msgstr "Ai đó đã đánh lên tận mái nhà."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SAFE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SAFE.GENERIC"
msgid "It's a safe. For keeping things safe."
msgstr "Đó là một cái két sắt. Để cất giữ mọi thứ an toàn."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SAFE.LOCKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SAFE.LOCKED"
msgid "It won't open without the key."
msgstr "Nó sẽ không mở ra nếu không có chìa khóa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SALMON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SALMON"
msgid "Mm, fresh fish."
msgstr "Mm, cá tươi kìa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SALMON_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SALMON_COOKED"
msgid "Ready for the dinner table."
msgstr "Đã sẵn sàng lên bàn ăn rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SALT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SALT"
msgid "It's full of salt."
msgstr "Toàn là muối không đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SALTROCK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SALTROCK"
msgid "Salt. The tastiest mineral."
msgstr "Muối. Khoáng chất ngon nhất."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC"
msgid "Science takes time."
msgstr "Khoa học cần phải có thời gian."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SALT_RACK.READY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SALT_RACK.READY"
msgid "Salt has gathered on the rope."
msgstr "Muối đã bám đầy trên dây thừng rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
msgid "For harvesting salt from the pond."
msgstr "Dùng để thu hoạch muối từ cái ao."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SAP"
msgid "It tastes sweet."
msgstr "Nó có vị ngọt."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SAPBUCKET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SAPBUCKET"
msgid "We can use it to gather sap from the trees."
msgstr "Chúng ta có thể dùng nó để lấy nhựa cây từ các thân cây."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SAPLING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SAPLING"
msgid "I can't get anything else out of that."
msgstr "Mình không thể lấy thêm gì từ cái đó nữa rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SAP_SPOILED"
msgid "Might as well toss it on the fire."
msgstr "Thôi cứ némừm lửa cho rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SEEDPACKET"
msgid "Sow what?"
msgstr "Gieo cái gì cơ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL"
msgid "Laboratory tools for surgical butchery."
msgstr "Dụng cụ phòng thí nghiệm dùng để mổ xẻ phẫu thuật."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND"
msgid "Flavorful."
msgstr "Đậm đà hương vị đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC"
msgid "It reminds me of those tentacle monsters."
msgstr "Nó làm mình nhớ đến lũ quái vật xúc tu đó."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED"
msgid "I can't get anymore out of that shrub."
msgstr "Mình không thể lấy thêm gì từ bụi cây này nữa rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG"
msgid "I could grind it up to make a spice."
msgstr "Mình có thể nghiền nó ra để làm gia vị."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC"
msgid "It's full of delicious, delicious sap."
msgstr "Nó tràn ngập nhựa cây ngon tuyệt hảo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP"
msgid "Where'd the tree go? I'm stumped."
msgstr "Cái cây đi đâu mất tiêu rồi nhỉ? Bí mất rồi đây."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS"
msgid "That's how you get ants."
msgstr "Đó là cách cậu thu hút kiến đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY"
msgid "Here sappy, sappy, sap."
msgstr "Ra đây nào, nhựa cây ơi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY"
msgid "Sweet golden sap."
msgstr "Nhựa cây vàng óng ngọt ngào."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED"
msgid "It looks ill."
msgstr "Trông nó có vẻ ốm yếu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SWAMPIG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SWAMPIG"
msgid "It's a super hairy pig."
msgstr "Đó là một con lợn siêu nhiều lông."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
msgid "I guess you're in charge around here?"
msgstr "Chắc ngài là người nắm quyền ở quanh đây à?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
msgid "It's sleeping, for now."
msgstr "Nó đang ngủ, tạm thời là vậy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE"
msgid "It's seen better days."
msgstr "Nó đã qua thời hoàng kim rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
msgid "Some pig's house was ruined."
msgstr "Nhà của con lợn nào đó đã bị tàn phá rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SYRUP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_SYRUP"
msgid "Adds sweetness to the mixture."
msgstr "Thêm vị ngọt cho hỗn hợp."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_TOMATO
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_TOMATO"
msgid "It's red because it's full of science."
msgstr "Nó có màu đỏ vì chứa đầy khoa học trong đó."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
msgid "Cooking's easy if you understand chemistry."
msgstr "Nấu ăn rất dễ nếu bạn hiểu về hóa học."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_TOMATO_SEEDS"
msgid "A handful of odd seeds."
msgstr "Một nắm hạt kỳ lạ."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_TRADER_MERM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_TRADER_MERM"
msgid "Maybe they'd be willing to trade."
msgstr "Biết đâu chúng lại sẵn lòng trao đổi nhỉ."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_TRADER_MERM2"
msgid "Maybe they'd be willing to trade."
msgstr "Biết đâu chúng lại sẵn lòng trao đổi nhỉ."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_TURNIP"
msgid "It's a raw turnip."
msgstr "Đó là một củ củ cải tím sống."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
msgid "Cooking is science in practice."
msgstr "Nấu ăn là khoa học trong thực tiễn."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "A handful of odd seeds."
msgstr "Một nắm hạt kỳ lạ."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_WHEAT"
msgid "It looks a bit grainy."
msgstr "Trông có vẻ hơi sần sùi hạt."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_WHEAT_SEEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_WHEAT_SEEDS"
msgid "A handful of odd seeds."
msgstr "Một nắm hạt kỳ lạ."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBIT.GENERIC"
msgid "A real jackalope! Come here little guy!"
msgstr "Một con thỏ sừng thực thụ kìa! Lại đây nào bé con!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBIT.HELD"
msgid "Look, the antlers aren't held on with paste or anything!"
msgstr "Nhìn kìa, cặp sừng không hề được dán keo hay gì đâu nhé!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITHAT"
msgid "Whoever wears that is a real hare-brain! Oh, Walter!"
msgstr "Đứa nào đội cái đó chắc chắn là kẻ đầu đất rồi! Ồ, Walter!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITHOLE.GENERIC"
msgid "We found its den!"
msgstr "Chúng ta tìm thấy hang của nó rồi!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITHOLE.SPRING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITHOLE.SPRING"
msgid "Looks like a cave-in."
msgstr "Trông giống như một vụ sập hang."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITHOUSE.BURNT"
msgid "That's what happens when you're irresponsible with fire."
msgstr "Đó là hậu quả của việc bất cẩn với lửa đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITHOUSE.GENERIC"
msgid "Do they ever dream of eating carrots and wake up with their house missing?"
msgstr "Liệu chúng có bao giờ mơ thấy ăn cà rốt rồi tỉnh dậy thấy nhà mình biến mất không nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITKINGHORN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITKINGHORN"
msgid "I can't carrot a tune! Heh. Nice, Walter."
msgstr "Mình không thể thổi nổi một nốt nhạc! Heh. Hay đấy, Walter."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITKINGHORN_CHEST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITKINGHORN_CHEST"
msgid "Woby, now you don't have to carry everything!"
msgstr "Woby ơi, giờ cậu không phải mang vác mọi thứ một mình nữa rồi!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITKINGMINION_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITKINGMINION_BUNNYMAN"
msgid "Who's a cranky pants?"
msgstr "Ai mà đang cáu kỉnh thế nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITKINGSPEAR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITKINGSPEAR"
msgid "The most striking part of the rabbit. Heh."
msgstr "Phần ấn tượng nhất của con thỏ. Heh."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITKING_AGGRESSIVE"
msgid "Someone's in a bad mood!"
msgstr "Ai đó đang có tâm trạng tồi tệ kìa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITKING_LUCKY"
msgid "Let's catch it, Woby!"
msgstr "Bắt lấy nó đi, Woby!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RABBITKING_PASSIVE"
msgid "It looks friendly!"
msgstr "Trông nó có vẻ thân thiện!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RAINCOAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RAINCOAT"
msgid "Gotta be prepared for the elements!"
msgstr "Phải luôn sẵn sàng ứng phó với thời tiết chứ!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RAINHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RAINHAT"
msgid "I wonder if I could make one for Woby too."
msgstr "Tự hỏi mình có làm được một cái cho Woby không nhỉ."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RAINOMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RAINOMETER.BURNT"
msgid "It wasn't really that useful anyway."
msgstr "Dù sao thì nó cũng chẳng hữu ích cho lắm."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RAINOMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RAINOMETER.GENERIC"
msgid "A Pinetree Pioneer can smell rain coming a mile away."
msgstr "Một Hướng đạo sinh Cây Thông có thể đánh hơi thấy mùi mưa từ cách xa cả dặm."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RATATOUILLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RATATOUILLE"
msgid "Apparently there's no actual rats in it."
msgstr "Hóa ra trong đó không hề có con chuột nào thật cả."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RAZOR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RAZOR"
msgid "I found a whisker on my chin, I'm sure my beard will come in any day now."
msgstr "Mình vừa tìm thấy một sợi râu trên cằm, chắc vài bữa nữa râu mình sẽ mọc đầy mặt thôi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD"
msgid "I could listen to this forever!"
msgstr "Mình có thể nghe cái này suốt đời luôn!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD_BALATRO
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD_BALATRO"
msgid "That's right, Woby! It's a real doozy!"
msgstr "Đúng thế đấy, Woby! Đỉnh của chóp luôn!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD_CREEPYFOREST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD_CREEPYFOREST"
msgid "It's no Midnight Broadcast, but it's still pretty good."
msgstr "Tuy không bằng Chương trình Phát thanh Đêm khuya, nhưng cũng khá ổn đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD_DANGER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD_DANGER"
msgid "Woby likes to howl along, don't you girl?"
msgstr "Woby thích hú theo lắm đúng không cô gái?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD_DAWN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD_DAWN"
msgid "It's no Midnight Broadcast, but it's still pretty good."
msgstr "Tuy không bằng Chương trình Phát thanh Đêm khuya, nhưng cũng khá ổn đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD_DRSTYLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD_DRSTYLE"
msgid "Woby likes to howl along, don't you girl?"
msgstr "Woby thích hú theo lắm đúng không cô gái?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD_DUSK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD_DUSK"
msgid "Woby likes to howl along, don't you girl?"
msgstr "Woby thích hú theo lắm đúng không cô gái?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD_EFS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD_EFS"
msgid "It's no Midnight Broadcast, but it's still pretty good."
msgstr "Tuy không bằng Chương trình Phát thanh Đêm khuya, nhưng cũng khá ổn đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD_END
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD_END"
msgid "Oh, that's a good one!"
msgstr "Ồ, bài này hay đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD_HALLOWEDNIGHTS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD_HALLOWEDNIGHTS"
msgid "Instant classic!"
msgstr "Kinh điển tức thì!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD_MAIN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD_MAIN"
msgid "Woby likes to howl along, don't you girl?"
msgstr "Woby thích hú theo lắm đúng không cô gái?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD_WORKTOBEDONE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RECORD_WORKTOBEDONE"
msgid "It's no Midnight Broadcast, but it's still pretty good."
msgstr "Tuy không bằng Chương trình Phát thanh Đêm khuya, nhưng cũng khá ổn đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.REDGEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.REDGEM"
msgid "I think this gem might be magic."
msgstr "Mình nghĩ viên ngọc này có phép thuật đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.REDLANTERN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.REDLANTERN"
msgid "I like this dramatic lighting!"
msgstr "Mình thích hiệu ứng ánh sáng đầy kịch tính này!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.REDMOONEYE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.REDMOONEYE"
msgid "This eye looks bloodshot!"
msgstr "Con mắt này trông đỏ ngầu như máu!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.REDPOUCH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.REDPOUCH"
msgid "It's jingling."
msgstr "Nó đang kêu lủng lẳng kìa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RED_CAP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RED_CAP"
msgid "That definitely looks poisonous."
msgstr "Nhìn cái đó là biết có độc rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RED_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RED_CAP_COOKED"
msgid "Did cooking it make it less poisonous?"
msgstr "Nấu lên rồi thì nó có bớt độc đi không nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RED_MUSHROOM.GENERIC"
msgid "Probably shouldn't pick that one."
msgstr "Chắc là không nên hái cái đó đâu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RED_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RED_MUSHROOM.INGROUND"
msgid "There's a mushroom hiding down there."
msgstr "Có một cây nấm đang trốn ở dưới kìa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RED_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RED_MUSHROOM.PICKED"
msgid "Maybe it will grow back?"
msgstr "Liệu nó có mọc lại không nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.REEDS.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.REEDS.BURNING"
msgid "Uh oh, who wasn't practicing fire safety?"
msgstr "Ôi không, ai lại không tuân thủ quy tắc an toàn khi dùng lửa thế này?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.REEDS.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.REEDS.GENERIC"
msgid "A pretty normal thing to see in a swamp."
msgstr "Một cảnh tượng khá bình thường ở đầm lầy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.REEDS.PICKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.REEDS.PICKED"
msgid "Nothing left to gather here."
msgstr "Chẳng còn gì để thu hoạch ở đây nữa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.REFINED_DUST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.REFINED_DUST"
msgid "It took a long time to collect all that dust."
msgstr "Mất khối thời gian mới thu thập được ngần ấy bụi bẩn đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.REFLECTIVEVEST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.REFLECTIVEVEST"
msgid "Do I look as cool as I feel?"
msgstr "Trông mình có ngầu như cảm giác lúc này không nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RELIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RELIC"
msgid "It's even older than the knick-knacks at my grandpa's house."
msgstr "Nó còn cổ hơn cả mấy món đồ linh tinh ở nhà ông nội mình nữa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RESEARCHLAB.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RESEARCHLAB.BURNT"
msgid "Did that look like a campfire?!"
msgstr "Trông có giống lửa trại chút nào không hả?!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RESEARCHLAB.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RESEARCHLAB.GENERIC"
msgid "I never knew science was such an important part of survival."
msgstr "Mình chưa bao giờ biết khoa học lại đóng vai trò quan trọng trong việc sinh tồn đến thế."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RESEARCHLAB2.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RESEARCHLAB2.BURNT"
msgid "I wish things would stop catching fire."
msgstr "Ước gì mọi thứ đừng có bén lửa nữa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RESEARCHLAB2.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RESEARCHLAB2.GENERIC"
msgid "They never taught us about alchemy in school."
msgstr "Họ chưa từng dạy tụi mình về thuật giả kim ở trường."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RESEARCHLAB3.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RESEARCHLAB3.BURNT"
msgid "I guess the magic wasn't fireproof."
msgstr "Chắc phép thuật này không chống được lửa rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RESEARCHLAB3.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RESEARCHLAB3.GENERIC"
msgid "Is it really magic?"
msgstr "Nó có thực sự là phép thuật không thế?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RESEARCHLAB4.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RESEARCHLAB4.BURNT"
msgid "I guess that's one way of putting an end to the mystery."
msgstr "Chắc đó cũng là một cách để chấm dứt bí ẩn này."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RESEARCHLAB4.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RESEARCHLAB4.GENERIC"
msgid "I don't really understand how it's supposed to work."
msgstr "Mình thực sự không hiểu cái này hoạt động thế nào nữa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RESKIN_TOOL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RESKIN_TOOL"
msgid "It changes how things look, but they're still the same deep down."
msgstr "Nó thay đổi vẻ bề ngoài, nhưng bản chất bên trong thì vẫn thế."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RESURRECTIONSTATUE.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RESURRECTIONSTATUE.BURNT"
msgid "What a waste of supplies..."
msgstr "Phí phạm nguyên liệu quá..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RESURRECTIONSTATUE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RESURRECTIONSTATUE.GENERIC"
msgid "I thought bringing back the dead involved more levers and electricity."
msgstr "Mình cứ tưởng hồi sinh người chết phải cần nhiều cần gạt và điện giật hơn cơ."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RESURRECTIONSTONE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RESURRECTIONSTONE"
msgid "It must've been used by an ancient civilization!"
msgstr "Chắc chắn nó đã được sử dụng bởi một nền văn minh cổ đại!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.REVIVER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.REVIVER"
msgid "Did you ever hear the story about the beating heart hidden under the floorboards?"
msgstr "Cậu đã bao giờ nghe câu chuyện về trái tim đang đập được giấu dưới ván sàn chưa?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RHINODRILL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RHINODRILL"
msgid "He's got a nose for this kind of work."
msgstr "Cậu ta có chiếc mũi rất thính cho kiểu công việc này đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROASTTURKEY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROASTTURKEY"
msgid "Woby wants some too!"
msgstr "Woby cũng muốn ăn kìa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROBIN.GENERIC"
msgid "Wonder how they got here?"
msgstr "Tự hỏi chúng đến đây bằng cách nào nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROBIN.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROBIN.HELD"
msgid "Are you happy in my pocket?"
msgstr "Cậu có thấy vui khi ở trong túi áo của tôi không?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROBIN_WINTER.GENERIC"
msgid "My handbook doesn't show them in this colour..."
msgstr "Sổ tay của mình không có loại màu này..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROBIN_WINTER.HELD"
msgid "They're extra downy."
msgstr "Chúng cực kỳ nhiều lông tơ luôn."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROBOT_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROBOT_BLUEPRINT"
msgid "Is this really for sewing?"
msgstr "Cái này thực sự dùng để khâu vá đấy á?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROBOT_PUPPET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROBOT_PUPPET"
msgid "Don't worry, a Pinetree Pioneer always helps those in need!"
msgstr "Đừng lo, một Hướng đạo sinh Cây Thông luôn sẵn sàng giúp đỡ những ai gặp khó khăn!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK"
msgid "It would be more useful in smaller pieces."
msgstr "Nó sẽ hữu ích hơn nếu được đập thành những mảnh nhỏ hơn."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCKS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCKS"
msgid "Maybe I could make a fire pit."
msgstr "Có lẽ mình có thể làm một cái Lò Lửa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCKY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCKY"
msgid "Wow! Look at you!"
msgstr "Chao ôi! Nhìn cậu kìa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN"
msgid "I don't think it'll be making fruit anytime soon."
msgstr "Mình không nghĩ nó sẽ ra quả sớm đâu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING"
msgid "It's on fire!"
msgstr "Nó đang bốc cháy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED"
msgid "Maybe that's how a moon bush is supposed to look?"
msgstr "Chắc bụi cây mặt trăng trông nó phải thế này nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING"
msgid "Is something wrong with it?"
msgstr "Có gì đó không ổn với nó à?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC"
msgid "Is that tree growing... rocks?"
msgstr "Cái cây đó đang mọc ra... cục đá á?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED"
msgid "We already gathered all the fruit."
msgstr "Chúng ta đã hái hết quả rồi còn đâu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED"
msgid "I don't think it likes the heat."
msgstr "Mình không nghĩ nó thích thời tiết nóng nực này đâu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_AVOCADO_FRUIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_AVOCADO_FRUIT"
msgid "It's hard as a rock!"
msgstr "Nó cứng như đá tảng vậy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE"
msgid "It's finally ripe! ...I think."
msgstr "Cuối cùng thì nó cũng chín! ...Mình nghĩ thế."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED"
msgid "That's better."
msgstr "Thế này thì đỡ hơn rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT"
msgid "Oh, it's growing!"
msgstr "Ồ, nó đang lớn lên kìa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_ICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_ICE.GENERIC"
msgid "This will really give you the chills."
msgstr "Cái này thực sự làm bạn lạnh thấu xương đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_ICE.MELTED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_ICE.MELTED"
msgid "Ice sometimes does that."
msgstr "Băng đá đôi khi cũng thế mà."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_ICE_MELTED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_ICE_MELTED"
msgid "Ice sometimes does that."
msgstr "Băng đá đôi khi cũng thế mà."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_LIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_LIGHT.GENERIC"
msgid "A crusted over lava pit."
msgstr "Một hố nham thạch đã đóng vảy ở trên."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_LIGHT.LOW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_LIGHT.LOW"
msgid "The lava's crusting over."
msgstr "Lớp dung nham đang đóng váng lại rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_LIGHT.NORMAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_LIGHT.NORMAL"
msgid "Nice and comfy."
msgstr "Vừa đẹp lại vừa ấm cúng."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_LIGHT.OUT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_LIGHT.OUT"
msgid "Looks fragile."
msgstr "Trông có vẻ dễ vỡ đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_MOON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_MOON"
msgid "I wonder how it affects were-people. I should ask Mr. Woodie."
msgstr "Tự hỏi nó ảnh hưởng thế nào đến người sói nhỉ. Chắc mình phải hỏi anh Woodie mới được."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_PETRIFIED_TREE"
msgid "What could've turned it to stone?"
msgstr "Thứ gì mà có thể biến nó thành đá thế nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_PETRIFIED_TREE_OLD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROCK_PETRIFIED_TREE_OLD"
msgid "What could've turned it to stone?"
msgstr "Thứ gì mà có thể biến nó thành đá thế nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROOK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROOK"
msgid "I wonder how it works?"
msgstr "Tự hỏi nó hoạt động thế nào nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROOK_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROOK_NIGHTMARE"
msgid "Wow! It looks even more dangerous than the usual ones!"
msgstr "Chao ôi! Trông nó còn nguy hiểm hơn mấy con bình thường nhiều!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROPE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROPE"
msgid "An essential part of any adventuring kit."
msgstr "Một món đồ không thể thiếu trong bất kỳ bộ dụng cụ thám hiểm nào."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROPE_BRIDGE_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROPE_BRIDGE_KIT"
msgid "This is basic Pinetree Pioneer stuff... now, where are those instructions?"
msgstr "Mấy thứ này cơ bản của H... hướng đạo sinh mà... ừm, tờ hướng dẫn đâu rồi nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROSEGLASSESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROSEGLASSESHAT.GENERIC"
msgid "Winona's been wearing those a lot lately."
msgstr "Dạo này Winona hay đeo mấy cái đó lắm."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROTTENEGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROTTENEGG.GENERIC"
msgid "That's definitely gone off."
msgstr "Cái đó hỏng thật rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ROYAL_JELLY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ROYAL_JELLY"
msgid "It was a royal pain to get."
msgstr "Kiếm được nó đúng là mệt bở hơi tai."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RUBBLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RUBBLE"
msgid "A bunch of really old rocks. I guess all rocks are old..."
msgstr "Một đống cục đá siêu cổ. Mà chắc cục đá nào chẳng cổ..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RUINSHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RUINSHAT"
msgid "I'm the king! You have to listen to what I say!"
msgstr "Ta là vua! Các ngươi phải nghe lời ta nói!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RUINS_BAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RUINS_BAT"
msgid "I was never great at baseball... but maybe I would be with a bat like this!"
msgstr "Mình chưa bao giờ giỏi bóng chày... nhưng biết đâu cầm chiếc gậy này vào thì mình lại giỏi nhỉ!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.RUINS_RUBBLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.RUINS_RUBBLE"
msgid "We can fix it up with some Pinetree Pioneer determination!"
msgstr "Chúng ta có thể sửa nó lại bằng sự quyết tâm của Hướng đạo sinh Cây Thông!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SACRED_CHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SACRED_CHEST.GENERIC"
msgid "There HAS to be something good in there, just look at it!"
msgstr "Chắc chắn PHẢI có món gì ngon ở trong đó rồi, nhìn nó kìa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SACRED_CHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SACRED_CHEST.LOCKED"
msgid "How do we get it open? Any ideas, Woby?"
msgstr "Làm sao để mở nó ra đây? Có cao kiến gì không Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SADDLEHORN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SADDLEHORN"
msgid "It can't be comfortable wearing a saddle all the time."
msgstr "Đeo yên cưỡi suốt thế thì chắc chẳng thoải mái gì đâu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SADDLE_BASIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SADDLE_BASIC"
msgid "Guess you need a saddle to ride some animals."
msgstr "Chắc cậu cần một cái yên cưỡi để cưỡi một số loài động vật."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SADDLE_RACE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SADDLE_RACE"
msgid "See? Bugs are helpful in lots of ways!"
msgstr "Thấy chưa? Bọ cũng hữu ích theo nhiều cách đấy chứ!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SADDLE_SHADOW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SADDLE_SHADOW"
msgid "Neat seat!"
msgstr "Chỗ ngồi tuyệt đấy chứ!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SADDLE_WAR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SADDLE_WAR"
msgid "It's almost as comfy as sitting in Woby's fur."
msgstr "Nó gần như thoải mái bằng việc ngồi trên bộ lông của Woby vậy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SADDLE_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SADDLE_WATHGRITHR"
msgid "Wanna try it on, Woby? Don't worry, I was just kidding!"
msgstr "Cậu muốn thử không Woby? Đừng lo, mình đùa thôi mà!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SALSA
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SALSA"
msgid "It only comes with one chip?!"
msgstr "Sao lại chỉ cho có một miếng bánh ngô giòn thế này?!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SALTBOX
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SALTBOX"
msgid "Salt is great for preserving your supplies."
msgstr "Muối rất tuyệt để bảo quản nguồn dự trữ của bạn."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SALTLICK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SALTLICK"
msgid "Don't eat that Woby, it's for the beefalo!"
msgstr "Đừng có ăn cái đó đấy Woby, cái đó dành cho bò lai mà!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SALTLICK_IMPROVED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SALTLICK_IMPROVED"
msgid "You're not a beefalo, Woby."
msgstr "Cậu đâu phải bò lai đâu Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SALTROCK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SALTROCK"
msgid "Hey, I think that's salt!"
msgstr "Này, mình nghĩ đó là muối đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SALTSTACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SALTSTACK.GENERIC"
msgid "Maybe there's a Medusa nearby... a salt Medusa..."
msgstr "Biết đâu có Medusa ở gần đây... một Medusa muối..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SALTSTACK.GROWING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SALTSTACK.GROWING"
msgid "I'm glad they grow back!"
msgstr "Thật may là chúng có thể mọc lại!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SALTSTACK.MINED_OUT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SALTSTACK.MINED_OUT"
msgid "Nothing left to gather."
msgstr "Chẳng còn gì để thu hoạch nữa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SALTY_DOG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SALTY_DOG"
msgid "He's not technically a dog, but he's still a good boy!"
msgstr "Về mặt kỹ thuật thì chú ta không phải chó, nhưng vẫn là một bé ngoan!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SALTY_DOGHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SALTY_DOGHAT"
msgid "It looks so official!"
msgstr "Trông ra dáng ra phết!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SANDBLOCK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SANDBLOCK"
msgid "Woah! How do you do that?"
msgstr "Chao ôi! Cậu làm cách nào hay thế?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SANDSPIKE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SANDSPIKE"
msgid "Hey, careful! You almost hit me with that!"
msgstr "Này, cẩn thận chứ! Suýt nữa cậu đánh trúng mình rồi đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SANITYROCK.ACTIVE"
msgid "Hey, where did that come from?"
msgstr "Này, cái đó ở đâu chui ra thế nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SANITYROCK.INACTIVE"
msgid "I swear there was something here a second ago."
msgstr "Mình thề là vừa có cái gì ở đây lúc nãy mà."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SAPLING.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SAPLING.BURNING"
msgid "Someone grab some water!"
msgstr "Ai đó kiếm ít nước mau lên!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SAPLING.DISEASED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SAPLING.DISEASED"
msgid "That doesn't look healthy."
msgstr "Trông không khỏe mạnh cho lắm."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SAPLING.DISEASING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SAPLING.DISEASING"
msgid "Is it supposed to look like that?"
msgstr "Nó phải trông như thế này thật à?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SAPLING.GENERIC"
msgid "It's a baby tree."
msgstr "Đó là một cây con."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SAPLING.PICKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SAPLING.PICKED"
msgid "Now it'll never grow into a tree."
msgstr "Giờ thì nó chẳng bao giờ lớn thành cây được nữa rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SAPLING.WITHERED"
msgid "I guess it's too hot out."
msgstr "Chắc ngoài trời nóng quá đây mà."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCANDATA
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCANDATA"
msgid "Neat! Wanna scan me next?"
msgstr "Hay thật đấy! Muốn quét mình luôn không?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCARECROW.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCARECROW.BURNING"
msgid "I guess that makes it look a little scarier."
msgstr "Mình đoán điều đó làm nó trông có vẻ đáng sợ hơn một chút."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCARECROW.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCARECROW.BURNT"
msgid "Not much use to us now."
msgstr "Giờ thì chẳng còn dùng được mấy nữa rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCARECROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCARECROW.GENERIC"
msgid "Who'd be scared of that?"
msgstr "Ai mà thèm sợ cái đó cơ chứ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCORCHED_SKELETON"
msgid "I think the time for first aid has long passed."
msgstr "Mình nghĩ thời gian để sơ cứu đã qua lâu lắm rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCRAPBOOK_PAGE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCRAPBOOK_PAGE"
msgid "I should add it to my scrapbook!"
msgstr "Mình nên thêm nó vào cuốn sổ lưu niệm mới được!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCRAPHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCRAPHAT"
msgid "That werepig was so big, I can wear his shoulder pad as a hat!"
msgstr "Con lợn vằn đó to đến mức mình có thể lấy tấm đệm vai của nó làm mũ luôn!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCRAP_MONOCLEHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCRAP_MONOCLEHAT"
msgid "Woah! It's like binoculars, but... well, the opposite of that!"
msgstr "Chao ôi! Giống như ống nhòm vậy, nhưng mà... ừm, ngược lại cơ!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTINGTABLE.BLOCK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTINGTABLE.BLOCK"
msgid "This doesn't look too hard! Or does it..."
msgstr "Cái này trông không khó lắm đâu! Hay là có nhỉ..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "Don't we have a perfectly good fire pit?"
msgstr "Chúng ta chẳng có sẵn một Lò Lửa ngon lành rồi sao?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTINGTABLE.EMPTY"
msgid "Time for some arts and crafts."
msgstr "Đã đến lúc làm nghệ thuật thủ công rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTINGTABLE.SCULPTURE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTINGTABLE.SCULPTURE"
msgid "Hey Woby, look! I'm getting good at this!"
msgstr "Này Woby, nhìn này! Mình bắt đầu giỏi món này rồi đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED"
msgid "One part of this statue looks older than the other."
msgstr "Một phần của bức tượng này trông có vẻ cổ hơn phần kia."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED"
msgid "Finished!"
msgstr "Xong rồi!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
msgid "Huh? I think I hear something moving in there."
msgstr "Hửm? Hình như mình nghe thấy có gì đó đang chuyển động trong đó."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED"
msgid "Can you sniff out the missing piece Woby?"
msgstr "Cậu đánh hơi ra mảnh còn thiếu được không Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_BISHOPHEAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_BISHOPHEAD"
msgid "What's that doing here?"
msgstr "Cái đó làm gì ở đây thế nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED"
msgid "There's something weird about it."
msgstr "Có cái gì đó rất kỳ lạ về nó."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED"
msgid "That looks better."
msgstr "Trông khá hơn rồi đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_KNIGHTBODY.READY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_KNIGHTBODY.READY"
msgid "Huh? I think I hear something moving in there."
msgstr "Hửm? Hình như mình nghe thấy có gì đó đang chuyển động trong đó."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED"
msgid "It's all broken up."
msgstr "Nó vỡ tung tóe hết cả rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_KNIGHTHEAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_KNIGHTHEAD"
msgid "That's one way to get a head. Get it?"
msgstr "Đúng là một cách để "lên đỉnh"... à nhầm, có đầu. Hiểu ý mình chứ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_ROOKBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_ROOKBODY.COVERED"
msgid "I think there's something else hiding in that marble."
msgstr "Mình nghĩ có thứ gì khác đang ẩn giấu trong khối đá cẩm thạch đó."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED"
msgid "That was easy enough."
msgstr "Việc đó dễ ẹc hà."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_ROOKBODY.READY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_ROOKBODY.READY"
msgid "Huh? I think I hear something moving in there."
msgstr "Hửm? Hình như mình nghe thấy có gì đó đang chuyển động trong đó."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED"
msgid "There's something missing..."
msgstr "Có cái gì đó đang bị thiếu..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_ROOKNOSE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SCULPTURE_ROOKNOSE"
msgid "How did it get there?"
msgstr "Nó lọt vào đây bằng cách nào thế?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SEAFARING_PROTOTYPER.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SEAFARING_PROTOTYPER.BURNT"
msgid "We should really be more careful with our resources."
msgstr "Lẽ ra chúng ta nên cẩn thận hơn với tài nguyên của mình mới phải."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC"
msgid "We're going to need a better boat."
msgstr "Chúng ta sẽ cần một chiếc Thuyền ván xịn hơn."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SEAFOODGUMBO
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SEAFOODGUMBO"
msgid "Packed full of flavour!"
msgstr "Tràn ngập hương vị!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SEASTACK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SEASTACK"
msgid "Rocks off the port bow!"
msgstr "Có cục đá phía mạn trái kìa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SECURITY_PULSE_CAGE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SECURITY_PULSE_CAGE"
msgid "It's empty, Woby. Let's find something to put in there."
msgstr "Nó trống không kìa Woby. Hãy tìm cái gì đó bỏ vào xem nào."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SECURITY_PULSE_CAGE_FULL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SECURITY_PULSE_CAGE_FULL"
msgid "I wonder if there is a glowing ball trapping badge."
msgstr "Tự hỏi có huy hiệu nào bắt giữ quả cầu phát sáng không nhỉ."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SEEDPOUCH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SEEDPOUCH"
msgid "You can never have too many pockets!"
msgstr "Không bao giờ là thừa túi đựng cả!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SEEDS"
msgid "It's nice of the birds to share."
msgstr "Mấy chú chim thật tốt bụng khi biết chia sẻ đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SEEDS_COOKED"
msgid "You make do with what you have when you're out in the wilderness."
msgstr "Sống ở chốn hoang dã thì có gì dùng nấy thôi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SENTRYWARD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SENTRYWARD"
msgid "Map making is so much more interesting here!"
msgstr "Làm bản đồ ở đây thú vị hơn nhiều!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SEWING_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SEWING_KIT"
msgid "Better make sure all my badges are secure!"
msgstr "Phải kiểm tra lại xem tất cả các huy hiệu của mình đã chắc chắn chưa đã!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SEWING_MANNEQUIN.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SEWING_MANNEQUIN.BURNT"
msgid "Oh no, I thought I smelled a campfire burning around here!"
msgstr "Ôi không, cứ như mình ngửi thấy mùi lửa trại đang cháy ở đâu đây!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SEWING_MANNEQUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SEWING_MANNEQUIN.GENERIC"
msgid "I don't know why some people think mannequins are scary."
msgstr "Mình không hiểu sao nhiều người lại nghĩ ma nơ canh đáng sợ nữa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SEWING_TAPE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SEWING_TAPE"
msgid "It's so handy!"
msgstr "Nó tiện lợi ghê!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWDANCER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWDANCER"
msgid "Mr. Maxwell's actually kind of fun when you get to know him."
msgstr "Thực ra ngài Maxwell cũng khá vui tính khiêm bạn đã quen đấy chứ."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWDIGGER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWDIGGER"
msgid "I wish my shadow could help me with my chores."
msgstr "Ước gì cái bóng của mình có thể giúp mình làm việc nhà nhỉ."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWHEART
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWHEART"
msgid "Look at that! I wonder what's keeping it alive?"
msgstr "Nhìn cái kìa! Tự hỏi thứ gì giữ cho nó sống được hay vậy?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWRIFT_PORTAL"
msgid "I wish I could get a better look inside..."
msgstr "Ước gì mình có thể nhìn rõ hơn vào bên trong..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY"
msgid "Beware of de-feet! Get it, Wobes? De-feet!"
msgstr "Cẩn thận mất chân đấy! Hiểu chứ, Wobes? Mất chân đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED"
msgid "No, Woby. I don't think it wants its belly scratched."
msgstr "Không đâu Woby. Mình không nghĩ nó muốn được gãi bụng đâu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD"
msgid "Are two heads better than one?"
msgstr "Hai đầu thì có tốt hơn một đầu không ta?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWTHRALL_HANDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWTHRALL_HANDS"
msgid "They seem fun!"
msgstr "Trông chúng có vẻ vui đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWTHRALL_HORNS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWTHRALL_HORNS"
msgid "I bet they're friendly!"
msgstr "Cá là chúng thân thiện đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWTHRALL_MOUTH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWTHRALL_MOUTH"
msgid "It's a silly one!"
msgstr "Đúng là một đứa ngốc nghếch!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWTHRALL_PARASITE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWTHRALL_PARASITE"
msgid "I think it just wants a friend."
msgstr "Mình nghĩ nó chỉ muốn có bạn thôi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWTHRALL_WINGS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOWTHRALL_WINGS"
msgid "Oooh, neat! That one can fly!"
msgstr "Ồ ồ, hay ghê! Con đó bay được kìa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOW_BATTLEAXE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOW_BATTLEAXE"
msgid "Woby, I think it winked at me!"
msgstr "Woby, hình như nó vừa nháy mắt với mình kìa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOW_BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOW_BEEF_BELL"
msgid "Like first aid but magic."
msgstr "Giống sơ cứu nhưng mà bằng phép thuật."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOW_FORGE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOW_FORGE"
msgid "It's really handy! Get it? Because it has hands?"
msgstr "Nó tiện lợi thật đấy! Hiểu chưa? Vì nó có tay mà!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOW_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOW_FORGE_KIT"
msgid "Don't worry, I'm great at setting things up!"
msgstr "Đừng lo, khoản dựng đồ này thì mình giỏi lắm!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOW_HEART_VEIN"
msgid "Aw, it's so helpful!"
msgstr "Á chà, hữu ích ghê cơ!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHALLOW_GRAVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHALLOW_GRAVE"
msgid "Don't sniff around there, Woby."
msgstr "Đừng có ngửi quanh đấy nhé Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHARK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHARK"
msgid "Just look at the size of those teeth!"
msgstr "Nhìn kích thước hàm răng kìa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHARKBOI
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHARKBOI"
msgid "Better watch out for frostbite!"
msgstr "Tốt hơn hết là nên cẩn thận bị bỏng lạnh đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHELLWEAVER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHELLWEAVER"
msgid "You can make a lot of stuff out of salt!"
msgstr "Cậu có thể làm rất nhiều thứ từ muối đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHELL_CLUSTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHELL_CLUSTER"
msgid "Let's break it apart and see what's inside."
msgstr "Đập nó ra xem bên trong có gì nào."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHIELDOFTERROR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHIELDOFTERROR"
msgid "I like to think it's smiling."
msgstr "Mình cứ nghĩ là nó đang cười chứ."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHOVEL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHOVEL"
msgid "You never know what you'll find if you do a little digging."
msgstr "Bạn sẽ không biết mình tìm được gì đâu nếu chịu khó đào bới một chút."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHOVEL_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHOVEL_LUNARPLANT"
msgid "I came up with the name!"
msgstr "Chính mình là người đặt tên cho nó đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHROOMBAIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHROOMBAIT"
msgid "Don't eat that Woby! It'll knock you right out."
msgstr "Đừng có ăn cái đó đấy Woby! Cậu sẽ ngất xỉu ngay lập tức đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHROOMCAKE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHROOMCAKE"
msgid "Is that really a cake?"
msgstr "Đó thực sự là bánh ngọt hả?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHROOM_SKIN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHROOM_SKIN"
msgid "It's so weird! Can I keep it?"
msgstr "Trông kỳ cục ghê! Mình giữ nó được không?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SIESTAHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SIESTAHUT.BURNT"
msgid "What a waste of supplies..."
msgstr "Phí phạm nguyên liệu quá..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SIESTAHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SIESTAHUT.GENERIC"
msgid "A shady spot for a quick nap."
msgstr "Một chỗ râm mát để chợp mắt nhanh."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SILK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SILK"
msgid "Spiders are pretty useful."
msgstr "Nhện khá là hữu ích đấy chứ."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC"
msgid "There's something inside it!"
msgstr "Có cái gì đó bên trong kìa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC"
msgid "Maybe I could teach it to play some songs I learned in the Pioneers."
msgstr "Chắc tôi có thể dạy nó chơi vài bài hát học được hồi ở Hướng đạo sinh."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC"
msgid "Is that hard on your ears, Woby?"
msgstr "Có nhức tai lắm không, Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SISTURN.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SISTURN.GENERIC"
msgid "Yeah, that looks haunted."
msgstr "Ừm, trông có vẻ bị ám đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SISTURN.LOTS_OF_FLOWERS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SISTURN.LOTS_OF_FLOWERS"
msgid "That looks pretty nice."
msgstr "Trông khá là đẹp phết."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM"
msgid "Do you hear that, Woby?"
msgstr "Cậu có nghe thấy gì không, Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_EVIL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_EVIL"
msgid "They make me feel weird."
msgstr "Chúng khiến tôi thấy cứ kỳ lạ thế nào ấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SISTURN.SOME_FLOWERS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SISTURN.SOME_FLOWERS"
msgid "If I find some flowers I'll bring them back here."
msgstr "Nếu tìm thấy đóa hoa nào, tôi sẽ mang chúng về đây."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SKELETON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SKELETON"
msgid "Is it a real skeleton?"
msgstr "Đây có phải là bộ xương thật không nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SKELETONHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SKELETONHAT"
msgid "Good thing they had such a thick skull, this makes a great helmet!"
msgstr "May mà chúng có cái sọ dày thật, đội cái này làm mũ thì hết sảy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SKELETON_NOTPLAYER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SKELETON_NOTPLAYER"
msgid "Think it's a monster skeleton, Woby?"
msgstr "Cậu nghĩ đó là bộ xương quái vật phải không, Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SKELETON_PLAYER.DEFAULT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SKELETON_PLAYER.DEFAULT"
msgid "Poor %s. I guess %s might be more dangerous than I thought..."
msgstr "Tội nghiệp %s. Chắc là %s nguy hiểm hơn tôi tưởng..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SKELETON_PLAYER.FEMALE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SKELETON_PLAYER.FEMALE"
msgid "Poor %s. I guess %s might be more dangerous than I thought..."
msgstr "Tội nghiệp %s. Chắc là %s nguy hiểm hơn tôi tưởng..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SKELETON_PLAYER.MALE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SKELETON_PLAYER.MALE"
msgid "Poor %s. I guess %s might be more dangerous than I thought..."
msgstr "Tội nghiệp %s. Chắc là %s nguy hiểm hơn tôi tưởng..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SKELETON_PLAYER.ROBOT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SKELETON_PLAYER.ROBOT"
msgid "Poor %s. I guess %s might be more dangerous than I thought..."
msgstr "Tội nghiệp %s. Chắc là %s nguy hiểm hơn tôi tưởng..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SKETCH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SKETCH"
msgid "I think I could sculpt this! I'm pretty good at arts and crafts."
msgstr "Tôi nghĩ mình có thể điêu khắc cái này! Tôi khá giỏi mấy môn thủ công mỹ nghệ đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SKULLCHEST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SKULLCHEST"
msgid "There's got to be something good in there."
msgstr "Chắc chắn phải có thứ gì đó hay ho ở trỏng rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLEEPBOMB
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLEEPBOMB"
msgid "It's more humane than a stink bomb."
msgstr "Cái này nhân đạo hơn bom thối đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT.GENERIC"
msgid "You never know what you'll run into out in the wilderness."
msgstr "Bạn không thể biết trước mình sẽ đụng độ thứ gì ngoài hoang dã đâu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT.NOT_MINE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT.NOT_MINE"
msgid "I really shouldn't pick up things that don't belong to me."
msgstr "Thực ra tôi không nên nhặt những thứ không phải của mình."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_CONTAINER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_CONTAINER"
msgid "A good Pinetree Pioneer always packs extra ammo!"
msgstr "Một Hướng đạo sinh Cây Thông chân chính luôn chuẩn bị sẵn đạn dược dự phòng!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_DREADSTONE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_DREADSTONE"
msgid "These will pack a real punch-a-roo!"
msgstr "Mấy viên này có võ phết đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_FREEZE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_FREEZE"
msgid "Almost as chilling as my favourite radio shows!"
msgstr "Gần như lạnh lẽo giống mấy chương trình phát thanh ưa thích của tôi!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_GELBLOB
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_GELBLOB"
msgid "Icky. Just the way I like it!"
msgstr "Nhớp nhúa. Đúng kiểu tôi thích!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_GOLD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_GOLD"
msgid "These rounds are golden! Literally!"
msgstr "Mấy viên đạn này mạ vàng đấy! Nghĩa đen luôn!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_GUNPOWDER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_GUNPOWDER"
msgid "Woby, we're going out with a BANG!"
msgstr "Woby, chúng ta sẽ kết thúc thật HOÀNH TRÁNG nhé!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_HONEY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_HONEY"
msgid "Sweet!"
msgstr "Ngọt ngào!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_HORRORFUEL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_HORRORFUEL"
msgid "Spooktacular! Heh."
msgstr "Ghê rợn thật đấy! Hừm."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_LUNARPLANTHUSK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_LUNARPLANTHUSK"
msgid "Prrrickly-wickly!"
msgstr "Đâm đau thấu xương!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_MARBLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_MARBLE"
msgid "I wish they weren't so hard to find!"
msgstr "Ước gì chúng không quá khó kiếm!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_MOONGLASS"
msgid "Now I can hit'em with the moon!"
msgstr "Giờ thì tôi có thể nện chúng bằng mặt trăng rồi!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_POOP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_POOP"
msgid "Gross... but a distraction is a distraction."
msgstr "Ghê quá... nhưng đánh lạc hướng được là tốt rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_PUREBRILLIANCE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_PUREBRILLIANCE"
msgid "Yes, Woby. We are brilliant!"
msgstr "Đúng vậy, Woby. Chúng ta quá đỉnh!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_ROCK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_ROCK"
msgid "They're not the best, but they'll work."
msgstr "Chúng không phải loại tốt nhất, nhưng vẫn dùng được."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_SCRAPFEATHER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_SCRAPFEATHER"
msgid "They're in for a shock!"
msgstr "Chúng sẽ được một phen bất ngờ cho xem!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_SLOW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_SLOW"
msgid "These should slow them down!"
msgstr "Mấy viên này sẽ làm chúng chậm lại!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_STINGER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_STINGER"
msgid "Better be careful with these."
msgstr "Tốt hơn hết là nên cẩn thận với mấy thứ này."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_THULECITE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTAMMO_THULECITE"
msgid "Shadow magic is pretty handy, I see why the Ancients liked it!"
msgstr "Ma thuật bóng tối khá là tiện lợi đấy chứ, tôi hiểu tại sao người Cổ đại lại thích nó rồi!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTMODKIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOTMODKIT"
msgid "Time to mod my trusty slingshot?"
msgstr "Đã đến lúc độ chế cây Súng Cao Su quen thuộc của tôi chưa nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT_BAND_MIMIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT_BAND_MIMIC"
msgid "Creepy! I love it."
msgstr "Rợn tóc gáy! Tôi thích thế."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT_BAND_PIGSKIN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT_BAND_PIGSKIN"
msgid "Mmm. Smells like bacon! But don't eat it Woby!"
msgstr "Hừm. Thơm mùi thịt xông khói! Nhưng đừng có ăn đấy Woby!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT_BAND_TENTACLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT_BAND_TENTACLE"
msgid "It's a little twitchy!"
msgstr "Nó cứ giật giật kìa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT_FRAME_BONE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT_FRAME_BONE"
msgid "Bad to the bone!"
msgstr "Chất chơi người dơi đến tận xương tủy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT_FRAME_GEMS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT_FRAME_GEMS"
msgid "Now we're getting fancy!"
msgstr "Bắt đầu sang xịn mịn rồi đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT_FRAME_WAGPUNK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT_FRAME_WAGPUNK"
msgid "I could slingshot forever!"
msgstr "Tôi có thể bắn súng cao su hoài không chán!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT_FRAME_WAGPUNK_0
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT_FRAME_WAGPUNK_0"
msgid "There's a real kick to it!"
msgstr "Có lực giật phết đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT_HANDLE_JELLY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT_HANDLE_JELLY"
msgid "Aww, super sticky!"
msgstr "Á chà, siêu dính luôn!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT_HANDLE_SILK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT_HANDLE_SILK"
msgid "Kinda like hockey tape!"
msgstr "Hơi giống băng dính khúc côn cầu!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT_HANDLE_STICKY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT_HANDLE_STICKY"
msgid "Gross but effective!"
msgstr "Ghê nhưng mà hiệu quả!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT_HANDLE_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLINGSHOT_HANDLE_VOIDCLOTH"
msgid "Thank you, shadow monster!"
msgstr "Cảm ơn nhé, quái vật bóng tối!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLURPER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLURPER"
msgid "Hey little guy!"
msgstr "Chào bạn nhỏ!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLURPERPELT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLURPERPELT"
msgid "Does anyone know taxidermy?"
msgstr "Có ai biết thuật ướp xác không vậy?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLURPER_PELT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLURPER_PELT"
msgid "Does anyone know taxidermy?"
msgstr "Có ai biết thuật ướp xác không vậy?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLURTLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLURTLE"
msgid "What is that slimy thing? I've gotta get a closer look!"
msgstr "Cái thứ nhờ nhớt đó là gì vậy? Tôi phải nhìn kỹ hơn mới được!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLURTLEHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLURTLEHAT"
msgid "This should keep my brain safe. Never know when you'll see a zombie."
msgstr "Cái này sẽ bảo vệ bộ não của tôi an toàn. Không biết khi nào lại đụng độ thây ma đâu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLURTLEHOLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLURTLEHOLE"
msgid "I have to see what's in there!"
msgstr "Tôi phải xem có gì trong đó mới được!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLURTLESLIME
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLURTLESLIME"
msgid "Slurtle snot!"
msgstr "Dãi Sên Rùa kìa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SLURTLE_SHELLPIECES
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SLURTLE_SHELLPIECES"
msgid "Sorry slurtle."
msgstr "Xin lỗi Sên Rùa nhé."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SMALLBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SMALLBIRD.GENERIC"
msgid "Hey little bird! Anything you want to tell me?"
msgstr "Chào chú chim nhỏ! Cậu có muốn kể cho tôi nghe gì không?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SMALLBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SMALLBIRD.HUNGRY"
msgid "Feeling a bit... peckish? Heh... you know, because you're a bird?"
msgstr "Thấy hơi... đói bụng hả? Hì... ý tôi là, vì cậu là chim mà?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SMALLBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SMALLBIRD.SLEEPING"
msgid "Shhh, you have to be extra quiet Woby."
msgstr "Suỵt, phải thật giữ trật tự đấy Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SMALLBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SMALLBIRD.STARVING"
msgid "Oh no! Did I forget to feed you?"
msgstr "Ôi không! Mình quên cho ăn à?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SMALLGHOST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SMALLGHOST"
msgid "Maybe I should come back with someone who speaks ghost..."
msgstr "Chắc tôi nên quay lại với ai biết nói tiếng ma..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SMALLMEAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SMALLMEAT"
msgid "Just a little meat."
msgstr "Chỉ là một miếng thịt nhỏ thôi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SMALLMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SMALLMEAT_DRIED"
msgid "Barely a bite of jerky."
msgstr "Chẳng khác nào một miếng thịt khô vụn."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SNAPPER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SNAPPER"
msgid "This one's got bite."
msgstr "Con này có vẻ cắn đau đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SNOWBALL_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SNOWBALL_ITEM"
msgid "Heh."
msgstr "Hừm."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SNOWMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SNOWMAN.GENERIC"
msgid "Ice to meet ya!"
msgstr "Rất vui được gặp bạn!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SNOWMAN.SNOWBALL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SNOWMAN.SNOWBALL"
msgid "I've seen you a round! Heh."
msgstr "Tôi đã thấy bạn quanh quẩn rồi đấy! Hừm."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SNURTLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SNURTLE"
msgid "Hey little guy!"
msgstr "Chào bạn nhỏ!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SOIL_AMENDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SOIL_AMENDER.GENERIC"
msgid "I think I'm supposed to let it sit for a while."
msgstr "Hình như tôi phải để nó ngấm trong chốc lát."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SOIL_AMENDER.SPOILED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SOIL_AMENDER.SPOILED"
msgid "I'd guess it's just about done."
msgstr "Tôi đoán nó sắp xong rồi đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SOIL_AMENDER.STALE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SOIL_AMENDER.STALE"
msgid "Well, it sure looks like it's doing something."
msgstr "Chà, trông có vẻ như nó đang phát huy tác dụng rồi đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SOIL_AMENDER_FERMENTED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SOIL_AMENDER_FERMENTED"
msgid "That's gotta be done!"
msgstr "Chắc chắn là xong rồi đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPAT"
msgid "I bet you're really a big softie!"
msgstr "Cá là cậu thực ra rất hiền lành đúng không!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPEAR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPEAR"
msgid "It has a point... heh..."
msgstr "Nó có một cái đầu nhọn... hì..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPEAR_GUNGNIR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPEAR_GUNGNIR"
msgid "I could do a quick charge with that."
msgstr "Tôi có thể lao đến đâm một nhát nhanh gọn với cái này."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPEAR_LANCE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPEAR_LANCE"
msgid "It gets to the point."
msgstr "Nó đi thẳng vào vấn đề chính luôn."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPEAR_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPEAR_WATHGRITHR"
msgid "No Woby, that's not a stick! Well, I guess it IS a stick..."
msgstr "Không phải đâu Woby, đó không phải là một cành cây! Ờ thì, hình như ĐÚNG là cành cây..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPEAR_WATHGRITHR_LIGHTNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPEAR_WATHGRITHR_LIGHTNING"
msgid "How shocking! Get it?"
msgstr "Sốc chưa kìa! Hiểu ý tôi chứ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPICEPACK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPICEPACK"
msgid "Specialized spice traveling gear."
msgstr "Thiết bị chuyên dụng mang theo gia vị."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPICE_CHILI
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPICE_CHILI"
msgid "A little bit of spice never hurt anyone."
msgstr "Thêm chút gia vị chẳng hại ai bao giờ."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPICE_GARLIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPICE_GARLIC"
msgid "It's good for you!"
msgstr "Tốt cho sức khỏe lắm đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPICE_SALT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPICE_SALT"
msgid "It helps makes camp food a bit less bland."
msgstr "Nó giúp đồ ăn khi cắm trại đỡ nhạt nhẽo hơn một chút."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPICE_SUGAR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPICE_SUGAR"
msgid "Too much will make you sick."
msgstr "Ăn nhiều quá sẽ phát ốm đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER.DEAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER.DEAD"
msgid "Aw, poor little guy."
msgstr "Ôi, tội nghiệp chú nhện nhỏ."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER.GENERIC"
msgid "Woah, you're a big spider!"
msgstr "Ồ, cậu là một con nhện to lớn đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER.SLEEPING"
msgid "Don't mind me!"
msgstr "Đừng để ý đến tôi nhé!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERCORPSE.BURNING"
msgid "That's a good habit."
msgstr "Đó là một thói quen tốt."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERCORPSE.GENERIC"
msgid "It looks dead, Woby. But be careful."
msgstr "Trông nó có vẻ chết rồi đấy, Woby. Nhưng cứ cẩn thận vẫn hơn."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERCORPSE.REVIVING"
msgid "We forgot to burn it. Oh well!"
msgstr "Mình quên thiêu nó đi mất rồi. Ôi chao!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERDEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERDEN"
msgid "Hey, that must be where the spiders live! It's huge!"
msgstr "Ồ, chắc đó là nơi lũ nhện sống! To khủng khiếp luôn!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERDEN_BEDAZZLER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERDEN_BEDAZZLER"
msgid "He's well on his way to getting his Arts and Crafts badge."
msgstr "Cậu ta sắp giành được huy hiệu Thủ công mỹ nghệ rồi đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDEREGGSACK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDEREGGSACK"
msgid "Aww, it's full of baby spiders!"
msgstr "Ôi, toàn là nhện con không kìa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERGLAND
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERGLAND"
msgid "This would be a good addition to my first aid kit."
msgstr "Cái này rất hợp để bỏ vào bộ sơ cứu của tôi đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERHAT"
msgid "Woby keeps growling at me when I wear it..."
msgstr "Woby cứ gừ gừ vào mặt tôi khi tôi đội nó..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERHOLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERHOLE"
msgid "Someone needs to dust more often, everything's covered in cobwebs!"
msgstr "Ai đó cần phải phủi bụi thường xuyên hơn đấy, mọi thứ phủ đầy mạng nhện rồi kìa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERHOLE_ROCK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERHOLE_ROCK"
msgid "Someone needs to dust more often, everything's covered in cobwebs!"
msgstr "Ai đó cần phải phủi bụi thường xuyên hơn đấy, mọi thứ phủ đầy mạng nhện rồi kìa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERQUEEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERQUEEN"
msgid "I've never heard of spiders having a queen, that's so interesting!"
msgstr "Tôi chưa từng nghe việc loài nhện lại có nữ hoàng bao giờ, thú vị thật đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERQUEENCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERQUEENCORPSE.BURNING"
msgid "We did the right thing, Woby."
msgstr "Chúng ta đã làm đúng, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERQUEENCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERQUEENCORPSE.GENERIC"
msgid "Rest in peace, Your Majesty."
msgstr "An nghỉ nhé, Nữ hoàng."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERQUEENCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDERQUEENCORPSE.REVIVING"
msgid "We should have burned it. Oops."
msgstr "Lẽ ra chúng ta nên thiêu nó đi. Ôi chao."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_DROPPER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_DROPPER"
msgid "Woah! You startled me!"
msgstr "Úi! Cậu làm tôi giật mình đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_HEALER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_HEALER"
msgid "Aw, what a helpful little guy!"
msgstr "Ồ, đúng là một chú nhện nhỏ hữu ích!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_HEALER_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_HEALER_ITEM"
msgid "It's like a first aid kit for spiders!"
msgstr "Nó giống như một bộ sơ cứu dành cho nhện vậy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_HIDER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_HIDER"
msgid "Woah! You startled me!"
msgstr "Úi! Cậu làm tôi giật mình đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_MOON.DEAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_MOON.DEAD"
msgid "Aw, it's dead."
msgstr "Ồ, nó chết rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_MOON.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_MOON.GENERIC"
msgid "Woah, how did they get like that? I need to get a closer look!"
msgstr "Ồ, sao chúng lại biến thành thế kia nhỉ? Tôi phải lại gần xem mới được!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_MOON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_MOON.SLEEPING"
msgid "I could probably get close while they're sleeping."
msgstr "Chắc tôi có thể đến gần lúc chúng đang ngủ."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_REPELLENT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_REPELLENT"
msgid "Aw, why would I want the spiders to go away?"
msgstr "Ơ hay, sao tôi lại muốn lũ nhện biến đi cơ chứ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_SPITTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_SPITTER"
msgid "Ooooh! Look at you!"
msgstr "Ồ ố ô! Nhìn cậu kìa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_WARRIOR.DEAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_WARRIOR.DEAD"
msgid "Sorry, you started it!"
msgstr "Xin lỗi nhé, cậu khơi màu trước mà!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_WARRIOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_WARRIOR.GENERIC"
msgid "Look at the colouring on that one!"
msgstr "Nhìn màu sắc trên người con kìa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_WARRIOR.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_WARRIOR.SLEEPING"
msgid "I should probably leave them alone..."
msgstr "Chắc tôi nên để mặc chúng thì hơn..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_WATER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_WATER"
msgid "Woah, look how fast they are on the water, Woby!"
msgstr "Ồ, nhìn chúng bơi trên nước nhanh chưa kìa, Woby!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_WHISTLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPIDER_WHISTLE"
msgid "Hey Webber, let's call some spiders!"
msgstr "Này Webber, gọi mấy con nhện ra đây nào!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPOILED_FISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPOILED_FISH.GENERIC"
msgid "Ugh, rotten fish!"
msgstr "Hợ, cá ươn!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPOILED_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPOILED_FOOD.GENERIC"
msgid "I probably shouldn't eat this..."
msgstr "Chắc tôi không nên ăn cái này đâu..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPORE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPORE_MEDIUM.GENERIC"
msgid "Don't eat the spores Woby, a mushtree might grow in your stomach!"
msgstr "Đừng có ăn mấy cái bào tử đấy nhé Woby, cây nấm sẽ mọc trong bụng cậu mất đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPORE_MEDIUM.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPORE_MEDIUM.HELD"
msgid "The bugs in my pocket might like some light."
msgstr "Mấy con bọ trong túi tôi chắc thích chút ánh sáng đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPORE_MOON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPORE_MOON"
msgid "I probably shouldn't touch that."
msgstr "Chắc tôi không nên chạm vào nó đâu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPORE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPORE_SMALL.GENERIC"
msgid "Swamp gas! Oh, it's just some more spores."
msgstr "Khí đầm lầy á! Ồ, hóa ra chỉ là mấy bào tử nữa thôi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPORE_SMALL.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPORE_SMALL.HELD"
msgid "The bugs in my pocket might like some light."
msgstr "Mấy con bọ trong túi tôi chắc thích chút ánh sáng đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPORE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPORE_TALL.GENERIC"
msgid "Hope I don't accidentally swallow one."
msgstr "Mong là mình không vô tình nuốt nhầm một cái."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SPORE_TALL.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SPORE_TALL.HELD"
msgid "The bugs in my pocket might like some light."
msgstr "Mấy con bọ trong túi tôi chắc thích chút ánh sáng đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SQUID
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SQUID"
msgid "I wonder if that's their full size, or if these are just babies..."
msgstr "Không biết đó là kích cỡ tối đa của chúng, hay đây chỉ là mấy con mực con..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STAFFCOLDLIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STAFFCOLDLIGHT"
msgid "I just got a chill up my spine."
msgstr "Tôi vừa thấy lạnh sống lưng xong."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STAFFLIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STAFFLIGHT"
msgid "Almost better than a campfire."
msgstr "Gần như tốt hơn cả lửa trại."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STAFF_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STAFF_LUNARPLANT"
msgid "Yup, that's definitely magical."
msgstr "Ừm, cái đó đúng là có ma thuật rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STAFF_TORNADO
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STAFF_TORNADO"
msgid "What a pane... heh."
msgstr "Đúng là đau đầu... hì."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STAGEHAND.AWAKE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STAGEHAND.AWAKE"
msgid "Maybe it wants to roast marshmallows too?"
msgstr "Biết đâu nó cũng muốn nướng kẹo dẻo cùng nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STAGEHAND.HIDING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STAGEHAND.HIDING"
msgid "Woby, what's wrong? It's just a table."
msgstr "Woby, sao thế hả? Chỉ là cái bàn thôi mà."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STAGEUSHER.SITTING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STAGEUSHER.SITTING"
msgid "Woby, what's wrong? It's just a table."
msgstr "Woby, sao thế hả? Chỉ là cái bàn thôi mà."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STAGEUSHER.STANDING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STAGEUSHER.STANDING"
msgid "Maybe it wants to roast marshmallows too?"
msgstr "Biết đâu nó cũng muốn nướng kẹo dẻo cùng nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STALAGMITE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STALAGMITE"
msgid "People get stalagmites and stalactites confused, but I know which is which!"
msgstr "Mọi người hay nhầm lẫn măng đá và thạch nhũ, nhưng tôi thì phân biệt được rõ ràng nhé!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STALAGMITE_TALL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STALAGMITE_TALL"
msgid "It's a really tall... one of these!"
msgstr "Đúng là một cột... thứ này cao thật!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STALKER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STALKER"
msgid "A real living skeleton!"
msgstr "Một bộ xương sống bằng xương bằng thịt!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STALKER_ATRIUM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STALKER_ATRIUM"
msgid "Maybe he knows something about the bug people that lived here!"
msgstr "Biết đâu hắn lại biết gì đó về người bọ từng sống ở đây!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STALKER_MINION
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STALKER_MINION"
msgid "I wonder if I can catch one!"
msgstr "Không biết tôi có bắt được một con không nhỉ!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STALKER_NPC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STALKER_NPC"
msgid "I've got so many questions!! Can you feel things without skin? Do you eat? How do you see? ...Hey, where are you going?"
msgstr "Tôi có bao nhiêu là câu hỏi luôn!! Cậu có thể cảm nhận mọi thứ mà không có da không? Cậu có ăn không? Cậu nhìn bằng cách nào thế? ...Này, cậu đi đâu đấy?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STASH_MAP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STASH_MAP"
msgid "Every Pinetree Pioneer knows how to follow a map."
msgstr "Mọi Hướng đạo sinh Cây Thông đều biết cách dò theo bản đồ."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STATUEGLOMMER.EMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STATUEGLOMMER.EMPTY"
msgid "Sorry..."
msgstr "Xin lỗi nhé..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STATUEGLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STATUEGLOMMER.GENERIC"
msgid "It looks just like him!"
msgstr "Trông y chang cậu ấy luôn!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STATUEHARP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STATUEHARP"
msgid "I don't think it has an ear for music. Heh... good one, Walter."
msgstr "Tôi không nghĩ nó có khiếu âm nhạc đâu. Hì... nói hay đấy, Walter."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STATUEHARP_HEDGESPAWNER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STATUEHARP_HEDGESPAWNER"
msgid "It's all overgrown with vines."
msgstr "Nó bị dây leo mọc phủ kín hết cả rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STATUEMAXWELL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STATUEMAXWELL"
msgid "I'm starting to think that Maxwell guy might be a bit full of himself."
msgstr "Tôi bắt đầu nghĩ gã Maxwell đó có hơi tự cao tự đại rồi đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STATUE_MARBLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STATUE_MARBLE.GENERIC"
msgid "I wonder who made these?"
msgstr "Không biết ai đã làm ra mấy thứ này nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STATUE_MARBLE.TYPE1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STATUE_MARBLE.TYPE1"
msgid "It looks like something from a museum."
msgstr "Trông giống như một món đồ trong bảo tàng vậy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STATUE_MARBLE.TYPE2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STATUE_MARBLE.TYPE2"
msgid "It's nice, I guess."
msgstr "Cũng được, tôi đoán thế."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STATUE_MARBLE.TYPE3
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STATUE_MARBLE.TYPE3"
msgid "That one's just asking for birds to land on it."
msgstr "Cái đó thì đúng là mời gọi lũ chim đến đậu lên đầu mà."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STEELWOOL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STEELWOOL"
msgid "For making especially scratchy sweaters."
msgstr "Dùng để đan những chiếc áo len cực kỳ ngứa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STEERINGWHEEL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STEERINGWHEEL"
msgid "Come on First Mate Woby, we're going sailing!"
msgstr "Nào Thuyền phó Woby, chúng ta đi ra khơi thôi!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STEERINGWHEEL_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STEERINGWHEEL_ITEM"
msgid "It's probably a good idea to add a steering wheel."
msgstr "Lắp thêm bánh lái có lẽ là một ý hay đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STINGER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STINGER"
msgid "Aaaaah! Keep it away, please!"
msgstr "Áaaa! Tránh ra xa tôi nhanh lên, làm ơn!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STONE_CHAIR.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STONE_CHAIR.GENERIC"
msgid "Sorry Woby, that's not for you."
msgstr "Xin lỗi Woby, cái đó không dành cho cậu đâu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STONE_CHAIR.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STONE_CHAIR.OCCUPIED"
msgid "Sorry Woby, that's not for you."
msgstr "Xin lỗi Woby, cái đó không dành cho cậu đâu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STONE_TABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STONE_TABLE.GENERIC"
msgid "Woby, no paws on the table!"
msgstr "Woby, không được đặt chân lên bàn!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STONE_TABLE.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STONE_TABLE.HAS_ITEM"
msgid "Woby, no paws on the table!"
msgstr "Woby, không được đặt chân lên bàn!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STORAGE_ROBOT.BROKEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STORAGE_ROBOT.BROKEN"
msgid "We should try to fix it!"
msgstr "Chúng ta nên thử sửa nó xem!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STORAGE_ROBOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STORAGE_ROBOT.GENERIC"
msgid "Now that's how you fetch, Woby!"
msgstr "Đấy mới là đi nhặt đồ chứ, Woby!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STRAWHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STRAWHAT"
msgid "That hat would never pass uniform inspection."
msgstr "Chiếc mũ đó mà đem đi kiểm tra đồng phục thì thể nào cũng rớt."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STUFFEDEGGPLANT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STUFFEDEGGPLANT"
msgid "A vegetable stuffed with more vegetable."
msgstr "Một món rau được nhồi thêm rau."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.STUFFING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.STUFFING"
msgid "I could stuff a bit more in my mouth."
msgstr "Tôi có thể nhét thêm chút nữa vào mồm đây."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SUCCULENT_PICKED"
msgid "They're pretty useful for minor cuts and burns."
msgstr "Chúng khá hữu ích cho mấy vết cắt và vết bỏng nhẹ."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SUCCULENT_PICKED_DRIED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SUCCULENT_PICKED_DRIED"
msgid "Dried perfectly!"
msgstr "Phơi khô hoàn hảo!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SUCCULENT_PLANT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SUCCULENT_PLANT"
msgid "They're from the cactus family!"
msgstr "Chúng thuộc họ xương rồng đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SUCCULENT_POTTED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SUCCULENT_POTTED"
msgid "I guess it's nice. I prefer plants outdoors though."
msgstr "Trông cũng được. Nhưng tôi thích cây trồng ngoài trời hơn."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SUNKENCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SUNKENCHEST.GENERIC"
msgid "How did this clam get so big?"
msgstr "Sao con trai này lại to thế nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SUNKENCHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SUNKENCHEST.LOCKED"
msgid "I can't get it open."
msgstr "Tôi không mở nó ra được."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SUPERTACKLECONTAINER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SUPERTACKLECONTAINER"
msgid "So organized!"
msgstr "Ngăn nắp thật đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SUPPORT_PILLAR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SUPPORT_PILLAR"
msgid "Don't worry Woby, I'm sure it'll be fine!"
msgstr "Đừng lo Woby, tôi chắc là nó ổn thôi!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SUPPORT_PILLAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SUPPORT_PILLAR_BROKEN"
msgid "Um. Maybe I spoke too soon..."
msgstr "Ừm. Có lẽ tôi nói hơi sớm thì phải..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SUPPORT_PILLAR_COMPLETE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SUPPORT_PILLAR_COMPLETE"
msgid "That's not going anywhere!"
msgstr "Cái đó thì chẳng đi đâu được đâu!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SUPPORT_PILLAR_DREADSTONE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SUPPORT_PILLAR_DREADSTONE"
msgid "Don't worry Woby, I'm sure it'll be fine!"
msgstr "Đừng lo Woby, tôi chắc là nó ổn thôi!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_BROKEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_BROKEN"
msgid "How could it be so destructible?"
msgstr "Sao nó lại dễ phá hủy thế nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_COMPLETE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_COMPLETE"
msgid "Absolutely indestructible!"
msgstr "Hoàn toàn không thể phá hủy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_SCAFFOLD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_SCAFFOLD"
msgid "I bet there's some interesting secrets hiding under there!"
msgstr "Cá là có vài bí mật thú vị đang ẩn giấu bên dưới đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SUPPORT_PILLAR_SCAFFOLD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SUPPORT_PILLAR_SCAFFOLD"
msgid "I bet there's some interesting secrets hiding under there!"
msgstr "Cá là có vài bí mật thú vị đang ẩn giấu bên dưới đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SURFNTURF
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SURFNTURF"
msgid "So filling!"
msgstr "No nê thật đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SWEATERVEST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SWEATERVEST"
msgid "This doesn't look like good adventuring wear."
msgstr "Trông cái này không giống đồ phiêu lưu cho lắm."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SWEETPOTATO
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SWEETPOTATO"
msgid "It just isn't the holidays without it!"
msgstr "Sẽ không phải là ngày lễ nếu thiếu nó!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SWEETTEA
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SWEETTEA"
msgid "It makes my head feel a bit fuzzy... but I'm sure that's fine!"
msgstr "Nó làm đầu tôi thấy hơi ong ong... nhưng chắc là không sao đâu!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SWORD_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SWORD_LUNARPLANT"
msgid "A space sword! Neat!"
msgstr "Một thanh kiếm không gian! Tuyệt đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TABLE_WINTERS_FEAST.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TABLE_WINTERS_FEAST.BURNT"
msgid "Who's the Scrooge that ruined the feast?"
msgstr "Kẻ keo kiệt nào đã phá hỏng bữa tiệc thế này?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TABLE_WINTERS_FEAST.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TABLE_WINTERS_FEAST.GENERIC"
msgid "The table's all set and ready for food!"
msgstr "Bàn đã được dọn xong và sẵn sàng phục vụ đồ ăn rồi!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TABLE_WINTERS_FEAST.HAS_FOOD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TABLE_WINTERS_FEAST.HAS_FOOD"
msgid "Dig in, everybody!"
msgstr "Mời mọi người xơi nhé!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TABLE_WINTERS_FEAST.WRONG_TYPE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TABLE_WINTERS_FEAST.WRONG_TYPE"
msgid "We can eat that anytime, Winter's Feast should be special!"
msgstr "Ta ăn cái đó lúc nào chẳng được, Tiệc Mùa Đông phải đặc biệt chứ!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TACKLECONTAINER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TACKLECONTAINER"
msgid "It's got room for all my tackle."
msgstr "Nó có đủ chỗ cho tất cả dụng cụ câu cá của tôi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TACKLESKETCH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TACKLESKETCH"
msgid "This looks pretty easy to make."
msgstr "Cái này trông khá dễ làm đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TACKLESTATION
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TACKLESTATION"
msgid "Not to brag, but I do have my fishing badge."
msgstr "Không phải khoe đâu, nhưng tôi có huy hiệu câu cá thật đấy nhé."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TAFFY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TAFFY"
msgid "Don't eat too much or you'll get a stomach ache."
msgstr "Đừng ăn nhiều quá kẻo lại đau bụng đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TALLBIRD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TALLBIRD"
msgid "Woah! Do you fly? Or are you more like an ostrich?"
msgstr "Ối! Cậu biết bay không? Hay cậu giống đà điểu hơn?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TALLBIRDEGG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TALLBIRDEGG"
msgid "What a huge egg!"
msgstr "Quả trứng gì mà to thế!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TALLBIRDEGG_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TALLBIRDEGG_COOKED"
msgid "That's just how nature goes sometimes."
msgstr "Đôi khi tự nhiên là thế đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TALLBIRDEGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TALLBIRDEGG_CRACKED.COLD"
msgid "Come on Woby, help me warm it up."
msgstr "Nào Woby, giúp tôi sưởi ấm nó đi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC"
msgid "It's hatching! It's really hatching!"
msgstr "Nó đang nở kìa! Nó đang nở thật rồi!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TALLBIRDEGG_CRACKED.HOT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TALLBIRDEGG_CRACKED.HOT"
msgid "Uh oh, it's going to be a fried egg if we don't cool it down."
msgstr "Ôi thôi, thành trứng ốp la mất nếu chúng ta không làm mát nó xuống đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TALLBIRDEGG_CRACKED.LONG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TALLBIRDEGG_CRACKED.LONG"
msgid "How long does it take for these to hatch?"
msgstr "Mấy quả trứng này mất bao lâu để nở thế nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT"
msgid "It'll hatch any day now, I'm positive!"
msgstr "Nó sẽ nở bất cứ lúc nào thôi, tôi chắc chắn đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TALLBIRDNEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TALLBIRDNEST.GENERIC"
msgid "She was protecting her nest..."
msgstr "Nó đang bảo vệ tổ của mình..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TALLBIRDNEST.PICKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TALLBIRDNEST.PICKED"
msgid "Invisible eggs? Oh, no it's just empty."
msgstr "Trứng tàng hình à? Ồ không, hóa ra chỉ là trống không thôi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TALLEGGS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TALLEGGS"
msgid "That's a monster-sized breakfast!"
msgstr "Bữa sáng cỡ bự cho quái vật đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TAMALES
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TAMALES"
msgid "Woah, these are tasty!"
msgstr "Úi, món này ngon phết đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TEENBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TEENBIRD.GENERIC"
msgid "Nobody understands us, do they?"
msgstr "Chẳng ai hiểu chúng ta cả, phải không?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TEENBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TEENBIRD.HUNGRY"
msgid "Hungry? I'll see what I have."
msgstr "Đói à? Để xem tôi có gì nào."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TEENBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TEENBIRD.SLEEPING"
msgid "Sleep well!"
msgstr "Ngủ ngon nhé!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TEENBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TEENBIRD.STARVING"
msgid "They're just grouchy because they're hungry."
msgstr "Chúng chỉ cáu kỉnh vì đói bụng thôi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TELEBASE.GEMS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TELEBASE.GEMS"
msgid "Come on Woby, let's find some purple gems."
msgstr "Nào Woby, chúng ta đi tìm mấy viên ngọc tím thôi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TELEBASE.VALID
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TELEBASE.VALID"
msgid "Everything's ready!"
msgstr "Mọi thứ đã sẵn sàng!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TELEPORTATO_BASE.ACTIVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TELEPORTATO_BASE.ACTIVE"
msgid "Come on Woby, we've got some exploring to do!"
msgstr "Nào Woby, chúng ta còn nhiều việc phải khám phá lắm đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TELEPORTATO_BASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TELEPORTATO_BASE.GENERIC"
msgid "That definitely looks like a magical... something."
msgstr "Trông nó đích thị là một thứ... ma thuật nào đó."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TELEPORTATO_BASE.LOCKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TELEPORTATO_BASE.LOCKED"
msgid "Hm, it still needs something..."
msgstr "Hừm, nó vẫn thiếu thứ gì đó..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TELEPORTATO_BASE.PARTIAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TELEPORTATO_BASE.PARTIAL"
msgid "I think I've almost got it, Woby!"
msgstr "Tôi nghĩ mình sắp hoàn thành rồi đấy, Woby!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TELEPORTATO_BOX
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TELEPORTATO_BOX"
msgid "I wonder what's inside?"
msgstr "Không biết bên trong có gì nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TELEPORTATO_CRANK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TELEPORTATO_CRANK"
msgid "This looks complicated..."
msgstr "Cái này trông phức tạp phết..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TELEPORTATO_POTATO
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TELEPORTATO_POTATO"
msgid "What is this supposed to be, exactly?"
msgstr "Chính xác thì cái này là cái quái gì vậy?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TELEPORTATO_RING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TELEPORTATO_RING"
msgid "This looks important."
msgstr "Cái này trông có vẻ quan trọng."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TELESTAFF
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TELESTAFF"
msgid "But getting there is half the fun!"
msgstr "Nhưng hành trình di chuyển mới là một nửa thú vị!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TENT.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TENT.BURNT"
msgid "I guess I set it up too close to the campfire."
msgstr "Chắc tôi dựng lều gần đống lửa trại quá rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TENT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TENT.GENERIC"
msgid "I always sleep better in a tent."
msgstr "Tôi luôn ngủ ngon hơn khi ở trong lều."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TENTACLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TENTACLE"
msgid "I want to see the creature it's attached to!"
msgstr "Tôi muốn thấy sinh vật lạ gắn liền với nó quá!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TENTACLESPIKE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TENTACLESPIKE"
msgid "A souvenir from the swamp creature."
msgstr "Một món quà lưu niệm từ sinh vật đầm lầy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TENTACLESPOTS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TENTACLESPOTS"
msgid "You can find a use for almost anything in nature."
msgstr "Bạn có thể tìm thấy công dụng cho hầu hết mọi thứ trong tự nhiên."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TENTACLE_GARDEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TENTACLE_GARDEN"
msgid "That's a weird looking pillar."
msgstr "Trông cái cột đó kỳ cục thật."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TENTACLE_PILLAR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TENTACLE_PILLAR"
msgid "I kind of want to poke it."
msgstr "Tôi hơi muốn chọc vào nó một tí."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TENTACLE_PILLAR_ARM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TENTACLE_PILLAR_ARM"
msgid "Are these all from the same creature?"
msgstr "Mấy cái này đều là của cùng một sinh vật à?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TENTACLE_PILLAR_HOLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TENTACLE_PILLAR_HOLE"
msgid "Hey, there's a tunnel! Let's go Woby!"
msgstr "Này, có một cái đường hầm kìa! Đi thôi Woby!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TERRARIUM.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TERRARIUM.COOLDOWN"
msgid "I guess it can't stay lit up all the time."
msgstr "Chắc nó không thể sáng mãi được đâu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TERRARIUM.CRIMSON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TERRARIUM.CRIMSON"
msgid "Oh no, I think that shadow stuff made the tree sick..."
msgstr "Ôi không, tôi nghĩ thứ bóng tối đó đã làm cái cây đổ bệnh rồi..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TERRARIUM.ENABLED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TERRARIUM.ENABLED"
msgid "WOAH! That's REALLY not normal!"
msgstr "ÚI! Quá bất bình thường luôn!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TERRARIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TERRARIUM.GENERIC"
msgid "Woah! That's not normal!"
msgstr "Ồ! Không bình thường chút nào!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TERRARIUM.SPAWN_DISABLED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TERRARIUM.SPAWN_DISABLED"
msgid "Aww, can't we turn it on for a little bit?"
msgstr "Ơ, chẳng lẽ tụi mình không thể bật nó lên một lát sao?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TERRARIUM.WAITING_FOR_DARK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TERRARIUM.WAITING_FOR_DARK"
msgid "Spooky!"
msgstr "Ma quái thật đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TERRARIUMCHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TERRARIUMCHEST.BURNT"
msgid "Aww, and it was such a neat looking chest too..."
msgstr "Ôi, tiếc quá cái rương trông gọn gàng thế cơ mà..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TERRARIUMCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TERRARIUMCHEST.GENERIC"
msgid "I wonder how it got here?"
msgstr "Không biết nó đến đây bằng cách nào nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TERRARIUMCHEST.SHIMMER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TERRARIUMCHEST.SHIMMER"
msgid "What do you say, Woby? Should we take a look inside?"
msgstr "Cậu nói sao đây, Woby? Hay chúng ta ghé vào xem thử nhé?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.THULECITE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.THULECITE"
msgid "Rocks from an ancient civilization!"
msgstr "Mấy cục đá từ một nền văn minh cổ đại!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.THULECITEBUGNET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.THULECITEBUGNET"
msgid "Just minding my own buzzness, Woby. Heh."
msgstr "Chỉ đang lo việc bận của mình thôi, Woby. Hừm."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.THULECITE_PIECES
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.THULECITE_PIECES"
msgid "Woby, keep your eyes peeled for any more of these little pieces!"
msgstr "Woby, mở to mắt ra mà tìm xem còn mấy mảnh vụn này nữa không đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.THURIBLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.THURIBLE"
msgid "Oof, that's a strong smell."
msgstr "Hộc, mùi nồng quá."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TICOON.ABANDONED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TICOON.ABANDONED"
msgid "I hope he's not too upset at me..."
msgstr "Mong là nó không quá giận tôi..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TICOON.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TICOON.GENERIC"
msgid "Is that a real man-eating tiger? I thought they'd be bigger."
msgstr "Đó là hổ ăn thịt người thật á? Tôi cứ tưởng chúng phải to hơn chứ."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TICOON.LOST_TRACK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TICOON.LOST_TRACK"
msgid "Maybe he doesn't know where he's going after all."
msgstr "Biết đâu nó cũng chẳng biết mình đang đi đâu nữa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TICOON.NEARBY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TICOON.NEARBY"
msgid "I think he smells something nearby!"
msgstr "Tôi nghĩ nó ngửi thấy gì đó ở gần đây rồi!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TICOON.NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TICOON.NOTHING_TO_TRACK"
msgid "It doesn't look like he's picking up any scents."
msgstr "Trông có vẻ nó không đánh hơi thấy mùi gì cả."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TICOON.SUCCESS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TICOON.SUCCESS"
msgid "Look, he found one!"
msgstr "Nhìn kìa, nó tìm thấy rồi!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TICOON.TARGET_TOO_FAR_AWAY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TICOON.TARGET_TOO_FAR_AWAY"
msgid "Maybe we should try looking somewhere else."
msgstr "Chắc chúng ta nên thử tìm ở chỗ khác đi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TICOON.TRACKING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TICOON.TRACKING"
msgid "Come on Woby, let's follow him!"
msgstr "Nào Woby, chúng ta đi theo nó thôi!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TICOON.TRACKING_NOT_MINE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TICOON.TRACKING_NOT_MINE"
msgid "Whoops, sorry! All man-eating tigers look so alike..."
msgstr "Úi, xin lỗi nhé! Hổ ăn thịt người nào mà trông cũng y chang nhau..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TILLWEED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TILLWEED"
msgid "Hey! No weeds allowed in the garden!"
msgstr "Này! Không cho phép cỏ dại mọc trong vườn đâu nhé!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TILLWEEDSALVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TILLWEEDSALVE"
msgid "Even weeds can be helpful in the wilderness!"
msgstr "Đến cả cỏ dại cũng có ích khi ở chốn hoang dã đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TILLWEED_DRIED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TILLWEED_DRIED"
msgid "Dried perfectly!"
msgstr "Phơi khô hoàn hảo!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TOADSTOOL.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TOADSTOOL.GENERIC"
msgid "A real giant frog monster!"
msgstr "Một con quái vật ếch khổng lồ bằng xương bằng thịt!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TOADSTOOL.RAGE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TOADSTOOL.RAGE"
msgid "I don't think he likes us very much."
msgstr "Tôi không nghĩ hắn thích chúng ta cho lắm đâu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TOADSTOOL_CAP.EMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TOADSTOOL_CAP.EMPTY"
msgid "What's wrong, Woby? It's just a normal hole in the ground."
msgstr "Sao thế Woby? Chỉ là một cái hố bình thường dưới đất thôi mà."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TOADSTOOL_CAP.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TOADSTOOL_CAP.GENERIC"
msgid "Don't be so skittish Woby, it's just a toadstool!"
msgstr "Đừng có nhát gan thế chứ Woby, chỉ là một cây cóc nấm thôi mà!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TOADSTOOL_CAP.INGROUND
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TOADSTOOL_CAP.INGROUND"
msgid "Hey! What's that in there?"
msgstr "Này! Cái gì trong kia thế nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TOMATO
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TOMATO"
msgid "Mom had some tomato plants in our backyard."
msgstr "Mẹ có trồng mấy khóm cà chua ở sau vườn nhà."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TOMATO_COOKED"
msgid "That just made it squishier..."
msgstr "Nó chỉ làm nó nhũn ra thêm thôi..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TOMATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TOMATO_OVERSIZED"
msgid "It's bigger than you Woby! Well, one version of you at least."
msgstr "Nó còn to hơn cả cậu nữa đấy Woby! Ờ thì, ít ra là so với một phiên bản của cậu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TOMATO_SEEDS"
msgid "Where should we plant them, Woby?"
msgstr "Chúng ta nên trồng chúng ở đâu đây, Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TOPHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TOPHAT"
msgid "Seems a bit out of place out here in the wilderness."
msgstr "Trông có vẻ lạc quẻ giữa chốn hoang dã này thật."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TOPHAT_MAGICIAN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TOPHAT_MAGICIAN"
msgid "Do you think he can teach me how to pull rabbits out of it?"
msgstr "Cậu nghĩ hắn có thể dạy tôi cách kéo thỏ ra từ trong đó không?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TORCH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TORCH"
msgid "Is this what they use in England instead of flashlights?"
msgstr "Ở Anh người ta dùng cái này thay cho đèn pin à?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TOURTIERE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TOURTIERE"
msgid "My cousin from the East Coast made these for us once, they're the best!"
msgstr "Anh họ tôi ở Bờ Đông từng làm món này cho chúng tôi ăn, ngon tuyệt cú mèo!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TOWNPORTAL.ACTIVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TOWNPORTAL.ACTIVE"
msgid "Let's go!"
msgstr "Đi thôi!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TOWNPORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TOWNPORTAL.GENERIC"
msgid "Ready for a journey into the unknown Woby?"
msgstr "Sẵn sàng cho một hành trình tiến vào vùng đất không rõ chưa Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE"
msgid "It's ready to take us somewhere!"
msgstr "Nó đã sẵn sàng đưa chúng ta đi đâu đó rồi kìa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TOWNPORTALTALISMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TOWNPORTALTALISMAN.GENERIC"
msgid "No wonder she was grumpy, there was a pit in her stomach!"
msgstr "Hèn gì cô ta cáu kỉnh, hóa ra có một cái hố trong bụng!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAILMIX
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAILMIX"
msgid "The snack of choice for all intrepid explorers!"
msgstr "Món ăn vặt tủ của mọi nhà thám hiểm gan dạ!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAILS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAILS"
msgid "He's got a strong arm on him."
msgstr "Cậu ta có cánh tay khỏe thật đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRANSISTOR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRANSISTOR"
msgid "Of course I know what it is! It's uh... um..."
msgstr "Tất nhiên là tôi biết nó là gì rồi! Nó là... ừm... ờ..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAP"
msgid "We learned how to make them in the Pinetree Pioneers."
msgstr "Chúng tôi được học cách làm mấy cái này ở hội Hướng đạo sinh Cây Thông đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAP_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAP_BRAMBLE"
msgid "He's pretty good at this!"
msgstr "Cậu ta làm việc này khá thật đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAP_FUMAROLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAP_FUMAROLE.GENERIC"
msgid "Now it's just rocks."
msgstr "Giờ thì chỉ toàn cục đá thôi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAP_FUMAROLE.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAP_FUMAROLE.HELD"
msgid "Sorry Woby, those aren't treats."
msgstr "Xin lỗi Woby, mấy thứ đó không phải đồ ăn vặt đâu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAP_FUMAROLE.HOT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAP_FUMAROLE.HOT"
msgid "Watch out Woby, that's hot!"
msgstr "Cẩn thận đấy Woby, nóng lắm đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAP_FUMAROLE.WARM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAP_FUMAROLE.WARM"
msgid "It looks nice and warm. Er, maybe a little too warm..."
msgstr "Trông có vẻ ấm áp dễ chịu nhỉ. Ờ, mà hình như hơi quá ấm thì phải..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAP_STARFISH.CLOSED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAP_STARFISH.CLOSED"
msgid "H-hey, be careful!"
msgstr "N-này, cẩn thận đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAP_STARFISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAP_STARFISH.GENERIC"
msgid "I love starfish!"
msgstr "Tôi thích sao biển lắm!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAP_TEETH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAP_TEETH"
msgid "We didn't make traps like these in the Pinetree Pioneers..."
msgstr "Bọn tôi có được học làm mấy cái bẫy thế này trong hội Hướng đạo sinh Cây Thông đâu..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAP_TEETH_MAXWELL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRAP_TEETH_MAXWELL"
msgid "That could hurt someone!"
msgstr "Cái đó có thể làm ai đó bị thương đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TREASURECHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TREASURECHEST.BURNT"
msgid "My stuff!!"
msgstr "Đồ đạc của tôi!!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TREASURECHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TREASURECHEST.GENERIC"
msgid "It isn't a toy chest, it's a very grownup SUPPLY chest."
msgstr "Nó không phải rương đồ chơi đâu, đây là rương VẬT TƯ rất ra trò đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TREASURECHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TREASURECHEST.UPGRADED_STACKSIZE"
msgid "Just look at how many important survival supplies it can hold!"
msgstr "Cứ nhìn xem nó chứa được bao nhiêu vật tư sinh tồn quan trọng kìa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TREASURECHEST_TRAP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TREASURECHEST_TRAP"
msgid "There might be cursed pirate gold inside!"
msgstr "Biết đâu bên trong lại có kho báu hải tặc bị nguyền rủa thì sao!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TREECLUMP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TREECLUMP"
msgid "Come on, trees! I just want to see what's over there!"
msgstr "Tránh ra nào, mấy cái cây! Tôi chỉ muốn xem có gì đằng kia thôi!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TREEGROWTHSOLUTION
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TREEGROWTHSOLUTION"
msgid "I'm glad we found a use for those figs other than eating them..."
msgstr "May là chúng ta tìm được công dụng khác cho mấy quả sung ngoài việc ăn chúng..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TREE_ROCK.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TREE_ROCK.BURNING"
msgid "Watch out, Wobes!"
msgstr "Cẩn thận đấy, Wobes!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TREE_ROCK.CHOPPED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TREE_ROCK.CHOPPED"
msgid "Now we can mine it!"
msgstr "Giờ thì chúng ta có thể khai thác nó rồi!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TREE_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TREE_ROCK.GENERIC"
msgid "How to free the stone? What a burning question to axe!"
msgstr "Làm sao để giải thoát cục đá đây? Thật là một câu hỏi nhức nhối để rìu giải quyết!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TREE_ROCK_SAPLING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TREE_ROCK_SAPLING"
msgid "It's going to grow up big and strong!"
msgstr "Nó sẽ lớn lên thật cao và khỏe mạnh cho xem!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TREE_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TREE_ROCK_SEED"
msgid "Where should we plant this little one, Woby?"
msgstr "Chúng ta nên trồng cây con này ở đâu đây, Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRIDENT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRIDENT"
msgid "This looks like it could cause some damage."
msgstr "Cái này trông có vẻ gây ra khối sát thương đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_1"
msgid "These will make perfect slingshot ammo."
msgstr "Mấy thứ này sẽ làm đạn súng cao su hoàn hảo luôn."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_10
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_10"
msgid "I'm sure these will bring a smile to someone's face. Get it?"
msgstr "Chắc mấy cái này sẽ mang lại nụ cười cho ai đó thôi. Hiểu ý tôi chứ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_11
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_11"
msgid "He said he loves when I talk about my bug collection!"
msgstr "Cậu ấy bảo rất thích khi tôi kể về bộ sưu tập bọ của mình đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_12
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_12"
msgid "Still wriggling."
msgstr "Vẫn đang ngue nguẩy kìa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_13
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_13"
msgid "I thought she was looking the other way a second ago..."
msgstr "Tôi cứ nghĩ cách đây một giây cô ta nhìn sang hướng khác cơ chứ..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_14
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_14"
msgid "My mom would kill me if I cracked her fine china."
msgstr "Mẹ mà biết tớ làm vỡ bộ đồ sứ tinh xảo của bà thì mẹ giết tớ mất."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_15
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_15"
msgid "I'm not really interested in board games."
msgstr "Tớ không hứng thú lắm với trò chơi cờ bàn đâu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_16
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_16"
msgid "I'm not really interested in board games."
msgstr "Tớ không hứng thú lắm với trò chơi cờ bàn đâu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_17
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_17"
msgid "One less utensil to pack with your camping gear!"
msgstr "Bớt đi được một món đồ dùng để mang theo cùng bộ đồ cắm trại!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_18
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_18"
msgid "Seems like a normal wooden horse."
msgstr "Trông như một con ngựa gỗ bình thường."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_19
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_19"
msgid "I'm too mature for toys."
msgstr "Tớ quá lớn tuổi để chơi đồ chơi rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_2"
msgid "I'd rather have a bugle."
msgstr "Tớ thà có một chiếc kèn đồng còn hơn."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_20
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_20"
msgid "Woby likes it."
msgstr "Woby thích nó kìa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_21
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_21"
msgid "Whoops, it got kind of bent."
msgstr "Ối, nó bị cong mất rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_22
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_22"
msgid "I like a good yarn. Heh..."
msgstr "Tớ thích nghe chuyện kể hay lắm. Hừm..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_23
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_23"
msgid "Protect your heels!"
msgstr "Bảo vệ gót chân của bạn kìa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_24
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_24"
msgid "Woby doesn't seem to like it very much."
msgstr "Woby có vẻ không thích nó cho lắm."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_25
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_25"
msgid "It doesn't even smell like a real pine tree!"
msgstr "Nó thậm chí còn chẳng có mùi giống cây thông thật!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_26
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_26"
msgid "One less dish to wash!"
msgstr "Bớt đi được một chiếc đĩa phải rửa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_27
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_27"
msgid "I wonder if I can use it to pick up radio signals..."
msgstr "Tự hỏi không biết mình có dùng nó để bắt tín hiệu radio được không..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_28
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_28"
msgid "I'm not really interested in board games."
msgstr "Tớ không hứng thú lắm với trò chơi cờ bàn đâu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_29
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_29"
msgid "I'm not really interested in board games."
msgstr "Tớ không hứng thú lắm với trò chơi cờ bàn đâu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_3
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_3"
msgid "That's easy, I know how to tie lots of knots!"
msgstr "Dễ thôi, tớ biết cách thắt rất nhiều loại nút thắt đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_30
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_30"
msgid "They're kind of boring once you've seen the bigger version."
msgstr "Nhìn mấy cái nào to hơn rồi thì mấy cái này nhàm chán lắm."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_31
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_31"
msgid "They're kind of boring once you've seen the bigger version."
msgstr "Nhìn mấy cái nào to hơn rồi thì mấy cái này nhàm chán lắm."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_32
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_32"
msgid "Will it tell me my future?"
msgstr "Nó sẽ nói cho tớ biết tương lai chứ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_33
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_33"
msgid "Aw, I thought it was a real spider..."
msgstr "Ái chà, tớ cứ tưởng đó là một con nhện thật chứ..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_34
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_34"
msgid "Nothing bad ever happened from wishing on a monkey's paw!"
msgstr "Chẳng có chuyện gì xấu xảy ra khi ước nguyện với bàn tay khỉ đâu!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_35
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_35"
msgid "Looks like someone already drank it."
msgstr "Trông như có ai uống hết rồi ấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_36
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_36"
msgid "Those are just fakes, I want to see real vampire teeth!"
msgstr "Đấy chỉ là đồ giả thôi, tớ muốn xem răng nanh ma cà rồng thật cơ!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_37
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_37"
msgid "I hope the vampire's okay."
msgstr "Tớ mong là tên ma cà rồng đó vẫn ổn."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_38
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_38"
msgid "I can almost see into space with these!"
msgstr "Tớ suýt có thể nhìn thấu không gian bằng cái này đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_39
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_39"
msgid "I guess my hands can take turns."
msgstr "Chắc hai tay tớ phải luân phiên nhau làm việc rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_4
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_4"
msgid "Is it just me, or do his eyes follow me around?"
msgstr "Chỉ là tớ tưởng tượng thôi hay mắt của nó đang liếc theo tớ thật thế?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_40
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_40"
msgid "I don't know what we'd be measuring out here."
msgstr "Tớ chẳng biết ra đây để đo đạc cái gì nữa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_41
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_41"
msgid "Looks like a slime monster escaped."
msgstr "Trông giống như một con quái vật chất nhờn đã trốn thoát."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_42
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_42"
msgid "It looks like someone mashed two toys together."
msgstr "Trông như ai đó đã ném hai món đồ chơi vào nhau ấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_43
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_43"
msgid "Another toy that I'm way too mature for."
msgstr "Lại thêm một món đồ chơi mà tớ đã quá tuổi để chơi rồi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_44
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_44"
msgid "Huh. I can't find that plant in my handbook."
msgstr "Hả. Tớ không thể tìm thấy loài thực vật đó trong sổ tay của mình."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_45
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_45"
msgid "It doesn't pick up any of my favourite stations..."
msgstr "Nó không bắt được bất kỳ đài phát thanh ưa thích nào của tớ cả..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_46
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_46"
msgid "It looks like something from outer space."
msgstr "Trông nó giống như một thứ gì đó đến từ ngoài không gian."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_5
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_5"
msgid "I wonder if we'll ever explore outer space."
msgstr "Tự hỏi liệu chúng ta có bao giờ khám phá không gian bên ngoài không."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_6
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_6"
msgid "Uh oh, did the robot drop these?"
msgstr "Ôi không, có phải con robot đã làm rơi những thứ này không?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_7
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_7"
msgid "That's kid stuff."
msgstr "Trò trẻ con ấy mà."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_8
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_8"
msgid "I'm sure I'll find a use for it."
msgstr "Tớ chắc chắn mình sẽ tìm được cách dùng cho nó."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_9
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRINKET_9"
msgid "Never know when you'll need a spare button."
msgstr "Không biết khi nào bạn sẽ cần một cái nút dự phòng đâu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_FISH.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_FISH.BURNING"
msgid "The fire is off the-- well actually it's ON the scale, that's the problem!"
msgstr "Lửa đang bùng cháy quá... à thực ra là nó đang bốc cháy TRÊN cái cân, đó mới là vấn đề!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_FISH.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_FISH.BURNT"
msgid "What a waste of supplies."
msgstr "Thật phí phạm vật tư quá."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_FISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_FISH.GENERIC"
msgid "Just wait, that biggest fish badge will be mine!"
msgstr "Cứ đợi đấy, huy hiệu câu cá lớn nhất sẽ thuộc về tớ!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM"
msgid "Weight: {weight}\nCaught by: {owner}"
msgstr "Trọng lượng: {weight}\nĐược câu bởi: {owner}"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\nIt's almost as heavy as you, Woby!"
msgstr "Trọng lượng: {weight}\nĐược câu bởi: {owner}\nNó nặng gần bằng cậu đấy, Woby!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_FISH.OWNER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_FISH.OWNER"
msgid "I win! Where's my badge?\nWeight: {weight}\nCaught by: {owner}"
msgstr "Tớ thắng rồi! Huy hiệu của tớ đâu?\nTrọng lượng: {weight}\nĐược câu bởi: {owner}"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\nPretty impressive, huh Woby?"
msgstr "Trọng lượng: {weight}\nĐược câu bởi: {owner}\nKhá ấn tượng phải không Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING"
msgid "Hey! That's not a fire pit!"
msgstr "Này! Đó không phải lò lửa đâu!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT"
msgid "That's what happens when you don't practice fire safety."
msgstr "Đó là những gì xảy ra khi bạn không thực hành an toàn lửa đấy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC"
msgid "Is there a badge for growing the biggest vegetable?"
msgstr "Có huy hiệu nào cho việc trồng được loại rau củ lớn nhất không nhỉ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM"
msgid "Weight: {weight}\nHarvested on day: {day}\nPretty good!"
msgstr "Trọng lượng: {weight}\nThu hoạch vào ngày: {day}\nKhá tốt đấy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY"
msgid "Weight: {weight}\nHarvested on day: {day}\nWow, it's huge!"
msgstr "Trọng lượng: {weight}\nThu hoạch vào ngày: {day}\nỒ, nó lớn quá!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_LIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_LIGHT"
msgid "Er... it's not even registering on the scale..."
msgstr "Ơ... nó còn chẳng hiện lên trên cân nữa..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRUNKVEST_SUMMER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRUNKVEST_SUMMER"
msgid "Now we're both fuzzy, Woby!"
msgstr "Giờ thì cả hai chúng ta đều xù lông rồi đấy, Woby!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRUNKVEST_WINTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRUNKVEST_WINTER"
msgid "A warm nose cozy."
msgstr "Một chiếc ống ủ ấm chiếc mũi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRUNK_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRUNK_COOKED"
msgid "Thankfully booger-free. I think..."
msgstr "May mắn là không có gỉ mũi. Tớ nghĩ vậy..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRUNK_SUMMER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRUNK_SUMMER"
msgid "The fur's a little patchy."
msgstr "Bộ lông hơi bị lởm chởm một chút."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TRUNK_WINTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TRUNK_WINTER"
msgid "It's full of nose hair."
msgstr "Nó đầy lông mũi kìa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TUMBLEWEED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TUMBLEWEED"
msgid "It's just minding its own business."
msgstr "Nó chỉ đang tự lo việc của mình thôi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TURFCRAFTINGSTATION
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TURFCRAFTINGSTATION"
msgid "I think we might be tampering with something we don't understand."
msgstr "Tớ nghĩ chúng ta đang can thiệp vào một thứ mà mình không hiểu rõ."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_ARCHIVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_ARCHIVE"
msgid "A patch of ground."
msgstr "Một mảnh đất."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_BADLANDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_BADLANDS"
msgid "A patch of ground."
msgstr "Một mảnh đất."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_BEARD_RUG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_BEARD_RUG"
msgid "It has to be a monster, I'm sure I saw it twitching!"
msgstr "Nó phải là một con quái vật, tớ chắc chắn là mình thấy nó đang co giật!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_CARPETFLOOR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_CARPETFLOOR"
msgid "This reminds me of my living room back home."
msgstr "Cái này làm tớ nhớ đến phòng khách nhà mình ở quê."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_CARPETFLOOR2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_CARPETFLOOR2"
msgid "Some carpet."
msgstr "Vài tấm thảm."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_CAVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_CAVE"
msgid "A patch of... underground."
msgstr "Một mảnh đất... ở dưới lòng đất."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_CHECKERFLOOR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_CHECKERFLOOR"
msgid "A patch of ground."
msgstr "Một mảnh đất."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_COTL_BRICK
