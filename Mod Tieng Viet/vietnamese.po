msgstr "Bùm!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
