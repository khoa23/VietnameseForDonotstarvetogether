msgstr "Đó là quá mỏng manh để leo lên."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TWIGS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TWIGS"
