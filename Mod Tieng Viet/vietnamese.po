msgstr "Tôi muốn hơn một xu cho suy nghĩ của mình."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_COIN2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_COIN2"
