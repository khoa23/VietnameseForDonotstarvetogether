msgctxt "STRINGS.UI.PAUSEMENU.PAUSED_DST_SUBTITLE"
msgid "Seriously. It is!"
msgstr "Nghiêm túc. Nó đó!"

#. STRINGS.UI.PAUSEMENU.PAUSED_DST_TITLE
msgctxt "STRINGS.UI.PAUSEMENU.PAUSED_DST_TITLE"
msgid "Paused!"
msgstr "Đã tạm dừng!"

#. STRINGS.UI.PAUSEMENU.PAUSE_SERVER
msgctxt "STRINGS.UI.PAUSEMENU.PAUSE_SERVER"
msgid "Pause Server"
msgstr "Tạm dừng máy chủ"

#. STRINGS.UI.PAUSEMENU.PLAYERPAUSED_TEXT
msgctxt "STRINGS.UI.PAUSEMENU.PLAYERPAUSED_TEXT"
msgid "{player} paused the game."
msgstr "{player} đã tạm dừng trò chơi."

#. STRINGS.UI.PAUSEMENU.PLAYERSTATUSSCREEN
msgctxt "STRINGS.UI.PAUSEMENU.PLAYERSTATUSSCREEN"
msgid "View Players"
msgstr "Xem người chơi"

#. STRINGS.UI.PAUSEMENU.QUIT
msgctxt "STRINGS.UI.PAUSEMENU.QUIT"
msgid "Quit"
msgstr "Thoát"

#. STRINGS.UI.PAUSEMENU.QUITBODY
msgctxt "STRINGS.UI.PAUSEMENU.QUITBODY"
msgid "Leaving so soon?"
msgstr "Rời sớm vậy sao?"

#. STRINGS.UI.PAUSEMENU.QUITNO
msgctxt "STRINGS.UI.PAUSEMENU.QUITNO"
msgid "Never mind..."
msgstr "Không có gì..."

#. STRINGS.UI.PAUSEMENU.QUITTITLE
msgctxt "STRINGS.UI.PAUSEMENU.QUITTITLE"
msgid "Return to main menu?"
msgstr "Về màn hình chính?"

#. STRINGS.UI.PAUSEMENU.QUITYES
msgctxt "STRINGS.UI.PAUSEMENU.QUITYES"
msgid "I said quit!"
msgstr "Đã bảo là nghỉ mà!"

#. STRINGS.UI.PAUSEMENU.SAVEANDQUIT
msgctxt "STRINGS.UI.PAUSEMENU.SAVEANDQUIT"
msgid "Save and Quit"
msgstr "Lưu và Thoát"

#. STRINGS.UI.PAUSEMENU.SAVEANDQUITBODY
msgctxt "STRINGS.UI.PAUSEMENU.SAVEANDQUITBODY"
msgid "Don't worry. We'll wait here for you."
msgstr "Đừng lo lắng. Chúng tôi sẽ chờ ở đây cho bạn."

#. STRINGS.UI.PAUSEMENU.SAVEANDQUITNO
msgctxt "STRINGS.UI.PAUSEMENU.SAVEANDQUITNO"
msgid "Never mind..."
msgstr "Không có gì..."

#. STRINGS.UI.PAUSEMENU.SAVEANDQUITTITLE
msgctxt "STRINGS.UI.PAUSEMENU.SAVEANDQUITTITLE"
