msgstr "Trông dễ thương, nhưng vẫn chưa chín."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FRUITDRAGON.RIPE"
msgid "I think it's ripe now."
msgstr "Tôi nghĩ nó đã chín muồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "It's snoozing."
msgstr "Nó ngủ đông rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FRUITFLY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FRUITFLY"
