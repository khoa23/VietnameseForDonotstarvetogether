msgstr "Wolfgang không thích khuôn mặt ma quái này."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAST"
msgid "Wooden wind catcher!"
msgstr "Cái bắt gió bằng gỗ!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MASTUPGRADE_LAMP_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MASTUPGRADE_LAMP_ITEM"
msgid "Put fire up high. Is safer that way."
msgstr "Đặt lửa lên cao. Làm vậy an toàn hơn."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD"
msgid "Put fire up high. Is safer that way."
msgstr "Đặt lửa lên cao. Làm vậy an toàn hơn."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MASTUPGRADE_LAMP_YOTD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MASTUPGRADE_LAMP_YOTD"
msgid "Tiny fire beast will light the way."
msgstr "Con quái thú lửa tí hon sẽ soi đường dẫn lối."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM"
msgid "Is lightning trap."
msgstr "Là cái bẫy sét."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAST_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAST_ITEM"
msgid "Is for making big sail-stick."
msgstr "Dùng để làm cây cột buồm lớn."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAST_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAST_MALBATROSS"
msgid "Bird make good sail."
msgstr "Chim làm buồm tốt phết."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAST_MALBATROSS_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAST_MALBATROSS_ITEM"
msgid "Make good sail out of bird feathers!"
msgstr "Làm cánh buồm xịn từ lông chim nào!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAST_YOTD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAST_YOTD"
msgid "Wind works for Wolfgang!"
msgstr "Gió phải phục tùng Wolfgang!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAST_YOTD_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAST_YOTD_ITEM"
msgid "Is for making big sail-stick."
msgstr "Dùng để làm cây cột buồm lớn."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELL"
msgid "A fancy suit is no match for my muscles!"
msgstr "Bộ âu phục hào nhoáng chẳng thấm vào đâu so với cơ bắp của ta!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELLHEAD"
