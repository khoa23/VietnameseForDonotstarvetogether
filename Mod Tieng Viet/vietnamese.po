msgstr "Nó sẽ che đi khuôn mặt đẹp trai của Wolfgang."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MASK_TREEHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MASK_TREEHAT"
