#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTB_PATTERN_FRAGMENT_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTB_PATTERN_FRAGMENT_1"
msgid "'Tis but a fragment of a complete pattern."
msgstr "Đây chỉ là mảnh vỡ của một tấm họa tiết hoàn chỉnh."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTB_PATTERN_FRAGMENT_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTB_PATTERN_FRAGMENT_2"
