msgstr "Hừm. Đúng là cái cây rất kỳ lạ."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEYQUEEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEYQUEEN"
