msgstr "Cậu được tự do rồi!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MOONPOTION_FAILED"
msgid "Perhaps I didn't let it steep long enough..."
msgstr "Có lẽ tôi ngâm nó chưa đủ lâu..."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MOSQUITOS"
msgid "Aaah! Bug off!"
msgstr "Áaaa! Biến đi lũ sâu bọ!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "This beast seems to be wounded."
msgstr "Con thú này có vẻ bị thương rồi."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL"
msgid "Buzz off! We're not dead yet! Wait a minute, these ones are mutated."
msgstr "Biến đi! Chúng ta chưa chết đâu! Khoan đã, bọn này bị biến đổi gen rồi."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NODANGERGIFT"
msgid "I can't open presents with monsters about!"
msgstr "Tôi không thể mở quà khi có quái vật xung quanh được!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NODANGERSIESTA"
msgid "It's too dangerous to siesta right now!"
msgstr "Quá nguy hiểm để ngủ trưa lúc này!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NODANGERSLEEP"
msgid "I'm too scared of dying to sleep right now!"
msgstr "Tôi sợ chết khiếp nên chẳng dám ngủ lúc này đâu!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NODAYSLEEP"
msgid "It's too bright out."
msgstr "Trời sáng quá."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "I'm not tired."
msgstr "Tôi không mệt."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NOHUNGERSIESTA"
msgid "I'm too hungry for a siesta!"
msgstr "Tôi đói quá nên chẳng ngủ trưa được đâu!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NOHUNGERSLEEP"
msgid "I'm too hungry to sleep, my growling tummy will keep me up!"
msgstr "Tôi đói quá không ngủ nổi, cái bụng réo rắt này sẽ giữ tôi thức trắng mất!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NOINSPIRATION
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NOINSPIRATION"
msgid "only_used_by_wathgrithr"
msgstr "chỉ_được_sử_dụng_bởi_wathgrithr"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I should get off my beefalo first."
msgstr "Tôi nên xuống khỏi con Bò Lai trước đã."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NONIGHTSIESTA"
msgid "Night is for sleeping, not taking siestas."
msgstr "Ban đêm là để ngủ, chứ không phải để ngủ trưa."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "I don't think I could really relax down here."
msgstr "Tôi không nghĩ mình có thể thực sự thư giãn dưới này đâu."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NOPUMPKINCARVINGONFIRE
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NOPUMPKINCARVINGONFIRE"
msgid "This pumpkin is cooked."
msgstr "Quả bí ngô này chín nhừ rồi."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NORMALTOMIGHTY
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NORMALTOMIGHTY"
msgid "only_used_by_wolfang"
msgstr "chỉ_được_sử_dụng_bởi_wolfang"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NORMALTOWIMPY
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NORMALTOWIMPY"
msgid "only_used_by_wolfang"
msgstr "chỉ_được_sử_dụng_bởi_wolfang"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT"
msgid "only_used_by_wx78"
msgstr "chỉ_được_sử_dụng_bởi_wx78"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NOSLEEPONFIRE"
msgid "I don't exactly have a burning desire to sleep in that."
msgstr "Tôi không hề có chút ham muốn bốc cháy nào khi ngủ trong đó đâu."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NOTSKILLEDENOUGH
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NOTSKILLEDENOUGH"
msgid "only_used_by_wathgrithr"
msgstr "chỉ_được_sử_dụng_bởi_wathgrithr"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NOWARDROBEONFIRE"
msgid "I can't change while it's on fire!"
msgstr "Tôi không thể thay đồ khi nó đang cháy được!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NOWATERNEARBY
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NOWATERNEARBY"
msgid "only_used_by_waxwell_and_wicker"
msgstr "chỉ_được_sử_dụng_bởi_wicker"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NO_ABIGAIL_FLOWER
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NO_ABIGAIL_FLOWER"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_NO_TRAP"
msgid "Well, that was easy."
msgstr "Chà, dễ thật đấy."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "My casting needs work..."
msgstr "Kỹ năng thả câu của tôi cần luyện tập thêm..."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "It got away."
msgstr "Nó sổng mất rồi."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "Where are the fish?"
msgstr "Mấy con cá đi đâu hết rồi nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "Maybe I should find a better fishing spot."
msgstr "Có lẽ tôi nên tìm một chỗ câu cá tốt hơn."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "I thought there were supposed to be plenty of fish in the sea!"
msgstr "Tôi cứ tưởng dưới biển có rất nhiều cá chứ!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "I could be doing so many more scientific things right now..."
msgstr "Lẽ ra tôi có thể làm nhiều việc mang tính khoa học hơn vào lúc này..."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "All my hard work, gone in a snap!"
msgstr "M bao nhiêu công sức vất vả, bay biến trong chớp mắt!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "Maybe reeling would help."
msgstr "Có lẽ cuộn dây lại sẽ giúp ích đấy."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "Uh-oh. Sea monsters!"
msgstr "Ôi không. Quái vật biển kìa!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OFF_SCRIPT
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OFF_SCRIPT"
msgid "I have a feeling that wasn't in the script."
msgstr "Tôi có cảm giác việc đó không có trong kịch bản."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OTTERBOAT_DENBROKEN
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OTTERBOAT_DENBROKEN"
msgid "Getting rid of that den might have started a chain reaction..."
msgstr "Việc phá hủy cái tổ đó có thể đã châm ngòi cho một chuỗi phản ứng dây chuyền..."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS"
msgid "I've got a sinking feeling this should've stayed in the shallows."
msgstr "Tôi có linh cảm tồi tệ rằng lẽ ra thứ này nên ở lại vùng nước nông."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_PANFLUTE_BUFF_ACTIVE.1
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_PANFLUTE_BUFF_ACTIVE.1"
msgid "only_used_by_wortox"
msgstr "chỉ_được_sử_dụng_bởi_wortox"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_PANFLUTE_BUFF_USED.1
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_PANFLUTE_BUFF_USED.1"
msgid "only_used_by_wortox"
msgstr "chỉ_được_sử_dụng_bởi_wortox"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_PECKED"
msgid "Ow! Quit it!"
msgstr "Ái! Thôi ngay đi!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_PETRIFED_TREES"
msgid "Did I just hear trees screaming?"
msgstr "Có phải tôi vừa nghe thấy tiếng cây cối thét lên không?"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "Uh, is it supposed to smell like that?"
msgstr "Ơ, nó có mùi thế này á?"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_PIRATES_ARRIVE
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_PIRATES_ARRIVE"
msgid "That shanty can only mean one thing..."
msgstr "Tiếng hát đó chỉ báo hiệu một điều duy nhất..."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_PLANT_RANDOMSEED
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_PLANT_RANDOMSEED"
