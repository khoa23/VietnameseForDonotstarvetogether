msgstr "Một lượng kha khá tiền xu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_COIN3
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_COIN3"
