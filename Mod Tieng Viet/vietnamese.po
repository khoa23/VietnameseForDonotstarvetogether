msgstr "Nó nhẹ nhàng và bình yên đến lạ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROBIN_WINTER.GENERIC"
