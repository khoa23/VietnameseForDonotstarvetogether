msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.wall_hay_corn
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wall_hay_corn"
msgid "Amaze your friends with a maze of Maize Walls!"
msgstr "Làm bạn bè kinh ngạc với một mê cung tường bắp!"

#. STRINGS.SKIN_DESCRIPTIONS.wall_hay_cornitem
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wall_hay_cornitem"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.wall_moonrock_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wall_moonrock_victorian"
msgid "Stately and resplendent, like the moon itself."
msgstr "Uy nghi và rực rỡ, tựa như chính mặt trăng."

#. STRINGS.SKIN_DESCRIPTIONS.wall_moonrock_victorianitem
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wall_moonrock_victorianitem"
