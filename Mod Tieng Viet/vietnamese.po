#. STRINGS.SKIN_DESCRIPTIONS.wx78_scanner_catcoon
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_scanner_catcoon"
msgid "Curious as its namesake, only without the whiskers."
msgstr "Tò mò y như cái tên của nó, chỉ là không có ria mép."

