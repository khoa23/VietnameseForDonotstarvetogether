#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SKETCH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SKETCH"
msgid "What a nice drawing."
msgstr "Bản vẽ đẹp phết."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SKULLCHEST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SKULLCHEST"
msgid "Is that supposed to scare me?"
msgstr "Cứ tưởng thế mà dọa được ta chắc?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SLEEPBOMB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SLEEPBOMB"
msgid "An unethical weapon, plain and simple."
msgstr "Một thứ vũ khí phi đạo đức, đơn giản và rõ ràng thế thôi."

