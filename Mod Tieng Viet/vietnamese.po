msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_SAGEHAT"
msgid "I already mask my emotions."
msgstr "Tôi đã che giấu cảm xúc của mình rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_TOADYHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_TOADYHAT"
msgid "I already mask my emotions."
msgstr "Tôi đã che giấu cảm xúc của mình rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_TREEHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_TREEHAT"
msgid "To become someone else, even for a moment..."
msgstr "Trở thành một ai đó khác, dẫu chỉ trong chốc lát..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST"
msgid "If we sailed forever we would never reach the horizon."
msgstr "Nếu chúng ta cứ mãi giương buồm đi muôn nơi thì cũng chẳng bao giờ chạm tới đường chân trời."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LAMP_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LAMP_ITEM"
msgid "A meager light to combat the darkness."
msgstr "Một ánh sáng yếu ớt để chống lại bóng đêm."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD"
msgid "A meager light to combat the darkness."
msgstr "Một ánh sáng yếu ớt để chống lại bóng đêm."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LAMP_YOTD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LAMP_YOTD"
msgid "How long before that fire in your eyes goes out?"
msgstr "Còn bao lâu nữa thì ngọn lửa trong mắt ngươi mới tắt hẳn?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM"
msgid "Alas, being struck down by lightning is one less thing I can look forward too."
msgstr "Than ôi, bị sét đánh trúng là một trong những điều ít ỏi mà tôi có thể mong chờ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_ITEM"
msgid "It's for making a mast."
msgstr "Nó dùng để làm buồm tàu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_MALBATROSS"
msgid "Fly me away from this place."
msgstr "Hãy đưa tôi bay khỏi nơi này đi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_MALBATROSS_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_MALBATROSS_ITEM"
msgid "That's alright, I can manage it."
msgstr "Không sao đâu, tôi tự lo được mà."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_YOTD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_YOTD"
msgid "Maybe I could sail far away..."
msgstr "Biết đâu tôi có thể buồm đi thật xa..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_YOTD_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_YOTD_ITEM"
msgid "It's for making a mast."
msgstr "Nó dùng để làm buồm tàu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELL"
msgid "I feel a strange kinship with him."
msgstr "Tôi cảm thấy một sự tương đồng kỳ lạ với ông ấy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLHEAD"
msgid "He sure has a taste for the dramatic."
msgstr "Ông ta quả thực rất thích sự kịch tính."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLLIGHT"
msgid "What a curious light."
msgstr "Thật là một ánh sáng tò mò."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLLOCK"
msgid "Looks magical."
msgstr "Trông có vẻ ma thuật."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLPHONOGRAPH"
msgid "Shall we have a danse macabre?"
msgstr "Chúng ta có nên khiêu vũ tử thần không?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLTHRONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLTHRONE"
msgid "Not quite what I expected."
msgstr "Không hẳn như tôi mong đợi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEAT"
msgid "It is still bloody."
msgstr "Nó vẫn còn dính máu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATBALLS"
msgid "Balled meat. How exciting."
msgstr "Thịt vo viên. Thật hào hứng làm sao."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.BURNT"
msgid "It's done drying. Forever."
msgstr "Nó đã khô rồi. Vĩnh viễn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DONE"
msgid "The drying is over."
msgstr "Quá trình phơi khô đã kết thúc."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DONE_NOTMEAT"
msgid "The drying is over."
msgstr "Quá trình phơi khô đã kết thúc."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DRYING"
msgid "It sways in the drying wind."
msgstr "Nó đung đưa trong cơn gió khô."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DRYINGINRAIN"
msgid "The rain is keeping it from drying."
msgstr "Cơn mưa đang ngăn cản nó khô lại."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT"
msgid "The rain is keeping it from drying."
msgstr "Cơn mưa đang ngăn cản nó khô lại."

