msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MITEGLAND_DEBUFF_DONE"
msgid "That is one experiment I don't want to re-heat."
msgstr "Đó là một thí nghiệm mà tôi không bao giờ muốn hâm nóng lại lần nữa."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MONKEY_CURSE_1
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MONKEY_CURSE_1"
