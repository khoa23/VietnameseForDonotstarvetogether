msgstr "Khô queo và giòn rụm. Làm củi tốt đây!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLAYBILL_THE_DOLL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLAYBILL_THE_DOLL"
