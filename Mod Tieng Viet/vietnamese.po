msgstr "Chào! Bạn trông ngon quá!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KOALEFANT_WINTER"
msgid "Hey! You look tasty!"
msgstr "Chào! Bạn trông ngon quá!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KOALEFIG_TRUNK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KOALEFIG_TRUNK"
