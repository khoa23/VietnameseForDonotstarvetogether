msgstr "Brrr ... tóc nhện không phải là rất ấm áp."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COMPASS_OUT"
msgid "Uh oh, I broke it."
msgstr "Ờ, tôi làm vỡ nó rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COZY_SLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COZY_SLEEP"
