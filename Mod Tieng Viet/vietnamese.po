#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL.LEVEL2.2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL.LEVEL2.2"
msgid "Awww, she has a cute little bow."
msgstr "Ơ, cô ấy có một chút nơ dễ thương."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL.LEVEL3.1
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL.LEVEL3.1"
msgid "Awww, she has a cute little bow."
msgstr "Ơ, cô ấy có một chút nơ dễ thương."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL.LEVEL3.2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL.LEVEL3.2"
msgid "Awww, she has a cute little bow."
msgstr "Ơ, cô ấy có một chút nơ dễ thương."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "It's hauntingly beautiful."
msgstr "Nó rất đẹp."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "I'd die to find out what it does."
msgstr "Tôi sẽ chết để tìm hiểu những gì nó làm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "I don't think I should hang on to this."
msgstr "Tôi không nghĩ mình nên tiếp tục chuyện này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "Do you need some alone time?"
msgstr "Bạn có cần một chút thời gian một mình?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "I think she's starting to open up to us."
msgstr "Tôi nghĩ rằng cô ấy bắt đầu mở lòng với chúng tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "Looks like someone's feeling especially spirited today!"
msgstr "Trông có vẻ như cảm giác của ai đó đặc biệt hăng hái trong hôm nay!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "It hurts my soul to look at that thing."
msgstr "Nó làm đau tâm hồn tôi khi nhìn vào thứ đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "It's giving me the creeps."
msgstr "Nó làm tôi sợ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "Something is up with that flower!"
msgstr "Điều gì đã xảy ra với bông hoa đó!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED"
msgid "How unoriginal!"
msgstr "Thật không nguyên bản!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABYSSPILLAR_MINION.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABYSSPILLAR_MINION.GENERIC"
msgid "I'm glad it's just a statue."
msgstr "Tôi mừng vì nó chỉ là một bức tượng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABYSSPILLAR_TRIAL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABYSSPILLAR_TRIAL"
msgid "I've got some pull around here."
msgstr "Tôi có một số lực kéo quanh đây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "I want to use it, and I want the world to know that I did."
msgstr "Tôi muốn sử dụng nó, và tôi muốn thế giới biết rằng tôi đã làm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ACORN"
msgid "There's definitely something inside there."
msgstr "Có chắc chắn là một cái gì đó bên trong đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ACORN_COOKED"
msgid "Roasted to perfection."
msgstr "Rang để hoàn thiện."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ACORN_SAPLING"
msgid "It'll be a tree soon!"
msgstr "Nó sẽ là một cây sớm!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ADVENTURE_PORTAL"
msgid "I'm not sure I want to fall for that a second time."
msgstr "Tôi không chắc là tôi muốn rơi cho rằng một lần thứ hai."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIANHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIANHAT"
msgid "It shows me infinite possibilities..."
msgstr "Nó cho tôi thấy khả năng vô hạn..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIANHATSHARD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIANHATSHARD"
msgid "Even a single piece is pretty illuminating!"
msgstr "Ngay cả một mảnh duy nhất cũng khá sáng sủa!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_CONTAINED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_CONTAINED"
msgid "It's draining the energy right out of that monster!"
msgstr "Nó đang hút cạn năng lượng của con quái vật đó!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD"
msgid "Gotcha!"
msgstr "Bắt được rồi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC"
msgid "You'll pay for breaking all that science!"
msgstr "Bạn sẽ phải trả giá cho việc phá vỡ tất cả công trình khoa học đó!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT"
msgid "You look the same but different."
msgstr "Bạn trông giống nhau nhưng khác nhau."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT"
msgid "This must be the one he wants."
msgstr "Đây chắc hẳn là thứ anh ấy muốn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD"
msgid "This time I'm sure I got it."
msgstr "Lần này tôi chắc chắn mình đã hiểu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC"
msgid "I think I just made it angry..."
msgstr "Tôi nghĩ tôi vừa làm nó tức giận.."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE"
msgid "You've made your point!"
msgstr "Bạn đã đưa ra quan điểm của mình!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE3
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE3"
msgid "It's definitely angry now!"
msgstr "Bây giờ chắc chắn là nó đang tức giận!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD"
msgid "Maybe someone should go poke it... just to be sure."
msgstr "Có lẽ ai đó nên tới chọc nó... để chắc chắn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB"
msgid "Is it dead? That strange energy still seems to be lingering around it."
msgstr "Nó chết rồi à? Năng lượng kỳ lạ đó dường như vẫn còn vương vấn xung quanh nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP"
msgid "After rigorous testing, I can confirm that they make me want to take a nap."
msgstr "Sau khi kiểm tra nghiêm ngặt, tôi có thể xác nhận rằng chúng khiến tôi muốn chợp mắt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT"
msgid "Haven't you broken enough science?!"
msgstr "Bạn vẫn chưa phá vỡ đủ khoa học sao?!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.AMULET"
msgid "I feel so safe when I get to wear it."
msgstr "Tôi cảm thấy an toàn khi tôi mặc nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCHOR"
msgid "I wouldn't want my boat to float away."
msgstr "Tôi sẽ không muốn thuyền của mình trôi đi đâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCHOR_ITEM"
msgid "Now I can build an anchor."
msgstr "Bây giờ mình có thể xây dựng một mỏ neo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTFRUIT_GEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "Hot and fresh off the tree."
msgstr "Nóng và tươi mới từ cây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "I just wish it was less... twitchy."
msgstr "Tôi chỉ ước gì nó ít... giật mình hơn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "At least it stopped twitching."
msgstr "Ít nhất là nó ngừng giật mình."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
msgid "It's vegetable AND mineral. Fascinating."
msgstr "Nó vừa là rau vừa là khoáng sản. Thật là thú vị."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTTREE_GEM.STUMP"
msgid "This tree has been mined."
msgstr "Cây này đã bị khai thác."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
msgid "Tree-t with caution."
msgstr "Hãy cẩn thận với cây này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
msgid "It's a stump."
msgstr "Đó là một gốc cây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
msgid "It's growing! I think?"
msgstr "Nó đang phát triển! Tôi nghĩ là vậy?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON"
msgid "It seems like it fits in, but it's not yet ready to grow."
msgstr "Dường như nó phù hợp, nhưng chưa sẵn sàng để phát triển."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE"
msgid "I don't think it's getting the required nutrients here."
msgstr "Tôi nghĩ là nó không nhận được dinh dưỡng cần thiết ở đây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTTREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTTREE_SAPLING_ITEM"
msgid "I need to plant this in the right place."
msgstr "Tôi cần trồng nó vào đúng nơi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTTREE_SEED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENTTREE_SEED"
msgid "There are no surprises, only incomplete data."
msgstr "Không có bất ngờ nào, chỉ là dữ liệu chưa hoàn chỉnh."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENT_ALTAR"
msgid "An ancient and mysterious structure."
msgstr "Một cấu trúc cổ xưa và bí ẩn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "This seems to be broken."
msgstr "Điều này dường như bị phá vỡ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENT_HUSK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENT_HUSK"
msgid "Something bad happened here."
msgstr "Có điều gì đó tồi tệ đã xảy ra ở đây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANCIENT_STATUE"
msgid "It seems to throb out of tune with the world."
msgstr "Nó dường như tê rần ra giai điệu với thế giới."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANIMAL_TRACK"
msgid "Tracks left by food. I mean... an animal."
msgstr "Dấu vết để lại bởi thức ăn. Tôi có nghĩa là ... một con vật."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANTCHOVIES"
msgid "Yeesh. Can I toss it back?"
msgstr "Yeesh. Tôi có thể ném nó trở lại?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANTLION.GENERIC"
msgid "It wants something from me."
msgstr "Nó muốn một cái gì đó từ tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANTLION.UNHAPPY"
msgid "It looks mad."
msgstr "Có vẻ điên rồ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANTLION.VERYHAPPY"
msgid "I think we're on good terms."
msgstr "Tôi nghĩ chúng ta đang ở trong tình trạng tốt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANTLIONHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANTLIONHAT"
msgid "It's a groundbreaking scientific achievement."
msgstr "Đó là một thành tựu khoa học mang tính đột phá."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ANTLIONTRINKET"
msgid "Someone might be interested in this."
msgstr "Ai đó có thể quan tâm đến điều này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "You won't centimpede my progress!"
msgstr "Bạn sẽ không thể cản trở tiến triển của tôi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "A pile of old spare parts."
msgstr "Một đống phụ tùng cũ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "The pot got cooked."
msgstr "Các nồi đã nấu chín."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "This is going to take a while."
msgstr "Điều này sẽ mất một thời gian."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "It's almost done!"
msgstr "Nó gần như đã hoàn tất!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "Mmmmm! It's ready to eat!"
msgstr "Mmmmm! Nó đã sẵn sàng để ăn!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "Let's dust off this old crockery, shall we?"
msgstr "Hãy làm sạch cái nồi cũ này, được không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "Now how do I get the knowledge out?"
msgstr "Bây giờ làm thế nào để lấy kiến thức ra khỏi đó?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "I have the strongest urge to stand around it and talk about nothing in particular."
msgstr "Tôi có sự thôi thúc mạnh mẽ nhất là đứng xung quanh nó và không nói về điều gì cụ thể."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "If only there was a way to get it working again..."
msgstr "Giá như có cách nào đó để nó hoạt động trở lại ..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "These magnificent moon statues have me waxing poetic."
msgstr "Những bức tượng mặt trăng tráng lệ này khiến tôi trở nên thơ mộng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "It's like they made it puzzling on purpose."
msgstr "Có vẻ như họ cố tình làm nó khó hiểu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "Strange, the power is on but this isn't."
msgstr "Thật kỳ lạ, nguồn đã bật nhưng cái này thì không."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "Dead as a dead doornail."
msgstr "Chết như một con đinh đóng cửa. Ờm tức là nó khá tuyệt vọng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "Why use a map when you could use a mind-bogglingly complex piece of machinery?"
msgstr "Tại sao phải sử dụng bản đồ khi bạn có thể sử dụng một bộ máy phức tạp đến khó tin?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "It seems to have found everything worth finding."
msgstr "Dường như đã tìm thấy mọi thứ đáng tìm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "Aha! I used the secret knowledge to build a device! Why does this feel familiar..."
msgstr "Aha! Tôi đã sử dụng kiến thức bí mật để chế tạo một thiết bị! Sao cảm giác này quen quen..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "So much knowledge, if only I could read it!"
msgstr "Nhiều kiến thức quá, giá mà tôi có thể đọc được nó!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2"
msgid "These markings look different from the ones in the rest of the ruins."
msgstr "Những dấu hiệu này trông khác với những dấu hiệu ở phần còn lại của tàn tích."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3"
msgid "So much knowledge, if only I could read it!"
msgstr "Nhiều kiến thức quá, giá mà tôi có thể đọc được nó!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
msgid "These markings look different from the ones in the rest of the ruins."
msgstr "Những dấu hiệu này trông khác với những dấu hiệu ở phần còn lại của tàn tích."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
msgid "So much knowledge, if only I could read it!"
msgstr "Nhiều kiến thức quá, giá mà tôi có thể đọc được nó!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
msgid "It looks inviting."
msgstr "Nó trông có vẻ hấp dẫn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
msgid "Whatever it did, it's not doing it anymore."
msgstr "Dù nó đã làm gì thì nó cũng không làm nữa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_SECURITY_PULSE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_SECURITY_PULSE"
msgid "Where are you going? Someplace interesting?"
msgstr "Bạn đi đâu? Nơi nào đó thú vị?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_SWITCH.GEMS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_SWITCH.GEMS"
msgid "The socket is empty."
msgstr "Ổ cắm trống rỗng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_SWITCH.VALID
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARCHIVE_SWITCH.VALID"
msgid "Those gems seem to power it... through entirely scientific means, I'm sure."
msgstr "Những viên đá quý đó dường như cung cấp năng lượng cho nó... bằng những phương pháp hoàn toàn khoa học, tôi chắc chắn vậy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMORDRAGONFLY"
msgid "Hot mail!"
msgstr "Thư nóng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMORDREADSTONE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMORDREADSTONE"
msgid "Lightweight, sturdy, and snazzy!"
msgstr "Nhẹ, chắc chắn và sang trọng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMORGRASS"
msgid "Hopefully there aren't any bugs in it."
msgstr "Hy vọng rằng không có bất kỳ lỗi nào trong đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMORMARBLE"
msgid "That looks really heavy."
msgstr "Điều đó trông thực sự nặng nề."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMORRUINS"
msgid "It's oddly light."
msgstr "Đó là kỳ quặc ánh sáng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMORSKELETON"
msgid "No bones about it."
msgstr "Không có xương về nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMORSLURPER"
msgid "A soggy, sustaining, succulent suit."
msgstr "Một sũng nước, duy trì, phù hợp với mọng nước."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMORSNURTLESHELL"
msgid "It sticks to your back when you wear it."
msgstr "Nó dính vào lưng của bạn khi bạn mặc nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMORWAGPUNK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMORWAGPUNK"
msgid "Fearsome and gearsome."
msgstr "Chút sợ hãi và bánh răng"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMORWOOD"
msgid "That is a perfectly reasonable piece of clothing."
msgstr "Đó là một mảnh hoàn toàn hợp lý của quần áo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMOR_BRAMBLE"
msgid "The best offense is a good defense."
msgstr "Tấn công là cách phòng thủ tốt nhất."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMOR_CARROTLURE"
msgid "I like a tight-knit bunch."
msgstr "Tôi thích một nhóm gắn bó chặt chẽ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMOR_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMOR_LUNARPLANT"
msgid "This armor doesn't leaf any room for improvement."
msgstr "Bộ giáp này không còn chỗ để cải tiến."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMOR_LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMOR_LUNARPLANT_HUSK"
msgid "That'll put a thorn in your side."
msgstr "Điều đó sẽ đặt một cái gai vào bên cạnh bạn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMOR_SANITY"
msgid "Wearing that makes me feel safe and insecure."
msgstr "Mặc nó khiến tôi cảm thấy an toàn và không an toàn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMOR_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMOR_VOIDCLOTH"
msgid "Oh drat, there's a tear across the front!"
msgstr "Ôi chết tiệt, có một vết rách ở phía trước!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMOR_YOTH_KNIGHT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARMOR_YOTH_KNIGHT"
msgid "I'm saddled with questions."
msgstr "Tôi đang đau đầu với những câu hỏi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "\"Don't play with matches.\""
msgstr "\"Đừng chơi với các trận đấu.\""

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "It says \"Thataway\"."
msgstr "Nó nói \"Như vậy\"."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "The sign is currently blank."
msgstr "Các dấu hiện trống."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "\"Don't play with matches.\""
msgstr "\"Đừng chơi với các trận đấu.\""

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "It says \"Thataway\"."
msgstr "Nó nói \"Như vậy\"."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "The sign is currently blank."
msgstr "Các dấu hiện trống."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ASH.GENERIC"
msgid "All that's left after the fire has done its job."
msgstr "Tất cả những gì còn lại sau khi vụ cháy đã hoàn thành công việc của mình."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "The eyebone was consumed by fire in the teleportation!"
msgstr "Các eyebone đã được tiêu thụ bởi lửa trong dịch chuyển!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "The flower was consumed by fire in the teleportation!"
msgstr "Hoa được tiêu thụ bằng lửa trong dịch chuyển tức thời!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "There's a perfectly scientific explanation for that."
msgstr "Có một lời giải thích hoàn toàn khoa học cho điều đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ASPARAGUS"
msgid "A vegetable."
msgstr "Một loại rau."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ASPARAGUSSOUP"
msgid "Smells like it tastes."
msgstr "Mùi hệt như vị của nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ASPARAGUS_COOKED"
msgid "Science says it's good for me."
msgstr "Khoa học nói rang nó tốt cho tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ASPARAGUS_OVERSIZED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ASPARAGUS_OVERSIZED"
msgid "I guess we'll be eating asparagus for a while..."
msgstr "Tôi đoán chúng ta sẽ ăn măng tây một thời gian..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ASPARAGUS_SEEDS"
msgid "It's some seeds."
msgstr "Đó là một số hạt giống."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "It's gaining power."
msgstr "Nó đang tăng sức mạnh."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "It needs time to recover. Me too."
msgstr "Nó cần thời gian để phục hồi. Tôi cũng vậy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "The gateway is destabilizing."
msgstr "Cửa ngõ đang bất ổn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_GATE.OFF"
msgid "The essential components are still intact."
msgstr "Các thành phần thiết yếu vẫn còn nguyên vẹn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_GATE.ON"
msgid "Back in working order."
msgstr "Trở lại làm việc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_KEY"
msgid "There is power emanating from it."
msgstr "Có sức mạnh phát ra từ nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "Something must power it."
msgstr "Một cái gì đó phải quyền lực nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "A truly unsettling light."
msgstr "Một ánh sáng thực sự đáng lo ngại."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "I don't recognize any of these symbols."
msgstr "Tôi không nhận ra bất kỳ biểu tượng nào trong số này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "It depicts an old civilization. The people look hungry and scared."
msgstr "Nó mô tả một nền văn minh cũ. Mọi người trông đói và sợ hãi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "This tablet is too worn to make out."
msgstr "Máy tính bảng này quá mòn để tạo ra."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "Something dark creeps over the city and its people."
msgstr "Thứ gì đó đen tối trên thành phố và người dân của nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "The people are shedding their skins. They look different underneath."
msgstr "Mọi người đang lột da của họ. Chúng trông khác bên dưới."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "It shows a massive, technologically advanced city."
msgstr "Nó cho thấy một thành phố lớn, công nghệ tiên tiến."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ATRIUM_STATUE"
msgid "It doesn't seem fully real."
msgstr "Nó không có vẻ hoàn toàn thực tế."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.AXE"
msgid "A trusty axe."
msgstr "Một chiếc rìu đáng tin cậy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "Awwww. So cute!"
msgstr "Awwww. Thật dễ thương!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "Sweet dreams, smelly."
msgstr "Những giấc mơ ngọt ngào, có mùi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BACKPACK"
msgid "You could fit a whole lot of science in there."
msgstr "Bạn có thể phù hợp với rất nhiều khoa học trong đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BACONEGGS"
msgid "The perfect breakfast for a man of science."
msgstr "Bữa sáng hoàn hảo cho một người đàn ông khoa học."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BALATRO_MACHINE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BALATRO_MACHINE"
msgid "I'm game for a game."
msgstr "Tôi là trò chơi cho một trò chơi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BALLOON"
msgid "How are they floating?"
msgstr "Chúng nổi như thế nào?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BALLOONHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BALLOONHAT"
msgid "The static does terrible things to my hair."
msgstr "Tĩnh điện gây ra những điều khủng khiếp cho tóc của tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BALLOONPARTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BALLOONPARTY"
msgid "How did he get the smaller balloons inside?"
msgstr "Làm thế nào anh ấy có được những quả bóng bay nhỏ hơn bên trong?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BALLOONSPEED.DEFLATED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BALLOONSPEED.DEFLATED"
msgid "Now it's just another balloon."
msgstr "Bây giờ nó chỉ là một quả bóng khác."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BALLOONSPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BALLOONSPEED.GENERIC"
msgid "The hole in the center makes it more aerodynamic, that's just physics!"
msgstr "Cái lỗ ở giữa khiến nó có tính khí động học cao hơn, đó chỉ là vật lý mà thôi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BALLOONS_EMPTY"
msgid "It looks like clown currency."
msgstr "Nó trông giống như tiền tệ chú hề."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BALLOONVEST
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BALLOONVEST"
msgid "If the bright colors don't attract some horrible creature, the squeaking will."
msgstr "Nếu màu sắc tươi sáng không thu hút được sinh vật khủng khiếp nào đó thì tiếng rít sẽ thu hút."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BANANABUSH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BANANABUSH"
msgid "That bush is bananas!"
msgstr "Bụi cây đó là chuối!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BANANAJUICE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BANANAJUICE"
msgid "Makes me feel a bit rogueish."
msgstr "Làm cho tôi cảm thấy hơi phiêu lưu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BANANAPOP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BANANAPOP"
msgid "No, not brain freeze! I need that for science!"
msgstr "Không, đừng đóng băng não! Tôi cần điều đó cho khoa học!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BANDAGE"
msgid "Seems sterile enough."
msgstr "Có vẻ như đủ vô trùng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BANDAGE_BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BANDAGE_BUTTERFLYWINGS"
msgid "This bandage is really winging it."
msgstr "Băng này thực sự đang chắp cánh cho nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BARNACLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BARNACLE"
msgid "They don't look like knuckles to me."
msgstr "Chúng không trông giống như khớp ngón tay đối với tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BARNACLEPITA
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BARNACLEPITA"
msgid "Barnacles taste better when you can't see them."
msgstr "Hàu ngon hơn khi bạn không thể nhìn thấy chúng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BARNACLESTUFFEDFISHHEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BARNACLESTUFFEDFISHHEAD"
msgid "I'm just hungry enough to consider it..."
msgstr "Tôi chỉ đói đủ để xem xét nó..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BARNACLESUSHI
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BARNACLESUSHI"
msgid "I still seem to have misplaced my chopsticks."
msgstr "Dường như tôi vẫn đặt nhầm đũa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BARNACLE_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BARNACLE_COOKED"
msgid "I'm told it's quite a delicacy."
msgstr "Tôi được biết nó khá là ngon."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BARNACLINGUINE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BARNACLINGUINE"
msgid "Pass the pasta!"
msgstr "Chuyển tôi bát mì ống!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BASALT"
msgid "That's too strong to break through!"
msgstr "Đó là quá mạnh mẽ để vượt qua!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BAT"
msgid "Ack! That's terrifying!"
msgstr "Ack! Đó là đáng sợ!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATBAT"
msgid "I bet I could fly if I held two of them."
msgstr "Tôi cá là tôi có thể bay nếu tôi cầm hai người."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATCAVE"
msgid "I don't want to wake them."
msgstr "Tôi không muốn đánh thức họ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATHBOMB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATHBOMB"
msgid "It's just textbook chemistry."
msgstr "Nó chỉ là sách giáo khoa hóa học."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATNOSE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATNOSE"
msgid "Who knows whose nose this is?"
msgstr "Ai biết đây là cái mũi của ai không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATNOSEHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATNOSEHAT"
msgid "For hands-free dairy drinking."
msgstr "Để uống sữa không cần sử dụng tay."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATNOSE_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATNOSE_COOKED"
msgid "It came out smelling like a nose."
msgstr "Nó chảy ra có mùi như mũi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATTLESONG_CONTAINER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATTLESONG_CONTAINER"
msgid "Wow, it stores so many songs."
msgstr "Wow, nó lưu trữ rất nhiều bài hát."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATTLESONG_DURABILITY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATTLESONG_DURABILITY"
msgid "Theater makes me fidgety."
msgstr "Sân khấu làm tôi bồn chồn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATTLESONG_FIRERESISTANCE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATTLESONG_FIRERESISTANCE"
msgid "I once burned my vest before seeing a play. I call that dramatic ironing."
msgstr "Một lần tôi đã đốt cháy chiếc áo vest trước khi xem một vở kịch. Tôi gọi đó là việc ủi đồ đầy kịch tính."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATTLESONG_HEALTHGAIN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATTLESONG_HEALTHGAIN"
msgid "Theater makes me fidgety."
msgstr "Sân khấu làm tôi bồn chồn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATTLESONG_INSTANT_PANIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATTLESONG_INSTANT_PANIC"
msgid "I'm afraid I'm not a licensed poetic."
msgstr "Tôi e ngại rằng tôi không phải là một nhà thơ có bằng cấp."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATTLESONG_INSTANT_REVIVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATTLESONG_INSTANT_REVIVE"
msgid "It's a very lively tune."
msgstr "Đó là một giai điệu rất sống động."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATTLESONG_INSTANT_TAUNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATTLESONG_INSTANT_TAUNT"
msgid "I'm afraid I'm not a licensed poetic."
msgstr "Tôi e ngại rằng tôi không phải là một nhà thơ có bằng cấp."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATTLESONG_LUNARALIGNED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATTLESONG_LUNARALIGNED"
msgid "Theater makes me fidgety."
msgstr "Sân khấu làm tôi bồn chồn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATTLESONG_SANITYAURA
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATTLESONG_SANITYAURA"
msgid "Theater makes me fidgety."
msgstr "Sân khấu làm tôi bồn chồn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATTLESONG_SANITYGAIN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATTLESONG_SANITYGAIN"
msgid "Theater makes me fidgety."
msgstr "Sân khấu làm tôi bồn chồn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATTLESONG_SHADOWALIGNED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATTLESONG_SHADOWALIGNED"
msgid "Theater makes me fidgety."
msgstr "Sân khấu làm tôi bồn chồn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATWING"
msgid "I hate those things, even when they're dead."
msgstr "Tôi ghét những thứ đó, ngay cả khi họ chết."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BATWING_COOKED"
msgid "At least it's not coming back."
msgstr "Ít nhất là nó không quay trở lại."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEARDHAIR"
msgid "It's only gross when they're not your own."
msgstr "Nó chỉ thô khi chúng không phải của riêng bạn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEARGER"
msgid "What a bear of a badger."
msgstr "Thật là một con gấu của một con lửng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEARGERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEARGERCORPSE.BURNING"
msgid "That was close."
msgstr "Thật xuýt xoát."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEARGERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEARGERCORPSE.GENERIC"
msgid "What an unbearable stench!"
msgstr "Mùi khó chịu quá!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEARGERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEARGERCORPSE.REVIVING"
msgid "There must be a scientific explanation for this!"
msgstr "Phải có lời giải thích khoa học cho việc này!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEARGERFUR_SACK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEARGERFUR_SACK"
msgid "There's still fur on it. Chilling."
msgstr "Vẫn còn lông trên đó. Rùng mình."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEARGERVEST"
msgid "Welcome to the hibernation station!"
msgstr "Chào mừng bạn đến với trạm ngủ đông!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEARGER_FUR"
msgid "A mat of thick fur."
msgstr "Một tấm thảm lông dày."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEAST_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEAST_BLUEPRINT"
msgid "I'm feeling lucky about this one!"
msgstr "Tôi cảm thấy may mắn về điều này!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEDROLL_FURRY"
msgid "It's so warm and comfy."
msgstr "Thật ấm áp và thoải mái."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEDROLL_STRAW"
msgid "Looks comfy, but it smells like mildew."
msgstr "Trông thoải mái, nhưng nó có mùi như nấm mốc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEE.GENERIC"
msgid "To bee or not to bee."
msgstr "Để ong hay không để ong."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEE.HELD"
msgid "Careful!"
msgstr "Cẩn thận!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX.BURNT"
msgid "How did it get burned?!!"
msgstr "Làm thế nào nó được đốt cháy? !!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX.FULLHONEY"
msgid "It's full of honey."
msgstr "Nó đầy mật ong."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX.GENERIC"
msgid "Bees!"
msgstr "Ong!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX.NOHONEY"
msgid "It's empty."
msgstr "Nó trống rỗng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX.READY"
msgid "It's full of honey."
msgstr "Nó đầy mật ong."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "Need to wait a bit."
msgstr "Cần phải đợi một chút."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX_HERMIT.BURNT"
msgid "How did it get burned?!!"
msgstr "Làm thế nào nó được đốt cháy? !!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX_HERMIT.FULLHONEY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX_HERMIT.FULLHONEY"
msgid "It's full of honey."
msgstr "Nó đầy mật ong."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX_HERMIT.GENERIC"
msgid "I'm sure there's a little sweetness to be found inside."
msgstr "Tôi chắc rằng có một chút ngọt ngào được tìm thấy bên trong."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "It's empty."
msgstr "Nó trống rỗng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "It's full of honey."
msgstr "Nó đầy mật ong."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "Need to wait a bit."
msgstr "Cần phải đợi một chút."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO.DEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO.DEAD"
msgid "It was a tough one."
msgstr "Đó là một trận khó nhằn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO.DEAD_MYPARTNER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO.DEAD_MYPARTNER"
msgid "I hope we meat again."
msgstr "Tôi hy vọng chúng ta sẽ gặp lại nhau."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "This one is slightly less smelly than the others."
msgstr "Đây là một chút ít mùi hơn những người khác."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO.FOLLOWER"
msgid "He's coming along peacefully."
msgstr "Anh ấy đến cùng một cách hòa bình."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO.GENERIC"
msgid "It's a beefalo!"
msgstr "Đó là một beefalo!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO.MYPARTNER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO.MYPARTNER"
msgid "We're beef friends forever."
msgstr "Chúng tôi mãi mãi là bạn tốt của nhau!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO.NAKED"
msgid "Aww, he's so sad."
msgstr "Aww, cậu ấy rất buồn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO.ORNERY"
msgid "It looks deeply angry."
msgstr "Nó trông rất tức giận."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO.PUDGY"
msgid "Hmmm, there may be too much food inside it."
msgstr "Hmmm, có thể có quá nhiều thức ăn bên trong nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO.RIDER"
msgid "This fellow appears quite ridable."
msgstr "Đồng nghiệp này xuất hiện khá dễ dàng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO.SLEEPING"
msgid "These guys are really heavy sleepers."
msgstr "Những anh chàng này thường thường thực sự nặng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALOFEED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALOFEED"
msgid "None for me, thank you."
msgstr "không có gì cho tôi, cảm ơn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALOHAT"
msgid "That's a case of hat-hair waiting to happen."
msgstr "Đó là một trường hợp tóc mũ chờ đợi xảy ra."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALOTREAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALOTREAT"
msgid "A bit too grainy for my taste."
msgstr "Hơi nhiều hạt đối với khẩu vị của tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALOWOOL"
msgid "It smells like beefalo tears."
msgstr "Nó có mùi giống như nước mắt beefalo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO_GROOMER.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO_GROOMER.BURNT"
msgid "I styled my beefalo in the hottest fashions... and paid the price."
msgstr "Tôi đã tạo kiểu cho chú bò của mình theo phong cách thời trang cao cấp nhất... và đã trả tiền cho điều đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO_GROOMER.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO_GROOMER.GENERIC"
msgid "There's no beefalo here to groom."
msgstr "không có bé bò nào để được chải chuốt ở đây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO_GROOMER.OCCUPIED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO_GROOMER.OCCUPIED"
msgid "Let's beautify this beefalo!"
msgstr "Hãy làm đẹp bé bò này nào!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO_GROOMER_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEFALO_GROOMER_ITEM"
msgid "I'd better set this up somewhere."
msgstr "Tốt hơn là tôi nên thiết lập điều này ở đâu đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEF_BELL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEF_BELL"
msgid "It makes beefalo friendly. I'm sure there's a very scientific explanation."
msgstr "Nó làm cho bé bò trở nên thân thiện. Tôi chắc chắn có một lời giải thích rất khoa học."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEGUARD"
msgid "It's guarding the queen."
msgstr "Nó bảo vệ nữ hoàng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEHAT"
msgid "Protects your skin, but squashes your meticulous coiffure."
msgstr "Bảo vệ da của anh, nhưng thân anh cẩn thận cắt tóc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEHIVE"
msgid "It's buzzing with activity."
msgstr "Nó ù với hoạt động."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEMINE"
msgid "It buzzes when shaken."
msgstr "Nó rung lên khi run rẩy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEMINE_MAXWELL"
msgid "Bottled mosquito rage!"
msgstr "Đóng chai muỗi cơn thịnh nộ!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEQUEEN"
msgid "Keep that stinger away from me!"
msgstr "Giữ cái móc đó tránh xa tôi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "It's too sticky to walk on."
msgstr "Đó là quá dính để đi bộ trên."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "Was that there before?"
msgstr "Có phải trước đó?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "How in science did it get so big?!"
msgstr "Làm thế nào trong khoa học nó đã trở nên quá lớn?!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEESWAX"
msgid "Beeswax is a scientifically proven preservative!"
msgstr "Sáp ong là một chất bảo quản được chứng minh khoa học!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEESWAX_SPRAY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEESWAX_SPRAY"
msgid "Is that formaldehyde I smell?"
msgstr "Có phải tôi ngửi thấy mùi formaldehyde không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BEETLETAUR"
msgid "I can smell him from here!"
msgstr "Tôi có thể ngửi thấy mùi của anh ấy từ đây!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BELL"
msgid "Dingalingaling."
msgstr "Dingalingaling."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERNIE_ACTIVE"
msgid "That teddy bear is moving around. Interesting."
msgstr "Đó là con gấu bông đang di chuyển xung quanh. Hấp dẫn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERNIE_BIG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERNIE_BIG"
msgid "Remind me not to get on Willow's bad side."
msgstr "Hãy nhắc tôi đừng làm xấu mặt Willow."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "It finally fell apart."
msgstr "Nó cuối cùng cũng tan vỡ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "It's all scorched."
msgstr "Đó là tất cả cháy xém."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRIES"
msgid "Red berries taste the best."
msgstr "Quả mọng đỏ có vị ngon nhất."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRIES_COOKED"
msgid "I don't think heat improved them."
msgstr "Tôi không nghĩ rằng nhiệt độ được cải thiện chúng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRIES_JUICY"
msgid "Extra tasty, though they won't last long."
msgstr "Thêm ngon, mặc dù họ sẽ không kéo dài."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "Better eat them before they spoil!"
msgstr "Tốt hơn là ăn chúng trước khi chúng hư hỏng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH.BARREN"
msgid "I think it needs to be fertilized."
msgstr "Tôi nghĩ rằng nó cần phải được thụ tinh."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH.BURNING"
msgid "It's very much on fire."
msgstr "Nó rất nhiều lửa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH.DISEASED"
msgid "It looks pretty sick."
msgstr "Nó trông khá ốm yếu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH.DISEASING"
msgid "Err, something's not right."
msgstr "Err, có gì đó không đúng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH.GENERIC"
msgid "I think those are the edible kind."
msgstr "Tôi nghĩ đó là loại ăn được."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH.PICKED"
msgid "Maybe they'll grow back?"
msgstr "Có lẽ họ sẽ phát triển trở lại?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH.WITHERED"
msgid "Nothing will grow in this heat."
msgstr "Không gì có thể phát triển ở nhiệt độ này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "It won't make any berries in this state."
msgstr "Nó sẽ không thực hiện bất kỳ quả mọng ở trạng thái này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "It's very much on fire."
msgstr "Nó rất nhiều lửa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "It looks pretty sick."
msgstr "Nó trông khá ốm yếu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "Err, something's not right."
msgstr "Err, có gì đó không đúng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "I should leave them there until it's time to eat."
msgstr "Tôi nên để chúng ở đó cho đến lúc ăn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "The bush is working hard on the next batch."
msgstr "Bụi cây đang làm việc chăm chỉ trong đợt tiếp theo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "The heat even dehydrated the juicy berries!"
msgstr "Cái nóng thậm chí còn làm mất nước quả mọng ngon ngọt!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BERRYSAUCE"
msgid "Equal parts merry and berry."
msgstr "Hài hòa giữa niềm vui và quả mọng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIBINGKA
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIBINGKA"
msgid "Soft and spongy."
msgstr "Mềm và xốp."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIGFOOT"
msgid "That is one biiig foot."
msgstr "Đó là một chân biiig."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRCHNUTDRAKE"
msgid "A mad little nut."
msgstr "Một chút hạt điên."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRDCAGE.DEAD"
msgid "Maybe he's just resting?"
msgstr "Có lẽ anh ấy đang nghỉ ngơi?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRDCAGE.GENERIC"
msgid "Now it just needs a bird."
msgstr "Bây giờ nó chỉ cần một con chim."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "He's looking a bit peckish."
msgstr "Anh ta đang nhìn một chút đói bụng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "Who's a good bird?"
msgstr "Ai là một con chim tốt?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRDCAGE.SKELETON"
msgid "That bird is definitely deceased."
msgstr "Con chim đó chắc chắn đã qua đời."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "Awwww, he's asleep."
msgstr "Awwww, ông đang ngủ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRDCAGE.STARVING"
msgid "Has no one fed you in awhile?"
msgstr "Không có ai nuôi bạn trong một lúc?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRDCORPSE.BURNING"
msgid "That's what I call a firebird."
msgstr "Đó là thứ tôi gọi là chim lửa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRDCORPSE.GENERIC"
msgid "I call fowl."
msgstr "Tôi gọi gà."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRDCORPSE.REVIVING"
msgid "It's becoming a new species!"
msgstr "Nó đang trở thành một loài mới!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRDTRAP"
msgid "Gives me a net advantage!"
msgstr "Mang lại cho tôi một lợi thế ròng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRD_EGG"
msgid "A small, normal egg."
msgstr "Một nhỏ, trứng bình thường."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRD_EGG_COOKED"
msgid "Sunny side yum!"
msgstr "Nắng bên yum!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRD_MUTANT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRD_MUTANT"
msgid "I think that used to be a crow."
msgstr "Tôi nghĩ rằng trước đây nó từng là một con quạ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRD_MUTANT_SPITTER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRD_MUTANT_SPITTER"
msgid "I don't like the way it's looking at me..."
msgstr "Tôi không thích cách nó đang nhìn tôi..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BISHOP"
msgid "Back off, preacherman!"
msgstr "Trở lại tắt, preacherman!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Ow!"
msgstr "Ow!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BISHOP_NIGHTMARE"
msgid "It's falling apart!"
msgstr "Nó rơi xuống ngoài!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLACKFLAG"
msgid "Gentleman Pirate-Scientist does have a bit of a ring to it."
msgstr "Nhà khoa học kiêm cướp biển lịch lãm nghe cũng khá hay đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLOWDART_FIRE"
msgid "This seems fundamentally unsafe."
msgstr "Điều này dường như căn bản không an toàn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLOWDART_LAVA"
msgid "That's a weapon I could use from range."
msgstr "Đó là một vũ khí tôi có thể sử dụng từ tầm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLOWDART_LAVA2"
msgid "It uses a strong blast of air to propel a projectile."
msgstr "Nó sử dụng một vụ nổ mạnh mẽ của không khí để đẩy một đạn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLOWDART_PIPE"
msgid "Good practice for my birthday cake!"
msgstr "Thói quen tốt cho bánh sinh nhật của tôi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLOWDART_SLEEP"
msgid "Just don't breathe in."
msgstr "Chỉ cần không hít vào."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLOWDART_YELLOW"
msgid "It has shocking accuracy."
msgstr "Nó có độ chính xác gây sốc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUEAMULET"
msgid "Cool as ice!"
msgstr "Mát mẻ như băng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUEGEM"
msgid "It sparkles with cold energy."
msgstr "Nó lấp lánh với năng lượng lạnh."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUEMOONEYE"
msgid "It's always smart to keep an eye out."
msgstr "Nó luôn luôn thông minh để giữ một mắt ra."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUEPRINT.COMMON"
msgid "It's scientific!"
msgstr "Đó là khoa học!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUEPRINT.RARE"
msgid "It's REALLY scientific!"
msgstr "Nó thực sự khoa học!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUE_CAP"
msgid "It's weird and gooey."
msgstr "Đó là kỳ lạ và dính."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUE_CAP_COOKED"
msgid "It's different now..."
msgstr "Đó là khác nhau bây giờ..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "It's a mushroom."
msgstr "Đó là một cây nấm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "It's sleeping."
msgstr "Nó đang ngủ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "I wonder if it will come back?"
msgstr "Tôi tự hỏi nếu nó sẽ quay trở lại?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOARDS"
msgid "Boards."
msgstr "Bảng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOARON"
msgid "I can take him!"
msgstr "Tôi có thể đưa anh ta!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOARRIOR"
msgid "You sure are big!"
msgstr "Bạn chắc chắn là lớn!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATFRAGMENT03"
msgid "Not much left of it."
msgstr "Không còn nhiều trong nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATFRAGMENT04"
msgid "Not much left of it."
msgstr "Không còn nhiều trong nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATFRAGMENT05"
msgid "Not much left of it."
msgstr "Không còn nhiều trong nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATPATCH"
msgid "Just in case of disaster."
msgstr "Chỉ trong trường hợp thảm họa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATPATCH_KELP"
msgid "It'll have to do for now."
msgstr "Tạm thời thì nó cũng được."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "There's the checkpoint!"
msgstr "Kìa một cái checkpoint!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "One more thing to check off my list."
msgstr "Một điều nữa là kiểm tra danh sách của tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "Someone's shadowing me!"
msgstr "Có ai đó đang che dấu tôi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_SEASTACK"
msgid "Buoy oh buoy!"
msgstr "Phao ơi phao ơi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Buoy oh buoy!"
msgstr "Phao ơi phao ơi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "Buoy oh buoy!"
msgstr "Phao ơi phao ơi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "Buoy oh buoy!"
msgstr "Phao ơi phao ơi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "Its support is getting me all fired up!"
msgstr "Sự hỗ trợ của nó khiến tôi hứng khởi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_START"
msgid "You have to start somewhere."
msgstr "Bạn cần phải bắt đầu từ đâu đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "Where to start?"
msgstr "Điểm nào xuất phát?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "\"Cargo\" is sailor-lingo for \"stuff\"."
msgstr "\"Hàng hóa\" là thuật ngữ của thủy thủ để chỉ \"đồ vật\"."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "I guess I'm doing this the old-fashioned way."
msgstr "Tôi đoán là tôi đang làm việc theo cách cũ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_BUMPER_CRABKING"
msgid "It's my boat's crowning glory."
msgstr "Đó là vinh quang của chiếc thuyền của tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_BUMPER_CRABKING_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_BUMPER_CRABKING_KIT"
msgid "A soon-to-be boat bumper."
msgstr "Một bộ giảm sóc thuyền sắp thành hình."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_BUMPER_KELP"
msgid "It won't save the boat from everything, but it sure kelps."
msgstr "Nó không thể bảo vệ con thuyền khỏi mọi thứ, nhưng chắc chắn nó giúp ích được."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "A soon-to-be boat bumper."
msgstr "Sắp trở thành một lớp bảo vệ cho thuyền đây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "It gives the boat a little shellf defense."
msgstr "Nó mang lại một chút sự bảo vệ như lớp vỏ cho con thuyền."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "A soon-to-be boat bumper."
msgstr "Sắp trở thành một lớp bảo vệ cho thuyền đây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "When you mess with a dragon boat, you get the horns!"
msgstr "Khi bạn gây rối với thuyền rồng, bạn sẽ nhận được cú húc sừng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "A soon-to-be boat bumper."
msgstr "Một thứ sắp-trở-thành một chiếc thuyền điển hình."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "The cannon is ready to fire!"
msgstr "Pháo sẵn sàng bắn!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "I should load it with something."
msgstr "Tôi nên nạp nó với cái gì đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "I didn't forget the cannonballs, I'm just letting the anticipation build."
msgstr "Tôi không quên đạn pháo, tôi chỉ để mong đợi và hứng thú tăng lên một chút."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_CANNON_KIT"
msgid "It's not a cannon yet, but it will be."
msgstr "Nó chưa phải là một pháo, nhưng sẽ là một ngày không xa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_GRASS_ITEM"
msgid "It's technically a boat."
msgstr "Với mọi kĩ thuật, nó là cái thuyền."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_ITEM"
msgid "It would be nice to do some experiments on the water."
msgstr "Sẽ thật tuyệt khi làm một số thí nghiệm trên mặt nước."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_LEAK"
msgid "I should patch that up before we sink."
msgstr "Mình nên vá nó trước khi chúng ta chìm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "It's working!! Er, I knew it would work, of course."
msgstr "Nó đang hoạt động!! À, tôi biết nó sẽ hoạt động, tất nhiên rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "I'm always drawn to physics, like a... ah, can't think of the word."
msgstr "Tôi luôn hấp dẫn bởi vật lý, giống như một... à, không nghĩ ra từ ngữ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "Magnetism!"
msgstr "Magnetism! tức là tĩnh điện á!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "This will attract any strong magnets nearby."
msgstr "Điều này sẽ thu hút mọi từ  mạnh ở gần đây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_MAGNET_KIT"
msgid "One of my more genius ideas, if I do say so myself."
msgstr "Một trong những ý tưởng tài năng của tôi, nếu tôi được nói vậy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_ROTATOR"
msgid "Things are going in the right direction. Or maybe the left."
msgstr "Mọi thứ đang diễn ra theo hướng đúng. Hoặc có lẽ sang trái :)."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "I think I'll take it out for a spin."
msgstr "Tôi nghĩ rằng tôi sẽ đưa nó đi chơi một chút."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "If only it didn't also smell like a beefalo."
msgstr "Chỉ là nếu nó không còn mùi như một con bò đực."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BODYPILLOW_KELP"
msgid "It's soggier than I would like."
msgstr "Nó ẩm ướt hơn là tôi muốn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BODYPILLOW_PETALS"
msgid "At least it smells nicer than the beefalo pillow."
msgstr "Ít nhất, mùi của nó còn thơm hơn cái gối bò đực."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "Who would sleep on this?"
msgstr "Ai sẽ ngủ trên cái này?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOMB_LUNARPLANT"
msgid "Botany and chemistry, working together."
msgstr "Thực vật học và hóa học, cùng hợp tác với nhau."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "Our friend seems to be getting more in touch with his lunar roots."
msgstr "Dường như người bạn của chúng ta đang ngày càng kết nối nhiều hơn với nguồn gốc liên quan đến mặt trăng của mình."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BONESHARD"
msgid "Bits of bone."
msgstr "Các mảnh xương."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BONESOUP"
msgid "No bones about it, Warly can cook."
msgstr "Không có vấn đề gì với xương cả, Warly có thể nấu nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BONESTEW"
msgid "A stew to put some meat on your bones."
msgstr "Một món hầm để đặt một số thịt trên xương của bạn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOKSTATION.BURNT"
msgid "I think the library's closed."
msgstr "Tôi nghĩ rằng thư viện đã đóng cửa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOKSTATION.GENERIC"
msgid "Why study when I can experiment?"
msgstr "Tại sao phải học khi có thể thí nghiệm?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_BEES"
msgid "I don't get all the buzz around this one."
msgstr "Tôi không hiểu tại sao mọi người lại quan tâm nhiều đến cái này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_BIRDS"
msgid "No point studying when I can just wing it."
msgstr "Không có điểm học khi tôi có thể chỉ cần cánh nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_BRIMSTONE"
msgid "The beginning was dull, but got better near the end."
msgstr "Sự khởi đầu là ngu si đần độn, nhưng đã tốt hơn gần cuối."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_ELEMENTAL"
msgid "I can't make out the text."
msgstr "Tôi không thể làm ra văn bản."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_FIRE"
msgid "I don't feel a burning need to read it."
msgstr "Tôi không cảm thấy có sự ham muốn mãnh liệt để đọc nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_FISH"
msgid "It didn't really hook me."
msgstr "Nó thực sự không làm tôi say mê lắm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_FOSSIL"
msgid "This'll keep those monsters held for a little while."
msgstr "Điều này sẽ giữ những con quái vật đó trong một khoảng thời gian ngắn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_GARDENING"
msgid "I see no farm in reading that."
msgstr "Tôi không nhìn đến nông trại."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_HORTICULTURE"
msgid "I see no farm in reading that."
msgstr "Tôi không nhìn đến nông trại."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "It's about as exciting as watching grass grow."
msgstr "Nó thú vị không kém việc ngồi xem cỏ mọc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_LIGHT"
msgid "Whoever wrote this must've been pretty bright."
msgstr "Người viết cái này chắc chắn là một người khá thông thạo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "Brilliant!"
msgstr "Tuyệt vời!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_MOON"
msgid "All this interest in the moon is probably just a phase."
msgstr "Tất cả sự quan tâm này đối với mặt trăng có lẽ chỉ là một giai đoạn thôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_RAIN"
msgid "That doesn't sound very scientific."
msgstr "Điều đó nghe có vẻ không rất khoa học."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "Wickerbottom likes to do everything by the book."
msgstr "Wickerbottom thích làm mọi thứ theo quy tắc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_SILVICULTURE"
msgid "I'll stick to my own experiments."
msgstr "Tôi sẽ tuân theo những thí nghiệm của mình."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_SLEEP"
msgid "Strange, it's just 500 pages of telegraph codes."
msgstr "Lạ, nó chỉ là 500 trang của mã Telegraph."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_TEMPERATURE"
msgid "My thoughts on it are only lukewarm."
msgstr "Ý kiến của tôi về nó chỉ là ấm áp nhẹ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_TENTACLES"
msgid "Someone'll get suckered into reading this."
msgstr "Ai đó sẽ bị cuốn hút vào việc đọc thứ này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOK_WEB"
msgid "I'm not scared of spiders! I'm not!"
msgstr "Tôi không sợ nhện! Tôi không sợ!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOMERANG"
msgid "Aerodynamical!"
msgstr "Aerodynamical!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOOTLEG"
msgid "Somewhere out there, a pirate is missing their bootie."
msgstr "Ở đâu đó ngoài kia, một tên cướp biển đang thiếu bootie của họ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BROKEN_FORGEDITEM"
msgid "It's broken, but I think I could repair it."
msgstr "Nó bị hỏng, nhưng tôi nghĩ tôi có thể sửa được."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BROKEN_FUMAROLETOOLITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BROKEN_FUMAROLETOOLITEM"
msgid "If I get it hot enough, I could melt the pieces back together."
msgstr "Nếu tôi để nó đủ nóng, tôi có thể làm tan chảy các mảnh lại với nhau."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BRUSH"
msgid "I bet the beefalo really like this."
msgstr "Mình cá là những con bò thực sự thích việc này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUGNET"
msgid "For catching bugs."
msgstr "Đối với đánh bắt lỗi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "Welp. It's kelp."
msgstr "Welp. Đó là tảo bẹ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "I just couldn't kelp myself."
msgstr "Mình không thể tự trồng nó vào người."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BULLKELP_ROOT"
msgid "I can plant it in deep water."
msgstr "Mình có thể trồng thứ này ở vùng nước sâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUNDLE"
msgid "Our supplies are in there!"
msgstr "Nguồn cung cấp của chúng tôi là trong đó!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUNDLEWRAP"
msgid "Wrapping things up should make them easier to carry."
msgstr "Gói những thứ lên nên làm cho họ dễ dàng hơn để thực hiện."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUNNYMAN"
msgid "I am filled with an irresistible urge to do science."
msgstr "Tôi chứa đầy một sự thôi thúc không thể cưỡng lại để làm khoa học."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUNNYSTEW"
msgid "This one's luck has run out."
msgstr "May mắn của người này đã hết."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BURNT_MARSH_BUSH"
msgid "It's all burnt up."
msgstr "Đó là tất cả bị cháy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUSHHAT"
msgid "It's kind of scratchy."
msgstr "Đó là loại hỗn tạp."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUTTER"
msgid "I can't believe it's butter!"
msgstr "Tôi không thể tin rằng đó là bơ!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUTTERFLY.GENERIC"
msgid "Butterfly, flutter by."
msgstr "Bướm, rung bằng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUTTERFLY.HELD"
msgid "Now I have you!"
msgstr "Bây giờ tôi có bạn!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUTTERFLYMUFFIN"
msgid "We threw the recipe away and just kind of winged it."
msgstr "Chúng tôi đã ném các công thức đi và chỉ loại cánh nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUTTERFLYWINGS"
msgid "Without these, it's just a butter."
msgstr "Nếu không có những, nó chỉ là một bơ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUZZARD"
msgid "What a bizarre buzzard!"
msgstr "Thật là một diều hâu kỳ lạ!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUZZARDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUZZARDCORPSE.BURNING"
msgid "That's what I call a firebird."
msgstr "Đó là thứ tôi gọi là chim lửa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUZZARDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUZZARDCORPSE.GENERIC"
msgid "I call fowl."
msgstr "Tôi gọi gà."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUZZARDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BUZZARDCORPSE.REVIVING"
msgid "It's becoming a new species!"
msgstr "Nó đang trở thành một loài mới!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CABBAGEROLLS"
msgid "The meat hides inside the cabbage to avoid predators."
msgstr "Thịt ẩn bên trong bắp cải để tránh động vật ăn thịt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CACTUS.GENERIC"
msgid "Sharp but delicious."
msgstr "Sharp nhưng ngon."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CACTUS.PICKED"
msgid "Deflated, but still spiny."
msgstr "Xì hơi, nhưng vẫn có nhiều gai."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CACTUS_FLOWER"
msgid "A pretty flower from a prickly plant."
msgstr "Một bông hoa đẹp từ cây gai."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CACTUS_MEAT"
msgid "There are still some spines between me and a tasty meal."
msgstr "Hiện vẫn còn một số gai giữa tôi và một bữa ăn ngon."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "Grilled fruit of the desert."
msgstr "Trái sa mạc nướng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CALIFORNIAROLL"
msgid "But I don't have chopsticks."
msgstr "Nhưng tôi không có đũa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAMPFIRE.EMBERS"
msgid "That fire needs more fuel or it's going to go out."
msgstr "Ngọn lửa đó cần thêm nhiên liệu hay nó sẽ đi ra ngoài."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAMPFIRE.GENERIC"
msgid "Sure beats darkness."
msgstr "Chắc chắn nhịp đập bóng tối."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAMPFIRE.HIGH"
msgid "That fire is getting out of hand!"
msgstr "Ngọn lửa đó đang vượt ra khỏi tầm tay!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAMPFIRE.LOW"
msgid "The fire's getting a bit low."
msgstr "Ngọn lửa của nhận được một chút thấp."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAMPFIRE.NORMAL"
msgid "Nice and comfy."
msgstr "Tốt đẹp và thoải mái."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAMPFIRE.OUT"
msgid "Well, that's over."
msgstr "Vâng, đó là hơn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CANARY.GENERIC"
msgid "Some sort of yellow creature made of science."
msgstr "Một số loại sinh vật màu vàng làm bằng khoa học."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CANARY.HELD"
msgid "I'm not squishing you, am I?"
msgstr "Tôi không lừa anh, phải không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CANARY_POISONED"
msgid "It's probably fine."
msgstr "Nó có lẽ là tốt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CANDYBAG"
msgid "It's some sort of delicious pocket dimension for sugary treats."
msgstr "Đó là một số loại túi ngon kích thước cho có đường xử lý."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CANE"
msgid "Technically walking is just controlled falling."
msgstr "Về mặt kỹ thuật đi bộ chỉ là kiểm soát té ngã."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CANNONBALL_ROCK_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CANNONBALL_ROCK_ITEM"
msgid "This will fit into a cannon perfectly."
msgstr "Điều này sẽ vừa vặn hoàn hảo vào một khẩu pháo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALCANNON.COOLDOWN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALCANNON.COOLDOWN"
msgid "What a blast!"
msgstr "Một vụ nổ đúng nghĩa!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALCANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALCANNON.GENERIC"
msgid "This experiment blows up on purpose!"
msgstr "Thí nghiệm này nổ tung có mục đích!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALCANNON_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALCANNON_KIT"
msgid "I've got a lot of experience in making things explode."
msgstr "Tôi có rất nhiều kinh nghiệm trong việc làm mọi thứ bùng nổ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_BANNER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_BANNER"
msgid "I think all these shiny decorations reflect well on me."
msgstr "Tôi nghĩ tất cả những đồ trang trí sáng bóng này phản ánh tốt về tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_BANNER_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_BANNER_KIT"
msgid "I have to build it myself? I should have known there'd be a catch."
msgstr "Tôi phải tự xây dựng nó à? Tôi nên biết rằng sẽ có điều gì đó khó khăn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_EGGRIDE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_EGGRIDE"
msgid "I could watch it for hours."
msgstr "Tôi có thể xem nó trong nhiều giờ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT"
msgid "I hope this prize is all it's cracked up to be."
msgstr "Tôi hy vọng rằng giải thưởng này sẽ đúng như mọi người đang nói."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC"
msgid "I seem to be getting a lot of these..."
msgstr "Có vẻ như tôi đang nhận được rất nhiều cái này..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_FIGURE.RARE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_FIGURE.RARE"
msgid "See? Proof that trying the exact same thing over and over will eventually lead to success!"
msgstr "Thấy không? Chứng minh rằng cố gắng một điều giống hệt lần sau lần sẽ cuối cùng dẫn đến thành công!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON"
msgid "You don't see this kind of design too often."
msgstr "Bạn không thường xuyên thấy thiết kế kiểu này đâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_FIGURE_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_FIGURE_KIT"
msgid "The thrill of discovery!"
msgstr "Niềm hứng thú từ sự khám phá!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2"
msgid "The thrill of discovery!"
msgstr "Niềm hứng thú từ sự khám phá!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON3
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON3"
msgid "The thrill of discovery!"
msgstr "Sự hồi hộp của sự khám phá!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_LAMP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_LAMP"
msgid "It's powered by whimsy."
msgstr "Nó được vận hành bởi sự phù phiếm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_LAMP_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_LAMP_KIT"
msgid "Only some light work left to do."
msgstr "Chỉ còn lại một số công việc nhẹ nhàng để làm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_PLANT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_PLANT"
msgid "Either it's small, or I'm gigantic."
msgstr "Hoặc nó nhỏ bé, hoặc tôi khổng lồ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_PLANT_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALDECOR_PLANT_KIT"
msgid "Maybe it's a boxwood?"
msgstr "Có lẽ đó là một cây hoàng dương?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALFOOD_CORNTEA
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALFOOD_CORNTEA"
msgid "Is this drink supposed to be crunchy?"
msgstr "Is this drink supposed to be crunchy?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD"
msgid "I don't need to chew them up first, do I?"
msgstr "Tôi không cần phải nhai chúng trước, phải không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT"
msgid "This really is a pop-up carnival."
msgstr "Đây thực sự là một lễ hội pop-up."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST"
msgid "It's a little trapdoor."
msgstr "Đó là một cái cửa sập nhỏ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC"
msgid "It won't let me play until I give it something shiny."
msgstr "Nó không cho tôi chơi cho đến khi tôi cho nó thứ gì đó sáng bóng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING"
msgid "This looks like fun!"
msgstr "Trông có vẻ vui!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFBALL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFBALL"
msgid "I've seen you round here!"
msgstr "Tôi đã nhìn thấy bạn quanh đây!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFCLUB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFCLUB"
msgid "Putter up!"
msgstr "Đẩy lên!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_DIY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_DIY"
msgid "Hm, there must be a formula to the perfect mini-golf course."
msgstr "Hừm, phải có một công thức để có được một sân gôn mini hoàn hảo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_EASY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_EASY"
msgid "The physics should be forgiving here."
msgstr "Vật lý nên được tha thứ ở đây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_HARD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_HARD"
msgid "This may require more calculation."
msgstr "Điều này có thể yêu cầu tính toán nhiều hơn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_MEDIUM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_MEDIUM"
msgid "I'll give it a shot."
msgstr "Tôi sẽ thử."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFPROP_CUTOUT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFPROP_CUTOUT"
msgid "It's just in the way."
msgstr "Nó cản đường thôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFPROP_FAN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFPROP_FAN"
msgid "I'm not blown away by it."
msgstr "Tôi không bị choáng ngợp bởi nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFPROP_FENCE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFPROP_FENCE"
msgid "There's no getting around that."
msgstr "Không có cách nào khác được."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFPROP_MOVINGWALL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFPROP_MOVINGWALL"
msgid "The obstacle has its ups and downs."
msgstr "Trở ngại có những thăng trầm của nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFPROP_SPINNER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFPROP_SPINNER"
msgid "It's really turning things around."
msgstr "Nó thực sự đang xoay chuyển tình thế."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFPROP_SPRING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFPROP_SPRING"
msgid "And they say there's no such thing as a free launch!"
msgstr "Và họ nói rằng không có thứ gọi là ra mắt miễn phí!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFPROP_WORMHOLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLFPROP_WORMHOLE"
msgid "I wish I could study how the two ends connect, but it might be gross."
msgstr "Tôi ước mình có thể nghiên cứu cách hai đầu kết nối với nhau, nhưng nó có thể thô thiển."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLF_HOLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLF_HOLE"
msgid "I'll putt the ball right in there."
msgstr "Tôi sẽ ném bóng vào đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLF_HOLE_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLF_HOLE_KIT"
msgid "Where to end?"
msgstr "Kết thúc ở đâu?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLF_TEE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLF_TEE.GENERIC"
msgid "It needs a token to get this par-tee started!"
msgstr "Nó cần một mã thông báo để bắt đầu trò chơi này!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLF_TEE.INACTIVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLF_TEE.INACTIVE"
msgid "It's a hole issue."
msgstr "Đó là một vấn đề về lỗ hổng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLF_TEE.PLAYING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLF_TEE.PLAYING"
msgid "A game is in play."
msgstr "Một trò chơi đang diễn ra."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLF_TEE_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLF_TEE_KIT"
msgid "Where to begin?"
msgstr "Bắt đầu từ đâu?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_HERDING_CHICK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_HERDING_CHICK"
msgid "Come back here!"
msgstr "Lại đây!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_HERDING_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_HERDING_KIT"
msgid "This really is a pop-up carnival."
msgstr "Đây thực sự là một lễ hội pop-up."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC"
msgid "It won't let me play until I give it something shiny."
msgstr "Nó không cho tôi chơi cho đến khi tôi cho nó thứ gì đó sáng bóng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING"
msgid "Those eggs are looking a little runny."
msgstr "Những quả trứng đó có vẻ hơi chảy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC"
msgid "It's a little trapdoor."
msgstr "Đó là một cái cửa sập nhỏ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING"
msgid "Is this the right one?"
msgstr "Đây có phải là cái đúng không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_MEMORY_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_MEMORY_KIT"
msgid "This really is a pop-up carnival."
msgstr "Đây thực sự là một lễ hội pop-up."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC"
msgid "It won't let me play until I give it something shiny."
msgstr "Nó không cho tôi chơi cho đến khi tôi cho nó thứ gì đó sáng bóng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING"
msgid "Not to brag, but I've been called a bit of an egghead in the past."
msgstr "không phải khoe khoang đâu, nhưng trước đây tôi từng bị gọi là kẻ ngốc nghếch."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT"
msgid "This really is a pop-up carnival."
msgstr "Đây thực sự là một lễ hội pop-up."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC"
msgid "It won't let me play until I give it something shiny."
msgstr "Nó không cho tôi chơi cho đến khi tôi cho nó thứ gì đó sáng bóng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING"
msgid "Physics don't always work the same way twice."
msgstr "Vật lý không phải lúc nào cũng hoạt động theo cùng một cách hai lần."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC"
msgid "It won't let me play until I give it something shiny."
msgstr "Nó không cho tôi chơi cho đến khi tôi cho nó thứ gì đó sáng bóng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING"
msgid "Science compels me to press that big shiny button!"
msgstr "Khoa học buộc tôi phải nhấn cái nút lớn sáng bóng đó!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_SHOOTING_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_SHOOTING_KIT"
msgid "This really is a pop-up carnival."
msgstr "Đây thực sự là một lễ hội pop-up."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC"
msgid "It won't let me play until I give it something shiny."
msgstr "Nó không cho tôi chơi cho đến khi tôi cho nó thứ gì đó sáng bóng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING"
msgid "I could calculate the trajectory, but it involves a lot of complicated numbers and squiggles."
msgstr "Tôi có thể tính toán quỹ đạo, nhưng nó liên quan đến rất nhiều con số phức tạp và những đường ngoằn ngoèo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC"
msgid "It's a little trapdoor."
msgstr "Đó là một cái cửa sập nhỏ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING"
msgid "That target's really starting to bug me."
msgstr "Mục tiêu đó thực sự bắt đầu làm tôi khó chịu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT"
msgid "This really is a pop-up carnival."
msgstr "Đây thực sự là một lễ hội pop-up."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC"
msgid "It won't let me play until I give it something shiny."
msgstr "Nó không cho tôi chơi cho đến khi tôi cho nó thứ gì đó sáng bóng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING"
msgid "It turns out that spinning your wheels is actually very productive."
msgstr "Hóa ra việc quay bánh xe của bạn thực sự rất hiệu quả."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_BALL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_BALL"
msgid "It's genius in its simplicity."
msgstr "Nó xuất sắc trong sự đơn giản của nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_CROWKID
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_CROWKID"
msgid "Good day to you, small bird person."
msgstr "Chúc bạn một ngày tốt lành, chú chim nhỏ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_GAMETOKEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_GAMETOKEN"
msgid "One shiny token."
msgstr "Một chiếc token sáng bóng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_HOST
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_HOST"
msgid "What an odd fellow."
msgstr "Đúng là một đồng nghiệp kỳ quặc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_PLAZA.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
msgid "It doesn't really scream \"Cawnival\" yet, does it?"
msgstr "Nó vẫn chưa thực sự hét lên \"Lễ hạ chí\", phải không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
msgid "A little birdy told me it could use some more decorations around here."
msgstr "Một chú chim nhỏ nói với tôi rằng nó có thể sử dụng thêm một số đồ trang trí quanh đây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3"
msgid "This tree is caws for celebration!"
msgstr "Cây này được ca ngợi để ăn mừng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_PLAZA_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_PLAZA_KIT"
msgid "It's a scientifically proven fact that birds love trees."
msgstr "Một thực tế đã được khoa học chứng minh là chim rất thích cây cối."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC"
msgid "I've got my eyes on the prize. That one, over there!"
msgstr "Tôi đang để mắt đến giải thưởng. Cái đó, ở đằng kia!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT"
msgid "The real prize is the booth we made along the way."
msgstr "Giải thưởng thực sự là quán gian hàng chúng tôi tạo ra trên đường đi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC"
msgid "That's the ticket!"
msgstr "Đó là tấm vé!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK"
msgid "That's a lot of tickets!"
msgstr "Đó là đống vé!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
msgid "That's the tickets!"
msgstr "Đó là những tấm vé!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_SEEDPACKET"
msgid "I was feeling a bit peckish."
msgstr "Tôi cảm thấy hơi đói bụng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_VEST_A
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_VEST_A"
msgid "I think it makes me look adventurous."
msgstr "Tôi nghĩ rằng nó khiến tôi trông thật phiêu lưu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_VEST_B
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_VEST_B"
msgid "It's like wearing my own shade tree."
msgstr "Giống như đang mặc một cây bóng mát của riêng mình."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_VEST_C
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVAL_VEST_C"
msgid "I hope there's no bugs in it..."
msgstr "Tôi hy vọng là không có côn trùng gì bên trong nó..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARPENTRY_BLADE_MOONGLASS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARPENTRY_BLADE_MOONGLASS"
msgid "Razor-sharp, like my mind!"
msgstr "Sắc bén như trí óc của tôi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARPENTRY_STATION.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARPENTRY_STATION.BURNT"
msgid "It doesn't make furniture anymore."
msgstr "Nó không làm đồ nội thất nữa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARPENTRY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARPENTRY_STATION.GENERIC"
msgid "It makes furniture."
msgstr "Nó làm đồ nội thất."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARRAT.DEAD"
msgid "That's the end of that."
msgstr "Đó là kết thúc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARRAT.GENERIC"
msgid "Are carrots supposed to have legs?"
msgstr "Carrots có thể có chân à?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARRAT.HELD"
msgid "You're kind of ugly up close."
msgstr "Mày là loại xấu xí thân thiện."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARRAT.SLEEPING"
msgid "It's almost cute."
msgstr "Trông nó cũng dễ thương đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARRAT_GHOSTRACER"
msgid "That's... disconcerting."
msgstr "Đó là … bối rối that."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARROT"
msgid "Yuck. This vegetable came out of the dirt."
msgstr "Yuck. Loại rau này ra khỏi bụi bẩn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARROT_COOKED"
msgid "Mushy."
msgstr "Ủy mị."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARROT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARROT_OVERSIZED"
msgid "That's one big bunch of carrots!"
msgstr "Đó là một bó cà rốt lớn!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARROT_PLANTED"
msgid "The earth is making plantbabies."
msgstr "Trái đất đang làm plantbabies."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARROT_SEEDS"
msgid "It's a seed."
msgstr "Đó là một hạt giống."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "So much for that."
msgstr "Quá nhiều cho điều đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "Nothing but ash now."
msgstr "Không có gì ngoài tro."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "Now I can show everyone what I found!"
msgstr "Bây giờ tôi có thể hiển thị tất cả mọi người những gì tôi tìm thấy!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CATCOON"
msgid "A playful little thing."
msgstr "Một điều nhỏ vui tươi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CATCOONDEN.EMPTY"
msgid "Its owner ran out of lives."
msgstr "Chủ sở hữu của nó chạy ra khỏi cuộc sống."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CATCOONDEN.GENERIC"
msgid "It's a den in a stump."
msgstr "Đó là một cái hang ở một gốc cây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CATCOONHAT"
msgid "Ears hat!"
msgstr "Tai hat!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CATTOY_MOUSE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CATTOY_MOUSE"
msgid "Mice with wheels, what will science think up next?"
msgstr "Chuột với bánh xe, khoa học sẽ nghĩ ra điều gì tiếp theo nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "I think I can lift this one."
msgstr "Tôi nghĩ tôi có thể nâng cái này lên."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "It's out of reach."
msgstr "Đó là ngoài tầm với."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_BANANA"
msgid "It's mushy."
msgstr "Đó là ủy mị."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_BANANA_BURNT"
msgid "Not my fault!"
msgstr "Không phải lỗi của tôi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Yum!"
msgstr "Yum!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_BANANA_TREE"
msgid "It's dubiously photosynthetical."
msgstr "Đó là số biến photosynthetical."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_ENTRANCE"
msgid "I wonder if that rock could be moved."
msgstr "Tôi tự hỏi liệu tảng đá đó có thể di chuyển được không."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "I'll have to wait until someone leaves to enter."
msgstr "Tôi sẽ phải đợi cho đến khi một người nào đó rời đi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "The earth itself rejects me!"
msgstr "Bản thân trái đất từ chối tôi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "I bet there's all sorts of things to discover down there."
msgstr "Tôi đặt cược có tất cả mọi thứ để khám phá ở dưới đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "It's probably hiding something."
msgstr "Nó có thể che giấu điều gì đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_EXIT.FULL"
msgid "The surface is too crowded!"
msgstr "Bề mặt quá đông đúc!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "I'll just stay down here, I suppose."
msgstr "Tôi sẽ chỉ ở lại đây, tôi giả sử."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_EXIT.OPEN"
msgid "I've had enough discovery for now."
msgstr "Tôi đã có đủ phát cho bây giờ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_FERN"
msgid "It's a fern."
msgstr "Đó là một cây dương xỉ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_FERN_WITHERED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_FERN_WITHERED"
msgid "It's a withered fern."
msgstr "Đó là một cây dương xỉ khô héo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_VENT_MITE.DEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_VENT_MITE.DEAD"
msgid "Out of gas!"
msgstr "Hết xăng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_VENT_MITE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_VENT_MITE.GENERIC"
msgid "What mite it be?"
msgstr "Nó là con ve gì vậy?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_VENT_MITE.SLEEPING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_VENT_MITE.SLEEPING"
msgid "Careful, it mite wake up."
msgstr "Cẩn thận nó dậy đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_VENT_MITE.VENTING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_VENT_MITE.VENTING"
msgid "It's fuming mad!"
msgstr "Nó đang nổi điên!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_VENT_ROCK.GAS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_VENT_ROCK.GAS"
msgid "That's exhausting."
msgstr "Thật mệt mỏi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_VENT_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_VENT_ROCK.GENERIC"
msgid "I'm not sure which way it vent."
msgstr "Tôi không chắc nó thoát ra theo hướng nào."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_VENT_ROCK.HOT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_VENT_ROCK.HOT"
msgid "Things are really heating up."
msgstr "Mọi thứ đang thực sự nóng lên."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_VENT_ROCK.MIASMA
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CAVE_VENT_ROCK.MIASMA"
msgid "What about miasma?"
msgstr "Còn chướng khí thì sao?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CEILING_ROPE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CEILING_ROPE"
msgid "It's a climbing rope."
msgstr "Đó là một sợi dây leo núi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CEVICHE"
msgid "Can I get a bigger bowl? This one looks a little shrimpy."
msgstr "Tôi có thể được một cái bát lớn hơn không? Cái này trông nhỏ bé quá."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHARCOAL"
msgid "It's small, dark, and smells like burnt wood."
msgstr "Nó nhỏ, tối tăm, và mùi giống như gỗ bị cháy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHARLIERESIDUE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHARLIERESIDUE"
msgid "only_used_by_winona"
msgstr "chỉ_dùng_bởi_winona"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHARLIEROSE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHARLIEROSE"
msgid "only_used_by_winona"
msgstr "chỉ_dùng_bởi_winona"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHARLIE_HAND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHARLIE_HAND"
msgid "It wants something dreadful."
msgstr "Nó muốn cái gì đó đáng sợ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHARLIE_HECKLER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHARLIE_HECKLER"
msgid "They're just here to stir up drama."
msgstr "Họ chỉ đến đây để khuấy động kịch tính."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHARLIE_LECTURN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHARLIE_LECTURN"
msgid "Is someone doing a play?"
msgstr "Có ai đang diễn kịch không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHARLIE_NPC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHARLIE_NPC"
msgid "Wait, is that...?"
msgstr "Đợi đã, đó có phải là...?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHARLIE_STAGE_POST
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHARLIE_STAGE_POST"
msgid "It's a setup! It feels too... staged."
msgstr "Đó là một sự sắp đặt! Cảm giác quá... dàn dựng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSJUNK1"
msgid "A pile of broken chess pieces."
msgstr "Một đống quân cờ bị hỏng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSJUNK2"
msgid "Another pile of broken chess pieces."
msgstr "Một đống quân cờ bị hỏng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSJUNK3"
msgid "Even more broken chess pieces."
msgstr "Thậm chí nhiều hơn chia miếng đánh cờ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "It's as heavy as it looks."
msgstr "Nó nặng như vẻ ngoài của nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_ANTLION"
msgid "A stagn-antlion."
msgstr "Một con kiến sư tử bất động."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_BEARGER"
msgid "It was a lot bigger up close."
msgstr "Đó là rất lớn lên gần."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_BEARGER_MUTATED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_BEARGER_MUTATED"
msgid "Somehow it seems crankier than the real one."
msgstr "Dù sao đó cứ như là nó cáu kỉnh hơn bản gốc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_BEEFALO
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_BEEFALO"
msgid "This sculpture is pretty beefy."
msgstr "Bức tượng này khá mạnh mẽ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "Very statuesque."
msgstr "Rất đẹp như tượng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "It's a stone bishop."
msgstr "Đó là một giám mục bằng đá."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "The chess pieces are moving themselves!"
msgstr "Các quân cờ đang di chuyển!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "It looks nice, doesn't it?"
msgstr "Trông thật đẹp, phải không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_CARRAT"
msgid "We have a winner!"
msgstr "Chúng ta có người chiến thắng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_CATCOON"
msgid "It would probably make a great scratching post."
msgstr "Chắc chắn nó sẽ làm một cột cắn tuyệt vời."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "That thing's the leashed of my worries."
msgstr "Đó là thứ leashed lo lắng của tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "And I didn't even get eaten!"
msgstr "Và tôi thậm chí không nhận được ăn!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_CRABKING"
msgid "Still not as crabby as Maxwell."
msgstr "Vẫn không tồi tàn như Maxwell."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "Now he's off who-knows-were."
msgstr "Bây giờ anh ấy đi đâu chẳng biết."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_DAYWALKER2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_DAYWALKER2"
msgid "This belongs in a junkpile!"
msgstr "Cái này thuộc về một đống rác!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "It feels like its eye follows you."
msgstr "Nó cảm thấy như mắt của nó sau bạn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "This sculpture is a bit of an eyesore."
msgstr "Bức điêu khắc này hơi chướng mắt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_DEPTHWORM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_DEPTHWORM"
msgid "It's a worm, figures."
msgstr "Đó là một con sâu, số liệu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "Ah, that brings back memories. Bad ones."
msgstr "Ah, mà mang lại những kỷ niệm. Những cái xấu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "It's giving me a stony stare."
msgstr "Nó cho tôi một cái nhìn chằm chằm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_FORMAL"
msgid "Doesn't seem very \"kingly\" to me."
msgstr "Không có vẻ rất \"vương giả\" đối với tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "I much prefer it this way."
msgstr "Tôi rất thích nó theo cách này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "Makes my stomach rumble just looking at it."
msgstr "Làm cho dạ dày của tôi Rumble chỉ cần nhìn vào nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_KITCOON"
msgid "These ones are much easier to find."
msgstr "Những cái đó đều rất dễ để tìm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_KLAUS"
msgid "Can I invoke the \"no holiday decorations\" Klaus?"
msgstr "Tôi có thể triệu hồi Klaus \"không trang trí lễ hội\" không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "It's a horse, of course."
msgstr "Đó là một con ngựa, tất nhiên."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "The chess pieces are moving themselves!"
msgstr "Các quân cờ đang di chuyển!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "It's not so bad when it isn't trying to kill you."
msgstr "Nó không quá tệ khi mà nó không cố gắng để giết bạn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "I want to hug it, but the stone chafes."
msgstr "Tôi muốn ôm nó, nhưng hòn đá cứng quá."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "Now you're the one scared stiff!"
msgstr "Bây giờ đến lượt bạn sợ cứng rồi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_MOON"
msgid "I've been feeling pretty inspired lately."
msgstr "Gần đây tôi đã cảm thấy khá hứng khởi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "Eurgh. It's so lifelike."
msgstr "Eurgh. Nó thật sống động."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_MUSE"
msgid "Hmm... Looks familiar."
msgstr "Hmm ... Có vẻ quen thuộc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_PAWN"
msgid "I can relate."
msgstr "Tôi có thể có liên quan."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_PIPE"
msgid "That was never really my thing."
msgstr "Đó không phải là điều thực sự của tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "It's even heavier than it looks."
msgstr "Nó thậm chí còn nặng hơn nó trông."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "The chess pieces are moving themselves!"
msgstr "Các quân cờ đang di chuyển!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_SHARKBOI
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_SHARKBOI"
msgid "There's just some-fin about it."
msgstr "Có điều gì đó thật 'cá' biệt về nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_STALKER"
msgid "Exactly as stationary as a skeleton should be."
msgstr "Chính xác như một xác ướp nên có được, đứng yên không chuyển động."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "Not really a great stool though, is it?"
msgstr "Thực sự không phải là một chiếc ghế tốt, phải không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "That was a terrible night of very uncomfortable eye contact."
msgstr "Đó là một đêm kinh khủng với những ánh nhìn mắt không thoải mái."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD"
msgid "This one is short on height."
msgstr "Cái này thấp về chiều cao."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR"
msgid "I'm over the moon."
msgstr "Tôi đang ở trên mặt trăng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT"
msgid "Great design, questionable execution."
msgstr "Thiết kế tuyệt vời, thực hiện có vấn đề."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "It's just missing that horrible breath."
msgstr "Chỉ thiếu cái hơi thở kinh khủng đó thôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_WORMBOSS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_WORMBOSS"
msgid "It still shakes me up."
msgstr "Nó vẫn làm tôi rung động."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_YOTD"
msgid "Just the sight of it gets my heart racing!"
msgstr "Chỉ là cảnh tượng của nó khiến trái tym tôi thổn thức một cuộc đua!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_YOTH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_YOTH"
msgid "That was a rough knight."
msgstr "Đó là một con ngựa thô lỗ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_YOTS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESSPIECE_YOTS"
msgid "I usually try to stay away from gold diggers."
msgstr "Tôi thường cố gắng tránh xa những người đào vàng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESTER"
msgid "Otto von Chesterfield, Esq."
msgstr "Otto von Chesterfield, Esq."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "It's looking at me."
msgstr "Nó đang nhìn tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "It went to sleep."
msgstr "Nó đã đi vào giấc ngủ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "The laws of physics are surprisingly flexible."
msgstr "Các định luật vật lý linh hoạt một cách đáng ngạc nhiên."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHEST_MIMIC_REVEALED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHEST_MIMIC_REVEALED"
msgid "Horrible! Definitely horrible!"
msgstr "Kinh khủng! Chắc chắn là kinh khủng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CHUM"
msgid "It's a fish meal!"
msgstr "Đó là một bữa ăn với cá!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CLAYHOUND.GENERIC"
msgid "It's been unleashed!"
msgstr "Nó đã được tung ra!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CLAYHOUND.STATUE"
msgid "It looks so real."
msgstr "Nó trông rất thật."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CLAYWARG.GENERIC"
msgid "A terror cotta monster!"
msgstr "Một con quái vật bằng đất nung khủng bố!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CLAYWARG.STATUE"
msgid "Did it just move?"
msgstr "Nó chỉ di chuyển?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIRE.EMBERS"
msgid "That fire needs more fuel or it's going to go out."
msgstr "Ngọn lửa đó cần thêm nhiên liệu hay nó sẽ đi ra ngoài."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIRE.GENERIC"
msgid "Sure beats darkness."
msgstr "Chắc chắn nhịp đập bóng tối."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIRE.HIGH"
msgid "That fire is getting out of hand!"
msgstr "Ngọn lửa đó đang vượt ra khỏi tầm tay!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIRE.LOW"
msgid "The fire's getting a bit low."
msgstr "Ngọn lửa của nhận được một chút thấp."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIRE.NORMAL"
msgid "Nice and comfy."
msgstr "Tốt đẹp và thoải mái."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIRE.OUT"
msgid "Well, that's over."
msgstr "Vâng, đó là hơn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "I should put something on the fire before it goes out."
msgstr "Tôi nên đặt một cái gì đó trên ngọn lửa trước khi nó đi ra."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "Sure beats darkness."
msgstr "Chắc chắn nhịp đập bóng tối."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIREPIT.HIGH"
msgid "Good thing it's contained!"
msgstr "Điều tốt đó chứa!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIREPIT.LOW"
msgid "The fire's getting a bit low."
msgstr "Ngọn lửa của nhận được một chút thấp."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "Nice and comfy."
msgstr "Tốt đẹp và thoải mái."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLDFIREPIT.OUT"
msgid "At least I can start it up again."
msgstr "Ít nhất tôi có thể bắt đầu nó lên một lần nữa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COLLAPSEDCHEST"
msgid "The laws of physics have been bent and broken."
msgstr "Các định luật vật lý đã bị bẻ cong và phá vỡ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPASS.E"
msgid "East."
msgstr "Đông."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPASS.GENERIC"
msgid "Which way am I facing?"
msgstr "Cách mà tôi phải đối mặt?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPASS.N"
msgid "North."
msgstr "Bắc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPASS.NE"
msgid "Northeast."
msgstr "Đông Bắc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPASS.NW"
msgid "Northwest."
msgstr "Tây bắc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPASS.S"
msgid "South."
msgstr "Nam."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPASS.SE"
msgid "Southeast."
msgstr "Đông Nam."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPASS.SW"
msgid "Southwest."
msgstr "Tây nam."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPASS.W"
msgid "West."
msgstr "Tây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPOST"
msgid "Food for plants, and not much else."
msgstr "Thức ăn cho cây cỏ, và không nhiều hơn thế."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "Just right!"
msgstr "Đúng rồi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "I didn't think it could smell any worse..."
msgstr "Tôi không tin rằng nó mùi tệ đến mức vậy..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "Hm... too dry."
msgstr "Hm...khô quá."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "I can barrel-y stand the smell."
msgstr "Tôi gần như không thể chịu nổi mùi này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPOSTINGBIN.WET"
msgid "That looks too soggy."
msgstr "Nhìn nó ướt như chuột lột."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPOSTWRAP"
msgid "Wormwood offered me a bite, but I respectfully declined."
msgstr "Wormwood mời tôi cắn một cái, nhưng tôi trân trọng từ chối."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CONSTRUCTION_PLANS"
msgid "Stuff for science!"
msgstr "Nội dung cho khoa học!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKBOOK"
msgid "I've always been hungry for knowledge."
msgstr "Tôi đã luôn khao khát kiến thức."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKEDMANDRAKE"
msgid "Poor little guy."
msgstr "Người nghèo ít chàng trai."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKEDMEAT"
msgid "Charbroiled to perfection."
msgstr "Charbroiled để hoàn thiện."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKEDMONSTERMEAT"
msgid "That's only somewhat more appetizing than when it was raw."
msgstr "Đó là chỉ thêm một chút cảm giác ngon miệng hơn khi nó là thô."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKEDSMALLMEAT"
msgid "Now there's no reason to worry about getting worms!"
msgstr "Bây giờ không có lý do để lo lắng về việc nhận sâu!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKIECUTTER"
msgid "I don't like the way it's looking at my boat..."
msgstr "Mình không thích cách nó nhìn vào thuyền của mình ..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKIECUTTERHAT"
msgid "At least my hair will stay dry."
msgstr "Ít nhất tóc tôi sẽ khô."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKIECUTTERSHELL"
msgid "A shell of its former self."
msgstr "Một cái vỏ bao cả người nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "Science help me, I can't decipher this handwriting."
msgstr "Gíup tôi một tay với khoa hoc, tôi không giải thích được chữ viết tay này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKPOT.BURNT"
msgid "The pot got cooked."
msgstr "Các nồi đã nấu chín."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "This is going to take a while."
msgstr "Điều này sẽ mất một thời gian."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "It's almost done!"
msgstr "Nó gần như đã hoàn tất!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKPOT.DONE"
msgid "Mmmmm! It's ready to eat!"
msgstr "Mmmmm! Nó đã sẵn sàng để ăn!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOKPOT.EMPTY"
msgid "It makes me hungry just to look at it."
msgstr "Nó làm cho tôi đói chỉ để nhìn vào nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOLANT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COOLANT"
msgid "It's bubbling with possibility!"
msgstr "Nó đang sôi sục với khả năng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COONTAIL"
msgid "I think it's still swishing."
msgstr "Tôi nghĩ rằng nó vẫn vút."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CORN"
msgid "High in fructose!"
msgstr "Cao fructose!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CORN_COOKED"
msgid "Cooked and high in fructose!"
msgstr "Nấu chín và giàu fructose!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CORN_OVERSIZED"
msgid "What a big ear you have!"
msgstr "Cậu có cái bắp to ghê!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CORN_SEEDS"
msgid "It's a seed."
msgstr "Đó là một hạt giống."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "It's a blacksmith costume."
msgstr "Đó là một bộ trang phục thợ rèn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COSTUME_DOLL_BODY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COSTUME_DOLL_BODY"
msgid "It's a doll costume."
msgstr "Đó là một bộ trang phục búp bê."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COSTUME_FOOL_BODY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COSTUME_FOOL_BODY"
msgid "It's a fool's costume."
msgstr "Đó là một bộ trang phục của một kẻ ngốc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COSTUME_KING_BODY"
msgid "It's a King costume."
msgstr "Đó là một bộ trang phục vua."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "It's a costume."
msgstr "Đó là một bộ trang phục."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COSTUME_PRINCESS_BODY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COSTUME_PRINCESS_BODY"
msgid "Ignore the neigh-sayers."
msgstr "Hãy phớt lờ những người hàng xóm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "It's a Queen costume."
msgstr "Đó là một trang phục nữ hoàng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COSTUME_TREE_BODY"
msgid "It's a tree costume."
msgstr "Đó là một bộ trang phục cây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "It needs some fuel."
msgstr "Nó cần một chút nhiên liệu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "What a soothing light."
msgstr "Thật là một ánh sáng nhẹ nhàng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "It needs some fuel."
msgstr "Nó cần một chút nhiên liệu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "What an inspirational figure!"
msgstr "Thật là một nhân vật truyền cảm hứng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "It needs some fuel."
msgstr "Nó cần một chút nhiên liệu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "I could stare at it forever... and ever..."
msgstr "Tôi có thể nhìn nó mãi mãi... và mãi mãi..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COTL_TRINKET"
msgid "What a crowning achievement."
msgstr "Thành tựu vô cùng xuất sắc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COZY_BUNNYMAN"
msgid "They look so cozy."
msgstr "Chúng trông rất ấm cúng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRABKING.GENERIC"
msgid "Yikes! A little too crabby for me."
msgstr "Rất tiếc! Một chút quá tồi tệ đối với tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRABKING.INERT"
msgid "That castle needs a little decoration."
msgstr "Lâu đài đó cần một chút trang trí."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRABKING_CANNONTOWER"
msgid "I knew there was mortar these crabs."
msgstr "Tôi biết có thứ nguy hiểm trong đám cua này mà."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRABKING_CLAW"
msgid "That's claws for alarm!"
msgstr "Đó là móng vuốt để báo động!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRABKING_ICEWALL"
msgid "This is between me and the crab."
msgstr "Chuyện này chỉ giữa tôi và con cua thôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRABKING_MOB"
msgid "Crabby much?"
msgstr "Cua hoài vậy?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "This shell be quite the challenge."
msgstr "Cái mai này sẽ là một thử thách thực sự."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTERLAB"
msgid "Is there something in there?"
msgstr "Có gì trong đó không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_BULBIN"
msgid "You'd never do anything rotten, would you?"
msgstr "Bạn sẽ không bao giờ làm điều gì xấu xa phải không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_DRAGONLING"
msgid "It's wyrmed its way into my heart."
msgstr "Nó nhét vào tim tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_EETS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_EETS"
msgid "Behold, a man."
msgstr "Này, một người đàn ông."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "Always good to have another set of eyes! Er... eye."
msgstr "Luôn luôn tốt để có một bộ mắt khác! Ơ... mắt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_GLOMLING"
msgid "What an aerodynamical creature!"
msgstr "Thật là một sinh vật khí động học!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_KITTEN"
msgid "You'd make a good lab assistant."
msgstr "Bạn sẽ thực hiện một trợ lý phòng thí nghiệm tốt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_LAMB"
msgid "Much less mucusy than its momma."
msgstr "Mẹ của nó bị nhiều hơn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "I keep her around because she's good at mothematics."
msgstr "Mình giữ nó xung quanh vì nó giỏi về mẹ đẻ của nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_PERDLING"
msgid "My feathered friend."
msgstr "Người bạn lông của tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_PUPPY"
msgid "Pretty cute for a lil monster!"
msgstr "Khá dễ thương cho một quái vật Lil!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CROW.GENERIC"
msgid "Creepy!"
msgstr "Rùng mình!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CROW.HELD"
msgid "He's not very happy in there."
msgstr "Anh ấy không phải là rất hạnh phúc trong đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRUMBS"
msgid "A crummy way to hide yourself."
msgstr "Một cách khó khăn để che giấu bản thân."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "It seems harmless."
msgstr "Nó có vẻ vô hại."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CUTGRASS"
msgid "Cut grass, ready for arts and crafts."
msgstr "Cắt cỏ, sẵn sàng cho nghệ thuật và hàng thủ công."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CUTLESS"
msgid "What it lacks in slicing it makes up for in splinters."
msgstr "Những gì nó thiếu về sắc bén, nó đền bù bằng những sợi gai."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CUTLICHEN"
msgid "Nutritious, but it won't last long."
msgstr "Bổ dưỡng, nhưng nó sẽ không kéo dài lâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CUTREEDS"
msgid "Cut reeds, ready for crafting and hobbying."
msgstr "Sậy cắt, sẵn sàng để chế tác và làm theo sở thích."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CUTSTONE"
msgid "Seductively smooth."
msgstr "Quyến rũ trơn tru."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DAYWALKER.GENERIC"
msgid "Freeing him might not have been my best idea."
msgstr "Việc thả anh ấy có lẽ không phải là ý tưởng tốt nhất của tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "I feel almost sorry for him."
msgstr "Tôi cảm thấy gần như tiếc anh ấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DAYWALKER2.BURIED"
msgid "He's trapped under all that junk."
msgstr "Hắn ta bị kẹt dưới đống phế liệu đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DAYWALKER2.GENERIC"
msgid "Let's not upset him."
msgstr "Chúng ta đừng làm anh ấy khó chịu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "He seems upset."
msgstr "Anh ấy có vẻ khó chịu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "A pillar of impossibly hard stone."
msgstr "Một cột của loại đá khó tin là cứng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "There's something glinting inside the marble."
msgstr "Có điều gì đó lấp lánh bên trong viên thạch anh."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEADLYFEAST"
msgid "A most potent dish."
msgstr "Một món ăn mạnh nhất."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEAD_SEA_BONES"
msgid "That's what they get for coming up on land."
msgstr "Đó là những gì chúng nhận được khi đến đất liền."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "What a waste of wood."
msgstr "Thật là một sự lãng phí gỗ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "I feel like I could have prevented that."
msgstr "Tôi cảm thấy như tôi đã có thể ngăn chặn điều đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "Take that, nature!"
msgstr "Đi mà, thiên nhiên!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "It's all leafy. Most of the time."
msgstr "Đó là tất cả các lá. Hầu hết thời gian."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "It looks unhappy about me stealing those birchnuts!"
msgstr "Có vẻ không vui khi tôi ăn cắp những cây bạch dương đó!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECK_OF_CARDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECK_OF_CARDS"
msgid "Are we playing with a full deck?"
msgstr "Có phải chúng ta đang chơi với một bộ bài đầy đủ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECOR_CENTERPIECE"
msgid "How sophisticated."
msgstr "Thật tinh tế."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "A nice vase without any flowers."
msgstr "Một lọ hoa đẹp nhưng không có hoa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "It's nice to have a little light."
msgstr "Nó rất hay để có một ít ánh sáng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "A nice vase of flowers."
msgstr "Một lọ hoa đẹp."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "I know I told Maxwell to replace the bulb."
msgstr "Tôi biết tôi đã nói với Maxwell để thay thế bóng đèn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "Not looking very fresh."
msgstr "Trông nhìn không tươi cho lắm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECOR_LAMP"
msgid "A welcoming light."
msgstr "Ánh sáng chào đón."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "It's beautiful."
msgstr "Nó thật đẹp."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "I should draw something in this."
msgstr "Tôi nên vẽ một cái gì đó trong này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "Looking good!"
msgstr "Tìm kiếm tốt!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEER.ANTLER"
msgid "What an impressive antler!"
msgstr "Thật là một con kiến tạo ấn tượng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEER.GENERIC"
msgid "Is it staring at me? ...No, I guess not."
msgstr "Nó đang nhìn chằm chằm vào tôi à? ...Không tôi đoán là không."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEERCLOPS"
msgid "It's enormous!!"
msgstr "Đó là rất lớn !!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "Can't be too careful."
msgstr "không thể quá cẩn thận."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "It's over... right?"
msgstr "Nó kết thúc rồi... phải không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "I don't want to believe what my eyes are seeing!"
msgstr "Tôi không muốn tin những gì tôi đang thấy!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "How's that for an icy gaze?"
msgstr "Còn đây là cái nhìn lạnh lùng chưa?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "Someone lose an eye?"
msgstr "Ai đó mất một con mắt à?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "Stand back everyone, I am a trained scientist!"
msgstr "Lùi ra mọi người, tôi là một nhà khoa học đã được đào tạo!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "This is really gross."
msgstr "Đây thực sự là gộp."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEER_ANTLER"
msgid "Was that supposed to come off?"
msgstr "Đó có phải là để đi tắt?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEER_GEMMED"
msgid "It's being controlled by that beast!"
msgstr "Nó đang bị kiểm soát bởi con thú đó!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "It's probably a tuft of grass."
msgstr "Đây có thể là một chùm cỏ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DESERTHAT"
msgid "Quality eye protection."
msgstr "Chất lượng bảo vệ thị giác."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DESICCANT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DESICCANT"
msgid "Just dry and dry again!"
msgstr "Chỉ cần khô và khô lại!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DESICCANTBOOSTED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DESICCANTBOOSTED"
msgid "It leaves me high and dry!"
msgstr "Nó khiến tôi cao và khô!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEVTOOL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEVTOOL"
msgid "It smells of bacon!"
msgstr "Nó có mùi thịt xông khói!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEVTOOL_NODEV
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DEVTOOL_NODEV"
msgid "I'm not strong enough to wield it."
msgstr "Tôi không đủ mạnh để sử dụng nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DIRTPILE"
msgid "It's a pile of dirt... or IS it?"
msgstr "Đó là một đống bụi bẩn ... hoặc IS nó?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DIVININGROD.COLD"
msgid "The signal is very faint."
msgstr "Các tín hiệu là rất mờ nhạt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DIVININGROD.GENERIC"
msgid "It's some kind of homing device."
msgstr "Đó là một số loại thiết bị dẫn đường."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DIVININGROD.HOT"
msgid "This thing's going crazy!"
msgstr "Điều này đang trở nên điên rồ!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DIVININGROD.WARM"
msgid "I'm headed in the right direction."
msgstr "Tôi đang đứng đầu đúng hướng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DIVININGROD.WARMER"
msgid "Must be getting pretty close."
msgstr "Phải được nhận khá gần."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "I wonder what it does."
msgstr "Tôi tự hỏi những gì nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DIVININGRODBASE.READY"
msgid "It looks like it needs a large key."
msgstr "Có vẻ như nó cần một chìa khóa lớn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "Now the machine can work!"
msgstr "Bây giờ máy có thể làm việc!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DIVININGRODSTART"
msgid "That rod looks useful!"
msgstr "Thanh đó trông hữu ích!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DOCK_KIT"
msgid "Everything I need to build a dock for my boat."
msgstr "Tất cả mọi thứ tôi cần để xây dựng cho thuyền của tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "Aha! I thought the dock was missing something."
msgstr "Aha! Tui nghĩ bến tàu đang cần gì đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DOLL_BLUEPRINT"
msgid "My beefalo will look as cute as a button!"
msgstr "Bò lai của tôi nhìn trông thật cute như cái nút vậy!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONBOAT_KIT"
msgid "I'd better stop dragon my feet and build it."
msgstr "Tôi tốt hơn nên dừng trì hoãn và xây dựng nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONBOAT_PACK"
msgid "Boat building made easy!"
msgstr "Thuyền xây dựng thật dễ dàng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONBODYHAT"
msgid "I'm middling on this middle piece."
msgstr "Tôi đang trung gian trên mảnh giữa này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONCHILISALAD"
msgid "I hope I can handle the spice level."
msgstr "Mình hy vọng có thể xử lý mức độ gia vị."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONFLY"
msgid "That's one fly dragon!"
msgstr "Đó là một con ruồi rồng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "Next best thing to a lockbox!"
msgstr "Điều tốt nhất tiếp theo đối với một hộp khóa!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE"
msgid "The amount of storage is off the scale!"
msgstr "Dung lượng lưu trữ vượt quá quy mô!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "Produces a lot of heat, but not much light."
msgstr "Sản xuất rất nhiều nhiệt, nhưng không nhiều ánh sáng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "I don't think it's supposed to look like that."
msgstr "Tôi không nghĩ nó trông như thế."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "It's scalding!"
msgstr "Đó là mở rộng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "Is it winking at me?"
msgstr "Nó đang nháy mắt với tôi?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONFRUIT"
msgid "What a weird fruit."
msgstr "Thật là một kỳ lạ trái cây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "The fruit's still weird."
msgstr "Quả vẫn còn lạ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "I half expect it to sprout wings."
msgstr "Tôi nửa mong đợi nó sẽ nảy mọc cánh."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "It's a seed."
msgstr "Đó là một hạt giống."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONHEADHAT"
msgid "So who gets to be the head?"
msgstr "Vậy ai sẽ là người đứng đầu?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONPIE"
msgid "The dragonfruit is very filling."
msgstr "Thanh long là rất đầy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGONTAILHAT"
msgid "Someone has to bring up the rear."
msgstr "Có người phải đưa lên phía sau."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRAGON_SCALES"
msgid "They're still warm."
msgstr "Chúng vẫn còn ấm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DREADSTONE"
msgid "It seems to reflect shadows instead of light."
msgstr "Nó có vẻ phản ánh bóng tối thay vì ánh sáng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DREADSTONEHAT"
msgid "To keep my brilliant brain safe and sound."
msgstr "Để bảo vệ tinh thần sáng tạo của tôi an toàn và nguyên vẹn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DREADSTONE_STACK"
msgid "It's coming from deep down in those chasms..."
msgstr "Nó đến từ sâu thẳm trong sự hỗn mang đó..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRIFTWOOD_LOG"
msgid "It floats on water."
msgstr "Nó trôi nổi trên nước."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "That driftwood's burning!"
msgstr "Thứ đó đang cháy!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "Doesn't look very useful anymore."
msgstr "Trông có vẻ như chẳng còn hữu dung."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "There might still be something worth digging up."
msgstr "Vẫn có thể có một cái gì đó đáng để đào lên."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "A dead tree that washed up on shore."
msgstr "Một cái cây chết dạt vào bờ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRUMSTICK"
msgid "Ready for gobbling."
msgstr "Sẵn sàng cho lắc lư."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DRUMSTICK_COOKED"
msgid "Even better for gobbling!"
msgstr "Thậm chí còn hơn ăn thịt!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUG_BANANABUSH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUG_BANANABUSH"
msgid "That bush is bananas!"
msgstr "Bụi cây đó là chuối!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUG_BERRYBUSH"
msgid "Now it can be taken anywhere."
msgstr "Bây giờ nó có thể được thực hiện ở bất cứ đâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "This could be replanted closer to home."
msgstr "Điều này có thể được trồng lại gần nhà."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUG_GRASS"
msgid "It can be planted anywhere now."
msgstr "Nó có thể được trồng ở bất cứ đâu bây giờ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUG_MARSH_BUSH"
msgid "This needs to be planted."
msgstr "Điều này cần phải được trồng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUG_MONKEYTAIL"
msgid "I wonder if they're edible? Maybe an experiment is in order."
msgstr "Tôi tự hỏi liệu chúng có ăn được không? Có lẽ nên thử nghiệm một chút."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUG_SAPLING"
msgid "This needs to be planted."
msgstr "Điều này cần phải được trồng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUG_TRAP_STARFISH"
msgid "It's not fooling anyone now."
msgstr "Bây giờ nó không lừa ai cả."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUMBBELL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUMBBELL"
msgid "I usually let my mind do all the heavy lifting."
msgstr "Thường thì, tôi để tâm trí làm mọi công việc nặng nề."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "You can't get much cooler than that."
msgstr "không thể cool hơn được nữa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUMBBELL_GEM"
msgid "I'll conquer this weight with the power of-- ACK! My spine!!"
msgstr "Tôi sẽ đánh bại gánh nặng này với sức mạnh của -- Ẩnkk! Cột sống tôi!!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUMBBELL_GOLDEN"
msgid "It's worth its weight in gold."
msgstr "Nó đáng giá như vàng vậy đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUMBBELL_HEAT"
msgid "It's good for a warm-up."
msgstr "Nó tốt để làm bài tập khởi động."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUMBBELL_MARBLE"
msgid "I've trained my brain to be the strongest muscle in my body."
msgstr "Tôi đã rèn não mình thành cơ bắp mạnh nhất trong cơ thể."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUMBBELL_REDGEM"
msgid "It'll really make you feel the burn."
msgstr "Nó sẽ khiến bạn cảm nhận được cảm giác cháy bỏng thực sự."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DURIAN"
msgid "Oh, it smells!"
msgstr "Oh, nó có mùi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DURIAN_COOKED"
msgid "Now it smells even worse!"
msgstr "Bây giờ nó có mùi thậm chí tồi tệ hơn!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DURIAN_OVERSIZED"
msgid "I'm sure it'll make an even bigger stink."
msgstr "Tôi chắc chắn rằng nó sẽ tạo ra một mùi hôi thối lớn hơn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DURIAN_SEEDS"
msgid "It's a seed."
msgstr "Đó là một hạt giống."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUSTMERINGUE"
msgid "Who or what would eat this?"
msgstr "Ai hoặc những gì sẽ ăn cái này?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUSTMOTH"
msgid "Tidy little guys, aren't they?"
msgstr "Những người nhỏ gọn, phải không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DUSTMOTHDEN"
msgid "They're snug as bugs in there."
msgstr "Họ khắt khe như những con bọ trong đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EARMUFFSHAT"
msgid "Makes you warm and fuzzy inside. Outside, too."
msgstr "Làm cho bạn ấm áp và mờ bên trong. Bên ngoài, quá."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EEL"
msgid "This will make a delicious meal."
msgstr "Điều này sẽ làm cho một bữa ăn ngon."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EEL_COOKED"
msgid "Smells great!"
msgstr "Mùi tuyệt vời!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EGGPLANT"
msgid "It doesn't look like an egg."
msgstr "Nó không giống như một quả trứng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EGGPLANT_COOKED"
msgid "It's even less eggy."
msgstr "Nó thậm chí còn ít hơn eggy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "I still don't see any resemblance to an egg."
msgstr "Tôi vẫn không thấy bất kỳ điểm nào giống với một quả trứng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EGGPLANT_SEEDS"
msgid "It's a seed."
msgstr "Đó là một hạt giống."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ELIXIR_CONTAINER"
msgid "That's more of a mortician's bag than a basket."
msgstr "Nó giống cái túi của người làm tang lễ hơn là cái giỏ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EMBERLIGHT"
msgid "A fire without fuel? No matter."
msgstr "Một ngọn lửa không cần đốt? không vấn đề gì."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ENDTABLE.BURNT"
msgid "A burnt vase on a burnt table."
msgstr "Một bình bị cháy trên bàn bị cháy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ENDTABLE.EMPTY"
msgid "I should put something in there."
msgstr "Tôi nên đặt cái gì đó vào trong đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "It's nice to have a little light."
msgstr "Nó rất hay để có một ít ánh sáng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ENDTABLE.GENERIC"
msgid "A flower in a vase on a table."
msgstr "Một bông hoa trong chiếc bình trên bàn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "Did we remember to pick up new bulbs?"
msgstr "Đã làm chúng tôi nhớ để chọn lên bóng mới?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ENDTABLE.WILTED"
msgid "Not looking too fresh."
msgstr "Không nhìn quá tươi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EVERGREEN.BURNING"
msgid "What a waste of wood."
msgstr "Thật là một sự lãng phí gỗ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EVERGREEN.BURNT"
msgid "I feel like I could have prevented that."
msgstr "Tôi cảm thấy như tôi đã có thể ngăn chặn điều đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EVERGREEN.CHOPPED"
msgid "Take that, nature!"
msgstr "Đi mà, thiên nhiên!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EVERGREEN.GENERIC"
msgid "It's all piney."
msgstr "Đó là tất cả cây thông."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "What a waste of wood."
msgstr "Thật là một sự lãng phí gỗ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "I feel like I could have prevented that."
msgstr "Tôi cảm thấy như tôi đã có thể ngăn chặn điều đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "Take that, nature!"
msgstr "Đi mà, thiên nhiên!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "This sad tree has no cones."
msgstr "Cây buồn này không có nón."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EYEBRELLAHAT"
msgid "It watches over the wearer."
msgstr "Nó theo dõi người đeo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EYEMASKHAT"
msgid "You could say I have an eye for style."
msgstr "Bạn có thể nói rằng tôi có gu thẩm mỹ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EYEOFTERROR"
msgid "Go for the eye!"
msgstr "Đi khám phá mắt!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EYEOFTERROR_MINI"
msgid "I'm starting to feel self-conscious."
msgstr "Tôi bắt đầu cảm thấy tự ý thức."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "I think it's about to hatch..."
msgstr "Tôi nghĩ nó sắp nở..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EYEPLANT"
msgid "I think I'm being watched."
msgstr "Tôi nghĩ rằng tôi đang bị theo dõi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EYETURRET"
msgid "I hope it doesn't turn on me."
msgstr "Tôi hy vọng nó không bật tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.EYETURRET_ITEM"
msgid "I think it's sleeping."
msgstr "Tôi nghĩ nó đang ngủ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARMPLOT.BURNT"
msgid "I don't think anything will grow in a pile of ash."
msgstr "Tôi không nghĩ rằng bất cứ điều gì sẽ phát triển trong một đống tro."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARMPLOT.GENERIC"
msgid "I should try planting some crops."
msgstr "Tôi nên thử trồng một số loại cây trồng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARMPLOT.GROWING"
msgid "Go plants go!"
msgstr "Tới nhà máy đi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "I think it needs to be fertilized."
msgstr "Tôi nghĩ rằng nó cần phải được thụ tinh."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_HOE"
msgid "I have to make the ground more comfortable for the seeds."
msgstr "Tôi phải làm cho mặt đất thoải mái hơn cho hạt giống."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_PLANT.BURNING"
msgid "That can't be good for the plants..."
msgstr "Điều đó không thể tốt cho cây..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_PLANT.FULL"
msgid "Time to reap science's rewards."
msgstr "Đã đến lúc gặt hái phần thưởng của khoa học."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "With the power of science, I've produced monstrous produce!"
msgstr "Với sức mạnh của khoa học, tôi đã sản xuất ra những sản phẩm quái dị!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "I knew I'd weed out the imposter eventually!"
msgstr "Tôi biết cuối cùng tôi đã loại bỏ được kẻ giả mạo!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_PLANT.GENERIC"
msgid "That's a plant!"
msgstr "Đó là một cái cây!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_PLANT.GROWING"
msgid "Grow my beautiful creation, grow!"
msgstr "Sáng tạo tuyệt đẹp của tôi trưởng thành, phát triển!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "Drat! If only I'd picked it while I had the chance!"
msgstr "Drat! Giá như tôi chọn nó khi có cơ hội!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "What rotten luck."
msgstr "Đồ thối may mắn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_PLANT.SEED"
msgid "And now, we wait."
msgstr "Và bây giờ, chúng ta chờ đợi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_PLOW"
msgid "A convenient plot device."
msgstr "Một mảnh đất tiện lợi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_PLOW_ITEM"
msgid "I'd better find a good spot for my garden before I use it."
msgstr "Tốt nhất là tìm một địa điểm tốt cho khu vườn của tôi trước khi sử dụng nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "It's making a mess of my garden."
msgstr "Nó đang làm cho khu vườn của tôi trở nên lộn xộn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FEATHERFAN"
msgid "Down, to bring the temperature down."
msgstr "Xuống, để hạ nhiệt độ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FEATHERHAT"
msgid "BECOME THE BIRD!"
msgstr "Trở thành con chim!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FEATHERPENCIL"
msgid "The feather increases the scientific properties of the writing."
msgstr "Lông làm tăng các tính chất khoa học của văn bản."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FEATHER_CANARY"
msgid "A canary feather."
msgstr "Một con chim hoàng yến."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FEATHER_CROW"
msgid "A feather from a black bird."
msgstr "Một chiếc lông từ một con quạ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FEATHER_ROBIN"
msgid "A redbird feather."
msgstr "Một lông chim đỏ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "A snowbird feather."
msgstr "Một chiếc lông chim tuyết."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FEM_PUPPET"
msgid "She's trapped!"
msgstr "Cô ấy bị mắc kẹt!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FENCE"
msgid "It's just a wood fence."
msgstr "Nó chỉ là một hàng rào gỗ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FENCE_ELECTRIC.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FENCE_ELECTRIC.GENERIC"
msgid "It is not functional as a standalone unit."
msgstr "Nó không hoạt động như một đơn vị độc lập."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FENCE_ELECTRIC.LINKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FENCE_ELECTRIC.LINKED"
msgid "Aw, it found a connection."
msgstr "Ồ, nó đã tìm thấy một kết nối."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FENCE_ELECTRIC_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FENCE_ELECTRIC_ITEM"
msgid "It's not a tree, but it must be planted."
msgstr "Nó không phải là một cái cây, nhưng nó phải được trồng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FENCE_GATE"
msgid "It opens. And closes sometimes, too."
msgstr "Nó mở ra. Và đôi khi cũng đóng lại."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FENCE_GATE_ITEM"
msgid "All we need to build a nice, sturdy gate."
msgstr "Tất cả những gì ta cần để xây dựng một cổng tốt đẹp, mạnh mẽ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FENCE_ITEM"
msgid "All we need to build a nice, sturdy fence."
msgstr "Tất cả những gì chúng ta cần làm là xây một hàng rào đẹp, chắc chắn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FENCE_JUNK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FENCE_JUNK"
msgid "Tell me it's ugly, I won't take a fence."
msgstr "Bảo tôi là nó xấu điên đi, tôi không lấy cái hàng rào đó đâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FENCE_ROTATOR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FENCE_ROTATOR"
msgid "Enguard! Re-post!"
msgstr "Enguard! Re-post!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FERTILIZER"
msgid "That is definitely a bucket full of poop."
msgstr "Đó chắc chắn là một xô đầy poop."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FESTIVEFISH"
msgid "I wouldn't mind sampling some seasonal seafood."
msgstr "Mình không ngại thử một số hải sản theo mùa đâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FESTIVE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FESTIVE_BLUEPRINT"
msgid "This is just the occasion for some festivity!"
msgstr "Đây chỉ là dịp lý tưởng để có một số lễ hội!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIG"
msgid "I'll call it \"Newton's Fig\"."
msgstr "Tôi sẽ gọi nó là \"Newton's Fig\"."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIGATONI
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIGATONI"
msgid "Mama mia!"
msgstr "Mama mia!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIGKABAB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIGKABAB"
msgid "Fig with a side of stick."
msgstr "Chảo lừa với một bên que."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIG_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIG_COOKED"
msgid "It's been warmed by science."
msgstr "Nó được khoa học làm ấm lên"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIREBALLSTAFF"
msgid "It calls a meteor from above."
msgstr "Nó gọi một thiên thạch từ trên cao."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIRECRACKERS"
msgid "Filled with explosion science!"
msgstr "Chứa đầy khoa học về vụ nổ!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIREFLIES.GENERIC"
msgid "If only I could catch them!"
msgstr "Nếu tôi chỉ có thể bắt được chúng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIREFLIES.HELD"
msgid "They make my pocket glow!"
msgstr "Họ làm cho túi của tôi sáng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIREHOUND"
msgid "That one is glowy."
msgstr "Đó là một trong những phát sáng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIRENETTLES
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIRENETTLES"
msgid "If you can't stand the heat, stay out of the garden."
msgstr "Nếu bạn không thể chịu được sức nóng, hãy tránh xa khu vườn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIRENETTLES_DRIED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIRENETTLES_DRIED"
msgid "Nice dry."
msgstr "Đẹp khô."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIREPEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIREPEN"
msgid "Strike while the pen's hot!"
msgstr "Đánh lúc bút còn nóng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIREPIT.EMBERS"
msgid "I should put something on the fire before it goes out."
msgstr "Tôi nên đặt một cái gì đó trên ngọn lửa trước khi nó đi ra."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIREPIT.GENERIC"
msgid "Sure beats darkness."
msgstr "Chắc chắn nhịp đập bóng tối."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIREPIT.HIGH"
msgid "Good thing it's contained!"
msgstr "Điều tốt đó chứa!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIREPIT.LOW"
msgid "The fire's getting a bit low."
msgstr "Ngọn lửa của nhận được một chút thấp."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIREPIT.NORMAL"
msgid "Nice and comfy."
msgstr "Tốt đẹp và thoải mái."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIREPIT.OUT"
msgid "At least I can start it up again."
msgstr "Ít nhất tôi có thể bắt đầu nó lên một lần nữa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIRESTAFF"
msgid "I don't want to set the world on fire."
msgstr "Tôi không muốn thiết lập trên thế giới vào lửa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "The fuel tank is getting a bit low."
msgstr "Bình xăng được nhận được một chút thấp."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "All quiet on the flinging front."
msgstr "Tất cả im lặng trên mặt trận flinging."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "Fling on!"
msgstr "Fling trên!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISH"
msgid "Now I shall eat for a day."
msgstr "Bây giờ tôi sẽ ăn trong một ngày."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISHINGNET"
msgid "Nothing but net."
msgstr "Không có gì ngoài mạng nhện."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISHINGROD"
msgid "Hook, line and stick!"
msgstr "Hook, line và thanh!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISHMEAT"
msgid "A chunk of fish meat."
msgstr "Một miếng thịt cá."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISHMEAT_COOKED"
msgid "Grilled to perfection."
msgstr "Nướng để hoàn thiện."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISHMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISHMEAT_DRIED"
msgid "That fish is a real jerk."
msgstr "Con cá đó đúng là một kẻ khốn nạn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISHMEAT_SMALL"
msgid "A small bit of fish."
msgstr "Một chút cá."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "A small bit of cooked fish."
msgstr "Một chút cá nấu chín."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISHMEAT_SMALL_DRIED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISHMEAT_SMALL_DRIED"
msgid "That fish is a real jerk."
msgstr "Con cá đó đúng là một kẻ khốn nạn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISHSTICKS"
msgid "Sticks to your ribs."
msgstr "Trỏ vào xương sườn của bạn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISHTACOS"
msgid "Crunchy and delicious!"
msgstr "Giòn và ngon!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISH_BOX"
msgid "They're stuffed in there like sardines!"
msgstr "Chúng được nhồi trong đó như cá mòi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FISH_COOKED"
msgid "Grilled to perfection."
msgstr "Nướng để hoàn thiện."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLINT"
msgid "It's a very sharp rock."
msgstr "Đó là một tảng đá rất sắc nét."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOATINGLANTERN.DEFLATED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOATINGLANTERN.DEFLATED"
msgid "Admit deflate!"
msgstr "Thừa nhận xì hơi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOATINGLANTERN.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOATINGLANTERN.GENERIC"
msgid "There we glow!"
msgstr "Ở đó chúng tôi phát sáng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOATINGLANTERN.HELD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOATINGLANTERN.HELD"
msgid "The trick is to let it go."
msgstr "Bí quyết là để nó đi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOTATIONCUSHION
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOTATIONCUSHION"
msgid "Oh, buoyancy!"
msgstr "Ôi, sức nổi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOWER.GENERIC"
msgid "It's pretty, but it smells like a common laborer."
msgstr "Nó đẹp, nhưng nó có mùi như một người lao động."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOWER.ROSE"
msgid "To match my rosy cheeks."
msgstr "Để phù hợp với má hồng của mình."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOWERHAT"
msgid "It smells like prettiness."
msgstr "Nó có mùi giống như sắc đẹp."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOWERSALAD"
msgid "A bowl of foliage."
msgstr "Một bát của tán lá."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOWER_CAVE"
msgid "Science makes it glow."
msgstr "Khoa học làm cho nó phát sáng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOWER_CAVE_WITHERED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOWER_CAVE_WITHERED"
msgid "It's dim bulb."
msgstr "Đó là bóng đèn mờ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOWER_EVIL"
msgid "Augh! It's so evil!"
msgstr "Augh! Thật là ác!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FLOWER_WITHERED"
msgid "I don't think it got enough sun."
msgstr "Tôi không nghĩ rằng nó có đủ ánh sáng mặt trời."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FOLIAGE"
msgid "Some leafy greens."
msgstr "Một số loại rau lá xanh."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FOLIAGE_DRIED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FOLIAGE_DRIED"
msgid "Nice dry."
msgstr "Đẹp khô."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FOOTBALLHAT"
msgid "I don't like sports."
msgstr "Tôi không thích thể thao."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FORGETMELOTS"
msgid "Hm. I can't remember what I was going to say about those."
msgstr "Hừm. Tôi không thể nhớ mình sẽ nói gì về những điều đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FORGETMELOTS_DRIED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FORGETMELOTS_DRIED"
msgid "Nice dry."
msgstr "Đẹp khô."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FORMAL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FORMAL_BLUEPRINT"
msgid "This is a costume for some Grade A beefalo."
msgstr "Đây là một trang phục cho Bò lai thượng hạng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FOSSIL_PIECE"
msgid "Science bones! We should put them back together."
msgstr "Xương khoa học! Chúng ta nên đặt chúng lại với nhau."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "It's alive! Oh wait, no, it's not."
msgstr "Nó còn sống! À đợi đã, không có."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "My scientific instincts say this isn't quite right."
msgstr "Bản năng khoa học của tôi nói rằng điều này không hoàn toàn đúng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "Still missing some pieces."
msgstr "Vẫn thiếu một số mảnh."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FRESHFRUITCREPES"
msgid "Sugary fruit! Part of a balanced breakfast."
msgstr "Trái cây có đường! Một phần của bữa sáng cân bằng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FRIENDLYFRUITFLY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FRIENDLYFRUITFLY"
msgid "The garden seems happier with it around."
msgstr "Khu vườn có vẻ hạnh phúc hơn với nó xung quanh."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FROG.DEAD"
msgid "He's croaked."
msgstr "Nó kêu ộp ộp."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FROG.GENERIC"
msgid "He's so cute!"
msgstr "Anh ta thật đáng yêu!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FROG.SLEEPING"
msgid "Aww, look at him sleep!"
msgstr "Aww, nhìn anh ngủ!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FROGFISHBOWL"
msgid "Is that just... frogs stuffed inside a fish?"
msgstr "Đó có phải là… những con ếch trong một con cá?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FROGGLEBUNWICH"
