msgid "This Chest contains Wormwood's complete set of Merrymaker skin items."
msgstr "Rương này chứa trọn bộ vật phẩm ngoại trang Sứ Giả Niềm Vui của Wormwood."

#. STRINGS.SKIN_DESCRIPTIONS.pack_yule_wurt
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_yule_wurt"
msgid "This Chest contains Wurt's complete set of Merrymaker skin items."
msgstr "Rương này chứa trọn bộ vật phẩm ngoại trang Sứ Giả Niềm Vui của Wurt."

#. STRINGS.SKIN_DESCRIPTIONS.pack_yule_wx78
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_yule_wx78"
msgid "This Chest contains WX-78's complete set of Merrymaker skin items."
msgstr "Rương này chứa trọn bộ vật phẩm ngoại trang Sứ Giả Niềm Vui của WX-78."

#. STRINGS.SKIN_DESCRIPTIONS.panflute_an
msgctxt "STRINGS.SKIN_DESCRIPTIONS.panflute_an"
msgid "A flute tuned for the winds of change."
msgstr "Một cây sáo được tinh chỉnh cho những ngọn gió đổi thay."

#. STRINGS.SKIN_DESCRIPTIONS.panflute_harlequin
msgctxt "STRINGS.SKIN_DESCRIPTIONS.panflute_harlequin"
msgid "As whimsical as it is musical."
msgstr "Vừa kì lạ vừa đầy tính âm nhạc."

#. STRINGS.SKIN_DESCRIPTIONS.panflute_insect
msgctxt "STRINGS.SKIN_DESCRIPTIONS.panflute_insect"
msgid "Play notes that float in the air, drifting without a care."
msgstr "Tấu lên những nốt nhạc lơ lửng trong không trung, trôi dạt mà chẳng chút bận lòng."

#. STRINGS.SKIN_DESCRIPTIONS.panflute_swamp
msgctxt "STRINGS.SKIN_DESCRIPTIONS.panflute_swamp"
msgid "Play a timeless tune."
msgstr "Trình tấu một khúc ca vượt thời gian."

#. STRINGS.SKIN_DESCRIPTIONS.parasol_polkadot
msgctxt "STRINGS.SKIN_DESCRIPTIONS.parasol_polkadot"
msgid "Pretty moderate protection."
msgstr "Khả năng bảo vệ khá là bình thường."

#. STRINGS.SKIN_DESCRIPTIONS.parasol_spring
msgctxt "STRINGS.SKIN_DESCRIPTIONS.parasol_spring"
msgid "\"April showers bring May flowers.\""
msgstr "\"Những cơn mưa tháng Tư mang lại những đóa hoa tháng Năm.\""

#. STRINGS.SKIN_DESCRIPTIONS.perdling_crow
msgctxt "STRINGS.SKIN_DESCRIPTIONS.perdling_crow"
msgid "This little scamp is ready to caws some commotion."
msgstr "Tên nhóc tì này đã sẵn sàng để quạu quọ gây náo loạn rồi."

#. STRINGS.SKIN_DESCRIPTIONS.perdling_crow_builder
msgctxt "STRINGS.SKIN_DESCRIPTIONS.perdling_crow_builder"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.perdling_pelican
msgctxt "STRINGS.SKIN_DESCRIPTIONS.perdling_pelican"
msgid "Have you always wanted to have a seabird companion? Well now you peli-can!"
msgstr "Bạn có luôn muốn có một người bạn đồng hành là loài chim biển không? Giờ thì bạn peli-có thể rồi!"

#. STRINGS.SKIN_DESCRIPTIONS.perdling_pelican_builder
msgctxt "STRINGS.SKIN_DESCRIPTIONS.perdling_pelican_builder"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.perdling_pollyrogers
msgctxt "STRINGS.SKIN_DESCRIPTIONS.perdling_pollyrogers"
msgid "This parrot pirate is prepared for plenty of pilfering!"
msgstr "Chú vẹt hải tặc này đã chuẩn bị sẵn sàng để vơ vét thỏa thích!"

#. STRINGS.SKIN_DESCRIPTIONS.perdling_pollyrogers_builder
msgctxt "STRINGS.SKIN_DESCRIPTIONS.perdling_pollyrogers_builder"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.perdling_puffin
msgctxt "STRINGS.SKIN_DESCRIPTIONS.perdling_puffin"
msgid "Travel the seas with your own puffin pal."
msgstr "Du hành các vùng biển cùng chú hải âu cổ rụt bạn đồng hành của riêng bạn."

#. STRINGS.SKIN_DESCRIPTIONS.perdling_puffin_builder
msgctxt "STRINGS.SKIN_DESCRIPTIONS.perdling_puffin_builder"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.perdling_rooster
msgctxt "STRINGS.SKIN_DESCRIPTIONS.perdling_rooster"
msgid "If you wanted a bouncy rooster companion by your side, then you're in cluck!"
msgstr "Nếu bạn muốn có một chú gà trống tưng tưng bên cạnh, thì bạn gặp may rồi đấy!"

#. STRINGS.SKIN_DESCRIPTIONS.perdling_rooster_builder
msgctxt "STRINGS.SKIN_DESCRIPTIONS.perdling_rooster_builder"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.perdling_winter
msgctxt "STRINGS.SKIN_DESCRIPTIONS.perdling_winter"
msgid "This plump little fellow is sure to brighten even the bitterest of winter nights!"
msgstr "Anh bạn tròn vo nhỏ bé này chắc chắn sẽ thắp sáng cả những đêm đông buốt giá nhất!"

#. STRINGS.SKIN_DESCRIPTIONS.perdling_winter_builder
msgctxt "STRINGS.SKIN_DESCRIPTIONS.perdling_winter_builder"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.pickaxe_feathered
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pickaxe_feathered"
msgid "The pickaxe of the self-reliant adventurer."
msgstr "Cuốc chim của nhà thám hiểm tự lực."

#. STRINGS.SKIN_DESCRIPTIONS.pickaxe_invisible
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pickaxe_invisible"
msgid "Convey an incredibly convincing impression of a pickaxe."
msgstr "Tạo ấn tượng vô cùng thuyết phục về một chiếc cuốc chim."

#. STRINGS.SKIN_DESCRIPTIONS.pickaxe_northern
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pickaxe_northern"
msgid "A rustic, sturdy pickaxe."
msgstr "Một chiếc cuốc chim mộc mạc và chắc chắn."

#. STRINGS.SKIN_DESCRIPTIONS.pickaxe_reavershark
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pickaxe_reavershark"
msgid "Not many realize the sharpest part of the shark is actually its jawline."
msgstr "Không nhiều người nhận ra phần sắc bén nhất của loài cá mập thực ra chính là đường quai hàm của nó."

#. STRINGS.SKIN_DESCRIPTIONS.pickaxe_scythe
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pickaxe_scythe"
msgid "A terrible scythe to behold."
msgstr "Một chiếc lưỡi hái khủng khiếp để ngắm nhìn."

#. STRINGS.SKIN_DESCRIPTIONS.pickaxe_scythe_alt
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pickaxe_scythe_alt"
msgid "A terrible scythe to behold."
msgstr "Một chiếc lưỡi hái khủng khiếp để ngắm nhìn."

#. STRINGS.SKIN_DESCRIPTIONS.pickaxe_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pickaxe_victorian"
msgid "An elegantly engraved silver pickaxe."
msgstr "Một chiếc cuốc chim bằng bạc được chạm khắc trang nhã."

#. STRINGS.SKIN_DESCRIPTIONS.piggyback_elephant
msgctxt "STRINGS.SKIN_DESCRIPTIONS.piggyback_elephant"
msgid "It really puts the \"pack\" in pachyderm!"
msgstr "Đúng là mang từ \"gói\" vào loài thú có vòi!"

#. STRINGS.SKIN_DESCRIPTIONS.piggyback_nose
msgctxt "STRINGS.SKIN_DESCRIPTIONS.piggyback_nose"
msgid "This little piggy will carry your things all the way home."
msgstr "Chú heo con này sẽ mang đồ đạc của bạn về tận nhà."

#. STRINGS.SKIN_DESCRIPTIONS.pighouse_cabin
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pighouse_cabin"
msgid "That pig will be snug as a bug in a rug."
msgstr "Chú heo đó sẽ ấm áp như bọ trong thảm."

#. STRINGS.SKIN_DESCRIPTIONS.pighouse_gothic
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pighouse_gothic"
msgid "Despite years of neglect, this manor still maintains its imposing atmosphere."
msgstr "Bất chấp nhiều năm bị bỏ bê, trang viên này vẫn giữ được bầu không khí uy nghiêm."

#. STRINGS.SKIN_DESCRIPTIONS.pighouse_logcabin
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pighouse_logcabin"
msgid "Perfect for weathering those cold winters up North."
msgstr "Hoàn hảo để đương đầu với những mùa đông lạnh giá ở phương Bắc."

#. STRINGS.SKIN_DESCRIPTIONS.pitchfork_fork
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pitchfork_fork"
msgid "When did Bearger start using utensils?"
msgstr "Từ khi nào mà Gấu Lửng lại bắt đầu dùng dụng cụ ăn uống thế?"

#. STRINGS.SKIN_DESCRIPTIONS.pitchfork_invisible
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pitchfork_invisible"
msgid "Convey an incredibly convincing impression of a pitchfork."
msgstr "Tạo ấn tượng vô cùng thuyết phục về một chiếc chĩa."

#. STRINGS.SKIN_DESCRIPTIONS.pitchfork_rose
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pitchfork_rose"
msgid "Deal with those thorny turf problems."
msgstr "Giải quyết những vấn đề cỏ dại đầy gai góc đó."

