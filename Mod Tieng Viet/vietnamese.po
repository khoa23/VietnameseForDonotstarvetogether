msgid "only_used_by_wolfang"
msgstr "chỉ_được_sử_dụng_bởi_wolfang"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_COLD"
msgid "Brr! Cold as frozen steel out here!"
msgstr "Ôi! Ngoài này lạnh như thép đông cứng!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_COMPASS_OUT"
msgid "Shoddy handmade junk!"
msgstr "Rác thủ công kém chất lượng!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_COZY_SLEEP
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_COZY_SLEEP"
msgid "I feel all bright-eyed and bushy-tailed!"
msgstr "Tôi cảm thấy tất cả đều sáng mắt và rậm rạp!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_CRAFTING_FAIL"
msgid "How did I junk that up?!"
msgstr "Làm sao tôi có thể vứt nó đi được?!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_DAMP"
msgid "A light mist never hurt nobody."
msgstr "Một làn sương mù nhẹ không bao giờ làm tổn thương ai."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_DEERCLOPS"
msgid "Democrew incoming!"
msgstr "Dân chủ đang đến!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_DESPAWN"
msgid "Good thing I got all my affairs in order."
msgstr "Thật tốt là tôi đã sắp xếp được mọi việc của mình."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_ATTACK"
msgid "Y'know, fightin' ain't always the answer."
msgstr "Bạn biết đấy, chiến đấu không phải lúc nào cũng là câu trả lời."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK"
msgid "I'm all outta juice!"
msgstr "Tôi hết nước trái cây rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY"
msgid "I think I might be needin' an umbrella soon."
msgstr "Tôi nghĩ có lẽ tôi sẽ cần một chiếc ô sớm thôi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION"
msgid "I'd better take a step back."
msgstr "Tốt hơn là tôi nên lùi lại một bước."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE"
msgid "I'm beat!"
msgstr "Tôi bị đánh!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS"
msgid "I'm off the clock!"
msgstr "Tôi hết giờ rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_DIG_DISEASE_WARNING"
msgid "That helped a bit."
msgstr "Điều đó đã giúp ích một chút."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_DUSK"
msgid "There's the quittin' bell."
msgstr "Có tiếng chuông bỏ cuộc."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.GENERIC"
msgid "That hits the spot."
msgstr "Đó là điểm nhấn."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.INVALID
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.INVALID"
msgid "Pretty sure that's not food."
msgstr "Khá chắc chắn đó không phải là thức ăn."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.PAINFUL
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.PAINFUL"
msgid "Yeow! That one bit back!"
msgstr "Vâng! Ngược lại một chút!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.SPOILED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.SPOILED"
msgid "I am full of regret."
msgstr "Tôi đầy hối tiếc."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.STALE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.STALE"
msgid "I've had worse."
msgstr "Tôi đã từng tệ hơn."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.YUCKY"
msgid "Blech! Even I got limits!"
msgstr "Thuốc tẩy! Ngay cả tôi cũng có giới hạn!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_EATING_NOT_FEASTING
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_EATING_NOT_FEASTING"
msgid "I ain't gonna hog this all to myself!"
msgstr "Tôi sẽ không ôm tất cả chuyện này cho riêng mình!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ELIXIR_BOOSTED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ELIXIR_BOOSTED"
msgid "That's pretty good."
msgstr "Điều đó khá tốt."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ELIXIR_GHOSTVISION
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ELIXIR_GHOSTVISION"
msgid "Sis? I can't see you here."
msgstr "Chị ơi? Tôi không thể nhìn thấy bạn ở đây."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ELIXIR_PLAYER_SPEED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ELIXIR_PLAYER_SPEED"
msgid "I feel like a steam engine!"
msgstr "Tôi cảm thấy giống như một động cơ hơi nước!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ELIXIR_TOO_SUPER
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ELIXIR_TOO_SUPER"
msgid "Yikes, that's way too strong."
msgstr "Rất tiếc, nó mạnh quá."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.1"
msgid "Hhff!"
msgstr "Hừ!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.2"
msgid "Easy as pie! Hff!"
msgstr "Dễ như ăn bánh! Hừ!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.3"
msgid "Like eggs in coffee!"
msgstr "Giống như trứng trong cà phê!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.4"
msgid "Hhngh!"
msgstr "Hừm!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.5"
msgid "I... *huff* I got it!"
msgstr "Tôi... *hụt* Tôi hiểu rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.6"
msgid "Ha! I'm plenty rugged! *huff*"
msgstr "Hà! Tôi rất gồ ghề! *hù*"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.7"
msgid "Ooff..."
msgstr "Ôi..."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.8
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.8"
msgid "This... ain't... nothin'!"
msgstr "Đây... không phải... không có gì cả!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.9
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.9"
msgid "Where's worker's comp when you need it?"
msgstr "Lương của công nhân ở đâu khi bạn cần?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE"
msgid "Whoa, this one is more advanced than my version."
msgstr "Whoa, cái này tiên tiến hơn phiên bản của tôi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE"
msgid "Interestin'. This version and mine are ahead in different ways."
msgstr "Thật thú vị. Phiên bản này và của tôi đang đi trước theo những cách khác nhau."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENGINEERING_CAN_UPGRADE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENGINEERING_CAN_UPGRADE"
msgid "Easy peasy, my version is miles ahead."
msgstr "Dễ thôi, phiên bản của tôi đã đi trước hàng dặm."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENTER_DARK"
msgid "I can't see!"
msgstr "Tôi không thể nhìn thấy!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENTER_LIGHT"
msgid "Whew! I can see!"
msgstr "Ối! Tôi có thể nhìn thấy!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_EXIT_GELBLOB
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_EXIT_GELBLOB"
msgid "Let's not speak of this again."
msgstr "Đừng nhắc lại chuyện này nữa."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_EYEOFTERROR_ARRIVE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_EYEOFTERROR_ARRIVE"
msgid "Uhh... maybe it's a friendly giant eyeball?"
msgstr "Uhh... có lẽ đó là một con mắt khổng lồ thân thiện?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_EYEOFTERROR_FLYAWAY
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_EYEOFTERROR_FLYAWAY"
msgid "Agh, I guess we'll finish it off another night."
msgstr "Agh, tôi đoán chúng ta sẽ kết thúc nó vào một đêm khác."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_EYEOFTERROR_FLYBACK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_EYEOFTERROR_FLYBACK"
msgid "Back for more?"
msgstr "Quay lại để nhận thêm?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_FAN_OUT"
msgid "Useless handmade junk!"
msgstr "Rác thủ công vô dụng!"

