#. STRINGS.SKIN_DESCRIPTIONS.mastupgrade_lightningrod_item_nautical
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mastupgrade_lightningrod_item_nautical"
msgid "This sea monster has an appetite for electricity."
msgstr "Quái vật biển này có sự thèm thuồng điện năng."

#. STRINGS.SKIN_DESCRIPTIONS.mastupgrade_lightningrod_nautical
