msgstr "Họ trông ngớ ngẩn hơn khi họ đang ngủ."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALOFEED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALOFEED"
