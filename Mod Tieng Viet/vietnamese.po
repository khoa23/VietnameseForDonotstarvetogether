msgstr "Bên trong tôi đang bốc cháy!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MITEGLAND_DEBUFF.2
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MITEGLAND_DEBUFF.2"
