msgstr "Dùng để mang theo nhiều đồ hơn."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BACONEGGS"
