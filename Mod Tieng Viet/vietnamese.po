msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC"
msgid "We used to see these at the fair!"
msgstr "Hồi trước chúng ta hay thấy mấy cái này ở hội chợ!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM"
