msgstr "Wolfgang đến con ruồi còn chẳng nỡ hại."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.THULECITE_PIECES
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.THULECITE_PIECES"
