msgstr "Kẻ nào đặt thứ này đúng là một tên để tiện!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TREASURECHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TREASURECHEST.BURNT"
