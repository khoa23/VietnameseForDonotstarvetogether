msgstr "Chắc giờ chúng ta đi đổi phần thưởng được rồi đấy!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_SEEDPACKET"
