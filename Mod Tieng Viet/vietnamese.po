msgstr "Cát bụi về với cát bụi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PEBBLECRAB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PEBBLECRAB"
