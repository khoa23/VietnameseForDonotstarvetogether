msgstr "Có lẽ đến lúc bôi thêm chút Cao nhiệt rồi."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE"
