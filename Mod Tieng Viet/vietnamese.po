msgstr "Tôi nên lắp ráp nó lại mới được."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_STAGE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_STAGE"
msgid "Ah mes amis, I've been judged by top chefs - this is nothing!"
msgstr "À mes amis, tôi đã từng bị đánh giá bởi những đầu bếp hàng đầu - cái này thấm vào đâu!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_STAGE_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_STAGE_ITEM"
