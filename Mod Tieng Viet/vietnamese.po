msgstr "Điều đó nghe có vẻ giống như một meanie lớn."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DESPAWN"
