msgstr "Chúng ta có thể giúp lũ chim dựng lên."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST"
msgid "It's a little bird door."
msgstr "Đó là một cánh cửa chim nhỏ."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC"
msgid "It'll let us play if we give it something shiny."
msgstr "Nó sẽ cho ta chơi nếu đưa thứ gì đó lấp lánh."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING"
msgid "Don't worry bird mom, all your babies will get fed."
msgstr "Đừng lo mẹ chim ơi, tất cả các bé sẽ được cho ăn hết."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFBALL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFBALL"
msgid "Don't worry little ball! We'll get you to the hole!"
msgstr "Đừng lo nhé bóng nhỏ! Chúng tôi sẽ đưa bạn vào hố!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFCLUB
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFCLUB"
msgid "Just a little tap and off the ball goes!"
msgstr "Chỉ một cú đánh nhẹ là bóng bay đi!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_DIY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_DIY"
msgid "We'll make our very own mini-golf course!"
msgstr "Chúng ta sẽ làm sân golf mini của riêng mình!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_EASY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_EASY"
msgid "So easy!"
msgstr "Dễ quá!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_HARD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_HARD"
msgid "We're up for a challenge!"
msgstr "Chúng ta sẵn sàng thử thách!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_MEDIUM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_MEDIUM"
msgid "This one is juuuuust right!"
msgstr "Cái này thì vừa vượn luôn!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFPROP_CUTOUT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFPROP_CUTOUT"
msgid "Excuse us!"
msgstr "Xin phép cho qua nhé!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFPROP_FAN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFPROP_FAN"
msgid "It's so windy!"
msgstr "Gió quá!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFPROP_FENCE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFPROP_FENCE"
msgid "We have to stay inside the fence to play."
msgstr "Chúng ta phải ở trong hàng rào mới chơi được."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFPROP_MOVINGWALL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFPROP_MOVINGWALL"
msgid "We have to time it juuuuust right."
msgstr "Chúng ta phải canh thời gian cho thật chuẩn."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFPROP_SPINNER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFPROP_SPINNER"
msgid "Ooooh! Spinny fun!"
msgstr "Ooooh! Xoay vòng vui thật!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFPROP_SPRING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFPROP_SPRING"
msgid "It makes the ball jump!"
msgstr "Nó làm quả bóng nhảy lên kìa!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFPROP_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLFPROP_WORMHOLE"
msgid "Just like the big one, but for golf balls!"
msgstr "Y hệt cái lớn, nhưng dành cho bóng golf!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLF_HOLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLF_HOLE"
msgid "We can do it!"
msgstr "Chúng ta làm được mà!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLF_HOLE_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLF_HOLE_KIT"
msgid "Can we put it next to the start?"
msgstr "Đặt nó cạnh chỗ xuất phát được không?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLF_TEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLF_TEE.GENERIC"
msgid "It costs a token! Do we have a token?"
msgstr "Tốn một đồng xu! Chúng ta có đồng xu nào không?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLF_TEE.INACTIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLF_TEE.INACTIVE"
msgid "We think it's missing the flaghole still!"
msgstr "Chúng ta nghĩ nó vẫn còn thiếu cờ hố gôn!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLF_TEE.PLAYING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLF_TEE.PLAYING"
msgid "It has a token already! We can play!"
msgstr "Nó có sẵn đồng xu rồi! Chơi được luôn!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLF_TEE_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_GOLF_TEE_KIT"
msgid "We can start anywhere we want?"
msgstr "Chúng ta bắt đầu ở đâu cũng được sao?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_HERDING_CHICK
