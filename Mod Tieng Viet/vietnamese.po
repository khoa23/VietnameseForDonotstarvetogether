#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC"
