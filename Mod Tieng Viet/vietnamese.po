msgstr "Nó có một khuôn mặt ngớ ngẩn nhỉ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_46
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_46"
