msgstr "Tôi thấy hơi giống khỉ rồi đấy..."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MONKEY_CURSE_CHANGE
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MONKEY_CURSE_CHANGE"
