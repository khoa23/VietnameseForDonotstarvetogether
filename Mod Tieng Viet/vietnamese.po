msgstr "Thật là thô thiển, nhưng Wolfgang không thể rời mắt."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATEDBUZZARD_GESTALT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATEDBUZZARD_GESTALT.GENERIC"
