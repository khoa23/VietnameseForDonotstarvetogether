#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRAP_FUMAROLE.HOT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRAP_FUMAROLE.HOT"
msgid "Is burny floor. Very bad for walking."
msgstr "Sàn nhà nóng rẫy. Đi vào cực kỳ tệ luôn."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRAP_FUMAROLE.WARM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRAP_FUMAROLE.WARM"
