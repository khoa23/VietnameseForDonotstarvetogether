msgstr "Tôi không thể! Tôi cần được y tế chăm sóc! Hộp sơ cứu đâu rồi?!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.BATHBOMB.ALREADY_BOMBED
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.BATHBOMB.ALREADY_BOMBED"
msgid "I don't want to waste supplies."
msgstr "Tôi không muốn lãng phí nguyên liệu đâu."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.BATHBOMB.GLASSED
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.BATHBOMB.GLASSED"
msgid "I don't think that's going to work."
msgstr "Tôi không nghĩ cách đó sẽ hiệu quả đâu."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.BUILD.BUSY_STATION
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.BUILD.BUSY_STATION"
msgid "We have to wait, Woby!"
msgstr "Chúng ta phải đợi thôi, Woby!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.BUILD.HASPET
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.BUILD.HASPET"
msgid "I think Woby might get jealous if I keep collecting pets."
msgstr "Tôi nghĩ Woby có thể sẽ ghen tị nếu tôi cứ tiếp tục thu thập thú cưng đấy."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.BUILD.MOUNTED
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.BUILD.MOUNTED"
msgid "I've got to get down if I'm going to do that properly."
msgstr "Tôi phải xuống ngựa nếu muốn làm việc đó cho đàng hoàng."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.BUILD.TICOON
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.BUILD.TICOON"
msgid "One of these guys is enough to keep track of."
msgstr "Một đứa thế này là đủ mệt để trông chừng rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CARNIVALGAME_FEED.TOO_LATE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CARNIVALGAME_FEED.TOO_LATE"
msgid "Darnit! I wasn't fast enough."
msgstr "Chết tiệt! Tôi không đủ nhanh."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CARVEPUMPKIN.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CARVEPUMPKIN.BURNING"
msgid "Ouch! Fire saftey!"
msgstr "Ái! An toàn lửa đấy!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CARVEPUMPKIN.INUSE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CARVEPUMPKIN.INUSE"
msgid "That pumpkin is being carved, Woby!"
msgstr "Quả bí ngô đó đang được khắc mà, Woby!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CASTAOE.CANT_SPELL_MOUNTED
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CASTAOE.CANT_SPELL_MOUNTED"
msgid "only_used_by_willow"
msgstr "chỉ_được_sử_dụng_bởi_willow"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CASTAOE.NOT_ENOUGH_EMBERS
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CASTAOE.NOT_ENOUGH_EMBERS"
msgid "only_used_by_willow"
msgstr "chỉ_được_sử_dụng_bởi_willow"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CASTAOE.NO_BATTERY
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CASTAOE.NO_BATTERY"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CASTAOE.NO_CATAPULTS
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CASTAOE.NO_CATAPULTS"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CASTAOE.NO_TARGETS
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CASTAOE.NO_TARGETS"
msgid "only_used_by_willow"
msgstr "chỉ_được_sử_dụng_bởi_willow"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CASTAOE.SPELL_ON_COOLDOWN
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CASTAOE.SPELL_ON_COOLDOWN"
msgid "only_used_by_willow"
msgstr "chỉ_được_sử_dụng_bởi_willow"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CASTSPELL.TERRAFORM_TOO_SOON
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CASTSPELL.TERRAFORM_TOO_SOON"
msgid "only_used_by_wurt"
msgstr "chỉ_được_sử_dụng_bởi_wurt"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CHANGEIN.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CHANGEIN.BURNING"
msgid "That goes against everything we learned about fire safety."
msgstr "Điều đó đi ngược lại mọi thứ chúng ta được học về an toàn phòng cháy chữa cháy."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CHANGEIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CHANGEIN.GENERIC"
msgid "What I'm wearing is fine."
msgstr "Thứ tôi đang mặc ổn chán."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CHANGEIN.INUSE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CHANGEIN.INUSE"
msgid "Did you get lost in there? Ha... ha... uh, that was a joke."
msgstr "Cậu bị lạc trong đó hả? Ha... ha... à, đùa đấy."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CHANGEIN.NOOCCUPANT
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CHANGEIN.NOOCCUPANT"
msgid "Uh, I think we're forgetting something..."
msgstr "Ờm, tôi nghĩ chúng ta quên mất điều gì đó..."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CHANGEIN.NOTENOUGHHAIR
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CHANGEIN.NOTENOUGHHAIR"
msgid "I'll have to wait till their hair grows back."
msgstr "Tôi sẽ phải đợi cho đến khi tóc họ mọc lại đã."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL"
msgid "We got a full charge, Woby!"
msgstr "Chúng ta đã nạp đầy năng lượng rồi, Woby!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE"
msgid "There's not enough power."
msgstr "Không đủ năng lượng rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.COMPARE_WEIGHABLE.FISH_TOO_SMALL
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.COMPARE_WEIGHABLE.FISH_TOO_SMALL"
msgid "This one's way too small."
msgstr "Con này quá nhỏ rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.COMPARE_WEIGHABLE.OVERSIZEDVEGGIES_TOO_SMALL
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.COMPARE_WEIGHABLE.OVERSIZEDVEGGIES_TOO_SMALL"
msgid "Nope. Not big enough."
msgstr "Không. Không đủ lớn."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CONSTRUCT.EMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CONSTRUCT.EMPTY"
msgid "I need some supplies!"
msgstr "Tôi cần một số nguyên liệu!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CONSTRUCT.INUSE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CONSTRUCT.INUSE"
msgid "Are you busy? Wanna hear about the bug I found yesterday?"
msgstr "Cậu đang bận à? Có muốn nghe về con bọ tôi tìm thấy hôm qua không?"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CONSTRUCT.MISMATCH
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CONSTRUCT.MISMATCH"
msgid "Wait... these aren't even the right plans."
msgstr "Khoan đã... đây thậm chí còn không phải bản thiết kế đúng."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CONSTRUCT.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CONSTRUCT.NOTALLOWED"
msgid "That doesn't make sense."
msgstr "Điều đó thật vô lý."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CONSTRUCT.NOTREADY
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.CONSTRUCT.NOTREADY"
msgid "Maybe I'll try when the ground isn't shaking."
msgstr "Có lẽ tôi sẽ thử khi mặt đất ngừng rung chuyển vậy."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.COOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.COOK.GENERIC"
msgid "If only I had some marshmallows... oh well."
msgstr "Giá như tôi có vài viên kẹo dẻo... mà thôi kệ."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.COOK.INUSE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.COOK.INUSE"
msgid "Hey while you're here, wanna hear a scary story I heard on the radio?"
msgstr "Này, trong lúc cậu ở đây, có muốn nghe một câu chuyện kinh dị tôi nghe được trên đài không?"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.COOK.TOOFAR
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.COOK.TOOFAR"
msgid "My arms aren't that long."
msgstr "Tay tôi không dài đến thế đâu."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.DECORATESNOWMAN.HASHAT
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.DECORATESNOWMAN.HASHAT"
msgid "Hey, there's a hat in the way!"
msgstr "Này, có cái mũ vướng ở đường kìa!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.DECORATESNOWMAN.INUSE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.DECORATESNOWMAN.INUSE"
msgid "That one's taken, Woby."
msgstr "Cái đó có chủ rồi, Woby."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.DECORATESNOWMAN.MELTING
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.DECORATESNOWMAN.MELTING"
msgid "Oh no, it's melting! We can't decorate it anymore, Woby."
msgstr "Ồ không, nó đang tan chảy kìa! Chúng ta không thể trang trí nó nữa đâu, Woby."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.DECORATESNOWMAN.STACKEDTOOHIGH
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.DECORATESNOWMAN.STACKEDTOOHIGH"
msgid "I can't build it taller than that, Woby!"
msgstr "Tôi không thể xây nó cao hơn thế nữa đâu, Woby!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.DEPLOY.HERMITCRAB_RELOCATE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.DEPLOY.HERMITCRAB_RELOCATE"
msgid "Aww, it's dry. Let's try again later!"
msgstr "Hây da, nó khô khốc rồi. Để lát nữa thử lại vậy!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.DIRECTCOURIER_MAP.NOTARGET
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.DIRECTCOURIER_MAP.NOTARGET"
msgid "Guess we should pick another spot, Woby."
msgstr "Chắc chúng ta nên chọn chỗ khác thôi, Woby."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.DISMANTLE.COOKING
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.DISMANTLE.COOKING"
msgid "That seems kind of dangerous."
msgstr "Việc đó có vẻ hơi nguy hiểm đấy."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.DISMANTLE.INUSE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.DISMANTLE.INUSE"
msgid "Guess I have to wait."
msgstr "Chắc tôi phải đợi thôi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.DISMANTLE.NOTEMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.DISMANTLE.NOTEMPTY"
msgid "I should make sure it's empty first."
msgstr "Tôi nên chắc chắn là nó trống trước đã."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.DIVEGRAB.MISSED
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.DIVEGRAB.MISSED"
msgid "Don't give up, Walter!"
msgstr "Đừng bỏ cuộc, Walter!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.DRAW.NOIMAGE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.DRAW.NOIMAGE"
msgid "Wait... Woby, do you remember what it looked like?"
msgstr "Khoan đã... Woby, cậu có nhớ trông nó thế nào không?"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.FILL_OCEAN.UNSUITABLE_FOR_PLANTS
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.FILL_OCEAN.UNSUITABLE_FOR_PLANTS"
msgid "Maybe if I was growing a garden full of seaweed."
msgstr "Trừ khi tôi đang trồng một khu vườn toàn rong biển."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.FISH_OCEAN.TOODEEP
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.FISH_OCEAN.TOODEEP"
msgid "A Pinetree Pioneer knows to use the right equipment. And this isn't it."
msgstr "Một Hướng đạo sinh Cây Thông biết phải dùng đúng dụng cụ. Và đây không phải thứ đó."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GENERIC.ITEMMIMIC
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GENERIC.ITEMMIMIC"
msgid "Oops!"
msgstr "Ôi không!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.ABIGAILHEART
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.ABIGAILHEART"
msgid "If it makes you feel better, ghosts are way more interesting anyway."
msgstr "Nếu nó làm cậu thấy khá hơn, dẫu sao thì hồn ma thú vị hơn nhiều."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.BUSY
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.BUSY"
msgid "I guess they're busy."
msgstr "Tôi đoán là họ đang bận."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.CANTSHADOWREVIVE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.CANTSHADOWREVIVE"
msgid "Darnit. It's not working."
msgstr "Chết tiệt. Không có tác dụng."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.CARNIVALGAME_ALREADY_PLAYING
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.CARNIVALGAME_ALREADY_PLAYING"
msgid "We can wait till they're done. Right Woby?"
msgstr "Chúng ta có thể đợi cho đến khi họ chơi xong. Phải không Woby?"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.CARNIVALGAME_GOLFGAME_NOTREADY
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.CARNIVALGAME_GOLFGAME_NOTREADY"
msgid "We can't play until there's a flaghole, Woby!"
msgstr "Chúng ta không thể chơi cho đến khi có lỗ cờ, Woby!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.CARNIVALGAME_INVALID_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.CARNIVALGAME_INVALID_ITEM"
msgid "I had a feeling that wouldn't work..."
msgstr "Tôi có cảm giác cách đó không hiệu quả đâu..."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.DEAD
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.DEAD"
msgid "Oh, uh... I think they're busy. Being dead."
msgstr "Ồ, à... tôi nghĩ họ đang bận. Bận chết ấy."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.DUPLICATE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.DUPLICATE"
msgid "I know that one already."
msgstr "Cái đó tôi biết rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.FOODFULL
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.FOODFULL"
msgid "There's some provisions in there already."
msgstr "Đã có sẵn một vài thứ lương thực trong đó rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.GENERIC"
msgid "I don't think I should put that there... should I?"
msgstr "Tôi không nghĩ mình nên đặt cái đó ở đây... phải không nhỉ?"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.GHOSTHEART
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.GHOSTHEART"
msgid "They seem pretty committed to their lifestyle. Or lack of one?"
msgstr "Họ có vẻ rất tận tụy với lối sống của mình. Hoặc là việc thiếu đi một lối sống?"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG"
msgid "One of those haunted logs should do the trick."
msgstr "Một trong những khúc gỗ bị ma ám đó sẽ phát huy tác dụng đấy."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM"
msgid "I need to forage for mushrooms! C'mon Woby!"
msgstr "Tôi cần đi kiếm nấm! Mau lên Woby!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.MUSHROOMFARM_NOMOONALLOWED
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.MUSHROOMFARM_NOMOONALLOWED"
msgid "I don't think they'll grow here."
msgstr "Tôi không nghĩ chúng sẽ mọc ở đây đâu."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.NOGENERATORSKILL
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.NOGENERATORSKILL"
msgid "That's probably not going to work."
msgstr "Chắc là cái đó không hoạt động đâu."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.NOMOON
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.NOMOON"
msgid "I'll have to wait until the moon's out."
msgstr "Tôi sẽ phải đợi cho đến khi trăng mọc."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.NOTAMONKEY
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.NOTAMONKEY"
msgid "Um. Sorry, could you repeat that please?"
msgstr "Ừm. Xin lỗi, bạn có thể nhắc lại được không?"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.NOTATRIUMKEY
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.NOTATRIUMKEY"
msgid "I'll have to keep looking for the right key."
msgstr "Tôi sẽ phải tiếp tục tìm kiếm chiếc chìa khóa phù hợp."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.NOTDISH
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.NOTDISH"
msgid "That... doesn't look like something anyone would eat."
msgstr "Thứ đó... trông không giống thứ mà bất kỳ ai sẽ ăn cả."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.NOTGEM
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.NOTGEM"
msgid "That's probably not going to work."
msgstr "Chắc là cái đó không hoạt động đâu."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.NOTSCULPTABLE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.NOTSCULPTABLE"
msgid "I'm not even going to try sculpting that."
msgstr "Tôi thậm chí còn không thèm thử chạm khắc thứ đó đâu."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.NOTSTAFF
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.NOTSTAFF"
msgid "That's not going to fit there."
msgstr "Cái đó không vừa ở đây đâu."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER"
msgid "Huh? My attention's kind of divided right now."
msgstr "Hả? Lúc này tôi đang bị phân tâm đấy."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.PIGKINGGAME_MESSY
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.PIGKINGGAME_MESSY"
msgid "Can't do anything until the area's been cleared up!"
msgstr "Không thể làm gì cho đến khi khu vực này được dọn sạch!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.PIGKINGGAME_TOOLATE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.PIGKINGGAME_TOOLATE"
msgid "It's too late for that."
msgstr "Quá muộn cho việc đó rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.QUEENBUSY
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.QUEENBUSY"
msgid "Sorry ma'am, I'll wait until you're ready."
msgstr "Xin lỗi thưa ngài, tôi sẽ đợi cho đến khi ngài sẵn sàng."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.SLEEPING"
msgid "Hey Woby, should we wake them up?"
msgstr "Này Woby, chúng ta có nên đánh thức họ dậy không?"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.SLOTFULL
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.SLOTFULL"
msgid "It's already packed."
msgstr "Nó được đóng gói kín rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.SPIDERNOHAT
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.SPIDERNOHAT"
msgid "I don't think that would be very comfy for the spider."
msgstr "Tôi không nghĩ điều đó sẽ thoải mái cho con nhện lắm đâu."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.TERRARIUM_COOLDOWN
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.TERRARIUM_COOLDOWN"
msgid "There's no tree to give anything to yet!"
msgstr "Chưa có cái cây nào để dâng hiến cả!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.TERRARIUM_REFUSE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.TERRARIUM_REFUSE"
msgid "I guess that was a silly thing to try..."
msgstr "Tôi đoán đó là một ý tưởng ngớ ngẩn khi thử..."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.WRONGGEM
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.WRONGGEM"
msgid "That doesn't look right."
msgstr "Trông có vẻ không đúng lắm."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.WRONGSHADOWFORM
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE.WRONGSHADOWFORM"
msgid "Did I put it together wrong? I wish it had instructions..."
msgstr "Có phải tôi lắp ghép nhầm không nhỉ? Ước gì nó có sách hướng dẫn..."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVEALLTOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVEALLTOPLAYER.BUSY"
msgid "I guess they're busy."
msgstr "Tôi đoán là họ đang bận."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVEALLTOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVEALLTOPLAYER.DEAD"
msgid "Oh, uh... I think they're busy. Being dead."
msgstr "Ồ, à... tôi nghĩ họ đang bận. Bận chết ấy."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVEALLTOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVEALLTOPLAYER.FULL"
msgid "Looks like you've already got enough supplies."
msgstr "Trông có vẻ bạn đã có đủ đồ dự trữ rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING"
msgid "Hey Woby, should we wake them up?"
msgstr "Này Woby, chúng ta có nên đánh thức họ dậy không?"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVETOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVETOPLAYER.BUSY"
msgid "I guess they're busy."
msgstr "Tôi đoán là họ đang bận."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVETOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVETOPLAYER.DEAD"
msgid "Oh, uh... I think they're busy. Being dead."
msgstr "Ồ, à... tôi nghĩ họ đang bận. Bận chết ấy."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVETOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVETOPLAYER.FULL"
msgid "Looks like you've already got enough supplies."
msgstr "Trông có vẻ bạn đã có đủ đồ dự trữ rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVETOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVETOPLAYER.SLEEPING"
msgid "Hey Woby, should we wake them up?"
msgstr "Này Woby, chúng ta có nên đánh thức họ dậy không?"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE_TACKLESKETCH.DUPLICATE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVE_TACKLESKETCH.DUPLICATE"
msgid "Heh. I learned that ages ago!"
msgstr "Hừ. Tôi học cái đó từ lâu rồi!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.HARVEST.DOER_ISNT_MODULE_OWNER
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.HARVEST.DOER_ISNT_MODULE_OWNER"
msgid "I was trying to scratch behind his ears... but I don't think he has any."
msgstr "Tôi định gãi sau tai nó... nhưng tôi không nghĩ nó có tai đâu."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.HEAL.NOT_MERM
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.HEAL.NOT_MERM"
msgid "No Woby, that's for bog monsters only."
msgstr "Không Woby, cái đó chỉ dành cho quái vật đầm lầy thôi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.HERD_FOLLOWERS.WEBBERONLY
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.HERD_FOLLOWERS.WEBBERONLY"
msgid "They're not listening to me! Maybe Webber can talk to them..."
msgstr "Chúng không thèm nghe tôi! Có lẽ Webber có thể nói chuyện với chúng..."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.HITCHUP.BEEF_HITCHED
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.HITCHUP.BEEF_HITCHED"
msgid "Don't worry, my beefalo isn't going anywhere."
msgstr "Đừng lo, con bò lai của tôi không đi đâu đâu."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.HITCHUP.INMOOD
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.HITCHUP.INMOOD"
msgid "Maybe we should wait for them to calm down..."
msgstr "Có lẽ chúng ta nên đợi chúng bình tĩnh lại..."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.HITCHUP.NEEDBEEF
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.HITCHUP.NEEDBEEF"
msgid "Sorry Woby, I need a real beefalo for this."
msgstr "Xin lỗi Woby, tôi cần một con bò lai thực sự cho việc này."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.HITCHUP.NEEDBEEF_CLOSER
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.HITCHUP.NEEDBEEF_CLOSER"
msgid "I should call my beefalo over here."
msgstr "Tôi nên gọi con bò lai của mình tới đây."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.LOWER_SAIL_FAIL.1
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.LOWER_SAIL_FAIL.1"
msgid "One more time, just like in the handbook."
msgstr "Làm lại lần nữa, y như trong cẩm nang hướng dẫn."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.LOWER_SAIL_FAIL.2
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.LOWER_SAIL_FAIL.2"
msgid "Aah, rope burn!"
msgstr "Ái, bị dây thừng cọ rát tay quá!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.LOWER_SAIL_FAIL.3
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.LOWER_SAIL_FAIL.3"
msgid "This is harder than the diagrams make it look..."
msgstr "Cái này khó hơn mấy hình minh họa vẽ nhiều..."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.MARK.ALREADY_MARKED
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.MARK.ALREADY_MARKED"
msgid "I already picked one!"
msgstr "Tôi đã chọn một cái rồi mà!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.MARK.NOT_PARTICIPANT
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.MARK.NOT_PARTICIPANT"
msgid "Woby and I will just watch for this round."
msgstr "Woby và tôi sẽ chỉ đứng xem ở hiệp này thôi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.MODSLINGSHOT.NOSLINGSHOT
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.MODSLINGSHOT.NOSLINGSHOT"
msgid "I don't have a slingshot to mod!"
msgstr "Tôi có cái súng ná nào để độ chế đâu!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.MOUNT.INUSE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.MOUNT.INUSE"
msgid "I guess this seat's occupied."
msgstr "Tôi đoán là chỗ này có người ngồi rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.MOUNT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.MOUNT.SLEEPING"
msgid "Sorry to wake you, but could you give me a ride?"
msgstr "Xin lỗi vì đã làm phiền cậu thức giấc, nhưng cho tôi đi nhờ một đoạn được không?"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.MOUNT.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.MOUNT.TARGETINCOMBAT"
msgid "Hey, calm down! Let me on!"
msgstr "Này, bình tĩnh nào! Cho tôi lên với!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.MUTATE.CAVE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.MUTATE.CAVE"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.MUTATE.NOFULLMOON
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.MUTATE.NOFULLMOON"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.MUTATE.NOGHOST
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.MUTATE.NOGHOST"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.MUTATE.NONEWMOON
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.MUTATE.NONEWMOON"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.MUTATE.NOTNIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.MUTATE.NOTNIGHT"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.OCEAN_FISHING_POND.WRONGGEAR
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.OCEAN_FISHING_POND.WRONGGEAR"
msgid "Hm... my handbook says I need a different kind of fishing rod."
msgstr "Hừm... cẩm nang của tôi nói rằng tôi cần một loại cần câu khác."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.OPEN_CRAFTING.PROFESSIONALCHEF
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.OPEN_CRAFTING.PROFESSIONALCHEF"
msgid "I should probably leave that alone."
msgstr "Có lẽ tôi nên để yên cho nó thì hơn."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.OPEN_CRAFTING.SHADOWMAGIC
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.OPEN_CRAFTING.SHADOWMAGIC"
msgid "Maybe you could teach me some magic tricks? I'm a quick learner!"
msgstr "Cậu có thể dạy tôi vài thủ thuật ma thuật được không? Tôi học nhanh lắm đấy!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.PICK.NOTHING_INSIDE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.PICK.NOTHING_INSIDE"
msgid "Better luck next time!"
msgstr "Chúc may mắn lần sau!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.PICK.STUCK
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.PICK.STUCK"
msgid "It's stuck. Oh well!"
msgstr "Nó kẹt mất rồi. Thôi kệ đi!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.PICKUP.FULL_OF_CURSES
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.PICKUP.FULL_OF_CURSES"
msgid "I really shouldn't pick up things that don't belong to me."
msgstr "Tôi thực sự không nên nhặt những thứ không thuộc về mình."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.PICKUP.INUSE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.PICKUP.INUSE"
msgid "Guess I have to wait."
msgstr "Chắc tôi phải đợi thôi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.PICKUP.NOTMINE_YOTC.1
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.PICKUP.NOTMINE_YOTC.1"
msgid "Wait... you're not my carrat!"
msgstr "Khoan đã... mày không phải Cà Ruột của tao!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.PICKUP.NOTMINE_YOTC.2
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.PICKUP.NOTMINE_YOTC.2"
msgid "Mine was the OTHER orange one."
msgstr "Của tôi là con màu cam KHÁC cơ."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.PICKUP.RESTRICTION
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.PICKUP.RESTRICTION"
msgid "That's not mine."
msgstr "Đó không phải của tôi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.FERTILIZER"
msgid "I think I know everything I need to."
msgstr "Tôi nghĩ mình biết mọi thứ cần biết rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.GENERIC"
msgid "I've already learned everything I need to know about that one."
msgstr "Tôi đã học được mọi thứ cần biết về món đó rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.POUNCECAPTURE.MISSED
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.POUNCECAPTURE.MISSED"
msgid "Don't give up, Walter!"
msgstr "Đừng bỏ cuộc, Walter!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.POUR_WATER.OUT_OF_WATER
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.POUR_WATER.OUT_OF_WATER"
msgid "Well, that's the last of the water."
msgstr "Chà, hết sạch nước rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.POUR_WATER_GROUNDTILE.OUT_OF_WATER
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.POUR_WATER_GROUNDTILE.OUT_OF_WATER"
msgid "I'll need to get more water."
msgstr "Tôi sẽ cần phải lấy thêm nước."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.REMOTE_TELEPORT.NODEST
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.REMOTE_TELEPORT.NODEST"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.REMOTE_TELEPORT.NOSKILL
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.REMOTE_TELEPORT.NOSKILL"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.REMOVEMODULES.NO_MODULES
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.REMOVEMODULES.NO_MODULES"
msgid "only_used_by_wx78"
msgstr "chỉ_được_sử_dụng_bởi_wx78"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.REPAIR.WRONGPIECE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.REPAIR.WRONGPIECE"
msgid "No, see? That doesn't fit together at all!"
msgstr "Không, thấy chưa? Mấy mảnh đó có khớp với nhau tí nào đâu!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.REPLATE.MISMATCH
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.REPLATE.MISMATCH"
msgid "I need to use a different dish. Apparently."
msgstr "Tôi cần phải dùng một cái đĩa khác. Rõ ràng là thế."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.REPLATE.SAMEDISH
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.REPLATE.SAMEDISH"
msgid "That just looks like the same dish..."
msgstr "Trông nó chẳng khác gì cái đĩa cũ cả..."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.ROW_FAIL.BAD_TIMING0
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.ROW_FAIL.BAD_TIMING0"
msgid "Wait, I can do it! Just need to get the hang of it."
msgstr "Khoan, tôi làm được mà! Chỉ cần nắm bắt được nhịp điệu thôi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.ROW_FAIL.BAD_TIMING1
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.ROW_FAIL.BAD_TIMING1"
msgid "That was just practice!"
msgstr "Đó chỉ là tập luyện thôi!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.ROW_FAIL.BAD_TIMING2
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.ROW_FAIL.BAD_TIMING2"
msgid "Come on Walter, follow the timing, just like in the handbook."
msgstr "Thôi nào Walter, theo nhịp điệu vào chứ, y như trong cẩm nang ấy."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.RUMMAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.RUMMAGE.GENERIC"
msgid "That's against the rules."
msgstr "Việc đó phạm quy đấy."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.RUMMAGE.INUSE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.RUMMAGE.INUSE"
msgid "Do you like radio shows? There was this great horror one I used to listen to-"
msgstr "Cậu thích nghe chương trình phát thanh không? Có một chương trình kinh dị hay lắm mà tôi hay nghe hồi trước-"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.RUMMAGE.NOTAMERM
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.RUMMAGE.NOTAMERM"
msgid "I don't want to make the bog monsters mad at me!"
msgstr "Tôi không muốn làm bọn quái vật đầm lầy nổi giận với mình đâu!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.RUMMAGE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.RUMMAGE.NOTAROBOT"
msgid "It's not for us, Woby."
msgstr "Cái đó không dành cho chúng ta đâu, Woby."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.RUMMAGE.NOTMASTERCHEF
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.RUMMAGE.NOTMASTERCHEF"
msgid "I'll go check on my own supplies."
msgstr "Tôi đi kiểm tra đồ dự trữ của mình đây."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.RUMMAGE.NOTSOULJARHANDLER
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.RUMMAGE.NOTSOULJARHANDLER"
msgid "They're souls Woby, not treats."
msgstr "Đó là linh hồn đấy Woby, không phải món ăn vặt đâu."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.RUMMAGE.RESTRICTED
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.RUMMAGE.RESTRICTED"
msgid "Aww, I can't use that."
msgstr "Ôi, tôi không dùng được thứ đó rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.SADDLE.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.SADDLE.TARGETINCOMBAT"
msgid "I'll... wait till you're done."
msgstr "Tôi sẽ... đợi cho đến khi cậu xong việc vậy."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.SHAVE.AWAKEBEEFALO
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.SHAVE.AWAKEBEEFALO"
msgid "Wouldn't that be kind of rude?"
msgstr "Làm thế có hơi bất lịch sự không nhỉ?"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.SHAVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.SHAVE.GENERIC"
msgid "Maybe if I ask nicely..."
msgstr "Có lẽ nếu tôi xin xỏ tử tế..."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.SHAVE.NOBITS
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.SHAVE.NOBITS"
msgid "He's already had a close shave. Heh, good one Walter."
msgstr "Nó vừa cạo sát xong. Hì, hay đấy Walter."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.SHAVE.SOMEONEELSESBEEFALO
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.SHAVE.SOMEONEELSESBEEFALO"
msgid "That doesn't seem very polite..."
msgstr "Việc đó có vẻ không lịch sự cho lắm..."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.SLAUGHTER.TOOFAR
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.SLAUGHTER.TOOFAR"
msgid "Hey, slow down! I just want to eat you!"
msgstr "Này, đi chậm lại chứ! Tôi chỉ muốn ăn thịt cậu thôi mà!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.SOAKIN.NOSPACE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.SOAKIN.NOSPACE"
msgid "Guess I'll just have to find another spot!"
msgstr "Chắc tôi phải tìm chỗ khác thôi!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.START_CARRAT_RACE.NO_RACERS
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.START_CARRAT_RACE.NO_RACERS"
msgid "Oh. I forgot the racers!"
msgstr "Ồ. Tôi quên mất mấy vận động viên đua rồi!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.STORE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.STORE.GENERIC"
msgid "I can't fit anything else in there."
msgstr "Tôi không thể nhét thêm gì vào trong đó nữa rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.STORE.INUSE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.STORE.INUSE"
msgid "\"A Pinetree Pioneer is patient and polite.\" But uh, hurry up please?"
msgstr "\"Hướng đạo sinh Cây Thông phải kiên nhẫn và lịch sự.\" Nhưng mà à, làm ơn nhanh lên giúp nhé?"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.STORE.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.STORE.NOTALLOWED"
msgid "That's against the rules."
msgstr "Việc đó phạm quy đấy."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.STORE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.STORE.NOTAROBOT"
msgid "It's not for us, Woby."
msgstr "Cái đó không dành cho chúng ta đâu, Woby."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.STORE.NOTMASTERCHEF
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.STORE.NOTMASTERCHEF"
msgid "I'd rather cook over a campfire, honestly..."
msgstr "Thành thật mà nói, tôi thích nấu nướng trên lửa trại hơn..."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.STORE.NOTSOULJARHANDLER
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.STORE.NOTSOULJARHANDLER"
msgid "They're souls Woby, not treats."
msgstr "Đó là linh hồn đấy Woby, không phải món ăn vặt đâu."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.STORE.RESTRICTED
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.STORE.RESTRICTED"
msgid "Aww, I can't use that."
msgstr "Ôi, tôi không dùng được thứ đó rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.TEACH.CANTLEARN
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.TEACH.CANTLEARN"
msgid "Sorry, I kind of lost interest."
msgstr "Xin lỗi, tôi hơi mất hứng rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.TEACH.KNOWN
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.TEACH.KNOWN"
msgid "Heh. I already knew that."
msgstr "Hừ. Tôi biết cái đó rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.TEACH.MESSAGEBOTTLEMANAGER_NOT_FOUND
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.TEACH.MESSAGEBOTTLEMANAGER_NOT_FOUND"
msgid "Come on Walter, gotta focus! Don't get distracted!"
msgstr "Nào Walter, phải tập trung vào! Đừng để bị phân tâm!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.TEACH.STASH_MAP_NOT_FOUND
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.TEACH.STASH_MAP_NOT_FOUND"
msgid "Um... those monkeys aren't very good at making maps."
msgstr "Ừm... mấy con khỉ đó vẽ bản đồ tệ thật đấy."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.TEACH.WRONGWORLD
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.TEACH.WRONGWORLD"
msgid "Wait... this map looks all wrong."
msgstr "Khoan đã... tấm bản đồ này trông sai bét nhè."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.TELLSTORY.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.TELLSTORY.GENERIC"
msgid "This isn't really the place for a scary story..."
msgstr "Đây không phải là lúc thích hợp để kể chuyện kinh dị đâu..."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.TELLSTORY.NOT_NIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.TELLSTORY.NOT_NIGHT"
msgid "I should wait until it's dark, for maximum spookiness."
msgstr "Tôi nên đợi cho trời tối hẳn để đạt độ đáng sợ tối đa."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.TELLSTORY.NO_FIRE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.TELLSTORY.NO_FIRE"
msgid "I need a fire, it adds to the atmosphere!"
msgstr "Tôi cần một ngọn lửa, nó làm tăng thêm không khí đấy!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.UNLOCK.WRONGKEY
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.UNLOCK.WRONGKEY"
msgid "That's not right."
msgstr "Không đúng rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.USEITEMON.BEEF_BELL_ALREADY_USED
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.USEITEMON.BEEF_BELL_ALREADY_USED"
msgid "I already rang it!"
msgstr "Tôi rung nó rồi mà!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.USEITEMON.BEEF_BELL_HAS_BEEF_ALREADY
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.USEITEMON.BEEF_BELL_HAS_BEEF_ALREADY"
msgid "I've already got as many big fuzzy friends as I can manage."
msgstr "Tôi đã có nhiều người bạn lớn lông xù nhất có thể rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.USEITEMON.BEEF_BELL_INVALID_TARGET
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.USEITEMON.BEEF_BELL_INVALID_TARGET"
msgid "I don't think that's going to work."
msgstr "Tôi không nghĩ cách đó sẽ hiệu quả đâu."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.USEITEMON.CANNOT_FIX_DRONE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.USEITEMON.CANNOT_FIX_DRONE"
msgid "Aww, it can't be fixed."
msgstr "Ôi, nó không sửa được nữa rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.USEITEMON.NOT_MINE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.USEITEMON.NOT_MINE"
msgid "That's not ours, Woby."
msgstr "Đó không phải của chúng ta, Woby."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS"
msgid "Wait, I want to get a closer look at that monster!"
msgstr "Khoan, tôi muốn nhìn kỹ hơn con quái vật đó!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY"
msgid "I guess I need another key."
msgstr "Chắc tôi cần một chiếc chìa khóa khác."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY"
msgid "I don't think that's what I'm supposed to use in this situation."
msgstr "Tôi không nghĩ đó là thứ mình nên dùng trong hoàn cảnh này."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.WRAPBUNDLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.WRAPBUNDLE.EMPTY"
msgid "Darnit, I forgot to get something to wrap."
msgstr "Chết tiệt, tôi quên kiếm thứ để gói lại rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.WRITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.WRITE.GENERIC"
msgid "I probably shouldn't..."
msgstr "Có lẽ tôi không nên..."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.WRITE.INUSE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.WRITE.INUSE"
msgid "Hey! What are you writing?"
msgstr "Này! Cậu đang viết gì thế?"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.YOTB_STARTCONTEST.ALREADYACTIVE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.YOTB_STARTCONTEST.ALREADYACTIVE"
msgid "There must be another contest going on somewhere else."
msgstr "Chắc hẳn có cuộc thi nào đó đang diễn ra ở đâu khác rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK"
msgid "Maybe he took the day off?"
msgstr "Chắc chú ấy nghỉ phép à?"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.YOTB_STARTCONTEST.NORESPONSE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.YOTB_STARTCONTEST.NORESPONSE"
msgid "He must be wandering around somewhere."
msgstr "Chắc chú ấy đang đi lang thang đâu đó rồi."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE"
msgid "Busy as a bee—f!"
msgstr "Bận như con ong—t!"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN"
msgid "We already know this one, don't we Woby?"
msgstr "Cái này tụi mình biết rồi phải không Woby?"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL_GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL_GENERIC"
msgid "It won't work."
msgstr "Không có tác dụng đâu."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ACCOMPLISHMENT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ACCOMPLISHMENT"
msgid "I did it!"
msgstr "Tớ làm được rồi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ACCOMPLISHMENT_DONE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ACCOMPLISHMENT_DONE"
msgid "If I were back home, I'd get a badge for that!"
msgstr "Mà ở nhà là tớ được tặng huy hiệu rồi đấy!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ACIDBATS
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ACIDBATS"
msgid "Here they come!"
msgstr "Chúng đến kìa!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ADVENTUREFAIL
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ADVENTUREFAIL"
msgid "Perseverance is the Pinetree Pioneer way!"
msgstr "Kiên trì là phong cách của Hướng đạo sinh Cây Thông!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_AMMO_SLOT_OVERSTACKED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_AMMO_SLOT_OVERSTACKED"
msgid "There's too much ammo to swap out now."
msgstr "Nhiều đạn quá, giờ không đổi được đâu."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ANTLION_SINKHOLE.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ANTLION_SINKHOLE.1"
msgid "Woah!"
msgstr "Úi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ANTLION_SINKHOLE.2
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ANTLION_SINKHOLE.2"
msgid "I think there's something moving underground!"
msgstr "Tớ nghĩ có gì đó đang chuyển động dưới lòng đất!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ANTLION_SINKHOLE.3
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ANTLION_SINKHOLE.3"
msgid "Hang on, I'm sure my handbook says what to do in an earthquake!"
msgstr "Đợi đã, tớ chắc là cẩm nang của mình có hướng dẫn cách xử lý động đất mà!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ANTLION_TRIBUTE.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ANTLION_TRIBUTE.1"
msgid "I brought you something!"
msgstr "Tớ mang cho bạn cái này nè!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ANTLION_TRIBUTE.2
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ANTLION_TRIBUTE.2"
msgid "This is for you!"
msgstr "Cái này cho bạn nè!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ANTLION_TRIBUTE.3
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ANTLION_TRIBUTE.3"
msgid "Woah... you're amazing!"
msgstr "Ồ... bạn tuyệt quá đấy!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE"
msgid "Huh? It's giving me instructions!"
msgstr "Hả? Nó đang hướng dẫn tớ kìa!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ARCHIVE_NO_POWER
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ARCHIVE_NO_POWER"
msgid "Hm, it doesn't look like it's working."
msgstr "Hừm, trông nó có vẻ không hoạt động rồi."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE"
msgid "I knew that one already."
msgstr "Cái đó tớ biết từ trước rồi."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ATRIUM_DESTABILIZING.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ATRIUM_DESTABILIZING.1"
msgid "Woah! What's happening?"
msgstr "Úi! Chuyện gì đang xảy ra vậy?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ATRIUM_DESTABILIZING.2
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ATRIUM_DESTABILIZING.2"
msgid "Don't be scared, Woby!"
msgstr "Đừng sợ, Woby!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ATRIUM_DESTABILIZING.3
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ATRIUM_DESTABILIZING.3"
msgid "Hey... I think this might not be safe."
msgstr "Này... tớ nghĩ chỗ này không được an toàn cho lắm."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ATTACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ATTACH_BUFF_ATTACK"
msgid "Woah! I feel like I can take on the world!"
msgstr "Ồ! Tớ cảm thấy mình có thể cân cả thế giới!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK"
msgid "This reminds me of a radio program I heard where a guy was hit by lightning and turned into pure electricity and-"
msgstr "Cái này làm tớ nhớ đến một chương trình phát thanh nghe được, có ông bị sét đánh trúng rồi biến thành điện nguyên chất và-"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY"
msgid "Nothing's going to rain on my parade! Because I'm waterproof, get it?"
msgstr "Không gì có thể làm hỏng ngày vui của tớ được! Vì tớ không thấm nước, hiểu chưa?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION"
msgid "I'm invincible!"
msgstr "Tớ là bất tử!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE"
msgid "Wide awake and ready for anything!"
msgstr "Tỉnh táo hoàn toàn và sẵn sàng cho mọi thứ!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS"
msgid "Come on Woby, let's get to work!"
msgstr "Nào Woby, đi làm việc thôi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_BECOMEGHOST
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_BECOMEGHOST"
msgid "oOooOooo!!"
msgstr "oOooOooo!!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_BEES
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_BEES"
msgid "I love bees! Too bad I'm uh... deathly allergic to them."
msgstr "Tớ thích ong lắm! Tiếc là tớ lại... dị ứng chết người với chúng."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_BOAT_LEAK"
msgid "Um. That might be a problem."
msgstr "Ừm. Có vẻ đây là một vấn đề lớn đấy."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_BOAT_SINK
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_BOAT_SINK"
msgid "Better put my swimming badge to good use!"
msgstr "Tốt hơn là nên phát huy huy hiệu bơi lội của mình thôi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_BOOMERANG"
msgid "Hey, who threw that?! Oh, wait..."
msgstr "Này, đứa nào vừa ném thế?! Ồ, từ từ đã..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_BRAVERY_POTION
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_BRAVERY_POTION"
msgid "There's nothing to be afraid of!"
msgstr "Có gì mà phải sợ chứ!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_BURNT"
msgid "Ow, ow, ow! Does anyone know first aid? Is this a third degree burn?!"
msgstr "Ái, ái, ái! Có ai biết sơ cứu không? Đây là bỏng độ ba à?!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_CALL_BEEF
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_CALL_BEEF"
msgid "Come here, girl! Or boy? It's hard to tell."
msgstr "Lại đây nào cô bé! Hay cậu bé nhỉ? Khó nhận ra thật."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_CANFIX
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_CANFIX"
msgid "\nDon't worry, I know how to fix it!"
msgstr "\nĐừng lo, tớ biết cách sửa nó mà!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS"
msgid "It looks like I need to find more supplies first."
msgstr "Có vẻ tớ cần tìm thêm nguyên liệu trước đã."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_CANNOT_BUILD.NO_STATION
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_CANNOT_BUILD.NO_STATION"
msgid "I could probably do it if I had a station with the right tools."
msgstr "Chắc tớ làm được nếu có một trạm chế tạo với đầy đủ dụng cụ."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_CANNOT_BUILD.NO_TECH
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_CANNOT_BUILD.NO_TECH"
msgid "Um... I don't think I know how to make one of those yet..."
msgstr "Ừm... tớ nghĩ mình chưa biết cách làm cái đó..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_CANTBUILDHERE_YOTB_POST
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_CANTBUILDHERE_YOTB_POST"
msgid "It doesn't make sense to build it so far away..."
msgstr "Xây ở xa thế này thì có ích gì đâu..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_CANT_ESCAPE_CURSE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_CANT_ESCAPE_CURSE"
msgid "Huh... maybe I don't want to drop it after all."
msgstr "Hừm... có lẽ tớ không muốn vứt nó nữa đâu."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP"
msgid "Hey! We need to start over, mine's asleep!"
msgstr "Này! Phải bắt đầu lại thôi, của tớ đang ngủ gật rồi kìa!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_CARRAT_ERROR_STUNNED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_CARRAT_ERROR_STUNNED"
msgid "That sound means go! Go!!"
msgstr "Tiếng đó nghĩa là xuất phát! Chạy đi!!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_CARRAT_ERROR_WALKING
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_CARRAT_ERROR_WALKING"
msgid "You can go faster, we trained for this! Or did we..."
msgstr "Cậu chạy nhanh hơn được mà, tụi mình luyện tập cho việc này rồi cơ mà! Hay là chưa..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1"
msgid "Hey! You have to turn around!"
msgstr "Này! Cậu phải quay đầu lại chứ!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2"
msgid "The finish line's the other way! The. Other. Way!!"
msgstr "Vạch Đích ở hướng ngược lại cơ mà! Hướng. Ngược. Lại!!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_CARRAT_START_RACE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_CARRAT_START_RACE"
msgid "READY-SET-GO!!"
msgstr "CHUẨN BỊ - SẴN SÀNG - XUẤT PHÁT!!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_CAVEIN
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_CAVEIN"
msgid "Wait. Is this... dangerous?"
msgstr "Đợi đã. Cái này có... nguy hiểm không vậy?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_CHAIR_ON_FIRE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_CHAIR_ON_FIRE"
msgid "This is fine."
msgstr "Mọi chuyện vẫn ổn."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_CHARLIE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_CHARLIE"
msgid "Woah! What are you?"
msgstr "Úi! Cậu là cái gì thế?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_CHARLIESAVE.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_CHARLIESAVE.1"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_CHARLIE_ATTACK
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_CHARLIE_ATTACK"
msgid "Hey w-wait- I thought we could be friends!"
msgstr "Này đ-đợi đã- tớ tưởng chúng ta có thể làm bạn chứ!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_COACH.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_COACH.1"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_COACH.2
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_COACH.2"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_COACH.3
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_COACH.3"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_COACH.4
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_COACH.4"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_COACH.5
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_COACH.5"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_COACH.6
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_COACH.6"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_COACH.7
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_COACH.7"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_COACH.8
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_COACH.8"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_COACH.9
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_COACH.9"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_COLD"
msgid "Brr... I sh-should find a way to w-warm up."
msgstr "Brr... m-mình phải tìm cách s-sưởi ấm mới được."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_COMPASS_OUT"
msgid "What...? I've never seen a compass do this before."
msgstr "Cái gì thế...? Tớ chưa thấy cái la bàn nào thế này bao giờ."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_COZY_SLEEP
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_COZY_SLEEP"
msgid "Wow, that was a good night's sleep!"
msgstr "Ồ, đêm qua ngủ đã thật đấy!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_CRAFTING_FAIL"
msgid "I don't have all the supplies I need."
msgstr "Tớ không có đủ nguyên liệu cần thiết rồi."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_DAMP"
msgid "It's just a little water!"
msgstr "Chỉ dính chút nước thôi mà!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_DEERCLOPS"
msgid "That has to be a Deerclops! I need to get a closer look!"
msgstr "Chắc chắn đó là một con Deerclops! Tớ phải lại gần xem mới được!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_DESPAWN"
msgid "I don't feel so good..."
msgstr "Tớ thấy hơi khó chịu trong người..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_DETACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_DETACH_BUFF_ATTACK"
msgid "Huh? My punches feel wimpier... not that I was wimpy before!"
msgstr "Hả? Cú đấm của tớ có vẻ yếu ớt thế nhỉ... không phải trước đây tớ yếu đâu nhé!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK"
msgid "Darnit... guess the show's over."
msgstr "Khỉ thật... chắc buổi biểu diễn kết thúc rồi."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY"
msgid "Oh well. It's good to stay hydrated anyway."
msgstr "Thôi kệ. Dù sao thì giữ cơ thể đủ nước vẫn tốt hơn."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION"
msgid "Back to regular Walter."
msgstr "Trở lại là Walter bình thường."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE"
msgid "I'm starting to get a bit tired..."
msgstr "Tớ bắt đầu thấy hơi buồn ngủ rồi đây..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS"
msgid "Alright, time for a break."
msgstr "Được rồi, đến lúc nghỉ ngơi một lát."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_DIG_DISEASE_WARNING"
msgid "That should help... I think."
msgstr "Chắc sẽ ổn thôi... tớ nghĩ thế."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_DUSK"
msgid "It's getting late, better set up camp soon."
msgstr "Trời muộn rồi, chắc phải dựng trại sớm thôi."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_EAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_EAT.GENERIC"
msgid "Being outdoors makes everything taste better!"
msgstr "Ở ngoài trời làm món gì cũng thấy ngon hơn hết!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_EAT.INVALID
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_EAT.INVALID"
msgid "I don't think that's safe to eat."
msgstr "Tớ không nghĩ cái đó an toàn để ăn đâu."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_EAT.PAINFUL
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_EAT.PAINFUL"
msgid "Oooh... my stomach hurts..."
msgstr "Úi chà... đau bụng quá..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_EAT.SPOILED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_EAT.SPOILED"
msgid "Ugh, what did I just eat?"
msgstr "Eo ôi, tớ vừa ăn cái gì thế này?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_EAT.STALE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_EAT.STALE"
msgid "I think that was old..."
msgstr "Tớ nghĩ cái đó cũ lắm rồi..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_EAT.YUCKY"
msgid "Even Woby wouldn't eat that."
msgstr "Ngay cả Woby cũng chẳng thèm ăn cái đó nữa là."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_EATING_NOT_FEASTING
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_EATING_NOT_FEASTING"
msgid "Hey everybody! Time to eat!"
msgstr "Mọi người ơi! Đến giờ ăn rồi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ELIXIR_BOOSTED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ELIXIR_BOOSTED"
msgid "Refreshing!"
msgstr "Sảng khoái thật!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ELIXIR_GHOSTVISION
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ELIXIR_GHOSTVISION"
msgid "It's the best of both worlds!"
msgstr "Đúng là đôi đường vẹn toàn!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ELIXIR_PLAYER_SPEED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ELIXIR_PLAYER_SPEED"
msgid "I bet I could carry you, Woby!"
msgstr "Cược là tớ có thể cõng cậu luôn đấy, Woby!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ELIXIR_TOO_SUPER
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ELIXIR_TOO_SUPER"
msgid "I don't think my tummy can handle that."
msgstr "Tớ không nghĩ bụng dạ mình chịu nổi thứ đó đâu."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENCUMBERED.1"
msgid "A Pinetree Pioneer... never gives up...!"
msgstr "Một Hướng đạo sinh Cây Thông... không bao giờ bỏ cuộc...!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENCUMBERED.2"
msgid "This is... ergh... a little heavy..."
msgstr "Cái này... ực... hơi nặng đấy..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENCUMBERED.3"
msgid "Woby... could you... help... at all...?"
msgstr "Woby... cậu có thể... giúp một tay... được không...?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENCUMBERED.4"
msgid "I'll get it...! I just... need a minute...!"
msgstr "Tớ nhấc được mà...! Chỉ... cần một phút thôi...!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENCUMBERED.5"
msgid "This can't... be good... for my spine..."
msgstr "Cái này chắc chắn... không tốt chút nào... cho cột sống của tớ..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENCUMBERED.6"
msgid "Come on Wobyyyy... help me... out!"
msgstr "Nào Wobyyyy... giúp tớ... một tay đi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENCUMBERED.7"
msgid "I can... do it...!"
msgstr "Tớ... làm được mà...!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENCUMBERED.8
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENCUMBERED.8"
msgid "Errgh... just... give me a minute..."
msgstr "Ực... cho tớ... thêm chút thời gian..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENCUMBERED.9
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENCUMBERED.9"
msgid "Why am I... doing this... again...?"
msgstr "Sao mình lại... làm cái trò này... cơ chứ...?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENGINEERING_CAN_UPGRADE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENGINEERING_CAN_UPGRADE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENTER_DARK"
msgid "Ohh, verrry spooooky!"
msgstr "Ồ, r-rất là đáng sợ nha!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ENTER_LIGHT"
msgid "Oh, hey! I can see again!"
msgstr "Ồ, này! Tớ thấy đường lại rồi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_EXIT_GELBLOB
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_EXIT_GELBLOB"
msgid "That was not fun."
msgstr "Trải nghiệm chẳng vui vẻ gì sất."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_EYEOFTERROR_ARRIVE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_EYEOFTERROR_ARRIVE"
msgid "I'm pretty sure that's supposed to be attached to something!"
msgstr "Tớ khá chắc là thứ đó phải dính vào cái gì đó chứ!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_EYEOFTERROR_FLYAWAY
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_EYEOFTERROR_FLYAWAY"
msgid "Aww wait, come back!"
msgstr "Ấy đợi đã, quay lại đi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_EYEOFTERROR_FLYBACK
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_EYEOFTERROR_FLYBACK"
msgid "Oh good, they came back!"
msgstr "Ôi may quá, chúng quay lại rồi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_FAN_OUT"
msgid "Guess it's time for a new fan."
msgstr "Chắc đến lúc phải dùng cái quạt mới rồi."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_FERTILIZER_RESEARCHED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_FERTILIZER_RESEARCHED"
msgid "I didn't know there was so much to learn about this stuff."
msgstr "Tớ không biết là có nhiều thứ để học về ba cái này phết đấy."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_FIRENETTLE_TOXIN.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_FIRENETTLE_TOXIN.1"
msgid "Ah! Ow! It burns!!"
msgstr "Á! Úi! Nóng quá rát quá!!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_FIRENETTLE_TOXIN.2
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_FIRENETTLE_TOXIN.2"
msgid "Aaaah, it got me! It got me!"
msgstr "Aaaah, nó dính lấy tớ rồi! Nó dính lấy tớ rồi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_FIRENETTLE_TOXIN_DONE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_FIRENETTLE_TOXIN_DONE"
msgid "Whew... I-I think I'm okay now."
msgstr "Phù... m-mình nghĩ giờ ổn rồi."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_FLARE_SEEN"
msgid "A signal! We should follow it!"
msgstr "Một tín hiệu! Chúng ta nên đi theo nó!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_FLOATER_HELD
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_FLOATER_HELD"
msgid "I knew I'd come out on top!"
msgstr "Biết ngay là tớ sẽ luôn dẫn đầu mà!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_FLOATER_LETGO
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_FLOATER_LETGO"
msgid "Submerging!"
msgstr "Đang chìm xuống đây!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_FLOAT_SWIM_TIRED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_FLOAT_SWIM_TIRED"
msgid "I gotta paws. Get it, Wobes?"
msgstr "Tớ phải "dừng chân" một nhịp. Hiểu ý tớ không Wobes?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_FOODMEMORY
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_FOODMEMORY"
msgid "only_used_by_warly"
msgstr "chỉ_được_sử_dụng_bởi_warly"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_FREEDOM"
msgid "That wasn't nearly as fun as I thought it'd be..."
msgstr "Chẳng vui như tớ tưởng tượng gì cả..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_GATHER_MERM
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_GATHER_MERM"
msgid "only_used_by_wurt"
msgstr "chỉ_được_sử_dụng_bởi_wurt"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_GHOSTDRAIN"
msgid "My head... I thought having ghosts around would be more fun."
msgstr "Đầu tớ... Tớ cứ tưởng có hồn ma xung quanh sẽ vui hơn cơ."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_GOT_DECON_MISTED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_GOT_DECON_MISTED"
msgid "Huh. Is it just me, or does the atmosphere in here feel lighter?"
msgstr "Hừm. Không biết có phải mỗi mình tớ thấy không khí ở đây nhẹ nhõm hơn không nhỉ?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE"
msgid "Hold on Woby, I think my Acid Repellent is wearing off."
msgstr "Đợi đã Woby, tớ nghĩ Thuốc Chống Axit sắp hết tác dụng rồi."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE"
msgid "I've got to be careful, Woby. My Thermal Balm has worn off."
msgstr "Tớ phải cẩn thận mới được Woby. Cao nhiệt của tớ hết tác dụng rồi."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE"
msgid "We're here, Wobes!"
msgstr "Tới nơi rồi Wobes!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT"
msgid "Aw, it didn't work!"
msgstr "Ái chà, không dùng được!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_HIGHRESEARCH"
msgid "I know everything now! Mostly everything, at least."
msgstr "Giờ tớ biết tuốt rồi! Ít ra thì hầu hết mọi thứ."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_HOT"
msgid "Whew... come on Woby, we'd better find some shade."
msgstr "Phù... đi nào Woby, tốt nhất là tìm chỗ râm mát thôi."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_HOUNDS"
msgid "Woby? Do you hear something?"
msgstr "Woby? Cậu có nghe thấy tiếng gì không?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_HUNGRY"
msgid "Can we stop for a snack break?"
msgstr "Chúng ta dừng lại ăn chút quà vặt được không?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_HUNT_AVOID_FORK
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_HUNT_AVOID_FORK"
msgid "Aww, but the other trail looks so much more exciting..."
msgstr "Ối, nhưng con đường kia trông có vẻ thú vị hơn nhiều..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "I learned all about tracking in the Pioneers! It went thataway!"
msgstr "Tớ học tất cả về kỹ năng theo dấu khi tham gia Hướng đạo sinh đấy! Nó đi hướng đó kìa!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "I uh... think I lost the trail..."
msgstr "Tớ ư... tớ nghĩ mình mất dấu rồi..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "There's too many footprints in this wet ground!"
msgstr "Nhiều dấu chân quá trên nền đất ướt này!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_HUNT_START_FORK
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_HUNT_START_FORK"
msgid "This trail could be dangerous, but a Pinetree Pioneer has no fear!"
msgstr "Đường này có vẻ nguy hiểm, nhưng một Hướng đạo sinh Cây Thông không biết sợ là gì!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_HUNT_SUCCESSFUL_FORK
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_HUNT_SUCCESSFUL_FORK"
msgid "Don't worry Woby, we're gonna catch them by surprise!"
msgstr "Đừng lo Woby, tụi mình sẽ úp sọt chúng bất ngờ cho xem!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_HUNT_WRONG_FORK
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_HUNT_WRONG_FORK"
msgid "Huh... I have the weirdest feeling something's watching me."
msgstr "Hừm... tớ có cảm giác kỳ lạ là có ai đó đang theo dõi mình."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "I think it needs more nutrients."
msgstr "Tớ nghĩ nó cần thêm chất dinh dưỡng."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_INV_FULL"
msgid "I already have too many supplies to carry."
msgstr "Tớ mang nhiều đồ quá rồi, không khuân thêm được nữa."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_IS_FEASTING"
msgid "Don't worry Woby, I'll save some for you!"
msgstr "Đừng lo Woby, tớ sẽ phần cậu một ít!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD"
msgid "Woby! Look what I found!"
msgstr "Woby! Nhìn tớ tìm được cái gì này!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "I knew I'd find you!"
msgstr "Biết ngay là tớ sẽ tìm ra cậu mà!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "There you are!"
msgstr "Cậu đây rồi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
msgid "Gotcha!"
msgstr "Tóm được rồi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
msgid "That was too easy."
msgstr "Dễ quá đi mất."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE"
msgid "I think that's all of them!"
msgstr "Chắc là hết rồi đấy!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM"
msgid "Good job {name}, I think that's the last one!"
msgstr "Làm tốt lắm {name}, tớ nghĩ đó là con cuối cùng rồi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE"
msgid "There should be one more hiding somewhere..."
msgstr "Chắc vẫn còn một con nữa đang trốn ở đâu đây..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME"
msgid "Darnit, they're too good at hiding!"
msgstr "Khỉ thật, chúng trốn kỹ quá!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP"
msgid "Uh oh, I think we're almost out of time."
msgstr "Ôi không, hình như sắp hết giờ rồi."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR"
msgid "I don't think they'd be hiding way out here."
msgstr "Tớ không nghĩ chúng lại trốn ra tận ngoài này đâu."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN"
msgid "I think we're getting warmer, Woby!"
msgstr "Tớ nghĩ chúng ta đang tiến gần hơn rồi đấy, Woby!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN"
msgid "Can I play too? Uh... I mean, use my Pioneer tracking expertise?"
msgstr "Tớ chơi cùng được không? Ờ... ý tớ là, dùng chuyên môn theo dấu của hướng đạo sinh ấy?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDEANDSEEK_START
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_KITCOON_HIDEANDSEEK_START"
msgid "Alright, I'm closing my eyes! Three... two... one...!"
msgstr "Được rồi, tớ nhắm mắt lại đây! Ba... hai... một...!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "He's calling more monsters! YES!!"
msgstr "Nó đang gọi thêm quái vật kìa! TUYỆT VỜI!!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_KLAUS_ENRAGE"
msgid "I think we made him angry."
msgstr "Chắc chúng ta chọc giận nó rồi."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_KLAUS_UNCHAINED"
msgid "Maybe he'll feel better with that chain gone."
msgstr "Biết đâu tháo xích ra nó sẽ thấy thoải mái hơn."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_KNOCKEDOUT"
msgid "W-Woby...? Oooh... what happened?"
msgstr "W-Woby...? Ồ... chuyện gì đã xảy ra vậy?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "Woah! I almost got zapped!"
msgstr "Úi! Suýt nữa thì bị sét đánh trúng!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_LIGHTSOUT_SHADOWHAND
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_LIGHTSOUT_SHADOWHAND"
msgid "Woby, did you see that hand? It's cheating!"
msgstr "Woby, cậu có thấy cái tay đó không? Nó chơi gian!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_LOWRESEARCH"
msgid "That wasn't very informative."
msgstr "Cái đó chẳng có mấy thông tin hữu ích cả."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_LUNARGUARDIAN_INCOMING
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_LUNARGUARDIAN_INCOMING"
msgid "Incoming... again?"
msgstr "Lại... tới nữa à?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_LUNARHAIL_BIRD_CORPSES
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_LUNARHAIL_BIRD_CORPSES"
msgid "They're falling from the sky, Woby!"
msgstr "Chúng đang rơi từ trên trời xuống kìa Woby!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS"
msgid "Those poor birds!"
msgstr "Mấy con chim tội nghiệp quá!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_LUNAR_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_LUNAR_RIFT_MAX"
msgid "Look, Woby! Something's glowing over there!"
msgstr "Nhìn kìa Woby! Có cái gì đang phát sáng đằng kia kìa!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Ha! Of course we only get a pair, Woby! They're chess pieces!"
msgstr "Ha! Dĩ nhiên chúng ta chỉ gặp một cặp thôi Woby! Chúng là quân cờ vua mà!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MEGA_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MEGA_FLARE_SEEN"
msgid "Wow, it's hard to miss a signal that bright!"
msgstr "Chà, tín hiệu sáng rực thế kia thì đố ai mà bỏ lỡ được!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MITEGLAND_DEBUFF.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MITEGLAND_DEBUFF.1"
msgid "I-is it getting hot in here...?"
msgstr "M-mình có thấy trời nóng lên chút nào không nhỉ...?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MITEGLAND_DEBUFF.2
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MITEGLAND_DEBUFF.2"
msgid "I feel so hot, I-I might have a fever..."
msgstr "Tớ thấy nóng quá, c-có khi tớ bị sốt rồi..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MITEGLAND_DEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MITEGLAND_DEBUFF_DONE"
msgid "I-it's okay, Woby. I'm feeling better now!"
msgstr "K-không sao đâu Woby. Giờ tớ đỡ hơn rồi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MONKEY_CURSE_1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MONKEY_CURSE_1"
msgid "All of a sudden I can't stop thinking about bananas..."
msgstr "Tự nhiên tớ cứ nghĩ hoài về chuối..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MONKEY_CURSE_CHANGE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MONKEY_CURSE_CHANGE"
msgid "Uhh, something really weird is happening!"
msgstr "Hừm, có gì đó rất bất thường đang xảy ra!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MONKEY_CURSE_CHANGEBACK
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MONKEY_CURSE_CHANGEBACK"
msgid "Woby, c'mere girl! It's okay, I'm me again!"
msgstr "Woby, lại đây cô bé! Không sao đâu, tớ lại là tớ rồi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW"
msgid "Just a little more..."
msgstr "Chỉ một chút nữa thôi..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "Woby look! There's something in there!"
msgstr "Woby nhìn kìa! Có cái gì trong đó á!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "Got it! What is it?"
msgstr "Lấy được rồi! Nó là cái gì thế?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "Just a little more..."
msgstr "Chỉ một chút nữa thôi..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "Woby look! There's something in there!"
msgstr "Woby nhìn kìa! Có cái gì trong đó á!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "Got it! What is it?"
msgstr "Lấy được rồi! Nó là cái gì thế?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "Just a little more..."
msgstr "Chỉ một chút nữa thôi..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "Woby look! There's something in there!"
msgstr "Woby nhìn kìa! Có cái gì trong đó á!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "Got it! What is it?"
msgstr "Lấy được rồi! Nó là cái gì thế?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONPOTION_FAILED"
msgid "Darnit, I must've done something wrong..."
msgstr "Khỉ thật, chắc tớ làm sai ở đâu rồi..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOSQUITOS"
msgid "Zhey vant to suck our bloood!"
msgstr "Zhey vant to suck our bloood!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "Oh. I think they're hurt."
msgstr "Ồ. Hình như chúng bị thương rồi."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL"
msgid "Woby, look at those weird buzzards!"
msgstr "Woby, nhìn mấy con kên kên kỳ dị kìa!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NODANGERGIFT"
msgid "There's monsters around! I don't want to miss anything!"
msgstr "Quái vật đang ở xung quanh kìa! Tớ không muốn bỏ lỡ thứ gì đâu!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NODANGERSIESTA"
msgid "This isn't the best time for a siesta."
msgstr "Giờ không phải lúc thích hợp để ngủ trưa đâu."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NODANGERSLEEP"
msgid "I'm not scared! I just can't sleep..."
msgstr "Tớ không sợ đâu! Chỉ là không tài nào ngủ được..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NODAYSLEEP"
msgid "I can't sleep with the sun in my eyes."
msgstr "Mặt trời chiếu thẳng vào mắt thế này thì sao mà ngủ."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "I can't sleep now!"
msgstr "Bây giờ tớ không ngủ được đâu!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOHUNGERSIESTA"
msgid "Maybe if I have a snack first."
msgstr "Chắc phải ăn lót dạ miếng đã."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOHUNGERSLEEP"
msgid "I can't sleep on an empty stomach..."
msgstr "Bụng đói meo thì sao mà ngủ được..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I'll have to get down first."
msgstr "Tớ phải xuống trước đã."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NONIGHTSIESTA"
msgid "I'd rather just go to bed."
msgstr "Tớ thà đi ngủ luôn cho rồi."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "I can't rest now! There's too much to look at down here!"
msgstr "Bây giờ không nghỉ ngơi được đâu! Dưới này có khối thứ hay ho để ngắm cơ mà!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOPUMPKINCARVINGONFIRE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOPUMPKINCARVINGONFIRE"
msgid "Do I still get the badge?"
msgstr "Tớ còn được nhận huy hiệu nữa không vậy?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT"
msgid "Um, WX? Could you maybe turn the light down a bit?"
msgstr "Ê, WX? Cậu làm ơn giảm bớt độ sáng đi được không?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOSLEEPONFIRE"
msgid "Um... that's on fire."
msgstr "Ừm... chỗ đó đang bốc lửa kìa."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOWARDROBEONFIRE"
msgid "That seems like a bad idea."
msgstr "Nghe có vẻ là một ý kiến tồi đấy."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NO_ABIGAIL_FLOWER
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NO_ABIGAIL_FLOWER"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NO_TRAP"
msgid "Huh. I thought for sure there would be a trap."
msgstr "Hừm. Tớ cứ chắc mẩm ở đây có bẫy cơ."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "Er... that was just for practice."
msgstr "Ơ... tớ câu tập thấu thôi mà."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "Hey! No fair!"
msgstr "Này! Chơi gian thế!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "Hmm-hm hmmm, hm-de-dum..."
msgstr "Hmm-hm hmmm, hm-de-dum..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "Well. I'm kind of bored."
msgstr "Chà. Tớ thấy hơi chán rồi đấy."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "Do you think we should try somewhere else Woby?"
msgstr "Cậu có nghĩ chúng ta nên thử chỗ khác không Woby?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "I wonder if fish tell scary stories about us?"
msgstr "Tự hỏi lũ cá có hay kể chuyện kinh dị về chúng ta không nhỉ?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "Darnit!"
msgstr "Khỉ thật!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "Just reel it in a little... just like they taught us..."
msgstr "Thu dây lại chút thôi... y như họ đã dạy tụi mình ấy..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "Is that a real sea monster?"
msgstr "Đó là quái vật biển thật á?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_OFF_SCRIPT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_OFF_SCRIPT"
msgid "Uh, I don't think that's in the script..."
msgstr "Ờ, tớ không nghĩ cái đó có trong kịch bản đâu..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_OTTERBOAT_DENBROKEN
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_OTTERBOAT_DENBROKEN"
msgid "I knew we shouldn't have gotten rid of that den..."
msgstr "Biết thế lúc nãy đừng phá cái ổ đó..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS"
msgid "Get ready to swim Woby, I don't think this was made for deep water!"
msgstr "Chuẩn bị bơi đi Woby, tớ không nghĩ cái này sinh ra để đi nước sâu đâu!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_PECKED"
msgid "Ouch!! Th-that hurt!"
msgstr "Áu!! Đ-Đau quá!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_PETRIFED_TREES"
msgid "I scream, you scream, the trees scream!"
msgstr "Tôi thét, bạn thét, cây cối cùng thét!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "I'm pretty sure that's not how it's supposed to look."
msgstr "Tớ khá chắc trông nó không nên ra thế này."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_PIRATES_ARRIVE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_PIRATES_ARRIVE"
msgid "What's that music? Did someone bring a radio?"
msgstr "Tiếng nhạc gì thế nhỉ? Có ai mang đài theo à?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_PLANT_RANDOMSEED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_PLANT_RANDOMSEED"
msgid "Let's see what grows, Woby!"
msgstr "Xem cái gì mọc lên nào Woby!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_PLANT_RESEARCHED.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_PLANT_RESEARCHED.1"
msgid "More plant facts for my mental handbook!"
msgstr "Thêm kiến thức thực vật vào cuốn cẩm nang trong đầu tớ nào!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_POCKETWATCH_PORTAL
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_POCKETWATCH_PORTAL"
msgid "Look at us, Woby! We're officially time travelers!!"
msgstr "Nhìn tụi mình kìa Woby! Tụi mình chính thức trở thành du hành thời gian rồi!!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_PREFALLINVOID
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_PREFALLINVOID"
msgid "Woby, run!"
msgstr "Woby, chạy mau!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_QUAKE"
msgid "Did you feel that, Woby?"
msgstr "Cậu có cảm thấy rung không Woby?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT"
msgid "Why won't it work here?"
msgstr "Sao ở đây lại không dùng được nhỉ?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_RABBITKING_AGGRESSIVE"
msgid "Woby, do you hear digging? Sounds angry!"
msgstr "Woby, cậu có nghe tiếng đào bới không? Nghe tức giận phết!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_RABBITKING_LUCKY"
msgid "Look at that rabbit, Woby!"
msgstr "Nhìn con thỏ kìa Woby!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_RABBITKING_LUCKYCAUGHT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_RABBITKING_LUCKYCAUGHT"
msgid "Gotcha!"
msgstr "Tóm được rồi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_RABBITKING_PASSIVE"
msgid "Something's digging underground!"
msgstr "Có cái gì đang đào bới dưới lòng đất kìa!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_REPELLED"
msgid "Look at those defenses! how does he do that?"
msgstr "Nhìn hệ thống phòng thủ kìa! Lão ta làm thế nào hay vậy?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_RESEARCH"
msgid "I memorized my Pinetree Pioneer handbook, I can memorize this!"
msgstr "Tớ đã học thuộc lòng cẩm nang Hướng đạo sinh Cây Thông, cái này tớ cũng học thuộc được!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "Aaah... I don't want to do that again."
msgstr "Aaah... tớ không muốn làm thế lần nữa đâu."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "You look better already!"
msgstr "Trông cậu đỡ hơn nhiều rồi đấy!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_REVIVING_CORPSE"
msgid "Don't worry! I have a badge in first aid!"
msgstr "Đừng lo! Tớ có huy hiệu sơ cứu đấy!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ROYALTY.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ROYALTY.1"
msgid "Hey! Nice crown!"
msgstr "Này! Vương miện đẹp đấy!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ROYALTY.2
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ROYALTY.2"
msgid "How bee-fitting!"
msgstr "Đúng là "ong-chủ" xứng tầm!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ROYALTY.3
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ROYALTY.3"
msgid "Your Majesty."
msgstr "Hạ thần xin bái kiến Bệ Hạ."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ROYALTY_JOKER.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ROYALTY_JOKER.1"
msgid "Wow! Nice \"crown\"."
msgstr "Chà! \"Vương miện\" đẹp đấy."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ROYALTY_JOKER.2
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ROYALTY_JOKER.2"
msgid "It's jest perfect!"
msgstr "Đúng là "chất" lừ luôn!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ROYALTY_JOKER.3
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ROYALTY_JOKER.3"
msgid "Your \"Majesty\"."
msgstr "Kính chào \"Bệ Hạ\"."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_RUINS_RESET"
msgid "Hey Woby, look! The monsters are back!"
msgstr "Này Woby, nhìn kìa! Lũ quái vật quay lại rồi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SACREDCHEST_NO"
msgid "This thing is impossible to open!"
msgstr "Cái thứ này đố mà mở được đấy!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SACREDCHEST_YES"
msgid "That wasn't hard at all."
msgstr "Chẳng khó tẹo nào."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SCRAPBOOK_FULL
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SCRAPBOOK_FULL"
msgid "I've already filled out my scrapbook."
msgstr "Sổ lưu niệm của tớ đầy kín rồi."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SECURITY_PULSE_FOLLOWING
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SECURITY_PULSE_FOLLOWING"
msgid "We have a new buddy, Woby!"
msgstr "Chúng ta có bạn mới rồi Woby!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SHADOWTHRALL_STEALTH
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SHADOWTHRALL_STEALTH"
msgid "Yikes! What bit me, Woby?"
msgstr "Ái chà! Cái gì cắn tớ thế Woby?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SHADOW_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SHADOW_RIFT_MAX"
msgid "What was that weird light? We should check it out, Woby!"
msgstr "Ánh sáng kỳ lạ gì thế nhỉ? Ta nên qua đó kiểm tra thôi Woby!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SHELTER"
msgid "What would we do without trees?"
msgstr "Không có cây cối thì tụi mình sống sao nổi chứ?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SISTURN_FULL_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SISTURN_FULL_BLOSSOM"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SISTURN_FULL_EVIL
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SISTURN_FULL_EVIL"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SLINGHSOT_NO_AMMO_SKILL
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SLINGHSOT_NO_AMMO_SKILL"
msgid "This ammo is tricky."
msgstr "Loại đạn này khó xài phết."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SLINGHSOT_NO_PARTS_SKILL
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SLINGHSOT_NO_PARTS_SKILL"
msgid "Huh. How does this part work?"
msgstr "Hừm. Phần này hoạt động thế nào nhỉ?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SLINGHSOT_OUT_OF_AMMO.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SLINGHSOT_OUT_OF_AMMO.1"
msgid "Uh oh... I'm all out of ammo."
msgstr "Ôi không... tớ hết đạn mất rồi."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SLINGHSOT_OUT_OF_AMMO.2
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SLINGHSOT_OUT_OF_AMMO.2"
msgid "Uh... just kidding!"
msgstr "Ờ... đùa thôi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SNARED"
msgid "Hey!"
msgstr "Này!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SNARED_IVY
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SNARED_IVY"
msgid "Hey, let me go!"
msgstr "Này, thả tớ ra!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SNOWBALL_NO_SNOW
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SNOWBALL_NO_SNOW"
msgid "We've run out of snow, Woby!"
msgstr "Hết tuyết mất rồi Woby ơi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SNOWBALL_TOO_BIG
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SNOWBALL_TOO_BIG"
msgid "It won't get any bigger!"
msgstr "Nó không to lên được nữa đâu!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SOAKED"
msgid "I'm going to get all pruney!"
msgstr "Tớ sắp nhăn nheo hết cả người lại rồi đây!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SPOOKED"
msgid "Yikes! That gave me quite the start!"
msgstr "Giật cả mình! Hết hồn chim én luôn!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_STORYTELLING_ABORT_FIREWENTOUT.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_STORYTELLING_ABORT_FIREWENTOUT.1"
msgid "Darnit, the fire went out right at the best part!"
msgstr "Khỉ thật, lửa lại tắt ngay đoạn hay nhất rồi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_STORYTELLING_ABORT_NOT_NIGHT.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_STORYTELLING_ABORT_NOT_NIGHT.1"
msgid "To be continued..."
msgstr "Còn nữa..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TALK_TO_PLANTS.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TALK_TO_PLANTS.1"
msgid "Hey! Do you guys want to hear a story?"
msgstr "Này! Các cậu có muốn nghe kể chuyện không?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TALK_TO_PLANTS.2
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TALK_TO_PLANTS.2"
msgid "You're doing great, plants! Keep it up!"
msgstr "Các cậu làm tốt lắm, thực vật ơi! Cứ phát huy nhé!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TALK_TO_PLANTS.3
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TALK_TO_PLANTS.3"
msgid "Don't worry, I'll be here to talk to you whenever you get lonely."
msgstr "Đừng lo, bất cứ khi nào buồn chán tớ sẽ luôn ở đây để trò chuyện với các cậu."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TALK_TO_PLANTS.4
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TALK_TO_PLANTS.4"
msgid "How are you doing today plants? Seen any new bugs lately?"
msgstr "Hôm nay các cậu thế nào rồi thực vật? Dạo này có thấy con bọ nào lạ không?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "It's good to have someone to talk to. Thanks plants!"
msgstr "Có ai đó để trò chuyện thật là tuyệt. Cảm ơn nhé thực vật!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_THORNS"
msgid "Aaah!! Ow!! It hurts! Were those poisonous?!"
msgstr "Aaaah!! Úi!! Đau quá! Chúng có độc không vậy trời?!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_THURIBLE_OUT"
msgid "I think it's out of fuel."
msgstr "Tớ nghĩ nó hết nhiên liệu rồi."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TICOON_ABANDONED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TICOON_ABANDONED"
msgid "I think Woby and I can sniff them out on our own."
msgstr "Tớ nghĩ Woby và tớ có thể tự đánh hơi chúng được."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TICOON_DEAD
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TICOON_DEAD"
msgid "I-it's okay Woby, he's just taking a nap! Let's keep going."
msgstr "K-không sao đâu Woby, chú ta chỉ đang chợp mắt một lát thôi! Đi tiếp nào."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TICOON_GET_LEADER_ATTENTION
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TICOON_GET_LEADER_ATTENTION"
msgid "Look Woby, I think he's trying to get our attention!"
msgstr "Nhìn kìa Woby, tớ nghĩ chú ta đang cố gây chú ý với chúng ta đấy!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TICOON_LOST_KITCOON
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TICOON_LOST_KITCOON"
msgid "I guess he lost the scent."
msgstr "Chắc chú ta mất dấu rồi."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TICOON_NEAR_KITCOON
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TICOON_NEAR_KITCOON"
msgid "I think he smells something nearby!"
msgstr "Tớ nghĩ chú ta ngửi thấy gì đó gần đây!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TICOON_NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TICOON_NOTHING_TO_TRACK"
msgid "It doesn't look like he's picking up any scents."
msgstr "Có vẻ chú ta không bắt được mùi hương nào cả."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TICOON_START_TRACKING
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TICOON_START_TRACKING"
msgid "I think he knows the way!"
msgstr "Tớ nghĩ chú ta biết đường!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TICOON_WAITING_FOR_LEADER
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TICOON_WAITING_FOR_LEADER"
msgid "Wait up! I'm coming!"
msgstr "Đợi đã! Tớ tới đây!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TOADESCAPED"
msgid "Darnit... he got away."
msgstr "Khỉ thật... nó xổng mất tiêu rồi."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TOADESCAPING"
msgid "Hey wait! Come back!"
msgstr "Này đợi đã! Quay lại đây!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TOOL_SLIP"
msgid "I- I meant to do that!"
msgstr "T-tớ cố tình làm thế đấy!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TOOL_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TOOL_TOOWEAK"
msgid "It's okay Woby, we just need to find a stronger tool!"
msgstr "Không sao đâu Woby, tụi mình chỉ cần tìm dụng cụ mạnh hơn thôi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TORCH_OUT"
msgid "Uh oh... this is usually the part when something bad happens."
msgstr "Ôi không... thường thì đây là lúc có chuyện tồi tệ xảy ra."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "Do you think I'll be the same person when I come out the other side?"
msgstr "Cậu nghĩ bước ra phía bên kia thì tớ có còn là chính mình không?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TRAP_WENT_OFF"
msgid "It looked way easier in my handbook..."
msgstr "Nhìn trong cẩm nang dễ hơn nhiều mà..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_UNIMPLEMENTED"
msgid "I don't think it's done yet."
msgstr "Tớ không nghĩ nó đã hoàn thành đâu."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_VAULT_SHADOW_ASSIST
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_VAULT_SHADOW_ASSIST"
msgid "Wait a minute! They're helping us, Woby!"
msgstr "Đợi đã nào! Chúng đang giúp tụi mình kìa, Woby!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_VAULT_TELEPORTER_DOES_NOTHING
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_VAULT_TELEPORTER_DOES_NOTHING"
msgid "I don't know, Woby! Must be a bad connection!"
msgstr "Chịu đấy, Woby! Chắc đường truyền hỏng rồi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WASHED_ASHORE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WASHED_ASHORE"
msgid "Woby...? Oh good, you're okay!"
msgstr "Woby...? Ồ may quá, cậu không sao!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WEAK_RAT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WEAK_RAT"
msgid "This carrat doesn't look healthy..."
msgstr "Con cà ruột này trông không khỏe lắm..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WEAPON_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WEAPON_TOOWEAK"
msgid "We need something stronger, Woby!"
msgstr "Tụi mình cần thứ gì đó mạnh hơn, Woby!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WEIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WEIGHT"
msgid "Weight: {weight}"
msgstr "Cân nặng: {weight}"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WEIGHT_HEAVY
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WEIGHT_HEAVY"
msgid "Weight: {weight}\nIs there a badge for heaviest fish?"
msgstr "Cân nặng: {weight}\nCó huy hiệu nào cho con cá nặng nhất không nhỉ?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WENDY_BABYSITTER_SET
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WENDY_BABYSITTER_SET"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WENDY_BABYSITTER_STOP
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WENDY_BABYSITTER_STOP"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WET"
msgid "This is starting to get uncomfortable."
msgstr "Bắt đầu thấy khó chịu rồi đấy."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WETTER"
msgid "Did anyone remember to pack a towel?"
msgstr "Có ai nhớ mang theo khăn tắm không vậy?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WINCH_CLAW_MISS
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WINCH_CLAW_MISS"
msgid "Next time I'll get it!"
msgstr "Lần sau tớ sẽ tóm được nó!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WINCH_CLAW_NO_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WINCH_CLAW_NO_ITEM"
msgid "What? Nothing?"
msgstr "Hả? Không có gì á?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WINTERS_FEAST_BUFF
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WINTERS_FEAST_BUFF"
msgid "It almost feels like I'm back home."
msgstr "Cảm giác cứ như đang ở nhà vậy."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WINTERS_FEAST_BUFF_OVER
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WINTERS_FEAST_BUFF_OVER"
msgid "Well, that was fun!"
msgstr "Chà, vui thật đấy!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_COURIER.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_COURIER.1"
msgid "Go, Woby! Go!"
msgstr "Đi nào, Woby! Đi thôi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_COURIER.2
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_COURIER.2"
msgid "Off you go! And don't get distracted, silly girl!"
msgstr "Đi nào! Và đừng có mà lơ đễnh đấy, cô bé ngốc!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_COURIER.3
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_COURIER.3"
msgid "Go on, Wobes!"
msgstr "Đi thôi, Wobes!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_COURIER.4
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_COURIER.4"
msgid "Be careful out there, Woby!"
msgstr "Cẩn thận đấy nhé, Woby!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_COURIER.5
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_COURIER.5"
msgid "Don't get lost, Wobers!"
msgstr "Đừng để bị lạc nha, Wobers!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_COURIER.6
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_COURIER.6"
msgid "And away she goes!"
msgstr "Và cô ấy đã đi xa!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_COURIER.7
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_COURIER.7"
msgid "On your way now, girl!"
msgstr "Lên đường thôi nào, cô bé!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_COURIER.8
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_COURIER.8"
msgid "Woby, follow your nose! It knows! Heh."
msgstr "Woby, đánh hơi theo trực giác đi! Nó biết rõ đấy! Hì."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_FOLLOW.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_FOLLOW.1"
msgid "Woby, come!"
msgstr "Woby, lại đây!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_FOLLOW.2
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_FOLLOW.2"
msgid "Follow me, girl!"
msgstr "Theo anh nào, cô bé!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_FOLLOW.3
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_FOLLOW.3"
msgid "With me, Wobes!"
msgstr "Đi cùng tớ nào, Wobes!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_FOLLOW.4
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_FOLLOW.4"
msgid "Come on, Wobers! Let's go!"
msgstr "Mau lên, Wobers! Đi thôi!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_FOLLOW.5
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_FOLLOW.5"
msgid "Keep up, Woby!"
msgstr "Theo kịp vào, Woby!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_FORAGE.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_FORAGE.1"
msgid "Find more of these, Woby!"
msgstr "Tìm thêm mấy cái này đi, Woby!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_FORAGE.2
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_FORAGE.2"
msgid "Help get us more, girl!"
msgstr "Giúp tụi mình kiếm thêm đi, cô bé!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_FORAGE.3
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_FORAGE.3"
msgid "Woby, just like these ones."
msgstr "Woby, tìm mấy thứ y hệt thế này này."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_FORAGE.4
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_FORAGE.4"
msgid "Look for these, Woby."
msgstr "Tìm mấy thứ này nhé, Woby."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.1"
msgid "Good girl!"
msgstr "Cô bé ngoan!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.10
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.10"
msgid "You're the best best friend, Woby."
msgstr "Cậu là người bạn thân nhất quả đất, Woby."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.11
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.11"
msgid "I'm so proud of you!"
msgstr "Tớ tự hào về cậu lắm đấy!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.12
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.12"
msgid "Alright, Wobes!"
msgstr "Làm tốt lắm, Wobes!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.13
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.13"
msgid "Woby the Wonderdog!"
msgstr "Woby - Chú chó thần kỳ!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.14
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.14"
msgid "Woah, Woby! Heh."
msgstr "Woah, Woby! Hì."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.2
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.2"
msgid "Thanks, Woby!"
msgstr "Cảm ơn nhé, Woby!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.3
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.3"
msgid "Atta girl, Wobers!"
msgstr "Làm tốt lắm, Wobers!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.4
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.4"
msgid "You're the best, Woby!"
msgstr "Cậu là nhất luôn đấy, Woby!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.5
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.5"
msgid "Yay, Woby!"
msgstr "Yay, Woby!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.6
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.6"
msgid "Awww... sweet girl, Wobes."
msgstr "Awww... cô bé ngọt ngào, Wobes."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.7
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.7"
msgid "Nice one, girl!"
msgstr "Làm đẹp lắm, cô bé!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.8
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.8"
msgid "Who's the smartest, Wobers? Yup, it's you!"
msgstr "Ai là người thông minh nhất nào, Wobers? Chuẩn luôn, là cậu đấy!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.9
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_PRAISE.9"
msgid "I love you, silly girl!"
msgstr "Tớ yêu cậu lắm, cô bé ngốc nghếch!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_REMEMBERCHEST_FAIL.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOBY_REMEMBERCHEST_FAIL.1"
