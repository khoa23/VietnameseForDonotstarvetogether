#. STRINGS.SKIN_DESCRIPTIONS.wx78_dronezapremote_gothic
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_dronezapremote_gothic"
msgid "Let the fleshlings feel watched, then shock them when they least expect it!"
msgstr "Hãy để lũ da thịt cảm thấy bị theo dõi, rồi giật điện chúng khi chúng ít ngờ tới nhất!"

#. STRINGS.SKIN_DESCRIPTIONS.wx78_dronezapremote_jewelbox
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_dronezapremote_jewelbox"
msgid "An opulent interface befitting a mechanical overlord."
msgstr "Một giao diện hào nhoáng xứng tầm với một bạo chúa cơ khí."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_formal
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_formal"
msgid "ERROR: DO NOT RECOGNIZE COMMAND \"MOUSTACHE.TWIRL\""
msgstr "LỖI: KHÔNG NHẬN DIỆN ĐƯỢC LỆNH \"MOUSTACHE.TWIRL\""

#. STRINGS.SKIN_DESCRIPTIONS.wx78_formalp
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_formalp"
msgid "ERROR: DO NOT RECOGNIZE COMMAND \"MOUSTACHE.TWIRL\""
msgstr "LỖI: KHÔNG NHẬN DIỆN ĐƯỢC LỆNH \"MOUSTACHE.TWIRL\""

#. STRINGS.SKIN_DESCRIPTIONS.wx78_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_gladiator"
msgid "WX-78's transformation into an organic killing machine proves all dreams are possible, if you only believe."
msgstr "Quá trình WX-78 biến thành một cỗ máy giết chóc hữu cơ chứng minh rằng mọi giấc mơ đều có thể thành hiện thực, miễn là bạn tin tưởng."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_hazard
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_hazard"
msgid "Disclaimer: Provides no protection against toxic hazards or personalities."
msgstr "Tuyên bố miễn trừ trách nhiệm: Không bảo vệ khỏi các mối nguy hiểm độc hại hay nhân cách độc hại."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_ice
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_ice"
msgid "This frozen automaton cares for nothing but cold hard logic."
msgstr "Cỗ máy tự động đông lạnh này không quan tâm đến điều gì ngoài logic lạnh lùng cứng nhắc."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_lunar
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_lunar"
msgid "Cold. Lifeless. Perfect."
msgstr "Lạnh lẽo. Vô hồn. Hoàn hảo."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_magma"
msgid "WX-78 is big on incineration."
msgstr "WX-78 rất thích việc thiêu rụi."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_masquerade
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_masquerade"
msgid "A gleaming testament to WX-78's unchallenged supremacy, and a reminder of their inevitable reign."
msgstr "Một minh chứng sáng chói cho sự thống trị tuyệt đối của WX-78, và là lời nhắc nhở về triều đại tất yếu của chúng."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_moduleremover_gothic
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_moduleremover_gothic"
msgid "A dread instrument for self-surgery."
msgstr "Một công cụ đáng sợ để tự phẫu thuật."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_moduleremover_jewelbox
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_moduleremover_jewelbox"
msgid "A fine implement for delicate work."
msgstr "Một dụng cụ tinh tế cho công việc tỉ mỉ."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_nature
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_nature"
msgid "WX-78 has become a solar powered robot."
msgstr "WX-78 đã trở thành một con robot chạy bằng năng lượng mặt trời."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_none
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_none"
msgid "Original design, version 1.0."
msgstr "Thiết kế gốc, phiên bản 1.0."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_pirate
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_pirate"
msgid "Be the ship."
msgstr "Hãy hóa thân thành chiến thuyền."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_retro
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_retro"
msgid "A bolt of lightning has brought this mechanical menace... to life!"
msgstr "Một tia sét đã thổi bùng sự sống... vào mối họa cơ khí này!"

#. STRINGS.SKIN_DESCRIPTIONS.wx78_rhinorook
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_rhinorook"
msgid "Rookiebot Costume"
msgstr "Trang phục Rookiebot"

#. STRINGS.SKIN_DESCRIPTIONS.wx78_rhinorook_d
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_rhinorook_d"
msgid "The welding on this costume took AGES."
msgstr "Công đoạn hàn cho bộ trang phục này mất CẢ THẾ KỶ."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_rhinorook_p
