msgstr "Ôi, vui lên đi!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATEDBEARGER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATEDBEARGER"
msgid "No fair, giant killing beast have armor too?"
msgstr "Không công bằng, quái thú khổng lồ cũng có áo giáp?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATEDBIRD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATEDBIRD"
