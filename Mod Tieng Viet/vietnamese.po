msgstr "Bạn đang trong tình trạng khó khăn phải không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KNIGHT_YOTH.FOLLOWING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KNIGHT_YOTH.FOLLOWING"
