msgstr "Chúng tôi không được phép chơi với thứ đó."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS"
msgid "It's too dangerous!"
msgstr "Nó quá nguy hiểm!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY"
msgid "Aw... It's the wrong one."
msgstr "Ôi... sai rồi."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY"
msgid "That doesn't go there!"
msgstr "Điều đó không đến đó!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.WRAPBUNDLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.WRAPBUNDLE.EMPTY"
msgid "But what should we wrap up?"
msgstr "Nhưng chúng ta nên kết thúc điều gì?"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.WRITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.WRITE.GENERIC"
msgid "We can't write on that now."
msgstr "Bây giờ chúng ta không thể viết về điều đó."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.WRITE.INUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.WRITE.INUSE"
msgid "We'll get our crayons ready while they finish up!"
msgstr "Chúng ta sẽ chuẩn bị bút chì màu trong khi chúng hoàn thành!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.YOTB_STARTCONTEST.ALREADYACTIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.YOTB_STARTCONTEST.ALREADYACTIVE"
msgid "Maybe there's another contest going on somewhere else?"
msgstr "Có lẽ có một cuộc thi khác đang diễn ra ở nơi khác?"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK"
msgid "Anybody there? Guess not..."
msgstr "Ai có? Đoán là không..."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.YOTB_STARTCONTEST.NORESPONSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.YOTB_STARTCONTEST.NORESPONSE"
msgid "We can't find him."
msgstr "Chúng ta không thể tìm thấy anh ấy."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE"
msgid "He's ignoring us."
msgstr "Anh ấy đang phớt lờ chúng tôi."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN"
msgid "Hey, we already have that one!"
msgstr "Này, chúng tôi đã có cái đó rồi!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL_GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL_GENERIC"
msgid "Mom told me never to do that."
msgstr "Mẹ bảo tôi đừng bao giờ làm điều đó."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ACCOMPLISHMENT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ACCOMPLISHMENT"
msgid "We're so capable!"
msgstr "Chúng tôi rất có khả năng!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ACCOMPLISHMENT_DONE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ACCOMPLISHMENT_DONE"
msgid "We're a super hero!"
msgstr "Chúng tôi là một siêu anh hùng!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ACIDBATS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ACIDBATS"
msgid "We don't like that sound."
msgstr "Chúng tôi không thích âm thanh đó."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ADVENTUREFAIL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ADVENTUREFAIL"
msgid "Play time is over."
msgstr "Giờ chơi kết thúc rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_SINKHOLE.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_SINKHOLE.1"
msgid "The ground's giving way!"
msgstr "Cách nhường chỗ cho mặt đất!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_SINKHOLE.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_SINKHOLE.2"
msgid "It's rumble-y!"
msgstr "Đó là tiếng ầm ầm-y!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_SINKHOLE.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_SINKHOLE.3"
msgid "What's that?"
msgstr "Cái gì thế?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_TRIBUTE.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_TRIBUTE.1"
msgid "For you!"
msgstr "Cho bạn!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_TRIBUTE.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_TRIBUTE.2"
msgid "Maybe it'll be happier now."
msgstr "Có lẽ bây giờ nó sẽ hạnh phúc hơn."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_TRIBUTE.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_TRIBUTE.3"
msgid "I hope you like our tribute!"
msgstr "Tôi hy vọng bạn thích cống phẩm của chúng tôi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE"
msgid "Haha, it tickles our brain!"
msgstr "Haha, nó làm chúng ta nhột nhột!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ARCHIVE_NO_POWER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ARCHIVE_NO_POWER"
msgid "Aww, nothing happened!"
msgstr "Ồ, không có gì xảy ra cả!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE"
msgid "We already learned that one."
msgstr "Chúng tôi đã học được điều đó rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATRIUM_DESTABILIZING.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATRIUM_DESTABILIZING.1"
msgid "That gateway did something weird."
msgstr "Cánh cổng đó đã làm điều gì đó kỳ lạ."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATRIUM_DESTABILIZING.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATRIUM_DESTABILIZING.2"
msgid "Something's happening."
msgstr "Một cái gì đó đang xảy ra."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATRIUM_DESTABILIZING.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATRIUM_DESTABILIZING.3"
msgid "Let's get out of here."
msgstr "Hãy ra khỏi đây."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_ATTACK"
msgid "We feel so strong!"
msgstr "Chúng tôi cảm thấy rất mạnh mẽ!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK"
msgid "With great lightning powers comes great responsibility!"
msgstr "Với sức mạnh sét lớn đi kèm với trách nhiệm lớn lao!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY"
msgid "Away, nasty water!"
msgstr "Đi đi, nước bẩn thỉu!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION"
msgid "We feel so much safer now!"
msgstr "Bây giờ chúng tôi cảm thấy an toàn hơn rất nhiều!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE"
msgid "We'll never feel sleepy again!"
msgstr "Chúng ta sẽ không bao giờ cảm thấy buồn ngủ nữa!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS"
msgid "We can help out with the chores!"
msgstr "Chúng tôi có thể giúp đỡ việc nhà!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BECOMEGHOST
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BECOMEGHOST"
msgid "oOooOooO!!"
msgstr "oOooOooO!!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BEES
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BEES"
msgid "Flying ouchies!"
msgstr "Bay ouchies!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BOAT_LEAK"
msgid "The boat is crying!"
msgstr "Thuyền đang khóc!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BOAT_SINK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BOAT_SINK"
msgid "We're too young to drown!"
msgstr "Chúng ta còn quá trẻ để chết đuối!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BOOMERANG"
msgid "It hurts us when we don't catch it."
msgstr "Nó đau khổ chúng ta khi chúng ta không nắm bắt nó."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BRAVERY_POTION
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BRAVERY_POTION"
