#. STRINGS.CHARACTERS.WARLY.DESCRIBE.NIGHTCAPHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.NIGHTCAPHAT"
msgid "A short nap might be nice."
msgstr "Một giấc ngủ ngắn có thể sẽ tốt."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.NIGHTLIGHT"
msgid "And I thought fluorescent tubes were a bad invention!"
msgstr "Và tôi nghĩ đèn huỳnh quang là một phát minh tồi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.NIGHTMAREFUEL"
msgid "Who in their right mind would want to fuel MORE nightmares?"
msgstr "Ai có đầu óc tinh thần lại muốn gây ra NHIỀU cơn ác mộng hơn?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.NIGHTMAREGROWTH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.NIGHTMAREGROWTH"
msgid "Mon dieu, the crust is cracking!"
msgstr "Món dieu, vỏ bánh nứt rồi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.NIGHTMARELIGHT"
msgid "Am I crazy or is this light not helping my situation?"
msgstr "Tôi điên hay là ánh sáng này không giúp ích gì cho tình huống của tôi?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.NIGHTMAREPIE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.NIGHTMAREPIE"
