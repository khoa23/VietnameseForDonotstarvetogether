msgstr "Bạn đang nhìn một con lươn nhỏ. Hà!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PONDFISH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PONDFISH"
msgid "I'd rather eat for a day than not at all."
msgstr "Tôi thà ăn trong một ngày còn hơn là không ăn gì cả."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POND_ALGAE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POND_ALGAE"
msgid "Ha! Gross."
msgstr "Hà! Tổng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POOP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POOP"
msgid "Nothing to be ashamed of."
msgstr "Không có gì phải xấu hổ cả."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLEBLENDER_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLEBLENDER_ITEM"
msgid "I like the way that machine dances."
msgstr "Tôi thích cách cái máy đó nhảy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG"
msgid "All good things take time."
msgstr "Tất cả những điều tốt đẹp đều cần có thời gian."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT"
msgid "This'll be done lickety-split!"
msgstr "Việc này sẽ được thực hiện một cách nhanh chóng!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE"
msgid "Let's see if all that fuss was worth it."
msgstr "Hãy xem liệu tất cả những ồn ào đó có đáng không."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY"
msgid "Could use some ingredients in there."
msgstr "Có thể sử dụng một số thành phần trong đó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC"
msgid "A fancy pot for some fancy cookin'."
msgstr "Một chiếc nồi sang trọng dành cho những món ăn cầu kỳ'."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLEFIREPIT_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLEFIREPIT_ITEM"
msgid "Now that's handy."
msgstr "Giờ thì tiện rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLESPICER_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLESPICER_ITEM.DONE"
msgid "Well worth all that work."
msgstr "Rất đáng giá tất cả những công việc đó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLESPICER_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLESPICER_ITEM.GENERIC"
msgid "Probably a whole lot of interesting gears in there."
msgstr "Có lẽ có rất nhiều bánh răng thú vị trong đó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLETENT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLETENT"
msgid "Aw, this reminds me of campin' with Charlie when we were little..."
msgstr "Ôi, điều này làm tôi nhớ đến buổi cắm trại với Charlie khi chúng tôi còn nhỏ..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLETENT_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLETENT_ITEM"
msgid "Need any help settin' that up?"
msgstr "Cần giúp đỡ gì để thiết lập điều đó không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATO
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATO"
msgid "I just think they're neat."
msgstr "Tôi chỉ nghĩ chúng gọn gàng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATOSACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATOSACK"
msgid "Always nice to have a snack on hand when you're workin'."
msgstr "Luôn mang theo đồ ăn nhẹ khi làm việc là điều tuyệt vời."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATOSOUFFLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATOSOUFFLE"
msgid "Looks great, Warly!"
msgstr "Trông tuyệt đấy, Warly!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATOTORNADO
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATOTORNADO"
msgid "Count on Warly's cookin' to always make my day."
msgstr "Hãy tin tưởng vào tài nấu nướng của Warly để tôi luôn vui vẻ mỗi ngày."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATO_COOKED"
msgid "I've always been a meat and potatoes gal."
msgstr "Tôi luôn là một cô gái thích ăn thịt và khoai tây."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATO_OVERSIZED"
msgid "Can't have too much potato."
msgstr "Không thể có quá nhiều khoai tây."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATO_SEEDS"
msgid "I got no idea what they'd grow into."
msgstr "Tôi không biết chúng sẽ phát triển thành gì."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POTTEDFERN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POTTEDFERN"
msgid "That's my kind of decor. Simple."
msgstr "Đó là kiểu trang trí của tôi. Đơn giản."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POWCAKE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POWCAKE"
msgid "Gotta eat what you can around here."
msgstr "Phải ăn những gì bạn có thể ở đây."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POWDER_MONKEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POWDER_MONKEY"
msgid "He looks like he wants to start some trouble."
msgstr "Có vẻ như anh ta muốn gây ra rắc rối gì đó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PREMIUMWATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PREMIUMWATERINGCAN.EMPTY"
msgid "Looks like I'll have to find some water."
msgstr "Có vẻ như tôi phải tìm chút nước."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PREMIUMWATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PREMIUMWATERINGCAN.GENERIC"
msgid "As long as it works, I don't care what it looks like."
msgstr "Miễn là nó hoạt động thì tôi không quan tâm nó trông như thế nào."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PRIME_MATE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PRIME_MATE"
msgid "Yeesh, what an ugly mug."
msgstr "Vâng, thật là một cái cốc xấu xí."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUFFIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUFFIN.GENERIC"
msgid "Cute lil bird. Never seen one before."
msgstr "Chú chim lil dễ thương. Chưa bao giờ nhìn thấy một cái trước đây."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUFFIN.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUFFIN.HELD"
msgid "Hope you're comfy in there."
msgstr "Hy vọng bạn thấy thoải mái khi ở trong đó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUFFIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUFFIN.SLEEPING"
msgid "Taking her mandated break."
msgstr "Nghỉ ngơi bắt buộc của cô ấy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN"
msgid "Hey there, pumpkin."
msgstr "Này, bí ngô."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKINCARVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKINCARVER"
msgid "A pumpkin carver is only as good as their tools."
msgstr "Người khắc bí ngô chỉ giỏi bằng dụng cụ của họ."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKINCOOKIE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKINCOOKIE"
msgid "Gotta indulge sometimes, hey?"
msgstr "Đôi khi phải thưởng thức chứ, này?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKINHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKINHAT.GENERIC"
msgid "How ya doin, Jack?"
msgstr "Bạn khỏe không, Jack?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKINHAT.UNCARVED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKINHAT.UNCARVED"
msgid "Didn't put on your face yet?"
msgstr "Bạn chưa bôi lên mặt à?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKINPIE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKINPIE"
msgid "Tis the season for some good eatin'!"
msgstr "Đây là mùa để ăn ngon!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN_COOKED"
msgid "Not bad! Kind of sweet."
msgstr "Không tệ! Thật ngọt ngào."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN_LANTERN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN_LANTERN"
msgid "It's childish, but in a nice way."
msgstr "Thật trẻ con, nhưng theo một cách tốt đẹp."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN_OVERSIZED"
msgid "Hey there, gourd lookin'! Ha!"
msgstr "Này, quả bầu đang nhìn kìa! Hà!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN_SEEDS"
msgid "A handful of seeds."
msgstr "Một nắm hạt."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUNCHINGBAG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUNCHINGBAG"
msgid "Whatcha say? Wanna go a few rounds?"
msgstr "Bạn nói gì thế? Muốn đi vài vòng không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUREBRILLIANCE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUREBRILLIANCE"
msgid "I ain't dazzled by much, but that'll do it."
msgstr "Tôi không bị choáng ngợp bởi nhiều điều, nhưng điều đó sẽ làm được."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PURPLEAMULET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PURPLEAMULET"
msgid "It's, uh, a purple necklace."
msgstr "Đó là một chiếc vòng cổ màu tím."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PURPLEGEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PURPLEGEM"
msgid "A little snooty gem."
msgstr "Một chút đá quý lén lút."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PURPLEMOONEYE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PURPLEMOONEYE"
msgid "That's amore."
msgstr "Đó là tình yêu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR.FULL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR.FULL"
msgid "That should keep it busy fer a bit."
msgstr "Điều đó sẽ khiến nó bận rộn một chút."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR.GENERIC"
msgid "Moss has grown over some sorta socket in the base."
msgstr "Rêu đã mọc trên một số ổ cắm ở phần đế."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD"
msgid "Nice metalwork."
msgstr "Đồ kim loại đẹp."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_IVY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_IVY"
msgid "That stuff can ruin good architecture."
msgstr "Những thứ đó có thể phá hỏng kiến trúc tốt."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_QUEEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_QUEEN"
msgid "Woo-wee. Impress-ive."
msgstr "Woo-đu. Ấn tượng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_STATUE1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_STATUE1"
msgid "It probably looked real nice once."
msgstr "Có lẽ nó đã từng trông rất đẹp."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_STATUE2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_STATUE2"
msgid "I wonder who chiseled that."
msgstr "Tôi tự hỏi ai đã đục cái đó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_BEEFALO"
msgid "Take it easy. You don't looks so good."
msgstr "Hãy thư giãn đi. Trông bạn không được tốt lắm."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_BERRYBUSH"
msgid "Nothing in that bush anymore."
msgstr "Không có gì trong bụi cây đó nữa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_BOWL_SILVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_BOWL_SILVER"
msgid "Fancy lookin' but it still just holds food."
msgstr "Nhìn lạ mắt nhưng nó vẫn chỉ đựng thức ăn thôi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CARROT_SEEDS"
msgid "I got no idea what they'd grow into."
msgstr "Tôi không biết chúng sẽ phát triển thành gì."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CASSEROLEDISH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CASSEROLEDISH"
msgid "I'll need to bake it."
msgstr "Tôi sẽ cần phải nướng nó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL"
msgid "For making little stews and stuff."
msgstr "Để làm món hầm nhỏ và các thứ khác."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN1"
msgid "A lucky coin."
msgstr "Một đồng tiền may mắn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN2"
msgid "Save this for a rainy day."
msgstr "Hãy để dành điều này cho một ngày mưa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN3"
msgid "Gotta watch I don't turn into a rich dope."
msgstr "Phải canh chừng để tôi không trở thành kẻ giàu có."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN4"
msgid "We could bust outta here with enough of these."
msgstr "Chúng ta có thể thoát khỏi đây với đủ thứ này."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABMEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABMEAT"
msgid "I get crabby when I'm hungry. Ha!"
msgstr "Tôi trở nên cáu kỉnh khi đói. Hà!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED"
msgid "It's a big lump of cooked crab."
msgstr "Đó là một miếng cua nấu chín lớn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABTRAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABTRAP"
msgid "Here lil crabby crab."
msgstr "Đây là cua cua bé nhỏ."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FERN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FERN"
msgid "Fresh roughage."
msgstr "Thức ăn thô tươi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FLOUR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FLOUR"
msgid "I ain't much of a baker."
msgstr "Tôi không phải là người làm bánh giỏi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
msgid "Cooked roughage."
msgstr "Thức ăn thô đã nấu chín."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.GENERIC"
msgid "Let's throw it up on that altar, hey?"
msgstr "Hãy ném nó lên bàn thờ đi, được không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MATCH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MATCH"
msgid "Perfect."
msgstr "Hoàn hảo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK"
msgid "It's the right food, but it don't look too filling."
msgstr "Đó là món ăn phù hợp nhưng trông không quá no."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MISMATCH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MISMATCH"
msgid "Well this ain't right."
msgstr "Ồ, điều này không đúng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD_BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD_BURNT"
msgid "It's a little toastier than normal."
msgstr "Nó hơi nướng hơn bình thường một chút."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GARLIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GARLIC"
msgid "Makes everything taste better."
msgstr "Làm cho mọi thứ ngon hơn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GARLIC_COOKED"
msgid "Bet that brought out the flavor."
msgstr "Đặt cược mà mang lại hương vị."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GARLIC_SEEDS"
msgid "I got no idea what they'd grow into."
msgstr "Tôi không biết chúng sẽ phát triển thành gì."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GOATKID
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GOATKID"
msgid "What's goin' on, squirt?"
msgstr "Chuyện gì đang xảy ra thế, phun nước?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GOATMILK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GOATMILK"
msgid "I try to support local artisans."
msgstr "Tôi cố gắng hỗ trợ các nghệ nhân địa phương."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GOATMUM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GOATMUM"
msgid "Got anything for me?"
msgstr "Có gì cho tôi không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL"
msgid "Time for a cookout!"
msgstr "Đã đến lúc nấu ăn!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL_ITEM"
msgid "I need to to find a firepit for this to work."
msgstr "Tôi cần tìm một cái lò sưởi để nó hoạt động."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL_SMALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL_SMALL"
msgid "Big enough for a small cookout."
msgstr "Đủ lớn cho một buổi nấu nướng nhỏ."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM"
msgid "Now where can I put this..."
