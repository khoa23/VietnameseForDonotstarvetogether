msgstr "Mình có để quên bật lò nướng không ta?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRATSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRATSHRINE.EMPTY"
