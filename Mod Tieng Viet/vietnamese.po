msgstr "Trông cậu nhỏ xíu và kêu chít chít."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KLAUS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KLAUS"
msgid "A lump of coal would be really useful, actually!"
msgstr "Một cục than chắc sẽ hữu ích lắm đây!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KLAUSSACKKEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KLAUSSACKKEY"
msgid "Ha! I wouldn't wanna get smacked with that thing!"
msgstr "Ha! Tôi mà bị món đó quật thì có mà tơi bời!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KLAUS_SACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KLAUS_SACK"
msgid "Nothing says \"Open Me\" quite like a lock!!"
msgstr "Không gì hợp với câu \"Hãy Mở Tôi Ra\" hơn một chiếc ổ khóa cả!!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT"
msgid "It's a pony!"
msgstr "Một chú ngựa con kìa!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT_NIGHTMARE"
msgid "It looks pretty worn down."
msgstr "Trông có vẻ tả tơi lắm rồi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT_YOTH.FOLLOWING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT_YOTH.FOLLOWING"
msgid "That's right, you follow me!"
msgstr "Đúng rồi, cứ bám theo tôi nhé!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT_YOTH.FOLLOWING_OTHER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT_YOTH.FOLLOWING_OTHER"
msgid "Who's bossing you around?"
msgstr "Đứa nào đang sai khiến cậu thế?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT_YOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT_YOTH.GENERIC"
msgid "What is your problem, horse?"
msgstr "Vấn đề của cậu là gì hả con ngựa kia?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFANT_CARCASS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFANT_CARCASS"
msgid "It's dead. Shall I do the honors?"
msgstr "Nómủm rồi. Để tôi ra tay nhé?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFANT_SUMMER"
msgid "We will be great friends!"
msgstr "Chúng ta sẽ là bạn tốt của nhau!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFANT_WINTER"
msgid "He sure looks warm..."
msgstr "Trông cậu ta ấm áp thật..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFIG_TRUNK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFIG_TRUNK"
