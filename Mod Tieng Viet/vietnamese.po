msgstr "Trông có vẻ anh ta đang bận ngập đầu luôn kìa. Mấy con chim này có tay không nhỉ?"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDERS
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDERS"
