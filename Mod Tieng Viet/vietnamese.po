msgstr "Không bằng lửa nhưng ít nhất chúng ta sẽ không chìm trong bóng tối."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.GENERIC"
