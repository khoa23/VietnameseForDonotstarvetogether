msgstr "Tảng đá đó còn sống!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PIGEON.DEAD"
