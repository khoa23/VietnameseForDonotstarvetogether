msgstr "Đợi chút, đó có phải là cần câu của tôi không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT"
msgid "There ya go!"
msgstr "Thế đấy!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM"
msgid "Just aboot everything I need to toughen up my Carrat."
msgstr "Chỉ cần khởi động lại mọi thứ tôi cần để tăng cường sức mạnh cho Carrat của mình."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT"
msgid "This marker should help 'em find the finish line."
msgstr "Điểm đánh dấu này sẽ giúp họ tìm thấy vạch đích."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM"
msgid "How aboot I start settin' up the racetrack?"
msgstr "Tôi bắt đầu thiết lập đường đua như thế nào?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT"
msgid "I guess nobody wins."
msgstr "Tôi đoán là không ai thắng cả."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC"
msgid "Can't have a race without a finish line."
msgstr "Không thể có một cuộc đua mà không có vạch đích."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON"
msgid "I knew you could do it, bud!"
msgstr "Tôi biết bạn có thể làm được mà, anh bạn!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON"
msgid "{winner} sure gave us the run-around, eh?"
msgstr "{winner} chắc chắn đã giúp chúng ta vượt qua được phải không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM"
msgid "Let's get this all set up!"
msgstr "Hãy thiết lập tất cả những điều này!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_START
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_START"
msgid "How aboot a little race, eh?"
msgstr "Làm thế nào để khởi động một cuộc đua nhỏ, hả?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM"
msgid "Alright, where do we start this race?"
msgstr "Được rồi, chúng ta bắt đầu cuộc đua này ở đâu?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_SCALE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_SCALE.BURNT"
msgid "Hey, it's not fire season!"
msgstr "Này, không phải mùa cháy nổ!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT"
msgid "Sorry bud, looks like you need more time at the gym."
msgstr "Xin lỗi nhé bạn, có vẻ như bạn cần thêm thời gian ở phòng gym."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD"
msgid "Not bad! Not bad at all!"
msgstr "Không tệ! Không xấu cả!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC"
msgid "How aboot we see what our Carrat's made of, eh?"
msgstr "Làm thế nào chúng ta có thể thấy cà rốt của chúng ta được làm từ gì nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_SCALE_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_SCALE_ITEM"
msgid "This will help me get the measure of my racer."
msgstr "Điều này sẽ giúp tôi có được thước đo cho tay đua của mình."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_SEEDPACKET"
msgid "It's a bit of a mixed bag. Of seeds."
msgstr "Đó là một chút của một túi hỗn hợp. Của hạt giống."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_SEEDPACKET_RARE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_SEEDPACKET_RARE"
msgid "Whatcha think it'll grow into, Lucy?"
msgstr "Bạn nghĩ nó sẽ lớn lên thành gì, Lucy?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTD_ANCHOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTD_ANCHOR"
msgid "Pretty fancy for an anchor, eh?"
msgstr "Khá lạ mắt cho một mỏ neo phải không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTD_ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTD_ANCHOR_ITEM"
msgid "A little elbow grease and we'll have an anchor."
msgstr "Một chút đánh bóng và chúng ta có một cái mỏ neo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTD_DRAGONSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTD_DRAGONSHRINE.BURNT"
msgid "All burnt up."
msgstr "Tất cả đã cháy sạch."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY"
msgid "How aboot givin' it some charcoal?"
msgstr "Sẽ thế nào khi cho nó một chút than?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC"
msgid "Lookin' good!"
msgstr "Trông tuyệt đêý!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTD_OAR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTD_OAR"
msgid "I'll paddle my way through the race if I have to."
msgstr "Tôi sẽ chèo thuyền vượt qua cuộc đua nếu buộc phải làm vậy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTD_STEERINGWHEEL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTD_STEERINGWHEEL"
msgid "Let's give 'er a spin!"
msgstr "Hãy thử một lần!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTD_STEERINGWHEEL_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTD_STEERINGWHEEL_ITEM"
msgid "Better make sure the boat's base is built first."
msgstr "Tốt hơn hết hãy chắc chắn rằng đế thuyền được xây dựng trước."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTH_CHAIR_ROCKING_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTH_CHAIR_ROCKING_ITEM"
msgid "Might be nice for stress relief."
msgstr "Có thể tốt cho việc giảm căng thẳng."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTH_KNIGHTHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTH_KNIGHTHAT"
msgid "It's a fine horse head."
msgstr "Đó là một cái đầu ngựa tốt."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTH_KNIGHTSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTH_KNIGHTSHRINE.BURNT"
msgid "So much for that."
msgstr "Quá nhiều cho điều đó."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTH_KNIGHTSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTH_KNIGHTSHRINE.EMPTY"
msgid "Well, what do you want?"
msgstr "Vâng, bạn muốn gì?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTH_KNIGHTSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTH_KNIGHTSHRINE.GENERIC"
msgid "What do you have for us, eh?"
msgstr "Bạn có gì cho chúng tôi vậy?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTH_KNIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTH_KNIGHTSTICK"
msgid "Looks like the one I had as a kid."
msgstr "Trông giống như cái tôi đã có khi còn nhỏ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTH_LANCE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTH_LANCE"
msgid "That's right, Luce. It can't chop a tree."
msgstr "Đúng rồi, Luce. Nó không thể chặt cây."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTP_FOOD1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTP_FOOD1"
msgid "Want some, Lucy?"
msgstr "Muốn một ít không, Lucy?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTP_FOOD2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTP_FOOD2"
msgid "Doesn't look to appetizing. Sorry."
msgstr "Nhìn có vẻ không ngon miệng. Lấy làm tiếc."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTP_FOOD3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTP_FOOD3"
msgid "I don't need nothin' fancy."
msgstr "Tôi không cần thứ gì cầu kỳ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_DECOR_1.GENERAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_DECOR_1.GENERAL"
msgid "Adds a nice rustic touch, eh?"
msgstr "Thêm một nét mộc mạc đẹp đẽ, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_DECOR_1.OUT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_DECOR_1.OUT"
msgid "Out like a light."
msgstr "Tắt như một ngọn đèn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_DECOR_1_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_DECOR_1_ITEM"
msgid "Alright Luce, where should we put it?"
msgstr "Được rồi Luce, chúng ta nên đặt nó ở đâu?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_DECOR_2.GENERAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_DECOR_2.GENERAL"
msgid "Adds a nice rustic touch, eh?"
msgstr "Thêm một nét mộc mạc đẹp đẽ, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_DECOR_2.OUT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_DECOR_2.OUT"
msgid "Out like a light."
msgstr "Tắt như một ngọn đèn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_DECOR_2_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_DECOR_2_ITEM"
msgid "Alright Luce, where should we put it?"
msgstr "Được rồi Luce, chúng ta nên đặt nó ở đâu?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_FIGHTRING_BELL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_FIGHTRING_BELL.GENERIC"
msgid "Looks peaceful for now."
msgstr "Hiện tại có vẻ yên bình."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_FIGHTRING_BELL.PLAYING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_FIGHTRING_BELL.PLAYING"
msgid "Those pillows pack a wallop, eh?"
msgstr "Những chiếc gối đó có tác dụng rất tốt phải không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_FIGHTRING_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_FIGHTRING_KIT"
msgid "Alright Luce, where should we put it?"
msgstr "Được rồi Luce, chúng ta nên đặt nó ở đâu?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_FOOD1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_FOOD1"
msgid "Rabbits love carrots so much, they'll even put 'em in cakes."
msgstr "Thỏ rất thích cà rốt, thậm chí chúng còn cho chúng vào bánh ngọt."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_FOOD2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_FOOD2"
msgid "Whew. It's not givin' me the transformation tingles."
msgstr "Ối. Nó không mang lại cho tôi sự biến đổi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_FOOD3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_FOOD3"
msgid "Looks like it's got a little snowcap on top."
msgstr "Có vẻ như nó có một lớp tuyết nhỏ phía trên."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_FOOD4
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_FOOD4"
msgid "I'll save the stick for a little midnight snack."
msgstr "Tôi sẽ để dành cây gậy cho bữa ăn nhẹ lúc nửa đêm."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_RABBITSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_RABBITSHRINE.BURNT"
msgid "Can't win 'em all, eh?"
msgstr "Không thể thắng hết được phải không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_RABBITSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_RABBITSHRINE.EMPTY"
msgid "This guy looks hungry."
msgstr "Anh chàng này có vẻ đói."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_RABBITSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_RABBITSHRINE.GENERIC"
msgid "Let's see what we've got to work with!"
msgstr "Hãy xem chúng ta phải làm việc với cái gì!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_TOKEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTR_TOKEN"
msgid "It doesn't feel polite to smack someone with a glove..."
msgstr "Đánh người khác bằng găng tay là điều không lịch sự..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTS_LANTERN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTS_LANTERN_POST.BURNT"
msgid "There's nothing left to chop, Lucy."
msgstr "Chẳng còn gì để chặt nữa, Lucy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTS_LANTERN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTS_LANTERN_POST.GENERIC"
msgid "No, Lucy. You are not chopping it down."
msgstr "Không, Lucy. Bạn không chặt nó xuống."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTS_LANTERN_POST_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTS_LANTERN_POST_ITEM"
msgid "These would look great around my cabin."
msgstr "Những thứ này sẽ trông tuyệt vời xung quanh cabin của tôi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTS_SNAKESHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTS_SNAKESHRINE.BURNT"
msgid "So that's why I smelled smoke."
msgstr "Đó là lý do tại sao tôi ngửi thấy mùi khói."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTS_SNAKESHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTS_SNAKESHRINE.EMPTY"
msgid "What do you feed a monster like that?"
msgstr "Bạn cho một con quái vật như vậy ăn gì?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTS_SNAKESHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTS_SNAKESHRINE.GENERIC"
msgid "I'm feeling lucky, Luce!"
msgstr "Tôi cảm thấy may mắn, Luce!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTS_WORM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTS_WORM"
msgid "WOO..orm?"
msgstr "WOO..orm?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOT_CATCOONSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOT_CATCOONSHRINE.BURNT"
msgid "All burnt up."
msgstr "Tất cả đều cháy hết."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOT_CATCOONSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOT_CATCOONSHRINE.EMPTY"
msgid "It could use a little something."
msgstr "Nó có thể sử dụng một chút gì đó."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOT_CATCOONSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOT_CATCOONSHRINE.GENERIC"
msgid "Some quality craftsmanship there."
msgstr "Một số nghề thủ công chất lượng ở đó."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE_GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE_GENERIC"
msgid "What's that, eh?"
msgstr "Đó là cái gì vậy?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE_PLANTHAPPY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE_PLANTHAPPY"
msgid "Looks right as rain!"
msgstr "Trông đẹp như mưa!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE_PLANTSTRESSED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE_PLANTSTRESSED"
msgid "Looks like there's a thing or two I should fix around here."
msgstr "Có vẻ như có một hoặc hai điều tôi nên sửa chữa ở đây."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE_PLANTSTRESSORFAMILY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE_PLANTSTRESSORFAMILY"
msgid "Maybe if I put some similar plants around..."
msgstr "Có lẽ nếu tôi đặt một số cây tương tự xung quanh..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE_PLANTSTRESSORHAPPINESS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE_PLANTSTRESSORHAPPINESS"
msgid "Maybe it just needs a little pep talk, eh?"
msgstr "Có lẽ nó chỉ cần một cuộc nói chuyện nhỏ, hả?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE_PLANTSTRESSORKILLJOYS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE_PLANTSTRESSORKILLJOYS"
msgid "I guess the garden's feeling a bit cluttered."
msgstr "Tôi cảm giác của khu vườn hơi lộn xộn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE_PLANTSTRESSORMOISTURE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE_PLANTSTRESSORMOISTURE"
msgid "It could use some more water, eh?"
msgstr "Nó cần thêm nước, hả?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE_PLANTSTRESSORNUTRIENTS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE_PLANTSTRESSORNUTRIENTS"
msgid "Might not be enough nutrients in the soil..."
msgstr "Có thể không đủ chất dinh dưỡng trong đất..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE_PLANTSTRESSOROVERCROWDING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE_PLANTSTRESSOROVERCROWDING"
msgid "There's so many plants packed in this garden, there's not enough room to grow."
msgstr "Có rất nhiều cây trong khu vườn này, không có đủ chỗ để trồng."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE_PLANTSTRESSORSEASON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE_PLANTSTRESSORSEASON"
msgid "It just wasn't made for this kind of season."
msgstr "Nó không được sinh ra cho mùa này."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE_PLANTVERYSTRESSED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE_PLANTVERYSTRESSED"
msgid "There's a lot going wrong with this plant."
msgstr "Có rất nhiều điều không ổn với cây này."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE_SMOLDERING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE_SMOLDERING"
msgid "It's aboot to go up in flames, eh?"
msgstr "Thật là khó để bốc cháy phải không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE_TOODARK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE_TOODARK"
msgid "It's too dark, eh!"
msgstr "Trời tối quá, ôi!"

