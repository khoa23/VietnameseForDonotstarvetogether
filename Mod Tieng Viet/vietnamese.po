msgstr "Một số ít hạt kỳ lạ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GOATKID
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GOATKID"
