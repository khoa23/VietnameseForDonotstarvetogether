msgstr "Wolfgang không thích khuôn mặt ma quái này."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MASK_SAGEHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MASK_SAGEHAT"
msgid "Not Wolfgang style."
msgstr "Không phải phong cách của Wolfgang."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MASK_TOADYHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MASK_TOADYHAT"
