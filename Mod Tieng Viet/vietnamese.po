msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT"
msgid "All this rain isn't helping."
msgstr "Tất cả mưa này không giúp ích gì."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT"
msgid "It's drying out nicely."
msgstr "Nó đang khô dần."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.GENERIC"
msgid "I'd be cantankerous too if I were left without meat!"
msgstr "Tôi cũng sẽ gắt gỏng nếu không có thịt!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT_MULTI.ABANDONED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT_MULTI.ABANDONED"
msgid "It hath fallen."
msgstr "Nó đã rơi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT_MULTI.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT_MULTI.BURNT"
msgid "Such a shame."
msgstr "Thật là xấu hổ."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE"
msgid "The moisture has been vanquished!"
msgstr "Độ ẩm đã bị đánh bại!"

