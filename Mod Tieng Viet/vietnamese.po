msgstr "Huh. Làm tôi nhớ đến quê nhà."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_LAMP_SHORT"
msgid "Enlightening."
msgstr "Khai sáng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MEALINGSTONE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MEALINGSTONE"
