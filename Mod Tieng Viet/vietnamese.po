msgstr "Cậu đùa tớ chắc."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WOODIE.MOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WOODIE.MOOSEGHOST"
