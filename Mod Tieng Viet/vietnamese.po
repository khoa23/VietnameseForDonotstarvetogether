msgstr "Và cứ như vậy, tôi không còn thấy đói nữa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GELBLOB_STORAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GELBLOB_STORAGE.GENERIC"
