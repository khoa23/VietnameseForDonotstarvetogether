msgstr "Heh, 'cô gái xinh đẹp!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WURT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WURT.GENERIC"
msgid "Hi %s!"
msgstr "Chào %s!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WURT.GHOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WURT.GHOST"
msgid "Yeesh, what happened to you?"
msgstr "Vâng, chuyện gì đã xảy ra với bạn vậy?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WURT.MURDERER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WURT.MURDERER"
