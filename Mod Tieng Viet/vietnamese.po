msgstr "Chẳng còn gì ở lại bên trong nữa."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TREASURECHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TREASURECHEST.GENERIC"
