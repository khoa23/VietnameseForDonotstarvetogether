msgstr "Nó làm cháy cả lông trên ngón tay của chúng ta!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.FUMAROLEAXE.LUKEWARM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.FUMAROLEAXE.LUKEWARM"
msgid "Aww, where did the heat go?"
