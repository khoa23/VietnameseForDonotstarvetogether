#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LUNARPLANTHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LUNARPLANTHAT"
msgid "How am I supposed to see in that thing?"
msgstr "Làm sao tôi có thể nhìn thấy thứ đó?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LUNARPLANT_HUSK"
