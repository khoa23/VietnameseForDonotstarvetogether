msgid "Select"
msgstr "Chọn"

#. STRINGS.SET_DESCRIPTIONS.body_ugly_winterhat_black_davys
msgctxt "STRINGS.SET_DESCRIPTIONS.body_ugly_winterhat_black_davys"
msgid "You might as well get one in every color."
msgstr "Bạn có thể mua mỗi màu một cái cũng được."

#. STRINGS.SET_DESCRIPTIONS.body_ugly_winterhat_pink_hibiscus
msgctxt "STRINGS.SET_DESCRIPTIONS.body_ugly_winterhat_pink_hibiscus"
msgid "As a matter of fact, having a matching hat and sweater is VERY fashionable."
msgstr "Thực ra thì, việc đội mũ và mặc áo len ton-sur-ton là RẤT hợp thời trang."

#. STRINGS.SET_DESCRIPTIONS.emote_carol
msgctxt "STRINGS.SET_DESCRIPTIONS.emote_carol"
msgid "The spirit of Winter's Feast will keep you warm when you go a-caroling tonight!"
msgstr "Tinh thần của Tiệc Mùa Đông sẽ giữ ấm cho bạn khi bạn đi hát ca khúc mừng Giáng Sinh tối nay!"

#. STRINGS.SET_DESCRIPTIONS.emote_fistshake
msgctxt "STRINGS.SET_DESCRIPTIONS.emote_fistshake"
msgid "Why, you!"
msgstr "Ồ, đồ ngốc này!"

#. STRINGS.SET_DESCRIPTIONS.emote_sleepy
msgctxt "STRINGS.SET_DESCRIPTIONS.emote_sleepy"
msgid "You look cozy from top to bottom. Sweet dreams, sleepy survivor!"
msgstr "Trông bạn thật ấm cúng từ đầu đến chân. Chúc ngủ ngon, người sống sót buồn ngủ!"

#. STRINGS.SET_DESCRIPTIONS.emote_tiphat
msgctxt "STRINGS.SET_DESCRIPTIONS.emote_tiphat"
msgid "Much obliged."
msgstr "Đa tạ."

#. STRINGS.SET_DESCRIPTIONS.emote_yawn
msgctxt "STRINGS.SET_DESCRIPTIONS.emote_yawn"
msgid "You are so ready for a nap. You've never been more ready for anything in your entire life."
msgstr "Bạn đã sẵn sàng để chợp mắt rồi đấy. Chưa bao giờ trong đời bạn lại sẵn sàng đến thế."

