msgstr "Chào! Bạn đang đi sai đường!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2"
