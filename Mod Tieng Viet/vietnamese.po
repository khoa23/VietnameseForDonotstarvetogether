msgstr "Đã lâu lắm rồi kể từ khi nó văng xuống nước."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC"
