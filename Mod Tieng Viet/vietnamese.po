msgstr "Chắc tôi vừa được câu cá vừa bị cảm lạnh cùng lúc mất."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE"
