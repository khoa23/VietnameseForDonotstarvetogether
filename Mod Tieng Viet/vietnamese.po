msgstr "Theo như khoa học chứng minh thì đáng lẽ chúng phải chết rồi chứ nhỉ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_BERRYBUSH"
msgid "Those berries are all gone."
msgstr "Những quả mọng đó mất tiêu hết rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_BOWL_SILVER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_BOWL_SILVER"
msgid "A bright bowl."
msgstr "Một cái bát sáng bóng"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_CARROT_SEEDS"
msgid "A handful of odd seeds."
msgstr "Một số ít hạt kỳ lạ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_CASSEROLEDISH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_CASSEROLEDISH"
