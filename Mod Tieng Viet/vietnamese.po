msgstr "Liệu đây có phải cái đúng không nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_MEMORY_KIT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_MEMORY_KIT"
msgid "I'll have it whipped up in no time at all."
msgstr "Ta sẽ làm xong nó trong nháy mắt thôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC"
msgid "I should feed it something shiny."
msgstr "Ta nên cho nó ăn thứ gì đó lấp lánh."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING"
msgid "Sometimes you must crack some eggs to get an omelette, non?"
msgstr "Đôi khi bạn phải đập vỡ vài quả trứng thì mới làm được món trứng ốp la chứ, phải không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT"
msgid "I'll have it whipped up in no time at all."
msgstr "Ta sẽ làm xong nó trong nháy mắt thôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC"
msgid "I should feed it something shiny."
msgstr "Ta nên cho nó ăn thứ gì đó lấp lánh."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING"
msgid "Oh my, it's a good thing that isn't a real egg."
msgstr "Ôi chao, may mà đó không phải là quả trứng thật đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC"
msgid "I should feed it something shiny."
msgstr "Ta nên cho nó ăn thứ gì đó lấp lánh."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING"
msgid "Shall I press it now? Or... now?"
msgstr "Ta có nên nhấn nó bây giờ không? Hay là... bây giờ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_SHOOTING_KIT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_SHOOTING_KIT"
msgid "I'll have it whipped up in no time at all."
msgstr "Ta sẽ làm xong nó trong nháy mắt thôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC"
msgid "I should feed it something shiny."
msgstr "Ta nên cho nó ăn thứ gì đó lấp lánh."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING"
msgid "A test of my timing skills, non?"
msgstr "Một bài kiểm tra kỹ năng canh thời gian của ta, đúng chứ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC"
msgid "A door, tres petite."
msgstr "Một cánh cửa, vô cùng nhỏ bé."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING"
msgid "Stay out of the nest... and my soup!"
msgstr "Tránh xa cái tổ ra... và cả súp của ta nữa!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT"
msgid "I'll have it whipped up in no time at all."
msgstr "Ta sẽ làm xong nó trong nháy mắt thôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC"
msgid "I should feed it something shiny."
msgstr "Ta nên cho nó ăn thứ gì đó lấp lánh."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING"
msgid "I'm quite good at this one!"
msgstr "Ta rất giỏi trò này đấy!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_BALL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_BALL"
msgid "Perhaps I'll toss it around with the children."
msgstr "Có lẽ ta sẽ đem ném qua ném lại với bọn trẻ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_CROWKID
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_CROWKID"
msgid "Bonjour! And who might you be, little one?"
msgstr "Bonjour! Và nhóc là ai thế nhỉ, bé con?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_GAMETOKEN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_GAMETOKEN"
msgid "A token for le carnaval!"
msgstr "Một chiếc thẻ cho le carnaval!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_HOST
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_HOST"
msgid "He's a bit odd, but so is everything around here, non?"
msgstr "Hắn ta hơi kỳ cục chút, nhưng mọi thứ quanh đây cũng thế cả thôi, phải không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_PLAZA.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
msgid "Hm, it's looking a bit bland around here."
msgstr "Hừm, quanh đây trông có vẻ hơi nhạt nhẽo nhỉ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
msgid "Having more decorations around would certainly give it some zest!"
msgstr "Có thêm nhiều đồ trang trí xung quanh chắc chắn sẽ làm nó thêm phần thú vị đấy!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3"
msgid "Magnifique!"
msgstr "Magnifique!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_PLAZA_KIT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_PLAZA_KIT"
msgid "This tree has a certain je ne sais quoi."
msgstr "Cái cây này mang một vẻ quyến rũ khó tả."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC"
msgid "They have quite a menu of prizes to choose from!"
msgstr "Họ có cả một thực đơn giải thưởng để lựa chọn kìa!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT"
msgid "All the ingredients are together, now let's get cooking!"
msgstr "Đã gom đủ nguyên liệu rồi, giờ thì bắt tay vào nấu nướng thôi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC"
msgid "One lonely ticket."
msgstr "Một chiếc vé cô đơn."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK"
msgid "Mon dieu, a mountain of tickets!"
msgstr "Mon dieu, cả một núi vé luôn!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
msgid "Quite a few tickets."
msgstr "Khá nhiều vé đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_SEEDPACKET"
msgid "They could use a bit of seasoning."
msgstr "Chúng có thể dùng thêm chút gia vị đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_VEST_A
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_VEST_A"
msgid "Ah, I remember this style being quite popular in Paris."
msgstr "À, ta nhớ kiểu này từng rất thịnh hành ở Paris."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_VEST_B
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_VEST_B"
msgid "It provides a nice bit of shade."
msgstr "Nó che bóng mát khá tốt đấy chứ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_VEST_C
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARNIVAL_VEST_C"
msgid "When at a crow carnival, dress like the crows do, non?"
msgstr "Đã đến lễ hội quạ thì phải ăn mặc giống loài quạ chứ, phải không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARPENTRY_BLADE_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARPENTRY_BLADE_MOONGLASS"
msgid "Will it slice le jambon?"
msgstr "Liệu nó có cắt được le jambon không nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARPENTRY_STATION.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARPENTRY_STATION.BURNT"
msgid "C'est la vie..."
msgstr "C'est la vie..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARPENTRY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARPENTRY_STATION.GENERIC"
msgid "A bit of furniture would be nice around here."
msgstr "Có vài món đồ nội thất quanh đây thì tuyệt nhỉ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARRAT.DEAD"
msgid "I wonder what you'd taste like."
msgstr "Tự hỏi vị của ngươi ra sao nhỉ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARRAT.GENERIC"
msgid "I... think I had a nightmare like this once."
msgstr "Ta... nghĩ là mình từng có một cơn ác mộng thế này rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARRAT.HELD"
msgid "Would you be a meat or a vegetable?"
msgstr "Ngươi là thịt hay là rau củ đây?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARRAT.SLEEPING"
msgid "Bonne nuit."
msgstr "Bonne nuit."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARRAT_GHOSTRACER"
msgid "Oh! Well aren't you... cute?"
msgstr "Ồ! Ngươi không phải là... dễ thương lắm sao?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARROT"
msgid "Fresh picked produce!"
msgstr "Nông sản mới hái đây!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARROT_COOKED"
msgid "Could use a dash of olive oil and cilantro..."
msgstr "Có thể cho thêm chút dầu ô-liu và rau mùi..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARROT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARROT_OVERSIZED"
msgid "How many different ways could I prepare carrots of this size..."
msgstr "Ta có thể chế biến củ cà rốt khổng lồ này theo bao nhiêu cách khác nhau đây..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARROT_PLANTED"
msgid "Ah, a fresh carrot!"
msgstr "À, một củ cà rốt tươi ngon!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARROT_SEEDS"
msgid "Future ingredients, just waiting to be grown!"
msgstr "Những nguyên liệu của tương lai, chỉ chờ được lớn lên!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "Oh dear!"
msgstr "Ôi trời!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "Well, that won't help our explorations much."
msgstr "Chà, cái đó thì chẳng giúp ích gì nhiều cho việc thám hiểm của chúng ta rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "I hope my penmanship is legible."
msgstr "Mong là chữ viết tay của ta dễ đọc."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CATCOON"
msgid "What perky little ears."
msgstr "Đôi tai nhỏ nhắn thật lanh lợi làm sao."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CATCOONDEN.EMPTY"
msgid "Vacant of critters."
msgstr "Không có sinh vật nào ở bên trong."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CATCOONDEN.GENERIC"
msgid "How many critters can fit in there?"
msgstr "Bao nhiêu sinh vật có thể chui vừa vào đó chứ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CATCOONHAT"
msgid "Not quite my style."
msgstr "Không hẳn là phong cách của ta."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CATTOY_MOUSE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CATTOY_MOUSE"
msgid "I'm afraid I don't have any clockwork cheese."
msgstr "E là ta không có miếng phô mai máy nào đâu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "I'm sure I'm strong enough to move it."
msgstr "Ta chắc chắn là mình đủ sức để dịch chuyển nó."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "I can't get at it."
msgstr "Ta không chạm tới nó được."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_BANANA"
msgid "Bananas! Just the flavor I needed!"
msgstr "Chuối! Đúng hương vị ta đang cần!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_BANANA_BURNT"
msgid "I would have liked more fresh bananas."
msgstr "Ta thích có nhiều chuối tươi hơn cơ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Could use some oats and a few chocolate chips..."
msgstr "Có thể cho thêm chút yến mạch và vài viên sô-cô-la chip..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_BANANA_TREE"
msgid "There must be monkeys close by."
msgstr "Chắc có bầy khỉ ở gần đây rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_ENTRANCE"
msgid "I wonder what is underneath that?"
msgstr "Tự hỏi bên dưới đó là gì nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "Someone else is having their turn in there."
msgstr "Ai đó đang chiếm dụng chỗ dưới đó rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "I wonder what is underneath that?"
msgstr "Tự hỏi bên dưới đó là gì nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "Dare I?"
msgstr "Liệu ta có dám không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "What is within?"
msgstr "Bên trong có gì nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_EXIT.FULL"
msgid "I'll wait til there's a little more room."
msgstr "Ta sẽ đợi đến khi nào thoáng hơn một chút."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "Now isn't a good time to leave."
msgstr "Bây giờ không phải là thời điểm thích hợp để rời đi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_EXIT.OPEN"
msgid "I should like to see the surface again."
msgstr "Ta rất muốn được nhìn thấy mặt đất lần nữa."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_FERN"
msgid "How does anything grow down here?"
msgstr "Làm sao mà thứ gì có thể mọc nổi dưới này chứ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_FERN_WITHERED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_FERN_WITHERED"
msgid "It did not survive this environment."
msgstr "Nó đã không thể sống sót nổi trong môi trường này."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_VENT_MITE.DEAD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_VENT_MITE.DEAD"
msgid "It is dead."
msgstr "Nó chết rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_VENT_MITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_VENT_MITE.GENERIC"
msgid "A walking pressure cooker!"
msgstr "Một chiếc nồi áp suất biết đi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_VENT_MITE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_VENT_MITE.SLEEPING"
msgid "Perhaps a good time to harvest?"
msgstr "Có lẽ đây là thời điểm tốt để thu hoạch nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_VENT_MITE.VENTING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_VENT_MITE.VENTING"
msgid "Most unappetizing!"
msgstr "Thật là chướng mắt làm sao!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_VENT_ROCK.GAS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_VENT_ROCK.GAS"
msgid "Reminds me of rotten eggs."
msgstr "Làm ta nhớ đến trứng thối."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_VENT_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_VENT_ROCK.GENERIC"
msgid "I do not wish to wait for what comes out!"
msgstr "Ta không muốn chờ xem thứ gì sẽ chui ra đâu!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_VENT_ROCK.HOT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_VENT_ROCK.HOT"
msgid "Steaming as a method of cooking preserves nutrients and flavor!"
msgstr "Hấp là một phương pháp nấu ăn giúp giữ lại chất dinh dưỡng và hương vị!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_VENT_ROCK.MIASMA
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CAVE_VENT_ROCK.MIASMA"
msgid "It smells of death and disease!"
msgstr "Nó có mùi của sự chết chóc và bệnh tật!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CEILING_ROPE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CEILING_ROPE"
msgid "If you can't take the heat, climb the rope!"
msgstr "Nếu không chịu được sức nóng, hãy trèo lên dây thừng!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CEVICHE"
msgid "Truly what I live for!"
msgstr "Đích thực là thứ để ta sống vì nó!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHARCOAL"
msgid "This, a grill and some meat and I'd have dinner."
msgstr "Thứ này, một cái vỉ nướng cùng vài miếng thịt là ta có bữa tối rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHARLIERESIDUE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHARLIERESIDUE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHARLIEROSE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHARLIEROSE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHARLIE_HAND
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHARLIE_HAND"
msgid "It needs an important ingredient."
msgstr "Nó còn thiếu một nguyên liệu quan trọng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHARLIE_HECKLER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHARLIE_HECKLER"
msgid "What a rude bird!"
msgstr "Đúng là một con chim bất lịch sự!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHARLIE_LECTURN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHARLIE_LECTURN"
msgid "A play? Here?"
msgstr "Một vở kịch? Ở đây á?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHARLIE_NPC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHARLIE_NPC"
msgid "Mon dieu... Is that the face I've seen peering from the shadows?"
msgstr "Mon dieu... Đó có phải là khuôn mặt ta từng thấy lấp ló sau bóng tối không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHARLIE_STAGE_POST
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHARLIE_STAGE_POST"
msgid "I have the feeling I am being watched."
msgstr "Ta có cảm giác như mình đang bị theo dõi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSJUNK1"
msgid "Broken chess pieces?"
msgstr "Mấy quân cờ vua bị hỏng sao?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSJUNK2"
msgid "More broken chess pieces?"
msgstr "Lại thêm mấy quân cờ vua bị hỏng nữa à?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSJUNK3"
msgid "And yet more broken chess pieces?"
msgstr "Và vẫn còn nhiều quân cờ vua bị hỏng nữa ư?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "I think Maman would like this."
msgstr "Ta nghĩ Maman sẽ thích món này đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_ANTLION"
msgid "I do like her better like this."
msgstr "Ta thích cô ta ở dạng này hơn đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_BEARGER"
msgid "I can't believe we survived that beast!"
msgstr "Ta không thể tin là chúng ta đã sống sót sau khi đối đầu với con quái vật đó!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_BEARGER_MUTATED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_BEARGER_MUTATED"
msgid "A second course of monster that I didn't ask for!"
msgstr "Món quái vật thứ hai mà ta chẳng hề đòi hỏi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_BEEFALO"
msgid "What a beautifully marbled steak."
msgstr "Một miếng bít-tết có các vân mỡ đẹp làm sao."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "Muse for my new honey glaze!"
msgstr "Nguồn cảm hứng cho lớp sốt mật ong mới của ta!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "It looks a bit like a bishop."
msgstr "Trông nó hơi giống quân tượng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "Mon dieu! It's moving!"
msgstr "Mon dieu! Nó đang chuyển động kìa!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "How lovely!"
msgstr "Đáng yêu làm sao!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_CARRAT"
msgid "Looking at it is making me a little hungry..."
msgstr "Nhìn nó lại làm ta thấy hơi đói bụng rồi đấy..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_CATCOON"
msgid "At least this one won't try to sneak off with my lunch."
msgstr "Ít ra con này sẽ không thử nẫng mất bữa trưa của ta."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "I'm glad it's not trying to bite me."
msgstr "May là nó không cố cắn ta."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "I'm not sure why we memorialized this very scary creature."
msgstr "Ta không chắc tại sao chúng ta lại tạc tượng sinh vật cực kỳ đáng sợ này nữa."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_CRABKING"
msgid "I'm getting a sudden craving for seafood."
msgstr "Tự nhiên ta lại thèm hải sản thế không biết."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "I have to admit, I think I prefer him this way."
msgstr "Phải công nhận là ta thích hắn ở dạng này hơn."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_DAYWALKER2
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_DAYWALKER2"
msgid "He put me off pork for some time."
msgstr "Hắn khiến ta mất cảm hứng ăn thịt heo một thời gian."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "It was much scarier in the flesh."
msgstr "Lúc bằng xương bằng thịt nó đáng sợ hơn nhiều."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "Brr... it still gives me the shivers..."
msgstr "Brr... nhìn vẫn thấy nổi da gà..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_DEPTHWORM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_DEPTHWORM"
msgid "How could I forget the chewing."
msgstr "Làm sao ta có thể quên được tiếng nhai đó chứ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "I was afraid I was going to be broiled alive!"
msgstr "Ta cứ sợ mình sẽ bị nướng sống chứ lõi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "Did it just blink?"
msgstr "Nó vừa chớp mắt phải không nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_FORMAL"
msgid "This must be the king?"
msgstr "Đây chắc là quân vua nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "A three course fight I won't soon forget."
msgstr "Một trận chiến ba hiệp mà ta khó lòng quên được."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "One can dream."
msgstr "Người ta có quyền mơ mộng mà."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_KITCOON"
msgid "I think Mme. Wickerbottom is particularly fond of this one."
msgstr "Ta nghĩ Quý cô Wickerbottom cực kỳ thích con này."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_KLAUS"
msgid "A table centerpiece fit for a holiday feast."
msgstr "Một vật trang trí bàn ăn xứng tầm cho bữa tiệc ngày lễ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "It looks a bit like a knight."
msgstr "Trông nó hơi giống quân mã."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "Mon dieu! It's moving!"
msgstr "Mon dieu! Nó đang chuyển động kìa!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "I hope this won't bring us ill luck at sea..."
msgstr "Mong là thứ này sẽ không đem lại vận rủi cho chúng ta trên biển..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "As far as battles go, it was probably the most pleasant."
msgstr "Tính ra thì đây là trận chiến dễ chịu nhất đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "Perhaps now you can keep watch over my crock pot."
msgstr "Có lẽ giờ ngươi có thể canh chừng cái Nồi Hầm của ta được rồi đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_MOON"
msgid "Hits my eye like a big pizza pie."
msgstr "Đập vào mắt ta như một chiếc bánh pizza khổng lồ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "I should whip up some roast goose with cranberry sauce."
msgstr "Ta nên làm món ngỗng quay sốt nam việt quất mới được."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_MUSE"
msgid "This one looks like a queen."
msgstr "Con này trông giống quân hậu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_PAWN"
msgid "It looks a bit like a pawn."
msgstr "Trông nó hơi giống quân tốt."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_PIPE"
msgid "I hope it doesn't set a bad example for the little ones."
msgstr "Mong là nó không tạo ra tấm gương xấu cho bọn trẻ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "It looks a bit like a rook."
msgstr "Trông nó hơi giống quân xe."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "Mon dieu! It's moving!"
msgstr "Mon dieu! Nó đang chuyển động kìa!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_SHARKBOI
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_SHARKBOI"
msgid "It seemed to think it was top of the food chain."
msgstr "Nó cứ nghĩ mình đứng đầu chuỗi thức ăn cơ đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_STALKER"
msgid "If only I could use those bones in a broth."
msgstr "Ước gì ta có thể dùng đống xương đó để nấu nước dùng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "Stone mushroom soup anyone?"
msgstr "Ai muốn ăn súp nấm đá không nào?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "They weren't the most polite guests, non?"
msgstr "Chúng không phải là những vị khách lịch sự cho lắm nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD"
msgid "It comes in petit!"
msgstr "Nó có phiên bản nhỏ nhắn kìa!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR"
msgid "That was a bad combination."
msgstr "Đó là một sự kết hợp tồi tệ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT"
msgid "The portable version."
msgstr "Phiên bản bỏ túi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "I'm relieved it's just a statue."
msgstr "Ta nhẹ cả người vì nó chỉ là bức tượng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_WORMBOSS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_WORMBOSS"
msgid "It sure had an appetite."
msgstr "Nó đúng là có một chiếc dạ dày không đáy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_YOTD"
msgid "Ah, the sweet taste of victory!"
msgstr "À, hương vị ngọt ngào của chiến thắng!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_YOTH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_YOTH"
msgid "It was really hot and cold with this one."
msgstr "Con này lúc nóng lúc lạnh thất thường thật."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_YOTS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_YOTS"
msgid "I remember the chewing."
msgstr "Ta vẫn nhớ cảm giác bị nhai đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESTER"
msgid "You look cute and inedible."
msgstr "Trông mi dễ thương và không thể ăn được."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "The eye follows me wherever I go..."
msgstr "Con mắt cứ dõi theo ta đi bất cứ đâu..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "It sleeps."
msgstr "Nó đang ngủ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "Ah! Can this give me the storage space I crave?"
msgstr "À! Thứ này có thể cho ta thêm không gian lưu trữ mà ta hằng ao ước không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHEST_MIMIC_REVEALED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHEST_MIMIC_REVEALED"
msgid "It's quite horrible!"
msgstr "Trông nó thật kinh khủng!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHUM"
msgid "I suppose fish don't have an especially sophisticated palate."
msgstr "Ta đoán là loài cá không có khẩu vị tinh tế lắm đâu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CLAYHOUND.GENERIC"
msgid "Don't eat me, I'm unseasoned!"
msgstr "Đừng ăn ta nhé, ta chưa ướp gia vị đâu!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CLAYHOUND.STATUE"
msgid "Someone's a very talented sculptor."
msgstr "Ai đó điêu khắc khéo tay thật đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CLAYWARG.GENERIC"
msgid "I'm not on the menu!"
msgstr "Ta không nằm trong thực đơn đâu nhé!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CLAYWARG.STATUE"
msgid "It looks quite nice."
msgstr "Trông cũng đẹp phết đấy chứ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIRE.EMBERS"
msgid "I should stoke the fire."
msgstr "Ta nên tiếp thêm lửa cho đống lửa trại này."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIRE.GENERIC"
msgid "Fire that cools?"
msgstr "Lửa mà lại tỏa ra hơi lạnh á?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIRE.HIGH"
msgid "The flames climb higher!"
msgstr "Ngọn lửa đang bùng lên cao hơn rồi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIRE.LOW"
msgid "It's getting low."
msgstr "Lửa đang lụi dần rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIRE.NORMAL"
msgid "I should like to sit by you for a moment."
msgstr "Ta muốn ngồi bên cạnh ngươi một lát."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIRE.OUT"
msgid "I will have to light you again."
msgstr "Ta sẽ phải nhóm lửa cho ngươi lại thôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "I should stoke the fire."
msgstr "Ta nên tiếp thêm lửa cho đống lửa trại này."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "Fire that cools?"
msgstr "Lửa mà lại tỏa ra hơi lạnh á?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIREPIT.HIGH"
msgid "The flames climb higher!"
msgstr "Ngọn lửa đang bùng lên cao hơn rồi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIREPIT.LOW"
msgid "It's getting low."
msgstr "Lửa đang lụi dần rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "I should like to sit by you for a moment."
msgstr "Ta muốn ngồi bên cạnh ngươi một lát."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COLDFIREPIT.OUT"
msgid "I will have to light you again."
msgstr "Ta sẽ phải nhóm lửa cho ngươi lại thôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COLLAPSEDCHEST"
msgid "I'm tired of the whole \"deconstructed\" trend."
msgstr "Ta phát ngấy cái trào lưu \"giải cấu trúc\" này rồi đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPASS.E"
msgid "East."
msgstr "Hướng Đông."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPASS.GENERIC"
msgid "Hmm, no reading."
msgstr "Hừm, không đọc được gì cả."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPASS.N"
msgid "North."
msgstr "Hướng Bắc."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPASS.NE"
msgid "Northeast."
msgstr "Đông Bắc."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPASS.NW"
msgid "Northwest."
msgstr "Tây Bắc."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPASS.S"
msgid "South."
msgstr "Hướng Nam."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPASS.SE"
msgid "Southeast."
msgstr "Đông Nam."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPASS.SW"
msgid "Southwest."
msgstr "Tây Nam."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPASS.W"
msgid "West."
msgstr "Hướng Tây."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPOST"
msgid "The garden needs to be fed too, and proper plating is important!"
msgstr "Khu vườn cũng cần được bón phân, và việc sắp xếp lớp Lang sao cho phù hợp rất quan trọng!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "Tres bon!"
msgstr "Très bon!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "Burnt to a crisp."
msgstr "Cháy đen thui rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "Non, far too dry!"
msgstr "Không, khô khốc quá rồi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "A good place for food scraps."
msgstr "Một nơi tuyệt vời để bỏ thức ăn thừa."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPOSTINGBIN.WET"
msgid "Too runny, it needs less moisture."
msgstr "Quá nhão rồi, nó cần ít độ ẩm hơn."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COMPOSTWRAP"
msgid "I'm frankly offended."
msgstr "Thành thật mà nói thì ta cảm thấy bị xúc phạm đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CONSTRUCTION_PLANS"
msgid "It's a recipe for building!"
msgstr "Đó là công thức để xây dựng đấy!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKBOOK"
msgid "I added a few of my own personal recipes."
msgstr "Ta đã thêm vài công thức nấu ăn của riêng mình vào đó."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKEDMANDRAKE"
msgid "Could use horseradish..."
msgstr "Có thể cho thêm cải ngựa..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKEDMEAT"
msgid "Could use a chimichurri sauce..."
msgstr "Có thể dùng kèm sốt chimichurri..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKEDMONSTERMEAT"
msgid "Could use... uh... I don't even..."
msgstr "Có thể dùng với... ừm... ta chịu đấy..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKEDSMALLMEAT"
msgid "Could use sea salt..."
msgstr "Có thể dùng thêm chút muối biển..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKIECUTTER"
msgid "Could I interest you in something other than my boat?"
msgstr "Ngươi có hứng thú với thứ gì khác ngoài chiếc thuyền ván của ta không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKIECUTTERHAT"
msgid "Not the best looking hat, but c'est la vie."
msgstr "Trông không đẹp mắt cho lắm, nhưng c'est la vie."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKIECUTTERSHELL"
msgid "Reminds me a bit of a durian... mostly the smell."
msgstr "Làm ta nhớ đến sầu riêng một chút... chủ yếu là cái mùi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "Ah, non! I cannot make out the recipe!"
msgstr "Ồ, không! Ta không tài nào đọc được công thức!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKPOT.BURNT"
msgid "Tragique."
msgstr "Thật bi kịch."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "A masterpiece takes time."
msgstr "Một kiệt tác cần phải có thời gian."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "Nearly there..."
msgstr "Sắp xong rồi đây..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKPOT.DONE"
msgid "Ahh, fini!"
msgstr "À, hoàn thành!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COOKPOT.EMPTY"
msgid "Empty pot, empty heart."
msgstr "Nồi trống rỗng, trái tim trống hoác."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COOLANT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COOLANT"
msgid "It is stewing and brewing!"
msgstr "Nó đang sôi sùng sục và tỏa hương kìa!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COONTAIL"
msgid "Chat noodle."
msgstr "Mì sợi mèo."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CORN"
msgid "Corn! Sweet, sweet corn!"
msgstr "Ngô! Ngô ngọt ngào là đây!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CORN_COOKED"
msgid "Could use miso and lardons..."
msgstr "Có thể dùng tương miso và thịt lợn muối xông khói..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CORN_OVERSIZED"
msgid "Let's see, what shall I make with you? Corn gratin? Maque choux?"
msgstr "Để xem nào, ta nên làm món gì với ngươi đây? Ngô đút lò phô mai? Hay món maque choux?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CORN_SEEDS"
msgid "Future ingredients, just waiting to be grown!"
msgstr "Những nguyên liệu của tương lai, chỉ chờ được lớn lên!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "It seems to be a costume for a blacksmith."
msgstr "Trông có vẻ là trang phục dành cho thợ rèn."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COSTUME_DOLL_BODY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COSTUME_DOLL_BODY"
msgid "It seems to be a costume for a doll."
msgstr "Trông có vẻ là trang phục dành cho búp bê."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COSTUME_FOOL_BODY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COSTUME_FOOL_BODY"
msgid "It seems to be a costume for a fool."
msgstr "Trông có vẻ là trang phục dành cho gã hề."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COSTUME_KING_BODY"
msgid "It seems to be a costume fit for a King."
msgstr "Trông có vẻ là trang phục xứng tầm cho nhà Vua."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "I wonder whose costume this could be?"
msgstr "Tự hỏi đây là trang phục của ai nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COSTUME_PRINCESS_BODY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COSTUME_PRINCESS_BODY"
msgid "Pretty."
msgstr "Xinh xắn thật."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "It seems to be a costume fit for a Queen."
msgstr "Trông có vẻ là trang phục xứng tầm cho Nữ hoàng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COSTUME_TREE_BODY"
msgid "It seems to be a costume for a... tree?"
msgstr "Trông có vẻ là trang phục dành cho một... cái cây?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "This statue is hungry for fuel."
msgstr "Bức tượng này đang thèm nhiên liệu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "Perhaps I could fix it up a bit."
msgstr "Có lẽ ta có thể sửa sang lại nó chút ít."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "This statue is hungry for fuel."
msgstr "Bức tượng này đang thèm nhiên liệu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "What a sweet little statue."
msgstr "Một bức tượng nhỏ đáng yêu làm sao."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "This statue is hungry for fuel."
msgstr "Bức tượng này đang thèm nhiên liệu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "Such a comforting glow."
msgstr "Ánh sáng ấm cúng làm sao."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COTL_TRINKET"
msgid "What an odd little chapeau."
msgstr "Cái mũ nhỏ kỳ quặc làm sao."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COZY_BUNNYMAN"
msgid "What a cozy-looking fellow."
msgstr "Đúng là một anh chàng trông ấm cúng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CRABKING.GENERIC"
msgid "Oh, the dishes I could make with that much crab meat..."
msgstr "Ồ, bao nhiêu là món ta có thể làm với ngần ấy thịt cua chứ..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CRABKING.INERT"
msgid "It seems to be missing a few shiny ingredients."
msgstr "Nó có vẻ đang thiếu vài nguyên liệu lấp lánh."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CRABKING_CANNONTOWER"
msgid "It reminds me of a seafood tower, but more deadly."
msgstr "Nó làm ta nhớ đến tháp hải sản, nhưng có vẻ chết chóc hơn."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CRABKING_CLAW"
msgid "I had a nightmare like this back in culinary school."
msgstr "Ta lại gặp cơn ác mộng giống hồi học nấu ăn."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CRABKING_ICEWALL"
msgid "The big crab built its own refridgerator."
msgstr "Con cua lớn tự xây cho nó một cái tủ lạnh luôn."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CRABKING_MOB"
msgid "You would go perfect with some lemon butter."
msgstr "Ngươi sẽ hoàn hảo khi ăn kèm chút bơ chanh đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "Wow. It's not even the main course."
msgstr "Chà. Nó thậm chí còn chưa phải món chính đâu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTERLAB"
msgid "I could use a friend in this difficult world."
msgstr "Tôi rất cần một người bạn ở thế giới khắc nghiệt này."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_BULBIN"
msgid "It never hurts to have a little onion on hand."
msgstr "Luôn thủ sẵn một chút hành bên mình không bao giờ là thừa cả."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_DRAGONLING"
msgid "Her name is \"Flambé\" and she is precious."
msgstr "Con bé tên là \"Flambé\" và nó cực kỳ đáng yêu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_EETS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_EETS"
msgid "Mon ami, won't you try my cakes?"
msgstr "Mon ami, bạn không tính thử bánh của tôi sao?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "Would you like me to make you some bacon and eggs?"
msgstr "Bạn có muốn tôi làm cho ít Thịt Xông Khói và Trứng không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_GLOMLING"
msgid "She's a great comfort in times of stress."
msgstr "Con bé là chỗ dựa tuyệt vời trong những lúc căng thẳng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_KITTEN"
msgid "Sweet petite chat."
msgstr "Chú mèo nhỏ ngọt ngào."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_LAMB"
msgid "This is Lambchop, my little kitchen helper."
msgstr "Đây là Lambchop, trợ thủ nhà bếp nhỏ của tôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "The light of my life!"
msgstr "Ánh sáng của đời tôi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_PERDLING"
msgid "I would never eat you."
msgstr "Tôi sẽ không bao giờ ăn thịt bạn đâu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_PUPPY"
msgid "Le petit chien!"
msgstr "Chú cún nhỏ kìa!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CROW.GENERIC"
msgid "Raven stew perhaps?"
msgstr "Chắc là súp quạ nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CROW.HELD"
msgid "Hush, my pet."
msgstr "Nào, cưng của tôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CRUMBS"
msgid "I'm on its delicious trail!"
msgstr "Tôi đang lần theo hương thơm của nó!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "It gives me a strange, bad feeling..."
msgstr "Nó đem lại cho tôi một cảm giác kỳ lạ, chẳng lành chút nào..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CUTGRASS"
msgid "What shall I craft?"
msgstr "Mình nên chế tạo gì đây?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CUTLESS"
msgid "That is not a sword, it's a toothpick!"
msgstr "Đây mà là kiếm à, tăm xỉa răng thì có!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CUTLICHEN"
msgid "Hmm, odd."
msgstr "Hừm, lạ thật."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CUTREEDS"
msgid "Smells like greenery."
msgstr "Ngửi cứ như mùi cây cỏ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CUTSTONE"
msgid "Compressed stones, nice presentation."
msgstr "Đá ép, bày trí đẹp mắt đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DAYWALKER.GENERIC"
msgid "I have decided on fear!"
msgstr "Tôi quyết định sẽ thấy sợ!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "I don't know whether to feel fear or pity."
msgstr "Tôi không biết nên thấy sợ hay thấy thương nữa."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DAYWALKER2.BURIED"
msgid "I may regret this, but I feel the urge to help this poor creature."
msgstr "Tôi có thể sẽ hối hận, nhưng tôi thấy muốn giúp sinh vật tội nghiệp này."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DAYWALKER2.GENERIC"
msgid "Perhaps he is not so bad after all."
msgstr "Có lẽ hắn ta cũng không tệ đến thế."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "Uh-oh! Monsieur Cochon is boiling mad!"
msgstr "Ồ không! Quý ngài Heo đang sôi máu lên rồi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "Ah zut, that stone is far too tough for me to break."
msgstr "Ah zut, hòn đá đó cứng quá tôi không phá nổi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "Perhaps I could free the poor creature?"
msgstr "Hay là mình giải cứu sinh vật tội nghiệp đó nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DEADLYFEAST"
msgid "I would not recommend this."
msgstr "Tôi không khuyến khích món này đâu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DEAD_SEA_BONES"
msgid "Hmm... that might be good in a soup."
msgstr "Hừm... cho vào súp chắc sẽ ngon đây."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "Au revoir, tree."
msgstr "Tạm biệt nhé, cái cây."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "Crisp, no?"
msgstr "Giòn rụm, phải không nào?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "Sliced!"
msgstr "Đã cắt lát!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "A bouquet of leaves."
msgstr "Một bó lá."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "No thank you!"
msgstr "Xin miễn nhé!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DECK_OF_CARDS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DECK_OF_CARDS"
msgid "Maman loved her cards."
msgstr "Maman rất thích mấy lá bài của bà."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DECOR_CENTERPIECE"
msgid "It's no Rodin."
msgstr "Làm sao bằng tác phẩm của Rodin được."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "We must replace these at once."
msgstr "Chúng ta phải thay ngay mấy thứ này thôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "Now we can all shine a little brighter."
msgstr "Giờ thì tất cả chúng ta có thể tỏa sáng hơn một chút rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "Pretty, though I prefer flour."
msgstr "Đẹp đấy, dù tôi thích bột mì hơn."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "It's looking pretty dim."
msgstr "Trông mờ tịt rồi kìa."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "I'm sorry, Maman."
msgstr "Con xin lỗi, Maman."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DECOR_LAMP"
msgid "Lumiere!"
msgstr "Ánh sáng!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "It's fine."
msgstr "Cũng ổn."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "My art is done in the kitchen."
msgstr "Nghệ thuật của tôi được thể hiện trong nhà bếp."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "I long to see the face of Maman."
msgstr "Tôi rất khao khát được nhìn thấy khuôn mặt của Maman."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DEER.ANTLER"
msgid "Shouldn't they have two antlers?"
msgstr "Chẳng phải chúng nên có hai chiếc sừng sao?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DEER.GENERIC"
msgid "Imagine... succulent venison bourguignon."
msgstr "Hãy tưởng tượng xem... món thịt nai hầm vang đỏ béo ngậy mọng nước."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DEERCLOPS"
msgid "I once had a saucier who looked like that."
msgstr "Tôi từng có một bếp trưởng nước sốt trông y như thế này."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "It is done. Well done."
msgstr "Xong việc. Chín kỹ luôn rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "What an unappetizing smell."
msgstr "Mùi mới kém hấp dẫn làm sao."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "Mon dieu! What is happening?"
msgstr "Chúa tôi! Chuyện gì đang xảy ra thế này?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "If you can't take the heat, freeze the kitchen."
msgstr "Nếu không chịu được nhiệt, hãy đóng băng nhà bếp lại."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "It's missing the SEEcret ingredient."
msgstr "Thiếu mất thành phần bí mật (SEEcret) rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "I'll whip it up tout de suite!"
msgstr "Tôi sẽ làm ngay đây!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "Giant eyeball... soup?"
msgstr "Con mắt khổng lồ... nấu súp à?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DEER_ANTLER"
msgid "It looks like a key, does it not?"
msgstr "Trông giống một chiếc chìa khóa phải không nào?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DEER_GEMMED"
msgid "Oh deer!"
msgstr "Ồ nai hươu ơi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "Well past its expiry date."
msgstr "Quá hạn sử dụng lâu lắm rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DESERTHAT"
msgid "Goggles would be quite useful. I need my eyes."
msgstr "Đeo kính bảo hộ sẽ rất hữu ích đây. Đôi mắt của tôi rất quý giá."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DESICCANT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DESICCANT"
msgid "It whisks the moisture away."
msgstr "Nó hút sạch độ ẩm đi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DESICCANTBOOSTED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DESICCANTBOOSTED"
msgid "It keeps me drier than hardtack."
msgstr "Nó giúp tôi khô ráo hơn cả bánh quy cứng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DEVTOOL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DEVTOOL"
msgid "Efficient, oui?"
msgstr "Hiệu quả đấy chứ, phải không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DEVTOOL_NODEV
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DEVTOOL_NODEV"
msgid "No, I am a traditionalist."
msgstr "Không, tôi là người theo chủ nghĩa truyền thống."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DIRTPILE"
msgid "It's making a bit of a mess, isn't it?"
msgstr "Làm bừa bộn cả lên rồi đấy, phải không nào?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DIVININGROD.COLD"
msgid "Hmm, keep looking."
msgstr "Hừm, tìm tiếp nào."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DIVININGROD.GENERIC"
msgid "A finely tuned radar stick."
msgstr "Một chiếc gậy dò đường được tinh chỉnh tinh tế."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DIVININGROD.HOT"
msgid "I can almost smell it!"
msgstr "Tôi gần như ngửi thấy mùi của nó rồi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DIVININGROD.WARM"
msgid "I've caught onto something!"
msgstr "Tôi bắt được manh mối rồi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DIVININGROD.WARMER"
msgid "Warmer, warmer...!"
msgstr "Ấm lên rồi, ấm lên rồi...!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "Is it a chopping block?"
msgstr "Đây là thớt chặt thịt à?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DIVININGRODBASE.READY"
msgid "How do I turn it on?"
msgstr "Làm sao để bật nó lên đây?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "Preparation complete!"
msgstr "Công tác chuẩn bị đã hoàn tất!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DIVININGRODSTART"
msgid "That looks important."
msgstr "Trông có vẻ quan trọng đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DOCK_KIT"
msgid "Everything one might need to whip up a dock."
msgstr "Mọi thứ cần thiết để dựng lên một cái bến tàu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "My dock needs a bit of garnish."
msgstr "Bến tàu của tôi cần thêm chút trang trí."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DOLL_BLUEPRINT"
msgid "Tres mignon!"
msgstr "Quá đáng yêu!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONBOAT_KIT"
msgid "Just like a gravy boat, minus the gravy."
msgstr "Y như một chiếc thuyền ván đựng nước sốt, chỉ là thiếu nước sốt thôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONBOAT_PACK"
msgid "Just add water, and voilà!"
msgstr "Chỉ cần thêm nước, và voilà!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONBODYHAT"
msgid "I can be the middle of the dragon."
msgstr "Tôi có thể làm phần giữa của con rồng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONCHILISALAD"
msgid "A hint of spice to awaken the tastebuds."
msgstr "Một chút vị cay để đánh thức vị giác."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFLY"
msgid "I'm not cut out for this."
msgstr "Tôi không hợp với việc này đâu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "Ooh la la, burnproof storage."
msgstr "Ooh la la, kho chứa chống cháy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE"
msgid "Burnproof storage, très grand!"
msgstr "Kho chứa chống cháy, rất rộng rãi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "It's a gilded furnace."
msgstr "Đó là một lò luyện mạ vàng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "Is it reparable?"
msgstr "Liệu có sửa được không nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "What a handsome fire!"
msgstr "Ngọn lửa đẹp làm sao!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "I believe it's giving me the \"eye\"."
msgstr "Tôi tin là nó đang \"liếc\" tôi đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFRUIT"
msgid "So exotic!"
msgstr "Thật là kỳ lạ và độc đáo!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "Could use a spread of pudding and chia seeds..."
msgstr "Thêm chút bánh pudding và hạt chia thì tuyệt..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "Delicious fresh fruit! What shall I make with you?"
msgstr "Trái cây tươi ngon quá! Mình nên làm món gì với bạn đây?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "Future ingredients, just waiting to be grown!"
msgstr "Những nguyên liệu cho tương lai, chỉ chờ ngày đơm hoa kết trái!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONHEADHAT"
msgid "Oh! Do I get to be the head?"
msgstr "Ồ! Tôi được làm phần đầu rồng à?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONPIE"
msgid "Flaky crust, tart filling... heavenly!"
msgstr "Vỏ bánh xốp giòn, phần nhân chua ngọt... đúng là tuyệt phẩm!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONTAILHAT"
msgid "I'm just happy to be part of the festivities."
msgstr "Tôi rất vui vì được góp vui cho lễ hội."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGON_SCALES"
msgid "Hot to the touch!"
msgstr "Chạm vào nóng rẫy tay!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DREADSTONE"
msgid "Terrible and beautiful all at once."
msgstr "Vừa đáng sợ vừa đẹp đẽ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DREADSTONEHAT"
msgid "My head feels safer already."
msgstr "Đầu tôi có vẻ an toàn hơn hẳn rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DREADSTONE_STACK"
msgid "More of that curious stone."
msgstr "Thêm một ít hòn đá kỳ lạ đó nữa."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRIFTWOOD_LOG"
msgid "It's surprisingly light."
msgstr "Nó nhẹ một cách đáng ngạc nhiên."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "Driftwood en flambé!"
msgstr "Cây Gỗ Mục nướng flambé!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "Charred to a crisp."
msgstr "Cháy đen thui luôn rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "All nicely chopped."
msgstr "Đã chặt gọn gàng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "This tree's spent too much time at sea."
msgstr "Cái cây này dành quá nhiều thời gian ở ngoài biển rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRUMSTICK"
msgid "Dark meat!"
msgstr "Thịt đùi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRUMSTICK_COOKED"
msgid "Could use a light honey garlic glaze..."
msgstr "Có thể phết thêm một lớp sốt tỏi mật ong nhẹ..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_BANANABUSH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_BANANABUSH"
msgid "Ah, I've stumbled on some fresh bananas!"
msgstr "À, tôi vừa kiếm được vài quả chuối tươi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_BERRYBUSH"
msgid "Should I bring it back to life?"
msgstr "Mình có nên hồi sinh nó lại không nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "Now I can have fresh berries wherever I please!"
msgstr "Giờ thì tôi có thể có dâu rừng tươi bất cứ lúc nào mình muốn!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_GRASS"
msgid "Should I bring it back to life?"
msgstr "Mình có nên hồi sinh nó lại không nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_MARSH_BUSH"
msgid "Should I bring it back to life?"
msgstr "Mình có nên hồi sinh nó lại không nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_MONKEYTAIL"
msgid "I would suggest not eating those."
msgstr "Tôi khuyên là không nên ăn mấy thứ đó đâu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_SAPLING"
msgid "Should I bring it back to life?"
msgstr "Mình có nên hồi sinh nó lại không nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_TRAP_STARFISH"
msgid "Ha! I'm nobody's snack!"
msgstr "Ha! Đố ai ăn được tôi đấy!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUMBBELL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUMBBELL"
msgid "All of my arm strength comes from whisking egg whites."
msgstr "Tất cả cơ bắp tay của tôi đều có được từ việc đánh lòng trắng trứng đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "For tenderizing and freezing."
msgstr "Dùng để làm mềm thịt và làm rét."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUMBBELL_GEM"
msgid "All of my arm strength comes from whisking egg whites."
msgstr "Tất cả cơ bắp tay của tôi đều có được từ việc đánh lòng trắng trứng đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUMBBELL_GOLDEN"
msgid "All of my arm strength comes from whisking egg whites."
msgstr "Tất cả cơ bắp tay của tôi đều có được từ việc đánh lòng trắng trứng đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUMBBELL_HEAT"
msgid "Ah. So this is for \"warming up,\" non?"
msgstr "À. Vậy cái này là để \"làm ấm\", phải không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUMBBELL_MARBLE"
msgid "All of my arm strength comes from whisking egg whites."
msgstr "Tất cả cơ bắp tay của tôi đều có được từ việc đánh lòng trắng trứng đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUMBBELL_REDGEM"
msgid "For tenderizing and frying."
msgstr "Dùng để làm mềm và chiên thịt."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DURIAN"
msgid "That odor..."
msgstr "Cái mùi đó..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DURIAN_COOKED"
msgid "Could use onions and chili..."
msgstr "Cho thêm hành và ớt vào chắc sẽ hợp..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DURIAN_OVERSIZED"
msgid "Oh, that's... quite a lot of durian."
msgstr "Ồ, quả... sầu riêng to thế này cơ á."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DURIAN_SEEDS"
msgid "Future ingredients, just waiting to be grown!"
msgstr "Những nguyên liệu cho tương lai, chỉ chờ ngày đơm hoa kết trái!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUSTMERINGUE"
msgid "I'm afraid even I can't make dust palatable."
msgstr "Tôi sợ là ngay cả tôi cũng không thể làm cho bụi bẩn trở nên ngon miệng được."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUSTMOTH"
msgid "It seems like a gentle soul."
msgstr "Trông nó có vẻ là một linh hồn hiền lành."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUSTMOTHDEN"
msgid "Quelle surprise! It's so clean you could eat off it!"
msgstr "Thật bất ngờ! Sạch đến mức ăn bốc trực tiếp trên sàn luôn cũng được!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EARMUFFSHAT"
msgid "Ahh, fuzzy!"
msgstr "À ôi, bông xù!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EEL"
msgid "Anguille."
msgstr "Anguille."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EEL_COOKED"
msgid "Could use some Cajun spices..."
msgstr "Cho thêm chút gia vị Cajun vào chắc sẽ ngon..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EGGPLANT"
msgid "Aubergine!"
msgstr "Aubergine!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EGGPLANT_COOKED"
msgid "Could use tomato sauce and Parmesan..."
msgstr "Có thể cho thêm sốt cà chua và phô mai Parmesan..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "Now the question is, do I bake you or fry you?"
msgstr "Vấn đề bây giờ là, nên nướng hay chiên bạn đây?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EGGPLANT_SEEDS"
msgid "Future ingredients, just waiting to be grown!"
msgstr "Những nguyên liệu cho tương lai, chỉ chờ ngày đơm hoa kết trái!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ELIXIR_CONTAINER"
msgid "Maman loved... loves picnics."
msgstr "Maman rất thích... thích đi dã ngoại."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EMBERLIGHT"
msgid "Willow left this burner unattended."
msgstr "Willow để cái lò nấu này cháy mà không thèm quản lý kìa."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ENDTABLE.BURNT"
msgid "Should have taken it out of the oven sooner."
msgstr "Lẽ ra nên lấy nó ra khỏi lò nướng sớm hơn một chút."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ENDTABLE.EMPTY"
msgid "It could use a little something."
msgstr "Trông nó có vẻ thiếu thiếu chút gì đó."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "Now we can all shine a little brighter."
msgstr "Giờ thì tất cả chúng ta có thể tỏa sáng hơn một chút rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ENDTABLE.GENERIC"
msgid "I miss table settings."
msgstr "Tôi nhớ khung cảnh bày biện bàn ăn quá."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "It's looking pretty dim."
msgstr "Trông mờ tịt rồi kìa."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ENDTABLE.WILTED"
msgid "I hope Maman Angeline is eating well without me."
msgstr "Tôi hy vọng Maman Angeline vẫn đang ăn uống ngon miệng khi không có tôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EVERGREEN.BURNING"
msgid "Au revoir, tree."
msgstr "Tạm biệt nhé, cái cây."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EVERGREEN.BURNT"
msgid "Crisp, no?"
msgstr "Giòn rụm, phải không nào?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EVERGREEN.CHOPPED"
msgid "Sliced!"
msgstr "Đã cắt lát!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EVERGREEN.GENERIC"
msgid "A soldier of the exotic forest."
msgstr "Một người lính của khu rừng lạ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "Au revoir, tree."
msgstr "Tạm biệt nhé, cái cây."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "Crisp, no?"
msgstr "Giòn rụm, phải không nào?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "Sliced!"
msgstr "Đã cắt lát!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "A coneless arbre."
msgstr "Một cái cây không quả thông."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EYEBRELLAHAT"
msgid "\"Eye\" like it!"
msgstr "\"Mắt\" tôi thích lắm đấy!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EYEMASKHAT"
msgid "I must remember to avoid cutting onions while wearing this."
msgstr "Tôi phải nhớ tránh cắt hành tây khi đang đội cái này mới được."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EYEOFTERROR"
msgid "That eye has a hungry look to it..."
msgstr "Con mắt đó trông có vẻ đang thèm thuồng..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EYEOFTERROR_MINI"
msgid "I'm sure there are tastier things to eat than me!"
msgstr "Tôi chắc chắn còn nhiều thứ ngon hơn để ăn ngoài tôi ra!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "Don't make me scramble you!"
msgstr "Đừng bắt tôi biến cậu thành trứng bác nhé!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EYEPLANT"
msgid "Is that a mouth?"
msgstr "Đó là một cái miệng à?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EYETURRET"
msgid "This is my friend, Lazer Oeil!"
msgstr "Đây là bạn của tôi, Lazer Oeil!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EYETURRET_ITEM"
msgid "Wake up!"
msgstr "Thức dậy đi nào!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FARMPLOT.BURNT"
msgid "Stayed in the oven a tad too long."
msgstr "Nằm trong lò nướng hơi lâu quá một tí."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FARMPLOT.GENERIC"
msgid "I can grow my own ingredients!"
msgstr "Tôi có thể tự trồng nguyên liệu cho mình rồi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FARMPLOT.GROWING"
msgid "Ah, couldn't be more fresh!"
msgstr "À, không gì có thể tươi ngon hơn thế này nữa!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "Needs to be fertilized."
msgstr "Cần được bón phân."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_HOE"
msgid "I'd better get planting if I want some fresh ingredients."
msgstr "Tôi tranh thủ đi trồng trọt thôi nếu muốn có nguyên liệu tươi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_PLANT.BURNING"
msgid "It's too soon to start cooking!"
msgstr "Còn quá sớm để bắt đầu nấu nướng đấy nhé!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_PLANT.FULL"
msgid "Ready for cooking!"
msgstr "Sẵn sàng để nấu nướng rồi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "Mon dieu, it's enormous!"
msgstr "Chúa tôi, nó to khủng khiếp!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "It seems my garden is full of weeds!"
msgstr "Có vẻ khu vườn của tôi mọc đầy cỏ dại rồi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_PLANT.GENERIC"
msgid "My garden."
msgstr "Khu vườn của tôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_PLANT.GROWING"
msgid "The garden is coming along nicely."
msgstr "Khu vườn đang phát triển rất tốt."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "How very sad."
msgstr "Thật là đáng tiếc."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "Non! What a terrible waste!"
msgstr "Không! Thật là lãng phí quá đi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_PLANT.SEED"
msgid "All good things come with time."
msgstr "Mọi điều tốt đẹp đều cần có thời gian."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_PLOW"
msgid "What a handy machine!"
msgstr "Thật là một cỗ máy tiện lợi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_PLOW_ITEM"
msgid "Now, where to start the garden..."
msgstr "Giờ thì, bắt đầu làm vườn ở đâu đây nhỉ..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "There's a bit of unwanted garnish in my garden."
msgstr "Có vài thứ trang trí thừa thãi trong khu vườn của tôi kìa."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FEATHERFAN"
msgid "Why is it so big?"
msgstr "Sao nó lại to thế nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FEATHERHAT"
msgid "What am I supposed to do with this?"
msgstr "Tôi phải làm gì với cái thứ này đây?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FEATHERPENCIL"
msgid "Lighter than my meringue."
msgstr "Nhẹ hơn cả bánh trứng mè của tôi nữa."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FEATHER_CANARY"
msgid "A bird's feather, in lemon yellow."
msgstr "Lông chim màu vàng chanh."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FEATHER_CROW"
msgid "A bird's feather, in truffle black."
msgstr "Lông chim màu đen tuyền."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FEATHER_ROBIN"
msgid "A bird's feather, in cherry red."
msgstr "Lông chim màu đỏ anh đào."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "A bird's feather, in tuna blue."
msgstr "Lông chim màu xanh cá ngừ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FEM_PUPPET"
msgid "She's trapped!"
msgstr "Cô ấy bị kẹt rồi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FENCE"
msgid "A fence."
msgstr "Một cái hàng rào."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FENCE_ELECTRIC.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FENCE_ELECTRIC.GENERIC"
msgid "This appliance does not work on its own."
msgstr "Thiết bị này không tự hoạt động được đâu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FENCE_ELECTRIC.LINKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FENCE_ELECTRIC.LINKED"
msgid "How well does it fry?"
msgstr "Nó giật tê người cỡ nào nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FENCE_ELECTRIC_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FENCE_ELECTRIC_ITEM"
msgid "I must find a good spot for this."
msgstr "Tôi phải tìm một chỗ thật tốt cho cái này mới được."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FENCE_GATE"
msgid "Like an oven door."
msgstr "Giống như cửa lò nướng vậy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FENCE_GATE_ITEM"
msgid "The ingredients for a gate."
msgstr "Nguyên liệu để làm một cái cổng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FENCE_ITEM"
msgid "The ingredients for a fence."
msgstr "Nguyên liệu để làm một cái hàng rào."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FENCE_JUNK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FENCE_JUNK"
msgid "It's constructed well enough, but it lacks presentation."
msgstr "Cũng được gia cố khá chắc chắn, chỉ là thiếu tính thẩm mỹ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FENCE_ROTATOR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FENCE_ROTATOR"
msgid "I should poke it into a freshly made fence, to see if it's done."
msgstr "Tôi nên cắm nó vào một cái hàng rào vừa dựng để xem đã chín... ý tôi là xong chưa."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FERTILIZER"
msgid "Sauce for my garden!"
msgstr "Nước sốt cho khu vườn của tôi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FESTIVEFISH"
msgid "There's always room for new traditions!"
msgstr "Luôn có chỗ cho những truyền thống mới!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FESTIVE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FESTIVE_BLUEPRINT"
msgid "Just the right thing for a celebration."
msgstr "Đúng là thứ hoàn hảo cho một buổi ăn mừng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FIG
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FIG"
msgid "You would be delicious in a tart."
msgstr "Bạn sẽ rất ngon nếu được làm bánh tart đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FIGATONI
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FIGATONI"
msgid "I've never had pasta so decadent!"
msgstr "Tôi chưa bao giờ được ăn món mì ống nào thịnh soạn đến thế!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FIGKABAB
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FIGKABAB"
msgid "Something about being on a stick brings out more of the flavor."
msgstr "Cứ xiên vào que là hương vị lại bùng nổ hơn hẳn."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FIG_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FIG_COOKED"
msgid "It could use a bit of honey, perhaps some cinnamon and nutmeg..."
msgstr "Có thể cho thêm chút mật ong, vài nhánh quế và hạt nhục đậu khấu..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FIREBALLSTAFF"
msgid "A portable stovetop."
msgstr "Một chiếc bếp lò di động."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FIRECRACKERS"
msgid "Like oil splattering in a hot pan."
msgstr "Giống như dầu bắn xèo xèo trong chảo nóng vậy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FIREFLIES.GENERIC"
msgid "A dash of glow."
msgstr "Một chút ánh sáng lấp lánh."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FIREFLIES.HELD"
msgid "My petit lightbulb pets."
msgstr "Những chú bóng đèn thú cưng nhỏ bé của tôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FIREHOUND"
msgid "Chien, on fire!"
msgstr "Chó cún bốc cháy rồi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FIRENETTLES
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FIRENETTLES"
msgid "What a bother."
msgstr "Thật phiền phức."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FIRENETTLES_DRIED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FIRENETTLES_DRIED"
msgid "A fine ingredient!"
msgstr "Một nguyên liệu hảo hạng!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FIREPEN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FIREPEN"
msgid "I wonder if anyone has ever cooked with a flaming pen?"
msgstr "Tự hỏi có ai từng nấu ăn bằng một cây bút đang bốc cháy chưa nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FIREPIT.EMBERS"
msgid "That fire's almost out!"
msgstr "Đống lửa đó sắp tàn rồi kìa!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FIREPIT.GENERIC"
msgid "To warm my fingers and roast sausages."
msgstr "Để sưởi ấm ngón tay và nướng xúc xích."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FIREPIT.HIGH"
msgid "Maximum heat!"
msgstr "Nhiệt độ tối đa!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FIREPIT.LOW"
msgid "It's getting low."
msgstr "Nó đang nhỏ dần rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FIREPIT.NORMAL"
msgid "Parfait."
msgstr "Hoàn hảo."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FIREPIT.OUT"
msgid "I like when it's warm and toasty."
msgstr "Tôi thích lúc nó ấm áp và dễ chịu thế này."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FIRESTAFF"
msgid "Oven on a stick!"
msgstr "Lò nướng gắn trên gậy!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "Shall I fuel it up?"
msgstr "Tôi có nên tiếp thêm nhiên liệu cho nó không nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "He's sleeping."
msgstr "Cậu ấy đang ngủ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "Make it snow!"
msgstr "Tạo ra tuyết nào!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FISH"
msgid "Poisson!"
msgstr "Cá!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FISHINGNET"
msgid "Fresh seafood awaits!"
msgstr "Hải sản tươi sống đang chờ đón!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FISHINGROD"
msgid "I believe I prefer the fish market."
msgstr "Tôi tin là tôi thích ra chợ cá hơn."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FISHMEAT"
msgid "Doesn't even smell fishy it's so fresh!"
msgstr "Tươi đến mức chẳng hề có mùi tanh chút nào!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FISHMEAT_COOKED"
msgid "Could use a squeeze of lemon..."
msgstr "Có thể vắt thêm chút chanh..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FISHMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FISHMEAT_DRIED"
msgid "A well-cured fish filet."
msgstr "Một phi lê cá được ướp muối kỹ lưỡng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FISHMEAT_SMALL"
msgid "I will honor this ingredient."
msgstr "Tôi sẽ tôn trọng nguyên liệu này."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "Could use fresh herbs and butter..."
msgstr "Có thể dùng thêm thảo mộc tươi và bơ..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FISHMEAT_SMALL_DRIED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FISHMEAT_SMALL_DRIED"
msgid "A well-cured fish filet."
msgstr "Một phi lê cá được ướp muối kỹ lưỡng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FISHSTICKS"
msgid "Crunchy and golden outside, flaky and moist inside!"
msgstr "Vỏ ngoài giòn rụm vàng óng, bên trong mềm ẩm và thơm phức!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FISHTACOS"
msgid "Takes me south of the border!"
msgstr "Đưa tôi về miền đất phía nam biên giới!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FISH_BOX"
msgid "Is the fish fresh or canned? I feel rather conflicted."
msgstr "Cá tươi hay cá đóng hộp đây? Tôi thấy khá bối rối đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FISH_COOKED"
msgid "Could use a squeeze of lemon..."
msgstr "Có thể vắt thêm chút chanh..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FLINT"
msgid "Sharp as can be!"
msgstr "Sắc bén hết chỗ chê!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOATINGLANTERN.DEFLATED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOATINGLANTERN.DEFLATED"
msgid "What a pity."
msgstr "Thật đáng tiếc."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOATINGLANTERN.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOATINGLANTERN.GENERIC"
msgid "Such a warm comforting glow!"
msgstr "Ánh sáng ấm áp dễ chịu làm sao!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOATINGLANTERN.HELD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOATINGLANTERN.HELD"
msgid "This will set the mood!"
msgstr "Cái này sẽ tạo không khí lắm đây!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOTATIONCUSHION
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOTATIONCUSHION"
msgid "It will save me from the brine!"
msgstr "Nó sẽ cứu tôi khỏi vùng nước mặn chát!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOWER.GENERIC"
msgid "I love to garnish with edible flowers."
msgstr "Tôi rất thích trang trí bằng các loại hoa ăn được."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOWER.ROSE"
msgid "Confections flavored with rose water, perhaps?"
msgstr "Làm bánh kẹo có hương vị nước hoa hồng thì sao nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOWERHAT"
msgid "Who doesn't look good in this?!"
msgstr "Ai mà đội cái này vào lại chẳng đẹp cơ chứ?!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOWERSALAD"
msgid "Edible art!"
msgstr "Nghệ thuật có thể ăn được!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOWER_CAVE"
msgid "Ah, a light in the dark."
msgstr "À, một đốm sáng trong bóng tối."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOWER_CAVE_WITHERED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOWER_CAVE_WITHERED"
msgid "The light grows dim."
msgstr "Ánh sáng đang mờ dần."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOWER_EVIL"
msgid "A terrible omen if I ever saw one."
msgstr "Một điềm gở tồi tệ nhất mà tôi từng thấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FLOWER_WITHERED"
msgid "I only use fresh ingredients in my cooking."
msgstr "Tôi chỉ dùng nguyên liệu tươi sống trong món ăn của mình thôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FOLIAGE"
msgid "Feuillage."
msgstr "Feuillage."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FOLIAGE_DRIED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FOLIAGE_DRIED"
msgid "A fine ingredient!"
msgstr "Một nguyên liệu hảo hạng!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FOOTBALLHAT"
msgid "Made from pork, to protect my melon."
msgstr "Làm từ thịt heo, để bảo vệ cái đầu dưa hấu của tôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FORGETMELOTS"
msgid "Hm, I don't recall ever seeing a flower like that before."
msgstr "Hừm, tôi không nhớ mình từng thấy loài hoa nào như thế này trước đây."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FORGETMELOTS_DRIED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FORGETMELOTS_DRIED"
msgid "A fine ingredient!"
msgstr "Một nguyên liệu hảo hạng!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FORMAL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FORMAL_BLUEPRINT"
msgid "The beast will look as if it's going out to a fancy dinner party."
msgstr "Con quái vật trông sẽ như thể nó sắp đi dự tiệc tối sang trọng vậy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FOSSIL_PIECE"
msgid "No marrow left in it."
msgstr "Chẳng còn chút tủy xương nào trong đó nữa."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "That looks about right. Now, what's the secret ingredient?"
msgstr "Trông ổn rồi đấy. Giờ thì, thành phần bí mật là gì nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "At least it's good for a chuckle."
msgstr "Ít ra cũng đáng để cười trừ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "There are still a few bits missing."
msgstr "Vẫn còn thiếu vài mảnh ghép."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FRESHFRUITCREPES"
msgid "Is this not a thing of beauty?"
msgstr "Đây chẳng phải là một tác phẩm nghệ thuật sao?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FRIENDLYFRUITFLY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FRIENDLYFRUITFLY"
msgid "This one seems to be friendly."
msgstr "Con này có vẻ thân thiện đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FROG.DEAD"
msgid "I'll eat your legs for dinner!"
msgstr "Tôi sẽ ăn đùi của bạn cho bữa tối!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FROG.GENERIC"
msgid "Frog. A delicacy."
msgstr "Ếch. Một món ăn cao cấp."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FROG.SLEEPING"
msgid "Bonne nuit, little snack."
msgstr "Ngủ ngon nhé, miếng mồi nhỏ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FROGFISHBOWL"
msgid "I think I've outdone myself, given the available ingredients."
msgstr "Tôi nghĩ mình đã tự vượt qua chính mình với những nguyên liệu sẵn có này đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FROGGLEBUNWICH"
msgid "Ah, French cuisine!"
msgstr "Ồ, ẩm thực Pháp!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FROGLEGS"
msgid "I am hopping with excitement!"
msgstr "Tôi đang nhảy cẫng lên vì phấn khích đây!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FROGLEGS_COOKED"
msgid "Could use garlic and clarified butter..."
msgstr "Có thể dùng tỏi và bơ đun chảy..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FROGNEWTON
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FROGNEWTON"
msgid "A lesser known French recipe."
msgstr "Một công thức ít được biết đến của Pháp."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FROZENBANANADAIQUIRI
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FROZENBANANADAIQUIRI"
msgid "There's no better refreshment!"
msgstr "Không gì giải khát tuyệt bằng món này!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "Our little friend is not quite ripe."
msgstr "Bạn nhỏ của chúng ta vẫn chưa chín hẳn."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FRUITDRAGON.RIPE"
msgid "You'd be perfect in a meal!"
msgstr "Bạn sẽ hoàn hảo trong một bữa ăn đấy!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "Sleep well, you tasty morsel."
msgstr "Ngủ ngon nhé, miếng thịt thơm ngon."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FRUITFLY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FRUITFLY"
msgid "Non! Out of my garden!"
msgstr "Không! Cút khỏi vườn của tôi mau!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FRUITFLYFRUIT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FRUITFLYFRUIT"
msgid "They seem quite taken with whoever holds this."
msgstr "Chúng có vẻ rất bám dính lấy bất kỳ ai cầm thứ này."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FRUITMEDLEY"
msgid "Invigorating!"
msgstr "Sảng khoái làm sao!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FUMAROLEAXE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FUMAROLEAXE.GENERIC"
msgid "It's beginning to crumble."
msgstr "Nó bắt đầu rệu rã rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FUMAROLEAXE.HOT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FUMAROLEAXE.HOT"
msgid "It cuts through trees like a hot knife through butter!"
msgstr "Nó cắt qua thân cây mượt mà như dao nóng cắt bơ!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FUMAROLEAXE.LUKEWARM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FUMAROLEAXE.LUKEWARM"
msgid "It's getting cold."
msgstr "Nó đang nguội dần."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FUMAROLEAXE.WARM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FUMAROLEAXE.WARM"
msgid "It keeps my hands pleasantly warm."
msgstr "Nó giữ cho tay tôi ấm áp dễ chịu."

