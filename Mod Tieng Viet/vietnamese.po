msgstr "Tôi phải làm gì với đống cà tím này đây?!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT_SEEDS"
msgid "Some seeds."
msgstr "Một số hạt giống."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ELIXIR_CONTAINER"
