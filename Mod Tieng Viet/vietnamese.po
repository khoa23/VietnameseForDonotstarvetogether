#. STRINGS.SKIN_DESCRIPTIONS.wx78_dronezapremote_gothic
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_dronezapremote_gothic"
msgid "Let the fleshlings feel watched, then shock them when they least expect it!"
msgstr "Hãy để những xác thịt cảm thấy bị theo dõi, sau đó gây sốc cho họ khi họ ít mong đợi nhất!"

#. STRINGS.SKIN_DESCRIPTIONS.wx78_dronezapremote_jewelbox
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_dronezapremote_jewelbox"
msgid "An opulent interface befitting a mechanical overlord."
msgstr "Một giao diện sang trọng phù hợp với một lãnh chúa máy móc."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_formal
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_formal"
msgid "ERROR: DO NOT RECOGNIZE COMMAND \"MOUSTACHE.TWIRL\""
msgstr "Lỗi: không nhận ra lệnh \"Moustache.twirl\""

#. STRINGS.SKIN_DESCRIPTIONS.wx78_formalp
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_formalp"
msgid "ERROR: DO NOT RECOGNIZE COMMAND \"MOUSTACHE.TWIRL\""
msgstr "Lỗi: không nhận ra lệnh \"Moustache.twirl\""

#. STRINGS.SKIN_DESCRIPTIONS.wx78_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_gladiator"
msgid "WX-78's transformation into an organic killing machine proves all dreams are possible, if you only believe."
msgstr "Việc chuyển đổi của WX-78 thành một cỗ máy giết người hữu cơ chứng minh tất cả những giấc mơ là có thể, nếu bạn chỉ tin."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_hazard
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_hazard"
msgid "Disclaimer: Provides no protection against toxic hazards or personalities."
msgstr "Tuyên bố từ chối trách nhiệm: Không cung cấp sự bảo vệ chống lại các mối nguy hiểm hoặc tính cách độc hại."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_ice
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_ice"
msgid "This frozen automaton cares for nothing but cold hard logic."
msgstr "Automaton đông lạnh này không quan tâm gì ngoài logic cứng lạnh."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_lunar
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_lunar"
msgid "Cold. Lifeless. Perfect."
msgstr "Lạnh lẽo. Vô hồn. Hoàn hảo."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_magma"
msgid "WX-78 is big on incineration."
msgstr "WX-78 là lớn về thiêu hủy."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_masquerade
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_masquerade"
msgid "A gleaming testament to WX-78's unchallenged supremacy, and a reminder of their inevitable reign."
msgstr "Một minh chứng rõ ràng cho uy quyền tối cao không thể thách thức của WX-78 và là lời nhắc nhở về triều đại không thể tránh khỏi của họ."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_moduleremover_gothic
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_moduleremover_gothic"
msgid "A dread instrument for self-surgery."
msgstr "Một công cụ đáng sợ để tự phẫu thuật."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_moduleremover_jewelbox
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_moduleremover_jewelbox"
msgid "A fine implement for delicate work."
msgstr "Một dụng cụ tốt cho công việc đòi hỏi sự tinh tế."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_nature
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_nature"
msgid "WX-78 has become a solar powered robot."
msgstr "WX-78 đã trở thành một robot chạy bằng năng lượng mặt trời."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_none
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_none"
msgid "Original design, version 1.0."
msgstr "Thiết kế ban đầu, phiên bản 1.0."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_pirate
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_pirate"
msgid "Be the ship."
msgstr "Hãy là con tàu."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_retro
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_retro"
msgid "A bolt of lightning has brought this mechanical menace... to life!"
msgstr "Một tia sét đã đưa mối đe dọa cơ học này ... cho cuộc sống!"

#. STRINGS.SKIN_DESCRIPTIONS.wx78_rhinorook
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_rhinorook"
msgid "Rookiebot Costume"
msgstr "Trang phục tân binh"

#. STRINGS.SKIN_DESCRIPTIONS.wx78_rhinorook_d
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_rhinorook_d"
msgid "The welding on this costume took AGES."
msgstr "Hàn trên trang phục này mất nhiều thời gian."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_rhinorook_p
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_rhinorook_p"
msgid "The welding on this costume took AGES."
msgstr "Hàn trên trang phục này mất nhiều thời gian."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_rose
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_rose"
msgid "The organics have inextricably grown on WX-78... Regrettable."
msgstr "Các chất hữu cơ đã được phát triển chặt chẽ trên WX-78 ... thật đáng tiếc."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_rosep
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_rosep"
msgid "The organics have inextricably grown on WX-78... Regrettable."
msgstr "Các chất hữu cơ đã được phát triển chặt chẽ trên WX-78 ... thật đáng tiếc."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_scanner_catcoon
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_scanner_catcoon"
msgid "Curious as its namesake, only without the whiskers."
msgstr "Tò mò như tên gọi của nó, chỉ không có râu."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_scanner_catcoon_item
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_scanner_catcoon_item"
msgid "Curious as its namesake, only without the whiskers."
msgstr "Tò mò như tên gọi của nó, chỉ không có râu."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_scanner_fancy
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_scanner_fancy"
msgid "A luxury tool for humble tasks."
msgstr "Một công cụ sang trọng cho những nhiệm vụ khiêm tốn."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_scanner_fancy_item
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_scanner_fancy_item"
msgid "A luxury tool for humble tasks."
msgstr "Một công cụ sang trọng cho những nhiệm vụ khiêm tốn."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_scanner_gothic
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_scanner_gothic"
msgid "Scan for secrets best left buried."
msgstr "Quét tìm những bí mật tốt nhất nên được chôn giấu."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_scanner_gothic_item
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_scanner_gothic_item"
msgid "Scan for secrets best left buried."
msgstr "Quét tìm những bí mật tốt nhất nên được chôn giấu."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_scanner_jewelbox
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_scanner_jewelbox"
msgid "Fancy scanning you here."
msgstr "Fancy quét bạn ở đây."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_scanner_jewelbox_item
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_scanner_jewelbox_item"
msgid "Fancy scanning you here."
msgstr "Fancy quét bạn ở đây."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_scanner_junky
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_scanner_junky"
msgid "Nothing beats nuts and bolts."
msgstr "Không có gì vượt qua được đai ốc và bu lông."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_scanner_junky_item
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_scanner_junky_item"
