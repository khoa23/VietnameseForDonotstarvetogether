msgstr "Ái chà, liều lượng đó mạnh quá thể."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.APPLYMODULE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.APPLYMODULE.COOLDOWN"
msgid "only_used_by_wx78"
msgstr "chỉ_được_sử_dụng_bởi_wx78"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.APPLYMODULE.NOTENOUGHSLOTS
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.APPLYMODULE.NOTENOUGHSLOTS"
msgid "only_used_by_wx78"
msgstr "chỉ_được_sử_dụng_bởi_wx78"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.APPRAISE.NOTNOW
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.APPRAISE.NOTNOW"
msgid "Guess he ain't got the time right now."
msgstr "Chắc bây giờ anh ta không có thời gian rồi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.ATTUNE.NOHEALTH
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.ATTUNE.NOHEALTH"
msgid "I don't have it in me right now."
msgstr "Lúc này tớ không đủ sức để làm chuyện đó."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.BATHBOMB.ALREADY_BOMBED
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.BATHBOMB.ALREADY_BOMBED"
msgid "That one's already been glitzed up."
msgstr "Cái đó đã được trang hoàng lấp lánh rồi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.BATHBOMB.GLASSED
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.BATHBOMB.GLASSED"
msgid "Can't do that with all this glass in the way."
msgstr "Không làm thế được đâu khi đống kính này cứ vướng víu ở đây."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.BEGIN_QUEST.ONEGHOST
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.BEGIN_QUEST.ONEGHOST"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.BUILD.BUSY_STATION
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.BUILD.BUSY_STATION"
msgid "Looks like I gotta wait."
msgstr "Có vẻ như tớ phải đợi thôi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.BUILD.HASPET
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.BUILD.HASPET"
msgid "Nah. I'm a one-pet gal."
msgstr "Thôi khỏi. Tớ chỉ chung thủy với một con thú cưng thôi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.BUILD.MOUNTED
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.BUILD.MOUNTED"
msgid "Can't assemble anything from up here."
msgstr "Không thể lắp ráp cái gì khi đang ngồi trên này đâu."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.BUILD.TICOON
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.BUILD.TICOON"
msgid "I'm not lookin' to expand my workforce."
msgstr "Tớ không có nhu cầu mở rộng quy mô nhân sự đâu."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CARNIVALGAME_FEED.TOO_LATE
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.CARNIVALGAME_FEED.TOO_LATE"
