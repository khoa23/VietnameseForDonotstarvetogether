#. STRINGS.SKIN_DESCRIPTIONS.dragonflychest_fantasy
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dragonflychest_fantasy"
msgid "The only thing that will placate this fearsome chest is a belly full of treasure."
msgstr "Điều duy nhất sẽ xoa dịu chiếc rương đáng sợ này là một cái bụng đầy kho báu."

#. STRINGS.SKIN_DESCRIPTIONS.dragonflychest_kraken
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dragonflychest_kraken"
msgid "This chest is guarded by the visage of a terrifying sea creature."
msgstr "Chiếc rương này được bảo vệ bởi tầm nhìn của một sinh vật biển đáng sợ."

#. STRINGS.SKIN_DESCRIPTIONS.dragonflychest_upgraded_fantasy
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dragonflychest_upgraded_fantasy"
msgid "The only thing that will placate this fearsome chest is a belly full of treasure."
msgstr "Điều duy nhất có thể làm xoa dịu chiếc rương đáng sợ này là một chiếc bụng đầy của kho báu."

#. STRINGS.SKIN_DESCRIPTIONS.dragonflychest_upgraded_kraken
