#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SLINGSHOTMODKIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SLINGSHOTMODKIT"
msgid "What is that Walter up to now?"
msgstr "Cậu Walter đó lại đang mưu tính gì thế nhỉ?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SLINGSHOT_BAND_MIMIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SLINGSHOT_BAND_MIMIC"
