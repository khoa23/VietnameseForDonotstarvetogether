#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "Will make boat extra turny, yes?"
msgstr "Sẽ làm cho thuyền ván quay ngoắt hơn, phải không?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
