msgstr "Wolfgang khỏe hơn ngươi nhiều!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRANSISTOR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRANSISTOR"
