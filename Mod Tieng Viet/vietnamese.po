#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD"
msgid "I knew I saw something hiding over here!"
msgstr "Biết ngay là mình thấy có cái gì đó trốn ở đây mà!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "Found you!"
msgstr "Tìm thấy cậu rồi!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "There you are."
msgstr "Cậu đây rồi."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
msgid "I knew you'd be hiding there!"
msgstr "Biết ngay là cậu trốn ở đây mà!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
msgid "I see you!"
msgstr "Thấy cậu rồi nhé!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE"
msgid "I found the last one!"
msgstr "Tôi tìm thấy đứa cuối cùng rồi!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM"
msgid "{name} found the last one!"
msgstr "{name} đã tìm thấy đứa cuối cùng rồi!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE"
msgid "Now where's that last one hiding?"
msgstr "Giờ thì đứa cuối cùng trốn ở đâu nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME"
msgid "I guess they don't want to play any more..."
msgstr "Chắc tụi nó không muốn chơi nữa rồi..."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP"
msgid "These little guys must be getting impatient..."
msgstr "Mấy chú nhóc này sắp mất kiên nhẫn rồi đây..."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR"
msgid "They probably wouldn't hide this far away, would they?"
msgstr "Chắc tụi nó không trốn xa đến thế này đâu, phải không nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN"
msgid "The kitcoons should be nearby."
msgstr "Mấy bé mèo gấu chắc ở quanh đây thôi."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN"
msgid "Aww, they're playing hide and seek."
msgstr "Ôi trời, tụi nó đang chơi trốn tìm kìa."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDEANDSEEK_START
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KITCOON_HIDEANDSEEK_START"
msgid "3, 2, 1... Ready or not, here I come!"
msgstr "3, 2, 1... Trốn hay không trốn, tôi đến đây!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "It called for help!"
msgstr "Nó gọi cứu trợ kìa!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KLAUS_ENRAGE"
msgid "There's no way to beat it now!!"
msgstr "Giờ thì không có cách nào đánh bại nó nữa rồi!!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KLAUS_UNCHAINED"
msgid "Its chains came off!"
msgstr "Xích của nó đứt rồi kìa!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KNOCKEDOUT"
