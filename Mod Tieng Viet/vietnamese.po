msgstr "Tiến lên, hướng tới những chân trời mới!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POCKETWATCH_PORTAL_EXIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POCKETWATCH_PORTAL_EXIT"
msgid "It's a long drop down."
msgstr "Rơi xuống dưới sâu lắm đấy."

