msgstr "Chúng ta không thể leo ra ngoài? Được rồi!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC"
