msgstr "Tôi nghĩ chúng ta đã chặn đầu được con sinh vật này rồi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_WRONG_FORK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_WRONG_FORK"
msgid "I'm gettin' the heebie-jeebies. Somethin's watchin' me."
msgstr "Tôi bắt đầu nổi da gà rồi đấy. Có gì đó đang theo dõi mình."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "It demands poop!"
msgstr "Nó đòi phân kìa!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_INV_FULL"
msgid "I only got two hands."
msgstr "Tôi chỉ có hai tay thôi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_IS_FEASTING"
msgid "What a spread!"
msgstr "Đúng là một bữa thịnh soạn!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD"
msgid "Well look what we've got here!"
msgstr "Ồ xem chúng ta tìm được gì này!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "Gotcha!"
msgstr "Tóm được rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "Found you!"
msgstr "Tìm thấy cậu rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
msgid "There's one!"
msgstr "Kia rồi một con!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
msgid "I see you!"
msgstr "Thấy cậu rồi nhé!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE"
msgid "Woo-hoo! That's all of em'!"
msgstr "U-hu! Tụi nó đây hết rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM"
msgid "Good eye, {name}!"
msgstr "Mắt tinh đấy, {name}!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE"
msgid "Just one more left!"
msgstr "Chỉ còn đúng một con nữa thôi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME"
msgid "Drat, you kits are just too good at hiding."
msgstr "Khỉ thật, mấy con chồn trốn giỏi thật đấy."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP"
msgid "We're almost out of time!"
msgstr "Sắp hết giờ rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR"
msgid "Would they be hiding this far out?"
msgstr "Liệu chúng có trốn xa thế này không nhỉ?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN"
msgid "They're probably around here somewhere."
msgstr "Chắc tụi nó loanh quanh đâu đây thôi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN"
msgid "Need another set of eyes?"
msgstr "Cần thêm người phụ một tay không?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDEANDSEEK_START
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDEANDSEEK_START"
msgid "Ready or not, here I come!"
msgstr "Sẵn sàng hay chưa, tôi tới đây!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "He called his goons!"
msgstr "Hắn gọi đàn em tới kìa!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_KLAUS_ENRAGE"
msgid "HOLY RIVETS! Time to make tracks!"
msgstr "LẠY ÔNG TÔI Ở BỤI NÀY! Chuồn lẹ thôi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_KLAUS_UNCHAINED"
msgid "The mitts are coming off!"
msgstr "Không nhịn được nữa rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_KNOCKEDOUT"
msgid "Yeowch! Hello workman's comp!"
msgstr "Ái chà! Chào tiền bồi thường tai nạn nhé!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "Ha! Now you gotta kiss me!"
msgstr "Hà! Giờ thì anh phải hôn em đấy!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_LIGHTSOUT_SHADOWHAND
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_LIGHTSOUT_SHADOWHAND"
msgid "Hey, quit it! You ain't even supposed to be down here!"
msgstr "Này, thôi đi! Mấy người có được phép xuống đây đâu!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_LOWRESEARCH"
msgid "I'll take what I can get."
msgstr "Có gì ăn nấy vậy."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_LUNARGUARDIAN_INCOMING
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_LUNARGUARDIAN_INCOMING"
msgid "Again!?"
msgstr "Lại nữa á!?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_LUNARHAIL_BIRD_CORPSES
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_LUNARHAIL_BIRD_CORPSES"
msgid "Yikes. Poor lil' fella."
msgstr "Úi chà. Tội nghiệp chú chim nhỏ."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS"
msgid "They're gettin' torn to pieces up there!"
msgstr "Chúng đang bị xé xác ở trên đó kìa!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_LUNAR_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_LUNAR_RIFT_MAX"
msgid "I should check out that weird glow."
msgstr "Tôi nên qua xem cái ánh sáng kỳ lạ đó là gì."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Darnit! A pair only? I hate chess."
msgstr "Chết tiệt! Chỉ có một đôi thôi à? Tôi ghét cờ vua."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_MEGA_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MEGA_FLARE_SEEN"
msgid "Looks like someone's fixin' for a fight."
msgstr "Có vẻ như ai đó đang chuẩn bị gây sự kìa."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_MITEGLAND_DEBUFF.1
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MITEGLAND_DEBUFF.1"
msgid "There's a fire in my belly, but not the good kind."
msgstr "Bụng tôi đang bốc Lửa, nhưng không phải kiểu tốt đẹp gì đâu."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_MITEGLAND_DEBUFF.2
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MITEGLAND_DEBUFF.2"
msgid "Yeesh, I'm burnin' up!"
msgstr "Trời ạ, tôi sắp bốc cháy rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_MITEGLAND_DEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MITEGLAND_DEBUFF_DONE"
msgid "I think I'll take a break from eatin' weird bug guts for a while."
msgstr "Chắc tôi sẽ tạm nghỉ ăn nội tạng bọ kỳ lạ một thời gian."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_MONKEY_CURSE_1
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MONKEY_CURSE_1"
msgid "Uuurgh, I don't feel so good..."
msgstr "Ư-ư-rgh, tôi thấy trong người không ổn lắm..."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_MONKEY_CURSE_CHANGE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MONKEY_CURSE_CHANGE"
msgid "I guess now I'm a real grease monkey. Ha..."
msgstr "Chắc giờ tôi là một thợ máy chính hiệu rồi. Ha..."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_MONKEY_CURSE_CHANGEBACK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MONKEY_CURSE_CHANGEBACK"
msgid "That was more than enough monkeying around for me."
msgstr "Trò khỉ đó với tôi thế là quá đủ rồi đấy."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW"
msgid "Nearly through!"
msgstr "Sắp xong rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "Hang on, I'll getcha outta there!"
msgstr "Đợi đã, tôi kéo cậu ra ngay đây!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "Ha! Gotcha!"
msgstr "Ha! Tóm được rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "Nearly through!"
msgstr "Sắp xong rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "Hang on, I'll getcha outta there!"
msgstr "Đợi đã, tôi kéo cậu ra ngay đây!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "Ha! Gotcha!"
msgstr "Ha! Tóm được rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "Nearly through!"
msgstr "Sắp xong rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "Hang on, I'll getcha outta there!"
msgstr "Đợi đã, tôi kéo cậu ra ngay đây!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "Ha! Gotcha!"
msgstr "Ha! Tóm được rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOONPOTION_FAILED"
msgid "Back to the drawing board."
msgstr "Làm lại từ đầu nào."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOSQUITOS"
msgid "Gah! I hate bugs!"
msgstr "Hừ! Tôi ghét lũ côn trùng!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "You're not looking too good, big guy."
msgstr "Trông cậu không khỏe lắm đâu, anh bạn lớn ạ."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL"
msgid "Dang buzzards! Hm, they look kinda off."
msgstr "Lũ kền kền chết tiệt! Ứm, trông chúng hơi lạ đấy."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NODANGERGIFT"
msgid "Not a keen idea right now!"
msgstr "Lúc này mà làm thế thì không ổn đâu!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NODANGERSIESTA"
msgid "But I'm in danger!"
msgstr "Nhưng tôi đang gặp nguy hiểm mà!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NODANGERSLEEP"
msgid "It ain't safe."
msgstr "Không Két Sắt được đâu."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NODAYSLEEP"
msgid "Can't sleep now, there's work to do!"
msgstr "Giờ không ngủ được đâu, còn việc phải làm cơ mà!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "No way I'm falling asleep here."
msgstr "Đời nào tôi thèm lăn ra ngủ ở đây chứ."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOHUNGERSIESTA"
msgid "I'd rather whip up some grub."
msgstr "Tôi thà đi bắt Con Sâu còn hơn."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOHUNGERSLEEP"
msgid "Not without supper first."
msgstr "Không ăn tối trước thì đừng hòng ngủ."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I can't open anything up here."
msgstr "Tôi không mở món quà nào ở đây được đâu."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NONIGHTSIESTA"
msgid "I'd rather sleep than nap."
msgstr "Tôi thà ngủ thật sự còn hơn là chợp mắt."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "Sleeping down here ain't a bright idea."
msgstr "Ngủ dưới này không phải là ý hay đâu."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOPUMPKINCARVINGONFIRE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOPUMPKINCARVINGONFIRE"
msgid "You're supposed to light it after it's been carved."
msgstr "Cậu phải khắc bí ngô xong rồi mới châm lửa chứ."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT"
msgid "Hey WX, mind turning the light down?"
msgstr "Này WX, bớt cái đèn lại được không?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOSLEEPONFIRE"
msgid "That's NOT fine."
msgstr "Thế này là KHÔNG ổn chút nào."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOWARDROBEONFIRE"
msgid "Uh. It's on fire."
msgstr "Ơ. Có Lửa kìa."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NO_ABIGAIL_FLOWER
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NO_ABIGAIL_FLOWER"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NO_TRAP"
msgid "That was a cinch."
msgstr "Chuyện đó dễ như ăn kẹo ấy mà."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "Practice makes perfect!"
msgstr "Cần cù bù thông minh!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "Guess I've got to brush up on my technique."
msgstr "Chắc tôi phải Chải chuốt lại kỹ thuật của mình thôi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "I'm not a fan of just sittin' around..."
msgstr "Tôi không phải Cái quạt của việc ngồi không đâu..."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "Maybe I could invent something quicker."
msgstr "Biết đâu tôi chế ra cái gì nhanh hơn được ấy chứ."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "Come on fish, let's get a move on!"
msgstr "Nào cá ơi, hãy mau ra đây Câu Cá nào!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "I'm starting to feel a bit antsy."
msgstr "Tôi bắt đầu thấy bồn chồn rồi đấy."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "You rascal!"
msgstr "Quân ranh mãnh này!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "I ain't no slacker! Time to reel 'er in!"
msgstr "Tôi không phải kẻ lười biếng! Đến lúc cuộn dây lại rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "Woah, that's a bigg'un!"
msgstr "Ồ, con hàng khủng đây rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_OFF_SCRIPT
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_OFF_SCRIPT"
msgid "That didn't seem right."
msgstr "Có gì đó sai sai thì phải."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_OTTERBOAT_DENBROKEN
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_OTTERBOAT_DENBROKEN"
msgid "Looks like the den was the main structural support..."
msgstr "Có vẻ cái tổ chính là phần chịu lực chính..."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS"
msgid "This rickety thing wasn't built for deep water!"
msgstr "Cái thứ lỏng lẻo này đâu có sinh ra để đi vùng nước sâu!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_PECKED"
msgid "Yeow! Lay off!"
msgstr "Ái chà! Tránh ra xem nào!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_PETRIFED_TREES"
msgid "Do these trees seem shadier?"
msgstr "Mấy cái cây này trông có vẻ mờ ám thế nhỉ?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "Whew! If that isn't the mightiest smell."
msgstr "Phù! Mùi gì mà nặng thế không biết."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_PIRATES_ARRIVE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_PIRATES_ARRIVE"
msgid "Sounds like someone's about to throw a monkey wrench in the works..."
msgstr "Nghe như có kẻ chuẩn bị chơi khăm công việc của chúng ta đây..."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_PLANT_RANDOMSEED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_PLANT_RANDOMSEED"
msgid "We'll see what happens!"
msgstr "Để xem chuyện gì sẽ xảy ra nào!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_PLANT_RESEARCHED.1
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_PLANT_RESEARCHED.1"
msgid "That's some real practical gardening know-how!"
msgstr "Đúng là kinh nghiệm làm vườn thực tế đấy!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_POCKETWATCH_PORTAL
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_POCKETWATCH_PORTAL"
msgid "Yeesh, that was a bumpy ride..."
msgstr "Trời ạ, chuyến đi vừa rồi xóc thật đấy..."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_PREFALLINVOID
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_PREFALLINVOID"
msgid "Best hustle!"
msgstr "Lo mà chuồn lẹ đi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_QUAKE"
msgid "Earthquake!"
msgstr "Động đất rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT"
msgid "Nope, ain't the right spot."
msgstr "Không, chỗ này không đúng rồi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_RABBITKING_AGGRESSIVE"
msgid "What's with all that scratchin'?"
msgstr "Tiếng sột soạt gì thế nhỉ?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_RABBITKING_LUCKY"
msgid "There is somethin' about that rabbit!"
msgstr "Con Thỏ đó có gì đó rất đặc biệt!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_RABBITKING_LUCKYCAUGHT
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_RABBITKING_LUCKYCAUGHT"
msgid "Gotcha, rabbit!"
msgstr "Tóm được ngươi rồi, Thỏ nhé!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_RABBITKING_PASSIVE"
msgid "I hear a critter comin'."
msgstr "Tôi nghe thấy tiếng sinh vật gì đang tới."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_REPELLED"
msgid "It's protected!"
msgstr "Nó được bảo vệ rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_RESEARCH"
msgid "I can build even MORE things!"
msgstr "Tôi có thể chế tạo NHIỀU thứ hơn nữa!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "I'm back on the clock!"
msgstr "Tôi quay lại ca trực rồi đây!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "Back to work!"
msgstr "Quay lại làm việc thôi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_REVIVING_CORPSE"
msgid "Up'n'attem now."
msgstr "Dậy thôi nào bạn tôi ơi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ROSEGLASSES.1
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ROSEGLASSES.1"
msgid "Gotcha, sis!"
msgstr "Tóm được em nhé, em gái!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ROSEGLASSES.2
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ROSEGLASSES.2"
msgid "Charlie was here."
msgstr "Charlie đã ở đây."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ROSEGLASSES.3
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ROSEGLASSES.3"
msgid "I'm pickin' up traces of her magic."
msgstr "Tôi đang bắt được dấu vết ma thuật của nhỏ."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ROYALTY.1
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ROYALTY.1"
msgid "Your Royal Highness!"
msgstr "Điện hạ Hoàng gia!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ROYALTY.2
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ROYALTY.2"
msgid "You wear it well!"
msgstr "Cậu mặc hợp đấy chứ!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ROYALTY.3
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ROYALTY.3"
msgid "I like the confidence!"
msgstr "Tôi thích sự tự tin này!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ROYALTY_JOKER.1
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ROYALTY_JOKER.1"
msgid "A royal idiot! Just jokin', love."
msgstr "Một kẻ ngốc hoàng gia! Đùa thôi mà, cưng ơi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ROYALTY_JOKER.2
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ROYALTY_JOKER.2"
msgid "You wear it too well!"
msgstr "Cậu mặc hợp quá đấy mất!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ROYALTY_JOKER.3
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ROYALTY_JOKER.3"
msgid "I love the confidence!"
msgstr "Tôi rất thích sự tự tin này!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_RUINS_RESET"
msgid "Huh? Where'd all these monsters come from?"
msgstr "Hả? Lũ quái vật này ở đâu chui ra thế?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_SACREDCHEST_NO"
msgid "Guess I didn't make the cut."
msgstr "Chắc tôi không đủ tiêu chuẩn rồi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_SACREDCHEST_YES"
msgid "Huh. Guess I'm worthy."
msgstr "Hừ. Chắc tôi xứng đáng đấy chứ."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_SCRAPBOOK_FULL
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_SCRAPBOOK_FULL"
msgid "I can't squeeze any more pages in my scrapbook."
msgstr "Tôi không thể nhét thêm trang nào vào sổ tay lưu niệm được nữa rồi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_SECURITY_PULSE_FOLLOWING
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_SECURITY_PULSE_FOLLOWING"
msgid "Hey there, little tagalong!"
msgstr "Chào cậu bé bám đuôi nhé!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_SHADOWTHRALL_STEALTH
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_SHADOWTHRALL_STEALTH"
msgid "Ow! Quit skulkin' and fight me fair!"
msgstr "Ái! Đừng có lén lút mà ra đấu tay đôi với tôi xem nào!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_SHADOW_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_SHADOW_RIFT_MAX"
msgid "I've got a bad feelin'..."
msgstr "Tôi có linh cảm không lành rồi..."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_SHELTER"
msgid "Ah, that's better."
msgstr "À, đỡ hơn rồi đây."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_SISTURN_FULL_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_SISTURN_FULL_BLOSSOM"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_SISTURN_FULL_EVIL
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_SISTURN_FULL_EVIL"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_SNARED"
msgid "Hey!"
msgstr "Này!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_SNARED_IVY
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_SNARED_IVY"
msgid "Knock it off, will ya?"
msgstr "Thôi ngay cái trò đó đi, được chứ?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_SNOWBALL_NO_SNOW
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_SNOWBALL_NO_SNOW"
msgid "Ain't no snow around."
msgstr "Xung quanh chẳng có tí tuyết nào cả."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_SNOWBALL_TOO_BIG
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_SNOWBALL_TOO_BIG"
msgid "It ain't gonna get any bigger."
msgstr "Nó không to lên được nữa đâu."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_SOAKED"
msgid "I'm DRENCHED!"
msgstr "Tôi ướt SỦNG rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_SPOOKED"
msgid "Oof! Gross!"
msgstr "Ối! Kinh quá!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_TALK_TO_PLANTS.1
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_TALK_TO_PLANTS.1"
msgid "Hey there, plants! Workin' hard?"
msgstr "Chào mấy cây nhé! Làm việc chăm chỉ vào chứ?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_TALK_TO_PLANTS.2
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_TALK_TO_PLANTS.2"
msgid "Now you better grow fast, you hear? I don't wanna catch you slacking!"
msgstr "Giờ thì lớn nhanh lên đấy, nghe chưa? Tôi không muốn thấy mấy cậu lười biếng đâu!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_TALK_TO_PLANTS.3
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_TALK_TO_PLANTS.3"
msgid "I want to see you do your best! Now hustle!"
msgstr "Tôi muốn thấy các cậu cố gắng hết sức! Mau lên nào!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_TALK_TO_PLANTS.4
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_TALK_TO_PLANTS.4"
msgid "I'm here to motivate ya! Feeling motivated yet?"
msgstr "Tôi đến đây để tiếp thêm động lực cho các cậu đấy! Thấy có động lực hơn chưa nào?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "I'm not usually one to stand around chin-wagging, but if it helps ya grow faster..."
msgstr "Tôi không hay đứng lê la tán gẫu đâu, nhưng nếu nó giúp các cậu lớn nhanh hơn..."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_THORNS"
msgid "Yeow! That smarts!"
msgstr "Ái chà! Đau điếng người!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_THURIBLE_OUT"
msgid "Ran outta juice."
msgstr "Hết nhiên liệu mất tiêu rồi."

