#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT_COOKED"
msgid "Using fire on it made it a tastier eggplant."
msgstr "Dùng lửa vào nó làm cho nó một cà tím ngon hơn."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT_OVERSIZED"
