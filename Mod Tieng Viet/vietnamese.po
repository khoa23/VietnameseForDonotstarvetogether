msgstr "Mày chạy trốn Wolfgang dũng mãnh à?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUM.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUM.COOLDOWN"
