msgstr "Chiếc rương này được bảo vệ bởi hình dáng của một sinh vật biển đáng sợ."

#. STRINGS.SKIN_DESCRIPTIONS.dragonflyfurnace_adventure
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dragonflyfurnace_adventure"
msgid "Despite the heat it provides, you can't help but feel a chill run down your spine."
msgstr "Mặc dù nó mang lại cảm giác ấm áp, nhưng bạn không thể không cảm thấy một cơn lạnh chạy dọc sống lưng."

#. STRINGS.SKIN_DESCRIPTIONS.dragonflyfurnace_antique
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dragonflyfurnace_antique"
msgid "A gilded antique furnace that evokes the image of a fallen foe."
msgstr "Một lò cổ mạ vàng gợi lên hình ảnh của một kẻ thù đã ngã xuống."

#. STRINGS.SKIN_DESCRIPTIONS.dragonflyfurnace_crystal
msgctxt "STRINGS.SKIN_DESCRIPTIONS.dragonflyfurnace_crystal"
msgid "Fine jewels won't keep you warm, but this fine jeweled furnace will!"
msgstr "Đồ trang sức tốt sẽ không giữ ấm cho bạn, nhưng lò nung tốt mịn này sẽ!"

#. STRINGS.SKIN_DESCRIPTIONS.dragonling_bat
