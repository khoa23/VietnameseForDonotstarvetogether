msgstr "Cái cảnh thụt thò này làm ta mất tập trung quá đi mất!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_GOLFPROP_SPINNER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_GOLFPROP_SPINNER"
