msgstr "Trông giống cái rương bình thường mà không có mấy đốm sáng."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUMCHEST.SHIMMER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUMCHEST.SHIMMER"
