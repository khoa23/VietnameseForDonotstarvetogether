msgstr "Bò lông tơ nhí!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BABYBEEFALO.SLEEPING"
