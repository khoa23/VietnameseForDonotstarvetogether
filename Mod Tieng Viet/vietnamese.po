msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCORPSE.BURNING"
msgid "Burn, birdie, burn."
msgstr "Đốt cháy, ghi chim, đốt cháy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCORPSE.GENERIC"
msgid "Shall I do the honors?"
msgstr "Tôi có nên làm vinh dự không?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCORPSE.REVIVING"
msgid "Do I even have to say it?"
msgstr "Tôi thậm chí có phải nói điều đó không?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDTRAP"
msgid "Gonna catch those creepy birds."
msgstr "Sẽ bắt được những con chim đáng sợ đó."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRD_EGG"
msgid "It smells like a bird's butt."
msgstr "Nó có mùi giống như mông của một con chim."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRD_EGG_COOKED"
msgid "Yuck. The yellow part is all runny."
msgstr "Kinh quá. Phần màu vàng là tất cả chảy nước mũi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRD_MUTANT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRD_MUTANT"
msgid "It looks like it wants to take a bite out of me."
msgstr "Có vẻ như nó muốn cắn tôi một miếng."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRD_MUTANT_SPITTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRD_MUTANT_SPITTER"
msgid "Oh yeah?! Two can play at that game... PTOOEY!"
msgstr "Ồ vâng?! Hai người có thể chơi trò đó... PTOOEY!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BISHOP"
msgid "It's a bishop!"
msgstr "Đó là một giám mục!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Owwww!"
msgstr "Ôi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BISHOP_NIGHTMARE"
msgid "Ahhh!"
msgstr "Ahhh!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLACKFLAG"
msgid "Looks like it's already charred."
msgstr "Có vẻ như nó đã cháy thành than rồi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_FIRE"
msgid "That's my favorite thing in the whole wide world."
msgstr "Đó là điều tôi yêu thích nhất trên toàn thế giới."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_LAVA"
msgid "Ptoo! Now you're dead!"
msgstr "Ptoo! Bây giờ bạn đã chết!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_LAVA2"
msgid "Ooh, the firepower!"
msgstr "Ôi, hỏa lực!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_PIPE"
msgid "Good practice for blowing into a fire."
msgstr "Thói quen tốt cho thổi vào ngọn lửa."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_SLEEP"
msgid "Tranquilized things are easier to light on fire."
msgstr "Những thứ yên tĩnh sẽ dễ dàng bắt lửa hơn."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_YELLOW"
msgid "Lightning is sort of like fire."
msgstr "Sét có tính chất giống như lửa."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEAMULET"
msgid "Boo to this."
msgstr "Boo này."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEGEM"
msgid "Ugh. This one is ugly."
msgstr "Ugh. Điều này là xấu xí."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEMOONEYE"
msgid "That's not an eyeball! It's a rock!"
msgstr "Đó không phải là nhãn cầu! Đó là một tảng đá!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEPRINT.COMMON"
msgid "This will save some experimentation."
msgstr "Điều này sẽ tiết kiệm được một số thử nghiệm."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEPRINT.RARE"
msgid "Woah. It doesn't burn!!"
msgstr "Ôi. Nó không cháy!!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_CAP"
msgid "It smells like a gym sock!"
msgstr "Nó có mùi giống như một chiếc vớ phòng tập thể dục!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_CAP_COOKED"
msgid "Transformed by fire!"
msgstr "Biến đổi bởi lửa!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "Dumb mushroom."
msgstr "Nấm ngu ngốc."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "Hey! You! Get up here!"
msgstr "Chào! Bạn! Lên đây!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Maybe it will return some day."
msgstr "Có lẽ nó sẽ trở lại một ngày."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOARDS"
msgid "Boards. They'll burn, same as other wood."
msgstr "Ván Ép. Họ sẽ đốt cháy, giống như gỗ khác."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOARON"
msgid "Keep that snout to yourself!"
msgstr "Hãy giữ cái mõm đó cho riêng mình!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOARRIOR"
msgid "He looks pretty haggard."
msgstr "Anh ấy trông khá hốc hác."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATFRAGMENT03"
msgid "Welp, there goes that."
msgstr "Welp, thế là xong."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATFRAGMENT04"
msgid "Welp, there goes that."
msgstr "Welp, thế là xong."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATFRAGMENT05"
msgid "Welp, there goes that."
msgstr "Welp, thế là xong."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATPATCH"
msgid "Fixing stuff is boring, but necessary."
msgstr "Sửa chữa mọi thứ thật nhàm chán, nhưng cần thiết."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATPATCH_KELP"
msgid "At least it'll keep the water out for a bit."
msgstr "Ít nhất nó sẽ giữ nước ra ngoài một chút."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "Yup. That's a checkpoint."
msgstr "Vâng đúng rồi đấy, nó là một điểm checkpoint."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "Does this thing even float?"
msgstr "Liệu thứ này có nổi không?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "That thing better not cheat."
msgstr "Điều đó tốt hơn là không gian lận."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_SEASTACK"
msgid "Don't you dare hit my boat!"
msgstr "Mày dám chạm vào thuyền tao không!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Don't you dare hit my boat!"
msgstr "Mày dám chạm vào thuyền tao không!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "Maybe I could have some fun with this..."
msgstr "Có vẻ thứ này có thể mang lại một chút niềm vui cho tôi..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "Maybe I could have some fun with this..."
msgstr "Có vẻ thứ này có thể mang lại một chút niềm vui cho tôi..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "Alright little guy, ready to watch me win?"
msgstr "Thôi được rồi cô cậu bé nhỏ, chuẩn bị ngắm nhìn tôi thắng chưa?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_START"
msgid "Let's just get this over with."
msgstr "Hãy kết thúc chuyện này thôi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "Does it HAVE to go in the water?"
msgstr "Nó PHẢI đi xuống nươc phải không chứ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "I hope all my stuff stays dry in there."
msgstr "Tôi hy vọng tất cả đồ của tôi sẽ khô ráo trong đó."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "Ew, it smells old!"
msgstr "Eo, nó có mùi cũ!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_CRABKING"
msgid "Sturdy. Let's ram something."
msgstr "Vững chắc. Hãy đâm vào cái gì đó."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_CRABKING_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_CRABKING_KIT"
msgid "I guess building some bumpers is better than sinking."
msgstr "Tôi đoán việc xây dựng một số tấm cản vẫn tốt hơn là đánh chìm."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_KELP"
msgid "Ewww, it's slimy!"
msgstr "Ewww, nó nhầy nhụa quá!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "I guess building some bumpers is better than sinking."
msgstr "Tôi đoán việc xây dựng một số tấm cản vẫn tốt hơn là đánh chìm."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "Uh-huh, nothing sturdier than seashells."
msgstr "Uh-huh, không có gì chắc chắn hơn vỏ sò."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "I guess building some bumpers is better than sinking."
msgstr "Tôi đoán việc xây dựng một số tấm cản vẫn tốt hơn là đánh chìm."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "Alright, a boat with teeth is kinda cool."
msgstr "Ngon, một cái thuyền đầy răng trông cũng ngầu đêý."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "I guess building some bumpers is better than sinking."
msgstr "Tôi đoán việc xây dựng một số tấm cản vẫn tốt hơn là đánh chìm."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "The only fun part of sailing is getting to fire the cannon."
msgstr "Phần thú vị duy nhất của việc chèo thuyền là bắn đại bác."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "It isn't loaded? Booooring."
msgstr "Nó không được tải? Tiếng la ó."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "Darn it, I'm out... hey Wes, you always wanted to try being a human cannonball right?"
msgstr "Chết tiệt, tôi không đồng ý... này Wes, bạn luôn muốn thử trở thành một viên đạn đại bác đúng không?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_CANNON_KIT"
msgid "If I build it, I get to fire it."
msgstr "Nếu tôi xây dựng nó, tôi có thể bắn nó."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_GRASS_ITEM"
msgid "But it won't be as flammable if I put it in the water!"
msgstr "Nhưng nó sẽ không dễ cháy nếu tôi cho nó vào nước!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_ITEM"
msgid "That's the boat part of the boat."
msgstr "Đó là phần thuyền của con thuyền."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_LEAK"
msgid "I only know how to solve fire-based problems."
msgstr "Tôi chỉ biết cách giải quyết các vấn đề liên quan đến lửa."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "Okay fiiiiine, I guess it works alright."
msgstr "Được rồi fiiiiine, tôi đoán nó hoạt động ổn."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "Great, now I've got a big dumb magnet."
msgstr "Tuyệt vời, bây giờ tôi đã có một nam châm to lớn."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "I guess that means it's working."
msgstr "Tôi đoán điều đó có nghĩa là nó đang hoạt động."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "Great, now I've got a little dumb magnet."
msgstr "Tuyệt, giờ tôi đã có một cục nam châm nhỏ."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_MAGNET_KIT"
msgid "Wilson! How am I supposed to put all this junk together?!"
msgstr "Wilson! Làm thế nào tôi có thể đặt tất cả những thứ rác rưởi này lại với nhau?!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_ROTATOR"
msgid "Hehehe, let's see how fast we can spin without getting sick!"
msgstr "Hehehe, hãy xem chúng ta có thể quay nhanh đến mức nào mà không bị ốm nhé!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "Fiiiine, I'll put the stupid rudder on the stupid boat."
msgstr "Fiiiine, tôi sẽ đặt cái bánh lái ngu ngốc lên con thuyền ngu ngốc."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "Bernie's cuddlier than a hairy old pillow."
msgstr "Bernie dễ thương hơn một chiếc gối cũ đầy lông."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BODYPILLOW_KELP"
msgid "Ew, this pillow's full of wet junk!"
msgstr "Ôi, cái gối này đầy rác ướt!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BODYPILLOW_PETALS"
msgid "I guess that's one use for flowers."
msgstr "Tôi đoán đó là một cách sử dụng hoa."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "Pretty sure this is the worst pillow ever."
msgstr "Khá chắc chắn đây là chiếc gối tồi tệ nhất từ trước đến nay."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOMB_LUNARPLANT"
msgid "Heh. Think fast!"
msgstr "Hừ. Nghĩ nhanh!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "Wormwood must've been messing around with that one."
msgstr "Wormwood chắc hẳn đang loay hoay với cái đó."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BONESHARD"
msgid "I don't think they make good tinder."
msgstr "Tôi không nghĩ rằng họ làm cháy khô tốt."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BONESOUP"
msgid "I would practically INHALE that!"
msgstr "Tôi thực tế sẽ HÍT vào điều đó!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BONESTEW"
msgid "Just add fire to food and voila!"
msgstr "Chỉ cần thêm lửa để thức ăn và thì đấy!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOKSTATION.BURNT"
msgid "What's burned is burned, no point thinking about it too much, right?"
msgstr "Đốt cháy thì đốt, nghĩ nhiều về nó cũng chẳng ích gì phải không?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOKSTATION.GENERIC"
msgid "Hey, uh... what library did Ms. Wickerbottom work at, anyway?"
msgstr "Này, ừ... mà cô Wickerbottom làm việc ở thư viện nào vậy?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_BEES"
msgid "\"Rule one: don't set beehives on fire\"? This book's stupid!"
msgstr "\"Quy tắc thứ nhất: không được đốt tổ ong\"? Cuốn sách này thật ngu ngốc!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_BIRDS"
msgid "Less reading, more burning!"
msgstr "Đọc ít hơn, cháy nhiều hơn!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_BRIMSTONE"
msgid "That's my favorite book!"
msgstr "Đó là cuốn sách yêu thích của tôi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_ELEMENTAL"
msgid "Looks interesting, for a book."
msgstr "Có vẻ thú vị, đối với một cuốn sách."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_FIRE"
msgid "You see something, you set it on fire. I don't need a book to teach me that!"
msgstr "Bạn nhìn thấy một cái gì đó, bạn đốt nó. Tôi không cần một cuốn sách để dạy tôi điều đó!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_FISH"
msgid "The only thing more boring than fishing is reading about fishing."
msgstr "Điều duy nhất nhàm chán hơn câu cá là đọc về câu cá."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_FOSSIL"
msgid "Looks like kindling to me."
msgstr "Có vẻ như đang nhen nhóm với tôi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_GARDENING"
msgid "Ughh, who cares?"
msgstr "Ugh, ai quan tâm chứ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_HORTICULTURE"
msgid "Ughh, who cares?"
msgstr "Ugh, ai quan tâm chứ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "Nice and thick, that should burn for a good while."
msgstr "Đẹp và dày, sẽ cháy lâu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_LIGHT"
msgid "Wow, another book I'll never read!"
msgstr "Wow, lại một cuốn sách nữa mà tôi chưa bao giờ đọc!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "Stop trying to get me to read!"
msgstr "Đừng cố bắt tôi đọc nữa!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_MOON"
msgid "Another dumb book about whatever."
msgstr "Một cuốn sách ngu ngốc khác về bất cứ điều gì."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_RAIN"
msgid "Ugh, I hate rain!"
msgstr "Ờ, tôi ghét mưa!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "How would everything even fit in there?"
msgstr "Làm thế nào mọi thứ có thể vừa vặn ở đó?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_SILVICULTURE"
msgid "Hey, it's a book about kindling!"
msgstr "Này, đó là một cuốn sách về việc nhóm lửa!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_SLEEP"
msgid "Bo-oring!"
msgstr "Bo-oring!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_TEMPERATURE"
msgid "Yaaaawwwn."
msgstr "Yaawww."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_TENTACLES"
msgid "Looks like kindling to me!"
msgstr "Có vẻ như đang nhen nhóm với tôi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_WEB"
msgid "Ew, who wants to read a book about spiders?"
msgstr "Ôi, ai muốn đọc sách về nhện nào?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOMERANG"
msgid "It's not the most exciting weapon."
msgstr "Đây không phải là vũ khí thú vị nhất."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOTLEG"
msgid "Ugh, it smells like old feet!"
msgstr "Ugh, nó có mùi như bàn chân cũ!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BROKEN_FORGEDITEM"
msgid "Welp, looks like it's busted."
msgstr "Welp, có vẻ như nó hỏng rồi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BROKEN_FUMAROLETOOLITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BROKEN_FUMAROLETOOLITEM"
msgid "Some fire should fix it. Fire fixes everything!"
msgstr "Một số lửa sẽ khắc phục nó. Lửa sửa chữa mọi thứ!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BRUSH"
msgid "It smells like burnt hair."
msgstr "Nó có mùi như tóc cháy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUGNET"
msgid "Doesn't fit over Webber's big head."
msgstr "Không vừa với cái đầu to của Webber."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "I bet we could eat that."
msgstr "Tôi cá là chúng ta có thể ăn món đó."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "Nothing left to take."
msgstr "Không còn gì để lấy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BULLKELP_ROOT"
msgid "Haha! This thing's great."
msgstr "Haha! Điều này thật tuyệt vời."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUNDLE"
msgid "Now I can burn a bunch of things in one go!"
msgstr "Bây giờ tôi có thể đốt nhiều thứ trong một lần!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUNDLEWRAP"
msgid "We could hide some gross things, I guess."
msgstr "Tôi đoán là chúng ta có thể che giấu một số điều thô thiển."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUNNYMAN"
msgid "Ugh. They look so stupid."
msgstr "Ugh. Họ trông rất ngu ngốc."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUNNYSTEW"
msgid "It warms from the inside out."
msgstr "Nó ấm áp từ trong ra ngoài."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BURNT_MARSH_BUSH"
msgid "That burned way too quickly."
msgstr "Nó cháy quá nhanh."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUSHHAT"
msgid "Too passive!"
msgstr "Quá thụ động!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTER"
msgid "Tasty, and just a little bit insecty."
msgstr "Ngon và hơi côn trùng một chút."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLY.GENERIC"
msgid "Flutter away, butterfly!"
msgstr "Chập chờn đi, bướm!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLY.HELD"
msgid "I want to squish it."
msgstr "Tôi muốn squish nó."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLYMUFFIN"
msgid "Heehee, look at that butterfly stuck in the muffin."
msgstr "Heehee, nhìn vào đó bướm bị mắc kẹt trong bánh xốp."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLYWINGS"
msgid "No more flying for that butterfly!"
msgstr "Không bay bướm mà!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUZZARD"
msgid "Your neck is gross."
msgstr "Cổ của bạn thật thô thiển."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUZZARDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUZZARDCORPSE.BURNING"
msgid "Burn, buzzard, burn."
msgstr "Đốt, ó, đốt."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUZZARDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUZZARDCORPSE.GENERIC"
msgid "Shall I do the honors?"
msgstr "Tôi có nên làm vinh dự không?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUZZARDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUZZARDCORPSE.REVIVING"
msgid "Do I even have to say it?"
msgstr "Tôi thậm chí có phải nói điều đó không?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CABBAGEROLLS"
msgid "Yeah, I can roll with these."
msgstr "Vâng, tôi có thể lăn lộn với những thứ này."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS.GENERIC"
msgid "Spines! My weakness! How did you know?"
msgstr "Vây! Điểm yếu của tôi! Làm sao bạn biết?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS.PICKED"
msgid "We'll call it a tie."
msgstr "Chúng tôi sẽ gọi nó là một tie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS_FLOWER"
msgid "Yet another flower."
msgstr "Tuy nhiên bông hoa khác."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS_MEAT"
msgid "It still looks dangerous."
msgstr "Nó vẫn có vẻ nguy hiểm."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "It seems fine now."
msgstr "Nó có vẻ tốt đẹp bây giờ."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CALIFORNIAROLL"
msgid "Oh, goody. Fish rolled in seaweed."
msgstr "Ồ, tốt quá. Cá cuộn rong biển."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.EMBERS"
msgid "Uh oh. It's almost gone!"
msgstr "Uh oh. Nó gần như biến mất!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.GENERIC"
msgid "I like fire."
msgstr "Tôi thích lửa."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.HIGH"
msgid "BURN! BURN FASTER!"
msgstr "ĐỐT CHÁY! GHI FASTER!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.LOW"
msgid "This fire is small and boring."
msgstr "Ngọn lửa này nhỏ và nhàm chán."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.NORMAL"
msgid "Burn!"
msgstr "Đốt cháy!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.OUT"
msgid "Awww. It's all over."
msgstr "Awww. Thế là xong."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY.GENERIC"
msgid "If it kicks the bucket I'm outta here."
msgstr "Nếu nó hỏng thì tôi sẽ ra khỏi đây."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY.HELD"
msgid "You still breathing? Just checking."
msgstr "Bạn vẫn còn thở chứ? Chỉ cần kiểm tra."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY_POISONED"
msgid "Is that infectious? We should burn it."
msgstr "Điều đó có lây nhiễm không? Chúng ta nên đốt nó."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANDYBAG"
msgid "I'm gonna stuff so much candy in there!"
msgstr "Tôi sẽ nhét thật nhiều kẹo vào đó!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANE"
msgid "It's way easier to cover ground with this!"
msgstr "Việc tiếp cận mặt đất với điều này dễ dàng hơn nhiều!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANNONBALL_ROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANNONBALL_ROCK_ITEM"
msgid "Okay, but I still think fireballs would be better."
msgstr "Được rồi, nhưng tôi vẫn nghĩ quả cầu lửa sẽ tốt hơn."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALCANNON.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALCANNON.COOLDOWN"
msgid "I only wish it had a more fiery explosion."
msgstr "Tôi chỉ ước nó có một vụ nổ rực lửa hơn."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALCANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALCANNON.GENERIC"
msgid "Let's liven things up a bit!"
msgstr "Hãy làm mọi thứ sôi động lên một chút!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALCANNON_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALCANNON_KIT"
msgid "Hehehe, this will be fun."
msgstr "Hehehe, sẽ vui đây."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_BANNER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_BANNER"
msgid "Oh yeah, that'll catch the firelight nicely!"
msgstr "Ồ vâng, nó sẽ bắt lửa rất tốt!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_BANNER_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_BANNER_KIT"
msgid "Can somebody else put it together for me?"
msgstr "Ai khác có thể ghép nó lại cho tôi được không?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_EGGRIDE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_EGGRIDE"
msgid "Can you imagine how great that would look if it was on fire?"
msgstr "Bạn có thể tưởng tượng nó sẽ tuyệt vời thế nào nếu nó bốc cháy không?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT"
msgid "Can somebody else put it together for me?"
msgstr "Ai khác có thể ghép nó lại cho tôi được không?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC"
msgid "Aww, it's so cute and flammable!"
msgstr "Aww, nó thật dễ thương và dễ cháy!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_FIGURE.RARE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_FIGURE.RARE"
msgid "Wow, a rare one! I bet it'll burn even better!"
msgstr "Wow, một điều hiếm có! Tôi cá là nó sẽ cháy tốt hơn nữa!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON"
msgid "If I gather enough of these I could make a pretty good bonfire."
msgstr "Nếu tôi thu thập đủ những thứ này, tôi có thể tạo ra một đống lửa khá lớn."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_FIGURE_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_FIGURE_KIT"
msgid "Ooooh what's in the box?"
msgstr "Ồ, có gì trong hộp vậy?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2"
msgid "Ooooh what's in the box?"
msgstr "Ồ, có gì trong hộp vậy?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON3
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON3"
msgid "Ooooh what's in the box?"
msgstr "Ồ, có gì trong hộp vậy?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_LAMP"
msgid "It makes light, but no fire. Creepy."
msgstr "Nó tạo ra ánh sáng nhưng không tạo ra lửa. Rùng mình."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_LAMP_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_LAMP_KIT"
msgid "Can somebody else put it together for me?"
msgstr "Ai khác có thể ghép nó lại cho tôi được không?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_PLANT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_PLANT"
msgid "Guess this tree never got its growth spurt."
msgstr "Đoán là cây này không bao giờ có sự phát triển vượt bậc."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_PLANT_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_PLANT_KIT"
msgid "Can somebody else put it together for me?"
msgstr "Ai khác có thể ghép nó lại cho tôi được không?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALFOOD_CORNTEA
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALFOOD_CORNTEA"
msgid "It keeps getting stuck in my teeth."
msgstr "Nó cứ mắc kẹt trong răng tôi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD
