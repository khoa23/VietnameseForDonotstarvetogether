msgstr "Haha! Gã hề tí hon làm cái mũ thỏ ngộ nghĩnh ghê!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BALLOONPARTY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BALLOONPARTY"
