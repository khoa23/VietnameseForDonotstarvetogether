msgctxt "STRINGS.SKIN_DESCRIPTIONS.mastupgradelamp_item_nautical"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.mastupgradelamp_nautical
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mastupgradelamp_nautical"
msgid "The beauty of the sea will guide your way with this iridescent lamp."
msgstr "Vẻ đẹp của đại dương sẽ dẫn lối cho bạn với chiếc đèn lung linh sắc màu này."

#. STRINGS.SKIN_DESCRIPTIONS.meatrack_ancient
msgctxt "STRINGS.SKIN_DESCRIPTIONS.meatrack_ancient"
msgid "Archaeologists speculate that the meat found on this drying rack was way past the expiration date."
msgstr "Các nhà khảo cổ học phỏng đoán rằng miếng thịt tìm thấy trên giá phơi này đã quá hạn sử dụng từ lâu."

#. STRINGS.SKIN_DESCRIPTIONS.meatrack_butcher
msgctxt "STRINGS.SKIN_DESCRIPTIONS.meatrack_butcher"
msgid "A very normal piece of food prep equipment that isn't disconcerting at all."
msgstr "Một thiết bị chuẩn bị thực phẩm vô cùng bình thường và chẳng có gì là đáng lo ngại cả."

#. STRINGS.SKIN_DESCRIPTIONS.meatrack_circus
