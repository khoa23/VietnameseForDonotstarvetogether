#. STRINGS.CHARACTERS.WOLFGANG.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK"
msgid "Where do you hide, strange little man?"
msgstr "Anh trốn ở đâu vậy, ông chú kỳ lạ?"

#. STRINGS.CHARACTERS.WOLFGANG.ACTIONFAIL.YOTB_STARTCONTEST.NORESPONSE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ACTIONFAIL.YOTB_STARTCONTEST.NORESPONSE"
msgid "Maybe he has gone for jogging."
msgstr "Chắc hắn đi chạy bộ rồi."

#. STRINGS.CHARACTERS.WOLFGANG.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE"
msgid "Sorry, Wolfgang not know you busy."
msgstr "Xin lỗi, Wolfgang không biết là bạn đang bận."

#. STRINGS.CHARACTERS.WOLFGANG.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN"
msgid "Ha! Was already there in Wolfgang's big brain!"
msgstr "Hà! Nó đã nằm sẵn trong bộ óc vĩ đại của Wolfgang rồi!"

#. STRINGS.CHARACTERS.WOLFGANG.ACTIONFAIL_GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ACTIONFAIL_GENERIC"
msgid "I am not mighty enough to do that."
msgstr "Tôi không đủ mạnh mẽ để làm việc đó."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ACCOMPLISHMENT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ACCOMPLISHMENT"
msgid "I am doing great things with tiny arrow!"
msgstr "Tôi đang làm nên những điều lớn lao với mũi tên tí hon!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ACCOMPLISHMENT_DONE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ACCOMPLISHMENT_DONE"
msgid "I have defeated the tiny arrow!"
msgstr "Tôi đã đánh bại mũi tên tí hon rồi!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ACIDBATS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ACIDBATS"
msgid "Wolfgang not afraid. You are afraid."
msgstr "Wolfgang không sợ. Mới là đứa sợ."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ADVENTUREFAIL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ADVENTUREFAIL"
msgid "Next time I will be mightier!"
msgstr "Lần sau tôi sẽ còn hùng mạnh hơn!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ANTLION_SINKHOLE.1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ANTLION_SINKHOLE.1"
msgid "Ground is crumble beneath might of Wolfgang!"
msgstr "Mặt đất đang sụp đổ dưới sức mạnh của Wolfgang!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ANTLION_SINKHOLE.2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ANTLION_SINKHOLE.2"
msgid "Wolfgang broke the ground!"
msgstr "Wolfgang đã làm nứt mặt đất rồi!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ANTLION_SINKHOLE.3
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ANTLION_SINKHOLE.3"
msgid "That rumble is not stomach!"
msgstr "Tiếng gầm rú đó không phải do bụng kêu đâu!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ANTLION_TRIBUTE.1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ANTLION_TRIBUTE.1"
msgid "Please do not eat me."
msgstr "Xin đừng ăn tôi."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ANTLION_TRIBUTE.2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ANTLION_TRIBUTE.2"
msgid "Is tribute for a mighty... f-friend."
msgstr "Đây là vật cống nạp cho một... người bạn hùng mạnh."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ANTLION_TRIBUTE.3
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ANTLION_TRIBUTE.3"
msgid "Do not eat Wolfgang's friends, please?"
msgstr "Đừng ăn bạn của Wolfgang, được chứ?"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE"
msgid "Wolfgang's brain full of strange pictures!"
msgstr "Bộ não của Wolfgang ngập tràn những hình ảnh kỳ lạ!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ARCHIVE_NO_POWER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ARCHIVE_NO_POWER"
msgid "Not sure what Wolfgang was expecting."
msgstr "Không chắc Wolfgang đang mong đợi điều gì nữa."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE"
msgid "Wolfgang has seen these brain pictures already."
msgstr "Wolfgang đã thấy mấy bức tranh trong não này rồi."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ATRIUM_DESTABILIZING.1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ATRIUM_DESTABILIZING.1"
msgid "Monsters is coming!"
msgstr "Quái vật đang tới kìa!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ATRIUM_DESTABILIZING.2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ATRIUM_DESTABILIZING.2"
msgid "Wolfgang wants out of cave!"
msgstr "Wolfgang muốn ra khỏi hang!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ATRIUM_DESTABILIZING.3
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ATRIUM_DESTABILIZING.3"
msgid "Wolfgang does not like dark cave."
msgstr "Wolfgang không thích cái hang tối tăm này."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ATTACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ATTACH_BUFF_ATTACK"
msgid "Wolfgang even mightier than was before!"
msgstr "Wolfgang còn hùng mạnh hơn cả trước đây!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK"
msgid "Sparky! I like!"
msgstr "Tia điện kìa! Tôi thích!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY"
msgid "Water will not bother Wolfgang!"
msgstr "Nước sẽ không làm phiền Wolfgang được đâu!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION"
msgid "Ha! Wimpy blows bounce right off Wolfgang!"
msgstr "Hà! Những đòn tấn công yếu ớt đập vào người Wolfgang rồi nảy ra luôn!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE"
msgid "Wolfgang mightier than the sleepytimes!"
msgstr "Wolfgang còn mạnh hơn cả cơn buồn ngủ!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS"
msgid "You watch, let Wolfgang take care of this!"
msgstr "Cứ nhìn đây, để Wolfgang lo vụ này cho!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_BECOMEGHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_BECOMEGHOST"
msgid "oOooOOoo!!"
msgstr "Uuuuoooooo!!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_BEES
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_BEES"
msgid "Bees! Nasty stinging bug men!"
msgstr "Ong! Lũ người bọ chích độc ác!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_BOAT_LEAK"
msgid "Drippy drops is come through boat!"
msgstr "Mấy giọt nước đang rỉ qua thuyền kìa!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_BOAT_SINK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_BOAT_SINK"
msgid "Wolfgang cannot swim!"
msgstr "Wolfgang không biết bơi!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_BOOMERANG"
msgid "Ow! Why did you hurt me, throwy stick?"
msgstr "Ái! Sao mày lại đánh tao, gậy ném ơi?"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_BRAVERY_POTION
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_BRAVERY_POTION"
msgid "Wolfgang is brave! Not scared of spooky tree!"
msgstr "Wolfgang rất dũng cảm! Không sợ cái cây ma quái đâu!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_BURNT"
msgid "Burny is not fair!"
msgstr "Bị cháy thế này là không công bằng!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CALL_BEEF
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CALL_BEEF"
msgid "Come, hair-cow!"
msgstr "Lại đây nào, bò lông!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CANFIX
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CANFIX"
msgid "\nMighty brain could make this better!"
msgstr "Bộ óc hùng mạnh có thể làm cho cái này tốt hơn!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS"
msgid "Is no good, Wolfgang doesn't have enough!"
msgstr "Không ổn rồi, Wolfgang không có đủ nguyên liệu!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CANNOT_BUILD.NO_STATION
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CANNOT_BUILD.NO_STATION"
msgid "Wolfgang will need right working-place!"
msgstr "Wolfgang sẽ cần một nơi làm việc phù hợp!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CANNOT_BUILD.NO_TECH
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CANNOT_BUILD.NO_TECH"
msgid "Hmm, is tricky. Wolfgang should learn how to make."
msgstr "Hừm, khoai phết. Wolfgang nên học cách làm mới được."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CANTBUILDHERE_YOTB_POST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CANTBUILDHERE_YOTB_POST"
