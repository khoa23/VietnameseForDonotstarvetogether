msgstr "Họ đã chết."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PIGEON.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PIGEON.GENERIC"
msgid "He's just winging it."
msgstr "Anh ấy chỉ đang chắp cánh cho nó thôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING"
