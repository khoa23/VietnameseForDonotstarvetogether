msgstr "Tôi cất đồ vào đây!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TREASURECHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TREASURECHEST.UPGRADED_STACKSIZE"
