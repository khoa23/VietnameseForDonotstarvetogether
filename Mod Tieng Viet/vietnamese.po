msgstr "Có vẻ như chúng ta phải tìm thêm người chơi thôi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDING_SPOTS
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDING_SPOTS"
