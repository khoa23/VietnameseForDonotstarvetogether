#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_PATTERN_FRAGMENT_1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_PATTERN_FRAGMENT_1"
msgid "Merely a lonely part of a completed whole."
msgstr "Chỉ là một phần cô độc của một tổng thể hoàn chỉnh."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_PATTERN_FRAGMENT_2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_PATTERN_FRAGMENT_2"
msgid "Merely a lonely part of a completed whole."
msgstr "Chỉ là một phần cô độc của một tổng thể hoàn chỉnh."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_PATTERN_FRAGMENT_3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_PATTERN_FRAGMENT_3"
msgid "Merely a lonely part of a completed whole."
msgstr "Chỉ là một phần cô độc của một tổng thể hoàn chỉnh."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_POST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_POST"
msgid "Where my beefalo will await judgment."
msgstr "Nơi bò lai của tôi sẽ chờ phán quyết."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_POST_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_POST_ITEM"
msgid "Where should I lay it to rest, I wonder?"
msgstr "Nên đặt nó yên nghỉ ở đâu nhỉ?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_SEWINGMACHINE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_SEWINGMACHINE"
msgid "Mother liked to sew matching outfits for Abigail and I."
msgstr "Mẹ thích may đồ đôi cho Abigail và tôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_SEWINGMACHINE_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_SEWINGMACHINE_ITEM"
msgid "It needs to be put together before it can be of any use."
msgstr "Nó cần phải được lắp ráp lại trước khi có thể dùng được."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_STAGE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_STAGE"
msgid "What a strange little booth."
msgstr "Đúng là một cái quầy kỳ lạ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_STAGE_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_STAGE_ITEM"
msgid "I suppose putting that together will distract me from my misery for a while."
msgstr "Chắc việc lắp ráp đó sẽ giúp tôi quên đi nỗi đau khổ này một thời gian."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRATSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRATSHRINE.BURNT"
msgid "Ashes to ashes."
msgstr "Tro lại hoàn tro."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRATSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRATSHRINE.EMPTY"
msgid "It hungers for a tribute."
msgstr "Nó đang khao khát một vật cúng tế."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRATSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRATSHRINE.GENERIC"
msgid "I must pay my respects."
msgstr "Tôi phải bày tỏ lòng kính trọng mới được."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT"
msgid "Returned to dust."
msgstr "Trở về cát bụi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC"
msgid "If only my life could find some direction."
msgstr "Giá mà cuộc đời tôi tìm được chút định hướng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT"
msgid "An exercise in futility."
msgstr "Một bài tập vô ích."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM"
msgid "I suppose I'd better get started."
msgstr "Chắc tôi nên bắt đầu thôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT"
msgid "Returned to dust."
msgstr "Trở về cát bụi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC"
msgid "After all, one never knows when disaster will strike..."
msgstr "Rốt cuộc, chẳng ai biết trước thảm họa sẽ ập đến lúc nào..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT"
msgid "What a silly creature."
msgstr "Đúng là một sinh vật ngốc nghếch."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM"
msgid "What a lot of trouble to go to."
msgstr "Tốn bao nhiêu là công sức."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT"
msgid "Returned to dust."
msgstr "Trở về cát bụi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC"
msgid "I had a hamster once. It died."
msgstr "Tôi từng nuôi một con chuột hamster. Nó chết rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT"
msgid "Running, running, yet going nowhere."
msgstr "Chạy, chạy mãi, để rồi chẳng đi đến đâu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM"
msgid "I'd rather not carry it any longer."
msgstr "Tôi không muốn vác nó thêm chút nào nữa đâu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT"
msgid "Returned to dust."
msgstr "Trở về cát bụi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC"
msgid "Abigail would have enjoyed this."
msgstr "Chắc Abigail sẽ thích trò này lắm."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT"
msgid "You know you'll never get that berry, don't you?"
msgstr "Cậu biết mình sẽ không bao giờ lấy được quả mọng đó đúng không?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM"
msgid "Perhaps I could put it over here..."
msgstr "Có lẽ tôi nên đặt nó ở đây..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT"
msgid "If only I had a signpost to guide me..."
msgstr "Giá mà tôi có một cột mốc để dẫn đường..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM"
msgid "I fear I've already lost my way."
msgstr "Tôi sợ rằng mình đã lạc lối từ lâu rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT"
msgid "I suppose this means the race is over."
msgstr "Chắc ý là cuộc đua đã kết thúc."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC"
msgid "Don't worry, the end is near."
msgstr "Đừng lo, hồi kết đã cận kề."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON"
msgid "Oh. I won."
msgstr "Ồ. Tôi thắng rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON"
msgid "Enjoy your victory {winner}... good things never last."
msgstr "Tận hưởng chiến thắng đi {winner}... những điều tốt đẹp chẳng kéo dài bao giờ đâu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM"
msgid "It's time to finish this... race track."
msgstr "Đã đến lúc hoàn thành đường đua này rồi..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_START
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_START"
msgid "Why do I bother with such silly things."
msgstr "Sao tôi lại đi bận tâm mấy thứ ngớ ngẩn thế này cơ chứ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM"
msgid "I should find a resting place for this."
msgstr "Tôi nên tìm một nơi yên nghỉ cho cái này."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_SCALE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_SCALE.BURNT"
msgid "\"Ashes, ashes, we all fall down.\""
msgstr "\"Tro tro, tất cả chúng ta cùng ngã nhào.\""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT"
msgid "I don't know what I expected, really."
msgstr "Thực sự thì tôi cũng chẳng biết mình mong đợi điều gì nữa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD"
msgid "Oh... that's actually pretty good."
msgstr "Ồ... thực ra thì nó khá ổn đấy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC"
msgid "What is the measure of a Carrat?"
msgstr "Làm thế nào để đo lường một con Cà Ruột đây?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_SCALE_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_SCALE_ITEM"
msgid "How do you measure one's worth?"
msgstr "Làm sao để đo lường giá trị của một người?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_SEEDPACKET"
msgid "Nothing grows in the garden of my heart."
msgstr "Chẳng có gì đâm chồi nảy lộc trong khu vườn trái tim tôi cả."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_SEEDPACKET_RARE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_SEEDPACKET_RARE"
msgid "Everything that grows just dies eventually."
msgstr "Mọi thứ mọc lên rồi cuối cùng cũng sẽ chết."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_ANCHOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_ANCHOR"
msgid "Its golden luster will be lost beneath the sea."
msgstr "Ánh vàng kim của nó sẽ chìm nghỉm dưới đáy biển sâu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_ANCHOR_ITEM"
msgid "It's for a burdensome boat anchor."
msgstr "Nó dùng làm dây neo thuyền ván nặng nhọc."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_DRAGONSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_DRAGONSHRINE.BURNT"
msgid "And to dust you shall return."
msgstr "Rồi ngươi cũng sẽ trở về với cát bụi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY"
msgid "It demands a burnt offering."
msgstr "Nó đang đòi một vật tế cháy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC"
msgid "Let us remember this monster."
msgstr "Hãy cùng tưởng nhớ con quái vật này."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_OAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_OAR"
msgid "I can paddle and paddle, and still feel like I'm going nowhere."
msgstr "Tôi có chèo mỏi mòn bao nhiêu, vẫn thấy mình chẳng đi đến đâu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_STEERINGWHEEL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_STEERINGWHEEL"
msgid "Where would I even go?"
msgstr "Tôi biết đi đâu về đâu bây giờ?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_STEERINGWHEEL_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_STEERINGWHEEL_ITEM"
msgid "It would make a steering wheel..."
msgstr "Nó sẽ tạo thành một bánh lái..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_CHAIR_ROCKING_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_CHAIR_ROCKING_ITEM"
msgid "Ah, the innocence of childhood."
msgstr "Ồ, sự ngây thơ của tuổi thơ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_KNIGHTHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_KNIGHTHAT"
msgid "One may become the knight and save themselves."
msgstr "Người ta có thể hóa thành hiệp sĩ và tự cứu lấy chính mình."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_KNIGHTSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_KNIGHTSHRINE.BURNT"
msgid "What a pity."
msgstr "Tiếc thật đấy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_KNIGHTSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_KNIGHTSHRINE.EMPTY"
msgid "An offering must be made."
msgstr "Phải dâng lễ vật mới được."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_KNIGHTSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_KNIGHTSHRINE.GENERIC"
msgid "I wonder what I'll get?"
msgstr "Tự hỏi mình sẽ nhận được gì nhỉ?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_KNIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_KNIGHTSTICK"
msgid "Hmm. It does look kind of fun."
msgstr "Hừm. Trông cũng có vẻ vui phết."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_LANCE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_LANCE"
msgid "Death rides at its tip."
msgstr "Cái chết ngự trị ngay đầu mũi nhọn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTP_FOOD1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTP_FOOD1"
msgid "Something died for that feast."
msgstr "Đã có sinh vật phải chết vì bữa tiệc đó."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTP_FOOD2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTP_FOOD2"
msgid "I don't want to eat that."
msgstr "Tôi không muốn ăn thứ đó đâu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTP_FOOD3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTP_FOOD3"
msgid "It'll keep me alive a little longer."
msgstr "Nó sẽ giúp tôi sống thêm chút nữa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_1.GENERAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_1.GENERAL"
msgid "The soft glow is... comforting."
msgstr "Ánh sáng dịu nhẹ này... thật dễ chịu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_1.OUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_1.OUT"
msgid "What little comfort it gave is now gone."
msgstr "Chút an ủi ít ỏi nó mang lại nay đã không còn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_1_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_1_ITEM"
msgid "I should find a place for it to belong."
msgstr "Mình nên tìm một chỗ cho nó."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_2.GENERAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_2.GENERAL"
msgid "The soft glow is... comforting."
msgstr "Ánh sáng dịu nhẹ này... thật dễ chịu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_2.OUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_2.OUT"
msgid "What little comfort it gave is now gone."
msgstr "Chút an ủi ít ỏi đó giờ đã biến mất."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_2_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_2_ITEM"
msgid "I should find a place for it to belong."
msgstr "Tôi nên tìm một chỗ phù hợp cho nó."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FIGHTRING_BELL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FIGHTRING_BELL.GENERIC"
msgid "The ring is silent and still, for now."
msgstr "Chiếc chuông tạm thời vẫn đang im lìm."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FIGHTRING_BELL.PLAYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FIGHTRING_BELL.PLAYING"
msgid "Can I... play next?"
msgstr "Tôi có thể... chơi tiếp không?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FIGHTRING_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FIGHTRING_KIT"
msgid "It might be... f-fun?"
msgstr "Có lẽ nó sẽ... v-vui nhỉ?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FOOD1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FOOD1"
msgid "I think... I would like a bit of cake."
msgstr "Tôi nghĩ... tôi muốn ăn một chút bánh ngọt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FOOD2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FOOD2"
msgid "Now my lips have turned blue..."
msgstr "Giờ môi tôi đã chuyển sang màu xanh rồi..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FOOD3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FOOD3"
msgid "I'm sorry Abigail, I'd share if I could."
msgstr "Tôi xin lỗi Abigail, nếu được tôi đã chia sẻ rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FOOD4
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FOOD4"
msgid "It's sticky."
msgstr "Nó dính quá."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_RABBITSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_RABBITSHRINE.BURNT"
msgid "Poor Mr. Rabbit."
msgstr "Tội nghiệp ngài Thỏ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_RABBITSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_RABBITSHRINE.EMPTY"
msgid "Are you hungry, Mr. Rabbit?"
msgstr "Ngài có đói không, ngài Thỏ?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_RABBITSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_RABBITSHRINE.GENERIC"
msgid "I should pay my respects."
msgstr "Tôi nên bày tỏ sự kính trọng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_TOKEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_TOKEN"
msgid "A duel to the death might help pass the time."
msgstr "Một trận quyết đấu tử thần có lẽ sẽ giúp giết thời gian."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_LANTERN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_LANTERN_POST.BURNT"
msgid "Shame, it was pretty."
msgstr "Tiếc thật, nó đẹp mà."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_LANTERN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_LANTERN_POST.GENERIC"
msgid "It does seem to bring some cheer."
msgstr "Nó thực sự mang lại chút phấn chấn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_LANTERN_POST_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_LANTERN_POST_ITEM"
msgid "Shall I cast some light upon the darkness?"
msgstr "Ta có nên thắp sáng bóng đêm này không?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_SNAKESHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_SNAKESHRINE.BURNT"
msgid "Inevitable, really."
msgstr "Cũng dễ đoán trước thôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_SNAKESHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_SNAKESHRINE.EMPTY"
msgid "Perhaps like consumes like."
msgstr "Có lẽ vật gì thu hút vật nấy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_SNAKESHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_SNAKESHRINE.GENERIC"
msgid "Abigail loved surprises."
msgstr "Abigail rất thích những điều bất ngờ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_WORM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_WORM"
msgid "It's actually quite beautiful."
msgstr "Nó thực sự khá đẹp đấy chứ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOT_CATCOONSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOT_CATCOONSHRINE.BURNT"
msgid "No more."
msgstr "Hết rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOT_CATCOONSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOT_CATCOONSHRINE.EMPTY"
msgid "What shall I let go to please it?"
msgstr "Tôi nên buông bỏ thứ gì để làm hài lòng nó đây?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOT_CATCOONSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOT_CATCOONSHRINE.GENERIC"
msgid "How do you know I'm mad?"
msgstr "Sao cậu biết tôi điên?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_GENERIC"
msgid "Sigh... I don't know."
msgstr "H F... Tôi không biết nữa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTHAPPY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTHAPPY"
msgid "The plant, at least, seems to be doing well."
msgstr "Ít ra thì thực vật trông có vẻ vẫn ổn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSED"
msgid "Something around is making its life quite difficult."
msgstr "Thứ gì quanh đây đang làm nó thấy khó sống đây."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORFAMILY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORFAMILY"
msgid "It's lonely... it needs family..."
msgstr "Nó cô đơn quá... nó cần gia đình..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORHAPPINESS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORHAPPINESS"
msgid "Perhaps it just needs some reassurance."
msgstr "Có lẽ nó chỉ cần được trấn an đôi chút."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORKILLJOYS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORKILLJOYS"
msgid "The garden is a bit untidy..."
msgstr "Khu vườn hơi bừa bộn một chút..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORMOISTURE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORMOISTURE"
msgid "Perhaps it might need some water?"
msgstr "Có lẽ nó cần chút nước chăng?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORNUTRIENTS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORNUTRIENTS"
msgid "It is starved for nutrients."
msgstr "Nó đang khát dưỡng chất trầm trọng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSOROVERCROWDING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSOROVERCROWDING"
msgid "It's too close to the other plants... it's suffocating..."
msgstr "Nó ở quá gần mấy cây khác... sắp ngột ngạt đến nơi rồi..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORSEASON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORSEASON"
msgid "It was not made to withstand the harshness of this season."
msgstr "Nó vốn không được sinh ra để chịu đựng sự khắc nghiệt của mùa này."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTVERYSTRESSED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTVERYSTRESSED"
msgid "It is positively miserable. A kindred spirit."
msgstr "Nó đích thực là đang đau khổ. Đúng là đồng bệnh tương lân."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_SMOLDERING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_SMOLDERING"
msgid "It's about to be swallowed by flames."
msgstr "Nó sắp bị ngọn lửa nuốt chửng rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_TOODARK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_TOODARK"
msgid "The darkness! It is too dark!"
msgstr "Bóng đêm kìa! Tối quá rồi!"

#. STRINGS.CHARACTERS.WENDY.EAT_FOOD.TALLBIRDEGG_CRACKED
msgctxt "STRINGS.CHARACTERS.WENDY.EAT_FOOD.TALLBIRDEGG_CRACKED"
msgid "I spared it the torment of living."
msgstr "Tôi đã tha cho nó khỏi sự dằn vặt của việc phải sống."

#. STRINGS.CHARACTERS.WENDY.EAT_FOOD.WINTERSFEASTFUEL
msgctxt "STRINGS.CHARACTERS.WENDY.EAT_FOOD.WINTERSFEASTFUEL"
msgid "Abigail, it's like I can taste mother's cooking..."
msgstr "Abigail, cảm giác như tớ vừa nếm được món ăn của mẹ vậy..."

#. STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_LOSE
msgctxt "STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_LOSE"
msgid "What a horrible place to have a curse."
msgstr "Thật là một nơi tồi tệ để vướng phải lời nguyền."

#. STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_MEALBURNT
msgctxt "STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_MEALBURNT"
msgid "It's ruined."
msgstr "Nó hỏng mất rồi."

#. STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_NOTRECIPE
msgctxt "STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_NOTRECIPE"
msgid "Those foods weren't meant to be together."
msgstr "Những món đó vốn không dành để kết hợp với nhau."

#. STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_WIN
msgctxt "STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_WIN"
msgid "Let us depart this terrible place."
msgstr "Hãy rời khỏi chốn khủng khiếp này thôi."

#. STRINGS.CHARACTERS.WENDY.WENDY_SKILLTREE_EASTEREGG
msgctxt "STRINGS.CHARACTERS.WENDY.WENDY_SKILLTREE_EASTEREGG"
msgid "Is that you, Abby?"
msgstr "Có phải em đấy không, Abby?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.CARNIVAL_HOST_HERE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.CARNIVAL_HOST_HERE"
msgid "I believe I saw our host somewhere in this direction."
msgstr "Ta tin rằng mình đã thấy vị chủ nhà ở hướng này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.EMPTY_CATCOONDEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.EMPTY_CATCOONDEN"
msgid "Unfortunately, it appears the kittens are not present."
msgstr "Thật tiếc, có vẻ như mấy chú mèo con không có ở đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.HOSTBUSY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.HOSTBUSY"
msgid "He seems to be attending to other matters at the moment."
msgstr "Có vẻ như cậu ta đang bận giải quyết việc khác lúc này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDERS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDERS"
msgid "It would seem the seekers outnumber the kittens."
msgstr "Xem ra số người đi tìm đông hơn số mèo con rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDING_SPOTS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDING_SPOTS"
msgid "I believe there are not enough locations for the kittens to hide."
msgstr "Ta cho rằng không có đủ chỗ trốn cho bầy mèo con."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_ONE_GAME_PER_DAY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_ONE_GAME_PER_DAY"
msgid "I believe I should take some time to rest."
msgstr "Ta nghĩ mình nên dành chút thời gian để nghỉ ngơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.LOCKED_GATE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.LOCKED_GATE"
msgid "It appears to be locked."
msgstr "Nó có vẻ đã bị khóa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.MANNEQUIN_EQUIPSWAPFAILED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.MANNEQUIN_EQUIPSWAPFAILED"
msgid "That does not belong on a mannequin."
msgstr "Thứ đó không thuộc về ma-nơ-canh này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.NOCARNIVAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.NOCARNIVAL"
msgid "How disappointing, the corvids seem to have migrated elsewhere."
msgstr "Thật thất vọng, lũ quạ có vẻ đã di cư đi nơi khác rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.NOKELP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.NOKELP"
msgid "only_used_by_wurt"
msgstr "chỉ_được_sử_dụng_bởi_wurt"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.NOTAROBOT"
msgid "It is the property of the automaton."
msgstr "Đây là tài sản của cỗ máy tự động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.NOTMERM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.NOTMERM"
msgid "It seems that piscean bipeds only heed the call of their own kind."
msgstr "Có vẻ như loài lưỡng cư dạng người chỉ nghe theo tiếng gọi đồng loại của chúng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.NOTMYBERNIE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.NOTMYBERNIE"
msgid "This monstrous animated teddy bear is loyal only to our dear Willow."
msgstr "Con gấu bông nhồi bông hoạt hình quái dị này chỉ trung thành với cô Willow thân mến của chúng ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.PILLOWFIGHT_NO_HANDPILLOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.PILLOWFIGHT_NO_HANDPILLOW"
msgid "I will require a pillow to participate."
msgstr "Ta sẽ cần một cái gối để tham gia."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.APPLYELIXIR.NO_ELIXIRABLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.APPLYELIXIR.NO_ELIXIRABLE"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.APPLYELIXIR.TOO_SUPER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.APPLYELIXIR.TOO_SUPER"
msgid "That is too strong."
msgstr "Thứ đó quá mạnh rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.APPLYMODULE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.APPLYMODULE.COOLDOWN"
msgid "only_used_by_wx78"
msgstr "chỉ_được_sử_dụng_bởi_wx78"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.APPLYMODULE.NOTENOUGHSLOTS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.APPLYMODULE.NOTENOUGHSLOTS"
msgid "only_used_by_wx78"
msgstr "chỉ_được_sử_dụng_bởi_wx78"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.APPRAISE.NOTNOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.APPRAISE.NOTNOW"
msgid "Patience is a virtue."
msgstr "Kiên nhẫn là một đức tính tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ATTUNE.NOHEALTH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ATTUNE.NOHEALTH"
msgid "I'm feeling too ill for that."
msgstr "Ta cảm thấy không khỏe để làm việc đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BATHBOMB.ALREADY_BOMBED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BATHBOMB.ALREADY_BOMBED"
msgid "No need to be excessive."
msgstr "Không cần phải làm quá lên thế đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BATHBOMB.GLASSED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BATHBOMB.GLASSED"
msgid "The surface of the spring has crystallized, unfortunately."
msgstr "Rất tiếc, bề mặt của suối nước đã đóng băng tinh thể rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BEGIN_QUEST.ONEGHOST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BEGIN_QUEST.ONEGHOST"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BUILD.BUSY_STATION
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BUILD.BUSY_STATION"
msgid "Oh, botheration."
msgstr "Ồ, thật phiền phức."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BUILD.HASPET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BUILD.HASPET"
msgid "One domestic creature is enough for me."
msgstr "Một sinh vật trong nhà là quá đủ cho ta rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BUILD.MOUNTED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BUILD.MOUNTED"
msgid "In this elevated position, I can't reach the ground."
msgstr "Ở vị trí cao thế này, ta không thể chạm tới mặt đất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BUILD.TICOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BUILD.TICOON"
msgid "Having two trackers at once could possibly confuse them."
msgstr "Có hai kẻ dò đường cùng lúc có thể khiến chúng bối rối đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CARNIVALGAME_FEED.TOO_LATE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CARNIVALGAME_FEED.TOO_LATE"
msgid "Oh dear, I wasn't quite fast enough."
msgstr "Trời ạ, ta ra tay hơi chậm mất rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CARVEPUMPKIN.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CARVEPUMPKIN.BURNING"
msgid "It's hot!"
msgstr "Nó nóng quá!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CARVEPUMPKIN.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CARVEPUMPKIN.INUSE"
msgid "It's obviously being carved by someone else."
msgstr "Rõ ràng là đang có người khác chạm khắc nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.CANT_SPELL_MOUNTED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.CANT_SPELL_MOUNTED"
msgid "only_used_by_willow"
msgstr "chỉ_được_sử_dụng_bởi_willow"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.NOT_ENOUGH_EMBERS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.NOT_ENOUGH_EMBERS"
msgid "only_used_by_willow"
msgstr "chỉ_được_sử_dụng_bởi_willow"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.NO_BATTERY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.NO_BATTERY"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.NO_CATAPULTS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.NO_CATAPULTS"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.NO_TARGETS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.NO_TARGETS"
msgid "only_used_by_willow"
msgstr "chỉ_được_sử_dụng_bởi_willow"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.SPELL_ON_COOLDOWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.SPELL_ON_COOLDOWN"
msgid "only_used_by_willow"
msgstr "chỉ_được_sử_dụng_bởi_willow"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTSPELL.TERRAFORM_TOO_SOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTSPELL.TERRAFORM_TOO_SOON"
msgid "only_used_by_wurt"
msgstr "chỉ_được_sử_dụng_bởi_wurt"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.BURNING"
msgid "No more changes for me. It's gone up in flames."
msgstr "Ta không thay đổi nữa đâu. Nó đã biến thành tro bụi rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.GENERIC"
msgid "I think I look pretty smart already."
msgstr "Ta nghĩ trông mình đã khá tươm tất rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.INUSE"
msgid "If I could use that after you, dear."
msgstr "Ước gì em có thể dùng nó sau anh, cưng à."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.NOOCCUPANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.NOOCCUPANT"
msgid "This station requires a beefalo to be securely hitched before I can proceed any further."
msgstr "Trạm này yêu cầu phải buộc chặt một con Bò Lai trước khi ta có thể tiến hành thêm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.NOTENOUGHHAIR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.NOTENOUGHHAIR"
msgid "Perhaps once the hair has regrown."
msgstr "Có lẽ đợi đến khi tóc mọc lại vậy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL"
msgid "Energy is at full capacity."
msgstr "Năng lượng đã đạt mức tối đa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE"
msgid "There is insufficient charge."
msgstr "Năng lượng không đủ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COMPARE_WEIGHABLE.FISH_TOO_SMALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COMPARE_WEIGHABLE.FISH_TOO_SMALL"
msgid "This specimen is far too insubstantial."
msgstr "Mẫu vật này quá nhỏ bé và nhẹ cân."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COMPARE_WEIGHABLE.OVERSIZEDVEGGIES_TOO_SMALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COMPARE_WEIGHABLE.OVERSIZEDVEGGIES_TOO_SMALL"
msgid "I'm afraid this specimen simply doesn't have enough mass to compete."
msgstr "E rằng mẫu vật này không đủ khối lượng để cạnh tranh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CONSTRUCT.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CONSTRUCT.EMPTY"
msgid "I need something to build with first."
msgstr "Tôi cần thứ gì đó để xây dựng trước đã."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CONSTRUCT.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CONSTRUCT.INUSE"
msgid "Someone's already using this."
msgstr "Có người đang dùng cái này rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CONSTRUCT.MISMATCH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CONSTRUCT.MISMATCH"
msgid "Those are the wrong plans."
msgstr "Đó là những bản thiết kế sai."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CONSTRUCT.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CONSTRUCT.NOTALLOWED"
msgid "That was erroneous."
msgstr "Thao tác đó không đúng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CONSTRUCT.NOTREADY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CONSTRUCT.NOTREADY"
msgid "Perhaps when the ground is more stable..."
msgstr "Có lẽ đợi khi mặt đất vững chắc hơn..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COOK.GENERIC"
msgid "Perhaps later. Not all old ladies enjoy cooking, you know."
msgstr "Để sau đi. Đâu phải bà già nào cũng thích nấu nướng đâu, bạn biết đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COOK.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COOK.INUSE"
msgid "Mmm, smells lovely, dear."
msgstr "Mmm, thơm quá cưng ơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COOK.TOOFAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COOK.TOOFAR"
msgid "It is not within my reach."
msgstr "Nó nằm ngoài tầm với của ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DECORATESNOWMAN.HASHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DECORATESNOWMAN.HASHAT"
msgid "I can't put it on top of the hat."
msgstr "Ta không thể đội nó lên trên mũ được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DECORATESNOWMAN.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DECORATESNOWMAN.INUSE"
msgid "There's obviously someone decorating it now."
msgstr "Rõ ràng là đang có người trang trí nó rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DECORATESNOWMAN.MELTING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DECORATESNOWMAN.MELTING"
msgid "There's no use decorating a snowman that's about to melt."
msgstr "Trang trí một con Người tuyết sắp tan chảy thì có ích gì chứ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DECORATESNOWMAN.STACKEDTOOHIGH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DECORATESNOWMAN.STACKEDTOOHIGH"
msgid "It's simply too tall for another."
msgstr "Nó quá cao để có thể chồng thêm cái nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DEPLOY.HERMITCRAB_RELOCATE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DEPLOY.HERMITCRAB_RELOCATE"
msgid "A convenient way for the hermit crab to relocate her home."
msgstr "Một cách thuận tiện để cua ẩn sĩ dọn nhà."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DISMANTLE.COOKING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DISMANTLE.COOKING"
msgid "I'm afraid I'll have to wait until it's finished cooking."
msgstr "E rằng ta phải đợi cho đến khi nó nấu xong đã."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DISMANTLE.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DISMANTLE.INUSE"
msgid "It's already in use."
msgstr "Nó đang được sử dụng rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DISMANTLE.NOTEMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DISMANTLE.NOTEMPTY"
msgid "I'll have to remove its contents first."
msgstr "Ta phải dọn sạch đồ bên trong nó trước đã."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DIVEGRAB.MISSED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DIVEGRAB.MISSED"
msgid "Oh dear, I've missed!"
msgstr "Ôi trời, ta với hụt mất rồi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DRAW.NOIMAGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DRAW.NOIMAGE"
msgid "An example of what I should diagram would be helpful."
msgstr "Có một ví dụ về thứ ta nên vẽ sơ đồ thì sẽ hữu ích hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.FILL_OCEAN.UNSUITABLE_FOR_PLANTS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.FILL_OCEAN.UNSUITABLE_FOR_PLANTS"
msgid "I'm afraid only freshwater will do."
msgstr "E rằng chỉ có nước ngọt mới dùng được thôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.FISH_OCEAN.TOODEEP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.FISH_OCEAN.TOODEEP"
msgid "Those fish are far too deep."
msgstr "Mấy con Câu Cá đó ở sâu quá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GENERIC.ITEMMIMIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GENERIC.ITEMMIMIC"
msgid "I knew it."
msgstr "Ta biết ngay mà."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.ABIGAILHEART
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.ABIGAILHEART"
msgid "Her spirit is already bound to something in this world."
msgstr "Linh hồn cô ấy đã gắn liền với thứ gì đó ở thế giới này rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.BUSY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.BUSY"
msgid "I'll try again when it's done."
msgstr "Ta sẽ thử lại khi nó xong việc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.CANTSHADOWREVIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.CANTSHADOWREVIVE"
msgid "Conditions are not right."
msgstr "Các điều kiện chưa phù hợp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.CARNIVALGAME_ALREADY_PLAYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.CARNIVALGAME_ALREADY_PLAYING"
msgid "I'm afraid I'll have to wait."
msgstr "E rằng ta phải đợi thôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.CARNIVALGAME_GOLFGAME_NOTREADY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.CARNIVALGAME_GOLFGAME_NOTREADY"
msgid "The mini-golf course requires at least a flaghole to be playable."
msgstr "Sân gôn mini cần ít nhất một lỗ cờ thì mới chơi được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.CARNIVALGAME_INVALID_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.CARNIVALGAME_INVALID_ITEM"
msgid "That doesn't appear to be the correct form of payment."
msgstr "Đó có vẻ không phải hình thức thanh toán chính xác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.DEAD"
msgid "That would be a waste."
msgstr "Thế thì phí hoài lắm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.DUPLICATE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.DUPLICATE"
msgid "We've already taken note of this recipe."
msgstr "Chúng ta đã ghi chú lại công thức này rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.FOODFULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.FOODFULL"
msgid "I'll be around when you're ready for seconds, dear."
msgstr "Ta sẽ quanh quẩn đây khi nào em muốn ăn phần thứ hai nhé, cưng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.GENERIC"
msgid "I don't think so, dear."
msgstr "Ta không nghĩ vậy đâu, cưng à."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.GHOSTHEART
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.GHOSTHEART"
msgid "I'll not be meddling in that business."
msgstr "Ta sẽ không nhúng tay vào chuyện đó đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG"
msgid "It needs a log, imbued with magical properties."
msgstr "Nó cần một khúc Gỗ được yểm bùa phép."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM"
msgid "Goodness no, it needs a fresh mushroom."
msgstr "Trời ạ không, nó cần một cây Nấm tươi cơ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.MUSHROOMFARM_NOMOONALLOWED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.MUSHROOMFARM_NOMOONALLOWED"
msgid "This species seems to only grow in the wild."
msgstr "Loài này có vẻ chỉ mọc ở ngoài tự nhiên."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.NOGENERATORSKILL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.NOGENERATORSKILL"
msgid "Don't be silly, dear."
msgstr "Đừng có ngốc thế chứ, cưng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.NOMOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.NOMOON"
msgid "It needs a lunar influence."
msgstr "Nó cần năng lượng từ mặt trăng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.NOTAMONKEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.NOTAMONKEY"
msgid "I believe they're trying to communicate."
msgstr "Ta tin là chúng đang cố giao tiếp đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.NOTDISH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.NOTDISH"
msgid "That food is simply not suitable."
msgstr "Thức ăn đó hoàn toàn không phù hợp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.NOTGEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.NOTGEM"
msgid "Don't be silly, dear."
msgstr "Đừng có ngốc thế chứ, cưng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.NOTSCULPTABLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.NOTSCULPTABLE"
msgid "No one ought to sculpt with that, dear."
msgstr "Không ai nên dùng thứ đó để điêu khắc cả, cưng ạ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.NOTSTAFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.NOTSTAFF"
msgid "This is not the staff I seek."
msgstr "Đây không phải là cây trượng ta đang tìm kiếm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER"
msgid "This is no time for fun and games!"
msgstr "Đây không phải lúc để đùa giỡn!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.PIGKINGGAME_MESSY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.PIGKINGGAME_MESSY"
msgid "I'll need to do some tidying up first."
msgstr "Ta cần phải dọn dẹp lại một chút trước đã."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.PIGKINGGAME_TOOLATE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.PIGKINGGAME_TOOLATE"
msgid "No time for that now. It'll be dark soon."
msgstr "Không còn thời gian cho việc đó nữa đâu. Trời sắp tối rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.QUEENBUSY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.QUEENBUSY"
msgid "She is occupied with other matters at the moment."
msgstr "Cô ấy đang bận giải quyết việc khác lúc này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.SLEEPING"
msgid "It appears to be sleeping."
msgstr "Nó có vẻ đang ngủ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.SLOTFULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.SLOTFULL"
msgid "Let's finish what's on our plate first, shall we?"
msgstr "Hãy ăn hết những gì trên Đĩa trước đã nhé?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.SPIDERNOHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.SPIDERNOHAT"
msgid "There simply isn't enough room for that."
msgstr "Đơn giản là không đủ chỗ cho việc đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.TERRARIUM_COOLDOWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.TERRARIUM_COOLDOWN"
msgid "Oh that won't do, the intended arborous recipient appears to be missing."
msgstr "Ồ không được đâu, hình như đối tượng cái cây được chọn đang vắng mặt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.TERRARIUM_REFUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.TERRARIUM_REFUSE"
msgid "Perhaps I should make another attempt with something else."
msgstr "Có lẽ ta nên thử lại với thứ khác xem sao."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.WRONGGEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.WRONGGEM"
msgid "This gemstone's properties are incorrect for my purposes."
msgstr "Đặc tính của viên đá quý này không phù hợp với mục đích của ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.WRONGSHADOWFORM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.WRONGSHADOWFORM"
msgid "The skeletal anatomy is incorrect."
msgstr "Cấu trúc giải phẫu xương không chính xác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVEALLTOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVEALLTOPLAYER.BUSY"
msgid "I'll try again when they're free."
msgstr "Ta sẽ thử lại khi họ rảnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVEALLTOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVEALLTOPLAYER.DEAD"
msgid "That would be a waste."
msgstr "Thế thì phí hoài lắm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVEALLTOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVEALLTOPLAYER.FULL"
msgid "They're already heavily burdened."
msgstr "Họ đã mang vác quá nặng rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING"
msgid "They've entered REM sleep. No need to disturb them."
msgstr "Họ đang ngủ sâu rồi. Không cần phải làm phiền đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVETOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVETOPLAYER.BUSY"
msgid "I'll try again when they're free."
msgstr "Ta sẽ thử lại khi họ rảnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVETOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVETOPLAYER.DEAD"
msgid "That would be a waste."
msgstr "Thế thì phí hoài lắm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVETOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVETOPLAYER.FULL"
msgid "They're already heavily burdened."
msgstr "Họ đã mang vác quá nặng rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVETOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVETOPLAYER.SLEEPING"
msgid "They've entered REM sleep. No need to disturb them."
msgstr "Họ đang ngủ sâu rồi. Không cần phải làm phiền đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE_TACKLESKETCH.DUPLICATE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE_TACKLESKETCH.DUPLICATE"
msgid "We've already taken note of this recipe."
msgstr "Chúng ta đã ghi chú lại công thức này rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.HARVEST.DOER_ISNT_MODULE_OWNER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.HARVEST.DOER_ISNT_MODULE_OWNER"
msgid "As I thought, I'm unable to glean any information from it."
msgstr "Đúng như ta nghĩ, ta chẳng thể thu thập được thông tin gì từ nó cả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.HEAL.NOT_MERM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.HEAL.NOT_MERM"
msgid "This concoction is used by the merms for healing."
msgstr "Hợp chất này được người cá dùng để chữa bệnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.HERD_FOLLOWERS.WEBBERONLY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.HERD_FOLLOWERS.WEBBERONLY"
msgid "I'm afraid this isn't my area of expertise."
msgstr "E rằng đây không phải lĩnh vực chuyên môn của ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.HITCHUP.BEEF_HITCHED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.HITCHUP.BEEF_HITCHED"
msgid "Already done, dear."
msgstr "Xong rồi đấy, cưng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.HITCHUP.INMOOD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.HITCHUP.INMOOD"
msgid "Nothing will be accomplished in the state they're in."
msgstr "Sẽ chẳng làm được gì với tâm trạng hiện tại của chúng đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.HITCHUP.NEEDBEEF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.HITCHUP.NEEDBEEF"
msgid "I will require a beefalo first."
msgstr "Ta sẽ cần một con Bò Lai trước."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.HITCHUP.NEEDBEEF_CLOSER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.HITCHUP.NEEDBEEF_CLOSER"
msgid "My beefalo needs to be in closer proximity to the post."
msgstr "Con Bò Lai của ta cần đứng gần cái Cột hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.LOWER_SAIL_FAIL.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.LOWER_SAIL_FAIL.1"
msgid "There must be a trick to this."
msgstr "Chắc phải có mẹo gì đó cho việc này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.LOWER_SAIL_FAIL.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.LOWER_SAIL_FAIL.2"
msgid "Oh, you finicky thing!"
msgstr "Ồ, cái đồ rắc rối này!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.LOWER_SAIL_FAIL.3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.LOWER_SAIL_FAIL.3"
msgid "Come along now, no need to be stubborn."
msgstr "Nào nào, đừng có bướng bỉnh thế chứ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MARK.ALREADY_MARKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MARK.ALREADY_MARKED"
msgid "I'm fairly confident in my selection."
msgstr "Ta khá tự tin với lựa chọn của mình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MARK.NOT_PARTICIPANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MARK.NOT_PARTICIPANT"
msgid "I'll have to observe for now."
msgstr "Ta đành phải đứng quan sát lúc này vậy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MOUNT.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MOUNT.INUSE"
msgid "Patience is required. I can ride this beefalo later."
msgstr "Cần phải kiên nhẫn. Ta có thể cưỡi con Bò Lai này sau."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MOUNT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MOUNT.SLEEPING"
msgid "Up now, I require your services."
msgstr "Dậy nào, ta cần sự phục vụ của ngươi đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MOUNT.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MOUNT.TARGETINCOMBAT"
msgid "It would be ill-advised to approach that scuffle."
msgstr "Thật không khôn ngoan chút nào nếu bén mảng đến cuộc ẩu đả đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MUTATE.CAVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MUTATE.CAVE"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MUTATE.NOFULLMOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MUTATE.NOFULLMOON"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MUTATE.NOGHOST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MUTATE.NOGHOST"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MUTATE.NONEWMOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MUTATE.NONEWMOON"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MUTATE.NOTNIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MUTATE.NOTNIGHT"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.OCEAN_FISHING_POND.WRONGGEAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.OCEAN_FISHING_POND.WRONGGEAR"
msgid "I don't require this for some simple pond fishing."
msgstr "Ta không cần thứ này chỉ để câu cá ở ao bình thường."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.OPEN_CRAFTING.PROFESSIONALCHEF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.OPEN_CRAFTING.PROFESSIONALCHEF"
msgid "It would be rude of me to tamper with it."
msgstr "Thật bất lịch sự nếu ta táy máy vào đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.OPEN_CRAFTING.SHADOWMAGIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.OPEN_CRAFTING.SHADOWMAGIC"
msgid "I'm not letting THAT in MY library!"
msgstr "Ta không đời nào để THỨ ĐÓ vào thư viện của mình đâu!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.PICK.NOTHING_INSIDE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.PICK.NOTHING_INSIDE"
msgid "Empty, as I suspected."
msgstr "Trống rỗng, đúng như ta nghi ngờ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.PICK.STUCK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.PICK.STUCK"
msgid "It is stuck."
msgstr "Nó bị kẹt rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.PICKUP.FULL_OF_CURSES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.PICKUP.FULL_OF_CURSES"
msgid "I think it would be best to leave it be."
msgstr "Ta nghĩ tốt nhất là cứ để mặc nó thì hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.PICKUP.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.PICKUP.INUSE"
msgid "It's already in use."
msgstr "Nó đang được dùng rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.PICKUP.NOTMINE_YOTC.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.PICKUP.NOTMINE_YOTC.1"
msgid "Oh my, I seem to have gotten a bit mixed up."
msgstr "Ôi trời, hình như ta bị nhầm lẫn chút rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.PICKUP.NOTMINE_YOTC.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.PICKUP.NOTMINE_YOTC.2"
msgid "My glasses need a good cleaning, that's clearly not my Daucus carota rattus!"
msgstr "Cặp kính của ta cần được lau chùi kỹ lại rồi, đó rõ ràng không phải là củ cải thỏ của ta!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.PICKUP.RESTRICTION
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.PICKUP.RESTRICTION"
msgid "That's not my area of expertise."
msgstr "Đó không phải lĩnh vực chuyên môn của ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.FERTILIZER"
msgid "I've gleaned as much information as I can."
msgstr "Ta đã thu thập được tất cả thông tin có thể rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.GENERIC"
msgid "I'm already quite knowledgeable about this particular species."
msgstr "Ta đã khá am hiểu về loài cụ thể này rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.POUNCECAPTURE.MISSED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.POUNCECAPTURE.MISSED"
msgid "Oh dear, I've missed!"
msgstr "Ôi trời, ta với hụt mất rồi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.POUR_WATER.OUT_OF_WATER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.POUR_WATER.OUT_OF_WATER"
msgid "Oh dear, I'll have to replenish my water supply."
msgstr "Ôi trời, ta sẽ phải bổ sung lại lượng nước của mình thôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.POUR_WATER_GROUNDTILE.OUT_OF_WATER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.POUR_WATER_GROUNDTILE.OUT_OF_WATER"
msgid "I'll have to replenish my water supply at the earliest opportunity."
msgstr "Ta sẽ phải bổ sung lại lượng nước ngay khi có cơ hội."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.ALREADYFULLMOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.ALREADYFULLMOON"
msgid "I'm afraid that would be quite redundant."
msgstr "E rằng làm vậy thì thừa thãi quá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.BIRDSBLOCKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.BIRDSBLOCKED"
msgid "Of course, the force field applies to the birds too."
msgstr "Dĩ nhiên rồi, trường lực cũng áp dụng với cả lũ chim luôn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.DEADBIRDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.DEADBIRDS"
msgid "Oh, dear. I'm afraid the sky is not safe for birds right now."
msgstr "Trời ạ. E rằng bầu trời lúc này không Két Sắt cho loài chim đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.GENERIC"
msgid "Other matters await."
msgstr "Những việc khác đang chờ kìa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.NOBIRDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.NOBIRDS"
msgid "The birds are not keen on this weather."
msgstr "Lũ chim không có hứng thú với thời tiết này lắm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.NOFIRES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.NOFIRES"
msgid "Thankfully, there are no fires to put out."
msgstr "Thật may là không có đám cháy nào cần dập tắt cả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.NOHORTICULTURE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.NOHORTICULTURE"
msgid "There are no crops to cultivate."
msgstr "Không có hoa màu nào để canh tác cả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.NOMOONINCAVES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.NOMOONINCAVES"
msgid "The moon can't be affected from this subterranean location."
msgstr "Mặt trăng không thể bị tác động từ vị trí dưới lòng đất này được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.NOSILVICULTURE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.NOSILVICULTURE"
msgid "There are no arboreal subjects to focus on."
msgstr "Không có đối tượng thực vật thân gỗ nào ở đây để tập trung cả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.NOSLEEPTARGETS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.NOSLEEPTARGETS"
msgid "I don't see anyone in need of a bedtime story."
msgstr "Ta chẳng thấy ai cần nghe truyện ngủ cả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.NOTENTACLEGROUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.NOTENTACLEGROUND"
msgid "The tentacles would be unable to break the surface here."
msgstr "Mấy cái xúc tu sẽ không thể trồi lên mặt đất ở đây được đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.NOWATERNEARBY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.NOWATERNEARBY"
msgid "Fish may only be summoned in close proximity to a body of water."
msgstr "Câu Cá chỉ có thể được triệu hồi khi ở gần nguồn nước."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.TOOMANYBEES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.TOOMANYBEES"
msgid "That would be a rather excessive amount of bees, dear."
msgstr "Số lượng ong thế thì nhiều quá mức rồi đấy, cưng ơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.TOOMANYBIRDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.TOOMANYBIRDS"
msgid "It doesn't work as well with this many birds around."
msgstr "Nó không hiệu quả lắm khi có quá nhiều chim quanh đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.WAYTOOMANYBIRDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.WAYTOOMANYBIRDS"
msgid "The sky is out of birds for now."
msgstr "Bầu trời hiện không còn con chim nào nữa rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.REMOTE_TELEPORT.NODEST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.REMOTE_TELEPORT.NODEST"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.REMOTE_TELEPORT.NOSKILL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.REMOTE_TELEPORT.NOSKILL"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.REMOVEMODULES.NO_MODULES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.REMOVEMODULES.NO_MODULES"
msgid "only_used_by_wx78"
msgstr "chỉ_được_sử_dụng_bởi_wx78"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.REPAIR.WRONGPIECE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.REPAIR.WRONGPIECE"
msgid "That is clearly the incorrect piece."
msgstr "Rõ ràng đó không phải là mảnh ghép phù hợp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.REPLATE.MISMATCH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.REPLATE.MISMATCH"
msgid "That's not the proper dinnerware for this food."
msgstr "Đó không phải là bộ đồ ăn thích hợp cho món này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.REPLATE.SAMEDISH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.REPLATE.SAMEDISH"
msgid "It's already on the proper dinnerware."
msgstr "Nó đang nằm trên bộ đồ ăn phù hợp rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ROW_FAIL.BAD_TIMING0
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ROW_FAIL.BAD_TIMING0"
msgid "I must time this perfectly."
msgstr "Ta phải căn nhịp sao cho thật chuẩn xác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ROW_FAIL.BAD_TIMING1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ROW_FAIL.BAD_TIMING1"
msgid "This might take some tenacity."
msgstr "Việc này có thể cần chút sự bền bỉ đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ROW_FAIL.BAD_TIMING2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ROW_FAIL.BAD_TIMING2"
msgid "Oh dear, I'll have to start over."
msgstr "Ôi trời, ta lại phải bắt đầu lại từ đầu rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.RUMMAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.RUMMAGE.GENERIC"
msgid "I've other things on my mind currently."
msgstr "Hiện tại ta còn nhiều chuyện khác phải bận tâm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.RUMMAGE.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.RUMMAGE.INUSE"
msgid "Be sure to sort by color and weight, dear."
msgstr "Hãy nhớ phân loại theo màu sắc và trọng lượng nhé, cưng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.RUMMAGE.NOTAMERM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.RUMMAGE.NOTAMERM"
msgid "I don't believe the locals would take kindly to that."
msgstr "Ta không nghĩ dân làng ở đây sẽ thích thú với việc đó đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.RUMMAGE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.RUMMAGE.NOTAROBOT"
msgid "It is the property of the automaton."
msgstr "Đây là tài sản của cỗ máy tự động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.RUMMAGE.NOTMASTERCHEF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.RUMMAGE.NOTMASTERCHEF"
msgid "It would be rude of me to tamper with it."
msgstr "Thật bất lịch sự nếu ta táy máy vào đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.RUMMAGE.NOTSOULJARHANDLER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.RUMMAGE.NOTSOULJARHANDLER"
msgid "Best not interfere."
msgstr "Tốt nhất là không nên nhúng tay vào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.RUMMAGE.RESTRICTED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.RUMMAGE.RESTRICTED"
msgid "It's not for me, I'm afraid."
msgstr "E rằng nó không dành cho ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.SADDLE.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.SADDLE.TARGETINCOMBAT"
msgid "It would be ill-advised to approach that scuffle."
msgstr "Thật không khôn ngoan chút nào nếu bén mảng đến cuộc ẩu đả đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.SHAVE.AWAKEBEEFALO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.SHAVE.AWAKEBEEFALO"
msgid "I think he might object to that."
msgstr "Ta nghĩ anh ta sẽ phản đối chuyện đó đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.SHAVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.SHAVE.GENERIC"
msgid "I would really rather not."
msgstr "Ta thực sự không muốn làm thế chút nào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.SHAVE.NOBITS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.SHAVE.NOBITS"
msgid "It's already smooth, dear."
msgstr "Nó đã nhẵn trụi rồi, cưng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.SHAVE.SOMEONEELSESBEEFALO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.SHAVE.SOMEONEELSESBEEFALO"
msgid "It's not my place to shave someone else's beefalo."
msgstr "Cạo lông con Bò Lai của người khác không phải việc của ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.SLAUGHTER.TOOFAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.SLAUGHTER.TOOFAR"
msgid "Oh dear, it got away."
msgstr "Ôi trời, nó chạy mất tiêu rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.SOAKIN.NOSPACE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.SOAKIN.NOSPACE"
msgid "There's clearly someone sitting there already."
msgstr "Rõ ràng là có người đang ngồi ở đó rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.START_CARRAT_RACE.NO_RACERS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.START_CARRAT_RACE.NO_RACERS"
msgid "I can't gather any data with no subjects."
msgstr "Ta chẳng thể thu thập dữ liệu nào khi không có đối tượng cả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.GENERIC"
msgid "It's full to the brim, I'm afraid."
msgstr "E rằng nó đã đầy ắp đến tận miệng rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.INUSE"
msgid "I do hope you're keeping organized, my dear."
msgstr "Ta rất hy vọng em vẫn đang giữ mọi thứ ngăn nắp đấy, cưng của ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.NOTALLOWED"
msgid "Nonsense."
msgstr "Thật vớ vẩn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.NOTAROBOT"
msgid "It is the property of the automaton."
msgstr "Đây là tài sản của cỗ máy tự động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.NOTMASTERCHEF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.NOTMASTERCHEF"
msgid "It would be rude of me to tamper with it."
msgstr "Thật bất lịch sự nếu ta táy máy vào đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.NOTSOULJARHANDLER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.NOTSOULJARHANDLER"
msgid "Best not interfere."
msgstr "Tốt nhất là không nên nhúng tay vào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.RESTRICTED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.RESTRICTED"
msgid "It's not for me, I'm afraid."
msgstr "E rằng nó không dành cho ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.TEACH.CANTLEARN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.TEACH.CANTLEARN"
msgid "A piece of knowledge I cannot grasp... Intriguing!"
msgstr "Một khối tri thức mà ta không thể lĩnh hội... Thật thú vị làm sao!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.TEACH.KNOWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.TEACH.KNOWN"
msgid "Please. That knowledge is child's play."
msgstr "Làm ơn đi. Kiến thức đó chỉ là trò trẻ con thôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.TEACH.MESSAGEBOTTLEMANAGER_NOT_FOUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.TEACH.MESSAGEBOTTLEMANAGER_NOT_FOUND"
msgid "It's much too dark to make any sense of this."
msgstr "Tối quá rồi, chẳng thể hiểu nổi thứ này nói gì cả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.TEACH.STASH_MAP_NOT_FOUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.TEACH.STASH_MAP_NOT_FOUND"
msgid "The apes seem to have neglected to mark any particular sites on this map."
msgstr "Lũ khỉ hình như đã quên đánh dấu bất kỳ vị trí cụ thể nào trên bản đồ này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.TEACH.WRONGWORLD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.TEACH.WRONGWORLD"
msgid "This map is for some other location."
msgstr "Bản đồ này dành cho một địa điểm khác nào đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.TELLSTORY.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.TELLSTORY.GENERIC"
msgid "only_used_by_walter"
msgstr "chỉ_được_sử_dụng_bởi_walter"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.USEITEMON.BEEF_BELL_ALREADY_USED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.USEITEMON.BEEF_BELL_ALREADY_USED"
msgid "It's already formed a bond with someone else, dear."
msgstr "Nó đã gắn kết tình cảm với người khác mất rồi, cưng à."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.USEITEMON.BEEF_BELL_HAS_BEEF_ALREADY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.USEITEMON.BEEF_BELL_HAS_BEEF_ALREADY"
msgid "I don't require any more beefalo."
msgstr "Ta không cần thêm con Bò Lai nào nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.USEITEMON.BEEF_BELL_INVALID_TARGET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.USEITEMON.BEEF_BELL_INVALID_TARGET"
msgid "That won't do."
msgstr "Thế thì không được đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.USEITEMON.CANNOT_FIX_DRONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.USEITEMON.CANNOT_FIX_DRONE"
msgid "It is simply irreparable."
msgstr "Nó hoàn toàn không thể sửa chữa được nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.USEITEMON.NOT_MINE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.USEITEMON.NOT_MINE"
msgid "It does not belong to me."
msgstr "Nó không thuộc về ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS"
msgid "The beast must first be defeated."
msgstr "Phải đánh bại con quái thú trước đã."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY"
msgid "I'll have to find the right key."
msgstr "Ta sẽ phải tìm Chìa khóa phù hợp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY"
msgid "That may have been the wrong implement."
msgstr "Đó có lẽ là dụng cụ không đúng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.WRAPBUNDLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.WRAPBUNDLE.EMPTY"
msgid "I have to know what to wrap, dear."
msgstr "Ta phải biết mình đang gói thứ gì chứ, cưng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.WRITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.WRITE.GENERIC"
msgid "I'd rather write in my own books."
msgstr "Ta thích viết vào sách của chính mình hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.WRITE.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.WRITE.INUSE"
msgid "When you're done, dear."
msgstr "Khi nào bạn xong việc nhé, cưng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.YOTB_STARTCONTEST.ALREADYACTIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.YOTB_STARTCONTEST.ALREADYACTIVE"
msgid "I imagine there must be a competition going on elsewhere."
msgstr "Ta đoán chắc phải có một cuộc thi đang diễn ra ở đâu đó rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK"
msgid "The contest will have to wait for the time being."
msgstr "Cuộc thi đành phải gác lại một thời gian vậy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.YOTB_STARTCONTEST.NORESPONSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.YOTB_STARTCONTEST.NORESPONSE"
msgid "It appears he has gone for a constitutional."
msgstr "Có vẻ như cậu ta đã đi dạo hít thở không khí rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE"
msgid "He is currently engaged."
msgstr "Cậu ta hiện đang bận việc rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN"
msgid "I've already familiarized myself with this particular pattern."
msgstr "Ta đã quen thuộc với mẫu thiết kế này rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL_GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL_GENERIC"
msgid "It seems I can't do that."
msgstr "Dường như ta không thể làm vậy được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ACCOMPLISHMENT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ACCOMPLISHMENT"
msgid "It's not there yet!"
msgstr "Vẫn chưa được đâu!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ACCOMPLISHMENT_DONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ACCOMPLISHMENT_DONE"
msgid "File that under completed!"
msgstr "Xếp vào mục đã hoàn thành!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ACIDBATS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ACIDBATS"
msgid "What a dreadful noise they make."
msgstr "Chúng phát ra thứ âm thanh thật kinh khủng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ADVENTUREFAIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ADVENTUREFAIL"
msgid "We must learn from our failures."
msgstr "Chúng ta phải học hỏi từ những thất bại của mình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_SINKHOLE.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_SINKHOLE.1"
msgid "The ground will soon give way."
msgstr "Mặt đất sẽ sớm sụt xuống thôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_SINKHOLE.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_SINKHOLE.2"
msgid "Not the work of tectonic plates."
msgstr "Không phải do các mảng kiến tạo đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_SINKHOLE.3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_SINKHOLE.3"
msgid "A six on the Richter scale."
msgstr "Đạt sáu độ rích-te luôn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_TRIBUTE.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_TRIBUTE.1"
msgid "For you, great Panthera auropunctata."
msgstr "Dành cho ngươi đấy, ngài Panthera auropunctata vĩ đại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_TRIBUTE.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_TRIBUTE.2"
msgid "It ought to be more docile now."
msgstr "Nó có vẻ ngoan ngoãn hơn rồi đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_TRIBUTE.3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_TRIBUTE.3"
msgid "The great Panthera auropunctata is tamed."
msgstr "Ngài Panthera auropunctata vĩ đại đã được thuần hóa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE"
msgid "What a peculiar sensation, it's transmitting a blueprint telepathically!"
msgstr "Thật là một cảm giác kỳ lạ, nó đang truyền một Bản thiết kế qua đường thần giao cách cảm!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ARCHIVE_NO_POWER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ARCHIVE_NO_POWER"
msgid "How very disappointing, I was curious to see what it would do."
msgstr "Thật là đáng thất vọng, ta đã rất tò mò muốn xem nó làm được gì cơ chứ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE"
msgid "I'm already familiar with this particular piece of knowledge."
msgstr "Ta đã quen thuộc với mảng kiến thức này rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATRIUM_DESTABILIZING.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATRIUM_DESTABILIZING.1"
msgid "I do believe it's time to go."
msgstr "Ta tin là đã đến lúc phải đi rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATRIUM_DESTABILIZING.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATRIUM_DESTABILIZING.2"
msgid "It's dangerous to be here."
msgstr "Ở đây nguy hiểm lắm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATRIUM_DESTABILIZING.3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATRIUM_DESTABILIZING.3"
msgid "Goodness gracious!"
msgstr "Ôi trời đất ơi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATTACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATTACH_BUFF_ATTACK"
msgid "My, I feel full of vim and vigor!"
msgstr "Chà, ta cảm thấy tràn đầy sức sống và năng lượng!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK"
msgid "I seem to have been rendered conductive!"
msgstr "Hình như ta đã trở thành vật dẫn điện rồi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY"
msgid "I feel so pleasantly dry!"
msgstr "Ta cảm thấy khô ráo dễ chịu làm sao!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION"
msgid "I daresay I'm tougher than I may appear!"
msgstr "Ta dám cá là mình cứng rắn hơn vẻ bề ngoài đấy!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE"
msgid "I'm no stranger to sleeplessness."
msgstr "Chuyện mất ngủ đối với ta chẳng có gì lạ cả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS"
msgid "I'll have everything done in a snap!"
msgstr "Ta sẽ hoàn thành mọi thứ trong nháy mắt!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BECOMEGHOST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BECOMEGHOST"
msgid "oOoooOoO!!"
msgstr "oOoooOoO!!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BEES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BEES"
msgid "Stinging nasties!"
msgstr "Lũ quái vật chích đau điếng!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BOAT_LEAK"
msgid "The boat has fallen into dangerous disrepair."
msgstr "Thuyền ván đã rơi vào tình trạng xuống cấp nguy hiểm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BOAT_SINK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BOAT_SINK"
msgid "Goodness, we're sinking!"
msgstr "Trời ạ, chúng ta đang chìm kìa!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BOOK_MOON_DAYTIME
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BOOK_MOON_DAYTIME"
msgid "We won't be able to view the effects until this evening."
msgstr "Chúng ta sẽ không thể thấy hiệu ứng cho đến tận tối nay đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BOOMERANG"
msgid "I misjudged the timing of its return."
msgstr "Ta đã phán đoán sai thời điểm nó quay lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BRAVERY_POTION
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BRAVERY_POTION"
msgid "My intestinal fortitude has returned!"
msgstr "Sự can đảm trong ta đã trở lại!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BURNT"
msgid "First degree, at least!"
msgstr "Ít nhất cũng bỏng độ một!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CALL_BEEF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CALL_BEEF"
msgid "Come along now."
msgstr "Nào, đi theo ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CANFIX
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CANFIX"
msgid "\nI do believe I can repair this."
msgstr "Ta tin là mình có thể sửa được cái này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS"
msgid "I should endeavor to collect the required ingredients."
msgstr "Ta nên cố gắng thu thập đủ các nguyên liệu cần thiết."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CANNOT_BUILD.NO_STATION
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CANNOT_BUILD.NO_STATION"
msgid "I'm afraid this will require a specialized workspace."
msgstr "E rằng việc này sẽ cần một không gian làm việc chuyên dụng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CANNOT_BUILD.NO_TECH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CANNOT_BUILD.NO_TECH"
msgid "This looks like an opportunity to conduct some research."
msgstr "Đây có vẻ là cơ hội để tiến hành một số nghiên cứu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CANTBUILDHERE_YOTB_POST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CANTBUILDHERE_YOTB_POST"
msgid "It would be much more practical to build this closer to the competition."
msgstr "Sẽ thiết thực hơn nhiều nếu xây dựng cái này gần khu vực thi đấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CANT_ESCAPE_CURSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CANT_ESCAPE_CURSE"
msgid "I just can't seem to put it down..."
msgstr "Ta cứ có cảm giác không thể đặt nó xuống được..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP"
msgid "The subject seems to be exhibiting low levels of stamina."
msgstr "Đối tượng hình như đang có mức thể lực thấp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CARRAT_ERROR_STUNNED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CARRAT_ERROR_STUNNED"
msgid "You must pay attention!"
msgstr "Bạn phải tập trung chứ!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CARRAT_ERROR_WALKING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CARRAT_ERROR_WALKING"
msgid "Let's try to look a bit more lively, dear."
msgstr "Cố gắng trông năng động hơn một chút nào, cưng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1"
msgid "Wrong way, dear."
msgstr "Nhầm đường rồi, cưng ơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2"
msgid "Oh my, I'll have to make a note of this."
msgstr "Ôi chao, ta phải ghi lại điều này mới được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CARRAT_START_RACE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CARRAT_START_RACE"
msgid "Let the race commence!"
msgstr "Cuộc đua xin được phép bắt đầu!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CAVEIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CAVEIN"
msgid "The rocks above will soon give way."
msgstr "Mấy Cục đá ở trên đầu sẽ sớm sụt xuống thôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CHAIR_ON_FIRE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CHAIR_ON_FIRE"
msgid "This is unacceptable."
msgstr "Thật không thể chấp nhận được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CHARLIE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CHARLIE"
msgid "A noise! And a distinctly floral scent?"
msgstr "Tiếng động gì vậy! Lại phảng phất mùi hương hoa nữa chứ?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CHARLIESAVE.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CHARLIESAVE.1"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CHARLIE_ATTACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CHARLIE_ATTACK"
msgid "OUCH! Who dares?!"
msgstr "ÁI CHÀ! Kẻ nào mà dám gan thế?!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COACH.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COACH.1"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COACH.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COACH.2"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COACH.3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COACH.3"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COACH.4
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COACH.4"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COACH.5
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COACH.5"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COACH.6
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COACH.6"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COACH.7
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COACH.7"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COACH.8
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COACH.8"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COACH.9
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COACH.9"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COLD"
msgid "The ambient temperature is low."
msgstr "Nhiệt độ xung quanh đang thấp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COMPASS_OUT"
msgid "My compass has become demagnetized."
msgstr "La bàn của tôi đã bị mất từ tính rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COZY_SLEEP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COZY_SLEEP"
msgid "I suppose it was worth a try."
msgstr "Chắc là cũng đáng để thử đấy chứ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CRAFTING_FAIL"
msgid "I can't make that now."
msgstr "Lúc này tôi không thể chế tạo cái đó được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DAMP"
msgid "The layer of water begins to build up."
msgstr "Lớp nước bắt đầu tích tụ lại rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DEERCLOPS"
msgid "That sounds quite large!"
msgstr "Nghe tiếng động lớn quá đấy!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DESPAWN"
msgid "I've never read anything describing this!"
msgstr "Tôi chưa từng đọc được tài liệu nào mô tả về thứ này!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DETACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DETACH_BUFF_ATTACK"
msgid "Oh my, what came over me?"
msgstr "Ôi trời, chuyện quái gì đã xảy ra với tôi thế này?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK"
msgid "Back to the the natural state of things."
msgstr "Trở lại trạng thái tự nhiên vốn có nào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY"
msgid "Did I just feel a raindrop?"
msgstr "Vừa rồi có phải tôi vừa cảm thấy một giọt nước mưa không nhỉ?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION"
msgid "It appears my defense has weakened."
msgstr "Có vẻ như khả năng phòng thủ của tôi đã suy giảm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE"
msgid "How strange, I do in fact feel a bit tired..."
msgstr "Thật kỳ lạ, quả thực tôi đang thấy hơi buồn ngủ..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS"
msgid "I can only work tirelessly for so long."
msgstr "Tôi chỉ có thể làm việc không ngừng nghỉ đến một mức độ nào đó thôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DIG_DISEASE_WARNING"
msgid "Caught it just in time. The roots were nearly rotten."
msgstr "Chộp được đúng lúc thật. Bộ rễ gần như đã mục nát rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DUSK"
msgid "Night will be here soon."
msgstr "Trời sắp tối đến nơi rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.GENERIC"
msgid "Yum!"
msgstr "Ngon tuyệt!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.INVALID
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.INVALID"
msgid "This cannot be consumed."
msgstr "Thứ này không thể ăn được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.PAINFUL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.PAINFUL"
msgid "I should not have ingested that."
msgstr "Lẽ ra tôi không nên nuốt thứ đó vào bụng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.SPOILED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.SPOILED"
msgid "That was partially decomposed."
msgstr "Thứ đó đã bị phân hủy một phần rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.STALE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.STALE"
msgid "That was not at optimal freshness."
msgstr "Thứ đó không còn ở độ tươi ngon nhất nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.YUCKY"
msgid "Ingesting this would be ill-advised."
msgstr "Nuốt thứ này vào thì không khôn ngoan chút nào đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EATING_NOT_FEASTING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EATING_NOT_FEASTING"
msgid "I couldn't possibly eat this all myself!"
msgstr "Tôi đời nào ăn hết ngần này một mình được!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ELIXIR_BOOSTED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ELIXIR_BOOSTED"
msgid "That will do nicely."
msgstr "Thế này là vừa đẹp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ELIXIR_GHOSTVISION
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ELIXIR_GHOSTVISION"
msgid "My eyes have been adjusted to the darkness."
msgstr "Mắt tôi đã thích nghi với bóng đêm rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ELIXIR_PLAYER_SPEED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ELIXIR_PLAYER_SPEED"
msgid "Strength is wasted on the young!"
msgstr "Sức lực đúng là hoài phí cho đám trẻ tuổi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ELIXIR_TOO_SUPER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ELIXIR_TOO_SUPER"
msgid "That is too strong."
msgstr "Thế này thì mạnh quá mức rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.1"
msgid "It's all in the legs."
msgstr "Tất cả là nhờ đôi chân đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.2"
msgid "Goodness..."
msgstr "Chúa ơi..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.3"
msgid "Dear me..."
msgstr "Trời đất ơi..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.4"
msgid "I've got it, dear."
msgstr "Tôi nhấc được mà, cưng ơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.5"
msgid "I'm more spry than I look!"
msgstr "Tôi nhanh nhẹn hơn vẻ bề ngoài nhiều nhé!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.6"
msgid "You just need to know how to lift!"
msgstr "Cậu chỉ cần biết cách nâng thế nào cho đúng thôi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.7"
msgid "No sweat off my back! Ho ho!"
msgstr "Nhẹ tựa lông hồng! Hô hô!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.8
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.8"
msgid "How invigorating!"
msgstr "Thật sảng khoái làm sao!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.9
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.9"
msgid "This gets the blood pumping!"
msgstr "Thứ này làm máu huyết lưu thông hẳn!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENGINEERING_CAN_UPGRADE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENGINEERING_CAN_UPGRADE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENTER_DARK"
msgid "I am in the dark."
msgstr "Tôi đang ở trong bóng tối."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENTER_LIGHT"
msgid "It is bright enough to see."
msgstr "Đủ sáng để nhìn thấy rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EXIT_GELBLOB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EXIT_GELBLOB"
msgid "I do not wish to experience that again."
msgstr "Tôi không muốn trải nghiệm cảm giác đó thêm lần nào nữa đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EYEOFTERROR_ARRIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EYEOFTERROR_ARRIVE"
msgid "Something from outside our dimension is trying to come in."
msgstr "Thứ gì đó từ ngoài chiều không gian của chúng ta đang cố đột nhập vào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EYEOFTERROR_FLYAWAY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EYEOFTERROR_FLYAWAY"
msgid "I suppose the daylight gives it a migraine."
msgstr "Chắc là ánh sáng ban ngày làm nó nhức đầu rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EYEOFTERROR_FLYBACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EYEOFTERROR_FLYBACK"
msgid "This ocular creature seems rather persistent."
msgstr "Sinh vật có hình con mắt này trông có vẻ khá lì lợm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FAN_OUT"
msgid "This fragile device has decayed."
msgstr "Cái thiết bị mỏng manh này đã hỏng rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FERTILIZER_RESEARCHED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FERTILIZER_RESEARCHED"
msgid "Even with my considerable gardening experience, there's always something new to learn."
msgstr "Dù tôi có kinh nghiệm làm vườn đáng kể, thì vẫn luôn có những thứ mới để học hỏi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FIRENETTLE_TOXIN.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FIRENETTLE_TOXIN.1"
msgid "Oh dear... I seem to be afflicted by the plant's toxin."
msgstr "Trời đất... có vẻ tôi đã bị nhiễm độc từ thực vật rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FIRENETTLE_TOXIN.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FIRENETTLE_TOXIN.2"
msgid "The toxin from those nettles carries a rather unpleasant burning sensation."
msgstr "Chất độc từ đám tầm ma đó mang lại cảm giác nóng rát khá khó chịu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FIRENETTLE_TOXIN_DONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FIRENETTLE_TOXIN_DONE"
msgid "Thankfully, the toxin's effects seem to be temporary."
msgstr "Thật may là tác dụng của chất độc có vẻ chỉ là tạm thời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FLARE_SEEN"
msgid "Someone's fired a flare."
msgstr "Ai đó vừa bắn pháo sáng kìa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FLOATER_HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FLOATER_HELD"
msgid "Hmm, rather convenient."
msgstr "Hừm, khá là tiện lợi đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FLOATER_LETGO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FLOATER_LETGO"
msgid "Time for a dip!"
msgstr "Đã đến lúc ngâm mình rồi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FLOAT_SWIM_TIRED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FLOAT_SWIM_TIRED"
msgid "I just need to catch my breath."
msgstr "Tôi chỉ cần lấy lại hơi sức thôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FOODMEMORY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FOODMEMORY"
msgid "only_used_by_warly"
msgstr "chỉ_được_sử_dụng_bởi_warly"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FREEDOM"
msgid "Freedom! I'll find a good book and tuck in."
msgstr "Tự do rồi! Tôi sẽ tìm một cuốn sách hay và nghiền ngẫm thôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_GATHER_MERM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_GATHER_MERM"
msgid "only_used_by_wurt"
msgstr "chỉ_được_sử_dụng_bởi_wurt"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_GHOSTDRAIN"
msgid "My humanity... it's slipping."
msgstr "Tính người của tôi... đang dần mất đi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_GHOST_QUEST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_GHOST_QUEST"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_GOT_DECON_MISTED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_GOT_DECON_MISTED"
msgid "Ah... my mind feels clearer, somehow."
msgstr "À... đầu óc tôi có vẻ thông suốt hơn rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE"
msgid "I believe my immunity from acidic rainfall has concluded."
msgstr "Tôi tin rằng khả năng miễn dịch với mưa axit của mình đã chấm dứt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE"
msgid "It would seem I am vulnerable to the flames once more."
msgstr "Có vẻ như tôi lại dễ bị tổn thương trước ngọn lửa một lần nữa rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE"
msgid "Ah yes. I have now arrived at Pearl's home."
msgstr "À phải rồi. Tôi đã đến nhà của Ngọc trai rồi đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT"
msgid "It's not responding for some reason."
msgstr "Không hiểu sao nó không phản hồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HIGHRESEARCH"
msgid "My my, that was extremely interesting!"
msgstr "Chà chà, thú vị quá cơ!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HOT"
msgid "The ambient temperature is high."
msgstr "Nhiệt độ xung quanh đang cao."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HOUNDS"
msgid "Something is approaching."
msgstr "Có thứ gì đó đang đến gần."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNGRY"
msgid "Librarian needs food."
msgstr "Thủ thư cần đồ ăn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNT_AVOID_FORK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNT_AVOID_FORK"
msgid "This trail will likely yield less dangerous results."
msgstr "Dấu vết này có lẽ sẽ dẫn đến kết quả ít nguy hiểm hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "The appearance of this track indicates recent activity."
msgstr "Sự xuất hiện của dấu chân này cho thấy hoạt động gần đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "The trail is no longer distinguishable."
msgstr "Dấu vết không còn nhận diện được nữa rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "The trail's been washed away by the precipitation."
msgstr "Dấu vết đã bị cơn mưa cuốn trôi mất tiêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNT_START_FORK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNT_START_FORK"
msgid "I suspect whatever lies at the end of this trail will be formidable."
msgstr "Tôi nghi ngờ bất cứ thứ gì ở cuối con đường này cũng sẽ rất đáng gờm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNT_SUCCESSFUL_FORK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNT_SUCCESSFUL_FORK"
msgid "It seems I've managed to track the creature without alerting it."
msgstr "Có vẻ như tôi đã lần theo được Sinh Vật Lạ mà không làm nó động tĩnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNT_WRONG_FORK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNT_WRONG_FORK"
msgid "Oh dear... I have the most peculiar sensation that I'm being observed."
msgstr "Trời đất... tôi có cảm giác kỳ lạ là mình đang bị theo dõi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "It needs just a touch more fecal assistance, I'd say."
msgstr "Tôi dám cá là nó cần thêm chút phân bón đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_INV_FULL"
msgid "I can't carry anything more."
msgstr "Tôi không thể mang thêm gì nữa rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_IS_FEASTING"
msgid "I hope everyone remembered to wash their hands before eating."
msgstr "Tôi hi vọng mọi người nhớ rửa tay trước khi ăn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD"
msgid "Poor dear, are you lost?"
msgstr "Tội nghiệp bé cưng, em lạc đường à?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "Ah, there you are."
msgstr "À, em đây rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "It seems I've discovered a kitten."
msgstr "Xem ra tôi vừa phát hiện ra một chú mèo con."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
msgid "I could see your tail from the distance, dear."
msgstr "Tôi có thể thấy cái đuôi của em từ đằng xa đấy, cưng à."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
msgid "Finding kittens is quite simple once you become accustomed to it."
msgstr "Tìm mèo con khá là đơn giản một khi bạn đã quen với nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE"
msgid "I found all of the missing kittens."
msgstr "Tôi đã tìm thấy tất cả những chú mèo con đi lạc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM"
msgid "We found all of the missing kittens."
msgstr "Chúng ta đã tìm thấy tất cả những chú mèo con đi lạc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE"
msgid "One more kitten has been encountered."
msgstr "Lại bắt gặp thêm một chú mèo con nữa rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME"
msgid "It appears we did not find them all in time."
msgstr "Có vẻ như chúng ta không tìm kịp tất cả chúng trong thời gian quy định."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP"
msgid "The end of the game draws closer."
msgstr "Trò chơi sắp kết thúc rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR"
msgid "I am distancing myself from where the game is happening."
msgstr "Tôi đang rời xa khu vực đang diễn ra trò chơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN"
msgid "The kittens should be over here, yes."
msgstr "Mấy chú mèo con chắc là ở quanh đây, đúng rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN"
msgid "Excuse me, I will join the feline search."
msgstr "Xin lỗi nhé, tôi sẽ tham gia cuộc tìm kiếm mèo cưng đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDEANDSEEK_START
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KITCOON_HIDEANDSEEK_START"
msgid "The game has commenced, I should start seeking."
msgstr "Trò chơi đã bắt đầu, tôi nên bắt đầu đi tìm thôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "Careful! It has summoned lesser Krampii."
msgstr "Cẩn thận! Nó đã triệu hồi thêm mấy con tiểu quỷ Krampus."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KLAUS_ENRAGE"
msgid "No sense throwing one's life away. Fall back!"
msgstr "Dại gì mà ném bỏ mạng sống chứ. Rút lui thôi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KLAUS_UNCHAINED"
msgid "Whatever enchantment restrained it has been undone."
msgstr "Bất cứ bùa chú nào kìm hãm nó đều đã bị phá giải."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KNOCKEDOUT"
msgid "Oof, that's one way to get some rest, I suppose."
msgstr "Hừm, cũng là một cách để chợp mắt nghỉ ngơi đấy chứ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "Thank goodness for this non-conductive clothing!"
msgstr "Tạ ơn trời đất vì bộ trang phục cách điện này!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_LIGHTSOUT_SHADOWHAND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_LIGHTSOUT_SHADOWHAND"
msgid "That insufferable hand appears to be impeding the puzzle's resolution!"
msgstr "Cái bàn tay khốn kiếp đó có vẻ đang cản trở việc giải đố rồi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_LOWRESEARCH"
msgid "Not a great resource, but there were useful bits."
msgstr "Không phải nguồn tài liệu xuất sắc, nhưng cũng có vài chi tiết hữu ích."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_LUNARGUARDIAN_INCOMING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_LUNARGUARDIAN_INCOMING"
msgid "Not you again!"
msgstr "Lại là ngươi à!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_LUNARHAIL_BIRD_CORPSES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_LUNARHAIL_BIRD_CORPSES"
msgid "Those poor birds never stood a chance in the hail storm."
msgstr "Mấy chú chim tội nghiệp đó không có chút cơ hội nào trong trận mưa đá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS"
msgid "What a dreadful sound."
msgstr "Âm thanh mới thảm hại làm sao."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_LUNAR_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_LUNAR_RIFT_MAX"
msgid "I suspect a powerful influx of energy is the source of that strange glow."
msgstr "Tôi nghi ngờ một luồng năng lượng cực mạnh chính là nguồn gốc của thứ ánh sáng kỳ lạ đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Well, yes. The rules of chess are simple. One may have no more than a pair of these pieces."
msgstr "Ừ thì đúng vậy. Luật chơi cờ vua rất đơn giản. Mỗi người không được có quá một cặp quân cờ này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MEGA_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MEGA_FLARE_SEEN"
msgid "Oh my. Someone is looking to initiate a conflict."
msgstr "Ôi trời. Ai đó đang muốn khơi mào một cuộc xung đột kìa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MITEGLAND_DEBUFF.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MITEGLAND_DEBUFF.1"
msgid "Oh dear... that gland is really disagreeing with me..."
msgstr "Trời đất... cái tuyến thể đó thực sự không hợp với tôi chút nào..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MITEGLAND_DEBUFF.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MITEGLAND_DEBUFF.2"
msgid "It appears that gland was not safe for consumption after all."
msgstr "Có vẻ như tuyến thể đó rốt cuộc lại không an toàn để tiêu thụ như Két Sắt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MITEGLAND_DEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MITEGLAND_DEBUFF_DONE"
msgid "That was a lesson painfully learned."
msgstr "Đó là một bài học nhớ đời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MONKEY_CURSE_1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MONKEY_CURSE_1"
msgid "What an unusual sensation."
msgstr "Thật là một cảm giác bất thường."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MONKEY_CURSE_CHANGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MONKEY_CURSE_CHANGE"
msgid "Oh dear. This is an unfortunate development."
msgstr "Ôi trời. Quả là một chuyển biến bất lợi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MONKEY_CURSE_CHANGEBACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MONKEY_CURSE_CHANGEBACK"
msgid "Ah. Much better."
msgstr "À. Dễ chịu hơn hẳn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW"
msgid "Nearly there."
msgstr "Sắp xong rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "I'm coming, dear."
msgstr "Tôi đến đây, cưng ơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "Tada!"
msgstr "Tada!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "Nearly there."
msgstr "Sắp xong rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "I'm coming, dear."
msgstr "Tôi đến đây, cưng ơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "Tada!"
msgstr "Tada!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "Nearly there."
msgstr "Sắp xong rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "I'm coming, dear."
msgstr "Tôi đến đây, cưng ơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "Tada!"
msgstr "Tada!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOONPOTION_FAILED"
msgid "Oh dear, that didn't go as planned."
msgstr "Ôi chao, mọi chuyện không diễn ra theo đúng kế hoạch rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOSQUITOS"
msgid "Cursed bloodsuckers!"
msgstr "Lũ hút máu chết tiệt!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "My mount requires attention of the medical variety."
msgstr "Thú cưỡi của tôi cần được chăm sóc y tế gấp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL"
msgid "Buzzards drawn by carrion, naturally. However, these exhibit signs of mutation."
msgstr "Chim kền kền bị thu hút bởi xác thối là điều hiển nhiên. Tuy nhiên, lũ này lại có dấu hiệu đột biến."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NODANGERGIFT"
msgid "Presents are not a top survival priority at this moment."
msgstr "Quà cáp không phải là ưu tiên sinh tồn hàng đầu lúc này đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NODANGERSIESTA"
msgid "I can't lie down when I'm in danger!"
msgstr "Tôi không thể nằm xuống khi đang gặp nguy hiểm được!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NODANGERSLEEP"
msgid "I can barely sleep even when I'm not in danger!"
msgstr "Ngay cả khi không gặp nguy hiểm thì tôi cũng khó mà chợp mắt được nữa là!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NODAYSLEEP"
msgid "I can hardly get to sleep at night, never mind during the day."
msgstr "Ban đêm tôi còn khó chợp mắt nữa là ban ngày."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "These caves don't make it any easier to sleep."
msgstr "Mấy cái hang này chẳng giúp gì cho việc ngủ nghỉ cả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOHUNGERSIESTA"
msgid "My hunger won't make relaxing any easier!"
msgstr "Cái bụng đói sẽ chẳng làm việc nghỉ ngơi dễ chịu hơn đâu!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOHUNGERSLEEP"
msgid "I can barely sleep even when I'm not starving!"
msgstr "Ngay cả khi không chết đói thì tôi cũng khó mà chợp mắt được!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I do believe I should dismount first."
msgstr "Tôi nghĩ mình nên xuống ngựa trước đã."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NONIGHTSIESTA"
msgid "I can't sleep, no matter where I lie down."
msgstr "Tôi không thể ngủ được, dù có nằm ở đâu đi nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "I couldn't possibly relax in these caves."
msgstr "Tôi không tài nào nghỉ ngơi nổi trong mấy cái hang này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOPUMPKINCARVINGONFIRE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOPUMPKINCARVINGONFIRE"
msgid "A hot mess indeed."
msgstr "Quả là một mớ hỗn độn nóng bỏng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT"
msgid "No need to turn the light off dear, I won't be able to sleep either way."
msgstr "Không cần tắt đèn đâu cưng, kiểu gì tôi cũng chẳng ngủ được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOSLEEPONFIRE"
msgid "Even if I could sleep, these temperatures are highly unsafe."
msgstr "Dù có ngủ được đi chăng nữa, nhiệt độ này cũng quá mất an toàn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOWARDROBEONFIRE"
msgid "As you can plainly see, it is ablaze."
msgstr "Như bạn thấy đấy, nó đang bùng cháy rực lửa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NO_ABIGAIL_FLOWER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NO_ABIGAIL_FLOWER"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NO_TRAP"
msgid "A cinch!"
msgstr "Dễ như trở bàn tay!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "Let's give that another go, shall we?"
msgstr "Thử lại lần nữa xem sao nào?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "I suppose there will be no fish dinner for me this time."
msgstr "Chắc bữa tối Câu Cá của tôi hỏng bét rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "Patience is a virtue."
msgstr "Kiên nhẫn là một đức tính tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "I do not appreciate the tardiness of these fish."
msgstr "Tôi không thích tính lề mề của lũ Câu Cá này chút nào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "Perhaps if I tried a different lure..."
msgstr "Biết đâu thử một loại mồi nhử khác sẽ hiệu quả hơn..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "I wonder if I could get some reading done while I wait."
msgstr "Tự hỏi không biết mình có thể đọc vài trang sách trong lúc chờ đợi không nhỉ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "Oh dear, I must have put too much strain on my line."
msgstr "Ôi trời, chắc tôi đã siết dây câu quá mạnh rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "The line must remain taut!"
msgstr "Dây câu phải luôn được căng!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "The megafauna have set their eyes on us."
msgstr "Đám sinh vật khổng lồ đã nhắm đến chúng ta rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OFF_SCRIPT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OFF_SCRIPT"
msgid "Perhaps a review of the script is in order, dear?"
msgstr "Có lẽ chúng ta nên xem lại kịch bản một chút nhỉ, cưng?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OTTERBOAT_DENBROKEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OTTERBOAT_DENBROKEN"
msgid "It seems the den was more crucial to this platform's structural integrity than I surmised."
msgstr "Có vẻ cái hang ổ lại đóng vai trò quan trọng đối với độ bền cấu trúc của chiếc bè này hơn tôi tưởng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS"
msgid "This platform's construction will not withstand deeper waters."
msgstr "Cấu trúc của chiếc bè này sẽ không chịu được vùng nước Sâu hơn đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_PECKED"
msgid "Settle down, this instant!"
msgstr "Nằm im ngay lập tức cho tôi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_PETRIFED_TREES"
msgid "The chemical reaction has been catalyzed..."
msgstr "Phản ứng hóa học đã được xúc tác..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "This plant is exhibiting concerning signs."
msgstr "Thực vật này đang hiển thị các dấu hiệu đáng lo ngại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_PIRATES_ARRIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_PIRATES_ARRIVE"
msgid "Oh dear, it's those troublemakers playing their loud music again..."
msgstr "Ôi trời, lại là mấy kẻ gây rối đang bật nhạc inh ỏi đó à..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_PLANT_RANDOMSEED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_PLANT_RANDOMSEED"
msgid "Once it grows I'll be able to identify the species."
msgstr "Lớn lên rồi tôi mới nhận diện được loài của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_PLANT_RESEARCHED.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_PLANT_RESEARCHED.1"
msgid "I've gained a bit more insight into the workings of this species."
msgstr "Tôi đã hiểu thêm được chút ít về cơ chế hoạt động của loài này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_POCKETWATCH_PORTAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_POCKETWATCH_PORTAL"
msgid "Oof! Might I suggest realigning the exit point closer to the ground next time, dear?"
msgstr "Úi! Lần tới có thể làm ơn căn chỉnh điểm thoát hiểm sát mặt đất hơn một chút được không hả cưng?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_PREFALLINVOID
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_PREFALLINVOID"
msgid "It will not hold!"
msgstr "Nó không chịu nổi đâu!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_QUAKE"
msgid "A tremor! At least magnitude seven on the Richter scale."
msgstr "Một trận động đất! Ít nhất là độ bảy trên thang Richter."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT"
msgid "This is obviously not the correct place for it."
msgstr "Đây rõ ràng không phải là chỗ thích hợp cho nó rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_RABBITKING_AGGRESSIVE"
msgid "Some form of creature is aggressively tunneling in the subterrain."
msgstr "Có dạng sinh vật nào đó đang đào bới hung hăng dưới lòng đất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_RABBITKING_LUCKY"
msgid "What a peculiar breed of rabbit!"
msgstr "Thật là một giống Thỏ kỳ lạ!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_RABBITKING_LUCKYCAUGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_RABBITKING_LUCKYCAUGHT"
msgid "Got you!"
msgstr "Bắt được ngươi rồi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_RABBITKING_PASSIVE"
msgid "I hear the burrowing of a small creature."
msgstr "Tôi nghe thấy tiếng đào bới của một sinh vật nhỏ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_REPELLED"
msgid "There's magic at work here."
msgstr "Có phép thuật đang tác động ở đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_RESEARCH"
msgid "No information should go to waste, no matter how trivial."
msgstr "Không nên để lãng phí bất kỳ thông tin nào, dù cho nó có vụn vặt đến đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "Oof! Back on my feet!"
msgstr "Úi chà! Lại đứng vững được rồi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "Off you go now."
msgstr "Đi đi nào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_REVIVING_CORPSE"
msgid "Hold on a moment, dear."
msgstr "Chờ một lát nhé, cưng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ROYALTY.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ROYALTY.1"
msgid "Your Highness."
msgstr "Điện hạ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ROYALTY.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ROYALTY.2"
msgid "Your Grace."
msgstr "Thưa Nữ Công tước."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ROYALTY.3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ROYALTY.3"
msgid "You wear her crown well."
msgstr "Trông cô đội vương miện hợp phết đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ROYALTY_JOKER.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ROYALTY_JOKER.1"
msgid "Your \"Highness\"."
msgstr "\"Điện hạ\"."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ROYALTY_JOKER.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ROYALTY_JOKER.2"
msgid "Your \"Grace\"."
msgstr "Thưa \"Nữ Công tước\"."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ROYALTY_JOKER.3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ROYALTY_JOKER.3"
msgid "You wear that \"crown\" well."
msgstr "Trông cô đội cái \"vương miện\" đó hợp phết đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_RUINS_RESET"
msgid "Careful, the monsters are back."
msgstr "Cẩn thận, lũ quái vật đã quay lại rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SACREDCHEST_NO"
msgid "Shoot. I thought I had it."
msgstr "Chết tiệt. Cứ tưởng là ăn được rồi chứ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SACREDCHEST_YES"
msgid "That did the trick."
msgstr "Thế là ổn thỏa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SCRAPBOOK_FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SCRAPBOOK_FULL"
msgid "My scrapbook has already been completed."
msgstr "Cuốn sổ lưu niệm của tôi đã hoàn thành rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SECURITY_PULSE_FOLLOWING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SECURITY_PULSE_FOLLOWING"
msgid "It is attracted to this device."
msgstr "Nó bị thu hút bởi thiết bị này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SHADOWTHRALL_STEALTH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SHADOWTHRALL_STEALTH"
msgid "I've been bitten by a camouflaged creature!"
msgstr "Tôi vừa bị một sinh vật ngụy trang cắn đấy!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SHADOW_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SHADOW_RIFT_MAX"
msgid "As nonsensical as it sounds, there is something dark about that \"light\"..."
msgstr "Nghe có vẻ vô lý, nhưng có thứ gì đó rất hắc ám ẩn chứa trong \"ánh sáng\" đó..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SHELTER"
msgid "Ah, a welcome respite."
msgstr "À, một chốn dung thân đáng hoan nghênh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SISTURN_FULL_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SISTURN_FULL_BLOSSOM"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SISTURN_FULL_EVIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SISTURN_FULL_EVIL"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SNARED"
msgid "You can't hold me for long, dear."
msgstr "Cưng giữ chân tôi không lâu được đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SNARED_IVY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SNARED_IVY"
msgid "Goodness, my garden seems to have quite an aggressive weed problem."
msgstr "Chúa ơi, khu vườn của tôi hình như đang gặp vấn nạn cỏ dại hoành hành dữ dội."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SNOWBALL_NO_SNOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SNOWBALL_NO_SNOW"
msgid "There's no snow here to roll it in."
msgstr "Chỗ này làm gì có tuyết để mà lăn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SNOWBALL_TOO_BIG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SNOWBALL_TOO_BIG"
msgid "It has reached its full size."
msgstr "Nó đã đạt kích thước tối đa rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SOAKED"
msgid "Positively soaked."
msgstr "Ướt sũng nước luôn rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SPOOKED"
msgid "Goodness gracious!"
msgstr "Ôi trời đất ơi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TALK_TO_PLANTS.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TALK_TO_PLANTS.1"
msgid "Talking to my little garden always seemed to help it grow."
msgstr "Trò chuyện với khu vườn nhỏ luôn giúp chúng lớn nhanh hơn thì phải."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TALK_TO_PLANTS.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TALK_TO_PLANTS.2"
msgid "My, those leaves are coming in quite nicely, dear!"
msgstr "Chà, mấy cái lá đâm chồi đẹp phết đấy chứ, cưng!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TALK_TO_PLANTS.3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TALK_TO_PLANTS.3"
msgid "All one needs to thrive is a bit of love and care, isn't that right?"
msgstr "Thứ mà mọi sinh vật cần để phát triển chỉ là chút tình thương và chăm sóc, đúng không nào?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TALK_TO_PLANTS.4
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TALK_TO_PLANTS.4"
msgid "No need to rush dear, you just take your time."
msgstr "Không cần phải vội đâu cưng, cứ thong thả thôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "How are you doing today? Do you have enough water?"
msgstr "Hôm nay thế nào rồi? Cưng có đủ nước không đấy?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_THORNS"
msgid "Dang spinose structure!"
msgstr "Cái cấu trúc gai góc chết tiệt!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_THURIBLE_OUT"
msgid "That's that."
msgstr "Thế là hết."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TICOON_ABANDONED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TICOON_ABANDONED"
msgid "It appears I will have to continue the search alone."
msgstr "Có vẻ tôi sẽ phải tiếp tục cuộc tìm kiếm một mình rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TICOON_DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TICOON_DEAD"
msgid "Oh, how terrible! I suppose I'm on my own now."
msgstr "Ôi, tệ thật đấy! Chắc tôi đành tự xoay sở một mình thôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TICOON_GET_LEADER_ATTENTION
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TICOON_GET_LEADER_ATTENTION"
msgid "Don't worry, dear, I'm coming."
msgstr "Đừng lo, cưng ơi, tôi đến đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TICOON_LOST_KITCOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TICOON_LOST_KITCOON"
msgid "Someone arrived before us and found our kitten."
msgstr "Ai đó đã đến trước và tìm thấy mèo con của chúng ta rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TICOON_NEAR_KITCOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TICOON_NEAR_KITCOON"
msgid "He believes we're near one of the kittens."
msgstr "Nó tin rằng chúng ta đang ở gần một trong những chú mèo con."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TICOON_NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TICOON_NOTHING_TO_TRACK"
msgid "There appears to be a clear lack of hiding evidence."
msgstr "Dường như hoàn toàn không có chút manh mối ẩn náu nào cả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TICOON_START_TRACKING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TICOON_START_TRACKING"
msgid "I believe he has caught the kitten's scent."
msgstr "Tôi tin là nó đã đánh hơi được mùi của mèo con rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TICOON_WAITING_FOR_LEADER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TICOON_WAITING_FOR_LEADER"
msgid "He is awaiting my lead."
msgstr "Nó đang đợi tôi dẫn đường đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TOADESCAPED"
msgid "It has burrowed away."
msgstr "Nó đã đào hang trốn mất rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TOADESCAPING"
msgid "It will need to burrow soon to rehydrate its skin."
msgstr "Nó sẽ cần phải sớm đào hang xuống Hang Chuột để cung cấp nước cho da."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TOOL_SLIP"
msgid "My grip!"
msgstr "Tay trượt quá!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TOOL_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TOOL_TOOWEAK"
msgid "This will require a more robust tool."
msgstr "Việc này đòi hỏi một công cụ cứng cáp hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TORCH_OUT"
msgid "I need another light."
msgstr "Tôi cần ngọn đuốc khác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "Goodness! That's one way to travel."
msgstr "Trời ạ! Đúng là một cách di chuyển độc đáo thật."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TRAP_WENT_OFF"
msgid "Eek!"
msgstr "Ái!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_UNIMPLEMENTED"
msgid "Tut tut, I don't think it's quite ready."
msgstr "Chậc chậc, tôi không nghĩ nó đã sẵn sàng đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_VAULT_SHADOW_ASSIST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_VAULT_SHADOW_ASSIST"
msgid "It would seem we are aligned with the shadowy beasts against a common foe."
msgstr "Có vẻ như chúng ta đang đồng minh với đám quái vật bóng tối để chống lại kẻ thù chung."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_VAULT_TELEPORTER_DOES_NOTHING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_VAULT_TELEPORTER_DOES_NOTHING"
msgid "It must be an issue with the receiving end."
msgstr "Chắc là có vấn đề ở đầu nhận tín hiệu rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WASHED_ASHORE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WASHED_ASHORE"
msgid "I hope my books weren't ruined."
msgstr "Tôi hi vọng mấy cuốn sách của mình không bị hỏng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WEAK_RAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WEAK_RAT"
msgid "I'm afraid it's in no condition to race."
msgstr "E rằng nó không có phong độ để thi đấu đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WEAPON_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WEAPON_TOOWEAK"
msgid "This calls for something more formidable."
msgstr "Cái này cần thứ gì đó lợi hại hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WEIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WEIGHT"
msgid "Weight: {weight}"
msgstr "Cân nặng: {weight}"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WEIGHT_HEAVY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WEIGHT_HEAVY"
msgid "Weight: {weight}\nThis specimen is decidedly larger than average."
msgstr "Cân nặng: {weight}\nCon này rõ ràng là lớn hơn mức trung bình rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WENDY_BABYSITTER_SET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WENDY_BABYSITTER_SET"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WENDY_BABYSITTER_STOP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WENDY_BABYSITTER_STOP"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WET"
msgid "I wonder what my body's saturation point is..."
msgstr "Tự hỏi điểm bão hòa của cơ thể mình là bao nhiêu nhỉ..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WETTER"
msgid "Wet, wet, wet!"
msgstr "Ướt, ướt hết cả rồi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WINCH_CLAW_MISS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WINCH_CLAW_MISS"
msgid "This will require a bit more precision on my part."
msgstr "Việc này đòi hỏi sự chuẩn xác hơn từ tôi đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WINCH_CLAW_NO_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WINCH_CLAW_NO_ITEM"
msgid "Oh dear... perhaps it's time to clean my glasses."
msgstr "Ôi trời... có lẽ đã đến lúc lau kính rồi đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WINTERS_FEAST_BUFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WINTERS_FEAST_BUFF"
msgid "Intriguing! I appear to be filled with \"cheer\"."
msgstr "Thật thú vị! Hình như tôi đang tràn ngập \"sự hân hoan\" thì phải."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WINTERS_FEAST_BUFF_OVER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WINTERS_FEAST_BUFF_OVER"
msgid "That was very illuminating."
msgstr "Thật là một trải nghiệm sáng tỏ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WOLFGANG_BEGIN_COACHING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WOLFGANG_BEGIN_COACHING"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WOLFGANG_END_COACHING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WOLFGANG_END_COACHING"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WOLFGANG_MIGHTY_COACHING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WOLFGANG_MIGHTY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WOLFGANG_NOTEAM.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WOLFGANG_NOTEAM.1"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WOLFGANG_NOTEAM.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WOLFGANG_NOTEAM.2"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WOLFGANG_NOTEAM.3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WOLFGANG_NOTEAM.3"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WOLFGANG_WIMPY_COACHING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WOLFGANG_WIMPY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WORMHOLE"
msgid "A detailed lesson in biology!"
msgstr "Một bài học sinh học chi tiết!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WORMS"
msgid "Something nasty intends to rear its head."
msgstr "Có thứ tồi tệ sắp ló mặt ra kìa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WORMS_BOSS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WORMS_BOSS"
msgid "Something monstrous approaches."
msgstr "Có thứ gì đó quái dị đang đến gần."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT"
msgid "Utterly disappointing."
msgstr "Thất vọng toàn tập."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WX_SCANNER_NEW_FOUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WX_SCANNER_NEW_FOUND"
msgid "only_used_by_wx78"
msgstr "chỉ_được_sử_dụng_bởi_wx78"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_YOTB_LEARN_NEW_PATTERN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_YOTB_LEARN_NEW_PATTERN"
msgid "I do believe I can fabricate a new bovine costume now."
msgstr "Tôi tin là bây giờ mình có thể may một bộ trang phục bò mới rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_YOTD_NOBOATS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_YOTD_NOBOATS"
msgid "I must be in closer proximity to the starting point before we can begin."
msgstr "Tôi phải lại gần Điểm Xuất Phát hơn trước khi chúng ta có thể bắt đầu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_YOTD_NOCHECKPOINTS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_YOTD_NOCHECKPOINTS"
msgid "The matter of placing checkpoints seems to have been overlooked."
msgstr "Việc đặt các trạm kiểm soát dường như đã bị bỏ sót thì phải."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_YOTD_NOTENOUGHBOATS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_YOTD_NOTENOUGHBOATS"
msgid "I should endeavor to make some space around the starting point."
msgstr "Tôi nên cố gắng tạo ra chút không gian xung quanh Điểm Xuất Phát."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_YOTH_ONCOOLDOWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_YOTH_ONCOOLDOWN"
msgid "It seems the mechanical knights are indisposed at the moment."
msgstr "Có vẻ như mấy hiệp sĩ máy đang bận không rảnh lúc này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANOUNCE_MUTATED_BIRD_ATTACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANOUNCE_MUTATED_BIRD_ATTACK"
msgid "The mutated fowl are attacking."
msgstr "Lũ gia cầm đột biến đang tấn công kìa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.DEER"
msgid "This will be easy."
msgstr "Dễ như trở bàn tay."

#. STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.GENERIC"
msgid "Combat!"
msgstr "Chiến đấu thôi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.PIG"
msgid "Foul cad!"
msgstr "Tên đểu cáng!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.PREY"
msgid "Just give up."
msgstr "Bỏ cuộc đi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.SPIDER"
msgid "Behave!"
msgstr "Cư xử cho đúng mực vào!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.SPIDER_WARRIOR"
msgid "Respect your elders!"
msgstr "Hãy tôn trọng người lớn tuổi đi chứ!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.COMBAT_QUIT.GENERIC"
msgid "Well, that's over."
msgstr "Rồi, thế là xong."

#. STRINGS.CHARACTERS.WICKERBOTTOM.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.COMBAT_QUIT.PIG"
msgid "Oh dear."
msgstr "Ôi trời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.COMBAT_QUIT.PREY"
msgid "I must reassess the situation."
msgstr "Tôi phải đánh giá lại tình hình mới được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.COMBAT_QUIT.SPIDER"
msgid "I must read up on this!"
msgstr "Tôi phải tìm đọc thêm về cái này mới được!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "Back to the drawing board!"
msgstr "Lại phải quay lại vạch xuất phát rồi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL.LEVEL1.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL.LEVEL1.1"
msgid "Fascinating. Can you speak, specter?"
msgstr "Thật hấp dẫn. Ngươi có nói được không thế, bóng ma?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL.LEVEL1.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL.LEVEL1.2"
msgid "Fascinating. Can you speak, specter?"
msgstr "Thật hấp dẫn. Ngươi có nói được không thế, bóng ma?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL.LEVEL2.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL.LEVEL2.1"
msgid "Fascinating. Can you speak, specter?"
msgstr "Thật hấp dẫn. Ngươi có nói được không thế, bóng ma?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL.LEVEL2.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL.LEVEL2.2"
msgid "Fascinating. Can you speak, specter?"
msgstr "Thật hấp dẫn. Ngươi có nói được không thế, bóng ma?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL.LEVEL3.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL.LEVEL3.1"
msgid "Fascinating. Can you speak, specter?"
msgstr "Thật hấp dẫn. Ngươi có nói được không thế, bóng ma?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL.LEVEL3.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL.LEVEL3.2"
msgid "Fascinating. Can you speak, specter?"
msgstr "Thật hấp dẫn. Ngươi có nói được không thế, bóng ma?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "Ah... I'm not familiar with this strain of flower."
msgstr "À... tôi không rành về dòng hoa này lắm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "Does it expect something of me?"
msgstr "Nó đang mong đợi điều gì từ tôi sao?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "I feel I should set it down now."
msgstr "Tôi cảm thấy mình nên đặt nó xuống ngay."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "It's emitting a strange energy."
msgstr "Nó đang tỏa ra một nguồn năng lượng kỳ lạ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "That flower has perked up quite a bit."
msgstr "Bông hoa đó đã tươi tỉnh lên khá nhiều rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "Its magic has reached maximum potency."
msgstr "Phép thuật của nó đã đạt đến mức tối đa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "Odd..."
msgstr "Kỳ lạ thật..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "It's emitting a strange energy."
msgstr "Nó đang tỏa ra một nguồn năng lượng kỳ lạ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "The flower's energy is growing powerful."
msgstr "Năng lượng của bông hoa đang trở nên mạnh mẽ hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED"
msgid "It follows a particular movement pattern."
msgstr "Nó tuân theo một quy luật di chuyển cụ thể."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABYSSPILLAR_MINION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABYSSPILLAR_MINION.GENERIC"
msgid "A statue of a large insectoid form."
msgstr "Bức tượng có hình thù côn trùng lớn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABYSSPILLAR_TRIAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABYSSPILLAR_TRIAL"
msgid "A mechanical lever designed to actuate a mechanism."
msgstr "Một chiếc cần gạt/đòn bẩy cơ học được thiết kế để kích hoạt cơ chế."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "I feel a compulsive urge to activate it, again and again."
msgstr "Tôi cảm thấy một sự thôi thúc cuồng nhiệt muốn kích hoạt nó, hết lần này đến lần khác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACORN"
msgid "Deciduous seeds encased in a Pericarp."
msgstr "Hạt rụng nằm trong vỏ quả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACORN_COOKED"
msgid "The poison has been successfully cooked out of them."
msgstr "Chất độc bên trong đã được nấu chín loại bỏ thành công."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACORN_SAPLING"
msgid "Deciduous seeds approaching maturity."
msgstr "Hạt rụng đang dần trưởng thành."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ADVENTURE_PORTAL"
msgid "That violates some pretty fundamental physical laws."
msgstr "Cái đó vi phạm mấy định luật vật lý cơ bản đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIANHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIANHAT"
msgid "The multitudes of knowledge it contains... if only I could write it all down..."
msgstr "Vô số kiến thức mà nó chứa đựng... ước gì tôi có thể ghi chép lại hết..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIANHATSHARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIANHATSHARD"
msgid "These shards hold a significant amount of energy on their own."
msgstr "Mấy mảnh vỡ này tự thân chúng đã chứa đựng một lượng năng lượng đáng kể rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_CONTAINED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_CONTAINED"
msgid "I wonder what he means to do with all that energy."
msgstr "Tự hỏi anh ta định làm gì với ngần ấy năng lượng nhỉ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD"
msgid "Strange, I was expecting a bit more than that."
msgstr "Lạ thật, tôi cứ nghĩ nó phải gớm ghiếc hơn thế cơ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC"
msgid "Our activities seem to have triggered a defense mechanism of sorts."
msgstr "Các hoạt động của chúng ta hình như đã kích hoạt một cơ chế phòng vệ nào đó rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT"
msgid "It has returned bursting with lunar energy."
msgstr "Nó đã quay trở lại với nguồn năng lượng mặt trăng sục sôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT"
msgid "This one is most definitely unique."
msgstr "Cái này thật sự rất độc đáo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD"
msgid "I doubt it will stay inert for long."
msgstr "Ta nghi ngờ nó sẽ nằm im bất động được lâu đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC"
msgid "Interesting, it seems to utilize aspects of the altars for combat."
msgstr "Thật thú vị, có vẻ như nó tận dụng các khía cạnh của bệ thờ để chiến đấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE"
msgid "I should endeavor to not become trapped by its barriers."
msgstr "Ta nên cố gắng để không bị kẹt trong các hàng rào của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE3"
msgid "If my assumptions are correct, this should be its final form."
msgstr "Nếu giả thuyết của ta chính xác, đây sẽ là hình thái cuối cùng của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD"
msgid "With the energy removed, I doubt it will be able to re-form."
msgstr "Khi đã rút cạn năng lượng, ta nghi ngờ nó có thể tái tạo lại được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB"
msgid "Interesting, it seems to have retained the energy that powered it."
msgstr "Thật thú vị, có vẻ như nó vẫn giữ lại nguồn năng lượng cung cấp cho nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP"
msgid "They appear to have a sleep inducing effect. Best to stay away."
msgstr "Chúng có vẻ gây ra hiệu ứng buồn ngủ. Tốt nhất là nên tránh xa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT"
msgid "A curious amalgamation of machine parts and sentient lunar energy."
msgstr "Một sự kết hợp kỳ lạ giữa các bộ phận máy móc và năng lượng mặt trăng có tri giác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.AMULET"
msgid "A relic from another time."
msgstr "Một thánh tích từ thời đại khác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCHOR"
msgid "An anchor for our vessel."
msgstr "Một sợi dây neo cho tàu của chúng ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCHOR_ITEM"
msgid "It will allow us to create an anchor for our ships."
msgstr "Nó sẽ cho phép chúng ta tạo ra một sợi dây neo cho các con tàu của mình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTFRUIT_GEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "I suspect burning away the tough outer skin might reveal something at its core."
msgstr "Ta đoán rằng việc thiêu rụi lớp vỏ bọc cứng bên ngoài có thể sẽ hé lộ thứ gì đó ở bên trong."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "If consumed, it seems to improve one's vision in the darkness."
msgstr "Nếu tiêu thụ nó, tầm nhìn trong bóng đêm của người dùng có vẻ sẽ được cải thiện."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "A bit easier to digest, but lacking in any vision-improving effects."
msgstr "Dễ tiêu hóa hơn một chút, nhưng lại không có tác dụng cải thiện thị lực."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
msgid "How interesting, it seems to produce its own heat from within."
msgstr "Thật thú vị làm sao, có vẻ như nó tự sinh ra nhiệt từ bên trong."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_GEM.STUMP"
msgid "A shame, really."
msgstr "Thật đáng tiếc làm sao."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
msgid "Could the sense of unease I feel be a part of its defense mechanism?"
msgstr "Liệu cảm giác bất an mà ta cảm thấy có phải là một phần cơ chế phòng thủ của nó không?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
msgid "As I thought, the sense of unease has passed."
msgstr "Đúng như ta nghĩ, cảm giác bất an đã qua đi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
msgid "It appears to be growing nicely."
msgstr "Nó có vẻ đang phát triển rất tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON"
msgid "Perhaps this is not the right time of year for it to thrive."
msgstr "Có lẽ đây không phải là thời điểm thích hợp trong năm để nó phát triển mạnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE"
msgid "This may not be a suitable environment for it."
msgstr "Đây có lẽ không phải là môi trường thích hợp cho nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_SAPLING_ITEM"
msgid "I will endeavor to find a suitable environment for it."
msgstr "Ta sẽ cố gắng tìm một môi trường phù hợp cho nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_SEED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENTTREE_SEED"
msgid "It's difficult to identify the species at this stage of development."
msgstr "Thật khó để xác định loài ở giai đoạn phát triển này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_ALTAR"
msgid "A monument to some long dead god."
msgstr "Một tượng đài kính cẩn dành cho vị thần đã chết từ lâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "Parts of this are missing."
msgstr "Một số bộ phận của cái này đã bị thiếu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_HUSK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_HUSK"
msgid "It's obvious which of these ancients was the perpetrator."
msgstr "Thật rõ ràng kẻ chủ谋 trong số những tàn tích này là ai."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_STATUE"
msgid "This seems mystically aligned to the world."
msgstr "Cái này có vẻ gắn kết một cách huyền bí với thế giới."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANIMAL_TRACK"
msgid "A sign of animal activity. Leads away."
msgstr "Một bảng hiệu thể hiện hoạt động của động vật. Dẫn hướng đi ra ngoài."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTCHOVIES"
msgid "Ah, I see! A brand new oceanic species!"
msgstr "Ồ, ta hiểu rồi! Một loài sinh vật biển hoàn toàn mới!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLION.GENERIC"
msgid "Ah. You must be behind all the seismic activity."
msgstr "À. Ngươi hẳn là thủ phạm đằng sau mọi hoạt động địa chấn này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLION.UNHAPPY"
msgid "Panthera auropunctata is looking irritable."
msgstr "Panthera auropunctata trông có vẻ đang cáu kỉnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLION.VERYHAPPY"
msgid "It has been mollified with tributes."
msgstr "Nó đã được làm dịu đi bằng các vật phẩm cống nạp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLIONHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLIONHAT"
msgid "It's quite convenient for landscaping."
msgstr "Nó khá tiện lợi cho việc làm vườn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLIONTRINKET"
msgid "It appears to be a child's plaything."
msgstr "Nó có vẻ là một món đồ chơi của trẻ con."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "An impressive piece of ancient engineering."
msgstr "Một tác phẩm kỹ thuật cổ đại ấn tượng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "These parts appear to be inoperative."
msgstr "Các bộ phận này có vẻ không còn hoạt động được nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "Now it's truly derelict."
msgstr "Bây giờ thì nó thực sự bị bỏ hoang rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "It's got a bit to go before it's ready."
msgstr "Nó còn một chút thời gian nữa mới sẵn sàng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "Almost done!"
msgstr "Sắp xong rồi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "Supper time!"
msgstr "Đến giờ ăn tối rồi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "I suspect it must have had a purpose specific to these chambers."
msgstr "Ta nghi ngờ nó phải có một mục đích cụ thể dành riêng cho những căn phòng này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "It seems to require an outside power source to activate."
msgstr "Nó có vẻ cần một nguồn năng lượng bên ngoài để kích hoạt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "Somehow, the ancients devised a way to store knowledge in liquid form."
msgstr "Bằng cách nào đó, người xưa đã nghĩ ra cách lưu trữ tri thức dưới dạng chất lỏng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "It appears to lack an energy source."
msgstr "Nó có vẻ thiếu một nguồn năng lượng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "These chambers appear to pre-date the rest of the ruins."
msgstr "Những căn phòng này có vẻ xuất hiện trước phần còn lại của tàn tích."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "There must be a manual somewhere."
msgstr "Chắc phải có một cuốn sổ tay hướng dẫn ở đâu đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "A shame, it appears to no longer be operational."
msgstr "Thật đáng tiếc, nó có vẻ không còn hoạt động được nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "The design is reminiscent of the Gateways we've traversed through before."
msgstr "Thiết kế này gợi nhớ đến những Cổng Không Gian mà chúng ta từng đi qua trước đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "The path to discovery awaits."
msgstr "Con đường khám phá đang chờ đón."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "It appears there are no more artifacts to find."
msgstr "Có vẻ như không còn cổ vật nào để tìm kiếm nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "How exciting! This technology most likely hasn't been used in hundreds of years!"
msgstr "Thật hào hứng làm sao! Công nghệ này rất có thể đã không được sử dụng trong hàng trăm năm qua!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "Fascinating! These glyphs seem to be the base that their language evolved from."
msgstr "Thật hấp dẫn! Những ký hiệu này có vẻ là nền tảng mà ngôn ngữ của họ phát triển từ đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2"
msgid "The introduction of shadow fuel must have had a tremendous impact on their culture."
msgstr "Sự ra đời của nhiên liệu bóng tối hẳn đã tác động rất lớn đến nền văn hóa của họ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3"
msgid "These glyphs must pre-date their discovery of the shadow fuel."
msgstr "Những ký hiệu này chắc phải có trước thời điểm họ phát hiện ra nhiên liệu bóng tối."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
msgid "This glyph in particular keeps repeating... if only I could decipher its meaning."
msgstr "Ký hiệu này cứ lặp đi lặp lại mãi... giá như ta có thể giải mã được ý nghĩa của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
msgid "This will need further study."
msgstr "Cái này cần phải được nghiên cứu thêm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
msgid "It appears to be a remarkably advanced security system."
msgstr "Nó có vẻ là một hệ thống bảo mật cực kỳ tiên tiến."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
msgid "I wonder what its intended purpose was."
msgstr "Ta tự hỏi mục đích ban đầu của nó là gì."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_SECURITY_PULSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_SECURITY_PULSE"
msgid "It seems unwise to follow it."
msgstr "Đi theo nó có vẻ là một ý kiến không khôn ngoan."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_SWITCH.GEMS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_SWITCH.GEMS"
msgid "It appears to require a specific gem to activate."
msgstr "Nó có vẻ cần một viên ngọc cụ thể để kích hoạt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_SWITCH.VALID
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARCHIVE_SWITCH.VALID"
msgid "The pedestals seem to draw power from these gems."
msgstr "Các bệ đỡ có vẻ thu hút năng lượng từ những viên ngọc này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORDRAGONFLY"
msgid "Pyrotechnic armor!"
msgstr "Giáp pháo hoa!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORDREADSTONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORDREADSTONE"
msgid "Extremely durable, and surprisingly lightweight."
msgstr "Cực kỳ bền bỉ, và nhẹ đến ngạc nhiên."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORGRASS"
msgid "Surprisingly effective with enough layers."
msgstr "Hiệu quả đến ngạc nhiên khi xếp đủ các lớp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORMARBLE"
msgid "An interesting choice of materials."
msgstr "Một sự lựa chọn vật liệu khá thú vị."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORRUINS"
msgid "A hardy Thulecite armor."
msgstr "Một bộ giáp Thulecite cứng cáp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORSKELETON"
msgid "Now it's an exoskeleton. Ho ho!"
msgstr "Bây giờ nó là một bộ giáp ngoại cốt cách rồi. Hô hô!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORSLURPER"
msgid "A disgusting and magical garment."
msgstr "Một món trang phục kỳ diệu và kinh tởm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORSNURTLESHELL"
msgid "It is quite capacious."
msgstr "Nó khá là rộng rãi đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORWAGPUNK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORWAGPUNK"
msgid "I do wish it wasn't quite so noisy."
msgstr "Ta thực sự ước gì nó đừng quá ồn ào như thế."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORWOOD"
msgid "Crude plate mail cobbled together from log sections."
msgstr "Giáp tấm thô sơ được chắp vá từ các khúc gỗ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_BRAMBLE"
msgid "I believe our friend knit it himself."
msgstr "Ta tin rằng người bạn của chúng ta đã tự đan nó đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_CARROTLURE"
msgid "This will be a big hit with the bunnymen."
msgstr "Cái này sẽ rất được lòng đám người thỏ đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_LUNARPLANT"
msgid "Surprisingly effective plant-based armor."
msgstr "Bộ giáp làm từ thực vật mang lại hiệu quả bất ngờ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_LUNARPLANT_HUSK"
msgid "Plant-based, plant-made, and plant-worn."
msgstr "Làm từ thực vật, tạo ra từ thực vật, và được mặc bởi thực vật."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_SANITY"
msgid "A protective shroud that transfers attacks to another dimension."
msgstr "Một lớp màn bảo vệ chuyển hướng các đòn tấn công sang một chiều không gian khác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_VOIDCLOTH"
msgid "Armor against metaphysical damage."
msgstr "Giáp chống lại sát thương siêu hình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_YOTH_KNIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_YOTH_KNIGHT"
msgid "The rose decorating this armor is the maker's insignia."
msgstr "Bông hồng trang trí trên bộ giáp này chính là huy hiệu của người chế tác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "Not much of an aid now."
msgstr "Bây giờ thì nó chẳng giúp ích được mấy nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "A navigational aid. \"Thataway\"."
msgstr "Một trợ giúp điều hướng. \"Lối đó kìa\"."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "A chance to give direction."
msgstr "Cơ hội để chỉ đường."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "Not much of an aid now."
msgstr "Bây giờ thì nó chẳng giúp ích được mấy nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "A navigational aid. \"Thataway\"."
msgstr "Một trợ giúp điều hướng. \"Lối đó kìa\"."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "A chance to give direction."
msgstr "Cơ hội để chỉ đường."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.GENERIC"
msgid "Some non-aqueous residue remains after the fire."
msgstr "Một ít cặn không chứa nước vẫn còn lại sau ngọn lửa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "The eyebone seems to have been burned entirely."
msgstr "Xương mắt có vẻ đã bị cháy rụi hoàn toàn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "The flower appears to have been completely burned up."
msgstr "Bông hoa có vẻ đã bị thiêu rụi hoàn toàn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "This used to be something, but now it's just a pile of ash."
msgstr "Thứ này từng là một cái gì đó, nhưng giờ chỉ là một đống tro tàn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASPARAGUS"
msgid "A great source of dietary fiber."
msgstr "Một nguồn cung cấp chất xơ tuyệt vời cho chế độ ăn uống."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASPARAGUSSOUP"
msgid "Smelly, but quite nutritious."
msgstr "Hơi bốc mùi, nhưng khá bổ dưỡng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASPARAGUS_COOKED"
msgid "It releases sulfur compounds when it's digested."
msgstr "Nó thải ra các hợp chất lưu huỳnh khi được tiêu hóa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASPARAGUS_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASPARAGUS_OVERSIZED"
msgid "It's quite the source of fiber!"
msgstr "Đúng là một nguồn cung cấp chất xơ tuyệt vời!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASPARAGUS_SEEDS"
msgid "It can't begin growing until it's been planted, dear."
msgstr "Nó chưa thể bắt đầu lớn lên cho đến khi được đem đi trồng đâu, cưng ạ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "It is storing power."
msgstr "Nó đang tích trữ năng lượng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "We must be patient."
msgstr "Chúng ta phải kiên nhẫn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "We'd best not be around when it goes off."
msgstr "Tốt nhất là chúng ta không nên ở quanh đây khi nó phát nổ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.OFF"
msgid "Now where might that lead?"
msgstr "Không biết cái đó dẫn đến đâu nhỉ?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.ON"
msgid "That's taken care of."
msgstr "Chuyện đó đã được giải quyết rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_KEY"
msgid "The key to that old gateway."
msgstr "Chìa khóa mở cánh cổng cũ đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "I suspect it is powered by that horrible fuel."
msgstr "Ta nghi ngờ nó được cung cấp năng lượng bởi thứ nhiên liệu kinh khủng đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "Indeed. It gained power from the key."
msgstr "Quả nhiên. Nó đã nhận được năng lượng từ chiếc chìa khóa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "It would take much too long to decipher."
msgstr "Sẽ mất rất nhiều thời gian để giải mã đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "An ancient mural of a non-mammalian civilization."
msgstr "Một bức tranh tường cổ đại về một nền văn minh không phải động vật có vú."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "This mural panel is too eroded to decipher."
msgstr "Bức tranh tường này đã bị bào mòn quá mức để có thể giải mã."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "A dark shadow, or perhaps a substance, overtakes the civilization."
msgstr "Một cái bóng tối tăm, hoặc có lẽ là một thực thể nào đó, đã áp đảo nền văn minh này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "The citizens molt from their exoskeletons in this panel."
msgstr "Những người dân đang lột xác khỏi lớp vỏ ngoài của họ trong bức tranh này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "The city appears exponentially more prosperous."
msgstr "Thành phố trông có vẻ thịnh vượng hơn hẳn theo cấp số nhân."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_STATUE"
msgid "It refuses to comply with this world's laws."
msgstr "Nó từ chối tuân theo các định luật của thế giới này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.AXE"
msgid "A dual inclined plane attached to a lever."
msgstr "Một mặt phẳng nghiêng kép được gắn vào một cần gạt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "Look at his widdle face! (Ahem!)"
msgstr "Nhìn cái mặt cưng chưa kìa! (Hèm!)"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "He's even more darling in sleep."
msgstr "Lúc ngủ trông chú ta còn đáng yêu hơn nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BACKPACK"
msgid "That could carry so many books."
msgstr "Cái đó có thể mang theo rất nhiều sách đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BACONEGGS"
msgid "Blue eggs and bacon!"
msgstr "Trứng màu xanh lam và thịt xông khói!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALATRO_MACHINE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALATRO_MACHINE"
msgid "One must know when the time for games has passed. Now is not that time."
msgstr "Người ta phải biết khi nào thời gian cho các trò chơi đã kết thúc. Bây giờ chưa phải lúc đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOON"
msgid "Could serve as a suitable diversion."
msgstr "Có thể dùng như một vật đánh lạc hướng thích hợp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONHAT"
msgid "I believe it's meant to evoke the image of a Lagomorph."
msgstr "Ta tin rằng nó ngầm gợi lên hình ảnh của một loài Thỏ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONPARTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONPARTY"
msgid "A reasonable amount of cheer every so often would do us good."
msgstr "Thỉnh thoảng có một chút niềm vui vừa phải sẽ rất tốt cho chúng ta đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONSPEED.DEFLATED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONSPEED.DEFLATED"
msgid "Probably not enough air left to analyze its composition..."
msgstr "Chắc không còn đủ không khí bên trong để phân tích thành phần của nó nữa..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONSPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONSPEED.GENERIC"
msgid "The chemical composition of the young man's breath must be fascinating."
msgstr "Thành phần hóa học trong hơi thở của cậu thanh niên này hẳn rất hấp dẫn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONS_EMPTY"
msgid "These seem frivolous."
msgstr "Những thứ này có vẻ phù phiếm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONVEST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONVEST"
msgid "I applaud your attempt at practicality, dear."
msgstr "Ta hoan hô sự cố gắng thực tế của em đấy, cưng ạ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BANANABUSH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BANANABUSH"
msgid "The fruit is remarkably similar to the subterranean strain."
msgstr "Quả của nó rất giống với chủng dưới lòng đất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BANANAJUICE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BANANAJUICE"
msgid "Ah, I was in need of some refreshment."
msgstr "À, ta đang cần một chút đồ giải khát đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BANANAPOP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BANANAPOP"
msgid "Well, isn't that refreshing?"
msgstr "Chà, chẳng phải rất sảng khoái sao?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BANDAGE"
msgid "Medicinal dressings."
msgstr "Băng gạc y tế."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BANDAGE_BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BANDAGE_BUTTERFLYWINGS"
msgid "A delicate dressing made of butterfly wings."
msgstr "Một miếng băng gạc tinh tế làm từ cánh bướm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLE"
msgid "People in ancient times believed geese grew from barnacles. Can you imagine?"
msgstr "Người thời cổ đại từng tin rằng loài ngỗng lớn lên từ hà biển. Bạn có thể tưởng tượng được không?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLEPITA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLEPITA"
msgid "A rather interesting combination."
msgstr "Một sự kết hợp khá thú vị."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLESTUFFEDFISHHEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLESTUFFEDFISHHEAD"
msgid "I don't think I can stomach it."
msgstr "Ta không nghĩ là mình có thể nuốt trôi món đó đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLESUSHI
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLESUSHI"
msgid "I think I'm developing a taste for it."
msgstr "Ta nghĩ mình đang dần thấy thích món này rồi đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLE_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLE_COOKED"
msgid "As I suspected, it tastes nothing like goose."
msgstr "Đúng như ta đoán, nó chẳng có vị gì giống ngỗng cả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLINGUINE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BARNACLINGUINE"
msgid "Oh my, it's very rich."
msgstr "Ôi trời, nó rất ngấy đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BASALT"
msgid "Material of great density!"
msgstr "Vật liệu có độ đặc rất lớn!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BAT"
msgid "A flying mammal."
msgstr "Một loài động vật có vú biết bay."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATBAT"
msgid "Interesting. This weapon appears to be alive."
msgstr "Thật thú vị. Vũ khí này có vẻ vẫn còn sống."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATCAVE"
msgid "This nook is actually a dwelling."
msgstr "Góc nhỏ này thực ra là một tổ ấm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATHBOMB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATHBOMB"
msgid "Ah, I do love a warm bath with a book."
msgstr "Ồ, ta rất thích ngâm mình trong bồn nước ấm cùng một cuốn sách."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATNOSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATNOSE"
msgid "Evolution truly is remarkable."
msgstr "Tiến hóa quả thực rất đáng kinh ngạc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATNOSEHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATNOSEHAT"
msgid "How... innovative."
msgstr "Thật là... đổi mới quá nhỉ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATNOSE_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATNOSE_COOKED"
msgid "It's moderately better."
msgstr "Nó đỡ hơn một chút rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_CONTAINER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_CONTAINER"
msgid "A specialized container for sheet music."
msgstr "Một chiếc hộp chuyên dụng đựng bản nhạc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_DURABILITY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_DURABILITY"
msgid "Musical notation, if I'm not mistaken."
msgstr "Ký hiệu âm nhạc, nếu ta không nhầm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_FIRERESISTANCE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_FIRERESISTANCE"
msgid "Musical notation, if I'm not mistaken."
msgstr "Ký hiệu âm nhạc, nếu ta không nhầm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_HEALTHGAIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_HEALTHGAIN"
msgid "Musical notation, if I'm not mistaken."
msgstr "Ký hiệu âm nhạc, nếu ta không nhầm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_INSTANT_PANIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_INSTANT_PANIC"
msgid "Ah, how I love the classics!"
msgstr "À, ta yêu làm sao những tác phẩm kinh điển!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_INSTANT_REVIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_INSTANT_REVIVE"
msgid "Musical notation, if I'm not mistaken."
msgstr "Ký hiệu âm nhạc, nếu ta không nhầm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_INSTANT_TAUNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_INSTANT_TAUNT"
msgid "Oh my, those are some rather colorful turns of phrase."
msgstr "Ôi trời, đó là một số cách diễn đạt khá màu mè đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_LUNARALIGNED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_LUNARALIGNED"
msgid "Musical notation, if I'm not mistaken."
msgstr "Ký hiệu âm nhạc, nếu ta không nhầm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_SANITYAURA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_SANITYAURA"
msgid "Musical notation, if I'm not mistaken."
msgstr "Ký hiệu âm nhạc, nếu ta không nhầm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_SANITYGAIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_SANITYGAIN"
msgid "Musical notation, if I'm not mistaken."
msgstr "Ký hiệu âm nhạc, nếu ta không nhầm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_SHADOWALIGNED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATTLESONG_SHADOWALIGNED"
msgid "Musical notation, if I'm not mistaken."
msgstr "Ký hiệu âm nhạc, nếu ta không nhầm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATWING"
msgid "Technically edible."
msgstr "Về mặt kỹ thuật thì ăn được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATWING_COOKED"
msgid "Technically edible."
msgstr "Về mặt kỹ thuật thì ăn được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARDHAIR"
msgid "This is human facial hair."
msgstr "Đây là lông trên mặt của con người."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGER"
msgid "It's the Caniformia suborder... Beyond that, I cannot say."
msgstr "Đó là phân bộ Chân chân thịt... Ngoài ra thì ta không thể nói gì hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGERCORPSE.BURNING"
msgid "I'm relieved to see it go."
msgstr "Ta thấy nhẹ nhõm khi nó biến mất đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGERCORPSE.GENERIC"
msgid "It could lead to trouble if it's not promptly disposed of."
msgstr "Nó có thể dẫn đến rắc rối nếu không được xử lý ngay lập tức."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGERCORPSE.REVIVING"
msgid "Oh dear. It seems I'm too late."
msgstr "Ôi trời. Có vẻ như ta đã đến quá muộn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGERFUR_SACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGERFUR_SACK"
msgid "A portable chilling unit. Well and good, but cold food makes my teeth ache."
msgstr "Một thiết bị làm lạnh di động. Khá tốt đấy, nhưng đồ ăn lạnh làm răng ta ê ẩm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGERVEST"
msgid "Whatever it was, its pelt makes for a fine garment."
msgstr "Dù nó là gì đi nữa, bộ lông của nó làm thành một trang phục tuyệt đẹp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEARGER_FUR"
msgid "My, my! That is thick."
msgstr "Trời ơi! Bộ lông đó dày thật đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEAST_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEAST_BLUEPRINT"
msgid "I'm not one to rely on luck, but a bit won't hurt in a competition."
msgstr "Ta không phải là người thích dựa vào may mắn, nhưng một chút may mắn cũng chẳng hại gì trong một cuộc thi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEDROLL_FURRY"
msgid "I'm not sleeping on the ground."
msgstr "Ta không ngủ trên mặt đất đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEDROLL_STRAW"
msgid "I'm not sleeping on the ground."
msgstr "Ta không ngủ trên mặt đất đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEE.GENERIC"
msgid "Apis mellifera. Quite large!"
msgstr "Apis mellifera. Khá là to lớn!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEE.HELD"
msgid "It is not pleased."
msgstr "Nó không vui chút nào đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.BURNT"
msgid "Poor bees!"
msgstr "Tội nghiệp bầy ong!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.FULLHONEY"
msgid "Honey can be harvested from it."
msgstr "Có thể thu hoạch mật ong từ nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.GENERIC"
msgid "A crude apiary."
msgstr "Một cái trại nuôi ong thô sơ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.NOHONEY"
msgid "It's devoid of honey."
msgstr "Nó không có chút mật ong nào cả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.READY"
msgid "Honey can be harvested from it."
msgstr "Có thể thu hoạch mật ong từ nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "It's not ready for harvesting."
msgstr "Nó chưa sẵn sàng để thu hoạch."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.BURNT"
msgid "Poor bees!"
msgstr "Tội nghiệp bầy ong!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.FULLHONEY"
msgid "Honey can be harvested from it."
msgstr "Có thể thu hoạch mật ong từ nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.GENERIC"
msgid "It appears to be a crudely fashioned apiary."
msgstr "Nó có vẻ là một chiếc trại nuôi ong được chế tạo thô sơ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "It's devoid of honey."
msgstr "Nó không có chút mật ong nào cả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "Honey can be harvested from it."
msgstr "Có thể thu hoạch mật ong từ nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "It's not ready for harvesting."
msgstr "Nó chưa sẵn sàng để thu hoạch."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.DEAD"
msgid "It's not breathing."
msgstr "Nó không còn thở nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.DEAD_MYPARTNER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.DEAD_MYPARTNER"
msgid "There may yet be a way to revive it..."
msgstr "Biết đâu vẫn còn cách để hồi sinh nó..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "While tame, it has become dependent on its human master."
msgstr "Dù đã được thuần hóa, nó lại trở nên phụ thuộc vào người chủ loài người của mình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.FOLLOWER"
msgid "It appears to be following me."
msgstr "Nó có vẻ đang đi theo ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.GENERIC"
msgid "It looks almost like a Bos Taurus."
msgstr "Trông nó gần giống một con bò tót Bos taurus."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.MYPARTNER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.MYPARTNER"
msgid "It has become rather attached to me."
msgstr "Nó đã trở nên khá quấn quýt với ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.NAKED"
msgid "It looks cold."
msgstr "Trông nó có vẻ lạnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.ORNERY"
msgid "The creature has developed a nasty disposition."
msgstr "Sinh vật lạ đã phát triển một tính khí khó chịu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.PUDGY"
msgid "Abundant nourishment has led to an amicable personality."
msgstr "Việc được nuôi dưỡng đầy đủ đã mang lại cho nó một tính cách thân thiện."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.RIDER"
msgid "This one seems lean and athletic."
msgstr "Con này trông có vẻ thon thả và lực lưỡng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO.SLEEPING"
msgid "It's sleeping."
msgstr "Nó đang ngủ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALOFEED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALOFEED"
msgid "Beefalo seem to be quite adept at digesting sticks."
msgstr "Bò Lai có vẻ rất giỏi tiêu hóa các cành cây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALOHAT"
msgid "This hat is hideous."
msgstr "Chiếc mũ này trông thật gớm ghiếc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALOTREAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALOTREAT"
msgid "We all could use a little treat from time to time."
msgstr "Tất cả chúng ta thỉnh thoảng đều cần một món quà nhỏ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALOWOOL"
msgid "Long follicles harvested from the beefalo."
msgstr "Những sợi lông dài được thu hoạch từ bò lai."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO_GROOMER.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO_GROOMER.BURNT"
msgid "What an unfortunate turn of events."
msgstr "Thật là một ngã rẽ sự việc không may."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO_GROOMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO_GROOMER.GENERIC"
msgid "These creatures require regular grooming."
msgstr "Những sinh vật này cần được chải chuốt thường xuyên."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO_GROOMER.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO_GROOMER.OCCUPIED"
msgid "Let's get you looking a bit more presentable, shall we?"
msgstr "Hãy làm cho bạn trông lịch sự hơn một chút nào?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO_GROOMER_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEFALO_GROOMER_ITEM"
msgid "I'd best get it set up."
msgstr "Ta tốt nhất nên dựng nó lên thôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEF_BELL"
msgid "Something about its tone triggers an affectionate response in beefalo."
msgstr "Âm thanh của nó gợi lên phản ứng trìu mến ở bò lai."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEGUARD"
msgid "Very angry Apis mellifera workers!"
msgstr "Những con thợ Apis mellifera rất giận dữ!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEHAT"
msgid "Appropriate protective equipment is a must!"
msgstr "Thiết bị bảo hộ phù hợp là thứ bắt buộc phải có!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEHIVE"
msgid "The natural home of the bee."
msgstr "Ngôi nhà tự nhiên của loài ong."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEMINE"
msgid "A dangerous mine filled with Antophila."
msgstr "Một cái bẫy nguy hiểm đầy những con Antophila."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEMINE_MAXWELL"
msgid "A dangerous mine filled with Culicidae."
msgstr "Một cái bẫy nguy hiểm đầy những con Culicidae."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEQUEEN"
msgid "The workers ferociously protect her."
msgstr "Đám ong thợ bảo vệ cô ta rất quyết liệt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "Thick Apis mellifera honeycomb."
msgstr "Mạng tổ ong dày của loài Apis mellifera."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "The Apis mellifera are constructing a new hive."
msgstr "Bầy Apis mellifera đang xây dựng một tổ mới."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "An Apis mellifera nest of unusual size."
msgstr "Một cái ổ Apis mellifera có kích thước bất thường."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEESWAX"
msgid "Naturally antibacterial. Could slow food decay if we use it properly."
msgstr "Có tính kháng khuẩn tự nhiên. Có thể làm chậm quá trình phân hủy thức ăn nếu chúng ta sử dụng đúng cách."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEESWAX_SPRAY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEESWAX_SPRAY"
msgid "It has an unpleasantly astringent odor."
msgstr "Nó có mùi chát khó chịu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BEETLETAUR"
msgid "That lock must be heavy on its snout."
msgstr "Chiếc khóa đó hẳn rất nặng trên mõm của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BELL"
msgid "Quiet! This is a library!"
msgstr "Yên lặng nào! Đây là thư viện!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERNIE_ACTIVE"
msgid "That teddy bear seems to be animated somehow."
msgstr "Con gấu bông đó có vẻ như đã cử động được bằng cách nào đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERNIE_BIG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERNIE_BIG"
msgid "As whimsical as it is befuddling."
msgstr "Vừa kỳ quặc vừa khó hiểu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "That bear is in need of repair."
msgstr "Con gấu đó đang cần được sửa chữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "It's a teddy bear."
msgstr "Đó là một con gấu bông."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRIES"
msgid "Some Ardisia crenata berries, I think."
msgstr "Hình như là mấy quả dâu rừng Ardisia crenata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRIES_COOKED"
msgid "Roasted Ardisia crenata, just in case."
msgstr "Dâu Ardisia crenata nướng, cứ đề phòng cho chắc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRIES_JUICY"
msgid "A variant of Ardisia crenata berries. Good hydration."
msgstr "Một biến thể của dâu rừng Ardisia crenata. Cung cấp nước tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "Spoilage is a constant threat."
msgstr "Hỏng mốc là một mối đe dọa thường trực."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.BARREN"
msgid "It will require an intervention."
msgstr "Nó sẽ cần được can thiệp đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.BURNING"
msgid "Combustion!"
msgstr "Sự bốc cháy!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.DISEASED"
msgid "It's afflicted with an agrarian disease beyond my curing."
msgstr "Nó đang mắc một loại bệnh nông nghiệp vượt quá khả năng chữa trị của ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.DISEASING"
msgid "Hm... The leaves are curling at the edges."
msgstr "Hừm... Các mép lá đang quăn lại kìa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.GENERIC"
msgid "It's an Ardisia crenata bush."
msgstr "Đó là một bụi dâu Ardisia crenata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.PICKED"
msgid "The berries are growing back, slowly."
msgstr "Những quả dâu rừng đang mọc lại, từ từ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH.WITHERED"
msgid "Ardisia crenata don't do well in extreme heat."
msgstr "Dâu Ardisia crenata không chịu nổi cái nóng khắc nghiệt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "It needs some agricultural attention."
msgstr "Nó cần được chăm sóc nông nghiệp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "Combustion!"
msgstr "Sự bốc cháy!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "It's afflicted with an agrarian disease beyond my curing."
msgstr "Nó đang mắc một loại bệnh nông nghiệp vượt quá khả năng chữa trị của ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "Hm... The leaves are curling at the edges."
msgstr "Hừm... Các mép lá đang quăn lại kìa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "That bush looks ready for harvest."
msgstr "Bụi cây đó trông có vẻ đã sẵn sàng để thu hoạch."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "It will have to wait."
msgstr "Nó sẽ phải đợi thôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "The Ardisia crenata variant has shriveled in the heat."
msgstr "Biến thể của dâu Ardisia crenata đã quéo lại vì trời nóng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BERRYSAUCE"
msgid "How festive!"
msgstr "Trông thật lễ hội làm sao!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIBINGKA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIBINGKA"
msgid "Traditionally, bibingka is baked in a specialized clay oven."
msgstr "Theo truyền thống, bánh gạo nướng bibingka được nướng trong một lò nướng bằng đất sét chuyên dụng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIGFOOT"
msgid "Prehistoric!"
msgstr "Thời tiền sử!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRCHNUTDRAKE"
msgid "Run awaaay!"
msgstr "Chạy mauuu!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.DEAD"
msgid "I do believe he has starved."
msgstr "Ta tin là chú ta đã bị chết đói rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.GENERIC"
msgid "This will safely contain one avian specimen."
msgstr "Cái này sẽ nhốt an toàn một mẫu vật có cánh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "He's getting hungry."
msgstr "Chú ta bắt đầu thấy đói rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "He is contained."
msgstr "Nó đã bị nhốt lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.SKELETON"
msgid "I guess I could study the bones."
msgstr "Chắc là ta có thể nghiên cứu đám xương này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "Shhhhh!"
msgstr "Suỵt!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCAGE.STARVING"
msgid "He's looking a bit malnourished."
msgstr "Chú ta trông có vẻ hơi suy dinh dưỡng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCORPSE.BURNING"
msgid "This is, in fact, saving it."
msgstr "Thực ra thì đây là đang cứu nó đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCORPSE.GENERIC"
msgid "If only this were the end for the little bird."
msgstr "Giá như đây là kết cục dành cho con chim nhỏ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCORPSE.REVIVING"
msgid "The little bird is on a different path now... terrible one."
msgstr "Con chim nhỏ giờ đang đi trên một con đường khác... một con đường tồi tệ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDTRAP"
msgid "A simple clap-trap for birds."
msgstr "Một cái bẫy sập đơn giản dành cho chim."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRD_EGG"
msgid "It is unfertilized."
msgstr "Nó chưa được thụ tinh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRD_EGG_COOKED"
msgid "Just needs some toast."
msgstr "Chỉ cần vài lát bánh mì nướng nữa là hoàn hảo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRD_MUTANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRD_MUTANT"
msgid "Oh dear, that creature looks unwell."
msgstr "Ôi trời, sinh vật đó trông có vẻ không được khỏe."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRD_MUTANT_SPITTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRD_MUTANT_SPITTER"
msgid "The poor thing appears to have been altered by unnatural means."
msgstr "Tội nghiệp con vật, có vẻ nó đã bị biến đổi bởi những phương pháp phi tự nhiên."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BISHOP"
msgid "A clockwork clergyman."
msgstr "Một tu sĩ máy cót."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Augh!"
msgstr "Ái!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BISHOP_NIGHTMARE"
msgid "Such exhilaratingly complex technology."
msgstr "Công nghệ phức tạp đến mức phấn khích."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLACKFLAG"
msgid "Historically, pirates also sailed under red or white flags."
msgstr "Trong lịch sử, cướp biển cũng giương cờ đỏ hoặc trắng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_FIRE"
msgid "Improvised inflammatory device."
msgstr "Thiết bị gây cháy tự chế."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_LAVA"
msgid "I haven't the lung capacity for such a thing."
msgstr "Ta không có đủ dung tích phổi cho một việc như thế."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_LAVA2"
msgid "I'll leave that to the younger folks."
msgstr "Ta sẽ để việc đó lại cho đám trẻ tuổi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_PIPE"
msgid "Improvised missile device."
msgstr "Thiết bị phóng tên lửa tự chế."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_SLEEP"
msgid "Improvised tranquilizer device."
msgstr "Thiết bị gây mê tự chế."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLOWDART_YELLOW"
msgid "Improvised electric device."
msgstr "Thiết bị điện tự chế."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUEAMULET"
msgid "The gem appears to be sucking energy out anything it touches."
msgstr "Viên ngọc có vẻ đang hút năng lượng ra khỏi bất cứ thứ gì nó chạm vào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUEGEM"
msgid "It is cold."
msgstr "Nó rất lạnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUEMOONEYE"
msgid "An excellent marker for group coordination."
msgstr "Một dấu hiệu tuyệt vời để phối hợp nhóm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUEPRINT.COMMON"
msgid "A detailed technical drawing."
msgstr "Một bản vẽ kỹ thuật chi tiết."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUEPRINT.RARE"
msgid "Such a rare and detailed drawing!"
msgstr "Một bản vẽ chi tiết và hiếm làm sao!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUE_CAP"
msgid "This seems to have medicinal properties."
msgstr "Cái này dường như có đặc tính y dược."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUE_CAP_COOKED"
msgid "Chemistry has altered it."
msgstr "Hóa học đã biến đổi nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "It is a fungus."
msgstr "Nó là một loại nấm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "It is dormant this time of day."
msgstr "Nó đang ngủ đông vào thời điểm này trong ngày."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "It requires hydration before it can fruit again."
msgstr "Nó cần được cấp nước trước khi có thể ra quả trở lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOARDS"
msgid "Roughly hewn wood boards."
msgstr "Các tấm ván ép được đẽo thô sơ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOARON"
msgid "They appear to be used as fodder."
msgstr "Chúng có vẻ được dùng làm thức ăn gia súc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOARRIOR"
msgid "We best not underestimate that one."
msgstr "Chúng ta tốt nhất không nên đánh giá thấp kẻ đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATFRAGMENT03"
msgid "What a pity."
msgstr "Thật là đáng tiếc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATFRAGMENT04"
msgid "What a pity."
msgstr "Thật là đáng tiếc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATFRAGMENT05"
msgid "What a pity."
msgstr "Thật là đáng tiếc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATPATCH"
msgid "For repairing hull damages."
msgstr "Dùng để sửa chữa những chỗ hư hỏng ở thân thuyền."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATPATCH_KELP"
msgid "A temporary solution, but better than nothing."
msgstr "Một giải pháp tạm thời, nhưng còn hơn không."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "This should help us stay on course."
msgstr "Cái này sẽ giúp chúng ta đi đúng hướng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "Its placement must be strategic."
msgstr "Vị trí đặt nó phải thật chiến lược."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "A shadowy opponent to keep things interesting."
msgstr "Một đối thủ mờ ảo để mọi thứ thêm phần thú vị."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_SEASTACK"
msgid "Best to avoid that!"
msgstr "Tốt nhất là nên tránh xa cái đó ra!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Best to avoid that!"
msgstr "Tốt nhất là nên tránh xa cái đó ra!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "I wouldn't dream of using any underhanded tactics to win. I'll exercise caution."
msgstr "Ta sẽ không bao giờ mơ đến việc dùng bất kỳ thủ đoạn mờ ám nào để chiến thắng đâu. Ta sẽ cẩn thận."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "I wouldn't dream of using any underhanded tactics to win. I'll exercise caution."
msgstr "Ta sẽ không bao giờ mơ đến việc dùng bất kỳ thủ đoạn mờ ám nào để chiến thắng đâu. Ta sẽ cẩn thận."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "It seems content to watch the proceedings."
msgstr "Nó có vẻ bằng lòng đứng xem buổi diễn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_START"
msgid "I do love a good old fashioned boat race."
msgstr "Ta rất thích một cuộc đua thuyền ván theo phong cách cổ điển."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "We must determine the best spot to start and finish the race."
msgstr "Chúng ta phải xác định điểm xuất phát và về đích tốt nhất cho cuộc đua."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "This vessel is outfitted with a convenient storage receptacle."
msgstr "Chiếc thuyền này được trang bị một khoang chứa đồ tiện lợi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "The style is reminiscent of the ships from days of old."
msgstr "Kiểu dáng gợi nhớ đến những con tàu từ thời cổ đại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_CRABKING"
msgid "A thick barrier of geocrustacean exoskeleton."
msgstr "Một lớp rào chắn dày bằng lớp vỏ ngoài của cua giáp xác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_CRABKING_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_CRABKING_KIT"
msgid "It would be wise to equip the boat with a protective barrier."
msgstr "Sẽ khôn ngoan hơn nếu trang bị cho thuyền ván một lớp rào chắn bảo vệ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_KELP"
msgid "A thick barrier of Nereocystis luetkeana."
msgstr "Một lớp rào chắn dày bằng Nereocystis luetkeana."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "It would be wise to equip the boat with a protective barrier."
msgstr "Sẽ khôn ngoan hơn nếu trang bị cho thuyền ván một lớp rào chắn bảo vệ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "A thick barrier of mollusks."
msgstr "Một lớp rào chắn dày bằng loài thân mềm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "It would be wise to equip the boat with a protective barrier."
msgstr "Sẽ khôn ngoan hơn nếu trang bị cho thuyền ván một lớp rào chắn bảo vệ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "The effect is admittedly quite striking."
msgstr "Phải thừa nhận là hiệu ứng của nó khá nổi bật."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "It would be wise to equip the boat with a protective barrier."
msgstr "Sẽ khôn ngoan hơn nếu trang bị cho thuyền ván một lớp rào chắn bảo vệ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "It is not a plaything."
msgstr "Nó không phải là đồ chơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "A highly effective weapon in nautical combat, when properly loaded."
msgstr "Một vũ khí cực kỳ hiệu quả trong chiến đấu trên biển, khi được nạp đạn đầy đủ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "There's still the small matter of ammunition, dear..."
msgstr "Vẫn còn vấn đề nhỏ về đạn dược đây, thân mến..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_CANNON_KIT"
msgid "A necessary precaution, unfortunately."
msgstr "Thật không may, đây là một sự phòng ngừa cần thiết."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_GRASS_ITEM"
msgid "Its durability is questionable, but it will do for now."
msgstr "Độ bền của nó còn là một dấu hỏi, nhưng tạm dùng lúc này thì được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_ITEM"
msgid "It will allow us to go on the water."
msgstr "Nó sẽ giúp chúng ta ra nước."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_LEAK"
msgid "Our ship is taking on water."
msgstr "Tàu của chúng ta đang bị ngập nước."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "The strong magnetic force will pull my ship toward its target."
msgstr "Lực từ mạnh mẽ sẽ kéo con tàu của tôi về phía mục tiêu của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "Its design is rather eccentric, but the theory is sound."
msgstr "Thiết kế của nó có phần kỳ cục, nhưng lý thuyết thì hoàn toàn hợp lý."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "The magnetic beacon has been activated."
msgstr "Hải đăng nam châm đã được kích hoạt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "It will attract large electromagnets, but only once activated."
msgstr "Nó sẽ thu hút các nam châm điện lớn, nhưng chỉ khi được kích hoạt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_MAGNET_KIT"
msgid "I will have to speak with him about the run-on sentences in his directions later."
msgstr "Lát nữa tôi phải nói chuyện với anh ta về mấy câu dài dòng trong hướng dẫn mới được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_ROTATOR"
msgid "It allows me to rotate the deck, while maintaining our heading."
msgstr "Nó cho phép tôi xoay boong tàu trong khi vẫn giữ nguyên hướng đi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "It should improve the boat's maneuverability."
msgstr "Nó sẽ cải thiện khả năng điều khiển của thuyền ván."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "The woolen fibers of a beefalo's coat make for excellent padding."
msgstr "Những sợi lông của bò lai tạo nên lớp đệm tuyệt vời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BODYPILLOW_KELP"
msgid "What a fascinating use of kelp."
msgstr "Thật là một cách tận dụng tảo biển đầy thú vị."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BODYPILLOW_PETALS"
msgid "It gives off a delicate floral aroma."
msgstr "Nó tỏa ra một hương thơm hoa cỏ nhẹ nhàng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "This seems ill-suited for a restful night's sleep."
msgstr "Cái này có vẻ không thích hợp cho một giấc ngủ đêm ngon giấc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOMB_LUNARPLANT"
msgid "Unstable energy, barely held together by a hardy plant epidermis."
msgstr "Năng lượng không ổn định, hầu như chỉ được giữ lại nhờ lớp biểu bì thực vật cứng cáp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "Our verdant friend seems to have worked his magic on this."
msgstr "Người bạn xanh tươi của chúng ta có vẻ đã dùng phép thuật của cậu ấy lên cái này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BONESHARD"
msgid "Remnants of a life well lived."
msgstr "Tàn tích của một cuộc đời sống trọn vẹn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BONESOUP"
msgid "Extremely savory. I wouldn't mind seconds."
msgstr "Cực kỳ đậm đà. Tôi không ngại ăn thêm chén nữa đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BONESTEW"
msgid "Not quite how mum used to make, but it smells superb!"
msgstr "Không giống cách mẹ hay làm lắm, nhưng mùi thơm tuyệt cú mèo!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOKSTATION.BURNT"
msgid "Few things are as saddening as the sight of destroyed books."
msgstr "Ít có gì đau lòng bằng cảnh những cuốn sách bị phá hủy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOKSTATION.GENERIC"
msgid "Eager minds should always have access to a library."
msgstr "Những bộ óc ham học hỏi nên luôn có quyền tiếp cận thư viện."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_BEES"
msgid "I've grown rather fond of beekeeping."
msgstr "Tôi bắt đầu khá thích việc nuôi ong rồi đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_BIRDS"
msgid "The expurgated version, but it has my favorite: Megascops kennicottii."
msgstr "Bản đã được kiểm duyệt, nhưng có loài tôi thích nhất: Megascops kennicottii."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_BRIMSTONE"
msgid "What could possibly go wrong?"
msgstr "Chuyện tồi tệ nào có thể xảy ra được cơ chứ?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_ELEMENTAL"
msgid "A powerful tome of summoning."
msgstr "Một cuốn sách phép triệu hồi mạnh mẽ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_FIRE"
msgid "Even misfortune offers opportunities to learn. Past mistakes shall not be repeated."
msgstr "Ngay cả bất hạnh cũng mang lại cơ hội học hỏi. Những sai lầm trong quá khứ sẽ không lặp lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_FISH"
msgid "It starts with a rather compelling hook."
msgstr "Nó bắt đầu bằng một cú lừa khá cuốn hút."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_FOSSIL"
msgid "A tome of accelerated petrification."
msgstr "Một cuốn sách về hóa đá gia tốc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_GARDENING"
msgid "Dead plants tied together to help me aid living plants."
msgstr "Những thực vật đã chết buộc lại với nhau để giúp tôi hỗ trợ những thực vật còn sống."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_HORTICULTURE"
msgid "Only my best tricks for bringing a garden to fruition."
msgstr "Toàn những mẹo hay nhất của tôi để giúp khu vườn đơm hoa kết trái."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "Mankind has cultivated crops for centuries, and there's still more to learn."
msgstr "Nhân loại đã canh tác hoa màu từ nhiều thế kỷ, và vẫn còn rất nhiều điều để học hỏi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_LIGHT"
msgid "I like to do a bit of light reading in the evening."
msgstr "Tôi thích đọc vài cuốn sách nhẹ nhàng vào buổi tối."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "I've given it a glowing review."
msgstr "Tôi đã cho nó một đánh giá rực rỡ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_MOON"
msgid "Investigating the ancient archives proved to be quite educational."
msgstr "Việc nghiên cứu các kho lưu trữ cổ đại hóa ra lại mang tính giáo dục cao."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_RAIN"
msgid "A succinct guide, without any extraneous fluff."
msgstr "Một hướng dẫn súc tích, không có bất kỳ lời lẽ rườm rà nào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "It took some effort to distill everything down into a single volume."
msgstr "Phải mất khá nhiều công sức để cô đọng mọi thứ vào một tập sách duy nhất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_SILVICULTURE"
msgid "Dead plants tied together to help me aid living plants."
msgstr "Những thực vật đã chết buộc lại với nhau để giúp tôi hỗ trợ những thực vật còn sống."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_SLEEP"
msgid "Warm milk in book form."
msgstr "Sữa ấm dưới dạng sách."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_TEMPERATURE"
msgid "You must be mindful of your thermal equilibrium."
msgstr "Bạn phải lưu ý đến sự cân bằng nhiệt của mình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_TENTACLES"
msgid "Hard to put this one down. It's gripping, frankly."
msgstr "Thật khó để đặt cuốn này xuống. Thú thực là nó rất lôi cuốn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOK_WEB"
msgid "Arachnids are crucial parts of a healthy ecosystem, after all."
msgstr "Rốt cuộc thì loài nhện là phần thiết yếu của một hệ sinh thái lành mạnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOMERANG"
msgid "It is a flat aerofoil."
msgstr "Nó là một mặt phẳng khí động học."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOOTLEG"
msgid "As far as teleportation methods go, it's quite unrefined."
msgstr "Xét về các phương pháp dịch chuyển tức thời, nó khá thô sơ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BROKEN_FORGEDITEM"
msgid "With the right materials, it could be repaired."
msgstr "Với các vật liệu phù hợp, nó có thể được sửa chữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BROKEN_FUMAROLETOOLITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BROKEN_FUMAROLETOOLITEM"
msgid "A sufficient amount of heat should be enough to reconstitute it."
msgstr "Một lượng nhiệt đủ lớn sẽ tái tạo lại nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BRUSH"
msgid "Microscopic barbs allow for optimal hair retrieval."
msgstr "Các ngạnh kính hiển vi giúp thu gom tóc tối ưu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUGNET"
msgid "The tool of entomologists."
msgstr "Công cụ của nhà côn trùng học."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "Nereocystis luetkeana."
msgstr "Nereocystis luetkeana."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "Nereocystis luetkeana needs time to regrow."
msgstr "Nereocystis luetkeana cần thời gian để mọc lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BULLKELP_ROOT"
msgid "I suppose this is why it's referred to as \"bullwhip\" kelp."
msgstr "Tôi đoán đây là lý do tại sao nó được gọi là tảo bẹ \"roi bò\"."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUNDLE"
msgid "At least someone's bundled up out here."
msgstr "Ít ra cũng có người chịu quấn áo ấm ra ngoài này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUNDLEWRAP"
msgid "Antibacterial wrapping for food preservation."
msgstr "Lớp bọc kháng khuẩn để bảo quản thực phẩm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUNNYMAN"
msgid "A sentient lagomorph."
msgstr "Một loài thỏ có tri giác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUNNYSTEW"
msgid "Caloric, but nutritious. It smells wonderful, as well."
msgstr "Nhiều calo nhưng bổ dưỡng. Mùi cũng rất tuyệt nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BURNT_MARSH_BUSH"
msgid "Reduced to ash."
msgstr "Đã biến thành tro bụi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUSHHAT"
msgid "Camouflage."
msgstr "Ngụy trang."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUTTER"
msgid "Lepidopterous lipids?"
msgstr "Lipid của loài cánh vảy sao?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUTTERFLY.GENERIC"
msgid "A colorful lepidopteran."
msgstr "Một loài côn trùng cánh vảy đầy màu sắc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUTTERFLY.HELD"
msgid "It is captured."
msgstr "Nó đã bị bắt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUTTERFLYMUFFIN"
msgid "Who knew butterflies made such nice baked goods?"
msgstr "Ai mà ngờ bướm lại làm ra được mấy món nướng ngon thế nhỉ?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUTTERFLYWINGS"
msgid "Wings from a captured butterfly."
msgstr "Đôi cánh của một con bướm bị bắt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUZZARD"
msgid "Cathartes, of course."
msgstr "Tất nhiên là Cathartes rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUZZARDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUZZARDCORPSE.BURNING"
msgid "This is, in fact, saving it."
msgstr "Thực ra đây là đang cứu nó đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUZZARDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUZZARDCORPSE.GENERIC"
msgid "If only this were the end for the buzzard."
msgstr "Giá mà đây là chấm hết cho con diều hâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUZZARDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BUZZARDCORPSE.REVIVING"
msgid "The buzzard is on a different path now... terrible one."
msgstr "Con diều hâu đang ở một ngã rẽ khác... một con đường tồi tệ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CABBAGEROLLS"
msgid "Variations of this dish can be found across Europe and Asia."
msgstr "Các biến thể của món này có thể tìm thấy ở khắp châu Âu và châu Á."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CACTUS.GENERIC"
msgid "A young barrel cactus."
msgstr "Một cây xương rồng thùng non."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CACTUS.PICKED"
msgid "Desperate times, desperate measures."
msgstr "Hoàn cảnh ngặt nghèo, biện pháp liều lĩnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CACTUS_FLOWER"
msgid "Reminds me of Burroughs. A favorite at the library."
msgstr "Làm tôi nhớ đến Burroughs. Một cuốn sách yêu thích ở thư viện."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CACTUS_MEAT"
msgid "I'm not sure it's been prepared properly."
msgstr "Tôi không chắc nó đã được sơ chế đúng cách chưa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "Delightfully devoid of spines."
msgstr "Thật tuyệt vời vì đã không còn gai."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CALIFORNIAROLL"
msgid "Delicious makizushi."
msgstr "Món makizushi ngon tuyệt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.EMBERS"
msgid "The fire has almost self-extinguished."
msgstr "Ngọn lửa gần như đã tự tắt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.GENERIC"
msgid "A camp fire."
msgstr "Một đống lửa trại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.HIGH"
msgid "That fire is burning at an alarming rate."
msgstr "Đống lửa đó đang cháy với tốc độ đáng báo động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.LOW"
msgid "The fire could use some more fuel."
msgstr "Lửa có thể cần thêm chút nhiên liệu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.NORMAL"
msgid "A perfectly average fire."
msgstr "Một đống lửa hoàn toàn bình thường."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAMPFIRE.OUT"
msgid "It can be re-lit."
msgstr "Nó có thể được nhóm lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANARY.GENERIC"
msgid "Serinus canaria. A historically useful sentinel species."
msgstr "Serinus canaria. Một loài chim cảnh báo hữu ích trong lịch sử."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANARY.HELD"
msgid "Serinus canaria. We ought never enter a cave without one."
msgstr "Serinus canaria. Ta không bao giờ nên vào hang động mà không có một con."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANARY_POISONED"
msgid "Oh, dear."
msgstr "Ôi trời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANDYBAG"
msgid "A festive bag for seasonal treats."
msgstr "Một chiếc túi lễ hội đựng quà vặt theo mùa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANE"
msgid "I'm no rabologist."
msgstr "Tôi không phải là chuyên gia về gậy gộc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANNONBALL_ROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CANNONBALL_ROCK_ITEM"
msgid "A suitable projectile for a cannon."
msgstr "Một loại đạn phù hợp cho đại bác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALCANNON.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALCANNON.COOLDOWN"
msgid "Oh, these sorts of things always make such a mess..."
msgstr "Ồ, mấy thứ kiểu này lúc nào cũng gây ra mớ hỗn độn..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALCANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALCANNON.GENERIC"
msgid "Thankfully idle, for now."
msgstr "May thay hiện tại đang rảnh rỗi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALCANNON_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALCANNON_KIT"
msgid "Let's just put it somewhere far away from the encampment."
msgstr "Hãy đặt nó ở đâu đó thật xa khu cắm trại nào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_BANNER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_BANNER"
msgid "It doesn't actually \"catch\" the light of course, but merely reflects it."
msgstr "Tất nhiên là nó không thực sự \"bắt\" được ánh sáng, mà chỉ phản chiếu lại thôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_BANNER_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_BANNER_KIT"
msgid "I should be able to assemble it easily enough."
msgstr "Tôi chắc có thể tự lắp ráp nó một cách dễ dàng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_EGGRIDE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_EGGRIDE"
msgid "Those corvids are quite capable craftspeople."
msgstr "Lũ quạ đó đúng là những thợ thủ công cừ khôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT"
msgid "I should be able to assemble it easily enough."
msgstr "Tôi chắc có thể tự lắp ráp nó một cách dễ dàng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC"
msgid "It would look lovely in a little curio cabinet, don't you think?"
msgstr "Trông nó sẽ rất đáng yêu trong một chiếc tủ trưng bày đồ cổ nhỏ, bạn có nghĩ vậy không?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE.RARE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE.RARE"
msgid "I believe this is among the rarest of the whole collection."
msgstr "Tôi tin rằng đây là một trong những món hiếm nhất trong toàn bộ bộ sưu tập."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON"
msgid "It appears to be of a slightly upgraded rarity."
msgstr "Nó có vẻ thuộc loại độ hiếm cao hơn một chút."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE_KIT"
msgid "How intriguing! I wonder what's inside?"
msgstr "Thật thú vị! Tự hỏi có gì bên trong nhỉ?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2"
msgid "How intriguing! I wonder what's inside?"
msgstr "Thật thú vị! Tự hỏi có gì bên trong nhỉ?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON3"
msgid "How intriguing! I wonder what's inside?"
msgstr "Thật thú vị! Tự hỏi có gì bên trong nhỉ?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_LAMP"
msgid "It has a most curious light source."
msgstr "Nó có một nguồn sáng rất lạ kỳ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_LAMP_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_LAMP_KIT"
msgid "I should be able to assemble it easily enough."
msgstr "Tôi chắc có thể tự lắp ráp nó một cách dễ dàng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_PLANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_PLANT"
msgid "It's so soothing to care for a small tree."
msgstr "Chăm sóc một cái cây nhỏ thật là thư giãn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_PLANT_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALDECOR_PLANT_KIT"
msgid "I wouldn't mind a bit of gardening."
msgstr "Tôi không ngại làm chút vườn tược đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALFOOD_CORNTEA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALFOOD_CORNTEA"
msgid "An acquired taste, but nevertheless quite refreshing."
msgstr "Một hương vị phải làm quen mới thấy ngon, nhưng dẫu sao thì cũng khá giải khát."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD"
msgid "Colorful paper representations of Annelida."
msgstr "Hình ảnh bằng giấy đầy màu sắc của loài giun nhiều tơ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT"
msgid "It appears simple enough to construct."
msgstr "Có vẻ khá đơn giản để chế tạo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST"
msgid "Part of the mechanism for the game, I'd imagine."
msgstr "Tôi đoán đây là một phần cơ chế của trò chơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC"
msgid "I believe it requires a form of currency to start."
msgstr "Tôi tin là nó cần một loại tiền tệ nào đó để bắt đầu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING"
msgid "The game appears to require quick reflexes."
msgstr "Trò chơi có vẻ đòi hỏi phản xạ nhanh nhạy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFBALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFBALL"
msgid "A near-perfect sphere, optimized for predictable rolling dynamics."
msgstr "Một hình cầu gần như hoàn hảo, được tối ưu hóa cho động lực lăn có thể dự đoán."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFCLUB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFCLUB"
msgid "Essentially an instrument optimized for low-velocity kinetic transfer."
msgstr "Về cơ bản là một dụng cụ được tối ưu hóa cho việc truyền động năng vận tốc thấp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_DIY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_DIY"
msgid "One may use this to create a custom, and hopefully delightful, mini-golf course."
msgstr "Người ta có thể dùng cái này để tạo ra một sân golf mini tự chọn, và hy vọng là rất thú vị."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_EASY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_EASY"
msgid "An introductory course, no doubt."
msgstr "Chắc chắn là một sân tập cơ bản rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_HARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_HARD"
msgid "For those up for a challenge."
msgstr "Dành cho những ai thích thử thách."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_MEDIUM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_MEDIUM"
msgid "A course of middling difficulty."
msgstr "Một sân chơi có độ khó trung bình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_CUTOUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_CUTOUT"
msgid "It is both aesthetic marker and deliberate impediment to linear play."
msgstr "Nó vừa mang tính thẩm mỹ vừa là vật cản có chủ đích đối với đường chơi tuyến tính."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_FAN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_FAN"
msgid "The ball path must be adjusted to account for the wind."
msgstr "Đường đi của bóng phải được điều chỉnh để tính đến sức gió."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_FENCE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_FENCE"
msgid "It designates the play area."
msgstr "Nó định hình khu vực chơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_MOVINGWALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_MOVINGWALL"
msgid "A wall that rises and falls at set intervals."
msgstr "Một bức tường nâng lên hạ xuống theo các khoảng thời gian cố định."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_SPINNER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_SPINNER"
msgid "Its behavior is simple to describe, but intentionally difficult to accommodate."
msgstr "Hành vi của nó rất dễ mô tả, nhưng lại cố tình gây khó khăn để thích ứng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_SPRING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_SPRING"
msgid "A controlled propulsion platform using stored mechanical energy."
msgstr "Một bệ đẩy được kiểm soát sử dụng năng lượng cơ học tích trữ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLFPROP_WORMHOLE"
msgid "It connects to another on the course, enabling instantaneous transfer between them."
msgstr "Nó kết nối với một cái khác trên sân, cho phép chuyển đổi tức thời giữa chúng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_HOLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_HOLE"
msgid "The objective of the game is to deposit the ball into that hole with as few strokes as possible."
msgstr "Mục tiêu của trò chơi là đưa quả bóng vào hố đó với số cú đánh càng ít càng tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_HOLE_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_HOLE_KIT"
msgid "The flaghole should be positioned sufficiently far from the start to provide an appropriate challenge."
msgstr "Hố cờ nên được đặt cách xa điểm xuất phát đủ để tạo ra thử thách phù hợp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_TEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_TEE.GENERIC"
msgid "A token must be deposited before the machine will dispense a ball."
msgstr "Phải bỏ một đồng xu vào trước khi máy nhả bóng ra."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_TEE.INACTIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_TEE.INACTIVE"
msgid "The mini-golf course requires at least a flaghole to be playable."
msgstr "Sân golf mini yêu cầu ít nhất phải có một hố cờ mới chơi được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_TEE.PLAYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_TEE.PLAYING"
msgid "A token has been inserted. The match is already in play."
msgstr "Một đồng xu đã được đưa vào. Trận đấu đang diễn ra rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_TEE_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_GOLF_TEE_KIT"
msgid "Where the ball dropper is placed determines where we begin play."
msgstr "Vị trí đặt máy thả bóng quyết định nơi chúng ta bắt đầu chơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_HERDING_CHICK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_HERDING_CHICK"
msgid "Go on now, scoot!"
msgstr "Đi nào, lẹ lên!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_HERDING_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_HERDING_KIT"
msgid "It appears simple enough to construct."
msgstr "Có vẻ khá đơn giản để chế tạo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC"
msgid "I believe it requires a form of currency to start."
msgstr "Tôi tin là nó cần một loại tiền tệ nào đó để bắt đầu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING"
msgid "This looks like a good bit of exercise."
msgstr "Cái này trông giống như một bài tập thể dục hay ho đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC"
msgid "Part of the mechanism for the game, I'd imagine."
msgstr "Tôi đoán đây là một phần cơ chế của trò chơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING"
msgid "I believe it was this one here."
msgstr "Tôi tin là chính cái này đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_MEMORY_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_MEMORY_KIT"
msgid "It appears simple enough to construct."
msgstr "Có vẻ khá đơn giản để chế tạo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC"
msgid "I believe it requires a form of currency to start."
msgstr "Tôi tin là nó cần một loại tiền tệ nào đó để bắt đầu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING"
msgid "Ah! A simple test of one's aptitude for memorization."
msgstr "À! Một bài kiểm tra đơn giản về năng lực ghi nhớ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT"
msgid "It appears simple enough to construct."
msgstr "Có vẻ khá đơn giản để chế tạo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC"
msgid "I believe it requires a form of currency to start."
msgstr "Tôi tin là nó cần một loại tiền tệ nào đó để bắt đầu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING"
msgid "A game of odds and probability."
msgstr "Một trò chơi may rủi và xác suất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC"
msgid "I believe it requires a form of currency to start."
msgstr "Tôi tin là nó cần một loại tiền tệ nào đó để bắt đầu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING"
msgid "This appears to trigger the firing mechanism."
msgstr "Cái này có vẻ kích hoạt cơ chế bắn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_KIT"
msgid "It appears simple enough to construct."
msgstr "Có vẻ khá đơn giản để chế tạo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC"
msgid "I believe it requires a form of currency to start."
msgstr "Tôi tin là nó cần một loại tiền tệ nào đó để bắt đầu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING"
msgid "One's timing must be precise to win."
msgstr "Thời gian phải thật chuẩn xác mới thắng được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC"
msgid "Part of the mechanism for the game, I'd imagine."
msgstr "Tôi đoán đây là một phần cơ chế của trò chơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING"
msgid "It appears the object is to hit the insects while sparing the birds."
msgstr "Có vẻ mục tiêu là đánh trúng lũ côn trùng trong khi tha cho mấy chú chim."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT"
msgid "It appears simple enough to construct."
msgstr "Có vẻ khá đơn giản để chế tạo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC"
msgid "I believe it requires a form of currency to start."
msgstr "Tôi tin là nó cần một loại tiền tệ nào đó để bắt đầu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING"
msgid "Curious. It seems that it's designed to be impossible to lose."
msgstr "Lạ thật. Có vẻ nó được thiết kế để không tài nào thua được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_BALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_BALL"
msgid "I don't want to see anyone playing with this near any breakables."
msgstr "Tôi không muốn thấy ai chơi đùa với thứ này ở gần mấy đồ dễ vỡ đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_CROWKID
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_CROWKID"
msgid "Corvids are remarkably intelligent, I'd imagine this species is even more so."
msgstr "Lũ quạ cực kỳ thông minh, tôi tưởng tượng loài này thậm chí còn hơn thế nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_GAMETOKEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_GAMETOKEN"
msgid "A form of avian currency, perhaps?"
msgstr "Có lẽ là một dạng tiền tệ của loài chim chăng?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_HOST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_HOST"
msgid "He's a rather curious character."
msgstr "Cậu ta là một nhân vật khá kỳ quặc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PLAZA.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
msgid "It seems customary to place decorations around it."
msgstr "Có vẻ như người ta thường đặt đồ trang trí xung quanh nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
msgid "Oh yes, that's coming along quite nicely!"
msgstr "Ồ vâng, tiến triển khá tốt đấy chứ!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3"
msgid "That appears to be an acceptable level of decoration."
msgstr "Trông có vẻ là một mức độ trang trí có thể chấp nhận được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PLAZA_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PLAZA_KIT"
msgid "What an intriguing specimen... I can't quite pinpoint the subspecies."
msgstr "Thật là một mẫu vật hấp dẫn... Tôi không tài nào xác định được phân loài của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC"
msgid "There is a surprisingly varied selection to choose from."
msgstr "Có rất nhiều lựa chọn đa dạng một cách đáng ngạc nhiên để chọn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT"
msgid "It appears simple enough to construct."
msgstr "Có vẻ khá đơn giản để chế tạo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC"
msgid "I should be able to exchange these for a prize of some sort."
msgstr "Tôi nên đổi mấy thứ này lấy một phần thưởng nào đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK"
msgid "I seem to be quite good at these games!"
msgstr "Tôi có vẻ khá giỏi mấy trò chơi này đấy!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
msgid "I assume the more tickets I collect, the greater the prize will be."
msgstr "Tôi đoán càng thu thập được nhiều vé, giải thưởng sẽ càng lớn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_SEEDPACKET"
msgid "A bit of extra fiber added to one's diet never hurts."
msgstr "Bổ sung thêm chút chất xơ vào chế độ ăn uống không bao giờ là thừa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_VEST_A
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_VEST_A"
msgid "The corvids seem to have developed a method of fabricating clothing from leaves."
msgstr "Lũ quạ hình như đã phát triển được cách chế tạo quần áo từ lá cây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_VEST_B
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_VEST_B"
msgid "How fascinating that these corvids have evolved to the point of wearing clothing."
msgstr "Thật kỳ diệu làm sao khi lũ quạ này đã tiến hóa đến mức biết mặc quần áo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_VEST_C
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARNIVAL_VEST_C"
msgid "It smells deligthfully of summer leaves."
msgstr "Nó tỏa ra mùi thơm dễ chịu của lá cây mùa hè."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARPENTRY_BLADE_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARPENTRY_BLADE_MOONGLASS"
msgid "A moon glass saw blade. Sharp enough to cut stone."
msgstr "Một lưỡi cưa thủy tinh trăng. Đủ sắc bén để cắt đá xẻ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARPENTRY_STATION.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARPENTRY_STATION.BURNT"
msgid "I suppose my reading chair will have to wait."
msgstr "Chắc chiếc ghế đọc sách của tôi phải đợi rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARPENTRY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARPENTRY_STATION.GENERIC"
msgid "I could use a new reading chair."
msgstr "Tôi có thể dùng một chiếc ghế đọc sách mới."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARRAT.DEAD"
msgid "Perhaps that was unnecessary."
msgstr "Có lẽ việc đó là không cần thiết."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARRAT.GENERIC"
msgid "My, another plant and animal hybrid. How odd."
msgstr "Chà, lại thêm một sinh vật lai giữa thực vật và động vật nữa. Lạ thật đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARRAT.HELD"
msgid "The plant and animal matter has fused in total harmony."
msgstr "Chất liệu thực vật và động vật đã hòa quyện với nhau một cách hoàn hảo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARRAT.SLEEPING"
msgid "It's in a deep sleep."
msgstr "Nó đang ngủ say."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARRAT_GHOSTRACER"
msgid "Fascinating! A new genus, perhaps?"
msgstr "Thật thú vị! Có lẽ là một chi mới chăng?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARROT"
msgid "Daucus carota. Edible, and delicious."
msgstr "Daucus carota. Ăn được, và rất ngon."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARROT_COOKED"
msgid "Daucus carota, roasted to perfection."
msgstr "Daucus carota, nướng hoàn hảo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARROT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARROT_OVERSIZED"
msgid "The result of proper research, planning and care."
msgstr "Kết quả của việc nghiên cứu, lập kế hoạch và chăm sóc đúng đắn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARROT_PLANTED"
msgid "Daucus carota is a root vegetable."
msgstr "Daucus carota là một loại rau củ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARROT_SEEDS"
msgid "It can't begin growing until it's been planted, dear."
msgstr "Nó không thể bắt đầu lớn lên cho đến khi được trồng xuống, cưng ạ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "Can we have nothing decent?"
msgstr "Chúng ta không thể có lấy một thứ đàng hoàng sao?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "The destruction of knowledge is such a difficult thing to stomach."
msgstr "Sự hủy diệt tri thức thật khó mà chấp nhận được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "Ah! A proper desk! Just look at the finish on that wood!"
msgstr "À! Một chiếc bàn đàng hoàng! Hãy nhìn lớp sơn bóng trên thớ gỗ kìa!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CATCOON"
msgid "A sort of a wildcat. Handsome fellow."
msgstr "Một dạng mèo rừng. Chàng trai bảnh bao."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CATCOONDEN.EMPTY"
msgid "Looks used up."
msgstr "Trông có vẻ đã tơi tả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CATCOONDEN.GENERIC"
msgid "An excellent hollow for a den."
msgstr "Một cái hốc tuyệt vời để làm ổ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CATCOONHAT"
msgid "Not quite like Crockett's, but it'll do."
msgstr "Không hẳn giống mũ của Crockett, nhưng tạm ổn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CATTOY_MOUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CATTOY_MOUSE"
msgid "A simple mechanism behind an entertaining toy for felines."
msgstr "Một cơ chế đơn giản đằng sau món đồ chơi giải trí cho loài mèo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "It looks as though it can be moved."
msgstr "Trông có vẻ có thể dịch chuyển được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "We must clear the surrounding boulders first."
msgstr "Chúng ta phải dọn sạch những tảng đá xung quanh trước."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_BANANA"
msgid "All of them are genetically identical."
msgstr "Tất cả chúng đều giống hệt nhau về mặt di truyền."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_BANANA_BURNT"
msgid "I do not believe this one can be restored."
msgstr "Tôi không nghĩ cái này có thể phục hồi lại được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Somewhat better."
msgstr "Khá hơn một chút."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_BANANA_TREE"
msgid "The seeds must have fallen down a sinkhole."
msgstr "Hạt giống chắc là đã rơi xuống một cái hố."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_ENTRANCE"
msgid "The placement of that rock looks intentional."
msgstr "Vị trí của hòn đá đó trông có vẻ có chủ đích."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "Much too crowded for my liking."
msgstr "Quá đông đúc so với sở thích của tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "Perhaps when I am better prepared."
msgstr "Có lẽ khi tôi chuẩn bị kỹ càng hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "The subterranean world awaits."
msgstr "Thế giới dưới lòng đất đang chờ đón."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "The passage has been obstructed."
msgstr "Lối đi đã bị chặn lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_EXIT.FULL"
msgid "With all those people? It's bound to be cacophony."
msgstr "Với ngần ấy người á? Chắc chắn sẽ là một mớ âm thanh hỗn độn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "Perhaps later."
msgstr "Có lẽ để sau đi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_EXIT.OPEN"
msgid "Maybe I should go back up for some fresh air."
msgstr "Có lẽ tôi nên quay lên trên để hít thở không khí trong lành."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_FERN"
msgid "A lovely ornamental plant."
msgstr "Một loại thực vật cảnh đáng yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_FERN_WITHERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_FERN_WITHERED"
msgid "It is quite dead."
msgstr "Nó đã chết hẳn rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_MITE.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_MITE.DEAD"
msgid "This one is deceased."
msgstr "Con này đã tử vong."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_MITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_MITE.GENERIC"
msgid "This mineral hybrid creature possesses the ability to store gas under considerable pressure."
msgstr "Sinh vật lai khoáng chất này có khả năng trữ khí dưới áp suất đáng kể."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_MITE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_MITE.SLEEPING"
msgid "It is dormant at the moment."
msgstr "Nó đang ngủ đông vào lúc này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_MITE.VENTING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_MITE.VENTING"
msgid "It is venting gas as a form of attack."
msgstr "Nó đang xả khí như một hình thức tấn công."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_ROCK.GAS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_ROCK.GAS"
msgid "Those fumes are harmful to inhale and will cause spoilage to perishables."
msgstr "Những làn khói đó rất có hại khi hít phải và sẽ làm đồ dễ hỏng bị ôi thiu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_ROCK.GENERIC"
msgid "Fumarole from which a number of gasses may emerge. Best steer clear."
msgstr "Miệng phun địa nhiệt tỏa ra một số loại khí. Tốt nhất là nên tránh xa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_ROCK.HOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_ROCK.HOT"
msgid "Merely geothermal steam venting from a fumarole. One needn't be alarmed."
msgstr "Chỉ là hơi nước địa nhiệt bốc lên từ một miệng phun địa nhiệt. Không có gì phải hoảng sợ cả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_ROCK.MIASMA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CAVE_VENT_ROCK.MIASMA"
msgid "Prudence dictates minimizing exposure to that most insidious vapor."
msgstr "Sự thận trọng đòi hỏi phải giảm thiểu việc tiếp xúc với thứ hơi độc hại đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CEILING_ROPE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CEILING_ROPE"
msgid "A tried and true means of escape."
msgstr "Một phương tiện tẩu thoát quen thuộc và hiệu quả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CEVICHE"
msgid "Could use a little more sauce."
msgstr "Có thể dùng thêm một ít sốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARCOAL"
msgid "It's mostly carbon and ash."
msgstr "Nó chủ yếu là carbon và tro."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIERESIDUE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIERESIDUE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIEROSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIEROSE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIE_HAND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIE_HAND"
msgid "It requires materials."
msgstr "Nó cần nguyên liệu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIE_HECKLER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIE_HECKLER"
msgid "I wouldn't classify their criticism as constructive."
msgstr "Tôi không xếp những lời chỉ trích của họ vào loại mang tính xây dựng đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIE_LECTURN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIE_LECTURN"
msgid "It lists the characters in the next act."
msgstr "Nó liệt kê các nhân vật trong màn tiếp theo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIE_NPC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIE_NPC"
msgid "I'd like to give that young lady a stern talking to!"
msgstr "Tôi muốn dạy cho cô trẻ đó một bài học nghiêm khắc!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIE_STAGE_POST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHARLIE_STAGE_POST"
msgid "The builder must have been inspired by the Greek dramas of antiquity."
msgstr "Người xây dựng chắc hẳn đã lấy cảm hứng từ các vở kịch Hy Lạp cổ đại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSJUNK1"
msgid "The magician's unfinished projects?"
msgstr "Những dự án còn dang dở của nhà ảo thuật sao?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSJUNK2"
msgid "The magician's unfinished projects?"
msgstr "Những dự án còn dang dở của nhà ảo thuật sao?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSJUNK3"
msgid "The magician's unfinished projects?"
msgstr "Những dự án còn dang dở của nhà ảo thuật sao?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "Artists tend to reference what they're familiar with."
msgstr "Các nghệ sĩ thường tham khảo những gì họ quen thuộc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_ANTLION"
msgid "A stately statuary of the Panthera auropunctata."
msgstr "Bức tượng trang nghiêm của loài Panthera auropunctata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BEARGER"
msgid "Quite expressive!"
msgstr "Khá biểu cảm đấy chứ!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BEARGER_MUTATED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BEARGER_MUTATED"
msgid "The artist truly captured its ferocity!"
msgstr "Người nghệ sĩ thực sự đã nắm bắt được sự hung dữ của nó!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BEEFALO"
msgid "It captures my beefalo's likeness quite well."
msgstr "Nó khắc họa khá giống con bò lai của tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "A queenly tribute to the Apis mellifera."
msgstr "Một sự tôn kính đầy vương giả dành cho loài Apis mellifera."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "A decorative stone carving of a bishop chess piece."
msgstr "Một bức chạm khắc đá trang trí hình quân tượng trong cờ vua."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "It seems magic is afoot."
msgstr "Dường như có phép thuật đang hoạt động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "Carved in the lunar moth's likeness."
msgstr "Được chạm khắc theo hình dáng của loài sâu đêm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_CARRAT"
msgid "A delightfully rendered likeness of the Daucus carota rattus."
msgstr "Một tạo hình vô cùng đẹp mắt của loài Daucus carota rattus."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_CATCOON"
msgid "The resemblance to the Felis lybica is incredible."
msgstr "Sự giống nhau với loài Felis lybica thật đáng kinh ngạc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "A replica of Canis lupis."
msgstr "Một bản sao của loài Canis lupis."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "The sculptor clearly studied the creature closely."
msgstr "Nhà điêu khắc rõ ràng đã nghiên cứu rất kỹ sinh vật lạ này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_CRABKING"
msgid "A rendering of a treasure-obsessed crustacean."
msgstr "Hình ảnh mô phỏng một sinh vật giáp xác ám ảnh với kho báu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "An accurate stone model of that ill-behaved creature."
msgstr "Mô hình đá chính xác của sinh vật hư hỏng đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DAYWALKER2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DAYWALKER2"
msgid "Resourceful, admittedly. Yet, in essence, a brute."
msgstr "Tháo vát đấy, phải công nhận vậy. Nhưng suy cho cùng vẫn chỉ là một tên vũ lực."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "An anatomical study of those strange beasts."
msgstr "Một nghiên cứu giải phẫu về những con quái vật kỳ lạ đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "Such a strange and grotesque affliction..."
msgstr "Thật là một căn bệnh kỳ lạ và quái dị..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DEPTHWORM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DEPTHWORM"
msgid "One of the hungriest large invertebrates."
msgstr "Một trong những loài động vật không xương sống lớn phàm ăn nhất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "Artist's interpretation of mythical Diptera."
msgstr "Sự diễn giải của nghệ sĩ về loài Diptera thần thoại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "A trophy that doubles as a useful anatomical model."
msgstr "Một chiếc cúp đồng thời là mô hình giải phẫu hữu ích."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_FORMAL"
msgid "The king is, by all measures, a liability to everyone on the board."
msgstr "Vua chúa, xét về mọi mặt, là một gánh nặng cho tất cả mọi người trên bàn cờ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "I must commend the artist for their attention to detail."
msgstr "Tôi phải ca ngợi nghệ sĩ vì sự chú ý đến từng chi tiết của họ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "It is a commonly held belief that art imitates life."
msgstr "Có một niềm tin phổ biến rằng nghệ thuật bắt nguồn từ cuộc sống."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_KITCOON"
msgid "I should warn the children not to play too close to it."
msgstr "Tôi nên cảnh báo lũ trẻ không được chơi quá gần nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_KLAUS"
msgid "A wonderfully seasonal simulacrum."
msgstr "Một mô hình giả lập theo mùa tuyệt đẹp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "A knight, in service to the king. Or perhaps the queen."
msgstr "Một hiệp sĩ, phục vụ nhà vua. Hoặc có thể là hoàng hậu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "It seems magic is afoot."
msgstr "Dường như có phép thuật đang hoạt động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "I'll have to add an appendix to \"Birds of the World\"."
msgstr "Tôi sẽ phải bổ sung một phần phụ lục vào cuốn \"Những Con Chim Của Thế Giới\"."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "Those lagomorphs are quite the rascals."
msgstr "Mấy con thỏ đó đúng là những kẻ tinh quái."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "A rather convincing likeness."
msgstr "Một tạo hình khá thuyết phục."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MOON"
msgid "The missing chunk is a recent development."
msgstr "Phần bị khuyết là sự phát triển gần đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "Bust of Alces canadensis."
msgstr "Bán thân của loài Alces canadensis."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_MUSE"
msgid "In chess, the queen is by far the most strategically formidable."
msgstr "Trong cờ vua, quân hậu là quân mạnh nhất về mặt chiến lược."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_PAWN"
msgid "Pawns that journey to the seat of power can be quite dangerous."
msgstr "Những quân tốt tiến đến ngai vàng có thể vô cùng nguy hiểm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_PIPE"
msgid "I hope this does not have a bad influence on the children."
msgstr "Tôi hy vọng thứ này không có ảnh hưởng xấu đến bọn trẻ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "Represents the protective walls of the king's castle."
msgstr "Đại diện cho những bức tường bảo vệ lâu đài của nhà vua."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "It seems magic is afoot."
msgstr "Dường như có phép thuật đang hoạt động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_SHARKBOI
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_SHARKBOI"
msgid "The mouthiest of its species."
msgstr "Kẻ lắm điều nhất trong loài của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_STALKER"
msgid "The artist faithfully replicated its skeletal structure."
msgstr "Nghệ sĩ đã tái tạo trung thực cấu trúc bộ xương của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "The artist captured the parasitic relationship beautifully."
msgstr "Nghệ sĩ đã nắm bắt mối quan hệ ký sinh một cách tuyệt đẹp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "A stone rendition of a pair of mechanical marvels."
msgstr "Bức tượng bằng đá tạc lại một cặp kỳ quan cơ khí."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD"
msgid "It proved a marvel of ancient architecture."
msgstr "Nó chứng tỏ là một kỳ quan kiến trúc cổ đại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR"
msgid "This dreadful amalgamation was unprecedented."
msgstr "Sự kết hợp khủng khiếp này chưa từng có tiền lệ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT"
msgid "A miniature of the homicidal automaton. Hm."
msgstr "Bản thu nhỏ của cỗ máy giết người. Hừm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "There is much I still don't understand about this beast."
msgstr "Vẫn còn rất nhiều điều tôi chưa hiểu về con quái vật này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_WORMBOSS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_WORMBOSS"
msgid "This ancestor of the predatory annelid was far worse."
msgstr "Tổ tiên của loài giun nhiều tơ săn mồi này còn tồi tệ hơn nhiều."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_YOTD"
msgid "A curious combination; the fire-breathing Diptera and seafaring."
msgstr "Một sự kết hợp kỳ lạ; loài Diptera phun lửa và việc đi biển."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_YOTH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_YOTH"
msgid "This mechanical knight demonstrates loyalty to whomever dons the garb of its charge."
msgstr "Hiệp sĩ cơ khí này thể hiện lòng trung thành với bất kỳ ai mặc trang phục bảo vệ của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_YOTS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESSPIECE_YOTS"
msgid "One of the hungriest large invertebrates."
msgstr "Một trong những loài động vật không xương sống lớn phàm ăn nhất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESTER"
msgid "A motile storage chest."
msgstr "Một chiếc rương đựng đồ biết di chuyển."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "Oculus Mysterium."
msgstr "Oculus Mysterium."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "The oculus is inactive."
msgstr "Con mắt đang không hoạt động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "Increases the capacity of a storage container by a, frankly, absurd degree."
msgstr "Tăng sức chứa của một vật chứa đồ lên một mức độ, thành thật mà nói, là vô lý."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHEST_MIMIC_REVEALED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHEST_MIMIC_REVEALED"
msgid "This creature mimics an artifact."
msgstr "Sinh vật này giả dạng một cổ vật."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CHUM"
msgid "I find it best not to dwell on what it's made of."
msgstr "Tôi thấy tốt nhất là không nên bận tâm đến việc nó được làm từ gì."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CLAYHOUND.GENERIC"
msgid "The earthenware has been magically animated."
msgstr "Đồ gốm đã được yểm bùa để chuyển động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CLAYHOUND.STATUE"
msgid "Terra cotta earthenware."
msgstr "Đồ gốm đất nung."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CLAYWARG.GENERIC"
msgid "Ah, how charmingly fearsome."
msgstr "Chà, đáng sợ một cách đáng yêu làm sao."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CLAYWARG.STATUE"
msgid "An intricately crafted terra cotta statue."
msgstr "Một bức tượng đất nung được chế tác tinh xảo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.EMBERS"
msgid "The fire has almost self-extinguished."
msgstr "Ngọn lửa gần như đã tự tắt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.GENERIC"
msgid "A rather strange, magical fire pit."
msgstr "Một lò lửa kỳ lạ và có phép thuật."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.HIGH"
msgid "That fire is burning at an alarming rate."
msgstr "Đống lửa đó đang cháy với tốc độ đáng báo động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.LOW"
msgid "The fire could use some more fuel."
msgstr "Lửa có thể cần thêm chút nhiên liệu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.NORMAL"
msgid "A perfectly unusual fire."
msgstr "Một ngọn lửa hoàn toàn bất thường."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIRE.OUT"
msgid "It can be re-lit."
msgstr "Nó có thể được nhóm lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "The fire has almost self-extinguished."
msgstr "Ngọn lửa gần như đã tự tắt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "A fire pit. It's chilly."
msgstr "Một lò lửa. Trời lạnh thật."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.HIGH"
msgid "That fire is burning at an alarming rate."
msgstr "Đống lửa đó đang cháy với tốc độ đáng báo động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.LOW"
msgid "The fire could use some more fuel, whatever fuel it takes."
msgstr "Lửa có thể cần thêm chút nhiên liệu, bất kể là thứ gì cháy được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "A fire. Of some kind."
msgstr "Một đống lửa. Kiểu vậy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLDFIREPIT.OUT"
msgid "It can be re-lit."
msgstr "Có thể thắp sáng lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COLLAPSEDCHEST"
msgid "It would be prudent to rebuild the chest, rather than leave all this lying about."
msgstr "Sẽ khôn ngoan hơn nếu chế tạo lại rương thay vì để đống đồ này vương vãi khắp nơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.E"
msgid "East."
msgstr "Hướng Đông."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.GENERIC"
msgid "The coordinates remain unknown."
msgstr "Tọa độ vẫn không rõ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.N"
msgid "North."
msgstr "Hướng Bắc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.NE"
msgid "Northeast."
msgstr "Hướng Đông Bắc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.NW"
msgid "Northwest."
msgstr "Hướng Tây Bắc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.S"
msgid "South."
msgstr "Hướng Nam."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.SE"
msgid "Southeast."
msgstr "Hướng Đông Nam."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.SW"
msgid "Southwest."
msgstr "Hướng Tây Nam."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPASS.W"
msgid "West."
msgstr "Hướng Tây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOST"
msgid "The secret to any garden's success is nutrient-rich soil."
msgstr "Bí quyết cho sự thành công của mọi khu vườn là đất giàu dinh dưỡng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "A well balanced mix."
msgstr "Một tỷ lệ pha trộn rất cân đối."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "Well... I suppose plants need carbon too."
msgstr "Chà... Ta cho rằng thực vật cũng cần carbon."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "It requires a bit more moisture."
msgstr "Nó cần thêm một chút độ ẩm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "Composting is an essential component to gardening."
msgstr "Ủ phân là một thành phần thiết yếu trong việc làm vườn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTINGBIN.WET"
msgid "The moisture level of this mixture is too high."
msgstr "Độ ẩm của hỗn hợp này quá cao."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COMPOSTWRAP"
msgid "Oh dear. Those are some large droppings."
msgstr "Ôi trời. Đống phân này lớn thật đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CONSTRUCTION_PLANS"
msgid "Oh, I do like the look of this."
msgstr "Ồ, trông cái này hay phết đấy chứ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKBOOK"
msgid "A collection of culinary observations."
msgstr "Một tập hợp các quan sát ẩm thực."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKEDMANDRAKE"
msgid "Mandragora officinarum, cooked in the name of discovery."
msgstr "Mandragora officinarum, được nấu chín nhân danh khoa học."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKEDMEAT"
msgid "It is slightly more appetizing when cooked."
msgstr "Nó kích thích vị giác hơn một chút khi được nấu chín."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKEDMONSTERMEAT"
msgid "It's still a little bit poisonous."
msgstr "Nó vẫn còn hơi độc một chút."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKEDSMALLMEAT"
msgid "It is slightly more appetizing when cooked."
msgstr "Nó kích thích vị giác hơn một chút khi được nấu chín."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKIECUTTER"
msgid "Its eyes seem fixed to my raft."
msgstr "Đôi mắt của nó cứ dán chặt vào chiếc bè của ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKIECUTTERHAT"
msgid "Hm, it has a very disagreeable odor."
msgstr "Hừm, nó có một mùi rất khó chịu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKIECUTTERSHELL"
msgid "A thick casing of calcium carbonate."
msgstr "Một lớp vỏ canxi carbonat dày."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "Oh dear, I can't seem to make any sense of it."
msgstr "Ôi trời, ta chẳng tài nào hiểu được cái này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKPOT.BURNT"
msgid "Now it's truly derelict."
msgstr "Giờ thì nó thực sự tàn tạ rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "It's got a bit to go before it's ready."
msgstr "Vẫn còn một lúc nữa mới xong."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "Almost done!"
msgstr "Sắp xong rồi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKPOT.DONE"
msgid "Supper time!"
msgstr "Đến giờ ăn tối rồi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOKPOT.EMPTY"
msgid "It looks derelict when it's not cooking something."
msgstr "Trông nó thật tiêu điều khi không nấu thứ gì."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOLANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COOLANT"
msgid "The fluids exhibit anomalous properties, no doubt catalyzed by the mutations."
msgstr "Chất lỏng này thể hiện các đặc tính bất thường, chắc chắn là do đột biến xúc tác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COONTAIL"
msgid "A flexible torso appendage."
msgstr "Một phần phụ linh hoạt ở phần thân."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CORN"
msgid "Zea mays, a great staple food."
msgstr "Zea mays, một loại lương thực chủ lực tuyệt vời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CORN_COOKED"
msgid "Popped corn!"
msgstr "Bỏng ngô!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CORN_OVERSIZED"
msgid "Quite an impressive harvest."
msgstr "Một vụ thu hoạch khá ấn tượng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CORN_SEEDS"
msgid "It can't begin growing until it's been planted, dear."
msgstr "Nó không thể bắt đầu mọc cho đến khi được gieo xuống đất đâu, cưng à."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "It appears to be a theatrical costume."
msgstr "Trông có vẻ là một bộ trang phục sân khấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COSTUME_DOLL_BODY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COSTUME_DOLL_BODY"
msgid "It appears to be a theatrical costume."
msgstr "Trông có vẻ là một bộ trang phục sân khấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COSTUME_FOOL_BODY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COSTUME_FOOL_BODY"
msgid "It appears to be a theatrical costume."
msgstr "Trông có vẻ là một bộ trang phục sân khấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COSTUME_KING_BODY"
msgid "It appears to be a theatrical costume."
msgstr "Trông có vẻ là một bộ trang phục sân khấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "It appears to be a theatrical costume."
msgstr "Trông có vẻ là một bộ trang phục sân khấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COSTUME_PRINCESS_BODY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COSTUME_PRINCESS_BODY"
msgid "These garments are indicative of royal status."
msgstr "Những trang phục này biểu thị địa vị hoàng gia."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "It appears to be a theatrical costume."
msgstr "Trông có vẻ là một bộ trang phục sân khấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COSTUME_TREE_BODY"
msgid "It appears to be a theatrical costume."
msgstr "Trông có vẻ là một bộ trang phục sân khấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "A small fire is needed to achieve the full effect."
msgstr "Cần một đốm lửa nhỏ để đạt hiệu quả tối đa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "This statue seems to have fallen into disrepair."
msgstr "Bức tượng này có vẻ đã xuống cấp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "A small fire is needed to achieve the full effect."
msgstr "Cần một đốm lửa nhỏ để đạt hiệu quả tối đa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "What a charming statue."
msgstr "Đúng là một bức tượng duyên dáng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "Fire is needed to achieve the full effect."
msgstr "Cần lửa để đạt hiệu quả tối đa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "The firelight reflecting against the gold surface is almost hypnotic."
msgstr "Ánh lửa phản chiếu lên bề mặt vàng trông gần như có thể thôi miên vậy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COTL_TRINKET"
msgid "Oh dear, did it just blink at me?"
msgstr "Ôi trời, nó vừa chớp mắt với ta phải không?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COZY_BUNNYMAN"
msgid "They look quite comfortable."
msgstr "Trông chúng có vẻ rất thoải mái."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRABKING.GENERIC"
msgid "I wonder if its size is natural or caused by lunar mutations?"
msgstr "Không biết kích thước của nó là tự nhiên hay do đột biến từ mặt trăng nhỉ?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRABKING.INERT"
msgid "Those impressions appear to have been made to house gems."
msgstr "Những vết lõm đó có vẻ được tạo ra để khảm ngọc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRABKING_CANNONTOWER"
msgid "Curious. These crustaceans have learned to launch projectiles."
msgstr "Thật tò mò. Lũ động vật giáp xác này đã học được cách phóng vật thể rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRABKING_CLAW"
msgid "Thank goodness I'm not allergic to shellfish."
msgstr "Thật may là tôi không bị dị ứng với hải sản."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRABKING_ICEWALL"
msgid "A solid but not impenetrable layer of defense."
msgstr "Một lớp phòng thủ vững chắc nhưng không phải là không thể xuyên thủng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRABKING_MOB"
msgid "The crabs are protecting their king."
msgstr "Lũ cua đang bảo vệ vua của chúng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "That is one brute of a decapod."
msgstr "Đúng là một con cua mười chân cục súc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTERLAB"
msgid "A perfect hollow for nesting animals."
msgstr "Một cái hốc hoàn hảo để làm ổ cho động vật."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_BULBIN"
msgid "Are you animal or vegetable, dear?"
msgstr "Cưng là động vật hay thực vật thế, cưng ơi?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_DRAGONLING"
msgid "What a darling Diptera juvenile!"
msgstr "Quả là một con ấu trùng Bộ Hai Vánh đáng yêu!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_EETS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_EETS"
msgid "It seems to have a liking for confectionary treats such as cakes."
msgstr "Nó có vẻ thích các món đồ ngọt như bánh ngọt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "Now, I wonder if your nerves are functional, or merely decorative..."
msgstr "Giờ thì, không biết hệ thần kinh của ngươi có hoạt động không, hay chỉ để trang trí..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_GLOMLING"
msgid "How do you maintain flight, dear?"
msgstr "Làm sao mà cưng có thể bay được thế, cưng ơi?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_KITTEN"
msgid "Now it feels like home."
msgstr "Bây giờ nơi này đã có cảm giác như nhà rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_LAMB"
msgid "I could just squish that widdle face."
msgstr "Ta chỉ muốn cấu yêu cái khuôn mặt nhỏ nhắn đó thôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "Who wuvs their widdle specimen?"
msgstr "Ai mà cưng chiều mẫu vật nhỏ xíu này thế nhỉ?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_PERDLING"
msgid "What a handsome poult you are!"
msgstr "Bạn nhỏ thật là một chú gà con bảnh bao!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_PUPPY"
msgid "Who's the sweetest little Canis lupus?"
msgstr "Ai là chú chó sói nhỏ đáng yêu nhất nào?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CROW.GENERIC"
msgid "Corvus brachyrhynchos."
msgstr "Corvus brachyrhynchos."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CROW.HELD"
msgid "A perfectly handsome specimen."
msgstr "Một mẫu vật vô cùng đẹp đẽ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRUMBS"
msgid "I believe this came from the walking confectionery."
msgstr "Ta tin là thứ này rơi ra từ cửa hàng bánh kẹo đi động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "Primitive jewelry."
msgstr "Trang sức nguyên thủy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CUTGRASS"
msgid "Some grass cuttings."
msgstr "Vài cọng cỏ cắt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CUTLESS"
msgid "It may be a suitable plaything for the children, if they behave themselves."
msgstr "Nó có thể là một món đồ chơi thích hợp cho lũ trẻ, nếu chúng biết điều."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CUTLICHEN"
msgid "This won't last long."
msgstr "Thứ này sẽ không tồn tại lâu đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CUTREEDS"
msgid "Some rush cuttings."
msgstr "Vài cọng sậy cắt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CUTSTONE"
msgid "Some smoothed rock slabs."
msgstr "Vài phiến đá tảng được mài nhẵn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DAYWALKER.GENERIC"
msgid "This creature has terrible manners."
msgstr "Sinh vật này có cách cư xử thật tệ hại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "My, how did it end up in this state?"
msgstr "Chà, làm thế nào mà nó lại ra nông nỗi này cơ chứ?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DAYWALKER2.BURIED"
msgid "The pitiful beast is pinned beneath this pile of debris."
msgstr "Con thú đáng thương bị kẹt dưới đống đổ nát này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DAYWALKER2.GENERIC"
msgid "The creature appears calm for now. Best not aggravate it."
msgstr "Sinh Vật Lạ có vẻ bình tĩnh lúc này. Tốt nhất là đừng chọc giận nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "Someone should teach this brute some manners."
msgstr "Ai đó nên dạy cho con vật cục súc này vài phép tắc ứng xử."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "It will require much greater force than I can muster to break it."
msgstr "Nó sẽ đòi hỏi lực tác động lớn hơn nhiều so với sức của ta để phá vỡ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "How odd... the marble appears to be encasing something."
msgstr "Thật kỳ lạ... khối đá cẩm thạch hình như đang bao bọc thứ gì đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEADLYFEAST"
msgid "I'm not sure that's good to eat."
msgstr "Ta không chắc thứ đó có ngon lành gì không."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEAD_SEA_BONES"
msgid "What curious skeletal structures."
msgstr "Cấu trúc bộ xương mới tò mò làm sao."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "The tree is burning."
msgstr "Cái cây đang bốc cháy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "A carbonized tree."
msgstr "Một cái cây đã bị carbon hóa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "It has been harvested."
msgstr "Nó đã được thu hoạch rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "Fagales of some kind. It bears fruit when fully grown."
msgstr "Họ Dẻ nào đó. Nó ra quả khi trưởng thành hoàn toàn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "That is no tree I've seen before!"
msgstr "Đó không phải cái cây nào mà ta từng thấy trước đây!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECK_OF_CARDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECK_OF_CARDS"
msgid "Do we have enough players for Bridge?"
msgstr "Chúng ta có đủ người chơi bài Bridge không nhỉ?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECOR_CENTERPIECE"
msgid "I suppose it's pretty, but it doesn't do much."
msgstr "Ta đoán nó đẹp đấy, nhưng chẳng làm được gì mấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "Ah, could use a doily, wouldn't you say?"
msgstr "À, dùng thêm một chiếc khăn lót thì tuyệt đấy nhỉ?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "The more light to read by the better, in my opinion."
msgstr "Theo ý kiến của tôi, càng nhiều ánh sáng để đọc sách thì càng tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "It's pleasant to see a little decor out here."
msgstr "Thật dễ chịu khi thấy chút đồ trang trí ngoài này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "It is Maxwell's turn to procure bulbs. I've it written down right here."
msgstr "Đến lượt Maxwell đi kiếm bóng đèn rồi. Tôi đã ghi lại ở đây này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "A pity. Shall we find replacements?"
msgstr "Tiếc thật. Chúng ta tìm đồ thay thế nhé?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECOR_LAMP"
msgid "Now I can read my books at night."
msgstr "Giờ thì tôi có thể đọc sách vào ban đêm rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "Sure. Why not?"
msgstr "Chắc chắn rồi. Tại sao lại không nhỉ?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "All art begins with a blank page."
msgstr "Mọi nghệ thuật đều bắt đầu từ một trang giấy trắng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "A decent resemblance."
msgstr "Trông khá giống đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEER.ANTLER"
msgid "Its antler has grown in for winter."
msgstr "Gạc của nó đã mọc ra cho mùa đông."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEER.GENERIC"
msgid "It has shed its antler for the warmer months."
msgstr "Nó đã rụng gạc cho những tháng ấm áp hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEERCLOPS"
msgid "Laurasiatheria!"
msgstr "Bộ Laurasiatheria!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "It's the safest course of action."
msgstr "Đó là cách xử lý an toàn nhất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "It might be prudent to dispose of the body."
msgstr "Sẽ khôn ngoan hơn nếu đem vứt cái xác này đi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "Goodness! Something is reanimating the body!"
msgstr "Chúa ơi! Có thứ gì đó đang hồi sinh cái xác!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "An implement that conditions the air, or ambient-temperature-reduction-device for short."
msgstr "Một dụng cụ điều hòa không khí, hay gọi tắt là thiết bị giảm nhiệt độ môi trường."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "It is rendered useless without the eye of that beast."
msgstr "Nó trở nên vô dụng nếu không có con mắt của con quái thú đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "It should be a simple matter to construct it."
msgstr "Chế tạo cái này chắc là chuyện đơn giản."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "I feel a vague sense of accomplishment."
msgstr "Tôi cảm thấy một chút tự hào mơ hồ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEER_ANTLER"
msgid "It looks like a key, but it's quite brittle."
msgstr "Trông nó giống chìa khóa, nhưng lại rất giòn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEER_GEMMED"
msgid "The poor creature has been forcibly fused to a magic gem."
msgstr "Con sinh vật tội nghiệp đã bị dung hợp cưỡng bức với một viên ngọc ma thuật."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "A tuft of a graminoid."
msgstr "Một bụi thực vật thân cỏ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DESERTHAT"
msgid "Much more effective than reading glasses."
msgstr "Hiệu quả hơn nhiều so với kính đọc sách."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DESICCANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DESICCANT"
msgid "It will help me be rid of excess moisture."
msgstr "Nó sẽ giúp tôi loại bỏ độ ẩm dư thừa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DESICCANTBOOSTED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DESICCANTBOOSTED"
msgid "This should keep me comfortably dry."
msgstr "Thứ này sẽ giữ cho tôi khô ráo và thoải mái."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIRTPILE"
msgid "Unhygienic!"
msgstr "Mất vệ sinh quá!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGROD.COLD"
msgid "The dial is moving faintly."
msgstr "Mặt số đang nhích nhẹ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGROD.GENERIC"
msgid "It is a magitechnical homing device."
msgstr "Đó là một thiết bị định vị ma thuật."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGROD.HOT"
msgid "Here we are!"
msgstr "Chúng ta đến nơi rồi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGROD.WARM"
msgid "This is definitely the right track."
msgstr "Chắc chắn là đi đúng hướng rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGROD.WARMER"
msgid "Must be getting close."
msgstr "Chắc là sắp tới nơi rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "It will need some work before it can function."
msgstr "Cần phải sửa sang lại một chút trước khi nó có thể hoạt động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGRODBASE.READY"
msgid "It simply needs a key now."
msgstr "Bây giờ nó chỉ đơn giản là cần một chiếc chìa khóa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "Ah. The beauty of functionality."
msgstr "À. Vẻ đẹp của tính thực dụng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGRODSTART"
msgid "This rod could be useful!"
msgstr "Cái gậy này có thể có ích đấy!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DOCK_KIT"
msgid "Some essential materials for constructing a wharf."
msgstr "Một số nguyên liệu thiết yếu để xây dựng một bến tàu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "Unnecessary for a floating dock, but they do have a pleasant appearance."
msgstr "Không cần thiết cho một chiếc bè nổi, nhưng trông chúng khá đẹp mắt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DOLL_BLUEPRINT"
msgid "A bit childish for my tastes."
msgstr "Hơi trẻ con so với sở thích của tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONBOAT_KIT"
msgid "It would make sense to construct this near the water."
msgstr "Sẽ hợp lý hơn nếu xây dựng cái này gần mặt nước."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONBOAT_PACK"
msgid "Everything I need has been conveniently collected into a singular package."
msgstr "Mọi thứ tôi cần đã được thu thập gọn gàng vào một gói duy nhất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONBODYHAT"
msgid "The longer the dragon, the better the luck."
msgstr "Rồng càng dài thì vận may càng lớn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONCHILISALAD"
msgid "I do like fresh greens."
msgstr "Tôi rất thích rau xanh tươi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLY"
msgid "It's some kind of mythical variant of a Diptera."
msgstr "Đó là một biến thể thần thoại nào đó của Bộ Hai Vánh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "Scales! Scales are the winner!"
msgstr "Vẩy! Vẩy là số một!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE"
msgid "A fireproof chest with an impossibly expansive interior."
msgstr "Một chiếc rương chống cháy với nội thất rộng rãi đến khó tin."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "A very efficient, magically powered furnace."
msgstr "Một cái lò rất hiệu quả, được vận hành bằng ma thuật."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "Hm, that was an interesting choice of alteration."
msgstr "Hừm, đó là một sự biến đổi khá thú vị."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "The magic of the two gems keeps it burning at maximum strength."
msgstr "Ma thuật của hai viên ngọc giữ cho nó cháy ở công suất tối đa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "It is burning at half strength, presently."
msgstr "Hiện tại nó đang cháy ở một nửa công suất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFRUIT"
msgid "Hylocereus undatus, or pitahaya blanca."
msgstr "Hylocereus undatus, hay thanh long ruột trắng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "Pleasantly prepared pitahaya blanca."
msgstr "Thanh long ruột trắng được chuẩn bị một cách ngon lành."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "The result of proper research, planning and care."
msgstr "Kết quả của việc nghiên cứu, lập kế hoạch và chăm sóc đúng đắn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "It can't begin growing until it's been planted, dear."
msgstr "Nó không thể bắt đầu mọc cho đến khi được gieo xuống đất đâu, cưng à."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONHEADHAT"
msgid "This is the head to the dragon costume."
msgstr "Đây là phần đầu của bộ trang phục rồng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONPIE"
msgid "I do love a nice fruit pie."
msgstr "Tôi rất thích bánh nướng hoa quả ngon lành."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONTAILHAT"
msgid "This is the back of the dragon costume."
msgstr "Đây là phần đuôi của bộ trang phục rồng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGON_SCALES"
msgid "Scales from an insect? Unheard of!"
msgstr "Vẩy từ một loài côn trùng ư? Chưa từng nghe thấy bao giờ!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DREADSTONE"
msgid "Metamorphic, if I'm not mistaken."
msgstr "Đá biến chất, nếu tôi không nhầm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DREADSTONEHAT"
msgid "Unfortunately, the material seems to have adverse affects on the mind."
msgstr "Đáng tiếc là chất liệu này dường như có tác động bất lợi đến tâm trí."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DREADSTONE_STACK"
msgid "Its source must lie even deeper underground."
msgstr "Nguồn gốc của nó chắc còn nằm sâu hơn nữa trong lòng đất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRIFTWOOD_LOG"
msgid "A naturally buoyant material."
msgstr "Một vật liệu nổi tự nhiên."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "The tree is burning."
msgstr "Cái cây đang bốc cháy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "Carbonized, through and through."
msgstr "Đã bị carbon hóa hoàn toàn từ trong ra ngoài."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "Little of use remains."
msgstr "Chẳng còn lại mấy thứ hữu ích."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "A new material may be of some use to us."
msgstr "Một vật liệu mới có thể có ích cho chúng ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRUMSTICK"
msgid "A leg of poultry."
msgstr "Một chiếc đùi gia cầm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRUMSTICK_COOKED"
msgid "Not terribly healthy, but my is it delicious!"
msgstr "Không bổ béo gì cho lắm, nhưng mà ngon tuyệt!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_BANANABUSH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_BANANABUSH"
msgid "The fruit is remarkably similar to our own subterranean strain."
msgstr "Quả của nó rất giống với giống cây dưới lòng đất của chúng ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_BERRYBUSH"
msgid "It requires soil to grow."
msgstr "Nó cần đất để phát triển."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "It requires soil to grow."
msgstr "Nó cần đất để phát triển."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_GRASS"
msgid "It requires soil to grow."
msgstr "Nó cần đất để phát triển."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_MARSH_BUSH"
msgid "It requires soil to grow."
msgstr "Nó cần đất để phát triển."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_MONKEYTAIL"
msgid "A variation of the common Typha latifolia, perhaps?"
msgstr "Có lẽ là một biến thể của loài Typha latifolia thông thường?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_SAPLING"
msgid "It requires soil to grow."
msgstr "Nó cần đất để phát triển."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_TRAP_STARFISH"
msgid "It is no longer a danger."
msgstr "Nó không còn là mối nguy hiểm nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUMBBELL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUMBBELL"
msgid "A bit of exercise can be quite beneficial to one's health."
msgstr "Tập thể dục một chút có thể rất có lợi cho lượng máu của một người."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "My, it's ice-cold to the touch!"
msgstr "Chà, sờ vào lạnh giá như băng đá vậy!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUMBBELL_GEM"
msgid "A bit of exercise can be quite beneficial to one's health."
msgstr "Tập thể dục một chút có thể rất có lợi cho lượng máu của một người."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUMBBELL_GOLDEN"
msgid "A bit of exercise can be quite beneficial to one's health."
msgstr "Tập thể dục một chút có thể rất có lợi cho lượng máu của một người."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUMBBELL_HEAT"
msgid "An interesting combination of exercise and temperature regulation."
msgstr "Một sự kết hợp thú vị giữa tập thể dục và điều hòa nhiệt độ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUMBBELL_MARBLE"
msgid "A bit of exercise can be quite beneficial to one's health."
msgstr "Tập thể dục một chút có thể rất có lợi cho lượng máu của một người."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUMBBELL_REDGEM"
msgid "Careful dear, that looks suspiciously combustible."
msgstr "Cẩn thận đấy cưng, thứ đó trông có vẻ dễ bắt lửa một cách đáng ngờ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DURIAN"
msgid "Aha, the Durio zibethinus. It really does reek."
msgstr "Aha, Durio zibethinus. Nó thực sự rất bốc mùi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DURIAN_COOKED"
msgid "Cooking this certainly did not improve its odor."
msgstr "Nấu chín thứ này chắc chắn không làm mùi của nó khá hơn chút nào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DURIAN_OVERSIZED"
msgid "Oh, our diminutive green friend will be thrilled!"
msgstr "Ồ, người bạn màu xanh lùn tịt của chúng ta sẽ phấn khích lắm đây!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DURIAN_SEEDS"
msgid "It can't begin growing until it's been planted, dear."
msgstr "Nó không thể bắt đầu mọc cho đến khi được gieo xuống đất đâu, cưng à."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUSTMERINGUE"
msgid "Perhaps there's a creature around here that could metabolize this."
msgstr "Có lẽ có một sinh vật nào đó quanh đây có thể trao đổi chất thứ này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUSTMOTH"
msgid "I would have been quite pleased to have one helping me in the library."
msgstr "Tôi rất vui lòng nếu có một con giúp tôi trong thư viện."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUSTMOTHDEN"
msgid "It seems a chemical reaction within the bodies of these creatures creates Thulecite."
msgstr "Dường như phản ứng hóa học bên trong cơ thể những sinh vật này tạo ra Thulecite."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EARMUFFSHAT"
msgid "Poor Leporidae. At least it's warm."
msgstr "Họ Leporidae tội nghiệp. Ít ra thì nó cũng ấm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EEL"
msgid "It's an eel."
msgstr "Đó là một con lươn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EEL_COOKED"
msgid "This eel has been cooked."
msgstr "Con lươn này đã được nấu chín."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EGGPLANT"
msgid "A nightshade. Solanum melongena, specifically."
msgstr "Một loài thuộc họ Cà. Cụ thể là Solanum melongena."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EGGPLANT_COOKED"
msgid "For your enjoyment: Braised Solanum melongena."
msgstr "Dành cho sự thưởng thức của bạn: Solanum melongena om."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "A particularly resplendent Solanum melongena."
msgstr "Một quả Solanum melongena đặc biệt lộng lẫy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EGGPLANT_SEEDS"
msgid "It can't begin growing until it's been planted, dear."
msgstr "Nó không thể bắt đầu mọc cho đến khi được gieo xuống đất đâu, cưng à."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ELIXIR_CONTAINER"
msgid "What a pretty elixir organizer!"
msgstr "Đúng là một chiếc hộp đựng dược phẩm xinh xắn!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EMBERLIGHT"
msgid "Nothing like some unnatural fire to warm yourself with on a chilly day."
msgstr "Không có gì bằng một ngọn lửa nhân tạo để sưởi ấm bản thân vào một ngày lạnh giá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.BURNT"
msgid "Well, such as it is."
msgstr "Chà, nó là thế đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.EMPTY"
msgid "Ah, could use a doily, wouldn't you say?"
msgstr "À, dùng thêm một chiếc khăn lót thì tuyệt đấy nhỉ?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "The more light to read by the better, in my opinion."
msgstr "Theo ý kiến của tôi, càng nhiều ánh sáng để đọc sách thì càng tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.GENERIC"
msgid "It's pleasant to see a little decor out here."
msgstr "Thật dễ chịu khi thấy chút đồ trang trí ngoài này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "It is Maxwell's turn to procure bulbs. I've it written down right here."
msgstr "Đến lượt Maxwell đi kiếm bóng đèn rồi. Tôi đã ghi lại ở đây này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.WILTED"
msgid "A pity. Shall we find replacements?"
msgstr "Tiếc thật. Chúng ta tìm đồ thay thế nhé?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN.BURNING"
msgid "The tree is burning."
msgstr "Cái cây đang bốc cháy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN.BURNT"
msgid "A carbonized tree."
msgstr "Một cái cây đã bị carbon hóa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN.CHOPPED"
msgid "It has been harvested."
msgstr "Nó đã được thu hoạch rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN.GENERIC"
msgid "A generically coniferous tree."
msgstr "Một cái cây mang đặc tính hạt trần nói chung."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "The tree is burning."
msgstr "Cái cây đang bốc cháy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "A carbonized tree."
msgstr "Một cái cây đã bị carbon hóa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "It has been harvested."
msgstr "Nó đã được thu hoạch rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "This genus seems to lack reproductive capabilities."
msgstr "Chi này dường như thiếu khả năng sinh sản."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYEBRELLAHAT"
msgid "The cornea must be quite water-repellent."
msgstr "Giác mạc chắc là có khả năng chống nước rất tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYEMASKHAT"
msgid "I doubt that they make my prescription in this size."
msgstr "Tôi nghi ngờ liệu họ có cắt kính theo đơn của tôi với kích thước này không."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYEOFTERROR"
msgid "Oculus dexter or oculus sinister, I wonder? I have a suspicion it's the latter."
msgstr "Mắt phải hay mắt trái đây nhỉ? Tôi có linh cảm là cái sau đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYEOFTERROR_MINI"
msgid "I'm fascinated, but now is not the time to study you."
msgstr "Tôi rất tò mò, nhưng giờ không phải lúc để nghiên cứu bạn đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "An eyeball... embryo? These creatures are quite perplexing."
msgstr "Một con mắt... phôi thai? Những sinh vật này thật khó hiểu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYEPLANT"
msgid "I believe they are controlled by the larger plant."
msgstr "Tôi tin rằng chúng được điều khiển bởi thực vật lớn hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYETURRET"
msgid "The magic of the two beasts has been concentrated by the Thulecite."
msgstr "Ma thuật của hai con quái thú đã được tập trung lại bởi Thulecite."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYETURRET_ITEM"
msgid "I'll need to place this."
msgstr "Tôi sẽ cần đặt cái này xuống."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARMPLOT.BURNT"
msgid "It shan't grow a crop again."
msgstr "Nó sẽ không thể mọc cây trồng được nữa đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARMPLOT.GENERIC"
msgid "A small cultivated patch of ground."
msgstr "Một mảnh đất nhỏ đã được canh tác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARMPLOT.GROWING"
msgid "The plants are extracting minerals from the ground."
msgstr "Cây cối đang hút khoáng chất từ lòng đất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "It has been rendered infertile for lack of nutrients."
msgstr "Nó đã trở nên cằn cỗi vì thiếu chất dinh dưỡng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_HOE"
msgid "Humans have cultivated crops since Neolithic times."
msgstr "Con người đã canh tác cây trồng từ thời kỳ đồ đá mới."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_PLANT.BURNING"
msgid "What an unfortunate turn of events!"
msgstr "Thật là một bước ngoặt không may!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_PLANT.FULL"
msgid "I daresay that's ready to harvest."
msgstr "Tôi dám cá là nó đã sẵn sàng để thu hoạch rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "How splendid!"
msgstr "Thật tuyệt vời làm sao!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "Weeds have no place in the garden."
msgstr "Cỏ dại không có chỗ đứng trong khu vườn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_PLANT.GENERIC"
msgid "Of the kingdom Plantae."
msgstr "Thuộc giới thực vật Plantae."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_PLANT.GROWING"
msgid "It's coming along."
msgstr "Nó đang phát triển dần lên."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "I detest the sight of spoiled food!"
msgstr "Tôi rất ghét cảnh tượng thức ăn bị hỏng!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "How terrible to see it all go to waste!"
msgstr "Thật tồi tệ khi thấy tất cả đều đổ sông đổ biển!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_PLANT.SEED"
msgid "It takes patience to grow crops from seed."
msgstr "Cần phải kiên nhẫn để trồng cây lương thực từ hạt giống."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_PLOW"
msgid "How very efficient!"
msgstr "Thật là hiệu quả làm sao!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_PLOW_ITEM"
msgid "I'd best find a suitable spot for my garden."
msgstr "Tốt nhất là tôi nên tìm một chỗ thích hợp cho khu vườn của mình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "Oh no you don't! Out of my garden!"
msgstr "Ồ không, anh đừng có hòng! Cút khỏi vườn của tôi mau!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHERFAN"
msgid "This will induce quite an airflow!"
msgstr "Thứ này sẽ tạo ra một luồng gió khá mạnh đấy!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHERHAT"
msgid "Not quite the genuine article, but it might fool some birds."
msgstr "Không hẳn là hàng thật, nhưng có thể đánh lừa được vài con chim."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHERPENCIL"
msgid "Oh, how I missed proper writing implements!"
msgstr "Ồ, tôi nhớ dụng cụ viết lách đàng hoàng làm sao!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHER_CANARY"
msgid "Feather of Canaria."
msgstr "Lông của loài Canaria."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHER_CROW"
msgid "Feather of Corvus. Or Alcidae?"
msgstr "Lông của loài Corvus. Hay là Alcidae nhỉ?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHER_ROBIN"
msgid "Feather of Cardinalis."
msgstr "Lông của loài Cardinalis."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "It looks like a feather of Cardinalis, but white."
msgstr "Trông giống lông của loài Cardinalis, nhưng có màu trắng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEM_PUPPET"
msgid "Poor girl."
msgstr "Cô bé tội nghiệp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE"
msgid "A simply constructed fence."
msgstr "Một chiếc hàng rào được làm đơn giản."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE_ELECTRIC.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE_ELECTRIC.GENERIC"
msgid "The post is not conducting a current at the moment."
msgstr "Cột hiện không dẫn dòng điện vào lúc này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE_ELECTRIC.LINKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE_ELECTRIC.LINKED"
msgid "The post is conducting a current just strong enough to deter uninsulated creatures."
msgstr "Cột đang dẫn một dòng điện vừa đủ mạnh để ngăn chặn các sinh vật chưa được cách điện."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE_ELECTRIC_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE_ELECTRIC_ITEM"
msgid "This is an electric fence post and it must be planted before it can be used."
msgstr "Đây là một cột hàng rào điện và nó phải được cắm xuống đất trước khi có thể sử dụng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE_GATE"
msgid "That is a wooden gate."
msgstr "Đó là một chiếc cổng gỗ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE_GATE_ITEM"
msgid "All the components for a wooden gate."
msgstr "Tất cả các thành phần cho một chiếc cổng gỗ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE_ITEM"
msgid "All the components for a wooden fence."
msgstr "Tất cả các thành phần cho một chiếc hàng rào gỗ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE_JUNK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE_JUNK"
msgid "Unpleasant to the eye, but I suppose practicality outweighs aesthetics."
msgstr "Không đẹp mắt cho lắm, nhưng tôi cho rằng tính thực tế quan trọng hơn tính thẩm mỹ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE_ROTATOR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE_ROTATOR"
msgid "Sometimes sharpness is necessary to keep things aligned and orderly."
msgstr "Đôi khi sự sắc bén là cần thiết để giữ cho mọi thứ thẳng hàng và ngăn nắp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FERTILIZER"
msgid "A bucket of animal feces. Pungent."
msgstr "Một xô phân động vật. Nồng nặc mùi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FESTIVEFISH"
msgid "I'm unfamiliar with the origins of this dish."
msgstr "Tôi không quen thuộc với nguồn gốc của món ăn này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FESTIVE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FESTIVE_BLUEPRINT"
msgid "It features quite an eclectic combination of colors."
msgstr "Nó có một sự kết hợp màu sắc khá chiết trung."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIG"
msgid "I do enjoy a nice ripe fig."
msgstr "Tôi rất thích một quả vả chín ngon lành."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIGATONI
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIGATONI"
msgid "An unexpected, but not unpleasant combination."
msgstr "Một sự kết hợp bất ngờ nhưng không hề khó chịu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIGKABAB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIGKABAB"
msgid "I suppose this is the next logical step after meat on a stick."
msgstr "Tôi cho rằng đây là bước tiến hợp lý tiếp theo sau món thịt xiên que."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIG_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIG_COOKED"
msgid "Cooking it brings out more of the flavor."
msgstr "Nấu lên sẽ làm nổi bật thêm hương vị."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREBALLSTAFF"
msgid "Someone experienced with magic ought to wield this. Like myself!"
msgstr "Ai có kinh nghiệm về phép thuật nên sử dụng cái này. Giống như tôi vậy!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRECRACKERS"
msgid "A little too noisy for my liking."
msgstr "Hơi ồn ào quá so với sở thích của tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREFLIES.GENERIC"
msgid "They disperse when I approach."
msgstr "Chúng tản ra khi tôi đến gần."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREFLIES.HELD"
msgid "Their bioluminescent properties might prove useful."
msgstr "Đặc tính phát quang sinh học của chúng có thể có ích."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREHOUND"
msgid "That hound is more dangerous than the others."
msgstr "Con chó săn đó nguy hiểm hơn những con khác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRENETTLES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRENETTLES"
msgid "Dastardly things."
msgstr "Mấy thứ thật khốn kiếp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRENETTLES_DRIED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRENETTLES_DRIED"
msgid "The drying process enhances the aroma."
msgstr "Quá trình phơi khô làm tăng thêm hương thơm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPEN"
msgid "A firestorm can be unleashed with but a few strokes of a writer's pen."
msgstr "Một trận bão lửa có thể được giải phóng chỉ với vài nét bút của người cầm bút."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.EMBERS"
msgid "The fire has almost self-extinguished."
msgstr "Lửa sắp tắt hẳn rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.GENERIC"
msgid "A fire pit."
msgstr "Một cái lò lửa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.HIGH"
msgid "That fire is burning at an alarming rate."
msgstr "Ngọn lửa đó đang cháy với tốc độ đáng báo động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.LOW"
msgid "The fire could use some more fuel."
msgstr "Lửa có vẻ cần thêm chút nhiên liệu rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.NORMAL"
msgid "A perfectly average fire."
msgstr "Một đống lửa bình thường hoàn hảo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.OUT"
msgid "It can be re-lit."
msgstr "Có thể thắp lại được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRESTAFF"
msgid "Some kind of fire-throwing contraption."
msgstr "Một loại thiết bị phun lửa nào đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "Fuel's getting low."
msgstr "Nhiên liệu sắp cạn rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "Nothing to see here."
msgstr "Không có gì để xem ở đây cả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "Pitch that ice!"
msgstr "Ném băng vào đi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISH"
msgid "Some kind of whitefish, I believe."
msgstr "Chắc là một loại cá trắng nào đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHINGNET"
msgid "The sea is a treasure trove of survival resources."
msgstr "Biển cả là kho báu chứa các tài nguyên sinh tồn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHINGROD"
msgid "I've read all about fishing. It should be a snap."
msgstr "Tôi đã đọc hết mọi thứ về câu cá. Chắc chắn là dễ như trở bàn tay thôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHMEAT"
msgid "An odorous slab of fish meat."
msgstr "Một miếng thịt câu cá có mùi nồng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHMEAT_COOKED"
msgid "Beautifully grilled."
msgstr "Nướng đẹp thật."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHMEAT_DRIED"
msgid "Salty, yet satisfying."
msgstr "Mặn mà nhưng đầy thỏa mãn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHMEAT_SMALL"
msgid "Fish flesh."
msgstr "Thịt câu cá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "A small bit of nourishment."
msgstr "Một chút dưỡng chất nhỏ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHMEAT_SMALL_DRIED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHMEAT_SMALL_DRIED"
msgid "Salty, yet satisfying."
msgstr "Mặn mà, nhưng cũng đủ thỏa mãn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHSTICKS"
msgid "Give me some tartar sauce and I'm in heaven."
msgstr "Thêm chút sốt tartar nữa là tôi lên tiên."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHTACOS"
msgid "Personally I relish a spot of spice on my fish."
msgstr "Cá nhân tôi thích một chút cay trên món cá của mình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISH_BOX"
msgid "A clever contraption to keep seafood fresh."
msgstr "Một cơ chế thông minh để giữ hải sản tươi ngon."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISH_COOKED"
msgid "Beautifully grilled."
msgstr "Nướng đẹp thật đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLINT"
msgid "A hard nodule of quartz."
msgstr "Một khối thạch anh cứng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOATINGLANTERN.DEFLATED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOATINGLANTERN.DEFLATED"
msgid "Now that the thermal lift is gone, it descended accordingly."
msgstr "Giờ luồng khí nóng đã mất, nó đã hạ xuống theo tương ứng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOATINGLANTERN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOATINGLANTERN.GENERIC"
msgid "Nothing magical here. It's flotation is merely due to hot air being less dense than the surrounding atmosphere."
msgstr "Chẳng có ma thuật nào cả. Nó nổi được là do không khí nóng nhẹ hơn không khí xung quanh thôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOATINGLANTERN.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOATINGLANTERN.HELD"
msgid "Deployment consists simply of allowing it to ascend upon release."
msgstr "Việc thả chỉ đơn giản là để nó bay lên khi buông tay."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOTATIONCUSHION
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOTATIONCUSHION"
msgid "A passive deployment flotation device. I approve."
msgstr "Thiết bị phao cứu sinh triển khai thụ động. Ta duyệt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWER.GENERIC"
msgid "It's a wildflower. I'm unfamiliar with the species."
msgstr "Đó là một bông hoa dại. Tôi không quen thuộc với loài này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWER.ROSE"
msgid "Ah, a Rosa Macdub... what's it doing out here?"
msgstr "À, một đóa Rosa Macdub... nó làm gì ở ngoài này nhỉ?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWERHAT"
msgid "How celebratory."
msgstr "Thật là mang tính ăn mừng làm sao."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWERSALAD"
msgid "Plenty of nutrients!"
msgstr "Dồi dào chất dinh dưỡng!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWER_CAVE"
msgid "You could read by that light."
msgstr "Bạn có thể đọc sách dưới ánh sáng đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWER_CAVE_WITHERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWER_CAVE_WITHERED"
msgid "It will not survive in these conditions."
msgstr "Nó sẽ không thể sống sót trong những điều kiện này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWER_EVIL"
msgid "It's not often one sees a flower with such a powerful aura."
msgstr "Hiếm khi nào người ta thấy một bông hoa có hào quang mạnh mẽ đến vậy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWER_WITHERED"
msgid "This flower lacks the essentials for growth."
msgstr "Bông hoa này thiếu các yếu tố thiết yếu để phát triển."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOLIAGE"
msgid "These may have some nutritional value."
msgstr "Chúng có thể có một chút giá trị dinh dưỡng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOLIAGE_DRIED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOLIAGE_DRIED"
msgid "The drying process enhances the aroma."
msgstr "Quá trình phơi khô làm tăng thêm hương thơm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOOTBALLHAT"
msgid "Protective gear for full-contact endeavors."
msgstr "Đồ bảo hộ cho các hoạt động va chạm mạnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FORGETMELOTS"
msgid "This strain can be used to brew a rather pleasant herbal tea."
msgstr "Loại này có thể dùng để pha một mẻ trà thảo mộc khá dễ chịu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FORGETMELOTS_DRIED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FORGETMELOTS_DRIED"
msgid "The drying process enhances the aroma."
msgstr "Quá trình phơi khô làm tăng thêm hương thơm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FORMAL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FORMAL_BLUEPRINT"
msgid "It seems rather senseless to attempt to make a beefalo appear dignified."
msgstr "Dường như khá vô lý khi cố gắng làm cho một con bò lai trông có vẻ uy nghi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOSSIL_PIECE"
msgid "Hardened remains preserved by taphonomic processes."
msgstr "Di tích hóa cứng được bảo tồn bởi các quá trình trầm tích."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "Oh! A specimen fit for a museum!"
msgstr "Ồ! Một mẫu vật xứng đáng có mặt trong viện bảo tàng!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "Paleontological incompetence has produced a sad excuse for a creature."
msgstr "Sự thiếu hiểu biết về cổ sinh vật học đã tạo ra một cái cớ thảm hại cho một sinh vật."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "There are pieces of the skeleton still yet to be assembled."
msgstr "Vẫn còn những mảnh của bộ xương chưa được lắp ráp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FRESHFRUITCREPES"
msgid "Sticky fingers will ensue."
msgstr "Những ngón tay dính dớp sẽ theo sau đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FRIENDLYFRUITFLY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FRIENDLYFRUITFLY"
msgid "This one appears to be of a different, more agreeable subspecies."
msgstr "Con này có vẻ thuộc một phân loài khác, dễ chịu hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROG.DEAD"
msgid "Considered a delicacy in some countries."
msgstr "Được coi là một món ăn ngon ở một số quốc gia."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROG.GENERIC"
msgid "A amphibian tetrapod."
msgstr "Một động vật bốn chân lưỡng cư."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROG.SLEEPING"
msgid "It's sleeping."
msgstr "Nó đang ngủ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROGFISHBOWL"
msgid "I'll happily volunteer to taste-test."
msgstr "Tôi rất sẵn lòng xung phong nếm thử."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROGGLEBUNWICH"
msgid "It was an interesting choice to serve it as a sandwich."
msgstr "Đó là một lựa chọn thú vị khi phục vụ nó dưới dạng bánh mì kẹp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROGLEGS"
msgid "They're still twitching a bit."
msgstr "Chúng vẫn còn giật giật một chút."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROGLEGS_COOKED"
msgid "Not unlike a chicken wing."
msgstr "Không khác gì cánh gà."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROGNEWTON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROGNEWTON"
msgid "It has quite a unique flavor."
msgstr "Nó có hương vị khá độc đáo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROZENBANANADAIQUIRI
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROZENBANANADAIQUIRI"
msgid "This would pair nicely with a short book."
msgstr "Món này sẽ rất hợp khi đọc một cuốn sách ngắn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "Plant and animal have merged into one in this specimen."
msgstr "Thực vật và động vật đã hợp nhất thành một trong mẫu vật này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FRUITDRAGON.RIPE"
msgid "It does smell quite delicious."
msgstr "Nó có mùi khá ngon."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "It's in a deep sleep."
msgstr "Nó đang chìm trong giấc ngủ sâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FRUITFLY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FRUITFLY"
msgid "Those pests are making quite the nuisance of themselves."
msgstr "Những kẻ phiền phức đó đang gây ra không ít rắc rối cho chính chúng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FRUITFLYFRUIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FRUITFLYFRUIT"
msgid "It seems that I can exert some level of control over these insects with this."
msgstr "Có vẻ như tôi có thể kiểm soát phần nào những con côn trùng này bằng thứ này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FRUITMEDLEY"
msgid "What a nice selection of fruit!"
msgstr "Thật là một sự lựa chọn trái cây tuyệt vời!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FUMAROLEAXE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FUMAROLEAXE.GENERIC"
msgid "It may require repairs soon."
msgstr "Nó có thể sớm cần được sửa chữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FUMAROLEAXE.HOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FUMAROLEAXE.HOT"
msgid "It helps perform tasks quickly, if one can withstand the heat."
msgstr "Nó giúp thực hiện các công việc nhanh chóng, nếu người ta có thể chịu được sức nóng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FUMAROLEAXE.LUKEWARM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FUMAROLEAXE.LUKEWARM"
msgid "Its temperature has diminished significantly."
msgstr "Nhiệt độ của nó đã giảm đi đáng kể."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FUMAROLEAXE.WARM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FUMAROLEAXE.WARM"
msgid "It keeps its user comfortably warm while working."
msgstr "Nó giữ cho người dùng ấm áp thoải mái khi làm việc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FUMAROLEHAMMER.GENERIC
