msgstr "Đây là những thứ dùng để chế tạo đồng hồ phải không nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POCKETWATCH_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POCKETWATCH_PORTAL.GENERIC"
