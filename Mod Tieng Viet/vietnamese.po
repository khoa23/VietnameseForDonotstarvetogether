msgstr "Tôi không nghĩ điều đó dành cho tôi."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.FERTILIZER"
msgid "I think I know everything I need to, non?"
msgstr "Tôi nghĩ tôi biết mọi thứ tôi cần, phải không?"

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.GENERIC"
