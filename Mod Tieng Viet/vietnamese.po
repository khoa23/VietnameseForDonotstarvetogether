msgstr "Con nhỏ này có vẻ khá lạnh lùng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROBIN_WINTER.HELD"
msgid "Let me lend you my warmth, feathered friend."
msgstr "Hãy để tôi cho bạn mượn hơi ấm của tôi, người bạn lông lá."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROBOT_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROBOT_BLUEPRINT"
