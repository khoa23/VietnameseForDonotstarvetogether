#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_EYEOFTERROR_FLYBACK
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_EYEOFTERROR_FLYBACK"
msgid "Did you come back just to get BURNED?"
msgstr "Bạn quay lại chỉ để bị CHÁY?"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_FAN_OUT"
msgid "Stupid thing broke!"
msgstr "Điều ngu ngốc đã phá vỡ!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_FERTILIZER_RESEARCHED
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_FERTILIZER_RESEARCHED"
msgid "Wow, so interesting. Glad I spent my time learning that and not doing literally anything else."
msgstr "Ôi, thú vị quá. Rất vui vì tôi đã dành thời gian để học điều đó và không làm bất cứ điều gì khác theo đúng nghĩa đen."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_FIRENETTLE_TOXIN.1
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_FIRENETTLE_TOXIN.1"
