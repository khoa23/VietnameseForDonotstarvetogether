msgstr "Wendy thách chúng tôi uống nó..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SOIL_AMENDER.SPOILED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SOIL_AMENDER.SPOILED"
msgid "It's gotten really rotten looking... yay!"
msgstr "Nó trông thật sự thối nát... yay!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SOIL_AMENDER.STALE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SOIL_AMENDER.STALE"
msgid "Is it going bad? Is that good?"
msgstr "Mọi chuyện có tệ không? Điều đó có tốt không?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SOIL_AMENDER_FERMENTED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SOIL_AMENDER_FERMENTED"
msgid "It smells done to us!"
msgstr "Nó có mùi như đã làm với chúng tôi!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPAT"
msgid "Maybe it just needs a cuddle!"
msgstr "Có lẽ nó chỉ cần một âu yếm!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPEAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPEAR"
msgid "We should stick things with the pointy part."
msgstr "Chúng ta nên dính vào những thứ với phần nhọn."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPEAR_GUNGNIR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPEAR_GUNGNIR"
msgid "Wigfrid makes it look so cool!"
msgstr "Wigfrid làm cho nó trông thật tuyệt!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPEAR_LANCE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPEAR_LANCE"
msgid "I don't really want it."
msgstr "Tôi thực sự không muốn nó."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPEAR_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPEAR_WATHGRITHR"
msgid "Pointy ouchies!"
msgstr "ouchies nhọn!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPEAR_WATHGRITHR_LIGHTNING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPEAR_WATHGRITHR_LIGHTNING"
msgid "It gets our fur all full of static!"
msgstr "Nó làm cho lông của chúng ta đầy tĩnh điện!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPICEPACK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPICEPACK"
msgid "I'm sure Mr. Warly won't mind if we use this!"
msgstr "Tôi chắc chắn ông Warly sẽ không phiền nếu chúng ta sử dụng cái này!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPICE_CHILI
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPICE_CHILI"
msgid "Ho! Ha! That's spicy!"
msgstr "ồ! Hà! Thật cay!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPICE_GARLIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPICE_GARLIC"
msgid "Our breath will smell stinky. Yay!"
msgstr "Hơi thở của chúng ta sẽ có mùi hôi. Đúng!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPICE_SALT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPICE_SALT"
msgid "Mmm, salty!"
msgstr "Ừm, mặn quá!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPICE_SUGAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPICE_SUGAR"
msgid "It turns everything into dessert!"
msgstr "Nó biến mọi thứ thành món tráng miệng!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER.DEAD"
