msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK"
msgid "They're out playing, let's go find em'!"
msgstr "Họ đang ra ngoài chơi, chúng ta hãy đi tìm họ'!"

