msgstr "Đá tảng từ mặt trăng có lỗ. Giống phô mai thế!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONROCKIDOL"
msgid "Hehe. Is funny little moon man."
msgstr "Hehe. Người trăng nhỏ buồn cười ghê."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONROCKNUGGET"
msgid "But is not cheese?"
msgstr "Nhưng mà không phải phô mai à?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONROCKSEED"
