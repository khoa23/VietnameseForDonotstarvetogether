msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.3.line"
msgid "nobody who's seen it up close ever made it back."
msgstr "không ai nhìn thấy nó ở cự ly gần mà quay về được cả."

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.4.duration
