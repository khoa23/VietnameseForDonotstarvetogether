msgstr "Nóng bỏng cả chân!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRAP_STARFISH.CLOSED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRAP_STARFISH.CLOSED"
