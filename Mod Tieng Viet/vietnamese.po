msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WINONA_TELEBRELLA.CHARGED"
msgid "How wonderfully efficient!"
msgstr "Hiệu quả tuyệt vời làm sao!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.WINONA_TELEBRELLA.CHARGING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WINONA_TELEBRELLA.CHARGING"
msgid "How wonderfully efficient!"
msgstr "Hiệu quả tuyệt vời làm sao!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.WINONA_TELEBRELLA.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WINONA_TELEBRELLA.GENERIC"
