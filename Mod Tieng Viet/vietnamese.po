msgstr "Chẳng có gì ở đó cả."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GESTALT_GUARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GESTALT_GUARD"
msgid "Don't think I like the looks of that."
msgstr "Đừng nghĩ là tôi thích vẻ ngoài đó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GESTALT_GUARD_EVOLVED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GESTALT_GUARD_EVOLVED"
