#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CASTAOE.NO_TARGETS
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CASTAOE.NO_TARGETS"
msgid "only_used_by_willow"
msgstr "chỉ_được_sử_dụng_bởi_willow"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CASTAOE.SPELL_ON_COOLDOWN
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CASTAOE.SPELL_ON_COOLDOWN"
msgid "only_used_by_willow"
msgstr "chỉ_được_sử_dụng_bởi_willow"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CASTSPELL.TERRAFORM_TOO_SOON
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CASTSPELL.TERRAFORM_TOO_SOON"
msgid "only_used_by_wurt"
msgstr "chỉ_được_sử_dụng_bởi_wurt"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CHANGEIN.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CHANGEIN.BURNING"
msgid "Woah! Hot fashions!"
msgstr "Woah! Thời trang cháy bỏng ghê!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CHANGEIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CHANGEIN.GENERIC"
msgid "Not right now, we're comfy."
msgstr "Chưa đâu, tụi mình đang thoải mái thế này cơ mà."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CHANGEIN.INUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CHANGEIN.INUSE"
msgid "We'll give them some privacy while they change."
msgstr "Hãy để cho họ chút không gian riêng tư để thay đồ nào."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CHANGEIN.NOOCCUPANT
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CHANGEIN.NOOCCUPANT"
msgid "Once we've got a beefalo hitched up, we can make them fancy!"
msgstr "Một khi đã buộc bò lai vào rồi, tụi mình có thể làm cho chúng trông thật bảnh!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CHANGEIN.NOTENOUGHHAIR
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CHANGEIN.NOTENOUGHHAIR"
msgid "Maybe once the fur grows back."
msgstr "Chắc đợi đến lúc lông mọc lại đã."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL"
msgid "Yay! Fully charged!"
msgstr "Yeah! Đã sạc đầy pin!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE"
msgid "Aw there's not enough charge!"
msgstr "Ối, không đủ năng lượng rồi!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.COMPARE_WEIGHABLE.FISH_TOO_SMALL
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.COMPARE_WEIGHABLE.FISH_TOO_SMALL"
msgid "This little guy's too small!"
msgstr "Chú cá nhỏ này bé quá!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.COMPARE_WEIGHABLE.OVERSIZEDVEGGIES_TOO_SMALL
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.COMPARE_WEIGHABLE.OVERSIZEDVEGGIES_TOO_SMALL"
msgid "We'll have to get a bigger veggie, or maybe a fruit!"
msgstr "Tụi mình phải kiếm củ quả to hơn, hoặc hoa quả cũng được!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CONSTRUCT.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CONSTRUCT.EMPTY"
msgid "We need stuff to build with."
msgstr "Tụi mình cần nguyên liệu để xây."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CONSTRUCT.INUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CONSTRUCT.INUSE"
msgid "Aw, we don't wanna mess up someone else's stuff."
msgstr "Ôi, tụi mình không muốn làm hỏng đồ của người khác đâu."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CONSTRUCT.MISMATCH
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CONSTRUCT.MISMATCH"
msgid "We don't think these are the right plans."
msgstr "Tụi mình nghĩ đây không phải bản thiết kế đúng đâu."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CONSTRUCT.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CONSTRUCT.NOTALLOWED"
msgid "It doesn't go there."
msgstr "Nó không nằm ở đó."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CONSTRUCT.NOTREADY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CONSTRUCT.NOTREADY"
msgid "Everything's too scary right now!"
msgstr "Mọi thứ lúc này đáng sợ quá!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.COOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.COOK.GENERIC"
msgid "I don't want to. Mom always said the kitchen was dangerous!"
msgstr "Tụi mình không muốn đâu. Mẹ luôn bảo nhà bếp rất nguy hiểm mà!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.COOK.INUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.COOK.INUSE"
msgid "Ooo, make something tasty!"
msgstr "Ooo, nấu món gì ngon đi!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.COOK.TOOFAR
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.COOK.TOOFAR"
msgid "Let's scurry closer!"
msgstr "Lại gần hơn chút nào!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DECORATESNOWMAN.HASHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DECORATESNOWMAN.HASHAT"
msgid "We can't cover the hat."
msgstr "Tụi mình không che mất cái mũ được đâu."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DECORATESNOWMAN.INUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DECORATESNOWMAN.INUSE"
msgid "We have to wait our turn."
msgstr "Tụi mình phải xếp hàng chờ đến lượt chứ."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DECORATESNOWMAN.MELTING
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DECORATESNOWMAN.MELTING"
msgid "Aww. It's going to melt!"
msgstr "Ôi không. Nó sắp tan chảy rồi!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DECORATESNOWMAN.STACKEDTOOHIGH
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DECORATESNOWMAN.STACKEDTOOHIGH"
msgid "It's so tall already!"
msgstr "Nó cao quá rồi kìa!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DEPLOY.HERMITCRAB_RELOCATE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DEPLOY.HERMITCRAB_RELOCATE"
msgid "Oh no, it's dry! We'll try again later."
msgstr "Ôi không, nó khô quá! Tụi mình sẽ thử lại sau."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DISMANTLE.COOKING
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DISMANTLE.COOKING"
msgid "We can't, it's still cooking!"
msgstr "Không được đâu, nó vẫn đang nấu mà!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DISMANTLE.INUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DISMANTLE.INUSE"
msgid "Oops. Someone else is using that."
msgstr "Ối. Có người khác đang dùng cái đó kìa."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DISMANTLE.NOTEMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DISMANTLE.NOTEMPTY"
msgid "There's still stuff inside!"
msgstr "Vẫn còn đồ bên trong kìa!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DIVEGRAB.MISSED
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DIVEGRAB.MISSED"
msgid "Aww, we missed!"
msgstr "Ôi, hụt mất tiêu!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DRAW.NOIMAGE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DRAW.NOIMAGE"
msgid "But what should we draw?!"
msgstr "Nhưng mà tụi mình nên vẽ gì cơ chứ?!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.FILL_OCEAN.UNSUITABLE_FOR_PLANTS
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.FILL_OCEAN.UNSUITABLE_FOR_PLANTS"
msgid "Ms. Wickerbottom says that salt water is bad for plants."
msgstr "Cô Wickerbottom bảo nước muối không tốt cho thực vật."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.FISH_OCEAN.TOODEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.FISH_OCEAN.TOODEEP"
msgid "We can't reach the fish with this rod!"
msgstr "Tụi mình không với tới chỗ cá bằng cần câu này được!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GENERIC.ITEMMIMIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GENERIC.ITEMMIMIC"
msgid "Aw, I guessed wrong!"
msgstr "Ối, tớ đoán sai mất tiêu!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.ABIGAILHEART
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.ABIGAILHEART"
msgid "Wendy would've been so happy if it worked."
msgstr "Wendy hẳn đã rất vui nếu cách đó thành công."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.BUSY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.BUSY"
msgid "We can try again when it's finished."
msgstr "Tụi mình có thể thử lại khi nó xong xuôi."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.CANTSHADOWREVIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.CANTSHADOWREVIVE"
msgid "It's not waking up."
msgstr "Nó không chịu tỉnh lại."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.CARNIVALGAME_ALREADY_PLAYING
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.CARNIVALGAME_ALREADY_PLAYING"
msgid "We're playing next!"
msgstr "Tụi mình sẽ chơi lượt kế tiếp!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.CARNIVALGAME_GOLFGAME_NOTREADY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.CARNIVALGAME_GOLFGAME_NOTREADY"
msgid "We think it's missing the flaghole still!"
msgstr "Tụi mình nghĩ nó vẫn còn thiếu lỗ cắm cờ!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.CARNIVALGAME_INVALID_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.CARNIVALGAME_INVALID_ITEM"
msgid "Hmm, it doesn't want that."
msgstr "Hừm, nó không muốn nhận thứ đó đâu."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.DEAD"
msgid "Um. We should probably keep it."
msgstr "Ừm. Chắc tụi mình nên giữ lại thì hơn."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.DUPLICATE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.DUPLICATE"
msgid "We don't need two!"
msgstr "Tụi mình có cần tận hai cái đâu!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.FOODFULL
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.FOODFULL"
msgid "It's still working on the first one."
msgstr "Nó vẫn đang xử lý cái đầu tiên mà."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.GENERIC"
msgid "Nope, don't think so!"
msgstr "Không, chắc là không đâu!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.GHOSTHEART
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.GHOSTHEART"
msgid "We don't think we even want them to come back."
msgstr "Tụi mình thậm chí còn chẳng muốn họ quay lại ấy chứ."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG"
msgid "It needs a special kind of log!"
msgstr "Nó cần một loại khúc gỗ đặc biệt!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM"
msgid "It needs a mushroom!"
msgstr "Nó cần một cây nấm!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.MUSHROOMFARM_NOMOONALLOWED
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.MUSHROOMFARM_NOMOONALLOWED"
msgid "We don't think they're going to grow."
msgstr "Tụi mình nghĩ chúng sẽ không lớn nổi đâu."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.NOGENERATORSKILL
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.NOGENERATORSKILL"
msgid "We'd rather keep this one for ourselves."
msgstr "Tụi mình muốn giữ cái này lại cho riêng mình hơn."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.NOMOON
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.NOMOON"
msgid "Doesn't work. We probably need to see the moon or something."
msgstr "Không ăn thua. Chắc tụi mình phải nhìn thấy mặt trăng hay gì đó."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.NOTAMONKEY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.NOTAMONKEY"
msgid "Sorry, neither of us speak monkey."
msgstr "Xin lỗi, không ai trong tụi mình biết tiếng khỉ cả."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.NOTDISH
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.NOTDISH"
msgid "We don't think we should offer that."
msgstr "Tụi mình nghĩ không nên đem thứ đó ra cúng."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.NOTGEM
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.NOTGEM"
msgid "It doesn't fit right!"
msgstr "Nó nhét không vừa!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.NOTSCULPTABLE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.NOTSCULPTABLE"
msgid "Eight legs isn't nearly enough to sculpt with THAT."
msgstr "Tám cái chân thì chưa thấm vào đâu để mà nặn cái ĐÓ cả."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.NOTSTAFF
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.NOTSTAFF"
msgid "We think that'd make it angry."
msgstr "Tụi mình nghĩ làm thế sẽ chọc giận nó đấy."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER"
msgid "Lets wait until the danger passes before we play."
msgstr "Hãy đợi qua cơn nguy hiểm rồi tụi mình hãy chơi."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.PIGKINGGAME_MESSY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.PIGKINGGAME_MESSY"
msgid "We need to clean up before we can play."
msgstr "Tụi mình cần dọn dẹp sạch sẽ trước đã."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.PIGKINGGAME_TOOLATE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.PIGKINGGAME_TOOLATE"
msgid "It's too close to bedtime to start another game."
msgstr "Sắp đến giờ đi ngủ rồi, không chơi ván nữa đâu."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.QUEENBUSY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.QUEENBUSY"
msgid "She looks pretty busy... maybe we'll just wait."
msgstr "Trông cô ấy bận lắm... hay tụi mình cứ đợi đi."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.SLEEPING"
msgid "Aww... It's sleepy-snoozy right now!"
msgstr "Ôi... Nó đang ngái ngủ khò khò kìa!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.SLOTFULL
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.SLOTFULL"
msgid "Mom said to always finish my plate before seconds."
msgstr "Mẹ dặn là phải ăn hết phần trên đĩa mới được ăn thêm."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.SPIDERNOHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.SPIDERNOHAT"
msgid "There's not enough room, we don't want to squish them by accident!"
msgstr "Không còn chỗ trống nữa, tụi mình không muốn lỡ tay đè bẹp các bạn ấy đâu!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.TERRARIUM_COOLDOWN
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.TERRARIUM_COOLDOWN"
msgid "Let's wait for the little tree to come back first!"
msgstr "Hãy đợi cái cây nhỏ quay lại trước đã nào!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.TERRARIUM_REFUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.TERRARIUM_REFUSE"
msgid "Maybe we can give it something else?"
msgstr "Hay là tụi mình đưa cho nó thứ khác nhỉ?"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.WRONGGEM
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.WRONGGEM"
msgid "We'd rather keep this one for ourselves."
msgstr "Tụi mình muốn giữ cái này lại cho riêng mình hơn."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.WRONGSHADOWFORM
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.WRONGSHADOWFORM"
msgid "We put the bones together wrong."
msgstr "Tụi mình xếp nhầm xương rồi."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVEALLTOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVEALLTOPLAYER.BUSY"
msgid "We have something for you!"
msgstr "Tụi mình có món này cho bạn nè!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVEALLTOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVEALLTOPLAYER.DEAD"
msgid "Um. We should probably keep it."
msgstr "Ừm. Chắc tụi mình nên giữ lại thì hơn."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVEALLTOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVEALLTOPLAYER.FULL"
msgid "Hey! Make room!"
msgstr "Này! Nhường chỗ nào!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING"
msgid "Aww... They're getting their snoozies right now!"
msgstr "Ối... Họ đang tranh thủ chợp mắt kìa!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVETOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVETOPLAYER.BUSY"
msgid "We have something for you!"
msgstr "Chúng tôi có thứ này cho bạn này!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVETOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVETOPLAYER.DEAD"
msgid "Um. We should probably keep it."
msgstr "Ừm. Chắc chúng ta nên giữ lại thì hơn."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVETOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVETOPLAYER.FULL"
msgid "Hey! Make room!"
msgstr "Này! Nhường chỗ nào!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVETOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVETOPLAYER.SLEEPING"
msgid "Aww... They're getting their snoozies right now!"
msgstr "Ối... Họ đang tranh thủ chợp mắt kìa!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE_TACKLESKETCH.DUPLICATE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE_TACKLESKETCH.DUPLICATE"
msgid "We don't need two!"
msgstr "Chúng ta không cần đến hai cái đâu!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.HARVEST.DOER_ISNT_MODULE_OWNER
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.HARVEST.DOER_ISNT_MODULE_OWNER"
msgid "We don't think Jimmy wants to play."
msgstr "Chúng ta không nghĩ Jimmy muốn chơi đâu."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.HEAL.NOT_MERM
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.HEAL.NOT_MERM"
msgid "It won't work on us."
msgstr "Nó không có tác dụng với chúng ta đâu."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.HERD_FOLLOWERS.WEBBERONLY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.HERD_FOLLOWERS.WEBBERONLY"
msgid "Okay everybody, follow us!"
msgstr "Nào mọi người, theo chúng tôi!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.HITCHUP.BEEF_HITCHED
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.HITCHUP.BEEF_HITCHED"
msgid "Our beefalo isn't going anywhere."
msgstr "Bò lai của chúng ta không đi đâu cả."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.HITCHUP.INMOOD
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.HITCHUP.INMOOD"
msgid "I think they're a bit too cranky for that right now."
msgstr "Tôi nghĩ chúng đang hơi cáu kỉnh để làm chuyện đó lúc này."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.HITCHUP.NEEDBEEF
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.HITCHUP.NEEDBEEF"
msgid "We don't have a beefalo to hitch up."
msgstr "Chúng ta không có con bò lai nào để buộc vào cả."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.HITCHUP.NEEDBEEF_CLOSER
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.HITCHUP.NEEDBEEF_CLOSER"
msgid "Our beefalo is too far away!"
msgstr "Bò lai của chúng ta ở xa quá!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.LOWER_SAIL_FAIL.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.LOWER_SAIL_FAIL.1"
msgid "We never did much sailing back home."
msgstr "Hồi ở nhà tụi mình có đi thuyền mấy đâu."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.LOWER_SAIL_FAIL.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.LOWER_SAIL_FAIL.2"
msgid "Ouchie! The rope burned our hands!"
msgstr "Á đau! Dây thừng cọ rát tay chúng ta rồi!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.LOWER_SAIL_FAIL.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.LOWER_SAIL_FAIL.3"
msgid "We almost had it!"
msgstr "Suýt nữa thì được rồi!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MARK.ALREADY_MARKED
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MARK.ALREADY_MARKED"
msgid "We're pretty sure we picked the right one!"
msgstr "Chúng ta khá chắc là mình đã chọn đúng cái rồi!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MARK.NOT_PARTICIPANT
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MARK.NOT_PARTICIPANT"
msgid "We can't play without entering a beefalo in the contest."
msgstr "Chúng ta không thể chơi nếu không đăng ký một con bò lai vào cuộc thi."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MOUNT.INUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MOUNT.INUSE"
msgid "We didn't climb into the saddle in time!"
msgstr "Chúng ta trèo lên yên cưỡi không kịp rồi!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MOUNT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MOUNT.SLEEPING"
msgid "Oops, were you sleeping?"
msgstr "Ấy, bạn đang ngủ à?"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MOUNT.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MOUNT.TARGETINCOMBAT"
msgid "It's too angry!"
msgstr "Nó giận quá rồi!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MUTATE.CAVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MUTATE.CAVE"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MUTATE.NOFULLMOON
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MUTATE.NOFULLMOON"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MUTATE.NOGHOST
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MUTATE.NOGHOST"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MUTATE.NONEWMOON
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MUTATE.NONEWMOON"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MUTATE.NOTNIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MUTATE.NOTNIGHT"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.OCEAN_FISHING_POND.WRONGGEAR
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.OCEAN_FISHING_POND.WRONGGEAR"
msgid "We think we should use a different fishing rod."
msgstr "Chúng ta nghĩ mình nên dùng một chiếc cần câu khác."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.OPEN_CRAFTING.PROFESSIONALCHEF
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.OPEN_CRAFTING.PROFESSIONALCHEF"
msgid "Warly gets upset when we play with his things."
msgstr "Warly sẽ buồn lắm nếu chúng ta nghịch đồ của chú ấy đấy."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.OPEN_CRAFTING.SHADOWMAGIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.OPEN_CRAFTING.SHADOWMAGIC"
msgid "I don't think we should play with that..."
msgstr "Tôi không nghĩ chúng ta nên nghịch thứ đó đâu..."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PICK.NOTHING_INSIDE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PICK.NOTHING_INSIDE"
msgid "We found nothing inside!"
msgstr "Chúng ta chẳng tìm thấy gì bên trong cả!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PICK.STUCK
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PICK.STUCK"
msgid "Aw! It's stuck!"
msgstr "Ái! Nó bị kẹt rồi!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PICKUP.FULL_OF_CURSES
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PICKUP.FULL_OF_CURSES"
msgid "We think we've had enough of these bracelets."
msgstr "Chúng ta nghĩ là mình đã có đủ mấy chiếc vòng tay này rồi."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PICKUP.INUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PICKUP.INUSE"
msgid "Oops. Someone else is using that."
msgstr "Ôi. Ai đó đang dùng cái đó mất tiêu rồi."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PICKUP.NOTMINE_SPIDER
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PICKUP.NOTMINE_SPIDER"
msgid "Oh! We're sorry, you looked like a friend of ours."
msgstr "Ồ! Tụi mình xin lỗi, trông bạn giống một người bạn của tụi mình quá."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PICKUP.NOTMINE_YOTC.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PICKUP.NOTMINE_YOTC.1"
msgid "Whoops! Wrong Carrat!"
msgstr "Ối nhầm! Nhầm Cà Ruột rồi!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PICKUP.NOTMINE_YOTC.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PICKUP.NOTMINE_YOTC.2"
msgid "They all look kind of similar..."
msgstr "Trông chúng cứ giống nhau thế nào ấy..."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PICKUP.RESTRICTION
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PICKUP.RESTRICTION"
msgid "We don't want to use that."
msgstr "Chúng ta không muốn dùng cái đó đâu."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.FERTILIZER"
msgid "There's nothing else we need to know."
msgstr "Chẳng còn gì mà chúng ta cần biết nữa đâu."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.GENERIC"
msgid "We already know everything about this plant!"
msgstr "Chúng ta đã biết tất cả mọi thứ về loài thực vật này rồi!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.POUNCECAPTURE.MISSED
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.POUNCECAPTURE.MISSED"
msgid "Aww, we missed!"
msgstr "Ái chà, trượt mất tiêu rồi!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.POUR_WATER.OUT_OF_WATER
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.POUR_WATER.OUT_OF_WATER"
msgid "Oops, out of water!"
msgstr "Ôi, hết nước mất rồi!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.POUR_WATER_GROUNDTILE.OUT_OF_WATER
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.POUR_WATER_GROUNDTILE.OUT_OF_WATER"
msgid "Aw, we're all out of water."
msgstr "Trời ạ, chúng ta hết sạch nước mất rồi."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.REMOTE_TELEPORT.NODEST
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.REMOTE_TELEPORT.NODEST"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.REMOTE_TELEPORT.NOSKILL
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.REMOTE_TELEPORT.NOSKILL"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.REMOVEMODULES.NO_MODULES
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.REMOVEMODULES.NO_MODULES"
msgid "only_used_by_wx78"
msgstr "chỉ_được_sử_dụng_bởi_wx78"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.REPAIR.WRONGPIECE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.REPAIR.WRONGPIECE"
msgid "This two piece puzzle sure is hard!"
msgstr "Trò xếp hình hai mảnh này khó phết đấy!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.REPLATE.MISMATCH
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.REPLATE.MISMATCH"
msgid "Hmmm... I think we need a different dish for this."
msgstr "Hừm... Tôi nghĩ chúng ta cần một cái đĩa khác cho món này."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.REPLATE.SAMEDISH
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.REPLATE.SAMEDISH"
msgid "We already put this on a dish."
msgstr "Chúng ta bày cái này lên đĩa từ nãy rồi mà."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ROW_FAIL.BAD_TIMING0
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ROW_FAIL.BAD_TIMING0"
msgid "We need to paddle at the right time!"
msgstr "Chúng ta phải chèo đúng nhịp chứ!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ROW_FAIL.BAD_TIMING1
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ROW_FAIL.BAD_TIMING1"
msgid "Whoops! One more time!"
msgstr "Ối! Làm lại lần nữa nào!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ROW_FAIL.BAD_TIMING2
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ROW_FAIL.BAD_TIMING2"
msgid "Row row row your boat... maybe a bit better next time."
msgstr "Chèo chèo chèo thuyền nào... lần tới chắc sẽ khá hơn một chút."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.RUMMAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.RUMMAGE.GENERIC"
msgid "That's off-limits."
msgstr "Cái đó cấm động vào."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.RUMMAGE.INUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.RUMMAGE.INUSE"
msgid "It's okay, we can wait for you to finish!"
msgstr "Không sao đâu, chúng ta đợi bạn làm xong cũng được!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.RUMMAGE.NOTAMERM
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.RUMMAGE.NOTAMERM"
msgid "We don't think we're allowed."
msgstr "Chúng ta không nghĩ mình được phép làm thế đâu."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.RUMMAGE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.RUMMAGE.NOTAROBOT"
msgid "We can't. The robot will get mad."
msgstr "Chúng ta không thể đâu. Con robot sẽ nổi giận mất."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.RUMMAGE.NOTMASTERCHEF
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.RUMMAGE.NOTMASTERCHEF"
msgid "Warly gets upset when we play with his things."
msgstr "Warly sẽ buồn lắm nếu chúng ta nghịch đồ của chú ấy đấy."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.RUMMAGE.NOTSOULJARHANDLER
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.RUMMAGE.NOTSOULJARHANDLER"
msgid "We promised not to play with the souls."
msgstr "Chúng ta đã hứa là sẽ không nghịch mấy linh hồn đó mà."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.RUMMAGE.RESTRICTED
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.RUMMAGE.RESTRICTED"
msgid "We're not allowed."
msgstr "Chúng ta không được phép đâu."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.SADDLE.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.SADDLE.TARGETINCOMBAT"
msgid "It's too angry!"
msgstr "Nó giận quá rồi!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.SHAVE.AWAKEBEEFALO
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.SHAVE.AWAKEBEEFALO"
msgid "It's hairy like us, but I don't think it likes shaving."
msgstr "Nó cũng có lông giống chúng ta, nhưng chắc nó không thích cạo lông đâu."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.SHAVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.SHAVE.GENERIC"
msgid "It's not shaving time!"
msgstr "Chưa đến giờ cạo lông đâu!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.SHAVE.NOBITS
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.SHAVE.NOBITS"
msgid "Clean as a whistle."
msgstr "Sạch bong kin kít."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.SHAVE.SOMEONEELSESBEEFALO
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.SHAVE.SOMEONEELSESBEEFALO"
msgid "We shouldn't do that to someone else's beefalo."
msgstr "Chúng ta không nên làm thế với con bò lai của người khác đâu."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.SLAUGHTER.TOOFAR
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.SLAUGHTER.TOOFAR"
msgid "Aw, it got away."
msgstr "Tiếc quá, nó chạy mất tiêu rồi."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.SOAKIN.NOSPACE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.SOAKIN.NOSPACE"
msgid "We can't! There's someone there!"
msgstr "Chúng ta không thể! Có người ở đấy rồi kìa!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.START_CARRAT_RACE.NO_RACERS
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.START_CARRAT_RACE.NO_RACERS"
msgid "We need to find some Carrats!"
msgstr "Chúng ta cần tìm vài con Cà Ruột đã!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.GENERIC"
msgid "All full!"
msgstr "Chật cứng rồi!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.INUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.INUSE"
msgid "Are you finding everything okay in there?"
msgstr "Mọi thứ trong đó ổn cả chứ hả?"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.NOTALLOWED"
msgid "That's against the rules."
msgstr "Làm thế là phạm luật đấy."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.NOTAROBOT"
msgid "We can't. The robot will get mad."
msgstr "Chúng ta không thể đâu. Con robot sẽ nổi giận mất."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.NOTMASTERCHEF
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.NOTMASTERCHEF"
msgid "Warly gets upset when we play with his things."
msgstr "Warly sẽ buồn lắm nếu chúng ta nghịch đồ của chú ấy đấy."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.NOTSOULJARHANDLER
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.NOTSOULJARHANDLER"
msgid "We promised not to play with the souls."
msgstr "Chúng ta đã hứa là sẽ không nghịch mấy linh hồn đó mà."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.RESTRICTED
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.RESTRICTED"
msgid "We're not allowed."
msgstr "Chúng ta không được phép đâu."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.TEACH.CANTLEARN
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.TEACH.CANTLEARN"
msgid "Ms. Wickerbottom will have to explain this one."
msgstr "Chắc cô Wickerbottom sẽ phải giải thích cái này rồi."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.TEACH.KNOWN
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.TEACH.KNOWN"
msgid "I'm pretty sure one of us knows that one."
msgstr "Tôi khá chắc là một trong số chúng ta biết cái đó đấy."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.TEACH.MESSAGEBOTTLEMANAGER_NOT_FOUND
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.TEACH.MESSAGEBOTTLEMANAGER_NOT_FOUND"
msgid "We should wait until we get outside."
msgstr "Chúng ta nên đợi ra ngoài rồi hẵn tính."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.TEACH.STASH_MAP_NOT_FOUND
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.TEACH.STASH_MAP_NOT_FOUND"
msgid "Hey... there's no \"X\" on this map!"
msgstr "Này... trên bản đồ này không có chữ \"X\" nào cả!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.TEACH.WRONGWORLD
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.TEACH.WRONGWORLD"
msgid "Is it upside down? Nope. It's just wrong."
msgstr "Nó bị ngược à? Không. Chỉ là nhầm lẫn thôi."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.TELLSTORY.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.TELLSTORY.GENERIC"
msgid "only_used_by_walter"
msgstr "chỉ_được_sử_dụng_bởi_walter"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.UPGRADE.BEDAZZLED
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.UPGRADE.BEDAZZLED"
msgid "But we made it look so nice! Let's keep it the way it is."
msgstr "Nhưng chúng ta vừa làm cho nó trông đẹp lắm mà! Cứ để nguyên vậy đi."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEITEMON.BEEF_BELL_ALREADY_USED
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEITEMON.BEEF_BELL_ALREADY_USED"
msgid "That's someone else's friend."
msgstr "Đó là bạn của người khác mà."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEITEMON.BEEF_BELL_HAS_BEEF_ALREADY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEITEMON.BEEF_BELL_HAS_BEEF_ALREADY"
msgid "We already have a beefalo of our own!"
msgstr "Chúng ta đã có một con bò lai của riêng mình rồi!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEITEMON.BEEF_BELL_INVALID_TARGET
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEITEMON.BEEF_BELL_INVALID_TARGET"
msgid "We're pretty sure it's not meant for that."
msgstr "Chúng ta khá chắc nó không dùng để làm việc đó đâu."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEITEMON.CANNOT_FIX_DRONE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEITEMON.CANNOT_FIX_DRONE"
msgid "We can't fix it."
msgstr "Chúng ta không sửa được nó đâu."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEITEMON.NOT_MINE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEITEMON.NOT_MINE"
msgid "We aren't allowed to play with that."
msgstr "Chúng ta không được phép nghịch thứ đó."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS"
msgid "It's too dangerous!"
msgstr "Nguy hiểm lắm!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY"
msgid "Aw... It's the wrong one."
msgstr "Ái... Không phải cái này."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY"
msgid "That doesn't go there!"
msgstr "Cái đó không hợp với chỗ này!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.WRAPBUNDLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.WRAPBUNDLE.EMPTY"
msgid "But what should we wrap up?"
msgstr "Nhưng chúng ta nên gói cái gì lại đây?"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.WRITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.WRITE.GENERIC"
msgid "We can't write on that now."
msgstr "Bây giờ chúng ta không viết lên đó được đâu."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.WRITE.INUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.WRITE.INUSE"
msgid "We'll get our crayons ready while they finish up!"
msgstr "Chúng ta sẽ lấy sẵn bút sáp màu trong lúc họ làm xong nhé!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.YOTB_STARTCONTEST.ALREADYACTIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.YOTB_STARTCONTEST.ALREADYACTIVE"
msgid "Maybe there's another contest going on somewhere else?"
msgstr "Biết đâu lại có cuộc thi nào khác đang diễn ra ở đâu đó thì sao?"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK"
msgid "Anybody there? Guess not..."
msgstr "Có ai ở đấy không nhỉ? Chắc là không rồi..."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.YOTB_STARTCONTEST.NORESPONSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.YOTB_STARTCONTEST.NORESPONSE"
msgid "We can't find him."
msgstr "Chúng ta không tìm thấy chú ta rồi."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE"
msgid "He's ignoring us."
msgstr "Chú ấy đang phớt lờ chúng ta kìa."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN"
msgid "Hey, we already have that one!"
msgstr "Này, chúng ta có cái đó từ trước rồi mà!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL_GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL_GENERIC"
msgid "Mom told me never to do that."
msgstr "Mẹ dặn tôi là không bao giờ được làm thế."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ACCOMPLISHMENT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ACCOMPLISHMENT"
msgid "We're so capable!"
msgstr "Chúng ta thật là tài giỏi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ACCOMPLISHMENT_DONE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ACCOMPLISHMENT_DONE"
msgid "We're a super hero!"
msgstr "Chúng ta là siêu anh hùng đấy!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ACIDBATS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ACIDBATS"
msgid "We don't like that sound."
msgstr "Chúng ta không thích âm thanh đó chút nào."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ADVENTUREFAIL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ADVENTUREFAIL"
msgid "Play time is over."
msgstr "Hết giờ chơi rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_SINKHOLE.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_SINKHOLE.1"
msgid "The ground's giving way!"
msgstr "Mặt đất đang sụt xuống kìa!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_SINKHOLE.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_SINKHOLE.2"
msgid "It's rumble-y!"
msgstr "Nghe cứ ùng ục ấy!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_SINKHOLE.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_SINKHOLE.3"
msgid "What's that?"
msgstr "Gì thế nhỉ?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_TRIBUTE.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_TRIBUTE.1"
msgid "For you!"
msgstr "Cho bạn này!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_TRIBUTE.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_TRIBUTE.2"
msgid "Maybe it'll be happier now."
msgstr "Biết đâu bây giờ nó sẽ vui hơn."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_TRIBUTE.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_TRIBUTE.3"
msgid "I hope you like our tribute!"
msgstr "Mong là bạn sẽ thích món quà của tụi mình!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE"
msgid "Haha, it tickles our brain!"
msgstr "Haha, nhột đại não chúng ta quá!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ARCHIVE_NO_POWER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ARCHIVE_NO_POWER"
msgid "Aww, nothing happened!"
msgstr "Tiếc quá, chẳng có chuyện gì xảy ra cả!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE"
msgid "We already learned that one."
msgstr "Cái đó chúng ta học rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATRIUM_DESTABILIZING.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATRIUM_DESTABILIZING.1"
msgid "That gateway did something weird."
msgstr "Cái cổng đó vừa làm gì lạ lắm."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATRIUM_DESTABILIZING.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATRIUM_DESTABILIZING.2"
msgid "Something's happening."
msgstr "Có chuyện gì đang xảy ra kìa."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATRIUM_DESTABILIZING.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATRIUM_DESTABILIZING.3"
msgid "Let's get out of here."
msgstr "Chuồn khỏi đây thôi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_ATTACK"
msgid "We feel so strong!"
msgstr "Chúng ta thấy khỏe lắm rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK"
msgid "With great lightning powers comes great responsibility!"
msgstr "Sức mạnh sấm sét càng lớn thì trách nhiệm càng cao!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY"
msgid "Away, nasty water!"
msgstr "Tránh xa ra, nước đáng ghét!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION"
msgid "We feel so much safer now!"
msgstr "Bây giờ chúng ta thấy an toàn hơn hẳn rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE"
msgid "We'll never feel sleepy again!"
msgstr "Chúng ta sẽ chẳng bao giờ thấy buồn ngủ nữa đâu!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS"
msgid "We can help out with the chores!"
msgstr "Chúng ta có thể phụ giúp làm việc nhà rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BECOMEGHOST
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BECOMEGHOST"
msgid "oOooOooO!!"
msgstr "oOooOooO!!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BEES
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BEES"
msgid "Flying ouchies!"
msgstr "Mấy cục nhức nhói biết bay kìa!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BOAT_LEAK"
msgid "The boat is crying!"
msgstr "Thuyền ván đang khóc kìa!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BOAT_SINK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BOAT_SINK"
msgid "We're too young to drown!"
msgstr "Chúng ta còn quá nhỏ để chết đuối!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BOOMERANG"
msgid "It hurts us when we don't catch it."
msgstr "Không bắt lấy nó là chúng ta bị đau đấy."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BRAVERY_POTION
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BRAVERY_POTION"
msgid "Hey, those trees aren't so scary anymore!"
msgstr "Này, mấy cái cây đó trông đỡ đáng sợ hơn rồi kìa!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BURNT"
msgid "Jeepers, that was hot!"
msgstr "Trời ạ, nóng ghê cơ!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CALL_BEEF
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CALL_BEEF"
msgid "Over here, beefalo! Follow us!"
msgstr "Mau lại đây nào, bò lai! Theo chúng tôi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CANFIX
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CANFIX"
msgid "\nWe can repair it."
msgstr "Chúng ta có thể sửa nó."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS"
msgid "We don't have enough stuff!"
msgstr "Chúng ta không đủ nguyên liệu rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CANNOT_BUILD.NO_STATION
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CANNOT_BUILD.NO_STATION"
msgid "We can't make that right now."
msgstr "Chúng ta không thể chế tạo cái đó lúc này."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CANNOT_BUILD.NO_TECH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CANNOT_BUILD.NO_TECH"
msgid "We're not sure how to make that yet..."
msgstr "Chúng ta chưa biết cách làm cái đó thế nào..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CANTBUILDHERE_YOTB_POST
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CANTBUILDHERE_YOTB_POST"
msgid "We should put this where the judge can see it."
msgstr "Chúng ta nên đặt cái này ở nơi trọng tài có thể nhìn thấy."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CANT_ESCAPE_CURSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CANT_ESCAPE_CURSE"
msgid "Oh... maybe we don't want to throw it away after all."
msgstr "Ồ... có lẽ suy cho cùng chúng ta không muốn vứt nó đi đâu."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP"
msgid "This is no time for a nap!"
msgstr "Đây không phải lúc để đánh một giấc đâu!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CARRAT_ERROR_STUNNED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CARRAT_ERROR_STUNNED"
msgid "Oh no! Snap out of it!"
msgstr "Ồ không! Tỉnh lại đi nào!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CARRAT_ERROR_WALKING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CARRAT_ERROR_WALKING"
msgid "Come on, you've got to run faster!"
msgstr "Nào, bạn phải chạy nhanh lên chứ!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1"
msgid "Hey! You're going the wrong way!"
msgstr "Này! Bạn đi ngược đường rồi kìa!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2"
msgid "You're supposed to go the other way!"
msgstr "Lẽ ra bạn phải đi hướng bên kia chứ!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CARRAT_START_RACE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CARRAT_START_RACE"
msgid "Ready, set, go!"
msgstr "Chuẩn bị, sẵn sàng, xuất phát!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CAVEIN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CAVEIN"
msgid "I think the sky is falling!"
msgstr "Tôi nghĩ bầu trời đang sập xuống rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CHAIR_ON_FIRE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CHAIR_ON_FIRE"
msgid "We are fine."
msgstr "Chúng tôi vẫn ổn."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CHARLIE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CHARLIE"
msgid "Is somebody there?!"
msgstr "Có ai ở đó không thế?!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CHARLIESAVE.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CHARLIESAVE.1"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CHARLIE_ATTACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CHARLIE_ATTACK"
msgid "Aah! Monsters in the dark!"
msgstr "Ái! Quái vật trong bóng tối!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COACH.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COACH.1"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COACH.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COACH.2"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COACH.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COACH.3"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COACH.4
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COACH.4"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COACH.5
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COACH.5"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COACH.6
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COACH.6"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COACH.7
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COACH.7"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COACH.8
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COACH.8"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COACH.9
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COACH.9"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COLD"
msgid "Brrr... spider hair isn't very warm."
msgstr "Brrr... lông nhện chẳng ấm lắm đâu."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COMPASS_OUT"
msgid "Uh oh, I broke it."
msgstr "Ôi không, tôi làm hỏng nó mất tiêu rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COZY_SLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COZY_SLEEP"
msgid "We had such a good sleep!"
msgstr "Chúng ta đã có một giấc ngủ thật ngon!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CRAFTING_FAIL"
msgid "We're missing something."
msgstr "Chúng ta đang thiếu thứ gì đó."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DAMP"
msgid "Splishy splashy."
msgstr "Ướt nhép luôn."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DEERCLOPS"
msgid "That sounded like a big meanie."
msgstr "Nghe có vẻ như một kẻ xấu tính to lớn."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DESPAWN"
msgid "Everything's getting fuzzy!"
msgstr "Mọi thứ đang mờ tịt đi rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DETACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DETACH_BUFF_ATTACK"
msgid "We're tired of fighting!"
msgstr "Chúng ta chán đánh nhau lắm rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK"
msgid "Aww, done already?"
msgstr "Ối, xong rồi á?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY"
msgid "Nooo! Spiders don't like the damp!"
msgstr "Khôngggg! Nhện không thích ẩm ướt đâu!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION"
msgid "Aah! We need armor!"
msgstr "Ái! Chúng ta cần giáp!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE"
msgid "Actually... we might feel a bit sleepy again."
msgstr "Thực ra thì... có lẽ chúng ta lại thấy hơi buồn ngủ rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS"
msgid "We're bored now."
msgstr "Bây giờ thì chúng ta chán ngấy rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DIG_DISEASE_WARNING"
msgid "Doesn't that feel better!"
msgstr "Thế có phải dễ chịu hơn không nào!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DUSK"
msgid "Almost time for bed."
msgstr "Sắp đến giờ đi ngủ rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.GENERIC"
msgid "Yummy in our tummy!"
msgstr "Ngon tuyệt cú mèo trong bụng tụi mình!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.INVALID
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.INVALID"
msgid "That doesn't look like food to us."
msgstr "Trông nó chẳng giống đồ ăn với chúng ta chút nào."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.PAINFUL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.PAINFUL"
msgid "Our tummy hurts."
msgstr "Bụng chúng ta đau quá."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.SPOILED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.SPOILED"
msgid "Past its date."
msgstr "Quá hạn sử dụng rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.STALE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.STALE"
msgid "Stale like mum's leftovers."
msgstr "Ôi thiu như đồ ăn thừa của mẹ ấy."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.YUCKY"
msgid "We can't, we won't, we refuse to eat that."
msgstr "Chúng ta không thể, không muốn, và tuyệt đối không ăn thứ đó đâu."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EATING_NOT_FEASTING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EATING_NOT_FEASTING"
msgid "We really should share."
msgstr "Lẽ ra chúng ta thực sự nên chia sẻ mới phải."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ELIXIR_BOOSTED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ELIXIR_BOOSTED"
msgid "Mmmm, we feel better."
msgstr "Mmmm, tụi mình thấy khỏe hơn rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ELIXIR_GHOSTVISION
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ELIXIR_GHOSTVISION"
msgid "Like what Abby sees!"
msgstr "Giống như những gì Abby nhìn thấy vậy!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ELIXIR_PLAYER_SPEED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ELIXIR_PLAYER_SPEED"
msgid "We can help carry heavy stuff!"
msgstr "Chúng ta có thể giúp khiêng đồ nặng đấy!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ELIXIR_TOO_SUPER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ELIXIR_TOO_SUPER"
msgid "That's too much for us."
msgstr "Cái đó quá sức với chúng ta rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.1"
msgid "Ughh!"
msgstr "Hự...!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.2"
msgid "So heavy...!"
msgstr "Nặng quá...!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.3"
msgid "Left foot... Right foot..."
msgstr "Chân trái... Chân phải..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.4"
msgid "We... can do it!"
msgstr "Chúng ta... làm được mà!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.5"
msgid "Are... we there yet..."
msgstr "Đến... nơi... chưa..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.6"
msgid "Chugga chugga chugga chugga..."
msgstr "Xình xịch xình xịch xình xịch..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.7"
msgid "Not enough... legs... to lift..."
msgstr "Không đủ... chân... để nhấc lên..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.8
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.8"
msgid "Hhhhfn!"
msgstr "Hhhhfn!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.9
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.9"
msgid "Oof...!"
msgstr "Oof...!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENGINEERING_CAN_UPGRADE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENGINEERING_CAN_UPGRADE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENTER_DARK"
msgid "We can't see! I want my nightlight."
msgstr "Chúng ta chẳng thấy gì cả! Tôi muốn có đèn ngủ."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENTER_LIGHT"
msgid "Phew, light!"
msgstr "Phù, có ánh sáng rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EXIT_GELBLOB
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EXIT_GELBLOB"
msgid "We're all sticky!"
msgstr "Người chúng ta dính tít mù rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EYEOFTERROR_ARRIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EYEOFTERROR_ARRIVE"
msgid "Why do we feel like we're being watched?"
msgstr "Sao chúng ta cứ có cảm giác đang bị theo dõi thế nhỉ?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EYEOFTERROR_FLYAWAY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EYEOFTERROR_FLYAWAY"
msgid "It doesn't want to play anymore."
msgstr "Nó không muốn chơi nữa rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EYEOFTERROR_FLYBACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EYEOFTERROR_FLYBACK"
msgid "Coming back to play some more?"
msgstr "Lại quay lại chơi tiếp à?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FAN_OUT"
msgid "Aaw, the twirly is gone."
msgstr "Ái chà, quạt nan mất tiêu rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FERTILIZER_RESEARCHED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FERTILIZER_RESEARCHED"
msgid "We never knew there was so much to learn about this stuff!"
msgstr "Chúng ta chưa bao giờ biết có nhiều thứ để học về món này thế đấy!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FIRENETTLE_TOXIN.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FIRENETTLE_TOXIN.1"
msgid "Owie, that was not a nice plant!"
msgstr "Ái, đó không phải là một loài thực vật tốt bụng đâu!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FIRENETTLE_TOXIN.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FIRENETTLE_TOXIN.2"
msgid "Eek, we feel all burny inside!"
msgstr "Hic, chúng ta cảm thấy nóng bừng cả người rồi đây!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FIRENETTLE_TOXIN_DONE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FIRENETTLE_TOXIN_DONE"
msgid "Whew, we'll be more careful not to touch strange weeds."
msgstr "Phù, lần sau chúng ta sẽ cẩn thận hơn để không chạm phải mấy thứ cỏ dại kỳ lạ nữa."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FLARE_SEEN"
msgid "Oh, someone's calling us to come over."
msgstr "Ồ, có ai đó đang gọi chúng ta qua kìa."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FLOATER_HELD
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FLOATER_HELD"
msgid "We float!"
msgstr "Chúng ta nổi lên được này!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FLOATER_LETGO
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FLOATER_LETGO"
msgid "Weeee!"
msgstr "Weeee!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FLOAT_SWIM_TIRED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FLOAT_SWIM_TIRED"
msgid "We're tired!"
msgstr "Chúng ta mệt rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FOODMEMORY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FOODMEMORY"
msgid "only_used_by_warly"
msgstr "chỉ_được_sử_dụng_bởi_warly"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FREEDOM"
msgid "We made it!"
msgstr "Chúng ta làm được rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_GATHER_MERM
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_GATHER_MERM"
msgid "only_used_by_wurt"
msgstr "chỉ_được_sử_dụng_bởi_wurt"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_GHOSTDRAIN"
msgid "We're becoming... even more monstrous!"
msgstr "Chúng ta đang trở nên... quái dị hơn nữa rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_GHOST_QUEST
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_GHOST_QUEST"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_GOT_DECON_MISTED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_GOT_DECON_MISTED"
msgid "That spray tickles!"
msgstr "Cái bình xịt đó nhột quá!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE"
msgid "We'd better not go out in the acid rain until we put on more repellent."
msgstr "Tốt nhất là chúng ta đừng ra ngoài trời mưa axit cho đến khi bôi thêm thuốc chống côn trùng."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE"
msgid "We'd better not play near fire anymore!"
msgstr "Tốt nhất là chúng ta đừng có chơi gần lửa nữa!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE"
msgid "Wheeeeee!"
msgstr "Wheeeeee!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT"
msgid "Aw! Why didn't it work?"
msgstr "Ái! Sao nó không hoạt động nhỉ?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HIGHRESEARCH"
msgid "I'm learning so much!"
msgstr "Tôi học hỏi được bao điều!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HOT"
msgid "Hot as heck!"
msgstr "Nóng chết đi được!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HOUNDS"
msgid "Doggies are coming!"
msgstr "Mấy chú cún đang đến kìa!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNGRY"
msgid "It's time for a snack!"
msgstr "Đến giờ ăn vặt rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_AVOID_FORK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_AVOID_FORK"
msgid "We feel better sticking to the safer trail."
msgstr "Chúng ta cảm thấy đi theo lối mòn an toàn hơn."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "Fresh tracks!"
msgstr "Dấu chân mới kìa!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "Animal went bye-bye."
msgstr "Con vật đi mất tiêu rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "It's too muddy to track."
msgstr "Lầy lội quá không dò dấu được."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_START_FORK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_START_FORK"
msgid "Whatever left those prints must be big... and scary..."
msgstr "Thứ để lại mấy dấu chân này chắc phải to lắm... và đáng sợ lắm..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_SUCCESSFUL_FORK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_SUCCESSFUL_FORK"
msgid "They'll never see us coming!"
msgstr "Họ sẽ không bao giờ thấy chúng ta xuất hiện đâu!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_WRONG_FORK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_WRONG_FORK"
msgid "Why do we feel like something's watching us..."
msgstr "Sao chúng ta cứ có cảm giác có ai đang theo dõi mình nhỉ..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "Not good enough for you, plant?"
msgstr "Chưa đủ tốt cho bạn à, thực vật ơi?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_INV_FULL"
msgid "Our pockets are full!"
msgstr "Túi của chúng ta đầy nhóc rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_IS_FEASTING"
msgid "We want to try everything!"
msgstr "Chúng ta muốn thử tất cả mọi thứ!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD"
msgid "Hello! Are you lost?"
msgstr "Xin chào! Bạn bị lạc à?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "Found you!"
msgstr "Tìm thấy bạn rồi nhé!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "There you are!"
msgstr "Bạn đây rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
msgid "We found you!"
msgstr "Bọn mình tìm thấy bạn rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
msgid "Heehee, gotcha!"
msgstr "Heehee, bắt được nhé!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE"
msgid "That was the last one, we won!"
msgstr "Đó là đứa cuối cùng rồi, chúng ta thắng!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM"
msgid "We did it, we found them all!"
msgstr "Chúng ta làm được rồi, tìm thấy hết bọn chúng luôn!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE"
msgid "We found one more!"
msgstr "Tìm thêm được một đứa nữa rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME"
msgid "Aw... olly olly oxenfree!"
msgstr "Ái... trốn tìm kiểu gì lạ vậy!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP"
msgid "We're almost out of time!"
msgstr "Chúng ta sắp hết thời gian rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR"
msgid "We don't think the kitcoons would go this far out..."
msgstr "Chúng ta không nghĩ mèo trúc con sẽ đi ra xa đến thế này đâu..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN"
msgid "We're back in the kitcoon's playground."
msgstr "Chúng ta đã quay lại sân chơi của mèo trúc con rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN"
msgid "Let's work together to find those kitcoons!"
msgstr "Cùng nhau tìm kiếm mấy chú mèo trúc con đó nào!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDEANDSEEK_START
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDEANDSEEK_START"
msgid "Ready or not, here we come!"
msgstr "Sẵn sàng hay chưa, chúng ta đến đây!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "Uh-oh, its got friends coming!"
msgstr "Ối định mệnh, nó sắp gọi đồng bọn đến kìa!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_ENRAGE"
msgid "Ah! I'm sorry we killed your deer!!"
msgstr "Á! Tụi mình xin lỗi vì đã lỡ giết con hươu của bạn!!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_UNCHAINED"
msgid "Its belly looks hungry!"
msgstr "Trông cái bụng của nó có vẻ đói lắm rồi đấy!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KNOCKEDOUT"
msgid "Ow, our head!"
msgstr "Ái, đầu tụi mình!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "We're invincible!"
msgstr "Chúng ta bất tử rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LIGHTSOUT_SHADOWHAND
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LIGHTSOUT_SHADOWHAND"
msgid "Hey, no fair! Nobody invited that hand to play!"
msgstr "Này, chơi không đẹp! Ai thèm mời cái tay đó vào chơi đâu!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LOWRESEARCH"
msgid "That might've taught a toddler something."
msgstr "Cái đó chắc chỉ dạy được cho mấy đứa trẻ tập đi thôi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNARGUARDIAN_INCOMING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNARGUARDIAN_INCOMING"
msgid "The giant ball is back."
msgstr "Cái quả cầu khổng lồ lại quay lại rồi kìa."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNARHAIL_BIRD_CORPSES
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNARHAIL_BIRD_CORPSES"
msgid "Maybe they're coming down for a rest."
msgstr "Chắc chúng bay xuống đây để nghỉ ngơi thôi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS"
msgid "Those birds don't sound happy."
msgstr "Mấy con chim đó kêu nghe không vui vẻ gì cả."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNAR_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNAR_RIFT_MAX"
msgid "We can see something glowing waaay over there!"
msgstr "Chúng ta có thể thấy thứ gì đó đang phát sáng ở đằng kiaaaa kìa!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Maybe it's not allowed to play with us."
msgstr "Có lẽ nó không được phép chơi với chúng ta."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MEGA_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MEGA_FLARE_SEEN"
msgid "Uh-oh, that bright light's attracting a lot of attention..."
msgstr "Ối chao, ánh sáng chói lọi đó đang thu hút rất nhiều sự chú ý đấy..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MITEGLAND_DEBUFF.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MITEGLAND_DEBUFF.1"
msgid "Our tummy's all burny!"
msgstr "Bụng tụi mình nóng bừng lên rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MITEGLAND_DEBUFF.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MITEGLAND_DEBUFF.2"
msgid "We REALLY shouldn't have eaten that..."
msgstr "Lẽ ra tụi mình KHÔNG NÊN ăn cái đó chút nào..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MITEGLAND_DEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MITEGLAND_DEBUFF_DONE"
msgid "Our tummy is finally feeling better."
msgstr "Cuối cùng thì bụng chúng ta cũng thấy dễ chịu hơn rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_1"
msgid "We feel weird... weirder than usual..."
msgstr "Chúng ta thấy lạ lắm... lạ hơn bình thường nữa..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_CHANGE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_CHANGE"
msgid "What? How...? Now we're really confused..."
msgstr "Gì cơ? Sao lại thế được chứ...? Giờ thì chúng ta thực sự bối rối rồi..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_CHANGEBACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_CHANGEBACK"
msgid "We're us again!"
msgstr "Tụi mình lại là chính mình rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW"
msgid "Almost!"
msgstr "Suýt nữa thì được!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "We'll get you out."
msgstr "Chúng ta sẽ cứu bạn ra."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "You're free!"
msgstr "Bạn được tự do rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "Almost!"
msgstr "Suýt nữa thì được!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "We'll get you out."
msgstr "Chúng ta sẽ cứu bạn ra."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "You're free!"
msgstr "Bạn được tự do rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "Almost!"
msgstr "Suýt nữa thì được!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "We'll get you out."
msgstr "Chúng ta sẽ cứu bạn ra."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "You're free!"
msgstr "Bạn được tự do rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONPOTION_FAILED"
msgid "Whoops!"
msgstr "Ối!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOSQUITOS"
msgid "Suck someone else's blood!"
msgstr "Đi hút máu kẻ khác đi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "Our hairy friend is hurt!"
msgstr "Người bạn nhiều lông của chúng ta bị thương rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL"
msgid "Buzzards! Hey, they look strange."
msgstr "Chim kền kền! Này, trông chúng lạ lắm."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERGIFT"
msgid "We'll open it later as a celebration of surviving this!"
msgstr "Chúng ta sẽ mở nó sau để ăn mừng vì đã sống sót qua chuyện này!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSIESTA"
msgid "Can't nap with monsters nearby!"
msgstr "Không thể chợp mắt khi có quái vật ở gần được!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSLEEP"
msgid "Can't sleep with monsters nearby!"
msgstr "Không thể ngủ khi có quái vật ở gần được!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP"
msgid "It's daytime, not bedtime."
msgstr "Đang là ban ngày, chứ có phải ban đêm đâu mà đi ngủ."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "We're not ready for bed."
msgstr "Chúng ta chưa sẵn sàng đi ngủ đâu."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSIESTA"
msgid "Won't be able to nap with a rumbling tummy."
msgstr "Cái bụng đang réo thế này thì chợp mắt sao nổi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSLEEP"
msgid "Our tummy is rumbling, we can't sleep."
msgstr "Bụng chúng ta đang réo ùng ục, không ngủ được đâu."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I promise I'll ride you again after I open my present!"
msgstr "Tôi hứa là tôi sẽ cưỡi bạn lại sau khi tôi mở quà nhé!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA"
msgid "We can't take a nap, it's nighttime!"
msgstr "Chúng ta không thể chợp mắt được đâu, đang là ban đêm mà!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "No naps til daybreak!"
msgstr "Không ngủ nghê gì cho đến khi trời sáng!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOPUMPKINCARVINGONFIRE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOPUMPKINCARVINGONFIRE"
msgid "Haha! Again!"
msgstr "Haha! Lại nữa đi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT"
msgid "We can't sleep with such a bright nightlight..."
msgstr "Chúng ta không thể ngủ với cái đèn ngủ sáng choang thế này đâu..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOSLEEPONFIRE"
msgid "Mum always said \"Don't sleep in a burning building.\""
msgstr "Mẹ luôn dặn là \"Đừng có ngủ trong tòa nhà đang cháy.\""

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOWARDROBEONFIRE"
msgid "I can't! It's all burny!"
msgstr "Tôi chịu! Nó cháy phừng phừng rồi còn gì!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NO_ABIGAIL_FLOWER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NO_ABIGAIL_FLOWER"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NO_TRAP"
msgid "Easy peasy."
msgstr "Dễ như ăn kẹo."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "Whoops! Let's try that again."
msgstr "Ối! Thử lại lần nữa nào."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "Aww, it got away..."
msgstr "Tiếc quá, nó xổng mất tiêu rồi..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "Was that a nibble? Nope."
msgstr "Vừa rồi có phải cá cắn câu không nhỉ? Không phải."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "Come on out, fishies!"
msgstr "Mau ngoi lên đây nào, mấy chú cá ơi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "This is getting kinda boring..."
msgstr "Trò này bắt đầu thấy hơi chán rồi đấy..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "I thought fishing would be a bit more exciting."
msgstr "Tôi cứ tưởng câu cá sẽ phải thú vị hơn một chút chứ."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "Ah! Aww, our line snapped..."
msgstr "Á! Ồ, đứt dây câu mất rồi..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "Should we reel it in a bit?"
msgstr "Chúng ta có nên cuộn dây lại một chút không?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "Don't eat us!"
msgstr "Đừng ăn tụi mình!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OFF_SCRIPT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OFF_SCRIPT"
msgid "Is that how the play is supposed to go?"
msgstr "Vở kịch phải diễn như thế này sao?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OTTERBOAT_DENBROKEN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OTTERBOAT_DENBROKEN"
msgid "We really shouldn't have broken that den!"
msgstr "Lẽ ra chúng ta không nên phá cái tổ đó!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS"
msgid "Uh-oh... maybe we shouldn't have rowed out so far."
msgstr "Ôi không... có lẽ tụi mình không nên chèo ra xa thế này."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PECKED"
msgid "Bad bird!"
msgstr "Con chim hư đốn!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PETRIFED_TREES"
msgid "The trees are yelling at us!!"
msgstr "Mấy cái cây đang mắng chúng ta kìa!!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "Yuck!"
msgstr "Ghê quá!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PIRATES_ARRIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PIRATES_ARRIVE"
msgid "Uh oh... we're not sure we like the sound of that."
msgstr "Ồ không... tụi mình không chắc là mình thích âm thanh đó đâu."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PLANT_RANDOMSEED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PLANT_RANDOMSEED"
msgid "We can't wait to see what it is!"
msgstr "Tụi mình rất nóng lòng muốn xem nó là gì!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PLANT_RESEARCHED.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PLANT_RESEARCHED.1"
msgid "We're learning so much about this plant!"
msgstr "Chúng ta học được rất nhiều điều về thực vật này!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_POCKETWATCH_PORTAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_POCKETWATCH_PORTAL"
msgid "Wheeeeee--OOF!"
msgstr "Uiiii--ÁC!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PREFALLINVOID
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PREFALLINVOID"
msgid "Let's get out of here!"
msgstr "Chuồn thôi nào!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_QUAKE"
msgid "I don't think that was our tummy."
msgstr "Mình không nghĩ đó là do bụng chúng ta đâu."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT"
msgid "Aw, wrong spot!"
msgstr "Ái chà, sai chỗ mất tiêu!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_AGGRESSIVE"
msgid "We hear something coming! And it sounds grouchy!"
msgstr "Tụi mình nghe thấy có gì đó đang đến! Nghe có vẻ cáu kỉnh đấy!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_LUCKY"
msgid "We see a weird rabbit!"
msgstr "Chúng ta thấy một con thỏ kỳ lạ!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_LUCKYCAUGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_LUCKYCAUGHT"
msgid "We caught it!"
msgstr "Tụi mình bắt được nó rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_PASSIVE"
msgid "Something's burrowing around us!"
msgstr "Có cái gì đó đang đào bới xung quanh chúng ta!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REPELLED"
msgid "We can't hit it."
msgstr "Tụi mình không đánh trúng nó được."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RESEARCH"
msgid "It's almost like being back in school."
msgstr "Cảm giác gần giống như được đi học lại vậy."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "All better!"
msgstr "Khỏe hẳn rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "There you go!"
msgstr "Được rồi đấy!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVING_CORPSE"
msgid "Hold on, we'll help!"
msgstr "Đợi đã, tụi mình sẽ giúp!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.1"
msgid "Our Liege!"
msgstr "Bệ hạ của chúng ta!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.2"
msgid "Nice crown!"
msgstr "Vương miện đẹp đấy!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.3"
msgid "Your wish is our command!"
msgstr "Mệnh lệnh của ngài là ý nguyện của chúng tôi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.1"
msgid "Our \"Liege\"!"
msgstr "\"Bệ hạ\" của chúng ta!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.2"
msgid "Nice \"crown\"!"
msgstr "\"Vương miện\" đẹp đấy!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.3"
msgid "Tell us a joke!"
msgstr "Kể cho tụi mình nghe một câu chuyện cười đi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RUINS_RESET"
msgid "Everything's back!"
msgstr "Mọi thứ đã trở lại rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_NO"
msgid "But those were presents!"
msgstr "Nhưng đó là những món quà mà!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_YES"
msgid "It likes us!"
msgstr "Nó thích chúng ta kìa!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SCRAPBOOK_FULL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SCRAPBOOK_FULL"
msgid "We already filled up our scrapbook."
msgstr "Chúng ta đã lấp đầy cuốn sổ lưu bút của mình rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SECURITY_PULSE_FOLLOWING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SECURITY_PULSE_FOLLOWING"
msgid "Hey! It's following us!"
msgstr "Này! Nó đang bám theo chúng ta kìa!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHADOWTHRALL_STEALTH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHADOWTHRALL_STEALTH"
msgid "Ouch! No fair! We can't see you!"
msgstr "Ái! Chơi gian lận! Tụi mình không thấy bạn được!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHADOW_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHADOW_RIFT_MAX"
msgid "What was that creepy light?"
msgstr "Ánh sáng rùng rợn đó là gì vậy?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHELTER"
msgid "Protect us, tree!"
msgstr "Hãy bảo vệ chúng tôi đi, cây ơi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SISTURN_FULL_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SISTURN_FULL_BLOSSOM"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SISTURN_FULL_EVIL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SISTURN_FULL_EVIL"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED"
msgid "Hey! Meanie!"
msgstr "Này! Đồ xấu tính!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED_IVY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED_IVY"
msgid "Hey! Let go!"
msgstr "Này! Thả ra xem nào!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNOWBALL_NO_SNOW
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNOWBALL_NO_SNOW"
msgid "Where's more snow?"
msgstr "Tuyết đâu mất tiêu rồi?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNOWBALL_TOO_BIG
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNOWBALL_TOO_BIG"
msgid "We can't roll it any bigger!"
msgstr "Tụi mình không thể vo nó to hơn được nữa!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SOAKED"
msgid "We're drenched!"
msgstr "Tụi mình ướt sũng rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SPOOKED"
msgid "Hey, that's not nice!"
msgstr "Này, làm vậy không đẹp chút nào đâu!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.1"
msgid "Hi plants! How do you do today?"
msgstr "Chào các thực vật nhé! Hôm nay các bạn thế nào rồi?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.2"
msgid "Aww, are you lonely? We'll keep you company!"
msgstr "Ò ó o, các bạn có cô đơn không? Tụi mình sẽ làm bạn với các bạn!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.3"
msgid "One day you're going to grow up big and strong... and then we'll eat you!"
msgstr "Rồi có ngày bạn sẽ lớn phổng và khỏe mạnh... rồi tụi mình sẽ ăn thịt bạn!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.4
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.4"
msgid "You are a very good plant."
msgstr "Bạn là một thực vật rất tốt."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "We're always here when you need somebody to talk to!"
msgstr "Tụi mình luôn ở đây khi bạn cần ai đó để trò chuyện!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THORNS"
msgid "Yowch!"
msgstr "Ái chà!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THURIBLE_OUT"
msgid "Aw, there goes our lure."
msgstr "Ối, mồi nhử của tụi mình đi đời nhà ma rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_ABANDONED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_ABANDONED"
msgid "We felt like using him was a bit like cheating anyway."
msgstr "Dù sao thì tụi mình cảm thấy dùng nó cũng hơi giống gian lận vậy."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_DEAD"
msgid "Oh no... where are we supposed to go now?"
msgstr "Ôi không... giờ tụi mình phải đi đâu đây?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_GET_LEADER_ATTENTION
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_GET_LEADER_ATTENTION"
msgid "They want to get back to finding the kitcoons."
msgstr "Họ muốn quay lại việc tìm kiếm mấy con chồn lông."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_LOST_KITCOON
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_LOST_KITCOON"
msgid "Either someone else found them, or this one is a lot tinier."
msgstr "Hoặc là ai đó đã tìm thấy chúng, hoặc con này nhỏ hơn rất nhiều."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_NEAR_KITCOON
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_NEAR_KITCOON"
msgid "We must be getting close!"
msgstr "Chắc là tụi mình đang đến gần rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_NOTHING_TO_TRACK"
msgid "Doesn't look like he found any clues here."
msgstr "Có vẻ như nó chẳng tìm thấy manh mối nào ở đây cả."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_START_TRACKING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_START_TRACKING"
msgid "Wow! He's leading us right to the kitcoons! ...Is that cheating?"
msgstr "Chà! Nó đang dẫn đường cho tụi mình tới chỗ mấy con chồn lông thẳng tiến luôn kìa! ...Thế này có tính là gian lận không nhỉ?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_WAITING_FOR_LEADER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_WAITING_FOR_LEADER"
msgid "We should stay close to him."
msgstr "Chúng ta nên đi sát theo nó."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPED"
msgid "Aww, the frog left!"
msgstr "Ái chà, con ếch đi mất tiêu rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPING"
msgid "It's looking around for a way out."
msgstr "Nó đang đảo mắt tìm đường thoát thân kìa."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOOL_SLIP"
msgid "Hey! We were using that!"
msgstr "Này! Tụi mình đang dùng cái đó mà!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOOL_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOOL_TOOWEAK"
msgid "We don't think this tool's strong enough!"
msgstr "Tụi mình không nghĩ công cụ này đủ mạnh đâu!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TORCH_OUT"
msgid "Waah, our light went out!"
msgstr "Ái chà, đèn của tụi mình tắt ngúm rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "We're here!"
msgstr "Tụi mình tới nơi rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TRAP_WENT_OFF"
msgid "Eek!"
msgstr "Ái!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_UNIMPLEMENTED"
msgid "Gah! It needs more time."
msgstr "Ái chà! Nó cần thêm thời gian."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_VAULT_SHADOW_ASSIST
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_VAULT_SHADOW_ASSIST"
msgid "Aw, they're helping us!"
msgstr "Ồ, chúng đang giúp chúng ta kìa!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_VAULT_TELEPORTER_DOES_NOTHING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_VAULT_TELEPORTER_DOES_NOTHING"
msgid "Hey, we're still here!"
msgstr "Này, tụi mình vẫn ở đây mà!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WASHED_ASHORE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WASHED_ASHORE"
msgid "Our fur is soaking wet!"
msgstr "Bộ lông của tụi mình ướt sũng nước rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEAK_RAT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEAK_RAT"
msgid "We don't think it can race anymore..."
msgstr "Tụi mình nghĩ nó không thể đua được nữa đâu..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEAPON_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEAPON_TOOWEAK"
msgid "We need something stronger!"
msgstr "Tụi mình cần thứ gì đó mạnh hơn!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEIGHT"
msgid "Weight: {weight}"
msgstr "Cân nặng: {weight}"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEIGHT_HEAVY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEIGHT_HEAVY"
msgid "Weight: {weight}\nWoah, that's heavy!"
msgstr "Cân nặng: {weight}\nUầy, nặng thế nhỉ!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WENDY_BABYSITTER_SET
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WENDY_BABYSITTER_SET"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WENDY_BABYSITTER_STOP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WENDY_BABYSITTER_STOP"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WET"
msgid "We're unpleasantly moist."
msgstr "Tụi mình ẩm ướt khó chịu quá đi mất."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WETTER"
msgid "Wet as a bathtub we can't crawl out of."
msgstr "Ướt như một cái bồn tắm mà tụi mình không tài nào bò ra được."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINCH_CLAW_MISS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINCH_CLAW_MISS"
msgid "Oops! We missed it."
msgstr "Ôi! Tụi mình trượt mất rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINCH_CLAW_NO_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINCH_CLAW_NO_ITEM"
msgid "Aww... nothing."
msgstr "Hic... chẳng có gì cả."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINTERS_FEAST_BUFF
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINTERS_FEAST_BUFF"
msgid "Hey! Everything's all sparkly!"
msgstr "Này! Mọi thứ lấp lánh hết cả lên kìa!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINTERS_FEAST_BUFF_OVER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINTERS_FEAST_BUFF_OVER"
msgid "Aww, we were having fun!"
msgstr "Hic, tụi mình đang chơi vui mà!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_BEGIN_COACHING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_BEGIN_COACHING"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_END_COACHING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_END_COACHING"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_MIGHTY_COACHING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_MIGHTY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_NOTEAM.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_NOTEAM.1"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_NOTEAM.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_NOTEAM.2"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_NOTEAM.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_NOTEAM.3"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_WIMPY_COACHING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_WIMPY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMHOLE"
msgid "That was a scary hole!"
msgstr "Đó là một cái hố đáng sợ!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMS"
msgid "Ohhh nooo. We're not friends with worms!"
msgstr "Ôi không. Tụi mình không làm bạn với giun đất đâu!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMS_BOSS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMS_BOSS"
msgid "Yikes! Here comes a BIG worm!"
msgstr "Ái chà! Con giun TO đang bò tới kìa!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT"
msgid "Weeeee! Huh?"
msgstr "Uiiii! Hả?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WX_SCANNER_NEW_FOUND
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WX_SCANNER_NEW_FOUND"
msgid "only_used_by_wx78"
msgstr "chỉ_được_sử_dụng_bởi_wx78"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_YOTB_LEARN_NEW_PATTERN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_YOTB_LEARN_NEW_PATTERN"
msgid "We can't wait for our beefalo to try it on!"
msgstr "Tụi mình nóng lòng muốn con bò lai mặc thử nó rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_YOTD_NOBOATS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_YOTD_NOBOATS"
msgid "We're not close enough to the starting point!"
msgstr "Chúng ta chưa đứng đủ gần điểm xuất phát!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_YOTD_NOCHECKPOINTS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_YOTD_NOCHECKPOINTS"
msgid "Oops! We forgot to set up the checkpoints!"
msgstr "Ôi! Tụi mình quên dựng các trạm kiểm soát mất tiêu rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_YOTD_NOTENOUGHBOATS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_YOTD_NOTENOUGHBOATS"
msgid "We should make some room, in case somebody wants to join in!"
msgstr "Chúng ta nên chừa chút chỗ trống, nhỡ có ai muốn tham gia cùng thì sao!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_YOTH_ONCOOLDOWN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_YOTH_ONCOOLDOWN"
msgid "Aw, those horses must be doing chores right now."
msgstr "Chà, chắc mấy con ngựa đó đang phải làm việc vặt lúc này rồi."

#. STRINGS.CHARACTERS.WEBBER.ANOUNCE_MUTATED_BIRD_ATTACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANOUNCE_MUTATED_BIRD_ATTACK"
msgid "Watch out for the birds!"
msgstr "Cẩn thận mấy con chim đấy!"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.DEER"
msgid "Hopefully we're venomous!"
msgstr "Hy vọng là chúng ta có độc!"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.GENERIC"
msgid "En garde!"
msgstr "Đỡ đòn đây!"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.PIG"
msgid "We hate it! Horrible pig!"
msgstr "Tụi mình ghét nó! Con heo gớm ghiếc!"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.PREY"
msgid "We will put you in our web!"
msgstr "Tụi mình sẽ nhốt bạn vào mạng nhện!"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.SPIDER"
msgid "Hey, wanna play?"
msgstr "Này, muốn chơi không?"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.SPIDER_WARRIOR"
msgid "Why can't we just get along?!"
msgstr "Sao chúng ta lại không thể hòa hợp với nhau cơ chứ?!"

#. STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.GENERIC"
msgid "Well, we would have won!"
msgstr "Thôi nào, thế nào tụi mình cũng thắng thôi!"

#. STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.PIG"
msgid "Another day, pig."
msgstr "Hẹn mày dịp khác nhé, heo ạ."

#. STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.PREY"
msgid "Speedy thing!"
msgstr "Đồ chạy nhanh!"

#. STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.SPIDER"
msgid "We didn't actually want to hurt you."
msgstr "Thực ra tụi mình không muốn làm bạn bị thương đâu."

#. STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "Simmer down, friend."
msgstr "Bình tĩnh nào, bạn hiền."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL.LEVEL1.1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL.LEVEL1.1"
msgid "We're a bit old for playing peek-a-boo."
msgstr "Tụi mình hơi già để chơi trò ú oà rồi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL.LEVEL1.2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL.LEVEL1.2"
msgid "We're a bit old for playing peek-a-boo."
msgstr "Tụi mình hơi già để chơi trò ú oà rồi."

