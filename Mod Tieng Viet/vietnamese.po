msgstr "Không! Nhện không thích ẩm ướt!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION"
