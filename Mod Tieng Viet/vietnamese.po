msgstr "Bạn không thể đánh bại các tác phẩm kinh điển!"

#. STRINGS.SKIN_DESCRIPTIONS.hermitcrab_peacock
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hermitcrab_peacock"
msgid "Pearl is going to teach you young'uns a thing or two about fashion."
msgstr "Ngọc trai chuẩn bị dạy cho tụi trẻ các người vài điều về thời trang đây."

#. STRINGS.SKIN_DESCRIPTIONS.hermitcrab_pointy
