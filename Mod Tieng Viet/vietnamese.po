msgstr "Wolfgang phải cẩn thận đừng dẫm vào."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRAP_TEETH
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRAP_TEETH"
