msgstr "Tôi cảm thấy có phép thuật nào đó đang diễn ra!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
