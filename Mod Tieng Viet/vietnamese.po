msgstr "Chết còn hơn cả đinh cửa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GENERIC_CORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GENERIC_CORPSE.REVIVING"
msgid "Why can't it stay dead?"
msgstr "Tại sao nó không thể chết mãi được?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GESTALT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GESTALT"
msgid "I feel like... they've seen my sister."
msgstr "Tôi có cảm giác như... họ đã nhìn thấy em gái tôi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GESTALT_CAGE.FILLED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GESTALT_CAGE.FILLED"
