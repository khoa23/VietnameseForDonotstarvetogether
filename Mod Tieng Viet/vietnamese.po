msgstr "chỉ_được_sử_dụng_bởi_wolfang"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_COACH.8
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_COACH.8"
msgid "only_used_by_wolfang"
msgstr "chỉ_được_sử_dụng_bởi_wolfang"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_COACH.9
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_COACH.9"
msgid "only_used_by_wolfang"
msgstr "chỉ_được_sử_dụng_bởi_wolfang"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_COLD"
msgid "Brr! Cold as frozen steel out here!"
msgstr "Brr! Ngoài này lạnh như thép đông cứng vậy!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_COMPASS_OUT"
msgid "Shoddy handmade junk!"
msgstr "Đồ dởm tự chế tồi tệ!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_COZY_SLEEP
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_COZY_SLEEP"
msgid "I feel all bright-eyed and bushy-tailed!"
msgstr "Tôi thấy tỉnh táo và tràn đầy sức sống hẳn lên!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_CRAFTING_FAIL"
msgid "How did I junk that up?!"
msgstr "Sao tôi lại làm hỏng việc đó được nhỉ?!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_DAMP"
msgid "A light mist never hurt nobody."
msgstr "Mưa lất phất thì có hại ai đâu."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_DEERCLOPS"
msgid "Democrew incoming!"
msgstr "Biệt đội quái vật tới kìa!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_DESPAWN"
msgid "Good thing I got all my affairs in order."
msgstr "May là tôi đã sắp xếp ổn thỏa mọi chuyện rồi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_ATTACK"
msgid "Y'know, fightin' ain't always the answer."
msgstr "Biết sao được, đánh nhau không phải lúc nào cũng giải quyết được vấn đề."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK"
msgid "I'm all outta juice!"
msgstr "Tôi hết pin rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY"
msgid "I think I might be needin' an umbrella soon."
msgstr "Chắc tôi sắp cần một cái Dù rồi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION"
msgid "I'd better take a step back."
msgstr "Tôi nên lùi lại một bước thôi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE"
msgid "I'm beat!"
msgstr "Tôi đuối lắm rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS"
msgid "I'm off the clock!"
msgstr "Tôi hết giờ làm việc rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_DIG_DISEASE_WARNING"
msgid "That helped a bit."
msgstr "Thế này đỡ hơn chút rồi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_DUSK"
msgid "There's the quittin' bell."
msgstr "Chuông tan ca kìa."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.GENERIC"
msgid "That hits the spot."
msgstr "Đúng là tuyệt cú mèo."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.INVALID
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.INVALID"
msgid "Pretty sure that's not food."
msgstr "Chắc chắn đây không phải đồ ăn rồi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.PAINFUL
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.PAINFUL"
msgid "Yeow! That one bit back!"
msgstr "Ái! Cái đó cắn lại kìa!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.SPOILED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.SPOILED"
msgid "I am full of regret."
msgstr "Tôi ngập tràn sự hối hận."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.STALE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.STALE"
msgid "I've had worse."
msgstr "Tôi ăn tệ hơn thế này rồi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_EAT.YUCKY"
msgid "Blech! Even I got limits!"
msgstr "Blẻh! Đến tôi cũng có giới hạn nhé!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_EATING_NOT_FEASTING
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_EATING_NOT_FEASTING"
msgid "I ain't gonna hog this all to myself!"
msgstr "Tôi không nuốt trọn một mình đâu!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ELIXIR_BOOSTED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ELIXIR_BOOSTED"
msgid "That's pretty good."
msgstr "Cái này khá phết."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ELIXIR_GHOSTVISION
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ELIXIR_GHOSTVISION"
msgid "Sis? I can't see you here."
msgstr "Chị ơi? Em chẳng thấy chị ở đây đâu cả."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ELIXIR_PLAYER_SPEED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ELIXIR_PLAYER_SPEED"
msgid "I feel like a steam engine!"
msgstr "Tôi thấy mình như một cỗ máy hơi nước vậy!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ELIXIR_TOO_SUPER
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ELIXIR_TOO_SUPER"
msgid "Yikes, that's way too strong."
msgstr "Úi chà, mạnh quá mức rồi đấy."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.1"
msgid "Hhff!"
msgstr "Hư hừ!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.2"
msgid "Easy as pie! Hff!"
msgstr "Dễ như ăn bánh! Hừ!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.3"
msgid "Like eggs in coffee!"
msgstr "Dễ như pha cà phê với trứng!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.4"
msgid "Hhngh!"
msgstr "Hự hừ!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.5"
msgid "I... *huff* I got it!"
msgstr "Tôi... *hộc* Tôi bê được mà!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.6"
msgid "Ha! I'm plenty rugged! *huff*"
msgstr "Hà! Tôi khỏe chán! *hộc*"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.7"
msgid "Ooff..."
msgstr "Ối..."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.8
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.8"
msgid "This... ain't... nothin'!"
msgstr "Cái này... thấm... vào đâu!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.9
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.9"
msgid "Where's worker's comp when you need it?"
msgstr "Lúc cần tiền bảo hiểm tai nạn lao động thì chẳng thấy đâu."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE"
msgid "Whoa, this one is more advanced than my version."
msgstr "Ồ, cái này tiên tiến hơn phiên bản của tôi đấy."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE"
msgid "Interestin'. This version and mine are ahead in different ways."
msgstr "Thú vị thật. Phiên bản này và bản của tôi vượt trội ở những điểm khác nhau."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENGINEERING_CAN_UPGRADE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENGINEERING_CAN_UPGRADE"
msgid "Easy peasy, my version is miles ahead."
msgstr "Dễ ợt, phiên bản của tôi vượt trội hơn hẳn."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENTER_DARK"
msgid "I can't see!"
msgstr "Tôi không nhìn thấy gì cả!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENTER_LIGHT"
msgid "Whew! I can see!"
msgstr "Phù! Tôi thấy đường rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_EXIT_GELBLOB
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_EXIT_GELBLOB"
msgid "Let's not speak of this again."
msgstr "Đừng bao giờ nhắc lại chuyện này nữa."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_EYEOFTERROR_ARRIVE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_EYEOFTERROR_ARRIVE"
msgid "Uhh... maybe it's a friendly giant eyeball?"
msgstr "Ừm... chắc đây là một con nhãn cầu khổng lồ thân thiện nhỉ?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_EYEOFTERROR_FLYAWAY
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_EYEOFTERROR_FLYAWAY"
msgid "Agh, I guess we'll finish it off another night."
msgstr "Hừ, chắc tối khác chúng ta mới xử lý nó được."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_EYEOFTERROR_FLYBACK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_EYEOFTERROR_FLYBACK"
msgid "Back for more?"
msgstr "Lại tìm thêm à?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_FAN_OUT"
msgid "Useless handmade junk!"
msgstr "Đồ dởm tự chế vô tích sự!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_FERTILIZER_RESEARCHED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_FERTILIZER_RESEARCHED"
msgid "I always say it's best to know what you're workin' with."
msgstr "Tôi luôn nói là tốt nhất nên biết mình đang làm việc với thứ gì."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_FIRENETTLE_TOXIN.1
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_FIRENETTLE_TOXIN.1"
msgid "Yeesh, I feel hotter than a furnace!"
msgstr "Trời ạ, tôi thấy nóng như cái lò luyện kim vậy!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_FIRENETTLE_TOXIN.2
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_FIRENETTLE_TOXIN.2"
msgid "Ugh, I'm burnin' up..."
msgstr "Hừ, tôi sắp bốc cháy rồi..."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_FIRENETTLE_TOXIN_DONE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_FIRENETTLE_TOXIN_DONE"
msgid "Whew, I'm not keen to try that again."
msgstr "Phù, tôi không dám thử lại lần nữa đâu."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_FLARE_SEEN"
msgid "A flare! Hold on, I'm comin'!"
msgstr "Pháo Sáng kìa! Chờ đã, tôi tới đây!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_FLOATER_HELD
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_FLOATER_HELD"
msgid "Thank goodness for this!"
msgstr "Tạ ơn trời vì có cái này!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_FLOATER_LETGO
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_FLOATER_LETGO"
msgid "Like a bag of rocks!"
msgstr "Nặng như một cục đá vậy!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_FLOAT_SWIM_TIRED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_FLOAT_SWIM_TIRED"
msgid "I need a breather."
msgstr "Tôi cần nghỉ xả hơi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_FOODMEMORY
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_FOODMEMORY"
msgid "only_used_by_warly"
msgstr "chỉ_được_sử_dụng_bởi_warly"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_FREEDOM"
msgid "Ha! Outsmarted!"
msgstr "Hà! Thoát rồi nhé!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_GATHER_MERM
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_GATHER_MERM"
msgid "only_used_by_wurt"
msgstr "chỉ_được_sử_dụng_bởi_wurt"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_GHOSTDRAIN"
msgid "My head's all fuzzy..."
msgstr "Đầu óc tôi mụ mị cả đi..."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_GHOST_QUEST
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_GHOST_QUEST"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_GOT_DECON_MISTED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_GOT_DECON_MISTED"
msgid "Huh. It actually chased away the shadows."
msgstr "Hả. Nó xua được đám bóng tối đi thật kìa."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE"
msgid "Uh oh, better slap on some more Acid Repellent."
msgstr "Ồ không, chắc phải bôi thêm Cao Chống Axit thôi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE"
msgid "I think the Thermal Balm is wearin' off."
msgstr "Hình như Cao nhiệt sắp hết tác dụng rồi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE"
msgid "Now that's a shortcut."
msgstr "Đúng là một lối đi tắt tuyệt vời."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT"
msgid "Hm. It ain't workin'."
msgstr "Hừ. Không hoạt động được."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HIGHRESEARCH"
msgid "Cutting edge!"
msgstr "Cực kỳ tiên tiến!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HOT"
msgid "It's hotter than a tin smelter in July!"
msgstr "Trời nóng hơn cả lò luyện thiếc vào tháng Bảy!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HOUNDS"
msgid "Are those dogs I hear?"
msgstr "Có phải tôi đang nghe tiếng chó sủa không nhỉ?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY"
msgid "When's lunch?"
msgstr "Mấy giờ ăn trưa vậy?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_FASTBUILD.1
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_FASTBUILD.1"
msgid "This's hungry work."
msgstr "Làm cái này tốn sức quá."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_FASTBUILD.2
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_FASTBUILD.2"
msgid "I'm working up an appetite."
msgstr "Tôi bắt đầu thấy thèm ăn rồi đấy."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_FASTBUILD.3
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_FASTBUILD.3"
msgid "That made me a lil hungry."
msgstr "Việc đó làm tôi thấy hơi đói rồi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_FASTBUILD.4
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_FASTBUILD.4"
msgid "I'll need some brainfood at this rate."
msgstr "Đà này chắc tôi phải nạp thêm đồ bổ não thôi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_SLOWBUILD.1
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_SLOWBUILD.1"
msgid "My head's all clouded by hunger!"
msgstr "Đói quá làm đầu óc tôi tối sầm lại rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_SLOWBUILD.2
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_SLOWBUILD.2"
msgid "Oof. I got the brainfog."
msgstr "Uầy. Tôi bị đói hoa mắt rồi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_SLOWBUILD.3
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_SLOWBUILD.3"
msgid "Maybe I could take a snack break?"
msgstr "Chắc tôi nghỉ ăn vặt chút được chứ nhỉ?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_SLOWBUILD.4
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_SLOWBUILD.4"
msgid "I could sure go for some grub."
msgstr "Chắc tôi có thể đi kiếm chút Con Sâu lót dạ."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_AVOID_FORK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_AVOID_FORK"
msgid "This trail looks like a cake walk."
msgstr "Đường đi này dễ như ăn bánh."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "I didn't order lunch to go. Get'em!"
msgstr "Tôi đâu có gọi đồ ăn mang đi đâu. Tóm lấy tụi nó!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "Gah! I lost it."
msgstr "Gah! Mất dấu rồi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "Err, are those my footprints? Shoot!"
msgstr "Ơ, đây là dấu chân của tôi à? Chết tiệt!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_START_FORK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_START_FORK"
msgid "This trail looks like a doozy."
msgstr "Dấu vết này có vẻ khoai đây."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_SUCCESSFUL_FORK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_SUCCESSFUL_FORK"
