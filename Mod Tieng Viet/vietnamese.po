msgid "It's barely warm."
msgstr "Nó hầu như không ấm áp."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FUMAROLEHAMMER.WARM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FUMAROLEHAMMER.WARM"
msgid "It makes the work nice and cozy."
msgstr "Nó làm cho công việc trở nên tốt đẹp và ấm cúng."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FUMAROLEPICKAXE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FUMAROLEPICKAXE.GENERIC"
msgid "Its time is nearly up."
msgstr "Thời gian của nó đã gần hết."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FUMAROLEPICKAXE.HOT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FUMAROLEPICKAXE.HOT"
msgid "Incredibly hot, but wonderfully efficient!"
msgstr "Vô cùng nóng bỏng nhưng hiệu quả tuyệt vời!"

