msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CASTAOE.NOT_ENOUGH_EMBERS"
msgid "only_used_by_willow"
msgstr "chỉ_được_sử_dụng_bởi_willow"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CASTAOE.NO_BATTERY
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CASTAOE.NO_BATTERY"
msgid "only_used_by_winona"
msgstr "chỉ_dùng_bởi_winona"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CASTAOE.NO_CATAPULTS
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CASTAOE.NO_CATAPULTS"
msgid "only_used_by_winona"
msgstr "chỉ_dùng_bởi_winona"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CASTAOE.NO_TARGETS
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CASTAOE.NO_TARGETS"
msgid "only_used_by_willow"
msgstr "chỉ_được_sử_dụng_bởi_willow"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CASTAOE.SPELL_ON_COOLDOWN
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CASTAOE.SPELL_ON_COOLDOWN"
msgid "only_used_by_willow"
msgstr "chỉ_được_sử_dụng_bởi_willow"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CASTSPELL.TERRAFORM_TOO_SOON
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CASTSPELL.TERRAFORM_TOO_SOON"
msgid "only_used_by_wurt"
msgstr "chỉ_được_dùng_bởi_wurt"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CHANGEIN.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CHANGEIN.BURNING"
msgid "Better it than a tree."
msgstr "Nó tốt hơn một cái cây."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CHANGEIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CHANGEIN.GENERIC"
msgid "Ouch. Do I not look skookum enough already?"
msgstr "Ối. Trông tôi vẫn chưa đủ skookum à?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CHANGEIN.INUSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CHANGEIN.INUSE"
msgid "Could you hand me my plaid shirt while you're in there?"
msgstr "Bạn có thể đưa cho tôi chiếc áo sơ mi kẻ sọc của tôi khi bạn ở trong đó được không?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CHANGEIN.NOOCCUPANT
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CHANGEIN.NOOCCUPANT"
msgid "See any beefalo to hitch up around here, Lucy?"
msgstr "Có thấy con bò nào ở quanh đây không, Lucy?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CHANGEIN.NOTENOUGHHAIR
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CHANGEIN.NOTENOUGHHAIR"
msgid "Gotta wait for the hair to grow back in."
msgstr "Phải chờ tóc mọc lại."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL"
msgid "Ready to go!"
msgstr "Sẵn sàng để đi!"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE"
msgid "There's not enough charge."
msgstr "Không có đủ phí."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.COMPARE_WEIGHABLE.FISH_TOO_SMALL
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.COMPARE_WEIGHABLE.FISH_TOO_SMALL"
msgid "Should've thrown this little guy back."
msgstr "Đáng lẽ phải ném anh chàng nhỏ bé này trở lại."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.COMPARE_WEIGHABLE.OVERSIZEDVEGGIES_TOO_SMALL
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.COMPARE_WEIGHABLE.OVERSIZEDVEGGIES_TOO_SMALL"
msgid "This one's not gonna cut it, eh?"
msgstr "Cái này sẽ không cắt được đâu, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CONSTRUCT.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CONSTRUCT.EMPTY"
msgid "I need to put something there."
msgstr "Tôi cần phải đặt một cái gì đó ở đó."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CONSTRUCT.INUSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CONSTRUCT.INUSE"
msgid "Oops, sorry. Someone's using it already."
msgstr "Ối xin lỗi. Đã có người sử dụng nó rồi."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CONSTRUCT.MISMATCH
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CONSTRUCT.MISMATCH"
msgid "Sorry. Wrong plans."
msgstr "Lấy làm tiếc. Kế hoạch sai lầm."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CONSTRUCT.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CONSTRUCT.NOTALLOWED"
msgid "Well, it doesn't go there."
msgstr "Vâng, nó không đi đến đó."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CONSTRUCT.NOTREADY
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CONSTRUCT.NOTREADY"
msgid "I'll try again when things have calmed down around here."
msgstr "Tôi sẽ thử lại khi mọi thứ ở đây đã lắng xuống."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.COOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.COOK.GENERIC"
msgid "That's not really in my wheelhouse, sorry."
msgstr "Xin lỗi, thứ đó thực sự không có trong buồng lái của tôi."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.COOK.INUSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.COOK.INUSE"
msgid "Careful now, don't burn it."
msgstr "Bây giờ hãy cẩn thận, đừng đốt nó."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.COOK.TOOFAR
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.COOK.TOOFAR"
msgid "I gotta get closer, eh?"
msgstr "Tôi phải đến gần hơn, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.DECORATESNOWMAN.HASHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.DECORATESNOWMAN.HASHAT"
msgid "I can't just throw it on top of that hat."
msgstr "Tôi không thể ném nó lên trên chiếc mũ đó được."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.DECORATESNOWMAN.INUSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.DECORATESNOWMAN.INUSE"
msgid "It's being decorated."
msgstr "Nó đang được trang trí."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.DECORATESNOWMAN.MELTING
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.DECORATESNOWMAN.MELTING"
msgid "Looks like it's melting."
msgstr "Hình như nó đang tan chảy."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.DECORATESNOWMAN.STACKEDTOOHIGH
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.DECORATESNOWMAN.STACKEDTOOHIGH"
msgid "It's too tall."
msgstr "Nó quá cao."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.DEPLOY.HERMITCRAB_RELOCATE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.DEPLOY.HERMITCRAB_RELOCATE"
msgid "Empty, eh? I'll try again later."
msgstr "Trống rỗng phải không? Tôi sẽ thử lại sau."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.DISMANTLE.COOKING
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.DISMANTLE.COOKING"
msgid "Better to wait till the food's done, eh?"
msgstr "Tốt nhất là đợi cho đến khi đồ ăn xong, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.DISMANTLE.INUSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.DISMANTLE.INUSE"
msgid "Sorry! I'll wait till you're finished there."
msgstr "Lấy làm tiếc! Tôi sẽ đợi cho đến khi bạn xong việc ở đó."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.DISMANTLE.NOTEMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.DISMANTLE.NOTEMPTY"
msgid "I'd better make sure it's empty first."
msgstr "Tốt hơn là tôi nên đảm bảo nó trống trước đã."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.DIVEGRAB.MISSED
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.DIVEGRAB.MISSED"
msgid "Missed it!"
msgstr "Bỏ lỡ nó!"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.DRAW.NOIMAGE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.DRAW.NOIMAGE"
msgid "I won't get it right unless I have the item in front of me."
msgstr "Tôi sẽ không làm đúng trừ khi tôi có món đồ đó trước mặt."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.FILL_OCEAN.UNSUITABLE_FOR_PLANTS
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.FILL_OCEAN.UNSUITABLE_FOR_PLANTS"
msgid "Sea water isn't usually good for gardens."
msgstr "Nước biển thường không tốt cho vườn."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.FISH_OCEAN.TOODEEP
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.FISH_OCEAN.TOODEEP"
msgid "This little rod won't do me much good."
msgstr "Cây gậy nhỏ này sẽ không giúp ích gì nhiều cho tôi đâu."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GENERIC.ITEMMIMIC
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GENERIC.ITEMMIMIC"
msgid "Don't say it, Lucy!"
msgstr "Đừng nói gì, Lucy!"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.ABIGAILHEART
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.ABIGAILHEART"
msgid "I'd never hear the end of it from 'Luce if I didn't try."
msgstr "Tôi sẽ không bao giờ nghe được kết thúc của câu chuyện từ 'Luce nếu tôi không thử."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.BUSY
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.BUSY"
msgid "I'll try again in a mo'."
msgstr "Tôi sẽ thử lại sau một lát'."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.CANTSHADOWREVIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.CANTSHADOWREVIVE"
msgid "Didn't work. Probably for the best."
msgstr "Không hoạt động. Có lẽ là tốt nhất."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.CARNIVALGAME_ALREADY_PLAYING
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.CARNIVALGAME_ALREADY_PLAYING"
msgid "It's not polite to cut in line."
msgstr "Thật không lịch sự khi chen ngang khi xếp hàng."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.CARNIVALGAME_GOLFGAME_NOTREADY
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.CARNIVALGAME_GOLFGAME_NOTREADY"
msgid "It needs a flaghole still."
msgstr "Nó vẫn cần một lỗ cờ."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.CARNIVALGAME_INVALID_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.CARNIVALGAME_INVALID_ITEM"
msgid "Had to give it a shot, eh?"
msgstr "Phải thử một lần nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.DEAD"
msgid "I don't think they... um..."
msgstr "Tôi không nghĩ họ... ừm..."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.DUPLICATE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.DUPLICATE"
msgid "No sense having two of the same recipe."
msgstr "Không có ý nghĩa gì khi có hai công thức giống nhau."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.FOODFULL
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.FOODFULL"
msgid "There's already something there."
msgstr "Đã có cái gì đó ở đó rồi."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.GENERIC"
msgid "Nah, that ain't right."
msgstr "Không, điều đó không đúng."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.GHOSTHEART
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.GHOSTHEART"
msgid "Not today."
msgstr "Không phải hôm nay."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG"
msgid "That needs a magic log, eh?"
msgstr "Điều đó cần một bản ghi ma thuật, phải không?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM"
msgid "That needs a mushroom spore, eh?"
msgstr "Cái đó cần bào tử nấm phải không?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.MUSHROOMFARM_NOMOONALLOWED
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.MUSHROOMFARM_NOMOONALLOWED"
msgid "I don't think they're suited to this environment."
msgstr "Tôi không nghĩ họ phù hợp với môi trường này."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.NOGENERATORSKILL
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.NOGENERATORSKILL"
msgid "I don't think that one'll work here."
msgstr "Tôi không nghĩ người đó sẽ làm việc ở đây."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.NOMOON
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.NOMOON"
msgid "Looks like it doesn't work in the caves, eh."
msgstr "Có vẻ như nó không có tác dụng trong hang động nhỉ."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.NOTAMONKEY
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.NOTAMONKEY"
msgid "Slow down there bud, I can't understand a word you're sayin'."
msgstr "Chậm lại đi bạn ơi, tôi không hiểu bạn đang nói gì cả."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.NOTDISH
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.NOTDISH"
msgid "That doesn't seem smart."
msgstr "Điều đó có vẻ không thông minh."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.NOTGEM
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.NOTGEM"
msgid "That doesn't look like a magic rock to me."
msgstr "Đối với tôi, nó không giống một hòn đá ma thuật."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.NOTSCULPTABLE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.NOTSCULPTABLE"
msgid "I'd prefer wood, personally."
msgstr "Cá nhân tôi thích gỗ hơn."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.NOTSTAFF
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.NOTSTAFF"
msgid "Nah. Something long and thin goes there, but not this."
msgstr "Không. Có thứ gì đó dài và mỏng ở đó, nhưng không phải cái này."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER"
msgid "I'll wait until the danger's passed."
msgstr "Tôi sẽ đợi cho đến khi nguy hiểm qua đi."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.PIGKINGGAME_MESSY
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.PIGKINGGAME_MESSY"
msgid "Could use a cleaning first."
msgstr "Có thể sử dụng chất tẩy rửa trước."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.PIGKINGGAME_TOOLATE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.PIGKINGGAME_TOOLATE"
msgid "Can't do that now. It'll be dark soon."
