msgstr "Mỗi lá cơ bị bỏ +15 chip\nMỗi lá cơ trên tay -11 chip +1 nhân điểm"

#. STRINGS.BALATRO.JOKER_WURT
msgctxt "STRINGS.BALATRO.JOKER_WURT"
