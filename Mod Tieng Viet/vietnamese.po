#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_POST
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_POST"
msgid "A stake to display my prized steak, non?"
msgstr "Một cổ phần để trưng bày món bít tết quý giá của tôi, phải không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_POST_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_POST_ITEM"
msgid "This looks like a good spot, non?"
msgstr "Đây có vẻ là một nơi tốt, phải không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_SEWINGMACHINE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_SEWINGMACHINE"
msgid "Now to find the recipe for a tasteful outfit."
msgstr "Bây giờ hãy tìm công thức cho một bộ trang phục trang nhã."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_SEWINGMACHINE_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_SEWINGMACHINE_ITEM"
msgid "I'd better put it together."
msgstr "Tốt hơn là tôi nên đặt nó lại với nhau."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_STAGE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_STAGE"
msgid "Ah mes amis, I've been judged by top chefs - this is nothing!"
msgstr "Ôi trời, tôi đã được các đầu bếp hàng đầu đánh giá - chuyện này chẳng là gì cả!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_STAGE_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_STAGE_ITEM"
msgid "I should be able to put that together."
msgstr "Tôi có thể kết hợp điều đó lại với nhau."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRATSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRATSHRINE.BURNT"
msgid "Did I leave the oven on?"
msgstr "Tôi đã để lò nướng bật à?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRATSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRATSHRINE.EMPTY"
msgid "Are you hungry?"
msgstr "Bạn có đói không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRATSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRATSHRINE.GENERIC"
msgid "How do you do?"
msgstr "Xin chào?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT"
msgid "It's been burnt to a crisp."
msgstr "Nó đã bị cháy giòn rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC"
msgid "I hope the poor thing doesn't get too dizzy."
msgstr "Tôi hy vọng điều tội nghiệp đó không quá chóng mặt."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT"
msgid "Train hard, mon ami!"
msgstr "Hãy luyện tập chăm chỉ nhé, anh bạn!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM"
msgid "I should find a good place to put this."
msgstr "Tôi nên tìm một nơi tốt để đặt cái này."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT"
msgid "It's been burnt to a crisp."
msgstr "Nó đã bị cháy giòn rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC"
msgid "I also find food quite motivating."
msgstr "Tôi cũng thấy đồ ăn khá có động lực."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT"
msgid "Practice makes perfect!"
msgstr "Tập luyện giúp hoàn hảo hơn!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM"
msgid "I wonder how my carrat will react to this..."
msgstr "Tôi tự hỏi cà rốt của tôi sẽ phản ứng thế nào với điều này..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT"
msgid "It's been burnt to a crisp."
msgstr "Nó đã bị cháy giòn rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC"
