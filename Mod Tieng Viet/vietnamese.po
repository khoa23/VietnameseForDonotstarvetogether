msgstr "Có lửa trong huyết quản của tôi!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_FIRENETTLE_TOXIN_DONE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_FIRENETTLE_TOXIN_DONE"
msgid "Huh. I was kind of getting used to it."
msgstr "Huh. Tôi đã dần quen với nó."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_FLARE_SEEN"
msgid "Woah, cool! Someone shot fire into the sky!"
msgstr "Wow, tuyệt quá! Có người bắn lửa lên trời!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_FLOATER_HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_FLOATER_HELD"
msgid "Something touched my foot."
msgstr "Có cái gì đó chạm vào chân tôi."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_FLOATER_LETGO
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_FLOATER_LETGO"
msgid "I hate waiting!"
msgstr "Tôi ghét chờ đợi!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_FLOAT_SWIM_TIRED
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_FLOAT_SWIM_TIRED"
