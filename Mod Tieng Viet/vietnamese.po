msgstr "Tôi nên lấy một cái gối trước nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.APPLYELIXIR.NO_ELIXIRABLE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.APPLYELIXIR.NO_ELIXIRABLE"
