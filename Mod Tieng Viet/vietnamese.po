msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.hermitcrab_none
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hermitcrab_none"
msgid "You can't beat the classics!"
msgstr "Bạn không thể đánh bại kinh điển!"

#. STRINGS.SKIN_DESCRIPTIONS.hermitcrab_peacock
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hermitcrab_peacock"
msgid "Pearl is going to teach you young'uns a thing or two about fashion."
msgstr "Pearl sẽ dạy các bạn trẻ vài điều về thời trang."

#. STRINGS.SKIN_DESCRIPTIONS.hermitcrab_pointy
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hermitcrab_pointy"
msgid "\"Ohh, my aching spines...\""
msgstr "\"Ôi, đau nhức xương sống của tôi...\""

