msgstr "Hạ! Đố tia lửa nhỏ thoát ra được đấy!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_STATIC_ROAMER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_STATIC_ROAMER"
