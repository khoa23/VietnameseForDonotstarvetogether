msgstr "Hóa ra chìa khóa là chìa khóa để vào."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED"
