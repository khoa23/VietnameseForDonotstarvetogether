msgstr "Không có gì nói \"Mở tôi\" giống như một chiếc khóa!!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT"
