msgstr "Cơn ác mộng này gần như đã kết thúc!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
