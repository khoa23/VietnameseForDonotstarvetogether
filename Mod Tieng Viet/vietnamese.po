#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.RUMMAGE.NOTSOULJARHANDLER
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.RUMMAGE.NOTSOULJARHANDLER"
msgid "How do souls taste? I guess I'll never know."
msgstr "Linh hồn có mùi vị như thế nào? Tôi đoán tôi sẽ không bao giờ biết."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.RUMMAGE.RESTRICTED
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.RUMMAGE.RESTRICTED"
msgid "This is not for me!"
msgstr "Điều này không dành cho tôi!"

