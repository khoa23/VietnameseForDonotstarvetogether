msgstr "Ngọn lửa! Lông của tôi!"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.CARVEPUMPKIN.INUSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.CARVEPUMPKIN.INUSE"
