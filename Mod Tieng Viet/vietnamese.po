msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDEN.BURNT"
msgid "Well, hope they can stay with a friend or something."
msgstr "Chà, hy vọng họ có thể ở cùng một người bạn hay gì đó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDEN.GENERIC"
