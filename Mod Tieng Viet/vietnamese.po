#. STRINGS.SKIN_DESCRIPTIONS.wall_dreadstone_relic
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wall_dreadstone_relic"
msgid "Like a cake, but horrible."
msgstr "Giống như một chiếc bánh ngọt, nhưng thật kinh khủng."

#. STRINGS.SKIN_DESCRIPTIONS.wall_dreadstone_relicitem
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wall_dreadstone_relicitem"
