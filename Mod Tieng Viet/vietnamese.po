msgstr "Đặt một số pep trong bước của tôi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YELLOWGEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YELLOWGEM"
