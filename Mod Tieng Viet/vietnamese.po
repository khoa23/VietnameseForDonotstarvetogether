msgid "\"So alluring...\""
msgstr "\"Thật lôi cuốn...\""

#. STRINGS.SKIN_QUOTES.wendy_magma
msgctxt "STRINGS.SKIN_QUOTES.wendy_magma"
msgid "\"My volcanic smoke shall encase the world in darkness.\""
msgstr "\"Khói núi lửa của tôi sẽ bao quanh thế giới trong bóng tối.\""

#. STRINGS.SKIN_QUOTES.wendy_masquerade
msgctxt "STRINGS.SKIN_QUOTES.wendy_masquerade"
msgid "\"The night is young, but not for long.\""
msgstr "\"Đêm còn dài nhưng không dài đâu.\""

#. STRINGS.SKIN_QUOTES.wendy_nature
msgctxt "STRINGS.SKIN_QUOTES.wendy_nature"
msgid "\"Do you believe in fairies? If you believe, clap your hands.\""
msgstr "\"Bạn có tin vào các nàng tiên không? Nếu bạn tin, hãy vỗ tay.\""

#. STRINGS.SKIN_QUOTES.wendy_pirate
msgctxt "STRINGS.SKIN_QUOTES.wendy_pirate"
msgid "\"Do you ever feel adrift like a vessel without mooring?\""
msgstr "\"Bạn có bao giờ cảm thấy trôi dạt như một con tàu không neo đậu không?\""

#. STRINGS.SKIN_QUOTES.wendy_rose
msgctxt "STRINGS.SKIN_QUOTES.wendy_rose"
msgid "\"A sickly, sweet rose, plucked in its prime. Why?\""
msgstr "\"Một bông hồng ngọt ngào, ốm yếu, bị hái khi còn non. Tại sao vậy?\""

#. STRINGS.SKIN_QUOTES.wendy_rosep
msgctxt "STRINGS.SKIN_QUOTES.wendy_rosep"
msgid "\"A sickly, sweet rose, plucked in its prime. Why?\""
msgstr "\"Một bông hồng ngọt ngào, ốm yếu, bị hái khi còn non. Tại sao vậy?\""

#. STRINGS.SKIN_QUOTES.wendy_shadow
msgctxt "STRINGS.SKIN_QUOTES.wendy_shadow"
msgid "\"Shadows are as black as ink, or night, or nightmares.\""
msgstr "\"Bóng tối có màu đen như mực, hoặc đêm, hoặc những cơn ác mộng.\""

#. STRINGS.SKIN_QUOTES.wendy_shadowp
msgctxt "STRINGS.SKIN_QUOTES.wendy_shadowp"
msgid "\"Shadows are as black as ink, or night, or nightmares.\""
msgstr "\"Bóng tối có màu đen như mực, hoặc đêm, hoặc những cơn ác mộng.\""

#. STRINGS.SKIN_QUOTES.wendy_survivor
msgctxt "STRINGS.SKIN_QUOTES.wendy_survivor"
msgid "\"I carry on for Abigail's sake.\""
msgstr "\"Tôi tiếp tục vì lợi ích của Abigail.\""

#. STRINGS.SKIN_QUOTES.wendy_survivorp
msgctxt "STRINGS.SKIN_QUOTES.wendy_survivorp"
msgid "\"I carry on for Abigail's sake.\""
msgstr "\"Tôi tiếp tục vì lợi ích của Abigail.\""

#. STRINGS.SKIN_QUOTES.wendy_victorian
msgctxt "STRINGS.SKIN_QUOTES.wendy_victorian"
msgid "\"I am in deepest mourning...\""
msgstr "\"Tôi đang trong tình trạng thương tiếc sâu nhất ...\""

#. STRINGS.SKIN_QUOTES.wendy_yule
msgctxt "STRINGS.SKIN_QUOTES.wendy_yule"
msgid "\"I will try to summon up some holiday spirit... if I must.\""
msgstr "\"Tôi sẽ cố gắng khơi dậy tinh thần ngày lễ... nếu phải.\""

#. STRINGS.SKIN_QUOTES.wickerbottom_combatant
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_combatant"
msgid "\"Combat is all about technique, dear.\""
msgstr "\"Chiến đấu là tất cả về kỹ thuật, thân yêu.\""

#. STRINGS.SKIN_QUOTES.wickerbottom_cook
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_cook"
msgid "\"Just follow the recipe, dear.\""
msgstr "\"Chỉ cần làm theo công thức, thân yêu.\""

#. STRINGS.SKIN_QUOTES.wickerbottom_formal
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_formal"
msgid "\"Even I let my hair down occasionally.\""
msgstr "\"Thậm chí tôi thỉnh thoảng để tóc xuống.\""

#. STRINGS.SKIN_QUOTES.wickerbottom_formalp
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_formalp"
msgid "\"Even I let my hair down occasionally.\""
msgstr "\"Thậm chí tôi thỉnh thoảng để tóc xuống.\""

#. STRINGS.SKIN_QUOTES.wickerbottom_gladiator
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_gladiator"
msgid "\"Goodness gracious, it seems you've been annihilated.\""
msgstr "\"Lòng tốt duyên dáng, có vẻ như bạn đã bị tiêu diệt.\""

#. STRINGS.SKIN_QUOTES.wickerbottom_hazard
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_hazard"
msgid "\"Hrrm... mff! Mmmf!\""
msgstr "\"Hrrm... khốn nạn! Mmm!\""

#. STRINGS.SKIN_QUOTES.wickerbottom_ice
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_ice"
msgid "\"Would you like a sweetie, dear?\""
msgstr "\"Bạn có muốn một người yêu, thân yêu?\""

#. STRINGS.SKIN_QUOTES.wickerbottom_lightninggoat
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_lightninggoat"
msgid "\"All it takes is a spark of genius.\""
msgstr "\"Tất cả những gì nó cần là một tia sáng của thiên tài.\""

#. STRINGS.SKIN_QUOTES.wickerbottom_lightninggoat_d
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_lightninggoat_d"
msgid "\"All it takes is a spark of genius.\""
msgstr "\"Tất cả những gì nó cần là một tia sáng của thiên tài.\""

#. STRINGS.SKIN_QUOTES.wickerbottom_lightninggoat_p
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_lightninggoat_p"
msgid "\"All it takes is a spark of genius.\""
msgstr "\"Tất cả những gì nó cần là một tia sáng của thiên tài.\""

#. STRINGS.SKIN_QUOTES.wickerbottom_lunar
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_lunar"
msgid "\"This lunar knowledge has been quite... eye-opening.\""
msgstr "\"Kiến thức mặt trăng này đã khá ... mở mắt.\""

#. STRINGS.SKIN_QUOTES.wickerbottom_magma
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_magma"
msgid "\"Watch for my extrusive igneous rocks, dear.\""
msgstr "\"Hãy xem những tảng đá lửa đẫm máu của tôi, thân yêu.\""

#. STRINGS.SKIN_QUOTES.wickerbottom_masquerade
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_masquerade"
msgid "\"I delight in an elegant soirée, provided it concludes at a sensible hour.\""
msgstr "\"Tôi thích thú với một buổi dạ hội sang trọng, miễn là nó kết thúc vào một giờ hợp lý.\""

#. STRINGS.SKIN_QUOTES.wickerbottom_nature
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_nature"
msgid "\"Honestly, a working knowledge of medicinal botany is hardly witchcraft!\""
msgstr "\"Thành thật mà nói, kiến thức thực tế về dược liệu khó có thể coi là phép thuật phù thủy!\""

#. STRINGS.SKIN_QUOTES.wickerbottom_ornate
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_ornate"
msgid "\"Ah, the reckless abandon of youth. To think I used to dabble in fiction...\""
msgstr "\"À, sự bỏ rơi tuổi trẻ một cách liều lĩnh. Nghĩ đến việc tôi từng say mê tiểu thuyết...\""

#. STRINGS.SKIN_QUOTES.wickerbottom_pirate
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_pirate"
msgid "\"Let the pursuit of knowledge stretch beyond every horizon.\""
msgstr "\"Hãy để việc theo đuổi kiến thức vượt ra ngoài mọi chân trời.\""

#. STRINGS.SKIN_QUOTES.wickerbottom_rose
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_rose"
msgid "\"Ah, to see the world through rose-colored glasses.\""
msgstr "\"Ah, để nhìn thế giới qua kính màu hồng.\""

#. STRINGS.SKIN_QUOTES.wickerbottom_rosep
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_rosep"
msgid "\"Ah, to see the world through rose-colored glasses.\""
msgstr "\"Ah, để nhìn thế giới qua kính màu hồng.\""

#. STRINGS.SKIN_QUOTES.wickerbottom_shadow
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_shadow"
msgid "\"Knowledge is power!\""
msgstr "\"Kiên thức là sức mạnh!\""

#. STRINGS.SKIN_QUOTES.wickerbottom_shadowp
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_shadowp"
msgid "\"Knowledge is power!\""
msgstr "\"Kiên thức là sức mạnh!\""

#. STRINGS.SKIN_QUOTES.wickerbottom_spiderwitch
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_spiderwitch"
msgid "\"Magic is merely science that hasn't been categorized yet.\""
msgstr "\"Phép thuật chỉ là khoa học chưa được phân loại.\""

#. STRINGS.SKIN_QUOTES.wickerbottom_survivor
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_survivor"
msgid "\"I hope I don't break my glasses.\""
msgstr "\"Tôi hy vọng tôi không làm vỡ kính của tôi.\""

#. STRINGS.SKIN_QUOTES.wickerbottom_survivorp
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_survivorp"
msgid "\"I hope I don't break my glasses.\""
msgstr "\"Tôi hy vọng tôi không làm vỡ kính của tôi.\""

#. STRINGS.SKIN_QUOTES.wickerbottom_victorian
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_victorian"
msgid "\"Manners, my dear.\""
msgstr "\"Cách cư xử, thân yêu của tôi.\""

#. STRINGS.SKIN_QUOTES.wickerbottom_yule
msgctxt "STRINGS.SKIN_QUOTES.wickerbottom_yule"
msgid "\"As usual, the responsibility of organizing the seasonal festivities falls to me.\""
msgstr "\"Như thường lệ, trách nhiệm tổ chức các lễ hội theo mùa thuộc về tôi.\""

#. STRINGS.SKIN_QUOTES.willow_ancient
msgctxt "STRINGS.SKIN_QUOTES.willow_ancient"
msgid "\"Sometimes the old ways need to crash and burn to make way for the new.\""
msgstr "\"Đôi khi những con đường cũ cần phải sụp đổ và cháy rụi để nhường chỗ cho những con đường mới.\""

#. STRINGS.SKIN_QUOTES.willow_combatant
msgctxt "STRINGS.SKIN_QUOTES.willow_combatant"
msgid "\"I can handle myself.\""
msgstr "\"Tôi có thể cải thiện bản thân.\""

#. STRINGS.SKIN_QUOTES.willow_cook
msgctxt "STRINGS.SKIN_QUOTES.willow_cook"
msgid "\"My food's always burned to perfection!\""
msgstr "\"Thức ăn của tôi luôn bị cháy đến hoàn hảo!\""

#. STRINGS.SKIN_QUOTES.willow_dowdy
msgctxt "STRINGS.SKIN_QUOTES.willow_dowdy"
msgid "\"I didn't do it. Really.\""
msgstr "\"Tôi đã không làm điều đó. Thực sự.\""

#. STRINGS.SKIN_QUOTES.willow_dragonfly
msgctxt "STRINGS.SKIN_QUOTES.willow_dragonfly"
msgid "\"Woah, I'm smokin'! (No, really!)\""
msgstr "\"Woah, tôi đang hút thuốc! (Không, thực sự!)\""

#. STRINGS.SKIN_QUOTES.willow_dragonfly_d
msgctxt "STRINGS.SKIN_QUOTES.willow_dragonfly_d"
msgid "\"Woah, I'm smokin'! (No, really!)\""
msgstr "\"Woah, tôi đang hút thuốc! (Không, thực sự!)\""

#. STRINGS.SKIN_QUOTES.willow_dragonfly_p
msgctxt "STRINGS.SKIN_QUOTES.willow_dragonfly_p"
msgid "\"Woah, I'm smokin'! (No, really!)\""
msgstr "\"Woah, tôi đang hút thuốc! (Không, thực sự!)\""

#. STRINGS.SKIN_QUOTES.willow_formal
msgctxt "STRINGS.SKIN_QUOTES.willow_formal"
msgid "\"He died before getting to see these beautiful flames.\""
msgstr "\"Anh ấy đã chết trước khi nhìn thấy những ngọn lửa tuyệt đẹp này.\""

#. STRINGS.SKIN_QUOTES.willow_formalp
msgctxt "STRINGS.SKIN_QUOTES.willow_formalp"
msgid "\"He died before getting to see these beautiful flames.\""
msgstr "\"Anh ấy đã chết trước khi nhìn thấy những ngọn lửa tuyệt đẹp này.\""

#. STRINGS.SKIN_QUOTES.willow_gladiator
msgctxt "STRINGS.SKIN_QUOTES.willow_gladiator"
msgid "\"Play with fire and you'll get burned.\""
msgstr "\"Chơi với lửa và bạn sẽ bị đốt cháy.\""

#. STRINGS.SKIN_QUOTES.willow_haunteddoll
msgctxt "STRINGS.SKIN_QUOTES.willow_haunteddoll"
msgid "\"Why did you leave me?\""
msgstr "\"Tại sao mày bỏ rơi tao?\""

#. STRINGS.SKIN_QUOTES.willow_hazard
msgctxt "STRINGS.SKIN_QUOTES.willow_hazard"
msgid "\"Hrrm... mff! Mmmf!\""
msgstr "\"Hrrm... khốn nạn! Mmm!\""

#. STRINGS.SKIN_QUOTES.willow_ice
msgctxt "STRINGS.SKIN_QUOTES.willow_ice"
msgid "\"Why couldn't it be warm fire?\""
msgstr "\"Tại sao nó không thể là lửa ấm?\""

#. STRINGS.SKIN_QUOTES.willow_lunar
msgctxt "STRINGS.SKIN_QUOTES.willow_lunar"
msgid "\"I have an urge to dance around a fire in the moonlight.\""
msgstr "“Tôi muốn nhảy múa quanh đống lửa dưới ánh trăng.”"

#. STRINGS.SKIN_QUOTES.willow_magma
msgctxt "STRINGS.SKIN_QUOTES.willow_magma"
msgid "\"All fire, all the time!!\""
msgstr "\"Tất cả lửa, mọi lúc !!\""

#. STRINGS.SKIN_QUOTES.willow_masquerade
msgctxt "STRINGS.SKIN_QUOTES.willow_masquerade"
msgid "\"The flames taught me how to dance.\""
msgstr "\"Ngọn lửa dạy tôi cách nhảy.\""

#. STRINGS.SKIN_QUOTES.willow_nature
msgctxt "STRINGS.SKIN_QUOTES.willow_nature"
msgid "\"Golden fields of hay, ripe for burning... I mean harvesting.\""
msgstr "\"Những cánh đồng cỏ khô vàng, chín để đốt... Ý tôi là đang thu hoạch.\""

#. STRINGS.SKIN_QUOTES.willow_pirate
msgctxt "STRINGS.SKIN_QUOTES.willow_pirate"
msgid "\"Come onnnn, let me fire the cannon!\""
msgstr "\"Hãy đến, hãy để tôi bắn đại bác!\""

#. STRINGS.SKIN_QUOTES.willow_rose
msgctxt "STRINGS.SKIN_QUOTES.willow_rose"
msgid "\"A rose to symbolize the flames of passion.\""
msgstr "\"Một bông hồng để tượng trưng cho ngọn lửa của đam mê.\""

#. STRINGS.SKIN_QUOTES.willow_rosep
msgctxt "STRINGS.SKIN_QUOTES.willow_rosep"
msgid "\"A rose to symbolize the flames of passion.\""
msgstr "\"Một bông hồng để tượng trưng cho ngọn lửa của đam mê.\""

#. STRINGS.SKIN_QUOTES.willow_shadow
msgctxt "STRINGS.SKIN_QUOTES.willow_shadow"
msgid "\"Shadows are just inverted flames.\""
msgstr "\"Bóng tối chỉ là ngọn lửa đảo ngược.\""

#. STRINGS.SKIN_QUOTES.willow_shadowp
msgctxt "STRINGS.SKIN_QUOTES.willow_shadowp"
msgid "\"Shadows are just inverted flames.\""
msgstr "\"Bóng tối chỉ là ngọn lửa đảo ngược.\""

#. STRINGS.SKIN_QUOTES.willow_spring
msgctxt "STRINGS.SKIN_QUOTES.willow_spring"
msgid "\"That village was burnt before I got there.\""
msgstr "\"Ngôi làng đó đã bị cháy trước khi tôi tới đó.\""

#. STRINGS.SKIN_QUOTES.willow_survivor
msgctxt "STRINGS.SKIN_QUOTES.willow_survivor"
msgid "\"Surviving just requires strength of will. (And fire.)\""
msgstr "\"Sống sót chỉ đòi hỏi sức mạnh của ý chí. (Và lửa.)\""

#. STRINGS.SKIN_QUOTES.willow_survivorp
msgctxt "STRINGS.SKIN_QUOTES.willow_survivorp"
msgid "\"Surviving just requires strength of will. (And fire.)\""
msgstr "\"Sống sót chỉ đòi hỏi sức mạnh của ý chí. (Và lửa.)\""

#. STRINGS.SKIN_QUOTES.willow_victorian
msgctxt "STRINGS.SKIN_QUOTES.willow_victorian"
msgid "\"Fancy a matchstick, sir?\""
msgstr "\"Fancy một que diêm, thưa ngài?\""

#. STRINGS.SKIN_QUOTES.willow_yule
msgctxt "STRINGS.SKIN_QUOTES.willow_yule"
msgid "\"It's the perfect time of year for sitting in front of a roaring fire.\""
msgstr "\"Đó là thời điểm hoàn hảo trong năm để ngồi trước ngọn lửa đang bùng cháy.\""

#. STRINGS.SKIN_QUOTES.wilson_barber
msgctxt "STRINGS.SKIN_QUOTES.wilson_barber"
msgid "\"You, sir! How about a shave?\""
msgstr "\"Bạn, thưa ngài! Làm thế nào về một cái cạo râu?\""

#. STRINGS.SKIN_QUOTES.wilson_combatant
msgctxt "STRINGS.SKIN_QUOTES.wilson_combatant"
msgid "\"This may prove to be my most dangerous experiment yet.\""
msgstr "\"Điều này có thể chứng minh là thí nghiệm nguy hiểm nhất của tôi.\""

#. STRINGS.SKIN_QUOTES.wilson_cook
msgctxt "STRINGS.SKIN_QUOTES.wilson_cook"
msgid "\"Oh yes, I'm cooking something up.\""
msgstr "\"Ồ vâng, tôi đang nấu một cái gì đó lên.\""

#. STRINGS.SKIN_QUOTES.wilson_formal
msgctxt "STRINGS.SKIN_QUOTES.wilson_formal"
msgid "\"I hate parties.\""
msgstr "\"Tôi ghét tiệc tùng.\""

#. STRINGS.SKIN_QUOTES.wilson_formalp
msgctxt "STRINGS.SKIN_QUOTES.wilson_formalp"
msgid "\"I hate parties.\""
msgstr "\"Tôi ghét tiệc tùng.\""

#. STRINGS.SKIN_QUOTES.wilson_gladiator
msgctxt "STRINGS.SKIN_QUOTES.wilson_gladiator"
msgid "\"I've the brains AND the brawn.\""
msgstr "\"Tôi có bộ não VÀ cơ bắp.\""

#. STRINGS.SKIN_QUOTES.wilson_hazard
msgctxt "STRINGS.SKIN_QUOTES.wilson_hazard"
msgid "\"Hrrm... mff! Mmmf!\""
msgstr "\"Hrrm... khốn nạn! Mmm!\""

#. STRINGS.SKIN_QUOTES.wilson_ice
msgctxt "STRINGS.SKIN_QUOTES.wilson_ice"
msgid "\"Brrrrr!\""
msgstr "\"Brrrrr!\""

#. STRINGS.SKIN_QUOTES.wilson_lunar
msgctxt "STRINGS.SKIN_QUOTES.wilson_lunar"
msgid "\"The cosmos are filled with limitless scientific possibilities!\""
msgstr "\"Các vũ trụ chứa đầy các khả năng khoa học vô hạn!\""

#. STRINGS.SKIN_QUOTES.wilson_madscience
msgctxt "STRINGS.SKIN_QUOTES.wilson_madscience"
msgid "\"Stand back. I'm going to do SCIENCE!\""
msgstr "\"Đứng lại. Tôi sẽ làm KHOA HỌC!\""

#. STRINGS.SKIN_QUOTES.wilson_magma
msgctxt "STRINGS.SKIN_QUOTES.wilson_magma"
msgid "\"I've harnessed the power of the earth's core!\""
msgstr "\"Tôi đã khai thác sức mạnh của lõi trái đất!\""

#. STRINGS.SKIN_QUOTES.wilson_masquerade
msgctxt "STRINGS.SKIN_QUOTES.wilson_masquerade"
msgid "\"I am feeling the chemistry!\""
msgstr "\"Tôi đang cảm nhận được chất hóa học!\""

#. STRINGS.SKIN_QUOTES.wilson_nature
msgctxt "STRINGS.SKIN_QUOTES.wilson_nature"
msgid "\"Field botany isn't my specialty... but it's growing on me.\""
msgstr "\"Thực vật học trên đồng ruộng không phải là chuyên môn của tôi... nhưng nó đang phát triển trong tôi.\""

#. STRINGS.SKIN_QUOTES.wilson_pigguard
msgctxt "STRINGS.SKIN_QUOTES.wilson_pigguard"
msgid "\"I'm sure I had a scientific reason for this.\""
msgstr "\"Tôi chắc chắn tôi đã có một lý do khoa học cho điều này.\""

#. STRINGS.SKIN_QUOTES.wilson_pigguard_d
msgctxt "STRINGS.SKIN_QUOTES.wilson_pigguard_d"
msgid "\"I'm sure I had a scientific reason for this.\""
msgstr "\"Tôi chắc chắn tôi đã có một lý do khoa học cho điều này.\""

#. STRINGS.SKIN_QUOTES.wilson_pigguard_p
msgctxt "STRINGS.SKIN_QUOTES.wilson_pigguard_p"
msgid "\"I'm sure I had a scientific reason for this.\""
msgstr "\"Tôi chắc chắn tôi đã có một lý do khoa học cho điều này.\""

#. STRINGS.SKIN_QUOTES.wilson_pirate
msgctxt "STRINGS.SKIN_QUOTES.wilson_pirate"
msgid "\"I've discovered a lot of things at sea... that I'm prone to seasickness, for one.\""
msgstr "\"Tôi đã phát hiện ra rất nhiều điều trên biển... chẳng hạn như tôi dễ bị say sóng.\""

#. STRINGS.SKIN_QUOTES.wilson_rose
msgctxt "STRINGS.SKIN_QUOTES.wilson_rose"
msgid "\"Perhaps I'll retire to a life of rose breeding.\""
msgstr "\"Có lẽ tôi sẽ nghỉ hưu với cuộc sống chăn nuôi hoa hồng.\""

#. STRINGS.SKIN_QUOTES.wilson_rosep
msgctxt "STRINGS.SKIN_QUOTES.wilson_rosep"
msgid "\"Perhaps I'll retire to a life of rose breeding.\""
msgstr "\"Có lẽ tôi sẽ nghỉ hưu với cuộc sống chăn nuôi hoa hồng.\""

#. STRINGS.SKIN_QUOTES.wilson_shadow
msgctxt "STRINGS.SKIN_QUOTES.wilson_shadow"
msgid "\"Mwahahaha!\""
msgstr "\"Mwahahaha!\""

