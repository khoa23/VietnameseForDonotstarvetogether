msgstr "Cảm giác giống như đang mặc một bộ giẻ rách đáng sợ!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_VOIDCLOTH"
msgid "Creepy shirt is happy to be worn by Wolfgang."
msgstr "Cái áo sơ mi rợn người này rất vui khi được Wolfgang mặc lên người."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_YOTH_KNIGHT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_YOTH_KNIGHT"
