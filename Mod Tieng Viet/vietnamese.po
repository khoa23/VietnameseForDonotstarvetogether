msgstr "Anh ấy có thực sự cần phải làm cho nó trở nên sang trọng như vậy không?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUMBBELL_GOLDEN"
