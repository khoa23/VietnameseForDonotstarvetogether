msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.wall_ruins_thulecite
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wall_ruins_thulecite"
msgid "Remnants of an Ancient civilization, before it fell to ruin."
msgstr "Tàn tích của một nền văn minh Cổ đại, trước khi sụp đổ thành phế tích."

#. STRINGS.SKIN_DESCRIPTIONS.wall_ruins_thulecite2
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wall_ruins_thulecite2"
