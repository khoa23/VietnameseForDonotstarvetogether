msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LOST_TOY_42"
msgid "How odd... perhaps it's merely a mirage."
msgstr "Thật kỳ lạ... có lẽ đó chỉ là ảo ảnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LOST_TOY_43
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LOST_TOY_43"
msgid "How odd... perhaps it's merely a mirage."
msgstr "Thật kỳ lạ... có lẽ đó chỉ là ảo ảnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LOST_TOY_7
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LOST_TOY_7"
msgid "How odd... perhaps it's merely a mirage."
msgstr "Thật kỳ lạ... có lẽ đó chỉ là ảo ảnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUCKY_GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUCKY_GOLDNUGGET"
msgid "Such a curious shape."
msgstr "Thật là một hình dạng tò mò."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUCY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUCY"
msgid "A perfectly fine looking axe."
msgstr "Một chiếc rìu trông hoàn hảo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUMPY_SAPLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUMPY_SAPLING"
msgid "Perhaps this species is surculose."
msgstr "Có lẽ loài này là suculose."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNARFROG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNARFROG"
msgid "It possesses a truly unnecessary abundance of eyes."
msgstr "Nó sở hữu rất nhiều đôi mắt thực sự không cần thiết."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNARPLANTHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNARPLANTHAT"
msgid "It does not fit well over my glasses, but I suppose I must make do."
msgstr "Nó không vừa với cặp kính của tôi, nhưng tôi cho rằng mình phải làm vậy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNARPLANT_HUSK"
msgid "An extremely resilient material. I should make use of it."
msgstr "Một vật liệu cực kỳ đàn hồi. Tôi nên tận dụng nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNARPLANT_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNARPLANT_KIT"
msgid "Now that I'm familiar with the material, it's a simple matter to repair it."
msgstr "Bây giờ tôi đã quen với vật liệu này nên việc sửa chữa nó là một vấn đề đơn giản."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNARRIFT_CRYSTAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNARRIFT_CRYSTAL"
msgid "These crystalline structures have grown at a rapid rate."
msgstr "Những cấu trúc tinh thể này đã phát triển với tốc độ nhanh chóng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNARRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNARRIFT_PORTAL"
msgid "It seems to be contaminating the surrounding area."
msgstr "Có vẻ như nó đang làm ô nhiễm khu vực xung quanh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNARTHRALL_PLANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNARTHRALL_PLANT"
msgid "It exhibits parasitic behavior."
msgstr "Nó thể hiện hành vi ký sinh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNARTHRALL_PLANT_VINE_END
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNARTHRALL_PLANT_VINE_END"
msgid "A rather effective defense mechanism."
msgstr "Một cơ chế phòng thủ khá hiệu quả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNAR_FORGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNAR_FORGE"
msgid "It utilizes crystallized energy to reshape and reinforce organic material."
msgstr "Nó sử dụng năng lượng kết tinh để định hình lại và củng cố vật liệu hữu cơ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNAR_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNAR_FORGE_KIT"
msgid "It should be a simple matter to construct it."
msgstr "Nó sẽ là một vấn đề đơn giản để xây dựng nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNAR_GRAZER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNAR_GRAZER"
msgid "Its unique physiology seems to allow it to re-form itself."
msgstr "Sinh lý độc đáo của nó dường như cho phép nó tự tái hình thành."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNAR_SEED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUNAR_SEED"
msgid "A piece of its crown, no doubt."
msgstr "Một mảnh vương miện của nó, không còn nghi ngờ gì nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUREPLANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUREPLANT"
msgid "An invasive plant species."
msgstr "Một loài thực vật xâm lấn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUREPLANTBULB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUREPLANTBULB"
msgid "Now it can be planted wherever is best."
msgstr "Bây giờ nó có thể được trồng ở bất cứ đâu là tốt nhất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUTEFISK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUTEFISK"
msgid "The fish is dried and then soaked in lye, hence the odd aroma."
msgstr "Cá được phơi khô rồi ngâm trong dung dịch kiềm nên có mùi thơm lạ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MADSCIENCE_LAB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MADSCIENCE_LAB"
msgid "Mad science indeed!"
msgstr "Đúng là khoa học điên rồ!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAGICIAN_CHEST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAGICIAN_CHEST"
msgid "I must admit, I find his renewed interest in the Codex... unsettling."
msgstr "Tôi phải thừa nhận, tôi thấy mối quan tâm mới của anh ấy đối với Codex... thật đáng lo ngại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MALBATROSS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MALBATROSS"
msgid "It appears to be of the family Diomedeidae."
msgstr "Nó dường như thuộc họ Diomedeidae."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MALBATROSS_BEAK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MALBATROSS_BEAK"
msgid "These beaks are designed to catch slippery prey."
msgstr "Những chiếc mỏ này được thiết kế để bắt những con mồi trơn trượt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MALBATROSS_FEATHER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MALBATROSS_FEATHER"
msgid "Its plumage has an almost scale-like texture."
msgstr "Bộ lông của nó có kết cấu gần giống như vảy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MALBATROSS_FEATHERED_WEAVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MALBATROSS_FEATHERED_WEAVE"
msgid "A sturdy, lightweight material."
msgstr "Chất liệu chắc chắn, nhẹ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MALE_PUPPET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MALE_PUPPET"
msgid "Poor boy."
msgstr "Cậu bé tội nghiệp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANDRAKE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANDRAKE"
msgid "Mandragora officinarum. Deceased."
msgstr "Mandragora officinarum. Người chết."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANDRAKESOUP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANDRAKESOUP"
msgid "Mandragora officinarum, prepared as a soup in the name of discovery."
msgstr "Mandragora officinarum, được chế biến thành món súp nhân danh sự khám phá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANDRAKE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANDRAKE_ACTIVE"
msgid "Mandragora officinarum. But with a face."
msgstr "Mandragora officinarum. Nhưng với một khuôn mặt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANDRAKE_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANDRAKE_COOKED"
msgid "Mandragora officinarum, cooked in the name of discovery."
msgstr "Mandragora officinarum, nấu chín trong tên của khám phá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANDRAKE_PLANTED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANDRAKE_PLANTED"
msgid "Mandragora officinarum."
msgstr "Mandragora officinarum."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANRABBIT_TAIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANRABBIT_TAIL"
msgid "They use their tails to balance."
msgstr "Họ sử dụng đuôi để cân bằng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAPSCROLL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAPSCROLL"
msgid "The potential of the blank page is paralyzing for some."
msgstr "Tiềm năng của trang trống đang làm tê liệt một số người."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLE"
msgid "A statuesque rock."
msgstr "Một tảng đá như tượng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLEBEAN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLEBEAN"
msgid "Marble growth is arboriculturally impossible."
msgstr "Sự phát triển của đá cẩm thạch là không thể về mặt trồng trọt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLEBEAN_SAPLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLEBEAN_SAPLING"
msgid "I believe it's a perennial."
msgstr "Tôi tin rằng đó là một cây lâu năm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLEPILLAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLEPILLAR"
msgid "It shows the touch of a Roman artisan. How amazing."
msgstr "Nó cho thấy sự liên lạc của một nghệ nhân La Mã. Thật tuyệt vời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLESHRUB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLESHRUB"
msgid "Not ideal for topiary."
msgstr "Không lý tưởng cho cây cảnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLETREE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLETREE"
msgid "Amazing. A tree made entirely of marble."
msgstr "Kinh ngạc. Một cây làm hoàn toàn bằng đá cẩm thạch."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_BUSH.BURNING"
msgid "Combustion!"
msgstr "Thiêu Đốt!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_BUSH.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_BUSH.BURNT"
msgid "Burned entirely."
msgstr "Bị đốt cháy hoàn toàn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_BUSH.GENERIC"
msgid "A cluster of brambles."
msgstr "Một cụm bụi gai."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_BUSH.PICKED"
msgid "Picking brambles is dangerous."
msgstr "Đón bụi gai là nguy hiểm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_PLANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_PLANT"
msgid "A swamp-dwelling rhizome."
msgstr "Một đầm lầy ở-thân rễ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_TREE.BURNING"
msgid "Combustion!"
msgstr "Thiêu Đốt!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_TREE.BURNT"
msgid "A carbonized mangrove."
msgstr "Rừng ngập mặn bị cacbon hóa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_TREE.CHOPPED"
msgid "It has been felled."
msgstr "Nó đã bị đốn hạ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_TREE.GENERIC"
msgid "A mangal rhizophora."
msgstr "Một đước Mangal."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASHEDPOTATOES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASHEDPOTATOES"
msgid "I wouldn't mind a bite or two, myself."
msgstr "Bản thân tôi cũng không ngại ăn một hai miếng đâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_ANCIENT_ARCHITECTHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_ANCIENT_ARCHITECTHAT"
msgid "This mask once adorned a figure of considerable sagacity."
msgstr "Chiếc mặt nạ này từng tô điểm cho một nhân vật có sự thông minh đáng kể."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_ANCIENT_HANDMAIDHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_ANCIENT_HANDMAIDHAT"
msgid "The visage of this mask denotes the elevated stature of its former bearer."
msgstr "Hình dáng của chiếc mặt nạ này biểu thị tầm vóc cao lớn của người từng mang nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_ANCIENT_MASONHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_ANCIENT_MASONHAT"
msgid "Such a mask could only belong to one whose mastery was forged through relentless work."
msgstr "Chiếc mặt nạ như vậy chỉ có thể thuộc về người có khả năng thành thạo được rèn giũa qua quá trình làm việc không ngừng nghỉ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_BLACKSMITHHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_BLACKSMITHHAT"
msgid "It appears to be a stage mask."
msgstr "Nó dường như là một mặt nạ sân khấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_DOLLBROKENHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_DOLLBROKENHAT"
msgid "It appears to be a stage mask."
msgstr "Nó dường như là một mặt nạ sân khấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_DOLLHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_DOLLHAT"
msgid "It appears to be a stage mask."
msgstr "Nó dường như là một mặt nạ sân khấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_DOLLREPAIREDHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_DOLLREPAIREDHAT"
msgid "It appears to be a stage mask."
msgstr "Nó dường như là một mặt nạ sân khấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_FOOLHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_FOOLHAT"
msgid "It appears to be a stage mask."
msgstr "Nó dường như là một mặt nạ sân khấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_HALFWITHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_HALFWITHAT"
msgid "There are no small parts."
msgstr "Không có chi tiết nhỏ nào cả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_KINGHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_KINGHAT"
msgid "It appears to be a stage mask."
msgstr "Nó dường như là một mặt nạ sân khấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_MIRRORHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_MIRRORHAT"
msgid "It appears to be a stage mask."
msgstr "Nó dường như là một mặt nạ sân khấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_PRINCESSHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_PRINCESSHAT"
msgid "She descends from a royal breed."
msgstr "Cô ấy xuất thân từ một dòng dõi hoàng gia."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_QUEENHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_QUEENHAT"
msgid "It appears to be a stage mask."
msgstr "Nó dường như là một mặt nạ sân khấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_SAGEHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_SAGEHAT"
msgid "There are times one must take the helm."
msgstr "Có những lúc một người phải đứng ra chỉ huy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_TOADYHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_TOADYHAT"
msgid "We all have our role to play."
msgstr "Mỗi người đều có vai trò riêng của mình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_TREEHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASK_TREEHAT"
msgid "It appears to be a stage mask."
msgstr "Nó dường như là một mặt nạ sân khấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAST"
msgid "Simply raise a sail, and off we go!"
msgstr "Đơn giản chỉ cần giương buồm lên và chúng ta khởi hành!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASTUPGRADE_LAMP_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASTUPGRADE_LAMP_ITEM"
msgid "I'm always in need of a good reading light."
msgstr "Tôi luôn cần một chiếc đèn đọc sách tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD"
msgid "I'm always in need of a good reading light."
msgstr "Tôi luôn cần một ánh sáng đọc tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASTUPGRADE_LAMP_YOTD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASTUPGRADE_LAMP_YOTD"
msgid "An eclectic design, but no less useful."
msgstr "Một thiết kế chiết trung nhưng không kém phần hữu ích."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM"
msgid "A very sensible safety measure."
msgstr "Một biện pháp an toàn rất hợp lý."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAST_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAST_ITEM"
msgid "A tool for harnessing the wind's power."
msgstr "Một công cụ khai thác sức mạnh của gió."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAST_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAST_MALBATROSS"
msgid "What an impressive wingspan."
msgstr "Thật là một sải cánh ấn tượng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAST_MALBATROSS_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAST_MALBATROSS_ITEM"
msgid "Raise the sail, and let's be off!"
msgstr "Hãy căng buồm lên và chúng ta hãy khởi hành!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAST_YOTD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAST_YOTD"
msgid "I don't believe those are in fact the wings of a Diptera."
msgstr "Tôi không tin đó thực sự là đôi cánh của Diptera."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAST_YOTD_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAST_YOTD_ITEM"
msgid "A tool for harnessing the wind's power."
msgstr "Một công cụ khai thác sức mạnh của gió."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELL"
msgid "Get down from there this instant!"
msgstr "Xuống khỏi đó ngay lập tức!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELLHEAD"
msgid "I wish he wouldn't do that."
msgstr "Tôi mong muốn anh ta sẽ không làm điều đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELLLIGHT"
msgid "How magical!"
msgstr "Thật là thần diệu!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELLLOCK"
msgid "Now I just need a key."
msgstr "Bây giờ tôi chỉ cần một phím."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELLPHONOGRAPH"
msgid "It appears to have no power source."
msgstr "Nó dường như không có nguồn điện."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELLTHRONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELLTHRONE"
msgid "What an intimidating chair."
msgstr "Thật là một chiếc ghế đáng sợ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEAT"
msgid "It's improper to eat it raw, but if we've no choice..."
msgstr "Ăn sống là không đúng đắn, nhưng nếu chúng ta không có lựa chọn nào khác..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATBALLS"
msgid "A pile of processed meat. Who knows what went into this."
msgstr "Một đống thịt chế biến. Ai biết được những gì đã đi vào điều này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.BURNT"
msgid "It doesn't seem stable."
msgstr "Nó dường như không ổn định."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.DONE"
msgid "The process has completed."
msgstr "Quá trình này đã hoàn thành."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.DONE_NOTMEAT"
msgid "The process has completed."
msgstr "Quá trình này đã hoàn thành."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.DRYING"
msgid "Dehydration is a slow process."
msgstr "Mất nước là một quá trình chậm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.DRYINGINRAIN"
msgid "The rain has temporarily halted the dehydration process."
msgstr "Cơn mưa đã tạm thời làm dừng lại quá trình khử nước."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT"
msgid "The rain has temporarily halted the dehydration process."
msgstr "Cơn mưa đã tạm thời làm dừng lại quá trình khử nước."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.DRYING_NOTMEAT"
msgid "Dehydration is a slow process."
msgstr "Mất nước là một quá trình chậm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.GENERIC"
msgid "Meats can be dehydrated."
msgstr "Thịt có thể bị mất nước."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT.BURNT"
msgid "It doesn't seem stable."
msgstr "Nó dường như không ổn định."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT.DONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT.DONE"
msgid "The process has completed."
msgstr "Quá trình này đã hoàn thành."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT"
msgid "The process has completed."
msgstr "Quá trình này đã hoàn thành."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT.DRYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT.DRYING"
msgid "Dehydration is a slow process."
msgstr "Mất nước là một quá trình chậm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN"
msgid "The rain has temporarily halted the dehydration process."
msgstr "Cơn mưa đã tạm thời làm dừng lại quá trình khử nước."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT"
msgid "The rain has temporarily halted the dehydration process."
msgstr "Cơn mưa đã tạm thời làm dừng lại quá trình khử nước."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT"
msgid "Dehydration is a slow process."
msgstr "Mất nước là một quá trình diễn ra chậm rãi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT.GENERIC"
msgid "It seems our chitinous friend could use some assistance."
msgstr "Có vẻ như người bạn chitinous của chúng ta cần sự giúp đỡ nào đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT_MULTI.ABANDONED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT_MULTI.ABANDONED"
msgid "What a shame."
msgstr "Thật là xấu hổ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT_MULTI.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT_MULTI.BURNT"
msgid "It doesn't seem stable."
msgstr "Nó có vẻ không ổn định."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE"
msgid "The process has completed."
msgstr "Quá trình đã hoàn tất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_NOTMEAT"
msgid "The process has completed."
msgstr "Quá trình đã hoàn tất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_SALT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_SALT"
msgid "The salt is a bi-product of the dehydration process for certain things obtained from the sea."
msgstr "Muối là sản phẩm phụ của quá trình khử nước đối với một số thứ thu được từ biển."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING"
msgid "Dehydration is a slow process."
msgstr "Mất nước là một quá trình diễn ra chậm rãi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN"
msgid "The rain has temporarily halted the dehydration process."
msgstr "Cơn mưa đã tạm thời làm dừng lại quá trình khử nước."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN_NOTMEAT"
msgid "The rain has temporarily halted the dehydration process."
msgstr "Cơn mưa đã tạm thời làm dừng lại quá trình khử nước."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING_NOTMEAT"
msgid "Dehydration is a slow process."
msgstr "Mất nước là một quá trình diễn ra chậm rãi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT_MULTI.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK_HERMIT_MULTI.GENERIC"
msgid "This drying rack has a larger capacity."
msgstr "Giá phơi này có công suất lớn hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATYSALAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATYSALAD"
msgid "It contains quite a bit of protein for a salad."
msgstr "Nó chứa khá nhiều protein cho món salad."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEAT_DRIED"
msgid "Salty, yet satisfying."
msgstr "Mặn nhưng vẫn thỏa mãn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEGAFLARE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEGAFLARE"
msgid "I can lure adversaries to a place of my choosing."
msgstr "Tôi có thể dụ kẻ thù đến nơi tôi chọn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERM"
msgid "A piscean biped!"
msgstr "Một động vật hai chân Piscean!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMARMORHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMARMORHAT"
msgid "This helmet was specifically made to fit the merm cranium."
msgstr "Chiếc mũ này được làm riêng để vừa với sọ của người cá merm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMARMORUPGRADEDHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMARMORUPGRADEDHAT"
msgid "This helmet was specifically made to fit the merm cranium."
msgstr "Chiếc mũ này được làm riêng để vừa với sọ của người cá merm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMCORPSE.BURNING"
msgid "It is unfortunate but necessary."
msgstr "Thật đáng tiếc nhưng cần thiết."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMCORPSE.GENERIC"
msgid "This piscean biped has met its demise."
msgstr "Con Song Ngư hai chân này đã bị diệt vong."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMCORPSE.REVIVING"
msgid "The creature is reanimating in the most unnatural way."
msgstr "Sinh vật này đang hồi sinh theo cách không tự nhiên nhất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMGUARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMGUARD"
msgid "A royal bodyguard."
msgstr "Một vệ sĩ hoàng gia."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMGUARD_LUNAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMGUARD_LUNAR"
msgid "It's been mutated nearly beyond recognition."
msgstr "Nó đã bị đột biến gần như không thể nhận ra."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMGUARD_SHADOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMGUARD_SHADOW"
msgid "This development has me feeling rather uneasy."
msgstr "Sự phát triển này khiến tôi cảm thấy khá lo lắng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMHAT"
msgid "I'm not eager to test out its effectiveness."
msgstr "Tôi không háo hức để kiểm tra hiệu quả của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMHEAD.BURNT"
msgid "It's neither rotting nor fermenting now."
msgstr "Đó không phải mục nát cũng không lên men bây giờ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMHEAD.GENERIC"
msgid "I'm uncertain whether it is rotting or fermenting."
msgstr "Tôi không chắc chắn cho dù đó là mục nát hoặc lên men."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMHOUSE.BURNT"
msgid "On beyond dilapidated."
msgstr "Ngày ngoài đổ nát."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMHOUSE.GENERIC"
msgid "Obviously dilapidated."
msgstr "Rõ ràng là đổ nát."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMHOUSE_CRAFTED.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMHOUSE_CRAFTED.BURNT"
msgid "Oh dear..."
msgstr "Ôi trời..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC"
msgid "It's good to see her doing something constructive."
msgstr "Thật tốt khi thấy cô ấy làm điều gì đó mang tính xây dựng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMKING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMKING"
msgid "He seems to be the one in charge here."
msgstr "Có vẻ như anh ta là người chịu trách nhiệm ở đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMTHRONE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMTHRONE.BURNT"
msgid "Oh my... I suppose they'll have to start all over."
msgstr "Ôi trời... tôi cho rằng họ sẽ phải bắt đầu lại từ đầu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMTHRONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMTHRONE.GENERIC"
msgid "The \"if it fits, it sits\" method of choosing a monarch. I'm familiar."
msgstr "Phương pháp chọn vua “hợp thì ngồi”. Tôi quen rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT"
msgid "Oh, oh dear..."
msgstr "Ôi trời ơi..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC"
msgid "Careful not to get a splinter, dear."
msgstr "Cẩn thận kẻo bị dằm nhé em yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMWATCHTOWER_NOKING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMWATCHTOWER_NOKING"
msgid "A crude, but effective fortification."
msgstr "Một công sự thô sơ nhưng hiệu quả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMWATCHTOWER_REGULAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMWATCHTOWER_REGULAR"
msgid "They seem to have found themselves a leader."
msgstr "Họ dường như đã tìm thấy cho mình một nhà lãnh đạo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERM_ARMORY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERM_ARMORY"
msgid "\"Mermfolk Ownlee\"? Hm. I see more spelling lessons are in order."
msgstr "\"Chỉ dành cho người cá Merm\"? Hm. Tôi nghĩ cần thêm vài bài học chính tả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERM_ARMORY_UPGRADED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERM_ARMORY_UPGRADED"
msgid "\"Mermfolk Ownlee\"? Hm. I see more spelling lessons are in order."
msgstr "\"Người Cá Riêng\"? Ừm. Tôi thấy có nhiều bài học đánh vần theo thứ tự hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERM_LUNAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERM_LUNAR"
msgid "It's been mutated nearly beyond recognition."
msgstr "Nó đã bị đột biến gần như không thể nhận ra."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERM_PRINCE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERM_PRINCE"
msgid "The heir, apparently."
msgstr "Người thừa kế, rõ ràng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERM_SHADOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERM_SHADOW"
msgid "This development has me feeling rather uneasy."
msgstr "Sự phát triển này khiến tôi cảm thấy khá lo lắng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERM_TOOL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERM_TOOL"
msgid "While crudely made, I admit it's far more efficient than their usual methods."
msgstr "Mặc dù được chế tạo một cách thô sơ nhưng tôi phải thừa nhận rằng nó hiệu quả hơn nhiều so với các phương pháp thông thường của họ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERM_TOOLSHED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERM_TOOLSHED"
msgid "A place for everything, and everything in its place."
msgstr "Một nơi dành cho mọi thứ và mọi thứ đều ở đúng vị trí của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERM_TOOLSHED_UPGRADED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERM_TOOLSHED_UPGRADED"
msgid "A place for everything, and everything in its place."
msgstr "Một nơi dành cho mọi thứ và mọi thứ đều ở đúng vị trí của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERM_TOOL_UPGRADED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERM_TOOL_UPGRADED"
msgid "While crudely made, I admit it's far more efficient than their usual methods."
msgstr "Mặc dù được chế tạo một cách thô sơ nhưng tôi phải thừa nhận rằng nó hiệu quả hơn nhiều so với các phương pháp thông thường của họ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MESSAGEBOTTLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MESSAGEBOTTLE"
msgid "Not the most effective postal service."
msgstr "Không phải là dịch vụ bưu chính hiệu quả nhất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MESSAGEBOTTLEEMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MESSAGEBOTTLEEMPTY"
msgid "This type of jar is most commonly used for canning."
msgstr "Loại lọ này được sử dụng phổ biến nhất để đóng hộp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MIGHTY_GYM.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MIGHTY_GYM.BURNT"
msgid "I'd suggest looking elsewhere for a place to exercise."
msgstr "Tôi khuyên bạn nên tìm nơi khác để tập thể dục."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MIGHTY_GYM.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MIGHTY_GYM.GENERIC"
msgid "Do be careful not to overexert yourself, dear."
msgstr "Hãy cẩn thận đừng cố gắng quá sức nhé em yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MILKYWHITES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MILKYWHITES"
msgid "Tunica albuginea oculi, the opaque white covering of the vitreous humor. Also known as disgusting."
msgstr "Tunica albuginea oculi, lớp phủ màu trắng đục của thủy tinh thể. Còn được gọi là kinh tởm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINERHAT"
msgid "This would make a great reading light."
msgstr "Điều này sẽ làm cho đọc một ánh sáng tuyệt vời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINIBOATLANTERN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINIBOATLANTERN"
msgid "The balloon seems a bit redundant, doesn't it?"
msgstr "Quả bóng bay có vẻ hơi dư thừa phải không?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINIFAN"
msgid "Its aerodynamic principals are astonishing."
msgstr "Nguyên lý khí động học của nó thật đáng kinh ngạc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINIFLARE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINIFLARE"
msgid "It's safer for everyone to stick together."
msgstr "Sẽ an toàn hơn khi mọi người gắn bó với nhau."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINISIGN.GENERIC"
msgid "An excellent diagram! Very accurate."
msgstr "Một sơ đồ tuyệt vời! Rất chính xác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINISIGN.UNDRAWN"
msgid "A drawn diagram might help keep things tidy."
msgstr "Một sơ đồ được vẽ có thể giúp giữ mọi thứ gọn gàng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINISIGN_ITEM"
msgid "Finally, a proper organizational tool."
msgstr "Cuối cùng, một công cụ tổ chức thích hợp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINOTAUR"
msgid "Get away, you beast!"
msgstr "Có được đi, bạn con thú!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINOTAURCHEST"
msgid "That chest is absolutely marvelous."
msgstr "Bộ ngực đó thực sự tuyệt vời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINOTAURHORN"
msgid "An amazingly large horn. I wonder if the nightmare helped fuel the growth."
msgstr "Một chiếc sừng lớn đáng kinh ngạc. Tôi tự hỏi liệu cơn ác mộng có giúp thúc đẩy sự tăng trưởng hay không."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MITEGLAND.COLD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MITEGLAND.COLD"
msgid "It seems that its reserves of heat are finite."
msgstr "Có vẻ như nguồn nhiệt dự trữ của nó là hữu hạn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MITEGLAND.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MITEGLAND.GENERIC"
msgid "It gives off a substantial amount of heat."
msgstr "Nó tỏa ra một lượng nhiệt đáng kể."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MITEGLAND_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MITEGLAND_COOKED"
msgid "I suspect it may not be wise to eat such a thing."
msgstr "Tôi nghi ngờ việc ăn một thứ như vậy có thể không phải là điều khôn ngoan."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLE.ABOVEGROUND"
msgid "Ah, it's a Talpidae!"
msgstr "À, đó là Talpidae!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLE.HELD"
msgid "I don't think my pocket is its natural habitat."
msgstr "Tôi không nghĩ rằng túi của tôi là môi trường sống tự nhiên của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLE.UNDERGROUND"
msgid "Something is tunneling down there."
msgstr "Một cái gì đó đang đào hầm ở dưới đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLEBAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLEBAT"
msgid "I suspect the impressive snout must compensate for its poor eyesight."
msgstr "Tôi nghi ngờ chiếc mõm ấn tượng phải bù đắp cho thị lực kém của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLEBATHILL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLEBATHILL"
msgid "The burrow appears to be mainly comprised of phlegm and mud."
msgstr "Hang dường như chủ yếu bao gồm đờm và bùn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLEHAT"
msgid "Ah, to look through another creature's, uh, nose!"
msgstr "À, để nhìn qua mũi của sinh vật khác!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLEHILL"
msgid "The tunnel system must be vast!"
msgstr "Hệ thống đường hầm phải lớn!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEY"
msgid "They produce quite an odor."
msgstr "Họ sản xuất khá mùi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEYBARREL"
msgid "This appears to be the home of several primates."
msgstr "Điều này dường như là ngôi nhà của nhiều loài linh trưởng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEYHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEYHUT.BURNT"
msgid "I suppose all that thievery leaves little time to organize a fire brigade."
msgstr "Tôi cho rằng tất cả những vụ trộm đó khiến cho việc tổ chức một đội cứu hỏa có rất ít thời gian."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEYHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEYHUT.GENERIC"
msgid "Despite their affinity with the ocean, the apes still seem to prefer sleeping in trees."
msgstr "Mặc dù có mối quan hệ thân thiết với đại dương nhưng loài vượn dường như vẫn thích ngủ trên cây hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEYISLAND_PORTAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEYISLAND_PORTAL"
msgid "It appears to be leaking into this world."
msgstr "Nó dường như đang rò rỉ vào thế giới này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS"
msgid "I highly doubt the apes I encountered are intelligent enough to have constructed it."
msgstr "Tôi thực sự nghi ngờ những con khỉ tôi gặp đủ thông minh để chế tạo ra nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEYPILLAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEYPILLAR"
msgid "These appear to be supporting the throne."
msgstr "Những thứ này dường như đang hỗ trợ ngai vàng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEYQUEEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEYQUEEN"
msgid "How interesting, the apes seem to have a matriarchal society."
msgstr "Thật thú vị, loài khỉ dường như có một xã hội mẫu hệ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEYTAIL"
msgid "A variation of the common Typha latifolia, perhaps?"
msgstr "Có lẽ là một biến thể của loài Typha latifolia phổ biến?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEY_MEDIUMHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEY_MEDIUMHAT"
msgid "Suitable headwear for one who spends time at sea."
msgstr "Mũ đội đầu thích hợp cho người dành nhiều thời gian trên biển."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEY_SMALLHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEY_SMALLHAT"
msgid "It could use a thorough washing."
msgstr "Nó có thể sử dụng một rửa kỹ lưỡng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONSTERLASAGNA"
msgid "Lasagna or no, it would be hazardous to consume it."
msgstr "Lasagna hay không, sẽ rất nguy hiểm khi tiêu thụ nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONSTERMEAT"
msgid "It would be hazardous to consume this."
msgstr "Sẽ rất nguy hiểm nếu tiêu thụ thứ này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONSTERMEAT_DRIED"
msgid "Salty, yet satisfying."
msgstr "Mặn nhưng vẫn thỏa mãn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONSTERTARTARE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONSTERTARTARE"
msgid "Monster meat, dressed up fancy."
msgstr "Thịt quái vật, ăn mặc cầu kỳ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBASE.BROKEN"
msgid "Ancient debris. Perhaps it can be restored?"
msgstr "Những mảnh vụn cổ xưa. Có lẽ nó có thể được phục hồi?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBASE.GENERIC"
msgid "The magic of this structure ebbs in predictable cycles."
msgstr "Sự kỳ diệu của cấu trúc này giảm dần theo chu kỳ có thể dự đoán được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "The magic of the stone appears to be inexhaustible."
msgstr "Sự kỳ diệu của đá dường như là vô tận."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBASE.STAFFED"
msgid "Now we must be patient."
msgstr "Bây giờ chúng ta phải kiên nhẫn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "Hmm... It seems the staves are not interchangeable."
msgstr "Hmm... Có vẻ như các cây gậy không thể thay thế cho nhau được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBUTTERFLY.GENERIC"
msgid "It gets its green hue from the lunar residue in its system."
msgstr "Nó có màu xanh lục từ cặn mặt trăng trong hệ thống của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBUTTERFLY.HELD"
msgid "I may have a use for this."
msgstr "Tôi có thể có ích cho việc này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBUTTERFLYWINGS"
msgid "As I suspected. There are high concentrations of lunar residue."
msgstr "Đúng như tôi nghi ngờ. Có nồng độ cao của dư lượng mặt trăng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBUTTERFLY_SAPLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBUTTERFLY_SAPLING"
msgid "The moths and the trees have somehow mutated together here."
msgstr "Những con bướm và cây cối bằng cách nào đó đã cùng nhau biến đổi ở đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.CAVE"
msgid "It appears to lose functionality in subterranean conditions."
msgstr "Nó dường như mất chức năng trong điều kiện dưới lòng đất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.GENERIC"
msgid "Something very odd is going on here."
msgstr "Có điều gì đó rất kỳ lạ đang diễn ra ở đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.GLASSED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.GLASSED"
msgid "How curious, the water reacts similarly to what I observed in the grotto."
msgstr "Thật kỳ lạ, nước phản ứng tương tự như những gì tôi quan sát được trong hang động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "This cycle of the moon has drawn to a close."
msgstr "Chu kỳ này của mặt trăng đã kết thúc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "The moon's cycle begins anew."
msgstr "Chu kỳ của mặt trăng bắt đầu lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "The moon is waning."
msgstr "Mặt trăng đang suy yếu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "The moon is waxing."
msgstr "Mặt trăng đang tròn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONGLASS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONGLASS"
msgid "Perhaps I could keep a sample and study the composition."
msgstr "Có lẽ tôi có thể giữ một mẫu và nghiên cứu thành phần."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONGLASSAXE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONGLASSAXE"
msgid "Always strive for greater efficacy."
msgstr "Luôn phấn đấu để đạt được hiệu quả cao hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONGLASS_CHARGED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONGLASS_CHARGED"
msgid "The energy seems unstable, I'll have to be quick to put it to any use."
msgstr "Năng lượng có vẻ không ổn định, tôi phải nhanh chóng sử dụng nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONGLASS_ROCK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONGLASS_ROCK"
msgid "It appears to be mineral, but may actually be organic in nature."
msgstr "Nó có vẻ là khoáng chất nhưng thực tế có thể có bản chất hữu cơ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONGLASS_WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONGLASS_WOBSTER_DEN"
msgid "It appears to be a den of some sort."
msgstr "Nó có vẻ là một cái hang nào đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONROCKCRATER"
msgid "Would make a useful cartographic instrument with proper embellishments."
msgstr "Sẽ tạo ra một công cụ vẽ bản đồ hữu ích với các chi tiết trang trí thích hợp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONROCKIDOL"
msgid "Curious. It rather looks like a key."
msgstr "Tò mò. Nó trông giống như một chiếc chìa khóa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONROCKNUGGET"
msgid "Implications of a lunar body? Interesting."
msgstr "Ý nghĩa của cơ thể mặt trăng? Hấp dẫn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONROCKSEED"
msgid "A floating orb of knowledge."
msgstr "Một quả cầu kiến thức lơ lửng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONROCK_PIECES"
msgid "What a perplexing transformation."
msgstr "Thật là một sự chuyển đổi khó hiểu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONSPIDERDEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONSPIDERDEN"
msgid "Those poor hideous creatures are making their den here."
msgstr "Những sinh vật xấu xí tội nghiệp đó đang làm hang ổ của chúng ở đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONSTORM_GLASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONSTORM_GLASS.GENERIC"
msgid "The glass seems to have stabilized."
msgstr "Kính dường như đã ổn định."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONSTORM_GLASS.INFUSED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONSTORM_GLASS.INFUSED"
msgid "It's radiating a faintly glowing energy."
msgstr "Nó đang tỏa ra một năng lượng phát sáng yếu ớt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONSTORM_GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONSTORM_GOGGLESHAT"
msgid "A rather eccentric design, yet surprisingly effective."
msgstr "Một thiết kế khá lập dị nhưng lại mang lại hiệu quả bất ngờ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONSTORM_SPARK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONSTORM_SPARK"
msgid "I assumed it was a form of electricity, but it seems to be something else entirely..."
msgstr "Tôi cho rằng đó là một dạng điện, nhưng có vẻ như nó là một thứ hoàn toàn khác..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONSTORM_STATIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONSTORM_STATIC"
msgid "That energy seems quite volatile."
msgstr "Năng lượng đó có vẻ khá dễ bay hơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONSTORM_STATIC_CATCHER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONSTORM_STATIC_CATCHER"
msgid "It is not carrying a charge."
msgstr "Nó không mang theo một khoản phí."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONSTORM_STATIC_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONSTORM_STATIC_ITEM"
msgid "This device appears to keep the energy contained, somehow."
msgstr "Bằng cách nào đó, thiết bị này dường như giữ được năng lượng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONSTORM_STATIC_ROAMER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONSTORM_STATIC_ROAMER"
msgid "That energy has gone astray."
msgstr "Năng lượng đó đã đi lạc lối."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR.GENERIC"
msgid "The voice says it has knowledge to share."
msgstr "Giọng nói nói rằng nó có kiến thức để chia sẻ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP"
msgid "It says it'll share a secret with me if I complete it."
msgstr "Nó nói rằng nó sẽ chia sẻ bí mật với tôi nếu tôi hoàn thành nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_ASTRAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_ASTRAL"
msgid "Are you ready to share your knowledge with me?"
msgstr "Bạn đã sẵn sàng chia sẻ kiến thức của mình với tôi chưa?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_COSMIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_COSMIC"
msgid "It says there's more knowledge yet to be found."
msgstr "Nó nói rằng vẫn còn nhiều kiến thức chưa được tìm thấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_CROWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_CROWN"
msgid "Come now, let's get you back where you belong."
msgstr "Hãy đến ngay bây giờ, hãy đưa bạn trở lại nơi bạn thuộc về."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_GLASS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_GLASS"
msgid "I believe it is trying to communicate with me telepathically."
msgstr "Tôi tin rằng nó đang cố gắng giao tiếp với tôi bằng thần giao cách cảm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_ICON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_ICON"
msgid "It's projecting a sense of urgency into my mind."
msgstr "Nó đang truyền tải cảm giác cấp bách vào tâm trí tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_IDOL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_IDOL"
msgid "Its energy is prodding at the edges of my mind."
msgstr "Năng lượng của nó đang thúc đẩy tâm trí tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_LINK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_LINK"
msgid "I'm afraid its purpose eludes me, for now."
msgstr "Tôi e rằng mục đích của nó hiện đang lảng tránh tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_ROCK_GLASS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_ROCK_GLASS"
msgid "I think I had best mine it out."
msgstr "Tôi nghĩ tốt nhất tôi nên khai thác nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_ROCK_IDOL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_ROCK_IDOL"
msgid "I think I had best mine it out."
msgstr "Tôi nghĩ tốt nhất tôi nên khai thác nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_ROCK_SEED"
msgid "I think I had best mine it out."
msgstr "Tôi nghĩ tốt nhất tôi nên khai thác nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_SEED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_SEED"
msgid "It is projecting images of an altar into my mind."
msgstr "Nó đang chiếu vào tâm trí tôi những hình ảnh của một bàn thờ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_WARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_ALTAR_WARD"
msgid "It's communicating a need to be reconstructed."
msgstr "Nó truyền đạt một nhu cầu cần được xây dựng lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_CAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_CAP"
msgid "It seems to possess strong sleep inducing properties."
msgstr "Nó dường như có đặc tính gây ngủ mạnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_CAP_COOKED"
msgid "How odd. Once cooked, they seem to act as a stimulant."
msgstr "Thật kỳ lạ. Sau khi nấu chín, chúng dường như hoạt động như một chất kích thích."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_DEVICE.CONSTRUCTION1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_DEVICE.CONSTRUCTION1"
msgid "I'm afraid I can't yet ascertain its function."
msgstr "Tôi e rằng tôi chưa thể xác định được chức năng của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_DEVICE.CONSTRUCTION2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_DEVICE.CONSTRUCTION2"
msgid "The pieces are slowly falling into place."
msgstr "Các mảnh ghép đang dần rơi vào đúng vị trí."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_DEVICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_DEVICE.GENERIC"
msgid "As I suspected, it's meant to function as a battery of sorts."
msgstr "Đúng như tôi nghi ngờ, nó có chức năng như một loại pin."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_FISSURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_FISSURE.GENERIC"
msgid "This is not the same type of magic I've seen from Maxwell's fuel."
msgstr "Đây không phải là loại phép thuật mà tôi từng thấy từ nhiên liệu của Maxwell."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_FISSURE.NOLIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_FISSURE.NOLIGHT"
msgid "The moon cycles here are beginning to make a lot more sense."
msgstr "Chu kỳ mặt trăng ở đây đang bắt đầu có ý nghĩa hơn rất nhiều."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_FISSURE_PLUGGED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_FISSURE_PLUGGED"
msgid "Goodness, that must have required some tenacity!"
msgstr "Ôi trời, điều đó chắc hẳn phải cần đến sự kiên trì!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_TREE.BURNING"
msgid "Tsk. Such a waste of resources."
msgstr "Chậc. Thật là lãng phí tài nguyên."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_TREE.BURNT"
msgid "Carbonized, through and through."
msgstr "Bị cacbon hóa, xuyên suốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_TREE.CHOPPED"
msgid "Little of use remains."
msgstr "Vẫn còn ít sử dụng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_TREE.GENERIC"
msgid "It seems to have been altered by ambient lunar energies."
msgstr "Nó dường như đã bị thay đổi bởi năng lượng mặt trăng xung quanh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_TREE_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_TREE_BLOSSOM"
msgid "What a peculiar specimen."
msgstr "Thật là một mẫu vật kỳ lạ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_TREE_BLOSSOM_DRIED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOON_TREE_BLOSSOM_DRIED"
msgid "The drying process enhances the aroma."
msgstr "Quá trình sấy khô tăng cường hương thơm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOOSE"
msgid "I dub it Alces canadensis."
msgstr "Tôi dub nó Alces canadensis."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOOSEEGG"
msgid "What a marvel!"
msgstr "Thật là một điều kỳ diệu!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "I should like to research its mating habits, someday."
msgstr "Tôi muốn nghiên cứu thói quen giao phối của nó vào một ngày nào đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOQUECA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOQUECA"
msgid "He's so very talented."
msgstr "Anh ấy rất tài năng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSQUITO.GENERIC"
msgid "A thirsty female Haemagogus Devorator."
msgstr "Một nữ khát Haemagogus Devorator."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSQUITO.HELD"
msgid "It is securely stored."
msgstr "Nó được lưu trữ an toàn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSQUITOBOMB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSQUITOBOMB"
msgid "Absolutely horrid. It makes my skin crawl."
msgstr "Thật kinh khủng. Nó làm tôi rùng mình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSQUITOFERTILIZER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSQUITOFERTILIZER"
msgid "There is a direct correlation between the fertilizer's efficacy and odor."
msgstr "Có mối tương quan trực tiếp giữa hiệu quả của phân bón và mùi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSQUITOMERMSALVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSQUITOMERMSALVE"
msgid "The infusion of fresh blood seems to boost a merm's overall health."
msgstr "Việc truyền máu tươi dường như giúp tăng cường sức khỏe tổng thể của người cá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSQUITOMUSK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSQUITOMUSK"
msgid "The pheromones render one undetectable to the cursed bloodsuckers."
msgstr "Pheromone khiến những kẻ hút máu bị nguyền rủa không thể phát hiện được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSQUITOSACK"
msgid "The stomach of a Culicidae, brimming with blood."
msgstr "Dạ dày của một Culicidae, tràn đầy máu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSSLING"
msgid "I suppose that's approximately what I expected."
msgstr "Tôi cho rằng đó là khoảng những gì tôi mong đợi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOUND.DUG"
msgid "A desecrated burial mound."
msgstr "Một gò chôn cất báng bổ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOUND.GENERIC"
msgid "A burial mound."
msgstr "Một gò chôn cất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MULLEDDRINK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MULLEDDRINK"
msgid "A taste of Yuletide cheer."
msgstr "Một hương vị của niềm vui Yuletide."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "Hmm... This may require further reading."
msgstr "Hmm... Điều này có thể cần đọc thêm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "Its design is decidedly otherworldly."
msgstr "Thiết kế của nó rõ ràng là thuộc thế giới khác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "Quite functional, it operates as both an axe and a pickaxe."
msgstr "Khá chức năng, nó hoạt động như cả một cái rìu và một cái cuốc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHGNOME
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHGNOME"
msgid "Should I classify you under Animalia or Fungi?"
msgstr "Tôi nên phân loại bạn theo Animalia hay Fungi?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOMBOMB"
msgid "Everyone, give the volatile Agaricus wide berth!"
msgstr "Mọi người hãy tránh xa Agaricus hay thay đổi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOMHAT"
msgid "Ooo. What a delightfully wizened look."
msgstr "Ồ. Thật là một cái nhìn nhăn nheo thú vị."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOMSPROUT.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOMSPROUT.BURNT"
msgid "A towering, burnt Agaricus."
msgstr "Một Agaricus cháy cao chót vót."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOMSPROUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOMSPROUT.GENERIC"
msgid "We must destroy that towering Agaricus."
msgstr "Chúng ta phải tiêu diệt Agaricus cao chót vót đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "Carbonized by an exothermic chemical reaction."
msgstr "Bị cacbon hóa bởi phản ứng hóa học tỏa nhiệt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "It must first be seeded with a cut specimen or fungal spore."
msgstr "Đầu tiên nó phải được gieo bằng mẫu vật đã cắt hoặc bào tử nấm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "An excellent fungal yield."
msgstr "Năng suất nấm tuyệt vời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.ROTTEN"
msgid "The state of decomposition is too advanced to support any specimens."
msgstr "Trạng thái phân hủy quá cao để có thể hỗ trợ bất kỳ mẫu vật nào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED"
msgid "Its growth has been halted by the extreme cold."
msgstr "Sự tăng trưởng của nó đã bị dừng lại do cái lạnh cực độ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "The fungi are fruiting nicely."
msgstr "Nấm đang sinh trái tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.STUFFED"
msgid "We ought to pick them before they outgrow their planter."
msgstr "Chúng ta nên hái chúng trước khi chúng lớn hơn chậu trồng cây của mình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT.BURNT"
msgid "That was myco-illogical. Ho ho!"
msgstr "Điều đó thật phi logic. Hô hô!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT.OFF"
msgid "A bioluminescent fungus. Neither Agaricales nor Xylariales."
msgstr "Một loại nấm phát quang sinh học. Cả Agaricales lẫn Xylariales."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "Quite enthralling, no?"
msgstr "Khá mê hoặc phải không?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "Ahem. I'll be needing a new reading light."
msgstr "Ừm. Tôi sẽ cần một chiếc đèn đọc sách mới."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT2.OFF"
msgid "Basic color theory is a must."
msgstr "Lý thuyết màu sắc cơ bản là phải."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "Red and blue spores produce lovely reading light when combined."
msgstr "Các bào tử màu đỏ và xanh lam tạo ra ánh sáng đọc đáng yêu khi kết hợp với nhau."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_MEDIUM.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_MEDIUM.ACIDCOVERED"
msgid "The acid will expedite the spoilage of the fungal yield."
msgstr "Axit sẽ đẩy nhanh quá trình hư hỏng sản lượng nấm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "The smell is used to ward off predators."
msgstr "Mùi được sử dụng để xua đuổi kẻ săn mồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
msgid "A red variety of Mycena luxaeterna."
msgstr "Một loạt màu đỏ của Mycena luxaeterna."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_MOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_MOON"
msgid "I suspect some property in the water caused it to change."
msgstr "Tôi nghi ngờ một số đặc tính trong nước đã khiến nó thay đổi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_SMALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_SMALL.ACIDCOVERED"
msgid "The acid will expedite the spoilage of the fungal yield."
msgstr "Axit sẽ đẩy nhanh quá trình hư hỏng sản lượng nấm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "The light is caused by a chemical reaction."
msgstr "Ánh sáng được tạo ra bởi một phản ứng hóa học."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_SMALL.GENERIC"
msgid "My word! A huge Mycena silvaelucens."
msgstr "Từ của tôi! Một silvaelucens Mycena lớn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED"
msgid "The acid will expedite the spoilage of the fungal yield."
msgstr "Axit sẽ đẩy nhanh quá trình hư hỏng sản lượng nấm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "Apparently it's the breeding season for this species."
msgstr "Có vẻ như đây là mùa sinh sản của loài này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "A tree with a fungal parasite."
msgstr "Một cây với một ký sinh trùng nấm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED"
msgid "The acid will expedite the spoilage of the fungal yield."
msgstr "Axit sẽ đẩy nhanh quá trình hư hỏng sản lượng nấm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC"
msgid "This relationship appears symbiotic."
msgstr "Mối quan hệ này có vẻ cộng sinh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATEDBEARGER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATEDBEARGER"
msgid "The parasite seems capable of altering its host body to suit its needs."
msgstr "Ký sinh trùng dường như có khả năng thay đổi cơ thể vật chủ để phù hợp với nhu cầu của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATEDBIRD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATEDBIRD"
msgid "It has mutated in form and nature."
msgstr "Nó đã bị biến đổi về hình thức và tính chất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATEDBUZZARD_GESTALT.EATING_CORPSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATEDBUZZARD_GESTALT.EATING_CORPSE"
msgid "This is how it spreads the... infection."
msgstr "Đây là cách nó lây lan... sự lây nhiễm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATEDBUZZARD_GESTALT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATEDBUZZARD_GESTALT.GENERIC"
msgid "Though reanimated, the creature remains an eater of the dead."
msgstr "Mặc dù đã được hồi sinh nhưng sinh vật này vẫn là kẻ ăn thịt người chết."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATEDDEERCLOPS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATEDDEERCLOPS"
msgid "The reanimation process seems to have altered its physicality."
msgstr "Quá trình hồi sinh dường như đã thay đổi thể chất của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATEDHOUND.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATEDHOUND.DEAD"
msgid "What a pity."
msgstr "Thật đáng tiếc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATEDHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATEDHOUND.GENERIC"
msgid "Another moon-induced mutation... Hm."
msgstr "Một đột biến khác do mặt trăng gây ra... Hm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATEDHOUND.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATEDHOUND.SLEEPING"
msgid "I should like to study it up close."
msgstr "Tôi muốn nghiên cứu nó kỹ hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATEDWARG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATEDWARG"
msgid "Its body has been drastically altered."
msgstr "Cơ thể của nó đã bị thay đổi đáng kể."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATED_PENGUIN.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATED_PENGUIN.DEAD"
msgid "That takes care of that."
msgstr "Điều đó quan tâm đến điều đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATED_PENGUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATED_PENGUIN.GENERIC"
msgid "Something about this place has made the creature go quite wrong."
msgstr "Có điều gì đó ở nơi này đã khiến sinh vật này trở nên khá sai lầm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATED_PENGUIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATED_PENGUIN.SLEEPING"
msgid "I see no reason to wake it."
msgstr "Tôi thấy không có lý do gì để đánh thức nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATOR_DROPPER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATOR_DROPPER"
msgid "They're lovely, dear."
msgstr "Chúng thật đáng yêu, em yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATOR_HEALER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATOR_HEALER"
msgid "They're lovely, dear."
msgstr "Chúng thật đáng yêu, em yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATOR_HIDER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATOR_HIDER"
msgid "How interesting! It appears to alter an arachnid's form when ingested."
msgstr "Thật thú vị! Nó dường như làm thay đổi hình dạng của loài nhện khi ăn phải."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATOR_MOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATOR_MOON"
msgid "How interesting! It appears to alter an arachnid's form when ingested."
msgstr "Thật thú vị! Nó dường như làm thay đổi hình dạng của loài nhện khi ăn phải."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATOR_SPITTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATOR_SPITTER"
msgid "They're lovely, dear."
msgstr "Chúng thật đáng yêu, em yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATOR_WARRIOR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATOR_WARRIOR"
msgid "How interesting! It appears to alter an arachnid's form when ingested."
msgstr "Thật thú vị! Nó dường như làm thay đổi hình dạng của loài nhện khi ăn phải."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATOR_WATER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUTATOR_WATER"
msgid "How interesting! They appear to alter an arachnid's form when ingested."
msgstr "Thật thú vị! Chúng dường như thay đổi hình dạng của loài nhện khi ăn phải."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NATURE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NATURE_BLUEPRINT"
msgid "How delightful!"
msgstr "Cach Thu Vị!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTCAPHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTCAPHAT"
msgid "I'm afraid I have no use for it."
msgstr "Tôi sợ tôi không có ích gì cho nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTLIGHT"
msgid "Curiously luminescent."
msgstr "Phát sáng một cách kỳ lạ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMAREFUEL"
msgid "Ectoplasmic residue."
msgstr "Dư lượng ngoại chất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMAREGROWTH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMAREGROWTH"
msgid "These crystalline structures do not appear to be natural."
msgstr "Những cấu trúc tinh thể này có vẻ không tự nhiên."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARELIGHT"
msgid "The ancients seem to have used nightmare fuel to power everything."
msgstr "Người xưa dường như đã sử dụng nhiên liệu ác mộng để cung cấp năng lượng cho mọi thứ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMAREPIE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMAREPIE"
msgid "It tastes a bit like magic."
msgstr "Nó có vị hơi giống ma thuật."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "The levels of ectoplasmic residue seem to be at their lowest."
msgstr "Mức dư lượng ectoplasmic dường như ở mức thấp nhất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "There is very little ectoplasmic residue vapor."
msgstr "Có rất ít ectoplasmic hơi dư lượng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "There doesn't seem to be any ectoplasmic vapor around here."
msgstr "Có vẻ như không được bất kỳ hơi ectoplasmic quanh đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "The levels of ectoplasmic residue seem to be at their peak."
msgstr "Mức dư lượng ectoplasmic dường như là đỉnh cao của họ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "Levels of ectoplasmic residue are high but seem to be decreasing."
msgstr "Mức dư lượng ectoplasmic là cao nhưng dường như được giảm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "There are low, but increasing levels of vapors containing ectoplasmic residue."
msgstr "Có mức độ thấp nhưng ngày càng tăng của hơi có chứa dư lượng ngoại chất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "Levels of ectoplasmic residue seem to be increasing."
msgstr "Mức dư lượng ectoplasmic dường như được tăng lên."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTSTICK"
msgid "I wonder if it's named for Venus?"
msgstr "Tôi tự hỏi nếu nó được đặt tên cho Venus?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTSWORD"
msgid "Transdimensional weaponry."
msgstr "Vũ khí xuyên không gian."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NITRE"
msgid "Also known as saltpeter."
msgstr "Còn được gọi là Nitrat."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NITRE_FORMATION
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NITRE_FORMATION"
msgid "The acidic rain seems to have caused a chemical reaction, producing these formations."
msgstr "Mưa axit dường như đã gây ra phản ứng hóa học, tạo ra những thành tạo này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NONSLIPGRIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NONSLIPGRIT"
msgid "It will enhance my grip, at the cost of my tool's longevity."
msgstr "Nó sẽ nâng cao khả năng cầm nắm của tôi nhưng phải trả giá bằng tuổi thọ của dụng cụ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NONSLIPGRITBOOSTED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NONSLIPGRITBOOSTED"
msgid "I won't have to fear slipping with this sprinkled on the ground."
msgstr "Tôi sẽ không phải sợ trượt khi rắc thứ này xuống đất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NUTRIENTSGOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NUTRIENTSGOGGLESHAT"
msgid "The prudent gardener ensures they are able to discern every detail about their crops."
msgstr "Người làm vườn khôn ngoan đảm bảo rằng họ có thể nhận biết từng chi tiết về cây trồng của mình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OAR"
msgid "One and two, and one and two!"
msgstr "Một và hai, và một và hai!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OAR_DRIFTWOOD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OAR_DRIFTWOOD"
msgid "A much more efficient, lighter design."
msgstr "Một thiết kế nhẹ hơn, hiệu quả hơn nhiều."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OAR_MONKEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OAR_MONKEY"
msgid "It appears to be a symbol of status aboard the apes' ship."
msgstr "Nó dường như là biểu tượng cho địa vị trên con tàu của loài khỉ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OASISLAKE.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OASISLAKE.EMPTY"
msgid "Perhaps it's not the right time of year."
msgstr "Có lẽ đó không phải là thời điểm thích hợp trong năm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OASISLAKE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OASISLAKE.GENERIC"
msgid "It could support a small ecosystem."
msgstr "Nó có thể hỗ trợ một hệ sinh thái nhỏ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHABLEFLOTSAM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHABLEFLOTSAM"
msgid "Oh my, what a mess!"
msgstr "Trời đất, lộn xộn quá!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGBOBBER_BALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGBOBBER_BALL"
msgid "The use of a fishing float was first documented in 1496."
msgstr "Việc sử dụng phao câu cá lần đầu tiên được ghi nhận vào năm 1496."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGBOBBER_CANARY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGBOBBER_CANARY"
msgid "The use of a fishing float was first documented in 1496."
msgstr "Việc sử dụng phao câu cá lần đầu tiên được ghi nhận vào năm 1496."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGBOBBER_CROW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGBOBBER_CROW"
msgid "The use of a fishing float was first documented in 1496."
msgstr "Việc sử dụng phao câu cá lần đầu tiên được ghi nhận vào năm 1496."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGBOBBER_GOOSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGBOBBER_GOOSE"
msgid "The large plumage adds a little something special."
msgstr "Bộ lông lớn thêm một chút gì đó đặc biệt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGBOBBER_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGBOBBER_MALBATROSS"
msgid "The large plumage adds a little something special."
msgstr "Bộ lông lớn thêm một chút gì đó đặc biệt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGBOBBER_NONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGBOBBER_NONE"
msgid "A float might improve the rod's accuracy."
msgstr "Một chiếc phao có thể cải thiện độ chính xác của thanh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGBOBBER_OVAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGBOBBER_OVAL"
msgid "The use of a fishing float was first documented in 1496."
msgstr "Việc sử dụng phao câu cá lần đầu tiên được ghi nhận vào năm 1496."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGBOBBER_ROBIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGBOBBER_ROBIN"
msgid "The use of a fishing float was first documented in 1496."
msgstr "Việc sử dụng phao câu cá lần đầu tiên được ghi nhận vào năm 1496."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER"
msgid "The use of a fishing float was first documented in 1496."
msgstr "Việc sử dụng phao câu cá lần đầu tiên được ghi nhận vào năm 1496."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY"
msgid "Fascinating! The spines secrete a potent neurotoxin."
msgstr "Lôi cuốn! Các gai tiết ra một chất độc thần kinh mạnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY"
msgid "This will ensure that I catch a larger specimen."
msgstr "Điều này sẽ đảm bảo rằng tôi bắt được một mẫu vật lớn hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN"
msgid "It seems to work in conjunction with precipitation."
msgstr "Nó dường như hoạt động cùng với lượng mưa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW"
msgid "It would be best utilized in snowy weather."
msgstr "Nó sẽ được sử dụng tốt nhất trong thời tiết có tuyết."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE"
msgid "Its effect appears to be stronger at night."
msgstr "Tác dụng của nó dường như mạnh hơn vào ban đêm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN"
msgid "Its effect appears to be stronger at dusk."
msgstr "Tác dụng của nó dường như mạnh hơn vào lúc hoàng hôn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED"
msgid "Its effect appears to be stronger during the day."
msgstr "Tác dụng của nó dường như mạnh hơn vào ban ngày."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE"
msgid "Its effect appears to be stronger at night."
msgstr "Tác dụng của nó dường như mạnh hơn vào ban đêm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN"
msgid "Its effect appears to be stronger at dusk."
msgstr "Tác dụng của nó dường như mạnh hơn vào lúc hoàng hôn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGLURE_SPOON_RED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGLURE_SPOON_RED"
msgid "Its effect appears to be stronger during the day."
msgstr "Tác dụng của nó dường như mạnh hơn vào ban ngày."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGROD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISHINGROD"
msgid "A sturdy rod for ocean fishing."
msgstr "Cần câu chắc chắn để câu cá biển."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_MEDIUM_1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_MEDIUM_1"
msgid "Oh my... is it supposed to look like that?"
msgstr "Ôi trời... nó có phải trông như vậy không?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_MEDIUM_2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_MEDIUM_2"
msgid "This species usually prefers deeper waters."
msgstr "Loài này thường thích vùng nước sâu hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_MEDIUM_3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_MEDIUM_3"
msgid "Oh dear, I believe these are actually an invasive species."
msgstr "Ôi trời, tôi tin rằng đây thực sự là một loài xâm lấn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_MEDIUM_4
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_MEDIUM_4"
msgid "I've never been superstitious about black cats, never mind a catfish!"
msgstr "Tôi chưa bao giờ mê tín về mèo đen, đừng bận tâm đến cá da trơn!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_MEDIUM_5
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_MEDIUM_5"
msgid "A fascinating blend of animal and vegetable."
msgstr "Một sự kết hợp hấp dẫn giữa động vật và thực vật."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_MEDIUM_6
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_MEDIUM_6"
msgid "It appears to be a subspecies of Cyprinus carpio."
msgstr "Nó dường như là một phân loài của cá chép Cyprinus."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_MEDIUM_7
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_MEDIUM_7"
msgid "It appears to be a subspecies of Cyprinus carpio."
msgstr "Nó dường như là một phân loài của cá chép Cyprinus."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_MEDIUM_8
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_MEDIUM_8"
msgid "All fish are cold-blooded of course, but this is exceptional."
msgstr "Tất nhiên, tất cả các loài cá đều máu lạnh, nhưng điều này thật đặc biệt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_MEDIUM_9
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_MEDIUM_9"
msgid "I surmise that its coloring is a result of its fig-based diet."
msgstr "Tôi phỏng đoán rằng màu sắc của nó là kết quả của chế độ ăn dựa trên quả sung."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_SMALL_1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_SMALL_1"
msgid "A rather dimimutive specimen."
msgstr "Một mẫu vật khá nhỏ bé."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_SMALL_2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_SMALL_2"
msgid "A smaller species of saltwater fish."
msgstr "Một loài cá nước mặn nhỏ hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_SMALL_3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_SMALL_3"
msgid "One of the smaller varieties."
msgstr "Một trong những giống nhỏ hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_SMALL_4
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_SMALL_4"
msgid "I believe they only grow to about this size."
msgstr "Tôi tin rằng chúng chỉ phát triển đến kích thước này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_SMALL_5
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_SMALL_5"
msgid "I don't think I'm familiar with this genus..."
msgstr "Tôi không nghĩ là tôi quen thuộc với thể loại này..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_SMALL_6
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_SMALL_6"
msgid "Curious, it seems to be camouflaged for the wrong environment."
msgstr "Tò mò, nó dường như được ngụy trang cho môi trường không phù hợp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_SMALL_7
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_SMALL_7"
msgid "Oh my, you'd look right at home in my old garden."
msgstr "Ôi trời, bạn sẽ trông như đang ở nhà trong khu vườn cũ của tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_SMALL_8
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_SMALL_8"
msgid "Careful not to look directly at it, dears."
msgstr "Cẩn thận đừng nhìn thẳng vào nó nhé các bạn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_SMALL_9
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANFISH_SMALL_9"
msgid "It's not unlike the Toxotes jaculator, though the coloring is unusual."
msgstr "Nó không khác gì máy phun Toxotes, mặc dù màu sắc không bình thường."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANTREE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANTREE"
msgid "It seems to be a hybrid between the genera Rhizophora and Salix."
msgstr "Nó dường như là sự lai tạo giữa chi Rhizophora và Salix."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANTREENUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANTREENUT"
msgid "Oh my, this seed seems quite eager to grow."
msgstr "Ôi trời, hạt giống này có vẻ khá háo hức muốn phát triển."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANTREE_PILLAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANTREE_PILLAR"
msgid "I was able to recreate the growth conditions, but not to the extent of the original."
msgstr "Tôi đã có thể tạo lại các điều kiện tăng trưởng, nhưng không đến mức như ban đầu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANVINE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANVINE"
msgid "These vines seem to enjoy a symbiotic relationship with the tree."
msgstr "Những cây nho này dường như có mối quan hệ cộng sinh với cây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANVINE_COCOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANVINE_COCOON"
msgid "This species seems to be both arboreal and aquatic."
msgstr "Loài này dường như vừa sống trên cây vừa sống dưới nước."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANVINE_COCOON_BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANVINE_COCOON_BURNT"
msgid "How unfortunate."
msgstr "Thật không may."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANWHIRLBIGPORTALEXIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANWHIRLBIGPORTALEXIT"
msgid "It appears to be sea debris and remnants from our watercraft."
msgstr "Nó dường như là mảnh vụn biển và tàn tích từ tàu thủy của chúng tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANWHIRLPORTAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEANWHIRLPORTAL"
msgid "One typically avoids sailing into a whirlpool, but sense and reason seem to mean nothing in this place."
msgstr "Người ta thường tránh lao vào xoáy nước, nhưng lý trí và lý trí dường như chẳng có ý nghĩa gì ở nơi này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEAN_TRAWLER.CAUGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEAN_TRAWLER.CAUGHT"
msgid "A successful catch."
msgstr "Bắt thành công."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEAN_TRAWLER.ESCAPED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEAN_TRAWLER.ESCAPED"
msgid "Oh dear, it looks like my catch escaped before I could return."
msgstr "Ôi trời, có vẻ như mẻ cá của tôi đã trốn thoát trước khi tôi kịp quay lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEAN_TRAWLER.FIXED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEAN_TRAWLER.FIXED"
msgid "The damage has been mended."
msgstr "Thiệt hại đã được sửa chữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEAN_TRAWLER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEAN_TRAWLER.GENERIC"
msgid "This will make collecting fish much more expedient."
msgstr "Điều này sẽ làm cho việc thu thập cá trở nên thuận tiện hơn nhiều."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEAN_TRAWLER.LOWERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEAN_TRAWLER.LOWERED"
msgid "Patience is a virtue."
msgstr "Kiên nhẫn là một đức tính tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEAN_TRAWLER_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OCEAN_TRAWLER_KIT"
msgid "It's just a simple matter of assembling the pieces."
msgstr "Đó chỉ là vấn đề đơn giản là lắp ráp các mảnh lại với nhau."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OFFERING_POT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OFFERING_POT.GENERIC"
msgid "The merms are known for their love of kelp."
msgstr "Người cá được biết đến với tình yêu dành cho tảo bẹ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OFFERING_POT.LOTS_OF_KELP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OFFERING_POT.LOTS_OF_KELP"
msgid "It's sure to topple if we pile on any more."
msgstr "Chắc chắn nó sẽ sụp đổ nếu chúng ta chất thêm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OFFERING_POT.SOME_KELP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OFFERING_POT.SOME_KELP"
msgid "A little more. They are not yet satiated."
msgstr "Một chút nữa. Họ chưa hài lòng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OFFERING_POT_UPGRADED.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OFFERING_POT_UPGRADED.GENERIC"
msgid "The merms are known for their love of kelp."
msgstr "Người cá được biết đến với tình yêu dành cho tảo bẹ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OFFERING_POT_UPGRADED.LOTS_OF_KELP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OFFERING_POT_UPGRADED.LOTS_OF_KELP"
msgid "It's sure to topple if we pile on any more."
msgstr "Chắc chắn nó sẽ sụp đổ nếu chúng ta chất thêm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OFFERING_POT_UPGRADED.SOME_KELP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OFFERING_POT_UPGRADED.SOME_KELP"
msgid "A little more. They are not yet satiated."
msgstr "Một chút nữa. Họ chưa hài lòng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ONEMANBAND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ONEMANBAND"
msgid "An impressive improvement to the traditional pipe and tabor."
msgstr "Một cải tiến ấn tượng với ống truyền thống và trống nhỏ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ONION
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ONION"
msgid "Edible bulb of Allium cepa."
msgstr "Củ ăn được của Allium cepa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ONION_COOKED"
msgid "Roast Allium cepa."
msgstr "Allium cepa nướng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ONION_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ONION_OVERSIZED"
msgid "A rather large Allium cepa specimen."
msgstr "Một mẫu vật Allium cepa khá lớn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ONION_SEEDS"
msgid "It can't begin growing until it's been planted, dear."
msgstr "Nó không thể bắt đầu phát triển cho đến khi nó được trồng, em yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OPALPRECIOUSGEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OPALPRECIOUSGEM"
msgid "A precious light diffracting mineraloid."
msgstr "Một loại khoáng vật nhiễu xạ ánh sáng quý giá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OPALSTAFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OPALSTAFF"
msgid "Appears to summon a cold star into being."
msgstr "Xuất hiện để triệu hồi một ngôi sao lạnh giá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ORANGEAMULET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ORANGEAMULET"
msgid "The gem fades with each use."
msgstr "Các đá quý mất dần với mỗi lần sử dụng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ORANGEGEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ORANGEGEM"
msgid "It looks like a Spessartite garnet."
msgstr "Nó trông giống như một garnet Spessartite."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ORANGEMOONEYE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ORANGEMOONEYE"
msgid "The fewer search parties we have to organize, the better."
msgstr "Chúng ta phải tổ chức càng ít nhóm tìm kiếm thì càng tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ORANGESTAFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ORANGESTAFF"
msgid "Handy over small distances."
msgstr "Handy trên một khoảng cách nhỏ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OTTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OTTER"
msgid "This beast possess traits of an otter, fish and petty criminal."
msgstr "Con thú này có đặc điểm của một con rái cá, một con cá và một tên tội phạm nhỏ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OTTERDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OTTERDEN.GENERIC"
msgid "Nothing there at all."
msgstr "Không có gì ở đó cả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OTTERDEN.HAS_LOOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OTTERDEN.HAS_LOOT"
msgid "It's left its loot behind."
msgstr "Nó đã để lại chiến lợi phẩm của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OTTERDEN_DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OTTERDEN_DEAD"
msgid "This was utterly avoidable."
msgstr "Điều này hoàn toàn có thể tránh được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PALMCONETREE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PALMCONETREE"
msgid "It appears to be from the family Arecaceae, yet possesses some coniferous characteristics."
msgstr "Nó dường như thuộc họ Arecaceae, nhưng lại có một số đặc điểm của cây lá kim."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PALMCONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PALMCONE_SAPLING"
msgid "It has not yet fully matured."
msgstr "Nó vẫn chưa trưởng thành hoàn toàn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PALMCONE_SCALE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PALMCONE_SCALE"
msgid "A segment of the tree's natural armor."
msgstr "Một đoạn áo giáp tự nhiên của cây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PALMCONE_SEED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PALMCONE_SEED"
msgid "It can't begin growing until it's been planted, dear."
msgstr "Nó không thể bắt đầu phát triển cho đến khi nó được trồng, em yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PANDORASCHEST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PANDORASCHEST"
msgid "An artifact which may contain other artifacts."
msgstr "Một vật có thể chứa đồ tạo tác khác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PANETTONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PANETTONE"
msgid "The origins of this cake trace all the way back to ancient Rome."
msgstr "Nguồn gốc của chiếc bánh này bắt nguồn từ thời La Mã cổ đại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PANFLUTE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PANFLUTE"
msgid "Hollow reeds with harmonic resonance."
msgstr "Cây sậy rỗng với sự cộng hưởng hài hòa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PAPYRUS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PAPYRUS"
msgid "Thin sheets of cellulose and lignin."
msgstr "Tấm mỏng cellulose và lignin."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PAVLOVA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PAVLOVA"
msgid "It takes its name from the Russian ballerina Anna Pavlova."
msgstr "Nó lấy tên từ nữ diễn viên ballet người Nga Anna Pavlova."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEGHOOK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEGHOOK"
msgid "A sentient Scorpiones. How odd."
msgstr "Một Bọ Cạp có tri giác. Thật kỳ lạ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PENGUIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PENGUIN"
msgid "What a classy bird."
msgstr "Thật là một con chim đẳng cấp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PENGUINCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PENGUINCORPSE.BURNING"
msgid "This is, in fact, saving it."
msgstr "Trên thực tế, đây là cách cứu nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PENGUINCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PENGUINCORPSE.GENERIC"
msgid "If only this were the end for the little bird."
msgstr "Giá như đây là kết thúc dành cho chú chim nhỏ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PENGUINCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PENGUINCORPSE.REVIVING"
msgid "The little bird is on a different path now... terrible one."
msgstr "Con chim nhỏ bây giờ đang đi trên một con đường khác... thật khủng khiếp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEPPER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEPPER"
msgid "Of the genus Capsicum, if I'm not mistaken."
msgstr "Thuộc chi Capsicum, nếu tôi không nhầm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEPPERPOPPER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEPPERPOPPER"
msgid "Just a tad spicy for me!"
msgstr "Chỉ là một chút cay đối với tôi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEPPER_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEPPER_COOKED"
msgid "I must be careful not to rub my eyes."
msgstr "Tôi phải cẩn thận để không dụi mắt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEPPER_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEPPER_OVERSIZED"
msgid "The result of proper research, planning and care."
msgstr "Kết quả của việc nghiên cứu, lập kế hoạch và chăm sóc thích hợp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEPPER_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEPPER_SEEDS"
msgid "It can't begin growing until it's been planted, dear."
msgstr "Nó không thể bắt đầu phát triển cho đến khi nó được trồng, em yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PERD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PERD"
msgid "Nasty Meleagris, you stay away from those berries!"
msgstr "Meleagris khốn kiếp, ngươi hãy tránh xa mấy quả mọng đó ra!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PERDFAN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PERDFAN"
msgid "It's quite lovely."
msgstr "Nó khá đáng yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PERDSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PERDSHRINE.BURNT"
msgid "A carbonized structure."
msgstr "Một cấu trúc cacbon hóa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PERDSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PERDSHRINE.EMPTY"
msgid "A bush must be placed to attract the Meleagris."
msgstr "Phải đặt một bụi cây để thu hút Meleagris."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PERDSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PERDSHRINE.GENERIC"
msgid "The native Meleagris flock to it."
msgstr "Người Meleagris bản địa đổ xô đến đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEROGIES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEROGIES"
msgid "A wonderfully bland dumpling."
msgstr "Một bánh bao tuyệt vời nhạt nhẽo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PETALS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PETALS"
msgid "Now it's a delightful handful of potpourri."
msgstr "Bây giờ nó là một nắm potpourri thú vị."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PETALS_DRIED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PETALS_DRIED"
msgid "The drying process enhances the aroma."
msgstr "Quá trình sấy khô tăng cường hương thơm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PETALS_EVIL"
msgid "Interesting. These petals seem to have a mind of their own."
msgstr "Hấp dẫn. Những cánh hoa này dường như có suy nghĩ riêng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PETALS_EVIL_DRIED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PETALS_EVIL_DRIED"
msgid "The drying process enhances the aroma."
msgstr "Quá trình sấy khô tăng cường hương thơm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PETRIFIED_TREE"
msgid "Should make for an excellent building material."
msgstr "Nên làm cho một vật liệu xây dựng tuyệt vời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PHLEGM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PHLEGM"
msgid "The congealed mucus retains its sticky texture."
msgstr "Chất nhầy đông lại vẫn giữ được kết cấu dính."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PHONOGRAPH"
msgid "The music was better back in my day."
msgstr "Âm nhạc đã trở lại tốt hơn vào thời của tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PICKAXE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PICKAXE"
msgid "A specialized axe for chipping away at rocks."
msgstr "Một chiếc rìu chuyên cho chạp đá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PICKAXE_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PICKAXE_LUNARPLANT"
msgid "A surprisingly effective mining and crushing implement."
msgstr "Một công cụ khai thác và nghiền hiệu quả đáng ngạc nhiên."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PICKLEDHERRING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PICKLEDHERRING"
msgid "I do enjoy some pickled herring around the holidays."
msgstr "Tôi rất thích ăn cá trích ngâm trong những ngày nghỉ lễ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITE1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITE1"
msgid "He's saturated with markings."
msgstr "Anh ấy đã bão hòa với các dấu hiệu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITE2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITE2"
msgid "Rather hot-tempered."
msgstr "Khá nóng tính."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITE3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITE3"
msgid "Has an earthy musk to him."
msgstr "Có một mùi xạ hương đất cho anh ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITE4
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITE4"
msgid "I wonder what those green markings signify."
msgstr "Tôi tự hỏi những dấu hiệu màu xanh lá cây đó có ý nghĩa gì."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITEFIGHTER1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITEFIGHTER1"
msgid "He's saturated with markings."
msgstr "Anh ấy đã bão hòa với các dấu hiệu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITEFIGHTER2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITEFIGHTER2"
msgid "Rather hot-tempered."
msgstr "Khá nóng tính."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITEFIGHTER3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITEFIGHTER3"
msgid "Has an earthy musk to him."
msgstr "Có một mùi xạ hương đất cho anh ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITEFIGHTER4
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITEFIGHTER4"
msgid "I wonder what those green markings signify."
msgstr "Tôi tự hỏi những dấu hiệu màu xanh lá cây đó có ý nghĩa gì."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGGUARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGGUARD"
msgid "One of the warrior caste."
msgstr "Một trong những đẳng cấp chiến binh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGGYBACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGGYBACK"
msgid "A face only necessity could love."
msgstr "Một khuôn mặt chỉ vì nhu cầu có thể yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHEAD.BURNT"
msgid "It's the charred remains of a head on a stick. Tsk!"
msgstr "Đó là phần còn lại cháy đen của một cái đầu trên một cây gậy. Chậc!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHEAD.GENERIC"
msgid "Tut tut. It's a head on a stick."
msgstr "Tut tut. Đó là một cái đầu trên một cây gậy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHOUSE.BURNT"
msgid "The house had no fire-prevention system."
msgstr "Ngôi nhà không có hệ thống phòng cháy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHOUSE.FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHOUSE.FULL"
msgid "I wonder what they do in there."
msgstr "Tôi tự hỏi họ làm gì trong đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHOUSE.GENERIC"
msgid "The pig creatures have such prosaic taste in architecture."
msgstr "Các sinh vật lợn có hương vị tầm thường như vậy trong kiến trúc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHOUSE.LIGHTSOUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHOUSE.LIGHTSOUT"
msgid "That was quite rude."
msgstr "Đó là khá thô lỗ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGKING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGKING"
msgid "He appears to be the leader of the village."
msgstr "Ông dường như là thủ lĩnh của làng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN.DEAD"
msgid "Don't worry, there are plenty more where that came from."
msgstr "Đừng lo lắng, còn rất nhiều điều khác đến từ đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN.FOLLOWER"
msgid "He seems to have bonded with me."
msgstr "Ông dường như đã gắn bó với tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN.GENERIC"
msgid "It's a semi-intelligent bipedal pig."
msgstr "Đó là một con lợn hai chân bán thông minh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN.GUARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN.GUARD"
msgid "It appears to be a guardian."
msgstr "Nó dường như là một người giám hộ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN.WEREPIG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN.WEREPIG"
msgid "It's a lycanthropic pig."
msgstr "Đó là một con lợn lycanthropic."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGSHRINE.BURNT"
msgid "No use to me like this."
msgstr "Không có ích gì cho tôi như thế này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGSHRINE.EMPTY"
msgid "It needs a sacrifice of meat."
msgstr "Nó cần một sự hy sinh thịt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGSHRINE.GENERIC"
msgid "A Porcine tribute."
msgstr "Một cống phẩm của Porcine."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGSKIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGSKIN"
msgid "The haunch of a semi-intelligent bipedal pig."
msgstr "Các quầy thịt của một con lợn hai chân bán thông minh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGTENT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGTENT"
msgid "Filthy."
msgstr "Bẩn thỉu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGTORCH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGTORCH"
msgid "I wonder how it's fueled."
msgstr "Tôi tự hỏi làm thế nào nó được thúc đẩy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_COIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_COIN"
msgid "A boon from the Pig King."
msgstr "Một lợi ích từ Vua Lợn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_TOKEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_TOKEN"
msgid "How did they manage to achieve such detail using pig hooves?"
msgstr "Làm sao họ có thể đạt được chi tiết như vậy bằng móng lợn?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PINECONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PINECONE"
msgid "Conifer seeds encased in a mature strobilus."
msgstr "Hạt lá kim được bọc trong một cây strobilus trưởng thành."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PINECONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PINECONE_SAPLING"
msgid "Conifer seeds approaching maturity."
msgstr "Hạt lá kim sắp trưởng thành."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIRATE_FLAG_POLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIRATE_FLAG_POLE"
msgid "Oh dear. That does not bode well."
msgstr "Ôi trời ơi. Điều đó không tốt chút nào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIRATE_STASH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIRATE_STASH"
msgid "That appears to be the location indicated on the map."
msgstr "Đó dường như là vị trí được chỉ định trên bản đồ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PITCHFORK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PITCHFORK"
msgid "Its design is effective at loosening earth."
msgstr "Thiết kế của nó có hiệu quả trong việc nới lỏng trái đất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANTMEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANTMEAT"
msgid "The plant produced a meaty substance."
msgstr "Các nhà máy sản xuất một chất thịt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANTMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANTMEAT_COOKED"
msgid "This looks much safer for consumption."
msgstr "Điều này có vẻ an toàn hơn nhiều cho tiêu dùng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANTREGISTRYHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANTREGISTRYHAT"
msgid "It seems to be a wearable directory of sorts, detailing various plant strains."
msgstr "Nó dường như là một loại thư mục có thể đeo được, trình bày chi tiết các chủng loại thực vật khác nhau."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANT_NORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANT_NORMAL.GENERIC"
msgid "It's a... plant. Of some kind."
msgstr "Đó là một ... nhà máy. Của một số loại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANT_NORMAL.GROWING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANT_NORMAL.GROWING"
msgid "It is not yet ready for harvest."
msgstr "Nó vẫn chưa sẵn sàng cho thu hoạch."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANT_NORMAL.READY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANT_NORMAL.READY"
msgid "It looks mature, now."
msgstr "Có vẻ trưởng thành, bây giờ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANT_NORMAL.WITHERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANT_NORMAL.WITHERED"
msgid "It couldn't survive the heat."
msgstr "Nó không thể tồn tại sự nhiệt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYBILL_THE_DOLL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYBILL_THE_DOLL"
msgid "I suspect there's a deeper meaning to its storyline."
msgstr "Tôi nghi ngờ có một ý nghĩa sâu sắc hơn trong cốt truyện của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYBILL_THE_PRINCESS_YOTH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYBILL_THE_PRINCESS_YOTH"
msgid "There is a rather dark metaphor here."
msgstr "Có một ẩn dụ khá đen tối ở đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYBILL_THE_VAULT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYBILL_THE_VAULT"
msgid "It's more a confession or retelling of events than a stage play."
msgstr "Đó là một lời thú nhận hoặc kể lại các sự kiện hơn là một vở kịch trên sân khấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYBILL_THE_VEIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYBILL_THE_VEIL"
msgid "Rather on-the-nose, if you ask me."
msgstr "Nếu bạn hỏi tôi thì khá là thẳng thắn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.ATTACKER"
msgid "That no good %s is up to no good."
msgstr "Việc không tốt %s có nghĩa là không tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.FIRESTARTER"
msgid "%s, what have I told you about lighting fires?"
msgstr "%s, tôi đã nói gì với bạn về việc đốt lửa?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.GENERIC"
msgid "Ah, greetings dear %s!"
msgstr "À, xin chào %s thân mến!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.GHOST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.GHOST"
msgid "Poor dear. %s needs a heart to anchor them to this plane."
msgstr "Thân nghèo. %s cần một trái tim để neo chúng vào mặt phẳng này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.MURDERER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.MURDERER"
msgid "I'll erase you from the history books!"
msgstr "Tôi sẽ xóa bạn khỏi sử sách!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.REVIVER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.REVIVER"
msgid "I appreciate your commitment to group survival, %s."
msgstr "Tôi đánh giá cao cam kết của bạn đối với sự tồn tại của nhóm, %s."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER_HOSTED.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER_HOSTED.GENERIC"
msgid "An unsubtle reminder of one's own mortality."
msgstr "Một lời nhắc nhở sâu sắc về cái chết của chính mình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER_HOSTED.ME
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER_HOSTED.ME"
msgid "How undignified."
msgstr "Thật là thiếu phẩm giá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYING_CARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYING_CARD"
msgid "Who's missing a card?"
msgstr "Ai đang thiếu thẻ?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_DISMANTLER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_DISMANTLER"
msgid "These tools are specialized for clockmaking."
msgstr "Những công cụ này chuyên dụng cho việc chế tạo đồng hồ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_HEAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_HEAL.GENERIC"
msgid "Horology mixed with magic, truly fascinating."
msgstr "Tử vi xen lẫn phép thuật, thực sự hấp dẫn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_HEAL.RECHARGING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_HEAL.RECHARGING"
msgid "It appears to require some time to replenish its power between uses."
msgstr "Có vẻ như cần một thời gian để bổ sung sức mạnh giữa các lần sử dụng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_PARTS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_PARTS"
msgid "It appears these pieces of clockwork have been infused with shadow fuel."
msgstr "Có vẻ như những mảnh đồng hồ này đã được truyền nhiên liệu bóng tối."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_PORTAL.GENERIC"
msgid "Horology mixed with magic, truly fascinating."
msgstr "Tử vi xen lẫn phép thuật, thực sự hấp dẫn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_PORTAL.RECHARGING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_PORTAL.RECHARGING"
msgid "It appears to require some time to replenish its power between uses."
msgstr "Có vẻ như cần một thời gian để bổ sung sức mạnh giữa các lần sử dụng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.DIFFERENTSHARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.DIFFERENTSHARD"
msgid "Magic triggered by a clockwork mechanism, how fascinating!"
msgstr "Phép thuật được kích hoạt bởi cơ chế kim đồng hồ, thật hấp dẫn!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.GENERIC"
msgid "Magic triggered by a clockwork mechanism, how fascinating!"
msgstr "Phép thuật được kích hoạt bởi cơ chế kim đồng hồ, thật hấp dẫn!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_PORTAL_EXIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_PORTAL_EXIT"
msgid "I wonder if she would allow me to write down my observations..."
msgstr "Tôi tự hỏi liệu cô ấy có cho phép tôi viết ra những quan sát của mình không..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_RECALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_RECALL.GENERIC"
msgid "Horology mixed with magic, truly fascinating."
msgstr "Tử vi xen lẫn phép thuật, thực sự hấp dẫn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_RECALL.RECHARGING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_RECALL.RECHARGING"
msgid "It appears to require some time to replenish its power between uses."
msgstr "Có vẻ như cần một thời gian để bổ sung sức mạnh giữa các lần sử dụng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_REVIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_REVIVE.GENERIC"
msgid "Horology mixed with magic, truly fascinating."
msgstr "Tử vi xen lẫn phép thuật, thực sự hấp dẫn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_REVIVE.RECHARGING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_REVIVE.RECHARGING"
msgid "It appears to require some time to replenish its power between uses."
msgstr "Có vẻ như cần một thời gian để bổ sung sức mạnh giữa các lần sử dụng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_WARP.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_WARP.GENERIC"
msgid "Horology mixed with magic, truly fascinating."
msgstr "Tử vi xen lẫn phép thuật, thực sự hấp dẫn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_WARP.RECHARGING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_WARP.RECHARGING"
msgid "It appears to require some time to replenish its power between uses."
msgstr "Có vẻ như cần một thời gian để bổ sung sức mạnh giữa các lần sử dụng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_WEAPON.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKETWATCH_WEAPON.GENERIC"
msgid "A handy bit of pocket-sized weaponry."
msgstr "Một chút vũ khí bỏ túi tiện dụng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKET_SCALE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POCKET_SCALE"
msgid "I'm always prepared to weigh in."
msgstr "Tôi luôn sẵn sàng cân nhắc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POLISHCOOKIE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POLISHCOOKIE"
msgid "Now it feels like the holidays."
msgstr "Bây giờ nó cảm thấy như những ngày nghỉ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POLLY_ROGERS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POLLY_ROGERS"
msgid "Please squawk with your inside voice, dear."
msgstr "Hãy hét lên bằng giọng nói nội tâm của bạn, em yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POLLY_ROGERSHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POLLY_ROGERSHAT"
msgid "A bit ostentatious for my taste."
msgstr "Một chút phô trương cho khẩu vị của tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POMEGRANATE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POMEGRANATE"
msgid "Punica granatum. Watery, sweet and a bit sour."
msgstr "Punica granatum. Chảy nước, ngọt và một chút chua."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POMEGRANATE_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POMEGRANATE_COOKED"
msgid "Punica granatum is so nice when it's warmed up."
msgstr "Punica granatum vậy là tốt đẹp khi nó ấm lên."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POMEGRANATE_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POMEGRANATE_OVERSIZED"
msgid "A rather large Punica granatum specimen."
msgstr "Mẫu vật Punica granatum khá lớn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POMEGRANATE_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POMEGRANATE_SEEDS"
msgid "It can't begin growing until it's been planted, dear."
msgstr "Nó không thể bắt đầu phát triển cho đến khi nó được trồng, em yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POND"
msgid "A small but deep freshwater pond."
msgstr "Một ao nước ngọt nhỏ nhưng sâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PONDEEL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PONDEEL"
msgid "It's an eel."
msgstr "Đó là một con lươn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PONDFISH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PONDFISH"
msgid "Some kind of whitefish, I believe."
msgstr "Một số loại cá thịt trắng, tôi tin."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POND_ALGAE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POND_ALGAE"
msgid "It is a good thing this algae has no need for photosynthesis."
msgstr "Đó là một điều tốt tảo này không có nhu cầu quang hợp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POOP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POOP"
msgid "A quantity of animal feces. How fragrant."
msgstr "Một số lượng phân động vật. Làm thế nào có mùi thơm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PORTABLEBLENDER_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PORTABLEBLENDER_ITEM"
msgid "Quite a lively cooking instrument."
msgstr "Một dụng cụ nấu ăn khá sống động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG"
msgid "Patience is a virtue!"
msgstr "Kiên nhẫn là một đức tính tốt!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT"
msgid "This will be finished in no time at all."
msgstr "Điều này sẽ được hoàn thành trong thời gian không lâu nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE"
msgid "Smells nourishing."
msgstr "Mùi thơm bổ dưỡng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY"
msgid "Hm, perhaps I'll whip something up."
msgstr "Hm, có lẽ tôi sẽ làm gì đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC"
msgid "It will be nice to eat some properly prepared food."
msgstr "Sẽ thật tuyệt khi ăn một số thực phẩm được chuẩn bị đúng cách."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PORTABLEFIREPIT_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PORTABLEFIREPIT_ITEM"
msgid "A travelling heat source. Useful if handled with due caution."
msgstr "Một nguồn nhiệt di chuyển. Hữu ích nếu xử lý một cách thận trọng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PORTABLESPICER_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PORTABLESPICER_ITEM.DONE"
msgid "The flavoring is ready for use."
msgstr "Hương liệu đã sẵn sàng để sử dụng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PORTABLESPICER_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PORTABLESPICER_ITEM.GENERIC"
msgid "It'll need some elbow grease."
msgstr "Nó sẽ cần một ít mỡ khuỷu tay."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PORTABLETENT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PORTABLETENT"
msgid "It's a lovely tent, but I'm afraid I don't have much use for it."
msgstr "Đó là một cái lều xinh xắn, nhưng tôi e rằng tôi không có nhiều công dụng với nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PORTABLETENT_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PORTABLETENT_ITEM"
msgid "How very practical."
msgstr "Làm thế nào rất thực tế."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POTATO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POTATO"
msgid "Solanum tuberosum, a staple in some cultures."
msgstr "Solanum tuberosum, một loại thực phẩm chủ yếu ở một số nền văn hóa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POTATOSACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POTATOSACK"
msgid "He seems to have a deep fondness for tubers."
msgstr "Anh ấy có vẻ rất yêu thích các loại củ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POTATOSOUFFLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POTATOSOUFFLE"
msgid "It looks lovely, dear."
msgstr "Trông thật đáng yêu, em yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POTATOTORNADO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POTATOTORNADO"
msgid "How creative!"
msgstr "Thật sáng tạo!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POTATO_COOKED"
msgid "Roasted Solanum tuberosum."
msgstr "Solanum tuberosum rang."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POTATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POTATO_OVERSIZED"
msgid "A rather impressive tuber!"
msgstr "Một củ khá ấn tượng!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POTATO_SEEDS"
msgid "It can't begin growing until it's been planted, dear."
msgstr "Nó không thể bắt đầu phát triển cho đến khi nó được trồng, em yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POTTEDFERN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POTTEDFERN"
msgid "A potted plant."
msgstr "Một chậu cây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POWCAKE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POWCAKE"
msgid "The crowning achievement of the agricultural-industrial complex."
msgstr "Các thành tựu của khu phức hợp nông-công nghiệp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POWDER_MONKEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POWDER_MONKEY"
msgid "Such deplorable manners! You need a good talking to!"
msgstr "Cách cư xử đáng trách như vậy! Bạn cần một cuộc nói chuyện thú vị!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PREMIUMWATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PREMIUMWATERINGCAN.EMPTY"
msgid "I'll have to fill it with water before it's usable."
msgstr "Tôi sẽ phải đổ đầy nước vào trước khi sử dụng được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PREMIUMWATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PREMIUMWATERINGCAN.GENERIC"
msgid "A bit unconventional, but an effective irrigation tool nevertheless."
msgstr "Tuy nhiên, hơi độc đáo nhưng lại là một công cụ tưới hiệu quả."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PRIME_MATE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PRIME_MATE"
msgid "What odd coloration. A form of aposematism, perhaps?"
msgstr "Màu sắc kỳ lạ làm sao. Có lẽ là một hình thức của chủ nghĩa ngụy biện?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUFFIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUFFIN.GENERIC"
msgid "What a dear Fratercula corniculata!"
msgstr "Thật là một Fratercula corniculata thân mến!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUFFIN.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUFFIN.HELD"
msgid "There there, now."
msgstr "Ở đó, bây giờ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUFFIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUFFIN.SLEEPING"
msgid "It's in a deep sleep."
msgstr "Nó đang trong giấc ngủ sâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKIN"
msgid "Cucurbita pepo."
msgstr "Cucurbita pepo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKINCARVER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKINCARVER"
msgid "I have carved many pumpkins in my day, and I was quite skilled."
msgstr "Tôi đã khắc nhiều quả bí ngô trong ngày của mình, và tôi khá có tài."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKINCOOKIE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKINCOOKIE"
msgid "Pumpkin biscuits, goody!"
msgstr "Bánh quy bí ngô, ngon quá!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKINHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKINHAT.GENERIC"
msgid "It does call to mind Ichabod's ill-fated encounter."
msgstr "Nó gợi nhớ đến cuộc gặp gỡ định mệnh của Ichabod."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKINHAT.UNCARVED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKINHAT.UNCARVED"
msgid "The pumpkin requires a face before one can wear it."
msgstr "Quả bí ngô cần có khuôn mặt trước khi người ta có thể đeo nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKINPIE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKINPIE"
msgid "Perhaps just a nibble..."
msgstr "Có lẽ chỉ là một miếng cắn nhẹ..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKIN_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKIN_COOKED"
msgid "Cooked Cucurbita pepo. Gooey and delicious."
msgstr "Nấu Cucurbita pepo. Dính và ngon."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKIN_LANTERN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKIN_LANTERN"
msgid "Carving the Cucurbita pepo is such a nice pastime."
msgstr "Khắc Cucurbita pepo là một trò tiêu khiển tốt đẹp như vậy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKIN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKIN_OVERSIZED"
msgid "A wonderfully plump squash."
msgstr "Một quả bí đầy đặn tuyệt vời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKIN_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKIN_SEEDS"
msgid "It can't begin growing until it's been planted, dear."
msgstr "Nó không thể bắt đầu phát triển cho đến khi nó được trồng, em yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUNCHINGBAG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUNCHINGBAG"
msgid "A useful tool for testing a weapon's efficacy."
msgstr "Một công cụ hữu ích để kiểm tra hiệu quả của vũ khí."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUREBRILLIANCE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUREBRILLIANCE"
msgid "Pure energy, in a crystalline form."
msgstr "Năng lượng tinh khiết, ở dạng tinh thể."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PURPLEAMULET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PURPLEAMULET"
msgid "I can almost sense it beckoning to something."
msgstr "Tôi gần như có thể cảm nhận nó vẫy tay gọi một cái gì đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PURPLEGEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PURPLEGEM"
msgid "It gives off a strange aura."
msgstr "Nó phát ra một luồng khí lạ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PURPLEMOONEYE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PURPLEMOONEYE"
msgid "A tool to mark our whereabouts."
msgstr "Một công cụ để đánh dấu nơi ở của chúng tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR.FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR.FULL"
msgid "That should tide it over while I prepare our next dish."
msgstr "Điều đó sẽ giải quyết được vấn đề trong khi tôi chuẩn bị món ăn tiếp theo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR.GENERIC"
msgid "What is this \"Gnaw\", I wonder?"
msgstr "Tôi tự hỏi \"Gnaw\" này là gì?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD"
msgid "A nice enough bollard."
msgstr "Một bollard đủ đẹp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR_IVY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR_IVY"
msgid "Something in the Hedera family."
msgstr "Một cái gì đó trong gia đình Hedera."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR_QUEEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR_QUEEN"
msgid "Impressive in scope."
msgstr "Ấn tượng về phạm vi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR_STATUE1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR_STATUE1"
msgid "Decrepit statuary."
msgstr "Bức tượng hư hỏng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR_STATUE2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR_STATUE2"
msgid "A gruesome gargoyle."
msgstr "Một con Gargoyle khủng khiếp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_BEEFALO"
msgid "Years past its life expectancy."
msgstr "Nhiều năm qua tuổi thọ của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_BERRYBUSH"
msgid "Those berries need time to grow back. Time I don't have."
msgstr "Những quả mọng đó cần thời gian để phát triển trở lại. Thời gian tôi không có."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_BOWL_SILVER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_BOWL_SILVER"
msgid "There are so many uses for a bowl."
msgstr "Có rất nhiều công dụng của một chiếc bát."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CARROT_SEEDS"
msgid "Mutated seed of Daucus carota."
msgstr "Hạt giống Daucus carota bị đột biến."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CASSEROLEDISH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CASSEROLEDISH"
msgid "I do love a good casserole."
msgstr "Tôi rất thích một món thịt hầm ngon."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL"
msgid "Enough for one."
msgstr "Đủ cho một."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_COIN1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_COIN1"
msgid "Worth a paltry sum to the locals."
msgstr "Đáng giá một khoản tiền nhỏ cho người dân địa phương."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_COIN2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_COIN2"
msgid "A coin of some denomination."
msgstr "Một đồng xu có mệnh giá nào đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_COIN3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_COIN3"
msgid "A coin of some value."
msgstr "Một đồng tiền có giá trị nào đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_COIN4
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_COIN4"
msgid "It's made of a sort of condensed magic."
msgstr "Nó được làm từ một loại phép thuật cô đặc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CRABMEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CRABMEAT"
msgid "Raw Paralithodes meat."
msgstr "Thịt Paralithodes sống."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED"
msgid "It no longer presents a threat of salmonellosis."
msgstr "Nó không còn là mối đe dọa của bệnh nhiễm khuẩn salmonella."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CRABTRAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CRABTRAP"
msgid "For trapping sea creatures."
msgstr "Để bẫy sinh vật biển."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FERN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FERN"
msgid "This species of fern is edible."
msgstr "Loại dương xỉ này có thể ăn được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FLOUR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FLOUR"
msgid "Ground Triticum aestivum grain."
msgstr "Hạt Triticum aestivum xay."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
msgid "I believe we could have prepared it better."
msgstr "Tôi tin rằng chúng tôi có thể đã chuẩn bị nó tốt hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOOD.GENERIC"
msgid "I suppose it's ready for the altar."
msgstr "Tôi cho rằng nó đã sẵn sàng cho bàn thờ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOOD.MATCH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOOD.MATCH"
msgid "The exact thing to placate the great wyrm."
msgstr "Điều chính xác để xoa dịu con Wyrm vĩ đại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK"
msgid "It's the correct food, although an insufficient amount."
msgstr "Đó là thực phẩm phù hợp, mặc dù số lượng chưa đủ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOOD.MISMATCH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOOD.MISMATCH"
msgid "Not the proper dish for the great wyrm."
msgstr "Không phải là món ăn thích hợp cho món wyrm tuyệt vời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOOD_BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOOD_BURNT"
msgid "Completely carbonized."
msgstr "Bị cacbon hóa hoàn toàn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GARLIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GARLIC"
msgid "Allium sativum, a close relative of Allium cepa."
msgstr "Allium sativum, họ hàng gần của Allium cepa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GARLIC_COOKED"
msgid "Roast Allium sativum."
msgstr "Nướng Allium sativum."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GARLIC_SEEDS"
msgid "Mutated seed of Allium sativum."
msgstr "Hạt đột biến của Allium sativum."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GOATKID
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GOATKID"
msgid "A sweet bipedal Bovidae adolescent."
msgstr "Một chú Bovidae hai chân ngọt ngào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GOATMILK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GOATMILK"
msgid "I shan't question its origins."
msgstr "Tôi sẽ không đặt câu hỏi về nguồn gốc của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GOATMUM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GOATMUM"
msgid "Perhaps she would be willing to barter."
msgstr "Có lẽ cô ấy sẽ sẵn lòng trao đổi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GRILL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GRILL"
msgid "Perhaps some barbeque is in order."
msgstr "Có lẽ sẽ có món nướng nào đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GRILL_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GRILL_ITEM"
msgid "It needs to be on the ground."
msgstr "Nó cần phải ở trên mặt đất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GRILL_SMALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GRILL_SMALL"
msgid "Smaller than normal, but it'll do."
msgstr "Nhỏ hơn bình thường, nhưng nó sẽ làm được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM"
msgid "I need to put it down somewhere to use it."
msgstr "Tôi cần phải đặt nó ở đâu đó để sử dụng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_HOE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_HOE"
msgid "It can be used to till fertile soil."
msgstr "Nó có thể được sử dụng để làm đất màu mỡ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_KEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_KEY"
msgid "I shall have to see what this unlocks."
msgstr "Tôi sẽ phải xem cái này mở ra cái gì."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_KEY_PARK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_KEY_PARK"
msgid "I believe this is for the park."
msgstr "Tôi tin rằng đây là dành cho công viên."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_LAMP_POST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_LAMP_POST"
msgid "What is it powered by, I wonder?"
msgstr "Tôi tự hỏi nó được cung cấp năng lượng bởi cái gì?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_LAMP_SHORT"
msgid "It's a nice enough light."
msgstr "Đó là một ánh sáng đủ đẹp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MEALINGSTONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MEALINGSTONE"
msgid "For mechanically powdering our ingredients."
msgstr "Để nghiền bột các thành phần của chúng tôi một cách máy móc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MERMHOUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MERMHOUSE"
msgid "Home of the local piscean bipeds."
msgstr "Ngôi nhà của loài song ngư địa phương."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MERM_CART1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MERM_CART1"
msgid "Reminds me of my bookmobile days."
msgstr "Làm tôi nhớ lại những ngày di chuyển sách của mình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MERM_CART2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MERM_CART2"
msgid "There are wares within."
msgstr "Có hàng hóa bên trong."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MUSHROOMS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MUSHROOMS"
msgid "I'm not familiar with the species, though it is edible."
msgstr "Tôi không quen thuộc với loài này, mặc dù nó có thể ăn được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC"
msgid "A wild cluster of edible mushrooms."
msgstr "Một cụm nấm ăn được hoang dã."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED"
msgid "I don't think they'll grow back."
msgstr "Tôi không nghĩ chúng sẽ mọc lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ONION
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ONION"
msgid "Edible bulb of Allium cepa."
msgstr "Củ ăn được của Allium cepa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ONION_COOKED"
msgid "Roast Allium cepa."
msgstr "Allium cepa nướng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ONION_SEEDS"
msgid "Mutated seed of Allium cepa."
msgstr "Hạt đột biến của Allium cepa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_OVEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_OVEN"
msgid "It is best suited to baking sweets."
msgstr "Nó phù hợp nhất để nướng đồ ngọt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_OVEN_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_OVEN_ITEM"
msgid "All the parts are necessary to construct a fully functional oven."
msgstr "Tất cả các bộ phận đều cần thiết để xây dựng một lò nướng đầy đủ chức năng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARKSPIKE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARKSPIKE"
msgid "Wrought iron, it seems."
msgstr "Có vẻ như là sắt rèn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_ANGEL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_ANGEL"
msgid "Quite an interesting sculpture."
msgstr "Một tác phẩm điêu khắc khá thú vị."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_ANGEL2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_ANGEL2"
msgid "Rather ghoulish monument."
msgstr "Tượng đài khá ma quái."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN"
msgid "A pity. I always enjoyed a good fountain."
msgstr "Một điều đáng tiếc. Tôi luôn thích một đài phun nước tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC"
msgid "We should have full access now."
msgstr "Chúng ta nên có toàn quyền truy cập ngay bây giờ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED"
msgid "It needs a key to open."
msgstr "Nó cần một chìa khóa để mở."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_OBELISK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_OBELISK"
msgid "I wish I could read the writing."
msgstr "Tôi ước gì tôi có thể đọc được bài viết."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_URN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_URN"
msgid "I wonder who's ashes those are."
msgstr "Tôi tự hỏi tro cốt đó là ai."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PEBBLECRAB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PEBBLECRAB"
msgid "I should like to study its shell more closely."
msgstr "Tôi muốn nghiên cứu lớp vỏ của nó kỹ hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PIGEON.DEAD"
msgid "Deceased."
msgstr "Người chết."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PIGEON.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PIGEON.GENERIC"
msgid "An agreeable member of the Columbidae family."
msgstr "Một thành viên dễ chịu của gia đình Columbidae."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING"
msgid "It has entered the REM stage of sleep."
msgstr "Nó đã bước vào giai đoạn REM của giấc ngủ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PLATE_SILVER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PLATE_SILVER"
msgid "I did miss proper dishware."
msgstr "Tôi đã bỏ lỡ bộ đồ ăn thích hợp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POND_SALT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POND_SALT"
msgid "It is a natural spring of sodium-infused water."
msgstr "Đó là một nguồn nước tự nhiên chứa natri."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PORTAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PORTAL"
msgid "My suspicions were correct. It has more than one destination."
msgstr "Sự nghi ngờ của tôi đã đúng. Nó có nhiều hơn một điểm đến."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PORTAL_KEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PORTAL_KEY"
msgid "Quite an elaborate key."
msgstr "Một chiếc chìa khóa khá phức tạp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POT"
msgid "A larger pot takes longer to boil."
msgstr "Nồi lớn hơn sẽ mất nhiều thời gian hơn để đun sôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POTATO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POTATO"
msgid "Solanum tuberosum, a staple in some cultures."
msgstr "Solanum tuberosum, một loại thực phẩm chủ yếu ở một số nền văn hóa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POTATO_COOKED"
msgid "Roasted Solanum tuberosum."
msgstr "Solanum tuberosum rang."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POTATO_SEEDS"
msgid "Mutated seed of Solanum tuberosum."
msgstr "Hạt đột biến của Solanum tuberosum."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POT_HANGER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POT_HANGER"
msgid "Traditionally one hangs a pot from it."
msgstr "Theo truyền thống, người ta treo một cái chậu lên đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM"
msgid "The old fashioned way to cook over a fire."
msgstr "Cách nấu ăn cổ điển trên lửa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POT_SMALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POT_SMALL"
msgid "Hmmm, what shall we make next?"
msgstr "Hmmm, tiếp theo chúng ta sẽ làm gì đây?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POT_SYRUP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POT_SYRUP"
msgid "It needs sap."
msgstr "Nó cần nhựa cây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ROTTEN_CROP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ROTTEN_CROP"
msgid "The soil in this realm is fetid."
msgstr "Đất ở cõi này hôi hám."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_BIKE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_BIKE"
msgid "Beyond repair."
msgstr "Ngoài việc sửa chữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE"
msgid "The remnants of a once thriving culture."
msgstr "Những tàn tích của một nền văn hóa thịnh vượng một thời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL"
msgid "Interesting. It appears they didn't worship Gnaw."
msgstr "Hấp dẫn. Có vẻ như họ không tôn thờ Gnaw."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY"
msgid "Something must have knocked it down."
msgstr "Chắc chắn có thứ gì đó đã đánh rơi nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2"
msgid "It's crumbling."
msgstr "Nó đang sụp đổ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK"
msgid "Antiquated but not without sophistication."
msgstr "Cổ kính nhưng không thiếu sự tinh tế."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER"
msgid "The clockwork has seized as well."
msgstr "Đồng hồ cũng đã hoạt động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1"
msgid "What creatures once lived here?"
msgstr "Những sinh vật nào từng sống ở đây?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2"
msgid "There's nothing left of the inhabitants."
msgstr "Không còn gì của cư dân."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3"
msgid "What caused this city to crumble?"
msgstr "Điều gì đã khiến thành phố này sụp đổ?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR"
msgid "The door to a public house."
msgstr "Cánh cửa vào một ngôi nhà công cộng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_ROOF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_RUBBLE_ROOF"
msgid "It has collapsed."
msgstr "Nó đã sụp đổ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SAFE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SAFE.GENERIC"
msgid "This city's former inhabitants had stashed goods within."
msgstr "Những cư dân trước đây của thành phố này đã cất giữ hàng hóa bên trong."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SAFE.LOCKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SAFE.LOCKED"
msgid "Surely there's an accompanying key."
msgstr "Chắc chắn có key đi kèm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SALMON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SALMON"
msgid "Mmmm! Oncorhynchus nerka!"
msgstr "Ừm! Oncorhynchus nerka!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SALMON_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SALMON_COOKED"
msgid "Seared oncorhynchus nerka."
msgstr "Nấm oncorhynchus nerka bị cháy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SALT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SALT"
msgid "Sodium chloride. Also known as table salt."
msgstr "Natri clorua. Còn được gọi là muối ăn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SALTROCK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SALTROCK"
msgid "Clusters of unprocessed sodium chloride."
msgstr "Các cụm natri clorua chưa qua chế biến."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC"
msgid "Salt deposits should form on the rack soon."
msgstr "Các cặn muối sẽ sớm hình thành trên giá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SALT_RACK.READY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SALT_RACK.READY"
msgid "Enough salt has crystallized to harvest."
msgstr "Muối đã kết tinh đủ để thu hoạch."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
msgid "We ought to put it up by the sodium spring."
msgstr "Chúng ta nên đặt nó lên cạnh lò xo natri."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SAP"
msgid "This tree sap has extraordinary glucose content."
msgstr "Nhựa cây này có hàm lượng glucose đặc biệt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SAPBUCKET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SAPBUCKET"
msgid "A simple implement for tapping trees."
msgstr "Một dụng cụ đơn giản để khai thác cây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SAPLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SAPLING"
msgid "That's not growing back."
msgstr "Điều đó không phát triển trở lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SAP_SPOILED"
msgid "No longer food grade."
msgstr "Không còn cấp thực phẩm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SEEDPACKET"
msgid "An envelope of potential crops."
msgstr "Một phong bì của cây trồng tiềm năng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL"
msgid "Gruesome."
msgstr "Kinh khủng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND"
msgid "Processed and ready for cooking."
msgstr "Đã chế biến và sẵn sàng để nấu ăn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC"
msgid "I am not familiar with this species of plant."
msgstr "Tôi không quen thuộc với loại cây này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED"
msgid "I don't have time to wait for it to grow back."
msgstr "Tôi không có thời gian để đợi nó mọc lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG"
msgid "It passes the universal edibility test."
msgstr "Nó vượt qua bài kiểm tra khả năng ăn được phổ quát."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC"
msgid "What unique coloring. I should like to press its leaves in my books!"
msgstr "Màu sắc độc đáo làm sao. Tôi muốn ấn những chiếc lá của nó vào cuốn sách của mình!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP"
msgid "I should at least like to study its rings."
msgstr "Ít nhất tôi cũng muốn nghiên cứu các vòng của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS"
msgid "The insecta are drawn to the glucose."
msgstr "Côn trùng bị thu hút bởi glucose."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY"
msgid "Sap collection is under way."
msgstr "Việc thu thập nhựa cây đang được tiến hành."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY"
msgid "No sense letting it sit."
msgstr "Không có ý nghĩa gì khi để nó ngồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED"
msgid "Its internal structure has been damaged, but it can still recover."
msgstr "Cấu trúc bên trong của nó đã bị hư hỏng, nhưng nó vẫn có thể phục hồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SWAMPIG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SWAMPIG"
msgid "What a magnificent subspecies!"
msgstr "Thật là một phân loài tuyệt vời!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
msgid "Their society has stark social class roles."
msgstr "Xã hội của họ có vai trò giai cấp xã hội rõ ràng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
msgid "It has entered the REM stage of sleep."
msgstr "Nó đã bước vào giai đoạn REM của giấc ngủ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE"
msgid "Tsk! What disrepair."
msgstr "Chậc! Những gì hư hỏng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
msgid "This house is no longer livable."
msgstr "Ngôi nhà này không còn có thể ở được nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SYRUP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_SYRUP"
msgid "A sweetener."
msgstr "Chất làm ngọt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_TOMATO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_TOMATO"
msgid "Fruit of Solanum lycopersicum."
msgstr "Quả của Solanum lycopersicum."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
msgid "Roasted Solanum lycopersicum."
msgstr "Solanum lycopersicum rang."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_TOMATO_SEEDS"
msgid "Mutated seed of Solanum lycopersicum."
msgstr "Hạt đột biến của Solanum lycopersicum."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_TRADER_MERM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_TRADER_MERM"
msgid "They appear to have been quarantined. How foolish."
msgstr "Có vẻ như họ đã bị cách ly. Thật ngu ngốc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_TRADER_MERM2"
msgid "They appear to have been quarantined. How foolish."
msgstr "Có vẻ như họ đã bị cách ly. Thật ngu ngốc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_TURNIP"
msgid "Edible root of Brassica rapa."
msgstr "Rễ ăn được của Brassica rapa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
msgid "Roast Brassica rapa."
msgstr "Nướng Brassica rapa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "Mutated seed of Brassica rapa."
msgstr "Hạt giống cải bắp rapa bị đột biến."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_WHEAT"
msgid "Fresh Triticum aestivum."
msgstr "Triticum aestivum tươi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_WHEAT_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_WHEAT_SEEDS"
msgid "Mutated grain of Triticum aestivum."
msgstr "Hạt Triticum aestivum bị đột biến."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBIT.GENERIC"
msgid "It's some kind of Lagomorph. With horns."
msgstr "Đó là một số loại bộ thỏ. Với sừng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBIT.HELD"
msgid "It is a cute widdle horned Lagomorph."
msgstr "Nó là một widdle dễ thương sừng bộ thỏ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITHAT"
msgid "This silly headpiece will render the wearer non-threatening to rabbits."
msgstr "Món đồ đầu tiên ngốc nghếch này sẽ khiến người đội nó trở nên không gây hại cho những chú thỏ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITHOLE.GENERIC"
msgid "It looks like a small animal's burrow."
msgstr "Nó trông giống như một con vật hang nhỏ của."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITHOLE.SPRING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITHOLE.SPRING"
msgid "I hope the Lagomorph is all right down there!"
msgstr "Tôi hy vọng Lagomorph vẫn ổn ở dưới đó!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITHOUSE.BURNT"
msgid "It didn't even burn like a carrot."
msgstr "Nó thậm chí còn không cháy như một củ cà rốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITHOUSE.GENERIC"
msgid "Sadly, it is just painted to look like a carrot."
msgstr "Đáng buồn thay, nó chỉ là sơn để trông giống như một củ cà rốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITKINGHORN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITKINGHORN"
msgid "It plays a melody meant for rabbit ears."
msgstr "Nó chơi một giai điệu dành cho tai thỏ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITKINGHORN_CHEST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITKINGHORN_CHEST"
msgid "The rabbits will keep my things safe."
msgstr "Những con thỏ sẽ giữ đồ của tôi an toàn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITKINGMINION_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITKINGMINION_BUNNYMAN"
msgid "Must be an aggressive breed."
msgstr "Chắc là một giống hung hăng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITKINGSPEAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITKINGSPEAR"
msgid "Not the most menacing weapon but it will ward off unwelcome bunnymen."
msgstr "Không phải là vũ khí đe dọa nhất, nhưng nó sẽ xua đuổi những người thỏ không mong muốn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITKING_AGGRESSIVE"
msgid "That rabbit has a rather hostile disposition."
msgstr "Con thỏ đó có một thái độ khá thù địch."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITKING_LUCKY"
msgid "That is a rabbit worth capturing."
msgstr "Đây là một con thỏ đáng bắt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RABBITKING_PASSIVE"
msgid "It is a reputable breed known for fair dealings."
msgstr "Nó là một giống nổi tiếng với những giao dịch công bằng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RAINCOAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RAINCOAT"
msgid "Totally non-porous."
msgstr "Hoàn toàn không xốp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RAINHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RAINHAT"
msgid "I hate when my bun gets wet."
msgstr "Tôi ghét khi búi tóc của tôi bị ướt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RAINOMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RAINOMETER.BURNT"
msgid "I can't read any measurements from that husk."
msgstr "Tôi không thể đọc được bất kỳ phép đo từ trấu đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RAINOMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RAINOMETER.GENERIC"
msgid "Measure before you act."
msgstr "Đo trước khi hành động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RATATOUILLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RATATOUILLE"
msgid "Nicoise, so nutritious!"
msgstr "Nicoise, vì vậy bổ dưỡng!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RAZOR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RAZOR"
msgid "A personal hygiene implement."
msgstr "Một vệ sinh cá nhân thực hiện."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD"
msgid "I could see it getting a tad repetitive."
msgstr "Tôi có thể thấy nó lặp đi lặp lại một chút."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD_BALATRO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD_BALATRO"
msgid "The music was better back in my day... but let's hear it again."
msgstr "Âm nhạc ngày xưa của tôi hay hơn... nhưng hãy nghe lại nhé."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD_CREEPYFOREST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD_CREEPYFOREST"
msgid "I can't imagine where one would find a record press out here."
msgstr "Tôi không thể tưởng tượng được người ta có thể tìm thấy một máy ghi âm ở đâu ở đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD_DANGER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD_DANGER"
msgid "I can't imagine where one would find a record press out here."
msgstr "Tôi không thể tưởng tượng được người ta có thể tìm thấy một máy ghi âm ở đâu ở đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD_DAWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD_DAWN"
msgid "I can't imagine where one would find a record press out here."
msgstr "Tôi không thể tưởng tượng được người ta có thể tìm thấy một máy ghi âm ở đâu ở đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD_DRSTYLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD_DRSTYLE"
msgid "The music was better back in my day."
msgstr "Âm nhạc đã trở lại tốt hơn vào thời của tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD_DUSK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD_DUSK"
msgid "The music was better back in my day."
msgstr "Âm nhạc đã trở lại tốt hơn vào thời của tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD_EFS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD_EFS"
msgid "The music was better back in my day."
msgstr "Âm nhạc đã trở lại tốt hơn vào thời của tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD_END
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD_END"
msgid "The music was better back in my day."
msgstr "Âm nhạc đã trở lại tốt hơn vào thời của tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD_HALLOWEDNIGHTS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD_HALLOWEDNIGHTS"
msgid "Tsk. This type of music inspires all manner of mischief."
msgstr "Tsk. Loại nhạc này truyền cảm hứng cho mọi trò nghịch ngợm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD_MAIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD_MAIN"
msgid "I can't imagine where one would find a record press out here."
msgstr "Tôi không thể tưởng tượng được người ta có thể tìm thấy một máy ghi âm ở đâu ở đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD_WORKTOBEDONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RECORD_WORKTOBEDONE"
msgid "I can't imagine where one would find a record press out here."
msgstr "Tôi không thể tưởng tượng được người ta có thể tìm thấy một máy ghi âm ở đâu ở đây."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.REDGEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.REDGEM"
msgid "It is warm."
msgstr "Đó là ấm áp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.REDLANTERN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.REDLANTERN"
msgid "What a colorful little lantern."
msgstr "Thật là một chiếc đèn lồng nhỏ đầy màu sắc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.REDMOONEYE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.REDMOONEYE"
msgid "The red lens will mark this position."
msgstr "Ống kính màu đỏ sẽ đánh dấu vị trí này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.REDPOUCH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.REDPOUCH"
msgid "The vibrant red hue is a sign of good luck."
msgstr "Màu đỏ rực rỡ là dấu hiệu của sự may mắn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RED_CAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RED_CAP"
msgid "Red usually indicates poison."
msgstr "Red thường chỉ ra chất độc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RED_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RED_CAP_COOKED"
msgid "Chemistry has altered it."
msgstr "Hóa học đã thay đổi nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RED_MUSHROOM.GENERIC"
msgid "It is a fungus."
msgstr "Nó là một loại nấm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RED_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RED_MUSHROOM.INGROUND"
msgid "It is dormant this time of day."
msgstr "Nó là không hoạt động thời gian này trong ngày."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RED_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RED_MUSHROOM.PICKED"
msgid "It requires hydration before it can fruit again."
msgstr "Nó cần hydrat hóa trước khi có thể sinh trái trở lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.REEDS.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.REEDS.BURNING"
msgid "Combustion!"
msgstr "Thiêu Đốt!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.REEDS.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.REEDS.GENERIC"
msgid "A group of juncaceae graminoids."
msgstr "Một nhóm các graminoids juncaceae."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.REEDS.PICKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.REEDS.PICKED"
msgid "I believe they shall grow back."
msgstr "Tôi tin rằng họ sẽ phát triển trở lại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.REFINED_DUST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.REFINED_DUST"
msgid "Better here than on my bookshelves."
msgstr "Ở đây tốt hơn trên giá sách của tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.REFLECTIVEVEST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.REFLECTIVEVEST"
msgid "That could keep one moderately cool."
msgstr "Điều đó có thể giữ cho một người mát mẻ vừa phải."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RELIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RELIC"
msgid "A relic of an ancient civilization, lost to the ravages of time."
msgstr "Một di tích của một nền văn minh cổ đại đã bị mất đi bởi sự tàn phá của thời gian."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESEARCHLAB.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESEARCHLAB.BURNT"
msgid "I can't learn anything from a carbonized research station."
msgstr "Tôi không thể học bất cứ điều gì từ một trạm nghiên cứu carbon."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESEARCHLAB.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESEARCHLAB.GENERIC"
msgid "It's a research station. I can learn new things with it."
msgstr "Đó là một trạm nghiên cứu. Tôi có thể học được những điều mới với nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESEARCHLAB2.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESEARCHLAB2.BURNT"
msgid "I can't learn anything from a carbonized research station."
msgstr "Tôi không thể học bất cứ điều gì từ một trạm nghiên cứu carbon."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESEARCHLAB2.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESEARCHLAB2.GENERIC"
msgid "It's a research station. I can learn new things with it."
msgstr "Đó là một trạm nghiên cứu. Tôi có thể học được những điều mới với nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESEARCHLAB3.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESEARCHLAB3.BURNT"
msgid "An omen."
msgstr "Một điềm báo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESEARCHLAB3.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESEARCHLAB3.GENERIC"
msgid "Perhaps I have gone too far."
msgstr "Có lẽ tôi đã đi quá xa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESEARCHLAB4.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESEARCHLAB4.BURNT"
msgid "It won't be collecting any energy now."
msgstr "Nó sẽ không được thu bất kỳ năng lượng hiện nay."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESEARCHLAB4.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESEARCHLAB4.GENERIC"
msgid "I think the hat collects energy from the air."
msgstr "Tôi nghĩ rằng những chiếc mũ thu thập năng lượng từ không khí."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESKIN_TOOL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESKIN_TOOL"
msgid "We're well past due for a spring cleaning around here."
msgstr "Chúng ta đã quá hạn dọn dẹp mùa xuân quanh đây rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESURRECTIONSTATUE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESURRECTIONSTATUE.BURNT"
msgid "It has been smote."
msgstr "Nó đã được đập."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESURRECTIONSTATUE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESURRECTIONSTATUE.GENERIC"
msgid "How very pagan."
msgstr "Làm thế nào rất tà giáo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESURRECTIONSTONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RESURRECTIONSTONE"
msgid "That stone has regenerative powers."
msgstr "Viên đá đó có khả năng tái sinh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.REVIVER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.REVIVER"
msgid "This provides a corporeal anchor for the ectoplasmic configuration."
msgstr "Điều này cung cấp một điểm neo vật chất cho cấu hình ngoại chất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RHINODRILL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RHINODRILL"
msgid "Prone to unnecessary displays of masculinity."
msgstr "Dễ có những biểu hiện nam tính không cần thiết."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROASTTURKEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROASTTURKEY"
msgid "I do hope it had enough time in the oven."
msgstr "Tôi hy vọng nó có đủ thời gian trong lò."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROBIN.GENERIC"
msgid "Cardinalis! Beautiful plumage."
msgstr "Cardinalis! Đẹp bộ lông."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROBIN.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROBIN.HELD"
msgid "This little fellow will be my friend."
msgstr "Anh bạn nhỏ này sẽ là bạn của tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROBIN_WINTER.GENERIC"
msgid "A winter coat for the Cardinalis? How peculiar!"
msgstr "Một chiếc áo khoác mùa đông cho các cardinalis? Làm thế nào đặc biệt!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROBIN_WINTER.HELD"
msgid "It's so delicate."
msgstr "Nó rất tinh tế."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROBOT_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROBOT_BLUEPRINT"
msgid "I'm not certain just how much sewing is actually involved."
msgstr "Tôi không chắc chắn thực sự có bao nhiêu công việc may vá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROBOT_PUPPET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROBOT_PUPPET"
msgid "Poor child."
msgstr "Đứa trẻ tội nghiệp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK"
msgid "A large sedimentary rock."
msgstr "Một đá trầm tích lớn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCKS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCKS"
msgid "A handful of assorted rocks."
msgstr "Một số ít các loại đá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCKY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCKY"
msgid "Their carapace is made of rocks."
msgstr "Mai của chúng được làm bằng đá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN"
msgid "It is past the reproduction phase of its life cycle."
msgstr "Nó đã qua giai đoạn sinh sản của vòng đời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING"
msgid "Tsk. Such a waste of resources."
msgstr "Chậc. Thật là lãng phí tài nguyên."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED"
msgid "I fear it has contracted a disease."
msgstr "Tôi sợ nó đã mắc phải một căn bệnh nào đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING"
msgid "Hm, I see browning at the leaves' edges."
msgstr "Ừm, tôi thấy mép lá có màu nâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC"
msgid "Surely that can't be fruit."
msgstr "Chắc chắn đó không thể là trái cây được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED"
msgid "A bush that grew from the lunar soil."
msgstr "Một bụi cây mọc lên từ đất mặt trăng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED"
msgid "These are not ideal conditions for this species."
msgstr "Đây không phải là điều kiện lý tưởng cho loài này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_AVOCADO_FRUIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_AVOCADO_FRUIT"
msgid "The outside is mineral, yet the inside is organic."
msgstr "Bên ngoài là khoáng chất nhưng bên trong là hữu cơ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE"
msgid "I miss a nice fresh avocado."
msgstr "Tôi nhớ một quả bơ tươi ngon."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED"
msgid "It's perfectly safe for consumption."
msgstr "Nó hoàn toàn an toàn cho tiêu dùng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT"
msgid "It would be better to allow it to grow at this point."
msgstr "Sẽ tốt hơn nếu cho phép nó phát triển vào thời điểm này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_ICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_ICE.GENERIC"
msgid "A small block of extremely dense ice."
msgstr "Một khối băng nhỏ cực kỳ dày đặc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_ICE.MELTED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_ICE.MELTED"
msgid "It must have melted due to its small size."
msgstr "Nó phải đã tan chảy do kích thước nhỏ của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_ICE_MELTED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_ICE_MELTED"
msgid "It must have melted due to its small size."
msgstr "Nó phải đã tan chảy do kích thước nhỏ của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_LIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_LIGHT.GENERIC"
msgid "A capped lava pit."
msgstr "Một dung nham hố mũ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_LIGHT.LOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_LIGHT.LOW"
msgid "The cooling process has begun."
msgstr "Quá trình làm mát đã bắt đầu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_LIGHT.NORMAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_LIGHT.NORMAL"
msgid "Much too hot to touch."
msgstr "Quá nóng để chạm vào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_LIGHT.OUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_LIGHT.OUT"
msgid "Nothing but a sheath of igneous rock now."
msgstr "Bây giờ chẳng có gì ngoài một vỏ đá lửa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_MOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_MOON"
msgid "Implications of a lunar body? Interesting."
msgstr "Ý nghĩa của cơ thể mặt trăng? Hấp dẫn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_PETRIFIED_TREE"
msgid "Should make for an excellent building material."
msgstr "Nên làm cho một vật liệu xây dựng tuyệt vời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_PETRIFIED_TREE_OLD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROCK_PETRIFIED_TREE_OLD"
msgid "Should make for an excellent building material."
msgstr "Nên làm cho một vật liệu xây dựng tuyệt vời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROOK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROOK"
msgid "A clockwork castle."
msgstr "Một lâu đài đồng hồ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROOK_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROOK_NIGHTMARE"
msgid "It looks like it could break apart at any moment."
msgstr "Có vẻ như nó có thể phá vỡ bất cứ lúc nào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROPE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROPE"
msgid "A short length of strong hemp rope."
msgstr "Một chiều dài ngắn của sợi dây gai dầu mạnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROPE_BRIDGE_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROPE_BRIDGE_KIT"
msgid "Not exactly a marvel of engineering, but I'm sure it will do."
msgstr "Không hẳn là một kỳ quan kỹ thuật, nhưng tôi chắc nó sẽ làm được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROSEGLASSESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROSEGLASSESHAT.GENERIC"
msgid "Winona has been rather tight-lipped about their function."
msgstr "Winona khá kín tiếng về chức năng của chúng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL"
msgid "only_used_by_winona"
msgstr "chỉ_dùng_bởi_winona"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROTTENEGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROTTENEGG.GENERIC"
msgid "How unappetizing."
msgstr "Thật không ngon miệng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROYAL_JELLY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ROYAL_JELLY"
msgid "In the wild this might have produced more queens."
msgstr "Trong tự nhiên, điều này có thể đã tạo ra nhiều ong chúa hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RUBBLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RUBBLE"
msgid "Looks like a job for library paste!"
msgstr "Trông giống như một công việc để dán thư viện!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RUINSHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RUINSHAT"
msgid "A bit gaudy for my tastes, but it seems useful."
msgstr "Một chút cầu kỳ cho sở thích của tôi, nhưng nó có vẻ hữu ích."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RUINS_BAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RUINS_BAT"
msgid "An implement for administering devastating blows."
msgstr "Một dụng cụ để thực hiện những đòn tàn phá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RUINS_RUBBLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RUINS_RUBBLE"
msgid "With a little elbow grease this could be put into working order."
msgstr "Với một ít dầu mỡ khuỷu tay này có thể được đưa vào để làm việc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SACRED_CHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SACRED_CHEST.GENERIC"
msgid "A small dimension tightly bound in magic."
msgstr "Một chiều không gian nhỏ bị ràng buộc chặt chẽ bởi ma thuật."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SACRED_CHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SACRED_CHEST.LOCKED"
msgid "The magic's at work."
msgstr "Phép thuật đang hoạt động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SADDLEHORN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SADDLEHORN"
msgid "A device for forceful unfurnishment."
msgstr "Một thiết bị để cưỡng bức dọn dẹp đồ đạc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SADDLE_BASIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SADDLE_BASIC"
msgid "A crude device for equestrianism."
msgstr "Một thiết bị thô sơ cho môn cưỡi ngựa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SADDLE_RACE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SADDLE_RACE"
msgid "The decorative antennae are a lovely touch."
msgstr "Các râu trang trí là một điểm nhấn đáng yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SADDLE_SHADOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SADDLE_SHADOW"
msgid "A beefalo saddle fitted for combat."
msgstr "Yên cho bò sừng phù hợp để chiến đấu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SADDLE_WAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SADDLE_WAR"
msgid "A favorite perch of generals and assorted warlords."
msgstr "Một con cá rô yêu thích của các tướng lĩnh và các lãnh chúa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SADDLE_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SADDLE_WATHGRITHR"
msgid "It follows that a beast used in battle should be well-armored."
msgstr "Theo đó, một con thú được sử dụng trong trận chiến phải được bọc thép tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SALSA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SALSA"
msgid "My goodness, that has some zest to it!"
msgstr "Chúa ơi, điều đó có chút thú vị!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SALTBOX
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SALTBOX"
msgid "This should help prevent food spoilage."
msgstr "Điều này sẽ giúp ngăn ngừa hư hỏng thực phẩm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SALTLICK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SALTLICK"
msgid "A cube of sodium chloride to lure wild beasts."
msgstr "Một khối natri clorua để dụ thú rừng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SALTLICK_IMPROVED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SALTLICK_IMPROVED"
msgid "The beefalo lick salt to acquire essential nutrients."
msgstr "Bò liếm muối để thu được các chất dinh dưỡng cần thiết."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SALTROCK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SALTROCK"
msgid "It's growing in a curiously geometric formation."
msgstr "Nó đang phát triển theo một hình dạng hình học kỳ lạ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SALTSTACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SALTSTACK.GENERIC"
msgid "Intriguing... just how were those figures constructed?"
msgstr "Thật thú vị... những hình vẽ đó được xây dựng như thế nào?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SALTSTACK.GROWING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SALTSTACK.GROWING"
msgid "Oh my... they seem to form that way naturally."
msgstr "Ôi trời... chúng dường như hình thành theo cách đó một cách tự nhiên."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SALTSTACK.MINED_OUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SALTSTACK.MINED_OUT"
msgid "The salt has already been harvested."
msgstr "Muối đã được thu hoạch rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SALTY_DOG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SALTY_DOG"
msgid "I'm more of a cat person."
msgstr "Tôi thích mèo hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SALTY_DOGHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SALTY_DOGHAT"
msgid "It gives one quite a commanding appearance."
msgstr "Nó mang lại cho người ta một vẻ ngoài khá chỉ huy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SANDBLOCK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SANDBLOCK"
msgid "Quite a phenomenal talent!"
msgstr "Quả là một tài năng phi thường!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SANDSPIKE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SANDSPIKE"
msgid "Panthera auropunctata is misbehaving today."
msgstr "Panthera auropunctata ngày nay đang hoạt động không tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SANITYROCK.ACTIVE"
msgid "Fascinating. I'll have to study these markings later."
msgstr "Hấp dẫn. Tôi sẽ cần phải nghiên cứu các dấu hiệu sau."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SANITYROCK.INACTIVE"
msgid "It seems to have sunk into the soil."
msgstr "Nó dường như đã chìm vào trong đất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SAPLING.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SAPLING.BURNING"
msgid "Combustion!"
msgstr "Thiêu Đốt!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SAPLING.DISEASED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SAPLING.DISEASED"
msgid "It's afflicted with an agrarian disease beyond my curing."
msgstr "Nó mắc phải một căn bệnh nông nghiệp mà tôi không thể chữa khỏi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SAPLING.DISEASING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SAPLING.DISEASING"
msgid "Hm... Seems more brittle than is usual."
msgstr "Hm... Có vẻ giòn hơn bình thường."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SAPLING.GENERIC"
msgid "It's a small tree."
msgstr "Đó là một cây nhỏ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SAPLING.PICKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SAPLING.PICKED"
msgid "Odd. I thought that would have killed it."
msgstr "Odd. Tôi nghĩ rằng sẽ giết chết nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SAPLING.WITHERED"
msgid "The heat's gotten to it."
msgstr "Nhiệt ta nhận được nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCANDATA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCANDATA"
msgid "An incredibly thorough analysis. Well done!"
msgstr "Một phân tích cực kỳ kỹ lưỡng. Làm tốt!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCARECROW.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCARECROW.BURNING"
msgid "Hm. I suppose it was quite flammable."
msgstr "Ừm. Tôi cho rằng nó khá dễ cháy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCARECROW.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCARECROW.BURNT"
msgid "Pity. He was such a jolly fellow."
msgstr "Lòng thương xót. Anh ấy quả là một người vui tính."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCARECROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCARECROW.GENERIC"
msgid "Ah, excellent. No more leaving clothes on branches to get wrinkled."
msgstr "À, tuyệt vời. Không còn việc để quần áo trên cành cho nhàu nát nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCORCHED_SKELETON"
msgid "You don't inspire a great deal of confidence, dear."
msgstr "Bạn không tạo được nhiều tự tin đâu, bạn thân mến."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCRAPBOOK_PAGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCRAPBOOK_PAGE"
msgid "What a hideous sight! A page torn from its book!"
msgstr "Thật là một cảnh tượng gớm ghiếc! Một trang bị xé khỏi cuốn sách của nó!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCRAPHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCRAPHAT"
msgid "Perhaps we might give it a good wash first?"
msgstr "Có lẽ chúng ta nên giặt kỹ trước?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCRAP_MONOCLEHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCRAP_MONOCLEHAT"
msgid "It seems to exponentially increase the wearer's field of view."
msgstr "Nó dường như tăng tầm nhìn của người đeo theo cấp số nhân."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTINGTABLE.BLOCK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTINGTABLE.BLOCK"
msgid "Oh, I never considered myself much of an artist!"
msgstr "Ôi, tôi chưa bao giờ coi mình là một nghệ sĩ!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "What a shame. It was a lovely addition."
msgstr "Xấu hổ làm sao. Đó là một sự bổ sung đáng yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTINGTABLE.EMPTY"
msgid "A method of ceramic production. We somehow use it for sculpture."
msgstr "Một phương pháp sản xuất gốm sứ. Bằng cách nào đó chúng tôi sử dụng nó cho tác phẩm điêu khắc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTINGTABLE.SCULPTURE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTINGTABLE.SCULPTURE"
msgid "We were all in dire need of an emotional outlet, I believe."
msgstr "Tôi tin rằng tất cả chúng ta đều đang rất cần một lối thoát cảm xúc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED"
msgid "There's an almost animalistic ferocity in the chiselwork."
msgstr "Có một sự hung dữ gần như thú tính trong công việc đục đẽo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED"
msgid "An excellent repair job."
msgstr "Một công việc sửa chữa tuyệt vời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
msgid "Something is stirring within."
msgstr "Có cái gì đó đang khuấy động bên trong."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED"
msgid "So this is what was lurking inside."
msgstr "Vậy ra đây chính là thứ ẩn giấu bên trong."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_BISHOPHEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_BISHOPHEAD"
msgid "I can lift it. I'm more spry than I look."
msgstr "Tôi có thể nâng nó lên. Tôi nhanh nhẹn hơn vẻ ngoài của tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED"
msgid "Very tasteful."
msgstr "Rất trang nhã."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED"
msgid "The structure is whole once again."
msgstr "Cấu trúc lại hoàn chỉnh một lần nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_KNIGHTBODY.READY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_KNIGHTBODY.READY"
msgid "Something is stirring within."
msgstr "Có cái gì đó đang khuấy động bên trong."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED"
msgid "They say every block of stone has a statue inside."
msgstr "Người ta nói mỗi khối đá đều có một bức tượng bên trong."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_KNIGHTHEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_KNIGHTHEAD"
msgid "You have to lift with your knees, dear."
msgstr "Bạn phải nâng bằng đầu gối của mình, bạn thân mến."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_ROOKBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_ROOKBODY.COVERED"
msgid "I feel a light dusting of magic. Odd."
msgstr "Tôi cảm thấy một lớp bụi ma thuật nhẹ. Số lẻ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED"
msgid "We may want to keep an eye on this."
msgstr "Chúng tôi có thể muốn để mắt đến điều này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_ROOKBODY.READY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_ROOKBODY.READY"
msgid "Something is stirring within."
msgstr "Có cái gì đó đang khuấy động bên trong."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED"
msgid "What an awful state it's in!"
msgstr "Thật là một tình trạng khủng khiếp!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_ROOKNOSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SCULPTURE_ROOKNOSE"
msgid "That's a thrown out back waiting to happen."
msgstr "Đó là một sự ném ra phía sau đang chờ đợi để xảy ra."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEAFARING_PROTOTYPER.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEAFARING_PROTOTYPER.BURNT"
msgid "How irresponsible."
msgstr "Thật vô trách nhiệm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC"
msgid "It's good to keep the mind occupied at sea."
msgstr "Thật tốt khi giữ tâm trí bận rộn trên biển."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEAFOODGUMBO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEAFOODGUMBO"
msgid "I can feel the heartburn already!"
msgstr "Tôi có thể cảm thấy ợ nóng rồi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEASTACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEASTACK"
msgid "It would be no good to run aground of that."
msgstr "Sẽ không tốt chút nào nếu mắc cạn điều đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SECURITY_PULSE_CAGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SECURITY_PULSE_CAGE"
msgid "I have not come across this in any book."
msgstr "Tôi chưa từng gặp điều này trong bất kỳ cuốn sách nào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SECURITY_PULSE_CAGE_FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SECURITY_PULSE_CAGE_FULL"
msgid "The glowing object inside emits some sort of energy."
msgstr "Vật thể phát sáng bên trong phát ra một loại năng lượng nào đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEEDPOUCH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEEDPOUCH"
msgid "For the practical storage and transport of seeds."
msgstr "Để lưu trữ và vận chuyển hạt giống thực tế."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEEDS"
msgid "A handful of unidentifiable seeds."
msgstr "Một số ít các hạt không xác định được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEEDS_COOKED"
msgid "A toasted embryonic plant treat!"
msgstr "Một nhà máy phôi nướng điều trị!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SENTRYWARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SENTRYWARD"
msgid "Ah! A scrying orb."
msgstr "Ah! Một quả cầu cầu vồng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEWING_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEWING_KIT"
msgid "A simple implement for domestic tasks."
msgstr "Một dụng cụ đơn giản dành cho các công việc gia đình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEWING_MANNEQUIN.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEWING_MANNEQUIN.BURNT"
msgid "What a shame, it might have been useful."
msgstr "Thật đáng tiếc, nó có thể hữu ích."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEWING_MANNEQUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEWING_MANNEQUIN.GENERIC"
msgid "Excellent! A place to air out musty equipment."
msgstr "Xuất sắc! Nơi thông thoáng các thiết bị bị mốc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEWING_TAPE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SEWING_TAPE"
msgid "A high grade adhesive, good for small mends."
msgstr "Chất kết dính cao cấp, phù hợp cho những vết vá nhỏ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWDANCER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWDANCER"
msgid "...Has anyone checked in on him recently?"
msgstr "...Gần đây có ai kiểm tra anh ấy không?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWDIGGER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWDIGGER"
msgid "Well, I suppose we did need an extra set of hands... Hm."
msgstr "Chà, tôi cho rằng chúng ta cần thêm một người giúp đỡ... Hm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWHEART
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWHEART"
msgid "This... This is no child's magic."
msgstr "Đây... Đây không phải là phép thuật của trẻ con."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWRIFT_PORTAL"
msgid "Intriguing and deeply worrying in equal measures."
msgstr "Hấp dẫn và đáng lo ngại sâu sắc trong các biện pháp bình đẳng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY"
msgid "The creature's dreadstone armoring exhibits near-impenetrable properties."
msgstr "Lớp giáp bằng đá dreadstone của sinh vật này có đặc tính gần như không thể xuyên thủng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED"
msgid "The shadow beast has been upended. However, its compromised position will not persist, I'm afraid."
msgstr "Con thú bóng tối đã bị lật tẩy. Tuy nhiên, tôi e rằng vị thế bị tổn hại của nó sẽ không tồn tại lâu dài."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD"
msgid "A bicephalic shadow beast. How curious."
msgstr "Một con thú bóng tối hai đầu. Thật tò mò."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWTHRALL_HANDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWTHRALL_HANDS"
msgid "I would advise against challenging it in hand-to-hand combat."
msgstr "Tôi khuyên bạn không nên thử thách nó trong trận chiến tay đôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWTHRALL_HORNS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWTHRALL_HORNS"
msgid "A ravenous shadow beast."
msgstr "Một con thú bóng tối háu đói."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWTHRALL_MOUTH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWTHRALL_MOUTH"
msgid "A sensible person would avoid the toothy maw."
msgstr "Một người khôn ngoan sẽ tránh cái hàm đầy răng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWTHRALL_PARASITE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWTHRALL_PARASITE"
msgid "A sort of parasite hailing from another realm."
msgstr "Một loại ký sinh trùng đến từ một thế giới khác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWTHRALL_WINGS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOWTHRALL_WINGS"
msgid "Its wings seem to be utilized for propulsion, not to remain airborne."
msgstr "Đôi cánh của nó dường như được sử dụng để tạo lực đẩy chứ không phải để bay trên không."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOW_BATTLEAXE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOW_BATTLEAXE"
msgid "There is a price to wielding such implements."
msgstr "Có một cái giá khi sử dụng những công cụ này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOW_BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOW_BEEF_BELL"
msgid "It revives one's dead beefalo by a simple mechanism: magic."
msgstr "Nó hồi sinh con Bò Lai đã chết bằng một cơ chế đơn giản: phép thuật."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOW_FORGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOW_FORGE"
msgid "I do not care for this type of magic."
msgstr "Tôi không quan tâm đến loại phép thuật này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOW_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOW_FORGE_KIT"
msgid "It cannot be utilized until its been assembled."
msgstr "Nó không thể được sử dụng cho đến khi nó được lắp ráp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOW_HEART_VEIN"
msgid "This is dark magic indeed."
msgstr "Đây thực sự là ma thuật đen tối."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHALLOW_GRAVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHALLOW_GRAVE"
msgid "This is inadequate."
msgstr "Điều này là không thỏa đáng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHARK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHARK"
msgid "Fascinating! The entire jaw seems to be comprised of living stone!"
msgstr "Lôi cuốn! Toàn bộ hàm dường như được làm bằng đá sống!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHARKBOI
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHARKBOI"
msgid "This brute has broken innumerable laws of nature, and I simply will not have it."
msgstr "Kẻ vũ phu này đã phá vỡ vô số quy luật tự nhiên, và đơn giản là tôi sẽ không chấp nhận nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHELLWEAVER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHELLWEAVER"
msgid "It utilizes salt in a wide variety of ways."
msgstr "Nó sử dụng muối theo nhiều cách khác nhau."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHELL_CLUSTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHELL_CLUSTER"
msgid "A fascinating assortment of mollusks!"
msgstr "Một loại động vật thân mềm hấp dẫn!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHIELDOFTERROR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHIELDOFTERROR"
msgid "It seems better suited to offensive measures, rather than defensive as one might think."
msgstr "Nó có vẻ phù hợp hơn với các biện pháp tấn công hơn là phòng thủ như người ta nghĩ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHOVEL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHOVEL"
msgid "It's a shovel. Surely you've seen one before?"
msgstr "Đó là một cái xẻng. Chắc chắn bạn đã thấy một trước?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHOVEL_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHOVEL_LUNARPLANT"
msgid "A surprisingly effective digging implement."
msgstr "Một dụng cụ đào có hiệu quả đáng ngạc nhiên."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHROOMBAIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHROOMBAIT"
msgid "This malodorous combination will render unconscious any creature that ingests it."
msgstr "Sự kết hợp mùi hôi này sẽ khiến bất kỳ sinh vật nào ăn phải nó đều bất tỉnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHROOMCAKE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHROOMCAKE"
msgid "I don't believe that qualifies as a \"cake\" dear."
msgstr "Tôi không tin rằng nó đủ tiêu chuẩn là một \"bánh\" thân yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHROOM_SKIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHROOM_SKIN"
msgid "Frog skin must remain damp, or they will suffocate. Not that this one minds."
msgstr "Da ếch phải luôn ẩm nếu không sẽ bị ngạt thở. Không phải là điều này một tâm trí."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SIESTAHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SIESTAHUT.BURNT"
msgid "It wasn't doing me much good anyhow."
msgstr "Nó đã không làm cho tôi nhiều điều tốt dù sao đi nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SIESTAHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SIESTAHUT.GENERIC"
msgid "I can barely sleep on a bed, never mind the ground."
msgstr "Tôi hầu như không thể ngủ trên giường, chứ đừng bận tâm đến mặt đất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SILK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SILK"
msgid "Protein fiber extruded from an arachnid."
msgstr "Sợi protein được ép ra từ loài nhện."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC"
msgid "SHHH!"
msgstr "SHHH!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC"
msgid "Shhh!"
msgstr "Suỵt!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC"
msgid "Shhh!"
msgstr "Suỵt!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SISTURN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SISTURN.GENERIC"
msgid "The poor dear."
msgstr "Người nghèo thân yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SISTURN.LOTS_OF_FLOWERS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SISTURN.LOTS_OF_FLOWERS"
msgid "The flowers seem to give off an aromatic effect."
msgstr "Những bông hoa dường như tỏa ra một hiệu ứng thơm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM"
msgid "They generate an unearthly sound."
msgstr "Họ tạo ra một âm thanh kinh khủng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_EVIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_EVIL"
msgid "The flowers affect one's mental stability."
msgstr "Những bông hoa ảnh hưởng đến sự ổn định tinh thần của một người."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SISTURN.SOME_FLOWERS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SISTURN.SOME_FLOWERS"
msgid "I believe flowers are a traditional offering to the deceased."
msgstr "Tôi tin rằng hoa là lễ vật truyền thống dành cho người đã khuất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SKELETON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SKELETON"
msgid "An incredibly well preserved human skeleton."
msgstr "Một bộ xương người cực kỳ bảo tồn tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SKELETONHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SKELETONHAT"
msgid "It has a detrimental effect on the mortal mind."
msgstr "Nó có ảnh hưởng bất lợi đến tâm trí của người phàm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SKELETON_NOTPLAYER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SKELETON_NOTPLAYER"
msgid "Looking at the bone structure, this was clearly not human."
msgstr "Nhìn vào cấu trúc xương, rõ ràng đây không phải là con người."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SKELETON_PLAYER.DEFAULT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SKELETON_PLAYER.DEFAULT"
msgid "%s's skeleton is a permanent reminder to be mindful around %s."
msgstr "Bộ xương của %s là lời nhắc nhở thường trực để bạn lưu tâm đến %s."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SKELETON_PLAYER.FEMALE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SKELETON_PLAYER.FEMALE"
msgid "%s's skeleton is a permanent reminder to be mindful around %s."
msgstr "Bộ xương của %s là lời nhắc nhở thường trực để bạn lưu tâm đến %s."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SKELETON_PLAYER.MALE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SKELETON_PLAYER.MALE"
msgid "%s's skeleton is a permanent reminder to be mindful around %s."
msgstr "Bộ xương của %s là lời nhắc nhở thường trực để bạn lưu tâm đến %s."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SKELETON_PLAYER.ROBOT
