msgstr "Ôi, Mẹ-Chân dài."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERQUEENCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERQUEENCORPSE.REVIVING"
