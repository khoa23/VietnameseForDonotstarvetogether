msgstr "Một mảnh của chiến trường."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_VENT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_VENT"
msgid "A piece of the battlefield."
msgstr "Một mảnh của chiến trường."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_WOODFLOOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_WOODFLOOR"
msgid "Wooden flooring, a fine surface for mortal combat."
msgstr "Sàn Gỗ, một bề mặt tuyệt vời cho cuộc chiến tử thần."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURKEYDINNER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURKEYDINNER"
msgid "A true feast."
msgstr "Một bữa tiệc thực thụ."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURNIP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURNIP"
msgid "I shall not consume it!"
msgstr "Ta sẽ không thèm ăn nó đâu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURNIP_COOKED"
msgid "Ach! I shall not eat thee!"
msgstr "Ach! Ta sẽ không ăn ngươi đâu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURNIP_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "Chỉ là một nắm hạt giống, dành cho đồ không phải thịt."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURTILLUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURTILLUS"
msgid "Your armor shalln't stop my spear."
msgstr "Bộ giáp của ngươi không cản được giáo của ta đâu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.BURNING"
msgid "The wood's ablaze!"
msgstr "Cây cối đang bốc cháy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.BURNT"
msgid "Loge took that one."
msgstr "Loge đã lấy đi cái đó rồi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.CHOPPED"
msgid "Chopped by the warrior in the woods!"
msgstr "Bị chặt bởi chiến binh trong rừng!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.DISEASED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.DISEASED"
msgid "Disease festers within its soul."
msgstr "Bệnh tật đang nhức nhối bên trong linh hồn nó."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.GENERIC"
msgid "Triumph will accompany its many resources."
msgstr "Khải hoàn sẽ đi kèm với vô vàn tài nguyên của nó."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGY_NUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGY_NUT"
msgid "It will one day rival Yggdrasil!"
msgstr "Một ngày nào đó nó sẽ sánh ngang với Yggdrasil!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGY_NUT_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGY_NUT_SAPLING"
msgid "Grow tall and strong."
msgstr "Hãy lớn thật cao và khỏe mạnh nhé."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGY_OLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGY_OLD"
msgid "It will soon return to the earth."
msgstr "Nó sẽ sớm trở về với đất mẹ."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGS"
msgid "Good for making spears."
msgstr "Thích hợp để làm giáo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWINOFTERROR1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWINOFTERROR1"
msgid "Do thine worst, foul metal fiend!"
msgstr "Cứ tung hết chiêu đi, hỡi ác ma kim loại đê tiện!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWINOFTERROR2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWINOFTERROR2"
msgid "Do thine worst, foul metal fiend!"
msgstr "Cứ tung hết chiêu đi, hỡi ác ma kim loại đê tiện!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.UMBRELLA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.UMBRELLA"
msgid "Rain protection made from the trophy of a hunt."
msgstr "Vật phẩm che mưa làm từ chiến lợi phẩm săn bắn."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.UNAGI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.UNAGI"
msgid "No need for food to be so fancy."
msgstr "Đồ ăn cần gì phải hoa mè thế này."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.UNIMPLEMENTED"
msgid "A mysterious relic, sure to contain great power."
msgstr "Một thánh tích bí ẩn, chắc chắn chứa đựng sức mạnh to lớn."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_CHANDELIER_BROKEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_CHANDELIER_BROKEN"
msgid "Who hath cast thee down from the heavens, little star?"
msgstr "Kẻ nào đã đánh ngươi rơi từ thiên đường xuống vậy, ngôi sao nhỏ?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_COMPASS.GENERIC"
msgid "Guide me true, o infernal device!"
msgstr "Hãy dẫn lối cho ta thật chuẩn xác, hỡi thiết bị địa ngục!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_COMPASS.KEYROOM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_COMPASS.KEYROOM"
msgid "I am arrived!"
msgstr "Ta đã đến nơi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_COMPASS.NOTVAULT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_COMPASS.NOTVAULT"
msgid "'Tis of no use to me here."
msgstr "Chẳng có ích gì với ta ở đây cả."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_CRAWLER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_CRAWLER.GENERIC"
msgid "Art thou my enemy, or my guiding light?"
msgstr "Ngươi là kẻ thù, hay ánh sáng dẫn đường cho ta?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_CRAWLER.SOCKETED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_CRAWLER.SOCKETED"
msgid "Ha! Right on the mark!"
msgstr "Ha! Trúng ngay phóc!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_CRAWLER_LEVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_CRAWLER_LEVER"
msgid "Steel thyself, and pull!"
msgstr "Hãy lấy lại tinh thần, và kéo nó lên!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_DECON_DOOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_DECON_DOOR"
msgid "No barricade can contain me!"
msgstr "Không hàng rào nào cản được ta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_DECON_MISTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_DECON_MISTER"
msgid "Defenses against dark magicks."
msgstr "Vật phòng thủ chống lại ma thuật hắc ám."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_KEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_KEY"
msgid "'Tis the key to our salvation!"
msgstr "Đây chính là chìa khóa để cứu rỗi chúng ta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_KEY_ACTIVATOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_KEY_ACTIVATOR"
msgid "There art something missing... but what?"
msgstr "Có cái gì đó đang thiếu... nhưng là gì nhỉ?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_KEY_EXIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_KEY_EXIT"
msgid "Nowhere to anchor a rope? A true warrior needeth no second plan."
msgstr "Không có chỗ để neo dây thừng á? Một chiến binh thực thụ chẳng cần phương án thứ hai."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC"
msgid "'Tis my bounty to claim."
msgstr "Đó là phần thưởng thuộc về ta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_KEY_PEDESTAL.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_KEY_PEDESTAL.PICKED"
msgid "There is nought."
msgstr "Chẳng có gì ở đây cả."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_LOBBY_EXIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_LOBBY_EXIT"
msgid "I ought to let down a length of rope, should I wish to venture this way again."
msgstr "Ta nên thả một đoạn dây thừng xuống, nhỡ đâu lại muốn thám hiểm lối này lần nữa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_ORB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_ORB"
msgid "What purpose hath this blasted bauble?"
msgstr "Món đồ trang sức bỏ đi này có mục đích gì chứ?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_ORB_REFINED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_ORB_REFINED"
msgid "'Tis a potent orb of old."
msgstr "Đó là một quả cầu cổ mạnh mẽ."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_PILLAR_GUARD"
msgid "Thine charge is a noble one, but I cannot let thee stand in my way!"
msgstr "Nhiệm vụ của ngươi rất cao cả, nhưng ta không thể để ngươi ngáng đường ta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR"
msgid "It hath the makings of a formidable thing!"
msgstr "Nó có vóc dáng của một thứ vô cùng đáng gờm!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS"
msgid "Where shall I fortify mine defenses?"
msgstr "Ta nên củng cố phòng tuyến của mình ở đâu đây?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED"
msgid "Stand watch, noble sentry!"
msgstr "Hãy canh gác cho cẩn thận, lính canh cao quý!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT"
msgid "A formidable structure."
msgstr "Một cấu trúc đáng gờm."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED"
msgid "It doth slumber 'til the spark of life be bestowed upon it!"
msgstr "Nó sẽ ngủ say cho đến khi tia lửa sự sống được ban cho nó!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_PILLAR_GUARD_PIECE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_PILLAR_GUARD_PIECE"
msgid "Behold! A piece of the golem!"
msgstr "Nhìn kìa! Một phần của con golem!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_REFINER_PEDESTAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_REFINER_PEDESTAL"
msgid "Though battle be my calling, I do not loathe the smith's craft."
msgstr "Dù chiến đấu là thiên chức của ta, nhưng ta không hề ghét nghề thợ rèn."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_RUNE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_RUNE"
msgid "I know not these runes."
msgstr "Ta không hiểu mấy thứ cổ văn này."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_STATUE.LORE1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_STATUE.LORE1"
msgid "It doth seem Lord Insect hath struck a fell bargain."
msgstr "Có vẻ như Ngài Côn Trùng đã đưa ra một thỏa thuận tồi tệ."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_STATUE.LORE2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_STATUE.LORE2"
msgid "What vile force could claim so many souls?"
msgstr "Thế lực đồi bại nào lại có thể tước đoạt nhiều linh hồn đến thế?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_STATUE.LORE3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_STATUE.LORE3"
msgid "I doth dare these stone warriors to rouse from slumber and cross blades with me!"
msgstr "Ta thách lũ chiến binh đá này tỉnh giấc và đọ kiếm với ta đấy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_TELEPORTER.BROKEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_TELEPORTER.BROKEN"
msgid "Curses! 'Tis stricken!"
msgstr "Khốn thật! Nó bị hỏng rồi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_TELEPORTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_TELEPORTER.GENERIC"
msgid "Aye! At times, some witchcraft is the only course."
msgstr "Phải! Đôi khi, phép thuật là con đường duy nhất."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_TELEPORTER.UNPOWERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_TELEPORTER.UNPOWERED"
msgid "This infernal contraption hath no spark!"
msgstr "Cái cỗ máy quái quỷ này chẳng có tí lửa nào cả!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_TORCH.BROKEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_TORCH.BROKEN"
msgid "'Tis broken."
msgstr "Nó bị hỏng rồi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_TORCH.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VAULT_TORCH.GENERIC"
msgid "A flame to banish the shadows!"
msgstr "Ngọn lửa để xua tan bóng tối!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VEGGIEOMLET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VEGGIEOMLET"
msgid "Bah! The eggs have been spoiled by non-meats!"
msgstr "Đồ khốn! Trứng bị làm hỏng bởi lũ không phải thịt rồi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN"
msgid "Good! Let it rot!"
msgstr "Tốt! Cứ để nó thành đồ thối đi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VEGSTINGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VEGSTINGER"
msgid "Its spiciness intrigues me not!"
msgstr "Độ cay của nó chẳng làm ta thấy hứng thú đâu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VICTORIAN_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VICTORIAN_BLUEPRINT"
msgid "Odd looking armor for a beast..."
msgstr "Bộ giáp trông kỳ lạ dành cho một con quái vật..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VOIDCLOTH"
msgid "Remnants of a fallen foe."
msgstr "Tàn tích của một kẻ thù đã gục ngã."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VOIDCLOTHHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VOIDCLOTHHAT"
msgid "I despise the thought of hiding one's face in combat."
msgstr "Ta căm ghét ý nghĩ che giấu mặt mình trong chiến đấu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VOIDCLOTH_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VOIDCLOTH_BOOMERANG"
msgid "There will be no escape for my foes."
msgstr "Sẽ không có đường thoát cho kẻ thù của ta đâu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VOIDCLOTH_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VOIDCLOTH_KIT"
msgid "Even the sturdiest armor will sometimes need repairs."
msgstr "Đến bộ giáp cứng cáp nhất đôi khi cũng cần được sửa chữa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VOIDCLOTH_SCYTHE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VOIDCLOTH_SCYTHE"
msgid "A formidable weapon against non-meats."
msgstr "Một thứ vũ khí đáng gờm chống lại bọn không phải thịt."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VOIDCLOTH_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VOIDCLOTH_UMBRELLA"
msgid "A shield against the elements."
msgstr "Chiếc khiên chống lại thời tiết khắc nghiệt."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VOLTGOATJELLY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VOLTGOATJELLY"
msgid "Well, it is technically made from a beast."
msgstr "Chà, về mặt kỹ thuật thì nó được làm từ một con quái vật."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAFFLES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAFFLES"
msgid "Waffles are no way to prepare for battle!"
msgstr "Bánh quế không phải là cách để chuẩn bị cho chiến trận!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGBOSS_ROBOT"
msgid "'Tis an iron golem."
msgstr "Đó là một con golem sắt."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE"
msgid "'Tis not battle ready yet."
msgstr "Nó chưa sẵn sàng cho chiến trận đâu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT"
msgid "The seed of an iron golem."
msgstr "Mầm mống của một con golem sắt."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS"
msgid "Bestow upon it its rightful arms!"
msgstr "Hãy ban cho nó vũ khí xứng tầm đi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGBOSS_ROBOT_LEG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGBOSS_ROBOT_LEG"
msgid "We have severed the iron golem's limbs and yet it still stands."
msgstr "Chúng ta đã chặt đứt chân tay của con golem sắt mà nó vẫn đứng vững."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGBOSS_ROBOT_POSSESSED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGBOSS_ROBOT_POSSESSED"
msgid "The forged beast is cursed!"
msgstr "Con quái vật rèn giũa này đã bị nguyền rủa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGBOSS_ROBOT_SECRET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGBOSS_ROBOT_SECRET"
msgid "What doth he veil from us?"
msgstr "Hắn đang che giấu điều gì khỏi chúng ta thế nhỉ?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGDRONE_BEACON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGDRONE_BEACON"
msgid "It doth form a wall unseen? Witchcraft!"
msgstr "Nó tạo ra một bức tường vô hình á? Phép thuật đấy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGDRONE_FLYING.DAMAGED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGDRONE_FLYING.DAMAGED"
msgid "'Tis dead but its parts may bring new life to another."
msgstr "Nó đã chết nhưng các bộ phận của nó có thể mang lại sự sống mới cho thứ khác."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGDRONE_FLYING.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGDRONE_FLYING.GENERIC"
msgid "Cursed iron harpies!"
msgstr "Lũ hắc điểu sắt bị nguyền rủa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGDRONE_FLYING.INACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGDRONE_FLYING.INACTIVE"
msgid "It slumbers."
msgstr "Nó đang ngủ."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGDRONE_PARTS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGDRONE_PARTS"
msgid "Clockwork from a cursed contrivance."
msgstr "Bánh răng từ một cỗ máy bị nguyền rủa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGDRONE_ROLLING.DAMAGED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGDRONE_ROLLING.DAMAGED"
msgid "Shall it be resurrected, or its steel organs claimed to renew another?"
msgstr "Liệu nó sẽ được hồi sinh, hay nội tạng bằng thép sẽ được dùng để tân trang cái khác?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY"
msgid "'Tis friend, no longer foe."
msgstr "Đó là bạn, không còn là thù nữa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGDRONE_ROLLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGDRONE_ROLLING.GENERIC"
msgid "I shall sunder thee, O metal menace!"
msgstr "Ta sẽ xé xác ngươi ra, hỡi mối họa kim loại!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGDRONE_ROLLING.INACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGDRONE_ROLLING.INACTIVE"
msgid "It slumbers."
msgstr "Nó đang ngủ."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGPUNKBITS_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGPUNKBITS_KIT"
msgid "How may one kill with this?"
msgstr "Làm thế nào để giết người bằng thứ này đây?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGPUNKHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGPUNKHAT"
msgid "This helm doth be possessed by the spirit of a cunning warrior."
msgstr "Chiếc mũ giáp này bị ám bởi tinh thần của một chiến binh xảo quyệt."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGPUNK_BITS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGPUNK_BITS"
msgid "What use would a warrior have for such leavings?"
msgstr "Một chiến binh cần gì đống đồ thừa thãi này chứ?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGPUNK_CAGEWALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGPUNK_CAGEWALL"
msgid "Let no soul flee the arena!"
msgstr "Không linh hồn nào được phép trốn khỏi võ đài!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGPUNK_FLOOR_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGPUNK_FLOOR_KIT"
msgid "Njord will not be pleased."
msgstr "Njord sẽ không vui đâu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGPUNK_LEVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGPUNK_LEVER"
msgid "A warrior trusts not cursed toggles."
msgstr "Một chiến binh không tin tưởng vào những chiếc cần gạt bị nguyền rủa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGPUNK_WORKSTATION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGPUNK_WORKSTATION"
msgid "What maketh the gear-wright now?"
msgstr "Tên thợ chế tạo bánh răng đang làm gì thế nhỉ?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_ITEM_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_ITEM_1"
msgid "He hath left his gauntlet in our realm."
msgstr "Hắn đã để lại găng tay của mình trong vương quốc của chúng ta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_ITEM_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_ITEM_2"
msgid "These runes hath taken physical form."
msgstr "Những cổ văn này đã hiện hữu thành thể xác."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_MACHINERY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_MACHINERY"
msgid "Be these the remains of a sacked outpost?"
msgstr "Đây có phải là tàn tích của một tiền đồn bị cướp phá không?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE"
msgid "Save it for the scholars!"
msgstr "Hãy để dành nó cho mấy học giả!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_NPC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_NPC"
msgid "Hail stranger! Are ye friend or foe?"
msgstr "Chào người lạ! Ngươi là bạn hay thù?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_NPC_MUTATIONS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_NPC_MUTATIONS"
msgid "'Twas my pleasure dispatching that beast."
msgstr "Thật là vinh hạnh khi được tiễn con quái vật đó về chầu trời."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_NPC_WAGPUNK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_NPC_WAGPUNK"
msgid "The man doth make haste."
msgstr "Gã này đi nhanh thật đấy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_TOOL_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_TOOL_1"
msgid "Mayhaps this is what I seek."
msgstr "Biết đâu đây chính là thứ ta đang tìm kiếm."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_TOOL_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_TOOL_2"
msgid "The odd stranger requested a tool, mayhaps this is it."
msgstr "Gã người lạ kỳ lạ kia đòi một món công cụ, nhỡ đâu đây chính là nó."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_TOOL_3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_TOOL_3"
msgid "Is this what the odd stranger seeks?"
msgstr "Đây có phải là thứ mà gã người lạ kỳ lạ đang tìm không?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_TOOL_4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_TOOL_4"
msgid "Mayhaps this is what the odd stranger lost."
msgstr "Biết đâu đây là thứ mà gã người lạ kỳ lạ đã đánh mất."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_TOOL_5
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAGSTAFF_TOOL_5"
msgid "How strange. Perhaps it belongs to that odd stranger."
msgstr "Lạ thật. Có lẽ nó thuộc về gã người lạ kỳ lạ đó."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALKINGPLANK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALKINGPLANK"
msgid "I shall never abandon my vessel!"
msgstr "Ta sẽ không bao giờ bỏ rơi chiến thuyền của mình!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALKINGPLANK_ANCIENT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALKINGPLANK_ANCIENT"
msgid "I shall never abandon my vessel!"
msgstr "Ta sẽ không bao giờ bỏ rơi chiến thuyền của mình!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALKINGPLANK_GRASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALKINGPLANK_GRASS"
msgid "I shall never abandon my vessel!"
msgstr "Ta sẽ không bao giờ bỏ rơi chiến thuyền của mình!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALKINGPLANK_YOTD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALKINGPLANK_YOTD"
msgid "Nay, a Viking doesn't quit so easily!"
msgstr "Không, một người Viking không dễ dàng bỏ cuộc thế đâu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALKING_STICK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALKING_STICK"
msgid "Carved with a fine blade, by a skilled hand."
msgstr "Được chạm khắc bằng một lưỡi dao tinh xảo, bởi một đôi tay điêu luyện."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_DREADSTONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_DREADSTONE"
msgid "These fortifications will strike fear into my enemies' hearts!"
msgstr "Những công sự này sẽ gieo rắc sự sợ hãi vào trái tim kẻ thù của ta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_DREADSTONE_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_DREADSTONE_ITEM"
msgid "Fashioned from cursed stone."
msgstr "Được tạo ra từ loại đá bị nguyền rủa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_HAY.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_HAY.BURNT"
msgid "That won't do at all."
msgstr "Thế này thì không ổn chút nào."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_HAY.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_HAY.GENERIC"
msgid "A minor deterrent to attackers."
msgstr "Một vật cản cỏn con đối với kẻ địch."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_HAY_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_HAY_ITEM"
msgid "Perhaps my foes will get lost in this hay."
msgstr "Có lẽ kẻ thù của ta sẽ lạc lối trong đống cỏ này."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_MOONROCK"
msgid "Wholly impregnable, a worthy fortification!"
msgstr "Hoàn toàn kiên cố, một công sự xứng tầm!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_MOONROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_MOONROCK_ITEM"
msgid "Our fortress shall be impenetrable!"
msgstr "Pháo đài của chúng ta sẽ bất khả xâm phạm!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_RUINS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_RUINS"
msgid "Nigh impenetrable."
msgstr "Gần như bất khả xâm phạm."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_RUINS_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_RUINS_2"
msgid "Nigh impenetrable."
msgstr "Gần như bất khả xâm phạm."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_RUINS_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_RUINS_ITEM"
msgid "Only the finest barriers for my fort."
msgstr "Chỉ những hàng rào tuyệt vời nhất mới xứng cho pháo đài của ta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_SCRAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_SCRAP"
msgid "It'll do."
msgstr "Tạm ổn."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_SCRAP_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_SCRAP_ITEM"
msgid "It'll do."
msgstr "Tạm ổn."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_STONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_STONE"
msgid "My enemies will dash themselves on these rocks."
msgstr "Kẻ thù của ta sẽ lao đầu vào những cục đá này cho mà xem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_STONE_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_STONE_2"
msgid "My enemies will dash themselves on these rocks."
msgstr "Kẻ thù của ta sẽ lao đầu vào những cục đá này cho mà xem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_STONE_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_STONE_ITEM"
msgid "A sturdy wall, fashioned from the earth."
msgstr "Một bức tường vững chắc, được tạo nên từ đất mẹ."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_WOOD.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_WOOD.BURNT"
msgid "Fire, wood's only weakness!"
msgstr "Lửa, điểm yếu duy nhất của gỗ!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_WOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_WOOD.GENERIC"
msgid "It may impale a foe."
msgstr "Nó có thể đâm thủng kẻ thù đấy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_WOOD_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_WOOD_ITEM"
msgid "A mediocre fortification."
msgstr "Một công sự tầm thường."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS"
msgid "Those tusks could pierce even the finest armor."
msgstr "Cặp ngà đó có thể đâm thủng cả bộ giáp tốt nhất."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUSHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUSHAT"
msgid "Highland filth!"
msgstr "Lũ rác rưởi vùng cao!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS_CAMP.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS_CAMP.EMPTY"
msgid "They have departed for a great journey."
msgstr "Chúng đã khởi hành cho một chuyến đi dài."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS_CAMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS_CAMP.GENERIC"
msgid "A proper winter camp."
msgstr "Một trại mùa đông đúng chuẩn."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS_TUSK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS_TUSK"
msgid "Rended from the mouth of the sea beast."
msgstr "Được giật ra từ miệng của con quái vật biển."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.ATTACKER"
msgid "Consider your actions wisely, %s."
msgstr "Hãy suy nghĩ kỹ về hành động của mình đi, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.FIRESTARTER"
msgid "%s, why do you break your cherished code?"
msgstr "%s, sao anh lại phá vỡ quy tắc đáng trân trọng của mình vậy?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.GENERIC"
msgid "Good health to you, %s, and to your loyal beast!"
msgstr "Chúc ngươi dồi dào máu, %s, và cả con quái vật trung thành của ngươi nữa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.GHOST"
msgid "By my honor, I will bring you back to this world!"
msgstr "Vì danh dự của ta, ta sẽ đưa ngươi trở lại thế giới này!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.MURDERER"
msgid "Have at thee, you and your wicked beast!"
msgstr "Đỡ lấy này, mày và con quái vật độc ác của mày!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.REVIVER"
msgid "%s carries with him a true sense of honor."
msgstr "%s mang trong mình một ý thức danh dự thực sự."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTERHAT"
msgid "The helm of the \"Pinetree Pioneer\" clan."
msgstr "Mũ giáp của gia tộc \"Tiên phong Cây thông\"."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WANDA.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WANDA.ATTACKER"
msgid "You think it wise to test me, %s?"
msgstr "Ngươi nghĩ thử thách ta là khôn ngoan sao, %s?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WANDA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WANDA.FIRESTARTER"
msgid "I don't wish to question your intentions, %s..."
msgstr "Ta không muốn nghi ngờ ý đồ của cô đâu, %s..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WANDA.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WANDA.GENERIC"
msgid "Good health to you through the ages, %s!"
msgstr "Chúc ngươi luôn dồi dào máu qua năm tháng, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WANDA.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WANDA.GHOST"
msgid "Fear not! I will find you a heart, with utmost haste!"
msgstr "Đừng sợ! Ta sẽ tìm một trái tim cho ngươi với tốc độ nhanh nhất!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WANDA.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WANDA.MURDERER"
msgid "Thou shall answer for this betrayal, %s! Meet my spear!"
msgstr "Ngươi sẽ phải trả giá cho sự phản bội này, %s! Đón lấy giáo của ta này!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WANDA.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WANDA.REVIVER"
msgid "%s is a powerful ally indeed."
msgstr "%s quả là một đồng minh mạnh mẽ."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WANDERINGTRADER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WANDERINGTRADER.GENERIC"
msgid "Wretched beast. Shall I grant it peace?"
msgstr "Con quái vật khốn khổ. Ta có nên ban cho nó sự giải thoát không?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WANDERINGTRADER.REVEALED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WANDERINGTRADER.REVEALED"
msgid "The pelt-bearer cometh to ply his wares."
msgstr "Kẻ mang áo choàng lông đang tới để bày biện hàng hóa của hắn."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARDROBE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARDROBE.BURNING"
msgid "No, my furs and cloaks!"
msgstr "Không, đống áo lông và áo choàng của ta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARDROBE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARDROBE.BURNT"
msgid "No use crying over burnt pelts."
msgstr "Khóc lóc cũng chẳng ích gì cho đống lông thú bị cháy đâu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARDROBE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARDROBE.GENERIC"
msgid "That's where I keep my furs and cloaks."
msgstr "Đó là nơi ta cất giữ áo lông và áo choàng của mình."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARG"
msgid "Be that you, Fenrir?"
msgstr "Có phải ngươi đấy không, Fenrir?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGCORPSE.BURNING"
msgid "Thou art worthy of a Viking funeral."
msgstr "Ngươi xứng đáng nhận được một đám tang kiểu Viking."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGCORPSE.GENERIC"
msgid "The creature is slain."
msgstr "Sinh Vật Lạ đã bị hạ gục."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGCORPSE.REVIVING"
msgid "The beast's spirit will not be put to rest!"
msgstr "Linh hồn của con quái vật sẽ không chịu nghỉ ngơi đâu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGLET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGLET"
msgid "Ha! I've felled more fearsome beasts than ye!"
msgstr "Ha! Ta đã hạ gục nhiều con quái vật đáng sợ hơn ngươi nhiều!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGSHRINE.BURNT"
msgid "Laid to waste."
msgstr "Đã bị san bằng."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGSHRINE.EMPTY"
msgid "What doth thou need?"
msgstr "Ngươi cần gì nào?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGSHRINE.GENERIC"
msgid "The gods are pleased!"
msgstr "Các vị thần rất hài lòng!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.ATTACKER"
msgid "What nefarious plots doth %s stew upon?"
msgstr "%s đang mưu tính trò bất lương gì thế nhỉ?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.FIRESTARTER"
msgid "%s's summoned Hel's flames this day!"
msgstr "%s đã triệu hồi ngọn lửa của Hel vào ngày hôm nay!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.GENERIC"
msgid "Hail, %s, blessed feast-forge!"
msgstr "Chào ngươi, %s, lò tiệc tùng ban phước!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.GHOST"
msgid "The feast hall of Valhalla will one day welcome you. But not today."
msgstr "Đại sảnh tiệc tùng của Valhalla một ngày nào đó sẽ chào đón ngươi. Nhưng không phải hôm nay."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.MURDERER"
msgid "We will hold a valorous feast at your defeat!"
msgstr "Chúng ta sẽ tổ chức một bữa tiệc hào hùng khi ngươi thất thủ!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.REVIVER"
msgid "%s's heart is as full as his belly."
msgstr "Trái tim của %s cũng đầy đặn như cái bụng của anh ta vậy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAR_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAR_BLUEPRINT"
msgid "Garb befitting a warrior's steed!"
msgstr "Trang phục xứng tầm chiến mã của chiến binh!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WASPHIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WASPHIVE"
msgid "Bees of war!"
msgstr "Những chú ong chiến trận!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERBALLOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERBALLOON"
msgid "Prepare to engage in water-y battle!"
msgstr "Chuẩn bị tham gia trận chiến nước nôi nào!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERINGCAN.EMPTY"
msgid "The plants expect me to fetch water for them as well?"
msgstr "Lũ thực vật cũng muốn ta đi xách nước cho chúng nữa sao?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERINGCAN.GENERIC"
msgid "Watering the garden is not a task befitting a warrior."
msgstr "Tưới cây không phải là nhiệm vụ xứng tầm với một chiến binh."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELON"
msgid "It makes a good sound when you hit it."
msgstr "Nó phát ra âm thanh khá hay khi ngươi đánh vào đó."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELONHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELONHAT"
msgid "It's almost like wearing a pelt."
msgstr "Cảm giác gần giống như đang mặc áo lông thú vậy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELONICLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELONICLE"
msgid "You cannot fool me by hiding in frozen fruit, stick."
msgstr "Ngươi không thể lừa ta bằng cách trốn trong hoa quả đóng băng đâu, cái que ạ."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELON_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELON_COOKED"
msgid "Warm and red, but it doesn't flow."
msgstr "Ấm áp và đỏ rực, nhưng nó không chảy ra."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELON_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELON_OVERSIZED"
msgid "Was this grown by a jotunn?"
msgstr "Cái này được trồng bởi một tên jotunn à?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELON_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELON_SEEDS"
msgid "Seedy."
msgstr "Nhiều hạt thật."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERPLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERPLANT"
msgid "Have we entered the realm of giants?"
msgstr "Chúng ta đã bước vào vương quốc của những người khổng lồ rồi sao?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERPLANT_BABY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERPLANT_BABY"
msgid "Grow fast and strong, young one."
msgstr "Hãy lớn thật nhanh và mạnh mẽ nhé, bé con."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERPLANT_BOMB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERPLANT_BOMB"
msgid "Have at thee, plant!"
msgstr "Đỡ lấy đòn này, thực vật!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERPLANT_PLANTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERPLANT_PLANTER"
msgid "Fear not, I shall return you to the sea in time."
msgstr "Đừng sợ, rồi ta sẽ đưa ngươi trở lại đại dương đúng lúc."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERPUMP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERPUMP"
msgid "We hath safeguarded our vessel against a fiery end."
msgstr "Chúng ta đã bảo vệ tàu chiến của mình khỏi một cái kết lửa cháy rực."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERTREE_PILLAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERTREE_PILLAR"
msgid "By the gods, have I found Yggdrasil itself?"
msgstr "Hỡi các vị thần, có phải ta đã tìm thấy chính Yggdrasil rồi không?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERTREE_ROOT"
msgid "What is it you seek, yon root?"
msgstr "Ngươi đang tìm kiếm cái gì thế, cái rễ cây kia?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.ATTACKER"
msgid "%s is tempting fate."
msgstr "%s đang thách thức số phận."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.FIRESTARTER"
msgid "A fellow Viking, forged in flames!"
msgstr "Một đồng đội Viking, được rèn giũa trong biển lửa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.GENERIC"
msgid "Hail, %s, fellow shieldmaiden!"
msgstr "Chào mừng, %s, nữ chiến binh khiên đồng môn!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.GHOST"
msgid "You'll not away to Valhalla yet, %s. A heart!"
msgstr "Ngươi chưa được về Valhalla đâu, %s. Cần một trái tim!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.MURDERER"
msgid "There can be only one!"
msgstr "Chỉ có thể tồn tại một người duy nhất!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.REVIVER"
msgid "%s, the perfect warrior!"
msgstr "%s, nữ chiến binh hoàn hảo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHRHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHRHAT"
msgid "The power of the unicorn is great."
msgstr "Sức mạnh của kỳ lân thật lớn lao."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR_IMPROVEDHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR_IMPROVEDHAT"
msgid "The unicorn hath bestowed its power onto me."
msgstr "Kỳ lân đã ban sức mạnh của nó cho ta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR_SHIELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR_SHIELD"
msgid "I shall defend my allies with spear and shield!"
msgstr "Ta sẽ bảo vệ đồng đội bằng giáo và khiên!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXED_PLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXED_PLANT"
msgid "Unnaturally preserved... it doth make one's skin crawl."
msgstr "Được bảo quản một cách phi tự nhiên... khiến người ta nổi hết cả da gà."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXPAPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXPAPER"
msgid "Waxen to the touch."
msgstr "Sờ vào thấy giống sáp."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.ATTACKER"
msgid "I sense Loki's influence in %s."
msgstr "Ta cảm nhận được ảnh hưởng của Loki ở %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.FIRESTARTER"
msgid "Loki has brought %s into a world of flame."
msgstr "Loki đã đưa %s vào một thế giới ngập tràn lửa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.GENERIC"
msgid "Greetings, %s, my ally!"
msgstr "Chào mừng, %s, đồng minh của ta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.GHOST"
msgid "A heart could return %s to this realm if we so wished."
msgstr "Một trái tim có thể đưa %s trở lại cõi này nếu chúng ta muốn."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.MURDERER"
msgid "%s! Back to your old tricks, I see!"
msgstr "%s! Lại giở trò cũ ra rồi hả!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.REVIVER"
msgid "%s has uncovered the kindness buried within his heart."
msgstr "%s đã khám phá ra sự tử tế ẩn giấu trong tim mình."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELLJOURNAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELLJOURNAL.GENERIC"
msgid "A tragic tale of woe and misery!"
msgstr "Một câu chuyện bi thảm về nỗi buồn và sự khốn khổ!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.ATTACKER"
msgid "There's a new hunger in %s's eyes."
msgstr "Có một sự thèm khát mới trong ánh mắt của %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.FIRESTARTER"
msgid "His flames are as open as his heart."
msgstr "Ngọn lửa của cậu ta cũng cởi mở như tấm lòng vậy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.GENERIC"
msgid "Blessings upon you, spiderchild %s!"
msgstr "Cầu phúc cho ngươi, đứa trẻ nhện %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.GHOST"
msgid "Return with Sleipnir's swiftness, many-legged one."
msgstr "Hãy quay lại với tốc độ của Sleipnir nhé, hỡi kẻ nhiều chân."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.MURDERER"
msgid "I've felled greater monsters than you, %s!"
msgstr "Ta đã hạ gục những con quái vật vĩ đại hơn ngươi nhiều, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.REVIVER"
msgid "%s's spirit burns brighter than Sol."
msgstr "Tâm hồn của %s cháy sáng rực rỡ hơn cả Sol."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBERSKULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBERSKULL"
msgid "He fought boldly, but his burial will not be that of a Viking."
msgstr "Cậu ta chiến đấu rất dũng cảm, nhưng tang lễ sẽ không theo kiểu Viking đâu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER_SPIDER_MINION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER_SPIDER_MINION"
msgid "I see naught but allies."
msgstr "Ta chẳng thấy gì ngoài những đồng minh cả."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEED_IVY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEED_IVY"
msgid "This weed is armed with thorns."
msgstr "Cỏ dại này được trang bị cả gai đấy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.ATTACKER"
msgid "Do not test me, fair maiden!"
msgstr "Đừng thử thách ta, thiếu nữ xinh đẹp!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.FIRESTARTER"
msgid "Ah. Have you singed your dress, fair maiden?"
msgstr "À. Cô lỡ làm cháy váy của mình rồi à, thiếu nữ xinh đẹp?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.GENERIC"
msgid "Spirits be with you, %s!"
msgstr "Cầu mong các linh hồn đồng hành cùng ngươi, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.GHOST"
msgid "%s's restless spirit could be revived with a heart."
msgstr "Linh hồn không yên nghỉ của %s có thể được hồi sinh bằng một trái tim."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.MURDERER"
msgid "%s, your body is weak but your heart is strong! Fight!"
msgstr "%s, thể xác cô yếu đuối nhưng trái tim lại kiên cường! Chiến đấu đi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.REVIVER"
msgid "%s is channeling the spirit of Eir."
msgstr "%s đang kết nối với tinh thần của Eir."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY_RESURRECTIONGRAVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY_RESURRECTIONGRAVE"
msgid "A warrior doth run toward death, not from it!"
msgstr "Một chiến binh phải lao về phía cái chết, chứ không trốn chạy nó!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEREITEM_BEAVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEREITEM_BEAVER"
msgid "Is this meant to summon your fylgja?"
msgstr "Cái này dùng để triệu hồi fylgja của ngươi à?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEREITEM_GOOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEREITEM_GOOSE"
msgid "It's... er... very fearsome!"
msgstr "Nó... ừm... rất đáng sợ đấy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEREITEM_MOOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEREITEM_MOOSE"
msgid "It represents a warrior's spirit!"
msgstr "Nó đại diện cho tinh thần của một chiến binh!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.ATTACKER"
msgid "Do you bite your thumb at me, mime?"
msgstr "Ngươi đang muốn khiêu khích ta đấy à, diễn viên kịch câm?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.FIRESTARTER"
msgid "Don't ruin your fair makeup with ashes, %s."
msgstr "Đừng làm hỏng lớp trang điểm đẹp đẽ của mình vì tro tàn nhé, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.GENERIC"
msgid "Good health to you, %s!"
msgstr "Chúc ngươi dồi dào máu, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.GHOST"
msgid "Meditate on Hoenir's blessings, %s. I'll find a heart."
msgstr "Hãy suy ngẫm về ân huệ của Hoenir đi, %s. Ta sẽ đi tìm một trái tim."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.MURDERER"
msgid "May we meet again in Valhalla!"
msgstr "Mong chúng ta lại được gặp nhau ở Valhalla!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.REVIVER"
msgid "%s has Hoenir's blessing."
msgstr "%s đang nhận được ân huệ của Hoenir."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WETGOOP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WETGOOP"
msgid "Slop."
msgstr "Cháo cám."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WETPAPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WETPAPER"
msgid "Tis drenched."
msgstr "Nó ướt sũng rồi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WETPOUCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WETPOUCH"
msgid "A treasure lies within!"
msgstr "Bảo vật đang ẩn giấu bên trong!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WHIP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WHIP"
msgid "Loud and powerful!"
msgstr "Đanh thép và uy lực!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.ATTACKER"
msgid "If %s is looking for trouble, I shall oblige!"
msgstr "Nếu %s đang tìm kiếm rắc rối, ta sẽ chiều lòng!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.FIRESTARTER"
msgid "I'll not question your wisdom, %s."
msgstr "Ta sẽ không hoài nghi sự thông thái của cô đâu, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.GENERIC"
msgid "Good health and wisdom to you, elder %s!"
msgstr "Chúc vị trưởng bối %s luôn dồi dào máu và trí tuệ!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.GHOST"
msgid "A heart! A heart! My base for a heart!"
msgstr "Một trái tim! Một trái tim! Ta đổi cả căn cứ lấy một trái tim!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.MURDERER"
msgid "Murderer! Face me in battle!"
msgstr "Kẻ sát nhân! Ra đây đấu tay đôi với ta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.REVIVER"
msgid "The wisdom of Wotan dwells within you, %s."
msgstr "Trí tuệ của Wotan ẩn chứa bên trong ngươi, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.ATTACKER"
msgid "Should it come to blows, may the best maiden triumph."
msgstr "Nếu phải động gươm động giáo, mong thiếu nữ xuất sắc nhất sẽ chiến thắng."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.FIRESTARTER"
msgid "%s has more fire in her eyes than usual."
msgstr "%s có nhiều lửa trong mắt hơn mọi khi đấy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.GENERIC"
msgid "Greetings, %s, the Inflammable!"
msgstr "Chào mừng, %s, Kẻ Dễ Cháy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.GHOST"
msgid "A heart shall wrench %s back from the jaws of death!"
msgstr "Một trái tim sẽ kéo %s trở về từ cõi chết!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.MURDERER"
msgid "My spear was forged in passionate fires, %s!"
msgstr "Giáo của ta được rèn trong những ngọn lửa đầy nhiệt huyết đấy, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.REVIVER"
msgid "%s has a noble heart."
msgstr "%s có một trái tim cao cả."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW_EMBER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW_EMBER"
msgid "only_used_by_willow"
msgstr "chỉ_được_sử_dụng_bởi_willow"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.ATTACKER"
msgid "Your honor wavers, %s."
msgstr "Danh dự của ngươi đang lung lay đấy, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.FIRESTARTER"
msgid "Hm. I worry about you sometimes, %s."
msgstr "Hừm. Thỉnh thoảng ta cũng thấy lo lắng cho anh đấy, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.GENERIC"
msgid "Wisdom guide you, %s!"
msgstr "Mong trí tuệ dẫn lối cho ngươi, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.GHOST"
msgid "The fate of the Draugr is not yours, %s. A heart!"
msgstr "Số phận của Draugr không phải là của ngươi đâu, %s. Cần một trái tim!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.MURDERER"
msgid "%s! Let us settle this in battle!"
msgstr "%s! Hãy giải quyết chuyện này trên chiến trường đi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.REVIVER"
msgid "%s protects our people."
msgstr "%s bảo vệ người dân của chúng ta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINCH.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINCH.GENERIC"
msgid "The ocean is mine to pillage."
msgstr "Đại dương là chiến lợi phẩm để ta cướp bóc."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINCH.HOLDING_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINCH.HOLDING_ITEM"
msgid "Behold, my prize!"
msgstr "Nhìn kìa, chiến lợi phẩm của ta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINCH.RETRIEVING_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINCH.RETRIEVING_ITEM"
msgid "And to the victor, the spoils!"
msgstr "Và chiến lợi phẩm sẽ thuộc về kẻ chiến thắng!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.ATTACKER"
msgid "Dost thou test me, %s?"
msgstr "Ngươi đang thử thách ta đấy à, %s?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.FIRESTARTER"
msgid "%s's flames could temper steel."
msgstr "Ngọn lửa của %s có thể tôi luyện cả thép."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.GENERIC"
msgid "Greetings, brave %s!"
msgstr "Chào mừng, %s dũng cảm!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.GHOST"
msgid "%s hath fallen! A heart!"
msgstr "%s đã ngã xuống! Cần một trái tim!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.MURDERER"
msgid "I shall unleash Ragnarok upon thee!"
msgstr "Ta sẽ giáng trọn cơn thịnh nộ Ragnarok xuống đầu ngươi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.REVIVER"
msgid "%s is guided by Brokkr."
msgstr "%s được dẫn dắt bởi Brokkr."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.BURNING"
msgid "Tis engulfed in flame!"
msgstr "Nó đang chìm trong biển lửa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.BURNT"
msgid "'Twas devoured by Hel's fire!"
msgstr "Đã bị ngọn lửa của Hel nuốt chửng!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.GENERIC"
msgid "Tis fueled by glorious magic."
msgstr "Nó được vận hành bởi ma thuật huy hoàng."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.LOWPOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.LOWPOWER"
msgid "T'will not hold out much longer!"
msgstr "Nó trụ không nổi lâu nữa đâu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.OFF"
msgid "It hath lost its incredible power!"
msgstr "Nó đã mất đi sức mạnh tuyệt vời rồi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.OVERLOADED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.OVERLOADED"
msgid "It must catch its breath."
msgstr "Nó phải lấy lại hơi sức đã."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.BURNING"
msgid "Tis engulfed in flame!"
msgstr "Nó đang chìm trong biển lửa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.BURNT"
msgid "'Twas devoured by Hel's fire!"
msgstr "Đã bị ngọn lửa của Hel nuốt chửng!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.GENERIC"
msgid "The tinkerer hath many tricks."
msgstr "Cô thợ máy có rất nhiều thủ pháp hay ho."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER"
msgid "T'will not hold out much longer!"
msgstr "Nó trụ không nổi lâu nữa đâu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.OFF"
msgid "It hath lost its incredible power!"
msgstr "Nó đã mất đi sức mạnh tuyệt vời rồi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.BURNING"
msgid "Tis engulfed in flame!"
msgstr "Nó đang chìm trong biển lửa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.BURNT"
msgid "'Twas devoured by Hel's fire!"
msgstr "Đã bị ngọn lửa của Hel nuốt chửng!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.GENERIC"
msgid "Reinforcements hath arrived! To battle!"
msgstr "Viện binh đã đến! Ra trận thôi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.OFF"
msgid "It has no fighting spirit."
msgstr "Nó không có chút tinh thần chiến đấu nào cả."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.SLEEP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.SLEEP"
msgid "Reinforcements hath arrived! To battle!"
msgstr "Viện binh đã đến! Ra trận thôi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_HOLOTELEBRELLA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_HOLOTELEBRELLA"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_HOLOTELEPAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_HOLOTELEPAD"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_MACHINEPARTS_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_MACHINEPARTS_1"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_MACHINEPARTS_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_MACHINEPARTS_2"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_RECIPESCANNER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_RECIPESCANNER"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_REMOTE.CHARGED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_REMOTE.CHARGED"
msgid "The tinkerer commands her armaments with the touch of a button."
msgstr "Cô thợ máy điều khiển vũ khí của mình chỉ bằng một cái nút bấm."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_REMOTE.CHARGING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_REMOTE.CHARGING"
msgid "The tinkerer commands her armaments with the touch of a button."
msgstr "Thợ mày mò điều khiển vũ khí chỉ với một cái nút."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_REMOTE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_REMOTE.GENERIC"
msgid "The tinkerer commands her armaments with the touch of a button."
msgstr "Thợ mày mò điều khiển vũ khí chỉ với một cái nút."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_REMOTE.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_REMOTE.OFF"
msgid "It has no fighting spirit."
msgstr "Nó chẳng có chút tinh thần chiến đấu nào cả."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.BURNING"
msgid "Tis engulfed in flame!"
msgstr "Nó bị ngọn lửa bao trùm rồi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.BURNT"
msgid "'Twas devoured by Hel's fire!"
msgstr "Nó đã bị ngọn lửa của Hel nuốt chửng!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.GENERIC"
msgid "It can't get enough of me!"
msgstr "Nó quấn quýt tôi mãi không thôi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.OFF"
msgid "It has no fighting spirit."
msgstr "Nó chẳng có chút tinh thần chiến đấu nào cả."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.SLEEP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.SLEEP"
msgid "It can't get enough of me!"
msgstr "Nó quấn quýt tôi mãi không thôi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGED"
msgid "Rest and regain your strength, little one."
msgstr "Nghỉ ngơi và lấy lại sức đi, bé con."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGING"
msgid "Rest and regain your strength, little one."
msgstr "Nghỉ ngơi và lấy lại sức đi, bé con."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_STORAGE_ROBOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_STORAGE_ROBOT.GENERIC"
msgid "The tinkerer's mechanical page."
msgstr "Trang giấy cơ khí của thợ mày mò."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_STORAGE_ROBOT.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_STORAGE_ROBOT.OFF"
msgid "Rest and regain your strength, little one."
msgstr "Nghỉ ngơi và lấy lại sức đi, bé con."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_STORAGE_ROBOT.SLEEP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_STORAGE_ROBOT.SLEEP"
msgid "The tinkerer's mechanical page."
msgstr "Trang giấy cơ khí của thợ mày mò."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_TELEBRELLA.CHARGED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_TELEBRELLA.CHARGED"
msgid "My ally is most resourceful."
msgstr "Đồng minh của tôi thật lắm mưu mẹo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_TELEBRELLA.CHARGING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_TELEBRELLA.CHARGING"
msgid "My ally is most resourceful."
msgstr "Đồng minh của tôi thật lắm mưu mẹo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_TELEBRELLA.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_TELEBRELLA.GENERIC"
msgid "My ally is most resourceful."
msgstr "Đồng minh của tôi thật lắm mưu mẹo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_TELEBRELLA.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_TELEBRELLA.OFF"
msgid "It has no fighting spirit."
msgstr "Nó chẳng có chút tinh thần chiến đấu nào cả."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNING"
msgid "Tis engulfed in flame!"
msgstr "Nó bị ngọn lửa bao trùm rồi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNT"
msgid "'Twas devoured by Hel's fire!"
msgstr "Nó đã bị ngọn lửa của Hel nuốt chửng!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.GENERIC"
msgid "Bring home the spoils of war!"
msgstr "Mang chiến lợi phẩm về nhà nào!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.OFF"
msgid "It has no fighting spirit."
msgstr "Nó chẳng có chút tinh thần chiến đấu nào cả."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERHAT"
msgid "Warm, but not suited for combat."
msgstr "Ấm áp đấy, nhưng không hợp để chiến đấu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTEROMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTEROMETER.BURNT"
msgid "The measuring device has been slain by Loge."
msgstr "Thiết bị đo đạc đã bị Loge hạ sát."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTEROMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTEROMETER.GENERIC"
msgid "If only it measured the heat of battle."
msgstr "Ước gì nó đo được sức nóng của trận chiến."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTFUEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTFUEL"
msgid "The essence of Jol!"
msgstr "Bản chất của Jol!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.ALMOST_DONE_COOKING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.ALMOST_DONE_COOKING"
msgid "The wait is almost at an end."
msgstr "Sắp đến lúc được ăn rồi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.COOKING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.COOKING"
msgid "Locked in a glorious cooking battle."
msgstr "Bị khóa trong một trận chiến nấu nướng hào hùng."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.DISH_READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.DISH_READY"
msgid "At long last, we feast!"
msgstr "Cuối cùng thì chúng ta cũng được mở tiệc!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.GENERIC"
msgid "A hearth for cooking a glorious feast!"
msgstr "Một lò sưởi để nấu một bữa tiệc hào hùng!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD1"
msgid "How dost I free you from the bread, man of ginger??"
msgstr "Làm sao ta giải thoát ngươi khỏi lớp bánh mì đây, người bánh gừng??"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD2"
msgid "Like a snowflake, it is a gift from the heavens!"
msgstr "Tựa như bông tuyết, đó là một gói quà từ thiên đường!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD3"
msgid "T'would look as divine on the tree as in mine mouth!"
msgstr "Trông treo trên cây hay ngậm trong mồm ta đều tuyệt diệu như nhau!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD4"
msgid "Stay back, foul creation!"
msgstr "Tránh ra, tạo vật ghê tởm!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD5
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD5"
msgid "We feast tonight!"
msgstr "Đêm nay chúng ta mở tiệc!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD6
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD6"
msgid "'Twas plucked straight from my nightmares!"
msgstr "Nó bước ra từ chính những cơn ác mộng của ta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD7
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD7"
msgid "Something so foul shall never pass my lips!"
msgstr "Thứ gớm ghiếc như vậy đừng hòng chạm vào môi ta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD8
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD8"
msgid "Warms the soul."
msgstr "Sưởi ấm linh hồn."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD9
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD9"
msgid "Imbibable eggs!"
msgstr "Trứng có thể uống được!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENT"
msgid "A fragile beauty that must be protected."
msgstr "Một vẻ đẹp mỏng manh cần phải được bảo vệ."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTBOSS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTBOSS"
msgid "Tis not a celebration without a good battle!"
msgstr "Không có một trận chiến hay thì không gọi là ăn mừng!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTFORGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTFORGE"
msgid "Hath been forged in fires."
msgstr "Được rèn trong lửa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTGORGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTGORGE"
msgid "It feeds the festive spirit."
msgstr "Nó nuôi dưỡng tinh thần lễ hội."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTLIGHT"
msgid "Tis a light enchantment, trapped inside a glass ball."
msgstr "Đó là một phép thuật ánh sáng, bị giam cầm bên trong quả cầu thủy tinh."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTPEARL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTPEARL"
msgid "Normally I careth not for baubels. But these doth stir my heart most sweetly."
msgstr "Bình thường ta không màng tới mấy thứ trang sức lặt vặt. Nhưng những thứ này lại làm trái tim ta xao xuyến xiết bao."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.BURNING"
msgid "Woe! Misery!"
msgstr "Than ôi! Thảm họa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.BURNT"
msgid "Its beauty lives on in our hearts."
msgstr "Vẻ đẹp của nó vẫn sống mãi trong tim chúng ta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.CANDECORATE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.CANDECORATE"
msgid "A majestic pine, worthy of celebration!"
msgstr "Một cây thông uy nghiêm, xứng đáng để ăn mừng!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.YOUNG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.YOUNG"
msgid "Grow strong, young one! It is your destiny!"
msgstr "Hãy lớn lên thật mạnh mẽ, bé con! Đó là định mệnh của ngươi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREESTAND.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREESTAND.BURNT"
msgid "Its beauty lives on in our hearts."
msgstr "Vẻ đẹp của nó vẫn sống mãi trong tim chúng ta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREESTAND.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREESTAND.GENERIC"
msgid "It awaits a grand tree!"
msgstr "Nó đang chờ một cái cây vĩ đại!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_DEN"
msgid "The lair of the pinchy beasts."
msgstr "Hang ổ của lũ quái vật kẹp càng."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_MOONGLASS"
msgid "The little beasties have acquired new armor!"
msgstr "Lũ quái vật nhỏ đã có áo giáp mới rồi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_SHELLER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_SHELLER"
msgid "Have at thee, morsel!"
msgstr "Bơi vào đây, miếng thịt nhỏ!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_SHELLER_DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_SHELLER_DEAD"
msgid "Sleep in Valhalla, armored one."
msgstr "Hãy ngủ ngon ở Valhalla nhé, chiến binh mặc giáp."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_SHELLER_DEAD_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_SHELLER_DEAD_COOKED"
msgid "Your armor hides tasty meat."
msgstr "Lớp giáp của ngươi che giấu phần thịt ngon lành."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYBIG.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYBIG.1"
msgid "Hail, beastie!"
msgstr "Chào nhé, quái vật nhỏ!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYBIG.2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYBIG.2"
msgid "Hail, beastie!"
msgstr "Chào nhé, quái vật nhỏ!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYSMALL.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYSMALL.1"
msgid "Wouldst thou like a skritch behind thine ears?"
msgstr "Ngươi có muốn được gãi sau tai không?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYSMALL.2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYSMALL.2"
msgid "Wouldst thou like a skritch behind thine ears?"
msgstr "Ngươi có muốn được gãi sau tai không?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBY_TREAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBY_TREAT"
msgid "Woby doth deserve all manner of fine victuals and sweetmeats."
msgstr "Woby xứng đáng được hưởng mọi loại thức ăn ngon và bánh ngọt hảo hạng."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.ATTACKER"
msgid "%s packs a punch to rival a frost giant."
msgstr "%s có cú đấm mạnh mẽ sánh ngang người khổng lồ băng."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.FIRESTARTER"
msgid "%s seems to have mistakenly fumbled a torch."
msgstr "%s có vẻ đã lóng ngóng làm rơi cây đuốc nhầm chỗ."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.GENERIC"
msgid "Health and strength to you, %s!"
msgstr "Chúc %s luôn dồi dào máu và sức mạnh!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.GHOST"
msgid "A valiant warrior should not be wasted. A heart, a heart!"
msgstr "Một chiến binh dũng cảm không thể cứ thế mà chết phí. Một trái tim, cho tôi một trái tim!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.MURDERER"
msgid "You will pay for your heinous deeds, brute!"
msgstr "Ngươi sẽ phải trả giá vì hành động tàn ác của mình, đồ thô lỗ!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.REVIVER"
msgid "%s, son of Magni."
msgstr "%s, con trai của Magni."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG_WHISTLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG_WHISTLE"
msgid "My ally will get our forces fighting fit!"
msgstr "Đồng minh của tôi sẽ giúp lực lượng chúng ta sẵn sàng chiến đấu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.ATTACKER"
msgid "Thou hast revealed thine true nature, beast!"
msgstr "Ngươi đã lộ nguyên hình rồi đấy, quái vật!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.FIRESTARTER"
msgid "Monkey trickery!"
msgstr "Mưu mẹo của loài khỉ!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.GENERIC"
msgid "Hail, monkey!"
msgstr "Chào nhé, chú khỉ!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.GHOST"
msgid "It seems you have not fared well, beastie."
msgstr "Xem ra ngươi không mấy khá khẩm nhỉ, bé con."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.MURDERER"
msgid "Foul beast! The hunt is on!"
msgstr "Quái vật ghê tởm! Cuộc săn bắt đầu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.REVIVER"
msgid "Thou art a most noble creature."
msgstr "Ngươi là một sinh vật vô cùng cao quý."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODCARVEDHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODCARVEDHAT"
msgid "A helm of the forest."
msgstr "Một chiếc mũ của rừng già."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.ATTACKER"
msgid "I could fell you like so many trees, %s."
msgstr "Ta có thể hạ gục ngươi dễ dàng như đốn cây vậy, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.BEAVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.BEAVER"
msgid "I did not know %s possessed such power!"
msgstr "Ta không ngờ %s lại sở hữu sức mạnh lớn đến vậy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.BEAVERGHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.BEAVERGHOST"
msgid "You went out in a blaze of glory, %s."
msgstr "Ngươi đã ra đi trong ánh hào quang rực rỡ, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.FIRESTARTER"
msgid "Did he mistake \"Loge\" for \"log\"?"
msgstr "Anh ta nhầm \"Loge\" (thần lửa) với \"log\" (khúc gỗ) à?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GENERIC"
msgid "May Yggdrasil bind us as the nine worlds, %s!"
msgstr "Mong Yggdrasil gắn kết chúng ta như chín cõi thế giới, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GHOST"
msgid "The worldtree watches over you, %s."
msgstr "Cây thế giới đang dõi theo ngươi đấy, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GOOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GOOSE"
msgid "%s, you've become a fowl beast!"
msgstr "%s, anh đã biến thành một con quái vật có lông vũ rồi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GOOSEGHOST"
msgid "Worry not, I won't let you leave for Valhalla looking like that!"
msgstr "Đừng lo, ta sẽ không để anh đến Valhalla với cái bộ dạng đó đâu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.MOOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.MOOSE"
msgid "By the gods, I mistook you for a jötunn!"
msgstr "Cứ các thần linh mà xem, ta còn tưởng anh là một tên jötunn (người khổng lồ) cơ đấy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.MOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.MOOSEGHOST"
msgid "Never fear, I'll return you to this realm!"
msgstr "Đừng sợ, ta sẽ đưa anh trở về cõi này!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.MURDERER"
msgid "By Yggdrasil, I will cut you down!"
msgstr "Nhân danh Yggdrasil, ta sẽ chém bay ngươi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.REVIVER"
msgid "%s's heart is as mighty as his beard."
msgstr "Trái tim của %s cũng dũng mãnh như bộ râu của anh ấy vậy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_CHAIR.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_CHAIR.BURNT"
msgid "The gods hath no need for chairs."
msgstr "Các vị thần nào cần đến ghế ngồi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_CHAIR.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_CHAIR.GENERIC"
msgid "A warrior doth not sit."
msgstr "Một chiến binh là không ngồi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_CHAIR.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_CHAIR.OCCUPIED"
msgid "On your feet, soldier!"
msgstr "Đứng lên đi, người lính!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_TABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_TABLE.BURNT"
msgid "The gods need not more tables."
msgstr "Các vị thần không cần thêm bàn ghế nữa đâu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_TABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_TABLE.GENERIC"
msgid "No sorrier sight than a bare table. Let us plunder!"
msgstr "Chẳng có cảnh gì đáng buồn hơn một chiếc bàn trống trơn. Đi cướp bóc thôi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_TABLE.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_TABLE.HAS_ITEM"
msgid "Not the most impressive piece of loot."
msgstr "Không phải chiến lợi phẩm ấn tượng gì cho cam."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.DIRT"
msgid "What's under that dirt?"
msgstr "Có gì bên dưới lớp đất đó nhỉ?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.PLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.PLANT"
msgid "I smell a trap."
msgstr "Ta ngửi thấy mùi bẫy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.WORM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.WORM"
msgid "A snake beast from the depths!"
msgstr "Một con quái vật dạng rắn đến từ đáy vực!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE.GENERIC"
msgid "Does it swallow those fallen in battle?"
msgstr "Nó có nuốt chửng những kẻ ngã xuống trong trận chiến không?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE.OPEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE.OPEN"
msgid "Its maw welcomes me."
msgstr "Cái miệng rộng đang chào đón tôi kìa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE_LIMITED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE_LIMITED"
msgid "It is sickly and weak."
msgstr "Nó trông ốm yếu và rệu rã."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT"
msgid "Glowing treasure, I can't resist!"
msgstr "Kho báu phát sáng, ta không thể cưỡng lại được!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT_LESSER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT_LESSER"
msgid "Glow! Glow with all your might!"
msgstr "Sáng lên nào! Hãy phát sáng hết sức có thể đi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT_PLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT_PLANT"
msgid "I smell a trap."
msgstr "Ta ngửi thấy mùi bẫy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.ATTACKER"
msgid "Rumors of %s's terrible act have spread like weeds."
msgstr "Tin đồn về hành động tồi tệ của %s đã lan rộng như cỏ dại."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.FIRESTARTER"
msgid "%s is sure to be scalded by Hel's flames!"
msgstr "%s chắc chắn sẽ bị bỏng bởi ngọn lửa của Hel!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.GENERIC"
msgid "Greetings, %s, touched by Yggdrasil!"
msgstr "Chào mừng %s, kẻ được Yggdrasil ban phước!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.GHOST"
msgid "My dear friend hath fallen in battle!"
msgstr "Người bạn thân thiết của tôi đã hy sinh trong trận chiến!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.MURDERER"
msgid "I will root you out, monstrous plant!"
msgstr "Ta sẽ nhổ tận gốc ngươi, loài thực vật quái dị!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.REVIVER"
msgid "%s is a kind and formidable healer."
msgstr "%s là một thầy thuốc tốt bụng và đáng gờm."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD"
msgid "It has breathed its last."
msgstr "Nó đã trút hơi thở cuối cùng."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC"
msgid "Vegetables are not to be trusted!"
msgstr "Không thể tin tưởng lũ rau củ được đâu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.HELD"
msgid "I have you now, wicked vegetable."
msgstr "Ta bắt được ngươi rồi, thứ rau củ hư hỏng."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.SLEEPING"
msgid "A deceptive vegetable with no honor."
msgstr "Một củ rau xảo trá chẳng có chút danh dự nào."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC"
msgid "Meat impostor!"
msgstr "Đồ giả thịt!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.RIPE"
msgid "I have no need for your fake meat."
msgstr "Ta không cần đống thịt giả mạo của ngươi đâu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.SLEEPING"
msgid "Grabbest thy shut eye!"
msgstr "Nhắm mắt lại nghỉ ngơi đi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_LIGHTFLIER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_LIGHTFLIER"
msgid "Light the way, noble insect."
msgstr "Soi đường nào, chú côn trùng cao quý."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM_BOSS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM_BOSS"
msgid "A snake beast worthy of mine spear!"
msgstr "Một con quái vật rắn xứng đáng với cây giáo của ta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.ATTACKER"
msgid "Back! Back, beast!"
msgstr "Tránh ra! Tránh ra, quái vật!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.FIRESTARTER"
msgid "%s stepped forth from Hel's flames!"
msgstr "%s bước ra từ ngọn lửa của Hel!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.GENERIC"
msgid "Hail, fire giant %s!"
msgstr "Chào mừng người khổng lồ lửa %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.GHOST"
msgid "An honorable Viking leaves no one behind!"
msgstr "Một chiến binh Viking chân chính không bao giờ bỏ lại ai phía sau!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.MURDERER"
msgid "%s will pay for his trespasses!"
msgstr "%s sẽ phải trả giá cho những tội ác của hắn!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.REVIVER"
msgid "%s abides by a warrior's code."
msgstr "%s tuân thủ nghiêm ngặt bộ quy tắc của chiến binh."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX_NABBAG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX_NABBAG"
msgid "The tool of a plunderer."
msgstr "Công cụ của một kẻ cướp bóc."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX_REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX_REVIVER"
msgid "Impish magic has power over death?"
msgstr "Ma thuật tinh nghịch lại có quyền năng chi phối cả cái chết sao?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX_SOULJAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX_SOULJAR"
msgid "He doth keep souls of the slain."
msgstr "Hắn cất giữ linh hồn của những kẻ đã ngã xuống."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.ATTACKER"
msgid "Ah, you wish to test your mettle in combat? As you wish!"
msgstr "Ồ, ngươi muốn thử tài chiến đấu à? Tùy ngươi thôi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.FIRESTARTER"
msgid "%s toys with Hel's flames!"
msgstr "%s đang đùa giỡn với ngọn lửa của Hel!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.GENERIC"
msgid "Hail, %s, small beastie of the marshlands!"
msgstr "Chào %s, quái vật nhỏ vùng đầm lầy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.GHOST"
msgid "You've a warrior's spirit, but you're not ready for Valhalla yet!"
msgstr "Ngươi có tinh thần của một chiến binh, nhưng chưa sẵn sàng đến Valhalla đâu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.MURDERER"
msgid "I will not be defeated so easily, beastie!"
msgstr "Ta sẽ không bị đánh bại dễ dàng thế đâu, bé con!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.REVIVER"
msgid "It seems you have a kind heart 'neath that scaly hide."
msgstr "Xem ra bên dưới lớp vảy đó, ngươi sở hữu một trái tim nhân hậu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT_SWAMPITEM_LUNAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT_SWAMPITEM_LUNAR"
msgid "The small beastie seems keen to expand her kingdom."
msgstr "Quái vật nhỏ có vẻ rất hào hứng mở rộng vương quốc của mình."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT_SWAMPITEM_SHADOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT_SWAMPITEM_SHADOW"
msgid "The small beastie seems keen to expand her kingdom."
msgstr "Quái vật nhỏ có vẻ rất hào hứng mở rộng vương quốc của mình."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.ATTACKER"
msgid "%s! You insult my honor!"
msgstr "%s! Ngươi đang sỉ nhục danh dự của ta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.FIRESTARTER"
msgid "That metal warrior would see this world burn."
msgstr "Tên chiến binh kim loại đó muốn nhìn thế giới này chìm trong biển lửa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.GENERIC"
msgid "May Thor's bolts energize you, %s!"
msgstr "Mong những tia sét của Thor tiếp thêm năng lượng cho ngươi, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.GHOST"
msgid "Metal warrior, it is not your time. A heart!"
msgstr "Chiến binh kim loại, chưa đến lúc của ngươi đâu. Một trái tim!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.MURDERER"
msgid "We shall see whose steel is stronger, %s!"
msgstr "Chúng ta hãy xem thanh thép của ai cứng cáp hơn, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.REVIVER"
msgid "%s is brimming with honor."
msgstr "%s tràn ngập lòng danh dự."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78MODULE_BEE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78MODULE_BEE"
msgid "These boons shall empower our metal warrior."
msgstr "Những món quà này sẽ tiếp sức cho chiến binh kim loại của chúng ta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78MODULE_CHESS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78MODULE_CHESS"
msgid "These boons shall empower our metal warrior."
msgstr "Những món quà này sẽ tiếp sức cho chiến binh kim loại của chúng ta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78MODULE_COLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78MODULE_COLD"
msgid "These boons shall empower our metal warrior."
msgstr "Những món quà này sẽ tiếp sức cho chiến binh kim loại của chúng ta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78MODULE_DIGESTION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78MODULE_DIGESTION"
msgid "These boons shall empower our metal warrior."
msgstr "Những món quà này sẽ tiếp sức cho chiến binh kim loại của chúng ta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78MODULE_HEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78MODULE_HEAT"
msgid "These boons shall empower our metal warrior."
msgstr "Những món quà này sẽ tiếp sức cho chiến binh kim loại của chúng ta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78MODULE_LIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78MODULE_LIGHT"
msgid "These boons shall empower our metal warrior."
msgstr "Những món quà này sẽ tiếp sức cho chiến binh kim loại của chúng ta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78MODULE_LIGHT2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78MODULE_LIGHT2"
msgid "These boons shall empower our metal warrior."
msgstr "Những món quà này sẽ tiếp sức cho chiến binh kim loại của chúng ta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78MODULE_MAXHEALTH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78MODULE_MAXHEALTH"
msgid "These boons shall empower our metal warrior."
msgstr "Những món quà này sẽ tiếp sức cho chiến binh kim loại của chúng ta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78MODULE_MAXHEALTH2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78MODULE_MAXHEALTH2"
msgid "These boons shall empower our metal warrior."
msgstr "Những món quà này sẽ tiếp sức cho chiến binh kim loại của chúng ta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78MODULE_MAXHUNGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78MODULE_MAXHUNGER"
msgid "These boons shall empower our metal warrior."
