msgid "Is almost done..."
msgstr "Sắp xong rồi..."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTERSFEASTOVEN.COOKING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTERSFEASTOVEN.COOKING"
