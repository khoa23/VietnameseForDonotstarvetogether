msgstr "Có vẻ như chúng đang lần theo manh mối gì đó..."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_TICOON_WAITING_FOR_LEADER
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_TICOON_WAITING_FOR_LEADER"
