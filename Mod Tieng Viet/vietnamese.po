#. STRINGS.SET_DESCRIPTIONS.body_ugly_winterhat_pink_hibiscus
msgctxt "STRINGS.SET_DESCRIPTIONS.body_ugly_winterhat_pink_hibiscus"
msgid "As a matter of fact, having a matching hat and sweater is VERY fashionable."
msgstr "Như một vấn đề thực tế, có một chiếc mũ và áo len phù hợp là rất thời trang."

#. STRINGS.SET_DESCRIPTIONS.emote_carol
msgctxt "STRINGS.SET_DESCRIPTIONS.emote_carol"
msgid "The spirit of Winter's Feast will keep you warm when you go a-caroling tonight!"
msgstr "Tinh thần của bữa tiệc của mùa đông sẽ giữ ấm cho bạn khi bạn đi caroling tối nay!"

#. STRINGS.SET_DESCRIPTIONS.emote_fistshake
