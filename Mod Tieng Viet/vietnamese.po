msgstr "Giống như chuyện tôi đã trải qua..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_PORTAL.ON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_PORTAL.ON"
msgid "Welp, time to go!"
msgstr "Vâng, đến lúc phải đi rồi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_RECHARGERHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_RECHARGERHAT"
msgid "I'd be so efficient with that!"
msgstr "Tôi sẽ rất hiệu quả với điều đó!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_SPAWNER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_SPAWNER"
msgid "Wonder how it works?"
msgstr "Tự hỏi nó hoạt động như thế nào?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT"
msgid "I'm gonna be a real slugger with that thing!"
msgstr "Tôi sẽ trở thành kẻ lười biếng thực sự với thứ đó!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT"
msgid "That'd be fer healin' my pals."
msgstr "Đó sẽ là cách chữa lành vết thương cho bạn bè của tôi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE"
msgid "I'm gonna squish that!"
msgstr "Tôi sẽ bóp chết nó!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_COCOON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_COCOON"
msgid "We could probably wake it back up."
msgstr "Có lẽ chúng ta có thể đánh thức nó dậy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_EGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_EGG.GENERIC"
msgid "Maybe we shouldn't hatch this."
msgstr "Có lẽ chúng ta không nên ấp ủ điều này."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
msgid "Looks chilly."
msgstr "Có vẻ lạnh lẽo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
msgid "It's feeling right as rain."
msgstr "Cảm giác thật giống như mưa vậy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_PET.CONTENT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_PET.CONTENT"
msgid "You're a happy little fellow."
msgstr "Bạn là một người bạn nhỏ hạnh phúc."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_PET.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_PET.GENERIC"
msgid "Seems friendly enough."
msgstr "Có vẻ đủ thân thiện."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_PET.HUNGRY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_PET.HUNGRY"
msgid "Let's fatten you up."
msgstr "Hãy vỗ béo bạn lên."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_PET.STARVING"
msgid "You need some meat on those bones. Do you have bones?"
msgstr "Bạn cần một ít thịt trên những xương đó. Bạn có xương không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_TOOTH"
msgid "Aw. That's a baby tooth."
msgstr "Ôi. Đó là răng sữa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVASPIT.COOL"
msgid "Just a rock, now."
msgstr "Bây giờ chỉ là một tảng đá."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVASPIT.HOT"
msgid "Woah! Hot potato!"
msgstr "Ôi! Khoai tây nóng!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVA_POND"
msgid "Lava!"
msgstr "Dung nham!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVA_POND_ROCK"
msgid "That... is a rock."
msgstr "Đó... là một tảng đá."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LEAFLOAF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LEAFLOAF"
msgid "It's hard to pin down the flavor..."
msgstr "Thật khó để xác định hương vị..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LEAFYMEATBURGER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LEAFYMEATBURGER"
msgid "It's not like any burger I've ever tried."
msgstr "Nó không giống bất kỳ loại burger nào tôi từng thử."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LEAFYMEATSOUFFLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LEAFYMEATSOUFFLE"
msgid "Well... I guess it's creative."
msgstr "Chà... tôi đoán là nó có tính sáng tạo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LEIF"
msgid "The trees have eyes!!"
msgstr "Cây cối có mắt!!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LEIF_IDOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LEIF_IDOL"
msgid "That's some quality carving, there."
msgstr "Đó là một số tác phẩm điêu khắc chất lượng đấy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LEIF_SPARSE"
msgid "Back off, you lumbering lumber!"
msgstr "Lùi lại đi, đồ gỗ ì ạch!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LICHEN"
msgid "Not to my lichen. Ha!"
msgstr "Không phải địa y của tôi. Hà!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIFEINJECTOR"
msgid "I've never taken a sick day in my life."
msgstr "Tôi chưa bao giờ nghỉ ốm trong đời."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTBULB"
msgid "Not at all like the lightbulbs I'm used to."
msgstr "Không giống chút nào với những bóng đèn tôi từng sử dụng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTCRAB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTCRAB"
msgid "I guess crabs can glow now, huh?"
msgstr "Tôi đoán bây giờ cua có thể phát sáng phải không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTER"
msgid "Neat little gizmo there."
msgstr "Gizmo nhỏ gọn gàng ở đó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTFLIER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTFLIER"
msgid "Doesn't even need a battery!"
msgstr "Thậm chí không cần pin!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTNINGGOAT.CHARGED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTNINGGOAT.CHARGED"
msgid "Electrifying! Ha!"
msgstr "Điện hóa! Hà!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTNINGGOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTNINGGOAT.GENERIC"
msgid "You and I are gonna get along."
msgstr "Bạn và tôi sẽ hòa hợp với nhau."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTNINGGOATHORN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTNINGGOATHORN"
msgid "It's even more interesting up close."
msgstr "Nó thậm chí còn thú vị hơn khi đến gần."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTNING_ROD.CHARGED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTNING_ROD.CHARGED"
msgid "All charged up and nowhere to go."
msgstr "Tất cả đã được sạc đầy và không nơi nào để đi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTNING_ROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTNING_ROD.GENERIC"
msgid "That's one way to get electricity."
msgstr "Đó là một cách để có được điện."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LITTLE_WALRUS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LITTLE_WALRUS"
msgid "Nice kilt."
msgstr "Váy đẹp đấy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIVINGLOG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIVINGLOG"
msgid "Stop looking at me like that."
msgstr "Đừng có nhìn tôi như thế."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIVINGTREE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIVINGTREE"
msgid "Did that tree just move?"
msgstr "Có phải cái cây đó vừa di chuyển?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIVINGTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIVINGTREE_ROOT"
msgid "Oh hey! There's a little stick in there."
msgstr "Ôi này! Có một cây gậy nhỏ ở đó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIVINGTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIVINGTREE_SAPLING"
msgid "Keep growin' little guy! I'm gonna decorate you."
msgstr "Hãy tiếp tục phát triển nhé chàng trai nhỏ! Tôi sẽ trang trí cho bạn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LOBSTERBISQUE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LOBSTERBISQUE"
msgid "Hey Warly? Can you just keep makin' this forever?"
msgstr "Này Warly? Bạn có thể tiếp tục làm món này mãi được không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LOBSTERDINNER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LOBSTERDINNER"
msgid "That's some pretty fancy lookin' grub!"
msgstr "Đó là một số sâu trông khá lạ mắt!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LOG.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LOG.BURNING"
msgid "I coulda built something with that."
msgstr "Tôi có thể xây dựng một cái gì đó với điều đó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LOG.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LOG.GENERIC"
msgid "It's a hunk of wood."
msgstr "Đó là một khúc gỗ."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LORDFRUITFLY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LORDFRUITFLY"
msgid "You think you can just come in here and lord over my garden?"
msgstr "Anh nghĩ anh có thể vào đây và cai trị khu vườn của tôi à?"

