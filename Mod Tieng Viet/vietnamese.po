msgstr "Trong qúa trình học."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MERMHOUSE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MERMHOUSE"
msgid "What an ugly little house."
msgstr "Thật là một ngôi nhà nhỏ xấu xí."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MERM_CART1
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MERM_CART1"
msgid "Any science in there?"
msgstr "Có khoa học nào không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MERM_CART2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MERM_CART2"
msgid "I could use some stuff."
msgstr "Tôi có thể sử dụng một số thứ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MUSHROOMS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MUSHROOMS"
msgid "These are edible mushrooms."
msgstr "Đây là những loại nấm ăn được."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC"
