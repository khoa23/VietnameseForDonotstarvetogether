msgstr "Vì vinh quang của nhà vua!"

#. STRINGS.SKIN_DESCRIPTIONS.mighty_gym_ancient
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mighty_gym_ancient"
msgid "Master the ancient art of lifting heavy objects."
msgstr "Làm chủ nghệ thuật cổ xưa của việc nâng vật nặng."

#. STRINGS.SKIN_DESCRIPTIONS.minerhat_bonnet
