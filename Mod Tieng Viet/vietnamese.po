msgstr "Không có cánh thì đừng mong bay!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BUZZARD"
