#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOONPOTION_FAILED"
msgid "Huh. Alright then."
msgstr "Huh. Thôi được."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOSQUITOS"
msgid "Get away, you bloodsucking jerks!"
msgstr "Có được đi, bạn hút máu giật!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "This beast is looking pretty bad."
msgstr "Con thú này trông khá tệ."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL"
msgid "Stupid buzzards. Hey, what's wrong with them?"
msgstr "Lũ chim ó ngu ngốc. Này, có chuyện gì với họ vậy?"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NODANGERGIFT"
msgid "That dumb box can wait!"
msgstr "Cái hộp ngu ngốc đó có thể đợi được!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NODANGERSIESTA"
msgid "It's not time for a siesta, it's time for fighting!"
msgstr "Không phải lúc để ngủ trưa, mà là lúc để chiến đấu!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NODANGERSLEEP"
msgid "No time for sleep, there's fighting to do!"
msgstr "Không có thời gian cho giấc ngủ, có đang chiến đấu để làm!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NODAYSLEEP"
msgid "Who would go inside when there's a great ball of fire in the sky?"
msgstr "Ai sẽ vào trong khi có một quả cầu lửa lớn trên bầu trời?"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "Too spooky down here to sleep."
msgstr "Quá ghê rợn xuống đây ngủ."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOHUNGERSIESTA"
msgid "I can't take a siesta while my tummy is grumbling!"
msgstr "Tôi không thể ngủ trưa trong khi bụng tôi đang kêu gào!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOHUNGERSLEEP"
msgid "My tummy is grumbling, I can't sleep!"
msgstr "Bụng tôi đang cồn cào, tôi không thể ngủ được!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I gotta get down from this big oaf before opening that!"
msgstr "Tôi phải xuống khỏi cái ổ to này trước khi mở nó ra!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NONIGHTSIESTA"
msgid "I couldn't get comfortable there."
msgstr "Tôi không thể có được thoải mái ở đó."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "I'd really rather be inside."
msgstr "Tôi thực sự thay vì được bên trong."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOPUMPKINCARVINGONFIRE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOPUMPKINCARVINGONFIRE"
msgid "It's perfect."
msgstr "Hoàn hảo."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT"
msgid "It's kind of hard to sleep with a robot glowing in my face."
msgstr "Thật khó ngủ khi có một con robot phát sáng trước mặt tôi."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOSLEEPONFIRE"
msgid "It's just the collapsing that concerns me."
msgstr "Nó chỉ là sự sụp đổ liên quan đến mình."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOWARDROBEONFIRE"
msgid "Why? This is way better."
msgstr "Tại sao? Điều này tốt hơn nhiều."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NO_ABIGAIL_FLOWER
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NO_ABIGAIL_FLOWER"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NO_TRAP"
msgid "Like lighting a barrel of fish on fire."
msgstr "Giống như ánh sáng một thùng cá trên lửa."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "This really isn't my thing."
msgstr "Đây thực sự không phải là chuyện của tôi."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "Ugh! Stupid! Fish!"
msgstr "Ờ! Ngốc nghếch! Cá!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "This is BORING."
msgstr "Điều này thật nhàm chán."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "Ugh. Can't this go any faster?"
msgstr "Ờ. Việc này không thể nhanh hơn được nữa sao?"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "Come on, you stupid fish!"
msgstr "Cố lên, con cá ngu ngốc!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "I could be setting so many fires right now."
msgstr "Tôi có thể gây ra rất nhiều đám cháy ngay bây giờ."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "Hey! That dumb fish stole my tackle!"
msgstr "Chào! Con cá ngu ngốc đó đã cướp mất mồi câu của tôi!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "Better start reeling or it's gonna get away!"
msgstr "Tốt hơn là nên bắt đầu quay cuồng nếu không nó sẽ chạy mất!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "Something big's coming!"
msgstr "Một cái gì đó lớn lao đang đến!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OFF_SCRIPT
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OFF_SCRIPT"
msgid "Haha, you messed up!"
msgstr "Haha, bạn đã nhầm lẫn!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OTTERBOAT_DENBROKEN
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OTTERBOAT_DENBROKEN"
msgid "Hey, no fair!"
msgstr "Này, không công bằng chút nào!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS"
msgid "This thing will be okay in deep water, right? Right?!"
msgstr "Cái này ổn chứ khi ra vùng nước sâu? Đúng không? Đúng chứ?!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_PECKED"
msgid "No! Bad birdy!"
msgstr "Không! Xấu Birdy!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_PETRIFED_TREES"
msgid "Something weird is happening...!"
msgstr "Có điều gì đó kỳ lạ đang xảy ra...!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "Ugh, put it back!"
msgstr "Ặc, đặt nó lại đi!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_PIRATES_ARRIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_PIRATES_ARRIVE"
msgid "Uh, that sound's getting closer..."
msgstr "Ừm, âm thanh đó đang đến gần hơn..."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_PLANT_RANDOMSEED
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_PLANT_RANDOMSEED"
msgid "I guess we'll see what happens."
msgstr "Tôi đoán chúng ta sẽ xem điều gì sẽ xảy ra."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_PLANT_RESEARCHED.1
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_PLANT_RESEARCHED.1"
msgid "Greeaaat, more boring old plant facts."
msgstr "Tuyệtttt, sự thật về thực vật cũ tẻ nhạt hơn."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_POCKETWATCH_PORTAL
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_POCKETWATCH_PORTAL"
msgid "Owww..."
msgstr "Ôi..."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_PREFALLINVOID
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_PREFALLINVOID"
msgid "Oh crap!"
msgstr "Ôi trời!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_QUAKE"
msgid "That sound probably doesn't mean good things."
msgstr "Âm thanh đó có lẽ không có nghĩa là những điều tốt đẹp."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT"
msgid "Picky, picky."
msgstr "Kén chọn quá nhỉ."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_RABBITKING_AGGRESSIVE"
msgid "Something's coming, and it doesn't sound happy."
msgstr "Có gì đó đang tới và nó nghe không vui vẻ gì đâu."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_RABBITKING_LUCKY"
msgid "That is one unique rabbit!"
msgstr "Đó là một con thỏ độc đáo đấy!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_RABBITKING_LUCKYCAUGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_RABBITKING_LUCKYCAUGHT"
msgid "Gotcha!"
msgstr "Bắt được rồi!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_RABBITKING_PASSIVE"
msgid "I think something is burrowing."
msgstr "Tôi nghĩ có gì đó đang đào bới."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_REPELLED"
msgid "Hey! That's not fair!"
msgstr "Chào! Điều đó không công bằng!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_RESEARCH"
msgid "That was useful, even if it didn't have anything about fires."
msgstr "Đó là hữu ích, thậm chí nếu nó không có bất cứ điều gì về vụ cháy."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "Thanks for the hand!"
msgstr "Cảm ơn vì bàn tay này!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "You got this!"
msgstr "Bạn hiểu rồi đấy!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_REVIVING_CORPSE"
msgid "Hey! Get back up!"
msgstr "Chào! Tìm sự trợ giúp!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_ROYALTY.1
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_ROYALTY.1"
msgid "Nice hat."
msgstr "Mũ đẹp đấy."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_ROYALTY.2
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_ROYALTY.2"
msgid "You're not the boss of me."
msgstr "Anh không phải là ông chủ của tôi."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_ROYALTY.3
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_ROYALTY.3"
msgid "You expecting me to bow or something?"
msgstr "Bạn mong đợi tôi cúi đầu hay gì đó à?"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_ROYALTY_JOKER.1
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_ROYALTY_JOKER.1"
msgid "Great hat!"
msgstr "Chiếc mũ tuyệt vời!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_ROYALTY_JOKER.2
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_ROYALTY_JOKER.2"
msgid "It really brings out your eyes!"
msgstr "Nó thực sự làm nổi bật đôi mắt của bạn!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_ROYALTY_JOKER.3
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_ROYALTY_JOKER.3"
msgid "It makes so much sense."
msgstr "Nó rất có ý nghĩa."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_RUINS_RESET"
msgid "Aw, everything I killed is back!"
msgstr "Ôi, mọi thứ tôi giết đã quay trở lại!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SACREDCHEST_NO"
msgid "Rude."
msgstr "Bất lịch sự."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SACREDCHEST_YES"
msgid "That did it!"
msgstr "Điều đó đã làm được!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SCRAPBOOK_FULL
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SCRAPBOOK_FULL"
msgid "Looks like stuff I already know."
msgstr "Có vẻ như những thứ tôi đã biết rồi."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SECURITY_PULSE_FOLLOWING
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SECURITY_PULSE_FOLLOWING"
msgid "What is it following me for?"
msgstr "Nó theo dõi tôi để làm gì?"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SHADOWTHRALL_STEALTH
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SHADOWTHRALL_STEALTH"
msgid "Ouch! What the heck was that?!"
msgstr "Á! Cái quái gì vậy?!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SHADOW_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SHADOW_RIFT_MAX"
msgid "Did anyone else see that weird glow?"
msgstr "Có ai nhìn thấy ánh sáng kỳ lạ đó không?"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SHELTER"
msgid "You're good for something besides burning after all."
msgstr "Bạn đang tốt cho một cái gì đó bên cạnh việc đốt sau khi tất cả."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SISTURN_FULL_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SISTURN_FULL_BLOSSOM"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SISTURN_FULL_EVIL
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SISTURN_FULL_EVIL"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SNARED"
msgid "Gross, ew! Bones!"
msgstr "Tệ quá, ôi! Xương!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SNARED_IVY
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SNARED_IVY"
msgid "Hey, knock it off!"
msgstr "Này, tắt nó đi!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SNOWBALL_NO_SNOW
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SNOWBALL_NO_SNOW"
msgid "There's no snow here."
msgstr "Ở đây không có tuyết."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SNOWBALL_TOO_BIG
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SNOWBALL_TOO_BIG"
msgid "It's useless to try and roll it any bigger."
msgstr "Sẽ vô ích nếu cố gắng cuộn nó lớn hơn nữa."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SOAKED"
msgid "Ugh, this is the WORST!"
msgstr "Ugh, đây là tệ nhất!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_SPOOKED"
msgid "Aww, gross!"
msgstr "Ôi, ghê quá!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TALK_TO_PLANTS.1
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TALK_TO_PLANTS.1"
msgid "Hey plants! How's it going?"
msgstr "Này cây! Thế nào rồi?"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TALK_TO_PLANTS.2
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TALK_TO_PLANTS.2"
msgid "Feeling flammable today?"
msgstr "Cảm thấy dễ cháy hôm nay?"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TALK_TO_PLANTS.3
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TALK_TO_PLANTS.3"
msgid "So... plant stuff... man, this is boring."
msgstr "Vì vậy... thực vật... anh bạn, điều này thật nhàm chán."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TALK_TO_PLANTS.4
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TALK_TO_PLANTS.4"
msgid "Anything interesting going on lately? Right, nope. Because you're a plant."
msgstr "Gần đây có chuyện gì thú vị không? Đúng, không. Bởi vì bạn là một cái cây."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "Hey, rustle twice if you want to take a closer look at my lighter!"
msgstr "Này, hãy xào xạc hai lần nếu bạn muốn nhìn kỹ hơn vào chiếc bật lửa của tôi!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_THORNS"
msgid "Ouch!"
msgstr "Ouch!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_THURIBLE_OUT"
msgid "Awww! I liked that thing."
msgstr "Ôi! Tôi thích điều đó."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TICOON_ABANDONED
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TICOON_ABANDONED"
msgid "Ah, who needs ya! I can find them on my own."
msgstr "Ah, ai cần bạn! Tôi có thể tự mình tìm thấy chúng."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TICOON_DEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TICOON_DEAD"
msgid "Great. What am I supposed to do now?"
msgstr "Tuyệt vời. Tôi phải làm gì bây giờ?"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TICOON_GET_LEADER_ATTENTION
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TICOON_GET_LEADER_ATTENTION"
msgid "What is it? Kit's stuck in a well?"
msgstr "Nó là gì? Kit bị mắc kẹt trong giếng à?"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TICOON_LOST_KITCOON
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TICOON_LOST_KITCOON"
msgid "Guess we were a second too late to this one."
msgstr "Có lẽ chúng ta đã quá muộn một giây với điều này."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TICOON_NEAR_KITCOON
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TICOON_NEAR_KITCOON"
msgid "Seems like he's onto somethin'..."
