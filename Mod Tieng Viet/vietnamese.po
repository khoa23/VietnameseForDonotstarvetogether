msgstr "Tôi thấy say sóng quá!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT"
