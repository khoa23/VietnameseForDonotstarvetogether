msgstr "Wolfgang muốn ở thật xa."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATEDHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATEDHOUND.GENERIC"
