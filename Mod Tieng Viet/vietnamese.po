msgstr "Mặt trăng đang buồn ngủ."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.NIGHT_WAX"
