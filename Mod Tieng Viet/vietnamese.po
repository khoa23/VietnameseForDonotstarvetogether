#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MUTATE.NOFULLMOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MUTATE.NOFULLMOON"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MUTATE.NOGHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MUTATE.NOGHOST"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MUTATE.NONEWMOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MUTATE.NONEWMOON"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MUTATE.NOTNIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MUTATE.NOTNIGHT"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.OCEAN_FISHING_POND.WRONGGEAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.OCEAN_FISHING_POND.WRONGGEAR"
msgid "I won't use my good fishing rod in this stagnant pond."
msgstr "Ta sẽ không dùng chiếc cần câu xịn của mình ở cái ao tù này đâu."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.OPEN_CRAFTING.PROFESSIONALCHEF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.OPEN_CRAFTING.PROFESSIONALCHEF"
msgid "I have more important things to do than that."
msgstr "Ta có nhiều việc quan trọng hơn để làm ngoài việc đó."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.OPEN_CRAFTING.SHADOWMAGIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.OPEN_CRAFTING.SHADOWMAGIC"
msgid "unused_by_waxwell"
msgstr "không_dùng_bởi_waxwell"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICK.NOTHING_INSIDE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICK.NOTHING_INSIDE"
msgid "Empty. I knew it."
msgstr "Trống không. Ta biết ngay mà."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICK.STUCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICK.STUCK"
msgid "Ugh! Stuck."
msgstr "Hừ! Kẹt rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.FULL_OF_CURSES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.FULL_OF_CURSES"
msgid "I will not fall for that again."
msgstr "Ta sẽ không dính bẫy đó lần nữa đâu."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.INUSE"
msgid "It's unavailable."
msgstr "Nó không khả dụng."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.NOTMINE_YOTC.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.NOTMINE_YOTC.1"
msgid "Say, pal, why don't you come work for me?"
msgstr "Này bạn hiền, sao không sang làm việc cho ta nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.NOTMINE_YOTC.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.NOTMINE_YOTC.2"
msgid "Its allegiance lies elsewhere."
msgstr "Lòng trung thành của nó thuộc về nơi khác."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.RESTRICTION
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.RESTRICTION"
msgid "I have no use of such things."
msgstr "Ta chẳng có nhu cầu gì với mấy thứ đó."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.FERTILIZER"
msgid "I think I know quite enough."
msgstr "Ta nghĩ mình biết đủ nhiều rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.GENERIC"
msgid "I have the information I need."
msgstr "Ta đã có thông tin mình cần."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.POUNCECAPTURE.MISSED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.POUNCECAPTURE.MISSED"
msgid "Quit moving!"
msgstr "Đứng yên xem nào!"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.POUR_WATER.OUT_OF_WATER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.POUR_WATER.OUT_OF_WATER"
msgid "I've run out."
msgstr "Ta hết nước mất rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.POUR_WATER_GROUNDTILE.OUT_OF_WATER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.POUR_WATER_GROUNDTILE.OUT_OF_WATER"
msgid "There's no more water."
msgstr "Hết nước mất rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.ALREADYFULLMOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.ALREADYFULLMOON"
msgid "For once, magic is not needed."
msgstr "Lần hiếm hoi mà ma thuật trở nên thừa thãi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.BIRDSBLOCKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.BIRDSBLOCKED"
msgid "He even stops the birds from coming and going?"
msgstr "Hắn ta đến cả chim chóc cũng ngăn không cho bay qua bay lại cơ à?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.DEADBIRDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.DEADBIRDS"
msgid "It's bad luck now... for the birds."
msgstr "Giờ thì xui xẻo thật đấy... cho lũ chim."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.GENERIC"
msgid "I must deal with this first."
msgstr "Ta phải giải quyết việc này trước đã."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOBIRDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOBIRDS"
msgid "There are plenty of birds here already."
msgstr "Ở đây có thừa chim rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOFIRES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOFIRES"
msgid "For once, nothing is on fire."
msgstr "Lần hiếm hoi mà chẳng có gì bốc cháy cả."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOHORTICULTURE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOHORTICULTURE"
msgid "There's nothing worth growing here."
msgstr "Chẳng có gì đáng trồng ở đây cả."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOMOONINCAVES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOMOONINCAVES"
msgid "Its power can't reach the \"moon\" from here."
msgstr "Sức mạnh của nó không thể vươn tới \"mặt trăng\" từ đây được."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOSILVICULTURE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOSILVICULTURE"
msgid "Making invisible trees grow? Now that'd be a trick."
msgstr "Làm cho những cái cây tàng hình lớn lên á? Đúng là một trò hay đấy."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOSLEEPTARGETS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOSLEEPTARGETS"
msgid "Nobody wants a bedtime story from the bogeyman, is that it?"
msgstr "Không ai muốn nghe ông kẹ kể chuyện trước giờ đi ngủ à, thế sao?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOTENTACLEGROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOTENTACLEGROUND"
msgid "Tentacles are ill-suited to this place."
msgstr "Xúc tu không phù hợp với nơi này cho lắm."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOWATERNEARBY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOWATERNEARBY"
msgid "I can't just conjure up fish without water."
msgstr "Ta không thể câu cá mà không có nước được."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.TOOMANYBEES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.TOOMANYBEES"
msgid "There's such a thing as too many bees, pal."
msgstr "Quá nhiều ong cũng là một thảm họa đấy, bạn tôi ơi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.TOOMANYBIRDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.TOOMANYBIRDS"
msgid "There are plenty of birds here already."
msgstr "Ở đây có thừa chim rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.WAYTOOMANYBIRDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.WAYTOOMANYBIRDS"
msgid "I must wait before I summon the birds again."
msgstr "Ta phải đợi trước khi triệu hồi lũ chim lần nữa."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REMOTE_TELEPORT.NODEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REMOTE_TELEPORT.NODEST"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REMOTE_TELEPORT.NOSKILL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REMOTE_TELEPORT.NOSKILL"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REMOVEMODULES.NO_MODULES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REMOVEMODULES.NO_MODULES"
msgid "only_used_by_wx78"
msgstr "chỉ_được_sử_dụng_bởi_wx78"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPAIR.WRONGPIECE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPAIR.WRONGPIECE"
msgid "I could have told you that wouldn't fit."
msgstr "Ta đã bảo là nó không vừa rồi mà."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPLATE.MISMATCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPLATE.MISMATCH"
msgid "Clearly this is the wrong dish."
msgstr "Rõ ràng đây không phải món ăn đúng điệu."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPLATE.SAMEDISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPLATE.SAMEDISH"
msgid "I've already put this on a dish."
msgstr "Ta đã đặt món này lên đĩa rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ROW_FAIL.BAD_TIMING0
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ROW_FAIL.BAD_TIMING0"
msgid "I must time this perfectly if I'm to succeed."
msgstr "Ta phải canh thời gian thật chuẩn xác mới thành công được."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ROW_FAIL.BAD_TIMING1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ROW_FAIL.BAD_TIMING1"
msgid "This isn't exactly my forte."
msgstr "Đây không phải sở trường của ta cho lắm."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ROW_FAIL.BAD_TIMING2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ROW_FAIL.BAD_TIMING2"
msgid "Hmph. Physical labor is more suited to underlings."
msgstr "Hừm. Lao động chân tay là việc dành cho cấp dưới."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.GENERIC"
msgid "Curses."
msgstr "Khỉ thật."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.INUSE"
msgid "I'm quite adept at waiting. I've had a lot of practice."
msgstr "Ta rất giỏi chờ đợi. Ta đã luyện tập nhiều lắm rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.NOTAMERM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.NOTAMERM"
msgid "Even I won't stoop so low as to steal from these wretches."
msgstr "Đến ta cũng chẳng thèm hạ mình đi ăn cắp của mấy kẻ khốn khổ này đâu."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.NOTAROBOT"
msgid "Robot junk."
msgstr "Đồ đồng nát người máy."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.NOTMASTERCHEF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.NOTMASTERCHEF"
msgid "I have more important things to do than that."
msgstr "Ta có nhiều việc quan trọng hơn để làm ngoài việc đó."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.NOTSOULJARHANDLER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.NOTSOULJARHANDLER"
msgid "Souls are a different thing altogether."
msgstr "Linh hồn lại là một chuyện hoàn toàn khác."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.RESTRICTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.RESTRICTED"
msgid "I don't have the magic word."
msgstr "Ta không biết mật khẩu."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SADDLE.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SADDLE.TARGETINCOMBAT"
msgid "Perhaps I should take a step back."
msgstr "Có lẽ ta nên lùi lại một bước."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.AWAKEBEEFALO
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.AWAKEBEEFALO"
msgid "I don't think she'd take kindly to that."
msgstr "Ta không nghĩ cô ta sẽ thích thú gì đâu."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.GENERIC"
msgid "To what end?"
msgstr "Để làm gì cơ chứ?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.NOBITS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.NOBITS"
msgid "But it's already as smooth as a baby's rear end."
msgstr "Nhưng nó đã nhẵn nhụi như mông em bé rồi còn đâu."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.SOMEONEELSESBEEFALO
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.SOMEONEELSESBEEFALO"
msgid "Let someone else do it."
msgstr "Cứ để người khác làm đi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SLAUGHTER.TOOFAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SLAUGHTER.TOOFAR"
msgid "It has escaped my clutches."
msgstr "Nó đã thoát khỏi tầm với của ta rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SOAKIN.NOSPACE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SOAKIN.NOSPACE"
msgid "There's an inconsiderate wretch taking up that space."
msgstr "Có một kẻ vô ý thức đang chiếm chỗ mất rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.START_CARRAT_RACE.NO_RACERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.START_CARRAT_RACE.NO_RACERS"
msgid "This race seems to be decidedly lacking in racers."
msgstr "Cuộc đua này có vẻ thiếu vắng các tay đua trầm trọng."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.GENERIC"
msgid "It wouldn't fit."
msgstr "Nó không vừa đâu."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.INUSE"
msgid "Worry not, pal. I've the patience of a saint."
msgstr "Đừng lo, bạn hiền. Ta kiên nhẫn như một vị thánh vậy."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTALLOWED"
msgid "That can't go in there."
msgstr "Thứ đó không nhét vào đây được."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTAROBOT"
msgid "Robot junk"
msgstr "Đồ đồng nát người máy"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTMASTERCHEF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTMASTERCHEF"
msgid "I have more important things to do than that."
msgstr "Ta có nhiều việc quan trọng hơn để làm ngoài việc đó."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTSOULJARHANDLER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTSOULJARHANDLER"
msgid "Souls are a different thing altogether."
msgstr "Linh hồn lại là một chuyện hoàn toàn khác."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.RESTRICTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.RESTRICTED"
msgid "I don't have the magic word."
msgstr "Ta không biết mật khẩu."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.CANTLEARN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.CANTLEARN"
msgid "There's a lesson to be learned about tampering with secret knowledge."
msgstr "Có một bài học rút ra về việc mân mê tri thức bí mật đấy."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.KNOWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.KNOWN"
msgid "I am far too advanced for this."
msgstr "Ta đã vượt xa trình độ này rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.MESSAGEBOTTLEMANAGER_NOT_FOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.MESSAGEBOTTLEMANAGER_NOT_FOUND"
msgid "I'll extract its secrets once I find some suitable lighting."
msgstr "Ta sẽ khai thác bí mật của nó khi tìm được nguồn sáng thích hợp."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.STASH_MAP_NOT_FOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.STASH_MAP_NOT_FOUND"
msgid "It's nothing but scribbles."
msgstr "Chẳng khác gì mấy nét nguệch ngoạc."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.WRONGWORLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.WRONGWORLD"
msgid "I seem to be in the wrong place to use this."
msgstr "Có vẻ ta đang ở nhầm nơi để dùng thứ này."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TELLSTORY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TELLSTORY.GENERIC"
msgid "only_used_by_walter"
msgstr "chỉ_được_sử_dụng_bởi_walter"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEITEMON.BEEF_BELL_ALREADY_USED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEITEMON.BEEF_BELL_ALREADY_USED"
msgid "This one's already been claimed."
msgstr "Cái này đã có chủ rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEITEMON.BEEF_BELL_HAS_BEEF_ALREADY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEITEMON.BEEF_BELL_HAS_BEEF_ALREADY"
msgid "One smelly beast following me around is more than enough."
msgstr "Có một con quái thú hôi hám cứ bám theo ta thế là quá đủ rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEITEMON.BEEF_BELL_INVALID_TARGET
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEITEMON.BEEF_BELL_INVALID_TARGET"
msgid "I think not."
msgstr "Ta không nghĩ vậy đâu."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEITEMON.CANNOT_FIX_DRONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEITEMON.CANNOT_FIX_DRONE"
msgid "There's no fixing it."
msgstr "Không sửa được nữa đâu."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEITEMON.NOT_MINE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEITEMON.NOT_MINE"
msgid "Someone's rubbish."
msgstr "Rác rưởi của ai đó."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS"
msgid "I'll not be done in by an overgrown Krampus."
msgstr "Ta sẽ không bị hạ gục bởi một tên Krampus quá khổ đâu."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY"
msgid "It appears there's another key around here."
msgstr "Hình như có chiếc chìa khóa khác quanh đây."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY"
msgid "Blast! Wrong key."
msgstr "Khỉ thật! Nhầm chìa khóa rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRAPBUNDLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRAPBUNDLE.EMPTY"
msgid "I don't know what to wrap."
msgstr "Ta không biết gói cái gì cả."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRITE.GENERIC"
msgid "I'm unable to do that right now."
msgstr "Ta không thể làm thế lúc này."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRITE.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRITE.INUSE"
msgid "I can wait... it's the courteous thing to do."
msgstr "Mình có thể đợi... đó là phép lịch sự mà."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.YOTB_STARTCONTEST.ALREADYACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.YOTB_STARTCONTEST.ALREADYACTIVE"
msgid "There must be a competition going on elsewhere..."
msgstr "Chắc là đang có cuộc thi nào đó diễn ra ở chỗ khác rồi..."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK"
msgid "Where is that incompetent judge?"
msgstr "Cái tên trọng tài vô tích sự đó đâu rồi nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.YOTB_STARTCONTEST.NORESPONSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.YOTB_STARTCONTEST.NORESPONSE"
msgid "Where did he wander off to now?"
msgstr "Hắn ta lại lang thang đi đâu mất rồi nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE"
msgid "How rude!"
msgstr "Thật bất lịch sự!"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN"
msgid "An old pattern. I've no use for it."
msgstr "Mẫu cũ rích. Ta dùng làm gì nữa chứ."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL_GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL_GENERIC"
msgid "That didn't work."
msgstr "Cách đó không hiệu quả."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ACCOMPLISHMENT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ACCOMPLISHMENT"
msgid "I need to pass the time somehow."
msgstr "Mình cần tìm cách giết thời gian thôi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ACCOMPLISHMENT_DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ACCOMPLISHMENT_DONE"
msgid "Ah. The satisfaction of a job well done."
msgstr "À. Thật là thỏa mãn khi hoàn thành tốt một công việc."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ACIDBATS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ACIDBATS"
msgid "What now?"
msgstr "Gì nữa đây?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ADVENTUREFAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ADVENTUREFAIL"
msgid "I of all people should be able to do this."
msgstr "Đáng lẽ ra ta phải làm được việc này mới phải."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.1"
msgid "My world is crumbling!"
msgstr "Thế giới của ta đang sụp đổ!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.2"
msgid "I am attacked by my own world!"
msgstr "Ta đang bị chính thế giới của mình tấn công!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.3"
msgid "An earthquake!"
msgstr "Động đất!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.1"
msgid "May this tribute sate the beast."
msgstr "Mong rằng lễ vật này sẽ làm con quái vật hài lòng."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.2"
msgid "Does this entertain you, beast?"
msgstr "Ngươi thấy thế này đã đủ vui chưa, hỡi quái thú?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.3"
msgid "What a chore."
msgstr "Đúng là phiền phức."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE"
msgid "This knowledge... it was hidden even from me."
msgstr "Tri thức này... thậm chí còn bị giấu kín cả với ta."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ARCHIVE_NO_POWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ARCHIVE_NO_POWER"
msgid "It doesn't respond to shadow magic. Perhaps another power source..."
msgstr "Nó không phản hồi phép thuật bóng tối. Có lẽ cần nguồn năng lượng khác..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE"
msgid "A waste of my time. This knowledge is already mine."
msgstr "Phí thời gian của mình. Kiến thức này mình đã nắm rõ rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.1"
msgid "Dark magics are returning."
msgstr "Ma thuật hắc ám đang quay trở lại."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.2"
msgid "Here we go again."
msgstr "Lại nữa rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.3"
msgid "The power's growing."
msgstr "Sức mạnh đang lớn dần."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_ATTACK"
msgid "I'm not afraid of some fisticuffs!"
msgstr "Ta không ngán vài đường quyền đâu!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK"
msgid "Unlimited power!"
msgstr "Sức mạnh vô hạn!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY"
msgid "Finally, some respite from the dampness."
msgstr "Cuối cùng cũng thoát khỏi sự ẩm ướt này."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION"
msgid "I feel protected by an unseen force."
msgstr "Tôi cảm thấy được bảo vệ bởi một thế lực vô hình."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE"
msgid "This will serve as a suitable ward against drowsiness."
msgstr "Cái này sẽ đóng vai trò như một bùa hộ mệnh chống lại cơn buồn ngủ."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS"
msgid "My focus feels heightened!"
msgstr "Ta cảm thấy sự tập trung được nâng cao!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BECOMEGHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BECOMEGHOST"
msgid "oOooooOO!!"
msgstr "oOooooOO!!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BEES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BEES"
msgid "Killing me won't bring back your honey!"
msgstr "Giết ta cũng không lấy lại được mật ong của ngươi đâu!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOAT_LEAK"
msgid "We've sprung a leak!"
msgstr "Thuyền bị rò rỉ rồi!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOAT_SINK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOAT_SINK"
msgid "Oh dear."
msgstr "Ôi trời."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOOK_MOON_DAYTIME
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOOK_MOON_DAYTIME"
msgid "We'll know if it worked once night falls."
msgstr "Chúng ta sẽ biết nó có hiệu quả hay không khi đêm xuống."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOOMERANG"
msgid "Ow! Blasted... clumsy hands!"
msgstr "Ái! Đồ... vụng về!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BRAVERY_POTION
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BRAVERY_POTION"
msgid "I was never really scared of those trees anyhow."
msgstr "Từ trước tới nay ta chưa từng sợ mấy cái cây đó."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BURNT"
msgid "It burns!"
msgstr "Cháy quá!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CALL_BEEF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CALL_BEEF"
msgid "And here comes my... er, \"beautiful\" assistant."
msgstr "Và kìa trợ sự... à nhầm, \"xinh đẹp\" của ta đến rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANFIX
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANFIX"
msgid "\nI think I can fix this!"
msgstr "Ta nghĩ mình có thể sửa được cái này!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS"
msgid "I don't have everything I need."
msgstr "Ta không có đủ mọi thứ mình cần."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANNOT_BUILD.NO_STATION
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANNOT_BUILD.NO_STATION"
msgid "I can't make that here, pal."
msgstr "Ta không làm cái đó ở đây được đâu, bạn tôi ơi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANNOT_BUILD.NO_TECH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANNOT_BUILD.NO_TECH"
msgid "Don't look at me, I've never made one before in my life."
msgstr "Đừng nhìn ta, đời này ta chưa từng làm cái đó bao giờ."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANTBUILDHERE_YOTB_POST
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANTBUILDHERE_YOTB_POST"
msgid "This seems a bit far from the festivities, don't you think?"
msgstr "Cái này có vẻ hơi xa khu lễ hội nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANT_ESCAPE_CURSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANT_ESCAPE_CURSE"
msgid "Odd... what kind of magic is this?"
msgstr "Lạ thật... đây là phép thuật gì thế này?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP"
msgid "Wake up, you useless vermin!"
msgstr "Dậy đi, lũ sâu mọt vô dụng này!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_STUNNED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_STUNNED"
msgid "What's the matter? Get going!"
msgstr "Sao thế? Đi đi chứ!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_WALKING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_WALKING"
msgid "Faster! Faster I say!"
msgstr "Nhanh lên! Ta bảo nhanh lên cơ mà!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1"
msgid "You fool! You're going the wrong way!"
msgstr "Đồ ngốc! Ngươi đi ngược đường rồi kìa!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2"
msgid "No! The other way!"
msgstr "Không! Lối kia cơ mà!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_START_RACE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_START_RACE"
msgid "Begin!"
msgstr "Bắt đầu!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CAVEIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CAVEIN"
msgid "The ceiling is going to collapse!"
msgstr "Trần nhà sắp sập rồi!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHAIR_ON_FIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHAIR_ON_FIRE"
msgid "This is fine."
msgstr "Ổn cả thôi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHARLIE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHARLIE"
msgid "I suppose it's best to keep up appearances..."
msgstr "Ta đoán tốt nhất là nên giữ thể diện..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHARLIESAVE.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHARLIESAVE.1"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHARLIE_ATTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHARLIE_ATTACK"
msgid "Ow! Be gentle, Charlie!"
msgstr "Ái! Nhẹ tay thôi chứ, Charlie!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.1"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.2"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.3"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.4
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.4"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.5
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.5"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.6
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.6"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.7
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.7"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.8
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.8"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.9
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.9"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COLD"
msgid "My heart grows cold."
msgstr "Trái tim ta đang nguội lạnh dần."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COMPASS_OUT"
msgid "The compass has fallen to pieces."
msgstr "La bàn đã vỡ thành từng mảnh rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COZY_SLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COZY_SLEEP"
msgid "That was a marginally more restful sleep than usual."
msgstr "Giấc ngủ đó có phần thư thái hơn bình thường một chút."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CRAFTING_FAIL"
msgid "Er... I can't do that."
msgstr "Hừm... ta không làm được việc đó."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DAMP"
msgid "Damp is not dapper."
msgstr "Ẩm ướt thì chẳng lịch thiệp chút nào."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DEERCLOPS"
msgid "I hear one of them coming."
msgstr "Ta nghe thấy tiếng một kẻ đang đến gần."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DESPAWN"
msgid "Say, pal, I don't look so good..."
msgstr "Này bạn ơi, trông ta có vẻ không ổn cho lắm..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_ATTACK"
msgid "My strength has left me."
msgstr "Sức mạnh của ta đã rời đi rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK"
msgid "Shame. I was starting to enjoy that."
msgstr "Tiếc thật. Ta bắt đầu thấy thích cảm giác đó rồi cơ mà."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY"
msgid "I'm exposed to the elements!"
msgstr "Ta đang phải đối mặt với thời tiết khắc nghiệt rồi!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION"
msgid "I've been left vulnerable!"
msgstr "Ta đã trở nên dễ bị tổn thương rồi!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE"
msgid "I'm growing tired."
msgstr "Ta đang buồn ngủ dần đây."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS"
msgid "My enthusiasm for this has run dry."
msgstr "Sự nhiệt huyết của ta với việc này đã cạn kiệt rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DIG_DISEASE_WARNING"
msgid "That takes care of that."
msgstr "Thế là xong việc đó."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DUSK"
msgid "It'll be dark soon. Charlie will be waking up."
msgstr "Trời sắp tối rồi. Charlie chuẩn bị thức dậy đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.GENERIC"
msgid "(Gulp!)"
msgstr "(Ực!)"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.INVALID
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.INVALID"
msgid "I won't let that anywhere near my mouth."
msgstr "Ta không đời nào cho thứ đó bén mảng tới miệng mình đâu."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.PAINFUL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.PAINFUL"
msgid "Ow! That hurt my mouth!"
msgstr "Ái! Đau miệng quá!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.SPOILED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.SPOILED"
msgid "That was putrid."
msgstr "Thứ đó thối rữa thật rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.STALE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.STALE"
msgid "That was past its expiration date."
msgstr "Thứ đó đã quá hạn sử dụng rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.YUCKY"
msgid "A civilized man does not eat such things."
msgstr "Một người văn minh không bao giờ ăn những thứ như thế."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EATING_NOT_FEASTING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EATING_NOT_FEASTING"
msgid "I suppose it's only right to share this with the others."
msgstr "Ta nghĩ chia sẻ món này với những người khác mới là điều phải phép."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ELIXIR_BOOSTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ELIXIR_BOOSTED"
msgid "That hit the spot."
msgstr "Đúng chỗ ngứa rồi đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ELIXIR_GHOSTVISION
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ELIXIR_GHOSTVISION"
msgid "I'd rather sleep like the dead."
msgstr "Ta thà ngủ giấc ngàn thu còn hơn."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ELIXIR_PLAYER_SPEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ELIXIR_PLAYER_SPEED"
msgid "Respect my brawn!"
msgstr "Hãy tôn trọng cơ bắp của ta đi!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ELIXIR_TOO_SUPER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ELIXIR_TOO_SUPER"
msgid "That's too stiff a drink."
msgstr "Đó là một ngụm rượu quá nặng đô."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.1"
msgid "Reduced... to this..."
msgstr "Bị đày ải... đến mức này..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.2"
msgid "Huff... huff..."
msgstr "Hộc... hộc..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.3"
msgid "This is... peasant... work..."
msgstr "Đây là... công việc của... bọn bần nông..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.4"
msgid "Oh... my back..."
msgstr "Ôi... cái lưng của ta..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.5"
msgid "I wasn't... built for this..."
msgstr "Ta vốn... không được sinh ra để làm việc này..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.6"
msgid "All my joints... are cracking!"
msgstr "Tất cả xương cốt của ta... đang kêu răng rắc!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.7"
msgid "I... was a king, you know..!"
msgstr "Ta... từng là một vị vua đấy, biết không hả..!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.8
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.8"
msgid "Oof... huff..."
msgstr "Phù... hộc..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.9
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.9"
msgid "This... better not ruin... my suit."
msgstr "Việc này... tốt nhất là đừng làm hỏng... bộ vest của ta."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENGINEERING_CAN_UPGRADE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENGINEERING_CAN_UPGRADE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENTER_DARK"
msgid "That smell... both nostalgic and terrifying!"
msgstr "Mùi đó... vừa hoài niệm lại vừa đáng sợ!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENTER_LIGHT"
msgid "Thank goodness for the light."
msgstr "Tạ ơn ánh sáng."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T1"
msgid "What's this? My shadow puppets feel just a bit stronger..."
msgstr "Gì thế này? Những con rối bóng của ta cảm thấy mạnh hơn một chút rồi..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T2"
msgid "I can feel the strength of my shadow puppets growing."
msgstr "Ta có thể cảm thấy sức mạnh của những con rối bóng đang lớn dần lên."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T3"
msgid "Go, my shadow puppets! With this power, nothing will stand in our way."
msgstr "Đi đi, những con rối bóng của ta! Với sức mạnh này, không gì có thể cản đường chúng ta nữa."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T4
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T4"
msgid "The shadow puppets I summon will be unstoppable!"
msgstr "Những con rối bóng ta triệu hồi sẽ là bất khả chiến bại!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EXIT_GELBLOB
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EXIT_GELBLOB"
msgid "Gaah! The horror!"
msgstr "Ái! Thật là kinh hoàng!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EYEOFTERROR_ARRIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EYEOFTERROR_ARRIVE"
msgid "Oh, what a magnificent horror."
msgstr "Ồ, quả là một thứ kinh hoàng tuyệt mỹ."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EYEOFTERROR_FLYAWAY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EYEOFTERROR_FLYAWAY"
msgid "It'll be back."
msgstr "Nó sẽ quay lại thôi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EYEOFTERROR_FLYBACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EYEOFTERROR_FLYBACK"
msgid "I've been awaiting your return. Let's end this."
msgstr "Ta đã chờ ngày ngươi quay lại lâu lắm rồi. Kết thúc chuyện này thôi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FAN_OUT"
msgid "There goes my respite."
msgstr "Hết chỗ nghỉ ngơi rồi kìa."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FERTILIZER_RESEARCHED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FERTILIZER_RESEARCHED"
msgid "I'm growing more knowledgeable than I'd care to be about this stuff."
msgstr "Ta đang biết nhiều hơn mức cần thiết về cái thứ này rồi đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FIRENETTLE_TOXIN.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FIRENETTLE_TOXIN.1"
msgid "Ack, those infernal nettles!"
msgstr "Hừ, đám tầm ma quái gở đó!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FIRENETTLE_TOXIN.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FIRENETTLE_TOXIN.2"
msgid "The nettle's poison is burning in my veins!"
msgstr "Độc của cây tầm ma đang thiêu đốt huyết quản của ta!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FIRENETTLE_TOXIN_DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FIRENETTLE_TOXIN_DONE"
msgid "The worst has passed."
msgstr "Mọi chuyện tồi tệ nhất đã qua rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FLARE_SEEN"
msgid "Am I supposed to come running every time I spot a flare?"
msgstr "Ta có bắt buộc phải chạy đến mỗi lần nhìn thấy một quả pháo sáng không nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FLOATER_HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FLOATER_HELD"
msgid "There are unspeakable horrors below."
msgstr "Có những thứ kinh hoàng không thể tả xiết ở bên dưới."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FLOATER_LETGO
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FLOATER_LETGO"
msgid "Ah!"
msgstr "A!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FLOAT_SWIM_TIRED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FLOAT_SWIM_TIRED"
msgid "I can't!"
msgstr "Ta không làm nổi nữa!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FOODMEMORY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FOODMEMORY"
msgid "only_used_by_warly"
msgstr "chỉ_được_sử_dụng_bởi_warly"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FREEDOM"
msgid "Freedom, at last!"
msgstr "Cuối cùng cũng được tự do!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GATHER_MERM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GATHER_MERM"
msgid "only_used_by_wurt"
msgstr "chỉ_được_sử_dụng_bởi_wurt"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GHOSTDRAIN"
msgid "They're whispering through the core of my mind...!"
msgstr "Chúng đang thì thầm xuyên qua tận sâu thẳm tâm trí ta...!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GHOST_QUEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GHOST_QUEST"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GOT_DECON_MISTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GOT_DECON_MISTED"
msgid "Ugh! It burns!"
msgstr "Ứ hự! Đau quá!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE"
msgid "I'd better not take a stroll in the acid rain anytime soon."
msgstr "Tốt nhất là ta đừng có đi dạo dưới mưa axit vào lúc này."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE"
msgid "There goes my protection against the fire."
msgstr "Hết lớp bảo vệ khỏi lửa rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE"
msgid "I can't believe it worked."
msgstr "Ta không thể tin là nó thành công đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT"
msgid "Surprise, surprise."
msgstr "Đúng là bất ngờ chưa kìa."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HIGHRESEARCH"
msgid "My brain swells with power!"
msgstr "Bộ não ta đang tràn ngập sức mạnh!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOT"
msgid "My heart can't stand the heat!"
msgstr "Trái tim ta không chịu nổi cái nóng này đâu!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOUNDS"
msgid "The hounds are growing restless."
msgstr "Đám chó săn đang bắt đầu bồn chồn rồi đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNGRY"
msgid "I am empty inside."
msgstr "Bên trong ta trống rỗng."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_AVOID_FORK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_AVOID_FORK"
msgid "I'll stick to hunting less dangerous game."
msgstr "Ta sẽ đi săn mấy con mồi ít nguy hiểm hơn vậy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "I smell dung and beast sweat."
msgstr "Ta ngửi thấy mùi phân và mồ hôi thú vật."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "Drat! It got away."
msgstr "Xém chút nữa! Nó chạy mất tiêu rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "I can't follow it in these conditions!"
msgstr "Ta không thể lần theo dấu vết trong điều kiện này được!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_START_FORK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_START_FORK"
msgid "Those vicious claw marks do not bode well..."
msgstr "Những vết cào độc ác đó không mang lại điềm lành đâu..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_SUCCESSFUL_FORK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_SUCCESSFUL_FORK"
msgid "The creature is unaware it's being pursued. Now, to strike."
msgstr "Sinh Vật Lạ vẫn chưa hay biết mình đang bị truy đuổi. Giờ thì ra tay thôi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_WRONG_FORK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_WRONG_FORK"
msgid "I fear I might have underestimated my prey..."
msgstr "Ta e rằng mình đã đánh giá thấp con mồi rồi..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "It perked up just a tiny bit."
msgstr "Nó tỉnh táo lại được chút xíu thôi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INV_FULL"
msgid "My pockets are full."
msgstr "Túi của ta đầy kín rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_IS_FEASTING"
msgid "At last, a decent meal."
msgstr "Cuối cùng cũng có một bữa ăn ra hồn."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD"
msgid "So you're the source of that pathetic mewling. I'll have to apologize to the strongman."
msgstr "Thì ra ngươi là nguồn gốc của tiếng kêu thảm hại đó. Chắc ta phải xin lỗi gã đô con kia một tiếng thôi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "A-ha! Not sneaky enough!"
msgstr "A-ha! Trốn chưa đủ kỹ đâu nhé!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "Found you!"
msgstr "Tìm thấy ngươi rồi!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
msgid "You were not clever enough to best the great Maxwell!!"
msgstr "Ngươi không đủ khôn ngoan để qua mặt Đại Maxwell này đâu!!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
msgid "Your attempt to escape me has been thwarted, child!"
msgstr "Mưu đồ trốn tránh của ngươi đã bị phá sản rồi nhóc con ạ!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE"
msgid "A-ha! That was the last one! I win!!!"
msgstr "A-ha! Đó là con cuối cùng! Ta thắng rồi!!!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM"
msgid "I had seen it already, but {name} got to it first, I suppose."
msgstr "Ta thấy nó từ trước rồi, nhưng {name} nhanh tay hơn thì phải."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE"
msgid "Only one remains."
msgstr "Chỉ còn lại một con nữa thôi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME"
msgid "Blast it!"
msgstr "Chết tiệt!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP"
msgid "Where are those blasted kittens!"
msgstr "Mấy con mèo chết tiệt đó trốn ở đâu rồi nhỉ!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR"
msgid "I doubt those tiny, pathetic legs would carry them this far."
msgstr "Ta nghi ngờ cái đôi chân ngắn ngủn thảm hại đó có thể đưa chúng đi xa đến thế này."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN"
msgid "This seems much more likely an area to find the kitcoons."
msgstr "Khu vực này có vẻ hợp để tìm mấy con mèo trúc hơn đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN"
msgid "Of course you need my help."
msgstr "Dĩ nhiên là ngươi cần sự giúp đỡ của ta rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDEANDSEEK_START
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDEANDSEEK_START"
msgid "I suppose we shall begin this ridiculous game."
msgstr "Ta đoán chúng ta phải bắt đầu trò chơi nhảm nhí này thôi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "The coward has summoned its minions."
msgstr "Tên hèn nhát đó đã gọi đàn em ra cứu viện rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_ENRAGE"
msgid "Time to beat a hasty retreat!"
msgstr "Đến lúc chuồn lẹ thôi!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_UNCHAINED"
msgid "Its true power has been unlocked!"
msgstr "Sức mạnh thực sự của nó đã được giải phóng!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KNOCKEDOUT"
msgid "Ugh. My head hurts."
msgstr "Hừ. Đầu ta đau quá."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "Can't touch this!"
msgstr "Đừng hòng chạm vào ta!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LIGHTSOUT_SHADOWHAND
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LIGHTSOUT_SHADOWHAND"
msgid "Hmm... could you be... trying to help?"
msgstr "Hừm... ngươi đang... cố giúp ta à?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LOWRESEARCH"
msgid "That wasn't very informative."
msgstr "Cái đó chẳng cung cấp thêm thông tin gì mấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LUNARGUARDIAN_INCOMING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LUNARGUARDIAN_INCOMING"
msgid "Again? What now?"
msgstr "Lại nữa á? Gì nữa đây?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LUNARHAIL_BIRD_CORPSES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LUNARHAIL_BIRD_CORPSES"
msgid "That's not a good sign."
msgstr "Đó không phải là bảng hiệu tốt đâu."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS"
msgid "What is that racket?"
msgstr "Cái tiếng ồn ào gì thế này?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LUNAR_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LUNAR_RIFT_MAX"
msgid "Something has changed..."
msgstr "Có gì đó đã thay đổi..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Too many of this piece on the board already, I suppose."
msgstr "Ta đoán trên bàn cờ có quá nhiều quân cờ loại này rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MEGA_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MEGA_FLARE_SEEN"
msgid "That flare's going to send some poor fool into a world of trouble."
msgstr "Cái pháo sáng đó sẽ đẩy một kẻ khốn khổ nào đó vào rắc rối to đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MITEGLAND_DEBUFF.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MITEGLAND_DEBUFF.1"
msgid "Why did I eat that accursed thing?!"
msgstr "Tại sao ta lại ăn cái thứ chết tiệt đó cơ chứ?!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MITEGLAND_DEBUFF.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MITEGLAND_DEBUFF.2"
msgid "When will this infernal burning cease?!"
msgstr "Đến bao giờ cái cảm giác thiêu đốt quái quỷ này mới dừng lại đây?!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MITEGLAND_DEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MITEGLAND_DEBUFF_DONE"
msgid "That was a mistake I won't be repeating soon."
msgstr "Đó là một sai lầm mà ta sẽ không lặp lại lần nữa đâu."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MONKEY_CURSE_1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MONKEY_CURSE_1"
msgid "I've just had the most unpleasant feeling..."
msgstr "Ta vừa có một cảm giác cực kỳ khó chịu..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MONKEY_CURSE_CHANGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MONKEY_CURSE_CHANGE"
msgid "A monkey? Have I not suffered enough humiliation already?!"
msgstr "Biến thành khỉ ư? Ta còn chưa bị sỉ nhục đủ hay sao hả?!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MONKEY_CURSE_CHANGEBACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MONKEY_CURSE_CHANGEBACK"
msgid "Nobody. Bring this up. Again."
msgstr "Không. Ai. Nhắc lại. Chuyện này. Nữa."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW"
msgid "I must have your knowledge."
msgstr "Ta phải lấy cho bằng được tri thức của ngươi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "I hear you in there."
msgstr "Ta nghe thấy tiếng ngươi trong đó đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "A-ha!"
msgstr "A-ha!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "I must have your knowledge."
msgstr "Ta phải lấy cho bằng được tri thức của ngươi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "I hear you in there."
msgstr "Ta nghe thấy tiếng ngươi trong đó đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "A-ha!"
msgstr "A-ha!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "I must have your knowledge."
msgstr "Ta phải lấy cho bằng được tri thức của ngươi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "I hear you in there."
msgstr "Ta nghe thấy tiếng ngươi trong đó đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "A-ha!"
msgstr "A-ha!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONPOTION_FAILED"
msgid "How disappointing."
msgstr "Thật là thất vọng quá đi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOSQUITOS"
msgid "What annoying little bugs."
msgstr "Đám côn trùng phiền phức thật đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "Say, pal, you don't look so good."
msgstr "Này bạn ơi, trông bạn không ổn chút nào đâu."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL"
msgid "I hate buzzards, but these are... wrong."
msgstr "Ta ghét đám kên kên, nhưng bọn này thì... sai trái quá."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERGIFT"
msgid "That's a terrible idea right now."
msgstr "Làm thế lúc này là một ý kiến tồi tệ đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERSIESTA"
msgid "They're hot on my heels!"
msgstr "Chúng đang bám sát gót ta kìa!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERSLEEP"
msgid "Not while there's danger afoot!"
msgstr "Không thể ngủ khi nguy hiểm đang rình rập được!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODAYSLEEP"
msgid "I can't sleep during daylight hours."
msgstr "Ta không thể ngủ vào ban ngày được."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "Sleeping now would mess up my sleep schedule!"
msgstr "Ngủ bây giờ sẽ làm đảo lộn giờ giấc sinh hoạt của ta mất!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOHUNGERSIESTA"
msgid "Traditionally, a siesta comes after eating, not before."
msgstr "Thông thường thì phải ăn xong mới nghỉ trưa, chứ ai lại nghỉ trước khi ăn bao giờ."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOHUNGERSLEEP"
msgid "I'm too hungry. I can't sleep."
msgstr "Ta đói quá rồi. Không ngủ được đâu."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I'm not opening that on top of this thing."
msgstr "Ta không mở món quà đó khi đang cưỡi thứ này đâu."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NONIGHTSIESTA"
msgid "It's sleep time, not siesta time."
msgstr "Bây giờ là giờ đi ngủ, chứ không phải giờ nghỉ trưa."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "It's a bit creepy out for that."
msgstr "Trời bên ngoài hơi rợn tóc gáy để làm việc đó đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOPUMPKINCARVINGONFIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOPUMPKINCARVINGONFIRE"
msgid "That's what I get for engaging in foolery."
msgstr "Đó là cái giá phải trả cho việc đùa dai đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT"
msgid "Oh for... would you turn that blasted light off?!"
msgstr "Lạy Chúa... ngài có thể tắt cái thứ ánh sáng chết tiệt đó đi được không?!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOSLEEPONFIRE"
msgid "That might not be the best idea."
msgstr "Đó chắc không phải là ý kiến hay ho gì đâu."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOWARDROBEONFIRE"
msgid "You're kidding right?"
msgstr "Ngươi đang đùa chắc?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NO_ABIGAIL_FLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NO_ABIGAIL_FLOWER"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NO_TRAP"
msgid "Odd. They forgot to set it."
msgstr "Lạ thật. Chúng quên đặt bẫy cơ à."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "That was, of course, just a warm up..."
msgstr "Dĩ nhiên là nãy giờ chỉ là khởi động thôi mà..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "We will meet again, mark my words..."
msgstr "Chúng ta sẽ gặp lại nhau, cứ nhớ lấy lời ta..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "I must exercise patience."
msgstr "Ta phải kiên nhẫn mới được."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "I daresay, this is almost relaxing."
msgstr "Phải công nhận là việc này gần như thư giãn phết."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "Why won't they take the bait? Perhaps I should offer secret knowledge..."
msgstr "Sao chúng không cắn câu nhỉ? Hay là ta nên tung ra bí kíp gia truyền đây..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "I am beginning to tire of all this waiting."
msgstr "Ta bắt đầu thấy chán ngấy cái cảnh chờ đợi này rồi đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "Blast! That cad-fish got away with my tackle!"
msgstr "Chết tiệt! Con cá khốn kiếp đó đã ngoạm mất cả cần câu của ta rồi!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "The line needs more tension."
msgstr "Cần câu cần phải căng hơn nữa."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "We're in for some trouble."
msgstr "Chúng ta sắp gặp rắc rối to rồi đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OFF_SCRIPT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OFF_SCRIPT"
msgid "She won't like that."
msgstr "Cô ta sẽ không thích điều đó đâu."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OTTERBOAT_DENBROKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OTTERBOAT_DENBROKEN"
msgid "Those accursed creatures! The den was all that held this platform together!"
msgstr "Lũ sinh vật chết tiệt đó! Cái hang chính là thứ duy nhất giữ cho bệ nổi này kết dính với nhau đấy!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS"
msgid "Ah. So it's not seaworthy after all."
msgstr "À. Hóa ra nó không đủ tiêu chuẩn đi biển rốt cuộc."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PECKED"
msgid "Have patience!"
msgstr "Kiên nhẫn nào!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PETRIFED_TREES"
msgid "Oh, this should be good."
msgstr "Ồ, vụ này hay đây."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "How putrid!"
msgstr "Gớm ghiếc làm sao!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PIRATES_ARRIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PIRATES_ARRIVE"
msgid "I don't like the sound of that..."
msgstr "Ta không thích cái âm thanh đó chút nào..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PLANT_RANDOMSEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PLANT_RANDOMSEED"
msgid "It had better grow into something worthwhile."
msgstr "Mong là nó mọc ra được thứ gì đó ra hồn."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PLANT_RESEARCHED.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PLANT_RESEARCHED.1"
msgid "This plant's secrets are revealing themselves to me."
msgstr "Những bí mật của thực vật này đang dần hé lộ với ta."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_POCKETWATCH_PORTAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_POCKETWATCH_PORTAL"
msgid "Oh ha-ha, laugh it up. I wouldn't have landed on my rump if the witch knew how to navigate!"
msgstr "Ồ haha, cười đi cứ cười đi. Nếu mụ phù thủy kia mà biết đường đi nước bước thì ta đã chẳng ngã chổng vó lên trời rồi!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PREFALLINVOID
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PREFALLINVOID"
msgid "That's not good."
msgstr "Không ổn rồi đây."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_QUAKE"
msgid "That rumbling can't be good."
msgstr "Tiếng ầm ầm đó không có gì là tốt lành đâu."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT"
msgid "Typical rabbit. Never there when you need them."
msgstr "Đúng chất loài thỏ. Lúc cần thì chẳng thấy bóng dáng đâu."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_AGGRESSIVE"
msgid "A frenzy of activity underfoot."
msgstr "Dưới chân đang có một sự náo động cuồng loạn kìa."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_LUCKY"
msgid "Simon, you rapscallion!"
msgstr "Simon, quân tiểu nhân nhà ngươi!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_LUCKYCAUGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_LUCKYCAUGHT"
msgid "I've got you now, Simon!"
msgstr "Ta tóm được ngươi rồi nhé, Simon!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_PASSIVE"
msgid "Some crawling creature beneath us, no doubt."
msgstr "Chắc chắn là có sinh vật nào đó đang bò lổm ngổm bên dưới chúng ta rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REPELLED"
msgid "What trickery is this!"
msgstr "Mưu mô gì thế này!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RESEARCH"
msgid "Knowledge is power. And power is... well, power."
msgstr "Tri thức là sức mạnh. Và sức mạnh thì... ừ thì là sức mạnh."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "That was simply undignified."
msgstr "Hành động đó quả là mất mặt."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "No need to thank me."
msgstr "Khỏi cần cảm ơn ta."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVING_CORPSE"
msgid "Allow me to assist."
msgstr "Để ta giúp một tay."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY.1"
msgid "Someone thinks highly of themselves."
msgstr "Có kẻ đang tự cao tự đại kìa."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY.2"
msgid "Your \"Majesty\"."
msgstr "\"Bệ hạ\" cơ đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY.3"
msgid "Your \"Royal Highness\""
msgstr "\"Điện hạ\" cơ đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY_JOKER.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY_JOKER.1"
msgid "It's a perfect fit."
msgstr "Vừa khít luôn."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY_JOKER.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY_JOKER.2"
msgid "Your \"Majesty\"."
msgstr "\"Bệ hạ\" cơ đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY_JOKER.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY_JOKER.3"
msgid "Your \"Royal Highness\""
msgstr "\"Điện hạ\" cơ đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RUINS_RESET"
msgid "The cycle begins again."
msgstr "Chu kỳ lại bắt đầu."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SACREDCHEST_NO"
msgid "It's deemed me unworthy."
msgstr "Nó cho rằng ta không xứng đáng."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SACREDCHEST_YES"
msgid "Was there ever a doubt?"
msgstr "Có phải nghi ngờ gì nữa đâu?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SCRAPBOOK_FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SCRAPBOOK_FULL"
msgid "I know all I need to already."
msgstr "Ta biết tất cả những gì mình cần biết rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SECURITY_PULSE_FOLLOWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SECURITY_PULSE_FOLLOWING"
msgid "Ugh, are you going to follow me everywhere?"
msgstr "Hừ, ngươi định bám theo ta đi khắp nơi luôn à?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOWLEVEL_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOWLEVEL_ITEM"
msgid "\nMy shadow puppets should be able to draw from its power..."
msgstr "Những con rối bóng của ta chắc sẽ tận dụng được sức mạnh từ nó..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOWTHRALL_STEALTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOWTHRALL_STEALTH"
msgid "Who bit me? Show yourself, coward!"
msgstr "Đứa nào cắn ta đấy? Lòi mặt ra đây xem nào, đồ hèn!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOW_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOW_RIFT_MAX"
msgid "Something's stirring..."
msgstr "Có gì đó đang chuyển động..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHELTER"
msgid "Protect me, cursed tree!"
msgstr "Hãy bảo vệ ta đi, cái cây bị nguyền rủa này!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SISTURN_FULL_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SISTURN_FULL_BLOSSOM"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SISTURN_FULL_EVIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SISTURN_FULL_EVIL"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNARED"
msgid "How dare you!"
msgstr "Láo thật đấy!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNARED_IVY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNARED_IVY"
msgid "Wretched greenery! Release me at once!"
msgstr "Lũ dây leo khốn kiếp! Thả ta ra ngay lập tức!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNOWBALL_NO_SNOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNOWBALL_NO_SNOW"
msgid "There's no snow here."
msgstr "Ở đây làm gì có tuyết."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNOWBALL_TOO_BIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNOWBALL_TOO_BIG"
msgid "Useless! It won't get any bigger."
msgstr "Vô dụng! Nó chẳng to lên được nữa đâu."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SOAKED"
msgid "Wetter than water itself."
msgstr "Ướt hơn cả nước luôn rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SPOOKED"
msgid "Disgusting!"
msgstr "Ghê tởm thật đấy!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.1"
msgid "I feel ridiculous. Is this really supposed to help it grow?"
msgstr "Ta thấy mình thật lố bịch. Việc này thực sự giúp nó lớn lên á?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.2"
msgid "Grow faster, you blasted thing! There, did that help?"
msgstr "Lớn nhanh lên cái đồ chết tiệt này! Đấy, nói thế có khá hơn không hả?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.3"
msgid "You know, I ruled over this entire world once. Now I'm talking to a plant."
msgstr "Biết sao không, có thời ta từng cai trị cả thế giới này đấy. Giờ thì lại đang đi nói chuyện với thực vật."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.4
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.4"
msgid "Say pal, do you like magic tricks? This is the one where I talk and you grow."
msgstr "Ta đây, đang ngồi tán phét với một đám cỏ cây đây. Đây là trò ảo thuật mà ta nói, ta nói còn ngươi thì lớn."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "Here I am, chatting it up with the vegetation."
msgstr "Ta đây rồi, đang ngồi trò chuyện rôm rả với thảm thực vật đây."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_THORNS"
msgid "I scratched my arms up doing that."
msgstr "Tay ta bị cào xước hết cả rồi kìa."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_THURIBLE_OUT"
msgid "A shame."
msgstr "Tiếc thật."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_ABANDONED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_ABANDONED"
msgid "Fine! Begone! The Great Maxwell doesn't need help for a simple child's game."
msgstr "Được rồi! Cút đi! Đại Maxwell này không cần giúp cho trò chơi con nít này đâu."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_DEAD"
msgid "That foolish creature! This may prove to be a setback..."
msgstr "Con sinh vật ngốc nghếch đó! Vụ này có khi lại rắc rối to đây..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_GET_LEADER_ATTENTION
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_GET_LEADER_ATTENTION"
msgid "Can't you see I'm busy, rodent!? ...My apologies. Where were we?"
msgstr "Không thấy ta đang bận à, hả đồ gặm nhấm?! ...Xin lỗi nhé. Chúng ta vừa nói đến đâu rồi nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_LOST_KITCOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_LOST_KITCOON"
msgid "Drat, someone found this kitcoon before us."
msgstr "Xém chút nữa, có kẻ đã tìm thấy con mèo trúc này trước chúng ta rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_NEAR_KITCOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_NEAR_KITCOON"
msgid "Ah, we must be near a kitcoon..."
msgstr "À, chắc chúng ta đang ở gần mèo trúc rồi đây..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_NOTHING_TO_TRACK"
msgid "Nothing??? Useless animal!"
msgstr "Không có gì á??? Con vật vô dụng!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_START_TRACKING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_START_TRACKING"
msgid "Yes, good... lead me to the kitcoons."
msgstr "Đúng rồi, tốt lắm... hãy dẫn đường tới chỗ mấy con mèo trúc đi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_WAITING_FOR_LEADER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_WAITING_FOR_LEADER"
msgid "Even a creature of your stature knows to wait for its superiors."
msgstr "Đến một sinh vật tầm thường như ngươi cũng biết phải đợi bề trên cơ đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOADESCAPED"
msgid "It fled back into the earth."
msgstr "Nó trốn ngược lại xuống lòng đất rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOADESCAPING"
msgid "Now is the time to strike!"
msgstr "Giờ chính là lúc ra tay!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOOL_SLIP"
msgid "Drat."
msgstr "Xém xém."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOOL_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOOL_TOOWEAK"
msgid "I'll need a more powerful tool."
msgstr "Ta sẽ cần một cái dụng cụ mạnh hơn."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TORCH_OUT"
msgid "Curses. Another light down."
msgstr "Khỉ thật. Lại thêm một ngọn đuốc tắt ngấm."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "It's about time."
msgstr "Cuối cùng cũng tới nơi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TRAP_WENT_OFF"
msgid "Ack!"
msgstr "Ái!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_UNIMPLEMENTED"
msgid "Hmm, not quite done."
msgstr "Hừm, vẫn chưa xong hẳn."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_VAULT_SHADOW_ASSIST
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_VAULT_SHADOW_ASSIST"
msgid "They're here to help... I'm beginning to understand."
msgstr "Chúng đến để giúp... ta bắt đầu hiểu ra rồi đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_VAULT_TELEPORTER_DOES_NOTHING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_VAULT_TELEPORTER_DOES_NOTHING"
msgid "It's always something with that moon magic."
msgstr "Lúc nào cũng có vấn đề với cái phép thuật mặt trăng đó."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WASHED_ASHORE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WASHED_ASHORE"
msgid "My suit is drenched in salt water."
msgstr "Bộ vest của ta đẫm nước muối rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEAK_RAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEAK_RAT"
msgid "The creature is past its prime."
msgstr "Sinh Vật Lạ này đã qua thời kỳ đỉnh cao rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEAPON_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEAPON_TOOWEAK"
msgid "Pathetic! I need something stronger!"
msgstr "Thật thảm hại! Ta cần thứ gì đó mạnh hơn!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEIGHT"
msgid "Weight: {weight}"
msgstr "Cân nặng: {weight}"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEIGHT_HEAVY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEIGHT_HEAVY"
msgid "Weight: {weight}\nEr... I don't suppose anyone would help me carry this?"
msgstr "Cân nặng: {weight}\nÀ... ta đoán là chẳng có ai giúp ta vác cái này đâu nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WENDY_BABYSITTER_SET
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WENDY_BABYSITTER_SET"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WENDY_BABYSITTER_STOP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WENDY_BABYSITTER_STOP"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WET"
msgid "Water'll ruin a good suit, you know?"
msgstr "Nước sẽ làm hỏng cả một bộ vest đẹp đấy, biết không hả?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WETTER"
msgid "I don't think I'll ever be dry again."
msgstr "Ta nghĩ mình sẽ chẳng bao giờ khô ráo nổi nữa đâu."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINCH_CLAW_MISS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINCH_CLAW_MISS"
msgid "Foiled again!"
msgstr "Lại hụt nữa rồi!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINCH_CLAW_NO_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINCH_CLAW_NO_ITEM"
msgid "I don't know what I expected."
msgstr "Ta cũng chẳng mong đợi gì hơn."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINTERS_FEAST_BUFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINTERS_FEAST_BUFF"
msgid "That food seems to have had an odd affect on me..."
msgstr "Món ăn đó có vẻ gây ra ảnh hưởng kỳ lạ lên người ta..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINTERS_FEAST_BUFF_OVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINTERS_FEAST_BUFF_OVER"
msgid "Its power was short-lived."
msgstr "Sức mạnh của nó ngắn ngủi thật đấy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_BEGIN_COACHING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_BEGIN_COACHING"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_END_COACHING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_END_COACHING"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_MIGHTY_COACHING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_MIGHTY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_NOTEAM.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_NOTEAM.1"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_NOTEAM.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_NOTEAM.2"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_NOTEAM.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_NOTEAM.3"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_WIMPY_COACHING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_WIMPY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMHOLE"
msgid "Yech. It's horrible in there."
msgstr "Ghê quá. Trong đó kinh khủng lắm."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMS"
msgid "Oh dear. I know what's making that sound."
msgstr "Ôi trời. Ta biết cái thứ phát ra tiếng động đó là gì rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMS_BOSS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMS_BOSS"
msgid "Curses. I know that sound."
msgstr "Chết tiệt. Ta biết cái tiếng đó mà."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT"
msgid "Surprise, surprise."
msgstr "Đúng là bất ngờ chưa kìa."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WX_SCANNER_NEW_FOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WX_SCANNER_NEW_FOUND"
msgid "only_used_by_wx78"
msgstr "chỉ_được_sử_dụng_bởi_wx78"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTB_LEARN_NEW_PATTERN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTB_LEARN_NEW_PATTERN"
msgid "At last, something new."
msgstr "Cuối cùng cũng có thứ mới mẻ."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTD_NOBOATS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTD_NOBOATS"
msgid "Oh, I'm not close enough to the starting point? Well maybe it should come to me!"
msgstr "Ồ, ta đứng chưa đủ gần điểm xuất phát à? Hay là nó tự đến chỗ ta đi!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTD_NOCHECKPOINTS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTD_NOCHECKPOINTS"
msgid "I think you're forgetting something, pal."
msgstr "Ta nghĩ ngươi đang quên mất thứ gì đó rồi đấy, bạn tôi ơi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTD_NOTENOUGHBOATS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTD_NOTENOUGHBOATS"
msgid "Perhaps some space should be cleared around the Start Tower."
msgstr "Có lẽ nên dọn dẹp chút không gian xung quanh tháp xuất phát đi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTH_ONCOOLDOWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTH_ONCOOLDOWN"
msgid "What could possibly be so important that they would not come when I call?"
msgstr "Cái quái gì mà quan trọng đến mức gọi mãi mà không thèm tới thế hả?"

#. STRINGS.CHARACTERS.WAXWELL.ANOUNCE_MUTATED_BIRD_ATTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANOUNCE_MUTATED_BIRD_ATTACK"
msgid "Blasted birds!"
msgstr "Đám chim chết tiệt!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.DEER"
msgid "You do not belong in MY world!"
msgstr "Ngươi không thuộc về thế giới CỦA TA!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.GENERIC"
msgid "To arms!"
msgstr "Xông lên nào!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.PIG"
msgid "Brains over brawn!"
msgstr "Dùng trí tuệ áp đảo cơ bắp!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.PREY"
msgid "Sacrifice yourself for my comfort!"
msgstr "Hãy hiến dâng bản thân để mang lại sự thoải mái cho ta đi!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.SPIDER"
msgid "I'll not be made a fool of!"
msgstr "Ta không để mình bị biến thành kẻ ngốc đâu!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.SPIDER_WARRIOR"
msgid "You've forced my hand!"
msgstr "Ngươi ép ta phải ra tay đấy nhé!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.GENERIC"
msgid "And stay away!"
msgstr "Và đừng có bén mảng lại gần nữa!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.PIG"
msgid "Next time, pig!"
msgstr "Lần sau nhé, heo nọc!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.PREY"
msgid "You're not worth my time!"
msgstr "Ngươi không đáng để ta tốn thời gian!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.SPIDER"
msgid "I won't be made a fool of... next time!"
msgstr "Ta sẽ không để bị biến thành kẻ ngốc... vào lần tới!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "Next time the gloves come off!"
msgstr "Lần sau ta sẽ không nương tay nữa đâu!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL1.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL1.1"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Đúng là một con ma lanh lợi nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL1.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL1.2"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Đúng là một con ma lanh lợi nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL2.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL2.1"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Đúng là một con ma lanh lợi nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL2.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL2.2"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Đúng là một con ma lanh lợi nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL3.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL3.1"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Đúng là một con ma lanh lợi nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL3.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL3.2"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Đúng là một con ma lanh lợi nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "Hm? What a familiar presence."
msgstr "Hửm? Thật là một sự hiện diện quen thuộc."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "It demands a sacrifice."
msgstr "Nó đòi hỏi một vật tế."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "I should quit toying with this now."
msgstr "Ta nên ngừng đùa giỡn với thứ này thôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "I can sense strong magic within it."
msgstr "Ta có thể cảm nhận được phép thuật mạnh mẽ bên trong nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "A powerful bond tethers this spirit to our world."
msgstr "Một mối liên kết mạnh mẽ trói buộc linh hồn này với thế giới của chúng ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "...I wonder how my brother is doing."
msgstr "...Không biết dạo này anh trai mình thế nào rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "I can sense strong magic within it."
msgstr "Ta có thể cảm nhận được phép thuật mạnh mẽ bên trong nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "This enchantment is not of my doing."
msgstr "Phép yểm bùa này không phải do ta làm ra."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "Whatever it is will be arriving soon."
msgstr "Bất kể đó là gì thì cũng sắp đến rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED"
msgid "Bug off! Ugh, I sound like Wilson."
msgstr "Cút đi! Hừ, nghe cứ như Wilson ấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABYSSPILLAR_MINION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABYSSPILLAR_MINION.GENERIC"
msgid "It's ugly."
msgstr "Trông xấu xí thật."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABYSSPILLAR_TRIAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABYSSPILLAR_TRIAL"
msgid "Let's get on with it then."
msgstr "Thế thì bắt đầu thôi nào."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "Even They couldn't build something so devious."
msgstr "Ngay cả Bọn Hắn cũng không thể xây nổi một thứ xảo quyệt thế này."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN"
msgid "A more outdoorsy type might be able to make something of this."
msgstr "Một kẻ thích dã ngoại có lẽ sẽ làm nên chuyện với thứ này."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN_COOKED"
msgid "Over an open fire."
msgstr "Trên đống lửa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN_SAPLING"
msgid "Huh, it seems to belong in the ground."
msgstr "Ồ, nó có vẻ thuộc về mặt đất."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ADVENTURE_PORTAL"
msgid "So that's where I left that thing!"
msgstr "Thì ra mình để thứ đó ở đây!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIANHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIANHAT"
msgid "It makes me uneasy... but I can't deny its power."
msgstr "Nó khiến ta thấy bất an... nhưng ta không thể phủ nhận sức mạnh của nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIANHATSHARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIANHATSHARD"
msgid "Even shattered, it holds power."
msgstr "Dù đã vỡ nát, nó vẫn mang sức mạnh."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_CONTAINED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_CONTAINED"
msgid "Ah, now I see..."
msgstr "À, giờ thì ta hiểu rồi..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD"
msgid "Something doesn't feel right..."
msgstr "Có gì đó không ổn lắm..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC"
msgid "It seems our actions have been noticed."
msgstr "Có vẻ hành động của chúng ta đã bị chú ý rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT"
msgid "It looks nastier than before."
msgstr "Trông nó đáng sợ hơn trước."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT"
msgid "This had better be the one he wants."
msgstr "Mong rằng đây là thứ hắn muốn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD"
msgid "Come on now. You're not fooling anyone."
msgstr "Thôi nào. Ngươi chẳng lừa được ai đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC"
msgid "It toys with us."
msgstr "Nó đang đùa giỡn với chúng ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE"
msgid "It's trying to ensnare us."
msgstr "Nó đang cố bẫy chúng ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3"
msgid "At last you reveal your true self."
msgstr "Cuối cùng ngươi cũng lộ nguyên hình rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD"
msgid "I don't know what to believe. All this time, I thought that They were..."
msgstr "Ta chẳng biết nên tin vào điều gì nữa. Suốt thời gian qua, ta cứ tưởng Bọn Hắn là..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB"
msgid "This power, it feels like... but it couldn't be..."
msgstr "Sức mạnh này, cảm giác giống như... nhưng không thể nào..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP"
msgid "I'd do well to avoid those."
msgstr "Ta nên tránh xa mấy thứ đó ra thì hơn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT"
msgid "Such grotesquerie."
msgstr "Thật là quái dị."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.AMULET"
msgid "It channels the darkest energies of the universe."
msgstr "Nó dẫn dắt những năng lượng đen tối nhất của vũ trụ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCHOR"
msgid "I can drop it to keep the boat in place."
msgstr "Ta có thể thả neo xuống để giữ thuyền ván ở yên một chỗ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCHOR_ITEM"
msgid "Can't someone else assemble it?"
msgstr "Không ai khác tự lắp ráp nó được sao?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTFRUIT_GEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "I sense magic at its core. Now, how to get it out..."
msgstr "Ta cảm nhận được phép thuật ở cốt lõi của nó. Giờ thì làm sao lấy nó ra đây..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "Hm. Tangy."
msgstr "Hừ. Hơi hăng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "I prefer them raw."
msgstr "Ta thích ăn sống hơn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
msgid "I'm sure it will burn out eventually."
msgstr "Ta chắc là cuối cùng nó cũng sẽ cháy hết thôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_GEM.STUMP"
msgid "Close enough."
msgstr "Gần được rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
msgid "It provides a lovely ambiance of dread, don't you think?"
msgstr "Nó tạo ra một bầu không khí đáng sợ dễ chịu đấy chứ, ngươi không nghĩ vậy sao?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
msgid "A pity."
msgstr "Tiếc thật."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
msgid "It's coming along nicely."
msgstr "Nó đang phát triển khá tốt đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON"
msgid "Patience. It's time will come."
msgstr "Kiên nhẫn nào. Thời của nó rồi sẽ đến."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE"
msgid "Impudent plant. This patch of ground isn't good enough for you?"
msgstr "Thực vật hỗn láo. Mảng đất này không đủ tốt cho ngươi à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING_ITEM"
msgid "I suppose I have no choice but to get my hands dirty."
msgstr "Chắc là ta không còn cách nào khác ngoài việc tự nhúng tay vào rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SEED"
msgid "How mysterious."
msgstr "Thật là bí ẩn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_ALTAR"
msgid "Where are their gods now?"
msgstr "Thần linh của chúng đâu rồi?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "This can be partially restored."
msgstr "Thứ này có thể được phục hồi một phần."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_HUSK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_HUSK"
msgid "Like I said, they were a nasty lot."
msgstr "Như ta đã nói, chúng là một lũ khó ưa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_STATUE"
msgid "A once proud race."
msgstr "Một chủng tộc từng rất kiêu hãnh."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANIMAL_TRACK"
msgid "Some dumb beast passed through here."
msgstr "Vài con thú ngốc nghếch nào đó vừa đi qua đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTCHOVIES"
msgid "What a miserable thing."
msgstr "Đúng là một sinh vật thảm hại."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.GENERIC"
msgid "Have you no pride?"
msgstr "Ngươi không có chút lòng tự trọng nào sao?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.UNHAPPY"
msgid "It's going to wreak havoc on my world."
msgstr "Nó chuẩn bị tàn phá thế giới của ta rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.VERYHAPPY"
msgid "We've placated it for now."
msgstr "Tạm thời chúng ta đã xoa dịu được nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLIONHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLIONHAT"
msgid "If the ground displeases me, I'll pull it up by the roots."
msgstr "Nếu mặt đất làm ta khó chịu, ta sẽ nhổ tận gốc nó lên."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLIONTRINKET"
msgid "I'll cross it off my bucket list."
msgstr "Ta sẽ gạch nó khỏi danh sách những việc phải làm trước khi chết."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "I get the sensation that we are not welcome here."
msgstr "Ta có cảm giác rằng chúng ta không được chào đón ở đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "A pile of worthless parts."
msgstr "Một đống phụ tùng vô giá trị."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "A bit overdone for my tastes."
msgstr "Hơi quá lửa so với khẩu vị của ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "Wait for it..."
msgstr "Đợi chút nào..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "Here it comes!"
msgstr "Nó đến kìa!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "Finally, some quality grub."
msgstr "Cuối cùng cũng có con Sâu ra trò để ăn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "They didn't always live off of the fuel."
msgstr "Họ không phải lúc nào cũng sống nhờ vào nhiên liệu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "Impossible... I thought I was privy to all of Their secrets."
msgstr "Không thể nào... Ta tưởng mình đã nắm rõ mọi bí mật của Bọn Hắn chứ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "Ah. I suppose I misinterpreted the original design."
msgstr "À. Chắc là ta đã hiểu sai thiết kế ban đầu rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "I always wondered where those parts came from."
msgstr "Ta vẫn luôn thắc mắc những bộ phận đó xuất phát từ đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "How did I not know of this place? Did They know?"
msgstr "Làm sao mà ta lại không biết nơi này nhỉ? Liệu Bọn Hắn có biết không?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "Rather devious."
msgstr "Khá là ranh ma."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "Still inactive. Curious."
msgstr "Vẫn bất động. Thật tò mò."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "It couldn't be..."
msgstr "Không thể nào..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "It's leading us to something..."
msgstr "Nó đang dẫn đường cho chúng ta tới thứ gì đó..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "It fulfilled its purpose."
msgstr "Nó đã hoàn thành mục đích của mình rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "I have many questions."
msgstr "Ta có rất nhiều câu hỏi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "These runes are... different."
msgstr "Mấy cổ văn này... khác lạ quá."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2"
msgid "I can only glean a hint of their meaning."
msgstr "Tôi chỉ đoán mò được một chút ý nghĩa của chúng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3"
msgid "This symbol here keeps repeating..."
msgstr "Ký hiệu này cứ lặp đi lặp lại mãi..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
msgid "\"To change?\" No. It's a name..."
msgstr "\"Thay đổi?\" Không. Đó là một cái tên..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
msgid "\"Alter\"?"
msgstr "\"Thay đổi\" ư?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
msgid "Hm. I have a bad feeling..."
msgstr "Hừ. Mình có linh tính chẳng lành..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
msgid "It's powerless."
msgstr "Nó mất nguồn rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SECURITY_PULSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SECURITY_PULSE"
msgid "Don't let it escape!"
msgstr "Đừng để nó thoát!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SWITCH.GEMS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SWITCH.GEMS"
msgid "I suppose I'll need to find a suitable gem."
msgstr "Chắc là mình cần tìm một viên ngọc phù hợp."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SWITCH.VALID
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SWITCH.VALID"
msgid "It saps power from the gems."
msgstr "Nó rút năng lượng từ các viên ngọc."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORDRAGONFLY"
msgid "That's some fly mail."
msgstr "Đúng là bộ giáp kêu căng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORDREADSTONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORDREADSTONE"
msgid "Black never goes out of style."
msgstr "Màu đen không bao giờ lỗi mốt."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORGRASS"
msgid "Direct confrontation is quite gauche."
msgstr "Đánh trực diện thì thô lỗ quá."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORMARBLE"
msgid "That really isn't my style."
msgstr "Cái đó không hợp với phong cách của tôi lắm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORRUINS"
msgid "Thulecite meshes so well with nightmare fuel."
msgstr "Thulecite hòa quyện hoàn hảo với Nhiên liệu Ác Mộng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSKELETON"
msgid "Like all things, it craves the fuel."
msgstr "Giống như mọi thứ khác, nó thèm khát nhiên liệu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSLURPER"
msgid "Wet, soggy, and oddly filling."
msgstr "Ướt át, nhão nhoét, và no đến kì lạ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSNURTLESHELL"
msgid "That is not dapper at all."
msgstr "Trông chẳng lịch lãm chút nào."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORWAGPUNK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORWAGPUNK"
msgid "What it lacks in style it almost makes up for in pure, stubborn resilience."
msgstr "Thứ nó thiếu về mặt phong cách đã được bù đắp phần nào bằng sự kiên cường lì lợm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORWOOD"
msgid "Ugh. I'm not typically one for vulgar fisticuffs."
msgstr "Hừm. Ta thường không thích mấy trò ẩu đả thô tục."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_BRAMBLE"
msgid "Who's frail now?"
msgstr "Ai mới là kẻ mong manh đây?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_CARROTLURE"
msgid "A little obsessed with bunnies, are we?"
msgstr "Hơi bị ám ảnh với lũ thỏ rồi đấy, nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_LUNARPLANT"
msgid "Does no one else find this armor oddly itchy?"
msgstr "Không ai khác thấy bộ giáp này ngứa ngáy một cách kỳ lạ à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_LUNARPLANT_HUSK"
msgid "Of course the plant saves the best stuff for himself."
msgstr "Dĩ nhiên cái thực vật đó giữ lại những thứ tốt nhất cho riêng nó rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_SANITY"
msgid "Wrap yourself in the nightmare. Embrace it."
msgstr "Hãy quấn lấy cơn ác mộng. Hãy ôm lấy nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_VOIDCLOTH"
msgid "The fabric really breathes."
msgstr "Bộ vải này thực sự rất thoáng khí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_YOTH_KNIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_YOTH_KNIGHT"
msgid "A rose huh?"
msgstr "Một bông hồng cơ đấy?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "Somehow, it says even less now."
msgstr "Không hiểu sao, giờ trông nó còn vô nghĩa hơn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "\"Thataway\"... Ugh!"
msgstr "\"Lối đó\"... Hừ!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "This requires profundity."
msgstr "Điều này đòi hỏi sự thâm thúy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "Somehow, it says even less now."
msgstr "Không hiểu sao, giờ trông nó còn vô nghĩa hơn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "\"Thataway\"... Ugh!"
msgstr "\"Lối đó\"... Hừ!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "This requires profundity."
msgstr "Điều này đòi hỏi sự thâm thúy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.GENERIC"
msgid "A fine powder that smells of destruction."
msgstr "Một loại bột mịn mang mùi hương của sự hủy diệt."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "Don't worry. There will be more Chesters."
msgstr "Đừng lo. Sẽ còn những con Chester khác."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "There's always another Glommer."
msgstr "Lúc nào mà chẳng có con Glommer khác."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "My trip through the portal made it unrecognizable."
msgstr "Chuyến hành trình qua cổng đã khiến nó trở nên không thể nhận ra."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS"
msgid "We must always eat our vegetables."
msgstr "Chúng ta phải luôn ăn rau của mình."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUSSOUP"
msgid "I suppose you can make soup from anything."
msgstr "Ta cho rằng ngươi có thể nấu súp từ bất cứ thứ gì."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS_COOKED"
msgid "Smells terrible."
msgstr "Ngửi kinh khủng thật."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS_OVERSIZED"
msgid "What am I supposed to do with all this asparagus?"
msgstr "Ta phải làm gì với đống Măng Tây này đây?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS_SEEDS"
msgid "Such labor is beneath me."
msgstr "Lao động chân tay như thế này không xứng với tầm vóc của ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "It is feeding off the dark energy."
msgstr "Nó đang hút năng lượng hắc ám."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "Best not to overuse this power."
msgstr "Tốt nhất không nên lạm dụng sức mạnh này."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "Now we've gone and done it."
msgstr "Giờ thì chúng ta đã làm một vố quá tay rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.OFF"
msgid "It lacks a key."
msgstr "Nó thiếu một chìa khóa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.ON"
msgid "This is a most wretched idea."
msgstr "Đây quả là một ý tưởng tồi tệ nhất."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_KEY"
msgid "It's strange to see it."
msgstr "Thật kỳ lạ khi nhìn thấy nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "No fuel, no power."
msgstr "Không nhiên liệu, không năng lượng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "It feeds off the nightmare."
msgstr "Nó ăn vào cơn ác mộng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "I can't believe I've forgotten how to read this."
msgstr "Ta không thể tin là mình lại quên cách đọc thứ này."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "A picture of the city, before the fuel."
msgstr "Một bức tranh về thành phố, trước thời kỳ có nhiên liệu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "We all know what happens next."
msgstr "Tất cả chúng ta đều biết chuyện gì xảy ra tiếp theo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "They gained such an enviable power..."
msgstr "Họ đã đạt được một thứ sức mạnh đáng ghen tị biết bao..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "I know why you led me back here."
msgstr "Ta biết tại sao ngươi dẫn ta quay lại đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "But it won't work."
msgstr "Nhưng nó sẽ không có tác dụng đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_STATUE"
msgid "There's a dreamlike quality to the material."
msgstr "Chất liệu này mang một vẻ đẹp ảo ảnh."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.AXE"
msgid "Sometimes the direct approach is best."
msgstr "Đôi khi cách tiếp cận trực diện là tốt nhất."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "They're even ugly as infants."
msgstr "Lũ chúng trông vẫn thật xấu xí ngay cả khi còn nhỏ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "Seems we've a few hours of reprieve."
msgstr "Xem ra chúng ta được nghỉ ngơi vài tiếng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BACKPACK"
msgid "I wish there were porters around here."
msgstr "Ước gì quanh đây có phu khuân vác."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BACONEGGS"
msgid "Now that is a proper breakfast."
msgstr "Đấy mới là một bữa sáng ra trò chứ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALATRO_MACHINE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALATRO_MACHINE"
msgid "The game is rigged! But I'll play again to be sure."
msgstr "Trò chơi bịp bợm! Nhưng ta sẽ chơi lại để cho chắc chắn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOON"
msgid "This seems out of place here. Too cheery."
msgstr "Thứ này có vẻ không hợp hoàn cảnh cho lắm. Quá mức vui vẻ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONHAT"
msgid "Would I really stoop so low as to wear such a thing?"
msgstr "Liệu ta có thực sự hạ mình đến mức đội một thứ như thế này không?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONPARTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONPARTY"
msgid "Oh no... he's managed to make them even more cheerful."
msgstr "Ồ không... hắn lại làm chúng trông vui vẻ hơn nữa rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONSPEED.DEFLATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONSPEED.DEFLATED"
msgid "Its power is spent. Now it's just garishly cheery."
msgstr "Sức mạnh của nó đã cạn kiệt. Giờ nó chỉ là một thứ lòe loẹt vui vẻ thôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONSPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONSPEED.GENERIC"
msgid "The mime's power unsettles me."
msgstr "Sức mạnh của tên kịch câm khiến ta thấy bất an."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONS_EMPTY"
msgid "Those look much too jovial for my liking."
msgstr "Mấy thứ đó trông quá ư là vui vẻ so với sở thích của ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONVEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONVEST"
msgid "I think I'd rather drown."
msgstr "Ta thà chết đuối còn hơn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANANABUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANANABUSH"
msgid "Bananas that don't grow in caves? Preposterous."
msgstr "Chuối mà lại không mọc trong hang á? Thật vô lý."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANANAJUICE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANANAJUICE"
msgid "It doesn't do much for my refined palate."
msgstr "Nó chẳng hợp với khẩu vị tinh tế của ta cho lắm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANANAPOP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANANAPOP"
msgid "Hm... I don't know what I was expecting."
msgstr "Hừm... Ta không biết mình đang mong đợi điều gì nữa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANDAGE"
msgid "Sticky and gooey and good for putting on booboos."
msgstr "Dính dớp, nhão nhoét và rất tốt để dán lên mấy vết trầy xước."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANDAGE_BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANDAGE_BUTTERFLYWINGS"
msgid "Ew."
msgstr "Kinh tởm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLE"
msgid "I wish they were oysters."
msgstr "Ước gì chúng là hàu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLEPITA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLEPITA"
msgid "I suppose I'll eat it if there's nothing else."
msgstr "Ta đoán mình sẽ ăn nó nếu không còn gì khác."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLESTUFFEDFISHHEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLESTUFFEDFISHHEAD"
msgid "I suppose anything is \"food\" now."
msgstr "Ta cho rằng bây giờ cái gì cũng là \"thức ăn\" cả."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLESUSHI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLESUSHI"
msgid "At least it's an attempt at sophistication."
msgstr "Ít ra nó cũng là một nỗ lực tỏ ra tinh tế."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLE_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLE_COOKED"
msgid "It's an acquired taste."
msgstr "Đó là một hương vị cần phải tập quen dần."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLINGUINE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLINGUINE"
msgid "It's surprisingly delicious."
msgstr "Nó ngon một cách đáng ngạc nhiên."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BASALT"
msgid "I made a rock so heavy that even I can't lift it."
msgstr "Ta đã tạo ra một hòn đá tảng nặng đến mức chính ta cũng không nhấc lên nổi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BAT"
msgid "Ugh. Ugly beasts."
msgstr "Hừm. Bọn quái vật xấu xí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATBAT"
msgid "Violence has never felt better."
msgstr "Bạo lực chưa bao giờ mang lại cảm giác tuyệt vời đến thế."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATCAVE"
msgid "Ugh. It stinks."
msgstr "Hừm. Hôi quá."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATHBOMB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATHBOMB"
msgid "It smells quite nice, if I'm honest."
msgstr "Thành thật mà nói, nó thơm phết."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATNOSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATNOSE"
msgid "It smells."
msgstr "Nó có mùi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATNOSEHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATNOSEHAT"
msgid "Do I have no dignity left?"
msgstr "Chẳng lẽ ta không còn chút phẩm giá nào sao?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATNOSE_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATNOSE_COOKED"
msgid "The things I must do to survive..."
msgstr "Những gì ta phải làm để sinh tồn..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_CONTAINER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_CONTAINER"
msgid "As good a place as any to stash sheet music away."
msgstr "Cũng là một nơi tuyệt vời để cất giấu bản nhạc."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_DURABILITY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_DURABILITY"
msgid "No. I do NOT sing."
msgstr "Không. Ta KHÔNG hát."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_FIRERESISTANCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_FIRERESISTANCE"
msgid "No. I do NOT sing."
msgstr "Không. Ta KHÔNG hát."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_HEALTHGAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_HEALTHGAIN"
msgid "No. I do NOT sing."
msgstr "Không. Ta KHÔNG hát."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_INSTANT_PANIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_INSTANT_PANIC"
msgid "My acts were always a bit more improvisational."
msgstr "Các màn biểu diễn của ta luôn mang tính ứng biến nhiều hơn một chút."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_INSTANT_REVIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_INSTANT_REVIVE"
msgid "No. I do NOT sing."
msgstr "Không. Ta KHÔNG hát."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_INSTANT_TAUNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_INSTANT_TAUNT"
msgid "My acts were always a bit more improvisational."
msgstr "Các màn biểu diễn của ta luôn mang tính ứng biến nhiều hơn một chút."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_LUNARALIGNED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_LUNARALIGNED"
msgid "No. I do NOT sing."
msgstr "Không. Ta KHÔNG hát."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_SANITYAURA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_SANITYAURA"
msgid "No. I do NOT sing."
msgstr "Không. Ta KHÔNG hát."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_SANITYGAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_SANITYGAIN"
msgid "No. I do NOT sing."
msgstr "Không. Ta KHÔNG hát."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_SHADOWALIGNED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_SHADOWALIGNED"
msgid "No. I do NOT sing."
msgstr "Không. Ta KHÔNG hát."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATWING"
msgid "I'm not eating that."
msgstr "Ta không ăn thứ đó đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATWING_COOKED"
msgid "I'm still not eating that."
msgstr "Ta vẫn sẽ không ăn thứ đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARDHAIR"
msgid "Hirsute."
msgstr "Lắm lông thật."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGER"
msgid "Take whatever you want."
msgstr "Lấy bất cứ thứ gì ngươi muốn đi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERCORPSE.BURNING"
msgid "That's one problem solved."
msgstr "Đã giải quyết được một rắc rối."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERCORPSE.GENERIC"
msgid "Ugh. I can't just leave that lying around."
msgstr "Hừm. Ta không thể cứ để mặc nó nằm ở đó được."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERCORPSE.REVIVING"
msgid "The \"moon's\" influence is growing..."
msgstr "Ảnh hưởng của \"mặt trăng\" đang lớn dần..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERFUR_SACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERFUR_SACK"
msgid "Portable indeed. Wilson can carry it."
msgstr "Đúng là rất tiện lợi. Cứ để Wilson mang nó đi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERVEST"
msgid "See my vest."
msgstr "Hãy ngắm chiếc áo của ta này."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGER_FUR"
msgid "This would make a nice rug."
msgstr "Thứ này làm thảm thì đẹp phải biết."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEAST_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEAST_BLUEPRINT"
msgid "I'd say luck is in rather short supply around here."
msgstr "Ta có thể nói là vận may ở quanh đây đang khá khan hiếm đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEDROLL_FURRY"
msgid "At least they're good for something."
msgstr "Ít ra chúng cũng dùng được việc gì đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEDROLL_STRAW"
msgid "I don't like sleeping rough."
msgstr "Ta không thích ngủ ngoài trời thế này chút nào."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEE.GENERIC"
msgid "They work so hard, the fools."
msgstr "Chúng làm việc thật chăm chỉ, lũ ngốc ạ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEE.HELD"
msgid "Now what do I do with it?"
msgstr "Giờ thì ta phải làm gì với nó đây?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.BURNT"
msgid "Honey roasted."
msgstr "Mật ong quay mật."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.FULLHONEY"
msgid "So tempting, but so full of bees."
msgstr "Hấp dẫn thật đấy, nhưng lại đầy rẫy ong."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.GENERIC"
msgid "It holds the bees."
msgstr "Nó chứa đám ong."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.NOHONEY"
msgid "Why do the bees not serve me?"
msgstr "Tại sao lũ ong không phục tùng ta?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.READY"
msgid "So tempting, but so full of bees."
msgstr "Hấp dẫn thật đấy, nhưng lại đầy rẫy ong."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "I should wait a bit longer."
msgstr "Ta nên đợi thêm chút nữa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.BURNT"
msgid "Honey roasted."
msgstr "Mật ong quay mật."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.FULLHONEY"
msgid "I've done enough, the old woman can brave the bees herself."
msgstr "Ta đã làm đủ việc rồi, mụ già đó có thể tự mình đối phó với lũ ong."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.GENERIC"
msgid "I think she made this herself."
msgstr "Ta nghĩ tự tay mụ ta đã làm cái này."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "Why do the bees not serve me?"
msgstr "Tại sao lũ ong không phục tùng ta?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "I've done enough, the old woman can brave the bees herself."
msgstr "Ta đã làm đủ việc rồi, mụ già đó có thể tự mình đối phó với lũ ong."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "I should wait a bit longer."
msgstr "Ta nên đợi thêm chút nữa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.DEAD"
msgid "They smell even worse when they're dead."
msgstr "Lúc chết chúng còn bốc mùi hơn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.DEAD_MYPARTNER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.DEAD_MYPARTNER"
msgid "How dare you die on me!"
msgstr "Sao ngươi dám chết trước ta chứ!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "I like a creature that knows its place."
msgstr "Ta thích một sinh vật biết điều."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.FOLLOWER"
msgid "Aw nuts, it's following me."
msgstr "Khỉ thật, nó đang bám theo ta kìa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.GENERIC"
msgid "Just look at that stupid beast."
msgstr "Cứ nhìn con quái vật ngốc nghếch đó mà xem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.MYPARTNER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.MYPARTNER"
msgid "I suppose I'm saddled with this creature now."
msgstr "Ta đoán là mình đành phải còng lưng với con sinh vật này rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.NAKED"
msgid "Now it looks dumb AND pathetic."
msgstr "Giờ thì nó vừa ngốc vừa thảm hại."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.ORNERY"
msgid "Yes, you understand how this works."
msgstr "Đúng thế, ngươi hiểu cách hoạt động của chuyện này rồi đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.PUDGY"
msgid "I suppose some people might find that charming."
msgstr "Ta đoán vài người sẽ thấy thế là đáng yêu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.RIDER"
msgid "I'd only ride you if I was desperate."
msgstr "Ta chỉ cưỡi ngươi khi nào cùng đường thôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.SLEEPING"
msgid "It's only marginally less stupid when it's asleep."
msgstr "Lúc ngủ trông nó cũng chỉ bớt đần đi một chút thôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOFEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOFEED"
msgid "I suppose I'd better keep the stupid beast fed."
msgstr "Ta đoán tốt nhất là nên cho con vật ngốc nghếch này ăn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOHAT"
msgid "How unfashionable."
msgstr "Trông lỗi mốt làm sao."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOTREAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOTREAT"
msgid "Best to keep the beast placated for now."
msgstr "Tốt nhất là nên dỗ dành con vật này lúc này."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOWOOL"
msgid "It smells like a barn."
msgstr "Nó có mùi như cái chuồng gia súc."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER.BURNT"
msgid "What a shame."
msgstr "Thật đáng tiếc."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER.GENERIC"
msgid "How ridiculous."
msgstr "Thật là lố bịch."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER.OCCUPIED"
msgid "I suppose I'll have to try to make this creature less homely."
msgstr "Ta đoán mình sẽ phải tìm cách làm cho con sinh vật này đỡ quê mùa hơn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER_ITEM"
msgid "Do I look like a common construction worker? Oh very well..."
msgstr "Ta trông giống một công nhân xây dựng bình thường lắm à? Thôi được rồi..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEF_BELL"
msgid "It appears to have some kind of hypnotic effect on beefalo."
msgstr "Nó có vẻ tạo ra một số loại hiệu ứng thôi miên đối với Bò Lai."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEGUARD"
msgid "Keep your backside to yourself, madam!"
msgstr "Lo cái mông của cô đi, thưa bà!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEHAT"
msgid "I'll wear it if I have to."
msgstr "Ta sẽ đội nó nếu bắt buộc phải làm vậy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEHIVE"
msgid "Not the bees!"
msgstr "Đừng là lũ ong!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEMINE"
msgid "They wait so patiently."
msgstr "Chúng chờ đợi thật kiên nhẫn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEMINE_MAXWELL"
msgid "Maybe I shouldn't have put that there."
msgstr "Có lẽ ta không nên đặt thứ đó ở đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEEN"
msgid "I didn't make that one! Really!"
msgstr "Không phải ta làm con đó đâu! Thật đấy!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "I am not getting that on my shoes."
msgstr "Ta không để thứ đó dính vào giày của mình đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "Now what are those bees up to?"
msgstr "Giờ lũ ong đó đang giở trò gì thế nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "I don't see what all the buzz is about."
msgstr "Ta chẳng hiểu có gì mà phải rùm beng lên thế."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEESWAX"
msgid "I miss sealing a good letter."
msgstr "Ta nhớ cảm giác niêm phong một bức thư tay."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEESWAX_SPRAY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEESWAX_SPRAY"
msgid "I'm picking up notes of terror, with a hint of dread."
msgstr "Ta ngửi thấy chút vị của sự khủng hoảng, thoang thoảng nỗi sợ hãi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEETLETAUR"
msgid "Back to the dungeons with you!"
msgstr "Cút về ngục tối của ngươi đi!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BELL"
msgid "More bell."
msgstr "Lại thêm chuông."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_ACTIVE"
msgid "Just what am I looking at here?"
msgstr "Chính xác là ta đang nhìn cái quái gì thế này?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_BIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_BIG"
msgid "How truly unnerving."
msgstr "Thật là lạnh sống lưng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "It's seen better days."
msgstr "Nó đã qua thời hoàng kim rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "It makes me a little nostalgic."
msgstr "Nó khiến ta thấy hơi hoài niệm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES"
msgid "Sigh. If I have to."
msgstr "Haizz. Nếu buộc phải làm thế."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_COOKED"
msgid "A little more refined, at least."
msgstr "Ít nhất thì cũng tao nhã hơn một chút."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_JUICY"
msgid "Delightfully sweet with a subtle hint of tartness."
msgstr "Ngọt ngào dễ chịu với một chút vị chua nhẹ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "They're quite delicious, actually."
msgstr "Thực ra chúng rất ngon."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.BARREN"
msgid "It needs manure."
msgstr "Nó cần phân bón."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.BURNING"
msgid "It better not start talking to me."
msgstr "Tốt nhất là nó đừng bắt đầu nói chuyện với ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.DISEASED"
msgid "What has brought this blight upon my world?"
msgstr "Thứ gì đã mang căn bệnh héo úa này đến thế giới của ta vậy?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.DISEASING"
msgid "Looks a little off, if you ask me."
msgstr "Trông hơi bất thường nếu ngươi hỏi ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.GENERIC"
msgid "Reduced to eating berries. Sigh."
msgstr "Bị đẩy đến mức phải ăn Dâu Rừng. Haizz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.PICKED"
msgid "And now we wait."
msgstr "Và giờ chúng ta chờ đợi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.WITHERED"
msgid "Too hot for that little bush."
msgstr "Quá nóng cho cái bụi cây nhỏ đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "It looks to be in need of assistance. Fertilizer, perhaps?"
msgstr "Có vẻ nó đang cần được giúp đỡ. Chắc là Phân bón nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "It better not start talking to me."
msgstr "Tốt nhất là nó đừng bắt đầu nói chuyện với ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "What has brought this blight upon my world?"
msgstr "Thứ gì đã mang căn bệnh héo úa này đến thế giới của ta vậy?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "Looks a little off, if you ask me."
msgstr "Trông hơi bất thường nếu ngươi hỏi ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "The berries will stay fresh as long as I leave them there."
msgstr "Lũ Dâu Rừng sẽ vẫn tươi ngon chừng nào ta còn để chúng ở đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "I fear I'll have to wait."
msgstr "Ta e rằng mình sẽ phải chờ đợi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "I know the feeling."
msgstr "Ta hiểu cảm giác đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYSAUCE"
msgid "This seems like a lot of fuss for some mashed berries."
msgstr "Chỉ vì vài quả Dâu Rừng nghiền mà làm quá lên thế nhỉ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIBINGKA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIBINGKA"
msgid "It has a unique spongy texture."
msgstr "Nó có kết cấu xốp độc đáo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIGFOOT"
msgid "Now that is surely fuel for nightmares."
msgstr "Đúng là chất liệu để làm ác mộng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRCHNUTDRAKE"
msgid "A nut with legs! How terrifying!"
msgstr "Một hạt dẻ có chân! Thật đáng sợ làm sao!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.DEAD"
msgid "That's a deep sleep."
msgstr "Đó là một giấc ngủ ngàn thu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.GENERIC"
msgid "You'll never get me behind bars again."
msgstr "Ngươi sẽ không bao giờ bắt ta phải quay lại sau song sắt nữa đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "What's all the fuss about, feathers?"
msgstr "Làm gì mà sồn sồn lên thế, cục bông?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "I feel for ya, feathers."
msgstr "Ta hiểu cho ngươi đấy, cục bông ạ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.SKELETON"
msgid "Maybe he wasn't sleeping."
msgstr "Có lẽ nó không đang ngủ đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "You'll still be in there when you wake up."
msgstr "Ngươi vẫn sẽ ở trong đó khi tỉnh dậy thôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.STARVING"
msgid "Oh, come on. I fed you last week."
msgstr "Ôi thôi nào. Ta vừa cho ngươi ăn tuần trước mà."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCORPSE.BURNING"
msgid "Good riddance."
msgstr "Đáng đời lắm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCORPSE.GENERIC"
msgid "Yuck."
msgstr "Eo ôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCORPSE.REVIVING"
msgid "Absolutely grotesque."
msgstr "Quả là kỳ dị."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDTRAP"
msgid "They keep falling for it!"
msgstr "Chúng cứ liên tục sập bẫy!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_EGG"
msgid "I like to think of it as baby bird prison."
msgstr "Ta thích coi nó là nhà tù dành cho chim non."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_EGG_COOKED"
msgid "Sunny side up."
msgstr "Trứng ốp la."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_MUTANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_MUTANT"
msgid "That creature has seen better days."
msgstr "Sinh vật đó đã qua thời hoàng kim rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_MUTANT_SPITTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_MUTANT_SPITTER"
msgid "You dare spit at me?!"
msgstr "Ngươi dám nhổ nước bọt vào ta ư?!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP"
msgid "I'm especially proud of that piece."
msgstr "Ta đặc biệt tự hào về quân cờ đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "How DARE you!"
msgstr "Ngươi DÁM lắm!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP_NIGHTMARE"
msgid "They degrade without proper upkeep."
msgstr "Chúng sẽ xuống cấp nếu không được bảo dưỡng đúng cách."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLACKFLAG"
msgid "Black never goes out of style."
msgstr "Màu đen không bao giờ lỗi mốt."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_FIRE"
msgid "Just make sure to breathe out."
msgstr "Chỉ cần nhớ thở ra là được."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_LAVA"
msgid "That is not my style."
msgstr "Đó không phải phong cách của ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_LAVA2"
msgid "I'm no blowhard."
msgstr "Ta không phải kẻ ba hoa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_PIPE"
msgid "A glorious tube of pain!"
msgstr "Một ống phóng nỗi đau huy hoàng!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_SLEEP"
msgid "Call me \"Mr. Sandman\"."
msgstr "Cứ gọi ta là \"Ông Bụt Ngủ\"."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_YELLOW"
msgid "Never strikes the same place twice, except when it does."
msgstr "Không bao giờ đánh cùng một chỗ hai lần, trừ những lúc ngoại lệ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEAMULET"
msgid "It's frosted over."
msgstr "Nó bị đóng băng rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEGEM"
msgid "Blue brings ice."
msgstr "Màu xanh mang lại băng đá."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEMOONEYE"
msgid "That reminds me, I must practice my cold glare tonight!"
msgstr "Nhắc mới nhớ, tối nay ta phải luyện tập ánh mắt sắc lạnh mới được!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.COMMON"
msgid "I know all about that. I... just forgot."
msgstr "Ta biết hết về cái đó. Ta chỉ... quên mất thôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.RARE"
msgid "A rare blueprint, indeed."
msgstr "Đúng là một bản thiết kế hiếm có."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP"
msgid "What could go wrong?"
msgstr "Chuyện tồi tệ nhất có thể xảy ra là gì chứ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP_COOKED"
msgid "Umami!"
msgstr "Vị umami!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "The blue ones are good for, uh, something."
msgstr "Mấy cây màu xanh tốt cho việc... ừm, gì đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "It's not ready."
msgstr "Nó chưa sẵn sàng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Another time, maybe?"
msgstr "Hẹn dịp khác nhé?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARDS"
msgid "Roughly hewn."
msgstr "Được đẽo thô sơ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARON"
msgid "Begone, swine."
msgstr "Biến đi, lũ lợn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARRIOR"
msgid "Well he's certainly no slouch."
msgstr "Chà, hắn rõ ràng không phải dạng vừa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT03"
msgid "Merely smithereens."
msgstr "Chỉ là những mảnh vụn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT04"
msgid "Merely smithereens."
msgstr "Chỉ là những mảnh vụn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT05"
msgid "Merely smithereens."
msgstr "Chỉ là những mảnh vụn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATPATCH"
msgid "I detest such work."
msgstr "Ta ghét cái công việc này làm sao."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATPATCH_KELP"
msgid "That won't keep the water at bay for long."
msgstr "Thứ đó sẽ không ngăn được nước lâu đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "Are we there yet?"
msgstr "Đã đến nơi chưa thế?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "Whatever."
msgstr "Sao cũng được."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "Are you supposed to be intimidating?"
msgstr "Ngươi nghĩ mình đáng sợ lắm hả?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK"
msgid "Out of my way!"
msgstr "Tránh đường ra!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Hm. Someone's feeling prickly."
msgstr "Hừm. Ai đó đang cảm thấy khó chịu kìa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "A waypoint. Or perhaps a well-timed obstacle..."
msgstr "Một điểm mốc. Hoặc có lẽ là một chướng ngại vật đúng thời điểm..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "A waypoint. Or perhaps a well-timed obstacle..."
msgstr "Một điểm mốc. Hoặc có lẽ là một chướng ngại vật đúng thời điểm..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "Enjoying the show, pal?"
msgstr "Xem biểu diễn vui không bạn hiền?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_START"
msgid "Can I just wait here for everyone to be done?"
msgstr "Ta có thể đứng đây chờ mọi người xong việc được không?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "Wherever."
msgstr "Sao cũng được."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "Now those apes won't get their grubby hands on my loot."
msgstr "Giờ thì đám khỉ đó sẽ không chạm tay vào chiến lợi phẩm của ta được nữa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "It's not old, it's \"classic.\""
msgstr "Nó không phải đồ cũ, nó là \"cổ điển\"."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_CRABKING"
msgid "Looks heavy enough to sink us."
msgstr "Trông có vẻ đủ nặng để làm chìm chúng ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_CRABKING_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_CRABKING_KIT"
msgid "Ugh. These menial tasks do not suit me."
msgstr "Hừm. Những việc vặt vãnh này không hợp với ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_KELP"
msgid "I don't know if the smell is worth the protection it offers."
msgstr "Ta không biết cái mùi đó có đáng để đổi lấy sự bảo vệ này không."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "Ugh. These menial tasks do not suit me."
msgstr "Hừm. Những việc vặt vãnh này không hợp với ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "Seashells. The sturdiest building material known to man."
msgstr "Vỏ sò. Vật liệu xây dựng vững chắc nhất được nhân loại biết đến."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "Ugh. These menial tasks do not suit me."
msgstr "Hừm. Những việc vặt vãnh này không hợp với ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "I always thought boats could use more teeth."
msgstr "Ta luôn nghĩ thuyền ván nên có nhiều răng hơn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "Ugh. These menial tasks do not suit me."
msgstr "Hừm. Những việc vặt vãnh này không hợp với ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "Don't test me."
msgstr "Đừng thử thách ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "It's useless if it isn't loaded."
msgstr "Nó vô tích sự nếu không được nạp đạn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "Tragically, I can't just summon cannonballs out of thin air."
msgstr "Thật bi đát, ta không thể tự triệu hồi đạn đại bác từ hư không được."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON_KIT"
msgid "Fine. I suppose the task of building it is left to me."
msgstr "Được rồi. Ta đoán nhiệm vụ xây dựng nó lại đè lên đầu ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_GRASS_ITEM"
msgid "Am I building a boat or weaving a basket?"
msgstr "Ta đang đóng thuyền ván hay đang đan giỏ thế này?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ITEM"
msgid "I've been reduced to a common shipyard laborer."
msgstr "Ta đã bị giáng xuống làm một kẻ lao động xưởng tàu bình thường."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_LEAK"
msgid "Oh, great. Now we're going to drown."
msgstr "Ồ tuyệt. Giờ thì chúng ta sắp chết đuối rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "Shockingly, it seems to work."
msgstr "Đáng ngạc nhiên là nó có vẻ hoạt động."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "If it saves me from having to row myself, I'll give it a chance."
msgstr "Nếu nó giúp ta không phải tự chèo thuyền, ta sẽ cho nó một cơ hội."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "Somehow, it's working."
msgstr "Không hiểu sao, nó đang hoạt động kìa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "This feels ridiculous."
msgstr "Việc này thật nực cười."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET_KIT"
msgid "Blast it Higgsbury, I can barely read these scribbled instructions."
msgstr "Khỉ thật Higgsbury, ta hầu như không đọc nổi mấy hướng dẫn nguệch ngoạc này."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ROTATOR"
msgid "If I hear one word of complaint, I'm turning this boat around."
msgstr "Nếu ta nghe thấy một lời phàn nàn nào nữa, ta sẽ quay thuyền ván lại đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "Do I look like a common shipwright? Oh, very well..."
msgstr "Ta trông giống một thợ đóng tàu bình thường lắm à? Thôi được rồi..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "What is the thread count on this?"
msgstr "Số lượng sợi trên cái này là bao nhiêu thế?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_KELP"
msgid "Looking at it is making me seasick."
msgstr "Nhìn nó là ta thấy say sóng rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_PETALS"
msgid "Can you rightfully call a sack of potpourri a pillow?"
msgstr "Liệu ngươi có thể gọi một túi thảo mộc thơm là gối được không?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "It will either protect me or cut me to ribbons."
msgstr "Nó sẽ bảo vệ ta hoặc cắt ta ra thành từng mảnh."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOMB_LUNARPLANT"
msgid "Someone's about to have a very bad day."
msgstr "Sắp có kẻ gặp một ngày vô cùng tồi tệ rồi đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "Its power has been amplified..."
msgstr "Sức mạnh của nó đã được khuếch đại..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESHARD"
msgid "Grind them bones."
msgstr "Nghiền nát đống xương đó đi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESOUP"
msgid "It's hearty and filling."
msgstr "Nó rất thịnh soạn và đầy đặn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESTEW"
msgid "Leave no scrap unused."
msgstr "Không bỏ sót một mảnh Sắt Vụn nào."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOKSTATION.BURNT"
msgid "History repeats itself."
msgstr "Lịch sử lại lặp lại."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOKSTATION.GENERIC"
msgid "Rebuilding her library, is she?"
msgstr "Đang xây dựng lại thư viện của cô ta đấy à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BEES"
msgid "Perhaps now the bees will serve me."
msgstr "Có lẽ giờ lũ ong sẽ phục tùng ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BIRDS"
msgid "What a wasteful misuse of magic."
msgstr "Thật là một sự lãng phí phép thuật vô nghĩa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BRIMSTONE"
msgid "I've had enough fire and brimstone for one eternity."
msgstr "Ta đã nếm đủ lửa và diêm sinh cho cả một cõi vĩnh hằng rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_ELEMENTAL"
msgid "The words within evoke an unknown force."
msgstr "Những từ ngữ bên trong gợi lên một sức mạnh không rõ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_FIRE"
msgid "Ah. Based on the librarian's own observations, I take it?"
msgstr "À. Dựa trên những quan sát của chính nữ thủ thư phải không?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_FISH"
msgid "I suppose I'll eat for a lifetime, then? Somehow I doubt it."
msgstr "Ta đoán mình sẽ được ăn suốt đời sao? Có vẻ nghi ngờ đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_FOSSIL"
msgid "I could stop a fiend in its tracks with this."
msgstr "Ta có thể chặn đứng một tên ác ma ngay trong đường tơ kẽ tóc với thứ này."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_GARDENING"
msgid "It's not wise to toy with forces beyond your comprehension."
msgstr "Đùa giỡn với những thế lực vượt quá tầm hiểu biết là không khôn ngoan đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_HORTICULTURE"
msgid "Hopefully this version is less wordy."
msgstr "Hy vọng phiên bản này ít chữ hơn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "Hopefully this will mean less time relegated to the garden."
msgstr "Hy vọng điều này sẽ đồng nghĩa với việc ít phải ra vườn hơn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_LIGHT"
msgid "Taking some inspiration from the Codex, are we? I'm flattered."
msgstr "Lấy cảm hứng từ Codex Umbra hả? Ta thấy rất vinh hạnh đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "Now she's just showing off."
msgstr "Giờ thì cô ta đang làm màu đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_MOON"
msgid "We've come this far, no point in stopping our meddling now."
msgstr "Chúng ta đã đi đến bước này rồi, chẳng có lý do gì để dừng việc nhúng tay vào nữa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_RAIN"
msgid "What's a ritual without a little showmanship? Surely a prop or two?"
msgstr "Nghi lễ gì mà lại không có chút biểu diễn phô trương nào thế? Ít ra cũng phải có một đạo cụ chứ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "Hmph. It doesn't hold a candle to the secret knowledge I possess."
msgstr "Hừm. Chẳng thấm vào đâu so với kho tàng tri thức bí mật mà ta đang sở hữu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_SILVICULTURE"
msgid "It's not wise to toy with forces beyond your comprehension."
msgstr "Đùa giỡn với những thế lực vượt quá tầm hiểu biết là không khôn ngoan đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_SLEEP"
msgid "I haven't had a real sleep in... ages."
msgstr "Ta đã không có một giấc ngủ thực sự từ... rất lâu rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_TEMPERATURE"
msgid "I'm always cool and collected."
msgstr "Ta luôn điềm tĩnh và bình thản."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_TENTACLES"
msgid "What horrors shall be summoned from the depths?"
msgstr "Những sự kinh hoàng nào sẽ được triệu hồi từ đáy sâu?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_WEB"
msgid "As if spiders are what you should be worried about here."
msgstr "Cứ như thể nhện là thứ ngươi nên lo lắng ở đây vậy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOMERANG"
msgid "Beats getting your hands dirty."
msgstr "Đỡ hơn việc phải nhúng tay vào vũng bùn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOTLEG"
msgid "Best not to think about where it's been."
msgstr "Tốt nhất không nên nghĩ xem nó đã qua tay những ai."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BROKEN_FORGEDITEM"
msgid "It's of no use to me like this."
msgstr "Nó chẳng có tích sự gì với ta ở dạng này cả."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BROKEN_FUMAROLETOOLITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BROKEN_FUMAROLETOOLITEM"
msgid "Some heat should restore it."
msgstr "Chút sức nóng có lẽ sẽ khôi phục lại nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BRUSH"
msgid "It's like showing affection, without actually touching it."
msgstr "Giống như việc thể hiện tình cảm mà không cần thực sự chạm vào vậy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUGNET"
msgid "Good for capturing defenseless insects."
msgstr "Rất tốt để bắt những côn trùng không có khả năng tự vệ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "Disgusting. I'll have someone else pick it."
msgstr "Ghê tởm thật. Ta sẽ bảo kẻ khác hái nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "We already took the food parts."
msgstr "Chúng ta đã lấy đi phần ăn được rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_ROOT"
msgid "For keeping the peasantry in line."
msgstr "Dùng để trị lũ dân đen."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNDLE"
msgid "Nice and snug."
msgstr "Gọn gàng và ấm áp."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNDLEWRAP"
msgid "I guess we could wrap a few things up."
msgstr "Ta đoán chúng ta có thể gói ghém vài thứ lại."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNNYMAN"
msgid "It reminds me of my old act."
msgstr "Nó làm ta nhớ đến vở diễn cũ của mình."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNNYSTEW"
msgid "Good until the last hop."
msgstr "Ngon cho đến cú nhảy cuối cùng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BURNT_MARSH_BUSH"
msgid "Utterly destroyed."
msgstr "Bị phá hủy hoàn toàn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUSHHAT"
msgid "There's room in there for me."
msgstr "Vẫn còn chỗ cho ta trong đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTER"
msgid "Some puns are irresistible."
msgstr "Vài trò chơi chữ thật khó mà cưỡng lại."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLY.GENERIC"
msgid "It's a flying flower."
msgstr "Đó là một bông hoa biết bay."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLY.HELD"
msgid "It would be a shame if someone ripped the wings off of it."
msgstr "Thật đáng tiếc nếu có ai đó giật đứt cánh của nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLYMUFFIN"
msgid "That should stop its incessant flapping."
msgstr "Thế là đủ để dừng cái tiếng vỗ cánh inh ỏi đó lại."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLYWINGS"
msgid "Ha ha ha. I got him!"
msgstr "Ha ha ha. Ta bắt được nó rồi!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUZZARD"
msgid "Carrion connoisseur."
msgstr "Kẻ sành sỏi tử thi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUZZARDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUZZARDCORPSE.BURNING"
msgid "Good riddance."
msgstr "Đỡ bận mắt."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUZZARDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUZZARDCORPSE.GENERIC"
msgid "Yuck."
msgstr "Ghê quá."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUZZARDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUZZARDCORPSE.REVIVING"
msgid "Absolutely grotesque."
msgstr "Hoàn toàn dị hợm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CABBAGEROLLS"
msgid "Meat rolled in cabbage. How exciting."
msgstr "Thịt cuốn trong lá bắp cải. Thật là hào hứng làm sao."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS.GENERIC"
msgid "Puffer plant."
msgstr "Thực vật phồng rộp."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS.PICKED"
msgid "Cactus? More like flat-tus!"
msgstr "Xương rồng á? Cứ như bánh kếp xương rồng ấy!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_FLOWER"
msgid "This part of the cactus is always nice."
msgstr "Phần này của cây xương rồng lúc nào cũng ổn cả."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_MEAT"
msgid "It would be unwise to put that in my mouth."
msgstr "Đưa thứ đó vào miệng chắc chắn không khôn ngoan chút nào."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "Cactus comestible."
msgstr "Món xương rồng ăn được."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CALIFORNIAROLL"
msgid "I don't think I truly appreciated those sunny shores."
msgstr "Ta không nghĩ mình thực sự đánh giá cao những bờ biển đầy nắng đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.EMBERS"
msgid "I'm going to lose it."
msgstr "Ta sắp phát điên rồi đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.GENERIC"
msgid "How comforting."
msgstr "Thật dễ chịu làm sao."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.HIGH"
msgid "That will keep Charlie away for now."
msgstr "Thế này thì tạm thời giữ chân Charlie được đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.LOW"
msgid "It needs fuel."
msgstr "Nó cần thêm nhiên liệu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.NORMAL"
msgid "Fiery."
msgstr "Rực lửa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.OUT"
msgid "That's not coming back."
msgstr "Thứ đó không quay lại đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY.GENERIC"
msgid "How do these things keep getting into my world?"
msgstr "Mấy thứ này cứ chui vào thế giới của ta kiểu gì nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY.HELD"
msgid "Bait."
msgstr "Mồi nhử."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY_POISONED"
msgid "You look atrocious."
msgstr "Trông ngươi khủng khiếp thật đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANDYBAG"
msgid "That's our sugar-sack."
msgstr "Đó là túi đường của chúng ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANE"
msgid "It has pictures of fast things carved into it."
msgstr "Trên đó có khắc hình những thứ chạy nhanh."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANNONBALL_ROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANNONBALL_ROCK_ITEM"
msgid "That looks heavy. Someone should load it into the cannon."
msgstr "Trông nặng thật đấy. Ai đó nên nạp nó vào đại bác đi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALCANNON.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALCANNON.COOLDOWN"
msgid "That's more than enough cheer for one day."
msgstr "Thế là quá đủ vui vẻ cho một ngày rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALCANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALCANNON.GENERIC"
msgid "This place is turning into a circus."
msgstr "Nơi này sắp biến thành gánh xiếc đến nơi rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALCANNON_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALCANNON_KIT"
msgid "Must I do everything around here?"
msgstr "Bộ quanh đây ta phải làm mọi thứ à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_BANNER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_BANNER"
msgid "Oh good. Wouldn't want anyone thinking we've got taste around here, would we?"
msgstr "Ồ tuyệt. Chắc không ai muốn người ta nghĩ quanh đây chúng ta có gu thẩm mỹ đâu nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_BANNER_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_BANNER_KIT"
msgid "There's no end to the work around here, it seems."
msgstr "Xem ra công việc quanh đây chẳng bao giờ là hết."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_EGGRIDE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_EGGRIDE"
msgid "Wonderful. It's even tackier than I imagined it would be."
msgstr "Tuyệt vời. Nó còn sến súa hơn cả tưởng tượng của ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT"
msgid "There's no end to the work around here, it seems."
msgstr "Xem ra công việc quanh đây chẳng bao giờ là hết."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC"
msgid "One more thing to clutter the ground."
msgstr "Thêm một thứ làm vướng víu mặt đất."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE.RARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE.RARE"
msgid "What exactly is so fantastic about it?"
msgstr "Chính xác thì có gì tuyệt vời ở nó chứ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON"
msgid "Measly things. In my time I made proper statues..."
msgstr "Những thứ tồi tàn. Thời của ta thì người ta tạc tượng đàng hoàng cơ..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE_KIT"
msgid "Curiosity always seems to get the better of me."
msgstr "Sự tò mò lúc nào cũng hại chết ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2"
msgid "Curiosity always seems to get the better of me."
msgstr "Sự tò mò lúc nào cũng hại chết ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON3"
msgid "Curiosity always seems to get the better of me."
msgstr "Sự tò mò lúc nào cũng hại chết ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_LAMP"
msgid "A paltry light source. But it will do."
msgstr "Một nguồn sáng nghèo nàn. Nhưng thế là đủ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_LAMP_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_LAMP_KIT"
msgid "There's no end to the work around here, it seems."
msgstr "Xem ra công việc quanh đây chẳng bao giờ là hết."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_PLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_PLANT"
msgid "At least it's small and somewhat manageable."
msgstr "Ít ra nó cũng nhỏ và có thể xoay sở được phần nào."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_PLANT_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_PLANT_KIT"
msgid "There's no end to the work around here, it seems."
msgstr "Xem ra công việc quanh đây chẳng bao giờ là hết."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALFOOD_CORNTEA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALFOOD_CORNTEA"
msgid "Surely you're not serious?"
msgstr "Chắc ngươi không đùa đấy chứ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD"
msgid "These props leave something to be desired."
msgstr "Mấy đạo cụ này vẫn còn nhiều điều để chê trách."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT"
msgid "I suppose I'm expected to set this up myself?"
msgstr "Chắc ta lại phải tự dựng cái này lên à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST"
msgid "What are they hiding down there..."
msgstr "Chúng đang giấu cái gì dưới đó thế..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC"
msgid "It requires payment."
msgstr "Nó cần phải trả phí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING"
msgid "I'll play it, but I won't enjoy it."
msgstr "Ta sẽ chơi, nhưng ta sẽ không thấy vui đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFBALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFBALL"
msgid "So small and obedient. It goes where I direct it."
msgstr "Nhỏ bé và dễ bảo làm sao. Nó đi tới nơi ta hướng dẫn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFCLUB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFCLUB"
msgid "Is this even a regulation putter?"
msgstr "Đây có phải gậy gạt bóng đúng quy chuẩn không đấy?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_DIY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_DIY"
msgid "A course of my own conjuring?"
msgstr "Một sân chơi do chính tay ta tạo ra á?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_EASY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_EASY"
msgid "This course is beneath me."
msgstr "Sân chơi này quá tầm thường đối với ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_HARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_HARD"
msgid "Difficult? Let's see about that."
msgstr "Khó nhằn ư? Để xem thế nào đã."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_MEDIUM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_MEDIUM"
msgid "Should make for a decent round."
msgstr "Chắc sẽ là một vòng chơi ra trò đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFPROP_CUTOUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFPROP_CUTOUT"
msgid "Must you always be in my way?"
msgstr "Ngươi cứ phải đứng cản đường ta mãi à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFPROP_FAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFPROP_FAN"
msgid "Can someone turn off that blasted fan?"
msgstr "Ai đó tắt cái cái quạt chết tiệt kia đi được không?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFPROP_FENCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFPROP_FENCE"
msgid "It reminds lesser players where the world ends."
msgstr "Nó nhắc nhở những người chơi kém cỏi rằng thế giới này có điểm dừng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFPROP_MOVINGWALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFPROP_MOVINGWALL"
msgid "Up or down? Make up your mind!"
msgstr "Lên hay xuống? Quyết định nhanh lên xem nào!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFPROP_SPINNER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFPROP_SPINNER"
msgid "Reminds me of that accursed thing."
msgstr "Làm ta nhớ đến cái thứ chết tiệt đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFPROP_SPRING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFPROP_SPRING"
msgid "It flings the ball skyward, sparing it the indignity of rolling."
msgstr "Nó phóng quả bóng lên tận trời xanh, miễn phải chịu cái cảnh lăn lóc kém sang."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFPROP_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLFPROP_WORMHOLE"
msgid "Careful where you send my ball."
msgstr "Cẩn thận chỗ ngươi ném bóng của ta đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLF_HOLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLF_HOLE"
msgid "Child's play, but I don't feel bad about winning."
msgstr "Trò trẻ con, nhưng thắng thì ta cũng chẳng thấyy áy náy gì đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLF_HOLE_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLF_HOLE_KIT"
msgid "Obviously it belongs at the end."
msgstr "Hiển nhiên là nó nằm ở đoạn cuối rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLF_TEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLF_TEE.GENERIC"
msgid "It costs a whole token?!"
msgstr "Tốn cả một đồng xu cơ á?!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLF_TEE.INACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLF_TEE.INACTIVE"
msgid "Ugh! The course is unfinished!"
msgstr "Hừ! Sân chơi vẫn chưa làm xong mà!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLF_TEE.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLF_TEE.PLAYING"
msgid "It's been paid already!"
msgstr "Nó được trả tiền rồi mà!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLF_TEE_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_GOLF_TEE_KIT"
msgid "It goes at the beginning of course!"
msgstr "Nó phải nằm ở đầu sân chứ lị!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_CHICK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_CHICK"
msgid "Get back here, you blasted contraption!"
msgstr "Quay lại đây ngay, cái máy móc chết tiệt này!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_KIT"
msgid "I suppose I'm expected to set this up myself?"
msgstr "Chắc ta lại phải tự dựng cái này lên à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC"
msgid "It requires payment."
msgstr "Nó cần phải trả phí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING"
msgid "Such pointless frivolity..."
msgstr "Đúng là một trò vô bổ..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC"
msgid "What are they hiding down there..."
msgstr "Chúng đang giấu cái gì dưới đó thế..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING"
msgid "I'm almost certain it was this one..."
msgstr "Ta khá chắc là cái này..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_KIT"
msgid "I suppose I'm expected to set this up myself?"
msgstr "Chắc ta lại phải tự dựng cái này lên à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC"
msgid "It requires payment."
msgstr "Nó cần phải trả phí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING"
msgid "A simple matter of memorization. I'll show you just how easy it is."
msgstr "Chỉ là chuyện ghi nhớ đơn giản thôi. Để ta cho ngươi thấy nó dễ thế nào nhé."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT"
msgid "I suppose I'm expected to set this up myself?"
msgstr "Chắc ta lại phải tự dựng cái này lên à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC"
msgid "It requires payment."
msgstr "Nó cần phải trả phí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING"
msgid "I imagine some people might find this amusing."
msgstr "Ta đoán vài kẻ sẽ thấy cái này thú vị đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC"
msgid "It requires payment."
msgstr "Nó cần phải trả phí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING"
msgid "Well, I suppose a bit of destruction might be relaxing."
msgstr "Chà, ta đoán việc đập phá chút đỉnh cũng giúp thư giãn đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_KIT"
msgid "I suppose I'm expected to set this up myself?"
msgstr "Chắc ta lại phải tự dựng cái này lên à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC"
msgid "It requires payment."
msgstr "Nó cần phải trả phí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING"
msgid "Another mindless diversion."
msgstr "Lại một trò giải trí vô bổ nữa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC"
msgid "What are they hiding down there..."
msgstr "Chúng đang giấu cái gì dưới đó thế..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING"
msgid "I'm certain it's rigged."
msgstr "Ta chắc chắn là nó bịp bợm rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT"
msgid "I suppose I'm expected to set this up myself?"
msgstr "Chắc ta lại phải tự dựng cái này lên à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC"
msgid "It requires payment."
msgstr "Nó cần phải trả phí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING"
msgid "A meaningless victory."
msgstr "Một chiến thắng vô nghĩa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_BALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_BALL"
msgid "How novel."
msgstr "Mới mẻ thật đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_CROWKID
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_CROWKID"
msgid "We're being overrun."
msgstr "Chúng ta sắp bị tràn ngập rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_GAMETOKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_GAMETOKEN"
msgid "Fine. I'll play your silly little games."
msgstr "Được rồi. Ta sẽ chơi mấy trò ngớ ngẩn của các người."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_HOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_HOST"
msgid "Just look at him, strutting around like he owns the place."
msgstr "Nhìn hắn kìa, cứ đi lại ngúng nguẩy như thể làm chủ cả cái xứ này không bằng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
msgid "It's about as festive as I like it. Which is not at all."
msgstr "Nó có bầu không khí lễ hội vừa đúng với ý ta. Tức là chẳng có tí nào."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
msgid "The birds seem to enjoy it. Some creatures just lack any taste."
msgstr "Mấy con chim có vẻ thích thú đấy. Đúng là có những sinh vật chẳng có tí gu thẩm mỹ nào."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3"
msgid "I think that's about as much clutter as one could possibly throw on a tree."
msgstr "Ta nghĩ đó là đống rác rưởi lớn nhất mà người ta có thể tống lên một cái cây đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA_KIT"
msgid "It's so... ugh... whimsical."
msgstr "Nó thật là... hừm... kỳ quặc."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC"
msgid "I somehow doubt they'd have anything I want."
msgstr "Ta hơi nghi ngờ việc ở đó có thứ gì ta muốn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT"
msgid "Must I do everything around here?"
msgstr "Bộ quanh đây ta phải làm mọi thứ à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC"
msgid "A prize ticket. How exciting."
msgstr "Một chiếc vé đổi thưởng. Hứng thú thật đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK"
msgid "Oh good. Now I can get some useless trinket from the Prize Booth."
msgstr "Ồ tuyệt. Giờ ta có thể lấy vài món đồ vô tích sự từ Gian hàng giải thưởng rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
msgid "I don't know why I'm dedicating so much time to this."
msgstr "Ta không hiểu sao mình lại dành nhiều thời gian cho việc này nữa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_SEEDPACKET"
msgid "About as pleasant as you'd expect."
msgstr "Dễ chịu đúng như những gì ngươi tưởng tượng đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_VEST_A
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_VEST_A"
msgid "Far too jaunty for my taste."
msgstr "Quá ư là lòe loẹt so với gu của ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_VEST_B
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_VEST_B"
msgid "At least it will give me some respite from this wretched heat."
msgstr "Ít ra nó cũng giúp ta đỡ được cái nóng khốn khổ này."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_VEST_C
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_VEST_C"
msgid "It affords some protection from the sun's burning rays."
msgstr "Nó có thể chống lại phần nào ánh nắng oi bức của mặt trời."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARPENTRY_BLADE_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARPENTRY_BLADE_MOONGLASS"
msgid "Fancy... for a laborer's tool."
msgstr "Cũng sang phết... đối với công cụ của một kẻ lao động."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARPENTRY_STATION.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARPENTRY_STATION.BURNT"
msgid "Too bad."
msgstr "Tiếc thật."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARPENTRY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARPENTRY_STATION.GENERIC"
msgid "I never cared for woodworking. The sawdust gets everywhere."
msgstr "Ta chưa từng thích làm mộc. Mạt cưa bay tứ tung khắp nơi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.DEAD"
msgid "Disgusting."
msgstr "Ghê tởm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.GENERIC"
msgid "That carrot is revolting!"
msgstr "Củ cà rốt đó thật đáng sợ!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.HELD"
msgid "You thought you could fool me?"
msgstr "Ngươi tưởng lừa được ta à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.SLEEPING"
msgid "I'm sure it is diseased."
msgstr "Ta chắc chắn nó mang bệnh rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT_GHOSTRACER"
msgid "Starting to feel left out?"
msgstr "Bắt đầu thấy tủi thân vì bị bỏ rơi rồi à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT"
msgid "I'm not a fan of vegetables."
msgstr "Ta không phải fan của rau củ đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_COOKED"
msgid "A little more refined, at least."
msgstr "Ít ra cũng tinh tế hơn một chút."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_OVERSIZED"
msgid "A ludicrously oversized carrot."
msgstr "Một củ cà rốt to đến mức lố bịch."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_PLANTED"
msgid "How mundane."
msgstr "Thật tầm thường."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_SEEDS"
msgid "Such labor is beneath me."
msgstr "Làm mấy việc lao động này quá tầm với ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "Such directionless destruction."
msgstr "Sự tàn phá thật vô định hướng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "Useless."
msgstr "Vô dụng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "Mapmaking is a soothing pastime. Methodical."
msgstr "Làm bản đồ là một trò tiêu khiển khá thư giãn. Rất có phương pháp."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOON"
msgid "Catty vermin."
msgstr "Lũ sâu bọ mèo mả."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONDEN.EMPTY"
msgid "Well, I guess that's that."
msgstr "Chà, ta đoán thế là hết."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONDEN.GENERIC"
msgid "Vermin housing."
msgstr "Ổ loài gặm nhấm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONHAT"
msgid "Dead head."
msgstr "Đầu thú chết."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATTOY_MOUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATTOY_MOUSE"
msgid "The classic game of catcoon and mechanical mouse."
msgstr "Trò chơi kinh điển giữa mèo trúc và chuột máy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "Well it's not going to move itself."
msgstr "Chà, nó có tự lăn đi đâu được đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "We must deal with the others first."
msgstr "Chúng ta phải xử lý mấy thứ kia trước đã."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA"
msgid "Ashes in one's mouth."
msgstr "Tro tàn trong miệng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_BURNT"
msgid "I refuse to be held responsible for that."
msgstr "Ta từ chối chịu trách nhiệm cho việc đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Even worse than raw."
msgstr "Còn tệ hơn lúc chưa nấu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_TREE"
msgid "It looks like a banana, but I'm not buying it."
msgstr "Trông giống chuối đấy, nhưng ta không tin đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE"
msgid "I plugged it a long time ago."
msgstr "Ta đã bịt nó lại từ lâu rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "When it's less claustrophobic, perhaps."
msgstr "Khi nào đỡ ngột ngạt hơn thì có lẽ được."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "That was not a good idea!"
msgstr "Đó không phải là ý hay đâu!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "Off to plunder the depths."
msgstr "Đi càn quét dưới sâu thôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "Probably shouldn't venture any deeper."
msgstr "Chắc không nên mạo hiểm đi sâu hơn nữa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.FULL"
msgid "I'd rather stay here than mingle with the crowds above."
msgstr "Ta thà ở đây còn hơn chen lấn với đám đông trên kia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "Get me out of here!"
msgstr "Đưa ta ra khỏi đây mau!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.OPEN"
msgid "Onward to the next thing."
msgstr "Tiến tới thử thách tiếp theo nào."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_FERN"
msgid "I'd like to step on it."
msgstr "Ta rất muốn dẫm lên nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_FERN_WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_FERN_WITHERED"
msgid "Ah well."
msgstr "À chà."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_VENT_MITE.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_VENT_MITE.DEAD"
msgid "Great."
msgstr "Tuyệt vời."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_VENT_MITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_VENT_MITE.GENERIC"
msgid "Leave me alone!"
msgstr "Để ta yên!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_VENT_MITE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_VENT_MITE.SLEEPING"
msgid "Quickly, while it sleeps."
msgstr "Tranh thủ lúc nó đang ngủ nào."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_VENT_MITE.VENTING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_VENT_MITE.VENTING"
msgid "Ugh, I think I swallowed some."
msgstr "Hừ, hình như ta vừa nuốt phải vài thứ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_VENT_ROCK.GAS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_VENT_ROCK.GAS"
msgid "Blegh! That stinks!"
msgstr "Ghê quá! Thối thật đấy!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_VENT_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_VENT_ROCK.GENERIC"
msgid "I don't like the looks of it."
msgstr "Ta không thích vẻ ngoài của nó chút nào."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_VENT_ROCK.HOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_VENT_ROCK.HOT"
msgid "Ugh, really? I'm already uncomfortable."
msgstr "Hừ, thật á? Ta đã thấy khó chịu sẵn rồi đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_VENT_ROCK.MIASMA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_VENT_ROCK.MIASMA"
msgid "No, thank you."
msgstr "Thôi, cảm ơn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CEILING_ROPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CEILING_ROPE"
msgid "Is it time to leave this accursed place?"
msgstr "Đã đến lúc rời khỏi nơi quỷ quái này chưa?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CEVICHE"
msgid "A delightful, cultured dish."
msgstr "Một món ăn tinh tế và đầy văn hóa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARCOAL"
msgid "Nothing will steal my carbon!"
msgstr "Đừng hòng ai cướp mất carbon của ta!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIERESIDUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIERESIDUE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIEROSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIEROSE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_HAND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_HAND"
msgid "I'll... see to it."
msgstr "Ta sẽ... lo việc đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_HECKLER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_HECKLER"
msgid "Tough crowd."
msgstr "Khán giả khó tính ghê."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_LECTURN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_LECTURN"
msgid "Misdirection, the oldest trick in the book. Well played, Charlie."
msgstr "Đánh lạc hướng, chiêu bài xưa cũ nhất trong sách. Chơi đẹp lắm, Charlie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_NPC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_NPC"
msgid "Charlie..."
msgstr "Charlie..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_STAGE_POST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_STAGE_POST"
msgid "Just like the old days."
msgstr "Y như những ngày xưa cũ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK1"
msgid "There's a reason I never finished that."
msgstr "Bảo sao ta chưa bao giờ hoàn thành cái đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK2"
msgid "That one was a jerk."
msgstr "Con đó hỗn láo thật."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK3"
msgid "Didn't like that one's face."
msgstr "Không ưa cái mặt con đó chút nào."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "How kitsch."
msgstr "Sến súa làm sao."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ANTLION"
msgid "Is there a sinkhole I can bury this in?"
msgstr "Có cái hố sụt nào để ta chôn cái này xuống không nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEARGER"
msgid "A brute."
msgstr "Một tên cục súc."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEARGER_MUTATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEARGER_MUTATED"
msgid "It'll scare away anyone with good taste."
msgstr "Nó sẽ dọa chạy mất bất cứ ai có gu thẩm mỹ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEEFALO"
msgid "At least this version doesn't shed all over my poor suit."
msgstr "Ít ra phiên bản này không rụng lông đầy bộ vest tội nghiệp của ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "Does she really need a statue?"
msgstr "Cô ta nhất thiết phải có tượng à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "Could use a few more mechanical bits in my opinion."
msgstr "Theo ta thì nên lắp thêm vài bộ phận máy móc vào nữa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "The pieces are in motion!"
msgstr "Các quân cờ đang chuyển động!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "Rather elegant, I'd say."
msgstr "Khá là thanh lịch đấy chứ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CARRAT"
msgid "If only I had a mantle to set it on."
msgstr "Phải chi ta có cái bệ lò sưởi để đặt nó lên."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CATCOON"
msgid "This animal commands respect through violence."
msgstr "Con vật này bắt người ta phải nể bằng bạo lực."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "It's quite fetching."
msgstr "Trông khá thu hút đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "What a gruesome maw."
msgstr "Cái hàm gì mà gớm ghiếc thế."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CRABKING"
msgid "I am not that crabby!"
msgstr "Ta đâu có hay cáu kỉnh thế đâu!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "Seems like anyone can get a statue these days."
msgstr "Dạo này hình như ai cũng được dựng tượng thì phải."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DAYWALKER2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DAYWALKER2"
msgid "Ah yes, the rummaging hog."
msgstr "À đúng rồi, con heo chuyên lục lọi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "I don't like winters."
msgstr "Ta không thích mùa đông chút nào."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "I take great offense to anyone trying to improve on my designs."
msgstr "Ta cực kỳ khó chịu với bất cứ kẻ nào dám cải tiến thiết kế của ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DEPTHWORM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DEPTHWORM"
msgid "Let's leave this underground."
msgstr "Cứ để thứ này dưới lòng đất đi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "It never stood a chance."
msgstr "Nó chưa bao giờ có cửa cả."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "An eye could never best a master of illusion such as I."
msgstr "Một con mắt thì làm sao qua mặt được bậc thầy ảo thuật như ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_FORMAL"
msgid "What a well-dressed figure!"
msgstr "Đúng là một nhân vật ăn mặc lịch sự!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "How could I not have seen..."
msgstr "Sao ta lại không nhận ra..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "This seems cruel."
msgstr "Trông có vẻ tàn nhẫn thế nào ấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KITCOON"
msgid "This is a rather precarious design."
msgstr "Thiết kế này có vẻ hơi chông chênh nhỉ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KLAUS"
msgid "Why bother?"
msgstr "Làm thế để làm gì cơ chứ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "A dreadful lack of accordions."
msgstr "Thiếu vắng tiếng đàn accordion trầm trọng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "And I thought chivalry was dead!"
msgstr "Thế mà ta cứ tưởng tinh thần hiệp sĩ đã tuyệt chủng rồi chứ!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "Such a fowl-tempered bird."
msgstr "Con chim tính tình cáu bẳn làm sao."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "Who put this ridiculous thing here?"
msgstr "Tên nào đặt cái thứ lố bịch này ở đây thế?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "Always keep things close to the chest, right pal?"
msgstr "Lúc nào cũng phải giữ bí mật cẩn thận, phải không bạn hiền?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MOON"
msgid "I'm fairly partial to this one."
msgstr "Ta khá có cảm tình với cái này đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "What an imbecilic expression."
msgstr "Cái biểu cảm đần độn gì thế này."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MUSE"
msgid "Must everything be about my shortcomings?"
msgstr "Cứ phải xoáy vào những điểm yếu của ta mới chịu được à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_PAWN"
msgid "I have no idea what that is."
msgstr "Ta chịu chết không biết đó là cái quái gì."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_PIPE"
msgid "Ceci n'est pas une pipe. Pity."
msgstr "Đây không phải là cái tẩu. Đáng tiếc thật."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "It's nice, but where's the rust? The exhaust pipes?"
msgstr "Cũng được đấy, nhưng vết gỉ sét đâu? Ống xả đâu rồi?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "The pieces are in motion!"
msgstr "Các quân cờ đang chuyển động!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_SHARKBOI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_SHARKBOI"
msgid "Bottom feeding lone shark."
msgstr "Con cá mập cô độc ăn đáy biển."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_STALKER"
msgid "I do like this one."
msgstr "Ta rất thích cái này đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "At least the statue doesn't smell as bad as the original."
msgstr "Ít ra bức tượng không bốc mùi tệ như bản gốc."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "The most troublesome pair I've ever seen."
msgstr "Cặp đôi phiền phức nhất mà ta từng thấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD"
msgid "Now who's afraid of getting crushed?"
msgstr "Giờ thì ai mới sợ bị nghiền nát nào?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR"
msgid "It was a culmination of terrible decisions."
msgstr "Đó là kết quả của một chuỗi quyết định tồi tệ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT"
msgid "I loathe it."
msgstr "Ta căm ghét nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "It was a bad dog."
msgstr "Đó là một con chó hư."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_WORMBOSS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_WORMBOSS"
msgid "I can still smell it's breath."
msgstr "Ta vẫn còn ngửi thấy hơi thở của nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_YOTD"
msgid "Always nice to be reminded of my victories."
msgstr "Thật tuyệt khi được gợi nhớ về những chiến thắng của mình."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_YOTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_YOTH"
msgid "Make up your mind! Friend or foe?"
msgstr "Quyết định nhanh lên xem nào! Bạn hay thù đây?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_YOTS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_YOTS"
msgid "Let's leave this underground."
msgstr "Cứ để thứ này dưới lòng đất đi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER"
msgid "Annoying little monster. Has his uses, though."
msgstr "Con quái vật nhỏ phiền phức. Nhưng cũng có khối việc ra trò đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "Stop looking at me!"
msgstr "Đừng có nhìn ta nữa!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "What is it waiting for?"
msgstr "Nó đang đợi cái gì thế nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "Hmph. Dress it up with wires and gears, but I know magic when I see it."
msgstr "Hừ. Trang trí bằng dây điện với bánh răng thế thôi chứ dùng phép thuật là ta nhận ra ngay."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHEST_MIMIC_REVEALED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHEST_MIMIC_REVEALED"
msgid "It's a trap!"
msgstr "Là bẫy đấy!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHUM"
msgid "Say, that chum doesn't look so good."
msgstr "Này, mồi câu đó trông không ổn lắm đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYHOUND.GENERIC"
msgid "I was wise to be suspicious."
msgstr "Ta đã khôn ngoan khi thấy hoài nghi đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYHOUND.STATUE"
msgid "I don't trust it."
msgstr "Ta không tin tưởng nó đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYWARG.GENERIC"
msgid "This earthen beast's all fired up."
msgstr "Con quái thú đất nung này đang hừng hực khí thế rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYWARG.STATUE"
msgid "How delightfully disconcerting."
msgstr "Thật là mất tự nhiên một cách thú vị."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.EMBERS"
msgid "I'm going to lose it."
msgstr "Ta sắp phát điên rồi đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.GENERIC"
msgid "How comforting."
msgstr "Thật dễ chịu làm sao."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.HIGH"
msgid "That will keep Charlie away for now."
msgstr "Thế này thì tạm thời giữ chân Charlie được đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.LOW"
msgid "It needs fuel."
msgstr "Nó cần thêm nhiên liệu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.NORMAL"
msgid "Cold and fiery."
msgstr "Vừa lạnh lẽo vừa rực lửa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.OUT"
msgid "That's not coming back."
msgstr "Thứ đó không quay lại đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "Someone should attend to that."
msgstr "Ai đó nên chăm chút cho cái lò lửa đó đi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "A fire pit."
msgstr "Một cái lò lửa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.HIGH"
msgid "A roaring, cold fire."
msgstr "Một ngọn lửa lạnh đang bùng cháy dữ dội."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.LOW"
msgid "It's getting low."
msgstr "Nó sắp tàn rồi kìa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "It's cold."
msgstr "Trời lạnh quá."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.OUT"
msgid "It's gone warm."
msgstr "Nó đã hơi ấm lên rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLLAPSEDCHEST"
msgid "Do you really expect me to dig through that?"
msgstr "Ngươi thực sự nghĩ ta sẽ bới tung đống đó lên à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.E"
msgid "East."
msgstr "Hướng Đông."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.GENERIC"
msgid "I've lost my way."
msgstr "Ta lạc đường mất rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.N"
msgid "North."
msgstr "Hướng Bắc."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.NE"
msgid "Northeast."
msgstr "Hướng Đông Bắc."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.NW"
msgid "Northwest."
msgstr "Hướng Tây Bắc."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.S"
msgid "South."
msgstr "Hướng Nam."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.SE"
msgid "Southeast."
msgstr "Hướng Đông Nam."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.SW"
msgid "Southwest."
msgstr "Hướng Tây Nam."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.W"
msgid "West."
msgstr "Hướng Tây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOST"
msgid "I'd rather not get my hands dirty."
msgstr "Ta thà không làm bẩn đôi tay mình còn hơn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "This should suffice."
msgstr "Thế này là đủ dùng rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "It smells about as bad as you'd imagine."
msgstr "Mùi của nó kinh khủng y như ngươi tưởng tượng vậy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "Positively arid."
msgstr "Khô khan tích cực."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "Disgusting."
msgstr "Ghê tởm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTINGBIN.WET"
msgid "It's nothing but foul wet slop."
msgstr "Chẳng khác gì đống bùn nhão nhoét hôi hám."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTWRAP"
msgid "I'm utterly dung with all of this."
msgstr "Ta chán ngấy đống phân rác này đến tận cổ rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CONSTRUCTION_PLANS"
msgid "I suppose I should build this."
msgstr "Chắc ta nên chế tạo cái này thôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKBOOK"
msgid "Very well. If I can master the dark arts, how hard could cooking be?"
msgstr "Được thôi. Nếu ta đã làm chủ được hắc pháp, nấu ăn chắc cũng chẳng khó lắm nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMANDRAKE"
msgid "It has lost a lot of its power."
msgstr "Nó đã mất đi phần lớn sức mạnh rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMEAT"
msgid "It smells less like barnyard, now."
msgstr "Giờ thì đỡ có mùi chuồng trại hơn rồi đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMONSTERMEAT"
msgid "It's still filthy."
msgstr "Nó vẫn dơ bẩn lắm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDSMALLMEAT"
msgid "Well, at least it's not moving anymore."
msgstr "Chà, ít ra nó không còn giãy giụa nữa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKIECUTTER"
msgid "Stay back, you!"
msgstr "Tránh xa ta ra, đồ quỷ!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKIECUTTERHAT"
msgid "This doesn't look dapper at all."
msgstr "Trông chẳng bảnh bao chút nào cả."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKIECUTTERSHELL"
msgid "Hmph. I suppose this could be useful."
msgstr "Hừ. Ta đoán cái này có ích đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "The writing is too faint to read."
msgstr "Chữ viết mờ quá không đọc nổi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.BURNT"
msgid "A bit overdone for my tastes."
msgstr "Hơi quá lửa so với gu của ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "Wait for it..."
msgstr "Đợi chút nào..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "Here it comes!"
msgstr "Nó đến kìa!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.DONE"
msgid "Finally, some quality grub."
msgstr "Cuối cùng cũng có con sâu ngon lành để ăn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.EMPTY"
msgid "Just the thought makes my mouth water."
msgstr "Mới nghĩ đến thôi mà nước miếng đã tứa ra rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOLANT"
msgid "Yucky."
msgstr "Ghê thế."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COONTAIL"
msgid "Tale of tails."
msgstr "Chuyện về những chiếc đuôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN"
msgid "High in fructose."
msgstr "Giàu fructose lắm đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN_COOKED"
msgid "A little more refined, at least."
msgstr "Ít ra cũng tinh tế hơn một chút."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN_OVERSIZED"
msgid "That's far too much corn for any reasonable person."
msgstr "Bắp gì mà quá nhiều so với một người bình thường."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN_SEEDS"
msgid "Such labor is beneath me."
msgstr "Làm mấy việc lao động này quá tầm với ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "It seems the costumes are provided."
msgstr "Có vẻ như trang phục đã được chuẩn bị sẵn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_DOLL_BODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_DOLL_BODY"
msgid "It seems the costumes are provided."
msgstr "Có vẻ như trang phục đã được chuẩn bị sẵn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_FOOL_BODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_FOOL_BODY"
msgid "It seems the costumes are provided."
msgstr "Có vẻ như trang phục đã được chuẩn bị sẵn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_KING_BODY"
msgid "I think that one will fit me nicely."
msgstr "Ta nghĩ bộ đó mặc vừa khít với ta đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "It seems the costumes are provided."
msgstr "Có vẻ như trang phục đã được chuẩn bị sẵn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_PRINCESS_BODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_PRINCESS_BODY"
msgid "I suppose it goes with the bossy horse head."
msgstr "Ta đoán nó hợp với cái đầu ngựa hách dịch kia đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "It seems the costumes are provided."
msgstr "Có vẻ như trang phục đã được chuẩn bị sẵn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_TREE_BODY"
msgid "It seems the costumes are provided."
msgstr "Có vẻ như trang phục đã được chuẩn bị sẵn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "Let's add a little fire for dramatic effect."
msgstr "Thêm chút lửa cho có không khí kịch tính nào."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "A homely statue. Perhaps it can be improved."
msgstr "Một bức tượng mộc mạc. Có lẽ có thể cải thiện nó được."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "Let's add a little fire for dramatic effect."
msgstr "Thêm chút lửa cho có không khí kịch tính nào."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "How delightfully ominous."
msgstr "Trông thật là điềm gở một cách thú vị."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "Let's add a little fire for dramatic effect."
msgstr "Thêm chút lửa cho có không khí kịch tính nào."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "There's something captivating about it."
msgstr "Có thứ gì đó rất lôi cuốn ở nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TRINKET"
msgid "Not my size, sadly."
msgstr "Tiếc là không vừa cỡ của ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COZY_BUNNYMAN"
msgid "I could have sworn I left you all underground."
msgstr "Ta dám cá là mình đã tống hết tụi mày xuống dưới lòng đất rồi cơ mà."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING.GENERIC"
msgid "Say, pal, why don't we try to work this out?"
msgstr "Này bạn hiền, sao chúng ta không thử dàn xếp chuyện này nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING.INERT"
msgid "I suppose we can't just leave well enough alone, can we?"
msgstr "Ta đoán chúng ta không thể cứ để yên mọi chuyện được nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_CANNONTOWER"
msgid "Watch it where you shoot those things!"
msgstr "Nhắm cái hướng ngươi bắn mấy thứ đó lại xem nào!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_CLAW"
msgid "Best to avoid that."
msgstr "Tốt nhất là tránh xa cái đó ra."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_ICEWALL"
msgid "Always something in the way."
msgstr "Lúc nào cũng có thứ vướng víu cản đường."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_MOB"
msgid "I'd kill for a crab cake."
msgstr "Ta sẵn sàng đổi cả mạng lấy một đĩa bánh cua đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "Middle management."
msgstr "Cấp quản lý trung gian."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTERLAB"
msgid "Am I being watched by that rock?"
msgstr "Có phải hòn đá đó đang nhìn chằm chằm vào ta không?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_BULBIN"
msgid "You're not from around here, are you pal?"
msgstr "Ngươi không phải người ở đây phải không, bạn hiền?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_DRAGONLING"
msgid "Just like old times."
msgstr "Y như những ngày xưa cũ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_EETS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_EETS"
msgid "Would you stay still, you jittering thing?"
msgstr "Đứng yên xem nào, cái thứ cứ giật giật này?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "Tell me, what is it you see, little one?"
msgstr "Nói cho ta nghe, ngươi nhìn thấy gì thế, nhóc con?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_GLOMLING"
msgid "You are much too trusting, friend."
msgstr "Cậu quá cả tin rồi đấy, bạn hiền."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_KITTEN"
msgid "A wholly agreeable animal."
msgstr "Một con vật hoàn toàn dễ thương."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_LAMB"
msgid "Quit nibbling my coattails."
msgstr "Đừng có gặm vạt áo tôi nữa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "You had better not chew holes in my suit."
msgstr "Tốt hơn là nhóc đừng cắn thủng bộ vest của tôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_PERDLING"
msgid "You're as fowl as I am!"
msgstr "Nhóc cũng nhiều lông như tôi vậy!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_PUPPY"
msgid "You're a slobbery little chap, aren't you?"
msgstr "Cậu là một chú nhóc chảy dãi, phải không nào?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CROW.GENERIC"
msgid "I don't know how they got here."
msgstr "Tôi không biết chúng đến đây bằng cách nào."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CROW.HELD"
msgid "Shhhh... My pretty."
msgstr "Suỵt... Đứa con xinh đẹp của ta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRUMBS"
msgid "It's falling apart."
msgstr "Nó đang rã ra kìa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "Disgusting!"
msgstr "Ghê tởm!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTGRASS"
msgid "The mundane stuff of the earth."
msgstr "Thứ tầm thường của mặt đất."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTLESS"
msgid "Very funny."
msgstr "Buồn cười thật đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTLICHEN"
msgid "Dry, crumbly, sustaining."
msgstr "Khô, vụn, nhưng vẫn đủ no."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTREEDS"
msgid "I think I could build something useful from this."
msgstr "Tôi nghĩ mình có thể làm ra thứ gì đó hữu ích từ món này."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTSTONE"
msgid "The building blocks of civilization."
msgstr "Những khối xây dựng nên nền văn minh."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER.GENERIC"
msgid "Say pal, why don't we talk this out?"
msgstr "Này bạn hiền, sao chúng ta không ngồi xuống nói chuyện nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "You went nosing around places you shouldn't have, didn't you?"
msgstr "Ngươi đã tọc mạch vào những nơi không nên đến phải không?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER2.BURIED"
msgid "He seems fine to me."
msgstr "Trông hắn có vẻ ổn với tôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER2.GENERIC"
msgid "Someone needs a bath."
msgstr "Ai đó cần đi tắm rửa kìa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "What's his problem?"
msgstr "Vấn đề của hắn là gì vậy?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "That stone would be useful, if only it could be broken."
msgstr "Hòn đá đó sẽ hữu ích, nếu như có thể đập vỡ nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "I can just make out something dark within."
msgstr "Tôi có thể lờ mờ nhận ra thứ gì đó đen tối bên trong."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEADLYFEAST"
msgid "It smells... noxious."
msgstr "Nó có mùi... độc hại."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEAD_SEA_BONES"
msgid "Adapt or perish."
msgstr "Thích nghi hoặc là diệt vong."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "Oops."
msgstr "Ôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "Bathed in fire."
msgstr "Đắm chìm trong lửa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "That's not about to grow back."
msgstr "Cái đó sẽ không mọc lại được nữa đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "An acquaintance of mine describes them as \"leafy\"."
msgstr "Một người quen của tôi mô tả chúng là \"nhiều lá\"."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "Shut your maw!"
msgstr "Ngậm cái mồm ngươi lại đi!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECK_OF_CARDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECK_OF_CARDS"
msgid "If only I stuck with these."
msgstr "Giá như tôi cứ gắn bó với chúng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_CENTERPIECE"
msgid "Bland."
msgstr "Nhạt nhẽo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "An empty vessel awaiting decoration or light."
msgstr "Một chiếc bình trống đang chờ được trang trí hoặc thắp sáng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "A temporary reprieve from the shadow."
msgstr "Một sự giải thoát tạm thời khỏi bóng tối."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "Purely decorative."
msgstr "Hoàn toàn để trang trí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "I believe it is Wilson's turn to fetch bulbs."
msgstr "Tôi tin là đến lượt Wilson đi gom bóng đèn rồi đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "Every lovely flower must one day wilt."
msgstr "Đóa hoa nào rồi cũng sẽ đến ngày tàn úa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_LAMP"
msgid "Who's afraid of the dark?"
msgstr "Ai mà sợ bóng tối cơ chứ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "Uninspired."
msgstr "Thiếu cảm hứng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "If only life were that simple."
msgstr "Giá như cuộc đời đơn giản được như thế."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "My my, aren't we special."
msgstr "Chà chà, chúng ta đặc biệt thật đấy nhỉ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER.ANTLER"
msgid "What a staggering sight!"
msgstr "Thật là một cảnh tượng choáng ngợp!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER.GENERIC"
msgid "Well it's certainly not deer to me."
msgstr "Chà, chắc chắn nó chẳng có tí "hươu" hốc nào đối với tôi cả."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPS"
msgid "Even I'm afraid of that guy."
msgstr "Đến tôi còn thấy sợ tên đó cơ mà."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "It's best to be rid of it."
msgstr "Tốt nhất là tống quái nó đi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "Disgusting."
msgstr "Ghê tởm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "The wretch is being puppeteered!"
msgstr "Kẻ khốn nạn đó đang bị giật dây kìa!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "Keeps it cold like my heart."
msgstr "Giữ cho nó lạnh giá như trái tim tôi vậy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "Don't say I didn't warn you when it all goes up in flames."
msgstr "Đừng có nói là tôi không cảnh báo khi mọi thứ chìm trong biển lửa nhé."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "Do I have to do everything around here?"
msgstr "Bộ tôi phải làm mọi thứ ở cái xó này chắc?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "Deerclops are so myopic."
msgstr "Deerclops lúc nào cũng cận thị như vậy đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER_ANTLER"
msgid "Filthy."
msgstr "Dơ dáy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER_GEMMED"
msgid "The gem imbues its attacks with a fearsome power."
msgstr "Viên ngọc truyền cho các đòn tấn công của nó một sức mạnh đáng sợ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "That's not doing anyone any good."
msgstr "Cái đó chẳng đem lại lợi ích gì cho ai cả."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DESERTHAT"
msgid "Function over form."
msgstr "Tính thực tế trên hết hình thức."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DESICCANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DESICCANT"
msgid "A rudimentary ward against dampness."
msgstr "Một biện pháp thô sơ để chống lại độ ẩm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DESICCANTBOOSTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DESICCANTBOOSTED"
msgid "A more robust ward against dampness."
msgstr "Một biện pháp mạnh mẽ hơn để chống lại độ ẩm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIRTPILE"
msgid "That looks out-of-place."
msgstr "Trông lạc lõng làm sao."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.COLD"
msgid "Mostly just background noise."
msgstr "Hầu như chỉ là tiếng ồn nền."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.GENERIC"
msgid "I can use this to find my missing parts."
msgstr "Tôi có thể dùng cái này để tìm những phần bị mất của mình."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.HOT"
msgid "It must be right under my nose!"
msgstr "Nó chắc chắn ở ngay trước mũi tôi rồi!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.WARM"
msgid "This is the right direction."
msgstr "Đây là hướng đi đúng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.WARMER"
msgid "I should keep my eyes peeled."
msgstr "Tôi nên căng mắt ra mới được."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "It's the starting mechanism."
msgstr "Đó là cơ chế khởi động."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.READY"
msgid "I need to insert the divining rod."
msgstr "Tôi cần cắm que bói vào."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "Progress!"
msgstr "Có tiến triển rồi!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODSTART"
msgid "The portals lead to the next rod."
msgstr "Các cổng dịch chuyển dẫn đến que tiếp theo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DOCK_KIT"
msgid "So I'm to be a dock builder now, am I?"
msgstr "Vậy là giờ tôi thành thợ xây bến tàu rồi sao?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "Do I look like a common laborer to you?"
msgstr "Trông tôi có giống một tên phu khuân vác bình thường trong mắt cậu à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DOLL_BLUEPRINT"
msgid "I can only imagine how grotesque this will look..."
msgstr "Tôi chỉ có thể tưởng tượng trông nó sẽ dị hợm đến mức nào..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONBOAT_KIT"
msgid "I'm not the roll-up-your-sleeves type. Ask the handywoman."
msgstr "Tôi không phải kiểu người thích xắn tay áo lên làm việc đâu. Đi mà hỏi cô thợ khéo tay ấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONBOAT_PACK"
msgid "Here I am, toiling away for a frivolous diversion."
msgstr "Tôi đây, đang cặm cụi làm việc vì một trò tiêu khiển phù phiếm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONBODYHAT"
msgid "I'm no middleman."
msgstr "Tôi không phải kẻ đứng giữa đâu nhé."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONCHILISALAD"
msgid "I'll permit him to stay so long as he keeps cooking."
msgstr "Tôi sẽ cho phép hắn ở lại chừng nào hắn còn tiếp tục nấu nướng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLY"
msgid "A fiery fly."
msgstr "Một con ruồi bốc lửa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "Those scales sure are nifty."
msgstr "Mấy chiếc vẩy đó đúng là tuyệt diệu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE"
msgid "Spacious and stylish."
msgstr "Rộng rãi và phong cách."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "Such a spiffy design!"
msgstr "Một thiết kế sành điệu làm sao!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "How undignified."
msgstr "Thật kém sang làm sao."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "The red gems are producing a sweltering heat."
msgstr "Những viên ngọc đỏ đang tỏa ra cái nóng ngột ngạt."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "With only one gem it is only moderately scorching."
msgstr "Chỉ với một viên ngọc thì nó chỉ nóng ở mức vừa phải thôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT"
msgid "Exotic and delicious."
msgstr "Độc lạ và ngon miệng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "A little more refined, at least."
msgstr "Ít ra thì cũng tinh tế hơn một chút."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "Utterly enormous."
msgstr "To lớn một cách khủng khiếp."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "Such labor is beneath me."
msgstr "Mấy việc chân tay đó quá tầm với tôi rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONHEADHAT"
msgid "Quite formidable looking."
msgstr "Trông khá là gờm đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONPIE"
msgid "Simply exquisite."
msgstr "Đơn giản là tuyệt hảo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONTAILHAT"
msgid "The back end of a terrible beast."
msgstr "Phần đuôi của một con quái vật khủng khiếp."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGON_SCALES"
msgid "Fiery."
msgstr "Rực lửa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DREADSTONE"
msgid "Petrified nightmares."
msgstr "Những cơn ác mộng hóa đá."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DREADSTONEHAT"
msgid "Darkness is never far from my mind."
msgstr "Bóng tối chưa bao giờ rời khỏi tâm trí tôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DREADSTONE_STACK"
msgid "It comes from the depths below."
msgstr "Nó đến từ tận sâu thẳm dưới lòng đất."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_LOG"
msgid "Oh good. More wood."
msgstr "Ồ tuyệt. Lại thêm gỗ nữa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "It seems to be burning."
msgstr "Nó có vẻ đang cháy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "It's in utter ruin."
msgstr "Nó đã lụi tàn hoàn toàn rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "We've chopped it up already."
msgstr "Chúng ta đã chặt vụn nó ra rồi mà."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "It appears to be a piece of drifted wood."
msgstr "Trông nó có vẻ là một khúc gỗ trôi dạt."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRUMSTICK"
msgid "It tastes strangely like berries."
msgstr "Nó có vị lạ kỳ giống như dâu rừng vậy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRUMSTICK_COOKED"
msgid "Still tastes like berries."
msgstr "Vẫn có vị giống dâu rừng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BANANABUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BANANABUSH"
msgid "Bananas that don't grow in caves? Preposterous."
msgstr "Chuối mà lại không mọc trong hang động ư? Thật vô lý."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BERRYBUSH"
msgid "Do I look like a gardener?"
msgstr "Trông tôi có giống làm vườn lắm à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "I could find a much better place for it."
msgstr "Tôi có thể tìm được chỗ tốt hơn cho nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_GRASS"
msgid "Do I look like a gardener?"
msgstr "Trông tôi có giống làm vườn lắm à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_MARSH_BUSH"
msgid "Do I look like a gardener?"
msgstr "Trông tôi có giống làm vườn lắm à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_MONKEYTAIL"
msgid "I still don't trust it."
msgstr "Tôi vẫn không tin tưởng nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_SAPLING"
msgid "I can't believe I'm reduced to this."
msgstr "Không thể tin nổi là mình lại phải làm đến mức này."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_TRAP_STARFISH"
msgid "What would be the most devilish place to put it?"
msgstr "Đâu sẽ là nơi hiểm độc nhất để đặt nó đây?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL"
msgid "I have no interest in such things."
msgstr "Tôi không có hứng thú với mấy thứ đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "It has all the grace and subtlety I'd expect from the strongman."
msgstr "Nó mang đầy vẻ duyên dáng và tinh tế đúng như tôi mong đợi từ gã đô con đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_GEM"
msgid "It's not that impressive."
msgstr "Cũng chẳng ấn tượng lắm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_GOLDEN"
msgid "It's not that impressive."
msgstr "Cũng chẳng ấn tượng lắm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_HEAT"
msgid "You won't catch me lugging it around."
msgstr "Đừng mong bắt được tôi xách vác cái thứ đó đi quanh."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_MARBLE"
msgid "It's not that impressive."
msgstr "Cũng chẳng ấn tượng lắm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_REDGEM"
msgid "It has all the grace and subtlety I'd expect from the strongman."
msgstr "Nó mang đầy vẻ duyên dáng và tinh tế đúng như tôi mong đợi từ gã đô con đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN"
msgid "It's an acquired taste."
msgstr "Nó là thứ phải ăn dần mới quen được."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_COOKED"
msgid "A little more refined, at least."
msgstr "Ít ra thì cũng tinh tế hơn một chút."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_OVERSIZED"
msgid "Far more than I'd like to have, quite honestly."
msgstr "Thành thật mà nói, nhiều hơn mức tôi muốn có rất nhiều."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_SEEDS"
msgid "Such labor is beneath me."
msgstr "Mấy việc chân tay đó quá tầm với tôi rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUSTMERINGUE"
msgid "I'll pass."
msgstr "Tôi xin nhường."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUSTMOTH"
msgid "Hmph. Just stay away from my suit, pal."
msgstr "Hừm. Tránh xa bộ vest của tôi ra, bạn hiền."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUSTMOTHDEN"
msgid "So this is the source of the Thulecite... I must say, I'm underwhelmed."
msgstr "Hóa ra đây là nguồn gốc của Thulecite... Phải nói là tôi hơi thất vọng đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EARMUFFSHAT"
msgid "They are at least warm."
msgstr "Ít ra thì chúng cũng ấm áp."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EEL"
msgid "It slithers all the way down."
msgstr "Nó trượt tuột tuột xuống dưới luôn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EEL_COOKED"
msgid "Still rather grotesque."
msgstr "Vẫn khá là dị hợm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT"
msgid "Just another boring plant."
msgstr "Lại thêm một loại thực vật nhàm chán."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_COOKED"
msgid "A little more refined, at least."
msgstr "Ít ra thì cũng tinh tế hơn một chút."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "An absurdly large eggplant."
msgstr "Một quả cà tím to một cách vô lý."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_SEEDS"
msgid "Such labor is beneath me."
msgstr "Mấy việc chân tay đó quá tầm với tôi rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ELIXIR_CONTAINER"
msgid "Don't think I'm fooled by its innocent appearance."
msgstr "Đừng hòng mà tôi bị lừa bởi vẻ bề ngoài vô hại của nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EMBERLIGHT"
msgid "Neat trick."
msgstr "Mẹo vặt hay đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.BURNT"
msgid "That was uncalled for."
msgstr "Thật là vô duyên hết chỗ nói."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.EMPTY"
msgid "An empty vessel awaiting decoration or light."
msgstr "Một chiếc bình trống đang chờ được trang trí hoặc thắp sáng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "A temporary reprieve from the shadow."
msgstr "Một sự giải thoát tạm thời khỏi bóng tối."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.GENERIC"
msgid "Purely decorative."
msgstr "Hoàn toàn để trang trí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "I believe it is Wilson's turn to fetch bulbs."
msgstr "Tôi tin là đến lượt Wilson đi gom bóng đèn rồi đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.WILTED"
msgid "Every lovely flower must one day wilt."
msgstr "Đóa hoa nào rồi cũng sẽ đến ngày tàn úa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.BURNING"
msgid "Oops."
msgstr "Ôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.BURNT"
msgid "Bathed in fire."
msgstr "Đắm chìm trong lửa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.CHOPPED"
msgid "That's not about to grow back."
msgstr "Cái đó sẽ không mọc lại được nữa đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.GENERIC"
msgid "An acquaintance of mine describes them as \"piney\"."
msgstr "Một người quen của tôi mô tả chúng là \"nhiều lá kim\"."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "Oops."
msgstr "Ôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "Dust to dust."
msgstr "Cát bụi lại hoàn cát bụi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "I put it out of its misery."
msgstr "Tôi chấm dứt nỗi thống khổ cho nó đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "It looks sickly."
msgstr "Trông nó có vẻ ốm yếu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEBRELLAHAT"
msgid "Eye to the sky."
msgstr "Mắt hướng lên bầu trời."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEMASKHAT"
msgid "How deliciously macabre."
msgstr "Thật rùng rợn làm sao."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEOFTERROR"
msgid "Don't look at me, it's definitely not one of mine."
msgstr "Đừng nhìn tôi, chắc chắn không phải của tôi đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEOFTERROR_MINI"
msgid "We're going to be up to our eyeballs in... eyeballs."
msgstr "Chúng ta sắp ngập ngụa trong... những con mắt rồi đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "I should dispose of it before it hatches."
msgstr "Tôi nên vứt nó đi trước khi nó nở."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEPLANT"
msgid "The Meat Bulb's pawns."
msgstr "Đàn em của Củ Thịt."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYETURRET"
msgid "Some of my better work."
msgstr "Một trong những tác phẩm xuất sắc của tôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYETURRET_ITEM"
msgid "Now it just needs to be set up."
msgstr "Giờ chỉ cần dựng nó lên nữa là được."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.BURNT"
msgid "A harvest of ashes."
msgstr "Một vụ thu hoạch toàn tro tàn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.GENERIC"
msgid "Do I look like a farmer?"
msgstr "Trông tôi có giống nông dân lắm à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.GROWING"
msgid "I have better things to do than watch plants grow."
msgstr "Tôi có khối việc quan trọng hơn là đứng nhìn thực vật lớn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "It needs to be... refreshed."
msgstr "Nó cần được... làm mới lại."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_HOE"
msgid "Am I to be reduced to a common farmhand?"
msgstr "Bộ tôi bị giáng cấp xuống làm tá túc nông dân thường dân à?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.BURNING"
msgid "Not the garden!"
msgstr "Đừng động đến khu vườn!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.FULL"
msgid "It's time to reap what I've sown."
msgstr "Đã đến lúc gặt hái những gì tôi đã gieo trồng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "At last, my efforts are rewarded."
msgstr "Cuối cùng thì công sức của tôi cũng được đền đáp."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "Not another blasted weed!"
msgstr "Lại thêm một đám cỏ dại khốn kiếp nữa!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.GENERIC"
msgid "Merely a plant."
msgstr "Chỉ là một loài thực vật thôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.GROWING"
msgid "Nearly there."
msgstr "Sắp được rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "Rotten."
msgstr "Hỏng rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "It's no good to anyone now."
msgstr "Giờ thì chẳng còn tích sự gì nữa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.SEED"
msgid "I'll have to be patient."
msgstr "Tôi đành phải kiên nhẫn vậy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLOW"
msgid "Thankfully it seems capable of doing the work itself."
msgstr "May thay là nó có vẻ tự làm được việc đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLOW_ITEM"
msgid "Some kind of farming implement? I've no interest in such things."
msgstr "Một loại dụng cụ làm nông nào đó à? Tôi chẳng có hứng thú với mấy thứ đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "The blasted things spring up again just as fast as I can remove them."
msgstr "Mấy thứ chết tiệt này cứ mọc lên nhanh như cách tôi nhổ chúng vậy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERFAN"
msgid "Is it windy out or is it just this fan?"
msgstr "Ngoài trời có gió hay là do cái quạt này thế?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERHAT"
msgid "I always considered myself the peacock of people."
msgstr "Tôi luôn tự coi mình là con công của loài người."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERPENCIL"
msgid "Not as elegant as a quill and inkwell, but it'll do."
msgstr "Không thanh lịch bằng bút lông và lọ mực, nhưng thế này cũng tạm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_CANARY"
msgid "Yellow is the color of naivety."
msgstr "Màu vàng là màu của sự ngây thơ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_CROW"
msgid "Black is the color of sleep."
msgstr "Màu đen là màu của giấc ngủ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_ROBIN"
msgid "Red is the color of fire."
msgstr "Màu đỏ là màu của lửa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "Grey is the color of pain."
msgstr "Màu xám là màu của nỗi đau."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEM_PUPPET"
msgid "Better her than me."
msgstr "Thà là cô ta còn hơn là tôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE"
msgid "My life is one obstacle after another."
msgstr "Cuộc đời tôi là hết vật cản này đến chướng ngại khác."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_ELECTRIC.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_ELECTRIC.GENERIC"
msgid "Perhaps it's best left alone."
msgstr "Có lẽ tốt nhất là đừng dây dưa với nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_ELECTRIC.LINKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_ELECTRIC.LINKED"
msgid "I don't trust the power source."
msgstr "Tôi không tin tưởng nguồn điện đó lắm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_ELECTRIC_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_ELECTRIC_ITEM"
msgid "I don't like it."
msgstr "Tôi không thích nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_GATE"
msgid "When one gate closes..."
msgstr "Khi một cánh cổng đóng lại..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_GATE_ITEM"
msgid "A gate for your pocket."
msgstr "Một cánh cổng bỏ túi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_ITEM"
msgid "A fence for your pocket."
msgstr "Một hàng rào bỏ túi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_JUNK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_JUNK"
msgid "Hmph. It'll certainly repel anyone with taste."
msgstr "Hừm. Nó chắc chắn sẽ xua đuổi bất cứ kẻ nào có gu thẩm mỹ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_ROTATOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_ROTATOR"
msgid "What insidious magic. It draws power from eye rolls and groans."
msgstr "Thật là một thứ phép thuật quỷ quái. Nó hút năng lượng từ những cái đảo mắt và tiếng thở dài."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FERTILIZER"
msgid "It's not gentlemanly to carry manure in one's hands."
msgstr "Thật không ra dáng quý ô khi cầm phân bón trên tay."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FESTIVEFISH"
msgid "I don't know what's so festive about it."
msgstr "Tôi chẳng thấy có gì gọi là lễ hội ở cái thứ này cả."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FESTIVE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FESTIVE_BLUEPRINT"
msgid "Positively garish."
msgstr "Lòe loẹt một cách quá đà."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIG"
msgid "A fruit for more refined tastes."
msgstr "Một loại quả dành cho những khẩu vị tinh tế hơn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIGATONI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIGATONI"
msgid "Exquisite."
msgstr "Tuyệt diệu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIGKABAB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIGKABAB"
msgid "Pleasantly sweet."
msgstr "Ngọt ngào dễ chịu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIG_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIG_COOKED"
msgid "Quite decadent."
msgstr "Khá là xa hoa đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREBALLSTAFF"
msgid "A staff after my own heart!"
msgstr "Một cây trượng đúng gu tôi!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRECRACKERS"
msgid "Great for magic tricks."
msgstr "Tuyệt vời cho các trò ảo thuật."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREFLIES.GENERIC"
msgid "How pretty."
msgstr "Đẹp làm sao."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREFLIES.HELD"
msgid "I could squish them if I wanted to."
msgstr "Tôi có thể bóp nát chúng nếu muốn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREHOUND"
msgid "I put fire gems in there as a joke."
msgstr "Tôi nhét mấy viên ngọc lửa vào đó để đùa thôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRENETTLES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRENETTLES"
msgid "Blasted nettles!"
msgstr "Mấy bụi tầm ma chết tiệt!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRENETTLES_DRIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRENETTLES_DRIED"
msgid "They're all shrivelled up."
msgstr "Chúng héo quắt lại hết cả rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPEN"
msgid "Words hold power. Pens too, apparently."
msgstr "Lời nói có sức mạnh. Cả ngòi bút nữa, rõ ràng là vậy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.EMBERS"
msgid "I should attend to that."
msgstr "Tôi nên chú ý đến nó mới được."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.GENERIC"
msgid "A fire pit."
msgstr "Một lò lửa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.HIGH"
msgid "A roaring fire."
msgstr "Một ngọn lửa bùng cháy dữ dội."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.LOW"
msgid "It's getting low."
msgstr "Nó đang nhỏ dần rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.NORMAL"
msgid "It's hot."
msgstr "Nó đang nóng lên."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.OUT"
msgid "It's gone cold."
msgstr "Nó nguội ngắt rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESTAFF"
msgid "A basic enchantment, but effective."
msgstr "Một bùa chú cơ bản, nhưng hiệu quả."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "Not much fuel left."
msgstr "Chẳng còn mấy nhiên liệu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "Quiet before the storm."
msgstr "Sự tĩnh lặng trước cơn bão."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "Begone, fire!"
msgstr "Biến đi, lửa!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH"
msgid "Fresh from the murky depths."
msgstr "Tươi rói từ đáy nước u ám."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHINGNET"
msgid "Not my preferred way to ensnare enemies."
msgstr "Không phải cách ưa thích của tôi để tóm gọn kẻ thù."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHINGROD"
msgid "I will eat for a lifetime."
msgstr "Tôi sẽ đủ ăn cả đời mất."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT"
msgid "Ugh, it's still twitching."
msgstr "Hừ, nó vẫn đang giãy đành đạch kìa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_COOKED"
msgid "Bland... but acceptable."
msgstr "Nhạt nhẽo... nhưng ăn được."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_DRIED"
msgid "My teeth are getting too old for this."
msgstr "Răng tôi già quá rồi nên thấy món này cứng lắm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_SMALL"
msgid "I'm reduced to scavenging scraps."
msgstr "Ta đã rơi đến mức phải đi nhặt nhạnh từng mảnh vụn rồi sao."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "That was barely an appetizer."
msgstr "Cái đó chưa đủ làm món khai vị nữa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_SMALL_DRIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_SMALL_DRIED"
msgid "My teeth are getting too old for this."
msgstr "Răng tôi già quá rồi nên không nhai nổi món này nữa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHSTICKS"
msgid "These should tide me over."
msgstr "Cái này chắc đủ lót dạ qua bữa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHTACOS"
msgid "Cooked fish in a crunchy shell."
msgstr "Cá rán trong vỏ giòn rụm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH_BOX"
msgid "Ugh, the smell... the things I do for a decent meal."
msgstr "Ối, mùi ghê quá... Những gì ta phải làm vì một bữa ăn đàng hoàng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH_COOKED"
msgid "It still stinks."
msgstr "Nó vẫn thối."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLINT"
msgid "Ow! I cut my finger!"
msgstr "Ái! Đứt tay tôi rồi!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOATINGLANTERN.DEFLATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOATINGLANTERN.DEFLATED"
msgid "Ah well."
msgstr "Thôi đành vậy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOATINGLANTERN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOATINGLANTERN.GENERIC"
msgid "Yes, fine. It's nice."
msgstr "Ừ thì đẹp. Được chưa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOATINGLANTERN.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOATINGLANTERN.HELD"
msgid "Just in case..."
msgstr "Phòng hờ thôi..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOTATIONCUSHION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOTATIONCUSHION"
msgid "Where does it say, \"women and children first\"?"
msgstr "Câu \"phụ nữ và trẻ em trước\" ghi ở chỗ nào thế nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER.GENERIC"
msgid "I am filled with the irrational urge to stomp upon it."
msgstr "Ta lại có cái thôi thúc vô lý muốn dẫm nát nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER.ROSE"
msgid "This is wrong."
msgstr "Cái này sai rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWERHAT"
msgid "Definitely not my style."
msgstr "Chắc chắn không phải gu của tôi rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWERSALAD"
msgid "Leafy goodness."
msgstr "Đầy tinh chất lá cây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_CAVE"
msgid "It's so dark down here."
msgstr "Dưới này tối quá."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_CAVE_WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_CAVE_WITHERED"
msgid "Just great."
msgstr "Tuyệt thật đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_EVIL"
msgid "I like that flower."
msgstr "Ta thích bông hoa đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_WITHERED"
msgid "It got what it deserved."
msgstr "Nó nhận được đúng những gì đáng có."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOLIAGE"
msgid "A meal fit for a peasant."
msgstr "Một bữa ăn xứng tầm dân nghèo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOLIAGE_DRIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOLIAGE_DRIED"
msgid "They're all shrivelled up."
msgstr "Chúng quéo lại hết cả rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOOTBALLHAT"
msgid "Ready for the scrimmage."
msgstr "Sẵn sàng cho trận đấu tập rồi đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FORGETMELOTS"
msgid "Nothing but a common weed."
msgstr "Chẳng khác gì một loài cỏ dại bình thường."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FORGETMELOTS_DRIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FORGETMELOTS_DRIED"
msgid "They're all shrivelled up."
msgstr "Chúng quéo lại hết cả rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FORMAL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FORMAL_BLUEPRINT"
msgid "These garments are absolutely wasted on such base creatures."
msgstr "Những bộ trang phục này hoàn toàn phí phạm cho lũ sinh vật hạ đẳng như thế."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_PIECE"
msgid "Perhaps it is best left in pieces."
msgstr "Có lẽ cứ để nó thành từng mảnh thì hơn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "Was it wise to unleash this upon the world?"
msgstr "Liệu thả thứ này ra thế giới có khôn ngoan không nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "It will be the laughingstock of the demon community."
msgstr "Nó sẽ thành trò cười cho cả cộng đồng quỷ dữ mất."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "The beginnings of some demonic beast."
msgstr "Khởi đầu của một con quái vật ma quái nào đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRESHFRUITCREPES"
msgid "Deserves to be eaten with fine silverware. Sadly, I've just my hands."
msgstr "Xứng đáng được ăn bằng dao nĩa sang trọng. Tiếc là tôi chỉ có đôi tay này."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRIENDLYFRUITFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRIENDLYFRUITFLY"
msgid "As long as it tends to the garden I'll leave it be."
msgstr "Chừng nào nó còn chăm sóc khu vườn thì ta cứ để nó yên."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.DEAD"
msgid "It croaked."
msgstr "Nó ngm củ tỏi rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.GENERIC"
msgid "It jumps and licks things."
msgstr "Nó nhảy nhót và liếm láp mọi thứ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.SLEEPING"
msgid "It looks tired."
msgstr "Trông nó có vẻ mệt rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGFISHBOWL"
msgid "At the end of the day, it's still frog."
msgstr "Cuối cùng thì nó vẫn là ếch thôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGGLEBUNWICH"
msgid "Has a bit of a kick to it."
msgstr "Hơi cay xè một chút đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGLEGS"
msgid "Muscular."
msgstr "Nhiều cơ bắp."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGLEGS_COOKED"
msgid "Stringy."
msgstr "Dai như da bò."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGNEWTON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGNEWTON"
msgid "This recipe has legs."
msgstr "Công thức này có chân rồi đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROZENBANANADAIQUIRI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROZENBANANADAIQUIRI"
msgid "There are better beverages to make."
msgstr "Vẫn còn những loại đồ uống đáng làm hơn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "They aren't very sociable."
msgstr "Họ không được hòa đồng cho lắm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.RIPE"
msgid "I bet it's delicious."
msgstr "Chắc là ngon lắm đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "Sleep is only a temporary escape."
msgstr "Giấc ngủ chỉ là một sự trốn tránh tạm thời."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITFLY"
msgid "Begone, pest!"
msgstr "Biến đi, đồ phá phách!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITFLYFRUIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITFLYFRUIT"
msgid "So this is all it takes to lead."
msgstr "Ra vậy, chỉ thế này là đủ để dẫn dắt rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITMEDLEY"
msgid "This would be great with a simple cheese plate."
msgstr "Món này mà ăn kèm một đĩa phô mai đơn giản thì tuyệt cú mèo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEAXE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEAXE.GENERIC"
msgid "It won't hold together much longer."
msgstr "Nó trụ không nổi lâu nữa đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEAXE.HOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEAXE.HOT"
msgid "I despise working up a sweat..."
msgstr "Ta rất ghét phải đổ mồ hôi..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEAXE.LUKEWARM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEAXE.LUKEWARM"
msgid "Without heat, it's hardly different from an ordinary axe."
msgstr "Không có nhiệt, nó chẳng khác gì một cái rìu bình thường."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEAXE.WARM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEAXE.WARM"
msgid "If I must do physical labor, I can at least do it in relative comfort."
msgstr "Nếu bắt buộc phải lao động chân tay, ít nhất ta cũng muốn làm sao cho tương đối thoải mái."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEHAMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEHAMMER.GENERIC"
msgid "It won't hold together much longer."
msgstr "Nó trụ không nổi lâu nữa đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEHAMMER.HOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEHAMMER.HOT"
msgid "I despise working up a sweat..."
msgstr "Ta rất ghét phải đổ mồ hôi..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEHAMMER.LUKEWARM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEHAMMER.LUKEWARM"
msgid "Without heat, it's hardly different from an ordinary hammer."
msgstr "Không có nhiệt, nó chẳng khác gì một cái búa bình thường."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEHAMMER.WARM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEHAMMER.WARM"
msgid "If I must do physical labor, I can at least do it in relative comfort."
msgstr "Nếu bắt buộc phải lao động chân tay, ít nhất ta cũng muốn làm sao cho tương đối thoải mái."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEPICKAXE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEPICKAXE.GENERIC"
msgid "It won't hold together much longer."
msgstr "Nó trụ không nổi lâu nữa đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEPICKAXE.HOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEPICKAXE.HOT"
msgid "I despise working up a sweat..."
msgstr "Ta rất ghét phải đổ mồ hôi..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEPICKAXE.LUKEWARM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEPICKAXE.LUKEWARM"
msgid "Without heat, it's hardly different from an ordinary pickaxe."
msgstr "Không có nhiệt, nó chẳng khác gì một chiếc cuốc chim bình thường."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEPICKAXE.WARM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEPICKAXE.WARM"
msgid "If I must do physical labor, I can at least do it in relative comfort."
msgstr "Nếu bắt buộc phải lao động chân tay, ít nhất ta cũng muốn làm sao cho tương đối thoải mái."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLESHOVEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLESHOVEL.GENERIC"
msgid "It won't hold together much longer."
msgstr "Nó trụ không nổi lâu nữa đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLESHOVEL.HOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLESHOVEL.HOT"
msgid "I despise working up a sweat..."
msgstr "Ta rất ghét phải đổ mồ hôi..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLESHOVEL.LUKEWARM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLESHOVEL.LUKEWARM"
msgid "Without heat, it's hardly different from an ordinary shovel."
msgstr "Không có nhiệt, nó chẳng khác gì một cái xẻng bình thường."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLESHOVEL.WARM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLESHOVEL.WARM"
msgid "If I must do physical labor, I can at least do it in relative comfort."
msgstr "Nếu bắt buộc phải lao động chân tay, ít nhất ta cũng muốn làm sao cho tương đối thoải mái."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLE_FARM_HOE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLE_FARM_HOE.GENERIC"
msgid "It won't hold together much longer."
msgstr "Nó trụ không nổi lâu nữa đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLE_FARM_HOE.HOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLE_FARM_HOE.HOT"
msgid "I despise working up a sweat..."
msgstr "Ta rất ghét phải đổ mồ hôi..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLE_FARM_HOE.LUKEWARM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLE_FARM_HOE.LUKEWARM"
msgid "Without heat, it's hardly different from an ordinary garden hoe."
msgstr "Không có nhiệt, nó chẳng khác gì một chiếc cuốc làm vườn bình thường."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLE_FARM_HOE.WARM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLE_FARM_HOE.WARM"
msgid "If I must do physical labor, I can at least do it in relative comfort."
msgstr "Nếu bắt buộc phải lao động chân tay, ít nhất ta cũng muốn làm sao cho tương đối thoải mái."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FURTUFT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FURTUFT"
msgid "Not quite enough for a rug."
msgstr "Vẫn chưa đủ lông để làm một cái thảm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUSED_SHADELING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUSED_SHADELING"
msgid "They grow up so fast."
msgstr "Chúng lớn nhanh thật đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUSED_SHADELING_BOMB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUSED_SHADELING_BOMB"
msgid "That is one persistent tail."
msgstr "Đúng là một cái đuôi dai như đỉa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARGOYLE_HOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARGOYLE_HOUND"
msgid "Try and get me now. Ha!"
msgstr "Giờ thì thử bắt ta xem nào. Hah!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARGOYLE_WEREPIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARGOYLE_WEREPIG"
msgid "Not so tough."
msgstr "Cũng chẳng cứng đầu lắm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC"
msgid "I suppose that's why there are no vampires around."
msgstr "Thảo nào chẳng có con ma cà rồng nào quanh đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC_COOKED"
msgid "I wonder if it still wards away the undead."
msgstr "Tự hỏi liệu nó còn xua đuổi được xác sống nữa không."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC_OVERSIZED"
msgid "An unreasonably enormous clump of garlic."
msgstr "Một củ tỏi to đến mức vô lý."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Tôi có nên trồng loại thực vật này không nhỉ?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GAZPACHO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GAZPACHO"
msgid "It smells much nicer going in than coming back out."
msgstr "Ngửi lúc trôi vào dễ chịu hơn nhiều lúc nôn ra."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEARS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEARS"
msgid "My pets! What has become of you?"
msgstr "Những thú cưng của ta! Các ngươi đã thành ra thế này sao?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB.GENERIC"
msgid "Blegh."
msgstr "Eo ôi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB.HAS_CHARACTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB.HAS_CHARACTER"
msgid "This one is occupied."
msgstr "Cái này có chủ rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB.HAS_ITEM"
msgid "Don't expect me to reach in there."
msgstr "Đừng có hồng bảo tôi thò tay vào trong đó nhé."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_BOTTLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_BOTTLE"
msgid "Wilson can take it on a picnic."
msgstr "Wilson có thể mang nó đi dã ngoại."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_STORAGE.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_STORAGE.FULL"
msgid "Somebody taste it first!"
msgstr "Ai đó thử nếm trước đi!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_STORAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_STORAGE.GENERIC"
msgid "I don't trust that infernal jelly."
msgstr "Tôi không tài nào tin tưởng nổi thứ thạch địa ngục đó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_STORAGE_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_STORAGE_KIT"
msgid "Pass. I don't do sticky."
msgstr "Thôi bỏ đi. Tôi không thích mấy thứ dính dấp đâu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEMSOCKET.GEMS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEMSOCKET.GEMS"
msgid "The fuel needs a focus."
msgstr "Nhiên liệu cần phải có một tiêu điểm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEMSOCKET.VALID
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEMSOCKET.VALID"
msgid "This one's ready."
msgstr "Cái này sẵn sàng rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GENERIC_CORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GENERIC_CORPSE.BURNING"
msgid "The pragmatic approach."
msgstr "Cách tiếp cận thực tế đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GENERIC_CORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GENERIC_CORPSE.GENERIC"
msgid "Apologies, Higgsbury. I thought that stench was coming from you."
msgstr "Xin lỗi nhé, Higgsbury. Tôi cứ tưởng cái mùi hôi thối đó phát ra từ cậu cơ chứ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GENERIC_CORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GENERIC_CORPSE.REVIVING"
msgid "It can't even die properly."
msgstr "Đến chết cũng không cho nên hồn."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GESTALT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GESTALT"
msgid "It communes with us through them."
msgstr "Nó giao tiếp với chúng ta thông qua chúng."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GESTALT_CAGE.FILLED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GESTALT_CAGE.FILLED"
msgid "Not so tough now, are you?"
msgstr "Giờ thì còn dám hống hách nữa không, hả?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GESTALT_CAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GESTALT_CAGE.GENERIC"
msgid "Ugh. Empty."
msgstr "Hừ. Trống không."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GESTALT_GUARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GESTALT_GUARD"
msgid "I think it would be best to keep my distance."
msgstr "Tôi nghĩ tốt nhất là nên giữ khoảng cách."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GESTALT_GUARD_EVOLVED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GESTALT_GUARD_EVOLVED"
msgid "Oh, bygones be bygones and such."
msgstr "Ồ, chuyện cũ bỏ qua đi, đại loại thế."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOST"
msgid "It remembers me!"
msgstr "Nó vẫn nhớ ta kìa!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTFLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTFLOWER"
msgid "I hope they found peace."
msgstr "Mong là họ đã tìm thấy sự bình yên."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTFLOWERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTFLOWERHAT"
msgid "Talk about a near death experience."
msgstr "Cảm giác suýt chết là thế đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_ATTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_ATTACK"
msgid "It appears someone has been toying with the dark arts and crafts."
msgstr "Xem ra có kẻ đang táy máy với hắc thuật rồi đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_FASTREGEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_FASTREGEN"
msgid "It appears someone has been toying with the dark arts and crafts."
msgstr "Xem ra có kẻ đang táy máy với hắc thuật rồi đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_LUNAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_LUNAR"
msgid "It appears someone has been toying with the dark arts and crafts."
msgstr "Xem ra có kẻ đang táy máy với hắc thuật rồi đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_RETALIATION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_RETALIATION"
msgid "It appears someone has been toying with the dark arts and crafts."
msgstr "Xem ra có kẻ đang táy máy với hắc thuật rồi đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_REVIVE
