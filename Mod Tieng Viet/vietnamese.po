#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_PLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_PLANT"
msgid "We can take a small bit of the Cawnival wherever we go."
msgstr "Chúng ta có thể mang một chút Lễ Hội Quạ theo bất cứ đâu."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_PLANT_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_PLANT_KIT"
msgid "Nearly there."
msgstr "Sắp xong rồi đấy."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALFOOD_CORNTEA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALFOOD_CORNTEA"
msgid "I think I'll go find a nice refreshing soul instead."
msgstr "Chắc ta đi tìm một linh hồn tươi mát nào đó để thay thế thôi."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD"
msgid "Imagine what a fun prank it would be to replace these with real worms..."
msgstr "Thử tưởng tượng việc thay thế mấy thứ này bằng giun thật sẽ là một trò đùa tai quái thế nào nhỉ..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT"
msgid "We're almost ready for the fun to begin!"
msgstr "Chúng ta gần như đã sẵn sàng để bắt đầu cuộc vui rồi!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST"
msgid "A small trap door is set in the floor."
msgstr "Một cánh cửa bẫy nhỏ được lắp dưới sàn."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC"
msgid "Allow me to propose a trade: one shiny trinket to play your game."
msgstr "Cho phép ta đề xuất một cuộc trao đổi: một món đồ lấp lánh để đổi lấy vé chơi trò chơi của bạn nhé."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING"
msgid "You must be quick to feed the chicks."
msgstr "Bạn phải thật nhanh tay để cho đám gà con ăn đấy."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_GOLFBALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_GOLFBALL"
msgid "Roll and roam, far from home!"
msgstr "Lăn và bay đi, thật xa khỏi tổ ấm!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_GOLFCLUB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_GOLFCLUB"
msgid "Tap it light, send it right... or out of sight!"
msgstr "Gõ nhẹ một cú, đưa bóng đi đúng hướng... hoặc bay khỏi tầm mắt luôn!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_DIY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_DIY"
msgid "It shall be a design of mine!"
msgstr "Nó sẽ mang phong cách của chính ta!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_EASY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_EASY"
msgid "Oh pleasey, so easy!"
msgstr "Ôi dễ quá đi, dễ như ăn bánh!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_HARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_HARD"
msgid "What the putt?!"
msgstr "Cú đánh quái quỷ gì thế này?!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_MEDIUM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_MEDIUM"
msgid "Good stuff, not too tough!"
msgstr "Được phết đấy, không quá khó đâu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_GOLFPROP_CUTOUT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_GOLFPROP_CUTOUT"
msgid "It mocks me as it blocks me!"
msgstr "Nó cứ nhạo báng ta trong lúc ngáng đường ta!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_GOLFPROP_FAN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_GOLFPROP_FAN"
msgid "The ball goes where it blows."
msgstr "Bóng lăn đi theo hướng gió thổi."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_GOLFPROP_FENCE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_GOLFPROP_FENCE"
msgid "A tidy frame for a bounded game!"
msgstr "Một khung cảnh ngăn nắp cho một trò chơi có giới hạn!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_GOLFPROP_MOVINGWALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_GOLFPROP_MOVINGWALL"
