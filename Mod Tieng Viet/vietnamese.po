msgstr "Xin lỗi-moi, tôi đã nhầm bạn với cà rốt của tôi!"

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.PICKUP.NOTMINE_YOTC.2
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.PICKUP.NOTMINE_YOTC.2"
