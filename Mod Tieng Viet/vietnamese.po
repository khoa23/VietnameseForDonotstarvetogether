msgstr "Cẩn thận chim non kìa!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC"
msgid "It's a little bird door."
msgstr "Đó là một cánh cửa chim nhỏ."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING"
msgid "Are the bugs the bad guys?"
msgstr "Lũ côn trùng là kẻ xấu à?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT"
msgid "We can help the birds set up."
msgstr "Chúng ta có thể giúp lũ chim dựng lên."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC"
msgid "It'll let us play if we give it something shiny."
msgstr "Nó sẽ cho ta chơi nếu đưa thứ gì đó lấp lánh."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING"
msgid "We're winning!"
msgstr "Chúng ta thắng rồi!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_BALL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_BALL"
msgid "We wanna play with it!"
msgstr "Chúng ta muốn chơi với nó!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_CROWKID
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_CROWKID"
msgid "Are you a boy who was eaten by a crow?"
msgstr "Cậu là cậu bé bị quạ ăn thịt phải không?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_GAMETOKEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_GAMETOKEN"
msgid "Wow, it's so shiny!"
msgstr "Chao ôi, lấp lánh quá!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_HOST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_HOST"
msgid "That's the biggest crow we've ever seen!"
msgstr "Đó là con quạ bự nhất mà chúng ta từng thấy!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PLAZA.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
msgid "It would look better with more decorations around."
msgstr "Trông sẽ đẹp hơn nếu có thêm nhiều đồ trang trí xung quanh."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
msgid "We're pretty sure we can fit even more decorations around it!"
msgstr "Chúng tôi khá chắc là có thể nhét thêm nhiều đồ trang trí xung quanh nó đấy!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3"
