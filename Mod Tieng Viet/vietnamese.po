msgstr "Thấy cả bóng cơ bắp cuồn cuộn của Wolfgang trong này này!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_GLASS.INFUSED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_GLASS.INFUSED"
msgid "Is strange and glowy."
msgstr "Trông lạ lắm và đang phát sáng nữa."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_GOGGLESHAT"
