msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_FOREST"
msgid "Floor or ceiling, depending on your perspective."
msgstr "Là sàn nhà hay trần nhà, tùy vào góc nhìn của ngươi thôi."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_FUNGUS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_FUNGUS"
msgid "Floor or ceiling, depending on your perspective."
msgstr "Là sàn nhà hay trần nhà, tùy vào góc nhìn của ngươi thôi."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_FUNGUS_GREEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_FUNGUS_GREEN"
msgid "Floor or ceiling, depending on your perspective."
msgstr "Là sàn nhà hay trần nhà, tùy vào góc nhìn của ngươi thôi."

