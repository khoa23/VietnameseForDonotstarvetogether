msgstr "Biết rồi biết rồi, cái đó tôi rõ rồi."

#. STRINGS.CHARACTERS.WANDA.ACTIONFAIL.TEACH.MESSAGEBOTTLEMANAGER_NOT_FOUND
msgctxt "STRINGS.CHARACTERS.WANDA.ACTIONFAIL.TEACH.MESSAGEBOTTLEMANAGER_NOT_FOUND"
