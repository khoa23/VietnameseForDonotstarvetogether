msgstr "Tội nghiệp chết như đinh đóng cửa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KOALEFANT_SUMMER"
