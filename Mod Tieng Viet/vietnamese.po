msgstr "Cậu Walter đó lại đang mưu tính gì thế nhỉ?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SLINGSHOT_HANDLE_JELLY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SLINGSHOT_HANDLE_JELLY"
msgid "What is that Walter up to now?"
msgstr "Cậu Walter đó lại đang mưu tính gì thế nhỉ?"

