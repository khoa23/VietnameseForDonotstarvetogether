msgstr "Tôi đã đến đúng thời gian, nhưng nhầm không gian."

#. STRINGS.CHARACTERS.WANDA.ACTIONFAIL.TELLSTORY.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.ACTIONFAIL.TELLSTORY.GENERIC"
msgid "only_used_by_walter"
msgstr "chỉ_được_sử_dụng_bởi_walter"

