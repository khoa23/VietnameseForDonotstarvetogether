msgstr "Nó cần một đồng xu để bắt đầu buổi tiệc đánh golf này!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLF_TEE.INACTIVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CARNIVALGAME_GOLF_TEE.INACTIVE"
