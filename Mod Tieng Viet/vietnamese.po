msgstr "Cây bụi nhão."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED"
msgid "Mushtree smells unhealthy."
msgstr "Cây nấm có mùi không tốt cho sức khỏe."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "Woah! It's even bigger!"
msgstr "Ôi! Nó thậm chí còn lớn hơn!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "Big mushtree is big."
msgstr "Big mushtree là lớn."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED"
