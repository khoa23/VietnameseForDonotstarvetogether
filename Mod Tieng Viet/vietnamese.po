msgstr "Chúng tôi đã làm được!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_CRAWLER_LEVER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_CRAWLER_LEVER"
