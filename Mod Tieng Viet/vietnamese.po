msgstr "Tôi có thể đi ăn một chút gì đó."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_AVOID_FORK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_AVOID_FORK"
