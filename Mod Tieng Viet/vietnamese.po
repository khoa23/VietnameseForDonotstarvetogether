msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.USEITEMON.BEEF_BELL_HAS_BEEF_ALREADY"
msgid "I've got my own beefalo to worry aboot."
msgstr "Tôi còn có con Bò Lai của riêng mình phải lo đây."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.USEITEMON.BEEF_BELL_INVALID_TARGET
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.USEITEMON.BEEF_BELL_INVALID_TARGET"
msgid "Better try something else, eh?"
msgstr "Tốt hơn là thử cái khác đi, phải không?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.USEITEMON.CANNOT_FIX_DRONE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.USEITEMON.CANNOT_FIX_DRONE"
msgid "It's beyond repair."
msgstr "Nó quá hỏng để mà sửa rồi."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.USEITEMON.NOT_MINE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.USEITEMON.NOT_MINE"
msgid "She's not mine."
msgstr "Cô ấy không phải của tôi."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS"
msgid "Now's not the time, eh?"
msgstr "Bây giờ không phải lúc đâu, phải không?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY"
msgid "You see another key around here, Lucy?"
msgstr "Cậu có thấy chiếc chìa khóa nào quanh đây không, Lucy?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY"
msgid "That was the wrong key, eh?"
msgstr "Đó là chiếc chìa khóa sai rồi, phải không?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.WRAPBUNDLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.WRAPBUNDLE.EMPTY"
msgid "I need some things to wrap first, eh?"
msgstr "Tôi cần vài thứ để gói lại trước đã, phải không?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.WRITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.WRITE.GENERIC"
msgid "No thanks. I have terrible writing."
msgstr "Thôi khỏi. Chữ viết của tôi tệ lắm."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.WRITE.INUSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.WRITE.INUSE"
msgid "If I could just... scooch in there after you..."
msgstr "Nếu tôi có thể... lách vào đó sau cậu..."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.YOTB_STARTCONTEST.ALREADYACTIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.YOTB_STARTCONTEST.ALREADYACTIVE"
msgid "He must be out and aboot somewhere else."
msgstr "Chắc cậu ta đang đi lông nhông ở đâu đó rồi."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK"
msgid "What, is the contest not open to residents of Canada?"
msgstr "Cái gì, cuộc thi không dành cho cư dân Canada à?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.YOTB_STARTCONTEST.NORESPONSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.YOTB_STARTCONTEST.NORESPONSE"
msgid "Off wandering, I bet."
msgstr "Chắc lại đi lang thang rồi, tôi cá thế."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE"
msgid "Hm. Busy."
msgstr "Hừm. Bận lắm."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN"
msgid "Nothin' new here."
msgstr "Chẳng có gì mới ở đây cả."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL_GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL_GENERIC"
msgid "Sorry, I can't do that."
msgstr "Xin lỗi, tôi không thể làm thế được."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ACCOMPLISHMENT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ACCOMPLISHMENT"
msgid "Lucy is going to be so proud of me!"
msgstr "Lucy sẽ tự hào về tôi lắm đây!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ACCOMPLISHMENT_DONE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ACCOMPLISHMENT_DONE"
msgid "That's a wrap, eh!"
msgstr "Thế là xong việc nhé!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ACIDBATS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ACIDBATS"
msgid "You hear something, Lucy?"
msgstr "Cậu có nghe thấy gì không, Lucy?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ADVENTUREFAIL
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ADVENTUREFAIL"
msgid "Oh well. I gave it a good try."
msgstr "Thôi được rồi. Tôi đã cố gắng hết sức mà."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_SINKHOLE.1
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_SINKHOLE.1"
msgid "Pothole incoming."
msgstr "Hố sụt chuẩn bị xuất hiện kìa."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_SINKHOLE.2
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_SINKHOLE.2"
msgid "Take cover!"
msgstr "Tìm chỗ ẩn nấp mau!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_SINKHOLE.3
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_SINKHOLE.3"
msgid "Dangerous 'round here."
msgstr "Quanh đây nguy hiểm phết."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_TRIBUTE.1
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_TRIBUTE.1"
msgid "Maybe put the sinkholes on pause, eh?"
msgstr "Hay là tạm dừng mấy cái hố sụt lại đi, phải không?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_TRIBUTE.2
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_TRIBUTE.2"
msgid "I got a tribute for you, eh?"
msgstr "Tôi có một món quà cống nạp cho cậu đấy, phải không?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_TRIBUTE.3
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_TRIBUTE.3"
msgid "This here's for you, eh?"
msgstr "Cái này là dành cho cậu đấy, phải không?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE"
msgid "It's fillin' my head with ideas!"
msgstr "Nó đang lấp đầy đầu tôi những ý tưởng kìa!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ARCHIVE_NO_POWER
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ARCHIVE_NO_POWER"
msgid "Well, that one's gonna stay a mystery for a while longer."
msgstr "Chà, cái đó sẽ còn là điều bí ẩn thêm một thời gian nữa đây."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE"
msgid "Guess I knew that one already."
msgstr "Chắc tôi biết cái đó từ trước rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATRIUM_DESTABILIZING.1
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATRIUM_DESTABILIZING.1"
msgid "We better hightail it out of here."
msgstr "Chúng ta tốt nhất nên chuồn khỏi đây thật nhanh."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATRIUM_DESTABILIZING.2
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATRIUM_DESTABILIZING.2"
msgid "Let's skedaddle!"
msgstr "Chuồn thôi!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATRIUM_DESTABILIZING.3
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATRIUM_DESTABILIZING.3"
msgid "There'll be trouble if we don't leave."
msgstr "Sẽ có rắc rối lớn nếu chúng ta không rời đi đấy."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATTACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATTACH_BUFF_ATTACK"
msgid "I feel strong as a grizzly bear!"
msgstr "Tôi cảm thấy khỏe như một con gấu xám vậy!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK"
msgid "Careful you don't get zapped, eh!"
msgstr "Cẩn thận kẻo bị giật điện đấy nhé!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY"
msgid "I could stand under Niagara Falls and stay dry!"
msgstr "Tôi có thể đứng dưới thác Niagara mà vẫn khô ráo ấy chứ!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION"
msgid "I'm feelin' a heckuva lot tougher now!"
msgstr "Tôi cảm thấy trâu bò hơn nhiều rồi đấy!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE"
msgid "This stuff will wake you right up!"
msgstr "Thứ này sẽ làm bạn tỉnh như sáo ngay!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS"
msgid "Time to roll up our sleeves, eh Lucy?"
msgstr "Đã đến lúc xắn tay áo lên rồi nhỉ Lucy?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BECOMEGHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BECOMEGHOST"
msgid "oOooOOOO!!"
msgstr "oOooOOOO!!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BEES
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BEES"
msgid "Bees! Bees!"
msgstr "Ong! Ong kìa!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BOAT_LEAK"
msgid "All this water is making me very anxious."
msgstr "Mấy thứ nước này làm tôi lo lắng quá."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BOAT_SINK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BOAT_SINK"
msgid "Hold on, Lucy!"
msgstr "Bám chặt vào nhé, Lucy!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BOOMERANG"
msgid "Sorry! Clumsy me!"
msgstr "Xin lỗi nhé! Tại tôi vụng về quá!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BRAVERY_POTION
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BRAVERY_POTION"
msgid "Glad that's over. Never thought I'd be scared of trees."
msgstr "May quá qua rồi. Chưa bao giờ nghĩ có ngày mình lại sợ cây cối đấy."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BURNT"
msgid "Ouch, that's hot!"
msgstr "Ái, nóng quá!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CALL_BEEF
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CALL_BEEF"
msgid "Hey bud, over here!"
msgstr "Này bạn hiền, qua đây nào!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CANFIX
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CANFIX"
msgid "\nI think I can fix this!"
msgstr "Tôi nghĩ mình có thể sửa được cái này!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS"
msgid "Dangit, I'm missing a few things."
msgstr "Chết tiệt, tôi thiếu vài thứ rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CANNOT_BUILD.NO_STATION
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CANNOT_BUILD.NO_STATION"
msgid "I'm gonna need a proper workstation."
msgstr "Tôi sẽ cần một cái bàn làm việc đàng hoàng."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CANNOT_BUILD.NO_TECH
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CANNOT_BUILD.NO_TECH"
msgid "That one might take some lookin' into."
msgstr "Cái đó có lẽ phải nghiên cứu thêm."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CANTBUILDHERE_YOTB_POST
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CANTBUILDHERE_YOTB_POST"
msgid "Better put this closer to the judge's booth."
msgstr "Tốt hơn là đặt cái này gần rạp giám khảo hơn."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CANT_ESCAPE_CURSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CANT_ESCAPE_CURSE"
msgid "It's stickin' to me like tree sap!"
msgstr "Nó dính chặt vào người tôi như nhựa cây vậy!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP"
msgid "Now's not the best time to catch some zeds!"
msgstr "Bây giờ không phải lúc thích hợp để ngủ gật đâu!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CARRAT_ERROR_STUNNED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CARRAT_ERROR_STUNNED"
msgid "We shoulda worked more on those reflexes, eh?"
msgstr "Lẽ ra chúng ta nên luyện tập phản xạ nhiều hơn nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CARRAT_ERROR_WALKING
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CARRAT_ERROR_WALKING"
msgid "You've gotta move faster than that!"
msgstr "Cậu phải di chuyển nhanh hơn thế chứ!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1"
msgid "Seems like its sense of direction isn't the greatest, eh Lucy?"
msgstr "Có vẻ như khả năng định hướng của nó không được tốt cho lắm nhỉ Lucy?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2"
msgid "How aboot you try going the other way?"
msgstr "Hay là cậu thử đi hướng ngược lại xem sao?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CARRAT_START_RACE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CARRAT_START_RACE"
msgid "Aaaaand go!"
msgstr "Và... bắt đầu!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CAVEIN
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CAVEIN"
msgid "Sounds like some trouble up above."
msgstr "Nghe có vẻ có rắc rối gì ở trên đó rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CHAIR_ON_FIRE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CHAIR_ON_FIRE"
msgid "This is fine, eh."
msgstr "Vẫn ổn chán, phải không."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CHARLIE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CHARLIE"
msgid "Who's there, eh?"
msgstr "Ai đấy, hả?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CHARLIESAVE.1
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CHARLIESAVE.1"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CHARLIE_ATTACK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CHARLIE_ATTACK"
msgid "Yeouch! That was rough!"
msgstr "Ái chà! Đau phết!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COACH.1
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COACH.1"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COACH.2
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COACH.2"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COACH.3
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COACH.3"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COACH.4
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COACH.4"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COACH.5
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COACH.5"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COACH.6
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COACH.6"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COACH.7
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COACH.7"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COACH.8
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COACH.8"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COACH.9
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COACH.9"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COLD"
msgid "It's a bit chilly out here!"
msgstr "Ngoài này hơi lạnh đấy!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COMPASS_OUT"
msgid "I'll always have the North in my heart."
msgstr "Tôi sẽ luôn hướng về phương Bắc trong tim mình."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COZY_SLEEP
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COZY_SLEEP"
msgid "Sorry Luce, was I snorin'?"
msgstr "Xin lỗi nhé Luce, có phải anh ngáy không?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CRAFTING_FAIL"
msgid "I can't do that right now."
msgstr "Tôi không làm thế lúc này được."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DAMP"
msgid "A bit damp, eh?"
msgstr "Hơi ẩm ướt nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DEERCLOPS"
msgid "What was that?"
msgstr "Cái gì thế nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DESPAWN"
msgid "This feels strangely familiar..."
msgstr "Cảm giác này quen thuộc đến kỳ lạ..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DETACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DETACH_BUFF_ATTACK"
msgid "Sorry, all the fight's gone out of me."
msgstr "Xin lỗi, tôi hết tinh thần chiến đấu rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK"
msgid "Power's out, eh?"
msgstr "Hết điện rồi à?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY"
msgid "I can feel the dampness creepin' back in."
msgstr "Tôi có thể cảm thấy hơi ẩm đang ngấm trở lại rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION"
msgid "Anyone got a spare hockey helmet?"
msgstr "Có ai có mũ khúc côn cầu dự phòng không?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE"
msgid "I'm gettin' tired, I think it's wearing off."
msgstr "Tôi bắt đầu thấy mệt rồi, chắc nó sắp hết tác dụng."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS"
msgid "That's enough hustlin' around for now."
msgstr "Thế là đủ bận rộn cho bây giờ rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DIG_DISEASE_WARNING"
msgid "Fixed'r right up."
msgstr "Sửa lại ngon lành rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DUSK"
msgid "It's almost my bedtime."
msgstr "Sắp đến giờ đi ngủ của tôi rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.GENERIC"
msgid "Tasty!"
msgstr "Ngon phết!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.INVALID
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.INVALID"
msgid "I don't think my teeth could cut through that."
msgstr "Tôi không nghĩ răng mình nhai nổi cái đó đâu."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.PAINFUL
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.PAINFUL"
msgid "That was past the expiry date."
msgstr "Cái đó quá hạn sử dụng mất rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.SPOILED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.SPOILED"
msgid "That was a wee bit manky."
msgstr "Cái đó hơi bị ôi thiu một chút."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.STALE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.STALE"
msgid "I got to that one just in time."
msgstr "Tôi ăn cái đó vừa đúng lúc luôn."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.YUCKY"
msgid "I'd rather chew on blubber balls."
msgstr "Thà gặm bóng mỡ cá voi còn hơn."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EATING_NOT_FEASTING
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EATING_NOT_FEASTING"
msgid "I wouldn't feel good aboot keeping this all to myself."
msgstr "Tôi thấy không ổn lắm nếu cứ giữ hết đống này cho riêng mình."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ELIXIR_BOOSTED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ELIXIR_BOOSTED"
msgid "That's alright, eh."
msgstr "Cũng được đấy chứ."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ELIXIR_GHOSTVISION
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ELIXIR_GHOSTVISION"
msgid "Here's to seeing things in a different light."
msgstr "Nào, cùng nhìn nhận mọi thứ theo một lăng kính khác nào."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ELIXIR_PLAYER_SPEED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ELIXIR_PLAYER_SPEED"
msgid "We are really movin', Luce!"
msgstr "Chúng ta đang chạy nước rút đấy, Luce!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ELIXIR_TOO_SUPER
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ELIXIR_TOO_SUPER"
msgid "I'll pass on that one."
msgstr "Cái đó thì tôi xin nhường."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.1"
msgid "Hnff..."
msgstr "Hừm..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.10
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.10"
msgid "Huff... huff..."
msgstr "Hộc... hộc..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.2"
msgid "No... Don't get up... Lucy..."
msgstr "Không... Đừng dậy mà... Lucy..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.3"
msgid "Heavy... Eh...?"
msgstr "Nặng quá... Hả...?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.4"
msgid "...oof..."
msgstr "...hự..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.5"
msgid "I'll keep... lumberin' along..."
msgstr "Tôi sẽ tiếp tục... lê bước..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.6"
msgid "No point... complainin'..."
msgstr "Than thở... cũng chẳng ích gì..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.7"
msgid "Work's... gotta get done..."
msgstr "Việc... vẫn phải làm thôi..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.8
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.8"
msgid "Nothin' like... honest work..."
msgstr "Không gì bằng... lao động chân chính..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.9
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.9"
msgid "I'm more of a chopper than a lifter..."
msgstr "Tôi hợp với việc đốn củi hơn là bốc vác..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENGINEERING_CAN_UPGRADE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENGINEERING_CAN_UPGRADE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENTER_DARK"
msgid "Who turned out the lights?"
msgstr "Ai vừa tắt đèn thế?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENTER_LIGHT"
msgid "Brilliance!"
msgstr "Sáng chói lọi!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EXIT_GELBLOB
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EXIT_GELBLOB"
msgid "I think some got in my mouth!"
msgstr "Chắc có thứ dính vào miệng tôi rồi!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EYEOFTERROR_ARRIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EYEOFTERROR_ARRIVE"
msgid "That's not what I was looking for, eh!"
msgstr "Đây không phải thứ tôi đang tìm kiếm, phải không!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EYEOFTERROR_FLYAWAY
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EYEOFTERROR_FLYAWAY"
msgid "Daylight's too much for that big ol' eye, eh?"
msgstr "Ánh sáng ban ngày quá sức chịu đựng với con mắt to lớn đó à?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EYEOFTERROR_FLYBACK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EYEOFTERROR_FLYBACK"
msgid "I'll cut you down for good this time!"
msgstr "Lần này tôi sẽ hạ gục ngươi cho bằng được!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FAN_OUT"
msgid "I guess I'll just have to suffer now."
msgstr "Chắc tôi phải chịu đựng tiếp thôi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FERTILIZER_RESEARCHED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FERTILIZER_RESEARCHED"
msgid "I learned a bit more aboot it."
msgstr "Tôi đã học thêm được vài điều về nó rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FIRENETTLE_TOXIN.1
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FIRENETTLE_TOXIN.1"
msgid "Whew, I feel hotter than a forest fire."
msgstr "Phù, tôi thấy nóng như đang giữa một đám cháy rừng vậy."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FIRENETTLE_TOXIN.2
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FIRENETTLE_TOXIN.2"
msgid "Guess I shouldn't have touched that plant, eh?"
msgstr "Chắc lẽ ra tôi không nên chạm vào thực vật đó nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FIRENETTLE_TOXIN_DONE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FIRENETTLE_TOXIN_DONE"
msgid "Glad that's over with."
msgstr "May quá qua rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FLARE_SEEN"
msgid "I should go check out that flare, eh?"
msgstr "Tôi nên đi kiểm tra quả pháo sáng đó xem sao nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FLOATER_HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FLOATER_HELD"
msgid "That was a close one!"
msgstr "Suýt thì tiêu!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FLOATER_LETGO
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FLOATER_LETGO"
msgid "Why'd I let-"
msgstr "Sao mình lại thả-"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FLOAT_SWIM_TIRED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FLOAT_SWIM_TIRED"
msgid "I'm resting, eh."
msgstr "Tôi đang nghỉ ngơi đây."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FOODMEMORY
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FOODMEMORY"
msgid "only_used_by_warly"
msgstr "chỉ_được_sử_dụng_bởi_warly"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FREEDOM"
msgid "I got out!"
msgstr "Tôi thoát rồi!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_GATHER_MERM
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_GATHER_MERM"
msgid "only_used_by_wurt"
msgstr "chỉ_được_sử_dụng_bởi_wurt"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_GHOSTDRAIN"
msgid "I'm goin', like, nutso over here..."
msgstr "Tôi sắp phát điên đến nơi rồi đây..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_GHOST_QUEST
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_GHOST_QUEST"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_GOT_DECON_MISTED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_GOT_DECON_MISTED"
msgid "Clears the head and opens up the pores!"
msgstr "Thanh lọc đầu óc và thông thoáng lỗ chân lông!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE"
msgid "Looks like I'll be needin' another dose of Acid Repellent."
msgstr "Có vẻ tôi sẽ cần thêm một liều Thuốc Chống Axit nữa rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE"
msgid "Is it gettin' warm in here? Might be time for another dose of that balm."
msgstr "Sao ở đây nóng thế nhỉ? Chắc đến lúc dùng thêm một liều thuốc xoa bóp đó rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE"
msgid "We're here!"
msgstr "Chúng ta đến nơi rồi!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT"
msgid "It didn't work, Luce."
msgstr "Không được rồi, Luce."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HIGHRESEARCH"
msgid "Informative."
msgstr "Thật nhiều thông tin bổ ích."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HOT"
msgid "It's so hot out here!"
msgstr "Ngoài này nóng quá đi mất!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HOUNDS"
msgid "There's something out there."
msgstr "Có cái gì ngoài đó kìa."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNGRY"
msgid "I'm getting peckish."
msgstr "Tôi đang thấy hơi đói bụng rồi đây."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNT_AVOID_FORK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNT_AVOID_FORK"
msgid "This trail looks like a skate in the park."
msgstr "Dấu vết này trông dễ như ăn bánh."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "The beastie is nearby."
msgstr "Con quái thú đang ở gần đây."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "I'm more of a woodsman than a hunter anyway."
msgstr "Dù sao thì tôi cũng hợp làm thợ mộc hơn là thợ săn."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "The beastie's tracks washed away."
msgstr "Dấu vết của con quái thú bị nước cuốn trôi mất rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNT_START_FORK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNT_START_FORK"
msgid "Well there's a trail to trouble, eh Luce?"
msgstr "Chà, có dấu hiệu của rắc rối rồi đây Luce nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNT_SUCCESSFUL_FORK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNT_SUCCESSFUL_FORK"
msgid "We got'er cornered, Luce."
msgstr "Chúng ta dồn được nó vào chân tường rồi, Luce."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNT_WRONG_FORK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNT_WRONG_FORK"
msgid "I can feel some beastie's beady eyes on me."
msgstr "Tôi có thể cảm thấy ánh mắt láo liên của con quái nào đó đang nhìn mình."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "Need more poop, eh?"
msgstr "Cần thêm phân bón à?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_INV_FULL"
msgid "I can't carry any more kit."
msgstr "Tôi không mang nổi thêm đồ nữa rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_IS_FEASTING"
msgid "My favourite thing aboot any holiday - eating!"
msgstr "Thứ tôi thích nhất trong mọi dịp lễ - ăn uống!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD"
msgid "Would you look at that! How long have you been hiding there, eh?"
msgstr "Nhìn kìa! Cậu trốn ở đó từ bao giờ thế hả?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "Gotcha."
msgstr "Tóm được rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "Can't hide from me!"
msgstr "Trốn khỏi tôi à!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
msgid "You were right, Luce! They were hiding right here!"
msgstr "Cậu nói đúng đấy, Luce! Chúng trốn ngay ở đây này!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
msgid "So that's where you were hiding, eh?"
msgstr "Hóa ra cậu trốn ở đây à?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE"
msgid "Think that's the last one, eh?"
msgstr "Chắc đây là con cuối cùng rồi nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM"
msgid "Looks like {name} found the last of them."
msgstr "Có vẻ như {name} đã tìm thấy con cuối cùng rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE"
msgid "Let's see, there should only be one left."
msgstr "Để xem nào, chắc chỉ còn lại một con thôi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME"
msgid "Looks like I lost this one."
msgstr "Có vẻ như lần này tôi thua rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP"
msgid "Just aboot outta time..."
msgstr "Sắp hết giờ rồi..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR"
msgid "They wouldn't have cut and run this far."
msgstr "Chúng chắc không chạy xa đến thế này đâu."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN"
msgid "Yep, this looks more like the kinda place they'd hide."
msgstr "Đúng rồi, chỗ này có vẻ giống nơi chúng hay trốn hơn."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN"
msgid "Looks like fun! Mind if I cut in?"
msgstr "Nghe vui phết! Cho tôi tham gia với nhé?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDEANDSEEK_START
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KITCOON_HIDEANDSEEK_START"
msgid "Better hide quick, eh? Here I come!"
msgstr "Trốn cho lẹ vào nhé? Tôi tới đây!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "Monster hosers, incoming."
msgstr "Lũ quái vật phiền phức tới kìa."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KLAUS_ENRAGE"
msgid "I think it's time to run."
msgstr "Tôi nghĩ đến lúc phải chạy rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KLAUS_UNCHAINED"
msgid "You shoulda stayed down."
msgstr "Lẽ ra anh nên nằm yên dưới đó mới phải."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KNOCKEDOUT"
msgid "Ow. What was that?"
msgstr "Ái. Gì thế nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "That tickled a bit, eh?"
msgstr "Nhột phết nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_LIGHTSOUT_SHADOWHAND
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_LIGHTSOUT_SHADOWHAND"
msgid "You see that, Luce? That creepy hand snuffed a torch!"
msgstr "Cậu thấy thế không, Luce? Cái bàn tay đáng sợ đó vừa dập tắt cây đuốc kìa!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_LOWRESEARCH"
msgid "That was barely even worth it, eh?"
msgstr "Cái đó hầu như chẳng đáng công chút nào nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_LUNARGUARDIAN_INCOMING
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_LUNARGUARDIAN_INCOMING"
msgid "Aw heck. Not again."
msgstr "Ôi trời. Lại nữa à."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_LUNARHAIL_BIRD_CORPSES
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_LUNARHAIL_BIRD_CORPSES"
msgid "Kinda sad, but I still hate it."
msgstr "Hơi buồn một chút, nhưng tôi vẫn ghét nó."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS"
msgid "Get'em!"
msgstr "Xử chúng nó!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_LUNAR_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_LUNAR_RIFT_MAX"
msgid "That light's givin' me goosebumps."
msgstr "Ánh sáng đó làm tôi nổi hết cả da gà."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Maybe I've got enough."
msgstr "Chắc tôi có đủ rồi đấy."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MEGA_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MEGA_FLARE_SEEN"
msgid "I hope whoever sent that flare is ready for what's comin'."
msgstr "Tôi mong kẻ bắn quả pháo sáng đó đã sẵn sàng cho những gì sắp tới."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MITEGLAND_DEBUFF.1
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MITEGLAND_DEBUFF.1"
msgid "Guess it was a mistake to eat that thing, eh?"
msgstr "Chắc là sai lầm khi ăn thứ đó nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MITEGLAND_DEBUFF.2
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MITEGLAND_DEBUFF.2"
msgid "Whew... I need something to cool off this wildfire in my belly..."
msgstr "Phù... Tôi cần cái gì đó để làm dịu ngọn lửa trong bụng này lại..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MITEGLAND_DEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MITEGLAND_DEBUFF_DONE"
msgid "My stomach finally cooled off."
msgstr "Cuối cùng thì bụng tôi cũng hạ nhiệt rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MONKEY_CURSE_1
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MONKEY_CURSE_1"
msgid "Uh-oh. This is a familiar feelin'..."
msgstr "Ối. Cảm giác này quen thuộc phết..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MONKEY_CURSE_CHANGE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MONKEY_CURSE_CHANGE"
msgid "Why does this kinda thing keep happening to me?"
msgstr "Sao chuyện này cứ xảy ra với tôi hoài thế nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MONKEY_CURSE_CHANGEBACK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MONKEY_CURSE_CHANGEBACK"
msgid "Whew. Next time I'm turning into something normal, like a moose."
msgstr "Phù. Lần sau tôi sẽ biến thành thứ gì đó bình thường thôi, ví dụ như hươu sừng tấm chẳng hạn."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW"
msgid "Hang on, I'll get you out."
msgstr "Đợi chút, tôi đưa cậu ra."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "I hear something inside."
msgstr "Tôi nghe thấy có tiếng gì đó bên trong."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "There! How's that, buddy?"
msgstr "Đó! Thế nào rồi, bạn hiền?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "Hang on, I'll get you out."
msgstr "Đợi chút, tôi đưa cậu ra."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "I hear something inside."
msgstr "Tôi nghe thấy có tiếng gì đó bên trong."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "There! How's that, buddy?"
msgstr "Đó! Thế nào rồi, bạn hiền?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "Hang on, I'll get you out."
msgstr "Đợi chút, tôi đưa cậu ra."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "I hear something inside."
msgstr "Tôi nghe thấy có tiếng gì đó bên trong."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "There! How's that, buddy?"
msgstr "Đó! Thế nào rồi, bạn hiền?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOONPOTION_FAILED"
msgid "Consider yourself lucky, eh?"
msgstr "Tự thấy mình may mắn đi nhé?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOSQUITOS"
msgid "Skeeters!"
msgstr "Lũ muỗi vắt!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "This beast looks in a bad way, eh."
msgstr "Con thú này có vẻ không ổn lắm nhỉ."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL"
msgid "Those buzzards look different to you, Luce?"
msgstr "Lũ kên kên đó trông lạ lắm phải không Luce?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NODANGERGIFT"
msgid "Now's definitely the wrong time to be celebratin' Christmas."
msgstr "Bây giờ chắc chắn không phải lúc để ăn mừng Giáng sinh đâu."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NODANGERSIESTA"
msgid "Can't siesta, something's chasing me."
msgstr "Không ngủ trưa được đâu, có cái gì đang đuổi theo tôi kìa."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NODANGERSLEEP"
msgid "It's too scary out to sleep."
msgstr "Ngoài này đáng sợ quá không ngủ được."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NODAYSLEEP"
msgid "Only a hoser sleeps during the day."
msgstr "Chỉ có kẻ ngốc mới đi ngủ vào ban ngày."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "I'm not feelin' too restful right now."
msgstr "Tôi không thấy thoải mái lắm lúc này đâu."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOHUNGERSIESTA"
msgid "My belly is rumbling. I'd never be able to relax."
msgstr "Bụng tôi đang kêu rúc rích đây này. Chẳng tài nào thư giãn nổi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOHUNGERSLEEP"
msgid "My belly is too empty to fall asleep."
msgstr "Bụng đói quá không ngủ được."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I'd rather open that with my feet on the ground."
msgstr "Tôi thích mở món đó khi chân chạm đất hơn."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NONIGHTSIESTA"
msgid "I prefer to siesta between chopping sessions, not at night."
msgstr "Tôi thích ngủ trưa giữa các bận đốn củi hơn là vào ban đêm."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "I prefer to siesta between chopping sessions, not at night."
msgstr "Tôi thích ngủ trưa giữa các bận đốn củi hơn là vào ban đêm."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOPUMPKINCARVINGONFIRE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOPUMPKINCARVINGONFIRE"
msgid "Aw. That was my best one yet."
msgstr "Ối. Đó là quả bí ngô đẹp nhất của tôi đấy."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT"
msgid "Hey bud, I can't sleep when it's as bright as daylight."
msgstr "Này bạn hiền, sáng như ban ngày thế này thì tôi ngủ sao được."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOSLEEPONFIRE"
msgid "Not sure that's entirely safe."
msgstr "Không chắc là an toàn trong két sắt đâu nhỉ."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOWARDROBEONFIRE"
msgid "That's okay. I just need a good flannel, anyway."
msgstr "Không sao. Dù sao thì tôi chỉ cần một chiếc áo flannel tốt là đủ."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NO_ABIGAIL_FLOWER
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NO_ABIGAIL_FLOWER"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NO_TRAP"
msgid "Close one!"
msgstr "Suýt thì trúng!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "Yeesh, I look like a real hoser right now."
msgstr "Trời ạ, trông tôi lúc này chẳng khác gì một gã khờ."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "Guess that one got away from me."
msgstr "Chắc con đó sổng mất rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "Nothin' like a day out fishing."
msgstr "Không gì bằng một ngày đi câu cá."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "I could watch the sky and the ocean for hours."
msgstr "Tôi có thể ngắm trời và biển cả tiếng đồng hồ."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "Hm, maybe I should swap out my lure."
msgstr "Hừm, chắc tôi nên đổi mồi câu thôi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "Can't rush it."
msgstr "Không vội được đâu."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "Aw nuts! Sorry for the language, Luce."
msgstr "Á chà đứt dây! Xin lỗi vì văng tục nhé, Luce."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "Thick I'd better tighten the slack."
msgstr "Tôi nghĩ mình nên thu bớt dây chùng lại."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "Watch out, something's coming!"
msgstr "Cẩn thận, có cái gì đang đến kìa!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OFF_SCRIPT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OFF_SCRIPT"
msgid "That didn't seem like part of the play..."
msgstr "Cái đó có vẻ không nằm trong kịch bản..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OTTERBOAT_DENBROKEN
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OTTERBOAT_DENBROKEN"
msgid "Shoulda known breaking that den was a bad idea."
msgstr "Lẽ ra tôi phải biết việc phá cái hang đó là ý tồi rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS"
msgid "Looks like this thing isn't cut out for deep seafaring."
msgstr "Có vẻ thứ này không sinh ra để đi biển sâu."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_PECKED"
msgid "Sorry! I'll try harder!"
msgstr "Xin lỗi! Tôi sẽ cố hơn!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_PETRIFED_TREES"
msgid "No! Not the wood!"
msgstr "Không! Đừng động vào gỗ!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "Well, that's not right."
msgstr "Chà, có gì đó không đúng rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_PIRATES_ARRIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_PIRATES_ARRIVE"
msgid "Hang on Lucy, it sounds like we've got company."
msgstr "Bám chắc vào Lucy, nghe như chúng ta có khách rồi đấy."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_PLANT_RANDOMSEED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_PLANT_RANDOMSEED"
msgid "I'm hopin' it's a maple tree."
msgstr "Tôi hi vọng đó là cây phong."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_PLANT_RESEARCHED.1
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_PLANT_RESEARCHED.1"
msgid "I sure am learnin' a lot aboot gardening!"
msgstr "Tôi học được khối thứ về làm vườn đấy!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_POCKETWATCH_PORTAL
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_POCKETWATCH_PORTAL"
msgid "Looks like I'm still in one piece."
msgstr "Có vẻ tôi vẫn còn nguyên vẹn."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_PREFALLINVOID
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_PREFALLINVOID"
msgid "Save yourself, Lucy!"
msgstr "Tự cứu lấy mình đi, Lucy!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_QUAKE"
msgid "The ground is heaving!"
msgstr "Mặt đất đang chuyển động kìa!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT"
msgid "Maybe we should try somewhere else."
msgstr "Hay là chúng ta thử ở chỗ khác xem."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_RABBITKING_AGGRESSIVE"
msgid "Hear that clawing, Luce?"
msgstr "Cậu có nghe thấy tiếng cào cấu không, Luce?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_RABBITKING_LUCKY"
msgid "Lookit that rabbit, Lucy!"
msgstr "Nhìn con thỏ kìa, Lucy!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_RABBITKING_LUCKYCAUGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_RABBITKING_LUCKYCAUGHT"
msgid "Got'er!"
msgstr "Tóm được rồi!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_RABBITKING_PASSIVE"
msgid "Something's crawling in the dirt."
msgstr "Có cái gì đang bò dưới đất kìa."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_REPELLED"
msgid "That's just impolite, eh."
msgstr "Hơi bất lịch sự đấy nhé, phải không."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_RESEARCH"
msgid "Learnin' keeps your mind sharp. Like an axe."
msgstr "Học tập giúp đầu óc nhạy bén. Giống như một chiếc rìu vậy."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "Lucy'll never let me live that down."
msgstr "Lucy sẽ không bao giờ để tôi quên chuyện đó đâu."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "There we go."
msgstr "Xong rồi đây."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_REVIVING_CORPSE"
msgid "You fell like a tree, eh?"
msgstr "Cậu ngã như đổ cây ấy nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ROYALTY.1
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ROYALTY.1"
msgid "Your Highness!"
msgstr "Điện hạ!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ROYALTY.2
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ROYALTY.2"
msgid "Your Majesty!"
msgstr "Bệ hạ!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ROYALTY.3
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ROYALTY.3"
msgid "My Liege!"
msgstr "Chúa công!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ROYALTY_JOKER.1
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ROYALTY_JOKER.1"
msgid "Your \"Highness\", eh?"
msgstr "Điện hạ \"của cậu\" đấy à?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ROYALTY_JOKER.2
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ROYALTY_JOKER.2"
msgid "Your \"Majesty\", eh?"
msgstr "Bệ hạ \"của cậu\" đấy à?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ROYALTY_JOKER.3
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ROYALTY_JOKER.3"
msgid "My \"Liege\", eh?"
msgstr "Chúa công \"của cậu\" đấy à?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_RUINS_RESET"
msgid "All that hard work gone to waste."
msgstr "Toàn bộ công sức đổ sông đổ biển."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SACREDCHEST_NO"
msgid "We didn't cut it, Lucy."
msgstr "Chúng ta không chặt được nó đâu, Lucy."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SACREDCHEST_YES"
msgid "Thanks'm."
msgstr "Cảm ơn nhé."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SCRAPBOOK_FULL
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SCRAPBOOK_FULL"
msgid "Looks like stuff I already know aboot."
msgstr "Có vẻ như toàn thứ tôi biết rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SECURITY_PULSE_FOLLOWING
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SECURITY_PULSE_FOLLOWING"
msgid "It's following us, Luce!"
msgstr "Nó đang bám theo chúng ta kìa, Luce!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SHADOWTHRALL_STEALTH
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SHADOWTHRALL_STEALTH"
msgid "What the heck bit me?"
msgstr "Cái quái gì vừa cắn tôi thế?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SHADOW_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SHADOW_RIFT_MAX"
msgid "I don't like the look of that light."
msgstr "Tôi không thích ánh sáng đó chút nào."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SHELTER"
msgid "Thanks for the shelter, buddy. I'm still gonna chop you."
msgstr "Cảm ơn vì chỗ trú nhé bạn hiền. Tôi vẫn sẽ chặt cậu thôi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SISTURN_FULL_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SISTURN_FULL_BLOSSOM"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SISTURN_FULL_EVIL
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SISTURN_FULL_EVIL"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SNARED"
msgid "You'll have to do better than that."
msgstr "Cậu phải làm tốt hơn thế chứ."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SNARED_IVY
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SNARED_IVY"
msgid "I think they want to dance, Lucy!"
msgstr "Chắc chúng muốn khiêu vũ đấy, Lucy!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SNOWBALL_NO_SNOW
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SNOWBALL_NO_SNOW"
msgid "We need to find more snow."
msgstr "Chúng ta cần tìm thêm tuyết."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SNOWBALL_TOO_BIG
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SNOWBALL_TOO_BIG"
msgid "She won't get any bigger."
msgstr "Nó không to lên được nữa đâu."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SOAKED"
msgid "Better hold on tight, Lucy."
msgstr "Bám chặt vào nhé, Lucy."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SPOOKED"
msgid "Oh geez!"
msgstr "Ôi trời!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TALK_TO_PLANTS.1
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TALK_TO_PLANTS.1"
msgid "So... what do plants like to talk aboot?"
msgstr "Vậy... thực vật thích nói về chuyện gì nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TALK_TO_PLANTS.2
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TALK_TO_PLANTS.2"
msgid "How are you doing there, bud?"
msgstr "Dạo này thế nào rồi bạn hiền?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TALK_TO_PLANTS.3
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TALK_TO_PLANTS.3"
msgid "Let me know if any of these other plants are botherin' you - I'll give 'em the axe!"
msgstr "Cho tôi biết nếu mấy cái cây này đang làm phiền cậu nhé - tôi sẽ cho chúng ăn rìu đấy!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TALK_TO_PLANTS.4
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TALK_TO_PLANTS.4"
msgid "You grow here often? Aw, c'mon Lucy that was funny!"
msgstr "Cậu hay lớn lên ở đây à? Ồ, thôi nào Lucy, câu đó buồn cười mà!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "It's nice catching up with my best bud!"
msgstr "Thật tuyệt khi được trò chuyện với chiến hữu thân thiết của tôi!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_THORNS"
msgid "Ouch!"
msgstr "Ái!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_THURIBLE_OUT"
msgid "No more luring, I guess."
msgstr "Chắc là hết dụ dỗ được rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TICOON_ABANDONED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TICOON_ABANDONED"
msgid "How aboot we try this again some other time, eh?"
msgstr "Hay là lúc khác chúng ta thử lại nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TICOON_DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TICOON_DEAD"
msgid "Well that's a shame. Guess I'm on my own now."
msgstr "Đúng là đáng tiếc thật. Chắc giờ tôi phải tự thân vận động rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TICOON_GET_LEADER_ATTENTION
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TICOON_GET_LEADER_ATTENTION"
msgid "Looks like he's trying to get my attention."
msgstr "Có vẻ như nó đang cố thu hút sự chú ý của tôi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TICOON_LOST_KITCOON
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TICOON_LOST_KITCOON"
msgid "Dangit. Must've lost the trail."
msgstr "Chết tiệt. Chắc mất dấu rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TICOON_NEAR_KITCOON
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TICOON_NEAR_KITCOON"
msgid "You see something, buddy?"
msgstr "Cậu thấy gì à, bạn hiền?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TICOON_NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TICOON_NOTHING_TO_TRACK"
msgid "Looks like there ain't anything around."
msgstr "Trông có vẻ chẳng có gì quanh đây cả."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TICOON_START_TRACKING
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TICOON_START_TRACKING"
msgid "Let's get to finding those kits, eh?"
msgstr "Đi tìm mấy chú mèo con thôi nào, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TICOON_WAITING_FOR_LEADER
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TICOON_WAITING_FOR_LEADER"
msgid "I think he's waiting for me."
msgstr "Tôi nghĩ nó đang đợi tôi đấy."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TOADESCAPED"
msgid "The warty hoser ran away!"
msgstr "Tên nhiều mụn cóc đó chuồn mất tiêu rồi!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TOADESCAPING"
msgid "It's gonna turn tail soon."
msgstr "Nó sắp cúp đuôi chạy trốn rồi kìa."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TOOL_SLIP"
msgid "The stuff of nightmares!"
msgstr "Cứ như cơn ác mộng vậy!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TOOL_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TOOL_TOOWEAK"
msgid "Guess this tool just ain't gonna cut it."
msgstr "Chắc cái công cụ này không dùng được việc này rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TORCH_OUT"
msgid "My light ran out!"
msgstr "Đèn của tôi hết sáng rồi!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "I got sand in my beard."
msgstr "Tôi bị dính cát vào râu rồi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TRAP_WENT_OFF"
msgid "Oops!"
msgstr "Úi!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_UNIMPLEMENTED"
msgid "Ouch! That wasn't very polite."
msgstr "Ái! Hành động đó không lịch sự chút nào đâu."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_VAULT_SHADOW_ASSIST
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_VAULT_SHADOW_ASSIST"
msgid "You see that, Luce? They're helping!"
msgstr "Cậu thấy chứ, Luce? Chúng đang giúp đỡ kìa!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_VAULT_TELEPORTER_DOES_NOTHING
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_VAULT_TELEPORTER_DOES_NOTHING"
msgid "Well do you have a better idea, Lucy?"
msgstr "Bộ cô có ý tưởng nào hay hơn à, Lucy?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WASHED_ASHORE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WASHED_ASHORE"
msgid "Well, that'll wake you up. Brr."
msgstr "Chà, thế thì tỉnh cả người. Brr."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WEAK_RAT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WEAK_RAT"
msgid "That one's not looking so good."
msgstr "Cái đó trông không ổn lắm đâu."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WEAPON_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WEAPON_TOOWEAK"
msgid "We need something stronger, eh?"
msgstr "Chúng ta cần thứ gì đó mạnh hơn, phải không?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WEIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WEIGHT"
msgid "Weight: {weight}"
msgstr "Cân nặng: {weight}"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WEIGHT_HEAVY
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WEIGHT_HEAVY"
msgid "Weight: {weight}\nNot bad, eh?"
msgstr "Cân nặng: {weight}\nKhông tệ đúng không?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WENDY_BABYSITTER_SET
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WENDY_BABYSITTER_SET"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WENDY_BABYSITTER_STOP
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WENDY_BABYSITTER_STOP"
msgid "only_used_by_wendy"
msgstr "chỉ_được_sử_dụng_bởi_wendy"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WET"
msgid "Plaid's warm, even when wet."
msgstr "Đồ sọc ca rô ấm lắm, kể cả khi bị ướt."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WETTER"
msgid "I'm getting quite wet, eh?"
msgstr "Tôi đang dần ướt sũng rồi đấy, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WINCH_CLAW_MISS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WINCH_CLAW_MISS"
msgid "Dangit, just missed it."
msgstr "Chết tiệt, suýt thì bắt được."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WINCH_CLAW_NO_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WINCH_CLAW_NO_ITEM"
msgid "Whoops. Guess I was a little off, eh?"
msgstr "Ôi. Chắc tôi lệch tâm một chút rồi phải không?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WINTERS_FEAST_BUFF
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WINTERS_FEAST_BUFF"
msgid "I'm lit up like the first of July!"
msgstr "Tôi sáng rực lên như ngày mùng một tháng Bảy vậy!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WINTERS_FEAST_BUFF_OVER
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WINTERS_FEAST_BUFF_OVER"
msgid "Eh, I was probably a walkin' fire hazard anyway."
msgstr "À thì, đằng nào tôi cũng chẳng khác gì một quả bom lửa di động cả."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WOLFGANG_BEGIN_COACHING
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WOLFGANG_BEGIN_COACHING"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WOLFGANG_END_COACHING
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WOLFGANG_END_COACHING"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WOLFGANG_MIGHTY_COACHING
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WOLFGANG_MIGHTY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WOLFGANG_NOTEAM.1
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WOLFGANG_NOTEAM.1"
msgid "only_used_by_wolfang"
msgstr "chỉ_được_sử_dụng_bởi_wolfang"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WOLFGANG_NOTEAM.2
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WOLFGANG_NOTEAM.2"
msgid "only_used_by_wolfang"
msgstr "chỉ_được_sử_dụng_bởi_wolfang"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WOLFGANG_NOTEAM.3
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WOLFGANG_NOTEAM.3"
msgid "only_used_by_wolfang"
msgstr "chỉ_được_sử_dụng_bởi_wolfang"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WOLFGANG_WIMPY_COACHING
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WOLFGANG_WIMPY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "chỉ_được_sử_dụng_bởi_wolfgang"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WORMHOLE"
msgid "It was gross in there!"
msgstr "Trong đó gớm ghiếc thật đấy!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WORMS"
msgid "Oh geez. I hope you're ready, Lucy."
msgstr "Ôi trời. Tôi hy vọng cậu đã sẵn sàng rồi đấy, Lucy."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WORMS_BOSS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WORMS_BOSS"
msgid "Sounds like a hefty one, eh Luce?"
msgstr "Nghe có vẻ là một con hàng nặng ký đấy, Luce?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT"
msgid "What gives?"
msgstr "Gì thế này?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WX_SCANNER_NEW_FOUND
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WX_SCANNER_NEW_FOUND"
msgid "only_used_by_wx78"
msgstr "chỉ_được_sử_dụng_bởi_wx78"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_YOTB_LEARN_NEW_PATTERN
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_YOTB_LEARN_NEW_PATTERN"
msgid "Hey, I think I figured out a new pattern, Luce!"
msgstr "Này, tôi nghĩ mình vừa tìm ra một hoa văn mới rồi đấy, Luce!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_YOTD_NOBOATS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_YOTD_NOBOATS"
msgid "Better scooch a bit closer to the starting point, eh?"
msgstr "Tốt hơn là nên xích lại gần điểm xuất phát một chút, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_YOTD_NOCHECKPOINTS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_YOTD_NOCHECKPOINTS"
msgid "Looks like I'm forgetting something."
msgstr "Hình như tôi đang quên mất điều gì đó thì phải."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_YOTD_NOTENOUGHBOATS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_YOTD_NOTENOUGHBOATS"
msgid "I should clear the start area for any other boats. It's only polite."
msgstr "Tôi nên dọn sạch khu vực xuất phát để nhường chỗ cho các con thuyền khác. Phải lịch sự chứ."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_YOTH_ONCOOLDOWN
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_YOTH_ONCOOLDOWN"
msgid "The horses must be busy now, Luce."
msgstr "Mấy chú ngựa chắc đang bận lắm rồi đấy, Luce."

#. STRINGS.CHARACTERS.WOODIE.ANOUNCE_MUTATED_BIRD_ATTACK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANOUNCE_MUTATED_BIRD_ATTACK"
msgid "What did I do to deserve this?"
msgstr "Tôi đã làm gì nên tội cơ chứ?"

#. STRINGS.CHARACTERS.WOODIE.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WOODIE.BATTLECRY.DEER"
msgid "Hunting season's open!"
msgstr "Mùa săn bắt đã mở!"

#. STRINGS.CHARACTERS.WOODIE.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.BATTLECRY.GENERIC"
msgid "Get over here, eh!"
msgstr "Mau lại đây nào!"

#. STRINGS.CHARACTERS.WOODIE.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WOODIE.BATTLECRY.PIG"
msgid "I'll make bacon of you yet!"
msgstr "Rồi tôi sẽ biến ngươi thành thịt xông khói cho coi!"

#. STRINGS.CHARACTERS.WOODIE.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WOODIE.BATTLECRY.PREY"
msgid "This here's the end for you!"
msgstr "Đến lúc tận số của ngươi rồi đấy!"

#. STRINGS.CHARACTERS.WOODIE.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WOODIE.BATTLECRY.SPIDER"
msgid "For the North!"
msgstr "Vì miền Bắc!"

#. STRINGS.CHARACTERS.WOODIE.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WOODIE.BATTLECRY.SPIDER_WARRIOR"
msgid "Prepare for a choppin'!"
msgstr "Chuẩn bị tinh thần để bị băm vằm đi!"

#. STRINGS.CHARACTERS.WOODIE.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.COMBAT_QUIT.GENERIC"
msgid "I think that's enough."
msgstr "Tôi nghĩ thế là đủ rồi đấy."

#. STRINGS.CHARACTERS.WOODIE.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WOODIE.COMBAT_QUIT.PIG"
msgid "I thought that would go better."
msgstr "Tôi cứ tưởng mọi chuyện sẽ khá hơn cơ."

#. STRINGS.CHARACTERS.WOODIE.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WOODIE.COMBAT_QUIT.PREY"
msgid "Sorry, sorry!"
msgstr "Xin lỗi, xin lỗi mà!"

#. STRINGS.CHARACTERS.WOODIE.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WOODIE.COMBAT_QUIT.SPIDER"
msgid "Sorry!"
msgstr "Xin lỗi nhé!"

#. STRINGS.CHARACTERS.WOODIE.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WOODIE.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "Same time again tomorrow, eh?"
msgstr "Hẹn gặp lại vào giờ này ngày mai nhé?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL.LEVEL1.1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL.LEVEL1.1"
msgid "That ain't right."
msgstr "Cái đó không bình thường chút nào."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL.LEVEL1.2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL.LEVEL1.2"
msgid "That ain't right."
msgstr "Cái đó không bình thường chút nào."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL.LEVEL2.1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL.LEVEL2.1"
msgid "That ain't right."
msgstr "Cái đó không bình thường chút nào."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL.LEVEL2.2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL.LEVEL2.2"
msgid "That ain't right."
msgstr "Cái đó không bình thường chút nào."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL.LEVEL3.1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL.LEVEL3.1"
msgid "That ain't right."
msgstr "Cái đó không bình thường chút nào."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL.LEVEL3.2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL.LEVEL3.2"
msgid "That ain't right."
msgstr "Cái đó không bình thường chút nào."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "It's a flower? I guess."
msgstr "Đó là một bông hoa à? Chắc vậy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "Maybe we should split, eh?"
msgstr "Có lẽ chúng ta nên chuồn thôi, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "I'm not comfortable with this."
msgstr "Tôi không thoải mái với chuyện này chút nào."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "That flower's lookin' a bit run down."
msgstr "Bông hoa đó trông có vẻ hơi tàn tạ rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "A haunted flower... pretty strange don't ya think, Lucy?"
msgstr "Một bông hoa ma quái... khá là kỳ lạ phải không Lucy?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "I guess I should be used to weird stuff by now."
msgstr "Chắc là tôi nên quen với mấy thứ kỳ quặc này từ lâu rồi mới phải."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "Yup. It's a flower."
msgstr "Chuẩn luôn. Đó là một bông hoa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "That flower's acting funny..."
msgstr "Bông hoa đó đang hành xử rất lạ đời..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "Did it just move?"
msgstr "Nó vừa nhúc nhích phải không nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED"
msgid "I knew it!"
msgstr "Tôi biết ngay mà!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABYSSPILLAR_MINION.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABYSSPILLAR_MINION.GENERIC"
msgid "I don't like it either, Luce."
msgstr "Tôi cũng chẳng thích nó chút nào đâu, Luce."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABYSSPILLAR_TRIAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABYSSPILLAR_TRIAL"
msgid "I know, Lucy."
msgstr "Tôi biết rồi, Lucy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "It seems a bit show-offy to me."
msgstr "Tôi thấy nó cứ ra vẻ khoe khoang thế nào ấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ACORN"
msgid "I should grow it and then chop it down!"
msgstr "Tôi nên trồng nó rồi đốn ngã nó mới được!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ACORN_COOKED"
msgid "What a waste of a perfectly good tree."
msgstr "Thật phí hoài một cái cây hoàn hảo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ACORN_SAPLING"
msgid "Here comes a tree!"
msgstr "Cây cối chuẩn bị mọc lên kìa!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ADVENTURE_PORTAL"
msgid "I wonder if that's the way out of here."
msgstr "Tự hỏi không biết đó có phải là lối thoát khỏi đây không."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIANHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIANHAT"
msgid "It's a pretty handy headpiece, could do without the whisperin' though."
msgstr "Đây là một món đồ đội đầu khá tiện lợi đấy, chỉ có điều giá mà nó bớt thì thầm đi thì tốt."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIANHATSHARD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIANHATSHARD"
msgid "I'm sure it's still good for somethin'."
msgstr "Tôi chắc là nó vẫn dùng được việc gì đó."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_CONTAINED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_CONTAINED"
msgid "Guess he couldn't have brought that sooner, eh?"
msgstr "Chắc là hắn không mang nó đến sớm hơn được à?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD"
msgid "Looks like we got 'em!"
msgstr "Có vẻ chúng ta hạ được chúng rồi!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC"
msgid "Hey! Watch where you're rollin', eh?"
msgstr "Này! Đi đứng cẩn thận cái chân vào chứ, hả?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT"
msgid "Looks meaner this time eh, Luce?"
msgstr "Lần này trông nó hung dữ hơn đấy, Luce nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT"
msgid "That must be what he's looking for."
msgstr "Chắc chắn đó là thứ mà hắn đang tìm kiếm rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD"
msgid "And stay down, will ya?"
msgstr "Và nằm im đấy nhé, chịu chưa?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC"
msgid "I get the feelin' it doesn't like us one bit, Luce."
msgstr "Tôi có cảm giác nó chẳng ưa gì chúng ta chút nào đâu, Luce ạ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE"
msgid "It's trying to fence us in!"
msgstr "Nó đang cố nhốt chúng ta lại kìa!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE3"
msgid "Well, third time's the charm, eh?"
msgstr "Chà, quá tam ba bận mà, phải không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD"
msgid "Guess that takes care of that!"
msgstr "Thế là giải quyết xong xuôi nhé!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB"
msgid "Hey! You be careful there, bud!"
msgstr "Này! Cẩn thận đấy nhé, bạn hiền!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP"
msgid "Now's probably not the time to be taking a nap."
msgstr "Bây giờ chắc không phải lúc để tranh thủ làm một giấc đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT"
msgid "What in the Aurora Borealis is that?!"
msgstr "Cái quái gì mà sáng rực như cực quang thế kia?!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.AMULET"
msgid "Always have a backup plan."
msgstr "Lúc nào cũng phải có phương án dự phòng."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCHOR"
msgid "Real heavy one there."
msgstr "Cái này nặng thật đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCHOR_ITEM"
msgid "A little elbow grease and we'll have an anchor."
msgstr "Bỏ ra chút công sức nữa là chúng ta sẽ có dây neo ngay."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTFRUIT_GEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "Maybe roasting it will soften it up, eh?"
msgstr "Có lẽ nướng lên sẽ làm nó mềm ra nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "Nope. Don't like the look of that."
msgstr "Không. Không thích cái vẻ ngoài đó tí nào."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "Is there anything else to eat?"
msgstr "Còn gì khác để ăn nữa không nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
msgid "Whoa, Lucy. This is not your kind of tree."
msgstr "Ồ, Lucy. Đây không phải loại cây của cậu đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTTREE_GEM.STUMP"
msgid "This is not the work of an axe."
msgstr "Đây không phải là tác phẩm của một chiếc rìu đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
msgid "It's just as spooky in the day."
msgstr "Ban ngày mà trông cũng ma quái chẳng kém."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
msgid "Good riddance, spooky tree."
msgstr "Biến đi cho khuất mắt, cái cây ma quái ạ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
msgid "Soon, Lucy. Soon."
msgstr "Sớm thôi, Lucy. Sớm thôi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON"
msgid "Maybe it's not growin' season, eh?"
msgstr "Có lẽ bây giờ không phải mùa cây lớn nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE"
msgid "I don't think this is where it goes."
msgstr "Tôi không nghĩ đây là chỗ dành cho nó đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTTREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTTREE_SAPLING_ITEM"
msgid "Where would you like to be chopped down eventually?"
msgstr "Rồi cuối cùng cậu muốn được chặt ở chỗ nào cơ chứ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTTREE_SEED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENTTREE_SEED"
msgid "I know you hope it's a tree, Luce. I do too."
msgstr "Tôi biết cậu cũng hy vọng nó là một cây gỗ đấy, Luce. Tôi cũng thế."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENT_ALTAR"
msgid "There's axe marks on these altar stones."
msgstr "Có những vết rìu trên mấy hòn đá bệ thờ này."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "Looks a little worn out."
msgstr "Trông có vẻ hơi sờn cũ rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENT_HUSK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENT_HUSK"
msgid "I can't even begin to understand what happened here."
msgstr "Tôi thậm chí còn chẳng thể hiểu nổi chuyện gì đã xảy ra ở đây nữa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENT_STATUE"
msgid "Another hoser."
msgstr "Lại thêm một tên đần nữa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANIMAL_TRACK"
msgid "A large woodland creature passed this way!"
msgstr "Một sinh vật rừng lớn đã đi qua đây!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANTCHOVIES"
msgid "They just ain't right."
msgstr "Mấy con đó trông cứ sai sai thế nào ấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANTLION.GENERIC"
msgid "They grow'em big out here, eh?"
msgstr "Ngoài này nuôi mấy con này to thật đấy, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANTLION.UNHAPPY"
msgid "That critter's in a real bad mood."
msgstr "Con quái vật đó đang cực kỳ bực bội đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANTLION.VERYHAPPY"
msgid "It seems agreeable."
msgstr "Trông nó có vẻ dễ chiều đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANTLIONHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANTLIONHAT"
msgid "It sure beats using a pitchfork, eh?"
msgstr "Dùng cái này rõ ràng đỡ khổ hơn dùng chĩa nhiều, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANTLIONTRINKET"
msgid "Could give it to some sandy hoser."
msgstr "Có thể đem cho mấy tên cát bụi nào đó."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "I think we might be tresspassin'."
msgstr "Tôi nghĩ chúng ta đang đột nhập rồi đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "This whole place is littered with these things!"
msgstr "Cả cái nơi này la liệt mấy thứ này luôn!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "Burned to a crisp."
msgstr "Cháy đen thui luôn rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "It'll be a bit longer, eh?"
msgstr "Sẽ phải đợi thêm lúc nữa đấy, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "Oh boy! Here it comes!"
msgstr "Ôi trời! Nó đến kìa!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "Time for supper!"
msgstr "Đến giờ ăn tối rồi!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "I'm guessin' this hasn't been used in a while."
msgstr "Tôi đoán là cái này lâu lắm rồi không được dùng tới."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "Huh. There's something sloshing around in there."
msgstr "Hả. Có cái quái gì đang lổn nhổn trong đó ấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "Well whattaya know! It just needed a little juice."
msgstr "Chà, ngạc nhiên chưa kìa! Nó chỉ cần thêm chút năng lượng thôi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "Now that's a funny looking gadget. Too bad it doesn't work."
msgstr "Đúng là một món đồ kỳ cục. Tiếc là nó chẳng hoạt động."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "The ones carryin' the full moon sure got the short end of the stick, eh?"
msgstr "Mấy bức tượng vác trăng tròn đúng là chịu phần thiệt thòi nhất nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "That's one fancy floor, eh?"
msgstr "Đúng là một chiếc sàn nhà sang trọng, phải không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "Guess that door's closed for good."
msgstr "Chắc cái cửa đó đóng vĩnh viễn luôn rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "Hey Lucy, maybe that's a way outta here!"
msgstr "Này Lucy, biết đâu đó là đường ra khỏi đây thì sao!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "Not sure where it's leading me, but I might as well find out."
msgstr "Không chắc nó dẫn đi đâu, nhưng cứ dò theo xem sao."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "Nothin' left to point us to."
msgstr "Chẳng còn manh mối nào để dò theo nữa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "It's humming with some kinda energy."
msgstr "Nó đang rung lên với thứ năng lượng gì đó."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "Now that's a head scratcher."
msgstr "Đúng là một phen đau đầu suy nghĩ đây."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2"
msgid "I never even got a handle on French, don't expect me to read that."
msgstr "Tiếng Pháp tôi còn chưa tài nào hiểu nổi, đừng hòng bắt tôi đọc cái đó."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3"
msgid "Now that's a head scratcher."
msgstr "Đúng là một phen đau đầu suy nghĩ đây."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
msgid "I never even got a handle on French, don't expect me to read that."
msgstr "Tiếng Pháp tôi còn chưa tài nào hiểu nổi, đừng hòng bắt tôi đọc cái đó."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
msgid "Now that's a head scratcher."
msgstr "Đúng là một phen đau đầu suy nghĩ đây."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
msgid "I'm not sure I like the look of it."
msgstr "Tôi không chắc mình thích cái vẻ ngoài của nó lắm đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
msgid "Not much happening with this thing."
msgstr "Cái thứ này chẳng có chuyển động gì sất."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_SECURITY_PULSE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_SECURITY_PULSE"
msgid "Hey Luce, should we be worried aboot that?"
msgstr "Này Luce, chúng ta có nên lo lắng về cái đó không nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_SWITCH.GEMS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_SWITCH.GEMS"
msgid "Anyone have a spare gem?"
msgstr "Có ai có viên ngọc nào thừa không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_SWITCH.VALID
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARCHIVE_SWITCH.VALID"
msgid "Looks like this one's already set."
msgstr "Có vẻ cái này đã được thiết lập sẵn rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORDRAGONFLY"
msgid "Plaid is all the armor I need."
msgstr "Áo sọc ca rô là món giáp duy nhất tôi cần."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORDREADSTONE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORDREADSTONE"
msgid "Lucy says black ain't my colour."
msgstr "Lucy bảo màu đen không hợp với tôi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORGRASS"
msgid "It's better than nothing."
msgstr "Vẫn đỡ hơn là không có gì."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORMARBLE"
msgid "It's hard to swing an axe while wearing this."
msgstr "Thật khó để vung rìu khi mặc món đồ này."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORRUINS"
msgid "That'll stop the hurt."
msgstr "Cái đó sẽ chặn được sát thương đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORSKELETON"
msgid "Sticks to yer ribs."
msgstr "Dính chặt lấy xương sườn luôn đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORSLURPER"
msgid "It tickles. I think it's still alive."
msgstr "Nhột quá. Tôi nghĩ nó vẫn còn sống đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORSNURTLESHELL"
msgid "You can never be too safe."
msgstr "Cẩn thận bao nhiêu cũng không thừa đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORWAGPUNK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORWAGPUNK"
msgid "Does it come in plaid?"
msgstr "Nó có họa tiết sọc ca rô không nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORWOOD"
msgid "It fits me so well!"
msgstr "Nó vừa vặn với tôi làm sao!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMOR_BRAMBLE"
msgid "All natural safety precautions."
msgstr "Các biện pháp an toàn hoàn toàn tự nhiên."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMOR_CARROTLURE"
msgid "Nice carrot vest."
msgstr "Chiếc áo cà rốt đẹp phết."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMOR_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMOR_LUNARPLANT"
msgid "Sturdy organic armor."
msgstr "Bộ giáp hữu cơ cứng cáp."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMOR_LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMOR_LUNARPLANT_HUSK"
msgid "That is some fine craftsmanship."
msgstr "Đúng là một tay nghề thủ công tinh xảo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMOR_SANITY"
msgid "It makes me queasy to look at."
msgstr "Nhìn vào nó làm tôi thấy buồn nôn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMOR_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMOR_VOIDCLOTH"
msgid "Quite the getup, eh?"
msgstr "Trang phục ra trò đấy chứ, nhờ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMOR_YOTH_KNIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMOR_YOTH_KNIGHT"
msgid "Yes, it'll fit me, Lucy."
msgstr "Vâng, nó sẽ vừa với tôi thôi, Lucy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "Wood is the best at burning."
msgstr "Gỗ là thứ cháy tốt nhất."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "Let the wood guide the way."
msgstr "Hãy để những thớ gỗ dẫn đường cho chúng ta."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "Let's give our neighbours some guidance."
msgstr "Hãy chỉ đường cho mấy người hàng xóm của chúng ta nào."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "Wood is the best at burning."
msgstr "Gỗ là thứ cháy tốt nhất."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "Let the wood guide the way."
msgstr "Hãy để những thớ gỗ dẫn đường cho chúng ta."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "Let's give our neighbours some guidance."
msgstr "Hãy chỉ đường cho mấy người hàng xóm của chúng ta nào."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASH.GENERIC"
msgid "It's all burnt up."
msgstr "Nó cháy rụi hết rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "This used to be an eyebone."
msgstr "Cái này từng là một cục xương mắt."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "This used to be a slimy flower."
msgstr "Cái này từng là một bông hoa nhầy nhụa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "Well, that's a shame."
msgstr "Chà, đúng là đáng tiếc thật."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASPARAGUS"
msgid "When it's raw, it's almost as tough as trees."
msgstr "Lúc còn sống, nó cứng gần bằng cây cối vậy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASPARAGUSSOUP"
msgid "It's a soup made out of those little trees."
msgstr "Đây là món súp nấu từ những cái cây nhỏ bé đó."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASPARAGUS_COOKED"
msgid "Little easier to eat them cooked."
msgstr "Nấu chín lên thì ăn dễ hơn chút."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASPARAGUS_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASPARAGUS_OVERSIZED"
msgid "It almost looks like a proper tree."
msgstr "Trông nó gần giống như một cái cây thực thụ vậy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASPARAGUS_SEEDS"
msgid "I should plant this."
msgstr "Tôi nên trồng thực vật này mới được."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "It's soaking up energy, hey?"
msgstr "Nó đang hấp thụ năng lượng kìa, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "Don't wanna overdo it."
msgstr "Không muốn quá đà đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "That'd be my cue to leave."
msgstr "Đó sẽ là tín hiệu để tôi chuồn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_GATE.OFF"
msgid "Where d'you think it goes, Lucy?"
msgstr "Cậu nghĩ nó dẫn đến đâu thế, Lucy?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_GATE.ON"
msgid "That oughta do it."
msgstr "Thế là ổn rồi đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_KEY"
msgid "Got it from that big bony hoser."
msgstr "Lấy được từ gã nhiều xương to lớn kia đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "Gotta be a way to turn it on."
msgstr "Phải có cách nào đó để bật nó lên chứ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "What a nightmare."
msgstr "Đúng là một cơn ác mộng."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "It probably said something important. Oh well."
msgstr "Chắc nó có nói điều gì đó quan trọng. Thôi kệ đi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "It's an old drawing of strange creatures."
msgstr "Đó là một bức vẽ cũ về những sinh vật kỳ lạ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "Nothin' of interest left here."
msgstr "Chẳng còn gì thú vị ở đây nữa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "Black muck is covering everything in this drawing."
msgstr "Bùn đen đang bao trùm mọi thứ trong bức vẽ này."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "Don't look at this one, Lucy."
msgstr "Đừng nhìn cái này nhé, Lucy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "Looks like a bustling city."
msgstr "Trông giống như một thành phố nhộn nhịp."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_STATUE"
msgid "Was it supposed to be holding something?"
msgstr "Nó có định cầm thứ gì không vậy?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.AXE"
msgid "It's not as nice as Lucy."
msgstr "Nó không đẹp bằng Lucy đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "A face only a mother could love."
msgstr "Khuôn mặt chỉ có mẹ nó mới thương nổi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "I enjoy sleeping outside, too."
msgstr "Tôi cũng thích ngủ ngoài trời lắm."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BACKPACK"
msgid "That's a decent looking rucksack."
msgstr "Đó là một cái ba lô trông khá được đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BACONEGGS"
msgid "Awww. It's just front bacon."
msgstr "Hây dà. Chỉ là thịt ba rọi phía trước thôi mà."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BALATRO_MACHINE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BALATRO_MACHINE"
msgid "I know I promised, Luce. Just one more."
msgstr "Tôi biết tôi đã hứa rồi mà, Luce. Chỉ một ván nữa thôi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BALLOON"
msgid "It's squeaky. Just like a real woodland creature."
msgstr "Nó kêu éc éc. Y hệt như một sinh vật rừng thực thụ vậy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BALLOONHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BALLOONHAT"
msgid "We can all appreciate nature in our own way."
msgstr "Ai cũng có cách tận hưởng thiên nhiên theo cách riêng của mình."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BALLOONPARTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BALLOONPARTY"
msgid "Uh oh, I didn't forget someone's birthday did I?"
msgstr "Ối không, tôi không bỏ quên sinh nhật ai đấy chứ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BALLOONSPEED.DEFLATED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BALLOONSPEED.DEFLATED"
msgid "Just a regular balloon now, eh?"
msgstr "Giờ chỉ là một quả bong bóng bình thường thôi phải không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BALLOONSPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BALLOONSPEED.GENERIC"
msgid "Now how do you figure that works, Luce?"
msgstr "Làm thế quái nào mà nó hoạt động hay thế nhỉ, Luce?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BALLOONS_EMPTY"
msgid "Are those balloons?"
msgstr "Đó là bong bóng phải không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BALLOONVEST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BALLOONVEST"
msgid "It beats drowning, I guess..."
msgstr "Vẫn đỡ hơn là chết đuối, tôi đoán thế..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BANANABUSH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BANANABUSH"
msgid "It's missing the tree part!"
msgstr "Nó thiếu mất phần thân cây rồi!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BANANAJUICE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BANANAJUICE"
msgid "Feels almost like being on vacation, eh?"
msgstr "Cảm giác cứ như đang đi nghỉ dưỡng vậy nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BANANAPOP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BANANAPOP"
msgid "I'd prefer maple taffy..."
msgstr "Tôi thích kẹo bơ cứng vị phong hơn..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BANDAGE"
msgid "At least I didn't have to pay for it."
msgstr "Ít ra thì tôi không phải trả tiền cho nó."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BANDAGE_BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BANDAGE_BUTTERFLYWINGS"
msgid "It's pretty pretty, eh?"
msgstr "Trông xinh xắn phết phải không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BARNACLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BARNACLE"
msgid "Not my first choice in seafood."
msgstr "Không phải món hải sản ưu tiên của tôi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BARNACLEPITA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BARNACLEPITA"
msgid "I'm not picky."
msgstr "Tôi không kén ăn đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BARNACLESTUFFEDFISHHEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BARNACLESTUFFEDFISHHEAD"
msgid "I'm not one to turn down some grub."
msgstr "Tôi không phải là kiểu người từ chối con sâu ngon lành đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BARNACLESUSHI
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BARNACLESUSHI"
msgid "Can't say I ever saw that on a menu back home."
msgstr "Tôi chưa từng thấy món đó trên thực đơn ở quê nhà bao giờ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BARNACLE_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BARNACLE_COOKED"
msgid "They're not bad!"
msgstr "Chúng ăn được phết đấy chứ!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BARNACLINGUINE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BARNACLINGUINE"
msgid "Sorry, I'm eatin' this whole thing myself."
msgstr "Xin lỗi nhé, tôi sẽ tự mình nuốt trọn đĩa này luôn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BASALT"
msgid "That rock ain't going to move."
msgstr "Cục đá tảng đó không đời nào dịch chuyển được đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BAT"
msgid "Who taught that rat to fly?"
msgstr "Ai dạy con chuột đó bay vậy trời?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATBAT"
msgid "A mouse with wings?"
msgstr "Một con chuột có cánh á?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATCAVE"
msgid "Full of the little critters!"
msgstr "Đầy ắp mấy sinh vật nhỏ bé trong đó!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATHBOMB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATHBOMB"
msgid "Smells nice, like wildflowers."
msgstr "Thơm lắm, giống như hoa dại vậy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATNOSE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATNOSE"
msgid "Who nose where the rest of it went."
msgstr "Ai mà biết phần còn lại đi đâu mất tiêu rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATNOSEHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATNOSEHAT"
msgid "Keeps my hands free for choppin'."
msgstr "Giúp tay tôi rảnh rang để còn chặt chém."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATNOSE_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATNOSE_COOKED"
msgid "Nothing worse than a cold nose."
msgstr "Không gì tệ hơn một cái mũi lạnh ngắt."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATTLESONG_CONTAINER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATTLESONG_CONTAINER"
msgid "She's a nifty tune holder."
msgstr "Đúng là một thứ giữ giai điệu gọn gàng."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATTLESONG_DURABILITY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATTLESONG_DURABILITY"
msgid "Don't recognize the song. Maybe it wasn't released in Canada."
msgstr "Không nhận ra bài hát này. Có lẽ nó không phát hành ở Canada."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATTLESONG_FIRERESISTANCE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATTLESONG_FIRERESISTANCE"
msgid "Don't recognize the song. Maybe it wasn't released in Canada."
msgstr "Không nhận ra bài hát này. Có lẽ nó không phát hành ở Canada."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATTLESONG_HEALTHGAIN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATTLESONG_HEALTHGAIN"
msgid "Don't recognize the song. Maybe it wasn't released in Canada."
msgstr "Không nhận ra bài hát này. Có lẽ nó không phát hành ở Canada."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATTLESONG_INSTANT_PANIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATTLESONG_INSTANT_PANIC"
msgid "I can't sit and watch a play when there's wood to be chopped!"
msgstr "Tôi không thể ngồi ngắm kịch khi đang có đống gỗ cần chặt được!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATTLESONG_INSTANT_REVIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATTLESONG_INSTANT_REVIVE"
msgid "Don't recognize the song. Maybe it wasn't released in Canada."
msgstr "Không nhận ra bài hát này. Có lẽ nó không phát hành ở Canada."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATTLESONG_INSTANT_TAUNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATTLESONG_INSTANT_TAUNT"
msgid "I can't sit and watch a play when there's wood to be chopped!"
msgstr "Tôi không thể ngồi ngắm kịch khi đang có đống gỗ cần chặt được!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATTLESONG_LUNARALIGNED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATTLESONG_LUNARALIGNED"
msgid "Don't recognize the song. Maybe it wasn't released in Canada."
msgstr "Không nhận ra bài hát này. Có lẽ nó không phát hành ở Canada."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATTLESONG_SANITYAURA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATTLESONG_SANITYAURA"
msgid "Don't recognize the song. Maybe it wasn't released in Canada."
msgstr "Không nhận ra bài hát này. Có lẽ nó không phát hành ở Canada."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATTLESONG_SANITYGAIN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATTLESONG_SANITYGAIN"
msgid "Don't recognize the song. Maybe it wasn't released in Canada."
msgstr "Không nhận ra bài hát này. Có lẽ nó không phát hành ở Canada."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATTLESONG_SHADOWALIGNED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATTLESONG_SHADOWALIGNED"
msgid "Don't recognize the song. Maybe it wasn't released in Canada."
msgstr "Không nhận ra bài hát này. Có lẽ nó không phát hành ở Canada."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATWING"
msgid "Gross!"
msgstr "Ghê tởm!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATWING_COOKED"
msgid "Gross! And tasty! So confusing!"
msgstr "Gớm ghiếc! Mà lại ngon nữa chứ! Thật khó hiểu mà!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARDHAIR"
msgid "My hair's not that colour. Not my beard, anyway."
msgstr "Tóc tôi không có màu đó. Ít ra là râu của tôi không phải màu đó."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARGER"
msgid "That's a big bear!"
msgstr "Đó là một con gấu bự chảng!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARGERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARGERCORPSE.BURNING"
msgid "Smokey!"
msgstr "Smokey kìa!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARGERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARGERCORPSE.GENERIC"
msgid "He's a whole lotta backbacon."
msgstr "Nó đúng là một tảng thịt xông khói bự."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARGERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARGERCORPSE.REVIVING"
msgid "Well that's no good, eh?"
msgstr "Chà, thế thì không ổn chút nào nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARGERFUR_SACK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARGERFUR_SACK"
msgid "Keeps things nice and frosty, eh?"
msgstr "Giữ cho đồ đạc mát mẻ nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARGERVEST"
msgid "Now this is some proper winter gear."
msgstr "Đây mới đúng là đồ dùng mùa đông chính hiệu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARGER_FUR"
msgid "It's as thick as my head!"
msgstr "Nó dày bằng đầu tôi luôn đấy!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEAST_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEAST_BLUEPRINT"
msgid "Our beast is lucky it ended up being our friend and not our dinner, eh?"
msgstr "Quái thú của chúng ta thật may mắn vì nó là bạn chứ không phải bữa tối nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEDROLL_FURRY"
msgid "I love camping."
msgstr "Tôi thích cắm trại lắm."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEDROLL_STRAW"
msgid "I slept on worse back at the lumber camp."
msgstr "Tôi từng ngủ trên những thứ tệ hơn thế này hồi ở trại đốn gỗ nhiều."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEE.GENERIC"
msgid "She's making the flowers grow."
msgstr "Nó đang giúp những bông hoa lớn lên kìa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEE.HELD"
msgid "Now what do I do with her?"
msgstr "Giờ tôi nên làm gì với cô nàng đây?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.BURNT"
msgid "No, not the bees!"
msgstr "Không, đừng là lũ ong!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.FULLHONEY"
msgid "Maple syrup substitute!"
msgstr "Món thay thế cho xi -rô phong đây!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.GENERIC"
msgid "Buzzers!"
msgstr "Mấy con vo ve!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.NOHONEY"
msgid "I'm getting hungry just looking at it."
msgstr "Nhìn thôi là tôi đã thấy đói bụng rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.READY"
msgid "Maple syrup substitute!"
msgstr "Món thay thế cho xi -rô phong đây!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "I could get more if I waited."
msgstr "Tôi có thể lấy nhiều hơn nếu đợi thêm chút nữa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX_HERMIT.BURNT"
msgid "No, not the bees!"
msgstr "Không, đừng là lũ ong!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX_HERMIT.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX_HERMIT.FULLHONEY"
msgid "Maple syrup substitute!"
msgstr "Món thay thế cho xi -rô phong đây!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX_HERMIT.GENERIC"
msgid "So that's where those bees are comin' from!"
msgstr "Thì ra đó là nơi lũ ong bay ra!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "I'm getting hungry just looking at it."
msgstr "Nhìn thôi là tôi đã thấy đói bụng rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "Maple syrup substitute!"
msgstr "Món thay thế cho xi -rô phong đây!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "I could get more if I waited."
msgstr "Tôi có thể lấy nhiều hơn nếu đợi thêm chút nữa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.DEAD"
msgid "It doesn't look alive."
msgstr "Trông không giống còn sống lắm."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.DEAD_MYPARTNER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.DEAD_MYPARTNER"
msgid "It's like losing my second best friend."
msgstr "Cảm giác giống như mất đi người bạn thân thứ hai vậy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "I like this one's attitude."
msgstr "Tôi thích thái độ của con này đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.FOLLOWER"
msgid "I think he likes me."
msgstr "Tôi nghĩ nó quý tôi đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.GENERIC"
msgid "He smells like a sod house."
msgstr "Nó ngửi cứ như một túp lều cỏ khô vậy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.MYPARTNER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.MYPARTNER"
msgid "He's a smelly old thing, but I couldn't ask for a better bud!"
msgstr "Nó là một con vật già nua hôi hám, nhưng tôi chẳng thể đòi hỏi một chiến hữu nào tốt hơn thế!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.NAKED"
msgid "Cheer up, eh?"
msgstr "Vui lên nào, phải không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.ORNERY"
msgid "Why so glum, chum?"
msgstr "Sao lại ủ rũ thế hả bạn hiền?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.PUDGY"
msgid "You're almost as big as a moose!"
msgstr "Mày to gần bằng một con hươu Sừng Tấm rồi đấy!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.RIDER"
msgid "I'm sorry, want to go for a ride?"
msgstr "Xin lỗi nhé, muốn đi dạo một vòng không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.SLEEPING"
msgid "He's catching some zeds."
msgstr "Nó đang tranh thủ làm vài nháy giấc ngủ đây."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALOFEED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALOFEED"
msgid "Come and get it!"
msgstr "Đến đây ăn đi nào!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALOHAT"
msgid "Now I'm the king of the beefalo!"
msgstr "Giờ thì ta là vua của loài bò lai rồi!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALOTREAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALOTREAT"
msgid "How aboot I give my beefalo something tasty to munch on, eh?"
msgstr "Hay là tôi cho con bò lai của mình chút đồ ăn ngon để nhấm nháp nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALOWOOL"
msgid "It feels like my beard."
msgstr "Cảm giác y hệt râu của tôi vậy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO_GROOMER.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO_GROOMER.BURNT"
msgid "Not much I can do with that."
msgstr "Chẳng làm được gì với cái đó nữa rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO_GROOMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO_GROOMER.GENERIC"
msgid "This seems like a bit much..."
msgstr "Cái này có vẻ hơi quá đà rồi đấy..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO_GROOMER.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO_GROOMER.OCCUPIED"
msgid "Well, let's see what I can do."
msgstr "Chà, xem tôi có thể làm gì nào."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO_GROOMER_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO_GROOMER_ITEM"
msgid "Better get that set up, eh?"
msgstr "Tốt hơn là nên dựng nó lên thôi, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEF_BELL"
msgid "Beefalo sure seem to like the sound it makes."
msgstr "Mấy con bò lai có vẻ rất thích âm thanh đó phát ra."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEGUARD"
msgid "Hopefully no one's allergic, eh?"
msgstr "Hy vọng là không ai bị dị ứng nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEHAT"
msgid "That'll keep the bees out of yer eyes."
msgstr "Cái đó sẽ giúp lũ ong không bay vào mắt cậu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEHIVE"
msgid "They're all comfy-cozy in there."
msgstr "Chúng đang cuộn mình thoải mái trong đó kìa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEMINE"
msgid "I don't know if the bees like this."
msgstr "Tôi không biết lũ ong có thích cái này không nữa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEMINE_MAXWELL"
msgid "Hey! That's just mean!"
msgstr "Này! Chơi thế thì hiểm quá đấy!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEQUEEN"
msgid "Bees got no business getting that big."
msgstr "Lũ ong không việc gì phải to bự đến mức đó cả."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "I'm not eating honey off the ground."
msgstr "Tôi không thèm ăn mật ong dính dưới đất đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "The bees are planning something."
msgstr "Lũ ong đang lên âm mưu gì kìa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "Nature is something else, eh?"
msgstr "Tự nhiên đúng là kỳ diệu thật đấy, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEESWAX"
msgid "Yeesh, that's waxy."
msgstr "Úi chà, sáp gì mà sáp nhiều thế."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEESWAX_SPRAY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEESWAX_SPRAY"
msgid "Lucy says she likes my own woody musk."
msgstr "Lucy bảo cô ấy thích mùi hương gỗ mộc mạc của tôi cơ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEETLETAUR"
msgid "Gotta chop that armor up."
msgstr "Phải chặt nát bộ giáp đó ra mới được."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BELL"
msgid "I'm amazed it makes such a crisp sound."
msgstr "Tôi ngạc nhiên là nó lại phát ra âm thanh giòn giã đến thế."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERNIE_ACTIVE"
msgid "I guess I should be used to weird stuff by now."
msgstr "Chắc là tôi nên quen với mấy thứ kỳ quặc này từ lâu rồi mới phải."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERNIE_BIG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERNIE_BIG"
msgid "Hm. Yep. Just another day."
msgstr "Hừm. Chuẩn luôn. Lại thêm một ngày bình thường."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "Poor lil thing."
msgstr "Tội nghiệp bé con."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "Cute, isn't it 'Luce?"
msgstr "Dễ thương phải không Luce?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRIES"
msgid "I have a heartier appetite than that."
msgstr "Tôi có sức ăn lớn hơn thế nhiều."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRIES_COOKED"
msgid "Tastes like warm berries."
msgstr "Vị như dâu rừng ấm áp."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRIES_JUICY"
msgid "That's good eatin', eh?"
msgstr "Món đó ngon phết đấy chứ, nhờ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "Mmm. These'd be perfect with some syrup."
msgstr "Mừm. Món này mà ăn kèm ít xi -rô thì hoàn hảo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.BARREN"
msgid "It needs a good poopin'."
msgstr "Nó cần được bón phân đàng hoàng đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.BURNING"
msgid "Can't save it now."
msgstr "Giờ thì cứu sao nổi nữa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.DISEASED"
msgid "It's caught a bit of a bug."
msgstr "Nó bị sâu bệnh một chút rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.DISEASING"
msgid "Lookin' a bit down."
msgstr "Trông có vẻ hơi ủ rũ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.GENERIC"
msgid "Saskatoon berries?"
msgstr "Dâu rừng Saskatoon hả?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.PICKED"
msgid "No berries left!"
msgstr "Chẳng còn quả dâu rừng nào!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.WITHERED"
msgid "It's perished from the heat, eh?"
msgstr "Nó héo úa vì trời nóng rồi, phải không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "Lookin' pretty barren."
msgstr "Trông trơ trọi quá nhỉ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "Can't save it now."
msgstr "Giờ thì cứu sao nổi nữa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "It's caught a bit of a bug."
msgstr "Nó bị sâu bệnh một chút rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "Lookin' a bit down."
msgstr "Trông có vẻ hơi ủ rũ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "I see a snack."
msgstr "Thấy món ăn vặt rồi đây."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "Eh, they'll be back."
msgstr "Hừm, chúng sẽ mọc lại thôi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "Dry as the Alberta plains."
msgstr "Khô hạn như vùng đồng bằng Alberta."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYSAUCE"
msgid "It's as sweet as you are, Luce."
msgstr "Nó ngọt ngào như cậu vậy, Luce."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIBINGKA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIBINGKA"
msgid "It's got a nice flavour to it."
msgstr "Nó có hương vị khá ngon đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIGFOOT"
msgid "Watch where you're stepping!"
msgstr "Nhìn cho kỹ chỗ mình đang bước đi chứ!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRCHNUTDRAKE"
msgid "I'll chop you too!"
msgstr "Tôi bổ cả cậu luôn bây giờ!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.DEAD"
msgid "I'm sorry. I failed you."
msgstr "Tôi xin lỗi. Tôi đã phụ lòng cậu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.GENERIC"
msgid "Where I try to make birds reform their evil ways."
msgstr "Nơi tôi cố gắng cảm hóa những con chim khỏi thói hư tật xấu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "I'll get you something to eat soon, buddy."
msgstr "Tôi sẽ kiếm cho cậu cái gì đó ăn sớm thôi, bạn hiền."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "Think aboot what you've done, bird!"
msgstr "Biết đường mà hối hận vì những gì mày đã làm đi, đồ chim chóc!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.SKELETON"
msgid "That's starting to smell."
msgstr "Cái đó bắt đầu bốc mùi rồi đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "They look so innocent when they dream."
msgstr "Chúng trông thật ngây thơ khi đang mơ màng."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.STARVING"
msgid "He's got a hankering for some poutine!"
msgstr "Nó đang thèm một đĩa khoai tây chiên sốt phô mai poutine kìa!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCORPSE.BURNING"
msgid "Finally."
msgstr "Cuối cùng cũng xong."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCORPSE.GENERIC"
msgid "I still don't trust it."
msgstr "Tôi vẫn không tin tưởng nó đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCORPSE.REVIVING"
msgid "This is the worst."
msgstr "Đây là điều tồi tệ nhất."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDTRAP"
msgid "I'll show those birds yet!"
msgstr "Rồi tôi sẽ cho lũ chim đó thấy tay tôi!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRD_EGG"
msgid "There's a bird in there, thinking evil bird thoughts."
msgstr "Có một con chim trong đó, đang suy tính những âm mưu đen tối của loài chim."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRD_EGG_COOKED"
msgid "Well, at least it never became a bird."
msgstr "Chà, ít nhất nó chưa từng nở thành chim."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRD_MUTANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRD_MUTANT"
msgid "I always knew they were evil."
msgstr "Tôi vẫn luôn biết chúng là loài ác độc."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRD_MUTANT_SPITTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRD_MUTANT_SPITTER"
msgid "See? You can never trust a bird!"
msgstr "Thấy chưa? Cậu không bao giờ có thể tin tưởng một con chim được!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BISHOP"
msgid "It's been a while since my last confession."
msgstr "Đã lâu lắm rồi kể từ lần xưng tội trước của tôi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Hey now!"
msgstr "Này hay nha!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BISHOP_NIGHTMARE"
msgid "I can see the internal workings!"
msgstr "Tôi có thể nhìn thấy cả cơ cấu bên trong luôn!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLACKFLAG"
msgid "I like my flags with a maple leaf on 'em."
msgstr "Tôi thích cờ có hình lá phong in trên đó cơ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_FIRE"
msgid "This seems a bit aggressive."
msgstr "Cái này có vẻ hơi hung hăng thì phải."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_LAVA"
msgid "I'm not much of a shot."
msgstr "Tôi không giỏi khoản ngắm bắn lắm."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_LAVA2"
msgid "Someone else'll make better use of it."
msgstr "Để người khác dùng sẽ có ích hơn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_PIPE"
msgid "Anyone want a demonstration of my impressive lungpower?"
msgstr "Có ai muốn xem màn biểu diễn dung tích phổi ấn tượng của tôi không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_SLEEP"
msgid "A couple blows on that and you can escape just aboot anything!"
msgstr "Thổi vài phát vào đó là cậu có thể trốn thoát khỏi bất cứ thứ gì luôn!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_YELLOW"
msgid "Gross bird parts made an okay weapon, I guess."
msgstr "Lấy mấy bộ phận kinh tởm của loài chim chế thành một món vũ khí tạm ổn, chắc vậy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUEAMULET"
msgid "Just need a tasty beverage to cool now, eh?"
msgstr "Giờ chỉ cần một món đồ uống mát lạnh để giải nhiệt thôi nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUEGEM"
msgid "It's very cold."
msgstr "Nó rất lạnh."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUEMOONEYE"
msgid "It sees all with the cold sight of the North."
msgstr "Nó nhìn thấu vạn vật bằng ánh nhìn lạnh lẽo của phương Bắc."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUEPRINT.COMMON"
msgid "I'm not one for book learning."
msgstr "Tôi không thích chuyện học hành sách vở cho lắm."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUEPRINT.RARE"
msgid "Looks real complicated, that one."
msgstr "Cái đó trông phức tạp thật đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUE_CAP"
msgid "That's not meat."
msgstr "Đó không phải là thịt."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUE_CAP_COOKED"
msgid "That's not meat."
msgstr "Đó không phải là thịt."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "I can never remember which ones you can eat."
msgstr "Tôi chẳng bao giờ nhớ nổi loại nào ăn được."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "I'll come back later."
msgstr "Tôi sẽ quay lại sau vậy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Well, that's over."
msgstr "Rồi, thế là xong chuyện."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOARDS"
msgid "So smooth. You can really see the grain."
msgstr "Mịn màng thật đấy. Nhìn rõ cả đường vân gỗ luôn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOARON"
msgid "I feel bad beatin' up such a little thing."
msgstr "Tôi thấy áy náy khi tẩn một sinh vật nhỏ bé thế này."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOARRIOR"
msgid "Tough guy, eh?"
msgstr "Cứng đầu gớm nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATFRAGMENT03"
msgid "Waste of good wood."
msgstr "Phí hoài gỗ tốt thật."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATFRAGMENT04"
msgid "Waste of good wood."
msgstr "Phí hoài gỗ tốt thật."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATFRAGMENT05"
msgid "Waste of good wood."
msgstr "Phí hoài gỗ tốt thật."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATPATCH"
msgid "This'll fix her right up."
msgstr "Cái này sẽ sửa nó ngon lành ngay."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATPATCH_KELP"
msgid "Not nearly as dependable as wood, but it'll do in a pinch."
msgstr "Không bền bằng gỗ được đâu, nhưng chữa cháy tạm thời thì cũng được."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "Keep your eye on the next checkpoint, Luce!"
msgstr "Tập trung vào điểm kiếm soát tiếp theo đi, Luce!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "Let's get it out on the water, eh?"
msgstr "Thả nó xuống nước nào, được chứ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "That's one shady lookin' sailor."
msgstr "Trông gã thủy thủ đó có vẻ mờ ám quá."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATRACE_SEASTACK"
msgid "Watch out for that buoy!"
msgstr "Cẩn thận cái phao tiêu kìa!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Watch out for that buoy!"
msgstr "Cẩn thận cái phao tiêu kìa!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "Into the water with ya!"
msgstr "Xuống nước với cậu nhé!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "Into the water with ya!"
msgstr "Xuống nước với cậu nhé!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "You here to watch the race, bud?"
msgstr "Cậu ra đây để xem đua thuyền à, nhóc?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATRACE_START"
msgid "A boat race? If you want a challenge, try log rolling."
msgstr "Đua thuyền á? Nếu muốn thử thách, hãy thử trò lăn khúc gỗ trên sông ấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "Let's get it out on the water, eh?"
msgstr "Thả nó xuống nước nào, được chứ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "Should help keep everything safely stowed away."
msgstr "Nên sẽ giúp cất giữ mọi thứ an toàn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "This boat's made of some solid old-growth lumber."
msgstr "Thuyền ván này được làm từ gỗ lâu năm rất chắc chắn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_BUMPER_CRABKING"
msgid "There ya go, nice and safe."
msgstr "Được rồi đấy, nằm trong két sắt an toàn nhé."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_BUMPER_CRABKING_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_BUMPER_CRABKING_KIT"
msgid "A bit of padding might be a good idea."
msgstr "Lót thêm một chút đệm thì có lẽ sẽ hay hơn đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_BUMPER_KELP"
msgid "There ya go, nice and safe."
msgstr "Được rồi đấy, nằm trong két sắt an toàn nhé."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "A bit of padding might be a good idea."
msgstr "Lót thêm một chút đệm thì có lẽ sẽ hay hơn đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "There ya go, nice and safe."
msgstr "Được rồi đấy, nằm trong két sắt an toàn nhé."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "A bit of padding might be a good idea."
msgstr "Lót thêm một chút đệm thì có lẽ sẽ hay hơn đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "Everyone will be givin' this boat a wide berth alright."
msgstr "Chắc chắn là ai nấy cũng sẽ tránh xa chiếc thuyền ván này cho mà xem."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "A bit of padding might be a good idea."
msgstr "Lót thêm một chút đệm thì có lẽ sẽ hay hơn đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "There's a big seabird out there I'd love to introduce you to."
msgstr "Ngoài kia có một con hải điểu lớn mà tôi rất muốn giới thiệu cho cậu đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "Looks like it could do some damage... if it was actually loaded."
msgstr "Trông có vẻ gây được khối sát thương... nếu như nó thực sự được nạp đạn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "I can't just load it with any old thing, eh?"
msgstr "Tôi không thể cứ nhét đại thứ vớ vẩn nào vào để bắn được đâu, phải không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_CANNON_KIT"
msgid "That cannon won't build itself, eh?"
msgstr "Khẩu đại bác đó không thể tự dựng lên được đâu, phải không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_GRASS_ITEM"
msgid "I'd rather have a boat made of good, dependable wood."
msgstr "Tôi thà đi thuyền ván làm bằng gỗ tốt, chắc chắn còn hơn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_ITEM"
msgid "It contains the base of the boat."
msgstr "Nó chứa phần thân cơ bản của chiếc thuyền ván."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_LEAK"
msgid "Better plug that up soon or we'll be swimmin'."
msgstr "Tốt hơn là nên bịt lại sớm, không thì chúng ta sẽ phải bơi đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "Now all I've gotta do is sit back, eh?"
msgstr "Giờ tất cả những gì tôi phải làm là ngồi ngả lưng thôi, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "Well, if it doesn't work I could always use it as an anchor."
msgstr "Chà, nếu nó không hoạt động thì tôi luôn có thể dùng làm dây neo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "Maybe you should keep your distance, Luce."
msgstr "Có lẽ cậu nên giữ khoảng cách đấy, Luce."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "That's one funny looking gadget."
msgstr "Đúng là một món đồ kỳ quặc."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_MAGNET_KIT"
msgid "Hope it's not too complicated."
msgstr "Mong là nó không quá phức tạp."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_ROTATOR"
msgid "Just gotta pick one way or the other, nice and simple."
msgstr "Chỉ cần chọn một hướng duy nhất, đơn giản và dễ dàng."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "Better get it set up on the boat, eh?"
msgstr "Tốt hơn là nên lắp đặt nó lên thuyền ván đi nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "It's not filled with goose down, is it?"
msgstr "Nó không được nhồi bằng lông ngỗng đâu nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BODYPILLOW_KELP"
msgid "At least it's not filled with feathers."
msgstr "Ít ra nó không được nhồi bằng lông vũ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BODYPILLOW_PETALS"
msgid "Smells like sleeping outside."
msgstr "Ngửi giống như cảm giác ngủ ngoài trời vậy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "Still better than one that's stuffed with nasty feathers."
msgstr "Vẫn đỡ hơn cái loại nhồi đầy lông vũ gớm ghiếc."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOMB_LUNARPLANT"
msgid "Let's kick things off with a bang, eh?"
msgstr "Hãy khởi đầu mọi thứ thật hoành tráng nào, được chứ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "Somethin' aboot it seems more dangerous than usual."
msgstr "Có cái gì đó ở nó trông nguy hiểm hơn bình thường."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BONESHARD"
msgid "I wish I knew how to make bread."
msgstr "Ước gì tôi biết cách làm bánh mì."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BONESOUP"
msgid "I could always go for a nice hearty soup."
msgstr "Tôi lúc nào cũng sẵn sàng cho một bát súp đậm đà."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BONESTEW"
msgid "Sticks to your ribs."
msgstr "No lâu ra phết đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOKSTATION.BURNT"
msgid "What a sorry sight, eh?"
msgstr "Thật là một cảnh tượng đáng tiếc phải không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOKSTATION.GENERIC"
msgid "Nice bit of woodworking there."
msgstr "Đúng là một sản phẩm mộc đẹp đẽ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_BEES"
msgid "There's a whole book on the little buzzers, eh?"
msgstr "Có cả một cuốn sách viết về mấy con vo ve nhỏ bé này cơ à?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_BIRDS"
msgid "I already know more than enough aboot those things."
msgstr "Tôi đã biết quá đủ về mấy thứ đó rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_BRIMSTONE"
msgid "I know better than to mess with that, eh."
msgstr "Tôi đủ khôn ngoan để không dây dưa với thứ đó."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_ELEMENTAL"
msgid "I'd rather stick with my axe, thanks."
msgstr "Tôi thà gắn bó với chiếc rìu của mình, cảm ơn nhé."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_FIRE"
msgid "My first instinct when I see a fire isn't to crack open a book."
msgstr "Phản xạ đầu tiên của tôi khi thấy lửa không phải là mở sách ra đọc."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_FISH"
msgid "Is there a chapter on ice fishing?"
msgstr "Có chương nào viết về câu cá trên băng đá không vậy?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_FOSSIL"
msgid "I'm leaving that to the experts."
msgstr "Tôi để việc đó cho các chuyên gia."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_GARDENING"
msgid "Does it grow trees?"
msgstr "Nó có làm cây cối mọc lên được không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_HORTICULTURE"
msgid "That's a lot of readin'... you sure it's the shorter version?"
msgstr "Nhiều chữ quá... cậu chắc đây là bản rút gọn chứ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "They sure gotta make gardening complicated, eh?"
msgstr "Đúng là họ làm cho việc làm vườn trở nên phức tạp thật, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_LIGHT"
msgid "Must be one of 'em book lights."
msgstr "Chắc lại là một trong mấy cái đèn gắn sách rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "I guess this is her idea of some light reading."
msgstr "Chắc đây là kiểu đọc sách giải trí của cô ấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_MOON"
msgid "I'm getting goosebumps just lookin' at it."
msgstr "Tôi nổi hết cả da gà khi nhìn vào nó đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_RAIN"
msgid "Could've really used this when I was livin' on the West Coast."
msgstr "Giá mà có cái này hồi tôi còn sống ở Bờ Tây."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "Eh, at the very least it'd make a good doorstop."
msgstr "Hừm, ít nhất thì nó dùng làm chặn cửa cũng tốt chán."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_SILVICULTURE"
msgid "Hey, I think this one grows trees!"
msgstr "Này, tôi nghĩ cuốn này trồng được cây đấy!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_SLEEP"
msgid "The perfect book for a full moon."
msgstr "Cuốn sách hoàn hảo cho đêm trăng tròn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_TEMPERATURE"
msgid "I'm alright with the cold, but summers ain't fun under all this hair."
msgstr "Tôi chịu được lạnh, nhưng mùa hè thì chẳng vui chút nào dưới lớp tóc tai này."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_TENTACLES"
msgid "They don't have tentacles in Canada."
msgstr "Canada làm gì có xúc tu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_WEB"
msgid "I deal with spiders enough, I don't need to read aboot them too!"
msgstr "Tôi đối phó với nhện đủ mệt rồi, không cần phải đọc về chúng nữa đâu!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOMERANG"
msgid "That looks hard to throw."
msgstr "Cái đó trông khó ném phết."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOTLEG"
msgid "How aboot we leg it out of here, eh?"
msgstr "Hay là chúng ta chuồn khỏi đây nhanh chân lên nào?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BROKEN_FORGEDITEM"
msgid "That thing's seen better days."
msgstr "Thứ đó qua thời hoàng kim lâu rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BROKEN_FUMAROLETOOLITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BROKEN_FUMAROLETOOLITEM"
msgid "Bet I could stick the pieces back together with some heat."
msgstr "Cá là tôi có thể dùng nhiệt để gắn các mảnh lại với nhau."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BRUSH"
msgid "You could debark a log with this thing."
msgstr "Cậu có thể dùng cái này để lột vỏ gỗ đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUGNET"
msgid "It can collect skeeters."
msgstr "Nó dùng để bắt muỗi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "Look, sea plants."
msgstr "Nhìn kìa, thực vật biển."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "Picked clean."
msgstr "Đã bị vặt sạch trơn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BULLKELP_ROOT"
msgid "Seems a bit cruel, doesn't it?"
msgstr "Có vẻ hơi tàn nhẫn nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUNDLE"
msgid "What's inside? Hope it's logs."
msgstr "Có gì trong này nhỉ? Mong là gỗ khúc."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUNDLEWRAP"
msgid "The paper's brown. Like wood."
msgstr "Giấy màu nâu. Giống như gỗ vậy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUNNYMAN"
msgid "He looks friendly enough."
msgstr "Trông hắn cũng khá thân thiện."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUNNYSTEW"
msgid "A hearty comfort food."
msgstr "Một món ăn bổ dưỡng làm ấm lòng."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BURNT_MARSH_BUSH"
msgid "Done for."
msgstr "Tiêu đời rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUSHHAT"
msgid "It's good for hiding from nature."
msgstr "Nó rất hữu ích để trốn tránh thiên nhiên."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUTTER"
msgid "I prefer margarine."
msgstr "Tôi thích bơ thực vật hơn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUTTERFLY.GENERIC"
msgid "I never trusted those things, eh?"
msgstr "Tôi chưa bao giờ tin tưởng mấy thứ đó."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUTTERFLY.HELD"
msgid "Where are you going to run?"
msgstr "Mày chạy đi đâu được chứ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUTTERFLYMUFFIN"
msgid "Crunchy! ...But soft?"
msgstr "Giòn rụm! ...Nhưng mà mềm mại?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUTTERFLYWINGS"
msgid "Sorry! Sorry. How awful!"
msgstr "Xin lỗi nhé! Xin lỗi nha. Tệ thật đấy!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUZZARD"
msgid "Stay away from those meat snacks!"
msgstr "Tránh xa mấy miếng thịt ăn vặt đó ra!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUZZARDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUZZARDCORPSE.BURNING"
msgid "Finally."
msgstr "Cuối cùng cũng xong."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUZZARDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUZZARDCORPSE.GENERIC"
msgid "I still don't trust it."
msgstr "Tôi vẫn không tin tưởng nó đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUZZARDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUZZARDCORPSE.REVIVING"
msgid "This is the worst."
msgstr "Đây là điều tồi tệ nhất."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CABBAGEROLLS"
msgid "That's some tasty grub!"
msgstr "Đúng là một bữa con sâu ngon lành!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CACTUS.GENERIC"
msgid "That's gonna hurt."
msgstr "Cái đó đau đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CACTUS.PICKED"
msgid "Called it."
msgstr "Đúng như dự đoán."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CACTUS_FLOWER"
msgid "It's a wonder anything grows in this climate at all."
msgstr "Thật kỳ diệu khi thứ gì đó có thể mọc nổi trong cái khí hậu này."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CACTUS_MEAT"
msgid "Would you put nails in your mouth?"
msgstr "Cậu có muốn ngậm đinh vào mồm không hả?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "Much better."
msgstr "Đỡ hơn nhiều rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CALIFORNIAROLL"
msgid "That fish looks cozy bundled up in all that rice and seaweed."
msgstr "Con cá trông thật ấm cúng khi được cuốn gọn gàng trong cơm và rong biển để câu cá."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.EMBERS"
msgid "It's almost gone."
msgstr "Nó sắp tàn rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.GENERIC"
msgid "Where's my guitar?"
msgstr "Cây đàn ghi-ta của tôi đâu rồi nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.HIGH"
msgid "Uh oh! It's bit high!"
msgstr "Ối chà! Cháy hơi cao rồi đấy!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.LOW"
msgid "I should probably do something aboot that, eh?"
msgstr "Chắc tôi phải làm gì đó với nó thôi, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.NORMAL"
msgid "I love a fire in the evening."
msgstr "Tôi rất thích đốt lửa vào buổi tối."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.OUT"
msgid "It was good while it lasted."
msgstr "Nó đã làm tốt nhiệm vụ khi còn cháy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CANARY.GENERIC"
msgid "Degenerate."
msgstr "Đồ đồi trụy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CANARY.HELD"
msgid "Want a peek at our prisoner, Lucy?"
msgstr "Muốn ngó qua tù nhân của chúng ta tí không, Lucy?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CANARY_POISONED"
msgid "Diseased vermin."
msgstr "Lũ sâu bệnh mang mầm bệnh."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CANDYBAG"
msgid "That there bag could hold a whole heap of candy."
msgstr "Cái túi đó có thể chứa cả một đống cục kẹo to."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CANE"
msgid "It's good for the back country."
msgstr "Nó rất hữu ích khi đi vào vùng rừng núi hoang sơ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CANNONBALL_ROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CANNONBALL_ROCK_ITEM"
msgid "I sure wouldn't want one of these fired at my boat."
msgstr "Tôi chắc chắn không muốn thứ này bắn vào thuyền ván của mình đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALCANNON.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALCANNON.COOLDOWN"
msgid "Sure does cheer you up, eh?"
msgstr "Thấy phấn chấn hẳn lên đúng không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALCANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALCANNON.GENERIC"
msgid "This would be great for scaring birds away."
msgstr "Cái này dùng để dọa lũ chim đi chỗ khác thì tuyệt."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALCANNON_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALCANNON_KIT"
msgid "Gives you the most bang for your buck, eh?"
msgstr "Đáng đồng tiền bát gạo phết chứ lị, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_BANNER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_BANNER"
msgid "Argh, it flashed the sun in my eyes! Curse you, birds!!"
msgstr "Ái chà, nó chói thẳng vào mắt tôi! Đồ lũ chim chết tiệt!!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_BANNER_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_BANNER_KIT"
msgid "Maybe I've been overreactin'. A little decoration won't do any harm, eh?"
msgstr "Có lẽ tôi hơi phản ứng thái quá rồi. Trang trí một chút chắc không hại gì đâu nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_EGGRIDE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_EGGRIDE"
msgid "Those things better not hatch."
msgstr "Mong là mấy thứ đó đừng có nở."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT"
msgid "Don't know why I'd want to build somethin' like that."
msgstr "Chẳng hiểu sao mình lại muốn xây cái thứ như thế này nữa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC"
msgid "Those birds are mockin' me, I just know it."
msgstr "Lũ chim đó đang chế nhạo tôi, chắc chắn là vậy rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_FIGURE.RARE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_FIGURE.RARE"
msgid "Maybe I'll give it to Willow. She'll know what to do with it."
msgstr "Có lẽ tôi sẽ đưa nó cho Willow. Cô ấy sẽ biết phải làm gì với nó."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON"
msgid "I'm not keeping that thing around."
msgstr "Tôi không giữ cái thứ đó quanh mình đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_FIGURE_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_FIGURE_KIT"
msgid "I can't stop wondering what's inside..."
msgstr "Tôi cứ thắc mắc mãi không biết bên trong có gì..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2"
msgid "I can't stop wondering what's inside..."
msgstr "Tôi cứ thắc mắc mãi không biết bên trong có gì..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON3"
msgid "I can't stop wondering what's inside..."
msgstr "Tôi cứ thắc mắc mãi không biết bên trong có gì..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_LAMP"
msgid "Alright I admit, this one's pretty nice."
msgstr "Thôi được, tôi thừa nhận cái này trông khá đẹp đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_LAMP_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_LAMP_KIT"
msgid "Might as well get it set up, eh?"
msgstr "Lắp đặt nó lên luôn thôi nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_PLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_PLANT"
msgid "This better not attract any smaller birds..."
msgstr "Mong là thứ này không thu hút thêm mấy con chim nhỏ nào nữa..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_PLANT_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALDECOR_PLANT_KIT"
msgid "Might as well get it set up, eh?"
msgstr "Lắp đặt nó lên luôn thôi nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALFOOD_CORNTEA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALFOOD_CORNTEA"
msgid "Hm. Chunky."
msgstr "Hừm. Lợn cợn quá."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD"
msgid "Not very appetizing."
msgstr "Trông không ngon miệng cho lắm."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT"
msgid "Those good-for-nothing birds can't even set up their own carnival?"
msgstr "Lũ chim vô tích sự đó đến cái hội chợ của chúng mà cũng không tự dựng lên được á?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST"
msgid "What kinda horrible bird secrets are they hiding down there..."
msgstr "Không biết chúng đang giấu cái bí mật bệnh hoạn gì dưới đó..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC"
msgid "You want somethin' shiny? How aboot my shiny axe!"
msgstr "Cậu muốn thứ gì đó lấp lánh à? Thế cái rìu sáng bóng của tôi thì sao!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING"
msgid "All that beautiful wood wasted on carving birds..."
msgstr "Bao nhiêu gỗ đẹp thế mà lại đem đi tạc tượng chim chóc, thật uổng phí..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFBALL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFBALL"
msgid "No, you may not, Luce."
msgstr "Không, cậu không được phép đâu, Luce."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFCLUB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFCLUB"
msgid "Don't tell me you're jealous of a putter, Lucy."
msgstr "Đừng bảo là cậu đang ghen tị với cây gậy gạt bóng đấy nhé, Lucy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_DIY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_DIY"
msgid "Finally, my own mini- c'mon, Luce! I have other talents!"
msgstr "Cuối cùng cũng có sân mini của riêng mìn- thôi nào, Luce! Tôi còn có tài năng khác nữa!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_EASY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_EASY"
msgid "Nice little warmup round."
msgstr "Một vòng khởi động nho nhỏ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_HARD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_HARD"
msgid "Ooh, tricky... no, I have not been golfing all day, Lucy."
msgstr "Ồ, hóc búa phết... không, tôi đâu có chơi gôn suốt cả ngày đâu, Lucy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_MEDIUM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_MEDIUM"
msgid "Something for the casual duffer."
msgstr "Món quà dành cho những tay chơi gôn nghiệp dư."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFPROP_CUTOUT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFPROP_CUTOUT"
msgid "I should just chop that down."
msgstr "Tôi nên chặtừm quách nó đi cho rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFPROP_FAN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFPROP_FAN"
msgid "I love a cool breeze, but that's just annoying."
msgstr "Tôi thích gió mát thật đấy, nhưng thế này thì phiền phức quá."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFPROP_FENCE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFPROP_FENCE"
msgid "That'll keep the ball from wandering off."
msgstr "Cái đó sẽ ngăn quả bóng lăn đi mất."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFPROP_MOVINGWALL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFPROP_MOVINGWALL"
msgid "Just need to time it right."
msgstr "Chỉ cần tính toán thời gian cho chuẩn là được."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFPROP_SPINNER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFPROP_SPINNER"
msgid "It's just a spinning headache."
msgstr "Chỉ làm nhức đầu thêm vì xoay mòng mòng thôi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFPROP_SPRING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFPROP_SPRING"
msgid "Not much control here."
msgstr "Chẳng kiểm soát được mấy ở đây."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFPROP_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLFPROP_WORMHOLE"
msgid "I don't trust it one bit."
msgstr "Tôi không tin tưởng nó dù chỉ một chút."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLF_HOLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLF_HOLE"
msgid "Yes, Lucy. I counted every stroke."
msgstr "Đúng vậy, Lucy. Tôi đếm từng cú đánh luôn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLF_HOLE_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLF_HOLE_KIT"
msgid "Let's just put it somewhere fair."
msgstr "Cứ đặt nó vào một chỗ công bằng là được."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLF_TEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLF_TEE.GENERIC"
msgid "Hm, needs a token eh?"
msgstr "Hừm, cần có một đồng xu nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLF_TEE.INACTIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLF_TEE.INACTIVE"
msgid "The course needs a flaghole still."
msgstr "Sân chơi vẫn cần có lỗ cắm cờ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLF_TEE.PLAYING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLF_TEE.PLAYING"
msgid "The game is going already."
msgstr "Trò chơi đang diễn ra rồi kìa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLF_TEE_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_GOLF_TEE_KIT"
msgid "Just put it on solid ground and call it a day."
msgstr "Cứ đặt lên bãi đất trống rồi tính tiếp."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_HERDING_CHICK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_HERDING_CHICK"
msgid "Get back here, you hoser!"
msgstr "Đứng lại đây xem nào, đồ ôn dịch!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_HERDING_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_HERDING_KIT"
msgid "Those good-for-nothing birds can't even set up their own carnival?"
msgstr "Lũ chim vô tích sự đó đến cái hội chợ của chúng mà cũng không tự dựng lên được á?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC"
msgid "You want somethin' shiny? How aboot my shiny axe!"
msgstr "Cậu muốn thứ gì đó lấp lánh à? Thế cái rìu sáng bóng của tôi thì sao!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING"
msgid "Seeing those things run around gives me the willies."
msgstr "Nhìn mấy thứ đó chạy quanh làm tôi nổi hết cả da gà."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC"
msgid "What kinda horrible bird secrets are they hiding down there..."
msgstr "Không biết chúng đang giấu cái bí mật bệnh hoạn gì dưới đó..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING"
msgid "Those birds are trying to trick me... but I'm smarter..."
msgstr "Lũ chim đó đang định lừa tôi... nhưng tôi thông minh hơn thế..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_MEMORY_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_MEMORY_KIT"
msgid "Those good-for-nothing birds can't even set up their own carnival?"
msgstr "Lũ chim vô tích sự đó đến cái hội chợ của chúng mà cũng không tự dựng lên được á?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC"
msgid "You want somethin' shiny? How aboot my shiny axe!"
msgstr "Cậu muốn thứ gì đó lấp lánh à? Thế cái rìu sáng bóng của tôi thì sao!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING"
msgid "Mighty unsettling."
msgstr "Hơi bị đáng sợ đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT"
msgid "Those good-for-nothing birds can't even set up their own carnival?"
msgstr "Lũ chim vô tích sự đó đến cái hội chợ của chúng mà cũng không tự dựng lên được á?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC"
msgid "You want somethin' shiny? How aboot my shiny axe!"
msgstr "Cậu muốn thứ gì đó lấp lánh à? Thế cái rìu sáng bóng của tôi thì sao!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING"
msgid "They're trying to distract us, I'm sure those birds are plotting something..."
msgstr "Chúng đang cố đánh lạc hướng chúng ta, chắc chắn lũ chim đó đang mưu tính gì rồi..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC"
msgid "You want somethin' shiny? How aboot my shiny axe!"
msgstr "Cậu muốn thứ gì đó lấp lánh à? Thế cái rìu sáng bóng của tôi thì sao!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING"
msgid "It's gotta be a trap... you can't trust anything made by birds."
msgstr "Chắc chắn là cái bẫy rồi... không thể tin tưởng bất cứ thứ gì do chim làm ra được đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_SHOOTING_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_SHOOTING_KIT"
msgid "Those good-for-nothing birds can't even set up their own carnival?"
msgstr "Lũ chim vô tích sự đó đến cái hội chợ của chúng mà cũng không tự dựng lên được á?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC"
msgid "You want somethin' shiny? How aboot my shiny axe!"
msgstr "Cậu muốn thứ gì đó lấp lánh à? Thế cái rìu sáng bóng của tôi thì sao!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING"
msgid "Defend a nest? Of birds?!"
msgstr "Bảo vệ một cái tổ á? Của loài chim á?!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC"
msgid "What kinda horrible bird secrets are they hiding down there..."
msgstr "Không biết chúng đang giấu cái bí mật bệnh hoạn gì dưới đó..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING"
msgid "I'm supposed to hit the one that looks like a bird, right?"
msgstr "Tôi phải bắn trúng cái trông giống chim phải không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT"
msgid "Those good-for-nothing birds can't even set up their own carnival?"
msgstr "Lũ chim vô tích sự đó đến cái hội chợ của chúng mà cũng không tự dựng lên được á?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC"
msgid "You want somethin' shiny? How aboot my shiny axe!"
msgstr "Cậu muốn thứ gì đó lấp lánh à? Thế cái rìu sáng bóng của tôi thì sao!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING"
msgid "It's too easy... what's the catch, eh?"
msgstr "Dễ quá vậy... bẫy ngầm ở đâu đây, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_BALL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_BALL"
msgid "Would've preferred a hockey puck, but this'll work."
msgstr "Ước gì là quả bóng khúc côn cầu, nhưng thế này cũng dùng được."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_CROWKID
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_CROWKID"
msgid "I think I had a nightmare like this once..."
msgstr "Tôi nghĩ mình từng gặp một cơn ác mộng thế này rồi..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_GAMETOKEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_GAMETOKEN"
msgid "I don't trust anything from a bird."
msgstr "Tôi không tin tưởng bất cứ thứ gì từ loài chim."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_HOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_HOST"
msgid "There's just somethin' aboot him I don't trust..."
msgstr "Có cái gì đó ở gã này khiến tôi không thể tin tưởng nổi..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_PLAZA.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
msgid "If I can't chop it down, might as well pretty it up, eh?"
msgstr "Nếu không chặt được nó đi thì trang trí cho đẹp lên vậy, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
msgid "Oh no... I think the decorations are attractin' more birds..."
msgstr "Ôi không... tôi nghĩ mấy món đồ trang trí đang thu hút thêm nhiều chim chóc hơn đấy..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3"
msgid "The tree's been decorated, but at what cost..."
msgstr "Cái cây đã được trang trí, nhưng cái giá phải trả là gì..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_PLAZA_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_PLAZA_KIT"
msgid "The one thing birds are good for, planting trees."
msgstr "Công dụng duy nhất của loài chim là trồng cây."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC"
msgid "Wonder where those birds stole these prizes from..."
msgstr "Tự hỏi lũ chim đó ăn cắp mấy phần thưởng này từ đâu nhỉ..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT"
msgid "I'm only setting this up out of curiosity."
msgstr "Tôi dựng cái này lên chỉ vì tò mò thôi đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC"
msgid "I bet they rig the games, that'd be just like a bird..."
msgstr "Cá là chúng gian lận trò chơi rồi, đúng là bản tính của loài chim..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK"
msgid "Those birds thought they could cheat me, eh? Guess again!"
msgstr "Lũ chim tưởng chúng có thể lừa được tôi á? Nghĩ lại đi!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
msgid "Huh. I managed to collect a pretty good pile."
msgstr "Hả. Tôi gom lại được một đống khá ra trò đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_SEEDPACKET"
msgid "Hmph. Bird food."
msgstr "Hừm. Thức ăn cho chim."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_VEST_A
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_VEST_A"
msgid "Eh, it's alright. For being bird-made."
msgstr "Hừ, cũng tạm được. Cho một món do chim làm."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_VEST_B
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_VEST_B"
msgid "It came from a tree, but also from a bird... I'm feelin' conflicted."
msgstr "Nó xuất phát từ một cái cây, nhưng lại là từ một con chim... tôi thấy mâu thuẫn quá."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_VEST_C
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVAL_VEST_C"
msgid "At least it keeps the sun off me, eh?"
msgstr "Ít ra nó cũng che được nắng cho tôi, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARPENTRY_BLADE_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARPENTRY_BLADE_MOONGLASS"
msgid "I know, Lucy. You're more versatile."
msgstr "Tôi biết rồi, Lucy. Cậu đa năng hơn nhiều."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARPENTRY_STATION.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARPENTRY_STATION.BURNT"
msgid "Lucy! Tell me you didn't."
msgstr "Lucy! Nói với tôi là cậu không làm thế đi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARPENTRY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARPENTRY_STATION.GENERIC"
msgid "Don't worry Luce. She's got nothin' on ya."
msgstr "Đừng lo Luce. Mấy món đó không có cửa so với cậu đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARRAT.DEAD"
msgid "It's dead."
msgstr "Nó chết rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARRAT.GENERIC"
msgid "That carrot's a rat!"
msgstr "Con cà rốt đó là một con chuột!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARRAT.HELD"
msgid "I gotcha now."
msgstr "Tóm được cậu rồi nhé."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARRAT.SLEEPING"
msgid "Huh. It's sleeping."
msgstr "Hả. Nó đang ngủ kìa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARRAT_GHOSTRACER"
msgid "That thing's giving me the creeps."
msgstr "Thứ đó làm tôi nổi da gà."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARROT"
msgid "That's rabbit food."
msgstr "Đó là thức ăn cho thỏ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARROT_COOKED"
msgid "That's cooked rabbit food."
msgstr "Đó là thức ăn cho thỏ đã nấu chín."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARROT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARROT_OVERSIZED"
msgid "That's giant rabbit food. Luckily we've got those 'round here."
msgstr "Đó là thức ăn cho thỏ khổng lồ. May là quanh đây có mấy thứ đó."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARROT_PLANTED"
msgid "I'm not one for vegetables, eh?"
msgstr "Tôi không khoái rau củ cho lắm, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARROT_SEEDS"
msgid "Tiny seeds."
msgstr "Những hạt nhỏ xíu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "Looks like the map ends here."
msgstr "Có vẻ như tấm bản đồ kết thúc ở đây."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "Eh, I prefer to just wander around the woods anyway."
msgstr "Hừm, tôi thích đi lang thang trong rừng hơn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "Heh. Has a little compass and everything."
msgstr "Heh. Có cả một chiếc la bàn nhỏ và đủ thứ luôn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CATCOON"
msgid "Pests."
msgstr "Lũ phiền phức."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CATCOONDEN.EMPTY"
msgid "Good riddance."
msgstr "Thật là nhẹ cả người."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CATCOONDEN.GENERIC"
msgid "Ugh, how many more lives do you have?"
msgstr "Ugh, mày còn mấy mạng nữa hả?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CATCOONHAT"
msgid "The traditional garb of the woodsman."
msgstr "Trang phục truyền thống của thợ săn rừng."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CATTOY_MOUSE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CATTOY_MOUSE"
msgid "It's pretty convincing."
msgstr "Trông giống thật phết."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "Some elbow grease'll move those, easy."
msgstr "Dùng chút sức lực là dời được mấy cục đá đó thôi, dễ ợt."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "Can't reach that one."
msgstr "Không với tới cái đó được."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_BANANA"
msgid "It tastes tropical."
msgstr "Nó có vị nhiệt đới."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_BANANA_BURNT"
msgid "Such a waste."
msgstr "Thật uổng phí."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Now it's a warm mush."
msgstr "Giờ nó thành một thứ bột nhão ấm ấm."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_BANANA_TREE"
msgid "They don't have those back home."
msgstr "Quê nhà tôi không có mấy thứ này."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_ENTRANCE"
msgid "It's all bunged up."
msgstr "Nó bị bít kín mít rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "More crowded than a Toronto subway!"
msgstr "Đông đúc hơn cả tàu điện ngầm ở Toronto!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "There're probably no trees down there anyway."
msgstr "Dưới đó chắc cũng chẳng có cây cối gì đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "It looks like Sudbury down there."
msgstr "Dưới đó trông giống hệt Sudbury vậy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "It's all bunged up."
msgstr "Nó bị bít kín mít rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_EXIT.FULL"
msgid "Sorry! I'll wait til you're all done up there!"
msgstr "Xin lỗi nhé! Tôi sẽ đợi đến khi tất cả các cậu lên trên đó!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "Maybe later. I've gotten cozy down here."
msgstr "Để sau đi. Tôi thấy ở dưới này cũng ấm cúng rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_EXIT.OPEN"
msgid "There are probably trees up there."
msgstr "Trên đó chắc là có cây cối đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_FERN"
msgid "Hey! It's a fern!"
msgstr "Này! Là một nhánh dương xỉ!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_FERN_WITHERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_FERN_WITHERED"
msgid "Hey, it's dead!"
msgstr "Này, nó chết ngóm rồi!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_VENT_MITE.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_VENT_MITE.DEAD"
msgid "That's a dead bug."
msgstr "Đó là một con côn trùng đã chết."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_VENT_MITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_VENT_MITE.GENERIC"
msgid "Stay away from me, bug!"
msgstr "Tránh xa tôi ra, đồ côn trùng!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_VENT_MITE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_VENT_MITE.SLEEPING"
msgid "We should get it while it's sleeping."
msgstr "Chúng ta nên xử lý nó lúc nó đang ngủ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_VENT_MITE.VENTING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_VENT_MITE.VENTING"
msgid "Watch out for the gas!"
msgstr "Cẩn thận khí độc kìa!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_VENT_ROCK.GAS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_VENT_ROCK.GAS"
msgid "Did you catch a whiff of that, Luce?"
msgstr "Cậu có ngửi thấy mùi gì không, Luce?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_VENT_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_VENT_ROCK.GENERIC"
msgid "I'd rather not wait around."
msgstr "Tôi không muốn đứng chờ ở đây đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_VENT_ROCK.HOT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_VENT_ROCK.HOT"
msgid "I'm not cut out for this climate."
msgstr "Tôi không hợp với cái khí hậu này chút nào."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_VENT_ROCK.MIASMA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_VENT_ROCK.MIASMA"
msgid "Smells like trouble."
msgstr "Ngửi có mùi rắc rối đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CEILING_ROPE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CEILING_ROPE"
msgid "That's a nice climbing rope."
msgstr "Đó là một sợi dây thừng leo núi rất tốt."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CEVICHE"
msgid "I'd be loonie not to eat this."
msgstr "Tôi chắc là điên rồi mới không ăn món này."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHARCOAL"
msgid "This makes me a bit sad."
msgstr "Cái này làm tôi hơi buồn đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHARLIERESIDUE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHARLIERESIDUE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHARLIEROSE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHARLIEROSE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHARLIE_HAND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHARLIE_HAND"
msgid "Not exactly a helping hand, eh?"
msgstr "Không hẳn là một tay giúp đỡ đâu nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHARLIE_HECKLER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHARLIE_HECKLER"
msgid "Birds... it's always the birds..."
msgstr "Lại là chim... lúc nào cũng là chim..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHARLIE_LECTURN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHARLIE_LECTURN"
msgid "Anything good on?"
msgstr "Có gì hay ho đang chiếu không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHARLIE_NPC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHARLIE_NPC"
msgid "Her face looks familiar, I think I've seen it in my nightmares."
msgstr "Khuôn mặt đó trông quen quá, hình như tôi thấy nó trong ác mộng rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHARLIE_STAGE_POST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHARLIE_STAGE_POST"
msgid "I don't like being put in the spotlight."
msgstr "Tôi không thích bị chú ý thế này đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSJUNK1"
msgid "Dead metal."
msgstr "Kim loại chết."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSJUNK2"
msgid "Dead metal."
msgstr "Kim loại chết."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSJUNK3"
msgid "Dead metal."
msgstr "Kim loại chết."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "Looks good to me."
msgstr "Trông ổn phết."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_ANTLION"
msgid "Looks almost real, eh?"
msgstr "Trông cứ như thật ấy nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_BEARGER"
msgid "Good use of stone."
msgstr "Tạc đá khéo đấy chứ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_BEARGER_MUTATED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_BEARGER_MUTATED"
msgid "We sure showed big boy, eh Luce?"
msgstr "Chúng ta vừa cho cậu bạn to xác một bài học nhỉ, Lucy?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_BEEFALO"
msgid "Some real fine detail on the fur there."
msgstr "Từng đường nét trên bộ lông tỉ mỉ phết."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "Some nice detail on that."
msgstr "Chi tiết điêu khắc đẹp phết."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "That's not really my sort of thing, eh?"
msgstr "Cái này không phải gu của tôi lắm nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "Get ready, Lucy."
msgstr "Chuẩn bị nào, Lucy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "Reminds me of nature."
msgstr "Làm tôi nhớ đến thiên nhiên."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_CARRAT"
msgid "Looks well made."
msgstr "Trông làm tỉ mỉ phết."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_CATCOON"
msgid "Real nice detailing on the fur there."
msgstr "Từng đường nét trên bộ lông chi tiết thật."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "All the dog, none of the smell."
msgstr "Đủ hình dáng con chó, nhưng chẳng có tí mùi nào."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "Not a wood sculpture, but it'll do."
msgstr "Không phải tượng gỗ, nhưng tạm ổn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_CRABKING"
msgid "That's nicely made."
msgstr "Làm đẹp đấy chứ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "Not lookin' so tough now, eh?"
msgstr "Giờ thì trông không còn khó nhằn nữa rồi nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_DAYWALKER2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_DAYWALKER2"
msgid "He keeps coming back for more, eh?"
msgstr "Cứ thích quay lại ăn đấm nữa cơ à?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "Fine detail on that base."
msgstr "Chi tiết cái bệ đẹp phết."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "She'd look great up on the mantle."
msgstr "Tre lên lò sưởi thì trông hết sảy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_DEPTHWORM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_DEPTHWORM"
msgid "We had some close calls with this guy, eh Luce?"
msgstr "Suýt thì toi mạng với tay này mấy bận đấy, Lucy nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "Good stonework."
msgstr "Đồ đá làm khéo đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "That's the worst case of cataract I've ever seen."
msgstr "Đó là ca cườm mắt nặng nhất mà tôi từng thấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_FORMAL"
msgid "Looks like a bit of a hoser."
msgstr "Trông hơi giống một tay rướm máu nhỉ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "From ornery to ornament, eh?"
msgstr "Từ cáu kỉnh thành đồ trang trí rồi nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "Well, I did say I had a hankering for \"stone fruit\"."
msgstr "Ừ thì, tôi đã bảo là mình đang thèm Trái Cây Đá mà."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_KITCOON"
msgid "Usually somethin' like this would be carved outta wood."
msgstr "Mấy món thế này thường được đẽo từ gỗ chứ nhỉ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_KLAUS"
msgid "Can't complain aboot that worksmanship."
msgstr "Không thể phàn nàn gì về tay nghề này được."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "I miss horses."
msgstr "Tôi nhớấy mấy con ngựa quá."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "Get ready, Lucy."
msgstr "Chuẩn bị nào, Lucy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "I'm not puttin' that anywhere near my base."
msgstr "Tôi không đem thứ đó đặt gần căn cứ của mình đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "Someone worked hard on that."
msgstr "Ai đó đã tốn khối công sức cho cái này đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "Gotta say I prefer it to the original."
msgstr "Phải nói là tôi thích cái này hơn bản gốc đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_MOON"
msgid "Someone did a good job on this."
msgstr "Ai đó làm cái này cừ thật."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "Looks sturdy."
msgstr "Trông có vẻ chắc chắn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_MUSE"
msgid "I don't tend to trust anyone without a face. Lucy excluded, of course."
msgstr "Tôi không hay tin tưởng kẻ nào không có mặt mũi. Trừ Lucy ra, đương nhiên rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_PAWN"
msgid "Just a humble peasant, really."
msgstr "Chỉ là một tên nông dân khiêm tốn thôi mà."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_PIPE"
msgid "Kitschy. Just how Lucy and I like it."
msgstr "Sến súa. Đúng kiểu tôi và Lucy thích."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "Pfft, tacky."
msgstr "Pừ, quê mùa quá."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "Get ready, Lucy."
msgstr "Chuẩn bị nào, Lucy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_SHARKBOI
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_SHARKBOI"
msgid "Hey there, fish breath."
msgstr "Chào nhé, đồ miệng cá."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_STALKER"
msgid "Nothin' wrong with it now."
msgstr "Giờ thì chẳng có gì chê được nữa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "Structurally sound."
msgstr "Kết cấu vững chắc."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "They make a good lookin' statue, eh?"
msgstr "Trông chúng thành bức tượng đẹp phết nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD"
msgid "Kinda sad now, eh?"
msgstr "Giờ thấy hơi buồn rồi đấy nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR"
msgid "That was a bad one... and weird."
msgstr "Cú đó tệ thật... lại còn dị nữa chứ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT"
msgid "Remember when it tried to kill us, Luce?"
msgstr "Còn nhớ lúc nó cố kết liễu chúng ta không, Luce?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "There's a good dog."
msgstr "Đúng là một chú cún ngoan."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_WORMBOSS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_WORMBOSS"
msgid "I still have nightmares about that thing."
msgstr "Tôi vẫn còn bị ám ảnh bởi thứ đó."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_YOTD"
msgid "Some nice stonework. Would've looked even better carved outta pine."
msgstr "Điêu khắc đá đẹp phết. Đẽo từ gỗ thông chắc còn đẹp hơn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_YOTH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_YOTH"
msgid "It could be really mean when it wanted to be."
msgstr "Nó có thể cực kỳ đểu cáng khi muốn đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_YOTS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_YOTS"
msgid "It would've looked better carved out of wood."
msgstr "Đẽo bằng gỗ thì trông còn đẹp hơn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESTER"
msgid "He's doing his best!"
msgstr "Nó đang cố hết sức rồi đấy!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "No one ever told him it was rude to stare."
msgstr "Chẳng ai bảo với nó nhìn chằm chằm là bất lịch sự cả."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "I wonder if it will ever wake up again."
msgstr "Không biết bao giờ nó mới tỉnh lại đây."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "Guess this thing will hollow out more space in my storage chest?"
msgstr "Chắc thứ này sẽ đào sâu thêm chút không gian trong rương trữ đồ của tôi nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHEST_MIMIC_REVEALED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHEST_MIMIC_REVEALED"
msgid "No! Noooo!"
msgstr "Không! Khônggggg!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHUM"
msgid "Smells bad, but the fish love it."
msgstr "Ngửi tệ thật, nhưng bọn cá thì thích mê."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CLAYHOUND.GENERIC"
msgid "Earth hounds!"
msgstr "Chó đất kìa!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CLAYHOUND.STATUE"
msgid "Someone carved each individual hair."
msgstr "Ai đó đã chạm trổ từng sợi lông một luôn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CLAYWARG.GENERIC"
msgid "Look at the size of you."
msgstr "Nhìn kích thước của mày kìa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CLAYWARG.STATUE"
msgid "Wonder where that sculpture came from."
msgstr "Tự hỏi bức tượng đó từ đâu ra nhỉ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.EMBERS"
msgid "It's almost gone."
msgstr "Nó sắp tắt mất rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.GENERIC"
msgid "This'll make it feel more like home."
msgstr "Cái này làm tôi thấy ấm cúng như ở nhà."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.HIGH"
msgid "Uh oh! It's bit high!"
msgstr "Ối trời! Hơi cao quá rồi đấy!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.LOW"
msgid "I should probably do something aboot that, eh?"
msgstr "Chắc tôi nên làm gì đó với nó thôi nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.NORMAL"
msgid "I love a cold fire in the evening."
msgstr "Tôi rất thích đống lửa lạnh vào buổi tối."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.OUT"
msgid "It was good while it lasted."
msgstr "Vẫn tuyệt chừng nào nó còn cháy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "I should go chop some wood for that, eh?"
msgstr "Chắc tôi phải đi chặt ít củi cho nó thôi nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "It uses wood."
msgstr "Nó dùng củi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.HIGH"
msgid "That's too much wood too fast!"
msgstr "Cho quá nhiều củi cháy nhanh quá rồi!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.LOW"
msgid "There should be some wood around here somewhere."
msgstr "Quanh đây chắc phải có ít củi chứ nhỉ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "Mmmm. Smells woody."
msgstr "Mmmm. Thơm mùi gỗ phết."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.OUT"
msgid "If only I had some wood."
msgstr "Giá mà tôi có ít củi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLLAPSEDCHEST"
msgid "Nobody's blamin' you, Luce."
msgstr "Chẳng ai trách cậu đâu, Luce."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.E"
msgid "East."
msgstr "Hướng Đông."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.GENERIC"
msgid "Points to the True North."
msgstr "Chỉ về hướng Bắc thực tế."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.N"
msgid "True North."
msgstr "Bắc thực tế."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.NE"
msgid "Northeast."
msgstr "Đông Bắc."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.NW"
msgid "Northwest."
msgstr "Tây Bắc."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.S"
msgid "South."
msgstr "Hướng Nam."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.SE"
msgid "Southeast."
msgstr "Đông Nam."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.SW"
msgid "Southwest."
msgstr "Tây Nam."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.W"
msgid "West."
msgstr "Hướng Tây."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPOST"
msgid "Can't say much for the food, but I like the presentation!"
msgstr "Đồ ăn thì không bàn tới, nhưng cách bày trí tôi thích đấy!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "Looks aboot right."
msgstr "Trông ổn phết rồi đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "Well that's a smell."
msgstr "Chà, đúng là một thứ mùi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "Nah, that's too dry."
msgstr "Thôi, khô quá rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "Not exactly a barrel of maple syrup..."
msgstr "Không hẳn là một thùng xi -rô phong đâu..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPOSTINGBIN.WET"
msgid "A bit too soggy."
msgstr "Hơi ẩm ướt quá rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPOSTWRAP"
msgid "Well. Plants gotta fertilize."
msgstr "Chà. Cây cối cũng cần bón phân mà."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CONSTRUCTION_PLANS"
msgid "Well, better get building."
msgstr "Thôi, chuẩn bị xây dựng thôi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKBOOK"
msgid "Pretty handy. Luce, how aboot you read off the ingredients while I cook?"
msgstr "Khá tiện đấy. Luce, trong lúc tôi nấu thì cậu đọc nguyên liệu lên nhé?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKEDMANDRAKE"
msgid "Was that a bad thing to do?"
msgstr "Làm thế có tệ lắm không ta?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKEDMEAT"
msgid "Just like my dear old ma used to make."
msgstr "Y hệt món má tôi hay làm hồi xưa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKEDMONSTERMEAT"
msgid "I still don't want to eat it."
msgstr "Tôi vẫn không muốn ăn nó đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKEDSMALLMEAT"
msgid "That'll just make me hungrier!"
msgstr "Thế này chỉ làm tôi thêm đói thôi!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKIECUTTER"
msgid "That thing's hankering for a bite of my boat!"
msgstr "Thứ đó đang thèm cắn thuyền ván của tôi kìa!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKIECUTTERHAT"
msgid "Hope this shell protects me better than it protected the last guy."
msgstr "Mong là cái mai này bảo vệ tôi tốt hơn kẻ xấu số trước."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKIECUTTERSHELL"
msgid "He was a tough nut to crack."
msgstr "Hắn đúng là một ca khó nhằn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "Looks like somethin' was written here, but it faded away."
msgstr "Hình như có viết gì ở đây, nhưng bay màu mất rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKPOT.BURNT"
msgid "Burned to a crisp."
msgstr "Cháy khét lẹt luôn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "It'll be a bit longer, eh?"
msgstr "Sẽ lâu hơn chút nữa đấy nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "Oh boy! Here it comes!"
msgstr "Ôi chao! Xong rồi kìa!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKPOT.DONE"
msgid "Time for supper!"
msgstr "Đến giờ ăn tối rồi!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKPOT.EMPTY"
msgid "It seems a waste to just leave it sitting there, empty."
msgstr "Cứ để nó trống không nằm đấy thì phí quá."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOLANT"
msgid "What is that stuff?"
msgstr "Thứ này là cái gì thế?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COONTAIL"
msgid "That's the end of that cat's tale."
msgstr "Hết câu chuyện của con mèo đó rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CORN"
msgid "I like it, but not in everything that I eat."
msgstr "Tôi thích nó, nhưng không phải món gì cũng cho vào ăn được."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CORN_COOKED"
msgid "Cooked with the goodness of corn."
msgstr "Nấu với vị ngon nguyên bản của ngô."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CORN_OVERSIZED"
msgid "Shucks, that's a lot of corn!"
msgstr "Trời ạ, lắm ngô thế không biết!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CORN_SEEDS"
msgid "I'm more of a hewer of wood than a tiller of soil."
msgstr "Tôi hợp đi chặt củi hơn là cày cấy ruộng vườn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "Some kinda fancy theater costume."
msgstr "Đồ hóa trang sân khấu hoa hòe nào đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COSTUME_DOLL_BODY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COSTUME_DOLL_BODY"
msgid "Some kinda fancy theater costume."
msgstr "Đồ hóa trang sân khấu hoa hòe nào đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COSTUME_FOOL_BODY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COSTUME_FOOL_BODY"
msgid "Some kinda fancy theater costume."
msgstr "Đồ hóa trang sân khấu hoa hòe nào đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COSTUME_KING_BODY"
msgid "Some kinda fancy theater costume."
msgstr "Đồ hóa trang sân khấu hoa hòe nào đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "Some kinda fancy theater costume."
msgstr "Đồ hóa trang sân khấu hoa hòe nào đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COSTUME_PRINCESS_BODY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COSTUME_PRINCESS_BODY"
msgid "Cute outfit."
msgstr "Bộ đồ cưng ghê."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "Some kinda fancy theater costume."
msgstr "Đồ hóa trang sân khấu hoa hòe nào đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COSTUME_TREE_BODY"
msgid "It's not as scratchy as it looks."
msgstr "Không ngứa ngáy như vẻ ngoài đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "It could use some wood to burn."
msgstr "Kiếm ít củi đốt thì hay biết mấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "It's kinda cute, eh?"
msgstr "Cũng dễ thương phết nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "It could use some wood to burn."
msgstr "Kiếm ít củi đốt thì hay biết mấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "That statue cleaned up nice."
msgstr "Bức tượng đó được dọn dẹp sạch sẽ ghê."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "It could use some wood to burn."
msgstr "Kiếm ít củi đốt thì hay biết mấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "Gleamin' like a sunrise over a glacier."
msgstr "Lấp lánh như ánh bình minh trên sông băng."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COTL_TRINKET"
msgid "They don't make headwear like that in Canada."
msgstr "Ở Canada người ta không làm mũ kiểu đó đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COZY_BUNNYMAN"
msgid "Looks like they're enjoyin' themselves."
msgstr "Trông chúng có vẻ đang tận hưởng đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRABKING.GENERIC"
msgid "I think we might've bothered him."
msgstr "Hình như chúng ta vừa làm phiền hắn rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRABKING.INERT"
msgid "Think that castle might be missing a gem or two, eh?"
msgstr "Lâu đài đó hình như thiếu viên ngọc nào thì phải nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRABKING_CANNONTOWER"
msgid "These guys don't fight fair."
msgstr "Mấy tay này đánh đấm chẳng đẹp đẽ gì cả."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRABKING_CLAW"
msgid "Not the best time to make snap decisions, eh?"
msgstr "Chưa phải lúc đưa ra quyết định chớp nhoáng đâu nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRABKING_ICEWALL"
msgid "Reminds me of winters up North."
msgstr "Làm tôi nhớ đến mùa đông ở phương Bắc."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRABKING_MOB"
msgid "I guess it's crab season."
msgstr "Chắc đang vào mùa cua rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "Not very friendly, eh?"
msgstr "Trông không mấy thân thiện lắm nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTERLAB"
msgid "Anyone home?"
msgstr "Có ai ở nhà không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_BULBIN"
msgid "Sure got a spring in your step, eh?"
msgstr "Bước chân nhanh nhẹn phết nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_DRAGONLING"
msgid "Don't start no forest fires now, buddy."
msgstr "Đừng có châm lửa đốt rừng đấy nhé bạn tôi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_EETS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_EETS"
msgid "You're a little pudgy, eh?"
msgstr "Trông cậu hơi mũm mĩm đấy nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "We'll have to get you some protective eye gear there, bud."
msgstr "Chúng ta phải kiếm cho cậu một chiếc kính bảo vệ mắt thôi, nhóc ạ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_GLOMLING"
msgid "Charmingly chubby."
msgstr "Mũm mĩm đáng yêu ghê."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_KITTEN"
msgid "Giving it pats is relaxing."
msgstr "Vuốt ve nó thấy thư giãn phết."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_LAMB"
msgid "Heh, it feels like a beard."
msgstr "Heh, sờ vào cứ như bộ râu ấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "That's my little forest buddy."
msgstr "Bạn nhỏ trong rừng của tôi đây."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_PERDLING"
msgid "Look, it's not you. It's me."
msgstr "Nghe này, không phải tại cậu đâu. Tại tôi đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_PUPPY"
msgid "Man and robot's best friend."
msgstr "Người bạn tốt nhất của con người và robot."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CROW.GENERIC"
msgid "He's planning something. I can tell."
msgstr "Nó đang mưu tính gì kìa. Tôi biết thừa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CROW.HELD"
msgid "You'll pay for your crimes, crow!"
msgstr "Mày sẽ phải trả giá vì tội lỗi của mình, con quạ ạ!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRUMBS"
msgid "I think we're supposed to follow these."
msgstr "Hình như chúng ta phải đi theo mấy thứ này."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "I know a curse when I see it."
msgstr "Lời nguyền thế nào thì nhìn phát là tôi biết ngay."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CUTGRASS"
msgid "I think I might be allergic to this."
msgstr "Chắc tôi bị dị ứng với thứ này mất."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CUTLESS"
msgid "Sorry, I might've taken a little bite."
msgstr "Xin lỗi nhé, hình như tôi lỡ cắn một miếng rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CUTLICHEN"
msgid "Yum! Tastes woody!"
msgstr "Ngon! Vị cứ như gỗ ấy!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CUTREEDS"
msgid "Want to hear my loon call?"
msgstr "Muốn nghe tiếng kêu của chim lặn không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CUTSTONE"
msgid "Part of the Canadian shield."
msgstr "Một phần của khiên đá Canada."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DAYWALKER.GENERIC"
msgid "Not even so much as a \"thank you\", eh?"
msgstr "Đến một lời \"cảm ơn\" cũng không có lấy một câu cơ à?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "Whatever he's got better not be contagious."
msgstr "Mong là thứ hắn đang dính không phải bệnh truyền nhiễm."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DAYWALKER2.BURIED"
msgid "Should we help him out, Luce?"
msgstr "Chúng ta có nên cứu hắn ra không, Luce?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DAYWALKER2.GENERIC"
msgid "Hey there, buddy. You don't look so bad."
msgstr "Chào bạn hiền. Trông cậu cũng được đấy chứ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "No good deed goes unpunished."
msgstr "Ở hiền chưa chắc đã gặp lành."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "That's some firmly planted stone."
msgstr "Đá cắm chắc phết."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "Looks sturdy... ish."
msgstr "Trông cũng... khá chắc chắn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEADLYFEAST"
msgid "That doesn't smell quite right, eh."
msgstr "Ngửi có vẻ không ổn lắm nhỉ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEAD_SEA_BONES"
msgid "Smells ripe."
msgstr "Mùi chín thủ rồi đây."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "Nooo! I could have chopped it!"
msgstr "Khônggggg! Lẽ ra tôi đã chặt được nó rồi!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "What a waste."
msgstr "Phí quá đi mất."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "Ahhhh!"
msgstr "Áhhhh!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "It's calling to me!"
msgstr "Nó đang gọi tôi kìa!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "You're due for a chopping."
msgstr "Mày đến hạn bị chặt rồi đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECK_OF_CARDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECK_OF_CARDS"
msgid "No Lucy, you may not cut the deck. I know what you mean."
msgstr "Không được đâu Lucy, cậu không được xào bài đâu. Tôi biết ý cậu là gì đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECOR_CENTERPIECE"
msgid "I'm pretty sure it's makin' a statement. Aboot something."
msgstr "Tôi khá chắc là nó đang gửi gắm thông điệp gì đấy. Về cái gì đó."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "It could use a bit of nature."
msgstr "Thêm chút thiên nhiên vào thì đẹp."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "Aboot time we brightened this place up, eh?"
msgstr "Cũng đến lúc làm cho nơi này sáng sủa lên rồi nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "A little bit of nature makes everything nicer."
msgstr "Chút thiên nhiên làm mọi thứ đẹp đẽ hơn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "We need bulbs, eh."
msgstr "Chúng ta cần bóng đèn nhỉ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "Well, that's that."
msgstr "Thôi thì, đành chịu vậy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECOR_LAMP"
msgid "I'd rather have natural light, but it'll do."
msgstr "Tôi thích ánh sáng tự nhiên hơn, nhưng thế này cũng tạm."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "Looks pretty realistic, eh?"
msgstr "Trông như thật ấy nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "It ain't much to look at with no picture in it."
msgstr "Chẳng có bức tranh nào bên trong thì ngắm nghía gì tầm này."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "It's their spitting image!"
msgstr "Giống y đúc người thật luôn!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEER.ANTLER"
msgid "Something's different aboot you..."
msgstr "Cậu có gì đó khác lạ đấy..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEER.GENERIC"
msgid "That's a creature of the woods, eh?"
msgstr "Đó là một sinh vật của rừng rậm nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEERCLOPS"
msgid "That's a big moose!"
msgstr "Đúng là một con hươu sừng tấm bự chảng!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "Smoke'em if you got'em."
msgstr "Có thuốc lá thì xập xình đi anh em."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "What's that Luce? Yup, she'll look great on the wall."
msgstr "Sao thế Luce? Chuẩn rồi, treo lên tường thì oách phải biết."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "What in the name of sweet Celine?"
msgstr "Cái quái gì nhân danh thánh Celine thế này?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "She'll keep the brews frosty all summer, eh?"
msgstr "Nó sẽ giữ cho mấy vại bia lạnh ngắt suốt cả mùa hè đấy nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "The eye's been lifted? Where are we? Toronto?"
msgstr "Con mắt biến đâu mất rồi? Chúng ta đang ở đâu thế này? Toronto à?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "Better get buildin', eh?"
msgstr "Lo mà xây dựng thôi nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "Now what is this good for?"
msgstr "Thứ này dùng để làm gì ta?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEER_ANTLER"
msgid "Wish I still had a cabin I could mount these things in."
msgstr "Ước gì mình còn cái nhà gỗ để treo mấy thứ này lên."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEER_GEMMED"
msgid "That ain't natural."
msgstr "Thứ đó không tự nhiên chút nào."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "It's probably a tuft of grass."
msgstr "Chắc chỉ là một bụi cỏ thôi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DESERTHAT"
msgid "That's easy on the eyes."
msgstr "Dịu mắt phết."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DESICCANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DESICCANT"
msgid "Remember how much it rained back home, Luce?"
msgstr "Cậu còn nhớ hồi ở nhà trời mưa nhiều cỡ nào không, Luce?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DESICCANTBOOSTED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DESICCANTBOOSTED"
msgid "Take that, rain!"
msgstr "Đỡ này, mưa nhé!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEVTOOL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEVTOOL"
msgid "I'm not commenting on that."
msgstr "Tôi không có ý kiến gì về việc đó đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIRTPILE"
msgid "Hey! A clue!"
msgstr "Này! Manh mối kìa!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGROD.COLD"
msgid "It's really fuzzy from here."
msgstr "Từ đây thì mơ hồ lắm."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGROD.GENERIC"
msgid "I wonder if it gets the hockey game."
msgstr "Không biết nó có bắt được trận khúc côn cầu không nhỉ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGROD.HOT"
msgid "Loud and clear! Something's near!"
msgstr "To và rõ! Có gì đó đang ở gần!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGROD.WARM"
msgid "I think I'm getting closer."
msgstr "Hình như tôi đang đến gần hơn rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGROD.WARMER"
msgid "Woah, careful there, bud."
msgstr "Ồ, cẩn thận đấy ông bạn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "It looks like something should plug in."
msgstr "Trông như có thứ gì đó cần cắm vào."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGRODBASE.READY"
msgid "It's ready to be unlocked."
msgstr "Nó đã sẵn sàng để được mở khóa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "Now all it needs is to be turned on."
msgstr "Giờ chỉ còn việc khởi động nó lên thôi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGRODSTART"
msgid "That's a weird looking rod."
msgstr "Cái gậy trông dị thế."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DOCK_KIT"
msgid "I can see it now, the whole ocean covered in beautiful timber..."
msgstr "Tôi tưởng tượng ra cảnh toàn bộ đại dương được phủ kín bằng gỗ thơm rồi đây..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "Looking at 'em is making me hungry."
msgstr "Nhìn bọn chúng lại thấy thèm ăn rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DOLL_BLUEPRINT"
msgid "I can doll it up all I want, it'll still be a beefalo."
msgstr "Tôi có làm điệu cho nó cỡ nào thì bản chất vẫn là một con bò lai thôi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONBOAT_KIT"
msgid "Fancy a sail, Lucy?"
msgstr "Làm một chuyến ra khơi chứ, Lucy?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONBOAT_PACK"
msgid "Everything's all packed and ready to go, eh?"
msgstr "Đồ đạc đã gói gọn sàng sàng lên đường rồi nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONBODYHAT"
msgid "Nice needlework."
msgstr "Đường kim mũi chỉ khéo thế."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONCHILISALAD"
msgid "Looks real good, buddy."
msgstr "Trông ổn phết đấy, bạn hiền."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLY"
msgid "She'll burn all the trees before I can chop them!"
msgstr "Ả ta sẽ đốt sạch lũ cây trước khi tôi kịp chặt chúng mất!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "Gaudy if you ask me."
msgstr "Lè loẹt nếu cậu hỏi tôi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE"
msgid "It's a bit much, eh? But at least it stores a lot."
msgstr "Hơi quá đà nhỉ? Nhưng ít ra chứa được đống đồ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "Tacky taxidermy."
msgstr "Đồ nhồi bông sến súa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "It got even tackier, eh?"
msgstr "Nó còn sến hơn nữa kìa nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "I'm sweaty enough without help from a furnace."
msgstr "Không cần cái lò sưởi này thì người tôi đã đủ ướt đẫm mồ hôi rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "Just bask in that warm glow."
msgstr "Cứ tận hưởng ánh hào quang ấm áp đó đi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFRUIT"
msgid "I've never seen one of those before."
msgstr "Tôi chưa từng thấy quả nào như thế này bao giờ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "It tastes like maple syrup."
msgstr "Vị cứ như xi -rô phong ấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "Guess I'm better at gardening than I thought, eh?"
msgstr "Chắc tay nghề làm vườn của tôi giỏi hơn mình tưởng nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "Maybe I can grow them."
msgstr "Biết đâu tôi trồng được chúng."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONHEADHAT"
msgid "That's a sight, eh?"
msgstr "Trông ra gì phết nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONPIE"
msgid "Almost as good as butter tarts!"
msgstr "Gần ngon bằng bánh tart bơ rồi đấy!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONTAILHAT"
msgid "Well, somebody's gotta do it."
msgstr "Thôi thì, ai đó phải làm việc này thôi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGON_SCALES"
msgid "I still don't believe in dragons."
msgstr "Tôi vẫn không tin có rồng đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DREADSTONE"
msgid "There's something off aboot it."
msgstr "Có gì đó bất ổn ở thứ này."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DREADSTONEHAT"
msgid "Gotta protect the old noggin', eh?"
msgstr "Phải bảo vệ cái đầu gối chứ nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DREADSTONE_STACK"
msgid "I don't like where this is going, and I really don't like where it's comin' from."
msgstr "Tôi không thích hướng đi này tí nào, và thực sự ghét nguồn gốc của nó."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRIFTWOOD_LOG"
msgid "You poor log."
msgstr "Khúc gỗ tội nghiệp."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "Hasn't it been through enough."
msgstr "Nó chịu đựng đủ khổ sở rồi cơ mà."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "It's over now."
msgstr "Mọi chuyện qua rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "Put it out of its misery."
msgstr "Cho nó giải thoát khỏi đau khổ đi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "The sea sucked all the good tree juice out of it."
msgstr "Biển đã hút hết nhựa cây ngon lành ra khỏi nó rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRUMSTICK"
msgid "October food."
msgstr "Món ăn tháng Mười."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRUMSTICK_COOKED"
msgid "Thanks, turkey."
msgstr "Cảm ơn nhé, gà tây."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_BANANABUSH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_BANANABUSH"
msgid "It's missing the tree part!"
msgstr "Thiếu phần cây rồi kìa!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_BERRYBUSH"
msgid "Time for a little landscaping."
msgstr "Đến lúc chỉnh trang lại cảnh quan chút thôi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "This would be more useful somewhere else, eh?"
msgstr "Đặt chỗ khác có ích hơn đấy nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_GRASS"
msgid "It makes my eyes water."
msgstr "Làm mắt tôi cứ cay cay."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_MARSH_BUSH"
msgid "I should plant this."
msgstr "Tôi nên trồng thực vật này xuống."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_MONKEYTAIL"
msgid "They're kinda like cattails except... not."
msgstr "Trông giống lau sậy nhưng mà... không phải."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_SAPLING"
msgid "Mmmmm. It's all twiggy."
msgstr "Mmmmm. Toàn cành là cành."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_TRAP_STARFISH"
msgid "I should find a place to put it."
msgstr "Tôi nên tìm chỗ nào đặt nó xuống."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUMBBELL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUMBBELL"
msgid "Looks pretty heavy, eh?"
msgstr "Trông nặng phết nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "You just throw it at whoever ya don't like, eh? Sounds pretty cold."
msgstr "Cứ ném thẳng vào đứa nào cậu ghét thôi nhỉ? Nghe có vẻ lạnh lùng đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUMBBELL_GEM"
msgid "Choppin' trees is enough of a workout for me."
msgstr "Chặt cây đối với tôi thế là đủ tập thể dục rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUMBBELL_GOLDEN"
msgid "I'll stick to lifting my axe."
msgstr "Tôi chỉ trung thành với việc nhấc rìu của mình thôi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUMBBELL_HEAT"
msgid "I think he took \"warm up\" too literally, eh?"
msgstr "Hình như hắn hiểu từ \"khởi động\" theo nghĩa đen quá nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUMBBELL_MARBLE"
msgid "I'll stick to lifting my axe."
msgstr "Tôi chỉ trung thành với việc nhấc rìu của mình thôi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUMBBELL_REDGEM"
msgid "Yer muscles won't be the only things on fire."
msgstr "Không chỉ cơ bắp của cậu bốc lửa đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DURIAN"
msgid "It smells bad."
msgstr "Mùi tệ thật."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DURIAN_COOKED"
msgid "It smells even worse."
msgstr "Mùi còn kinh khủng hơn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DURIAN_OVERSIZED"
msgid "No thank you very much."
msgstr "Xin miễn cho tôi nhờ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DURIAN_SEEDS"
msgid "Maybe I could plant them?"
msgstr "Hay là tôi trồng mấy thực vật này nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUSTMERINGUE"
msgid "Tastes terrible. And that's speakin' as someone who's eaten raw lumber."
msgstr "Vị kinh khủng. Nói thế đủ hiểu vì tôi từng ăn gỗ thô rồi đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUSTMOTH"
msgid "Let's compare moustaches later."
msgstr "Lát nữa đọ ria mép đi nhé."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUSTMOTHDEN"
msgid "Resourceful little guys!"
msgstr "Mấy chú nhóc tháo vát thật đấy!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EARMUFFSHAT"
msgid "Where I'm from these'd only work in the fall."
msgstr "Chỗ tôi ở thì mấy thứ này chỉ dùng được vào mùa thu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EEL"
msgid "This should cook up nicely."
msgstr "Món này nướng lên sẽ ngon đây."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EEL_COOKED"
msgid "This cooked up nicely."
msgstr "Nướng lên ăn ngon phết."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EGGPLANT"
msgid "I bet the birds have something to do with this."
msgstr "Cá là lũ chim có dính dáng đến vụ này."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EGGPLANT_COOKED"
msgid "Suspiciously birdy."
msgstr "Đậm chất vị chim chóc đến đáng ngờ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "It better not hatch into a giant purple bird."
msgstr "Mong là nó không nở ra một con chim khổng lồ màu tím."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EGGPLANT_SEEDS"
msgid "Maybe I could plant them?"
msgstr "Hay là tôi trồng mấy thực vật này nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ELIXIR_CONTAINER"
msgid "Think there's a spooky six-pack in there."
msgstr "Hình như có một lốc sáu lon ma quái ở trỏng."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EMBERLIGHT"
msgid "Just keep it away from the trees, eh?"
msgstr "Cứ để nó tránh xa mấy cái cây ra nhé?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.BURNT"
msgid "A burnt wood table."
msgstr "Một cái bàn gỗ bị cháy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.EMPTY"
msgid "Such a beaut of a wood table shouldn't be hidden by a cloth."
msgstr "Một chiếc bàn gỗ đẹp tuyệt thế này không nên bị khăn trải bàn che khuất."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "Aboot time we brightened this place up, eh?"
msgstr "Cũng đến lúc làm cho nơi này sáng sủa lên rồi nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.GENERIC"
msgid "A little bit of nature makes everything nicer."
msgstr "Chút thiên nhiên làm mọi thứ đẹp đẽ hơn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "We need bulbs, eh."
msgstr "Chúng ta cần bóng đèn nhỉ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.WILTED"
msgid "Well, that's that."
msgstr "Thôi thì, đành chịu vậy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN.BURNING"
msgid "Nooo! I could have chopped it!"
msgstr "Khônggggg! Lẽ ra tôi đã chặt được nó rồi!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN.BURNT"
msgid "What a waste."
msgstr "Phí quá đi mất."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN.CHOPPED"
msgid "Ahhhh!"
msgstr "Áhhhh!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN.GENERIC"
msgid "It's calling to me!"
msgstr "Nó đang gọi tôi kìa!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "Sorry!"
msgstr "Xin lỗi nhé!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "How terrible!"
msgstr "Tệ thật đấy!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "Another one!"
msgstr "Lại một cây nữa!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "Lucy would want me to chop it down."
msgstr "Lucy chắc chắn muốn tôi đốn quách nó đi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYEBRELLAHAT"
msgid "Always good to have something watching over you."
msgstr "Có gì đó che chở cho mình lúc nào cũng tốt."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYEMASKHAT"
msgid "Protective eye gear that protects everything but the eyes."
msgstr "Đồ bảo vệ mắt bảo vệ mọi thứ trừ đôi mắt."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYEOFTERROR"
msgid "Feast your eye on my axe!"
msgstr "Hãy chiêm ngưỡng chiếc rìu của tôi đi!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYEOFTERROR_MINI"
msgid "It's rude to stare, eh?"
msgstr "Nhìn chằm chằm là bất lịch sự đấy nhé?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "Probably shouldn't let that eye open."
msgstr "Chắc không nên để con mắt đó mở ra đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYEPLANT"
msgid "It needs to mind its own business."
msgstr "Nó lo chuyện của nó đi thì hơn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYETURRET"
msgid "That'll drive the hosers off."
msgstr "Thứ đó sẽ tống khứ lũ rắc rối đi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYETURRET_ITEM"
msgid "This needs to be installed properly."
msgstr "Phải lắp đặt thứ này cho đàng hoàng đã."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARMPLOT.BURNT"
msgid "If it was a tree farm, I'd be sad."
msgstr "Nếu đây là trang trại cây, chắc tôi buồn lắm."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARMPLOT.GENERIC"
msgid "I prefer larger plants."
msgstr "Tôi thích cây cối lớn hơn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARMPLOT.GROWING"
msgid "They'll never reach chopping size."
msgstr "Chúng sẽ chẳng bao giờ lớn đến mức chặt được đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "I think it needs some poop."
msgstr "Tôi nghĩ nó cần chút phân."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_HOE"
msgid "Better get planting."
msgstr "Tốt hơn là nên đi trồng cây thôi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_PLANT.BURNING"
msgid "Who's the hoser that set my garden on fire?"
msgstr "Tên ngốc nào dám phóng lửa đốt khu vườn của tôi thế?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_PLANT.FULL"
msgid "It's ready for picking."
msgstr "Nó đã sẵn sàng để thu hoạch rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "What a beaut!"
msgstr "Đẹp tuyệt!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "Whoops, looks like I've been tendin' to a weed this whole time."
msgstr "Ấy chà, hóa ra nãy giờ tôi toàn chăm sóc cỏ dại."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_PLANT.GENERIC"
msgid "A plant, eh?"
msgstr "Một cây thực vật à?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_PLANT.GROWING"
msgid "Hey, I think it's grown a bit!"
msgstr "Này, tôi nghĩ nó lớn hơn một chút rồi đấy!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "That's not looking so good..."
msgstr "Trông không ổn lắm đâu..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "The only thing it's good for is compost."
msgstr "Thứ duy nhất nó dùng được là làm phân trộn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_PLANT.SEED"
msgid "Gotta be patient."
msgstr "Phải kiên nhẫn thôi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_PLOW"
msgid "Looks like it's got things under control."
msgstr "Trông có vẻ mọi thứ đang trong tầm kiểm soát."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_PLOW_ITEM"
msgid "Where should we put the garden, Luce?"
msgstr "Chúng ta nên đặt khu vườn ở đâu đây, Luce?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "I'd better clear that out of the way."
msgstr "Tôi tốt hơn hết nên dọn cái đó đi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHERFAN"
msgid "A traditional Canadian fan."
msgstr "Một cái quạt truyền thống của Canada."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHERHAT"
msgid "I want nothing to do with that... thing."
msgstr "Tôi không muốn dính dáng gì đến cái... thứ đó."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHERPENCIL"
msgid "The bird murder wasn't even necessary. Heh."
msgstr "Việc giết chim thậm chí còn không cần thiết. Hừm."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHER_CANARY"
msgid "A grody feather."
msgstr "Một chiếc lông vũ gớm ghiếc."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHER_CROW"
msgid "A gross feather."
msgstr "Một chiếc lông vũ tởm lợm."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHER_ROBIN"
msgid "A disgusting feather."
msgstr "Một chiếc lông vũ đáng kinh tởm."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "A stupid feather."
msgstr "Một chiếc lông vũ ngớ ngẩn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEM_PUPPET"
msgid "She's trapped!"
msgstr "Cô ấy bị kẹt rồi!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE"
msgid "That's a good lookin' fence."
msgstr "Đó là một hàng rào trông rất được."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE_ELECTRIC.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE_ELECTRIC.GENERIC"
msgid "It's just a post now."
msgstr "Bây giờ nó chỉ là một cái cột thôi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE_ELECTRIC.LINKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE_ELECTRIC.LINKED"
msgid "That'll straighten your hair!"
msgstr "Cái đó sẽ làm tóc bạn dựng đứng lên đấy!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE_ELECTRIC_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE_ELECTRIC_ITEM"
msgid "I suppose I could plant it."
msgstr "Tôi đoán mình có thể trồng thực vật này."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE_GATE"
msgid "Some nice woodwork there."
msgstr "Đồ mộc ở đó thật đẹp."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE_GATE_ITEM"
msgid "A good project for a lazy afternoon."
msgstr "Một dự án hay cho buổi chiều lười biếng."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE_ITEM"
msgid "A good project for a lazy afternoon."
msgstr "Một dự án hay cho buổi chiều lười biếng."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE_JUNK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE_JUNK"
msgid "It's got nothin' on a sturdy wooden fence."
msgstr "Nó chẳng thấm vào đâu so với một hàng rào gỗ chắc chắn cả."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE_ROTATOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE_ROTATOR"
msgid "Sometimes you've gotta show a fence who's boss, eh?"
msgstr "Đôi khi bạn phải cho hàng rào biết ai mới là chủ, phải không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FERTILIZER"
msgid "Poop belongs in a bucket, not on the ground."
msgstr "Phân bón thuộc về cái xô, chứ không phải trên mặt đất."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FESTIVEFISH"
msgid "Season's fishings!"
msgstr "Chúc mừng mùa câu cá!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FESTIVE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FESTIVE_BLUEPRINT"
msgid "Looks pretty cheerful!"
msgstr "Trông khá vui tươi đấy!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIG"
msgid "That's one fancy fruit."
msgstr "Đó là một loại quả kỳ công."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIGATONI
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIGATONI"
msgid "Now that's some real comfort food."
msgstr "Đó mới thực sự là món ăn an ủi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIGKABAB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIGKABAB"
msgid "Nothin' better than food served on a wooden stick, eh?"
msgstr "Không gì tuyệt hơn đồ ăn xiên trên que gỗ phải không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIG_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIG_COOKED"
msgid "This stuff's not half bad, eh?"
msgstr "Món này không tệ lắm đâu, phải không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREBALLSTAFF"
msgid "I'll leave it to someone more magic-inclined."
msgstr "Tôi sẽ để việc đó cho người có máu ma thuật hơn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRECRACKERS"
msgid "Let's not set them off in the forest."
msgstr "Đừng đốt pháo trong rừng nhé."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREFLIES.GENERIC"
msgid "Reminds me of Algonquin park."
msgstr "Làm tôi nhớ đến công viên Algonquin."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREFLIES.HELD"
msgid "I've got a pocket full of sunshine!"
msgstr "Tôi có cả một túi đầy ánh nắng mặt trời!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREHOUND"
msgid "Hot hound!"
msgstr "Chú chó nóng bỏng!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRENETTLES
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRENETTLES"
msgid "Note to self, \"do not touch.\""
msgstr "Nhắc nhở bản thân: \"không được chạm vào.\""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRENETTLES_DRIED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRENETTLES_DRIED"
msgid "Smells nice."
msgstr "Thơm dễ chịu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPEN"
msgid "Keep it away from the trees!"
msgstr "Tránh xa đám cây ra!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.EMBERS"
msgid "I should go chop some wood for that, eh?"
msgstr "Tôi nên đi chặt ít củi cho nó nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.GENERIC"
msgid "It uses wood."
msgstr "Nó dùng củi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.HIGH"
msgid "Too much wood, too fast!"
msgstr "Quá nhiều củi, quá nhanh!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.LOW"
msgid "There should be some wood around here somewhere."
msgstr "Phải có ít củi ở quanh đây chứ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.NORMAL"
msgid "Mmmm. Smells woody."
msgstr "Mmm. Ngửi mùi gỗ phết."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.OUT"
msgid "If only I had some wood."
msgstr "Giá mà tôi có ít củi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRESTAFF"
msgid "I don't trust any sort of magic business."
msgstr "Tôi không tin tưởng bất kỳ thứ ma thuật nào cả."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "It craves wood."
msgstr "Nó thèm củi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "Lazy thing."
msgstr "Đồ lười biếng."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "Save the trees!"
msgstr "Cứu lấy những bóng cây!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISH"
msgid "Looks like a cod."
msgstr "Trông giống cá tuyết."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHINGNET"
msgid "I cast a wide net."
msgstr "Tôi giăng một chiếc lưới lớn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHINGROD"
msgid "I should spend some time at the lake."
msgstr "Tôi nên dành chút thời gian ở hồ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHMEAT"
msgid "I'd prefer salmon."
msgstr "Tôi thích cá hồi hơn."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHMEAT_COOKED"
msgid "I wish I had some chips."
msgstr "Ước gì mình có ít khoai tây chiên."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHMEAT_DRIED"
msgid "Beats bird jerky."
msgstr "Đỉnh hơn thịt khô chim."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHMEAT_SMALL"
msgid "I hope I don't attract bears."
msgstr "Mong là tôi không thu hút gấu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "Looks good to me."
msgstr "Trông được đấy chứ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHMEAT_SMALL_DRIED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHMEAT_SMALL_DRIED"
msgid "Beats bird jerky."
msgstr "Đỉnh hơn thịt khô chim."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHSTICKS"
msgid "Elegant dining in a box."
msgstr "Bữa ăn thanh lịch trong hộp."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHTACOS"
msgid "Tastes like the sea, eh?"
msgstr "Vị cứ như biển cả ấy nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISH_BOX"
msgid "Reminds me of the old salmon fisheries."
msgstr "Làm tôi nhớ đến những xưởng đánh bắt cá hồi cũ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISH_COOKED"
msgid "Could use some chips."
msgstr "Ăn kèm chút khoai tây chiên thì ngon."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLINT"
msgid "This could be an axe head."
msgstr "Cái này có thể làm đầu rìu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOATINGLANTERN.DEFLATED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOATINGLANTERN.DEFLATED"
msgid "Had to come down sometime."
msgstr "Kiểu gì thì lúc nào cũng phải hạ cánh."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOATINGLANTERN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOATINGLANTERN.GENERIC"
msgid "Aw, that's pretty."
msgstr "Ồ, đẹp thật đấy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOATINGLANTERN.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOATINGLANTERN.HELD"
msgid "I can't wait to light it up."
msgstr "Tôi nóng lòng muốn thắp sáng nó lên rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOTATIONCUSHION
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOTATIONCUSHION"
msgid "There's room for both of us, Luce."
msgstr "Vẫn còn chỗ cho cả hai chúng ta đấy, Luce."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWER.GENERIC"
msgid "That's nice."
msgstr "Đẹp phết."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWER.ROSE"
msgid "Not very satisfying chopping, that."
msgstr "Chặt cái này chả đã tay gì cả."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWERHAT"
msgid "I think wildflowers look nice with my red hair."
msgstr "Tôi nghĩ hoa dại rất hợp với mái tóc đỏ của mình."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWERSALAD"
msgid "Healthy, but not very hardy."
msgstr "Tốt cho sức khỏe, nhưng không chắc chắn lắm."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWER_CAVE"
msgid "Shiny!"
msgstr "Lấp lánh!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWER_CAVE_WITHERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWER_CAVE_WITHERED"
msgid "It's almost out."
msgstr "Nó sắp tàn rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWER_EVIL"
msgid "Something is wrong with that flower."
msgstr "Có gì đó không ổn với bông hoa đó."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWER_WITHERED"
msgid "Someone's got a brown thumb."
msgstr "Ai đó có ngón tay nâu rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOLIAGE"
msgid "Looks like a salad."
msgstr "Trông như món salad."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOLIAGE_DRIED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOLIAGE_DRIED"
msgid "Smells nice."
msgstr "Thơm dễ chịu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOOTBALLHAT"
msgid "Will this give me hockey hair?"
msgstr "Cái này có làm tóc tôi giống vận động viên khúc côn cầu không?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FORGETMELOTS"
msgid "Funny what some folks will call a \"weed\". I think it looks nice!"
msgstr "Đúng là buồn cười khi vài kẻ gọi đây là \"cỏ dại\". Tôi thấy nó đẹp mà!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FORGETMELOTS_DRIED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FORGETMELOTS_DRIED"
msgid "Smells nice."
msgstr "Thơm dễ chịu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FORMAL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FORMAL_BLUEPRINT"
msgid "Canadian tuxedos look a bit different."
msgstr "Vest tuxedo kiểu Canada trông hơi khác một chút."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOSSIL_PIECE"
msgid "Brittle."
msgstr "Dễ vỡ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "One hundred percent assembled beastie."
msgstr "Quái vật đã được lắp ráp hoàn chỉnh một trăm phần trăm."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "Eh... Should we try again, Lucy?"
msgstr "Hừm... Chúng ta thử lại nhé, Lucy?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "Still got some work to do, looks like."
msgstr "Trông có vẻ vẫn còn việc phải làm."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FRESHFRUITCREPES"
msgid "I can get maple syrup on that?"
msgstr "Tôi có thể rưới xi -rô phong lên đó chứ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FRIENDLYFRUITFLY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FRIENDLYFRUITFLY"
msgid "See? We can all get along."
msgstr "Thấy chưa? Chúng ta đều có thể hòa hợp với nhau mà."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROG.DEAD"
msgid "Ex-frog."
msgstr "Cựu ếch."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROG.GENERIC"
msgid "I don't trust anything that can't decide between air and water."
msgstr "Tôi không tin tưởng bất cứ thứ gì không quyết định được giữa không khí và nước."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROG.SLEEPING"
msgid "It's tired."
msgstr "Nó mệt rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROGFISHBOWL"
msgid "I'm not one to turn my nose up at a meal."
msgstr "Tôi không phải kiểu người chê bai bữa ăn đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROGGLEBUNWICH"
msgid "You can really taste the swamp."
msgstr "Bạn thực sự có thể nếm được mùi đầm lầy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROGLEGS"
msgid "They're still jumping!"
msgstr "Chúng vẫn đang nhảy kìa!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROGLEGS_COOKED"
msgid "At least they stopped moving."
msgstr "Ít ra chúng cũng đã ngừng cử động."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROGNEWTON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROGNEWTON"
msgid "The fig masks the swamp taste."
msgstr "Quả vả che lấp đi vị đầm lầy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROZENBANANADAIQUIRI
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROZENBANANADAIQUIRI"
msgid "Nothin' like kickin' back with a cold one, eh?"
msgstr "Không gì bằng việc thư giãn với một ly đồ uống lạnh, nhỉ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "Just a sweet little critter."
msgstr "Chỉ là một sinh vật nhỏ ngọt ngào."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FRUITDRAGON.RIPE"
msgid "Were you always that colourful?"
msgstr "Từ trước đến nay mày luôn sặc sỡ thế à?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "I'll let it rest."
msgstr "Tôi sẽ để nó nghỉ ngơi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FRUITFLY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FRUITFLY"
msgid "What did the plants ever do to you, eh?"
msgstr "Mấy cái cây đã làm gì mi chứ, hả?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FRUITFLYFRUIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FRUITFLYFRUIT"
msgid "Those Fruit Flies seem to have a real liking for it."
msgstr "Mấy con ruồi trái cây đó có vẻ rất thích thứ này."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FRUITMEDLEY"
msgid "In syrup!"
msgstr "Ngâm trong xi -rô!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FUMAROLEAXE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FUMAROLEAXE.GENERIC"
msgid "Looks like it's aboot to break apart. Luce... are you smiling?"
msgstr "Trông có vẻ sắp gãy đến nơi rồi. Luce... em đang cười đấy à?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FUMAROLEAXE.HOT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FUMAROLEAXE.HOT"
msgid "It's hot stuff, but I promise it doesn't hold a candle to you, Lucy!"
msgstr "Nó rất nóng, nhưng tôi hứa là không bằng một góc của em đâu, Lucy!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FUMAROLEAXE.LUKEWARM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FUMAROLEAXE.LUKEWARM"
msgid "Fizzled out, eh?"
msgstr "Tắt ngấm rồi à?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FUMAROLEAXE.WARM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FUMAROLEAXE.WARM"
msgid "I'm sorry, Lucy! It was freezin' out!"
msgstr "Xin lỗi nhé, Lucy! Ngoài trời lạnh cóng mà!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FUMAROLEHAMMER.GENERIC
