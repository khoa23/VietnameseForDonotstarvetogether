msgstr "Nhà trọ kiêm luôn bữa ăn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GINGERBREADPIG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GINGERBREADPIG"
msgid "I'd better follow him."
msgstr "Tốt nhất là mình nên bám theo nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GINGERBREADWARG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GINGERBREADWARG"
msgid "Time to desert this dessert."
msgstr "Đã đến lúc bỏ rơi món tráng miệng này rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLASSBLOCK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLASSBLOCK"
msgid "That's science for you."
msgstr "Đúng là khoa học."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLASSCUTTER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLASSCUTTER"
msgid "I'm not really cut out for fighting."
msgstr "Tôi không phải là tuýp người sinh ra để chiến đấu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLASSSPIKE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLASSSPIKE"
msgid "Memories of the time I wasn't skewered."
msgstr "Ký ức về lúc tôi chưa bị xiên qua người."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLOMMER.GENERIC"
msgid "It's cute, in a gross kind of way."
msgstr "Nó dễ thương theo một kiểu hơi gớm ghiếc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLOMMER.SLEEPING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLOMMER.SLEEPING"
msgid "Snug as a bug."
msgstr "Êm ã như sâu trong kén."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLOMMERFLOWER.DEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLOMMERFLOWER.DEAD"
msgid "The petals droop and shimmer in the light."
msgstr "Những cánh hoa rủ xuống và lấp lánh dưới ánh sáng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLOMMERFLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLOMMERFLOWER.GENERIC"
msgid "The petals shimmer in the light."
msgstr "Những cánh hoa lấp lánh dưới ánh sáng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLOMMERFUEL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLOMMERFUEL"
msgid "This goop smells foul."
msgstr "Bãi nhầy này bốc mùi kinh khủng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLOMMERWINGS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLOMMERWINGS"
msgid "These would look empirically amazing on a helmet!"
msgstr "Mấy cái này gắn lên mũ thì trông cứ gọi là đỉnh của chóp!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLOWBERRYMOUSSE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLOWBERRYMOUSSE"
msgid "Warly sure can cook."
msgstr "Warly đúng là nấu ăn đỉnh thật."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GNARWAIL.BROKENHORN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GNARWAIL.BROKENHORN"
msgid "Got your nose!"
msgstr "Bắt được mũi ngươi rồi nhé!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GNARWAIL.BROKENHORN_FOLLOWER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GNARWAIL.BROKENHORN_FOLLOWER"
msgid "That's what happens when you nose around!"
msgstr "Đó là cái giá phải trả khi cứ thích thò mũi vào chuyện người khác đấy!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GNARWAIL.FOLLOWER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GNARWAIL.FOLLOWER"
msgid "This is all whale and good."
msgstr "Mọi chuyện vẫn 'cá voi' ổn cả."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GNARWAIL.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GNARWAIL.GENERIC"
msgid "My, what a big horn you have."
msgstr "Chao ôi, chiếc sừng của cậu mới to làm sao."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GNARWAIL_HORN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GNARWAIL_HORN"
msgid "Gnarly!"
msgstr "Gai góc phết!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GOATMILK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GOATMILK"
msgid "It's buzzing with tastiness!"
msgstr "Nó tràn ngập hương vị tuyệt vời!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GOGGLESHAT"
msgid "What a stylish pair of goggles."
msgstr "Một cặp kính bảo hộ thật phong cách."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GOLDENAXE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GOLDENAXE"
msgid "That's one fancy axe."
msgstr "Đúng là một cây rìu sành điệu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GOLDENPICKAXE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GOLDENPICKAXE"
msgid "Hey, isn't gold really soft?"
msgstr "Này, chẳng phải vàng mềm lắm sao?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GOLDENPITCHFORK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GOLDENPITCHFORK"
msgid "Why did I even make a pitchfork this fancy?"
msgstr "Sao tôi lại đi chế tạo một cái chĩa lồng lộn thế này cơ chứ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GOLDENSHOVEL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GOLDENSHOVEL"
msgid "I can't wait to dig holes."
msgstr "Tôi nóng lòng muốn được đào bới rồi đây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GOLDEN_FARM_HOE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GOLDEN_FARM_HOE"
msgid "Do I really need something this fancy to move dirt around?"
msgstr "Tôi có thực sự cần một thứ sang chảnh thế này chỉ để xới đất không nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GOLDNUGGET"
msgid "I can't eat it, but it sure is shiny."
msgstr "Tôi không ăn được nó, nhưng trông nó lấp lánh phết."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GOOSE_FEATHER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GOOSE_FEATHER"
msgid "Fluffy!"
msgstr "Bồng bềnh quá!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRASS.BARREN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRASS.BARREN"
msgid "It needs poop."
msgstr "Nó cần phân bón."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRASS.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRASS.BURNING"
msgid "That's burning fast!"
msgstr "Cháy nhanh thật đấy!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRASS.DISEASED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRASS.DISEASED"
msgid "It looks pretty sick."
msgstr "Trông nó có vẻ ốm nặng rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRASS.DISEASING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRASS.DISEASING"
msgid "Err, something's not right."
msgstr "Hừm, có gì đó không ổn lắm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRASS.GENERIC"
msgid "It's a tuft of grass."
msgstr "Chỉ là một bụi cỏ thôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRASS.PICKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRASS.PICKED"
msgid "It was cut down in the prime of its life."
msgstr "Nó đã bị cắt đứt khi đang ở độ tuổi đẹp nhất cuộc đời."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRASS.WITHERED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRASS.WITHERED"
msgid "It's not going to grow back while it's so hot."
msgstr "Nó sẽ chẳng mọc lại được khi trời nóng thế này đâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRASSGATOR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRASSGATOR"
msgid "I don't think he likes me very much."
msgstr "Tôi nghĩ nó không thích tôi cho lắm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRASSGEKKO.DISEASED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRASSGEKKO.DISEASED"
msgid "It looks really sick."
msgstr "Trông nó ốm nặng thật đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRASSGEKKO.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRASSGEKKO.GENERIC"
msgid "It's an extra leafy lizard."
msgstr "Đúng là một con thằn lằn rậm rạp."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRASS_UMBRELLA
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRASS_UMBRELLA"
msgid "My hair looks good wet... it's when it dries that's the problem."
msgstr "Tóc tôi trông khá ổn khi ướt... khổ nỗi là lúc nó khô kìa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRAVEURN.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRAVEURN.GENERIC"
msgid "This urn has a lack of spirit."
msgstr "Bình di cốt này thiếu chút tâm linh."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRAVEURN.HAS_SPIRIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRAVEURN.HAS_SPIRIT"
msgid "This spirit has urned a new home!"
msgstr "Linh hồn này đã tìm được một ngôi nhà mới!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRAVY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GRAVY"
msgid "It's all gravy."
msgstr "Mọi chuyện đều ổn cả."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GREENAMULET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GREENAMULET"
msgid "No base should be without one!"
msgstr "Căn cứ nào cũng nên có một cái!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GREENGEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GREENGEM"
msgid "It's green and gemmy."
msgstr "Nó màu xanh và ra dáng ngọc quý."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GREENMOONEYE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GREENMOONEYE"
msgid "That'll keep a watchful eye on the place."
msgstr "Cái đó sẽ canh chừng khu vực này thật cẩn thận."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GREENSTAFF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GREENSTAFF"
msgid "This will come in handy."
msgstr "Cái này sẽ rất hữu ích đây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GREEN_CAP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GREEN_CAP"
msgid "It seems pretty normal."
msgstr "Trông có vẻ khá bình thường."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GREEN_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GREEN_CAP_COOKED"
msgid "It's different now..."
msgstr "Bây giờ nó khác trước rồi..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GREEN_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GREEN_MUSHROOM.GENERIC"
msgid "It's a mushroom."
msgstr "Đó là một cây nấm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GREEN_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GREEN_MUSHROOM.INGROUND"
msgid "It's sleeping."
msgstr "Nó đang ngủ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GREEN_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GREEN_MUSHROOM.PICKED"
msgid "I wonder if it will come back?"
msgstr "Không biết nó có mọc lại không nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GROTTO_POOL_BIG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GROTTO_POOL_BIG"
msgid "The moon water makes the glass grow. That's just science."
msgstr "Nước dưới ánh trăng làm cho thủy tinh lớn lên. Khoa học cả đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GROTTO_POOL_SMALL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GROTTO_POOL_SMALL"
msgid "The moon water makes the glass grow. That's just science."
msgstr "Nước dưới ánh trăng làm cho thủy tinh lớn lên. Khoa học cả đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GUACAMOLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GUACAMOLE"
msgid "Avogadro's favorite dish."
msgstr "Món khoái khẩu của Avogadro."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GUANO
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GUANO"
msgid "Another flavor of poop."
msgstr "Một loại phân bón có hương vị khác."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GUNPOWDER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GUNPOWDER"
msgid "It looks like pepper."
msgstr "Trông giống bột ớt ghê."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_1
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_1"
msgid "The cavities are probably worth it, right?"
msgstr "Sâu răng thì chắc cũng đáng lắm nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_10
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_10"
msgid "Only a sucker wouldn't love this."
msgstr "Chỉ có kẻ ngốc mới không thích thứ này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_11
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_11"
msgid "Much better tasting than the real thing."
msgstr "Ngon hơn hẳn đồ thật."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_12
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_12"
msgid "Did that candy just move?"
msgstr "Cục kẹo đó vừa chuyển động phải không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_13
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_13"
msgid "Oh, my poor jaw."
msgstr "Ôi, cái hàm tội nghiệp của tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_14
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_14"
msgid "I don't do well with spice."
msgstr "Tôi không hợp với đồ ăn cay cho lắm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_2"
msgid "What corruption of science grew these?"
msgstr "Thứ quái gì đã làm vấy bẩn khoa học để sinh ra mấy thứ này thế?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_3
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_3"
msgid "It's... corn."
msgstr "Nó là... ngô."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_4
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_4"
msgid "They wriggle on the way down."
msgstr "Chúng cứ ngọ nguậy trên đường trôi xuống cổ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_5
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_5"
msgid "My teeth are going to have something to say about this tomorrow."
msgstr "Hôm nay ăn thế này mai răng cỏ chắc lại phải lên tiếng cho xem."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_6
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_6"
msgid "I... don't think I'll be eating those."
msgstr "Tôi... chắc sẽ không ăn mấy thứ đó đâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_7
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_7"
msgid "Everyone'll be raisin' a fuss over these."
msgstr "Ai cũng sẽ phát cuồng vì mấy món này cho xem."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_8
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_8"
msgid "Only a sucker wouldn't love this."
msgstr "Chỉ có kẻ ngốc mới không thích thứ này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_9
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_9"
msgid "Sticks to your teeth."
msgstr "Dính chặt vào răng luôn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENPOTION_BRAVERY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENPOTION_BRAVERY"
msgid "Full of grit."
msgstr "Tràn đầy gan dạ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT"
msgid "A potent potion."
msgstr "Một bình thuốc cực mạnh."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK"
msgid "I was hoping for something bigger."
msgstr "Tôi cứ hy vọng thứ gì đó đô con hơn cơ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENPOTION_FIRE_FX
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENPOTION_FIRE_FX"
msgid "Crystallized inferno."
msgstr "Ngọn lửa đã kết tinh."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENPOTION_MOON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENPOTION_MOON"
msgid "Infused with transforming such-and-such."
msgstr "Được truyền nhiễm thứ phép biến hình gì gì đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_1
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_1"
msgid "A spectornament I could hang in a tree."
msgstr "Một món đồ trang trí ma quái mà tôi có thể treo lên cây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_2"
msgid "Completely batty decoration."
msgstr "Đồ trang trí đậm chất loài dơi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_3
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_3"
msgid "This wood look good hanging somewhere."
msgstr "Món đồ gỗ này treo ở đâu trông cũng đẹp."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_4
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_4"
msgid "Almost i-tentacle to the real ones."
msgstr "Gần như "xúc-tu-i" giống hệt hàng thật."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_5
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_5"
msgid "Eight-armed adornment."
msgstr "Món đồ trang trí tám tay."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_6
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_6"
msgid "Everyone's raven about tree decorations these days."
msgstr "Dạo này ai cũng bàn tán xôn xao về đồ trang trí cây cối."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAMBAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAMBAT"
msgid "This seems unsanitary."
msgstr "Trông có vẻ không vệ sinh cho lắm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAMMER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAMMER"
msgid "Stop! It's time! To hammer things!"
msgstr "Dừng lại! Đã đến lúc! Đập phá thôi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAMMER_MJOLNIR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAMMER_MJOLNIR"
msgid "It's a heavy hammer for hitting things."
msgstr "Đó là một chiếc búa nặng dùng để nện đồ vật."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HANDPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HANDPILLOW_BEEFALOWOOL"
msgid "If only it didn't also smell like a beefalo."
msgstr "Ước gì nó đừng có mùi giống bò lai."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HANDPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HANDPILLOW_KELP"
msgid "It's soggier than I would like."
msgstr "Nó ẩm ướt hơn tôi tưởng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HANDPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HANDPILLOW_PETALS"
msgid "At least it smells nicer than the beefalo pillow."
msgstr "Ít ra nó còn thơm hơn cái gối lông bò lai."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HANDPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HANDPILLOW_STEELWOOL"
msgid "Who would sleep on this?"
msgstr "Ai mà thèm ngủ trên cái này cơ chứ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAREBALL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAREBALL"
msgid "At this point... I've eaten worse things."
msgstr "Đến nước này thì... tôi ăn những thứ còn kinh hơn thế này rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAWAIIANSHIRT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAWAIIANSHIRT"
msgid "It's not lab-safe!"
msgstr "Không an toàn trong phòng thí nghiệm chút nào!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEALINGSALVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEALINGSALVE"
msgid "The stinging means that it's working."
msgstr "Cảm giác xót tức là nó đang phát huy tác dụng đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEALINGSALVE_ACID
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEALINGSALVE_ACID"
msgid "This will salve a number of problems."
msgstr "Thứ này sẽ giải quyết được kha khá rắc rối đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEALINGSALVE_FUMAROLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEALINGSALVE_FUMAROLE"
msgid "It beats the heat."
msgstr "Nó giúp đánh bay cái nóng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEALINGSTAFF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEALINGSTAFF"
msgid "It conducts regenerative energy."
msgstr "Nó dẫn truyền năng lượng hồi phục."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.COLD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.COLD"
msgid "That's a cold stone."
msgstr "Đó là một hòn đá lạnh ngắt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.FROZEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.FROZEN"
msgid "It's colder than ice."
msgstr "Nó lạnh hơn cả băng đá."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.GENERIC"
msgid "I could manipulate its temperature."
msgstr "Tôi có thể thao túng nhiệt độ của nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.HOT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.HOT"
msgid "Nice and toasty hot!"
msgstr "Nóng ấm dễ chịu thật!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.WARM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.WARM"
msgid "It's quite warm and cuddly... for a rock!"
msgstr "Nó khá ấm áp và dễ chịu... đối với một hòn đá!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEDGEHOUND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEDGEHOUND"
msgid "It's an ambush!"
msgstr "Đó là một cú phục kích!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEDGEHOUND_BUSH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEDGEHOUND_BUSH"
msgid "It's a bush."
msgstr "Đó là một bụi cây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB"
msgid "Living by yourshellf must get abalonely."
msgstr "Sống một mình "vỏn-vẹn" chắc là cô "đơn-bào" lắm nhỉ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRABTEA_FIRENETTLES
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRABTEA_FIRENETTLES"
msgid "It should come with a warming label."
msgstr "Nó chắc phải đi kèm với nhãn cảnh báo bỏng đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRABTEA_FOLIAGE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRABTEA_FOLIAGE"
msgid "Don't worry, I won't go crazy with it."
msgstr "Đừng lo, tôi sẽ không làm quá lên đâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRABTEA_FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRABTEA_FORGETMELOTS"
msgid "It really melts away my madness."
msgstr "Nó thực sự làm tan biến cơn điên của tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRABTEA_MOON_TREE_BLOSSOM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRABTEA_MOON_TREE_BLOSSOM"
msgid "I don't mean to wane, but it's kind of waxy."
msgstr "Tôi không có ý chê bai gì đâu, nhưng nó cứ như làm bằng sáp ấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRABTEA_PETALS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRABTEA_PETALS"
msgid "Mmmm, sweet sereni-tea."
msgstr "Mmmm, thứ trà thanh tịnh ngọt ngào."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRABTEA_PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRABTEA_PETALS_EVIL"
msgid "Insani-tea!"
msgstr "Trà-điên-cuồng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRABTEA_SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRABTEA_SUCCULENT_PICKED"
msgid "I should save it for desert."
msgstr "Tôi nên để dành nó cho món tráng miệng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRABTEA_TILLWEED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRABTEA_TILLWEED"
msgid "Let's raise a little health!"
msgstr "Nào cùng nâng lượng máu lên nào!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB_LIGHTPOST.ABANDONED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB_LIGHTPOST.ABANDONED"
msgid "It's so sad, I can't stand it."
msgstr "Trông đáng thương quá, tôi chịu không nổi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB_LIGHTPOST.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB_LIGHTPOST.GENERIC"
msgid "They really lighten the mood."
msgstr "Chúng thực sự làm tâm trạng sáng bừng lên đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB_LIGHTPOST_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB_LIGHTPOST_ITEM"
msgid "Let's string together some ambiance."
msgstr "Hãy thắp lên chút không khí nào."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB_RELOCATION_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB_RELOCATION_KIT"
msgid "The crab's new home will be pitcher perfect."
msgstr "Ngôi nhà mới của con cua sẽ hoàn hảo như một bức tranh."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB_SHELL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB_SHELL"
msgid "Shell we go to Pearl's?"
msgstr "Chúng ta có "vỏ-n" ghé thăm chỗ Pearl không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB_TEASHOP.ACTIVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB_TEASHOP.ACTIVE"
msgid "Tea time!"
msgstr "Đến giờ uống trà rồi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB_TEASHOP.BREWING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB_TEASHOP.BREWING"
msgid "I paid a steep price."
msgstr "Tôi đã phải trả một cái giá đắt đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB_TEASHOP.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB_TEASHOP.BURNT"
msgid "Her shop is toast."
msgstr "Cửa hàng của bà ấy tiêu tùng rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB_TEASHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB_TEASHOP.GENERIC"
msgid "The shop is emp-tea."
msgstr "Cửa hàng đang "trống-vắng"."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITHOTSPRING.BOMBED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITHOTSPRING.BOMBED"
msgid "The perfect formula for relaxing."
msgstr "Công thức hoàn hảo để thư giãn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITHOTSPRING.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITHOTSPRING.EMPTY"
msgid "Where's the water?"
msgstr "Nước đâu mất tiêu rồi?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITHOTSPRING.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITHOTSPRING.GENERIC"
msgid "If only I could soak my weary bones."
msgstr "Ước gì tôi có thể ngâm mình cho đỡ mỏi xương cốt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITHOTSPRING_CONSTR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITHOTSPRING_CONSTR"
msgid "It's under construction."
msgstr "Nó đang được xây dựng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITHOUSE.BUILTUP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITHOUSE.BUILTUP"
msgid "It just needed a little love."
msgstr "Nó chỉ cần thêm một chút yêu thương thôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITHOUSE.GENERIC"
msgid "It's just an empty shell of a house."
msgstr "Đó chỉ là cái vỏ rỗng của một ngôi nhà."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITHOUSE_LAUNDRY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITHOUSE_LAUNDRY"
msgid "Should I say something, or is it unmentionable?"
msgstr "Mình có nên nói gì không, hay cứ lờ đi cho rồi?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITHOUSE_ORNAMENT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITHOUSE_ORNAMENT"
msgid "How chiming."
msgstr "Đúng là leng keng vui tai."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMIT_BUNDLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMIT_BUNDLE"
msgid "She shore shells out a lot of these."
msgstr "Bà ấy bờ-môi tung ra khối thứ hay ho đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMIT_BUNDLE_SHELLS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMIT_BUNDLE_SHELLS"
msgid "She DOES sell sea shells!"
msgstr "Bà ấy THẬT SỰ bán vỏ sò biển kìa!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMIT_CRACKED_PEARL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMIT_CRACKED_PEARL"
msgid "I... didn't take good care of it."
msgstr "Tôi... đã không chăm sóc nó cho tốt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMIT_PEARL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMIT_PEARL"
msgid "I'll take good care of it."
msgstr "Tôi sẽ chăm sóc nó thật tốt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HIVEHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HIVEHAT"
msgid "The world seems a little less crazy when I wear it."
msgstr "Thế giới có vẻ bớt điên rồ hơn một chút khi tôi đội nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOME
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOME"
msgid "Someone must live here."
msgstr "Chắc có ai đó sống ở đây rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOMESIGN.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOMESIGN.BURNT"
msgid "\"Don't play with matches.\""
msgstr "\"Đừng đùa với diêm.\""

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOMESIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOMESIGN.GENERIC"
msgid "It says \"You are here\"."
msgstr "Nó ghi là \"Bạn đang ở đây\"."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOMESIGN.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOMESIGN.UNWRITTEN"
msgid "The sign is currently blank."
msgstr "Bảng hiệu hiện đang trống trơn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HONEY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HONEY"
msgid "Looks delicious!"
msgstr "Trông ngon quá!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HONEYCOMB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HONEYCOMB"
msgid "Bees used to live in this."
msgstr "Lũ ong từng sống trong này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HONEYHAM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HONEYHAM"
msgid "Sweet and savory."
msgstr "Ngọt ngào và đậm đà."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HONEYNUGGETS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HONEYNUGGETS"
msgid "Tastes like chicken, but I don't think it is."
msgstr "Vị giống thịt gà, nhưng tôi không nghĩ nó là thịt gà đâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HORN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HORN"
msgid "It sounds like a beefalo field in there."
msgstr "Nghe tiếng cứ như cả đàn bò lai đang ở trong đó vậy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HORRORFUEL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HORRORFUEL"
msgid "It sends a terrible shiver down my spine."
msgstr "Nó khiến sống lưng tôi lạnh toát."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HORSESHOE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HORSESHOE"
msgid "It would behoove me to keep this."
msgstr "Tôi nên giữ lại cái này thì hơn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOTCHILI
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOTCHILI"
msgid "Five alarm!"
msgstr "Cấp độ năm!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOTSPRING.BOMBED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOTSPRING.BOMBED"
msgid "Just a simple chemical reaction."
msgstr "Chỉ là một phản ứng hóa học đơn giản thôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOTSPRING.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOTSPRING.EMPTY"
msgid "I'll just have to wait for it to fill up again."
msgstr "Tôi đành phải chờ nó đầy nước trở lại vậy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOTSPRING.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOTSPRING.GENERIC"
msgid "If only I could soak my weary bones."
msgstr "Ước gì tôi có thể ngâm mình cho đỡ mỏi xương cốt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOTSPRING.GLASS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOTSPRING.GLASS"
msgid "Water turns to glass under the moon. That's just science."
msgstr "Nước hóa thành thủy tinh dưới ánh trăng. Khoa học cả đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUND"
msgid "You ain't nothing, hound dog!"
msgstr "Mày chẳng là cái thá gì cả, chú chó săn ơi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDBONE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDBONE"
msgid "Creepy."
msgstr "Ớn lạnh thật."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDCORPSE.BURNING"
msgid "I think we're safe now."
msgstr "Tôi nghĩ chúng ta an toàn rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDCORPSE.GENERIC"
msgid "The smell is not the most pleasant."
msgstr "Mùi không được dễ chịu cho lắm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDCORPSE.REVIVING"
msgid "Science save us!"
msgstr "Khoa học hãy cứu chúng con!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDMOUND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDMOUND"
msgid "I've got no bones to pick with the owner. Really."
msgstr "Tôi chẳng có xương xẩu gì để mà đôi co với chủ nhà cả. Thật đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDSTOOTH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDSTOOTH"
msgid "It's sharp!"
msgstr "Sắc bén lắm đấy!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDSTOOTH_BLOWPIPE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDSTOOTH_BLOWPIPE"
msgid "Teeth? Doesn't seem all that hygenic."
msgstr "Răng á? Nghe không hợp vệ sinh cho lắm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDWHISTLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDWHISTLE"
msgid "This'd stop a dog in its tracks."
msgstr "Cái này mà thổi thì chó cũng phải khựng lại."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUMANMEAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUMANMEAT"
msgid "Flesh is flesh. Where do I draw the line?"
msgstr "Thịt thì cũng là thịt. Đâu là ranh giới đạo đức chứ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUMANMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUMANMEAT_COOKED"
msgid "Cooked nice and pink, but still morally gray."
msgstr "Nướng chín hồng, nhưng về mặt đạo đức thì vẫn mập mờ lắm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUMANMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUMANMEAT_DRIED"
msgid "Letting it dry makes it not come from a human, right?"
msgstr "Làm khô nó đi thì coi như không phải thịt người nữa, đúng chứ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUTCH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUTCH"
msgid "Hutch Danglefish, P.I."
msgstr "Hutch Danglefish, thám tử tư."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
msgid "I always wanted one of these."
msgstr "Tôi vẫn luôn muốn có một cái như thế này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "Maybe he needs some science?"
msgstr "Biết đâu chú ta cần một chút khoa học nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICE"
msgid "Ice to meet you."
msgstr "Rất vui được "băng" diện."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEBERG.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEBERG.GENERIC"
msgid "Let's steer clear of that."
msgstr "Hãy tránh xa thứ đó ra."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEBERG.MELTED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEBERG.MELTED"
msgid "It's completely melted."
msgstr "Nó tan chảy hoàn toàn rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEBERG_MELTED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEBERG_MELTED"
msgid "It's completely melted."
msgstr "Nó tan chảy hoàn toàn rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEBOX
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEBOX"
msgid "I have harnessed the power of cold!"
msgstr "Ta đã khai thác được sức mạnh của cái lạnh!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICECREAM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICECREAM"
msgid "I scream for ice cream!"
msgstr "Tôi thét lên vì kem!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEHAT"
msgid "Stay cool, boy."
msgstr "Bình tĩnh nào, anh bạn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEHOUND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEHOUND"
msgid "Are there hounds for every season?"
msgstr "Lại còn có chó săn theo mùa nữa cơ à?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEPACK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEPACK"
msgid "The fur keeps the temperature inside stable."
msgstr "Lớp lông thú giúp giữ nhiệt độ bên trong ổn định."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICESTAFF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICESTAFF"
msgid "It's cold to the touch."
msgstr "Sờ vào thấy lạnh ngắt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICESTAFF2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICESTAFF2"
msgid "It comes with a freeze upgrade!"
msgstr "Nó đi kèm với bản nâng cấp đóng băng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICESTAFF3
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICESTAFF3"
msgid "Even more powerful, icy."
msgstr "Cực kỳ mạnh mẽ và băng giá."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICE_BLUEPRINT"
msgid "I usually like my beefalo fresh, not frozen."
msgstr "Tôi thường thích bò lai tươi hơn là đông lạnh."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.INSANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.INSANITYROCK.ACTIVE"
msgid "TAKE THAT, SANE SELF!"
msgstr "NHẬN ĐIỀU NÀY ĐI, BẢN THÂN TỈNH TÁO ƠI!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.INSANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.INSANITYROCK.INACTIVE"
msgid "It's more of a pyramid than an obelisk."
msgstr "Trông nó giống kim tự tháp hơn là một cột tháp đá."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.INSPECTACLESBOX
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.INSPECTACLESBOX"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.INSPECTACLESBOX2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.INSPECTACLESBOX2"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.INSPECTACLESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.INSPECTACLESHAT.GENERIC"
msgid "Winona always struck me as someone with a vision for the future."
msgstr "Winona từ trước đến nay luôn mang phong thái của một kẻ có tầm nhìn hướng về tương lai."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.INSPECTACLESHAT.MISSINGSKILL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.INSPECTACLESHAT.MISSINGSKILL"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.INSPECTSELF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.INSPECTSELF"
msgid "Am I still in one piece?"
msgstr "Mình còn lành lặn cả chứ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.IPECACSYRUP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.IPECACSYRUP"
msgid "I don't think I want to eat this."
msgstr "Tôi nghĩ mình không muốn ăn cái này đâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.IVY_SNARE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.IVY_SNARE"
msgid "Now that's just rude."
msgstr "Thế thì hơi bất lịch sự đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.JAMMYPRESERVES
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.JAMMYPRESERVES"
msgid "Probably should have made a jar."
msgstr "Lẽ ra nên làm một cái hũ thì hơn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.JELLYBEAN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.JELLYBEAN"
msgid "One part jelly, one part bean."
msgstr "Một phần thạch, một phần hạt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.JUNK_PILE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.JUNK_PILE"
msgid "A good junk pile rummage? I'll never refuse."
msgstr "Lục lọi đống phế liệu á? Không bao giờ từ chối đâu nhé."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.JUNK_PILE_BIG.BLUEPRINT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.JUNK_PILE_BIG.BLUEPRINT"
msgid "There's something up there."
msgstr "Có cái gì đó ở trên đó kìa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.JUNK_PILE_BIG.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.JUNK_PILE_BIG.GENERIC"
msgid "I think it could fall over any moment."
msgstr "Tôi nghĩ nó có thể đổ sập xuống bất cứ lúc nào."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.JUSTEGGS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.JUSTEGGS"
msgid "It could use some bacon."
msgstr "Thêm chút thịt xông khói vào thì tuyệt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KABOBS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KABOBS"
msgid "Lunch on a stick."
msgstr "Bữa trưa trên que xiên."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KELP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KELP"
msgid "It gets my pockets all wet and gross."
msgstr "Nó làm túi quần tôi ướt sũng và gớm ghiếc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KELPHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KELPHAT"
msgid "Sometimes you have to feel worse to feel better."
msgstr "Đôi khi bạn phải chịu cảm giác tệ hơn để thấy tốt hơn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KELP_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KELP_COOKED"
msgid "It's closer to a liquid than a solid."
msgstr "Nó gần như lỏng hơn là đặc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KELP_DRIED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KELP_DRIED"
msgid "The sodium content's kinda high."
msgstr "Hàm lượng natri hơi cao thì phải."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KILLERBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KILLERBEE.GENERIC"
msgid "Oh no! It's a killer bee!"
msgstr "Ôi không! Ong sát thủ kìa!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KILLERBEE.HELD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KILLERBEE.HELD"
msgid "This seems dangerous."
msgstr "Trông có vẻ nguy hiểm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOONDECOR1.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOONDECOR1.BURNT"
msgid "Combustion!"
msgstr "Bốc cháy!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOONDECOR1.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOONDECOR1.GENERIC"
msgid "It's not a real bird, but the kits don't know that."
msgstr "Không phải chim thật đâu, nhưng lũ mèo con thì đâu có biết."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOONDECOR1_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOONDECOR1_KIT"
msgid "It looks like there's some assembly required."
msgstr "Trông có vẻ cần phải tự lắp ráp đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOONDECOR2.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOONDECOR2.BURNT"
msgid "It went up in flames."
msgstr "Nó cháy thành tro rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOONDECOR2.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOONDECOR2.GENERIC"
msgid "Those kits are so easily distracted. Now what was I doing again?"
msgstr "Lũ mèo con đó dễ bị phân tâm thật. Mà vừa nãy mình đang làm gì ấy nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOONDECOR2_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOONDECOR2_KIT"
msgid "It doesn't look too hard to build."
msgstr "Trông có vẻ không khó xây lắm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOONDEN.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOONDEN.BURNT"
msgid "NOOOO!"
msgstr "KHÔOOOOONG!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOONDEN.GENERIC"
msgid "You'd have to be pretty small to fit in there."
msgstr "Ngươi phải bé lắm mới chui vừa cái đó đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK"
msgid "Now where could they be..."
msgstr "Không biết bọn chúng trốn ở đâu rồi nhỉ..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK_TIME_ALMOST_UP"
msgid "Not much time left! Where are they?!"
msgstr "Sắp hết giờ rồi! Bọn chúng đâu mất tiêu rồi chứ?!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOONDEN_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOONDEN_KIT"
msgid "The whole kit and caboodle."
msgstr "Trọn gói cả mớ luôn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOON_DECIDUOUS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOON_DECIDUOUS"
msgid "Aren't you the cutest little cat thing!"
msgstr "Cậu đúng là sinh vật mèo con đáng yêu nhất!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOON_DESERT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOON_DESERT"
msgid "I must collect more... for research!"
msgstr "Mình phải thu thập thêm... vì mục đích nghiên cứu!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOON_FOREST
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOON_FOREST"
msgid "Aren't you the cutest little cat thing!"
msgstr "Cậu đúng là sinh vật mèo con đáng yêu nhất!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOON_GRASS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOON_GRASS"
msgid "Aren't you the cutest little cat thing!"
msgstr "Cậu đúng là sinh vật mèo con đáng yêu nhất!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOON_MARSH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOON_MARSH"
msgid "I must collect more... for research!"
msgstr "Mình phải thu thập thêm... vì mục đích nghiên cứu!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOON_MOON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOON_MOON"
msgid "I must collect more... for research!"
msgstr "Mình phải thu thập thêm... vì mục đích nghiên cứu!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOON_NAMETAG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOON_NAMETAG"
msgid "I should think of some names! Let's see, Wilson Jr., Wilson Jr. 2..."
msgstr "Mình nên nghĩ vài cái tên mới được! Để xem nào, Wilson Con Jr., Wilson Con Jr. 2..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOON_ROCKY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOON_ROCKY"
msgid "I must collect more... for research!"
msgstr "Mình phải thu thập thêm... vì mục đích nghiên cứu!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOON_SAVANNA
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOON_SAVANNA"
msgid "Aren't you the cutest little cat thing!"
msgstr "Cậu đúng là sinh vật mèo con đáng yêu nhất!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOON_YOT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KITCOON_YOT"
msgid "I must collect more... for research!"
msgstr "Mình phải thu thập thêm... vì mục đích nghiên cứu!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KLAUS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KLAUS"
msgid "What on earth is that thing!"
msgstr "Thứ quái quỷ gì thế này!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KLAUSSACKKEY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KLAUSSACKKEY"
msgid "It's really fancy for a deer antler."
msgstr "Đối với một chiếc nhung hươu thì cái này quá sức cầu kỳ rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KLAUS_SACK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KLAUS_SACK"
msgid "We should definitely open that."
msgstr "Chúng ta chắc chắn nên mở cái đó ra."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KNIGHT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KNIGHT"
msgid "Check it out!"
msgstr "Xem kìa!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KNIGHT_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KNIGHT_NIGHTMARE"
msgid "It's a knightmare!"
msgstr "Đúng là một cơn ác mộng hiệp sĩ!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KNIGHT_YOTH.FOLLOWING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KNIGHT_YOTH.FOLLOWING"
msgid "Good knight!"
msgstr "Chúc ngủ ngon!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KNIGHT_YOTH.FOLLOWING_OTHER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KNIGHT_YOTH.FOLLOWING_OTHER"
msgid "Who's in charge? Have you herd?"
msgstr "Ai đang quản lý thế? Cậu có nghe ngóng gì chưa?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KNIGHT_YOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KNIGHT_YOTH.GENERIC"
msgid "Quit horsin' around!"
msgstr "Đừng có đùa giỡn nữa!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KOALEFANT_CARCASS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KOALEFANT_CARCASS"
msgid "Adorably dead."
msgstr "Chết mà vẫn đáng yêu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KOALEFANT_SUMMER"
msgid "Adorably delicious."
msgstr "Ngon lành một cách đáng yêu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KOALEFANT_WINTER"
msgid "It looks warm and full of meat."
msgstr "Trông có vẻ ấm áp và đầy thịt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KOALEFIG_TRUNK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KOALEFIG_TRUNK"
msgid "Great, now I've got a stuffed nose."
msgstr "Tuyệt, giờ thì tôi bị nghẹt mũi rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KRAMPUS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KRAMPUS"
msgid "He's going after my stuff!"
msgstr "Nó đang nhắm vào đồ đạc của tôi kìa!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KRAMPUS_SACK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KRAMPUS_SACK"
msgid "Ew. It has Krampus slime all over it."
msgstr "Eo ôi. Dính đầy chất nhờn của Krampus rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LANTERN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LANTERN"
msgid "A more civilized light."
msgstr "Ánh sáng văn minh hơn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LATKES
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LATKES"
msgid "I could eat a latke more of these."
msgstr "Tôi có thể ăn thêm mấy cái bánh kho chiên này nữa đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY"
msgid "This armor has been petrified for maximum protection."
msgstr "Bộ giáp này đã bị hóa đá để đạt mức bảo vệ tối đa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORHEAVY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORHEAVY"
msgid "That's as good as it gets."
msgstr "Đó là mức tốt nhất có thể."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORLIGHT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORLIGHT"
msgid "Light, but not very durable."
msgstr "Nhẹ, nhưng không bền lắm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED"
msgid "Lightweight and designed for mobility."
msgstr "Nhẹ và được thiết kế để di chuyển linh hoạt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORMEDIUM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORMEDIUM"
msgid "It offers a decent amount of protection."
msgstr "Nó cung cấp một lượng bảo vệ khá ổn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER"
msgid "That could help me hit a little harder."
msgstr "Cái đó có thể giúp tôi đánh mạnh hơn một chút."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER"
msgid "I'd have energy for a few more stunts wearing that."
msgstr "Mặc cái đó vào, tôi sẽ có năng lượng cho vài cú tung chiêu đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMOR_HP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMOR_HP"
msgid "That should keep me safe."
msgstr "Cái đó sẽ giữ cho két sắt của tôi được an toàn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_BATTLESTANDARD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_BATTLESTANDARD"
msgid "Everyone, break the Battle Standard!"
msgstr "Mọi người, phá hủy Cờ Hiệu Chiến Đấu đi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_BERNIE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_BERNIE"
msgid "He might make a good distraction for us."
msgstr "Cậu ta có thể đóng vai trò đánh lạc hướng tốt cho chúng ta."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_BOARLORD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_BOARLORD"
msgid "That's the guy in charge here."
msgstr "Đó là kẻ đang phụ trách ở đây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT"
msgid "That could cause some major destruction."
msgstr "Cái đó có thể gây ra sự tàn phá lớn đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ELEMENTAL"
msgid "It's a rock monster!"
msgstr "Đó là một con quái vật đá tảng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_EYECIRCLETHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_EYECIRCLETHAT"
msgid "It has a gaze full of science."
msgstr "Nó mang ánh nhìn đậm chất khoa học."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_FEATHERCROWNHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_FEATHERCROWNHAT"
msgid "Those fluffy feathers make me want to run!"
msgstr "Mấy chiếc lông xù xì đó làm tôi muốn chạy ngay!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_FIREBOMB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_FIREBOMB"
msgid "It smells like brimstone."
msgstr "Nó có mùi giống lưu huỳnh."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT"
msgid "The blossom interacts well with healing magic."
msgstr "Bông hoa tương tác rất tốt với phép thuật chữa trị."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT"
msgid "This garland will restore a bit of my vitality."
msgstr "Vòng hoa này sẽ hồi phục lại một chút sinh lực cho tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_HEAVYBLADE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_HEAVYBLADE"
msgid "A sharp looking instrument."
msgstr "Một dụng cụ trông có vẻ sắc bén."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_KEYHOLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_KEYHOLE"
msgid "It needs a key."
msgstr "Nó cần một chìa khóa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_KEYHOLE_FULL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_KEYHOLE_FULL"
msgid "That should do it."
msgstr "Thế là được rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT"
msgid "My strikes would hurt a little more wearing that."
msgstr "Các đòn tấn công của tôi sẽ đau hơn một chút khi mặc cái đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_LUCY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_LUCY"
msgid "That weapon's for throwing."
msgstr "Vũ khí đó dùng để ném."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_PORTAL.GENERIC"
msgid "That's how we got here. Hopefully how we get back, too."
msgstr "Đó là cách chúng ta đến đây. Hy vọng cũng là cách để quay về."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_PORTAL.ON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_PORTAL.ON"
msgid "I'll just be going now."
msgstr "Tôi chuẩn bị đi đây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_RECHARGERHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_RECHARGERHAT"
msgid "Those crystals will quicken my abilities."
msgstr "Những viên pha lê đó sẽ đẩy nhanh năng lực của tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_SPAWNER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_SPAWNER"
msgid "This is where those enemies are coming from."
msgstr "Đây là nơi lũ kẻ thù xuất hiện."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT"
msgid "It looks like it packs a wallop."
msgstr "Trông có vẻ ra trò đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT"
msgid "Looks like it amplifies healing expertise."
msgstr "Có vẻ nó khuếch đại chuyên môn hồi máu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE"
msgid "Too hot to handle."
msgstr "Quá nóng để chạm vào."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_COCOON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_COCOON"
msgid "Cooled off and chilled out."
msgstr "Đã nguội và hạ nhiệt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_EGG.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_EGG.GENERIC"
msgid "There's a faint warmth coming from inside."
msgstr "Có một chút hơi ấm phát ra từ bên trong."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
msgid "I don't think that egg is warm enough."
msgstr "Tôi không nghĩ quả trứng đó đủ ấm đâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
msgid "I never thought I would see a happy egg."
msgstr "Tôi chưa bao giờ nghĩ mình sẽ thấy một quả trứng hạnh phúc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_PET.CONTENT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_PET.CONTENT"
msgid "It seems happy."
msgstr "Nó có vẻ hạnh phúc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_PET.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_PET.GENERIC"
msgid "Aww. Who's a good monster?"
msgstr "Ồ. Ai là quái vật ngoan nào?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_PET.HUNGRY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_PET.HUNGRY"
msgid "I hear a tiny stomach grumbling."
msgstr "Tôi nghe thấy tiếng bụng nhỏ đang réo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_PET.STARVING"
msgid "Poor thing must be starving."
msgstr "Tội nghiệp, chắc nó đang đói lả rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_TOOTH"
msgid "It's an egg tooth!"
msgstr "Đó là một chiếc răng trứng!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVASPIT.COOL"
msgid "I like to call it \"Basaliva\"."
msgstr "Tôi thích gọi nó là \"Dịch Nham Thạch\"."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVASPIT.HOT"
msgid "Hot spit!"
msgstr "Nước bọt bỏng rát!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVA_POND"
msgid "Magmificent!"
msgstr "Tuyệt magmáf!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVA_POND_ROCK"
msgid "As gneiss a place as any."
msgstr "Cũng là một nơi ổn chán."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LEAFLOAF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LEAFLOAF"
msgid "Mystery leaf meat."
msgstr "Thịt lá bí ẩn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LEAFYMEATBURGER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LEAFYMEATBURGER"
msgid "Vegetarian, but not cruelty-free."
msgstr "Ăn chay, nhưng không hề nhân đạo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LEAFYMEATSOUFFLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LEAFYMEATSOUFFLE"
msgid "Has science gone too far?"
msgstr "Khoa học đã đi quá giới hạn rồi phải không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LEIF"
msgid "He's huge!"
msgstr "Cậu ta to quá!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LEIF_IDOL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LEIF_IDOL"
msgid "Carving a tree out of wood seems a bit redundant."
msgstr "Tạc một cái cây từ gỗ nghe hơi thừa thãi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LEIF_SPARSE"
msgid "He's huge!"
msgstr "Cậu ta to quá!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LICHEN"
msgid "Only a cyanobacteria could grow in this light."
msgstr "Chỉ có vi khuẩn lam mới mọc nổi trong ánh sáng này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIFEINJECTOR"
msgid "A scientific breakthrough! The cure!"
msgstr "Một bước đột phá khoa học! Liều thuốc chữa bệnh!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTBULB"
msgid "It's strangely tasty looking."
msgstr "Trông nó có vẻ ngon một cách kỳ lạ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTCRAB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTCRAB"
msgid "It's bioluminous!"
msgstr "Nó phát quang sinh học!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTER"
msgid "It's her lucky lighter."
msgstr "Đó là chiếc bật lửa may mắn của cô ấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTFLIER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTFLIER"
msgid "How strange, carrying one makes my pocket feel lighter!"
msgstr "Lạ thật, mang theo một con khiến túi quần tôi nhẹ hẳn đi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTNINGGOAT.CHARGED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTNINGGOAT.CHARGED"
msgid "I don't think it liked being struck by lightning."
msgstr "Tôi không nghĩ nó thích bị sét đánh đâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTNINGGOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTNINGGOAT.GENERIC"
msgid "\"Baaaah\" yourself!"
msgstr "\"Baaaah\" lại mày này!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTNINGGOATHORN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTNINGGOATHORN"
msgid "It's like a miniature lightning rod."
msgstr "Nó giống như một cột thu lôi thu nhỏ vậy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTNING_ROD.CHARGED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTNING_ROD.CHARGED"
msgid "The power is mine!"
msgstr "Sức mạnh thuộc về ta!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTNING_ROD.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTNING_ROD.GENERIC"
msgid "To harness the heavens!"
msgstr "Để thuần hóa bầu trời!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LITTLE_WALRUS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LITTLE_WALRUS"
msgid "He won't be cute and cuddly forever."
msgstr "Nó sẽ không đáng yêu và dễ thương mãi đâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIVINGLOG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIVINGLOG"
msgid "It looks worried."
msgstr "Trông nó có vẻ lo lắng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIVINGTREE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIVINGTREE"
msgid "Is it watching me?"
msgstr "Nó đang nhìn mình à?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIVINGTREE_ROOT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIVINGTREE_ROOT"
msgid "Something's in there! I'll have to root it out."
msgstr "Có cái gì trong đó! Tôi phải nhổ tận gốc nó lên mới được."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIVINGTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIVINGTREE_SAPLING"
msgid "It'll grow up big and horrifying."
msgstr "Nó sẽ lớn lên thành một thứ to lớn và kinh hoàng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LOBSTERBISQUE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LOBSTERBISQUE"
msgid "Could use more salt, but that's none of my bisque-ness."
msgstr "Cho thêm muối thì ngon hơn, nhưng đó không phải việc của tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LOBSTERDINNER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LOBSTERDINNER"
msgid "If I eat it in the morning is it still dinner?"
msgstr "Nếu tôi ăn nó vào buổi sáng thì có còn gọi là bữa tối không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LOG.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LOG.BURNING"
msgid "That's some hot wood!"
msgstr "Khúc gỗ nóng bỏng thật đấy!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LOG.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LOG.GENERIC"
msgid "It's big, it's heavy, and it's wood."
msgstr "Nó to, nó nặng, và nó bằng gỗ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LORDFRUITFLY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LORDFRUITFLY"
msgid "Hey, stop upsetting the plants!"
msgstr "Này, đừng làm phiền lũ thực vật nữa!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LOST_TOY_1
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LOST_TOY_1"
msgid "I'm sure there's a perfectly scientific explanation for that."
msgstr "Tôi chắc chắn có lời giải thích hoàn toàn khoa học cho chuyện đó."

