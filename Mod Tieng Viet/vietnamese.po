msgstr "Một thứ gì đó rất đặc biệt."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE_PLANTHAPPY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE_PLANTHAPPY"
msgid "I'd best leave well enough alone."
msgstr "Tốt nhất là tôi nên để yên."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE_PLANTSTRESSED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE_PLANTSTRESSED"
