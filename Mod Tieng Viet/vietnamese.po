#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TWIGGY_NUT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TWIGGY_NUT"
msgid "Looks like campfire fuel to me!"
msgstr "Trông giống nhiên liệu đốt lửa trại đối với tôi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TWIGGY_NUT_SAPLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TWIGGY_NUT_SAPLING"
msgid "It'll grow... unless something fiery happens to it."
msgstr "Nó sẽ lớn thôi... trừ khi có chuyện cháy nổ gì xảy ra với nó."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TWIGGY_OLD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TWIGGY_OLD"
msgid "Fire would release it from its torment."
msgstr "Lửa sẽ giải thoát nó khỏi sự dằn vặt này."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TWIGS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TWIGS"
msgid "A bunch of small twigs. Good for fires, among other things."
msgstr "Một bó cành cây nhỏ. Dùng để nhóm lửa và nhiều việc khác."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TWINOFTERROR1
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TWINOFTERROR1"
msgid "Hey no fair, it brought backup!"
msgstr "Này không công bằng nhé, nó gọi viện binh kìa!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TWINOFTERROR2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TWINOFTERROR2"
msgid "Hey no fair, it brought backup!"
msgstr "Này không công bằng nhé, nó gọi viện binh kìa!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.UMBRELLA
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.UMBRELLA"
msgid "I love the color!"
msgstr "Tôi thích màu này!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.UNAGI
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.UNAGI"
msgid "You can make it fancy but it's still an eel."
msgstr "Bạn có làm cho nó sang chảnh thế nào thì nó vẫn là một con lươn thôi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.UNIMPLEMENTED"
msgid "It's not finished. But I bet it still burns."
msgstr "Nó chưa hoàn thiện. Nhưng cá là nó vẫn cháy được."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_CHANDELIER_BROKEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_CHANDELIER_BROKEN"
msgid "Someone could trip on that."
msgstr "Ai đó có thể vấp phải cái đó đấy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_COMPASS.GENERIC"
msgid "Don't tell me where to go!"
msgstr "Đừng có bảo tôi phải đi đâu!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_COMPASS.KEYROOM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_COMPASS.KEYROOM"
msgid "Ha! I knew I'd find it!"
msgstr "Hà! Biết ngay là tôi sẽ tìm thấy mà!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_COMPASS.NOTVAULT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_COMPASS.NOTVAULT"
msgid "Stupid thing doesn't work here."
msgstr "Đồ ngốc nghếch chẳng dùng được ở đây."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_CRAWLER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_CRAWLER.GENERIC"
msgid "Hey! Think you can get the drop on me, huh?!"
msgstr "Này! Tưởng đánh úp được tôi đấy phỏng?!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_CRAWLER.SOCKETED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_CRAWLER.SOCKETED"
msgid "Haha! Now stay put!"
msgstr "Haha! Giờ thì đứng yên đấy nhé!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_CRAWLER_LEVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_CRAWLER_LEVER"
msgid "Ooooooh, I wonder what that does!"
msgstr "Ooooooh, tự hỏi cái đó làm gì thế nhỉ!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_DECON_DOOR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_DECON_DOOR"
msgid "Pfft. Some dumb wall isn't going to stop me."
msgstr "Pfft. Mấy bức tường ngốc nghếch đừng mong cản được tôi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_DECON_MISTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_DECON_MISTER"
msgid "You'd better not spray anything at me again!"
msgstr "Tốt nhất là mày đừng có xịt thứ gì vào người tao nữa đấy!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_KEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_KEY"
msgid "Anywhere's gotta be better than this place. Right...?"
msgstr "Ở đâu cũng phải khá hơn cái xó này chứ. Phải không...?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_KEY_ACTIVATOR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_KEY_ACTIVATOR"
msgid "Huh. Looks like something's supposed to go in there."
msgstr "Hừm. Trông có vẻ như có thứ gì đó phải nhét vào đây."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_KEY_EXIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_KEY_EXIT"
msgid "Can't tie a rope? Who cares!"
msgstr "Không buộc được dây thừng à? Ai thèm quan tâm chứ!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC"
msgid "Looks like trouble... Think I'll take it."
msgstr "Trông có vẻ rắc rối... Nghĩ là tôi sẽ lấy nó đấy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_KEY_PEDESTAL.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_KEY_PEDESTAL.PICKED"
msgid "And it's gone!"
msgstr "Và nó đã biến mất!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_LOBBY_EXIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_LOBBY_EXIT"
msgid "I guess I could always tie a rope if I wanted to come back."
msgstr "Chắc tôi có thể cột dây thừng nếu muốn quay lại."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_ORB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_ORB"
msgid "What am I supposed to do with this stupid ball?"
msgstr "Tôi phải làm gì với cái quả bóng ngốc nghếch này đây?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_ORB_REFINED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_ORB_REFINED"
msgid "So pretty. Now what do I do with it?"
msgstr "Đẹp ghê. Giờ thì làm gì với nó đây?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_PILLAR_GUARD"
msgid "Come onnnn!"
msgstr "Nào nàooo!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR"
msgid "Here we go!"
msgstr "Đi nào!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS"
msgid "Who's ready to get crushed?!"
msgstr "Ai muốn bị nghiền nát nào?!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED"
msgid "Dumb as a ton of bricks, but I like you anyway."
msgstr "Đần như cục gạch, nhưng tôi vẫn thích ngươi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT"
msgid "What good is a tower that doesn't burn?"
msgstr "Cái tháp mà không cháy được thì tích sự gì?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED"
msgid "What is your problem? What do you want now?"
msgstr "Ngươi bị sao thế? Giờ lại muốn gì nữa?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_PILLAR_GUARD_PIECE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_PILLAR_GUARD_PIECE"
msgid "Great, now where does it go?"
msgstr "Tuyệt, giờ thì đặt nó ở đâu nhỉ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_REFINER_PEDESTAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_REFINER_PEDESTAL"
msgid "Does it have a burn function?"
msgstr "Nó có chức năng đốt không?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_RUNE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_RUNE"
msgid "That's stupid."
msgstr "Thật là ngớ ngẩn."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_STATUE.LORE1
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_STATUE.LORE1"
msgid "What is that goop?"
msgstr "Cái chất nhầy nhụa gì thế kia?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_STATUE.LORE2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_STATUE.LORE2"
msgid "That's a lot of dead bugs."
msgstr "Lắm lũ côn trùng chết thế."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_STATUE.LORE3
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_STATUE.LORE3"
msgid "Watch where you're pointing those!"
msgstr "Nhìn cho kỹ hướng ngươi đang chĩa vào đi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_TELEPORTER.BROKEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_TELEPORTER.BROKEN"
msgid "Who the heck broke this?"
msgstr "Đứa quái nào làm hỏng cái này thế?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_TELEPORTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_TELEPORTER.GENERIC"
msgid "It better work!"
msgstr "Mong là nó hoạt động!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_TELEPORTER.UNPOWERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_TELEPORTER.UNPOWERED"
msgid "Someone forgot to plug it in."
msgstr "Ai đó quên cắm điện rồi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_TORCH.BROKEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_TORCH.BROKEN"
msgid "Stupid broken switch."
msgstr "Cái công tắc chết tiệt bị hỏng."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_TORCH.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VAULT_TORCH.GENERIC"
msgid "Light'em up!"
msgstr "Đốt cháy chúng nó đi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VEGGIEOMLET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VEGGIEOMLET"
msgid "Hey, there's vegetables hiding underneath!"
msgstr "Ơ, có rau củ đang ẩn nấp bên dưới kìa!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN"
msgid "A big pile of stinky mush."
msgstr "Một đống bầy nhầy hôi hám to lớn."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VEGSTINGER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VEGSTINGER"
msgid "Fire for my tongue."
msgstr "Lửa cho lưỡi tôi đây."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VICTORIAN_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VICTORIAN_BLUEPRINT"
msgid "Ha! This is gonna look hilarious!"
msgstr "Hừ! Nhìn buồn cười phải biết!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VOIDCLOTH"
msgid "Finders keepers!"
msgstr "Ai nhặt được người đó giữ!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VOIDCLOTHHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VOIDCLOTHHAT"
msgid "You never know who might really be hiding under that hood."
msgstr "Đố biết được ai thực sự đang trốn dưới cái mũ trùm đó."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VOIDCLOTH_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VOIDCLOTH_BOOMERANG"
msgid "Hmm, this could be fun."
msgstr "Hừm, cái này có vẻ vui đây."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VOIDCLOTH_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VOIDCLOTH_KIT"
msgid "Do I look like the kind of person who fixes things? Ugh, fiiiiine..."
msgstr "Trông tôi có giống kiểu người hay sửa đồ không? Hừ, đượooo rồi..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VOIDCLOTH_SCYTHE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VOIDCLOTH_SCYTHE"
msgid "Farming just got a bit less boring."
msgstr "Việc làm ruộng vừa bớt nhàm chán đi một chút."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VOIDCLOTH_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VOIDCLOTH_UMBRELLA"
msgid "At least it keeps the rain off."
msgstr "Ít ra nó cũng che được mưa."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VOLTGOATJELLY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VOLTGOATJELLY"
msgid "HEY WARLY! Can I eat this?"
msgstr "NÀY WARLY! Tôi ăn cái này được không?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAFFLES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAFFLES"
msgid "Hi, waffles!"
msgstr "Chào bánh quế nhé!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGBOSS_ROBOT"
msgid "Looks shifty."
msgstr "Trông đáng ngờ đấy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE"
msgid "It's not too late..."
msgstr "Vẫn chưa quá muộn đâu..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT"
msgid "I should incinerate this, and I'm not just saying that."
msgstr "Tôi nên thiêu rụi cái này, mà tôi không đùa đâu đấy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS"
msgid "These make me nervous."
msgstr "Mấy thứ này làm tôi thấy căng thẳng."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGBOSS_ROBOT_LEG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGBOSS_ROBOT_LEG"
msgid "Stupid killer robot leg."
msgstr "Cái chân robot sát thủ ngốc nghếch."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGBOSS_ROBOT_POSSESSED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGBOSS_ROBOT_POSSESSED"
msgid "I knew it was a killer robot!"
msgstr "Tôi biết ngay nó là một con robot sát thủ mà!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGBOSS_ROBOT_SECRET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGBOSS_ROBOT_SECRET"
msgid "What's that pile of junk under there?"
msgstr "Cái đống phế liệu gì ở dưới kia thế?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGDRONE_BEACON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGDRONE_BEACON"
msgid "Big deal, it can't stop me."
msgstr "Có gì ghê gớm đâu, nó ngăn tôi thế nào được."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGDRONE_FLYING.DAMAGED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGDRONE_FLYING.DAMAGED"
msgid "Blah, it's just spare parts at this point."
msgstr "Xì, tầm này thì nó chỉ là đồ phụ tùng thôi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGDRONE_FLYING.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGDRONE_FLYING.GENERIC"
msgid "Get outta here, flying trashcans!"
msgstr "Cút đi chỗ khác, mấy cái thùng rác bay lượn!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGDRONE_FLYING.INACTIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGDRONE_FLYING.INACTIVE"
msgid "Do something!"
msgstr "Làm gì đi chứ!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGDRONE_PARTS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGDRONE_PARTS"
msgid "Spare junk."
msgstr "Phế liệu thừa."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGDRONE_ROLLING.DAMAGED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGDRONE_ROLLING.DAMAGED"
msgid "So I could fix it or take its parts, but can I just incinerate it?"
msgstr "Tôi có thể sửa hoặc rã nó ra lấy phụ tùng, nhưng tôi thiêu rụi luôn được không?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY"
msgid "Remember when these guys tried to kill us?"
msgstr "Còn nhớ lúc bọn này tìm cách giết chúng ta không?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGDRONE_ROLLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGDRONE_ROLLING.GENERIC"
msgid "You guys are so annoying!"
msgstr "Mấy người phiền phức thật đấy!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGDRONE_ROLLING.INACTIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGDRONE_ROLLING.INACTIVE"
msgid "Do something!"
msgstr "Làm gì đi chứ!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGPUNKBITS_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGPUNKBITS_KIT"
msgid "Nice doodad."
msgstr "Đồ chơi hay đấy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGPUNKHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGPUNKHAT"
msgid "Aww, it's a hat that teaches nerds how to fight!"
msgstr "Ồ, hóa ra là một chiếc mũ dạy mọt sách cách đánh nhau!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGPUNK_BITS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGPUNK_BITS"
msgid "What am I supposed to do with that?"
msgstr "Tôi phải làm gì với cái này đây?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGPUNK_CAGEWALL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGPUNK_CAGEWALL"
msgid "Gives me claustrophobia."
msgstr "Làm tôi thấy ngột ngạt quá."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGPUNK_FLOOR_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGPUNK_FLOOR_KIT"
msgid "Why didn't he just find a bigger island?"
msgstr "Sao lão ta không tìm đại một hòn đảo lớn hơn chứ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGPUNK_LEVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGPUNK_LEVER"
msgid "Let's flip it already."
msgstr "Gạt cần luôn đi nào."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGPUNK_WORKSTATION
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGPUNK_WORKSTATION"
msgid "Electrical fires just aren't as fun."
msgstr "Chập điện cháy nổ chán chết."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_ITEM_1
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_ITEM_1"
msgid "Why does a glove give me the creeps? Burn it!"
msgstr "Sao cái găng tay này lại khiến tôi nổi da gà thế nhỉ? Đốt nó đi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_ITEM_2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_ITEM_2"
msgid "It doesn't make sense! Burn it!"
msgstr "Vô lý hết chỗ nói! Đốt nó đi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_MACHINERY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_MACHINERY"
msgid "Someone really should burn this scrap heap."
msgstr "Lẽ ra nên có ai đó đốt đống sắt vụn này đi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE"
msgid "Looks important. I'll burn it later."
msgstr "Trông có vẻ quan trọng. Lát nữa tôi đốt."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_NPC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_NPC"
msgid "Uuuugh, old people always seem to need help with something or other."
msgstr "Hự, người già lúc nào cũng cần người khác giúp cái này cái nọ."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_NPC_MUTATIONS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_NPC_MUTATIONS"
msgid "Now what?"
msgstr "Giờ sao nữa?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_NPC_WAGPUNK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_NPC_WAGPUNK"
msgid "That's right, old man. Move along."
msgstr "Đúng rồi đấy, ông già. Đi chỗ khác chơi đi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_TOOL_1
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_TOOL_1"
msgid "I've got a feeling this belongs to that old guy."
msgstr "Tôi có cảm giác cái này là của ông già đó."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_TOOL_2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_TOOL_2"
msgid "Ugh, couldn't that old guy have just gotten it himself?"
msgstr "Hừ, sao ông già đó không tự đi mà lấy chứ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_TOOL_3
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_TOOL_3"
msgid "Yeah, that looks like a Whaddayacallit! Or was it a Whatchamahoosit..."
msgstr "Ừ, nhìn giống cái Đồ-Cái-Thứ-Gì-Đó thật! Hoặc là cái Cái-Gì-Mà-Gọi-Là..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_TOOL_4
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_TOOL_4"
msgid "Welp, it doesn't seem to be flammable. Might as well give it to that old guy."
msgstr "Chà, trông có vẻ không bắt lửa cho lắm. Đem cho ông già đó luôn vậy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_TOOL_5
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAGSTAFF_TOOL_5"
msgid "Looks like some weird science junk. Maybe that's what the old guy's looking for?"
msgstr "Trông như đống rác khoa học quái dị nào đó. Chắc đây là thứ ông già đó đang tìm à?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALKINGPLANK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALKINGPLANK"
msgid "So, who are we gonna make walk it?"
msgstr "Thế, chúng ta sẽ bắt ai đi ván mộc đây?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALKINGPLANK_ANCIENT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALKINGPLANK_ANCIENT"
msgid "So, who are we gonna make walk it?"
msgstr "Thế, chúng ta sẽ bắt ai đi ván mộc đây?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALKINGPLANK_GRASS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALKINGPLANK_GRASS"
msgid "So, who are we gonna make walk it?"
msgstr "Thế, chúng ta sẽ bắt ai đi ván mộc đây?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALKINGPLANK_YOTD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALKINGPLANK_YOTD"
msgid "I'm not setting foot on that, no matter how good it looks!"
msgstr "Tôi không thèm đặt chân lên đó đâu, trông có đẹp mấy đi nữa cũng thế!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALKING_STICK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALKING_STICK"
msgid "That'll make a nice poker stick."
msgstr "Cái này dùng để chọc lò thì tuyệt."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_DREADSTONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_DREADSTONE"
msgid "Couldn't we have made walls out of literally anything else?"
msgstr "Không thể làm tường bằng thứ gì khác khả dĩ hơn được à?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_DREADSTONE_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_DREADSTONE_ITEM"
msgid "Uuuuugh, building is so much wooork..."
msgstr "Hựiii, xây dựng mệt mỏi quá đi..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_HAY.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_HAY.BURNT"
msgid "It was flammable!"
msgstr "Nó bắt lửa đấy chứ!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_HAY.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_HAY.GENERIC"
msgid "That looks so flammable!"
msgstr "Trông dễ bắt lửa thế không biết!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_HAY_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_HAY_ITEM"
msgid "Hmmm. I wonder if these will burn."
msgstr "Hừm. Không biết mấy cái này có cháy không nhỉ."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_MOONROCK"
msgid "Safe for now."
msgstr "Tạm thời an toàn rồi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_MOONROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_MOONROCK_ITEM"
msgid "I guess I could carry it."
msgstr "Chắc tôi vác nổi nó đấy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_RUINS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_RUINS"
msgid "And they'll huff and they'll puff!"
msgstr "Và chúng sẽ hì hục hộc tốc thổi bay!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_RUINS_2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_RUINS_2"
msgid "And they'll huff and they'll puff!"
msgstr "Và chúng sẽ hì hục hộc tốc thổi bay!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_RUINS_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_RUINS_ITEM"
msgid "Will those fit in my pockets?"
msgstr "Mấy thứ đó có vừa túi tôi không nhỉ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_SCRAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_SCRAP"
msgid "This looks like a fire hazard. Trust me."
msgstr "Trông có nguy cơ gây cháy đấy. Tin tôi đi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_SCRAP_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_SCRAP_ITEM"
msgid "This will be a fire hazard. Trust me."
msgstr "Cái này sẽ có nguy cơ gây cháy đấy. Tin tôi đi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_STONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_STONE"
msgid "Eh. I guess that's okay."
msgstr "Ờ. Tạm được."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_STONE_2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_STONE_2"
msgid "Eh. I guess that's okay."
msgstr "Ờ. Tạm được."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_STONE_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_STONE_ITEM"
msgid "These are surprisingly heavy."
msgstr "Mấy cục này nặng bất ngờ đấy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_WOOD.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_WOOD.BURNT"
msgid "It did catch on fire!"
msgstr "Nó bén lửa thật đấy!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_WOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_WOOD.GENERIC"
msgid "That could totally catch on fire."
msgstr "Cái đó hoàn toàn có thể bén lửa."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_WOOD_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALL_WOOD_ITEM"
msgid "I hate hiding."
msgstr "Tôi ghét trốn tránh lắm."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALRUS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALRUS"
msgid "Stop following me!"
msgstr "Đừng bám theo tôi nữa!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALRUSHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALRUSHAT"
msgid "I kind of like the look of it."
msgstr "Nhìn cũng hay ho phết."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALRUS_CAMP.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALRUS_CAMP.EMPTY"
msgid "I'm not going in there. Yuck!"
msgstr "Tôi không thèm bước vào đó đâu. Ghê quá!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALRUS_CAMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALRUS_CAMP.GENERIC"
msgid "Why does everyone have a nicer house than me?"
msgstr "Sao ai cũng có nhà đẹp hơn tôi thế nhỉ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALRUS_TUSK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALRUS_TUSK"
msgid "Nom nom nom."
msgstr "Húp húp húp."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALTER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALTER.ATTACKER"
msgid "That goody-goody finally snapped!"
msgstr "Tên ngoan hiền đó cuối cùng cũng nổi điên rồi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALTER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALTER.FIRESTARTER"
msgid "Who \"doesn't know fire safety\" NOW, %s?"
msgstr "Ai mới là kẻ \"không biết an toàn phòng cháy\" hả, %s?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALTER.GENERIC"
msgid "Hi %s!"
msgstr "Chào %s!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALTER.GHOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALTER.GHOST"
msgid "I think he's actually having fun."
msgstr "Tôi nghĩ cậu ta thực sự đang thấy vui đấy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALTER.MURDERER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALTER.MURDERER"
msgid "Hey %s, let's talk about this..."
msgstr "Này %s, chúng ta nói chuyện này chút đi..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALTER.REVIVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALTER.REVIVER"
msgid "Alright, I'm sorry for calling you a goody-goody."
msgstr "Rồi rồi, tôi xin lỗi vì đã gọi cậu là đồ ngoan hiền."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALTERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WALTERHAT"
msgid "Okay fine, so I wasn't \"in\" girl scouts so much as \"crashed\" girl scouts."
msgstr "Thôi được rồi, thực ra tôi không phải \"tham gia\" hướng đạo sinh mà là \"xâm nhập\" hướng đạo sinh."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WANDA.ATTACKER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WANDA.ATTACKER"
msgid "Hey, watch it!"
msgstr "Này, cẩn thận đấy!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WANDA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WANDA.FIRESTARTER"
msgid "Hey %s! Leave some kindling for me!"
msgstr "Này %s! Chừa lại chút củi lửa cho tôi với!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WANDA.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WANDA.GENERIC"
msgid "Hi %s!"
msgstr "Chào %s!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WANDA.GHOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WANDA.GHOST"
msgid "Uh... I'm guessing something went wrong."
msgstr "Ờ... Tôi đoán là có gì đó không ổn rồi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WANDA.MURDERER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WANDA.MURDERER"
msgid "Your future just went up in smoke, murderer!"
msgstr "Tương lai của cô vừa tan thành mây khói rồi đấy, kẻ sát nhân!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WANDA.REVIVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WANDA.REVIVER"
msgid "%s is always there when we need her."
msgstr "%s luôn xuất hiện bất cứ khi nào chúng ta cần."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WANDERINGTRADER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WANDERINGTRADER.GENERIC"
msgid "Weird."
msgstr "Lạ thật."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WANDERINGTRADER.REVEALED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WANDERINGTRADER.REVEALED"
msgid "Heard you take ashes?"
msgstr "Nghe nói anh thu nhận tro à?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARDROBE.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARDROBE.BURNING"
msgid "Yes! Burn!"
msgstr "Đúng rồi! Cháy đi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARDROBE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARDROBE.BURNT"
msgid "Aww, the fire burned out."
msgstr "Ối, lửa tắt mất tiêu rồi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARDROBE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARDROBE.GENERIC"
msgid "I want to set it on fire."
msgstr "Tôi muốn châm lửa đốt nó quá."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARG"
msgid "You're a big mean jerk!"
msgstr "Ngươi là một tên khốn xấu tính!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARGCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARGCORPSE.BURNING"
msgid "Who doesn't like a bonfire?"
msgstr "Ai mà không thích lửa trại chứ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARGCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARGCORPSE.GENERIC"
msgid "Ugh. I can't just leave that thing lying around."
msgstr "Hừ. Tôi không thể cứ vứt cái thứ này ở đây được."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARGCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARGCORPSE.REVIVING"
msgid "Oh come ON!!"
msgstr "Ôi thôi nào!!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARGLET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARGLET"
msgid "You big jerk!"
msgstr "Đồ khốn to xác!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARGSHRINE.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARGSHRINE.BURNING"
msgid "That's what we were supposed to do, right?"
msgstr "Đó là những gì chúng ta phải làm đúng không?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARGSHRINE.BURNT"
msgid "I may've misunderstood."
msgstr "Có lẽ tôi đã hiểu nhầm."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARGSHRINE.EMPTY"
msgid "It's missing something. Like fire."
msgstr "Nó đang thiếu thứ gì đó. Chẳng hạn như lửa."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARGSHRINE.GENERIC"
msgid "That looks WAY better!"
msgstr "Trông ĐẸP HƠN hẳn!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARLY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARLY.ATTACKER"
msgid "%s has been serving up knuckle sandwiches."
msgstr "%s vừa dọn món đấm bốc lên mâm kìa."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARLY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARLY.FIRESTARTER"
msgid "Haha, nice one, %s!!"
msgstr "Haha, được đấy, %s!!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARLY.GENERIC"
msgid "Hi %s!"
msgstr "Chào %s!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARLY.GHOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARLY.GHOST"
msgid "Did you mean to do that?"
msgstr "Cậu cố tình làm thế à?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARLY.MURDERER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARLY.MURDERER"
msgid "I'm gonna smoke you like a ham!"
msgstr "Tôi sẽ đem anh đi hun khói như giò heo luôn!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARLY.REVIVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WARLY.REVIVER"
msgid "%s would never leave anyone behind."
msgstr "%s không bao giờ bỏ rơi ai lại phía sau cả."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAR_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAR_BLUEPRINT"
msgid "Ooooh, looks dangerous!"
msgstr "Oooh, trông nguy hiểm phết!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WASPHIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WASPHIVE"
msgid "A cone full of jerks."
msgstr "Một cái tổ đầy lũ khốn."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERBALLOON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERBALLOON"
msgid "Boo! Hissss!"
msgstr "Xì! Đồ dở hơi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERINGCAN.EMPTY"
msgid "That's more like it."
msgstr "Thế mới vừa lòng chứ."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERINGCAN.GENERIC"
msgid "Ugh, who put this water here?!"
msgstr "Hừ, đứa nào đổ nước ở đây thế hả?!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERMELON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERMELON"
msgid "But where's the firemelon?"
msgstr "Nhưng dưa hấu lửa đâu rồi?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERMELONHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERMELONHAT"
msgid "Well, that's one use for this fruit."
msgstr "Chà, đó cũng là một cách dùng loại trái cây này."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERMELONICLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERMELONICLE"
msgid "Why would you freeze a fruit when you could burn it?"
msgstr "Sao lại đi đông lạnh trái cây trong khi bạn có thể đốt nó chứ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERMELON_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERMELON_COOKED"
msgid "I made my own firemelon."
msgstr "Tôi tự làm ra dưa hấu lửa của riêng mình rồi đây."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERMELON_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERMELON_OVERSIZED"
msgid "Ugh, way too much water!"
msgstr "Hừ, thừa nước quá mức!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERMELON_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERMELON_SEEDS"
msgid "I could grow them, but that sounds boring."
msgstr "Tôi có thể trồng chúng, nhưng nghe chán ngấy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERPLANT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERPLANT"
msgid "Just a big dumb flower."
msgstr "Chỉ là một bông hoa to ngốc nghếch."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERPLANT_BABY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERPLANT_BABY"
msgid "It's small now, but it'll get bigger."
msgstr "Giờ nó còn nhỏ, nhưng sẽ lớn lên thôi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERPLANT_BOMB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERPLANT_BOMB"
msgid "Okay, I'm sorry I called you dumb!"
msgstr "Được rồi, tôi xin lỗi vì đã gọi ngươi là đồ ngốc!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERPLANT_PLANTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERPLANT_PLANTER"
msgid "Do I really want to grow more of these things?"
msgstr "Tôi có thực sự muốn trồng thêm mấy thứ này nữa không?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERPUMP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERPUMP"
msgid "This thing's broken, it spouts water instead of fire!"
msgstr "Cái thứ này hỏng rồi, nó phun ra nước thay vì lửa!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERTREE_PILLAR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERTREE_PILLAR"
msgid "The bigger the tree, the more there is to burn."
msgstr "Cây càng lớn thì càng có nhiều thứ để đốt."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATERTREE_ROOT"
msgid "I bet it'll still burn."
msgstr "Tôi cá là nó vẫn cháy được."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATHGRITHR.ATTACKER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATHGRITHR.ATTACKER"
msgid "Take it down a notch, %s!"
msgstr "Bớt húng lại đi, %s!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATHGRITHR.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATHGRITHR.FIRESTARTER"
msgid "Yes, %s! Burn!!!"
msgstr "Đúng rồi, %s! Đốt đi nào!!!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATHGRITHR.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATHGRITHR.GENERIC"
msgid "Hi %s!"
msgstr "Chào %s!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATHGRITHR.GHOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATHGRITHR.GHOST"
msgid "Hey %s, I'll get you a heart if you let me wear your helm!"
msgstr "Này %s, tôi sẽ kiếm một trái tim cho cô nếu cô cho tôi đội mũ của cô nhé!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATHGRITHR.MURDERER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATHGRITHR.MURDERER"
msgid "Woahh! That's not an act! Murderer!"
msgstr "Ôi trời! Không phải diễn đâu đấy! Kẻ sát nhân!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATHGRITHR.REVIVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATHGRITHR.REVIVER"
msgid "%s doesn't let anyone fall in battle!"
msgstr "%s không để ai phải gục ngã trong trận chiến!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATHGRITHRHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATHGRITHRHAT"
msgid "It's got a name scratched on the inside... \"W\", uh..."
msgstr "Có khắc một cái tên ở mặt trong... Chữ \"W\", ừm..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATHGRITHR_IMPROVEDHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATHGRITHR_IMPROVEDHAT"
msgid "I don't think I could pull it off like she does."
msgstr "Tôi không nghĩ mình có thể đội đẹp như cô ấy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATHGRITHR_SHIELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WATHGRITHR_SHIELD"
msgid "If I know Wigfrid, she'll still find a way to use it as a weapon."
msgstr "Nếu tôi hiểu rõ Wigfrid, cô ấy thế nào cũng tìm ra cách dùng nó làm vũ khí."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAXED_PLANT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAXED_PLANT"
msgid "So it's just gonna stay that way forever?"
msgstr "Vậy là nó cứ giữ nguyên thế này mãi mãi à?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAXPAPER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAXPAPER"
msgid "Heh, we rubbed a bunch of paper in beeswax."
msgstr "Hừm, tụi mình vừa bôi sáp ong lên một đống giấy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAXWELL.ATTACKER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAXWELL.ATTACKER"
msgid "There's evil in you, huh %s?!"
msgstr "Trong người anh có tà khí đấy, ha %s?!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAXWELL.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAXWELL.FIRESTARTER"
msgid "Amateur."
msgstr "Nghiệp dư."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAXWELL.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAXWELL.GENERIC"
msgid "Hi %s!"
msgstr "Chào %s!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAXWELL.GHOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAXWELL.GHOST"
msgid "Have a heart, %s! Heh heh."
msgstr "Tỏ chút lòng thành đi chứ, %s! Hì hì."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAXWELL.MURDERER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAXWELL.MURDERER"
msgid "%s! I knew you couldn't be trusted! Burn!!"
msgstr "%s! Tôi biết ngay không thể tin tưởng anh được mà! Đốt đi!!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAXWELL.REVIVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAXWELL.REVIVER"
msgid "Hahaha %s, you care about us!"
msgstr "Hahaha %s, anh cũng quan tâm đến chúng tôi cơ à!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAXWELLJOURNAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WAXWELLJOURNAL.GENERIC"
msgid "Would make a great bedtime story... for nightmares!"
msgstr "Làm truyện kể trước khi ngủ thì tuyệt... cho những cơn ác mộng!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEBBER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEBBER.ATTACKER"
msgid "Hey %s, you're not venomous, are you?"
msgstr "Này %s, cậu không có độc đấy chứ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEBBER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEBBER.FIRESTARTER"
msgid "Your fires are so cute, %s!"
msgstr "Mấy ngọn lửa của cậu cưng thế nhỉ, %s!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEBBER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEBBER.GENERIC"
msgid "Hi %s!"
msgstr "Chào %s!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEBBER.GHOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEBBER.GHOST"
msgid "Don't cry, %s, I'm getting you a heart."
msgstr "Đừng khóc mà, %s, tôi đang kiếm tim cho cậu đây."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEBBER.MURDERER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEBBER.MURDERER"
msgid "Monster! Burn them!"
msgstr "Đồ quái vật! Đốt chúng đi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEBBER.REVIVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEBBER.REVIVER"
msgid "Who do ghosts call? %s!"
msgstr "Hồn ma gọi ai thế? %s!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEBBERSKULL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEBBERSKULL"
msgid "It's not myyy way, but a burial will have to do."
msgstr "Không phải cách của tôi, nhưng chôn cất tạm vậy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEBBER_SPIDER_MINION
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEBBER_SPIDER_MINION"
msgid "That spider's so tiny!"
msgstr "Con nhện đó bé xíu à!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEED_IVY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEED_IVY"
msgid "It's all spiny."
msgstr "Toàn gai là gai."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WENDY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WENDY.ATTACKER"
msgid "I've never seen you so, uh, passionate... %s."
msgstr "Tôi chưa từng thấy cậu... nhiệt huyết đến thế, %s."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WENDY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WENDY.FIRESTARTER"
msgid "%s! Was that your fire? I'm so proud!"
msgstr "%s! Đó là lửa của cô à? Tôi tự hào quá cơ!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WENDY.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WENDY.GENERIC"
msgid "Hi %s!"
msgstr "Chào %s!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WENDY.GHOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WENDY.GHOST"
msgid "Isn't death kind of your thing, %s?"
msgstr "Chẳng phải cái chết là sở trường của cô à, %s?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WENDY.MURDERER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WENDY.MURDERER"
msgid "She's gone nuts! Murderer!"
msgstr "Cô ta phát điên rồi! Kẻ sát nhân!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WENDY.REVIVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WENDY.REVIVER"
msgid "That girl really likes ghosts!"
msgstr "Cô bé đó khoái ma cỏ thật đấy!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WENDY_RESURRECTIONGRAVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WENDY_RESURRECTIONGRAVE"
msgid "Does it work if you've been cremated?"
msgstr "Bị hỏa táng rồi thì có tác dụng không nhỉ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEREITEM_BEAVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEREITEM_BEAVER"
msgid "He wouldn't mind if I use this for kindling, right?"
msgstr "Cậu ta không phiền nếu tôi dùng cái này làm củi chứ nhỉ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEREITEM_GOOSE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEREITEM_GOOSE"
msgid "Burn it. BURN. IT."
msgstr "Đốt nó đi. ĐỐT. NÓ. ĐI."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEREITEM_MOOSE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WEREITEM_MOOSE"
msgid "Yup, looks cursed alright."
msgstr "Ừm, trông bị nguyền rủa thật đấy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WES.ATTACKER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WES.ATTACKER"
msgid "That mime punch was really convincing! Haha, ow!"
msgstr "Cú đấm kịch câm đó thật thuyết phục! Haha, ối!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WES.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WES.FIRESTARTER"
msgid "Make it BURN!"
msgstr "Đốt trụi nó đi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WES.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WES.GENERIC"
msgid "Hi %s!"
msgstr "Chào %s!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WES.GHOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WES.GHOST"
msgid "Just tell me whatcha need and I'll get it for you. Heheh!"
msgstr "Cứ nói cần gì rồi tôi lấy cho. Heheh!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WES.MURDERER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WES.MURDERER"
msgid "Your actions speak louder than words! Murderer!"
msgstr "Hành động nói lên tất cả! Kẻ sát nhân!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WES.REVIVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WES.REVIVER"
msgid "Who do ghosts call? %s!"
msgstr "Hồn ma gọi ai thế? %s!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WETGOOP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WETGOOP"
msgid "How did it go wrong?! It was engulfed in fire and everything."
msgstr "Sao lại hỏng được cơ chứ?! Nó ngập trong lửa và đủ thứ cơ mà."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WETPAPER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WETPAPER"
msgid "I can think of a real quick way to dry it."
msgstr "Tôi nghĩ ra cách cực nhanh để làm khô nó rồi đấy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WETPOUCH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WETPOUCH"
msgid "There's something inside."
msgstr "Có cái gì đó bên trong kìa."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WHIP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WHIP"
msgid "This means I'm the boss now."
msgstr "Điều này có nghĩa là tôi là trùm ở đây rồi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WICKERBOTTOM.ATTACKER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WICKERBOTTOM.ATTACKER"
msgid "Your bun too tight, %s?"
msgstr "Búi tóc chật quá hay gì vậy, %s?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WICKERBOTTOM.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WICKERBOTTOM.FIRESTARTER"
msgid "Didn't know you had it in you, %s."
msgstr "Không ngờ bà cũng máu lửa thế đấy, %s."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WICKERBOTTOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WICKERBOTTOM.GENERIC"
msgid "Hi %s!"
msgstr "Chào %s!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WICKERBOTTOM.GHOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WICKERBOTTOM.GHOST"
msgid "Did your heart give out, %s? Just kidding! Hey!"
msgstr "Tim bà ngừng đập rồi à, %s? Đùa thôi! Này!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WICKERBOTTOM.MURDERER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WICKERBOTTOM.MURDERER"
msgid "Time for a good ol' book burnin'! Murderer!"
msgstr "Đến lúc đốt sách ăn mừng thôi! Kẻ sát nhân!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WICKERBOTTOM.REVIVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WICKERBOTTOM.REVIVER"
msgid "%s is a big softie!"
msgstr "%s đúng là một cục bông mềm mại!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILLOW.ATTACKER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILLOW.ATTACKER"
msgid "You're makin' us look nuts, %s!"
msgstr "Cậu đang làm tụi mình trông như lũ điên ấy, %s!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILLOW.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILLOW.FIRESTARTER"
msgid "Burny twins! High five."
msgstr "Cặp đôi sinh đôi hỏa hoạn! Đập tay nào."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILLOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILLOW.GENERIC"
msgid "Hey! That's my face, %s! Give it back!"
msgstr "Này! Đó là mặt tôi mà, %s! Trả lại đây!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILLOW.GHOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILLOW.GHOST"
msgid "Is that really what my ghost hair looks like?"
msgstr "Tóc ma của tôi trông thế này thật á?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILLOW.MURDERER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILLOW.MURDERER"
msgid "Murderer! Burn the impostor!"
msgstr "Kẻ sát nhân! Đốt kẻ mạo danh đi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILLOW.REVIVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILLOW.REVIVER"
msgid "Haha, nice one %s."
msgstr "Haha, được đấy %s."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILLOW_EMBER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILLOW_EMBER"
msgid "Aren't they beautiful?"
msgstr "Chúng đẹp tuyệt đúng không?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILSON.ATTACKER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILSON.ATTACKER"
msgid "Why, %s... that fire in your eyes!"
msgstr "Chà, %s... ngọn lửa trong mắt anh kìa!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILSON.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILSON.FIRESTARTER"
msgid "Oh, %s!! Let me help with your next fire!!"
msgstr "Ồ, %s!! Để tôi giúp đốt đống tiếp theo cho!!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILSON.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILSON.GENERIC"
msgid "Hi %s!"
msgstr "Chào %s!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILSON.GHOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILSON.GHOST"
msgid "I better get a heart for %s."
msgstr "Tôi tranh thủ kiếm trái tim cho %s mới được."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILSON.MURDERER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILSON.MURDERER"
msgid "Hey %s! Your hair is dumb! Raaaugh!"
msgstr "Này %s! Tóc cậu ngốc thật đấy! Raaaugh!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILSON.REVIVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WILSON.REVIVER"
msgid "%s won't leave anyone behind."
msgstr "%s sẽ không bỏ rơi ai lại phía sau đâu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WINCH.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WINCH.GENERIC"
msgid "It's only good for grabbing junk from the bottom of the ocean."
msgstr "Nó chỉ dùng để vớt rác dưới đáy đại dương thôi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WINCH.HOLDING_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WINCH.HOLDING_ITEM"
msgid "Unless it's something flammable, I'm not that interested."
msgstr "Trừ khi nó bắt lửa được, còn không thì tôi không có hứng."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WINCH.RETRIEVING_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WINCH.RETRIEVING_ITEM"
msgid "Come on alreadyyyy..."
msgstr "Nhanh lên nàooooo..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WINONA.ATTACKER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WINONA.ATTACKER"
msgid "Too rough, %s! Jeez!"
msgstr "Thô lỗ quá đấy, %s! Chúa ơi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WINONA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WINONA.FIRESTARTER"
msgid "Nice fire, %s!"
msgstr "Lửa đẹp đấy, %s!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WINONA.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WINONA.GENERIC"
msgid "Hi %s!"
msgstr "Chào %s!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WINONA.GHOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WINONA.GHOST"
msgid "A heart sure would come in handy!"
msgstr "Có một trái tim thì tiện biết mấy!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WINONA.MURDERER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WINONA.MURDERER"
msgid "Murderer! Now you burn!"
msgstr "Kẻ sát nhân! Giờ thì cô cháy đi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WINONA.REVIVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WINONA.REVIVER"
