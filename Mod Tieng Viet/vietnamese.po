msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "Safe from that frightening lightning!"
msgstr "Thoát khỏi tia sét đáng sợ đó rồi!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_LIGHTSOUT_SHADOWHAND
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_LIGHTSOUT_SHADOWHAND"
msgid "Wait a minute, what is that doing down here?"
msgstr "Khoan đã, cái đó làm gì ở dưới này thế nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_LOWRESEARCH"
msgid "I didn't learn very much from that."
msgstr "Tôi chẳng học được mấy từ cái đó."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_LUNARGUARDIAN_INCOMING
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_LUNARGUARDIAN_INCOMING"
msgid "It's back!"
msgstr "Nó quay lại rồi kìa!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_LUNARHAIL_BIRD_CORPSES
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_LUNARHAIL_BIRD_CORPSES"
