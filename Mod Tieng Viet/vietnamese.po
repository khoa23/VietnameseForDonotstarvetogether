msgstr "Hừ, đầu tôi đau quá!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_LIGHTFIRE.1
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_LIGHTFIRE.1"
