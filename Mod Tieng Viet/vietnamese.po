msgstr "Nó sẽ trông rất đẹp khi được đốt cháy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_SAPLING"
