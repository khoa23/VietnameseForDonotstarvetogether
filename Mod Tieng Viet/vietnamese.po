msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_LUNARPLANT_HUSK"
msgid "Only for leafy friend? Too small for Wolfgang muscles anyway."
msgstr "Chỉ dành cho người bạn lá cây thôi à? Dù sao thì cũng quá nhỏ so với cơ bắp của Wolfgang."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_SANITY"
