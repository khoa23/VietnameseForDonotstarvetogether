msgstr "Cậu Walter đó lại đang mưu tính gì thế nhỉ?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SLINGSHOT_BAND_PIGSKIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SLINGSHOT_BAND_PIGSKIN"
