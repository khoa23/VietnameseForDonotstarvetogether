#. STRINGS.SKIN_DESCRIPTIONS.firesuppressor_circus
msgctxt "STRINGS.SKIN_DESCRIPTIONS.firesuppressor_circus"
msgid "Look and be amazed by the incredible automatic snowball juggling machine!"
msgstr "Hãy chiêm ngưỡng và kinh ngạc trước cỗ máy tung hứng quả cầu tuyết tự động đáng kinh ngạc!"

#. STRINGS.SKIN_DESCRIPTIONS.firesuppressor_robot
msgctxt "STRINGS.SKIN_DESCRIPTIONS.firesuppressor_robot"
msgid "Fires never had a chance."
msgstr "Lửa không bao giờ có cơ hội."

#. STRINGS.SKIN_DESCRIPTIONS.fishbox_nautical
msgctxt "STRINGS.SKIN_DESCRIPTIONS.fishbox_nautical"
msgid "Fit for only the finest fish."
msgstr "Chỉ dành cho những chú cá cao cấp nhất."

#. STRINGS.SKIN_DESCRIPTIONS.fishbox_pirate
msgctxt "STRINGS.SKIN_DESCRIPTIONS.fishbox_pirate"
msgid "The perfect hiding spot for fishy cargo."
msgstr "Nơi trú ẩn hoàn hảo cho hàng hóa đáng ngờ."

#. STRINGS.SKIN_DESCRIPTIONS.fishingrod_block
msgctxt "STRINGS.SKIN_DESCRIPTIONS.fishingrod_block"
msgid "If one could only articulate how great this rod is."
msgstr "Ước gì ai đó có thể diễn tả được cần câu này tuyệt vời đến thế nào."

#. STRINGS.SKIN_DESCRIPTIONS.fishingrod_curl
msgctxt "STRINGS.SKIN_DESCRIPTIONS.fishingrod_curl"
msgid "Cast your line off the arbor but watch out for knots."
msgstr "Quăng dây ra khỏi giàn hoa nhưng hãy cẩn thận kẻo bị thắt nút."

#. STRINGS.SKIN_DESCRIPTIONS.fishingrod_sword
msgctxt "STRINGS.SKIN_DESCRIPTIONS.fishingrod_sword"
msgid "Challenge the fish to a duel."
msgstr "Thách đấu với lũ cá một trận."

#. STRINGS.SKIN_DESCRIPTIONS.flotationcushion_cawnival
msgctxt "STRINGS.SKIN_DESCRIPTIONS.flotationcushion_cawnival"
msgid "Take the festivities to the open water - comfortably afloat."
msgstr "Mang lễ hội ra vùng nước mở - nổi bồng bềnh một cách thoải mái."

#. STRINGS.SKIN_DESCRIPTIONS.flowerhat_crown
msgctxt "STRINGS.SKIN_DESCRIPTIONS.flowerhat_crown"
msgid "This feather hat is so luxurious to the touch!"
msgstr "Chiếc mũ lông chim này chạm vào vô cùng sang trọng!"

#. STRINGS.SKIN_DESCRIPTIONS.flowerhat_healing
msgctxt "STRINGS.SKIN_DESCRIPTIONS.flowerhat_healing"
msgid "This lovely wreath of Life Blossoms have lost their magic, but they still look divine."
msgstr "Vòng hoa Mầm Sống đáng yêu này đã mất đi phép thuật, nhưng chúng trông vẫn thật tuyệt diệu."

#. STRINGS.SKIN_DESCRIPTIONS.flowerhat_holly_wreath
msgctxt "STRINGS.SKIN_DESCRIPTIONS.flowerhat_holly_wreath"
msgid "A jolly holly laurel to wear on your head. How winter-y!"
