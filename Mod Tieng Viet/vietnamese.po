msgstr "Không nhận ra tranh vẽ cái gì nữa."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "In picture darkness covers sad, weak people."
msgstr "Trong tranh, bóng đêm đang bao phủ những con người yếu đuối, khốn khổ."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
