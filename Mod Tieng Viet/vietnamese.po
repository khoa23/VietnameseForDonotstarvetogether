msgstr "Sao tôi vẫn còn ở đây nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HIGHRESEARCH"
msgid "I feel so smart now!"
msgstr "Giờ tôi thấy mình thông minh quá cơ!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HOT"
msgid "Need... ice... or... shade!"
msgstr "Cần... đá... hoặc... bóng râm!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HOUNDS"
msgid "Did you hear that?"
msgstr "Cậu có nghe thấy gì không?"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HUNGRY"
msgid "I'm so hungry!"
msgstr "Tôi đói quá!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HUNGRY_FASTBUILD.1
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HUNGRY_FASTBUILD.1"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HUNGRY_SLOWBUILD.1
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HUNGRY_SLOWBUILD.1"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HUNT_AVOID_FORK
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HUNT_AVOID_FORK"
msgid "This trail looks safer."
msgstr "Lối này trông an toàn hơn."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "This track is fresh. The beast must be nearby."
msgstr "Dấu vết này còn mới. Con quái vật chắc ở quanh đây thôi."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "The beast's trail ends here."
msgstr "Dấu vết của con quái vật kết thúc ở đây."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "This wet soil can't hold a footprint."
msgstr "Đất ẩm thế này không giữ được dấu chân đâu."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HUNT_START_FORK
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HUNT_START_FORK"
msgid "This trail looks dangerous."
msgstr "Lối này trông nguy hiểm đấy."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HUNT_SUCCESSFUL_FORK
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HUNT_SUCCESSFUL_FORK"
msgid "No beast is a match for my wits!"
msgstr "Không con quái vật nào địch lại sự thông minh của tôi được đâu!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HUNT_WRONG_FORK
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_HUNT_WRONG_FORK"
msgid "I get the feeling that something is watching me."
msgstr "Tôi có cảm giác như có ai đó đang theo dõi mình."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "Are you still hungry, plant?"
msgstr "Cây ơi, mày vẫn đói à?"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_INV_FULL"
msgid "I can't carry any more stuff!"
msgstr "Tôi không thể mang thêm món đồ nào nữa rồi!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_IS_FEASTING"
msgid "Happy Winter's Feast!"
msgstr "Chúc mừng Đại Tiệc Mùa Đông!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KILLEDPLANT.1
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KILLEDPLANT.1"
msgid "only_used_by_wormwood"
msgstr "chỉ_được_sử_dụng_bởi_wormwood"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KINGCREATED
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_KINGCREATED"
