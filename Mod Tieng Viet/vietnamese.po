msgstr "Một nhạc cụ được chế tạo rất tốt."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PAPYRUS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PAPYRUS"
msgid "We could do our homework."
msgstr "Chúng ta có thể làm bài tập về nhà rồi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PAVLOVA
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PAVLOVA"
msgid "We love anything with sugar!"
msgstr "Bọn mình thích bất cứ thứ gì có đường!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PEGHOOK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PEGHOOK"
msgid "Wouldn't you rather be bug friends with us?"
msgstr "Các cậu không muốn làm bạn côn trùng với bọn mình sao?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PENGUIN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PENGUIN"
msgid "Where do they live the rest of the year?"
msgstr "Phần thời gian còn lại trong năm chúng sống ở đâu nhỉ?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PENGUINCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PENGUINCORPSE.BURNING"
msgid "Mmm."
msgstr "Măm măm."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PENGUINCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PENGUINCORPSE.GENERIC"
msgid "It's dead, we think?"
msgstr "Nó chết rồi, tụi mình nghĩ vậy?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PENGUINCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PENGUINCORPSE.REVIVING"
