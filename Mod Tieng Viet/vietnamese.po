msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.BURNT"
msgid "That's a right shame."
msgstr "Đúng là đáng xấu hổ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.GENERIC"
msgid "Looks like Winona's work."
msgstr "Có vẻ như tác phẩm của Winona."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER"
msgid "Just aboot dead."
msgstr "Chỉ cần khởi động chết."

