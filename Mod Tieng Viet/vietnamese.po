msgstr "Hóa ra đó là tiếng kêu của một đàn quạ."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_LUNAR_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_LUNAR_RIFT_MAX"
msgid "That flash! Was that moonlight?"
msgstr "Ánh chớp đó! Có phải ánh trăng không nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Hm, I suppose it makes sense I can only have a pair of these."
msgstr "Hừm, chắc là hợp lý khi tôi chỉ có thể sở hữu một cặp thế này thôi."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MEGA_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MEGA_FLARE_SEEN"
msgid "That flash is gonna bring trouble."
msgstr "Ánh chớp đó thế nào cũng mang rắc rối đến cho xem."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MIGHTYTONORMAL
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MIGHTYTONORMAL"
msgid "only_used_by_wolfang"
msgstr "chỉ_được_sử_dụng_bởi_wolfang"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MITEGLAND_DEBUFF.1
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MITEGLAND_DEBUFF.1"
