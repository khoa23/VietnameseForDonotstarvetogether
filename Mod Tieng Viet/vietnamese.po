msgid "Note to self: no more experiments with Fire Nettle toxin."
msgstr "Ghi nhớ: không thử nghiệm với độc tố Tầm Ma Lửa nữa."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_FLARE_SEEN"
msgid "I wonder who set that flare?"
msgstr "Không biết ai đã bắn pháo sáng thế nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_FLOATER_HELD
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_FLOATER_HELD"
msgid "I was busy drowning but something came up... me!"
msgstr "Tôi suýt chết đuối nhưng có cái gì đó nổi lên... chính là tôi!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_FLOATER_LETGO
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_FLOATER_LETGO"
msgid "I hate being kept in susp-"
msgstr "Tôi ghét bị để cho hồi hộp..."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_FLOAT_SWIM_TIRED
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_FLOAT_SWIM_TIRED"
msgid "I'm too tired."
msgstr "Tôi mệt lắm rồi."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_FOODMEMORY
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_FOODMEMORY"
msgid "only_used_by_warly"
msgstr "chỉ_được_sử_dụng_bởi_warly"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_FREEDOM"
msgid "I'm free! I'm finally free!"
msgstr "Tôi được tự do rồi! Cuối cùng cũng được tự do!"

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_GATHER_MERM
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_GATHER_MERM"
msgid "Must be a merm thing."
msgstr "Chắc lại là chuyện của Người Cá thôi."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_GHOSTDRAIN"
