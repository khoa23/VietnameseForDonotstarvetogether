msgstr "Trông đây là một chỗ tốt đấy chứ, non?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_SEWINGMACHINE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_SEWINGMACHINE"
msgid "Now to find the recipe for a tasteful outfit."
msgstr "Giờ thì đi tìm công thức cho một bộ trang phục có gu thôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_SEWINGMACHINE_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_SEWINGMACHINE_ITEM"
