msgstr "Quá đáng sợ!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATED_PENGUIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATED_PENGUIN.SLEEPING"
