msgstr "Là bức tranh vẽ những con người yếu đuối, đau khổ."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
