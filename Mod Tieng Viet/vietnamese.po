msgstr "Tụi mình vẫn luôn muốn có một chiếc áo choàng!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_VEST_C
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_VEST_C"
