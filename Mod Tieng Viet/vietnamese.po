msgstr "Ta có thể... giúp dựng hội chợ không?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC"
msgid "It wants something first... something shiny."
msgstr "Nó muốn một thứ trước đã... một thứ lấp lánh."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING"
msgid "Oh... I think I'm doing... well?"
msgstr "Ồ... Ta nghĩ mình đang chơi... khá ổn nhỉ?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_BALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_BALL"
msgid "Won't you play with me, Abigail?"
msgstr "Cậu không muốn chơi cùng tớ sao, Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_CROWKID
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_CROWKID"
msgid "A murder has flown in."
msgstr "Một đàn quạ vừa bay đến."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_GAMETOKEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_GAMETOKEN"
msgid "It gleams in the light."
msgstr "Nó lấp lánh dưới ánh sáng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_HOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_HOST"
msgid "How do you do, Mr. Raven?"
msgstr "Dạo này ngài thế nào rồi, Ngài Quạ?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
msgid "Abigail thinks it needs some decorations around it."
msgstr "Abigail nghĩ nơi này cần vài món trang trí xung quanh."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
msgid "The ravens seem quite drawn to the decorations."
msgstr "Lũ quạ có vẻ rất bị thu hút bởi mấy món trang trí."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3"
msgid "It does look quite pretty, doesn't it?"
msgstr "Trông cũng khá xinh xắn đấy chứ, phải không?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA_KIT"
msgid "Perhaps I might enjoy its shade one day."
msgstr "Biết đâu có ngày ta sẽ tận hưởng bóng mát của nó."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC"
msgid "Maybe I'll just take a peek..."
msgstr "Có khi ta chỉ liếc nhìn một chút thôi..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT"
msgid "I wonder what kind of prizes they have..."
msgstr "Không biết họ có những phần thưởng gì nhỉ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC"
msgid "I... won something?"
msgstr "Ta... vừa thắng được gì sao?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK"
msgid "M-maybe I'll take a look at the prizes...!"
msgstr "C-có lẽ ta sẽ nghía qua mấy món quà thưởng xem sao...!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
msgid "I've collected quite a few now."
msgstr "Bây giờ ta sưu tầm được khá nhiều rồi đấy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_SEEDPACKET"
msgid "It tastes like disappointment."
msgstr "Nó có vị như sự thất vọng vậy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_VEST_A
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_VEST_A"
msgid "I wish you could try it on Abigail, I think it would suit you."
msgstr "Ước gì cậu có thể mặc thử nó, Abigail, tớ nghĩ nó sẽ rất hợp với cậu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_VEST_B
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_VEST_B"
msgid "I find a curious comfort in the sound of dead, rustling leaves."
msgstr "Ta tìm thấy một sự an ủi kỳ lạ trong tiếng lá khô xào xạc."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_VEST_C
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_VEST_C"
msgid "Perhaps I could join the ravens and fly far, far away..."
msgstr "Biết đâu ta có thể nhập bọn với lũ quạ và bay thật xa, thật xa..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARPENTRY_BLADE_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARPENTRY_BLADE_MOONGLASS"
msgid "Pretty. If it was smaller I'd wear it around my neck."
msgstr "Xinh thật. Nếu nó nhỏ hơn chút nữa thì ta đã đeo quanh cổ rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARPENTRY_STATION.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARPENTRY_STATION.BURNT"
msgid "...Perhaps not."
msgstr "...Chắc là không hợp đâu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARPENTRY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARPENTRY_STATION.GENERIC"
msgid "Perhaps I could make something nice."
msgstr "Biết đâu ta có thể làm được thứ gì đó hay ho."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.DEAD"
msgid "It is no more."
msgstr "Nó không còn nữa rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.GENERIC"
msgid "I despise how it skitters..."
msgstr "Ta ghét cái cách nó chạy lăng xăng..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.HELD"
msgid "Freedom is not for you."
msgstr "Tự do không dành cho ngươi đâu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.SLEEPING"
msgid "It is arrested by deepest sleep."
msgstr "Nó bị giam cầm trong giấc ngủ sâu thẳm nhất."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT_GHOSTRACER"
msgid "It's merely a shade."
msgstr "Nó chỉ là một cái bóng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT"
msgid "It's a carrot."
msgstr "Đó là một củ cà rốt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_COOKED"
msgid "It's a carrot that's gone through a gauntlet of fire."
msgstr "Đó là một củ cà rốt đã trải qua thử thách lửa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_OVERSIZED"
msgid "A clump of giant, gnarled roots for eating."
msgstr "Một búi rễ khổng lồ, sần sùi để ăn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_PLANTED"
msgid "It's a carrot that's in the ground."
msgstr "Đó là một củ cà rốt nằm dưới đất."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_SEEDS"
msgid "It's a plant that's waiting to be."
msgstr "Đó là một thực vật đang chờ được sinh trưởng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "Well, old maps always do look burnt at the edges..."
msgstr "Chà, mấy tấm bản đồ cũ lúc nào chả trông như bị cháy xém ở rìa..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "No more mapmaking, then."
msgstr "Vậy là hết vẽ bản đồ rồi nhé."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "Maps are best with monsters drawn on the borders."
msgstr "Bản đồ tuyệt nhất là khi có vẽ quái vật ở viền xung quanh."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOON"
msgid "I wonder if it had a twin, too."
msgstr "Ta tự hỏi liệu nó có một người sinh đôi không nhỉ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOONDEN.EMPTY"
msgid "All cats must die."
msgstr "Mọi con mèo rồi cũng phải chết."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOONDEN.GENERIC"
msgid "I could curl up and die in there."
msgstr "Ta có thể cuộn mình và chết trong đó."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOONHAT"
msgid "Nothing like the stench of death on your head."
msgstr "Không gì tuyệt bằng việc đội một thứ nồng nặc mùi tử khí lên đầu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CATTOY_MOUSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CATTOY_MOUSE"
msgid "The wheel is come full circle."
msgstr "Vòng luân hồi đã khép lại."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "Call me Sisyphus."
msgstr "Hãy gọi ta là Sisyphus đi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "So close, yet so far away."
msgstr "Gần ngay trước mắt, mà sao xa xôi quá."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA"
msgid "The peels look dangerous."
msgstr "Mấy vỏ chuối trông nguy hiểm đấy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA_BURNT"
msgid "The death and suffering never ends."
msgstr "Cái chết và sự thống khổ không bao giờ chấm dứt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Warmed banana mush is so much better."
msgstr "Chuối nghiền ấm nóng ngon hơn nhiều."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA_TREE"
msgid "Poor plant, locked away from the sun."
msgstr "Tội nghiệp thực vật, bị giam cầm cách biệt với ánh mặt trời."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE"
msgid "Someone is trying to keep the underground at bay."
msgstr "Ai đó đang cố ngăn chặn thế giới ngầm trỗi dậy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "There's no room at the cave party for me..."
msgstr "Chẳng còn chỗ cho ta ở bữa tiệc hang động đó đâu..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "I'm too busy descending into madness to descend that cave."
msgstr "Ta còn bận phát điên nên chẳng có thời gian đi xuống cái hang đó đâu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "A great evil lurks beneath the surface."
msgstr "Một thế lực tà ác vĩ đại đang ẩn nấp bên dưới bề mặt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "Someone is trying to keep the underground at bay."
msgstr "Ai đó đang cố ngăn chặn thế giới ngầm trỗi dậy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_EXIT.FULL"
msgid "Oh... I guess I'm not invited to the surface party..."
msgstr "Ồ... Ta đoán mình không được mời đến bữa tiệc trên mặt đất rồi..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "Why leave? The light here compliments my complexion."
msgstr "Rời đi làm gì? Ánh sáng ở đây rất tôn lên làn da của ta."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_EXIT.OPEN"
msgid "The surface beckons."
msgstr "Mặt đất đang vẫy gọi kìa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_FERN"
msgid "A touch of color in the bleakness."
msgstr "Một chút sắc màu giữa chốn hiu hắt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_FERN_WITHERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_FERN_WITHERED"
msgid "It's dead."
msgstr "Nó chết rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.DEAD"
msgid "It's dead."
msgstr "Nó chết rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.GENERIC"
msgid "Has it ever been above ground?"
msgstr "Nó đã từng xuất hiện trên mặt đất bao giờ chưa nhỉ?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.SLEEPING"
msgid "It's asleep."
msgstr "Nó đang ngủ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.VENTING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.VENTING"
msgid "It smells terrible."
msgstr "Nó hôi khủng khiếp."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.GAS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.GAS"
msgid "That's unpleasant."
msgstr "Thật khó chịu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.GENERIC"
msgid "There's nothing coming out... for now."
msgstr "Không có gì thoát ra cả... tạm thời là thế."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.HOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.HOT"
msgid "I prefer the cold's quiet embrace."
msgstr "Tôi thích cái ôm tĩnh lặng của giá lạnh hơn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.MIASMA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.MIASMA"
msgid "One could drown in that black fog."
msgstr "Người ta có thể chết đuối trong làn sương đen đó."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CEILING_ROPE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CEILING_ROPE"
msgid "A way out."
msgstr "Một lối thoát."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CEVICHE"
msgid "All I taste is my sadness..."
msgstr "Tất cả những gì tôi nếm được là nỗi buồn của mình..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARCOAL"
msgid "Cold, dead and black, just like my heart."
msgstr "Lạnh lẽo, đã chết và đen đúa, y như trái tim tôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIERESIDUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIERESIDUE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIEROSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIEROSE"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_HAND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_HAND"
msgid "Do I dare approach?"
msgstr "Tôi có dám lại gần không?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_HECKLER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_HECKLER"
msgid "Their words can't hurt me. Well, maybe just a little..."
msgstr "Lời nói của họ không thể làm tổn thương tôi đâu. Ờ thì, chắc chỉ hơi chút thôi..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_LECTURN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_LECTURN"
msgid "Perhaps there is a small part for me to play."
msgstr "Có lẽ tôi cũng có một vai nhỏ để diễn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_NPC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_NPC"
msgid "Are you the true face of the darkness?"
msgstr "Ngươi có phải là gương mặt thật của bóng đêm không?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_STAGE_POST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_STAGE_POST"
msgid "The perfect place for a tragedy."
msgstr "Nơi hoàn hảo cho một vở bi kịch."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSJUNK1"
msgid "Cold, dead artificial life."
msgstr "Sự sống nhân tạo lạnh lẽo, vô tri."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSJUNK2"
msgid "Cold, dead artificial life."
msgstr "Sự sống nhân tạo lạnh lẽo, vô tri."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSJUNK3"
msgid "Cold, dead artificial life."
msgstr "Sự sống nhân tạo lạnh lẽo, vô tri."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "Why did we sculpt an anchor."
msgstr "Sao chúng ta lại đi tạc một cái dây neo cơ chứ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ANTLION"
msgid "Still and lifeless."
msgstr "Bất động và vô hồn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEARGER"
msgid "Ashes to ashes, bust to bust. Oh."
msgstr "Tro hoàn tro, bụi hoàn bụi. Ồ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEARGER_MUTATED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEARGER_MUTATED"
msgid "Its new lease on life was, well, short-lived."
msgstr "Mệnh lệnh thứ hai cho sự sống này thật là... ngắn ngủi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEEFALO"
msgid "Merely a cold, lifeless copy."
msgstr "Chỉ là một bản sao lạnh lẽo, vô tri."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "She once had a sweet life."
msgstr "Cô ấy từng có một cuộc đời ngọt ngào."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "A piece, constrained to the board."
msgstr "Một quân cờ, bị kìm hẹp trên bàn cờ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "They're here."
msgstr "Họ đến rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "But a simulacrum of life. Sigh."
msgstr "Chỉ là một ảo ảnh của sự sống. Haizz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CARRAT"
msgid "If only I could feel so serene."
msgstr "Phải chi tôi cũng có thể cảm thấy thanh thản như vậy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CATCOON"
msgid "A reminder of brighter days."
msgstr "Một lời nhắc nhở về những ngày tươi đẹp hơn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "Happiness is a warm puppy... but this one is cold."
msgstr "Hạnh phúc là một chú cún ấm áp... nhưng con này thì lạnh ngắt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "It knows only fury."
msgstr "Nó chỉ biết đến sự cuồng nộ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CRABKING"
msgid "We put him out of his misery."
msgstr "Chúng ta đã chấm dứt sự khốn khổ của hắn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "A reminder that kindness only leads to pain."
msgstr "Lời nhắc nhở rằng lòng tốt chỉ mang lại đau khổ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DAYWALKER2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DAYWALKER2"
msgid "His pain led to anger."
msgstr "Nỗi đau của hắn dẫn đến sự phẫn nộ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "What a terrible beast."
msgstr "Thật là một con quái vật khủng khiếp."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "The beast came back even colder than before."
msgstr "Con quái vật quay lại còn lạnh lùng hơn trước."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DEPTHWORM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DEPTHWORM"
msgid "How curious, the things we choose to commemorate."
msgstr "Thật tò mò, những thứ mà chúng ta chọn để tưởng niệm."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "She now lies, cold as stone."
msgstr "Giờ cô ấy nằm đó, lạnh giá như đá."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "Its stony gaze will glare for eternity."
msgstr "Ánh nhìn bằng đá của nó sẽ trừng trừng đến vạn kiếp."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_FORMAL"
msgid "Alas, the king is but a figurehead, at best."
msgstr "Than ôi, nhà vua suy cho cùng cũng chỉ là kẻ bù nhìn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "It won't be looking down on us anymore."
msgstr "Nó sẽ không còn nhìn xuống chúng ta nữa đâu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "A cold mockery."
msgstr "Một sự chế giễu lạnh lẽo."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KITCOON"
msgid "Hubris, undoubtedly."
msgstr "Kiêu ngạo làm sao, chắc chắn là vậy rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KLAUS"
msgid "No more life in this festive spirit."
msgstr "Không còn sự sống nào trong tinh thần lễ hội này nữa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "Oh, if I could ride away into the night."
msgstr "Ồ, giá mà tôi có thể phi ngựa vào màn đêm."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "They're here."
msgstr "Họ đến rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "No more will she soar over the gloomy shoals."
msgstr "Sẽ không còn cảnh cô ấy bay lượn trên những bãi cạn ảm đạm nữa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "A fleeting moment of joy, captured in stone."
msgstr "Một khoảnh khắc vui vẻ thoáng qua, được lưu giữ trong đá."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "A testament to a lifetime spent alone in the dark."
msgstr "Minh chứng cho cả đời cô độc trong bóng tối."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MOON"
msgid "I'd prefer to look at this over the real thing."
msgstr "Tôi thà nhìn cái này còn hơn là nhìn mặt trăng thật."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "Such expression in her eyes."
msgstr "Biết bao cảm xúc trong đôi mắt cô ấy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MUSE"
msgid "She holds the true power, here."
msgstr "Cô ấy nắm giữ sức mạnh thực sự ở đây."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_PAWN"
msgid "We are all but pawns in this game called \"life\"."
msgstr "Tất cả chúng ta chỉ là những con tốt trong trò chơi mang tên \"cuộc đời\" này."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_PIPE"
msgid "A bubble, frozen in time, can never pop."
msgstr "Một bóng nước, đông cứng trong thời gian, sẽ chẳng bao giờ vỡ tung."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "A mere minion to something greater."
msgstr "Chỉ là một tay sai cho thứ gì đó lớn lao hơn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "They're here."
msgstr "Họ đến rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_SHARKBOI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_SHARKBOI"
msgid "Their cold shark heart was just misunderstood."
msgstr "Trái tim cá mập lạnh lùng của chúng chỉ bị hiểu lầm thôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_STALKER"
msgid "Dark and cold, like my soul."
msgstr "Tăm tối và lạnh lẽo, giống như linh hồn tôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "A monument to fungal decay."
msgstr "Một đài tưởng niệm cho sự mục nát của nấm mốc."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "I still remember watching the light leave their eyes."
msgstr "Tôi vẫn nhớ khoảnh khắc nhìn ánh sáng vụt tắt trong đôi mắt chúng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD"
msgid "There's no life in this small sentry."
msgstr "Không có sự sống nào trong tên lính canh nhỏ bé này."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR"
msgid "This doesn't capture its pain."
msgstr "Điều này không thể hiện hết nỗi đau của nó."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT"
msgid "It was built to bring death."
msgstr "Nó được chế tạo để mang lại cái chết."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "Why was it able to come back? It's not fair..."
msgstr "Tại sao nó lại có thể quay lại được chứ? Thật không công bằng..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WORMBOSS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WORMBOSS"
msgid "It consumed to fill its endless void."
msgstr "Nó ăn ngấu nghiến để lấp đầy khoảng không vô tận của mình."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_YOTD"
msgid "If only I could have a new start."
msgstr "Giá mà tôi có thể có một khởi đầu mới."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_YOTH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_YOTH"
msgid "Not quite the fairy tale version."
msgstr "Không hẳn là phiên bản truyện cổ tích."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_YOTS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_YOTS"
msgid "How curious, the things we choose to commemorate."
msgstr "Thật tò mò, những thứ mà chúng ta chọn để tưởng niệm."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTER"
msgid "A fuzzy ball of emptiness."
msgstr "Một cục bông xù đầy sự trống rỗng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "It's looking into my soul."
msgstr "Nó đang nhìn thấu linh hồn tôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "Not so much sleeping as... waiting."
msgstr "Không hẳn là ngủ mà là... chờ đợi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "It will make the emptiness in my chest grow even bigger..."
msgstr "Nó sẽ làm cho sự trống rỗng trong lồng ngực tôi càng lớn hơn..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHEST_MIMIC_REVEALED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHEST_MIMIC_REVEALED"
msgid "I did not expect that."
msgstr "Tôi không ngờ tới điều đó."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHUM"
msgid "I had a pet fish once... it didn't last very long."
msgstr "Tôi từng có một con cá cưng... nó chẳng sống được bao lâu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYHOUND.GENERIC"
msgid "My, what big teeth you have."
msgstr "Ồ, cậu có hàm răng mới to lớn làm sao."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYHOUND.STATUE"
msgid "Naught but a pithy imitation of life."
msgstr "Chẳng qua chỉ là một sự bắt chước thảm hại của sự sống."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYWARG.GENERIC"
msgid "To perish now would save me much sorrow."
msgstr "Bỏ mạng lúc này sẽ cứu tôi khỏi vô vàn đau khổ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYWARG.STATUE"
msgid "There is no life in its eyes."
msgstr "Không có sự sống nào trong đôi mắt của nó."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.EMBERS"
msgid "Darkness is looming."
msgstr "Bóng đêm đang cận kề."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.GENERIC"
msgid "I might survive this night!"
msgstr "Tôi có thể sống sót qua đêm nay!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.HIGH"
msgid "A vision of a frozen-over Hell!"
msgstr "Tầm nhìn về một Địa Ngục đóng băng!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.LOW"
msgid "The gloom encroaches."
msgstr "Sự ảm đạm đang lan rộng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.NORMAL"
msgid "It's a weird fire."
msgstr "Đó là một ngọn lửa kì lạ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.OUT"
msgid "That is not a good sign."
msgstr "Đó không phải là một bảng hiệu tốt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "Darkness is looming."
msgstr "Bóng đêm đang cận kề."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "I might survive this night!"
msgstr "Tôi có thể sống sót qua đêm nay!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.HIGH"
msgid "A vision of a frozen-over Hell!"
msgstr "Tầm nhìn về một Địa Ngục đóng băng!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.LOW"
msgid "The gloom encroaches."
msgstr "Sự ảm đạm đang lan rộng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "It's a weird fire."
msgstr "Đó là một ngọn lửa kì lạ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.OUT"
msgid "That is not a good sign."
msgstr "Đó không phải là một bảng hiệu tốt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLLAPSEDCHEST"
msgid "Is the emptyness all around us now?"
msgstr "Sự trống rỗng giờ đang bao trùm lấy chúng ta sao?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.E"
msgid "East."
msgstr "Hướng Đông."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.GENERIC"
msgid "I am directionless."
msgstr "Tôi đã mất phương hướng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.N"
msgid "North."
msgstr "Hướng Bắc."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.NE"
msgid "Northeast."
msgstr "Đông Bắc."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.NW"
msgid "Northwest."
msgstr "Tây Bắc."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.S"
msgid "North. No wait, South."
msgstr "Hướng Bắc. À không, Nam."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.SE"
msgid "Southeast."
msgstr "Đông Nam."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.SW"
msgid "Southwest."
msgstr "Tây Nam."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.W"
msgid "West."
msgstr "Hướng Tây."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOST"
msgid "Rot and decay."
msgstr "Đồ thối và mục nát."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "I suppose this will do well enough."
msgstr "Tôi đoán thế này là đủ dùng rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "Ashes to ashes."
msgstr "Tro hoàn tro."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "Dry and brittle."
msgstr "Khô khốc và giòn tan."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "Food for worms."
msgstr "Thức ăn cho giun."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.WET"
msgid "It's far too watery, the poor plants might drown."
msgstr "Nó quá nhiều nước, mấy cái cây tội nghiệp có thể bị ngập chết mất."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTWRAP"
msgid "It's poop. Sigh."
msgstr "Đó là phân. Haizz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CONSTRUCTION_PLANS"
msgid "Shall I even bother building this?"
msgstr "Tôi có nên bận tâm xây cái này không nhỉ?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKBOOK"
msgid "What's the point of filling my stomach when my heart remains empty..."
msgstr "Ý nghĩa gì của việc làm đầy dạ dày khi trái tim tôi vẫn trống rỗng..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDMANDRAKE"
msgid "It was a good death. You will be delicious."
msgstr "Đó là một cái chết thanh thản. Ngươi sẽ rất ngon đấy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDMEAT"
msgid "The remaining blood has been cooked away."
msgstr "Phần máu còn lại đã được nấu chín bay hơi hết rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDMONSTERMEAT"
msgid "Cooked evil is still evil."
msgstr "Thứ ác độc được nấu chín thì vẫn cứ ác độc."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDSMALLMEAT"
msgid "Fire has purified it."
msgstr "Lửa đã thanh tẩy nó."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKIECUTTER"
msgid "Their faces are twisted with hunger."
msgstr "Khuôn mặt chúng méo mó vì cơn đói."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKIECUTTERHAT"
msgid "I'm protected, but at what cost to my dignity."
msgstr "Tôi được bảo vệ, nhưng lòng tự trọng thì tổn hại biết bao."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKIECUTTERSHELL"
msgid "All that remains of its former occupant."
msgstr "Tất cả những gì còn sót lại của sinh vật từng cư ngụ trong đó."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "The writing has been smudged away, the words forgotten."
msgstr "Chữ viết đã bị nhòe đi, những từ ngữ đã bị lãng quên."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.BURNT"
msgid "Burnt to a crisp."
msgstr "Cháy đen thui."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "Whatever's in there isn't dead yet."
msgstr "Thứ ở trong đó vẫn chưa chết hẳn đâu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "It needs to boil."
msgstr "Nó cần phải được đun sôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.DONE"
msgid "Finally, food."
msgstr "Cuối cùng cũng có đồ ăn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.EMPTY"
msgid "As empty as my soul."
msgstr "Trống rỗng như linh hồn tôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOLANT"
msgid "It seems alive but not."
msgstr "Nó có vẻ như đang sống nhưng lại không phải."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COONTAIL"
msgid "It's matted, patchy and putrid."
msgstr "Nó bị rối bù, lởm chởm và hôi thối."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN"
msgid "I could make a corny joke, but I'll refrain."
msgstr "Tôi có thể pha trò về ngô, nhưng thôi vậy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN_COOKED"
msgid "This corn couldn't handle the heat."
msgstr "Ngô này không chịu được sức nóng rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN_OVERSIZED"
msgid "I could pop enough corn for everyone."
msgstr "Tôi có thể nổ đủ bắp ngô cho tất cả mọi người."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN_SEEDS"
msgid "The seed of life, so tiny in my hand."
msgstr "Hạt giống của sự sống, thật bé nhỏ trong lòng bàn tay tôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "Shall we play a game of dress-up, Abigail?"
msgstr "Chúng ta chơi trò hóa trang nhé, Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_DOLL_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_DOLL_BODY"
msgid "Shall we play a game of dress-up, Abigail?"
msgstr "Chúng ta chơi trò hóa trang nhé, Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_FOOL_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_FOOL_BODY"
msgid "Shall we play a game of dress-up, Abigail?"
msgstr "Chúng ta chơi trò hóa trang nhé, Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_KING_BODY"
msgid "Shall we play a game of dress-up, Abigail?"
msgstr "Chúng ta chơi trò hóa trang nhé, Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "Shall we play a game of dress-up, Abigail?"
msgstr "Chúng ta chơi trò hóa trang nhé, Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_PRINCESS_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_PRINCESS_BODY"
msgid "So pretty."
msgstr "Đẹp quá."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "Shall we play a game of dress-up, Abigail?"
msgstr "Chúng ta chơi trò hóa trang nhé, Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_TREE_BODY"
msgid "Shall we play a game of dress-up, Abigail?"
msgstr "Chúng ta chơi trò hóa trang nhé, Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "The fire has grown cold."
msgstr "Lửa đã nguội lạnh."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "A gentle glow from a gentle creature."
msgstr "Ánh sáng dịu dàng từ một sinh vật dịu dàng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "The fire has grown cold."
msgstr "Lửa đã nguội lạnh."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "Somehow, its presence puts my mind at ease."
msgstr "Không hiểu sao sự hiện diện của nó lại giúp tâm trí tôi thấy nhẹ nhõm."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "The fire has grown cold."
msgstr "Lửa đã nguội lạnh."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "Look how it glitters in the firelight, Abigail!"
msgstr "Nhìn nó lấp lánh dưới ánh lửa kìa, Abigail!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TRINKET"
msgid "I wonder whose head it toppled from."
msgstr "Tự hỏi cái đầu đó rơi ra từ ai nhỉ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COZY_BUNNYMAN"
msgid "Poor creatures, sleep is only a temporary escape."
msgstr "Những sinh vật tội nghiệp, giấc ngủ chỉ là sự trốn chạy tạm thời."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING.GENERIC"
msgid "One of us will be sent to a watery grave..."
msgstr "Một trong số chúng ta sẽ được đưa xuống nấm mồ dưới nước..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING.INERT"
msgid "A crumbling edifice of sand... it's not even decorated."
msgstr "Một tòa lâu đài cát đang sụp đổ... thậm chí còn chẳng được trang trí."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_CANNONTOWER"
msgid "Futile."
msgstr "Vô ích."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_CLAW"
msgid "It wants to drag me down to the icy depths of the sea."
msgstr "Nó muốn kéo tôi xuống đáy biển sâu lạnh giá."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_ICEWALL"
msgid "You can't hide forever, crab."
msgstr "Ngươi không trốn mãi được đâu, cua à."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_MOB"
msgid "You're a pawn."
msgstr "Ngươi chỉ là một con tốt thí."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "Is your agression an attempt to fill the void?"
msgstr "Sự hung hăng của ngươi là một nỗ lực để lấp đầy sự trống rỗng bên trong ư?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTERLAB"
msgid "Oh. The abyss is staring back at me..."
msgstr "Ồ. Vực thẳm đang nhìn lại tôi..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_BULBIN"
msgid "Its adorable face nearly brings me to tears."
msgstr "Khuôn mặt đáng yêu của nó suýt làm tôi phát khóc."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_DRAGONLING"
msgid "My, what big eyes you have."
msgstr "Ồ, cậu có đôi mắt to ghê."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_EETS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_EETS"
msgid "It likes to bounce along with Abigail."
msgstr "Nó thích nhảy nhót cùng Abigail."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "May we gaze into the abyss... together."
msgstr "Mong rằng chúng ta cùng nhìn vào vực thẳm..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_GLOMLING"
msgid "Its snuggles almost make me forget."
msgstr "Những cái ôm của nó suýt làm tôi quên mất mọi thứ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_KITTEN"
msgid "Cursed with nine lives. Poor thing."
msgstr "Bị nguyền rủa với chín mạng sống. Thật tội nghiệp."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_LAMB"
msgid "The softest creature in the hardest world."
msgstr "Sinh vật mềm mại nhất trong một thế giới khắc nghiệt nhất."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "Your beauty will fade too, you know."
msgstr "Vẻ đẹp của ngươi rồi cũng sẽ phai tàn thôi, biết không."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_PERDLING"
msgid "It's so happy."
msgstr "Nó vui vẻ quá nhỉ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_PUPPY"
msgid "Blissfully unaware of mortal troubles..."
msgstr "Hạnh phúc vì chẳng hay biết gì về những muộn phiền trần thế..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CROW.GENERIC"
msgid "Take thy beak from out my heart!"
msgstr "Hãy rút chiếc mỏ ngươi khỏi trái tim ta!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CROW.HELD"
msgid "He is mine."
msgstr "Nó là của tôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRUMBS"
msgid "The little guy is falling apart."
msgstr "Cậu nhóc đang tan rã kìa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "It has an aura of malevolence... and monkeyness."
msgstr "Nó tỏa ra hào quang của sự độc ác... và cả loài khỉ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTGRASS"
msgid "It never even knew it was alive. How fortunate."
msgstr "Nó còn chẳng biết mình từng sống. Thật may mắn làm sao."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTLESS"
msgid "Sigh. Very well, I'll play \"pirates\"."
msgstr "Haizz. Thôi được rồi, tôi sẽ chơi trò \"cướp biển\"."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTLICHEN"
msgid "Fleeting, just like life."
msgstr "Phù du, giống hệt như cuộc đời vậy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTREEDS"
msgid "The blade has sentenced you to death."
msgstr "Lưỡi dao đã tuyên án tử hình cho ngươi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTSTONE"
msgid "The better to mark graves with."
msgstr "Dùng để đánh dấu mộ thì hợp hơn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER.GENERIC"
msgid "Kindness only begets more pain..."
msgstr "Lòng tốt chỉ mang lại thêm nhiều đau khổ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "What a pitiful creature."
msgstr "Thật là một sinh vật đáng thương."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER2.BURIED"
msgid "A soul crushed by the weight of the inescapable past."
msgstr "Linh hồn bị nghiền nát bởi sức nặng của quá khứ không thể chối bỏ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER2.GENERIC"
msgid "He seems hungry for power. Perhaps to fill the void within."
msgstr "Hắn có vẻ thèm khát quyền lực. Có lẽ để lấp đầy khoảng trống bên trong."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "The rage is a mask to hide his pain."
msgstr "Cơn thịnh nộ chỉ là lớp mặt nạ che giấu nỗi đau của hắn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "It is too strong, and I am too weak."
msgstr "Nó quá mạnh, còn tôi thì quá yếu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "We are all tethered to this place in one way or another."
msgstr "Tất cả chúng ta đều gắn kết với nơi này theo cách này hay cách khác."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEADLYFEAST"
msgid "This, a fitting final meal."
msgstr "Đây, một bữa ăn cuối cùng thật phù hợp."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEAD_SEA_BONES"
msgid "The sea rejects its dead."
msgstr "Biển cả từ chối những kẻ đã khuất của nó."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "It's burning brightly."
msgstr "Nó đang cháy rực rỡ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "Used up and done for."
msgstr "Đã bị vắt kiệt và tiêu đời."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "Everything dies."
msgstr "Mọi thứ đều phải chết."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "This tree is spooky. I bet it likes Halloween."
msgstr "Cái cây này thật đáng sợ. Cá là nó thích Halloween."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "Extra-spooky!"
msgstr "Siêu đáng sợ luôn!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECK_OF_CARDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECK_OF_CARDS"
msgid "Suppose I can play Solitaire."
msgstr "Chắc tôi chơi bài Solitaire được đấy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_CENTERPIECE"
msgid "The mortal obsession with material things."
msgstr "Sự ám ảnh của phàm nhân với vật chất."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "I feel the urge to stare into it."
msgstr "Tôi có cảm giác muốn nhìn chằm chằm vào nó."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "It's illuminating... for now."
msgstr "Nó đang tỏa sáng... tạm thời là thế."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "We pulled the flowers from their homes for our own amusement."
msgstr "Chúng ta đã bứt những bông hoa khỏi ngôi nhà của chúng để giải trí."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "It, too, will die."
msgstr "Rồi nó cũng sẽ chết mà thôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "I think it's lovelier this way..."
msgstr "Tôi nghĩ trông nó đáng yêu hơn thế này..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_LAMP"
msgid "Great."
msgstr "Tuyệt thật."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "It will be worth more after the artist dies."
msgstr "Nó sẽ có giá trị hơn sau khi họa sĩ qua đời."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "Leave it."
msgstr "Cứ để đó đi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "In the end, all we have are pictures."
msgstr "Cuối cùng, tất cả những gì chúng ta có chỉ là những bức ảnh."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER.ANTLER"
msgid "That horn won't protect you."
msgstr "Cái sừng đó sẽ không bảo vệ được ngươi đâu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER.GENERIC"
msgid "It lives in a constant state of fear."
msgstr "Nó sống trong sự sợ hãi liên miên."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPS"
msgid "Death incarnate!"
msgstr "Thần chết hiện thân!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "Ashes to ashes."
msgstr "Tro hoàn tro."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "This body is nothing but an empty vessel."
msgstr "Cái xác này chẳng khác nào một cái vỏ rỗng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "You should stay down."
msgstr "Ngươi nên nằm im đi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "No colder than a world without Abigail."
msgstr "Cũng chẳng lạnh lẽo hơn một thế giới vắng bóng Abigail."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "Hot. Cold. What does it matter?"
msgstr "Nóng. Lạnh. Thì sao chứ?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "I guess I could set this up and be helpful."
msgstr "Chắc tôi có thể dựng cái này lên và tỏ ra hữu ích chút."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "What terrors must it see."
msgstr "Nó đã phải chứng kiến những điều khủng khiếp gì cơ chứ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER_ANTLER"
msgid "We have grabbed life by its horn... though I wish we hadn't."
msgstr "Chúng ta đã nắm lấy cuộc sống bằng sừng của nó... dù tôi ước gì mình đừng làm thế."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER_GEMMED"
msgid "Some chains are physical..."
msgstr "Có những chiếc xiềng xích mang tính vật lý..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "The remains of a tuft of grass."
msgstr "Tàn tích của một búi cỏ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DESERTHAT"
msgid "Now no one can tell when I'm crying."
msgstr "Giờ thì không ai nhận ra lúc tôi khóc nữa rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DESICCANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DESICCANT"
msgid "It can't dry away all my tears."
msgstr "Nó không thể làm khô đi mọi giọt nước mắt của tôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DESICCANTBOOSTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DESICCANTBOOSTED"
msgid "I can't remember the last time my eyes were dry."
msgstr "Tôi không nhớ lần cuối cùng mắt mình khô ráo là khi nào nữa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIRTPILE"
msgid "Oh look. More dirt."
msgstr "Ồ nhìn kìa. Lại đất nữa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.COLD"
msgid "The source is distant."
msgstr "Nguồn năng lượng còn ở xa lắm."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.GENERIC"
msgid "It is forever seeking its lost half."
msgstr "Nó cứ mãi đi tìm một nửa bị thất lạc của mình."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.HOT"
msgid "Something wicked is here!"
msgstr "Có thứ gì đó tà ác đang ở đây!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.WARM"
msgid "The wickedness draws closer."
msgstr "Sự tà ác đang đến gần hơn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.WARMER"
msgid "It is very close now."
msgstr "Bây giờ thì nó ở rất gần rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "What does this newfangled thing do?"
msgstr "Cái thứ tối tân này dùng để làm gì vậy?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODBASE.READY"
msgid "It still needs a large key."
msgstr "Nó vẫn cần một chiếc chìa khóa lớn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "What mysteries will be revealed!"
msgstr "Những bí ẩn nào sẽ được hé lộ đây!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODSTART"
msgid "I could use that."
msgstr "Tôi có thể dùng cái đó đấy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DOCK_KIT"
msgid "I will build it, but no one will come."
msgstr "Tôi sẽ xây nó, nhưng sẽ chẳng có ai đến đâu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "What would be the point?"
msgstr "Có ích gì cơ chứ?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DOLL_BLUEPRINT"
msgid "It's pretty."
msgstr "Trông nó xinh xắn đấy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONBOAT_KIT"
msgid "I can help set this up, I guess."
msgstr "Chắc tôi có thể giúp dựng cái này lên."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONBOAT_PACK"
msgid "I suppose I can make myself useful in some small way and put it together."
msgstr "Tôi đoán mình cũng có thể tự giúp ích chút ít bằng cách lắp ráp nó lại."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONBODYHAT"
msgid "The belly of the beast."
msgstr "Bụng của con quái vật."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONCHILISALAD"
msgid "I missed having someone make me dinner..."
msgstr "Tôi nhớ cảm giác có ai đó nấu bữa tối cho mình ghê..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLY"
msgid "It's burning on the inside."
msgstr "Nó đang cháy bùng ở bên trong."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "Boom box."
msgstr "Hộp nhạc boombox."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE"
msgid "It holds multitudes, and refuses to burn away."
msgstr "Nó chứa được vô số thứ, và nhất quyết không chịu cháy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "Its teeth do not even gnash."
msgstr "Hàm răng của nó còn chẳng thèm nghiến lại."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "Pathetic."
msgstr "Thật thảm hại."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "No need to lean in and check if it's hot. I can feel it from here."
msgstr "Không cần phải cúi người kiểm tra xem nó có nóng không đâu. Tôi cảm nhận được từ đây rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "Burns hot... but not bright..."
msgstr "Cháy nóng... nhưng không sáng..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT"
msgid "This isn't shaped like a dragon at all."
msgstr "Cái này chẳng có hình thù gì giống rồng cả."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "Still not a dragon. At least it's dead."
msgstr "Vẫn không phải là rồng. Ít ra thì nó đã chết rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "It nearly became a dragon."
msgstr "Nó suýt biến thành một con rồng đấy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "It's a seed."
msgstr "Đó là một hạt giống."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONHEADHAT"
msgid "What big eyes you have."
msgstr "Cậu có đôi mắt to ghê."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONPIE"
msgid "Well, at least it's a pie now."
msgstr "Ừ thì, ít ra bây giờ nó là một cái bánh nướng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONTAILHAT"
msgid "That's just a tall tail."
msgstr "Đó chỉ là một câu chuyện bịa đặt thôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGON_SCALES"
msgid "Scales of pain."
msgstr "Những chiếc vẩy đầy đau đớn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DREADSTONE"
msgid "It is cold... and beautiful."
msgstr "Nó thật lạnh lẽo... và đẹp đẽ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DREADSTONEHAT"
msgid "What's the point?"
msgstr "Có ích gì chứ?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DREADSTONE_STACK"
msgid "Do I dare imagine what kind of darkness it grew from?"
msgstr "Tôi có dám tưởng tượng nó lớn lên từ loại bóng tối nào không nhỉ?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_LOG"
msgid "Bleached like bones left in the sun."
msgstr "Bạc phếch như những khúc xương phơi ngoài nắng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "Oh. It's burning."
msgstr "Ồ. Nó đang cháy kìa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "Your suffering is over now."
msgstr "Nỗi thống khổ của ngươi giờ đã chấm dứt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "It's met its end at our hands."
msgstr "Nó đã tận số dưới tay chúng ta."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "The bleached remains of a dead tree."
msgstr "Tàn tích bạc phếch của một cái cây chết."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRUMSTICK"
msgid "Makes a good thud, and it's nutritious!"
msgstr "Phát ra tiếng bịp khá hay, lại còn bổ dưỡng nữa!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRUMSTICK_COOKED"
msgid "Less raw, more tasty."
msgstr "Bớt sống đi, ngon miệng hơn rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_BANANABUSH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_BANANABUSH"
msgid "Bananas that grow in the sun... how unnatural."
msgstr "Chuối mọc dưới ánh nắng mặt trời... thật bất tự nhiên làm sao."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_BERRYBUSH"
msgid "How sad. You've no home."
msgstr "Thật đáng thương. Ngươi chẳng còn nhà để về."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "How does it feel to be ripped from your home?"
msgstr "Cảm giác bị bứt khỏi ngôi nhà của mình ra sao hả?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_GRASS"
msgid "I like it dead, but it should probably be returned to the earth."
msgstr "Tôi thích nó chết hơn, nhưng chắc nên trả nó về với đất mẹ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_MARSH_BUSH"
msgid "I like it dead, but it should probably be returned to the earth."
msgstr "Tôi thích nó chết hơn, nhưng chắc nên trả nó về với đất mẹ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_MONKEYTAIL"
msgid "Oh. They're so soft. And fuzzy."
msgstr "Ồ. Chúng mềm quá. Lại còn xù nữa chứ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_SAPLING"
msgid "I like it dead, but it should probably be returned to the earth."
msgstr "Tôi thích nó chết hơn, nhưng chắc nên trả nó về với đất mẹ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_TRAP_STARFISH"
msgid "A pity it didn't crunch me up when it had the chance."
msgstr "Tiếc thật, nó không nghiền nát tôi luôn khi có cơ hội."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL"
msgid "Oh. It's very heavy."
msgstr "Ồ. Nó nặng lắm đấy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "It chills me to my core."
msgstr "Nó làm tôi lạnh thấu xương."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_GEM"
msgid "Who would choose to carry such a burden..."
msgstr "Ai lại muốn mang một gánh nặng như thế chứ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_GOLDEN"
msgid "It's almost as heavy as my heart."
msgstr "Nó nặng gần bằng trái tim tôi vậy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_HEAT"
msgid "It may warm the body, but not the heart."
msgstr "Nó có thể sưởi ấm thể xác, nhưng chẳng thể sưởi ấm trái tim."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_MARBLE"
msgid "We all carry a great weight. His seems... a bit more literal, though."
msgstr "Tất cả chúng ta đều mang một sức nặng lớn. Chỉ là của anh ta... có vẻ đen tối hơn một chút thôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_REDGEM"
msgid "It inflicts burning pain."
msgstr "Nó gây ra nỗi đau bỏng rát."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN"
msgid "Spiky and smelly!"
msgstr "Gai góc và bốc mùi!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN_COOKED"
msgid "Less spiky, but even smellier!"
msgstr "Bớt gai hơn, nhưng lại càng bốc mùi hơn!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN_OVERSIZED"
msgid "Why did this one have to grow so large?"
msgstr "Sao cái này lại phải mọc to đến thế cơ chứ?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN_SEEDS"
msgid "It's a plant that's waiting to be."
msgstr "Đó là một mầm cây đang chờ ngày đơm hoa kết trái."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUSTMERINGUE"
msgid "A treat devoid of sweetness..."
msgstr "Một món tráng miệng chẳng hề ngọt ngào..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUSTMOTH"
msgid "They seem to live only to clean. What a tiresome life."
msgstr "Chúng sinh ra hình như chỉ để dọn dẹp. Quả là một cuộc đời tẻ nhạt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUSTMOTHDEN"
msgid "Poor things, their home is no longer safe from us."
msgstr "Tội nghiệp, ngôi nhà của chúng không còn an toàn trước chúng ta nữa rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EARMUFFSHAT"
msgid "Their bitter end offers protection from the bitter cold."
msgstr "Cái chết cay đắng của chúng mang lại sự bảo vệ khỏi cái lạnh buốt giá."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EEL"
msgid "An eel."
msgstr "Một con lươn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EEL_COOKED"
msgid "An eel that has been cooked."
msgstr "Một con lươn đã được nấu chín."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT"
msgid "Almost a deadly nightshade. Almost."
msgstr "Gần giống như cây ô đầu chết người. Suýt thì phải."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT_COOKED"
msgid "Cooking this nightshade made it even less deadly."
msgstr "Nấu chín loại độc dược này càng làm nó bớt độc hơn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "Unfortunately it's not poisonous, despite its sickly purple shade."
msgstr "Đáng tiếc là nó không có độc, dù mang sắc tím ố bệnh."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT_SEEDS"
msgid "It's a plant that's waiting to be."
msgstr "Đó là một mầm cây đang chờ ngày đơm hoa kết trái."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ELIXIR_CONTAINER"
msgid "If only I could have helped you then."
msgstr "Giá mà lúc đó tôi có thể giúp được cậu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EMBERLIGHT"
msgid "At least it warms my hands."
msgstr "Ít ra nó cũng sưởi ấm đôi tay tôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.BURNT"
msgid "Nothing lasts forever."
msgstr "Chẳng có gì là vĩnh cửu cả."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.EMPTY"
msgid "The shadow equivalent of taxidermy. I like it."
msgstr "Phiên bản bóng tối của nghệ thuật nhồi xác. Tôi thích nó."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "It's illuminating... for now."
msgstr "Nó đang tỏa sáng... tạm thời là thế."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.GENERIC"
msgid "We pulled the flowers from their homes for our own amusement."
msgstr "Chúng ta đã bứt những bông hoa khỏi ngôi nhà của chúng để giải trí."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "It, too, will die."
msgstr "Rồi nó cũng sẽ chết mà thôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.WILTED"
msgid "I think it's lovelier this way..."
msgstr "Tôi nghĩ trông nó đáng yêu hơn thế này..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.BURNING"
msgid "It's burning brightly."
msgstr "Nó đang cháy rực rỡ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.BURNT"
msgid "Used up and done for."
msgstr "Đã bị vắt kiệt và tiêu đời."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.CHOPPED"
msgid "Everything dies."
msgstr "Mọi thứ đều phải chết."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.GENERIC"
msgid "Nature is so boring."
msgstr "Thiên nhiên thật là nhàm chán."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "It's burning brightly."
msgstr "Nó đang cháy rực rỡ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "Used up and done for."
msgstr "Đã bị vắt kiệt và tiêu đời."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "Everything dies."
msgstr "Mọi thứ đều phải chết."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "Its cycle of life is ending."
msgstr "Vòng đời của nó sắp kết thúc rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEBRELLAHAT"
msgid "That's one stretchy eye."
msgstr "Đúng là một con mắt co giãn thật."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEMASKHAT"
msgid "I am the beholder of the eye."
msgstr "Tôi là kẻ chiêm ngưỡng con mắt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEOFTERROR"
msgid "Beware the evil eye."
msgstr "Hãy đề phòng con mắt ác quỷ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEOFTERROR_MINI"
msgid "I can feel the sting of their sharp gaze..."
msgstr "Tôi có thể cảm nhận được sự nhức nhối từ ánh nhìn sắc lẹm của chúng..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "One more blight will be brought into this world."
msgstr "Thêm một thảm họa nữa sắp được mang đến thế giới này."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEPLANT"
msgid "They follow their master's every wish."
msgstr "Chúng tuân lệnh mọi mong muốn của chủ nhân."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYETURRET"
msgid "I do not know why it helps me."
msgstr "Tôi không biết tại sao nó lại giúp tôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYETURRET_ITEM"
msgid "I think it needs to be placed."
msgstr "Tôi nghĩ nó cần được đặt xuống."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.BURNT"
msgid "This earth is burnt and dead."
msgstr "Mặt đất này đã bị thiêu rụi và chết chóc."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.GENERIC"
msgid "What seeds shall I sow?"
msgstr "Tôi nên gieo hạt nào đây?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.GROWING"
msgid "Leafy tendrils coil out of the muck."
msgstr "Những chồi lá cuộn tròn vươn lên từ lớp bùn lầy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "This earth is cold and dead."
msgstr "Mặt đất này lạnh lẽo và chết chóc."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_HOE"
msgid "I must prepare the seeds for their burial."
msgstr "Tôi phải chuẩn bị cho những cái hạt được an táng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.BURNING"
msgid "All that work, destroyed..."
msgstr "Bao nhiêu công sức, tan thành mây khói..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.FULL"
msgid "How cruel, that I must now steal the fruits of your labor."
msgstr "Thật tàn nhẫn làm sao, khi giờ đây tôi phải cướp đi thành quả lao động của bạn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "However did it grow so big?"
msgstr "Sao mà nó có thể lớn đến thế nhỉ?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "It is the tragic fate of all weeds to be spurned from the garden."
msgstr "Đó là bi kịch số phận của mọi loài cỏ dại, bị xua đuổi khỏi khu vườn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.GENERIC"
msgid "A plant."
msgstr "Một loài thực vật."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.GROWING"
msgid "Despite the horrors of the world, it seems intent on living."
msgstr "Bất chấp những điều kinh hoàng của thế giới, nó vẫn kiên quyết sống tiếp."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "There's nothing I can do for it."
msgstr "Tôi chẳng thể làm gì cho nó được nữa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "Dead and rotting."
msgstr "Chết chóc và mục rữa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.SEED"
msgid "Is it cold down there, alone in the ground?"
msgstr "Dưới đó có lạnh không, khi đơn độc nằm trong lòng đất?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLOW"
msgid "It's fighting against the ground."
msgstr "Nó đang chiến đấu với mặt đất."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLOW_ITEM"
msgid "I suppose I must find a place for the garden."
msgstr "Chắc tôi phải tìm một chỗ cho khu vườn thôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "You don't belong here."
msgstr "Ngươi không thuộc về nơi này."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHERFAN"
msgid "That'll make quite a draft."
msgstr "Cái đó sẽ tạo ra một luồng gió kha khá đấy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHERHAT"
msgid "Ca-caw!"
msgstr "Quác quác!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHERPENCIL"
msgid "M...maybe I'll doodle something... When no one's looking."
msgstr "M...mình có thể vẽ nguệch ngoạc gì đó... Khi không có ai nhìn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_CANARY"
msgid "A canary feather, golden as the gilded cage."
msgstr "Một chiếc lông chim hoàng yến, vàng óng như chiếc lồng son."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_CROW"
msgid "A soft feather, black like eternal darkness."
msgstr "Một chiếc lông mềm mại, đen nhánh tựa bóng đêm vĩnh hằng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_ROBIN"
msgid "A redbird feather, red like blood."
msgstr "Một chiếc lông chim Đỏ, đỏ như máu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "A snowbird feather, white as the light at the end of the tunnel."
msgstr "Một chiếc lông chim Tuyết, trắng tựa ánh sáng cuối đường hầm."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEM_PUPPET"
msgid "I wonder what she did."
msgstr "Tôi tự hỏi cô ta đã làm gì."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE"
msgid "Sort of like an emotional barrier. But wood."
msgstr "Kiểu như một hàng rào cảm xúc vậy. Nhưng bằng gỗ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ELECTRIC.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ELECTRIC.GENERIC"
msgid "What a lonely post."
msgstr "Quả là một chiếc cột cô độc."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ELECTRIC.LINKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ELECTRIC.LINKED"
msgid "It fulfills its purpose in connection."
msgstr "Nó hoàn thành mục đích của mình qua sự kết nối."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ELECTRIC_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ELECTRIC_ITEM"
msgid "It's no use to anyone like that."
msgstr "Thế này thì chẳng có ích gì cho ai cả."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_GATE"
msgid "Will it keep others in, or out?"
msgstr "Nó sẽ nhốt người ở trong, hay chắn người ở ngoài đây?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_GATE_ITEM"
msgid "We could use it to build a gate."
msgstr "Chúng ta có thể dùng nó để dựng một cái cổng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ITEM"
msgid "We could use it to build a fence."
msgstr "Chúng ta có thể dùng nó để làm hàng rào."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_JUNK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_JUNK"
msgid "Even these discarded pieces can manage to be useful."
msgstr "Ngay cả những mảnh vụn bị bỏ đi này cũng có ích."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ROTATOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ROTATOR"
msgid "Disorderly fences need to be brought into line."
msgstr "Những chiếc hàng rào lộn xộn cần phải được chỉnh đốn lại."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FERTILIZER"
msgid "A bucket of grime."
msgstr "Một xô chất nhờn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FESTIVEFISH"
msgid "It's about as festive as I feel."
msgstr "Nó có vẻ vui tươi ngang ngửa tâm trạng tôi lúc này."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FESTIVE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FESTIVE_BLUEPRINT"
msgid "It's so colorful, it hurts my eyes."
msgstr "Nó sặc sỡ đến mức làm tôi nhức cả mắt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIG"
msgid "Abigail always told me they were filled with wasps."
msgstr "Abigail luôn bảo với tôi rằng bên trong chúng toàn là ong bắp cày."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIGATONI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIGATONI"
msgid "The fig cowers in its pasta shell."
msgstr "Quả vả đang co rúm trong lớp vỏ mì ống."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIGKABAB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIGKABAB"
msgid "The fig pieces look like little pierced hearts."
msgstr "Những miếng quả vả trông giống như những trái tim nhỏ bị đâm thủng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIG_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIG_COOKED"
msgid "Any wasps it held seem to have been burned away."
msgstr "Mấy con ong bắp cày bên trong hình như đã bị thiêu rụi rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREBALLSTAFF"
msgid "To call death from the skies."
msgstr "Để gọi cái chết từ bầu trời."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRECRACKERS"
msgid "It needs only a light."
msgstr "Chỉ cần châm lửa là xong."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREFLIES.GENERIC"
msgid "A tiny brightness in the dark."
msgstr "Một đốm sáng nhỏ nhoi trong bóng tối."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREFLIES.HELD"
msgid "Tiny lights, stranded from the world outside my pocket."
msgstr "Những ánh đèn nhỏ bé, bị lưu lạc khỏi thế giới bên ngoài túi áo tôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREHOUND"
msgid "His disposition is fiery."
msgstr "Tính tình của nó dữ dội như lửa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRENETTLES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRENETTLES"
msgid "They sting terribly."
msgstr "Chúng đốt đau khủng khiếp."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRENETTLES_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRENETTLES_DRIED"
msgid "I like how they smell."
msgstr "Tôi thích mùi của chúng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPEN"
msgid "Father had one very similar. I doubt it ever started a fire, though."
msgstr "Cha có một cái y hệt thế này. Nhưng tôi nghi ngờ nó chưa từng tạo ra ngọn lửa nào."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.EMBERS"
msgid "Don't give up, little flame!"
msgstr "Đừng bỏ cuộc, ngọn lửa nhỏ nhé!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.GENERIC"
msgid "A flame to keep the horrors at bay."
msgstr "Một ngọn lửa để xua đuổi những nỗi kinh hoàng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.HIGH"
msgid "This fire burns with passion!"
msgstr "Ngọn lửa này cháy với đầy nhiệt huyết!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.LOW"
msgid "It's losing the will to go on."
msgstr "Nó đang mất đi ý chí muốn tiếp tục."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.NORMAL"
msgid "It's a comfort."
msgstr "Thật là một sự an ủi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.OUT"
msgid "This can be rekindled, unlike my heart."
msgstr "Thứ này có thể thắp sáng lại, không như trái tim tôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESTAFF"
msgid "The world will burn before this staff."
msgstr "Cả thế giới này sẽ phải cháy rụi trước cây quyền năng này."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "It's running on fumes."
msgstr "Nó sắp cạn sạch nhiên liệu rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "Quiet as a corpse."
msgstr "Yên tĩnh như một cái xác."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "I don't know why you bother. We're all going to burn."
msgstr "Tôi không hiểu sao cậu lại phải bận tâm. Tất cả chúng ta rồi sẽ thành tro bụi thôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISH"
msgid "It was flopping around desperately for life. The poor fool."
msgstr "Nó đã giãy giụa tuyệt vọng để giành lấy sự sống. Thật đáng thương hại."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHINGNET"
msgid "To ensnare fish and tear them from their peaceful lives."
msgstr "Để câu cá và bứt chúng khỏi cuộc sống bình yên."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHINGROD"
msgid "With this the fishies will be ripped from the safety of their precious pond."
msgstr "Với thứ này, lũ cá sẽ bị lôi ra khỏi chốn bình yên quý giá trong ao của chúng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT"
msgid "It's been decapitated."
msgstr "Nó đã bị chặt đầu rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_COOKED"
msgid "A proper grilling puts a stop to the flopping."
msgstr "Nướng đúng cách sẽ chấm dứt ngay mấy cú giãy giụa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_DRIED"
msgid "The dessicated remains of a fish."
msgstr "Phần xác khô quắt của một con cá."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_SMALL"
msgid "There are other fish in the sea. Bigger ones, hopefully."
msgstr "Dưới biển còn đầy cá. Hy vọng là mấy con to hơn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "It will... tide... me over for now."
msgstr "Nó sẽ... cầm cự... giúp tôi lúc này."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_SMALL_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_SMALL_DRIED"
msgid "Withered away to almost nothing."
msgstr "Teo tóp lại gần như chẳng còn gì."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHSTICKS"
msgid "Perfectly molded blocks of fish."
msgstr "Những khối cá được đúc hoàn hảo."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHTACOS"
msgid "Hopefully no bones still linger within."
msgstr "Hy vọng là không còn chiếc xương nào sót lại bên trong."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISH_BOX"
msgid "It feels a bit cruel to trap them within sight of freedom."
msgstr "Cảm giác hơi tàn nhẫn khi bẫy chúng ngay trong tầm mắt của sự tự do."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISH_COOKED"
msgid "A proper grilling puts a stop to the flopping."
msgstr "Nướng đúng cách sẽ chấm dứt ngay mấy cú giãy giụa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLINT"
msgid "A tiny blade-like rock."
msgstr "Một hòn đá sắc nhọn tựa lưỡi dao."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOATINGLANTERN.DEFLATED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOATINGLANTERN.DEFLATED"
msgid "I knew it couldn't last."
msgstr "Tôi biết là nó không kéo dài được lâu mà."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOATINGLANTERN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOATINGLANTERN.GENERIC"
msgid "It does lift my spirits... a little."
msgstr "Nó cũng vực dậy tinh thần tôi... chút ít."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOATINGLANTERN.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOATINGLANTERN.HELD"
msgid "I should save this for when it's darkest."
msgstr "Tôi nên giữ lại cái này cho lúc tối trời nhất."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOTATIONCUSHION
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOTATIONCUSHION"
msgid "One does not need water to drown."
msgstr "Đâu cần phải có nước mới chết đuối được."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER.GENERIC"
msgid "They are bright and cheery. Yuck."
msgstr "Chúng thật tươi sáng và vui vẻ. Kinh tởm."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER.ROSE"
msgid "Prickly and blood red..."
msgstr "Gai góc và đỏ như máu..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWERHAT"
msgid "But I am in mourning..."
msgstr "Nhưng tôi đang để tang cơ mà..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWERSALAD"
msgid "Ugh, more flowers."
msgstr "Hừ, lại hoa nữa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_CAVE"
msgid "It looks fragile."
msgstr "Trông nó có vẻ mỏng manh."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_CAVE_WITHERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_CAVE_WITHERED"
msgid "There's a sadness about how it flickers."
msgstr "Có một nỗi buồn man mác trong cách nó lập lòe."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_EVIL"
msgid "At least they're better than the other flowers."
msgstr "Ít ra chúng còn đỡ hơn mấy bông hoa kia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_WITHERED"
msgid "This is the fate of all things."
msgstr "Đây là số phận chung của vạn vật."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FOLIAGE"
msgid "Lead me to the Aarnivalkea."
msgstr "Hãy dẫn tôi đến Aarnivalkea."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FOLIAGE_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FOLIAGE_DRIED"
msgid "I like how they smell."
msgstr "Tôi thích mùi của chúng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FOOTBALLHAT"
msgid "A dead thing for me to wear. Goody."
msgstr "Một món đồ của kẻ chết để tôi mặc lên người. Vui quá nhỉ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FORGETMELOTS"
msgid "They are rather pretty for a weed."
msgstr "Đối với cỏ dại thì chúng khá xinh đấy chứ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FORGETMELOTS_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FORGETMELOTS_DRIED"
msgid "I like how they smell."
msgstr "Tôi thích mùi của chúng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FORMAL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FORMAL_BLUEPRINT"
msgid "It looks very dignified."
msgstr "Trông rất ra dáng trang nghiêm."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_PIECE"
msgid "It is death, preserved."
msgstr "Đó là cái chết được bảo quản lại."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "What horrors have we resurrected here today?"
msgstr "Thứ kinh hoàng nào mà chúng ta đã hồi sinh ở đây hôm nay thế?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "Death has a sense of humor."
msgstr "Thần chết cũng có khiếu hài hước đấy chứ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "We must find more pieces."
msgstr "Chúng ta phải tìm thêm các mảnh khác."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRESHFRUITCREPES"
msgid "Could I get this a la mode?"
msgstr "Tôi có thể gọi món này kèm kem được không?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRIENDLYFRUITFLY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRIENDLYFRUITFLY"
msgid "Oh. It seems to be friendly."
msgstr "Ồ. Có vẻ như nó rất thân thiện."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROG.DEAD"
msgid "Life is small and short."
msgstr "Cuộc đời thật nhỏ bé và ngắn ngủi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROG.GENERIC"
msgid "He's little and warty."
msgstr "Nó thật nhỏ bé và đầy nốt sần."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROG.SLEEPING"
msgid "He's asleep."
msgstr "Nó đang ngủ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGFISHBOWL"
msgid "It's actually... really good..."
msgstr "Thực ra thì... rất ngon đấy..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGGLEBUNWICH"
msgid "I never thought frog's legs could look so good."
msgstr "Tôi chưa bao giờ nghĩ đùi ếch lại có thể ngon mắt đến thế."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGLEGS"
msgid "Torn right from the frog."
msgstr "Bứt ra trực tiếp từ con ếch."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGLEGS_COOKED"
msgid "Definitely not twitching any longer."
msgstr "Chắc chắn là không còn co giật nữa rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGNEWTON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGNEWTON"
msgid "Sweet and only a little slimy."
msgstr "Ngọt ngào và chỉ hơi nhớt một chút."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROZENBANANADAIQUIRI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROZENBANANADAIQUIRI"
msgid "This won't be of help to my cold, cold heart."
msgstr "Cái này sẽ chẳng giúp ích gì cho trái tim lạnh giá của tôi đâu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "It prefers to be alone."
msgstr "Nó thích ở một mình hơn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITDRAGON.RIPE"
msgid "You simply look too delicious."
msgstr "Trông cậu ngon miệng quá đấy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "It is arrested by deepest sleep."
msgstr "Nó đang chìm đalam vào giấc ngủ ngàn thu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITFLY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITFLY"
msgid "They have no respect for living things."
msgstr "Chúng chẳng hề tôn trọng sự sống."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITFLYFRUIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITFLYFRUIT"
msgid "Now you may trade your lord for a queen."
msgstr "Giờ thì ngươi có thể đổi vua lấy chúa được rồi đấy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITMEDLEY"
msgid "Sweet, tart and in a cup."
msgstr "Ngọt, chua thanh và nằm gọn trong ly."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEAXE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEAXE.GENERIC"
msgid "It's not long for this world..."
msgstr "Nó sẽ chẳng sống được lâu trên thế giới này đâu..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEAXE.HOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEAXE.HOT"
msgid "The hottest flames burn out the quickest..."
msgstr "Ngọn lửa rực rỡ nhất sẽ tàn lụi nhanh nhất..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEAXE.LUKEWARM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEAXE.LUKEWARM"
msgid "It has lost the warmth it once had."
msgstr "Nó đã mất đi hơi ấm từng có."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEAXE.WARM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEAXE.WARM"
msgid "I can find some small comfort in its warmth."
msgstr "Tôi có thể tìm thấy chút hơi ấm an ủi nhỏ nhoi từ nó."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEHAMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEHAMMER.GENERIC"
msgid "It's not long for this world..."
msgstr "Nó sẽ chẳng sống được lâu trên thế giới này đâu..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEHAMMER.HOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEHAMMER.HOT"
msgid "The hottest flames burn out the quickest..."
msgstr "Ngọn lửa rực rỡ nhất sẽ tàn lụi nhanh nhất..."

