#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_BACKUPBODY.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_BACKUPBODY.GENERIC"
msgid "Practical immortality through engineering!"
msgstr "Đạt được sự bất tử thực tế thông qua kỹ thuật!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_BACKUPBODY.UNCLAIMED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_BACKUPBODY.UNCLAIMED"
msgid "only_used_by_wx78"
msgstr "chỉ_được_sử_dụng_bởi_wx78"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_BACKUPBODY.VIEWERS_BODY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_BACKUPBODY.VIEWERS_BODY"
msgid "only_used_by_wx78"
msgstr "chỉ_được_sử_dụng_bởi_wx78"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_DELIVERY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "A freight it will get lost!"
msgstr "Mong là nó sẽ không chuyển phát thất lạc!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_SCOUT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_SCOUT"
msgid "So far, so good."
msgstr "Mọi thứ vẫn ổn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_ZAP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_ZAP"
msgid "It uses current technology."
msgstr "Nó sử dụng công nghệ dòng điện hiện tại đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_ZAP_REMOTE.CANUSE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_ZAP_REMOTE.CANUSE"
msgid "only_used_by_wx78"
msgstr "chỉ_được_sử_dụng_bởi_wx78"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "It controls remotely? It's a.... Detached Telecommand Apparatus!"
msgstr "Nó điều khiển từ xa á? Đúng là một... Thiết bị Viễn điều khiển Tách rời!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_FOODBRICK.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "It's too hard to eat."
msgstr "Cứng quá không ăn nổi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_FOODBRICK.WET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_FOODBRICK.WET"
msgid "It's a moist try!"
msgstr "Đúng là một cú thử nghiệm ẩm ướt!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_GESTALTTRAPPER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "What possessed WX to do this?"
msgstr "Mùi gì xui khiến WX làm thế này nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "Finite like that."
msgstr "Giới hạn kiểu thế đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_INVENTORYCONTAINER.HELD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_INVENTORYCONTAINER.HELD"
msgid "only_used_by_wx78"
msgstr "chỉ_được_sử_dụng_bởi_wx78"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_INVENTORYCONTAINER.NOPOWER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_INVENTORYCONTAINER.NOPOWER"
msgid "only_used_by_wx78"
msgstr "chỉ_được_sử_dụng_bởi_wx78"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_MODULEREMOVER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_MODULEREMOVER"
msgid "Obviously a very delicate and complicated scientific instrument."
msgstr "Rõ ràng là một thiết bị khoa học vô cùng tinh vi và phức tạp."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_POSSESSEDBODY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_POSSESSEDBODY"
msgid "You're not yourself lately!"
msgstr "Dạo này cậu không còn là chính mình nữa rồi đấy!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_SCANNER.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_SCANNER.GENERIC"
msgid "WX-78 really puts a piece of themselves into their work."
msgstr "WX-78 thực sự đặt cả tâm huyết vào công việc của mình."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_SCANNER.HUNTING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_SCANNER.HUNTING"
msgid "Get that data!"
msgstr "Lấy dữ liệu đó về đi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_SCANNER.SCANNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_SCANNER.SCANNING"
msgid "Seems like it's found something."
msgstr "Có vẻ như nó vừa tìm thấy gì đó rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_SCANNER_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_SCANNER_ITEM"
msgid "I wonder if it dreams about scanning sheep."
msgstr "Không biết nó có đang mơ về việc quét cừu không nhỉ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_SCANNER_SUCCEEDED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_SCANNER_SUCCEEDED"
msgid "It's got the look of someone eager to show their work."
msgstr "Trông y như vẻ mặt của một kẻ đang háo hức khoe thành quả vậy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_SHADOWDRONE_DEBUFFER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_SHADOWDRONE_DEBUFFER"
msgid "It's a keen observer."
msgstr "Đúng là một quan sát viên tinh tường."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_SHADOWDRONE_HARVESTER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_SHADOWDRONE_HARVESTER"
msgid "A collector in WX's collection."
msgstr "Một kẻ thu gom trong bộ sưu tập của WX."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.W_RADIO
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.W_RADIO"
msgid "Hm. There's a lot of science here."
msgstr "Hừm. Có rất nhiều khoa học ở đây đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YELLOWAMULET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YELLOWAMULET"
msgid "Warm to the touch."
msgstr "Ấm áp khi chạm vào."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YELLOWGEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YELLOWGEM"
msgid "This gem is yellow."
msgstr "Viên ngọc này có màu vàng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YELLOWMOONEYE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YELLOWMOONEYE"
msgid "That ought to show everyone the way."
msgstr "Cái đó chắc sẽ chỉ đường cho mọi người đây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YELLOWSTAFF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YELLOWSTAFF"
msgid "A genius invention... a gem on a stick."
msgstr "Một phát minh thiên tài... gắn viên ngọc lên cây gậy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTB_BEEFALOSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTB_BEEFALOSHRINE.BURNT"
msgid "Smells like barbeque."
msgstr "Ngửi giống mùi thịt nướng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTB_BEEFALOSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTB_BEEFALOSHRINE.EMPTY"
msgid "Hm... what makes a beefalo?"
msgstr "Hừm... thế nào mới là một con bò lai chính hiệu nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTB_BEEFALOSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTB_BEEFALOSHRINE.GENERIC"
msgid "What to make..."
msgstr "Nên làm gì đây..."

