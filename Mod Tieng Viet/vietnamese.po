msgstr "Không gian chỉ có hạn thôi."

#. STRINGS.CHARACTERS.WANDA.ACTIONFAIL.STORE.INUSE
msgctxt "STRINGS.CHARACTERS.WANDA.ACTIONFAIL.STORE.INUSE"
msgid "Please hurry, I have so much to do!"
msgstr "Làm ơn nhanh lên, tôi còn khối việc phải làm!"

#. STRINGS.CHARACTERS.WANDA.ACTIONFAIL.STORE.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WANDA.ACTIONFAIL.STORE.NOTALLOWED"
msgid "I don't have time to fuss with this!"
msgstr "Tôi không có thời gian để bận tâm với cái này!"

#. STRINGS.CHARACTERS.WANDA.ACTIONFAIL.STORE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WANDA.ACTIONFAIL.STORE.NOTAROBOT"
msgid "It belongs to the automaton."
msgstr "Nó thuộc về cỗ máy tự động."

#. STRINGS.CHARACTERS.WANDA.ACTIONFAIL.STORE.NOTMASTERCHEF
msgctxt "STRINGS.CHARACTERS.WANDA.ACTIONFAIL.STORE.NOTMASTERCHEF"
msgid "It takes too long to cook a fancy meal."
msgstr "Nấu một bữa ăn cầu kỳ tốn nhiều thời gian quá."

#. STRINGS.CHARACTERS.WANDA.ACTIONFAIL.STORE.NOTSOULJARHANDLER
msgctxt "STRINGS.CHARACTERS.WANDA.ACTIONFAIL.STORE.NOTSOULJARHANDLER"
msgid "The imp can do whatever he wants with these."
msgstr "Con tiểu yêu muốn làm gì với đống này thì làm."

#. STRINGS.CHARACTERS.WANDA.ACTIONFAIL.STORE.RESTRICTED
msgctxt "STRINGS.CHARACTERS.WANDA.ACTIONFAIL.STORE.RESTRICTED"
msgid "I'll not waste time with that."
msgstr "Tôi sẽ không phí thời gian với cái đó đâu."

#. STRINGS.CHARACTERS.WANDA.ACTIONFAIL.TEACH.CANTLEARN
msgctxt "STRINGS.CHARACTERS.WANDA.ACTIONFAIL.TEACH.CANTLEARN"
