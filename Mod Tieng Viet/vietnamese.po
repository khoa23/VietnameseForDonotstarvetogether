msgstr "Lại đây các bạn ơi! Mở tiệc thôi!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BALLOONSPEED.DEFLATED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BALLOONSPEED.DEFLATED"
