msgstr "Lớn lên nào, cây ơi! Phải thật khỏe mạnh nhé!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TREE_ROCK.BURNING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TREE_ROCK.BURNING"
