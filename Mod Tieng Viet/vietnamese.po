msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POCKETWATCH_REVIVE.GENERIC"
msgid "Maybe I could ask her to make me a kitchen timer..."
msgstr "Có lẽ tôi có thể nhờ cô ấy làm cho tôi một chiếc đồng hồ bấm giờ nhà bếp..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POCKETWATCH_REVIVE.RECHARGING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POCKETWATCH_REVIVE.RECHARGING"
msgid "I don't think it's ready just yet."
msgstr "Tôi không nghĩ nó sẵn sàng ngay lúc này đâu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POCKETWATCH_WARP.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POCKETWATCH_WARP.GENERIC"
msgid "Maybe I could ask her to make me a kitchen timer..."
msgstr "Có lẽ tôi có thể nhờ cô ấy làm cho tôi một chiếc đồng hồ bấm giờ nhà bếp..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POCKETWATCH_WARP.RECHARGING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POCKETWATCH_WARP.RECHARGING"
msgid "I don't think it's ready just yet."
msgstr "Tôi không nghĩ nó sẵn sàng ngay lúc này đâu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POCKETWATCH_WEAPON.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POCKETWATCH_WEAPON.GENERIC"
msgid "I'm starting to think Mme. Wanda has a bit of pent up aggression..."
msgstr "Tôi bắt đầu nghĩ bà Wanda đang có chút bực dọc bị nén lại đấy..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POCKET_SCALE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POCKET_SCALE"
msgid "A simple way to weigh!"
msgstr "Một cách cân đo đơn giản!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POLISHCOOKIE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POLISHCOOKIE"
msgid "A rich pastry with a sweet fruity filling."
msgstr "Một loại bánh ngọt béo ngậy với lớp nhân trái cây ngọt ngào."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POLLY_ROGERS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POLLY_ROGERS"
msgid "Je m'excuse, I did not bring any crackers."
msgstr "Je m'excuse, tôi không mang theo chút bánh quy giòn nào cả."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POLLY_ROGERSHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POLLY_ROGERSHAT"
msgid "What a fine chapeau!"
msgstr "Thật là một chiếc mũ chapeau tuyệt đẹp!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POMEGRANATE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POMEGRANATE"
msgid "Wonderful!"
msgstr "Tuyệt vời!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POMEGRANATE_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POMEGRANATE_COOKED"
msgid "Could use tahini and mint..."
msgstr "Có thể dùng sốt mè tahini và bạc hà..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POMEGRANATE_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POMEGRANATE_OVERSIZED"
msgid "I could make a fine dessert with you!"
msgstr "Tôi có thể làm một món tráng miệng tuyệt vời với bạn đấy!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POMEGRANATE_SEEDS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POMEGRANATE_SEEDS"
msgid "Future ingredients, just waiting to be grown!"
msgstr "Những nguyên liệu cho tương lai, chỉ chờ được lớn lên!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POND
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POND"
msgid "I can't see the bottom..."
msgstr "Tôi không thể nhìn thấy đáy..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PONDEEL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PONDEEL"
msgid "Anguille."
msgstr "Anguille."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PONDFISH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PONDFISH"
msgid "Poisson!"
msgstr "Poisson!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POND_ALGAE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POND_ALGAE"
msgid "I can't see the bottom..."
msgstr "Tôi không thể nhìn thấy đáy..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POOP
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POOP"
msgid "The end result of a fine meal."
msgstr "Kết quả cuối cùng của một bữa ăn ngon."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PORTABLEBLENDER_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PORTABLEBLENDER_ITEM"
msgid "It has greatly improved my culinary adventures."
msgstr "Nó đã cải thiện rất nhiều cho các cuộc phiêu lưu ẩm thực của tôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG"
msgid "The flavors need time to meld."
msgstr "Hương vị cần có thời gian để hòa quyện."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT"
msgid "I threw that meal together!"
msgstr "Tôi đã vội vã làm xong bữa ăn đó đấy!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE"
msgid "Pickup! Oh, old habits..."
msgstr "Nhấc lên nào! Ồ, thói quen cũ..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY"
msgid "I would never leave home without it!"
msgstr "Tôi sẽ không bao giờ rời khỏi nhà mà không có nó đâu!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC"
msgid "What new culinary adventures shall we undertake, old friend?"
msgstr "Chúng ta sẽ bắt đầu những cuộc phiêu lưu ẩm thực mới nào đây, người bạn cũ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PORTABLEFIREPIT_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PORTABLEFIREPIT_ITEM"
msgid "Most convenient!"
msgstr "Quá là tiện lợi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PORTABLESPICER_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PORTABLESPICER_ITEM.DONE"
msgid "Pickup! Oh, old habits..."
msgstr "Nhấc lên nào! Ồ, thói quen cũ..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PORTABLESPICER_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PORTABLESPICER_ITEM.GENERIC"
msgid "Fresh spices! Oh, how I have missed you!"
msgstr "Gia vị tươi! Ồ, ta nhớ các ngươi biết bao!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PORTABLETENT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PORTABLETENT"
msgid "It looks very cozy."
msgstr "Trông rất ấm cúng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PORTABLETENT_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PORTABLETENT_ITEM"
msgid "All rolled up like a crepe."
msgstr "Được cuộn tròn lại như một chiếc bánh kếp crepe."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POTATO
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POTATO"
msgid "Ah, the mighty potato!"
msgstr "À, củ khoai tây vĩ đại!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POTATOSACK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POTATOSACK"
msgid "I suppose all that lifting works up quite an appetite."
msgstr "Tôi cho rằng việc nâng nhấc đó tốn khá nhiều sức ăn đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POTATOSOUFFLE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POTATOSOUFFLE"
msgid "It came out just right."
msgstr "Nó ra lò vừa vặn hoàn hảo."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POTATOTORNADO
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POTATOTORNADO"
msgid "Junk food can be as enjoyable as anything gourmet."
msgstr "Đồ ăn nhanh cũng có thể ngon miệng không kém gì đồ ăn thượng hạng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POTATO_COOKED"
msgid "Golden brown. Simplicity at its finest."
msgstr "Vàng ruộm. Sự đơn giản ở mức hoàn hảo nhất."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POTATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POTATO_OVERSIZED"
msgid "Ah, you can never go wrong with a potato!"
msgstr "À, bạn không bao giờ có thể sai lầm với một củ khoai tây cả!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POTATO_SEEDS"
msgid "What fresh ingredients will grow from these?"
msgstr "Nguyên liệu tươi ngon nào sẽ mọc lên từ những thứ này đây?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POTTEDFERN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POTTEDFERN"
msgid "Nature. Tamed."
msgstr "Thiên nhiên. Đã được thuần hóa."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POWCAKE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POWCAKE"
msgid "I would not feed this to my worst enemies. Or would I..."
msgstr "Tôi sẽ không cho kẻ thù tồi tệ nhất của mình ăn thứ này đâu. Hay là có nhỉ..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.POWDER_MONKEY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.POWDER_MONKEY"
msgid "J'accuse! You are no honest sailor!"
msgstr "J'accuse! Ngươi không phải là một thủy thủ chân chính!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PREMIUMWATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PREMIUMWATERINGCAN.EMPTY"
msgid "It's completely empty, I'm afraid."
msgstr "E là nó hoàn toàn trống rỗng rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PREMIUMWATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PREMIUMWATERINGCAN.GENERIC"
msgid "To make the finest ingredients, our plants need the finest care."
msgstr "Để tạo ra những nguyên liệu tốt nhất, cây trồng của chúng ta cần sự chăm sóc tốt nhất."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PRIME_MATE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PRIME_MATE"
msgid "You should teach your crew better manners, monsieur."
msgstr "Ngươi nên dạy thủy thủ đoàn của mình cách cư xử tốt hơn đấy, thưa ngài."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PUFFIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PUFFIN.GENERIC"
msgid "Hm, I don't think I've cooked one of those before."
msgstr "Hừm, hình như tôi chưa từng nấu con nào trong số đó trước đây."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PUFFIN.HELD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PUFFIN.HELD"
msgid "What a cute little morsel!"
msgstr "Đúng là một miếng thịt nhỏ dễ thương!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PUFFIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PUFFIN.SLEEPING"
msgid "I think it's asleep."
msgstr "Tôi nghĩ nó đang ngủ đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PUMPKIN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PUMPKIN"
msgid "I'm the pumpking of the world!"
msgstr "Tôi là vua bí ngô của thế giới!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PUMPKINCARVER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PUMPKINCARVER"
msgid "Ah yes. I can use this."
msgstr "À vâng. Tôi có thể dùng thứ này."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PUMPKINCOOKIE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PUMPKINCOOKIE"
msgid "I've outdone myself this time."
msgstr "Lần này tôi đã tự vượt qua chính mình rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PUMPKINHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PUMPKINHAT.GENERIC"
msgid "One should never play with food, but wearing it is another matter."
msgstr "Người ta không bao giờ nên đùa giỡn với đồ ăn, nhưng việc đội nó lên đầu lại là chuyện khác."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PUMPKINHAT.UNCARVED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PUMPKINHAT.UNCARVED"
msgid "This pumpkin is in need of my knife skills."
msgstr "Quả bí ngô này đang cần đến kỹ năng dao kéo của tôi đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PUMPKINPIE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PUMPKINPIE"
msgid "Simple and classic."
msgstr "Đơn giản và cổ điển."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PUMPKIN_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PUMPKIN_COOKED"
msgid "Could use some pie crust and nutmeg..."
msgstr "Có thể dùng thêm vỏ bánh nướng và hạt nhục đậu khấu..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PUMPKIN_LANTERN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PUMPKIN_LANTERN"
msgid "Trick 'r' neat!"
msgstr "Lừa hay gọn gàng!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PUMPKIN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PUMPKIN_OVERSIZED"
msgid "You would make for a lovely pie."
msgstr "Bạn sẽ làm nên một chiếc bánh nướng tuyệt vời đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PUMPKIN_SEEDS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PUMPKIN_SEEDS"
msgid "Future ingredients, just waiting to be grown!"
msgstr "Những nguyên liệu cho tương lai, chỉ chờ được lớn lên!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PUNCHINGBAG
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PUNCHINGBAG"
msgid "It's a relief to practice on something that won't hit me back."
msgstr "Thật nhẹ nhõm khi được tập luyện trên một thứ sẽ không đánh trả tôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PUREBRILLIANCE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PUREBRILLIANCE"
msgid "My, I've never seen anything shine so brightly."
msgstr "Trời ạ, tôi chưa từng thấy thứ gì tỏa sáng rực rỡ đến thế."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PURPLEAMULET
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PURPLEAMULET"
msgid "I must be crazy to fool around with this."
msgstr "Chắc tôi điên rồi mới đi táy máy với thứ này."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PURPLEGEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PURPLEGEM"
msgid "It holds deep secrets."
msgstr "Nó chứa đựng những bí mật sâu kín."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PURPLEMOONEYE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PURPLEMOONEYE"
msgid "It's a purple stone eye."
msgstr "Đó là một con mắt bằng đá màu tím."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBIT.GENERIC"
msgid "I haven't had rabbit in awhile..."
msgstr "Tôi đã không ăn thịt thỏ một thời gian rồi..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBIT.HELD"
msgid "Your little heart is beating so fast."
msgstr "Trái tim nhỏ bé của mày đang đập nhanh quá kìa."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITHAT"
msgid "Cute topper."
msgstr "Cái mũ dễ thương quá."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITHOLE.GENERIC"
msgid "Thump twice if you are fat and juicy."
msgstr "Hãy đập hai tiếng nếu mày béo múp míp và mọng nước nhé."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITHOLE.SPRING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITHOLE.SPRING"
msgid "What a pity rabbit season has ended."
msgstr "Thật tiếc là mùa săn thỏ đã kết thúc rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITHOUSE.BURNT"
msgid "That was no carrot!"
msgstr "Đó đâu phải là củ cà rốt!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITHOUSE.GENERIC"
msgid "Do my eyes deceive me?"
msgstr "Mắt tôi có đang đánh lừa mình không nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITKINGHORN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITKINGHORN"
msgid "Do rabbits have a taste for music?"
msgstr "Lũ thỏ cũng có gu thưởng thức âm nhạc cơ à?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITKINGHORN_CHEST
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITKINGHORN_CHEST"
msgid "A cellar!"
msgstr "Một căn hầm rượu!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITKINGMINION_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITKINGMINION_BUNNYMAN"
msgid "They are not trying to cuddle."
msgstr "Chúng không hề có ý định ôm ấp đâu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITKINGSPEAR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITKINGSPEAR"
msgid "Made from real rabbit antler."
msgstr "Được làm từ sừng thỏ thật đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITKING_AGGRESSIVE"
msgid "It is tough, even for stew."
msgstr "Nó rất dai, ngay cả khi đem nấu canh."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITKING_LUCKY"
msgid "I promise not to cook you!"
msgstr "Tôi hứa sẽ không nấu chín cậu đâu!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RABBITKING_PASSIVE"
msgid "A gentle creature. Hopefully."
msgstr "Một sinh vật hiền lành. Mong là vậy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RAINCOAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RAINCOAT"
msgid "For a foggy Paris evening."
msgstr "Dành cho một buổi tối sương mù ở Paris."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RAINHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RAINHAT"
msgid "Better than a newspaper."
msgstr "Tốt hơn một tờ báo."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RAINOMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RAINOMETER.BURNT"
msgid "It measures nothing now..."
msgstr "Bây giờ nó chẳng đo được cái gì nữa cả..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RAINOMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RAINOMETER.GENERIC"
msgid "It measures moisture in the clouds."
msgstr "Nó đo lượng độ ẩm trong các đám mây."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RATATOUILLE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RATATOUILLE"
msgid "A veritable village of vegetables!"
msgstr "Một ngôi làng thực sự của các loại rau củ!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RAZOR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RAZOR"
msgid "If only I had aftershave."
msgstr "Giá như tôi có kem dưỡng sau khi cạo râu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD"
msgid "Now where have I heard that before?"
msgstr "Mình đã từng nghe âm thanh đó ở đâu rồi nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_BALATRO
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_BALATRO"
msgid "Reminds me of fun times."
msgstr "Làm tôi nhớ đến những khoảnh khắc vui vẻ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_CREEPYFOREST
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_CREEPYFOREST"
msgid "A feast for the ears!"
msgstr "Một bữa tiệc cho đôi tai!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_DANGER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_DANGER"
msgid "A feast for the ears!"
msgstr "Một bữa tiệc cho đôi tai!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_DAWN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_DAWN"
msgid "A feast for the ears!"
msgstr "Một bữa tiệc cho đôi tai!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_DRSTYLE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_DRSTYLE"
msgid "What a sweet sound it makes."
msgstr "Nó phát ra âm thanh thật ngọt ngào làm sao."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_DUSK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_DUSK"
msgid "What a sweet sound it makes."
msgstr "Nó phát ra âm thanh thật ngọt ngào làm sao."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_EFS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_EFS"
msgid "A feast for the ears!"
msgstr "Một bữa tiệc cho đôi tai!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_END
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_END"
msgid "A feast for the ears!"
msgstr "Một bữa tiệc cho đôi tai!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_HALLOWEDNIGHTS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_HALLOWEDNIGHTS"
msgid "It really sets the mood."
msgstr "Nó thực sự tạo nên bầu không khí đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_MAIN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_MAIN"
msgid "What a sweet sound it makes."
msgstr "Nó phát ra âm thanh thật ngọt ngào làm sao."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_WORKTOBEDONE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_WORKTOBEDONE"
msgid "What a sweet sound it makes."
msgstr "Nó phát ra âm thanh thật ngọt ngào làm sao."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.REDGEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.REDGEM"
msgid "A deep fire burns within."
msgstr "Một ngọn lửa sâu thẳm đang bùng cháy bên trong."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.REDLANTERN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.REDLANTERN"
msgid "I do like festivals like this."
msgstr "Tôi rất thích những lễ hội thế này đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.REDMOONEYE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.REDMOONEYE"
msgid "It looks a bit like an eye with a gem inside, non?"
msgstr "Trông nó hơi giống một con mắt có đính ngọc ở trong phải không nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.REDPOUCH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.REDPOUCH"
msgid "How nice it is to have luck on my side!"
msgstr "Thật tuyệt vời làm sao khi có sự may mắn ở bên cạnh!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RED_CAP
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RED_CAP"
msgid "Could use cream and salt... And less poison."
msgstr "Có thể dùng kem và muối... Và ít độc hơn thì tốt."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RED_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RED_CAP_COOKED"
msgid "Perhaps I could make a good soup."
msgstr "Có lẽ tôi có thể nấu một món súp ngon."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RED_MUSHROOM.GENERIC"
msgid "Can't get fresher than that!"
msgstr "Không thể tìm đâu ra thứ tươi hơn thế này nữa đâu!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RED_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RED_MUSHROOM.INGROUND"
msgid "It'll be hard to harvest like that."
msgstr "Sẽ khó mà thu hoạch được như thế đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RED_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RED_MUSHROOM.PICKED"
msgid "There's nothing left."
msgstr "Chẳng còn gì sót lại cả."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.REEDS.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.REEDS.BURNING"
msgid "The fire took to those quite nicely."
msgstr "Lửa bén vào đám đó khá là vừa vặn đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.REEDS.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.REEDS.GENERIC"
msgid "A small clump of reeds."
msgstr "Một bụi cây sậy nhỏ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.REEDS.PICKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.REEDS.PICKED"
msgid "There's nothing left to pick."
msgstr "Không còn gì để hái nữa rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.REFINED_DUST
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.REFINED_DUST"
msgid "A most unusual ingredient."
msgstr "Một nguyên liệu rất khác thường."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.REFLECTIVEVEST
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.REFLECTIVEVEST"
msgid "Well, it should be hard to lose."
msgstr "Chà, chắc là khó mà làm mất được."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RELIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RELIC"
msgid "Ancient kitchenware."
msgstr "Đồ dùng nhà bếp cổ xưa."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RESEARCHLAB.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RESEARCHLAB.BURNT"
msgid "That didn't cook very well."
msgstr "Cái đó nấu không ngon lắm."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RESEARCHLAB.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RESEARCHLAB.GENERIC"
msgid "A center for learning."
msgstr "Một trung tâm học tập."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RESEARCHLAB2.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RESEARCHLAB2.BURNT"
msgid "The fire seemed to find it quite tasty."
msgstr "Ngọn lửa có vẻ thấy nó khá ngon miệng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RESEARCHLAB2.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RESEARCHLAB2.GENERIC"
msgid "Oh, the things I'll learn!"
msgstr "Ồ, bao điều tôi sẽ học được!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RESEARCHLAB3.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RESEARCHLAB3.BURNT"
msgid "The darkness is all burnt up."
msgstr "Bóng đêm đã cháy rụi hết rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RESEARCHLAB3.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RESEARCHLAB3.GENERIC"
msgid "It boggles the mind."
msgstr "Thật là hại não."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RESEARCHLAB4.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RESEARCHLAB4.BURNT"
msgid "Nothing but ashes."
msgstr "Chẳng còn gì ngoài tro."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RESEARCHLAB4.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RESEARCHLAB4.GENERIC"
msgid "I won't even try to pronounce it..."
msgstr "Tôi thậm chí sẽ không thèm cố đọc tên nó..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RESKIN_TOOL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RESKIN_TOOL"
msgid "Ah, this will help freshen up the place, non?"
msgstr "À, cái này sẽ giúp làm mới lại nơi này, phải không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RESURRECTIONSTATUE.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RESURRECTIONSTATUE.BURNT"
msgid "It won't be much good now."
msgstr "Bây giờ thì chẳng còn dùng được mấy nữa."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RESURRECTIONSTATUE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RESURRECTIONSTATUE.GENERIC"
msgid "Part of my soul is within."
msgstr "Một phần linh hồn của tôi ở bên trong."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RESURRECTIONSTONE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RESURRECTIONSTONE"
msgid "Looks like some sort of ritual stone."
msgstr "Trông giống như một loại đá nghi lễ nào đó."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.REVIVER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.REVIVER"
msgid "I don't like that it's still beating."
msgstr "Tôi không thích việc nó vẫn đang đập."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RHINODRILL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RHINODRILL"
msgid "Can't we just talk?"
msgstr "Chúng ta không thể nói chuyện tử tế sao?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROASTTURKEY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROASTTURKEY"
msgid "The pièce de résistance of any holiday feast!"
msgstr "Món ăn đỉnh cao của bất kỳ bữa tiệc lễ hội nào!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROBIN.GENERIC"
msgid "Good afternoon, sir or madam!"
msgstr "Chào buổi chiều, thưa ông hoặc thưa bà!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROBIN.HELD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROBIN.HELD"
msgid "It's soft, and surprisingly calm."
msgstr "Nó mềm mại và điềm tĩnh một cách đáng ngạc nhiên."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROBIN_WINTER.GENERIC"
msgid "This little fellow seems quite frigid."
msgstr "Chú chim nhỏ này trông có vẻ khá cóng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROBIN_WINTER.HELD"
msgid "Let me lend you my warmth, feathered friend."
msgstr "Hãy để tôi sưởi ấm cho bạn nhé, người bạn có lông vũ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROBOT_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROBOT_BLUEPRINT"
msgid "This does not look like any sewing pattern I've ever seen."
msgstr "Cái này trông không giống bất kỳ mẫu khâu vá nào tôi từng thấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROBOT_PUPPET
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROBOT_PUPPET"
msgid "Surely no one deserves such treatment!"
msgstr "Chắc chắn không ai đáng phải chịu đối xử thế này!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK"
msgid "Don't you go rolling off on me."
msgstr "Đừng có mà lăn đi chỗ khác đấy nhé."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCKS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCKS"
msgid "Bite-sized boulders."
msgstr "Những tảng đá cỡ vừa một miếng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCKY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCKY"
msgid "Hmm... I would have to be careful to not chip a tooth."
msgstr "Hừm... Tôi sẽ phải cẩn thận kẻo mẻ răng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN"
msgid "It's all out of fruit."
msgstr "Nó hết sạch trái cây rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING"
msgid "Did I leave the stove on?"
msgstr "Mình có để quên bật bếp không ta?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED"
msgid "That doesn't look healthy."
msgstr "Cái đó trông không lành mạnh cho lắm."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING"
msgid "I think something's wrong with it."
msgstr "Tôi nghĩ có gì đó không ổn với nó."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC"
msgid "What a strange looking shrub!"
msgstr "Quả là một bụi cây có hình dáng kỳ lạ!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED"
msgid "I must be patient."
msgstr "Tôi phải kiên nhẫn thôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED"
msgid "It's withered from the heat."
msgstr "Nó đã héo úa vì sức nóng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_FRUIT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_FRUIT"
msgid "You can't expect me to eat this!"
msgstr "Bạn không thể bắt tôi ăn cái này được!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE"
msgid "The fruit seems to have softened somewhat."
msgstr "Trái cây có vẻ đã mềm đi đôi chút."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED"
msgid "Cooking really does wonders."
msgstr "Nấu nướng thực sự làm nên điều kỳ diệu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT"
msgid "Let's find somewhere to plant this."
msgstr "Hãy tìm chỗ nào đó để trồng thực vật này nào."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_ICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_ICE.GENERIC"
msgid "Brr!"
msgstr "Brr!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_ICE.MELTED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_ICE.MELTED"
msgid "It's just liquid now."
msgstr "Bây giờ nó chỉ là chất lỏng thôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_ICE_MELTED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_ICE_MELTED"
msgid "It's just liquid now."
msgstr "Bây giờ nó chỉ là chất lỏng thôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_LIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_LIGHT.GENERIC"
msgid "The lava has crusted over."
msgstr "Dung nham đã đóng vảy lại rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_LIGHT.LOW
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_LIGHT.LOW"
msgid "Like a pie on a proverbial windowsill, it will soon cool."
msgstr "Giống như chiếc bánh trên bệ cửa sổ, nó sẽ sớm nguội thôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_LIGHT.NORMAL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_LIGHT.NORMAL"
msgid "Nature's fiery fondue pot."
msgstr "Nồi lẩu phô mai nóng chảy của tự nhiên."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_LIGHT.OUT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_LIGHT.OUT"
msgid "It has no heat left to give."
msgstr "Nó không còn chút hơi ấm nào để tỏa ra nữa."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_MOON
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_MOON"
msgid "It has a very peaceful energy."
msgstr "Nó có một nguồn năng lượng rất yên bình."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_PETRIFIED_TREE"
msgid "Did someone sculpt that?"
msgstr "Có ai tạc tượng cái đó à?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_PETRIFIED_TREE_OLD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_PETRIFIED_TREE_OLD"
msgid "Did someone sculpt that?"
msgstr "Có ai tạc tượng cái đó à?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROOK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROOK"
msgid "What a rude contraption."
msgstr "Quả là một cỗ máy thô lỗ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROOK_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROOK_NIGHTMARE"
msgid "What a monstrosity!"
msgstr "Đúng là một thứ quái dị!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROPE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROPE"
msgid "A bit too thick to tie up a roast."
msgstr "Hơi quá dày để buộc món thịt quay rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROPE_BRIDGE_KIT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROPE_BRIDGE_KIT"
msgid "This looks like a recipe for disaster."
msgstr "Cái này trông như một thảm họa được chưng cất sẵn vậy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROSEGLASSESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROSEGLASSESHAT.GENERIC"
msgid "Rather pretty, non?"
msgstr "Khá xinh xắn đấy chứ, phải không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL"
msgid "only_used_by_winona"
msgstr "chỉ_được_sử_dụng_bởi_winona"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROTTENEGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROTTENEGG.GENERIC"
msgid "Pee-eew!"
msgstr "Kéw-eew!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROYAL_JELLY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROYAL_JELLY"
msgid "I feel inspired to try my hand at confections!"
msgstr "Tôi cảm thấy có hứng thử sức với các món bánh kẹo!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RUBBLE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RUBBLE"
msgid "Delicious destruction."
msgstr "Sự hủy diệt ngon lành."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RUINSHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RUINSHAT"
msgid "Seems unnecessarily fancy."
msgstr "Có vẻ sang trọng một cách thừa thãi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RUINS_BAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RUINS_BAT"
msgid "I could tenderize some meat with this."
msgstr "Tôi có thể dùng cái này để làm mềm thịt."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RUINS_RUBBLE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RUINS_RUBBLE"
msgid "Delicious destruction."
msgstr "Sự hủy diệt ngon lành."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SACRED_CHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SACRED_CHEST.GENERIC"
msgid "Now to add the final ingredients."
msgstr "Giờ là lúc thêm các nguyên liệu cuối cùng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SACRED_CHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SACRED_CHEST.LOCKED"
msgid "Have I not been found worthy?"
msgstr "Chẳng lẽ ta không xứng đáng sao?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SADDLEHORN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SADDLEHORN"
msgid "It's like a spatula for a saddle."
msgstr "Nó giống như cái vá dành cho yên cưỡi vậy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SADDLE_BASIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SADDLE_BASIC"
msgid "Let's see if I can ride on this."
msgstr "Để xem tôi có cưỡi lên cái này được không."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SADDLE_RACE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SADDLE_RACE"
msgid "Adds a little spice to my ride."
msgstr "Thêm chút gia vị cho chuyến đi của tôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SADDLE_SHADOW
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SADDLE_SHADOW"
msgid "Best seat in the house!"
msgstr "Chỗ ngồi tuyệt nhất trong nhà!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SADDLE_WAR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SADDLE_WAR"
msgid "Durable."
msgstr "Bền bỉ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SADDLE_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SADDLE_WATHGRITHR"
msgid "Too much? Mais non, I think the wings are very tasteful!"
msgstr "Hơi quá đà không? Mais non, tôi nghĩ đôi cánh rất có gu đấy chứ!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SALSA
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SALSA"
msgid "I like to spice things up!"
msgstr "Tôi thích làm mọi thứ trở nên cay nồng hơn!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTBOX
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTBOX"
msgid "Just the thing for preserving ingredients."
msgstr "Đúng là thứ để bảo quản nguyên liệu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTLICK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTLICK"
msgid "Too salty."
msgstr "Mặn quá."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTLICK_IMPROVED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTLICK_IMPROVED"
msgid "This is more than a dash."
msgstr "Cái này không chỉ là một chút gia vị đâu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTROCK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTROCK"
msgid "Quelle chance! I've found salt!"
msgstr "Quelle chance! Tôi tìm thấy muối rồi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTSTACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTSTACK.GENERIC"
msgid "What beautiful formations!"
msgstr "Những cấu trúc thật đẹp!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTSTACK.GROWING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTSTACK.GROWING"
msgid "The sea is capable of amazing things."
msgstr "Đại dương có thể làm ra những điều tuyệt vời."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTSTACK.MINED_OUT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTSTACK.MINED_OUT"
msgid "Nothing left, I'm afraid."
msgstr "Hết sạch rồi, e là vậy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTY_DOG
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTY_DOG"
msgid "Merci beacoup for the salt, mon ami!"
msgstr "Cảm ơn rất nhiều vì số muối nhé, mon ami!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTY_DOGHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTY_DOGHAT"
msgid "It makes me look quite distinguished, non?"
msgstr "Nó làm tôi trông khá ra dáng quý ông, phải không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SANDBLOCK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SANDBLOCK"
msgid "Very thick sand."
msgstr "Cát rất dày."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SANDSPIKE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SANDSPIKE"
msgid "Watch yourself, it's quite sharp."
msgstr "Cẩn thận đấy, nó sắc lắm đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SANITYROCK.ACTIVE"
msgid "It's tugging on my mind."
msgstr "Nó đang kéo giật tâm trí tôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SANITYROCK.INACTIVE"
msgid "The darkness lurks within."
msgstr "Bóng đêm đang rình rập bên trong."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SAPLING.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SAPLING.BURNING"
msgid "Those burn quite dramatically."
msgstr "Mấy thứ đó cháy dữ dội phết."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SAPLING.DISEASED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SAPLING.DISEASED"
msgid "Would some nice soup make you feel better?"
msgstr "Ít súp ngon có làm bạn khá hơn chút nào không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SAPLING.DISEASING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SAPLING.DISEASING"
msgid "It's coming down with something."
msgstr "Nó đang lâm bệnh gì rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SAPLING.GENERIC"
msgid "Those could be key to my continued survival."
msgstr "Chúng có thể là chìa khóa giúp tôi tiếp tục sinh tồn."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SAPLING.PICKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SAPLING.PICKED"
msgid "There is nothing left for me to grasp!"
msgstr "Chẳng còn gì để tôi bấu víu nữa rồi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SAPLING.WITHERED"
msgid "It could use some love."
msgstr "Nó rất cần được chăm sóc đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCANDATA
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCANDATA"
msgid "What is this they're cooking up?"
msgstr "Bọn họ đang tính toán mưu tính gì thế nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCARECROW.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCARECROW.BURNING"
msgid "What a tragedy."
msgstr "Quả là một bi kịch."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCARECROW.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCARECROW.BURNT"
msgid "Overcooked."
msgstr "Nấu quá tay rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCARECROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCARECROW.GENERIC"
msgid "He seems nice."
msgstr "Cậu ta trông có vẻ tốt bụng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCORCHED_SKELETON"
msgid "A kitchen mishap, maybe?"
msgstr "Một tai nạn trong nhà bếp chăng?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCRAPBOOK_PAGE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCRAPBOOK_PAGE"
msgid "Ah! Someone has left a page here."
msgstr "Ồ! Ai đó đã bỏ quên một trang giấy ở đây."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCRAPHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCRAPHAT"
msgid "One werepig's pauldron is another man's chapeau, non?"
msgstr "Miếng giáp vai của người lợn này lại là cái mũ của người khác, phải không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCRAP_MONOCLEHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCRAP_MONOCLEHAT"
msgid "It provides a lovely view!"
msgstr "Nó mang lại một tầm nhìn tuyệt vời!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTINGTABLE.BLOCK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTINGTABLE.BLOCK"
msgid "Ready for the chisel."
msgstr "Đã sẵn sàng cho cái đục."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "Overcooked."
msgstr "Nấu quá tay rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTINGTABLE.EMPTY"
msgid "Just need some stone to get cooking."
msgstr "Chỉ cần ít đá là có thể bắt đầu nấu nướng được rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTINGTABLE.SCULPTURE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTINGTABLE.SCULPTURE"
msgid "Someone's a very talented artist."
msgstr "Ai đó là một nghệ sĩ rất tài năng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED"
msgid "Some old, worn stone."
msgstr "Vài viên đá cũ đã mòn."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED"
msgid "It looks much better."
msgstr "Trông khá hơn nhiều rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
msgid "I think... it's stirring!"
msgstr "Tôi nghĩ là... nó đang cựa quậy!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED"
msgid "It looks incomplete."
msgstr "Trông nó chưa hoàn chỉnh."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_BISHOPHEAD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_BISHOPHEAD"
msgid "I think it was part of a statue."
msgstr "Tôi nghĩ nó từng là một phần của bức tượng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED"
msgid "What an odd shape for a rock."
msgstr "Hình thù hòn đá gì mà kỳ quặc thế."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED"
msgid "Well, it's fixed now."
msgstr "Chà, giờ nó được sửa xong rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_KNIGHTBODY.READY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_KNIGHTBODY.READY"
msgid "I think... it's stirring!"
msgstr "Tôi nghĩ là... nó đang cựa quậy!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED"
msgid "It's looking for its missing piece."
msgstr "Nó đang tìm mảnh còn thiếu của mình."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_KNIGHTHEAD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_KNIGHTHEAD"
msgid "Looks like it came off a sculpture somewhere."
msgstr "Trông như thể nó rơi ra từ bức tượng nào đó."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_ROOKBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_ROOKBODY.COVERED"
msgid "Parts of it look like they were sculpted."
msgstr "Có vài phần trông giống như được tạc tượng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED"
msgid "That looks nice."
msgstr "Trông đẹp đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_ROOKBODY.READY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_ROOKBODY.READY"
msgid "I think... it's stirring!"
msgstr "Tôi nghĩ là... nó đang cựa quậy!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED"
msgid "Where is your nose?"
msgstr "Mũi của bạn đâu rồi?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_ROOKNOSE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SCULPTURE_ROOKNOSE"
msgid "That doesn't look like a natural rock."
msgstr "Cái đó trông không giống một tảng đá tự nhiên cho lắm."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SEAFARING_PROTOTYPER.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SEAFARING_PROTOTYPER.BURNT"
msgid "It's all gone up in smoke."
msgstr "Nó tan thành mây khói rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC"
msgid "All the knowledge of a seasoned seafarer!"
msgstr "Tất cả kiến thức của một thủy thủ kỳ cựu!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SEAFOODGUMBO
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SEAFOODGUMBO"
msgid "Incredible! Just like Nana used to make!"
msgstr "Tuyệt vời! Y chang món của Nội ngày trước!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SEASTACK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SEASTACK"
msgid "A big lumpy rock."
msgstr "Một tảng đá lớn lổn nhổn."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SECURITY_PULSE_CAGE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SECURITY_PULSE_CAGE"
msgid "This reminds me of my little oven back home."
msgstr "Cái này làm tôi nhớ đến lò nướng nhỏ ở nhà."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SECURITY_PULSE_CAGE_FULL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SECURITY_PULSE_CAGE_FULL"
msgid "Something is cooking."
msgstr "Có thứ gì đó đang được nấu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SEEDPOUCH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SEEDPOUCH"
msgid "A little organization never hurts."
msgstr "Sắp xếp ngăn nắp một chút chẳng bao giờ thừa cả."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SEEDS"
msgid "You may grow up to be delicious one day."
msgstr "Biết đâu một ngày nào đó ngươi lớn lên sẽ rất ngon đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SEEDS_COOKED"
msgid "Could use smoked paprika..."
msgstr "Dùng thêm chút ớt bột xông khói thì hợp..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SENTRYWARD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SENTRYWARD"
msgid "It's watching over us."
msgstr "Nó đang canh chừng chúng ta kìa."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SEWING_KIT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SEWING_KIT"
msgid "Not exactly my specialty."
msgstr "Không hẳn là sở trường của tôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SEWING_MANNEQUIN.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SEWING_MANNEQUIN.BURNT"
msgid "Ah, I almost feel bad for it now."
msgstr "À, giờ thì tôi hơi thấy tội cho nó rồi đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SEWING_MANNEQUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SEWING_MANNEQUIN.GENERIC"
msgid "I feel as though it's staring at me."
msgstr "Tôi có cảm giác như nó đang trừng trừng nhìn mình."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SEWING_TAPE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SEWING_TAPE"
msgid "Winona is really very resourceful."
msgstr "Winona quả thực rất tháo vát."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWDANCER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWDANCER"
msgid "They keep getting odder..."
msgstr "Chúng ngày càng trở nên kỳ quặc hơn..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWDIGGER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWDIGGER"
msgid "Oh, how odd."
msgstr "Ồ, thật kỳ lạ làm sao."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWHEART
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWHEART"
msgid "That beef heart is almost certainly past its prime."
msgstr "Trái tim bò đó gần như chắc chắn đã qua thời điểm ngon nhất rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWRIFT_PORTAL"
msgid "The ground is crumbling!"
msgstr "Mặt đất đang sụp đổ kìa!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY"
msgid "That will not fit in any pot."
msgstr "Cái đó không nhét vừa bất kỳ cái nồi nào đâu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED"
msgid "It has gone belly up."
msgstr "Nó đã phơi bụng lên trời rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD"
msgid "Impressive jaws."
msgstr "Bộ hàm ấn tượng thật."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWTHRALL_HANDS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWTHRALL_HANDS"
msgid "I don't want to end up in its clutches."
msgstr "Tôi không muốn kết thúc trong nanh vuốt của nó đâu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWTHRALL_HORNS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWTHRALL_HORNS"
msgid "Oh my, it looks hungry... and I'm probably delicious!"
msgstr "Ôi trời, nó trông có vẻ đói... và có lẽ tôi rất ngon!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWTHRALL_MOUTH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWTHRALL_MOUTH"
msgid "It smiles, but is it happy?"
msgstr "Nó đang mỉm cười, nhưng liệu nó có vui không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWTHRALL_PARASITE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWTHRALL_PARASITE"
msgid "It is one bad customer."
msgstr "Đúng là một vị khách khó nhằn."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWTHRALL_WINGS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOWTHRALL_WINGS"
msgid "My fears have taken flight!"
msgstr "Nỗi sợ của tôi đã chắp cánh bay xa!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOW_BATTLEAXE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOW_BATTLEAXE"
msgid "I've never seen a cleaver like that before."
msgstr "Tôi chưa từng thấy con dao mổ nào như thế trước đây."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOW_BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOW_BEEF_BELL"
msgid "Ring the bell for seconds!"
msgstr "Róng chuông lên để gọi thêm phần ăn nào!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOW_FORGE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOW_FORGE"
msgid "A place for dark concoctions."
msgstr "Nơi ra lò của những chế phẩm hắc ám."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOW_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOW_FORGE_KIT"
msgid "I'll just put these pieces together, and voilà!"
msgstr "Tôi chỉ cần ráp mấy mảnh này lại, và voilà!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOW_HEART_VEIN"
msgid "It has roots and grows in the dirt, but that is no vegetable."
msgstr "Nó có rễ và mọc trong đất, nhưng đó không phải là rau củ đâu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHALLOW_GRAVE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHALLOW_GRAVE"
msgid "There was no effort here."
msgstr "Chẳng hề có chút cố gắng nào ở đây cả."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHARK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHARK"
msgid "I'm sure you can find something much tastier to eat elsewhere!"
msgstr "Tôi chắc là bạn có thể tìm thứ gì đó ngon hơn để ăn ở chỗ khác đấy!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHARKBOI
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHARKBOI"
msgid "It looks rather tough."
msgstr "Trông có vẻ khá dai đấy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHELLWEAVER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHELLWEAVER"
msgid "These recipes all call for a pinch of salt."
msgstr "Những công thức này đều đòi hỏi một nhúm muối."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHELL_CLUSTER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHELL_CLUSTER"
msgid "Perhaps I could break it open?"
msgstr "Biết đâu tôi có thể đập vỡ nó ra nhỉ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHIELDOFTERROR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHIELDOFTERROR"
msgid "Mon dieu, it seems I have another mouth to feed..."
msgstr "Mon dieu, có vẻ như tôi lại có thêm một cái miệng phải cho ăn rồi..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHOVEL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHOVEL"
msgid "I'm not the landscaping type."
msgstr "Tôi không phải kiểu người thích làm vườn cảnh đâu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHOVEL_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHOVEL_LUNARPLANT"
msgid "I almost hate to get it dirty."
msgstr "Tôi gần như không nỡ làm nó vấy bẩn."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHROOMBAIT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHROOMBAIT"
msgid "Not the stuffed champignon I had in mind."
msgstr "Không phải món nấm nhồi mà tôi đang nghĩ đến."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHROOMCAKE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHROOMCAKE"
msgid "It certainly has a unique flavor profile."
msgstr "Nó chắc chắn có một hương vị rất độc đáo."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHROOM_SKIN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHROOM_SKIN"
msgid "Oh dear. I'm not sure I like that."
msgstr "Ôi trời. Tôi không chắc mình thích cái đó lắm đâu."

