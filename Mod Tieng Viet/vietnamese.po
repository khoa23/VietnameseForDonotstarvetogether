msgstr "Nó đang ngủ, bây giờ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PLATE_SILVER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_PLATE_SILVER"
